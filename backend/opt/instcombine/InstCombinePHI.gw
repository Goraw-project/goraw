static mut NumPHIsOfInsertValues: Statistic = Statistic { "instcombine", "NumPHIsOfInsertValues", "Number of phi-of-insertvalue turned into insertvalue-of-phis" };

static mut NumPHIsOfExtractValues: Statistic = Statistic { "instcombine", "NumPHIsOfExtractValues", "Number of phi-of-extractvalue turned into extractvalue-of-phi" };

static mut NumPHICSEs: Statistic = Statistic { "instcombine", "NumPHICSEs", "Number of PHI's that got CSE'd" };

fn InstCombinerImpl::PHIArgMergedDebugLoc(self, Inst: *mut Instruction, PN: *mut PHINode) {
    let mut FirstInst: *mut Instruction = cast(PN.getIncomingValue(0));
    Inst.setDebugLoc(FirstInst.getDebugLoc());
    assert!(!isa(Inst);
    for V in drop_begin(PN.incoming_values(), 1) {
        let mut I: *mut Instruction = cast(V);
        Inst.applyMergedLocation(Inst.getDebugLoc(), I.getDebugLoc());
    }
}

fn InstCombinerImpl::foldDeadPhiWeb(self, PN: *mut PHINode) -> bool {
    let mut Stack: SmallVector<PHINode *, 16> = SmallVector<PHINode *, 16> {};
    let mut Visited: SmallPtrSet<PHINode *, 16> = SmallPtrSet<PHINode *, 16> {};
    Stack.push(&mut PN);
    Visited.insert(&mut PN);
    while !Stack.is_empty() {
        let mut Phi: *mut PHINode = Stack.pop_back_val();
        for Use in Phi.users() {
            if dyn_cast(Use) {
                PhiUse;
            } else {
                if !Visited.insert(PhiUse).second {
                    continue;
                }
                if Visited.len >= 16 {
                    return false;
                }
                Stack.push(PhiUse);
            }
        }
    }
    for Phi in Visited {
        self.replaceInstUsesWith(*Phi, get(Phi.getType()));
    }
    for Phi in Visited {
        self.eraseInstFromFunction(*Phi);
    }
    return true;
}

fn InstCombinerImpl::foldIntegerTypedPHI(self, PN: *mut PHINode) -> bool {
    if !PN.getType().isIntegerTy() {
        return false;
    }
    if !PN.hasOneUse() {
        return false;
    }
    let mut IntToPtr: *mut IntToPtrInst = dyn_cast(PN.user_back());
    if !IntToPtr {
        return false;
    }
    let mut HasPointerUse: Closure_1 = Closure_1 {};
    if !HasPointerUse.call(IntToPtr) {
        return false;
    }
    if self.DL.getPointerSizeInBits(IntToPtr.getAddressSpace()) != self.DL.getTypeSizeInBits(IntToPtr.getOperand(0).getType()).operator unsigned long long() {
        return false;
    }
    let mut AvailablePtrVals: SmallVector<Value *, 4> = SmallVector<Value *, 4> {};
    for Incoming in zip(PN.blocks(), PN.incoming_values()) {
        let mut BB: *mut BasicBlock = get(Incoming);
        let mut Arg: *mut Value = get(Incoming).operator llvm::Value *();
        if !isa(Arg) && !isa(Arg) {
            return false;
        }
        if dyn_cast(Arg) {
            PI;
        } else {
            if PI.getOperand(0).getType() == IntToPtr.getType() {
                AvailablePtrVals.push(PI.getOperand(0));
                continue;
            }
        }
        let mut ArgIntToPtr: *mut Value = null;
        for U in Arg.users() {
            if isa(U) && U.getType() == IntToPtr.getType() && (self.DT.dominates(cast(U), BB) || cast(U).getParent() == BB) {
                ArgIntToPtr = U;
                break;
            }
        }
        if ArgIntToPtr {
            AvailablePtrVals.push(ArgIntToPtr);
            continue;
        }
        if isa(Arg) {
            AvailablePtrVals.push(Arg);
            continue;
        }
        let mut LoadI: *mut LoadInst = dyn_cast(Arg);
        if !LoadI {
            return false;
        }
        if !LoadI.hasOneUse() {
            return false;
        }
        AvailablePtrVals.push(LoadI);
    }
    let mut BB: *mut BasicBlock = PN.getParent();
    assert!(AvailablePtrVals.len == PN.getNumIncomingValues(), "Not enough available ptr typed incoming values");
    let mut MatchingPtrPHI: *mut PHINode = null;
    let mut NumPhis: u32 = 0;
    for PtrPHI in BB.phis() {
        if NumPhis += 1 > self.CLOpts.max_num_phis {
            return false;
        }
        if &mut PtrPHI == &mut PN || PtrPHI.getType() != IntToPtr.getType() {
            continue;
        }
        if any_of(zip(PN.blocks(), AvailablePtrVals), Closure_2 { PtrPHI: &mut PtrPHI }) {
            continue;
        }
        MatchingPtrPHI = &mut PtrPHI;
        break;
    }
    if MatchingPtrPHI {
        assert!(MatchingPtrPHI.getType() == IntToPtr.getType(), "Phi's Type does not match with IntToPtr");
        self.replaceInstUsesWith(*IntToPtr, MatchingPtrPHI);
        self.eraseInstFromFunction(*IntToPtr);
        self.eraseInstFromFunction(PN);
        return true;
    }
    if all_of(AvailablePtrVals, Closure_3 { IntToPtr: &mut IntToPtr }) {
        return false;
    }
    if any_of(AvailablePtrVals, Closure_4 { IntToPtr: &mut IntToPtr }) {
        return false;
    }
    let mut NewPtrPHI: *mut PHINode = Create(IntToPtr.getType(), PN.getNumIncomingValues(), PN.getName() + ".ptr", null);
    self.InsertNewInstBefore(NewPtrPHI, PN.getIterator());
    let mut Casts: SmallDenseMap<Value *, Instruction *> = SmallDenseMap<Value *, Instruction *> {};
    for Incoming in zip(PN.blocks(), AvailablePtrVals) {
        let mut IncomingBB: *mut BasicBlock = get(Incoming);
        let mut IncomingVal: *mut Value = get(Incoming);
        if IncomingVal.getType() == IntToPtr.getType() {
            NewPtrPHI.addIncoming(IncomingVal, IncomingBB);
            continue;
        }
        let mut LoadI: *mut LoadInst = dyn_cast(IncomingVal);
        assert!((isa(IncomingVal) || IncomingVal.getType().isPointerTy() || (LoadI && LoadI.hasOneUse())), "Can not replace LoadInst with multiple uses");
        let mut CI: *mut *mut Instruction = Casts[IncomingVal];
        if !CI {
            CI = CreateBitOrPointerCast(IncomingVal, IntToPtr.getType(), IncomingVal.getName() + ".ptr", null);
            if dyn_cast(IncomingVal) {
                IncomingI;
            } else {
                let mut InsertPos: iterator = IncomingI;
                operator(InsertPos, 0);
                let mut BB: *mut BasicBlock = IncomingI.getParent();
                if isa(IncomingI) {
                    InsertPos = BB.getFirstInsertionPt();
                }
                assert!(InsertPos != BB.end(), "should have checked above");
                self.InsertNewInstBefore(CI, InsertPos);
            }
        }
        NewPtrPHI.addIncoming(CI, IncomingBB);
    }
    self.replaceInstUsesWith(*IntToPtr, NewPtrPHI);
    self.eraseInstFromFunction(*IntToPtr);
    self.eraseInstFromFunction(PN);
    return true;
}

fn InstCombinerImpl::foldPHIArgIntToPtrToPHI(self, PN: *mut PHINode) -> *mut Instruction {
    if !all_of(PN.users(), IsaPred) {
        return null;
    }
    let mut OperandWithRoundTripCast: bool = false;
    for let mut OpNum: u32 = 0; OpNum != PN.getNumIncomingValues(); OpNum += 1 {
        if self.simplifyIntToPtrRoundTripCast(PN.getIncomingValue(OpNum)) {
            NewOp;
        } else {
            self.replaceOperand(PN, OpNum, NewOp);
            OperandWithRoundTripCast = true;
        }
    }
    if !OperandWithRoundTripCast {
        return null;
    }
    return &mut PN;
}

fn InstCombinerImpl::foldPHIArgInsertValueInstructionIntoPHI(self, PN: *mut PHINode) -> *mut Instruction {
    let mut FirstIVI: *mut InsertValueInst = cast(PN.getIncomingValue(0));
    for V in drop_begin(PN.incoming_values(), 1) {
        let mut I: *mut InsertValueInst = dyn_cast(V);
        if !I || !I.hasOneUser() || I.getIndices() != FirstIVI.getIndices() {
            return null;
        }
    }
    let mut NewOperands: array<PHINode *, 2> = array<PHINode *, 2> {};
    for OpIdx in [0, 1] {
        let mut NewOperand: *mut *mut PHINode = NewOperands[OpIdx];
        NewOperand = Create(FirstIVI.getOperand(OpIdx).getType(), PN.getNumIncomingValues(), FirstIVI.getOperand(OpIdx).getName() + ".pn", null);
        for Incoming in zip(PN.blocks(), PN.incoming_values()) {
            NewOperand.addIncoming(cast(get(Incoming)).getOperand(OpIdx), get(Incoming));
        }
        self.InsertNewInstBefore(NewOperand, PN.getIterator());
    }
    let mut NewIVI: *mut InsertValueInst = Create(NewOperands[0], NewOperands[1], FirstIVI.getIndices(), PN.getName(), null);
    self.PHIArgMergedDebugLoc(NewIVI, PN);
    operator(NumPHIsOfInsertValues);
    return NewIVI;
}

fn InstCombinerImpl::foldPHIArgExtractValueInstructionIntoPHI(self, PN: *mut PHINode) -> *mut Instruction {
    let mut FirstEVI: *mut ExtractValueInst = cast(PN.getIncomingValue(0));
    for V in drop_begin(PN.incoming_values(), 1) {
        let mut I: *mut ExtractValueInst = dyn_cast(V);
        if !I || !I.hasOneUser() || I.getIndices() != FirstEVI.getIndices() || I.getAggregateOperand().getType() != FirstEVI.getAggregateOperand().getType() {
            return null;
        }
    }
    let mut NewAggregateOperand: *mut PHINode = Create(FirstEVI.getAggregateOperand().getType(), PN.getNumIncomingValues(), FirstEVI.getAggregateOperand().getName() + ".pn", null);
    for Incoming in zip(PN.blocks(), PN.incoming_values()) {
        NewAggregateOperand.addIncoming(cast(get(Incoming)).getAggregateOperand(), get(Incoming));
    }
    self.InsertNewInstBefore(NewAggregateOperand, PN.getIterator());
    let mut NewEVI: *mut ExtractValueInst = Create(NewAggregateOperand, FirstEVI.getIndices(), PN.getName(), null);
    self.PHIArgMergedDebugLoc(NewEVI, PN);
    operator(NumPHIsOfExtractValues);
    return NewEVI;
}

fn InstCombinerImpl::foldPHIArgBinOpIntoPHI(self, PN: *mut PHINode) -> *mut Instruction {
    let mut FirstInst: *mut Instruction = cast(PN.getIncomingValue(0));
    assert!(isa(FirstInst) || isa(FirstInst);
    let mut Opc: u32 = FirstInst.getOpcode();
    let mut LHSVal: *mut Value = FirstInst.getOperand(0);
    let mut RHSVal: *mut Value = FirstInst.getOperand(1);
    let mut LHSType: *mut Type = LHSVal.getType();
    let mut RHSType: *mut Type = RHSVal.getType();
    for V in drop_begin(PN.incoming_values(), 1) {
        let mut I: *mut Instruction = dyn_cast(V);
        if !I || I.getOpcode() != Opc || !I.hasOneUser() || I.getOperand(0).getType() != LHSType || I.getOperand(1).getType() != RHSType {
            return null;
        }
        if dyn_cast(I) {
            CI;
        } else if CI.getPredicate() != cast(FirstInst).getPredicate() {
            return null;
        }
        if I.getOperand(0) != LHSVal {
            LHSVal = null;
        }
        if I.getOperand(1) != RHSVal {
            RHSVal = null;
        }
    }
    if !LHSVal && !RHSVal {
        return null;
    }
    let mut InLHS: *mut Value = FirstInst.getOperand(0);
    let mut InRHS: *mut Value = FirstInst.getOperand(1);
    let mut NewLHS: *mut PHINode = null;
    let mut NewRHS: *mut PHINode = null;
    if !LHSVal {
        NewLHS = Create(LHSType, PN.getNumIncomingValues(), FirstInst.getOperand(0).getName() + ".pn", null);
        NewLHS.addIncoming(InLHS, PN.getIncomingBlock(0));
        self.InsertNewInstBefore(NewLHS, PN.getIterator());
        LHSVal = NewLHS;
    }
    if !RHSVal {
        NewRHS = Create(RHSType, PN.getNumIncomingValues(), FirstInst.getOperand(1).getName() + ".pn", null);
        NewRHS.addIncoming(InRHS, PN.getIncomingBlock(0));
        self.InsertNewInstBefore(NewRHS, PN.getIterator());
        RHSVal = NewRHS;
    }
    if NewLHS || NewRHS {
        for Incoming in drop_begin(zip(PN.blocks(), PN.incoming_values()), 1) {
            let mut InBB: *mut BasicBlock = get(Incoming);
            let mut InVal: *mut Value = get(Incoming).operator llvm::Value *();
            let mut InInst: *mut Instruction = cast(InVal);
            if NewLHS {
                let mut NewInLHS: *mut Value = InInst.getOperand(0);
                NewLHS.addIncoming(NewInLHS, InBB);
            }
            if NewRHS {
                let mut NewInRHS: *mut Value = InInst.getOperand(1);
                NewRHS.addIncoming(NewInRHS, InBB);
            }
        }
    }
    if dyn_cast(FirstInst) {
        CIOp;
    } else {
        let mut NewCI: *mut CmpInst = Create(CIOp.getOpcode(), CIOp.getPredicate(), LHSVal, RHSVal, "", null);
        self.PHIArgMergedDebugLoc(NewCI, PN);
        return NewCI;
    }
    let mut BinOp: *mut BinaryOperator = cast(FirstInst);
    let mut NewBinOp: *mut BinaryOperator = Create(BinOp.getOpcode(), LHSVal, RHSVal, "", null);
    NewBinOp.copyIRFlags(PN.getIncomingValue(0), true);
    for V in drop_begin(PN.incoming_values(), 1) {
        NewBinOp.andIRFlags(V);
    }
    self.PHIArgMergedDebugLoc(NewBinOp, PN);
    return NewBinOp;
}

fn InstCombinerImpl::foldPHIArgGEPIntoPHI(self, PN: *mut PHINode) -> *mut Instruction {
    let mut FirstInst: *mut GetElementPtrInst = cast(PN.getIncomingValue(0));
    let mut FixedOperands: SmallVector<Value *, 16> = SmallVector<Value *, 16> { FirstInst.op_begin(), FirstInst.op_end() };
    let mut AllBasePointersAreAllocas: bool = true;
    let mut NeededPhi: bool = false;
    let mut NW: GEPNoWrapFlags = FirstInst.getNoWrapFlags();
    for V in drop_begin(PN.incoming_values(), 1) {
        let mut GEP: *mut GetElementPtrInst = dyn_cast(V);
        if !GEP || !GEP.hasOneUser() || GEP.getSourceElementType() != FirstInst.getSourceElementType() || GEP.getNumOperands() != FirstInst.getNumOperands() {
            return null;
        }
        operator(NW, GEP.getNoWrapFlags());
        if AllBasePointersAreAllocas && (!isa(GEP.getOperand(0)) || !GEP.hasAllConstantIndices()) {
            AllBasePointersAreAllocas = false;
        }
        for let mut Op: u32 = 0;
let mut E: u32 = FirstInst.getNumOperands(); Op != E; Op += 1 {
            if FirstInst.getOperand(Op) == GEP.getOperand(Op) {
                continue;
            }
            if isa(FirstInst.getOperand(Op)) || isa(GEP.getOperand(Op)) {
                return null;
            }
            if FirstInst.getOperand(Op).getType() != GEP.getOperand(Op).getType() {
                return null;
            }
            if NeededPhi {
                return null;
            }
            FixedOperands[Op] = null;
            NeededPhi = true;
        }
    }
    if AllBasePointersAreAllocas {
        return null;
    }
    let mut OperandPhis: SmallVector<PHINode *, 16> = FixedOperands.len;
    let mut HasAnyPHIs: bool = false;
    for let mut I: u32 = 0;
let mut E: u32 = FixedOperands.len; I != E; I += 1 {
        if FixedOperands[I] {
            continue;
        }
        let mut FirstOp: *mut Value = FirstInst.getOperand(I);
        let mut NewPN: *mut PHINode = Create(FirstOp.getType(), E, FirstOp.getName() + ".pn", null);
        self.InsertNewInstBefore(NewPN, PN.getIterator());
        NewPN.addIncoming(FirstOp, PN.getIncomingBlock(0));
        OperandPhis[I] = NewPN;
        FixedOperands[I] = NewPN;
        HasAnyPHIs = true;
    }
    if HasAnyPHIs {
        for Incoming in drop_begin(zip(PN.blocks(), PN.incoming_values()), 1) {
            let mut InBB: *mut BasicBlock = get(Incoming);
            let mut InVal: *mut Value = get(Incoming).operator llvm::Value *();
            let mut InGEP: *mut GetElementPtrInst = cast(InVal);
            for let mut Op: u32 = 0;
let mut E: u32 = OperandPhis.len; Op != E; Op += 1 {
                if OperandPhis[Op] {
                    OpPhi;
                } else {
                    OpPhi.addIncoming(InGEP.getOperand(Op), InBB);
                }
            }
        }
    }
    let mut Base: *mut Value = FixedOperands[0];
    let mut NewGEP: *mut GetElementPtrInst = Create(FirstInst.getSourceElementType(), Base, FixedOperands.slice(1), NW, "", null);
    self.PHIArgMergedDebugLoc(NewGEP, PN);
    return NewGEP;
}

fn isSafeAndProfitableToSinkLoad(L: *mut LoadInst) -> bool {
    let mut BBI: iterator = L.getIterator();
    let mut E: iterator = L.getParent().end();
    for operator(BBI); BBI != E; operator(BBI) {
        if operator(BBI).mayWriteToMemory() {
            if dyn_cast(BBI) {
                CB;
            } else if CB.onlyAccessesInaccessibleMemory() {
                continue;
            }
            return false;
        }
    }
    if dyn_cast(L.getOperand(0)) {
        AI;
    } else {
        let mut IsAddressTaken: bool = false;
        for U in AI.users() {
            if isa(U) {
                continue;
            }
            if dyn_cast(U) {
                SI;
            } else {
                if SI.getOperand(1) == AI {
                    continue;
                }
            }
            IsAddressTaken = true;
            break;
        }
        if !IsAddressTaken && AI.isStaticAlloca() {
            return false;
        }
    }
    if dyn_cast(L.getOperand(0)) {
        GEP;
    } else if dyn_cast(GEP.getOperand(0)) {
        AI;
    } else if AI.isStaticAlloca() && GEP.hasAllConstantIndices() {
        return false;
    }
    return true;
}

fn InstCombinerImpl::foldPHIArgLoadIntoPHI(self, PN: *mut PHINode) -> *mut Instruction {
    let mut FirstLI: *mut LoadInst = cast(PN.getIncomingValue(0));
    if !canReplaceOperandWithVariable(FirstLI, 0) {
        return null;
    }
    if !FirstLI.isSimple() {
        return null;
    }
    let mut LoadAlignment: Align = FirstLI.getAlign();
    let mut LoadAddrSpace: u32 = FirstLI.getPointerAddressSpace();
    if FirstLI.getParent() != PN.getIncomingBlock(0) || !isSafeAndProfitableToSinkLoad(FirstLI) {
        return null;
    }
    for Incoming in drop_begin(zip(PN.blocks(), PN.incoming_values()), 1) {
        let mut InBB: *mut BasicBlock = get(Incoming);
        let mut InVal: *mut Value = get(Incoming).operator llvm::Value *();
        let mut LI: *mut LoadInst = dyn_cast(InVal);
        if !LI || !LI.hasOneUser() || !LI.isSimple() {
            return null;
        }
        if LI.getPointerAddressSpace() != LoadAddrSpace {
            return null;
        }
        if !canReplaceOperandWithVariable(LI, 0) {
            return null;
        }
        if LI.getParent() != InBB || !isSafeAndProfitableToSinkLoad(LI) {
            return null;
        }
        LoadAlignment = if LoadAlignment < LI.getAlign() { LoadAlignment } else { LI.getAlign() };
    }
    let mut NewPN: *mut PHINode = Create(FirstLI.getOperand(0).getType(), PN.getNumIncomingValues(), PN.getName() + ".in", null);
    let mut InVal: *mut Value = FirstLI.getOperand(0);
    NewPN.addIncoming(InVal, PN.getIncomingBlock(0));
    let mut NewLI: *mut LoadInst = LoadInst { FirstLI.getType(), NewPN, "", false, LoadAlignment, null };
    NewLI.copyMetadata(*FirstLI, ArrayRef<unsigned int> {});
    for Incoming in drop_begin(zip(PN.blocks(), PN.incoming_values()), 1) {
        let mut BB: *mut BasicBlock = get(Incoming);
        let mut V: *mut Value = get(Incoming).operator llvm::Value *();
        let mut LI: *mut LoadInst = cast(V);
        combineMetadataForCSE(NewLI, LI, true);
        let mut NewInVal: *mut Value = LI.getOperand(0);
        if NewInVal != InVal {
            InVal = null;
        }
        NewPN.addIncoming(NewInVal, BB);
    }
    if InVal {
        NewLI.setOperand(0, InVal);
        NewPN;
    } else {
        self.InsertNewInstBefore(NewPN, PN.getIterator());
    }
    self.PHIArgMergedDebugLoc(NewLI, PN);
    return NewLI;
}

fn InstCombinerImpl::foldPHIArgZextsIntoPHI(self, Phi: *mut PHINode) -> *mut Instruction {
    if Phi.getParent().getTerminator() {
        TI;
    } else if TI.isEHPad() {
        return null;
    }
    let mut NumIncomingValues: u32 = Phi.getNumIncomingValues();
    if NumIncomingValues < 3 {
        return null;
    }
    let mut NarrowType: *mut Type = null;
    for V in Phi.incoming_values() {
        if dyn_cast(V) {
            Zext;
        } else {
            NarrowType = Zext.getSrcTy();
            break;
        }
    }
    if !NarrowType {
        return null;
    }
    let mut NewIncoming: SmallVector<Value *, 4> = SmallVector<Value *, 4> {};
    let mut NumZexts: u32 = 0;
    let mut NumConsts: u32 = 0;
    for V in Phi.incoming_values() {
        if dyn_cast(V) {
            Zext;
        } else {
            if Zext.getSrcTy() != NarrowType || !Zext.hasOneUser() {
                return null;
            }
            NewIncoming.push(Zext.getOperand(0));
            NumZexts += 1;
        }
    }
    if NumConsts == 0 || NumZexts < 2 {
        return null;
    }
    let mut NewPhi: *mut PHINode = Create(NarrowType, NumIncomingValues, Phi.getName() + ".shrunk", null);
    for let mut I: u32 = 0; I != NumIncomingValues; I += 1 {
        NewPhi.addIncoming(NewIncoming[I], Phi.getIncomingBlock(I));
    }
    self.InsertNewInstBefore(NewPhi, Phi.getIterator());
    let mut CI: *mut CastInst = CreateZExtOrBitCast(NewPhi, Phi.getType(), "", null);
    CI.setDebugLoc(getDropped());
    return CI;
}

fn InstCombinerImpl::foldPHIArgOpIntoPHI(self, PN: *mut PHINode) -> *mut Instruction {
    if PN.getParent().getTerminator() {
        TI;
    } else if TI.isEHPad() {
        return null;
    }
    let mut FirstInst: *mut Instruction = cast(PN.getIncomingValue(0));
    if isa(FirstInst) {
        return self.foldPHIArgGEPIntoPHI(PN);
    }
    if isa(FirstInst) {
        return self.foldPHIArgLoadIntoPHI(PN);
    }
    if isa(FirstInst) {
        return self.foldPHIArgInsertValueInstructionIntoPHI(PN);
    }
    if isa(FirstInst) {
        return self.foldPHIArgExtractValueInstructionIntoPHI(PN);
    }
    let mut ConstantOp: *mut Constant = null;
    let mut CastSrcTy: *mut Type = null;
    if isa(FirstInst) {
        CastSrcTy = FirstInst.getOperand(0).getType();
        if PN.getType().isIntegerTy() && CastSrcTy.isIntegerTy() {
            if !self.shouldChangeType(PN.getType(), CastSrcTy) {
                return null;
            }
        }
    } else if isa(FirstInst) || isa(FirstInst) {
        ConstantOp = dyn_cast(FirstInst.getOperand(1));
        if !ConstantOp {
            return self.foldPHIArgBinOpIntoPHI(PN);
        }
    } else {
        return null;
    }
    for V in drop_begin(PN.incoming_values(), 1) {
        let mut I: *mut Instruction = dyn_cast(V);
        if !I || !I.hasOneUser() || !I.isSameOperationAs(FirstInst, 0) {
            return null;
        }
        if CastSrcTy {
            if I.getOperand(0).getType() != CastSrcTy {
                return null;
            }
        } else if I.getOperand(1) != ConstantOp {
            return null;
        }
    }
    let mut NewPN: *mut PHINode = Create(FirstInst.getOperand(0).getType(), PN.getNumIncomingValues(), PN.getName() + ".in", null);
    let mut InVal: *mut Value = FirstInst.getOperand(0);
    NewPN.addIncoming(InVal, PN.getIncomingBlock(0));
    for Incoming in drop_begin(zip(PN.blocks(), PN.incoming_values()), 1) {
        let mut BB: *mut BasicBlock = get(Incoming);
        let mut V: *mut Value = get(Incoming).operator llvm::Value *();
        let mut NewInVal: *mut Value = cast(V).getOperand(0);
        if NewInVal != InVal {
            InVal = null;
        }
        NewPN.addIncoming(NewInVal, BB);
    }
    let mut PhiVal: *mut Value = null;
    if InVal {
        PhiVal = InVal;
        NewPN;
    } else {
        self.InsertNewInstBefore(NewPN, PN.getIterator());
        PhiVal = NewPN;
    }
    if dyn_cast(FirstInst) {
        FirstCI;
    } else {
        let mut NewCI: *mut CastInst = Create(FirstCI.getOpcode(), PhiVal, PN.getType(), "", null);
        self.PHIArgMergedDebugLoc(NewCI, PN);
        return NewCI;
    }
    if dyn_cast(FirstInst) {
        BinOp;
    } else {
        BinOp = Create(BinOp.getOpcode(), PhiVal, ConstantOp, "", null);
        BinOp.copyIRFlags(PN.getIncomingValue(0), true);
        for V in drop_begin(PN.incoming_values(), 1) {
            BinOp.andIRFlags(V);
        }
        self.PHIArgMergedDebugLoc(BinOp, PN);
        return BinOp;
    }
    let mut CIOp: *mut CmpInst = cast(FirstInst);
    let mut NewCI: *mut CmpInst = Create(CIOp.getOpcode(), CIOp.getPredicate(), PhiVal, ConstantOp, "", null);
    self.PHIArgMergedDebugLoc(NewCI, PN);
    return NewCI;
}

fn PHIsEqualValue(PN: *mut PHINode, NonPhiInVal: *mut *mut Value, ValueEqualPHIs: *mut SmallPtrSetImpl<PHINode *>) -> bool {
    if !ValueEqualPHIs.insert(PN).second {
        return true;
    }
    if ValueEqualPHIs.len >= 16 {
        return false;
    }
    for Op in PN.incoming_values() {
        if dyn_cast(Op) {
            OpPN;
        } else {
            if !PHIsEqualValue(OpPN, NonPhiInVal, ValueEqualPHIs) {
                if NonPhiInVal {
                    return false;
                }
                NonPhiInVal = OpPN;
            }
        }
    }
    return true;
}

fn getAnyNonZeroConstInt(PN: *mut PHINode) -> *mut ConstantInt {
    assert!(isa(PN.getType()), "Expect only integer type phi");
    for V in PN.operands() {
        if dyn_cast(V) {
            ConstVA;
        } else if !ConstVA.isZero() {
            return ConstVA;
        }
    }
    return get(cast(PN.getType()), 1, false, false);
}

struct PHIUsageRecord {
    PHIId: u32,
    Shift: u32,
    Inst: *mut Instruction,
}

fn PHIUsageRecord::operator<(self: *PHIUsageRecord, RHS: *PHIUsageRecord) -> bool {
    if self.PHIId < RHS.PHIId {
        return true;
    }
    if self.PHIId > RHS.PHIId {
        return false;
    }
    if self.Shift < RHS.Shift {
        return true;
    }
    if self.Shift > RHS.Shift {
        return false;
    }
    return self.Inst.getType().getPrimitiveSizeInBits().operator unsigned long long() < RHS.Inst.getType().getPrimitiveSizeInBits().operator unsigned long long();
}

struct LoweredPHIRecord {
    PN: *mut PHINode,
    Shift: u32,
    Width: u32,
}

fn InstCombinerImpl::SliceUpIllegalIntegerPHI(self, FirstPhi: *mut PHINode) -> *mut Instruction {
    let mut PHIUsers: SmallVector<PHIUsageRecord, 16> = SmallVector<PHIUsageRecord, 16> {};
    let mut PHIsToSlice: SmallVector<PHINode *, 8> = SmallVector<PHINode *, 8> {};
    let mut PHIsInspected: SmallPtrSet<PHINode *, 8> = SmallPtrSet<PHINode *, 8> {};
    PHIsToSlice.push(&mut FirstPhi);
    PHIsInspected.insert(&mut FirstPhi);
    for let mut PHIId: u32 = 0; PHIId != PHIsToSlice.len; PHIId += 1 {
        let mut PN: *mut PHINode = PHIsToSlice[PHIId];
        for U in PN.users() {
            let mut UserI: *mut Instruction = cast(U);
            if dyn_cast(UserI) {
                UserPN;
            } else {
                if PHIsInspected.insert(UserPN).second {
                    PHIsToSlice.push(UserPN);
                }
                continue;
            }
            if isa(UserI) {
                PHIUsers.push(PHIUsageRecord { PHIId: PHIId, Shift: 0, Inst: UserI });
                continue;
            }
            if UserI.getOpcode() != LShr || !UserI.hasOneUse() || !isa(UserI.user_back()) || !isa(UserI.getOperand(1)) {
                return null;
            }
            let mut SizeInBits: u32 = UserI.getType().getScalarSizeInBits();
            if cast(UserI.getOperand(1)).getValue().uge(SizeInBits) {
                return null;
            }
            let mut Shift: u32 = cast(UserI.getOperand(1)).getZExtValue();
            PHIUsers.push(PHIUsageRecord { PHIId: PHIId, Shift: Shift, Inst: UserI.user_back() });
        }
    }
    for PN in PHIsToSlice {
        for Incoming in zip(PN.blocks(), PN.incoming_values()) {
            let mut BB: *mut BasicBlock = get(Incoming);
            let mut V: *mut Value = get(Incoming).operator llvm::Value *();
            let mut II: *mut InvokeInst = dyn_cast(V);
            if !II {
                continue;
            }
            if II.getParent() != BB {
                continue;
            }
            return null;
        }
        for Pred in PN.blocks() {
            if !Pred.hasInsertionPt() {
                return null;
            }
        }
    }
    if PHIUsers.is_empty() {
        return self.replaceInstUsesWith(FirstPhi, get(FirstPhi.getType()));
    }
    array_pod_sort(PHIUsers.begin(), PHIUsers.end());
    while true {
        {
        if DebugFlag && isCurrentDebugType("instcombine", 1) {
            dbgs() << "SLICING UP PHI: " << FirstPhi << 10;
            for let mut I: u32 = 1; I != PHIsToSlice.len; I += 1 {
                dbgs() << "AND USER PHI #" << I << ": " << *PHIsToSlice[I] << 10;
            }
        }
    }
        if !(false) { break; }
    }
    let mut PredValues: DenseMap<BasicBlock *, Value *> = DenseMap<BasicBlock *, Value *> {};
    let mut ExtractedVals: DenseMap<LoweredPHIRecord, PHINode *> = DenseMap<LoweredPHIRecord, PHINode *> {};
    for let mut UserI: u32 = 0;
let mut UserE: u32 = PHIUsers.len; UserI != UserE; UserI += 1 {
        let mut PHIId: u32 = PHIUsers[UserI].PHIId;
        let mut PN: *mut PHINode = PHIsToSlice[PHIId];
        let mut Offset: u32 = PHIUsers[UserI].Shift;
        let mut Ty: *mut Type = PHIUsers[UserI].Inst.getType();
        let mut EltPHI: *mut PHINode = null;
        if (EltPHI = ExtractedVals[LoweredPHIRecord { PN: PN, Shift: Offset, Width: Ty }]) == null {
            EltPHI = Create(Ty, PN.getNumIncomingValues(), PN.getName() + ".off" + Offset, PN.getIterator());
            assert!(EltPHI.getType() != PN.getType(), "Truncate didn't shrink phi?");
            for Incoming in zip(PN.blocks(), PN.incoming_values()) {
                let mut Pred: *mut BasicBlock = get(Incoming);
                let mut InVal: *mut Value = get(Incoming).operator llvm::Value *();
                let mut PredVal: *mut *mut Value = PredValues[Pred];
                if PredVal {
                    EltPHI.addIncoming(PredVal, Pred);
                    continue;
                }
                if InVal == PN {
                    PredVal = EltPHI;
                    EltPHI.addIncoming(PredVal, Pred);
                    continue;
                }
                if ExtractedVals[LoweredPHIRecord { PN: PN, Shift: Offset, Width: Ty }] {
                    Res;
                } else {
                    PredVal = Res;
                    EltPHI.addIncoming(PredVal, Pred);
                    continue;
                }
                self.Builder.SetInsertPoint(Pred.getTerminator());
                let mut Res: *mut Value = InVal;
                if Offset {
                    Res = self.Builder.CreateLShr(Res, get(InVal.getType(), Offset, false, false), "extract", false);
                }
                Res = self.Builder.CreateTrunc(Res, Ty, "extract.t", false, false);
                PredVal = Res;
                EltPHI.addIncoming(Res, Pred);
                if dyn_cast(InVal) {
                    OldInVal;
                } else if PHIsInspected.count(OldInVal) {
                    let mut RefPHIId: u32 = find(PHIsToSlice, OldInVal) - PHIsToSlice.begin();
                    PHIUsers.push(PHIUsageRecord { PHIId: RefPHIId, Shift: Offset, Inst: cast(Res) });
                    UserE += 1;
                }
            }
            PredValues.clear();
            while true {
                {
                if DebugFlag && isCurrentDebugType("instcombine", 1) {
                    dbgs() << "  Made element PHI for offset " << Offset << ": " << *EltPHI << 10;
                }
            }
                if !(false) { break; }
            }
            ExtractedVals[LoweredPHIRecord { PN: PN, Shift: Offset, Width: Ty }] = EltPHI;
        }
        self.replaceInstUsesWith(*PHIUsers[UserI].Inst, EltPHI);
    }
    let mut Poison: *mut Value = get(FirstPhi.getType());
    for PHI in drop_begin(PHIsToSlice, 1) {
        self.replaceInstUsesWith(*PHI, Poison);
    }
    return self.replaceInstUsesWith(FirstPhi, Poison);
}

fn simplifyUsingControlFlow(Self: *mut InstCombiner, PN: *mut PHINode, DT: *DominatorTree) -> *mut Value {
    if !all_of(PN.operands(), IsaPred) {
        return null;
    }
    let mut BB: *mut BasicBlock = PN.getParent();
    if !DT.isReachableFromEntry(BB) {
        return null;
    }
    let mut Context: *mut LLVMContext = PN.getContext();
    let mut IDom: *mut BasicBlock = DT.getNode(BB).getIDom().getBlock();
    let mut Cond: *mut Value = null;
    let mut SuccForValue: SmallDenseMap<ConstantInt *, BasicBlock *, 8> = SmallDenseMap<ConstantInt *, BasicBlock *, 8> {};
    let mut SuccCount: SmallDenseMap<BasicBlock *, unsigned int, 8> = SmallDenseMap<BasicBlock *, unsigned int, 8> {};
    let mut AddSucc: Closure_5 = Closure_5 { SuccForValue: &mut SuccForValue, SuccCount: &mut SuccCount };
    if dyn_cast(IDom.getTerminator()) {
        BI;
    } else {
        Cond = BI.getCondition();
        AddSucc.call(getTrue(Context), BI.getSuccessor(0));
        AddSucc.call(getFalse(Context), BI.getSuccessor(1));
    }
    if Cond.getType() != PN.getType() {
        return null;
    }
    let mut Invert: optional<bool> = optional<bool> {};
    for Pair in zip(PN.incoming_values(), PN.blocks()) {
        let mut Input: *mut ConstantInt = cast(get(Pair));
        let mut Pred: *mut BasicBlock = get(Pair);
        let mut IsCorrectInput: Closure_6 = Closure_6 { SuccForValue: &mut SuccForValue, SuccCount: &mut SuccCount, DT: &mut DT, IDom: &mut IDom, Pred: &mut Pred, BB: &mut BB };
        let mut NeedsInvert: bool = false;
        if IsCorrectInput.call(Input) {
            NeedsInvert = false;
        } else if IsCorrectInput.call(cast(getNot(Input))) {
            NeedsInvert = true;
        } else {
            return null;
        }
        if Invert && operator(Invert) != NeedsInvert {
            return null;
        }
        Invert = NeedsInvert;
    }
    if !operator(Invert) {
        return Cond;
    }
    let mut InsertPt: iterator = BB.getFirstInsertionPt();
    if InsertPt != BB.end() {
        Self.Builder.SetInsertPoint(InsertPt);
        return Self.Builder.CreateNot(Cond, "");
    }
    return null;
}

fn foldDependentIVs(PN: *mut PHINode, Builder: *mut IRBuilderBase) -> *mut Value {
    let mut BB: *mut BasicBlock = PN.getParent();
    if PN.getNumIncomingValues() != 2 {
        return null;
    }
    let mut Start: *mut Value = null;
    let mut IvNext: *mut Instruction = null;
    let mut Iv2Next: *mut BinaryOperator = null;
    let mut MatchOuterIV: Closure_7 = Closure_7 { Iv2Next: &mut Iv2Next, Start: &mut Start, IvNext: &mut IvNext };
    if !MatchOuterIV.call(PN.getIncomingValue(0), PN.getIncomingValue(1)) && !MatchOuterIV.call(PN.getIncomingValue(1), PN.getIncomingValue(0)) {
        return null;
    }
    let mut Iv2: *mut PHINode = null;
    let mut Iv2Start: *mut Value = null;
    let mut Iv2Step: *mut Value = null;
    if !matchSimpleRecurrence(Iv2Next, Iv2, Iv2Start, Iv2Step) || Iv2.getParent() != BB {
        return null;
    }
    let mut BO: *mut BinaryOperator = dyn_cast(IvNext);
    let mut Identity: *mut Constant = if BO { getBinOpIdentity(BO.getOpcode(), Iv2Start.getType(), false, false) } else { getNullValue(Iv2Start.getType()) };
    if Iv2Start != Identity {
        return null;
    }
    Builder.SetInsertPoint(BB.getFirstInsertionPt());
    if !BO {
        let mut GEP: *mut GEPOperator = cast(IvNext);
        return Builder.CreateGEP(GEP.getSourceElementType(), Start, Iv2, "", cast(IvNext).getNoWrapFlags());
    }
    assert!(BO.isCommutative(), "Must be commutative");
    let mut Res: *mut Value = Builder.CreateBinOp(BO.getOpcode(), Iv2, Start, "", null);
    cast(Res).copyIRFlags(BO, true);
    return Res;
}

fn InstCombinerImpl::visitPHINode(self, PN: *mut PHINode) -> *mut Instruction {
    if simplifyInstruction(&mut PN, self.SQ.getWithInstruction(&mut PN)) {
        V;
    } else {
        return self.replaceInstUsesWith(PN, V);
    }
    if self.foldPHIArgZextsIntoPHI(PN) {
        Result;
    } else {
        return Result;
    }
    if self.foldPHIArgIntToPtrToPHI(PN) {
        Result;
    } else {
        return Result;
    }
    let mut Inst0: *mut Instruction = dyn_cast(PN.getIncomingValue(0));
    let mut Inst1: *mut Instruction = dyn_cast(PN.getIncomingValue(1));
    if Inst0 && Inst1 && Inst0.getOpcode() == Inst1.getOpcode() && Inst0.hasOneUser() {
        if self.foldPHIArgOpIntoPHI(PN) {
            Result;
        } else {
            return Result;
        }
    }
    if PN.getType().isPointerTy() && PN.getParent().hasInsertionPt() {
        let mut IV0: *mut Value = PN.getIncomingValue(0);
        let mut IV0Stripped: *mut Value = IV0.stripPointerCasts();
        let mut CheckedIVs: SmallPtrSet<Value *, 4> = SmallPtrSet<Value *, 4> {};
        CheckedIVs.insert(IV0);
        if IV0 != IV0Stripped && all_of(PN.incoming_values(), Closure_8 { CheckedIVs: &mut CheckedIVs, IV0Stripped: IV0Stripped }) {
            return CreatePointerCast(IV0Stripped, PN.getType(), "", null);
        }
    }
    if self.foldDeadPhiWeb(PN) {
        return null;
    }
    if PN.hasOneUse() {
        if self.foldIntegerTypedPHI(PN) {
            return null;
        }
        let mut PHIUser: *mut Instruction = cast(PN.user_back());
        if PHIUser.hasOneUse() && (isa(PHIUser) || isa(PHIUser) || isa(PHIUser)) && PHIUser.user_back() == &mut PN {
            return self.replaceInstUsesWith(PN, get(PN.getType()));
        }
    }
    if !PN.hasNUsesOrMore(3) {
        let mut DropPoisonFlags: SmallVector<Instruction *> = SmallVector<Instruction *> {};
        let mut AllUsesOfPhiEndsInCmp: bool = all_of(PN.users(), Closure_9 { PN: &mut PN, DropPoisonFlags: &mut DropPoisonFlags });
        if AllUsesOfPhiEndsInCmp {
            let mut NonZeroConst: *mut ConstantInt = null;
            let mut MadeChange: bool = false;
            for let mut I: u32 = 0;
let mut E: u32 = PN.getNumIncomingValues(); I != E; I += 1 {
                let mut CtxI: *mut Instruction = PN.getIncomingBlock(I).getTerminator();
                let mut VA: *mut Value = PN.getIncomingValue(I);
                if isKnownNonZero(VA, self.getSimplifyQuery().getWithInstruction(CtxI), 0) {
                    if !NonZeroConst {
                        NonZeroConst = getAnyNonZeroConstInt(PN);
                    }
                    if NonZeroConst != VA {
                        self.replaceOperand(PN, I, NonZeroConst);
                        for I in DropPoisonFlags {
                            I.dropPoisonGeneratingFlags();
                        }
                        MadeChange = true;
                    }
                }
            }
            if MadeChange {
                return &mut PN;
            }
        }
    }
    {
        let mut InValNo: u32 = 0;
        let mut NumIncomingVals: u32 = PN.getNumIncomingValues();
        while InValNo != NumIncomingVals && isa(PN.getIncomingValue(InValNo)) {
            InValNo += 1;
        }
        let mut NonPhiInVal: *mut Value = if InValNo != NumIncomingVals { PN.getIncomingValue(InValNo) } else { null };
        if NonPhiInVal {
            for InValNo += 1; InValNo != NumIncomingVals; InValNo += 1 {
                let mut OpVal: *mut Value = PN.getIncomingValue(InValNo);
                if OpVal != NonPhiInVal && !isa(OpVal) {
                    break;
                }
            }
        }
        if InValNo == NumIncomingVals {
            let mut ValueEqualPHIs: SmallPtrSet<PHINode *, 16> = SmallPtrSet<PHINode *, 16> {};
            if PHIsEqualValue(&mut PN, NonPhiInVal, ValueEqualPHIs) {
                return self.replaceInstUsesWith(PN, NonPhiInVal);
            }
        }
    }
    let mut Res: pair<iterator, bool> = self.PredOrder.try_emplace(PN.getParent());
    if !Res.second {
        let mut Preds: *BasicBlock *> const = operator(Res.first).second;
        for let mut I: u32 = 0;
let mut E: u32 = PN.getNumIncomingValues(); I != E; I += 1 {
            let mut BBA: *mut BasicBlock = PN.getIncomingBlock(I);
            let mut BBB: *mut BasicBlock = Preds[I];
            if BBA != BBB {
                let mut VA: *mut Value = PN.getIncomingValue(I);
                let mut J: u32 = PN.getBasicBlockIndex(BBB);
                let mut VB: *mut Value = PN.getIncomingValue(J);
                PN.setIncomingBlock(I, BBB);
                PN.setIncomingValue(I, VB);
                PN.setIncomingBlock(J, BBA);
                PN.setIncomingValue(J, VA);
            }
        }
    } else {
        append_range(operator(Res.first).second, PN.blocks());
    }
    for IdenticalPN in PN.getParent().phis() {
        if &mut IdenticalPN == &mut PN {
            continue;
        }
        if !PN.isIdenticalToWhenDefined(&mut IdenticalPN, false) {
            continue;
        }
        operator(NumPHICSEs);
        return self.replaceInstUsesWith(PN, &mut IdenticalPN);
    }
    if PN.getType().isIntegerTy() && !self.DL.isLegalInteger(PN.getType().getPrimitiveSizeInBits().operator unsigned long long()) {
        if self.SliceUpIllegalIntegerPHI(PN) {
            Res;
        } else {
            return Res;
        }
    }
    if simplifyUsingControlFlow(*self, PN, self.DT) {
        V;
    } else {
        return self.replaceInstUsesWith(PN, V);
    }
    if foldDependentIVs(PN, self.Builder) {
        Res;
    } else {
        return self.replaceInstUsesWith(PN, Res);
    }
    return null;
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, IIP: *mut Instruction) -> bool {
        for U in IIP.users() {
            let mut Ptr: *mut Value = null;
            if dyn_cast(U) {
                LoadI;
            } else {
                Ptr = LoadI.getPointerOperand();
            }
            if Ptr && Ptr == IIP {
                return true;
            }
        }
        return false;
    }

struct Closure_2 {
    PtrPHI: *mut PHINode,
}

unsafe fn Closure_2::call(self: *mut Closure_2) {
            let mut BB: *mut BasicBlock = get(BlockAndValue);
            let mut V: *mut Value = get(BlockAndValue);
            return (*self.PtrPHI).getIncomingValueForBlock(BB) != V;
        }

struct Closure_3 {
    IntToPtr: *mut *mut IntToPtrInst,
}

unsafe fn Closure_3::call(self: *mut Closure_3, V: *mut Value) -> bool {
        return (V.getType() != (*self.IntToPtr).getType()) || isa(V);
    }

struct Closure_4 {
    IntToPtr: *mut *mut IntToPtrInst,
}

unsafe fn Closure_4::call(self: *mut Closure_4, V: *mut Value) -> bool {
        if V.getType() == (*self.IntToPtr).getType() {
            return false;
        }
        let mut Inst: *mut Instruction = dyn_cast(V);
        if !Inst {
            return false;
        }
        if Inst.isTerminator() {
            return true;
        }
        let mut BB: *mut BasicBlock = Inst.getParent();
        if isa(Inst) && !BB.hasInsertionPt() {
            return true;
        }
        return false;
    }

struct Closure_5 {
    SuccForValue: *mut SmallDenseMap<ConstantInt *, BasicBlock *, 8>,
    SuccCount: *mut SmallDenseMap<BasicBlock *, unsigned int, 8>,
}

unsafe fn Closure_5::call(self: *mut Closure_5, C: *mut ConstantInt, Succ: *mut BasicBlock) {
        (*self.SuccForValue)[C] = Succ;
        (*self.SuccCount)[Succ] += 1;
    }

struct Closure_6 {
    SuccForValue: *mut SmallDenseMap<ConstantInt *, BasicBlock *, 8>,
    SuccCount: *mut SmallDenseMap<BasicBlock *, unsigned int, 8>,
    DT: *mut DominatorTree,
    IDom: *mut *mut BasicBlock,
    Pred: *mut *mut BasicBlock,
    BB: *mut *mut BasicBlock,
}

unsafe fn Closure_6::call(self: *mut Closure_6, Input: *mut ConstantInt) -> bool {
            let mut It: iterator = (*self.SuccForValue).find(Input);
            return It != (*self.SuccForValue).end() && (*self.SuccCount)[operator(It).second] == 1 && (*self.DT).dominates(BasicBlockEdge { Start: (*self.IDom), End: operator(It).second }, BasicBlockEdge { Start: (*self.Pred), End: (*self.BB) });
        }

struct Closure_7 {
    Iv2Next: *mut *mut BinaryOperator,
    Start: *mut *mut Value,
    IvNext: *mut *mut Instruction,
}

unsafe fn Closure_7::call(self: *mut Closure_7, V1: *mut Value, V2: *mut Value) -> bool {
        if match(V2, m_c_BinOp(m_Specific(V1), m_BinOp((*self.Iv2Next)))) || match(V2, m_GEP(m_Specific(V1), m_BinOp((*self.Iv2Next)))) {
            (*self.Start) = V1;
            (*self.IvNext) = cast(V2);
            return true;
        }
        return false;
    }

struct Closure_8 {
    CheckedIVs: *mut SmallPtrSet<Value *, 4>,
    IV0Stripped: *mut Value,
}

unsafe fn Closure_8::call(self: *mut Closure_8, IV: *mut Value) -> bool {
            return !(*self.CheckedIVs).insert(IV).second || self.IV0Stripped == IV.stripPointerCasts();
        }

struct Closure_9 {
    PN: *mut PHINode,
    DropPoisonFlags: *mut SmallVector<Instruction *>,
}

unsafe fn Closure_9::call(self: *mut Closure_9, U: *mut User) -> bool {
            let mut CmpInst: *mut ICmpInst = dyn_cast(U);
            if !CmpInst {
                if U.hasOneUse() && match(U, m_c_Or(m_Specific(&mut (*self.PN)), m_Value())) {
                    (*self.DropPoisonFlags).push(cast(U));
                    CmpInst = dyn_cast(U.user_back());
                }
            }
            if !CmpInst || !isa((*self.PN).getType()) || !CmpInst.isEquality() || !match(CmpInst.getOperand(1), m_Zero()) {
                return false;
            }
            return true;
        }
