struct Closure_7 {
    PN: *mut PHINode,
}

unsafe fn Closure_7::call(self: *mut Closure_7, U: *mut User) -> bool {
            let mut CmpInst: *mut auto = dyn_cast(U);
            if operator!() {
                if U.hasOneUse() && match(U, m_c_Or(m_Specific(&mut (*self.PN)), m_Value())) {
                    DropPoisonFlags()(cast(U));
                    CmpInst() = dyn_cast(U.user_back());
                }
            }
            if operator!() || operator!(isa((*self.PN).getType)) || operator!() || operator!(match((1), m_Zero())) {
                return false;
            }
            return true;
        }
