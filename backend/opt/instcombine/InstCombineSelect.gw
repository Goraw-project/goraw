                return null;
            }
            if TI.getOpcode() != BitCast && (operator!(TI.hasOneUse) || operator!(FI.hasOneUse)) {
                return null;
            }
        } else if operator!(TI.hasOneUse) || operator!(FI.hasOneUse) {
            return null;
