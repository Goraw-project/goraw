static mut ProfcheckDisableMetadataFixes: opt<bool> = zeroed();

fn foldSelectBinOpIdentity(Sel: *mut SelectInst, TLI: *TargetLibraryInfo, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut X: *mut Value = null;
    let mut C: *mut Constant = null;
    let mut Pred: CmpPredicate = CmpPredicate {};
    if !match(Sel.getCondition(), m_Cmp(Pred, m_Value(X), m_Constant(C))) {
        return null;
    }
    let mut IsEq: bool = false;
    if isEquality(Pred.operator llvm::CmpInst::Predicate()) {
        IsEq = Pred == ICMP_EQ;
    } else if Pred == FCMP_OEQ {
        IsEq = true;
    } else if Pred == FCMP_UNE {
        IsEq = false;
    } else {
        return null;
    }
    let mut BO: *mut BinaryOperator = null;
    if !match(Sel.getOperand(if IsEq { 1 } else { 2 }), m_BinOp(BO)) {
        return null;
    }
    let mut IsAbsorbingValue: bool = false;
    let mut Y: *mut Value = null;
    if BO.isCommutative() {
        if match(BO, m_c_FMul(m_FAbs(m_Specific(X)), m_Value(Y))) && match(C, m_AnyZeroFP()) && IC.fmulByZeroIsZero(Y, BO.getFastMathFlags(), &mut Sel) {
            IsAbsorbingValue = true;
        } else if !match(BO, m_c_BinOp(m_Value(Y), m_Specific(X))) {
            return null;
        }
    } else {
        if !match(BO, m_BinOp(m_Value(Y), m_Specific(X))) {
            return null;
        }
    }
    let mut Ty: *mut Type = BO.getType();
    let mut FoldedVal: *mut Value = null;
    if IsAbsorbingValue {
        FoldedVal = C;
    } else {
        let mut IdC: *mut Constant = getBinOpIdentity(BO.getOpcode(), Ty, true, false);
        if IdC != C {
            if !IdC || !isFPPredicate(Pred.operator llvm::CmpInst::Predicate()) {
                return null;
            }
            if !match(IdC, m_AnyZeroFP()) || !match(C, m_AnyZeroFP()) {
                return null;
            }
        }
        if dyn_cast(BO) {
            FPO;
        } else if !FPO.hasNoSignedZeros() && !cannotBeNegativeZero(Y, IC.getSimplifyQuery().getWithInstruction(&mut Sel), 0) {
            return null;
        }
        FoldedVal = Y;
    }
    return IC.replaceOperand(Sel, if IsEq { 1 } else { 2 }, FoldedVal);
}

fn foldSelectICmpAnd(Sel: *mut SelectInst, CondVal: *mut Value, TrueVal: *mut Value, FalseVal: *mut Value, V: *mut Value, AndMask: *APInt, CreateAnd: bool, Builder: *mut BuilderTy) -> *mut Value {
    let mut SelTC: *APInt = null;
    let mut SelFC: *APInt = null;
    if !match(TrueVal, m_APInt(SelTC)) || !match(FalseVal, m_APInt(SelFC)) {
        return null;
    }
    let mut SelType: *mut Type = Sel.getType();
    let mut TC: *APInt = *SelTC;
    let mut FC: *APInt = *SelFC;
    if !TC.isZero() && !FC.isZero() {
        if TC.getBitWidth() != AndMask.getBitWidth() {
            return null;
        }
        if CreateAnd && !CondVal.hasOneUse() {
            return null;
        }
        let mut TCC: *mut Constant = get(SelType, TC);
        let mut FCC: *mut Constant = get(SelType, FC);
        let mut MaskC: *mut Constant = get(SelType, AndMask);
        for Opc in [Or, Xor, Add, Sub] {
            if ConstantFoldBinaryOpOperands(Opc, TCC, MaskC, Sel.getDataLayout()) == FCC {
                if CreateAnd {
                    V = Builder.CreateAnd(V, MaskC, "");
                }
                return Builder.CreateBinOp(Opc, TCC, V, "", null);
            }
        }
        return null;
    }
    if !TC.isPowerOf2() && !FC.isPowerOf2() {
        return null;
    }
    let mut ValC: *APInt = if !TC.isZero() { TC } else { FC };
    let mut ValZeros: u32 = ValC.logBase2();
    let mut AndZeros: u32 = AndMask.logBase2();
    let mut ShouldNotVal: bool = !TC.isZero();
    let mut NeedShift: bool = ValZeros != AndZeros;
    let mut NeedZExtTrunc: bool = SelType.getScalarSizeInBits() != V.getType().getScalarSizeInBits();
    if CreateAnd + ShouldNotVal + NeedShift + NeedZExtTrunc > 1 + CondVal.hasOneUse() {
        return null;
    }
    if CreateAnd {
        V = Builder.CreateAnd(V, get(V.getType(), AndMask), "");
    }
    if ValZeros > AndZeros {
        V = Builder.CreateZExtOrTrunc(V, SelType, "");
        V = Builder.CreateShl(V, ValZeros - AndZeros, "", false, false);
    } else if ValZeros < AndZeros {
        V = Builder.CreateLShr(V, AndZeros - ValZeros, "", false);
        V = Builder.CreateZExtOrTrunc(V, SelType, "");
    } else {
        V = Builder.CreateZExtOrTrunc(V, SelType, "");
    }
    if ShouldNotVal {
        V = Builder.CreateXor(V, ValC, "");
    }
    return V;
}

fn getSelectFoldableOperands(I: *mut BinaryOperator) -> u32 {
    match I.getOpcode() {
        Add => {
            FAdd;
        },
        Sub => {
            FSub;
        },
        _ => {
            return 0;
        },
    }
}

fn InstCombinerImpl::foldSelectOpOp(self, SI: *mut SelectInst, TI: *mut Instruction, FI: *mut Instruction) -> *mut Instruction {
    let mut Cond: *mut Value = SI.getCondition();
    let mut CondTy: *mut Type = Cond.getType();
    if TI.getNumOperands() == 1 && TI.isCast() {
        let mut FIOpndTy: *mut Type = FI.getOperand(0).getType();
        if TI.getOperand(0).getType() != FIOpndTy {
            return null;
        }
        if dyn_cast(CondTy) {
            CondVTy;
        } else {
            if !FIOpndTy.isVectorTy() || CondVTy.getElementCount() != cast(FIOpndTy).getElementCount() {
                return null;
            }
            if TI.getOpcode() != BitCast && (!TI.hasOneUse() || !FI.hasOneUse()) {
                return null;
            }
        }
        let mut NewSI: *mut Value = self.Builder.CreateSelect(Cond, TI.getOperand(0), FI.getOperand(0), SI.getName() + ".v", &mut SI);
        return Create(TI.getOpcode(), NewSI, TI.getType(), "", null);
    }
    let mut OtherOpT: *mut Value = null;
    let mut OtherOpF: *mut Value = null;
    let mut MatchIsOpZero: bool = false;
    let mut getCommonOp: Closure_1 = Closure_1 { OtherOpT: &mut OtherOpT, OtherOpF: &mut OtherOpF, MatchIsOpZero: &mut MatchIsOpZero };
    if TI.hasOneUse() || FI.hasOneUse() {
        let mut X: *mut Value = null;
        let mut Y: *mut Value = null;
        if match(TI, m_FNeg(m_Value(X))) && match(FI, m_FNeg(m_Value(Y))) {
            let mut FMF: FastMathFlags = TI.getFastMathFlags();
            operator(FMF, FI.getFastMathFlags());
            operator(FMF, SI.getFastMathFlags());
            let mut NewSel: *mut Value = self.Builder.CreateSelect(Cond, X, Y, SI.getName() + ".v", &mut SI);
            if dyn_cast(NewSel) {
                NewSelI;
            } else {
                NewSelI.setFastMathFlags(FMF);
            }
            let mut NewFNeg: *mut Instruction = CreateFNeg(NewSel, "");
            NewFNeg.setFastMathFlags(FMF);
            return NewFNeg;
        }
        let mut TII: *mut IntrinsicInst = dyn_cast(TI);
        let mut FII: *mut IntrinsicInst = dyn_cast(FI);
        if TII && FII && TII.getIntrinsicID() == FII.getIntrinsicID() {
            if match(TII, m_MaxOrMin(m_Value(), m_Value())) {
                if getCommonOp.call(TI, FI, true, false) {
                    MatchOp;
                } else {
                    let mut NewSel: *mut Value = self.Builder.CreateSelect(Cond, OtherOpT, OtherOpF, "minmaxop", &mut SI);
                    return Create(TII.getCalledFunction(), [NewSel, MatchOp], ArrayRef<OperandBundleDef> {}, "", null);
                }
            }
            if TII.getIntrinsicID() == ldexp {
                let mut LdexpVal0: *mut Value = TII.getArgOperand(0);
                let mut LdexpExp0: *mut Value = TII.getArgOperand(1);
                let mut LdexpVal1: *mut Value = FII.getArgOperand(0);
                let mut LdexpExp1: *mut Value = FII.getArgOperand(1);
                if LdexpExp0.getType() == LdexpExp1.getType() {
                    let mut SelectFPOp: *mut FPMathOperator = cast(&mut SI);
                    let mut FMF: FastMathFlags = cast(TII).getFastMathFlags();
                    operator(FMF, cast(FII).getFastMathFlags());
                    operator(FMF, SelectFPOp.getFastMathFlags());
                    let mut SelectVal: *mut Value = self.Builder.CreateSelect(Cond, LdexpVal0, LdexpVal1, "", null);
                    let mut SelectExp: *mut Value = self.Builder.CreateSelect(Cond, LdexpExp0, LdexpExp1, "", null);
                    let mut NewLdexp: *mut Value = self.Builder.CreateIntrinsic(TII.getType(), ldexp, [SelectVal, SelectExp], FMF, "", function_ref<void (CallInst *)> { Closure_2 {}, null, null });
                    return self.replaceInstUsesWith(SI, NewLdexp);
                }
            }
        }
        let mut CreateCmpSel: Closure_3 = Closure_3 { getCommonOp: &mut getCommonOp, TI: &mut TI, FI: &mut FI, cap_3: self, Cond: &mut Cond, OtherOpT: &mut OtherOpT, OtherOpF: &mut OtherOpF, SI: &mut SI, MatchIsOpZero: &mut MatchIsOpZero };
        let mut TPred: CmpPredicate = CmpPredicate {};
        let mut FPred: CmpPredicate = CmpPredicate {};
        if match(TI, m_ICmp(TPred, m_Value(), m_Value())) && match(FI, m_ICmp(FPred, m_Value(), m_Value())) {
            if CreateCmpSel.call(getMatching(TPred, FPred), false) {
                R;
            } else {
                return R;
            }
            if CreateCmpSel.call(getMatching(TPred, getSwappedCmpPredicate(FPred)), true) {
                R;
            } else {
                return R;
            }
        }
    }
    if TI.getNumOperands() != 2 || FI.getNumOperands() != 2 || !TI.isSameOperationAs(FI, 0) || (!isa(TI) && !isa(TI)) || !TI.hasOneUse() || !FI.hasOneUse() {
        return null;
    }
    let mut MatchOp: *mut Value = getCommonOp.call(TI, FI, TI.isCommutative(), false);
    if !MatchOp {
        return null;
    }
    if CondTy.isVectorTy() && (!OtherOpT.getType().isVectorTy() || !OtherOpF.getType().isVectorTy()) {
        return null;
    }
    let mut BO: *mut BinaryOperator = dyn_cast(TI);
    if BO && BO.isIntDivRem() && !isGuaranteedNotToBePoison(Cond, null, null, null, 0) {
        if BO.getOpcode() == SDiv || BO.getOpcode() == SRem || MatchIsOpZero {
            Cond = self.Builder.CreateFreeze(Cond, "");
        }
    }
    let mut NewSI: *mut Value = self.Builder.CreateSelect(Cond, OtherOpT, OtherOpF, SI.getName() + ".v", &mut SI);
    let mut Op0: *mut Value = if MatchIsOpZero { MatchOp } else { NewSI };
    let mut Op1: *mut Value = if MatchIsOpZero { NewSI } else { MatchOp };
    if dyn_cast(TI) {
        BO;
    } else {
        let mut NewBO: *mut BinaryOperator = Create(BO.getOpcode(), Op0, Op1, "", null);
        NewBO.copyIRFlags(TI, true);
        NewBO.andIRFlags(FI);
        return NewBO;
    }
    if dyn_cast(TI) {
        TGEP;
    } else {
        let mut FGEP: *mut GetElementPtrInst = cast(FI);
        let mut ElementType: *mut Type = TGEP.getSourceElementType();
        return Create(ElementType, Op0, Op1, TGEP.getNoWrapFlags() & FGEP.getNoWrapFlags(), "", null);
    }
    llvm_unreachable_internal("Expected BinaryOperator or GEP", "P:/Goraw/llvm-project/llvm/lib/Transforms/InstCombine/InstCombineSelect.cpp", 502);
    return null;
}

fn InstCombinerImpl::foldSelectIntrinsic(self, SI: *mut SelectInst) -> *mut Instruction {
    let mut LHSIntrinsic: *mut IntrinsicInst = dyn_cast(SI.getTrueValue());
    if !LHSIntrinsic {
        return null;
    }
    let mut RHSIntrinsic: *mut IntrinsicInst = dyn_cast(SI.getFalseValue());
    if !RHSIntrinsic || LHSIntrinsic.getIntrinsicID() != RHSIntrinsic.getIntrinsicID() || !LHSIntrinsic.hasOneUse() || !RHSIntrinsic.hasOneUse() {
        return null;
    }
    let mut IID: ID = LHSIntrinsic.getIntrinsicID();
    match IID {
        abs => {
            cttz;
        },
        ctpop => {
            let mut TV: *mut Value = LHSIntrinsic.getArgOperand(0);
            let mut FV: *mut Value = RHSIntrinsic.getArgOperand(0);
            let mut NewSel: *mut Value = self.Builder.CreateSelect(SI.getCondition(), TV, FV, "", &mut SI);
            let mut NewCall: *mut Value = self.Builder.CreateUnaryIntrinsic(IID, NewSel, FMFSource {}, "");
            return self.replaceInstUsesWith(SI, NewCall);
        },
        _ => {
            return null;
        },
    }
}

fn isSelect01(C1I: *APInt, C2I: *APInt) -> bool {
    if !C1I.isZero() && !C2I.isZero() {
        return false;
    }
    return C1I.isOne() || C1I.isAllOnes() || C2I.isOne() || C2I.isAllOnes();
}

fn InstCombinerImpl::foldSelectIntoOp(self, SI: *mut SelectInst, TrueVal: *mut Value, FalseVal: *mut Value) -> *mut Instruction {
    let mut TryFoldSelectIntoOp: Closure_4 = Closure_4 { cap_0: self };
    if TryFoldSelectIntoOp.call(SI, TrueVal, FalseVal, false) {
        R;
    } else {
        return R;
    }
    if TryFoldSelectIntoOp.call(SI, FalseVal, TrueVal, true) {
        R;
    } else {
        return R;
    }
    return null;
}

fn canoncalizeSelectICmpMinMax(Cmp: *ICmpInst, TVal: *mut Value, FVal: *mut Value, Builder: *mut BuilderTy, SQ: *SimplifyQuery) -> *mut Value {
    let mut CmpLHS: *mut Value = Cmp.getOperand(0);
    let mut CmpRHS: *mut Value = Cmp.getOperand(1);
    let mut Pred: Predicate = Cmp.getPredicate();
    if match(FVal, m_Zero()) {
        swap(TVal, FVal);
        Pred = getInversePredicate(Pred);
    }
    if !match(TVal, m_Zero()) {
        return null;
    }
    if Pred == ICMP_SGT || Pred == ICMP_SGE {
        swap(CmpLHS, CmpRHS);
        Pred = getSwappedPredicate(Pred);
    }
    if (Pred == ICMP_SLT || Pred == ICMP_SLE) && match(FVal, m_NSWSub(m_Specific(CmpLHS), m_Specific(CmpRHS))) && isGuaranteedNotToBeUndef(CmpLHS, SQ.AC, SQ.CtxI, SQ.DT, 0) {
        let mut SMin: *mut Value = Builder.CreateBinaryIntrinsic(smin, CmpRHS, CmpLHS, FMFSource {}, "");
        return Builder.CreateNSWSub(CmpLHS, SMin, "");
    }
    return null;
}

fn foldSelectICmpMinMax(Cmp: *ICmpInst, TVal: *mut Value, FVal: *mut Value, Builder: *mut BuilderTy, SQ: *SimplifyQuery) -> *mut Value {
    let mut CmpLHS: *mut Value = Cmp.getOperand(0);
    let mut CmpRHS: *mut Value = Cmp.getOperand(1);
    let mut Pred: Predicate = Cmp.getPredicate();
    if canoncalizeSelectICmpMinMax(Cmp, TVal, FVal, Builder, SQ) {
        V;
    } else {
        return V;
    }
    if CmpRHS == TVal {
        swap(CmpLHS, CmpRHS);
        Pred = getSwappedPredicate(Pred);
    }
    if !(CmpLHS == TVal && isa(FVal)) {
        return null;
    }
    if Pred == ICMP_SGT && match(FVal, m_NSWAdd(m_Specific(CmpRHS), m_One())) {
        cast(FVal).setHasNoUnsignedWrap(false);
        return Builder.CreateBinaryIntrinsic(smax, TVal, FVal, FMFSource {}, "");
    }
    if Pred == ICMP_SLT && match(FVal, m_NSWAdd(m_Specific(CmpRHS), m_AllOnes())) {
        cast(FVal).setHasNoUnsignedWrap(false);
        return Builder.CreateBinaryIntrinsic(smin, TVal, FVal, FMFSource {}, "");
    }
    if Pred == ICMP_UGT && match(FVal, m_NUWAdd(m_Specific(CmpRHS), m_One())) {
        cast(FVal).setHasNoSignedWrap(false);
        return Builder.CreateBinaryIntrinsic(umax, TVal, FVal, FMFSource {}, "");
    }
    if Pred == ICMP_ULT && match(FVal, m_Add(m_Specific(CmpRHS), m_AllOnes())) && isKnownNonZero(CmpRHS, SQ, 0) {
        cast(FVal).setHasNoSignedWrap(false);
        cast(FVal).setHasNoUnsignedWrap(false);
        return Builder.CreateBinaryIntrinsic(umin, TVal, FVal, FMFSource {}, "");
    }
    return null;
}

fn foldSelectICmpAndAnd(SelType: *mut Type, Cond: *Value, TVal: *mut Value, FVal: *mut Value, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut A: *mut Value = null;
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut Z: *mut Value = null;
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut NumReplaced: u32 = 1 + Cond.hasOneUse();
    if match(Cond, m_Trunc(m_Value(X))) {
        Y = get(X.getType(), 1, false, false);
        Pred = CmpPredicate { Pred: ICMP_NE, HasSameSign: false };
    } else if match(Cond, m_ICmp(Pred, m_And(m_Value(X), m_Value(Y)), m_Zero())) && isEquality(Pred.operator llvm::CmpInst::Predicate()) {
        NumReplaced += Cond.hasOneUse() && cast(Cond).getOperand(0).hasOneUse();
    } else {
        return null;
    }
    if Pred == ICMP_NE {
        swap(TVal, FVal);
    }
    if !match(FVal, m_One()) {
        return null;
    }
    if !match(TVal, m_And(m_Value(A), m_One())) {
        return null;
    }
    let mut BitWidth: APInt = APInt { SelType.getScalarSizeInBits(), SelType.getScalarSizeInBits(), false, false };
    let mut TValPattern: Value>>, 27, false>> = m_CombineOr(m_Deferred(X), m_LShr(m_Deferred(X), m_Value(Z, m_SpecificInt_ICMP_ForbidPoison(ICMP_ULT, BitWidth))));
    if !match(A, TValPattern) {
        swap(X, Y);
        if !match(A, TValPattern) {
            return null;
        }
    }
    let mut HasShift: bool = A != X;
    if TVal.hasOneUse() {
        NumReplaced += 1 + (HasShift && A.hasOneUse());
    }
    if NumReplaced < (4 - isa(Y)) {
        return null;
    }
    let mut One: *mut Constant = get(SelType, 1, false, false);
    let mut MaskB: *mut Value = if HasShift { Builder.CreateShl(One, Z, "", false, false) } else { One };
    let mut FullMask: *mut Value = Builder.CreateOr(Y, MaskB, "", false);
    let mut MaskedX: *mut Value = Builder.CreateAnd(X, FullMask, "");
    let mut ICmpNeZero: *mut Value = Builder.CreateIsNotNull(MaskedX, "");
    return ZExtInst { ICmpNeZero, SelType, "", null };
}

fn foldSelectICmpAndZeroShl(Cmp: *ICmpInst, TVal: *mut Value, FVal: *mut Value, Builder: *mut BuilderTy) -> *mut Value {
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut AndVal: *mut Value = null;
    if !match(Cmp, m_ICmp(Pred, m_Value(AndVal), m_Zero())) {
        return null;
    }
    if Pred == ICMP_NE {
        Pred = CmpPredicate { Pred: ICMP_EQ, HasSameSign: false };
        swap(TVal, FVal);
    }
    let mut X: *mut Value = null;
    let mut C2: *APInt = null;
    let mut C1: *APInt = null;
    if Pred != ICMP_EQ || !match(AndVal, m_And(m_Value(X), m_APInt(C1))) || !match(TVal, m_Zero()) || !match(FVal, m_Shl(m_Specific(X), m_APInt(C2))) {
        return null;
    }
    if !C1.isMask() || C1.countLeadingZeros() != C2.getZExtValue() as u32 {
        return null;
    }
    let mut FI: *mut Instruction = dyn_cast(FVal);
    if !FI {
        return null;
    }
    FI.setHasNoSignedWrap(false);
    FI.setHasNoUnsignedWrap(false);
    return FVal;
}

fn foldSelectICmpLshrAshr(IC: *ICmpInst, TrueVal: *mut Value, FalseVal: *mut Value, Builder: *mut BuilderTy) -> *mut Value {
    let mut Pred: Predicate = IC.getPredicate();
    let mut CmpLHS: *mut Value = IC.getOperand(0);
    let mut CmpRHS: *mut Value = IC.getOperand(1);
    if !CmpRHS.getType().isIntOrIntVectorTy() {
        return null;
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut Bitwidth: u32 = CmpRHS.getType().getScalarSizeInBits();
    if (Pred != ICMP_SGT || !match(CmpRHS, m_SpecificInt_ICMP(ICMP_SGE, getAllOnes(Bitwidth)))) && (Pred != ICMP_SLT || !match(CmpRHS, m_SpecificInt_ICMP(ICMP_SGE, getZero(Bitwidth)))) {
        return null;
    }
    if Pred == ICMP_SLT {
        swap(TrueVal, FalseVal);
    }
    if match(TrueVal, m_LShr(m_Value(X), m_Value(Y))) && match(FalseVal, m_AShr(m_Specific(X), m_Specific(Y))) && match(CmpLHS, m_Specific(X)) {
        let mut Ashr: *Instruction const = cast(FalseVal);
        let mut IsExact: bool = Ashr.isExact() && cast(TrueVal).isExact();
        return Builder.CreateAShr(X, Y, IC.getName(), IsExact);
    }
    return null;
}

fn foldSelectICmpAndBinOp(CondVal: *mut Value, TrueVal: *mut Value, FalseVal: *mut Value, V: *mut Value, AndMask: *APInt, CreateAnd: bool, Builder: *mut BuilderTy) -> *mut Value {
    if !TrueVal.getType().isIntOrIntVectorTy() {
        return null;
    }
    let mut C1Log: u32 = AndMask.logBase2();
    let mut Y: *mut Value = null;
    let mut BinOp: *mut BinaryOperator = null;
    let mut C2: *APInt = null;
    let mut NeedXor: bool = false;
    if match(FalseVal, m_BinOp(m_Specific(TrueVal), m_Power2(C2))) {
        Y = TrueVal;
        BinOp = cast(FalseVal);
        NeedXor = false;
    } else if match(TrueVal, m_BinOp(m_Specific(FalseVal), m_Power2(C2))) {
        Y = FalseVal;
        BinOp = cast(TrueVal);
        NeedXor = true;
    } else {
        return null;
    }
    let mut IdentityC: *mut Constant = getBinOpIdentity(BinOp.getOpcode(), BinOp.getType(), true, false);
    if IdentityC == null || !IdentityC.isNullValue() {
        return null;
    }
    let mut C2Log: u32 = C2.logBase2();
    let mut NeedShift: bool = C1Log != C2Log;
    let mut NeedZExtTrunc: bool = Y.getType().getScalarSizeInBits() != V.getType().getScalarSizeInBits();
    if AndMask.isOne() && C2.isSignBitSet() {
        CreateAnd = false;
    }
    if (NeedShift + NeedXor + NeedZExtTrunc + CreateAnd) > (CondVal.hasOneUse() + BinOp.hasOneUse()) {
        return null;
    }
    if CreateAnd {
        V = Builder.CreateAnd(V, get(V.getType(), AndMask), "");
    }
    if C2Log > C1Log {
        V = Builder.CreateZExtOrTrunc(V, Y.getType(), "");
        V = Builder.CreateShl(V, C2Log - C1Log, "", false, false);
    } else if C1Log > C2Log {
        V = Builder.CreateLShr(V, C1Log - C2Log, "", false);
        V = Builder.CreateZExtOrTrunc(V, Y.getType(), "");
    } else {
        V = Builder.CreateZExtOrTrunc(V, Y.getType(), "");
    }
    if NeedXor {
        V = Builder.CreateXor(V, *C2, "");
    }
    let mut Res: *mut Value = Builder.CreateBinOp(BinOp.getOpcode(), Y, V, "", null);
    if dyn_cast(Res) {
        BO;
    } else {
        BO.copyIRFlags(BinOp, true);
    }
    return Res;
}

fn foldSetClearBits(Sel: *mut SelectInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Cond: *mut Value = Sel.getCondition();
    let mut T: *mut Value = Sel.getTrueValue();
    let mut F: *mut Value = Sel.getFalseValue();
    let mut Ty: *mut Type = Sel.getType();
    let mut X: *mut Value = null;
    let mut NotC: *APInt = null;
    let mut C: *APInt = null;
    if match(T, m_And(m_Value(X), m_APInt(NotC))) && match(F, m_OneUse(m_Or(m_Specific(X), m_APInt(C)))) && *NotC == operator((*C)) {
        let mut Zero: *mut Constant = getNullValue(Ty);
        let mut OrC: *mut Constant = get(Ty, *C);
        let mut NewSel: *mut Value = Builder.CreateSelect(Cond, Zero, OrC, "masksel", &mut Sel);
        return CreateOr(T, NewSel, "");
    }
    if match(F, m_And(m_Value(X), m_APInt(NotC))) && match(T, m_OneUse(m_Or(m_Specific(X), m_APInt(C)))) && *NotC == operator((*C)) {
        let mut Zero: *mut Constant = getNullValue(Ty);
        let mut OrC: *mut Constant = get(Ty, *C);
        let mut NewSel: *mut Value = Builder.CreateSelect(Cond, OrC, Zero, "masksel", &mut Sel);
        return CreateOr(F, NewSel, "");
    }
    return null;
}

fn foldSelectZeroOrFixedOp(SI: *mut SelectInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut CondVal: *mut Value = SI.getCondition();
    let mut TrueVal: *mut Value = SI.getTrueValue();
    let mut FalseVal: *mut Value = SI.getFalseValue();
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut Predicate: CmpPredicate = CmpPredicate {};
    if !match(CondVal, m_ICmp(Predicate, m_Value(X), m_Zero())) || !isEquality(Predicate.operator llvm::CmpInst::Predicate()) {
        return null;
    }
    if Predicate == ICMP_NE {
        swap(TrueVal, FalseVal);
    }
    let mut TrueValC: *mut Constant = dyn_cast(TrueVal);
    if TrueValC == null || !isa(FalseVal) {
        return null;
    }
    let mut FreezeY: bool = false;
    if match(FalseVal, m_c_Mul(m_Specific(X), m_Value(Y))) || match(FalseVal, m_c_And(m_Specific(X), m_Value(Y))) || match(FalseVal, m_FShl(m_Specific(X), m_Specific(X), m_Value(Y))) || match(FalseVal, m_FShr(m_Specific(X), m_Specific(X), m_Value(Y))) || match(FalseVal, m_c_Intrinsic(m_Specific(X), m_Value(Y))) {
        FreezeY = true;
    } else if match(FalseVal, m_IDiv(m_Specific(X), m_Value(Y))) || match(FalseVal, m_IRem(m_Specific(X), m_Value(Y))) {
        FreezeY = false;
    } else {
        return null;
    }
    let mut ZeroC: *mut Constant = cast(cast(CondVal).getOperand(1));
    let mut MergedC: *mut Constant = mergeUndefsWith(TrueValC, ZeroC);
    if !match(MergedC, m_Zero()) && !match(MergedC, m_Undef()) {
        return null;
    }
    let mut FalseValI: *mut Instruction = cast(FalseVal);
    if FreezeY {
        let mut FrY: *mut Instruction = IC.InsertNewInstBefore(FreezeInst { Y, Y.getName() + ".fr", null }, FalseValI.getIterator());
        IC.replaceOperand(*FalseValI, if FalseValI.getOperand(0) == Y { 0 } else { (if FalseValI.getOperand(1) == Y { 1 } else { 2 }) }, FrY);
    }
    return IC.replaceInstUsesWith(SI, FalseValI);
}

fn canonicalizeSaturatedSubtractUnsigned(ICI: *ICmpInst, TrueVal: *Value, FalseVal: *Value, Builder: *mut BuilderTy) -> *mut Value {
    let mut Pred: Predicate = ICI.getPredicate();
    let mut A: *mut Value = ICI.getOperand(0);
    let mut B: *mut Value = ICI.getOperand(1);
    if match(TrueVal, m_Zero()) {
        Pred = getInversePredicate(Pred);
        swap(TrueVal, FalseVal);
    }
    if !match(FalseVal, m_Zero()) {
        return null;
    }
    if Pred == ICMP_NE {
        if match(B, m_Zero()) && match(TrueVal, m_Add(m_Specific(A), m_AllOnes())) {
            return Builder.CreateBinaryIntrinsic(usub_sat, A, get(A.getType(), 1, false, false), FMFSource {}, "");
        }
        return null;
    }
    if !isUnsigned(Pred) {
        return null;
    }
    if Pred == ICMP_ULE || Pred == ICMP_ULT {
        swap(A, B);
        Pred = getSwappedPredicate(Pred);
    }
    assert!((Pred == ICMP_UGE || Pred == ICMP_UGT), "Unexpected isUnsigned predicate!");
    let mut IsNegative: bool = false;
    let mut C: *APInt = null;
    if match(TrueVal, m_Sub(m_Specific(B), m_Specific(A))) || (match(A, m_APInt(C)) && match(TrueVal, m_Add(m_Specific(B), m_SpecificInt(operator(*C))))) {
        IsNegative = true;
    } else if !match(TrueVal, m_Sub(m_Specific(A), m_Specific(B))) && !(match(B, m_APInt(C)) && match(TrueVal, m_Add(m_Specific(A), m_SpecificInt(operator(*C))))) {
        return null;
    }
    if IsNegative && !TrueVal.hasOneUse() && !ICI.hasOneUse() {
        return null;
    }
    let mut Result: *mut Value = Builder.CreateBinaryIntrinsic(usub_sat, A, B, FMFSource {}, "");
    if IsNegative {
        Result = Builder.CreateNeg(Result, "", false);
    }
    return Result;
}

fn canonicalizeSaturatedSubtractSigned(ICI: *ICmpInst, TrueVal: *Value, FalseVal: *Value, Builder: *mut BuilderTy) -> *mut Value {
    let mut Pred: Predicate = ICI.getPredicate();
    let mut CmpLHS: *mut Value = ICI.getOperand(0);
    let mut CmpRHS: *mut Value = ICI.getOperand(1);
    if Pred == ICMP_NE {
        Pred = ICMP_EQ;
        swap(TrueVal, FalseVal);
    }
    if Pred == ICMP_EQ && match(CmpRHS, m_SignMask()) && match(TrueVal, m_MaxSignedValue()) && match(FalseVal, m_Neg(m_Specific(CmpLHS))) {
        return Builder.CreateBinaryIntrinsic(ssub_sat, getNullValue(CmpLHS.getType()), CmpLHS, FMFSource {}, "");
    }
    return null;
}

fn canonicalizeSaturatedSubtract(ICI: *ICmpInst, TrueVal: *Value, FalseVal: *Value, Builder: *mut BuilderTy) -> *mut Value {
    if canonicalizeSaturatedSubtractUnsigned(ICI, TrueVal, FalseVal, Builder) {
        V;
    } else {
        return V;
    }
    if canonicalizeSaturatedSubtractSigned(ICI, TrueVal, FalseVal, Builder) {
        V;
    } else {
        return V;
    }
    return null;
}

fn canonicalizeSaturatedAddUnsigned(Cmp: *mut ICmpInst, TVal: *mut Value, FVal: *mut Value, Builder: *mut BuilderTy) -> *mut Value {
    let mut Cmp0: *mut Value = Cmp.getOperand(0);
    let mut Cmp1: *mut Value = Cmp.getOperand(1);
    let mut Pred: Predicate = Cmp.getPredicate();
    let mut X: *mut Value = null;
    let mut C: *APInt = null;
    if match(FVal, m_AllOnes()) {
        swap(TVal, FVal);
        Pred = getInversePredicate(Pred);
    }
    if !match(TVal, m_AllOnes()) {
        return null;
    }
    if Pred == ICMP_EQ {
        if match(FVal, m_Add(m_Specific(Cmp0), m_One())) && match(Cmp1, m_AllOnes()) {
            return Builder.CreateBinaryIntrinsic(uadd_sat, Cmp0, get(Cmp0.getType(), 1, false, false), FMFSource {}, "");
        }
        return null;
    }
    if (Pred == ICMP_UGE || Pred == ICMP_UGT) && match(FVal, m_Add(m_Specific(Cmp0), m_APIntAllowPoison(C))) && match(Cmp1, m_SpecificIntAllowPoison(operator(*C))) {
        return Builder.CreateBinaryIntrinsic(uadd_sat, Cmp0, get(Cmp0.getType(), *C), FMFSource {}, "");
    }
    if Pred == ICMP_UGT && match(FVal, m_Add(m_Specific(Cmp0), m_APIntAllowPoison(C))) && match(Cmp1, m_SpecificIntAllowPoison(operator(*C) - 1)) && !C.isAllOnes() {
        return Builder.CreateBinaryIntrinsic(uadd_sat, Cmp0, get(Cmp0.getType(), *C), FMFSource {}, "");
    }
    if Pred == ICMP_UGE && match(FVal, m_Add(m_Specific(Cmp0), m_APIntAllowPoison(C))) && match(Cmp1, m_SpecificIntAllowPoison(operator(*C))) && !C.isZero() {
        return Builder.CreateBinaryIntrinsic(uadd_sat, Cmp0, get(Cmp0.getType(), *C), FMFSource {}, "");
    }
    if Pred == ICMP_UGT || Pred == ICMP_UGE {
        swap(Cmp0, Cmp1);
        Pred = getSwappedPredicate(Pred);
    }
    if Pred != ICMP_ULT && Pred != ICMP_ULE {
        return null;
    }
    let mut Y: *mut Value = null;
    if match(Cmp0, m_Not(m_Value(X))) && match(FVal, m_c_Add(m_Specific(X), m_Value(Y))) && Y == Cmp1 {
        return Builder.CreateBinaryIntrinsic(uadd_sat, X, Y, FMFSource {}, "");
    }
    X = Cmp0;
    Y = Cmp1;
    if match(FVal, m_c_Add(m_NotForbidPoison(m_Specific(X)), m_Specific(Y))) {
        let mut BO: *mut BinaryOperator = cast(FVal);
        return Builder.CreateBinaryIntrinsic(uadd_sat, BO.getOperand(0), BO.getOperand(1), FMFSource {}, "");
    }
    if Pred == ICMP_ULT && match(Cmp0, m_c_Add(m_Specific(Cmp1), m_Value(Y))) && match(FVal, m_c_Add(m_Specific(Cmp1), m_Specific(Y))) {
        return Builder.CreateBinaryIntrinsic(uadd_sat, Cmp1, Y, FMFSource {}, "");
    }
    return null;
}

fn canonicalizeSaturatedAddSigned(Cmp: *mut ICmpInst, TVal: *mut Value, FVal: *mut Value, Builder: *mut BuilderTy) -> *mut Value {
    let mut Cmp0: *mut Value = Cmp.getOperand(0);
    let mut Cmp1: *mut Value = Cmp.getOperand(1);
    let mut Pred: Predicate = Cmp.getPredicate();
    if match(FVal, m_MaxSignedValue()) || match(FVal, m_SignMask()) {
        swap(TVal, FVal);
        Pred = getInversePredicate(Pred);
    }
    let mut SatC: *APInt = null;
    if !match(TVal, m_APInt(SatC)) || !(SatC.isMaxSignedValue() || SatC.isSignMask()) {
        return null;
    }
    let mut IsMax: bool = SatC.isMaxSignedValue();
    if Pred == ICMP_EQ && Cmp1 == TVal {
        if IsMax && match(FVal, m_Add(m_Specific(Cmp0), m_One())) {
            return Builder.CreateBinaryIntrinsic(sadd_sat, Cmp0, get(Cmp0.getType(), 1, false, false), FMFSource {}, "");
        }
        if !IsMax && match(FVal, m_Add(m_Specific(Cmp0), m_AllOnes())) {
            return Builder.CreateBinaryIntrinsic(sadd_sat, Cmp0, getAllOnesValue(Cmp0.getType()), FMFSource {}, "");
        }
        return null;
    }
    let mut C: *APInt = null;
    if IsMax && (Pred == ICMP_SGT || Pred == ICMP_SGE) && isa(Cmp1) && match(FVal, m_Add(m_Specific(Cmp0), m_StrictlyPositive(C))) {
        if Pred == ICMP_SGE {
            if getFlippedStrictnessPredicateAndConstant(CmpPredicate { Pred: Pred, HasSameSign: false }, cast(Cmp1)) {
                Flipped;
            } else {
                Pred = operator(Flipped).first.operator llvm::CmpInst::Predicate();
                Cmp1 = operator(Flipped).second;
            }
        }
        let mut Threshold: APInt = *SatC - *C;
        if Pred == ICMP_SGT && (match(Cmp1, m_SpecificIntAllowPoison(Threshold)) || match(Cmp1, m_SpecificIntAllowPoison(Threshold - 1))) {
            return Builder.CreateBinaryIntrinsic(sadd_sat, Cmp0, get(Cmp0.getType(), *C), FMFSource {}, "");
        }
    }
    if !IsMax && (Pred == ICMP_SLT || Pred == ICMP_SLE) && isa(Cmp1) && match(FVal, m_Add(m_Specific(Cmp0), m_Negative(C))) {
        if Pred == ICMP_SLE {
            if getFlippedStrictnessPredicateAndConstant(CmpPredicate { Pred: Pred, HasSameSign: false }, cast(Cmp1)) {
                Flipped;
            } else {
                Pred = operator(Flipped).first.operator llvm::CmpInst::Predicate();
                Cmp1 = operator(Flipped).second;
            }
        }
        let mut Threshold: APInt = *SatC - *C;
        if Pred == ICMP_SLT && (match(Cmp1, m_SpecificIntAllowPoison(Threshold)) || match(Cmp1, m_SpecificIntAllowPoison(Threshold + 1))) {
            return Builder.CreateBinaryIntrinsic(sadd_sat, Cmp0, get(Cmp0.getType(), *C), FMFSource {}, "");
        }
    }
    if Pred == ICMP_SGT || Pred == ICMP_SGE {
        swap(Cmp0, Cmp1);
        Pred = getSwappedPredicate(Pred);
    }
    if Pred != ICMP_SLT && Pred != ICMP_SLE {
        return null;
    }
    let mut X: *mut Value = null;
    if IsMax && match(Cmp0, m_NSWSub(m_SpecificInt(*SatC), m_Value(X))) && match(FVal, m_c_Add(m_Specific(X), m_Specific(Cmp1))) {
        return Builder.CreateBinaryIntrinsic(sadd_sat, X, Cmp1, FMFSource {}, "");
    }
    if !IsMax && match(Cmp1, m_NSWSub(m_SpecificInt(*SatC), m_Value(X))) && match(FVal, m_c_Add(m_Specific(X), m_Specific(Cmp0))) {
        return Builder.CreateBinaryIntrinsic(sadd_sat, X, Cmp0, FMFSource {}, "");
    }
    return null;
}

fn canonicalizeSaturatedAdd(Cmp: *mut ICmpInst, TVal: *mut Value, FVal: *mut Value, Builder: *mut BuilderTy) -> *mut Value {
    if !Cmp.hasOneUse() {
        return null;
    }
    if canonicalizeSaturatedAddUnsigned(Cmp, TVal, FVal, Builder) {
        V;
    } else {
        return V;
    }
    if canonicalizeSaturatedAddSigned(Cmp, TVal, FVal, Builder) {
        V;
    } else {
        return V;
    }
    return null;
}

fn foldAbsDiff(Cmp: *mut ICmpInst, TVal: *mut Value, FVal: *mut Value, Builder: *mut BuilderTy) -> *mut Value {
    let mut TI: *mut Instruction = dyn_cast(TVal);
    let mut FI: *mut Instruction = dyn_cast(FVal);
    if !TI || !FI {
        return null;
    }
    let mut Pred: Predicate = Cmp.getStrictPredicate();
    let mut A: *mut Value = Cmp.getOperand(0);
    let mut B: *mut Value = Cmp.getOperand(1);
    if match(FI, m_Sub(m_Specific(A), m_Specific(B))) {
        swap(FI, TI);
        Pred = getSwappedPredicate(Pred);
    }
    if Pred == ICMP_SGT && match(TI, m_Sub(m_Specific(A), m_Specific(B))) && match(FI, m_Sub(m_Specific(B), m_Specific(A))) && (TI.hasNoSignedWrap() || TI.hasNoUnsignedWrap()) && (FI.hasNoSignedWrap() || FI.hasNoUnsignedWrap()) {
        TI.setHasNoUnsignedWrap(false);
        if !TI.hasNoSignedWrap() {
            TI.setHasNoSignedWrap(TI.hasOneUse());
        }
        return Builder.CreateBinaryIntrinsic(abs, TI, Builder.getTrue(), FMFSource {}, "");
    }
    if Pred == ICMP_SGT && match(TI, m_NSWSub(m_Specific(A), m_Specific(B))) && match(FI, m_Neg(m_Specific(TI))) {
        return Builder.CreateBinaryIntrinsic(abs, TI, Builder.getFalse(), FMFSource {}, "");
    }
    if Pred == ICMP_SLT && match(FI, m_NSWSub(m_Specific(A), m_Specific(B))) && match(TI, m_Neg(m_Specific(FI))) {
        return Builder.CreateBinaryIntrinsic(abs, FI, Builder.getFalse(), FMFSource {}, "");
    }
    if Pred == ICMP_SGT && match(FI, m_NSWSub(m_Specific(B), m_Specific(A))) && match(TI, m_Neg(m_Specific(FI))) {
        return Builder.CreateBinaryIntrinsic(abs, FI, Builder.getFalse(), FMFSource {}, "");
    }
    if Pred == ICMP_SLT && match(TI, m_NSWSub(m_Specific(B), m_Specific(A))) && match(FI, m_Neg(m_Specific(TI))) {
        return Builder.CreateBinaryIntrinsic(abs, TI, Builder.getFalse(), FMFSource {}, "");
    }
    return null;
}

fn foldSelectCtlzToCttz(ICI: *mut ICmpInst, TrueVal: *mut Value, FalseVal: *mut Value, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut BitWidth: u32 = TrueVal.getType().getScalarSizeInBits();
    if !ICI.isEquality() || !match(ICI.getOperand(1), m_Zero()) {
        return null;
    }
    if ICI.getPredicate() == ICMP_NE {
        swap(TrueVal, FalseVal);
    }
    let mut Ctlz: *mut Value = null;
    if match(FalseVal, m_Xor(m_Value(Ctlz), m_SpecificIntAllowPoison(BitWidth - 1))) {
        if !isPowerOf2_32(BitWidth) {
            return null;
        }
    } else if !match(FalseVal, m_Sub(m_SpecificIntAllowPoison(BitWidth - 1), m_Value(Ctlz))) {
        return null;
    }
    if !match(Ctlz, m_Ctlz(m_Value(), m_Value())) {
        return null;
    }
    if !match(TrueVal, m_SpecificInt(BitWidth)) {
        return null;
    }
    let mut X: *mut Value = ICI.getOperand(0);
    let mut II: *mut IntrinsicInst = cast(Ctlz);
    if !match(II.getOperand(0), m_c_And(m_Specific(X), m_Neg(m_Specific(X)))) {
        return null;
    }
    let mut F: *mut Function = getOrInsertDeclaration(II.getModule(), cttz, II.getType());
    return Create(F, [X, Builder.getFalse()], ArrayRef<OperandBundleDef> {}, "", null);
}

fn foldSelectCttzCtlz(ICI: *mut ICmpInst, TrueVal: *mut Value, FalseVal: *mut Value, IC: *mut InstCombinerImpl) -> *mut Value {
    let mut Pred: Predicate = ICI.getPredicate();
    let mut CmpLHS: *mut Value = ICI.getOperand(0);
    let mut CmpRHS: *mut Value = ICI.getOperand(1);
    if !ICI.isEquality() {
        return null;
    }
    let mut SelectArg: *mut Value = FalseVal;
    let mut ValueOnZero: *mut Value = TrueVal;
    if Pred == ICMP_NE {
        swap(SelectArg, ValueOnZero);
    }
    let mut Count: *mut Value = null;
    if !match(SelectArg, m_ZExt(m_Value(Count))) && !match(SelectArg, m_Trunc(m_Value(Count))) {
        Count = SelectArg;
    }
    let mut X: *mut Value = null;
    if !match(Count, m_Cttz(m_Value(X), m_Value())) && !match(Count, m_Ctlz(m_Value(X), m_Value())) {
        return null;
    }
    if (X != CmpLHS || !match(CmpRHS, m_Zero())) && (!match(X, m_Not(m_Specific(CmpLHS))) || !match(CmpRHS, m_AllOnes())) && !match(X, m_c_Xor(m_Specific(CmpLHS), m_Specific(CmpRHS))) {
        return null;
    }
    let mut II: *mut IntrinsicInst = cast(Count);
    let mut SizeOfInBits: u32 = Count.getType().getScalarSizeInBits();
    if match(ValueOnZero, m_SpecificInt(SizeOfInBits)) {
        II.dropPoisonGeneratingAnnotations();
        IC.addToWorklist(II);
        return SelectArg;
    }
    if II.hasOneUse() && SelectArg.hasOneUse() && !match(II.getArgOperand(1), m_One()) {
        II.setArgOperand(1, getTrue(II.getContext()));
        II.dropUBImplyingAttrsAndMetadata(ArrayRef<unsigned int> {});
        IC.addToWorklist(II);
    }
    return null;
}

fn canonicalizeSPF(Cmp: *mut ICmpInst, TrueVal: *mut Value, FalseVal: *mut Value, IC: *mut InstCombinerImpl) -> *mut Value {
    let mut LHS: *mut Value = null;
    let mut RHS: *mut Value = null;
    if !TrueVal.getType().isIntOrIntVectorTy() {
        return null;
    }
    let mut SPF: SelectPatternFlavor = matchDecomposedSelectPattern(&mut Cmp, TrueVal, FalseVal, LHS, RHS, FastMathFlags {}, null, 0).Flavor;
    if SPF == SPF_ABS || SPF == SPF_NABS {
        if !Cmp.hasOneUse() && !RHS.hasOneUse() {
            return null;
        }
        let mut IntMinIsPoison: bool = SPF == SPF_ABS && match(RHS, m_NSWNeg(m_Specific(LHS)));
        let mut IntMinIsPoisonC: *mut Constant = get(getInt1Ty(Cmp.getContext()), IntMinIsPoison, false, false);
        let mut Abs: *mut Value = IC.Builder.CreateBinaryIntrinsic(abs, LHS, IntMinIsPoisonC, FMFSource {}, "");
        if SPF == SPF_NABS {
            return IC.Builder.CreateNeg(Abs, "", false);
        }
        return Abs;
    }
    if isMinOrMax(SPF) {
        let mut IntrinsicID: ID = getMinMaxIntrinsic(SPF);
        return IC.Builder.CreateBinaryIntrinsic(IntrinsicID, LHS, RHS, FMFSource {}, "");
    }
    return null;
}

fn InstCombinerImpl::replaceInInstruction(self, V: *mut Value, Old: *mut Value, New: *mut Value, Depth: u32) -> bool {
    if Depth == 2 {
        return false;
    }
    assert!(!isa(Old), "Only replace non-constant values");
    let mut I: *mut Instruction = dyn_cast(V);
    if !I || !I.hasOneUse() || !isSafeToSpeculativelyExecuteWithVariableReplaced(I, true) {
        return false;
    }
    if Old.getType().isVectorTy() && !isNotCrossLaneOperation(I) {
        return false;
    }
    let mut Changed: bool = false;
    for U in I.operands() {
        if U.operator llvm::Value *() == Old {
            self.replaceUse(U, New);
            self.Worklist.add(I);
            Changed = true;
        } else {
            Changed |= self.replaceInInstruction(U.operator llvm::Value *(), Old, New, Depth + 1);
        }
    }
    return Changed;
}

fn InstCombinerImpl::foldSelectValueEquivalence(self, Sel: *mut SelectInst, Cmp: *mut CmpInst) -> *mut Instruction {
    let mut TrueVal: *mut Value = Sel.getTrueValue();
    let mut FalseVal: *mut Value = Sel.getFalseValue();
    let mut Swapped: bool = false;
    if Cmp.isEquivalence(true) {
        swap(TrueVal, FalseVal);
        Swapped = true;
    } else if !Cmp.isEquivalence(false) {
        return null;
    }
    let mut CmpLHS: *mut Value = Cmp.getOperand(0);
    let mut CmpRHS: *mut Value = Cmp.getOperand(1);
    let mut ReplaceOldOpWithNewOp: Closure_5 = Closure_5 { TrueVal: &mut TrueVal, cap_1: self, Sel: &mut Sel, Swapped: &mut Swapped, CmpLHS: &mut CmpLHS };
    let mut CanReplaceCmpLHSWithRHS: bool = canReplacePointersIfEqual(CmpLHS, CmpRHS, self.DL);
    if CanReplaceCmpLHSWithRHS {
        if ReplaceOldOpWithNewOp.call(CmpLHS, CmpRHS) {
            R;
        } else {
            return R;
        }
    }
    let mut CanReplaceCmpRHSWithLHS: bool = canReplacePointersIfEqual(CmpRHS, CmpLHS, self.DL);
    if CanReplaceCmpRHSWithLHS {
        if ReplaceOldOpWithNewOp.call(CmpRHS, CmpLHS) {
            R;
        } else {
            return R;
        }
    }
    let mut FalseInst: *mut Instruction = dyn_cast(FalseVal);
    if !FalseInst {
        return null;
    }
    let mut DropFlags: SmallVector<Instruction *> = SmallVector<Instruction *> {};
    if (CanReplaceCmpLHSWithRHS && simplifyWithOpReplaced(FalseVal, CmpLHS, CmpRHS, self.SQ, false, &mut DropFlags) == TrueVal) || (CanReplaceCmpRHSWithLHS && simplifyWithOpReplaced(FalseVal, CmpRHS, CmpLHS, self.SQ, false, &mut DropFlags) == TrueVal) {
        for I in DropFlags {
            I.dropPoisonGeneratingAnnotations();
            self.Worklist.add(I);
        }
        return self.replaceInstUsesWith(Sel, FalseVal);
    }
    let mut CmpC: *mut Constant = null;
    if FalseVal.getType().isIntOrIntVectorTy(1) && match(FalseVal, m_NUWTrunc(m_Specific(CmpLHS))) && match(CmpRHS, m_ImmConstant(CmpC)) && ConstantFoldCompareInstOperands(ICMP_NE, CmpC, getNullValue(CmpLHS.getType()), self.DL, null, null) == TrueVal {
        return ICmpInst { ICMP_NE, CmpLHS, getNullValue(CmpLHS.getType()), "" };
    }
    return null;
}

fn InstCombinerImpl::foldSelectEqualityTest(self, Sel: *mut SelectInst) -> *mut Instruction {
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut Z: *mut Value = null;
    let mut XeqY: *mut Value = null;
    let mut XeqZ: *mut Value = Sel.getCondition();
    let mut YeqZ: *mut Value = Sel.getTrueValue();
    if !match(XeqZ, m_SpecificICmp(CmpPredicate { Pred: ICMP_EQ, HasSameSign: false }, m_Value(X), m_Value(Z))) {
        return null;
    }
    if !match(YeqZ, m_c_SpecificICmp(CmpPredicate { Pred: ICMP_EQ, HasSameSign: false }, m_Value(Y), m_Specific(Z))) {
        swap(X, Z);
    }
    if !match(YeqZ, m_c_SpecificICmp(CmpPredicate { Pred: ICMP_EQ, HasSameSign: false }, m_Value(Y), m_Specific(Z))) {
        return null;
    }
    if !match(Sel.getFalseValue(), m_c_LogicalAnd(m_Not(m_Specific(YeqZ)), m_Value(XeqY))) {
        return null;
    }
    if !match(XeqY, m_c_SpecificICmp(CmpPredicate { Pred: ICMP_EQ, HasSameSign: false }, m_Specific(X), m_Specific(Y))) {
        return null;
    }
    cast(XeqY).setSameSign(false);
    return self.replaceInstUsesWith(Sel, XeqY);
}

fn canonicalizeClampLike(Sel0: *mut SelectInst, Cmp0: *mut ICmpInst, Builder: *mut BuilderTy, IC: *mut InstCombiner) -> *mut Value {
    let mut X: *mut Value = Sel0.getTrueValue();
    let mut Sel1: *mut Value = Sel0.getFalseValue();
    if !Cmp0.hasOneUse() {
        return null;
    }
    let mut Pred0: Predicate = Cmp0.getPredicate();
    let mut Cmp00: *mut Value = Cmp0.getOperand(0);
    let mut C0: *mut Constant = null;
    if !match(Cmp0.getOperand(1), m_CombineAnd(m_AnyIntegralConstant(), m_Constant(C0))) {
        return null;
    }
    if !match(Sel1, m_SelectLike(m_Value(), m_Value(), m_Value())) {
        Pred0 = getInversePredicate(Pred0);
        swap(X, Sel1);
    }
    match Pred0 {
        ICMP_ULT => {
            ICMP_UGE;
        },
        ICMP_ULE => {
            ICMP_UGT;
        },
        _ => {
            return null;
        },
    }
    if !Sel1.hasOneUse() {
        return null;
    }
    if Cmp00.getType() != X.getType() && X.hasOneUse() {
        match(X, m_TruncOrSelf(m_Value(X)));
    }
    let mut C1: *mut Constant = null;
    if Cmp00 == X {
        C1 = getNullValue(X.getType());
    } else if !match(Cmp00, m_Add(m_Specific(X), m_CombineAnd(m_AnyIntegralConstant(), m_Constant(C1)))) {
        return null;
    }
    let mut Cmp1: *mut Value = null;
    let mut Pred1: CmpPredicate = CmpPredicate {};
    let mut C2: *mut Constant = null;
    let mut ReplacementLow: *mut Value = null;
    let mut ReplacementHigh: *mut Value = null;
    if !match(Sel1, m_SelectLike(m_Value(Cmp1), m_Value(ReplacementLow), m_Value(ReplacementHigh))) || !match(Cmp1, m_ICmp(Pred1, m_Specific(X), m_CombineAnd(m_AnyIntegralConstant(), m_Constant(C2)))) {
        return null;
    }
    if !Cmp1.hasOneUse() && (Cmp00 == X || !Cmp00.hasOneUse()) {
        return null;
    }
    match Pred1.operator llvm::CmpInst::Predicate() {
        ICMP_SLT => {
            break;
        },
        ICMP_SLE => {
            return null;
        },
        ICMP_SGT => {
            if !match(C2, m_SpecificInt_ICMP(ICMP_NE, getSignedMaxValue(C2.getType().getScalarSizeInBits()))) {
                return null;
            }
        },
        ICMP_SGE => {
            Pred1 = CmpPredicate { Pred: ICMP_SLT, HasSameSign: false };
        },
        _ => {
            return null;
        },
    }
    assert!(Pred1 == ICMP_SLT, "Unexpected predicate type.");
    let mut ThresholdLowIncl: *mut Constant = getNeg(C1, false);
    let mut ThresholdHighExcl: *mut Constant = getSub(C0, C1, false, false);
    assert!((Pred0 == ICMP_ULT || Pred0 == ICMP_UGE), "Unexpected predicate type.");
    if Pred0 == ICMP_UGE {
        swap(ThresholdLowIncl, ThresholdHighExcl);
    }
    let mut Precond1: *mut Constant = ConstantFoldCompareInstOperands(ICMP_SGE, C2, ThresholdLowIncl, IC.getDataLayout(), null, null);
    if !Precond1 || !match(Precond1, m_One()) {
        return null;
    }
    let mut Precond2: *mut Constant = ConstantFoldCompareInstOperands(ICMP_SLE, C2, ThresholdHighExcl, IC.getDataLayout(), null, null);
    if !Precond2 || !match(Precond2, m_One()) {
        return null;
    }
    if X.getType() != Sel0.getType() {
        let mut LowC: *mut Constant = null;
        let mut HighC: *mut Constant = null;
        if !match(ReplacementLow, m_ImmConstant(LowC)) || !match(ReplacementHigh, m_ImmConstant(HighC)) {
            return null;
        }
        let mut DL: *DataLayout = Sel0.getDataLayout();
        ReplacementLow = ConstantFoldCastOperand(SExt, LowC, X.getType(), DL);
        ReplacementHigh = ConstantFoldCastOperand(SExt, HighC, X.getType(), DL);
        assert!(ReplacementLow && ReplacementHigh, "Constant folding of ImmConstant cannot fail");
    }
    let mut ShouldReplaceLow: *mut Value = Builder.CreateICmpSLT(X, ThresholdLowIncl, "");
    let mut ShouldReplaceHigh: *mut Value = Builder.CreateICmpSGE(X, ThresholdHighExcl, "");
    let mut MaybeReplacedLow: *mut Value = Builder.CreateSelect(ShouldReplaceLow, ReplacementLow, X, "", null);
    let mut MaybeReplacedHigh: *mut Value = Builder.CreateSelect(ShouldReplaceHigh, ReplacementHigh, MaybeReplacedLow, "", null);
    return Builder.CreateTrunc(MaybeReplacedHigh, Sel0.getType(), "", false, false);
}

fn tryToReuseConstantFromSelectInComparison(Sel: *mut SelectInst, Cmp: *mut ICmpInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut X: *mut Value = null;
    let mut C0: *mut Constant = null;
    if !match(&mut Cmp, m_OneUse(m_ICmp(Pred, m_Value(X), m_CombineAnd(m_AnyIntegralConstant(), m_Constant(C0))))) {
        return null;
    }
    if isEquality(Pred.operator llvm::CmpInst::Predicate()) {
        return null;
    }
    if !isCanonicalPredicate(Pred) {
        return null;
    }
    if C0.getType() != Sel.getType() {
        return null;
    }
    if Pred == ICMP_ULT && match(X, m_Add(m_Value(), m_Constant())) {
        return null;
    }
    let mut SelVal0: *mut Value = null;
    let mut SelVal1: *mut Value = null;
    match(&mut Sel, m_Select(m_Value(), m_Value(SelVal0), m_Value(SelVal1)));
    if !match(SelVal0, m_AnyIntegralConstant()) && !match(SelVal1, m_AnyIntegralConstant()) {
        return null;
    }
    let mut MatchesSelectValue: Closure_6 = Closure_6 { SelVal0: SelVal0, SelVal1: SelVal1 };
    if MatchesSelectValue.call(C0) {
        return null;
    }
    let mut FlippedStrictness: pair<CmpPredicate, Constant *>> = getFlippedStrictnessPredicateAndConstant(Pred, C0);
    if !FlippedStrictness {
        return null;
    }
    if !MatchesSelectValue.call(operator(FlippedStrictness).second) {
        return null;
    }
    let mut Guard: InsertPointGuard = IC.Builder;
    IC.Builder.SetInsertPoint(&mut Sel);
    Pred = CmpPredicate { Pred: getSwappedPredicate(Pred.operator llvm::CmpInst::Predicate()), HasSameSign: false };
    let mut NewCmp: *mut Value = IC.Builder.CreateICmp(Pred.operator llvm::CmpInst::Predicate(), X, operator(FlippedStrictness).second, Cmp.getName() + ".inv");
    IC.replaceOperand(Sel, 0, NewCmp);
    Sel.swapValues();
    Sel.swapProfMetadata();
    return &mut Sel;
}

fn foldSelectZeroOrOnes(Cmp: *mut ICmpInst, TVal: *mut Value, FVal: *mut Value, Builder: *mut BuilderTy) -> *mut Instruction {
    if !Cmp.hasOneUse() {
        return null;
    }
    let mut CmpC: *APInt = null;
    if !match(Cmp.getOperand(1), m_APIntAllowPoison(CmpC)) {
        return null;
    }
    let mut X: *mut Value = Cmp.getOperand(0);
    if Cmp.getPredicate() == ICMP_ULT && *CmpC == 2 && match(TVal, m_Neg(m_Specific(X))) && match(FVal, m_AllOnes()) {
        return SExtInst { Builder.CreateIsNotNull(X, ""), TVal.getType(), "", null };
    }
    if Cmp.getPredicate() == ICMP_UGT && *CmpC == 1 && match(FVal, m_Neg(m_Specific(X))) && match(TVal, m_AllOnes()) {
        return SExtInst { Builder.CreateIsNotNull(X, ""), TVal.getType(), "", null };
    }
    return null;
}

fn foldSelectInstWithICmpConst(SI: *mut SelectInst, ICI: *mut ICmpInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut CmpC: *APInt = null;
    let mut V: *mut Value = null;
    let mut Pred: CmpPredicate = CmpPredicate {};
    if !match(ICI, m_ICmp(Pred, m_Value(V), m_APInt(CmpC))) {
        return null;
    }
    let mut TVal: *mut Value = SI.getTrueValue();
    let mut FVal: *mut Value = SI.getFalseValue();
    if Pred == ICMP_EQ && V == FVal {
        if CmpC.isMinValue() && match(TVal, m_SpecificInt(*CmpC + 1)) {
            return Builder.CreateBinaryIntrinsic(umax, V, TVal, FMFSource {}, "");
        }
        if CmpC.isMaxValue() && match(TVal, m_SpecificInt(*CmpC - 1)) {
            return Builder.CreateBinaryIntrinsic(umin, V, TVal, FMFSource {}, "");
        }
        if CmpC.isMinSignedValue() && match(TVal, m_SpecificInt(*CmpC + 1)) {
            return Builder.CreateBinaryIntrinsic(smax, V, TVal, FMFSource {}, "");
        }
        if CmpC.isMaxSignedValue() && match(TVal, m_SpecificInt(*CmpC - 1)) {
            return Builder.CreateBinaryIntrinsic(smin, V, TVal, FMFSource {}, "");
        }
    }
    let mut Op: *mut Instruction = null;
    let mut C: *APInt = null;
    let mut CPred: Predicate = zeroed();
    if match(&mut SI, m_Select(m_Specific(ICI), m_APInt(C), m_Instruction(Op))) {
        CPred = ICI.getPredicate();
    } else if match(&mut SI, m_Select(m_Specific(ICI), m_Instruction(Op), m_APInt(C))) {
        CPred = ICI.getInversePredicate();
    } else {
        return null;
    }
    let mut InvDomCR: ConstantRange = makeExactICmpRegion(CPred, *CmpC);
    let mut OpC: *APInt = null;
    if match(Op, m_BinOp(m_Specific(V), m_APInt(OpC))) {
        let mut R: ConstantRange = InvDomCR.binaryOp(Op.getOpcode() as BinaryOps, *OpC);
        if R == *C {
            Op.dropPoisonGeneratingFlags();
            return Op;
        }
    }
    let mut MMI: *mut MinMaxIntrinsic = dyn_cast(Op);
    if MMI && MMI.getLHS() == V && match(MMI.getRHS(), m_APInt(OpC)) {
        let mut R: ConstantRange = intrinsic(MMI.getIntrinsicID(), [InvDomCR, *OpC]);
        if R == *C {
            MMI.dropPoisonGeneratingAnnotations();
            return MMI;
        }
    }
    return null;
}

fn foldSelectWithExtremeEqCond(CmpLHS: *mut Value, CmpRHS: *mut Value, TrueVal: *mut Value, FalseVal: *mut Value) -> *mut Instruction {
    let mut Ty: *mut Type = CmpLHS.getType();
    if Ty.isPtrOrPtrVectorTy() {
        return null;
    }
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut B: *mut Value = null;
    if !match(FalseVal, m_c_ICmp(Pred, m_Specific(CmpLHS), m_Value(B))) {
        return null;
    }
    let mut TValRHS: *mut Value = null;
    if !match(TrueVal, m_SpecificICmp(CmpPredicate { Pred: ICMP_NE, HasSameSign: false }, m_Specific(B), m_Value(TValRHS))) {
        return null;
    }
    let mut C: APInt = APInt {};
    let mut BitWidth: u32 = Ty.getScalarSizeInBits();
    if isLT(Pred.operator llvm::CmpInst::Predicate()) {
        C = if isSigned(Pred.operator llvm::CmpInst::Predicate()) { getSignedMinValue(BitWidth) } else { getMinValue(BitWidth) };
    } else if isGT(Pred.operator llvm::CmpInst::Predicate()) {
        C = if isSigned(Pred.operator llvm::CmpInst::Predicate()) { getSignedMaxValue(BitWidth) } else { getMaxValue(BitWidth) };
    } else {
        return null;
    }
    if !match(CmpRHS, m_SpecificInt(C)) || !match(TValRHS, m_SpecificInt(C)) {
        return null;
    }
    return ICmpInst { Pred.operator llvm::CmpInst::Predicate(), CmpLHS, B, "" };
}

fn foldSelectICmpEq(SI: *mut SelectInst, ICI: *mut ICmpInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut Pred: Predicate = ICI.getPredicate();
    if !isEquality(Pred) {
        return null;
    }
    let mut TrueVal: *mut Value = SI.getTrueValue();
    let mut FalseVal: *mut Value = SI.getFalseValue();
    let mut CmpLHS: *mut Value = ICI.getOperand(0);
    let mut CmpRHS: *mut Value = ICI.getOperand(1);
    if Pred == ICMP_NE {
        swap(TrueVal, FalseVal);
    }
    if foldSelectWithExtremeEqCond(CmpLHS, CmpRHS, TrueVal, FalseVal) {
        Res;
    } else {
        return Res;
    }
    return null;
}

fn InstCombinerImpl::foldSelectWithConstOpToBinOp(self, Cmp: *mut ICmpInst, TrueVal: *mut Value, FalseVal: *mut Value) -> *mut Value {
    let mut C1: *mut Constant = null;
    let mut C2: *mut Constant = null;
    let mut C3: *mut Constant = null;
    let mut X: *mut Value = null;
    let mut Predicate: CmpPredicate = CmpPredicate {};
    if !match(Cmp, m_ICmp(Predicate, m_Value(X), m_Constant(C1))) {
        return null;
    }
    if !isRelational(Predicate.operator llvm::CmpInst::Predicate()) {
        return null;
    }
    if match(TrueVal, m_Constant()) {
        swap(FalseVal, TrueVal);
        Predicate = CmpPredicate { Pred: getInversePredicate(Predicate.operator llvm::CmpInst::Predicate()), HasSameSign: false };
    }
    if !match(FalseVal, m_Constant(C3)) || !TrueVal.hasOneUse() {
        return null;
    }
    let mut IsIntrinsic: bool = false;
    let mut Opcode: u32 = 0;
    if dyn_cast(TrueVal) {
        BOp;
    } else {
        Opcode = BOp.getOpcode();
        IsIntrinsic = false;
        if isIntDivRem(Opcode) {
            return null;
        }
        if !match(BOp, m_BinOp(m_Specific(X), m_Constant(C2))) {
            return null;
        }
    }
    let mut RHS: *mut Value = null;
    let mut SPF: SelectPatternFlavor = zeroed();
    let mut DL: *DataLayout = Cmp.getDataLayout();
    let mut Flipped: pair<CmpPredicate, Constant *>> = getFlippedStrictnessPredicateAndConstant(Predicate, C1);
    let mut FoldBinaryOpOrIntrinsic: Closure_7 = Closure_7 { IsIntrinsic: &mut IsIntrinsic, Opcode: &mut Opcode, DL: &mut DL };
    if C3 == FoldBinaryOpOrIntrinsic.call(C1, C2) {
        SPF = getSelectPattern(Predicate.operator llvm::CmpInst::Predicate(), SPNB_NA, false).Flavor;
        RHS = C1;
    } else if Flipped && C3 == FoldBinaryOpOrIntrinsic.call(operator(Flipped).second, C2) {
        SPF = getSelectPattern(operator(Flipped).first.operator llvm::CmpInst::Predicate(), SPNB_NA, false).Flavor;
        RHS = operator(Flipped).second;
    } else {
        return null;
    }
    let mut MinMaxID: ID = getMinMaxIntrinsic(SPF);
    let mut MinMax: *mut Value = self.Builder.CreateBinaryIntrinsic(MinMaxID, X, RHS, FMFSource {}, "");
    if IsIntrinsic {
        return self.Builder.CreateBinaryIntrinsic(Opcode, MinMax, C2, FMFSource {}, "");
    }
    let mut BinOpc: BinaryOps = Opcode;
    let mut BinOp: *mut Value = self.Builder.CreateBinOp(BinOpc, MinMax, C2, "", null);
    if dyn_cast(BinOp) {
        BinOpInst;
    } else {
        if BinOpc == Add || BinOpc == Sub || BinOpc == Mul {
            let mut OldBinOp: *mut Instruction = cast(TrueVal);
            if OldBinOp.hasNoSignedWrap() && self.willNotOverflow(BinOpc, RHS, C2, *BinOpInst, true) {
                BinOpInst.setHasNoSignedWrap(true);
            }
            if OldBinOp.hasNoUnsignedWrap() && self.willNotOverflow(BinOpc, RHS, C2, *BinOpInst, false) {
                BinOpInst.setHasNoUnsignedWrap(true);
            }
        }
    }
    return BinOp;
}

fn foldICmpUSubSatWithAndForMostSignificantBitCmp(SI: *mut SelectInst, ICI: *mut ICmpInst, Builder: *mut BuilderTy) -> *mut Instruction {
    if !SI.hasOneUse() || !ICI.hasOneUse() {
        return null;
    }
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut Constant1: *APInt = null;
    let mut Constant2: *APInt = null;
    if !match(SI.getCondition(), m_ICmp(Pred, m_OneUse(m_Or(m_OneUse(m_Intrinsic(m_Value(A), m_APInt(Constant1))), m_OneUse(m_Intrinsic(m_Value(B), m_APInt(Constant2))))), m_Zero())) {
        return null;
    }
    let mut TrueVal: *mut Value = SI.getTrueValue();
    let mut FalseVal: *mut Value = SI.getFalseValue();
    if !((Pred == ICMP_EQ && match(TrueVal, m_Zero()) && match(FalseVal, m_SignMask())) || (Pred == ICMP_NE && match(TrueVal, m_SignMask()) && match(FalseVal, m_Zero()))) {
        return null;
    }
    let mut Ty: *mut Type = A.getType();
    let mut BW: u32 = Constant1.getBitWidth();
    let mut MostSignificantBit: APInt = getSignMask(BW);
    if Constant1.isNonNegative() || Constant2.isNonNegative() {
        return null;
    }
    let mut AdjAP1: APInt = *Constant1 - MostSignificantBit + 1;
    let mut AdjAP2: APInt = *Constant2 - MostSignificantBit + 1;
    let mut Adj1: *mut Constant = get(Ty, AdjAP1);
    let mut Adj2: *mut Constant = get(Ty, AdjAP2);
    let mut NewA: *mut Value = Builder.CreateBinaryIntrinsic(usub_sat, A, Adj1, FMFSource {}, "");
    let mut NewB: *mut Value = Builder.CreateBinaryIntrinsic(usub_sat, B, Adj2, FMFSource {}, "");
    let mut Or: *mut Value = Builder.CreateOr(NewA, NewB, "", false);
    let mut MSBConst: *mut Constant = get(Ty, MostSignificantBit);
    return CreateAnd(Or, MSBConst, "");
}

fn InstCombinerImpl::foldSelectInstWithICmp(self, SI: *mut SelectInst, ICI: *mut ICmpInst) -> *mut Instruction {
    if canonicalizeSPF(*ICI, SI.getTrueValue(), SI.getFalseValue(), *self) {
        V;
    } else {
        return self.replaceInstUsesWith(SI, V);
    }
    if foldSelectInstWithICmpConst(SI, ICI, self.Builder) {
        V;
    } else {
        return self.replaceInstUsesWith(SI, V);
    }
    if canonicalizeClampLike(SI, *ICI, self.Builder, *self) {
        V;
    } else {
        return self.replaceInstUsesWith(SI, V);
    }
    if tryToReuseConstantFromSelectInComparison(SI, *ICI, *self) {
        NewSel;
    } else {
        return NewSel;
    }
    if foldICmpUSubSatWithAndForMostSignificantBitCmp(SI, ICI, self.Builder) {
        Folded;
    } else {
        return Folded;
    }
    let mut Changed: bool = false;
    let mut TrueVal: *mut Value = SI.getTrueValue();
    let mut FalseVal: *mut Value = SI.getFalseValue();
    let mut Pred: Predicate = ICI.getPredicate();
    let mut CmpLHS: *mut Value = ICI.getOperand(0);
    let mut CmpRHS: *mut Value = ICI.getOperand(1);
    if foldSelectICmpEq(SI, ICI, *self) {
        NewSel;
    } else {
        return NewSel;
    }
    if Pred == ICMP_SGT && match(CmpRHS, m_AllOnes()) && !match(TrueVal, m_Constant()) && !match(FalseVal, m_Constant()) && ICI.hasOneUse() {
        let mut Guard: InsertPointGuard = self.Builder;
        self.Builder.SetInsertPoint(&mut SI);
        let mut IsNeg: *mut Value = self.Builder.CreateIsNeg(CmpLHS, ICI.getName());
        self.replaceOperand(SI, 0, IsNeg);
        SI.swapValues();
        SI.swapProfMetadata();
        return &mut SI;
    }
    if foldSelectICmpMinMax(ICI, TrueVal, FalseVal, self.Builder, self.SQ.getWithInstruction(&mut SI)) {
        V;
    } else {
        return self.replaceInstUsesWith(SI, V);
    }
    if foldSelectICmpAndZeroShl(ICI, TrueVal, FalseVal, self.Builder) {
        V;
    } else {
        return self.replaceInstUsesWith(SI, V);
    }
    if foldSelectCtlzToCttz(ICI, TrueVal, FalseVal, self.Builder) {
        V;
    } else {
        return V;
    }
    if foldSelectZeroOrOnes(ICI, TrueVal, FalseVal, self.Builder) {
        V;
    } else {
        return V;
    }
    if foldSelectICmpLshrAshr(ICI, TrueVal, FalseVal, self.Builder) {
        V;
    } else {
        return self.replaceInstUsesWith(SI, V);
    }
    if foldSelectCttzCtlz(ICI, TrueVal, FalseVal, *self) {
        V;
    } else {
        return self.replaceInstUsesWith(SI, V);
    }
    if canonicalizeSaturatedSubtract(ICI, TrueVal, FalseVal, self.Builder) {
        V;
    } else {
        return self.replaceInstUsesWith(SI, V);
    }
    if canonicalizeSaturatedAdd(ICI, TrueVal, FalseVal, self.Builder) {
        V;
    } else {
        return self.replaceInstUsesWith(SI, V);
    }
    if foldAbsDiff(ICI, TrueVal, FalseVal, self.Builder) {
        V;
    } else {
        return self.replaceInstUsesWith(SI, V);
    }
    if self.foldSelectWithConstOpToBinOp(ICI, TrueVal, FalseVal) {
        V;
    } else {
        return self.replaceInstUsesWith(SI, V);
    }
    return if Changed { &mut SI } else { null };
}

fn InstCombinerImpl::foldSPFofSPF(self, Inner: *mut Instruction, SPF1: SelectPatternFlavor, A: *mut Value, B: *mut Value, Outer: *mut Instruction, SPF2: SelectPatternFlavor, C: *mut Value) -> *mut Instruction {
    if Outer.getType() != Inner.getType() {
        return null;
    }
    if C == A || C == B {
        if SPF1 == SPF2 && isMinOrMax(SPF1) {
            return self.replaceInstUsesWith(Outer, Inner);
        }
    }
    return null;
}

fn foldAddSubSelect(SI: *mut SelectInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut CondVal: *mut Value = SI.getCondition();
    let mut TrueVal: *mut Value = SI.getTrueValue();
    let mut FalseVal: *mut Value = SI.getFalseValue();
    let mut TI: *mut Instruction = dyn_cast(TrueVal);
    let mut FI: *mut Instruction = dyn_cast(FalseVal);
    if !TI || !FI || !TI.hasOneUse() || !FI.hasOneUse() {
        return null;
    }
    let mut AddOp: *mut Instruction = null;
    let mut SubOp: *mut Instruction = null;
    if (TI.getOpcode() == Sub && FI.getOpcode() == Add) || (TI.getOpcode() == FSub && FI.getOpcode() == FAdd) {
        AddOp = FI;
        SubOp = TI;
    } else if (FI.getOpcode() == Sub && TI.getOpcode() == Add) || (FI.getOpcode() == FSub && TI.getOpcode() == FAdd) {
        AddOp = TI;
        SubOp = FI;
    }
    if AddOp {
        let mut OtherAddOp: *mut Value = null;
        if SubOp.getOperand(0) == AddOp.getOperand(0) {
            OtherAddOp = AddOp.getOperand(1);
        } else if SubOp.getOperand(0) == AddOp.getOperand(1) {
            OtherAddOp = AddOp.getOperand(0);
        }
        if OtherAddOp {
            let mut NegVal: *mut Value = null;
            if SI.getType().isFPOrFPVectorTy() {
                NegVal = Builder.CreateFNeg(SubOp.getOperand(1), "", null);
                if dyn_cast(NegVal) {
                    NegInst;
                } else {
                    let mut Flags: FastMathFlags = AddOp.getFastMathFlags();
                    operator(Flags, SubOp.getFastMathFlags());
                    NegInst.setFastMathFlags(Flags);
                }
            } else {
                NegVal = Builder.CreateNeg(SubOp.getOperand(1), "", false);
            }
            let mut NewTrueOp: *mut Value = OtherAddOp;
            let mut NewFalseOp: *mut Value = NegVal;
            if AddOp != TI {
                swap(NewTrueOp, NewFalseOp);
            }
            let mut NewSel: *mut Value = Builder.CreateSelect(CondVal, NewTrueOp, NewFalseOp, SI.getName() + ".p", &mut SI);
            if SI.getType().isFPOrFPVectorTy() {
                let mut RI: *mut Instruction = CreateFAdd(SubOp.getOperand(0), NewSel, "");
                let mut Flags: FastMathFlags = AddOp.getFastMathFlags();
                operator(Flags, SubOp.getFastMathFlags());
                RI.setFastMathFlags(Flags);
                return RI;
            } else {
                return CreateAdd(SubOp.getOperand(0), NewSel, "");
            }
        }
    }
    return null;
}

fn foldOverflowingAddSubSelect(SI: *mut SelectInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut CondVal: *mut Value = SI.getCondition();
    let mut TrueVal: *mut Value = SI.getTrueValue();
    let mut FalseVal: *mut Value = SI.getFalseValue();
    let mut II: *mut WithOverflowInst = null;
    if !match(CondVal, m_ExtractValue(m_WithOverflowInst(II))) || !match(FalseVal, m_ExtractValue(m_Specific(II))) {
        return null;
    }
    let mut X: *mut Value = II.getLHS();
    let mut Y: *mut Value = II.getRHS();
    let mut IsSignedSaturateLimit: Closure_8 = Closure_8 { X: &mut X, Y: &mut Y };
    let mut NewIntrinsicID: ID = zeroed();
    if II.getIntrinsicID() == uadd_with_overflow && match(TrueVal, m_AllOnes()) {
        NewIntrinsicID = uadd_sat;
    } else if II.getIntrinsicID() == usub_with_overflow && match(TrueVal, m_Zero()) {
        NewIntrinsicID = usub_sat;
    } else if II.getIntrinsicID() == sadd_with_overflow && IsSignedSaturateLimit.call(TrueVal, true) {
        NewIntrinsicID = sadd_sat;
    } else if II.getIntrinsicID() == ssub_with_overflow && IsSignedSaturateLimit.call(TrueVal, false) {
        NewIntrinsicID = ssub_sat;
    } else {
        return null;
    }
    let mut F: *mut Function = getOrInsertDeclaration(SI.getModule(), NewIntrinsicID, SI.getType());
    return Create(F, [X, Y], ArrayRef<OperandBundleDef> {}, "", null);
}

fn InstCombinerImpl::foldSelectExtConst(self, Sel: *mut SelectInst) -> *mut Instruction {
    let mut C: *mut Constant = null;
    if !match(Sel.getTrueValue(), m_Constant(C)) && !match(Sel.getFalseValue(), m_Constant(C)) {
        return null;
    }
    let mut ExtInst: *mut Instruction = null;
    if !match(Sel.getTrueValue(), m_Instruction(ExtInst)) && !match(Sel.getFalseValue(), m_Instruction(ExtInst)) {
        return null;
    }
    let mut ExtOpcode: u32 = ExtInst.getOpcode();
    if ExtOpcode != ZExt && ExtOpcode != SExt {
        return null;
    }
    let mut X: *mut Value = ExtInst.getOperand(0);
    let mut SmallType: *mut Type = X.getType();
    let mut Cond: *mut Value = Sel.getCondition();
    if !SmallType.isIntOrIntVectorTy(1) && (!isa(Cond) || cast(Cond).getOperand(0).getType() != SmallType) {
        return null;
    }
    let mut SelType: *mut Type = Sel.getType();
    let mut TruncC: *mut Constant = getLosslessInvCast(C, SmallType, ExtOpcode, self.DL, null);
    if TruncC && ExtInst.hasOneUse() {
        let mut TruncCVal: *mut Value = cast(TruncC);
        if ExtInst == Sel.getFalseValue() {
            swap(X, TruncCVal);
        }
        let mut NewSel: *mut Value = self.Builder.CreateSelect(Cond, X, TruncCVal, "narrow", &mut Sel);
        return Create(ExtOpcode, NewSel, SelType, "", null);
    }
    return null;
}

fn canonicalizeSelectToShuffle(SI: *mut SelectInst) -> *mut Instruction {
    let mut CondVal: *mut Value = SI.getCondition();
    let mut CondC: *mut Constant = null;
    let mut CondValTy: *mut FixedVectorType = dyn_cast(CondVal.getType());
    if !CondValTy || !match(CondVal, m_Constant(CondC)) {
        return null;
    }
    let mut NumElts: u32 = CondValTy.getNumElements();
    let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> {};
    Mask.reserve(NumElts);
    for let mut i: u32 = 0; i != NumElts; i += 1 {
        let mut Elt: *mut Constant = CondC.getAggregateElement(i);
        if !Elt {
            return null;
        }
        if Elt.isOneValue() {
            Mask.push(i);
        } else if Elt.isNullValue() {
            Mask.push(i + NumElts);
        } else if isa(Elt) {
            return null;
        } else {
            return null;
        }
    }
    return ShuffleVectorInst { SI.getTrueValue(), SI.getFalseValue(), Mask, "", null };
}

fn canonicalizeScalarSelectOfVecs(Sel: *mut SelectInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut Ty: *mut VectorType = dyn_cast(Sel.getType());
    if !Ty {
        return null;
    }
    let mut Cond: *mut Value = Sel.getCondition();
    if !match(Cond, m_OneUse(m_ExtractElt(m_Value(), m_ConstantInt()))) {
        return null;
    }
    return IC.replaceOperand(Sel, 0, IC.Builder.CreateVectorSplat(Ty.getElementCount(), Cond, ""));
}

fn foldSelectCmpBitcasts(Sel: *mut SelectInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Cond: *mut Value = Sel.getCondition();
    let mut TVal: *mut Value = Sel.getTrueValue();
    let mut FVal: *mut Value = Sel.getFalseValue();
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    if !match(Cond, m_Cmp(Pred, m_Value(A), m_Value(B))) {
        return null;
    }
    if TVal == A || TVal == B || FVal == A || FVal == B {
        return null;
    }
    let mut C: *mut Value = null;
    let mut D: *mut Value = null;
    if !match(A, m_BitCast(m_Value(C))) || !match(B, m_BitCast(m_Value(D))) {
        return null;
    }
    let mut TSrc: *mut Value = null;
    let mut FSrc: *mut Value = null;
    if !match(TVal, m_BitCast(m_Value(TSrc))) || !match(FVal, m_BitCast(m_Value(FSrc))) {
        return null;
    }
    let mut NewSel: *mut Value = null;
    if TSrc == C && FSrc == D {
        NewSel = Builder.CreateSelect(Cond, A, B, "", &mut Sel);
    } else if TSrc == D && FSrc == C {
        NewSel = Builder.CreateSelect(Cond, B, A, "", &mut Sel);
    } else {
        return null;
    }
    return BitCastInst { NewSel, Sel.getType(), "", null };
}

fn foldSelectCmpXchg(SI: *mut SelectInst) -> *mut Value {
    let mut isExtractFromCmpXchg: Closure_11 = Closure_11 {};
    let mut isCompareSameAsValue: Closure_12 = Closure_12 {};
    if SI.hasOneUse() {
        if dyn_cast(SI.user_back()) {
            Select;
        } else if Select.getCondition() == SI.getCondition() {
            if Select.getFalseValue() == SI.getTrueValue() || Select.getTrueValue() == SI.getFalseValue() {
                return null;
            }
        }
    }
    let mut CmpXchg: *mut AtomicCmpXchgInst = isExtractFromCmpXchg.call(SI.getCondition(), 1);
    if !CmpXchg {
        return null;
    }
    if isExtractFromCmpXchg.call(SI.getTrueValue(), 0) {
        X;
    } else if X == CmpXchg && isCompareSameAsValue.call(X.getCompareOperand(), SI.getFalseValue()) {
        return SI.getFalseValue();
    }
    if isExtractFromCmpXchg.call(SI.getFalseValue(), 0) {
        X;
    } else if X == CmpXchg && isCompareSameAsValue.call(X.getCompareOperand(), SI.getTrueValue()) {
        return SI.getFalseValue();
    }
    return null;
}

fn foldSelectFunnelShift(Sel: *mut SelectInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Width: u32 = Sel.getType().getScalarSizeInBits();
    if !isPowerOf2_32(Width) {
        return null;
    }
    let mut Or0: *mut BinaryOperator = null;
    let mut Or1: *mut BinaryOperator = null;
    if !match(Sel.getFalseValue(), m_OneUse(m_Or(m_BinOp(Or0), m_BinOp(Or1)))) {
        return null;
    }
    let mut SV0: *mut Value = null;
    let mut SV1: *mut Value = null;
    let mut SA0: *mut Value = null;
    let mut SA1: *mut Value = null;
    if !match(Or0, m_OneUse(m_LogicalShift(m_Value(SV0), m_ZExtOrSelf(m_Value(SA0))))) || !match(Or1, m_OneUse(m_LogicalShift(m_Value(SV1), m_ZExtOrSelf(m_Value(SA1))))) || Or0.getOpcode() == Or1.getOpcode() {
        return null;
    }
    if Or0.getOpcode() == LShr {
        swap(Or0, Or1);
        swap(SV0, SV1);
        swap(SA0, SA1);
    }
    assert!(Or0.getOpcode() == Shl && Or1.getOpcode() == LShr, "Illegal or(shift,shift) pair");
    let mut ShAmt: *mut Value = null;
    if match(SA1, m_OneUse(m_Sub(m_SpecificInt(Width), m_Specific(SA0)))) {
        ShAmt = SA0;
    } else if match(SA0, m_OneUse(m_Sub(m_SpecificInt(Width), m_Specific(SA1)))) {
        ShAmt = SA1;
    } else {
        return null;
    }
    let mut IsFshl: bool = (ShAmt == SA0);
    let mut TVal: *mut Value = Sel.getTrueValue();
    if (IsFshl && TVal != SV0) || (!IsFshl && TVal != SV1) {
        return null;
    }
    let mut Cond: *mut Value = Sel.getCondition();
    if !match(Cond, m_OneUse(m_SpecificICmp(CmpPredicate { Pred: ICMP_EQ, HasSameSign: false }, m_Specific(ShAmt), m_ZeroInt()))) {
        return null;
    }
    if SV0 != SV1 {
        if IsFshl && !isGuaranteedNotToBePoison(SV1, null, null, null, 0) {
            SV1 = Builder.CreateFreeze(SV1, "");
        } else if !IsFshl && !isGuaranteedNotToBePoison(SV0, null, null, null, 0) {
            SV0 = Builder.CreateFreeze(SV0, "");
        }
    }
    let mut IID: ID = if IsFshl { fshl } else { fshr };
    let mut F: *mut Function = getOrInsertDeclaration(Sel.getModule(), IID, Sel.getType());
    ShAmt = Builder.CreateZExt(ShAmt, Sel.getType(), "", false);
    return Create(F, [SV0, SV1, ShAmt], ArrayRef<OperandBundleDef> {}, "", null);
}

fn foldSelectToCopysign(Sel: *mut SelectInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Cond: *mut Value = Sel.getCondition();
    let mut TVal: *mut Value = Sel.getTrueValue();
    let mut FVal: *mut Value = Sel.getFalseValue();
    let mut SelType: *mut Type = Sel.getType();
    let mut TC: *APFloat = null;
    let mut FC: *APFloat = null;
    if !match(TVal, m_APFloatAllowPoison(TC)) || !match(FVal, m_APFloatAllowPoison(FC)) || !if *TC < 0 { -*TC } else { *TC }.bitwiseIsEqual(if *FC < 0 { -*FC } else { *FC }) {
        return null;
    }
    assert!(TC != FC, "Expected equal select arms to simplify");
    let mut X: *mut Value = null;
    let mut C: *APInt = null;
    let mut IsTrueIfSignSet: bool = false;
    let mut Pred: CmpPredicate = CmpPredicate {};
    if !match(Cond, m_OneUse(m_ICmp(Pred, m_ElementWiseBitCast(m_Value(X)), m_APInt(C)))) || !isSignBitCheck(Pred.operator llvm::CmpInst::Predicate(), *C, IsTrueIfSignSet) || X.getType() != SelType {
        return null;
    }
    if IsTrueIfSignSet ^ TC.isNegative() {
        X = Builder.CreateFNeg(X, "", null);
    }
    let mut MagArg: *mut Value = get(SelType, if *TC < 0 { -*TC } else { *TC });
    let mut F: *mut Function = getOrInsertDeclaration(Sel.getModule(), copysign, Sel.getType());
    return Create(F, [MagArg, X], ArrayRef<OperandBundleDef> {}, "", null);
}

fn InstCombinerImpl::foldVectorSelect(self, Sel: *mut SelectInst) -> *mut Instruction {
    if !isa(Sel.getType()) {
        return null;
    }
    let mut Cond: *mut Value = Sel.getCondition();
    let mut TVal: *mut Value = Sel.getTrueValue();
    let mut FVal: *mut Value = Sel.getFalseValue();
    let mut C: *mut Value = null;
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(Cond, m_VecReverse(m_Value(C))) {
        let mut createSelReverse: Closure_13 = Closure_13 { cap_0: self, Sel: &mut Sel };
        if match(TVal, m_VecReverse(m_Value(X))) {
            if match(FVal, m_VecReverse(m_Value(Y))) && (Cond.hasOneUse() || TVal.hasOneUse() || FVal.hasOneUse()) {
                return createSelReverse.call(C, X, Y);
            }
            if (Cond.hasOneUse() || TVal.hasOneUse()) && isSplatValue(FVal, -1, 0) {
                return createSelReverse.call(C, X, FVal);
            }
        } else if isSplatValue(TVal, -1, 0) && match(FVal, m_VecReverse(m_Value(Y))) && (Cond.hasOneUse() || FVal.hasOneUse()) {
            return createSelReverse.call(C, TVal, Y);
        }
    }
    let mut VecTy: *mut FixedVectorType = dyn_cast(Sel.getType());
    if !VecTy {
        return null;
    }
    let mut NumElts: u32 = VecTy.getNumElements();
    let mut PoisonElts: APInt = APInt { NumElts, 0, false, false };
    let mut AllOnesEltMask: APInt = getAllOnes(NumElts);
    if self.SimplifyDemandedVectorElts(&mut Sel, AllOnesEltMask, PoisonElts, 0, false) {
        V;
    } else {
        if V != &mut Sel {
            return self.replaceInstUsesWith(Sel, V);
        }
        return &mut Sel;
    }
    let mut Mask: ArrayRef<int> = ArrayRef<int> {};
    if match(TVal, m_OneUse(m_Shuffle(m_Value(X), m_Value(Y), Mask))) && !is_contained(Mask, PoisonMaskElem) && cast(TVal).isSelect() {
        if X == FVal {
            let mut NewSel: *mut Value = self.Builder.CreateSelect(Cond, Y, X, "sel", &mut Sel);
            return ShuffleVectorInst { X, NewSel, Mask, "", null };
        }
        if Y == FVal {
            let mut NewSel: *mut Value = self.Builder.CreateSelect(Cond, X, Y, "sel", &mut Sel);
            return ShuffleVectorInst { NewSel, Y, Mask, "", null };
        }
    }
    if match(FVal, m_OneUse(m_Shuffle(m_Value(X), m_Value(Y), Mask))) && !is_contained(Mask, PoisonMaskElem) && cast(FVal).isSelect() {
        if X == TVal {
            let mut NewSel: *mut Value = self.Builder.CreateSelect(Cond, X, Y, "sel", &mut Sel);
            return ShuffleVectorInst { X, NewSel, Mask, "", null };
        }
        if Y == TVal {
            let mut NewSel: *mut Value = self.Builder.CreateSelect(Cond, Y, X, "sel", &mut Sel);
            return ShuffleVectorInst { NewSel, Y, Mask, "", null };
        }
    }
    return null;
}

fn foldSelectToPhiImpl(Sel: *mut SelectInst, BB: *mut BasicBlock, DT: *DominatorTree, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut IDomNode: *mut DomTreeNodeBase<BasicBlock> = DT[BB].getIDom();
    if !IDomNode {
        return null;
    }
    let mut IDom: *mut BasicBlock = IDomNode.getBlock();
    let mut Cond: *mut Value = Sel.getCondition();
    let mut IfTrue: *mut Value = null;
    let mut IfFalse: *mut Value = null;
    let mut TrueSucc: *mut BasicBlock = null;
    let mut FalseSucc: *mut BasicBlock = null;
    if match(IDom.getTerminator(), m_Br(m_Specific(Cond), m_BasicBlock(TrueSucc), m_BasicBlock(FalseSucc))) {
        IfTrue = Sel.getTrueValue();
        IfFalse = Sel.getFalseValue();
    } else if match(IDom.getTerminator(), m_Br(m_Not(m_Specific(Cond)), m_BasicBlock(TrueSucc), m_BasicBlock(FalseSucc))) {
        IfTrue = Sel.getFalseValue();
        IfFalse = Sel.getTrueValue();
    } else {
        return null;
    }
    if TrueSucc == FalseSucc {
        return null;
    }
    let mut TrueEdge: BasicBlockEdge = BasicBlockEdge { Start: IDom, End: TrueSucc };
    let mut FalseEdge: BasicBlockEdge = BasicBlockEdge { Start: IDom, End: FalseSucc };
    let mut Inputs: DenseMap<BasicBlock *, Value *> = DenseMap<BasicBlock *, Value *> {};
    for Pred in predecessors(BB) {
        let mut Incoming: BasicBlockEdge = BasicBlockEdge { Start: Pred, End: BB };
        if DT.dominates(TrueEdge, Incoming) {
            Inputs[Pred] = IfTrue.DoPHITranslation(BB, Pred);
        } else if DT.dominates(FalseEdge, Incoming) {
            Inputs[Pred] = IfFalse.DoPHITranslation(BB, Pred);
        } else {
            return null;
        }
        if dyn_cast(Inputs[Pred]) {
            Insn;
        } else if !DT.dominates(Insn, Pred.getTerminator()) {
            return null;
        }
    }
    Builder.SetInsertPoint(BB.begin());
    let mut PN: *mut PHINode = Builder.CreatePHI(Sel.getType(), Inputs.len, "");
    for Pred in predecessors(BB) {
        PN.addIncoming(Inputs[Pred], Pred);
    }
    PN.takeName(&mut Sel);
    return PN;
}

fn foldSelectToPhi(Sel: *mut SelectInst, DT: *DominatorTree, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut CandidateBlocks: SmallSetVector<BasicBlock *, 4> = SmallSetVector<BasicBlock *, 4> {};
    CandidateBlocks.insert(Sel.getParent());
    for V in Sel.operands() {
        if dyn_cast(V) {
            I;
        } else {
            CandidateBlocks.insert(I.getParent());
        }
    }
    for BB in CandidateBlocks {
        if foldSelectToPhiImpl(Sel, BB, DT, Builder) {
            PN;
        } else {
            return PN;
        }
    }
    return null;
}

fn foldSelectWithSRem(SI: *mut SelectInst, IC: *mut InstCombinerImpl, Builder: *mut IRBuilderBase) -> *mut Instruction {
    let mut CondVal: *mut Value = SI.getCondition();
    let mut TrueVal: *mut Value = SI.getTrueValue();
    let mut FalseVal: *mut Value = SI.getFalseValue();
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut Op: *mut Value = null;
    let mut RemRes: *mut Value = null;
    let mut Remainder: *mut Value = null;
    let mut C: *APInt = null;
    let mut TrueIfSigned: bool = false;
    if !(match(CondVal, m_ICmp(Pred, m_Value(RemRes), m_APInt(C))) && isSignBitCheck(Pred.operator llvm::CmpInst::Predicate(), *C, TrueIfSigned)) {
        return null;
    }
    if !TrueIfSigned {
        swap(TrueVal, FalseVal);
    }
    let mut FoldToBitwiseAnd: Closure_14 = Closure_14 { Builder: &mut Builder, RemRes: &mut RemRes, Op: &mut Op };
    if match(TrueVal, m_c_Add(m_Specific(RemRes), m_Value(Remainder))) && match(RemRes, m_SRem(m_Value(Op), m_Specific(Remainder))) && IC.isKnownToBeAPowerOfTwo(Remainder, true, null, 0) && FalseVal == RemRes {
        return FoldToBitwiseAnd.call(Remainder);
    }
    if match(TrueVal, m_One()) && match(RemRes, m_SRem(m_Value(Op), m_SpecificInt(2))) && FalseVal == RemRes {
        return FoldToBitwiseAnd.call(get(RemRes.getType(), 2, false, false));
    }
    return null;
}

fn simplifyNestedSelectsUsingImpliedCond(SI: *mut SelectInst, CondVal: *mut Value, CondIsTrue: bool, DL: *DataLayout) -> *mut Value {
    let mut InnerCondVal: *mut Value = SI.getCondition();
    let mut InnerTrueVal: *mut Value = SI.getTrueValue();
    let mut InnerFalseVal: *mut Value = SI.getFalseValue();
    assert!(CondVal.getType() == InnerCondVal.getType(), "The type of inner condition must match with the outer.");
    if isImpliedCondition(CondVal, InnerCondVal, DL, CondIsTrue, 0) {
        Implied;
    } else {
        return if operator(Implied) { InnerTrueVal } else { InnerFalseVal };
    }
    return null;
}

fn InstCombinerImpl::foldAndOrOfSelectUsingImpliedCond(self, Op: *mut Value, SI: *mut SelectInst, IsAnd: bool) -> *mut Instruction {
    assert!(Op.getType().isIntOrIntVectorTy(1), "Op must be either i1 or vector of i1.");
    if SI.getCondition().getType() != Op.getType() {
        return null;
    }
    if simplifyNestedSelectsUsingImpliedCond(SI, Op, IsAnd, self.DL) {
        V;
    } else {
        return self.createSelectInstWithUnknownProfile(Op, if IsAnd { V } else { getTrue(Op.getType()) }, if IsAnd { getFalse(Op.getType()) } else { V }, "", null);
    }
    return null;
}

fn foldSelectWithFCmpToFabs(SI: *mut SelectInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut CondVal: *mut Value = SI.getCondition();
    let mut ChangedFMF: bool = false;
    for Swap in [false, true] {
        let mut TrueVal: *mut Value = SI.getTrueValue();
        let mut X: *mut Value = SI.getFalseValue();
        let mut Pred: CmpPredicate = CmpPredicate {};
        if Swap {
            swap(TrueVal, X);
        }
        if !match(CondVal, m_FCmp(Pred, m_Specific(X), m_AnyZeroFP())) {
            continue;
        }
        if match(TrueVal, m_FSub(m_PosZeroFP(), m_Specific(X))) && (cast(CondVal).hasNoNaNs() || SI.hasNoNaNs() || (SI.hasOneUse() && canIgnoreSignBitOfNaN(operator(SI.use_begin()))) || isKnownNeverNaN(X, IC.getSimplifyQuery().getWithInstruction(cast(CondVal)), 0)) {
            if !Swap && (Pred == FCMP_OLE || Pred == FCMP_ULE) {
                let mut Fabs: *mut Value = IC.Builder.CreateFAbs(X, &mut SI, "");
                return IC.replaceInstUsesWith(SI, Fabs);
            }
            if Swap && (Pred == FCMP_OGT || Pred == FCMP_UGT) {
                let mut Fabs: *mut Value = IC.Builder.CreateFAbs(X, &mut SI, "");
                return IC.replaceInstUsesWith(SI, Fabs);
            }
        }
        if !match(TrueVal, m_FNeg(m_Specific(X))) {
            return null;
        }
        let mut FMF: FastMathFlags = cast(CondVal).getFastMathFlags();
        if FMF.noNaNs() && !SI.hasNoNaNs() {
            SI.setHasNoNaNs(true);
            ChangedFMF = true;
        }
        if FMF.noInfs() && !SI.hasNoInfs() {
            SI.setHasNoInfs(true);
            ChangedFMF = true;
        }
        if !SI.hasNoNaNs() && cast(TrueVal).hasNoNaNs() && (if Swap { isOrdered(Pred.operator llvm::CmpInst::Predicate()) } else { isUnordered(Pred.operator llvm::CmpInst::Predicate()) }) {
            SI.setHasNoNaNs(true);
            ChangedFMF = true;
        }
        if !SI.hasNoSignedZeros() && (!SI.hasOneUse() || !canIgnoreSignBitOfZero(operator(SI.use_begin()))) {
            return null;
        }
        if !SI.hasNoNaNs() && (!SI.hasOneUse() || !canIgnoreSignBitOfNaN(operator(SI.use_begin()))) {
            return null;
        }
        if Swap {
            Pred = CmpPredicate { Pred: getSwappedPredicate(Pred.operator llvm::CmpInst::Predicate()), HasSameSign: false };
        }
        let mut IsLTOrLE: bool = Pred == FCMP_OLT || Pred == FCMP_OLE || Pred == FCMP_ULT || Pred == FCMP_ULE;
        let mut IsGTOrGE: bool = Pred == FCMP_OGT || Pred == FCMP_OGE || Pred == FCMP_UGT || Pred == FCMP_UGE;
        if IsLTOrLE {
            let mut Fabs: *mut Value = IC.Builder.CreateFAbs(X, &mut SI, "");
            return IC.replaceInstUsesWith(SI, Fabs);
        }
        if IsGTOrGE {
            let mut Fabs: *mut Value = IC.Builder.CreateFAbs(X, &mut SI, "");
            let mut NewFNeg: *mut Instruction = CreateFNeg(Fabs, "");
            NewFNeg.setFastMathFlags(SI.getFastMathFlags());
            return NewFNeg;
        }
    }
    for Swap in [false, true] {
        let mut TrueVal: *mut Value = SI.getTrueValue();
        let mut X: *mut Value = SI.getFalseValue();
        if Swap {
            swap(TrueVal, X);
        }
        let mut Pred: CmpPredicate = CmpPredicate {};
        let mut C: *APInt = null;
        let mut TrueIfSigned: bool = false;
        if !match(CondVal, m_ICmp(Pred, m_ElementWiseBitCast(m_Specific(X)), m_APInt(C))) || !isSignBitCheck(Pred.operator llvm::CmpInst::Predicate(), *C, TrueIfSigned) {
            continue;
        }
        if !match(TrueVal, m_FNeg(m_Specific(X))) {
            return null;
        }
        if Swap == TrueIfSigned && !CondVal.hasOneUse() && !TrueVal.hasOneUse() {
            return null;
        }
        let mut Fabs: *mut Value = IC.Builder.CreateFAbs(X, &mut SI, "");
        if Swap != TrueIfSigned {
            return IC.replaceInstUsesWith(SI, Fabs);
        }
        return CreateFNegFMF(Fabs, &mut SI, "", null);
    }
    return if ChangedFMF { &mut SI } else { null };
}

fn foldSelectOfOrderedFAbsCmpOfNaNScrubbedValue(SI: *mut SelectInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut OuterCmpI: *mut Instruction = null;
    let mut Cmp0: *mut Value = null;
    let mut Cmp1: *mut Value = null;
    if !match(SI.getCondition(), m_OneUse(m_Instruction(OuterCmpI, m_FCmp(m_Value(Cmp0), m_Value(Cmp1))))) {
        return null;
    }
    let mut OuterCmp: *mut FCmpInst = cast(OuterCmpI);
    let mut Pred: Predicate = OuterCmp.getPredicate();
    if !isOrdered(Pred) {
        return null;
    }
    let mut Y: *mut Value = SI.getFalseValue();
    let mut InnerSel: *mut Value = SI.getTrueValue();
    let mut X: *mut Value = null;
    if !match(InnerSel, m_Select(m_OneUse(m_SpecificFCmp(CmpPredicate { Pred: FCMP_ORD, HasSameSign: false }, m_Value(X), m_AnyZeroFP())), m_Deferred(X), m_Specific(Y))) {
        return null;
    }
    let mut FAbsI: *mut Instruction = null;
    let mut MatchFAbsOfInnerSel: Closure_15 = Closure_15 { FAbsI: &mut FAbsI, InnerSel: &mut InnerSel };
    if !MatchFAbsOfInnerSel.call(Cmp0) {
        if !MatchFAbsOfInnerSel.call(Cmp1) {
            return null;
        }
        swap(Cmp0, Cmp1);
        Pred = getSwappedPredicate(Pred);
    }
    let mut FAbsFMF: FastMathFlags = FAbsI.getFastMathFlags();
    let mut CmpFMF: FastMathFlags = OuterCmp.getFastMathFlags();
    let mut CommonRewriteFMF: FastMathFlags = intersectRewrite(FAbsFMF, CmpFMF);
    let mut NewFAbsFMF: FastMathFlags = CommonRewriteFMF | unionValue(FAbsFMF, FastMathFlags {});
    let mut NewCmpFMF: FastMathFlags = CommonRewriteFMF | unionValue(CmpFMF, FastMathFlags {});
    NewFAbsFMF.setNoNaNs(false);
    NewCmpFMF.setNoNaNs(false);
    let mut NewAbs: *mut Value = IC.Builder.CreateFAbs(X, NewFAbsFMF, "");
    let mut NewCmp: *mut Value = IC.Builder.CreateFCmpFMF(Pred, NewAbs, Cmp1, NewCmpFMF, "", null);
    let mut NewSel: *mut Value = IC.Builder.CreateSelectFMF(NewCmp, X, Y, &mut SI, "", null);
    return IC.replaceInstUsesWith(SI, NewSel);
}

fn foldRoundUpIntegerWithPow2Alignment(SI: *mut SelectInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut Cond: *mut Value = SI.getCondition();
    let mut X: *mut Value = SI.getTrueValue();
    let mut XBiasedHighBits: *mut Value = SI.getFalseValue();
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut XLowBits: *mut Value = null;
    if !match(Cond, m_ICmp(Pred, m_Value(XLowBits), m_ZeroInt())) || !isEquality(Pred.operator llvm::CmpInst::Predicate()) {
        return null;
    }
    if Pred == ICMP_NE {
        swap(X, XBiasedHighBits);
    }
    let mut LowBitMaskCst: *APInt = null;
    if !match(XLowBits, m_And(m_Specific(X), m_APIntAllowPoison(LowBitMaskCst))) {
        return null;
    }
    let mut BiasCst: *APInt = null;
    let mut HighBitMaskCst: *APInt = null;
    if !match(XBiasedHighBits, m_And(m_Add(m_Specific(X), m_APIntAllowPoison(BiasCst)), m_APIntAllowPoison(HighBitMaskCst))) && !match(XBiasedHighBits, m_Add(m_And(m_Specific(X), m_APIntAllowPoison(HighBitMaskCst)), m_APIntAllowPoison(BiasCst))) {
        return null;
    }
    if !LowBitMaskCst.isMask() {
        return null;
    }
    let mut InvertedLowBitMaskCst: APInt = operator(*LowBitMaskCst);
    if InvertedLowBitMaskCst != *HighBitMaskCst {
        return null;
    }
    let mut AlignmentCst: APInt = *LowBitMaskCst + 1;
    if *BiasCst != AlignmentCst && *BiasCst != *LowBitMaskCst {
        return null;
    }
    if !XBiasedHighBits.hasOneUse() {
        if *BiasCst == *LowBitMaskCst && impliesPoison(XBiasedHighBits, X) {
            return XBiasedHighBits;
        }
        return null;
    }
    let mut Ty: *mut Type = X.getType();
    let mut XOffset: *mut Value = Builder.CreateAdd(X, get(Ty, *LowBitMaskCst), X.getName() + ".biased", false, false);
    let mut R: *mut Value = Builder.CreateAnd(XOffset, get(Ty, *HighBitMaskCst), "");
    R.takeName(&mut SI);
    return R;
}

struct DecomposedSelect {
    Cond: *mut Value,
    TrueVal: *mut Value,
    FalseVal: *mut Value,
}

fn foldSelectOfSymmetricSelect(OuterSelVal: *mut SelectInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut OuterCond: *mut Value = null;
    let mut InnerCond: *mut Value = null;
    let mut InnerTrueVal: *mut Value = null;
    let mut InnerFalseVal: *mut Value = null;
    if !match(&mut OuterSelVal, m_Select(m_Value(OuterCond), m_OneUse(m_Select(m_Value(InnerCond), m_Value(InnerTrueVal), m_Value(InnerFalseVal))), m_OneUse(m_Select(m_Deferred(InnerCond), m_Deferred(InnerFalseVal), m_Deferred(InnerTrueVal))))) {
        return null;
    }
    if OuterCond.getType() != InnerCond.getType() {
        return null;
    }
    let mut Xor: *mut Value = Builder.CreateXor(InnerCond, OuterCond, "");
    return Create(Xor, InnerFalseVal, InnerTrueVal, "", null, null);
}

fn foldNestedSelects(OuterSelVal: *mut SelectInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut OuterSel: DecomposedSelect = DecomposedSelect {};
    match(&mut OuterSelVal, m_Select(m_Value(OuterSel.Cond), m_Value(OuterSel.TrueVal), m_Value(OuterSel.FalseVal)));
    if match(OuterSel.Cond, m_Not(m_Value(OuterSel.Cond))) {
        swap(OuterSel.TrueVal, OuterSel.FalseVal);
    }
    if !match(OuterSel.Cond, m_c_LogicalOp(m_Value(), m_Value())) {
        return null;
    }
    let mut IsAndVariant: bool = match(OuterSel.Cond, m_LogicalAnd());
    let mut InnerSelVal: *mut Value = if IsAndVariant { OuterSel.FalseVal } else { OuterSel.TrueVal };
    if none_of([OuterSelVal.getCondition(), InnerSelVal], match_fn(m_OneUse(m_Value()))) {
        return null;
    }
    let mut InnerSel: DecomposedSelect = DecomposedSelect {};
    if !match(InnerSelVal, m_Select(m_Value(InnerSel.Cond), m_Value(InnerSel.TrueVal), m_Value(InnerSel.FalseVal))) {
        return null;
    }
    if match(InnerSel.Cond, m_Not(m_Value(InnerSel.Cond))) {
        swap(InnerSel.TrueVal, InnerSel.FalseVal);
    }
    let mut AltCond: *mut Value = null;
    let mut matchOuterCond: Closure_16 = Closure_16 { cap_0: OuterSel, IsAndVariant: IsAndVariant, AltCond: &mut AltCond };
    if matchOuterCond.call(m_Specific(InnerSel.Cond)) {} else if  {
        matchOuterCond.call(m_CombineAnd(m_Not(m_Specific(InnerSel.Cond)), m_Value(NotInnerCond)));
    } else {
        swap(InnerSel.TrueVal, InnerSel.FalseVal);
        InnerSel.Cond = NotInnerCond;
    }
    let mut SelInner: *mut Value = Builder.CreateSelect(AltCond, if IsAndVariant { OuterSel.TrueVal } else { InnerSel.FalseVal }, if IsAndVariant { InnerSel.TrueVal } else { OuterSel.FalseVal }, "", null);
    SelInner.takeName(InnerSelVal);
    return Create(InnerSel.Cond, if IsAndVariant { SelInner } else { InnerSel.TrueVal }, if !IsAndVariant { SelInner } else { InnerSel.FalseVal }, "", null, null);
}

fn impliesPoisonOrCond(ValAssumedPoison: *Value, V: *Value, Expected: bool, SQ: *SimplifyQuery) -> bool {
    if impliesPoison(ValAssumedPoison, V) {
        return true;
    }
    if dyn_cast(ValAssumedPoison) {
        ICmp;
    } else {
        let mut LHS: *mut Value = ICmp.getOperand(0);
        let mut RHSC1: *APInt = null;
        let mut RHSC2: *APInt = null;
        let mut Pred: CmpPredicate = CmpPredicate {};
        if ICmp.hasSameSign() && match(ICmp.getOperand(1), m_APIntForbidPoison(RHSC1)) && match(V, m_ICmp(Pred, m_Specific(LHS), m_APIntAllowPoison(RHSC2))) {
            let mut BitWidth: u32 = RHSC1.getBitWidth();
            let mut CRX: ConstantRange = if RHSC1.isNonNegative() { ConstantRange { Lower: getSignedMinValue(BitWidth), Upper: getZero(BitWidth) } } else { ConstantRange { Lower: getZero(BitWidth), Upper: getSignedMinValue(BitWidth) } };
            return CRX.icmp(if Expected { Pred } else { getInverseCmpPredicate(Pred) }.operator llvm::CmpInst::Predicate(), *RHSC2);
        }
    }
    let mut A: *mut Value = null;
    if match(ValAssumedPoison, m_NUWTrunc(m_Value(A))) && !cast(ValAssumedPoison).hasNoSignedWrap() && isGuaranteedNotToBePoison(A, null, null, null, 0) {
        assert!(ValAssumedPoison.getType().isIntOrIntVectorTy(1);
        return computeKnownBits(A, SQ.getWithInstruction(cast(ValAssumedPoison)), 0).getMaxValue() == 1;
    }
    return false;
}

fn InstCombinerImpl::foldSelectOfBools(self, SI: *mut SelectInst) -> *mut Instruction {
    let mut CondVal: *mut Value = SI.getCondition();
    let mut TrueVal: *mut Value = SI.getTrueValue();
    let mut FalseVal: *mut Value = SI.getFalseValue();
    let mut SelType: *mut Type = SI.getType();
    if !SelType.isIntOrIntVectorTy(1) || isa(CondVal) || TrueVal.getType() != CondVal.getType() {
        return null;
    }
    let mut One: *mut Constant = getTrue(SelType);
    let mut Zero: *mut Constant = getFalse(SelType);
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut C: *mut Value = null;
    let mut D: *mut Value = null;
    if match(TrueVal, m_One()) {
        if impliesPoisonOrCond(FalseVal, CondVal, false, self.SQ) {
            return CreateOr(CondVal, FalseVal, "");
        }
        if match(CondVal, m_OneUse(m_Select(m_Value(A), m_One(), m_Value(B)))) && impliesPoisonOrCond(FalseVal, B, false, self.SQ) {
            let mut LOr: *mut Value = self.Builder.CreateLogicalOr(A, self.Builder.CreateOr(B, FalseVal, "", false), "", null);
            if dyn_cast(LOr) {
                I;
            } else {
                setExplicitlyUnknownBranchWeightsIfProfiled(*I, "instcombine", null);
            }
            return self.replaceInstUsesWith(SI, LOr);
        }
        if match(CondVal, m_LogicalAnd(m_Value(A), m_Value(B))) && match(FalseVal, m_LogicalAnd(m_Value(C), m_Value(D))) && (CondVal.hasOneUse() || FalseVal.hasOneUse()) {
            let mut CondLogicAnd: bool = isa(CondVal);
            let mut FalseLogicAnd: bool = isa(FalseVal);
            let mut AndFactorization: Closure_17 = Closure_17 { cap_0: self, One: &mut One, FalseLogicAnd: &mut FalseLogicAnd, CondLogicAnd: &mut CondLogicAnd, A: &mut A, Zero: &mut Zero };
            if A == C {
                return AndFactorization.call(A, B, D, false);
            }
            if A == D {
                return AndFactorization.call(A, B, C, false);
            }
            if B == C {
                return AndFactorization.call(B, A, D, false);
            }
            if B == D {
                return AndFactorization.call(B, A, C, CondLogicAnd && FalseLogicAnd);
            }
        }
    }
    if match(FalseVal, m_Zero()) {
        if impliesPoisonOrCond(TrueVal, CondVal, true, self.SQ) {
            return CreateAnd(CondVal, TrueVal, "");
        }
        if match(CondVal, m_OneUse(m_Select(m_Value(A), m_Value(B), m_Zero()))) && impliesPoisonOrCond(TrueVal, B, true, self.SQ) {
            let mut LAnd: *mut Value = self.Builder.CreateLogicalAnd(A, self.Builder.CreateAnd(B, TrueVal, ""), "", null);
            if dyn_cast(LAnd) {
                I;
            } else {
                setExplicitlyUnknownBranchWeightsIfProfiled(*I, "instcombine", null);
            }
            return self.replaceInstUsesWith(SI, LAnd);
        }
        if match(CondVal, m_LogicalOr(m_Value(A), m_Value(B))) && match(TrueVal, m_LogicalOr(m_Value(C), m_Value(D))) && (CondVal.hasOneUse() || TrueVal.hasOneUse()) {
            let mut CondLogicOr: bool = isa(CondVal);
            let mut TrueLogicOr: bool = isa(TrueVal);
            let mut OrFactorization: Closure_18 = Closure_18 { cap_0: self, Zero: &mut Zero, TrueLogicOr: &mut TrueLogicOr, CondLogicOr: &mut CondLogicOr, A: &mut A, One: &mut One };
            if A == C {
                return OrFactorization.call(A, B, D, false);
            }
            if A == D {
                return OrFactorization.call(A, B, C, false);
            }
            if B == C {
                return OrFactorization.call(B, A, D, false);
            }
            if B == D {
                return OrFactorization.call(B, A, C, CondLogicOr && TrueLogicOr);
            }
        }
    }
    if match(TrueVal, m_Specific(Zero)) {
        let mut NotCond: *mut Value = self.Builder.CreateNot(CondVal, "not." + CondVal.getName());
        let mut NewSI: *mut SelectInst = Create(NotCond, FalseVal, Zero, "", null, &mut SI);
        NewSI.swapProfMetadata();
        return NewSI;
    }
    if match(FalseVal, m_Specific(One)) {
        let mut NotCond: *mut Value = self.Builder.CreateNot(CondVal, "not." + CondVal.getName());
        let mut NewSI: *mut SelectInst = Create(NotCond, One, TrueVal, "", null, &mut SI);
        NewSI.swapProfMetadata();
        return NewSI;
    }
    if match(&mut SI, m_LogicalAnd(m_Not(m_Value(A)), m_Not(m_Value(B)))) && (CondVal.hasOneUse() || TrueVal.hasOneUse()) && !match(A, m_ConstantExpr()) && !match(B, m_ConstantExpr()) {
        let mut NewSI: *mut SelectInst = cast(self.Builder.CreateSelect(A, One, B, "", &mut SI));
        NewSI.swapProfMetadata();
        return CreateNot(NewSI, "", null);
    }
    if match(&mut SI, m_LogicalOr(m_Not(m_Value(A)), m_Not(m_Value(B)))) && (CondVal.hasOneUse() || FalseVal.hasOneUse()) && !match(A, m_ConstantExpr()) && !match(B, m_ConstantExpr()) {
        let mut NewSI: *mut SelectInst = cast(self.Builder.CreateSelect(A, B, Zero, "", &mut SI));
        NewSI.swapProfMetadata();
        return CreateNot(NewSI, "", null);
    }
    if match(CondVal, m_Select(m_Value(A), m_One(), m_Value(B))) && match(TrueVal, m_One()) && match(FalseVal, m_Specific(B)) {
        return self.replaceOperand(SI, 0, A);
    }
    if match(CondVal, m_Select(m_Value(A), m_Value(B), m_Zero())) && match(TrueVal, m_Specific(B)) && match(FalseVal, m_Zero()) {
        return self.replaceOperand(SI, 0, A);
    }
    if match(&mut SI, m_c_LogicalAnd(m_Not(m_LogicalAnd(m_Value(A), m_Value(B))), m_c_LogicalOr(m_Deferred(A), m_Deferred(B)))) {
        return CreateXor(A, B, "");
    }
    if match(CondVal, m_OneUse(m_c_Or(m_Not(m_Specific(TrueVal)), m_Value(C)))) {
        let mut OrV: *mut Value = self.Builder.CreateSelectWithUnknownProfile(C, One, FalseVal, "instcombine", "");
        return self.createSelectInstWithUnknownProfile(TrueVal, OrV, Zero, "", null);
    }
    if match(CondVal, m_OneUse(m_c_And(m_Value(C), m_Specific(FalseVal)))) {
        if self.getFreelyInverted(C, C.hasOneUse(), &mut self.Builder) {
            NotC;
        } else {
            let mut OrV: *mut Value = self.Builder.CreateSelectWithUnknownProfile(NotC, One, TrueVal, "instcombine", "");
            return self.createSelectInstWithUnknownProfile(FalseVal, OrV, Zero, "", null);
        }
    }
    if match(CondVal, m_OneUse(m_c_Or(m_Specific(TrueVal), m_Value(C)))) {
        if self.getFreelyInverted(C, C.hasOneUse(), &mut self.Builder) {
            NotC;
        } else {
            let mut AndV: *mut Value = self.Builder.CreateSelectWithUnknownProfile(NotC, FalseVal, Zero, "instcombine", "");
            return self.createSelectInstWithUnknownProfile(TrueVal, One, AndV, "", null);
        }
    }
    if match(CondVal, m_OneUse(m_c_And(m_Value(C), m_Not(m_Specific(FalseVal))))) {
        let mut AndV: *mut Value = self.Builder.CreateSelectWithUnknownProfile(C, TrueVal, Zero, "instcombine", "");
        return self.createSelectInstWithUnknownProfile(FalseVal, One, AndV, "", null);
    }
    if match(FalseVal, m_Zero()) || match(TrueVal, m_One()) {
        let mut Y: *mut Use = null;
        let mut IsAnd: bool = if match(FalseVal, m_Zero()) { true } else { false };
        let mut Op1: *mut Value = if IsAnd { TrueVal } else { FalseVal };
        if isCheckForZeroAndMulWithOverflow(CondVal, Op1, IsAnd, Y) {
            let mut FI: *mut FreezeInst = FreezeInst { *Y.operator llvm::Value *(), operator((*Y)).getName() + ".fr", null };
            self.InsertNewInstBefore(FI, cast(Y.getUser()).getIterator());
            self.replaceUse(*Y, FI);
            return self.replaceInstUsesWith(SI, Op1);
        }
        if self.foldBooleanAndOr(CondVal, Op1, SI, IsAnd, true) {
            V;
        } else {
            return self.replaceInstUsesWith(SI, V);
        }
    }
    if match(CondVal, m_LogicalOr(m_Value(A), m_Value(B))) && match(FalseVal, m_Zero()) {
        let mut Res: optional<bool> = isImpliedCondition(TrueVal, B, self.DL, true, 0);
        if Res && operator(Res) == false {
            return self.replaceOperand(SI, 0, A);
        }
    }
    if match(TrueVal, m_LogicalOr(m_Value(A), m_Value(B))) && match(FalseVal, m_Zero()) {
        let mut Res: optional<bool> = isImpliedCondition(CondVal, B, self.DL, true, 0);
        if Res && operator(Res) == false {
            return self.replaceOperand(SI, 1, A);
        }
    }
    if match(TrueVal, m_One()) && match(FalseVal, m_LogicalAnd(m_Value(A), m_Value(B))) {
        let mut Res: optional<bool> = isImpliedCondition(CondVal, B, self.DL, false, 0);
        if Res && operator(Res) == true {
            return self.replaceOperand(SI, 2, A);
        }
    }
    if match(CondVal, m_LogicalAnd(m_Value(A), m_Value(B))) && match(TrueVal, m_One()) {
        let mut Res: optional<bool> = isImpliedCondition(FalseVal, B, self.DL, false, 0);
        if Res && operator(Res) == true {
            return self.replaceOperand(SI, 0, A);
        }
    }
    if match(TrueVal, m_One()) {
        if self.FoldOrOfLogicalAnds(CondVal, FalseVal) {
            V;
        } else {
            return V;
        }
    }
    return null;
}

fn isSafeToRemoveBitCeilSelect(Pred: Predicate, Cond0: *mut Value, Cond1: *APInt, CtlzOp: *mut Value, BitWidth: u32, ShouldDropNoWrap: *mut bool) -> bool {
    let mut CR: ConstantRange = makeExactICmpRegion(getInversePredicate(Pred), *Cond1);
    ShouldDropNoWrap = false;
    let mut MatchForward: Closure_19 = Closure_19 { CtlzOp: &mut CtlzOp, ShouldDropNoWrap: &mut ShouldDropNoWrap, CR: &mut CR };
    let mut C: *APInt = null;
    let mut CommonAncestor: *mut Value = null;
    if MatchForward.call(Cond0) {} else if match(Cond0, m_Add(m_Value(CommonAncestor), m_APInt(C))) {
        CR = CR.sub(*C);
        if !MatchForward.call(CommonAncestor) {
            return false;
        }
    } else {
        return false;
    }
    let mut IntMax: APInt = getSignMask(BitWidth) - 1;
    CR = CR.sub(APInt { BitWidth, 1, false, false });
    return CR.icmp(ICMP_UGE, IntMax);
}

fn foldBitCeil(SI: *mut SelectInst, Builder: *mut IRBuilderBase, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut SelType: *mut Type = SI.getType();
    let mut BitWidth: u32 = SelType.getScalarSizeInBits();
    if !isPowerOf2_32(BitWidth) {
        return null;
    }
    let mut FalseVal: *mut Value = SI.getFalseValue();
    let mut TrueVal: *mut Value = SI.getTrueValue();
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut Cond1: *APInt = null;
    let mut Cond0: *mut Value = null;
    let mut Ctlz: *mut Value = null;
    let mut CtlzOp: *mut Value = null;
    if !match(SI.getCondition(), m_ICmp(Pred, m_Value(Cond0), m_APInt(Cond1))) {
        return null;
    }
    if match(TrueVal, m_One()) {
        swap(FalseVal, TrueVal);
        Pred = CmpPredicate { Pred: getInversePredicate(Pred.operator llvm::CmpInst::Predicate()), HasSameSign: false };
    }
    let mut ShouldDropNoWrap: bool = false;
    if !match(FalseVal, m_One()) || !match(TrueVal, m_OneUse(m_Shl(m_One(), m_OneUse(m_Sub(m_SpecificInt(BitWidth), m_Value(Ctlz)))))) || !match(Ctlz, m_Ctlz(m_Value(CtlzOp), m_Value())) || !isSafeToRemoveBitCeilSelect(Pred.operator llvm::CmpInst::Predicate(), Cond0, Cond1, CtlzOp, BitWidth, ShouldDropNoWrap) {
        return null;
    }
    if ShouldDropNoWrap {
        cast(CtlzOp).setHasNoUnsignedWrap(false);
        cast(CtlzOp).setHasNoSignedWrap(false);
    }
    cast(Ctlz).dropPoisonGeneratingAnnotations();
    IC.addToWorklist(cast(Ctlz));
    let mut Neg: *mut Value = Builder.CreateNeg(Ctlz, "", false);
    let mut Masked: *mut Value = Builder.CreateAnd(Neg, get(SelType, BitWidth - 1, false, false), "");
    return Create(Shl, get(SelType, 1, false, false), Masked, "", null);
}

fn InstCombinerImpl::foldSelectToCmp(self, SI: *mut SelectInst) -> *mut Instruction {
    let mut TV: *mut Value = SI.getTrueValue();
    let mut FV: *mut Value = SI.getFalseValue();
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut LHS: *mut Value = null;
    let mut RHS: *mut Value = null;
    if !match(SI.getCondition(), m_ICmp(Pred, m_Value(LHS), m_Value(RHS))) {
        return null;
    }
    if !LHS.getType().isIntOrIntVectorTy() {
        return null;
    }
    if !isa(TV) {
        if !isa(FV) {
            return null;
        }
        Pred = getInverseCmpPredicate(Pred);
        swap(TV, FV);
    }
    if isNonStrictPredicate(Pred.operator llvm::CmpInst::Predicate()) {
        if dyn_cast(RHS) {
            C;
        } else {
            let mut FlippedPredAndConst: pair<CmpPredicate, Constant *>> = getFlippedStrictnessPredicateAndConstant(Pred, C);
            if !FlippedPredAndConst {
                return null;
            }
            Pred = operator(FlippedPredAndConst).first;
            RHS = operator(FlippedPredAndConst).second;
        }
    }
    if (isGT(Pred.operator llvm::CmpInst::Predicate()) && match(TV, m_AllOnes())) || (isLT(Pred.operator llvm::CmpInst::Predicate()) && match(TV, m_One())) {
        Pred = CmpPredicate { Pred: getSwappedPredicate(Pred.operator llvm::CmpInst::Predicate()), HasSameSign: false };
        swap(LHS, RHS);
    }
    let mut IsSigned: bool = isSigned(Pred.operator llvm::CmpInst::Predicate());
    let mut Replace: bool = false;
    let mut ExtendedCmpPredicate: CmpPredicate = CmpPredicate {};
    if isLT(Pred.operator llvm::CmpInst::Predicate()) && match(TV, m_AllOnes()) && match(FV, m_ZExt(m_c_ICmp(ExtendedCmpPredicate, m_Specific(LHS), m_Specific(RHS)))) && (ExtendedCmpPredicate == ICMP_NE || getSwappedPredicate(ExtendedCmpPredicate.operator llvm::CmpInst::Predicate()) == Pred.operator llvm::CmpInst::Predicate()) {
        Replace = true;
    }
    if isGT(Pred.operator llvm::CmpInst::Predicate()) && match(TV, m_One()) && match(FV, m_SExt(m_c_ICmp(ExtendedCmpPredicate, m_Specific(LHS), m_Specific(RHS)))) && (ExtendedCmpPredicate == ICMP_NE || getSwappedPredicate(ExtendedCmpPredicate.operator llvm::CmpInst::Predicate()) == Pred.operator llvm::CmpInst::Predicate()) {
        Replace = true;
    }
    let mut FalseBranchSelectPredicate: CmpPredicate = CmpPredicate {};
    let mut InnerTV: *APInt = null;
    let mut InnerFV: *APInt = null;
    if Pred == ICMP_EQ && match(TV, m_Zero()) && match(FV, m_Select(m_c_ICmp(FalseBranchSelectPredicate, m_Specific(LHS), m_Specific(RHS)), m_APInt(InnerTV), m_APInt(InnerFV))) {
        if !isGT(FalseBranchSelectPredicate.operator llvm::CmpInst::Predicate()) {
            FalseBranchSelectPredicate = CmpPredicate { Pred: getSwappedPredicate(FalseBranchSelectPredicate.operator llvm::CmpInst::Predicate()), HasSameSign: false };
            swap(LHS, RHS);
        }
        if !InnerTV.isOne() {
            swap(InnerTV, InnerFV);
            swap(LHS, RHS);
        }
        if isGT(FalseBranchSelectPredicate.operator llvm::CmpInst::Predicate()) && InnerTV.isOne() && InnerFV.isAllOnes() {
            IsSigned = isSigned(FalseBranchSelectPredicate.operator llvm::CmpInst::Predicate());
            Replace = true;
        }
    }
    if Pred == ICMP_EQ && match(TV, m_Zero()) {
        let mut C: *APInt = null;
        if match(RHS, m_APInt(C)) {
            let mut InnerPred: CmpPredicate = CmpPredicate {};
            let mut InnerRHS: *mut Value = null;
            let mut InnerTV: *APInt = null;
            let mut InnerFV: *APInt = null;
            if match(FV, m_Select(m_ICmp(InnerPred, m_Specific(LHS), m_Value(InnerRHS)), m_APInt(InnerTV), m_APInt(InnerFV))) {
                if isGT(InnerPred.operator llvm::CmpInst::Predicate()) && InnerTV.isOne() && InnerFV.isAllOnes() {
                    IsSigned = isSigned(InnerPred.operator llvm::CmpInst::Predicate());
                    let mut CanSubOne: bool = if IsSigned { !C.isMinSignedValue() } else { !C.isMinValue() };
                    if CanSubOne {
                        let mut Cminus1: APInt = *C - 1;
                        if match(InnerRHS, m_SpecificInt(Cminus1)) {
                            Replace = true;
                        }
                    }
                }
                if isLT(InnerPred.operator llvm::CmpInst::Predicate()) && InnerTV.isAllOnes() && InnerFV.isOne() {
                    IsSigned = isSigned(InnerPred.operator llvm::CmpInst::Predicate());
                    let mut CanAddOne: bool = if IsSigned { !C.isMaxSignedValue() } else { !C.isMaxValue() };
                    if CanAddOne {
                        let mut Cplus1: APInt = *C + 1;
                        if match(InnerRHS, m_SpecificInt(Cplus1)) {
                            Replace = true;
                        }
                    }
                }
            }
        }
    }
    let mut IID: ID = if IsSigned { scmp } else { ucmp };
    if Replace {
        return self.replaceInstUsesWith(SI, self.Builder.CreateIntrinsic(SI.getType(), IID, [LHS, RHS], FMFSource {}, "", function_ref<void (CallInst *)> { Closure_20 {}, null, null }));
    }
    return null;
}

fn InstCombinerImpl::fmulByZeroIsZero(self: *InstCombinerImpl, MulVal: *mut Value, FMF: FastMathFlags, CtxI: *Instruction) -> bool {
    let mut Known: KnownFPClass = computeKnownFPClass(MulVal, FMF, fcNegative, self.SQ.getWithInstruction(CtxI), 0);
    return Known.isKnownNeverNaN() && Known.isKnownNeverInfinity() && (FMF.noSignedZeros() || Known.signBitIsZeroOrNaN());
}

fn matchFMulByZeroIfResultEqZero(IC: *mut InstCombinerImpl, Cmp0: *mut Value, Cmp1: *mut Value, TrueVal: *mut Value, FalseVal: *mut Value, CtxI: *mut Instruction, SelectIsNSZ: bool) -> bool {
    let mut MulRHS: *mut Value = null;
    if match(Cmp1, m_PosZeroFP()) && match(TrueVal, m_c_FMul(m_Specific(Cmp0), m_Value(MulRHS))) {
        let mut FMF: FastMathFlags = cast(TrueVal).getFastMathFlags();
        FMF.setNoSignedZeros(SelectIsNSZ);
        return IC.fmulByZeroIsZero(MulRHS, FMF, &mut CtxI);
    }
    return false;
}

fn hasAffectedValue(V: *mut Value, Affected: *mut SmallPtrSetImpl<Value *>, Depth: u32) -> bool {
    if Depth == MaxAnalysisRecursionDepth {
        return false;
    }
    if Depth != 0 && Affected.contains(V) {
        return true;
    }
    if dyn_cast(V) {
        I;
    } else {
        if isa(I) {
            if Depth == MaxAnalysisRecursionDepth - 1 {
                return false;
            }
            Depth = MaxAnalysisRecursionDepth - 2;
        }
        return any_of(I.operands(), Closure_21 { Affected: &mut Affected, Depth: &mut Depth });
    }
    return false;
}

fn foldSelectIntoAddConstant(SI: *mut SelectInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut SIFOp: *mut FPMathOperator = dyn_cast(&mut SI);
    if !SIFOp || !SIFOp.hasNoSignedZeros() || !SIFOp.hasNoNaNs() {
        return null;
    }
    let mut TryFoldIntoAddConstant: Closure_22 = Closure_22 { Builder: &mut Builder, SI: &mut SI };
    let mut FAdd: *mut Instruction = null;
    let mut C: *mut Constant = null;
    let mut X: *mut Value = null;
    let mut Z: *mut Value = null;
    let mut Pred: CmpPredicate = CmpPredicate {};
    if match(&mut SI, m_Select(m_OneUse(m_FCmp(Pred, m_Value(X), m_Value(Z))), m_OneUse(m_Instruction(FAdd)), m_Constant(C))) {
        return TryFoldIntoAddConstant.call(Pred.operator llvm::CmpInst::Predicate(), X, Z, FAdd, C, false);
    }
    if match(&mut SI, m_Select(m_OneUse(m_FCmp(Pred, m_Value(X), m_Value(Z))), m_Constant(C), m_OneUse(m_Instruction(FAdd)))) {
        return TryFoldIntoAddConstant.call(Pred.operator llvm::CmpInst::Predicate(), X, Z, FAdd, C, true);
    }
    return null;
}

fn foldSelectBitTest(Sel: *mut SelectInst, CondVal: *mut Value, TrueVal: *mut Value, FalseVal: *mut Value, Builder: *mut BuilderTy, SQ: *SimplifyQuery) -> *mut Value {
    let mut SelType: *mut Type = Sel.getType();
    if SelType.isVectorTy() != CondVal.getType().isVectorTy() {
        return null;
    }
    let mut V: *mut Value = null;
    let mut AndMask: APInt = APInt {};
    let mut CreateAnd: bool = false;
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut CmpLHS: *mut Value = null;
    let mut CmpRHS: *mut Value = null;
    if match(CondVal, m_ICmp(Pred, m_Value(CmpLHS), m_Value(CmpRHS))) {
        if isEquality(Pred.operator llvm::CmpInst::Predicate()) {
            if !match(CmpRHS, m_Zero()) {
                return null;
            }
            V = CmpLHS;
            let mut AndRHS: *APInt = null;
            if !match(CmpLHS, m_And(m_Value(), m_Power2(AndRHS))) {
                return null;
            }
            AndMask = *AndRHS;
        } else if decomposeBitTestICmp(CmpLHS, CmpRHS, Pred.operator llvm::CmpInst::Predicate(), true, false, false) {
            Res;
        } else {
            assert!(isEquality(operator(Res).Pred), "Not equality test?");
            AndMask = operator(Res).Mask;
            V = operator(Res).X;
            let mut Known: KnownBits = computeKnownBits(V, SQ.getWithInstruction(&mut Sel), 0);
            operator(AndMask, Known.getMaxValue());
            if !AndMask.isPowerOf2() {
                return null;
            }
            Pred = CmpPredicate { Pred: operator(Res).Pred, HasSameSign: false };
            CreateAnd = true;
        }
    } else if dyn_cast(CondVal) {
        Trunc;
    } else {
        V = Trunc.getOperand(0);
        AndMask = APInt { V.getType().getScalarSizeInBits(), 1, false, false };
        Pred = CmpPredicate { Pred: ICMP_NE, HasSameSign: false };
        CreateAnd = !Trunc.hasNoUnsignedWrap();
    }
    if Pred == ICMP_NE {
        swap(TrueVal, FalseVal);
    }
    if foldSelectICmpAnd(Sel, CondVal, TrueVal, FalseVal, V, AndMask, CreateAnd, Builder) {
        X;
    } else {
        return X;
    }
    if foldSelectICmpAndBinOp(CondVal, TrueVal, FalseVal, V, AndMask, CreateAnd, Builder) {
        X;
    } else {
        return X;
    }
    return null;
}

fn foldSelectNegNot(SI: *mut SelectInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut CondVal: *mut Value = SI.getCondition();
    let mut TrueVal: *mut Value = SI.getTrueValue();
    let mut FalseVal: *mut Value = SI.getFalseValue();
    let mut SelTy: *mut Type = SI.getType();
    if !SelTy.isIntOrIntVectorTy() || SelTy.isIntOrIntVectorTy(1) {
        return null;
    }
    if CondVal.getType().isVectorTy() != SelTy.isVectorTy() {
        return null;
    }
    let mut matchNegNot: Closure_23 = Closure_23 {};
    let mut X: *mut Value = null;
    let mut Mask: *mut Value = null;
    if matchNegNot.call(TrueVal, FalseVal, X) {
        let mut NotCond: *mut Value = Builder.CreateNot(CondVal, "not." + CondVal.getName());
        Mask = Builder.CreateSExt(NotCond, SelTy, "");
        return CreateSub(Mask, X, "");
    }
    if matchNegNot.call(FalseVal, TrueVal, X) {
        Mask = Builder.CreateSExt(CondVal, SelTy, "");
        return CreateSub(Mask, X, "");
    }
    return null;
}

fn foldSelectAndOrPowerOfTwo(SI: *mut SelectInst, Builder: *mut BuilderTy, SQ: *SimplifyQuery) -> *mut Instruction {
    let mut Cond: *mut Value = SI.getCondition();
    if !Cond.hasOneUse() {
        return null;
    }
    let mut TrueVal: *mut Value = SI.getTrueValue();
    let mut FalseVal: *mut Value = SI.getFalseValue();
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut Shift: *mut Value = null;
    let mut Case1: bool = match(TrueVal, m_Zero()) && match(FalseVal, m_Value(Shift)) && match(Cond, m_Or(m_SpecificICmp(CmpPredicate { Pred: ICMP_EQ, HasSameSign: false }, m_c_And(m_Specific(Shift), m_Value(A)), m_Zero()), m_SpecificICmp(CmpPredicate { Pred: ICMP_EQ, HasSameSign: false }, m_c_And(m_Specific(Shift), m_Value(B)), m_Zero())));
    let mut Case2: bool = match(FalseVal, m_Zero()) && match(TrueVal, m_Value(Shift)) && match(Cond, m_And(m_SpecificICmp(CmpPredicate { Pred: ICMP_NE, HasSameSign: false }, m_c_And(m_Specific(Shift), m_Value(A)), m_Zero()), m_SpecificICmp(CmpPredicate { Pred: ICMP_NE, HasSameSign: false }, m_c_And(m_Specific(Shift), m_Value(B)), m_Zero())));
    if (Case1 || Case2) && isKnownToBeAPowerOfTwo(Shift, true, SQ.getWithInstruction(&mut SI), 0) {
        let mut And1: *mut Value = Builder.CreateAnd(Shift, A, "");
        return CreateAnd(And1, B, "");
    }
    return null;
}

fn isSelectZeroSignInsignificant(SI: *mut SelectInst) -> bool {
    let mut MaxUsesToLookThrough: u32 = 16;
    let mut NumUses: u32 = 0;
    let mut Visited: SmallPtrSet<Instruction *, 4> = SmallPtrSet<Instruction *, 4> {};
    let mut Worklist: SmallVector<Instruction *> = SmallVector<Instruction *> { 1, &mut SI };
    while !Worklist.is_empty() {
        for U in Worklist.pop_back_val().uses() {
            if NumUses += 1 > MaxUsesToLookThrough {
                return false;
            }
            let mut User: *mut Instruction = cast(U.getUser());
            if User == &mut SI {
                continue;
            }
            if canIgnoreSignBitOfZero(U) {
                continue;
            }
            if isa(User) {
                if Visited.insert(User).second {
                    Worklist.push(User);
                }
                continue;
            }
            return false;
        }
    }
    return true;
}

fn InstCombinerImpl::visitSelectInst(self, SI: *mut SelectInst) -> *mut Instruction {
    let mut CondVal: *mut Value = SI.getCondition();
    let mut TrueVal: *mut Value = SI.getTrueValue();
    let mut FalseVal: *mut Value = SI.getFalseValue();
    let mut SelType: *mut Type = SI.getType();
    let mut FMF: FastMathFlags = FastMathFlags {};
    if dyn_cast_if_present(&mut SI) {
        FPMO;
    } else {
        FMF = FPMO.getFastMathFlags();
    }
    if simplifySelectInst(CondVal, TrueVal, FalseVal, FMF, self.SQ.getWithInstruction(&mut SI)) {
        V;
    } else {
        return self.replaceInstUsesWith(SI, V);
    }
    if canonicalizeSelectToShuffle(SI) {
        I;
    } else {
        return I;
    }
    if canonicalizeScalarSelectOfVecs(SI, *self) {
        I;
    } else {
        return I;
    }
    if match(FalseVal, m_Ctpop(m_Specific(TrueVal))) && match(CondVal, m_SpecificICmp(CmpPredicate { Pred: ICMP_ULT, HasSameSign: false }, m_Specific(TrueVal), m_SpecificInt(2))) {
        cast(FalseVal).dropPoisonGeneratingAnnotations();
        self.addToWorklist(cast(FalseVal));
        return self.replaceInstUsesWith(SI, FalseVal);
    }
    let mut CondType: *mut Type = CondVal.getType();
    if !isa(CondVal) && SelType.isIntOrIntVectorTy() && CondType.isVectorTy() == SelType.isVectorTy() {
        if simplifyWithOpReplaced(TrueVal, CondVal, getTrue(CondType), self.SQ, true, null) {
            S;
        } else {
            return self.replaceOperand(SI, 1, S);
        }
        if simplifyWithOpReplaced(FalseVal, CondVal, getFalse(CondType), self.SQ, true, null) {
            S;
        } else {
            return self.replaceOperand(SI, 2, S);
        }
        if self.replaceInInstruction(TrueVal, CondVal, getTrue(CondType), 0) || self.replaceInInstruction(FalseVal, CondVal, getFalse(CondType), 0) {
            return &mut SI;
        }
    }
    if self.foldSelectOfBools(SI) {
        R;
    } else {
        return R;
    }
    if SelType.isIntOrIntVectorTy() && !SelType.isIntOrIntVectorTy(1) && CondVal.getType().isVectorTy() == SelType.isVectorTy() {
        if match(TrueVal, m_One()) && match(FalseVal, m_Zero()) {
            return ZExtInst { CondVal, SelType, "", null };
        }
        if match(TrueVal, m_AllOnes()) && match(FalseVal, m_Zero()) {
            return SExtInst { CondVal, SelType, "", null };
        }
        if match(TrueVal, m_Zero()) && match(FalseVal, m_One()) {
            let mut NotCond: *mut Value = self.Builder.CreateNot(CondVal, "not." + CondVal.getName());
            return ZExtInst { NotCond, SelType, "", null };
        }
        if match(TrueVal, m_Zero()) && match(FalseVal, m_AllOnes()) {
            let mut NotCond: *mut Value = self.Builder.CreateNot(CondVal, "not." + CondVal.getName());
            return SExtInst { NotCond, SelType, "", null };
        }
    }
    if foldSelectNegNot(SI, self.Builder) {
        I;
    } else {
        return I;
    }
    if foldSelectAndOrPowerOfTwo(SI, self.Builder, self.SQ) {
        I;
    } else {
        return I;
    }
    let mut SIFPOp: *mut FPMathOperator = dyn_cast(&mut SI);
    if dyn_cast(CondVal) {
        FCmp;
    } else {
        let mut Pred: Predicate = FCmp.getPredicate();
        let mut Cmp0: *mut Value = FCmp.getOperand(0);
        let mut Cmp1: *mut Value = FCmp.getOperand(1);
        if (Cmp0 == TrueVal && Cmp1 == FalseVal) || (Cmp0 == FalseVal && Cmp1 == TrueVal) {
            if FCmp.hasOneUse() && isUnordered(Pred) {
                let mut InvPred: Predicate = FCmp.getInversePredicate();
                let mut NewCond: *mut Value = self.Builder.CreateFCmpFMF(InvPred, Cmp0, Cmp1, FCmp, FCmp.getName() + ".inv", null);
                let mut FMF: FastMathFlags = SI.getFastMathFlags();
                if FCmp.hasNoNaNs() {
                    FMF.setNoNaNs(true);
                }
                if FCmp.hasNoInfs() {
                    FMF.setNoInfs(true);
                }
                let mut NewSel: *mut Value = self.Builder.CreateSelectFMF(NewCond, FalseVal, TrueVal, FMF, "", if ProfcheckDisableMetadataFixes { null } else { &mut SI });
                if dyn_cast(NewSel) {
                    NewSI;
                } else {
                    NewSI.swapProfMetadata();
                }
                return self.replaceInstUsesWith(SI, NewSel);
            }
        }
        if SIFPOp {
            let mut MatchCmp0: *mut Value = null;
            let mut MatchCmp1: *mut Value = null;
            if Pred == FCMP_OEQ || Pred == FCMP_UEQ {
                MatchCmp0 = FalseVal;
                MatchCmp1 = TrueVal;
            } else if Pred == FCMP_ONE || Pred == FCMP_UNE {
                MatchCmp0 = TrueVal;
                MatchCmp1 = FalseVal;
            }
            if Cmp0 == MatchCmp0 && matchFMulByZeroIfResultEqZero(*self, Cmp0, Cmp1, MatchCmp1, MatchCmp0, SI, SIFPOp.hasNoSignedZeros()) {
                return self.replaceInstUsesWith(SI, Cmp0);
            }
            let mut EltTy: *mut Type = SelType.getScalarType();
            if (Pred == FCMP_ORD || Pred == FCMP_UNO) && match(Cmp1, m_PosZeroFP()) && EltTy.isIEEELikeFPTy() {
                if Pred == FCMP_ORD {
                    MatchCmp0 = TrueVal;
                    MatchCmp1 = FalseVal;
                } else {
                    MatchCmp0 = FalseVal;
                    MatchCmp1 = TrueVal;
                }
                let mut RcpIfNan: bool = match(MatchCmp1, m_FDiv(m_FPOne(), m_Specific(Cmp0)));
                let mut CanonicalizeIfNotNan: bool = match(MatchCmp0, m_FCanonicalize(m_Specific(Cmp0)));
                if RcpIfNan || CanonicalizeIfNotNan {
                    let mut FPSem: *fltSemantics = EltTy.getFltSemantics();
                    let mut Mode: DenormalMode = self.F.getDenormalMode(FPSem);
                    if RcpIfNan {
                        if Mode == getIEEE() {
                            if CanonicalizeIfNotNan {
                                return self.replaceInstUsesWith(SI, Cmp0);
                            }
                            if isGuaranteedNotToBeUndef(Cmp0, &mut self.AC, &mut SI, &mut self.DT, 0) {
                                self.replaceOperand(SI, if Pred == FCMP_ORD { 2 } else { 1 }, Cmp0);
                                return &mut SI;
                            }
                            let mut FrCmp0: *mut Instruction = self.InsertNewInstBefore(FreezeInst { Cmp0, Cmp0.getName() + ".fr", null }, FCmp.getIterator());
                            self.replaceOperand(*FCmp, 0, FrCmp0);
                            return self.replaceOperand(SI, if Pred == FCMP_ORD { 2 } else { 1 }, FrCmp0);
                        }
                    }
                    if CanonicalizeIfNotNan {
                        if Mode == getIEEE() {
                            self.replaceOperand(SI, if Pred == FCMP_ORD { 1 } else { 2 }, Cmp0);
                            return &mut SI;
                        }
                        if RcpIfNan && (Mode.inputsAreZero() || Mode.outputsAreZero()) {
                            return self.replaceInstUsesWith(SI, MatchCmp0);
                        }
                        assert!(RcpIfNan || Mode != getIEEE();
                    }
                }
            }
        }
    }
    if SIFPOp {
        let mut FCmp: *mut FCmpInst = dyn_cast(CondVal);
        if FCmp && FCmp.hasNoNaNs() && (SIFPOp.hasNoSignedZeros() || isSelectZeroSignInsignificant(SI)) {
            let mut X: *mut Value = null;
            let mut Y: *mut Value = null;
            if match(&mut SI, m_OrdOrUnordFMax(m_Value(X), m_Value(Y))) {
                let mut BinIntr: *mut Value = self.Builder.CreateBinaryIntrinsic(maxnum, X, Y, &mut SI, "");
                if dyn_cast(BinIntr) {
                    BinIntrInst;
                } else {
                    BinIntrInst.setHasNoInfs(FCmp.hasNoInfs());
                    BinIntrInst.setHasNoSignedZeros(true);
                    BinIntrInst.setHasNoNaNs(true);
                }
                return self.replaceInstUsesWith(SI, BinIntr);
            }
            if match(&mut SI, m_OrdOrUnordFMin(m_Value(X), m_Value(Y))) {
                let mut BinIntr: *mut Value = self.Builder.CreateBinaryIntrinsic(minnum, X, Y, &mut SI, "");
                if dyn_cast(BinIntr) {
                    BinIntrInst;
                } else {
                    BinIntrInst.setHasNoInfs(FCmp.hasNoInfs());
                    BinIntrInst.setHasNoSignedZeros(true);
                    BinIntrInst.setHasNoNaNs(true);
                }
                return self.replaceInstUsesWith(SI, BinIntr);
            }
        }
    }
    if foldSelectWithFCmpToFabs(SI, *self) {
        Fabs;
    } else {
        return Fabs;
    }
    if foldSelectOfOrderedFAbsCmpOfNaNScrubbedValue(SI, *self) {
        I;
    } else {
        return I;
    }
    if dyn_cast(CondVal) {
        CI;
    } else if self.foldSelectValueEquivalence(SI, *CI) {
        NewSel;
    } else {
        return NewSel;
    }
    if dyn_cast(CondVal) {
        ICI;
    } else if self.foldSelectInstWithICmp(SI, ICI) {
        Result;
    } else {
        return Result;
    }
    if foldSelectICmpAndAnd(SelType, CondVal, TrueVal, FalseVal, self.Builder) {
        V;
    } else {
        return V;
    }
    if foldSelectBitTest(SI, CondVal, TrueVal, FalseVal, self.Builder, self.SQ) {
        V;
    } else {
        return self.replaceInstUsesWith(SI, V);
    }
    if foldAddSubSelect(SI, self.Builder) {
        Add;
    } else {
        return Add;
    }
    if foldOverflowingAddSubSelect(SI, self.Builder) {
        Add;
    } else {
        return Add;
    }
    if foldSetClearBits(SI, self.Builder) {
        Or;
    } else {
        return Or;
    }
    if foldSelectZeroOrFixedOp(SI, *self) {
        Mul;
    } else {
        return Mul;
    }
    let mut TI: *mut Instruction = dyn_cast(TrueVal);
    let mut FI: *mut Instruction = dyn_cast(FalseVal);
    if TI && FI && TI.getOpcode() == FI.getOpcode() {
        if self.foldSelectOpOp(SI, TI, FI) {
            IV;
        } else {
            return IV;
        }
    }
    if self.foldSelectIntrinsic(SI) {
        I;
    } else {
        return I;
    }
    if self.foldSelectExtConst(SI) {
        I;
    } else {
        return I;
    }
    if foldSelectWithSRem(SI, *self, self.Builder) {
        I;
    } else {
        return I;
    }
    let mut SelectGepWithBase: Closure_24 = Closure_24 { CondVal: &mut CondVal, cap_1: self, SI: &mut SI };
    if dyn_cast(TrueVal) {
        TrueGep;
    } else if SelectGepWithBase.call(TrueGep, FalseVal, false) {
        NewGep;
    } else {
        return NewGep;
    }
    if dyn_cast(FalseVal) {
        FalseGep;
    } else if SelectGepWithBase.call(FalseGep, TrueVal, true) {
        NewGep;
    } else {
        return NewGep;
    }
    if SelType.isIntOrIntVectorTy() || SelType.isFPOrFPVectorTy() {
        if self.foldSelectIntoOp(SI, TrueVal, FalseVal) {
            FoldI;
        } else {
            return FoldI;
        }
        let mut LHS: *mut Value = null;
        let mut RHS: *mut Value = null;
        let mut CastOp: CastOps = zeroed();
        let mut SPR: SelectPatternResult = matchSelectPattern(&mut SI, LHS, RHS, &mut CastOp, 0);
        let mut SPF: SelectPatternFlavor = SPR.Flavor;
        if SPF {
            let mut LHS2: *mut Value = null;
            let mut RHS2: *mut Value = null;
            if matchSelectPattern(LHS, LHS2, RHS2, null, 0).Flavor {
                SPF2;
            } else if self.foldSPFofSPF(cast(LHS), SPF2, LHS2, RHS2, SI, SPF, RHS) {
                R;
            } else {
                return R;
            }
            if matchSelectPattern(RHS, LHS2, RHS2, null, 0).Flavor {
                SPF2;
            } else if self.foldSPFofSPF(cast(RHS), SPF2, LHS2, RHS2, SI, SPF, LHS) {
                R;
            } else {
                return R;
            }
        }
        if isMinOrMax(SPF) {
            let mut IsCastNeeded: bool = LHS.getType() != SelType;
            let mut CmpLHS: *mut Value = cast(CondVal).getOperand(0);
            let mut CmpRHS: *mut Value = cast(CondVal).getOperand(1);
