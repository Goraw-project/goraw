unsafe fn Closure_20::call(self: *mut Closure_20, Pred: Predicate, X: *mut Value, Z: *mut Value, FAdd: *mut Instruction, C: *mut Constant, Swapped: bool) -> auto {
        if !isRelational(Pred) || operator!(match(Z)) {
            return null;
        }
        if operator!(match(FAdd, m_FAdd(m_Specific(X), m_Specific(C)))) {
            return null;
        }
        let mut NewSelect: *mut Value = (*self.Builder)()((*self.SI).getCondition(), if Swapped { Z } else { X }, if Swapped { X } else { Z }, "", &mut (*self.SI));
        NewSelect.takeName;
        let mut NewFAdd: *mut Value = (*self.Builder)()(NewSelect, C);
        NewFAdd.takeName;
        let mut SelectFMF: FastMathFlags = (*self.SI).getFastMathFlags;
        let mut FAddFMF: FastMathFlags = FAdd.getFastMathFlags();
        let mut NewFMF: FastMathFlags = intersectRewrite(SelectFMF, FAddFMF) | unionValue(SelectFMF, FAddFMF);
        cast(NewFAdd)(NewFMF);
        cast(NewSelect)(NewFMF);
        return NewFAdd;
    }

struct Closure_21 {}

fn Closure_21::call(self: *mut Closure_21, Neg: *mut Value, Not: *mut Value, X: *mut *mut Value) -> auto {
        return match(Neg, m_OneUse(m_Neg(m_Value(X)))) && match(Not, m_OneUse(m_Not(m_Specific(X))));
    }

struct Closure_22 {
    CondVal: *mut *mut Value,
    cap_1: *mut InstCombinerImpl,
    SI: *mut SelectInst,
}

unsafe fn Closure_22::call(self: *mut Closure_22, Gep: *mut GetElementPtrInst, Base: *mut Value, Swap: bool) -> auto {
        let mut Ptr: *mut Value = Gep.getPointerOperand();
        if Gep.getNumOperands() != 2 || Gep.getPointerOperand() != Base || operator!(Gep.hasOneUse) {
            return null;
        }
        let mut Idx: *mut Value = Gep.getOperand(1);
        if isa((*self.CondVal).getType()) && !isa(Idx.getType()) {
            return null;
        }
        let mut ElementType: *mut Type = Gep.getSourceElementType();
        let mut NewT: *mut Value = Idx;
        let mut NewF: *mut Value = getNullValue(Idx.getType());
        if Swap {
            swap(NewT, NewF);
        }
        let mut NewSI: *mut Value = null;
        return Create(ElementType, Ptr, NewSI, Gep.getNoWrapFlags());
    }

struct Closure_23 {
    TrueVal: *mut *mut Value,
    FalseVal: *mut *mut Value,
    FMF: *mut FastMathFlags,
    cap_3: *mut InstCombinerImpl,
    SI: *mut SelectInst,
    CondVal: *mut *mut Value,
    SelType: *mut *mut Type,
}

unsafe fn Closure_23::call(self: *mut Closure_23, IsAnd: bool, A: *mut Value, B: *mut Value) -> auto {
        if simplifySelectInst(B, (*self.TrueVal), (*self.FalseVal), (*self.FMF)) {
            V;
        } else {
            let mut NewTrueVal: *mut Value = if IsAnd { V } else { (*self.TrueVal) };
            let mut NewFalseVal: *mut Value = if IsAnd { (*self.FalseVal) } else { V };
            let mut MDFrom: *mut Instruction = null;
            if NewTrueVal == (*self.TrueVal) && NewFalseVal == (*self.FalseVal) {
                MDFrom(&mut (*self.SI));
            }
        }
        if (*self.CondVal).hasOneUse() && (*self.SelType).isIntOrIntVectorTy() {
            if dyn_cast(B) {
                Cmp;
            } else if canonicalizeSPF(*Cmp, (*self.TrueVal), (*self.FalseVal), *self) {
                V;
            } else {
                return Create(A, if IsAnd { V } else { (*self.TrueVal) }, if IsAnd { (*self.FalseVal) } else { V }, "", null, if  { null } else { &mut (*self.SI) });
            }
        }
        return null;
    }

struct Closure_24 {
    CC: *mut CondContext,
}

unsafe fn Closure_24::call(self: *mut Closure_24, V: *mut Value) {
            (*self.CC)()(V);
        }
