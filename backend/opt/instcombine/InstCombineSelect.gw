    }
    let mut OtherOpT: *mut Value = null;
    let mut OtherOpF: *mut Value = null;
    let mut MatchIsOpZero: bool = false;
    let mut getCommonOp: Closure_1 = Closure_1 { OtherOpT: &mut OtherOpT, OtherOpF: &mut OtherOpF, MatchIsOpZero: &mut MatchIsOpZero };
    if TI.hasOneUse || FI.hasOneUse {
        let mut X: *mut Value = null;
        let mut Y: *mut Value = null;
        if match(TI, m_FNeg(m_Value(X))) && match(FI, m_FNeg(m_Value(Y))) {
            let mut FMF: FastMathFlags = TI.getFastMathFlags();
            operator(FMF, FI.getFastMathFlags());
            operator|=(FMF, SI.getFastMathFlags);
            let mut NewSel: *mut Value = null;
            if  {
                NewSelI()(FMF);
            }
            let mut NewFNeg: *mut Instruction = CreateFNeg(NewSel, "");
            NewFNeg.setFastMathFlags(FMF);
            return NewFNeg;
        }
        let mut TII: *mut auto = dyn_cast(TI);
        let mut FII: *mut auto = dyn_cast(FI);
        if TII() &&  && () == () {
            if match(m_MaxOrMin(m_Value(), m_Value())) {
                if getCommonOp.call(TI, FI, true, false) {
                    MatchOp;
                } else {
                    let mut NewSel: *mut Value = null;
                    return Create(void { NewSel, MatchOp });
                }
            }
            if TII()() == ldexp {
                let mut LdexpVal0: *mut Value = (0);
                let mut LdexpExp0: *mut Value = (1);
                let mut LdexpVal1: *mut Value = (0);
                let mut LdexpExp1: *mut Value = (1);
                if LdexpExp0.getType() == LdexpExp1.getType() {
                    let mut SelectFPOp: *mut FPMathOperator = cast(&mut SI);
                    let mut FMF: FastMathFlags = cast()();
                    operator&=(FMF, cast()());
                    operator(FMF, SelectFPOp.getFastMathFlags());
                    let mut SelectVal: *mut Value = null;
                    let mut SelectExp: *mut Value = null;
                    let mut NewLdexp: *mut Value = null;
                    return self.replaceInstUsesWith;
                }
            }
        }
        let mut CreateCmpSel: Closure_2 = Closure_2 { getCommonOp: &mut getCommonOp, TI: &mut TI, FI: &mut FI, cap_3: self, Cond: &mut Cond, OtherOpT: &mut OtherOpT, OtherOpF: &mut OtherOpF, SI: &mut SI, MatchIsOpZero: &mut MatchIsOpZero };
        let mut TPred: CmpPredicate = CmpPredicate {};
        let mut FPred: CmpPredicate = CmpPredicate {};
        if match(TI, m_ICmp(TPred, m_Value(), m_Value())) && match(FI, m_ICmp(FPred, m_Value(), m_Value())) {
            if  {
                return ;
            }
            if  {
                return ;
            }
        }
    }
    if TI.getNumOperands != 2 || FI.getNumOperands != 2 || !TI.isSameOperationAs(FI, 0) || (!isa(TI) && !isa(TI)) || operator!(TI.hasOneUse) || operator!(FI.hasOneUse) {
        return null;
    }
    let mut MatchOp: *mut Value = getCommonOp.call(TI, FI, TI.isCommutative(), false);
    if !MatchOp {
        return null;
    }
    if CondTy.isVectorTy() && (!OtherOpT.getType().isVectorTy() || !OtherOpF.getType().isVectorTy()) {
        return null;
    }
    let mut BO: *mut auto = dyn_cast(TI);
    if BO() && () && !isGuaranteedNotToBePoison(Cond, null, null, null, 0) {}
    let mut NewSI: *mut Value = null;
    let mut Op0: *mut Value = if MatchIsOpZero { MatchOp } else { NewSI };
    let mut Op1: *mut Value = if MatchIsOpZero { NewSI } else { MatchOp };
    if  {
        let mut NewBO: *mut BinaryOperator = Create(Op0, Op1);
        NewBO.copyIRFlags;
        NewBO.andIRFlags;
        return NewBO();
    }
    if  {
        let mut FGEP: *mut auto = cast(FI);
        let mut ElementType: *mut Type = ();
        return Create(ElementType, Op0, Op1, () & ());
    }
    llvm_unreachable_internal("Expected BinaryOperator or GEP", "llvm\\lib\\Transforms\\InstCombine\\InstCombineSelect.cpp", 502);
    return null;
}

fn InstCombinerImpl::foldSelectIntrinsic(self, SI: *mut SelectInst) -> *mut Instruction {
    let mut LHSIntrinsic: *mut auto = dyn_cast(SI.getTrueValue());
    if operator!() {
        return null;
    }
    let mut RHSIntrinsic: *mut auto = dyn_cast(SI.getFalseValue());
    if operator!() || () != () || operator!() || operator!() {
        return null;
    }
    let mut IID: ID = ();
    match IID {
        abs => {
            cttz;
        },
        ctpop => {
            let mut TV: *mut Value = (0);
            let mut FV: *mut Value = (0);
            let mut NewSel: *mut Value = null;
            let mut NewCall: *mut Value = null;
            return self.replaceInstUsesWith;
        },
        _ => {
            return null;
        },
    }
}

fn isSelect01(C1I: *APInt, C2I: *APInt) -> bool {
    if !C1I.isZero() && !C2I.isZero() {
        return false;
    }
    return C1I.isOne() || C1I.isAllOnes() || C2I.isOne() || C2I.isAllOnes();
}

fn InstCombinerImpl::foldSelectIntoOp(self, SI: *mut SelectInst, TrueVal: *mut Value, FalseVal: *mut Value) -> *mut Instruction {
    let mut TryFoldSelectIntoOp: Closure_3 = Closure_3 { cap_0: self };
    if TryFoldSelectIntoOp.call(SI, TrueVal, FalseVal, false) {
        R;
    } else {
        return R;
    }
    if TryFoldSelectIntoOp.call(SI, FalseVal, TrueVal, true) {
        R;
    } else {
        return R;
    }
    return null;
}

fn canoncalizeSelectICmpMinMax(Cmp: *ICmpInst, TVal: *mut Value, FVal: *mut Value, Builder: *mut BuilderTy, SQ: *SimplifyQuery) -> *mut Value {
    let mut CmpLHS: *mut Value = Cmp.getOperand;
    let mut CmpRHS: *mut Value = Cmp.getOperand;
    let mut Pred: Predicate = Cmp.getPredicate;
    if match(FVal, m_Zero()) {
        swap(TVal, FVal);
        Pred = getInversePredicate(Pred);
    }
    if !match(TVal, m_Zero()) {
        return null;
    }
    if Pred == ICMP_SGT || Pred == ICMP_SGE {
        swap(CmpLHS, CmpRHS);
        Pred = getSwappedPredicate(Pred);
    }
    if (Pred == ICMP_SLT || Pred == ICMP_SLE) && match(FVal, m_NSWSub(m_Specific(CmpLHS), m_Specific(CmpRHS))) && isGuaranteedNotToBeUndef(CmpLHS, SQ.AC, SQ.CtxI, SQ.DT, 0) {
        let mut SMin: *mut Value = Builder()(smin, CmpRHS, CmpLHS);
        return Builder()(CmpLHS, SMin);
    }
    return null;
}

fn foldSelectICmpMinMax(Cmp: *ICmpInst, TVal: *mut Value, FVal: *mut Value, Builder: *mut BuilderTy, SQ: *SimplifyQuery) -> *mut Value {
    let mut CmpLHS: *mut Value = Cmp.getOperand;
    let mut CmpRHS: *mut Value = Cmp.getOperand;
    let mut Pred: Predicate = Cmp.getPredicate;
    if canoncalizeSelectICmpMinMax(Cmp, TVal, FVal, Builder, SQ) {
        V;
    } else {
        return V;
    }
    if CmpRHS == TVal {
        swap(CmpLHS, CmpRHS);
        Pred = getSwappedPredicate(Pred);
    }
    if !(CmpLHS == TVal && isa(FVal)) {
        return null;
    }
    if Pred == ICMP_SGT && match(FVal, m_NSWAdd(m_Specific(CmpRHS))) {
        cast(FVal)(false);
        return Builder()(smax, TVal, FVal);
    }
    if Pred == ICMP_SLT && match(FVal, m_NSWAdd(m_Specific(CmpRHS))) {
        cast(FVal)(false);
        return Builder()(smin, TVal, FVal);
    }
    if Pred == ICMP_UGT && match(FVal, m_NUWAdd(m_Specific(CmpRHS))) {
        cast(FVal)(false);
        return Builder()(umax, TVal, FVal);
    }
    if Pred == ICMP_ULT && match(FVal, m_Add(m_Specific(CmpRHS))) && isKnownNonZero(CmpRHS, SQ, 0) {
        cast(FVal)(false);
        cast(FVal)(false);
        return Builder()(umin, TVal, FVal);
    }
    return null;
}

fn foldSelectICmpAndAnd(SelType: *mut Type, Cond: *Value, TVal: *mut Value, FVal: *mut Value, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut A: *mut Value = null;
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut Z: *mut Value = null;
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut NumReplaced: u32 = 1 + Cond.hasOneUse();
    if match(Cond, m_Trunc(m_Value(X))) {
        Y = get(X.getType(), 1, false, false);
        Pred = CmpPredicate { Pred: ICMP_NE, HasSameSign: false };
    } else if match(Cond, m_ICmp(Pred, m_And(m_Value(X), m_Value(Y)), m_Zero())) && isEquality(Pred.operator llvm::CmpInst::Predicate()) {
        operator+=(NumReplaced, Cond.hasOneUse() && cast(Cond)(0)());
    } else {
        return null;
    }
    if Pred == ICMP_NE {
        swap(TVal, FVal);
    }
    if operator!(match(FVal)) {
        return null;
    }
    if operator!(match(TVal, m_And(m_Value(A)))) {
        return null;
    }
    let mut BitWidth: APInt = APInt { SelType.getScalarSizeInBits(), SelType.getScalarSizeInBits(), false, false };
    let mut TValPattern: auto = m_CombineOr(m_LShr(m_Value(Z)));
    if operator!(match(A)) {
        swap(X, Y);
        if operator!(match(A)) {
            return null;
        }
    }
    let mut HasShift: bool = A != X;
    if TVal.hasOneUse() {
        NumReplaced += 1 + (HasShift && A.hasOneUse());
    }
    if NumReplaced < (4 - isa(Y)) {
        return null;
    }
    let mut One: *mut Constant = get(SelType, 1, false, false);
    let mut MaskB: *mut Value = if HasShift { Builder()(One, Z) } else { One };
    let mut FullMask: *mut Value = Builder()(Y, MaskB);
    let mut MaskedX: *mut Value = Builder()(X, FullMask);
    let mut ICmpNeZero: *mut Value = Builder()(MaskedX);
    return ZExtInst { ICmpNeZero, SelType, "", null };
}

fn foldSelectICmpAndZeroShl(Cmp: *ICmpInst, TVal: *mut Value, FVal: *mut Value, Builder: *mut BuilderTy) -> *mut Value {
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut AndVal: *mut Value = null;
    if operator!(match(Cmp, m_ICmp(Pred, m_Value(AndVal), m_Zero()))) {
        return null;
    }
    if Pred == ICMP_NE {
        Pred = CmpPredicate { Pred: ICMP_EQ, HasSameSign: false };
        swap(TVal, FVal);
    }
    let mut X: *mut Value = null;
    let mut C2: *APInt = null;
    let mut C1: *APInt = null;
    if Pred != ICMP_EQ || operator!(match(AndVal, m_And(m_Value(X)))) || !match(TVal, m_Zero()) || operator!(match(FVal, m_Shl(m_Specific(X)))) {
        return null;
    }
    if !C1.isMask() || C1.countLeadingZeros() != C2.getZExtValue() as u32 {
        return null;
    }
    let mut FI: *mut auto = dyn_cast(FVal);
    if operator!() {
        return null;
    }
    FI()(false);
    FI()(false);
    return FVal;
}

fn foldSelectICmpLshrAshr(IC: *ICmpInst, TrueVal: *mut Value, FalseVal: *mut Value, Builder: *mut BuilderTy) -> *mut Value {
    let mut Pred: Predicate = IC.getPredicate;
    let mut CmpLHS: *mut Value = IC.getOperand;
    let mut CmpRHS: *mut Value = IC.getOperand;
    if !CmpRHS.getType().isIntOrIntVectorTy() {
        return null;
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut Bitwidth: u32 = CmpRHS.getType().getScalarSizeInBits();
    if (Pred != ICMP_SGT || operator!(match(CmpRHS))) && (Pred != ICMP_SLT || operator!(match(CmpRHS))) {
        return null;
    }
    if Pred == ICMP_SLT {
        swap(TrueVal, FalseVal);
    }
    if match(TrueVal, m_LShr(m_Value(X), m_Value(Y))) && match(FalseVal, m_AShr(m_Specific(X), m_Specific(Y))) && match(CmpLHS, m_Specific(X)) {
        let mut Ashr: *auto = cast(FalseVal);
        let mut IsExact: bool = () && cast(TrueVal)();
        return Builder()(X, Y, IC.getName, IsExact);
    }
    return null;
}

fn foldSelectICmpAndBinOp(CondVal: *mut Value, TrueVal: *mut Value, FalseVal: *mut Value, V: *mut Value, AndMask: *APInt, CreateAnd: bool, Builder: *mut BuilderTy) -> *mut Value {
    if !TrueVal.getType().isIntOrIntVectorTy() {
        return null;
    }
    let mut C1Log: u32 = AndMask.logBase2();
    let mut Y: *mut Value = null;
    let mut BinOp: *mut BinaryOperator = null;
    let mut C2: *APInt = null;
    let mut NeedXor: bool = false;
    if match(FalseVal, m_BinOp(m_Specific(TrueVal))) {
        Y = TrueVal;
        BinOp = cast(FalseVal);
        NeedXor = false;
    } else if match(TrueVal, m_BinOp(m_Specific(FalseVal))) {
        Y = FalseVal;
        BinOp = cast(TrueVal);
        NeedXor = true;
    } else {
        return null;
    }
    let mut IdentityC: *mut auto = getBinOpIdentity(BinOp.getOpcode(), BinOp.getType, true);
    if IdentityC() == null || operator!() {
        return null;
    }
    let mut C2Log: u32 = C2.logBase2();
    let mut NeedShift: bool = C1Log != C2Log;
    let mut NeedZExtTrunc: bool = Y.getType().getScalarSizeInBits() != V.getType().getScalarSizeInBits();
    if AndMask.isOne() && C2.isSignBitSet() {
        CreateAnd = false;
    }
    if (NeedShift + NeedXor + NeedZExtTrunc + CreateAnd) > (CondVal.hasOneUse() + BinOp.hasOneUse) {
        return null;
    }
    if CreateAnd {
        V = Builder()(V, get(V.getType(), AndMask));
    }
    if C2Log > C1Log {
        V = Builder()(V, Y.getType());
        V = Builder()(V, C2Log - C1Log);
    } else if C1Log > C2Log {
        V = Builder()(V, C1Log - C2Log);
        V = Builder()(V, Y.getType());
    } else {
        V = Builder()(V, Y.getType());
    }
    if NeedXor {
        V = Builder()(V, *C2);
    }
    let mut Res: *mut auto = Builder()(BinOp.getOpcode(), Y, V);
    if  {
        BO()(BinOp);
    }
    return ;
}

fn foldSetClearBits(Sel: *mut SelectInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Cond: *mut Value = Sel.getCondition();
    let mut T: *mut Value = Sel.getTrueValue();
    let mut F: *mut Value = Sel.getFalseValue();
    let mut Ty: *mut Type = Sel.getType;
    let mut X: *mut Value = null;
    let mut NotC: *APInt = null;
    let mut C: *APInt = null;
    if match(T, m_And(m_Value(X))) && match(F, m_OneUse(m_Or(m_Specific(X)))) && *NotC == operator((*C)) {
        let mut Zero: *mut Constant = getNullValue(Ty);
        let mut OrC: *mut Constant = get(Ty, *C);
        let mut NewSel: *mut Value = Builder()(Cond, Zero, OrC, "masksel", &mut Sel);
        return CreateOr(T, NewSel, "");
    }
    if match(F, m_And(m_Value(X))) && match(T, m_OneUse(m_Or(m_Specific(X)))) && *NotC == operator((*C)) {
        let mut Zero: *mut Constant = getNullValue(Ty);
        let mut OrC: *mut Constant = get(Ty, *C);
        let mut NewSel: *mut Value = Builder()(Cond, OrC, Zero, "masksel", &mut Sel);
        return CreateOr(F, NewSel, "");
    }
    return null;
}

fn foldSelectZeroOrFixedOp(SI: *mut SelectInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut CondVal: *mut Value = SI.getCondition();
    let mut TrueVal: *mut Value = SI.getTrueValue();
    let mut FalseVal: *mut Value = SI.getFalseValue();
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut Predicate: CmpPredicate = CmpPredicate {};
    if operator!(match(CondVal, m_ICmp(Predicate, m_Value(X), m_Zero()))) || !isEquality(Predicate.operator llvm::CmpInst::Predicate()) {
        return null;
    }
    if Predicate == ICMP_NE {
        swap(TrueVal, FalseVal);
    }
    let mut TrueValC: *mut auto = dyn_cast(TrueVal);
    if TrueValC() == null || !isa(FalseVal) {
        return null;
    }
    let mut FreezeY: bool = false;
    if match(FalseVal, m_c_Mul(m_Specific(X), m_Value(Y))) || match(FalseVal, m_c_And(m_Specific(X), m_Value(Y))) || match(FalseVal, m_FShl(m_Specific(X), m_Specific(X), m_Value(Y))) || match(FalseVal, m_FShr(m_Specific(X), m_Specific(X), m_Value(Y))) || match(FalseVal, m_c_Intrinsic(m_Specific(X), m_Value(Y))) {
        FreezeY = true;
    } else if match(FalseVal, m_IDiv(m_Specific(X), m_Value(Y))) || match(FalseVal, m_IRem(m_Specific(X), m_Value(Y))) {
        FreezeY = false;
    } else {
        return null;
    }
    let mut ZeroC: *mut auto = cast(cast(CondVal)(1));
    let mut MergedC: *mut auto = mergeUndefsWith();
    if operator!(match(m_Zero())) && operator!(match(m_Undef())) {
        return null;
    }
    let mut FalseValI: *mut auto = cast(FalseVal);
    if FreezeY {
        let mut FrY: *mut auto = IC()(FreezeInst { Y, Y.getName() + ".fr", null });
        IC.replaceOperand(operator*(), if (0) == Y { 0 } else { (if FalseValI()(1) == Y { 1 } else { 2 }) });
    }
    return IC.replaceInstUsesWith(SI);
}

fn canonicalizeSaturatedSubtractUnsigned(ICI: *ICmpInst, TrueVal: *Value, FalseVal: *Value, Builder: *mut BuilderTy) -> *mut Value {
    let mut Pred: Predicate = ICI.getPredicate;
    let mut A: *mut Value = ICI.getOperand;
    let mut B: *mut Value = ICI.getOperand;
    if match(TrueVal, m_Zero()) {
        Pred = getInversePredicate(Pred);
        swap(TrueVal, FalseVal);
    }
    if !match(FalseVal, m_Zero()) {
        return null;
    }
    if Pred == ICMP_NE {
        if match(B, m_Zero()) && match(TrueVal, m_Add(m_Specific(A))) {
            return Builder()(usub_sat, A, get(A.getType(), 1, false, false));
        }
        return null;
    }
    if !isUnsigned(Pred) {
        return null;
    }
    if Pred == ICMP_ULE || Pred == ICMP_ULT {
        swap(A, B);
        Pred = getSwappedPredicate(Pred);
    }
    assert!((Pred == ICMP_UGE || Pred == ICMP_UGT), "Unexpected isUnsigned predicate!");
    let mut IsNegative: bool = false;
    let mut C: *APInt = null;
    if match(TrueVal, m_Sub(m_Specific(B), m_Specific(A))) || (match(A) && match(TrueVal, m_Add(m_Specific(B)))) {
        IsNegative = true;
    } else if operator!(match(TrueVal, m_Sub(m_Specific(A), m_Specific(B)))) && operator!((match(B) && match(TrueVal, m_Add(m_Specific(A))))) {
        return null;
    }
    if IsNegative && !TrueVal.hasOneUse() && operator!(ICI.hasOneUse) {
        return null;
    }
    let mut Result: *mut Value = Builder()(usub_sat, A, B);
    if IsNegative {
        Result = Builder()(Result);
    }
    return Result;
}

fn canonicalizeSaturatedSubtractSigned(ICI: *ICmpInst, TrueVal: *Value, FalseVal: *Value, Builder: *mut BuilderTy) -> *mut Value {
    let mut Pred: Predicate = ICI.getPredicate;
    let mut CmpLHS: *mut Value = ICI.getOperand;
    let mut CmpRHS: *mut Value = ICI.getOperand;
    if Pred == ICMP_NE {
        Pred = ICMP_EQ;
        swap(TrueVal, FalseVal);
    }
    if Pred == ICMP_EQ && match(CmpRHS) && match(TrueVal) && match(FalseVal, m_Neg(m_Specific(CmpLHS))) {
        return Builder()(ssub_sat, getNullValue(CmpLHS.getType()), CmpLHS);
    }
    return null;
}

fn canonicalizeSaturatedSubtract(ICI: *ICmpInst, TrueVal: *Value, FalseVal: *Value, Builder: *mut BuilderTy) -> *mut Value {
    if canonicalizeSaturatedSubtractUnsigned(ICI, TrueVal, FalseVal, Builder) {
        V;
    } else {
        return V;
    }
    if canonicalizeSaturatedSubtractSigned(ICI, TrueVal, FalseVal, Builder) {
        V;
    } else {
        return V;
    }
    return null;
}

fn canonicalizeSaturatedAddUnsigned(Cmp: *mut ICmpInst, TVal: *mut Value, FVal: *mut Value, Builder: *mut BuilderTy) -> *mut Value {
    let mut Cmp0: *mut Value = Cmp.getOperand;
    let mut Cmp1: *mut Value = Cmp.getOperand;
    let mut Pred: Predicate = Cmp.getPredicate;
    let mut X: *mut Value = null;
    let mut C: *APInt = null;
    if match(FVal) {
        swap(TVal, FVal);
        Pred = getInversePredicate(Pred);
    }
    if operator!(match(TVal)) {
        return null;
    }
    if Pred == ICMP_EQ {
        if match(FVal, m_Add(m_Specific(Cmp0))) && match(Cmp1) {
            return Builder()(uadd_sat, Cmp0, get(Cmp0.getType(), 1, false, false));
        }
        return null;
    }
    if (Pred == ICMP_UGE || Pred == ICMP_UGT) && match(FVal, m_Add(m_Specific(Cmp0))) && match(Cmp1) {
        return Builder()(uadd_sat, Cmp0, get(Cmp0.getType(), *C));
    }
    if Pred == ICMP_UGT && match(FVal, m_Add(m_Specific(Cmp0))) && match(Cmp1) && !C.isAllOnes() {
        return Builder()(uadd_sat, Cmp0, get(Cmp0.getType(), *C));
    }
    if Pred == ICMP_UGE && match(FVal, m_Add(m_Specific(Cmp0))) && match(Cmp1) && !C.isZero() {
        return Builder()(uadd_sat, Cmp0, get(Cmp0.getType(), *C));
    }
    if Pred == ICMP_UGT || Pred == ICMP_UGE {
        swap(Cmp0, Cmp1);
        Pred = getSwappedPredicate(Pred);
    }
    if Pred != ICMP_ULT && Pred != ICMP_ULE {
        return null;
    }
    let mut Y: *mut Value = null;
    if match(Cmp0, m_Not(m_Value(X))) && match(FVal, m_c_Add(m_Specific(X), m_Value(Y))) && Y == Cmp1 {
        return Builder()(uadd_sat, X, Y);
    }
    X = Cmp0;
    Y = Cmp1;
    if match(FVal, m_c_Add(m_NotForbidPoison(m_Specific(X)), m_Specific(Y))) {
        let mut BO: *mut BinaryOperator = cast(FVal);
        return Builder()(uadd_sat, BO.getOperand(0), BO.getOperand(1));
    }
    if Pred == ICMP_ULT && match(Cmp0, m_c_Add(m_Specific(Cmp1), m_Value(Y))) && match(FVal, m_c_Add(m_Specific(Cmp1), m_Specific(Y))) {
        return Builder()(uadd_sat, Cmp1, Y);
    }
    return null;
}

fn canonicalizeSaturatedAddSigned(Cmp: *mut ICmpInst, TVal: *mut Value, FVal: *mut Value, Builder: *mut BuilderTy) -> *mut Value {
    let mut Cmp0: *mut Value = Cmp.getOperand;
    let mut Cmp1: *mut Value = Cmp.getOperand;
    let mut Pred: Predicate = Cmp.getPredicate;
    if match(FVal) || match(FVal) {
        swap(TVal, FVal);
        Pred = getInversePredicate(Pred);
    }
    let mut SatC: *APInt = null;
    if operator!(match(TVal)) || !(SatC.isMaxSignedValue() || SatC.isSignMask()) {
        return null;
    }
    let mut IsMax: bool = SatC.isMaxSignedValue();
    if Pred == ICMP_EQ && Cmp1 == TVal {
        if IsMax && match(FVal, m_Add(m_Specific(Cmp0))) {
            return Builder()(sadd_sat, Cmp0, get(Cmp0.getType(), 1, false, false));
        }
        if !IsMax && match(FVal, m_Add(m_Specific(Cmp0))) {
            return Builder()(sadd_sat, Cmp0, getAllOnesValue(Cmp0.getType()));
        }
        return null;
    }
    let mut C: *APInt = null;
    if IsMax && (Pred == ICMP_SGT || Pred == ICMP_SGE) && isa(Cmp1) && match(FVal, m_Add(m_Specific(Cmp0))) {
        if Pred == ICMP_SGE {
            if  {
                Pred = ;
                Cmp1 = ;
            }
        }
        let mut Threshold: APInt = *SatC - *C;
        if Pred == ICMP_SGT && (match(Cmp1) || match(Cmp1)) {
            return Builder()(sadd_sat, Cmp0, get(Cmp0.getType(), *C));
        }
    }
    if !IsMax && (Pred == ICMP_SLT || Pred == ICMP_SLE) && isa(Cmp1) && match(FVal, m_Add(m_Specific(Cmp0))) {
        if Pred == ICMP_SLE {
            if  {
                Pred = ;
                Cmp1 = ;
            }
        }
        let mut Threshold: APInt = *SatC - *C;
        if Pred == ICMP_SLT && (match(Cmp1) || match(Cmp1)) {
            return Builder()(sadd_sat, Cmp0, get(Cmp0.getType(), *C));
        }
    }
    if Pred == ICMP_SGT || Pred == ICMP_SGE {
        swap(Cmp0, Cmp1);
        Pred = getSwappedPredicate(Pred);
    }
    if Pred != ICMP_SLT && Pred != ICMP_SLE {
        return null;
    }
    let mut X: *mut Value = null;
    if IsMax && match(Cmp0, m_NSWSub(m_Value(X))) && match(FVal, m_c_Add(m_Specific(X), m_Specific(Cmp1))) {
        return Builder()(sadd_sat, X, Cmp1);
    }
    if !IsMax && match(Cmp1, m_NSWSub(m_Value(X))) && match(FVal, m_c_Add(m_Specific(X), m_Specific(Cmp0))) {
        return Builder()(sadd_sat, X, Cmp0);
    }
    return null;
}

fn canonicalizeSaturatedAdd(Cmp: *mut ICmpInst, TVal: *mut Value, FVal: *mut Value, Builder: *mut BuilderTy) -> *mut Value {
    if operator!(Cmp.hasOneUse) {
        return null;
    }
    if canonicalizeSaturatedAddUnsigned(Cmp, TVal, FVal, Builder) {
        V;
    } else {
        return V;
    }
    if canonicalizeSaturatedAddSigned(Cmp, TVal, FVal, Builder) {
        V;
    } else {
        return V;
    }
    return null;
}

fn foldAbsDiff(Cmp: *mut ICmpInst, TVal: *mut Value, FVal: *mut Value, Builder: *mut BuilderTy) -> *mut Value {
    let mut TI: *mut auto = dyn_cast(TVal);
    let mut FI: *mut auto = dyn_cast(FVal);
    if operator!() || operator!() {
        return null;
    }
    let mut Pred: Predicate = Cmp;
    let mut A: *mut Value = Cmp.getOperand;
    let mut B: *mut Value = Cmp.getOperand;
    if match(m_Sub(m_Specific(A), m_Specific(B))) {
        swap();
        Pred = getSwappedPredicate(Pred);
    }
    if Pred == ICMP_SGT && match(m_Sub(m_Specific(A), m_Specific(B))) && match(m_Sub(m_Specific(B), m_Specific(A))) && (TI()() || ()) && (FI()() || ()) {
        TI()(false);
        if operator!() {
            TI()();
        }
        return Builder()(abs, Builder()());
    }
    if Pred == ICMP_SGT && match(m_NSWSub(m_Specific(A), m_Specific(B))) && match(m_Neg(m_Specific())) {
        return Builder()(abs, Builder()());
    }
    if Pred == ICMP_SLT && match(m_NSWSub(m_Specific(A), m_Specific(B))) && match(m_Neg(m_Specific())) {
        return Builder()(abs, Builder()());
    }
    if Pred == ICMP_SGT && match(m_NSWSub(m_Specific(B), m_Specific(A))) && match(m_Neg(m_Specific())) {
        return Builder()(abs, Builder()());
    }
    if Pred == ICMP_SLT && match(m_NSWSub(m_Specific(B), m_Specific(A))) && match(m_Neg(m_Specific())) {
        return Builder()(abs, Builder()());
    }
    return null;
}

fn foldSelectCtlzToCttz(ICI: *mut ICmpInst, TrueVal: *mut Value, FalseVal: *mut Value, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut BitWidth: u32 = TrueVal.getType().getScalarSizeInBits();
    if !ICI.isEquality() || operator!(match(ICI.getOperand, m_Zero())) {
        return null;
    }
    if ICI.getPredicate == ICMP_NE {
        swap(TrueVal, FalseVal);
    }
    let mut Ctlz: *mut Value = null;
    if match(FalseVal, m_Xor(m_Value(Ctlz))) {
        if !isPowerOf2_32(BitWidth) {
            return null;
        }
    } else if operator!(match(FalseVal, m_Sub(m_Value(Ctlz)))) {
        return null;
    }
    if operator!(match(Ctlz, m_Ctlz(m_Value(), m_Value()))) {
        return null;
    }
    if operator!(match(TrueVal)) {
        return null;
    }
    let mut X: *mut Value = ICI.getOperand;
    let mut II: *mut auto = cast(Ctlz);
    if operator!(match((0), m_c_And(m_Specific(X), m_Neg(m_Specific(X))))) {
        return null;
    }
    let mut F: *mut Function = getOrInsertDeclaration(cttz);
    return Create(F, void { X, Builder()() });
}

fn foldSelectCttzCtlz(ICI: *mut ICmpInst, TrueVal: *mut Value, FalseVal: *mut Value, IC: *mut InstCombinerImpl) -> *mut Value {
    let mut Pred: Predicate = ICI.getPredicate;
    let mut CmpLHS: *mut Value = ICI.getOperand;
    let mut CmpRHS: *mut Value = ICI.getOperand;
    if !ICI.isEquality() {
        return null;
    }
    let mut SelectArg: *mut Value = FalseVal;
    let mut ValueOnZero: *mut Value = TrueVal;
    if Pred == ICMP_NE {
        swap(SelectArg, ValueOnZero);
    }
    let mut Count: *mut Value = null;
    if operator!(match(SelectArg, m_ZExt(m_Value(Count)))) && operator!(match(SelectArg, m_Trunc(m_Value(Count)))) {
        Count = SelectArg;
    }
    let mut X: *mut Value = null;
    if operator!(match(Count, m_Cttz(m_Value(X), m_Value()))) && operator!(match(Count, m_Ctlz(m_Value(X), m_Value()))) {
        return null;
    }
    if (X != CmpLHS || !match(CmpRHS, m_Zero())) && (operator!(match(X, m_Not(m_Specific(CmpLHS)))) || operator!(match(CmpRHS))) && operator!(match(X, m_c_Xor(m_Specific(CmpLHS), m_Specific(CmpRHS)))) {
        return null;
    }
    let mut II: *mut IntrinsicInst = cast(Count);
    let mut SizeOfInBits: u32 = Count.getType().getScalarSizeInBits();
    if match(ValueOnZero) {
        II.dropPoisonGeneratingAnnotations;
        IC.addToWorklist;
        return SelectArg;
    }
    if II.hasOneUse && SelectArg.hasOneUse() && operator!(match(II.getArgOperand)) {
        II.setArgOperand(1, getTrue(II.getContext));
        II.dropUBImplyingAttrsAndMetadata;
        IC.addToWorklist;
    }
    return null;
}

fn canonicalizeSPF(Cmp: *mut ICmpInst, TrueVal: *mut Value, FalseVal: *mut Value, IC: *mut InstCombinerImpl) -> *mut Value {
    let mut LHS: *mut Value = null;
    let mut RHS: *mut Value = null;
    if !TrueVal.getType().isIntOrIntVectorTy() {
        return null;
    }
    let mut SPF: SelectPatternFlavor = matchDecomposedSelectPattern(&mut Cmp, TrueVal, FalseVal, LHS, RHS).Flavor;
    if SPF == SPF_ABS || SPF == SPF_NABS {
        if operator!(Cmp.hasOneUse) && !RHS.hasOneUse() {
            return null;
        }
        let mut IntMinIsPoison: bool = SPF == SPF_ABS && match(RHS, m_NSWNeg(m_Specific(LHS)));
        let mut IntMinIsPoisonC: *mut Constant = get(getInt1Ty(Cmp.getContext), IntMinIsPoison);
        let mut Abs: *mut Value = IC()(abs, LHS, IntMinIsPoisonC);
        if SPF == SPF_NABS {
            return IC()(Abs);
        }
        return Abs;
    }
    if isMinOrMax(SPF) {
        let mut IntrinsicID: ID = getMinMaxIntrinsic(SPF);
        return IC()(IntrinsicID, LHS, RHS);
    }
    return null;
}

fn InstCombinerImpl::replaceInInstruction(self, V: *mut Value, Old: *mut Value, New: *mut Value, Depth: u32) -> bool {
    if Depth == 2 {
        return false;
    }
    assert!(!isa(Old), "Only replace non-constant values");
    let mut I: *mut auto = dyn_cast(V);
    if operator!() || operator!() || operator!(isSafeToSpeculativelyExecuteWithVariableReplaced()) {
        return false;
    }
    if Old.getType().isVectorTy() && operator!(isNotCrossLaneOperation()) {
        return false;
    }
    let mut Changed: bool = false;
    return Changed;
}

fn InstCombinerImpl::foldSelectValueEquivalence(self, Sel: *mut SelectInst, Cmp: *mut CmpInst) -> *mut Instruction {
    let mut TrueVal: *mut Value = Sel.getTrueValue();
    let mut FalseVal: *mut Value = Sel.getFalseValue();
    let mut Swapped: bool = false;
    if Cmp.isEquivalence(true) {
        swap(TrueVal, FalseVal);
        Swapped = true;
    } else if !Cmp.isEquivalence(false) {
        return null;
    }
    let mut CmpLHS: *mut Value = Cmp.getOperand(0);
    let mut CmpRHS: *mut Value = Cmp.getOperand(1);
    let mut ReplaceOldOpWithNewOp: Closure_4 = Closure_4 { TrueVal: &mut TrueVal, cap_1: self, Sel: &mut Sel, Swapped: &mut Swapped, CmpLHS: &mut CmpLHS };
    let mut CanReplaceCmpLHSWithRHS: bool = canReplacePointersIfEqual(CmpLHS, CmpRHS);
    if CanReplaceCmpLHSWithRHS {
        if ReplaceOldOpWithNewOp.call(CmpLHS, CmpRHS) {
            R;
        } else {
            return R;
        }
    }
    let mut CanReplaceCmpRHSWithLHS: bool = canReplacePointersIfEqual(CmpRHS, CmpLHS);
    if CanReplaceCmpRHSWithLHS {
        if ReplaceOldOpWithNewOp.call(CmpRHS, CmpLHS) {
            R;
        } else {
            return R;
        }
    }
    let mut FalseInst: *mut auto = dyn_cast(FalseVal);
    if operator!() {
        return null;
    }
    let mut DropFlags: i32 = 0;
    if (CanReplaceCmpLHSWithRHS && simplifyWithOpReplaced(FalseVal, CmpLHS, CmpRHS, false, operator&()) == TrueVal) || (CanReplaceCmpRHSWithLHS && simplifyWithOpReplaced(FalseVal, CmpRHS, CmpLHS, false, operator&()) == TrueVal) {
        return self.replaceInstUsesWith;
    }
    let mut CmpC: *mut Constant = null;
    if FalseVal.getType().isIntOrIntVectorTy(1) && match(FalseVal, m_NUWTrunc(m_Specific(CmpLHS))) && match(CmpRHS, m_ImmConstant(CmpC)) && ConstantFoldCompareInstOperands(ICMP_NE, CmpC, getNullValue(CmpLHS.getType())) == TrueVal {
        return ICmpInst { ICMP_NE, CmpLHS, getNullValue(CmpLHS.getType()), "" };
    }
    return null;
}

fn InstCombinerImpl::foldSelectEqualityTest(self, Sel: *mut SelectInst) -> *mut Instruction {
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut Z: *mut Value = null;
    let mut XeqY: *mut Value = null;
    let mut XeqZ: *mut Value = Sel.getCondition();
    let mut YeqZ: *mut Value = Sel.getTrueValue();
    if operator!(match(XeqZ, m_SpecificICmp(ICMP_EQ, m_Value(X), m_Value(Z)))) {
        return null;
    }
    if operator!(match(YeqZ, m_c_SpecificICmp(ICMP_EQ, m_Value(Y), m_Specific(Z)))) {
        swap(X, Z);
    }
    if operator!(match(YeqZ, m_c_SpecificICmp(ICMP_EQ, m_Value(Y), m_Specific(Z)))) {
        return null;
    }
    if operator!(match(Sel.getFalseValue(), m_c_LogicalAnd(m_Not(m_Specific(YeqZ)), m_Value(XeqY)))) {
        return null;
    }
    if operator!(match(XeqY, m_c_SpecificICmp(ICMP_EQ, m_Specific(X), m_Specific(Y)))) {
        return null;
    }
    cast(XeqY)(false);
    return self.replaceInstUsesWith;
}

fn canonicalizeClampLike(Sel0: *mut SelectInst, Cmp0: *mut ICmpInst, Builder: *mut BuilderTy, IC: *mut InstCombiner) -> *mut Value {
    let mut X: *mut Value = Sel0.getTrueValue();
    let mut Sel1: *mut Value = Sel0.getFalseValue();
    if operator!(Cmp0.hasOneUse) {
        return null;
    }
    let mut Pred0: Predicate = Cmp0.getPredicate;
    let mut Cmp00: *mut Value = Cmp0.getOperand;
    let mut C0: *mut Constant = null;
    if operator!(match(Cmp0.getOperand, m_CombineAnd())) {
        return null;
    }
    if operator!(match(Sel1, m_SelectLike(m_Value(), m_Value(), m_Value()))) {
        Pred0 = getInversePredicate(Pred0);
        swap(X, Sel1);
    }
    match Pred0 {
        ICMP_ULT => {
            ICMP_UGE;
        },
        ICMP_ULE => {
            ICMP_UGT;
        },
        _ => {
            return null;
        },
    }
    if !Sel1.hasOneUse() {
        return null;
    }
    if Cmp00.getType() != X.getType() && X.hasOneUse() {
        match(X, m_TruncOrSelf(m_Value(X)));
    }
    let mut C1: *mut Constant = null;
    if Cmp00 == X {
        C1 = getNullValue(X.getType());
    } else if operator!(match(Cmp00, m_Add(m_Specific(X), m_CombineAnd()))) {
        return null;
    }
    let mut Cmp1: *mut Value = null;
    let mut Pred1: CmpPredicate = CmpPredicate {};
    let mut C2: *mut Constant = null;
    let mut ReplacementLow: *mut Value = null;
    let mut ReplacementHigh: *mut Value = null;
    if operator!(match(Sel1, m_SelectLike(m_Value(Cmp1), m_Value(ReplacementLow), m_Value(ReplacementHigh)))) || operator!(match(Cmp1, m_ICmp(Pred1, m_Specific(X), m_CombineAnd()))) {
        return null;
    }
    if !Cmp1.hasOneUse() && (Cmp00 == X || !Cmp00.hasOneUse()) {
        return null;
    }
    match Pred1.operator llvm::CmpInst::Predicate() {
        ICMP_SLT => {
            break;
        },
        ICMP_SLE => {
            return null;
        },
        ICMP_SGT => {
            if operator!(match(C2)) {
                return null;
            }
        },
        ICMP_SGE => {
            Pred1 = CmpPredicate { Pred: ICMP_SLT, HasSameSign: false };
        },
        _ => {
            return null;
        },
    }
    assert!(Pred1 == ICMP_SLT, "Unexpected predicate type.");
    let mut ThresholdLowIncl: *mut Constant = getNeg(C1, false);
    let mut ThresholdHighExcl: *mut Constant = getSub(C0, C1, false, false);
    assert!((Pred0 == ICMP_ULT || Pred0 == ICMP_UGE), "Unexpected predicate type.");
    if Pred0 == ICMP_UGE {
        swap(ThresholdLowIncl, ThresholdHighExcl);
    }
    let mut Precond1: *mut Constant = ConstantFoldCompareInstOperands(ICMP_SGE, C2, ThresholdLowIncl, IC.getDataLayout(), null, null);
    if !Precond1 || operator!(match(Precond1)) {
        return null;
    }
    let mut Precond2: *mut Constant = ConstantFoldCompareInstOperands(ICMP_SLE, C2, ThresholdHighExcl, IC.getDataLayout(), null, null);
    if !Precond2 || operator!(match(Precond2)) {
        return null;
    }
    if X.getType() != Sel0.getType {
        let mut LowC: *mut Constant = null;
        let mut HighC: *mut Constant = null;
        if !match(ReplacementLow, m_ImmConstant(LowC)) || !match(ReplacementHigh, m_ImmConstant(HighC)) {
            return null;
        }
        let mut DL: *DataLayout = Sel0.getDataLayout;
        ReplacementLow = ConstantFoldCastOperand(SExt, LowC, X.getType(), DL);
        ReplacementHigh = ConstantFoldCastOperand(SExt, HighC, X.getType(), DL);
        assert!(ReplacementLow && ReplacementHigh, "Constant folding of ImmConstant cannot fail");
    }
    let mut ShouldReplaceLow: *mut Value = Builder()(X, ThresholdLowIncl);
    let mut ShouldReplaceHigh: *mut Value = Builder()(X, ThresholdHighExcl);
    let mut MaybeReplacedLow: *mut Value = Builder()(ShouldReplaceLow, ReplacementLow, X);
    let mut MaybeReplacedHigh: *mut Value = Builder()(ShouldReplaceHigh, ReplacementHigh, MaybeReplacedLow);
    return Builder()(MaybeReplacedHigh, Sel0.getType);
}

fn tryToReuseConstantFromSelectInComparison(Sel: *mut SelectInst, Cmp: *mut ICmpInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut X: *mut Value = null;
    let mut C0: *mut Constant = null;
    if operator!(match(&mut Cmp, m_OneUse(m_ICmp(Pred, m_Value(X), m_CombineAnd())))) {
        return null;
    }
    if isEquality(Pred.operator llvm::CmpInst::Predicate()) {
        return null;
    }
    if !isCanonicalPredicate(Pred) {
        return null;
    }
    if C0.getType() != Sel.getType {
        return null;
    }
    if Pred == ICMP_ULT && match(X, m_Add(m_Value())) {
        return null;
    }
    let mut SelVal0: *mut Value = null;
    let mut SelVal1: *mut Value = null;
    match(&mut Sel, m_Select(m_Value(), m_Value(SelVal0), m_Value(SelVal1)));
    if operator!(match(SelVal0)) && operator!(match(SelVal1)) {
        return null;
    }
    let mut MatchesSelectValue: Closure_5 = Closure_5 { SelVal0: SelVal0, SelVal1: SelVal1 };
    if MatchesSelectValue.call(C0) {
        return null;
    }
    let mut FlippedStrictness: auto = getFlippedStrictnessPredicateAndConstant(Pred, C0);
    if operator!() {
        return null;
    }
    if operator!(MatchesSelectValue()) {
        return null;
    }
    IC()(&mut Sel);
    Pred = CmpPredicate { Pred: getSwappedPredicate(Pred.operator llvm::CmpInst::Predicate()), HasSameSign: false };
    let mut NewCmp: *mut Value = IC()(Pred, X, Cmp.getName + ".inv");
    IC.replaceOperand;
    Sel.swapValues();
    Sel.swapProfMetadata;
    return &mut Sel;
}

fn foldSelectZeroOrOnes(Cmp: *mut ICmpInst, TVal: *mut Value, FVal: *mut Value, Builder: *mut BuilderTy) -> *mut Instruction {
    if operator!(Cmp.hasOneUse) {
        return null;
    }
    let mut CmpC: *APInt = null;
    if operator!(match(Cmp.getOperand)) {
        return null;
    }
    let mut X: *mut Value = Cmp.getOperand;
    if Cmp.getPredicate == ICMP_ULT && *CmpC == 2 && match(TVal, m_Neg(m_Specific(X))) && match(FVal) {
        return Builder()(X);
    }
    if Cmp.getPredicate == ICMP_UGT && *CmpC == 1 && match(FVal, m_Neg(m_Specific(X))) && match(TVal) {
        return Builder()(X);
    }
    return null;
}

fn foldSelectInstWithICmpConst(SI: *mut SelectInst, ICI: *mut ICmpInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut CmpC: *APInt = null;
    let mut V: *mut Value = null;
    let mut Pred: CmpPredicate = CmpPredicate {};
    if operator!(match(ICI, m_ICmp(Pred, m_Value(V)))) {
        return null;
    }
    let mut TVal: *mut Value = SI.getTrueValue();
    let mut FVal: *mut Value = SI.getFalseValue();
    if Pred == ICMP_EQ && V == FVal {
        if CmpC.isMinValue() && match(TVal) {
            return Builder()(umax, V, TVal);
        }
        if CmpC.isMaxValue() && match(TVal) {
            return Builder()(umin, V, TVal);
        }
        if CmpC.isMinSignedValue() && match(TVal) {
            return Builder()(smax, V, TVal);
        }
        if CmpC.isMaxSignedValue() && match(TVal) {
            return Builder()(smin, V, TVal);
        }
    }
    let mut Op: *mut Instruction = null;
    let mut C: *APInt = null;
    let mut CPred: Predicate = zeroed();
    if match(&mut SI, m_Select(m_Specific(ICI), m_Instruction(Op))) {
        CPred = ICI.getPredicate;
    } else if match(&mut SI, m_Select(m_Specific(ICI), m_Instruction(Op))) {
        CPred = ICI;
    } else {
        return null;
    }
    let mut InvDomCR: ConstantRange = makeExactICmpRegion(CPred, *CmpC);
    let mut OpC: *APInt = null;
    if match(Op, m_BinOp(m_Specific(V))) {
        let mut R: ConstantRange = InvDomCR.binaryOp(Op.getOpcode() as BinaryOps, *OpC);
        if R == *C {
            Op.dropPoisonGeneratingFlags();
            return Op;
        }
    }
    let mut MMI: *mut auto = dyn_cast(Op);
    if MMI() && () == V && match() {
        let mut R: ConstantRange = intrinsic(void { InvDomCR, *OpC });
        if R == *C {
            MMI()();
            return ;
        }
    }
    return null;
}

fn foldSelectWithExtremeEqCond(CmpLHS: *mut Value, CmpRHS: *mut Value, TrueVal: *mut Value, FalseVal: *mut Value) -> *mut Instruction {
    let mut Ty: *mut Type = CmpLHS.getType();
    if Ty.isPtrOrPtrVectorTy() {
        return null;
    }
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut B: *mut Value = null;
    if operator!(match(FalseVal, m_c_ICmp(Pred, m_Specific(CmpLHS), m_Value(B)))) {
        return null;
    }
    let mut TValRHS: *mut Value = null;
    if operator!(match(TrueVal, m_SpecificICmp(ICMP_NE, m_Specific(B), m_Value(TValRHS)))) {
        return null;
    }
    let mut C: APInt = APInt {};
    let mut BitWidth: u32 = Ty.getScalarSizeInBits();
    if isLT(Pred.operator llvm::CmpInst::Predicate()) {
        C = if isSigned(Pred.operator llvm::CmpInst::Predicate()) { getSignedMinValue(BitWidth) } else { getMinValue(BitWidth) };
    } else if isGT(Pred.operator llvm::CmpInst::Predicate()) {
        C = if isSigned(Pred.operator llvm::CmpInst::Predicate()) { getSignedMaxValue(BitWidth) } else { getMaxValue(BitWidth) };
    } else {
        return null;
    }
    if operator!(match(CmpRHS)) || operator!(match(TValRHS)) {
        return null;
    }
    return ICmpInst { Pred.operator llvm::CmpInst::Predicate(), CmpLHS, B, "" };
}

fn foldSelectICmpEq(SI: *mut SelectInst, ICI: *mut ICmpInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut Pred: Predicate = ICI.getPredicate;
    if !isEquality(Pred) {
        return null;
    }
    let mut TrueVal: *mut Value = SI.getTrueValue();
    let mut FalseVal: *mut Value = SI.getFalseValue();
    let mut CmpLHS: *mut Value = ICI.getOperand;
    let mut CmpRHS: *mut Value = ICI.getOperand;
    if Pred == ICMP_NE {
        swap(TrueVal, FalseVal);
    }
    if foldSelectWithExtremeEqCond(CmpLHS, CmpRHS, TrueVal, FalseVal) {
        Res;
    } else {
        return Res;
    }
    return null;
}

fn InstCombinerImpl::foldSelectWithConstOpToBinOp(self, Cmp: *mut ICmpInst, TrueVal: *mut Value, FalseVal: *mut Value) -> *mut Value {
    let mut C1: *mut Constant = null;
    let mut C2: *mut Constant = null;
    let mut C3: *mut Constant = null;
    let mut X: *mut Value = null;
    let mut Predicate: CmpPredicate = CmpPredicate {};
    if operator!(match(Cmp, m_ICmp(Predicate, m_Value(X)))) {
        return null;
    }
    if !isRelational(Predicate.operator llvm::CmpInst::Predicate()) {
        return null;
    }
    if match(TrueVal) {
        swap(FalseVal, TrueVal);
        Predicate = CmpPredicate { Pred: getInversePredicate(Predicate.operator llvm::CmpInst::Predicate()), HasSameSign: false };
    }
    if operator!(match(FalseVal)) || !TrueVal.hasOneUse() {
        return null;
    }
    let mut IsIntrinsic: bool = false;
    let mut Opcode: u32 = 0;
    if dyn_cast(TrueVal) {
        BOp;
    } else {
        Opcode = BOp.getOpcode();
        IsIntrinsic = false;
        if isIntDivRem(Opcode) {
            return null;
        }
        if operator!(match(BOp, m_BinOp(m_Specific(X)))) {
            return null;
        }
    }
    let mut RHS: *mut Value = null;
    let mut SPF: SelectPatternFlavor = zeroed();
    let mut DL: *DataLayout = Cmp.getDataLayout;
    let mut Flipped: auto = getFlippedStrictnessPredicateAndConstant(Predicate, C1);
    let mut FoldBinaryOpOrIntrinsic: Closure_6 = Closure_6 { IsIntrinsic: &mut IsIntrinsic, Opcode: &mut Opcode, DL: &mut DL };
    if C3 == FoldBinaryOpOrIntrinsic(C1, C2) {
        SPF = getSelectPattern(Predicate.operator llvm::CmpInst::Predicate(), SPNB_NA, false).Flavor;
        RHS = C1;
    } else if Flipped() && C3 == FoldBinaryOpOrIntrinsic(C2) {
        SPF = getSelectPattern();
        RHS = ;
    } else {
        return null;
    }
    let mut MinMaxID: ID = getMinMaxIntrinsic(SPF);
    let mut MinMax: *mut Value = null;
    let mut BinOpc: BinaryOps = Opcode;
    let mut BinOp: *mut Value = null;
    if dyn_cast(BinOp) {
        BinOpInst;
    } else {
        if BinOpc == Add || BinOpc == Sub || BinOpc == Mul {
            let mut OldBinOp: *mut Instruction = cast(TrueVal);
            if OldBinOp.hasNoSignedWrap() && self.willNotOverflow(BinOpc, RHS, C2, *BinOpInst, true) {
                BinOpInst.setHasNoSignedWrap(true);
            }
            if OldBinOp.hasNoUnsignedWrap() && self.willNotOverflow(BinOpc, RHS, C2, *BinOpInst, false) {
                BinOpInst.setHasNoUnsignedWrap(true);
            }
        }
    }
    return BinOp;
}

fn foldICmpUSubSatWithAndForMostSignificantBitCmp(SI: *mut SelectInst, ICI: *mut ICmpInst, Builder: *mut BuilderTy) -> *mut Instruction {
    if operator!(SI.hasOneUse) || operator!(ICI.hasOneUse) {
        return null;
    }
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut Constant1: *APInt = null;
    let mut Constant2: *APInt = null;
    if operator!(match(SI.getCondition(), m_ICmp(Pred, m_OneUse(m_Or(m_OneUse(m_Intrinsic(m_Value(A))), m_OneUse(m_Intrinsic(m_Value(B))))), m_Zero()))) {
        return null;
    }
    let mut TrueVal: *mut Value = SI.getTrueValue();
    let mut FalseVal: *mut Value = SI.getFalseValue();
    if operator!(((Pred == ICMP_EQ && match(TrueVal, m_Zero()) && match(FalseVal)) || (Pred == ICMP_NE && match(TrueVal) && match(FalseVal, m_Zero())))) {
        return null;
    }
    let mut Ty: *mut Type = A.getType();
    let mut BW: u32 = Constant1.getBitWidth();
    let mut MostSignificantBit: APInt = getSignMask(BW);
    if Constant1.isNonNegative() || Constant2.isNonNegative() {
        return null;
    }
    let mut AdjAP1: APInt = *Constant1 - MostSignificantBit + 1;
    let mut AdjAP2: APInt = *Constant2 - MostSignificantBit + 1;
    let mut Adj1: *mut Constant = get(Ty, AdjAP1);
    let mut Adj2: *mut Constant = get(Ty, AdjAP2);
    let mut NewA: *mut Value = Builder()(usub_sat, A, Adj1);
    let mut NewB: *mut Value = Builder()(usub_sat, B, Adj2);
    let mut Or: *mut Value = Builder()(NewA, NewB);
    let mut MSBConst: *mut Constant = get(Ty, MostSignificantBit);
    return CreateAnd(Or, MSBConst, "");
}

fn InstCombinerImpl::foldSelectInstWithICmp(self, SI: *mut SelectInst, ICI: *mut ICmpInst) -> *mut Instruction {
    if canonicalizeSPF(*ICI, SI.getTrueValue(), SI.getFalseValue(), *self) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if foldSelectInstWithICmpConst(SI, ICI) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if canonicalizeClampLike(SI, *ICI, *self) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if tryToReuseConstantFromSelectInComparison(SI, *ICI, *self) {
        NewSel;
    } else {
        return NewSel;
    }
    if foldICmpUSubSatWithAndForMostSignificantBitCmp(SI, ICI) {
        Folded;
    } else {
        return Folded;
    }
    let mut Changed: bool = false;
    let mut TrueVal: *mut Value = SI.getTrueValue();
    let mut FalseVal: *mut Value = SI.getFalseValue();
    let mut Pred: Predicate = ICI.getPredicate;
    let mut CmpLHS: *mut Value = ICI.getOperand;
    let mut CmpRHS: *mut Value = ICI.getOperand;
    if foldSelectICmpEq(SI, ICI, *self) {
        NewSel;
    } else {
        return NewSel;
    }
    if Pred == ICMP_SGT && match(CmpRHS) && operator!(match(TrueVal)) && operator!(match(FalseVal)) && ICI.hasOneUse {
        let mut IsNeg: *mut Value = null;
        self.replaceOperand;
        SI.swapValues();
        SI.swapProfMetadata;
        return &mut SI;
    }
    if foldSelectICmpMinMax(ICI, TrueVal, FalseVal) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if foldSelectICmpAndZeroShl(ICI, TrueVal, FalseVal) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if foldSelectCtlzToCttz(ICI, TrueVal, FalseVal) {
        V;
    } else {
        return V;
    }
    if foldSelectZeroOrOnes(ICI, TrueVal, FalseVal) {
        V;
    } else {
        return V;
    }
    if foldSelectICmpLshrAshr(ICI, TrueVal, FalseVal) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if foldSelectCttzCtlz(ICI, TrueVal, FalseVal, *self) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if canonicalizeSaturatedSubtract(ICI, TrueVal, FalseVal) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if canonicalizeSaturatedAdd(ICI, TrueVal, FalseVal) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if foldAbsDiff(ICI, TrueVal, FalseVal) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if self.foldSelectWithConstOpToBinOp(ICI, TrueVal, FalseVal) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    return if Changed { &mut SI } else { null };
}

fn InstCombinerImpl::foldSPFofSPF(self, Inner: *mut Instruction, SPF1: SelectPatternFlavor, A: *mut Value, B: *mut Value, Outer: *mut Instruction, SPF2: SelectPatternFlavor, C: *mut Value) -> *mut Instruction {
    if Outer.getType != Inner.getType {
        return null;
    }
    if C == A || C == B {
        if SPF1 == SPF2 && isMinOrMax(SPF1) {
            return self.replaceInstUsesWith;
        }
    }
    return null;
}

fn foldAddSubSelect(SI: *mut SelectInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut CondVal: *mut Value = SI.getCondition();
    let mut TrueVal: *mut Value = SI.getTrueValue();
    let mut FalseVal: *mut Value = SI.getFalseValue();
    let mut TI: *mut auto = dyn_cast(TrueVal);
    let mut FI: *mut auto = dyn_cast(FalseVal);
    if operator!() || operator!() || operator!() || operator!() {
        return null;
    }
    let mut AddOp: *mut Instruction = null;
    let mut SubOp: *mut Instruction = null;
    if (TI()() == Sub && () == Add) || (TI()() == FSub && () == FAdd) {
        AddOp = ;
        SubOp = ;
    } else if (FI()() == Sub && () == Add) || (FI()() == FSub && () == FAdd) {
        AddOp = ;
        SubOp = ;
    }
    if AddOp {
        let mut OtherAddOp: *mut Value = null;
        if SubOp.getOperand == AddOp.getOperand {
            OtherAddOp = AddOp.getOperand;
        } else if SubOp.getOperand == AddOp.getOperand {
            OtherAddOp = AddOp.getOperand;
        }
        if OtherAddOp {
            let mut NegVal: *mut Value = null;
            if SI.getType() {
                NegVal = Builder()(SubOp.getOperand);
                if dyn_cast(NegVal) {
                    NegInst;
                } else {
                    let mut Flags: FastMathFlags = AddOp.getFastMathFlags();
                    operator(Flags, SubOp.getFastMathFlags());
                    NegInst.setFastMathFlags(Flags);
                }
            } else {
                NegVal = Builder()(SubOp.getOperand);
            }
            let mut NewTrueOp: *mut Value = OtherAddOp;
            let mut NewFalseOp: *mut Value = NegVal;
            if AddOp !=  {
                swap(NewTrueOp, NewFalseOp);
            }
            let mut NewSel: *mut Value = Builder()(CondVal, NewTrueOp, NewFalseOp, SI.getName + ".p", &mut SI);
            if SI.getType() {
                let mut RI: *mut Instruction = CreateFAdd(SubOp.getOperand, NewSel);
                let mut Flags: FastMathFlags = AddOp.getFastMathFlags();
                operator(Flags, SubOp.getFastMathFlags());
                RI.setFastMathFlags(Flags);
                return RI;
            } else {
                return CreateAdd(SubOp.getOperand, NewSel);
            }
        }
    }
    return null;
}

fn foldOverflowingAddSubSelect(SI: *mut SelectInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut CondVal: *mut Value = SI.getCondition();
    let mut TrueVal: *mut Value = SI.getTrueValue();
    let mut FalseVal: *mut Value = SI.getFalseValue();
    let mut II: *mut WithOverflowInst = null;
    if operator!(match(CondVal, m_ExtractValue())) || operator!(match(FalseVal, m_ExtractValue(m_Specific(II)))) {
        return null;
    }
    let mut X: *mut Value = II.getLHS;
    let mut Y: *mut Value = II.getRHS;
    let mut IsSignedSaturateLimit: Closure_7 = Closure_7 { X: &mut X, Y: &mut Y };
    let mut NewIntrinsicID: ID = zeroed();
    if II.getIntrinsicID == uadd_with_overflow && match(TrueVal) {
        NewIntrinsicID = uadd_sat;
    } else if II.getIntrinsicID == usub_with_overflow && match(TrueVal, m_Zero()) {
        NewIntrinsicID = usub_sat;
    } else if II.getIntrinsicID == sadd_with_overflow && IsSignedSaturateLimit.call(TrueVal, true) {
        NewIntrinsicID = sadd_sat;
    } else if II.getIntrinsicID == ssub_with_overflow && IsSignedSaturateLimit.call(TrueVal, false) {
        NewIntrinsicID = ssub_sat;
    } else {
        return null;
    }
    let mut F: *mut Function = getOrInsertDeclaration(SI, NewIntrinsicID, SI.getType);
    return Create(F, void { X, Y });
}

fn InstCombinerImpl::foldSelectExtConst(self, Sel: *mut SelectInst) -> *mut Instruction {
    let mut C: *mut Constant = null;
    if operator!(match(Sel.getTrueValue())) && operator!(match(Sel.getFalseValue())) {
        return null;
    }
    let mut ExtInst: *mut Instruction = null;
    if operator!(match(Sel.getTrueValue(), m_Instruction(ExtInst))) && operator!(match(Sel.getFalseValue(), m_Instruction(ExtInst))) {
        return null;
    }
    let mut ExtOpcode: u32 = ExtInst.getOpcode();
    if ExtOpcode != ZExt && ExtOpcode != SExt {
        return null;
    }
    let mut X: *mut Value = ExtInst.getOperand;
    let mut SmallType: *mut Type = X.getType();
    let mut Cond: *mut Value = Sel.getCondition();
    if !SmallType.isIntOrIntVectorTy(1) && (!isa(Cond) || cast(Cond)(0)() != SmallType) {
        return null;
    }
    let mut SelType: *mut Type = Sel.getType;
    let mut TruncC: *mut Constant = getLosslessInvCast(C, SmallType, ExtOpcode);
    if TruncC && ExtInst.hasOneUse {
        let mut TruncCVal: *mut Value = cast(TruncC);
        if ExtInst(Sel.getFalseValue()) {
            swap(X, TruncCVal);
        }
        let mut NewSel: *mut Value = null;
        return Create(ExtOpcode, NewSel, SelType, "", null);
    }
    return null;
}

fn canonicalizeSelectToShuffle(SI: *mut SelectInst) -> *mut Instruction {
    let mut CondVal: *mut Value = SI.getCondition();
    let mut CondC: *mut Constant = null;
    let mut CondValTy: *mut auto = dyn_cast(CondVal.getType());
    if operator!() || operator!(match(CondVal)) {
        return null;
    }
    let mut NumElts: u32 = ();
    let mut Mask: SmallVector<int, 16> = zeroed();
    Mask()(NumElts);
    for let mut i: u32 = 0; i != NumElts; i += 1 {
        let mut Elt: *mut Constant = CondC.getAggregateElement(i);
        if !Elt {
            return null;
        }
        if Elt.isOneValue() {
            Mask()(i);
        } else if Elt.isNullValue() {
            Mask()(i + NumElts);
        } else if isa(Elt) {
            return null;
        } else {
            return null;
        }
    }
    return SI.getTrueValue();
}

fn canonicalizeScalarSelectOfVecs(Sel: *mut SelectInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut Ty: *mut auto = dyn_cast(Sel.getType);
    if operator!() {
        return null;
    }
    let mut Cond: *mut Value = Sel.getCondition();
    if operator!(match(Cond, m_OneUse(m_ExtractElt(m_Value(), m_ConstantInt())))) {
        return null;
    }
    return IC.replaceOperand(Sel, 0, IC()(Cond));
}

fn foldSelectCmpBitcasts(Sel: *mut SelectInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Cond: *mut Value = Sel.getCondition();
    let mut TVal: *mut Value = Sel.getTrueValue();
    let mut FVal: *mut Value = Sel.getFalseValue();
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    if operator!(match(Cond, m_Cmp(Pred, m_Value(A), m_Value(B)))) {
        return null;
    }
    if TVal == A || TVal == B || FVal == A || FVal == B {
        return null;
    }
    let mut C: *mut Value = null;
    let mut D: *mut Value = null;
    if operator!(match(A, m_BitCast(m_Value(C)))) || operator!(match(B, m_BitCast(m_Value(D)))) {
        return null;
    }
    let mut TSrc: *mut Value = null;
    let mut FSrc: *mut Value = null;
    if operator!(match(TVal, m_BitCast(m_Value(TSrc)))) || operator!(match(FVal, m_BitCast(m_Value(FSrc)))) {
        return null;
    }
    let mut NewSel: *mut Value = null;
    if TSrc == C && FSrc == D {
        NewSel = Builder()(Cond, A, B, "", &mut Sel);
    } else if TSrc == D && FSrc == C {
        NewSel = Builder()(Cond, B, A, "", &mut Sel);
    } else {
        return null;
    }
    return NewSel;
}

fn foldSelectCmpXchg(SI: *mut SelectInst) -> *mut Value {
    let mut isExtractFromCmpXchg: Closure_10 = Closure_10 {};
    let mut isCompareSameAsValue: Closure_11 = Closure_11 {};
    if SI.hasOneUse {
        if  {
            if Select()() == SI.getCondition() {
                if Select()() == SI.getTrueValue() || () == SI.getFalseValue() {
                    return null;
                }
            }
        }
    }
    let mut CmpXchg: *mut AtomicCmpXchgInst = isExtractFromCmpXchg.call(SI.getCondition(), 1);
    if !CmpXchg {
        return null;
    }
    if isExtractFromCmpXchg.call(SI.getTrueValue(), 0) {
        X;
    } else if X == CmpXchg && isCompareSameAsValue(X.getCompareOperand(), SI.getFalseValue()) {
        return SI.getFalseValue();
    }
    if isExtractFromCmpXchg.call(SI.getFalseValue(), 0) {
        X;
    } else if X == CmpXchg && isCompareSameAsValue(X.getCompareOperand(), SI.getTrueValue()) {
        return SI.getFalseValue();
    }
    return null;
}

fn foldSelectFunnelShift(Sel: *mut SelectInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Width: u32 = Sel.getType();
    if !isPowerOf2_32(Width) {
        return null;
    }
    let mut Or0: *mut BinaryOperator = null;
    let mut Or1: *mut BinaryOperator = null;
    if operator!(match(Sel.getFalseValue(), m_OneUse(m_Or(m_BinOp(Or0), m_BinOp(Or1))))) {
        return null;
    }
    let mut SV0: *mut Value = null;
    let mut SV1: *mut Value = null;
    let mut SA0: *mut Value = null;
    let mut SA1: *mut Value = null;
    if operator!(match(Or0, m_OneUse(m_LogicalShift(m_Value(SV0), m_ZExtOrSelf(m_Value(SA0)))))) || operator!(match(Or1, m_OneUse(m_LogicalShift(m_Value(SV1), m_ZExtOrSelf(m_Value(SA1)))))) || Or0.getOpcode() == Or1.getOpcode() {
        return null;
    }
    if Or0.getOpcode() == LShr {
        swap(Or0, Or1);
        swap(SV0, SV1);
        swap(SA0, SA1);
    }
    assert!(Or0.getOpcode() == Shl && Or1.getOpcode() == LShr, "Illegal or(shift,shift) pair");
    let mut ShAmt: *mut Value = null;
    if match(SA1, m_OneUse(m_Sub(m_Specific(SA0)))) {
        ShAmt = SA0;
    } else if match(SA0, m_OneUse(m_Sub(m_Specific(SA1)))) {
        ShAmt = SA1;
    } else {
        return null;
    }
    let mut IsFshl: bool = (ShAmt == SA0);
    let mut TVal: *mut Value = Sel.getTrueValue();
    if (IsFshl && TVal != SV0) || (!IsFshl && TVal != SV1) {
        return null;
    }
    let mut Cond: *mut Value = Sel.getCondition();
    if operator!(match(Cond, m_OneUse(m_SpecificICmp(ICMP_EQ, m_Specific(ShAmt))))) {
        return null;
    }
    if SV0 != SV1 {
        if IsFshl && !isGuaranteedNotToBePoison(SV1, null, null, null, 0) {
            SV1 = Builder()(SV1);
        } else if !IsFshl && !isGuaranteedNotToBePoison(SV0, null, null, null, 0) {
            SV0 = Builder()(SV0);
        }
    }
    let mut IID: ID = if IsFshl { fshl } else { fshr };
    let mut F: *mut Function = getOrInsertDeclaration(Sel, IID, Sel.getType);
    ShAmt = Builder()(ShAmt, Sel.getType);
    return Create(F, void { SV0, SV1, ShAmt });
}

fn foldSelectToCopysign(Sel: *mut SelectInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Cond: *mut Value = Sel.getCondition();
    let mut TVal: *mut Value = Sel.getTrueValue();
    let mut FVal: *mut Value = Sel.getFalseValue();
    let mut SelType: *mut Type = Sel.getType;
    let mut TC: *APFloat = null;
    let mut FC: *APFloat = null;
    if operator!(match(TVal)) || operator!(match(FVal)) || !if *TC < 0 { -*TC } else { *TC }.bitwiseIsEqual(if *FC < 0 { -*FC } else { *FC }) {
        return null;
    }
    assert!(TC != FC, "Expected equal select arms to simplify");
    let mut X: *mut Value = null;
    let mut C: *APInt = null;
    let mut IsTrueIfSignSet: bool = false;
    let mut Pred: CmpPredicate = CmpPredicate {};
    if operator!(match(Cond, m_OneUse(m_ICmp(Pred, m_ElementWiseBitCast(m_Value(X)))))) || !isSignBitCheck(Pred.operator llvm::CmpInst::Predicate(), *C, IsTrueIfSignSet) || X.getType() != SelType {
        return null;
    }
    if IsTrueIfSignSet ^ TC.isNegative() {
        X = Builder()(X);
    }
    let mut MagArg: *mut Value = get(SelType, if *TC < 0 { -*TC } else { *TC });
    let mut F: *mut Function = getOrInsertDeclaration(Sel, copysign, Sel.getType);
    return Create(F, void { MagArg, X });
}

fn InstCombinerImpl::foldVectorSelect(self, Sel: *mut SelectInst) -> *mut Instruction {
    if operator!(isa(Sel.getType)) {
        return null;
    }
    let mut Cond: *mut Value = Sel.getCondition();
    let mut TVal: *mut Value = Sel.getTrueValue();
    let mut FVal: *mut Value = Sel.getFalseValue();
    let mut C: *mut Value = null;
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(Cond, m_VecReverse(m_Value(C))) {
        let mut createSelReverse: Closure_12 = Closure_12 { cap_0: self, Sel: &mut Sel };
        if match(TVal, m_VecReverse(m_Value(X))) {
            if match(FVal, m_VecReverse(m_Value(Y))) && (Cond.hasOneUse() || TVal.hasOneUse() || FVal.hasOneUse()) {
                return createSelReverse(C, X, Y);
            }
            if (Cond.hasOneUse() || TVal.hasOneUse()) && isSplatValue(FVal, -1, 0) {
                return createSelReverse(C, X, FVal);
            }
        } else if isSplatValue(TVal, -1, 0) && match(FVal, m_VecReverse(m_Value(Y))) && (Cond.hasOneUse() || FVal.hasOneUse()) {
            return createSelReverse(C, TVal, Y);
        }
    }
    let mut VecTy: *mut auto = dyn_cast(Sel.getType);
    if operator!() {
        return null;
    }
    let mut NumElts: u32 = ();
    let mut PoisonElts: APInt = APInt { NumElts, 0, false, false };
    let mut AllOnesEltMask: APInt = getAllOnes(NumElts);
    if self.SimplifyDemandedVectorElts {
        V;
    } else {
        if V(&mut Sel) {
            return self.replaceInstUsesWith;
        }
        return &mut Sel;
    }
    let mut Mask: ArrayRef<int> = zeroed();
    if match(TVal, m_OneUse(m_Shuffle(m_Value(X), m_Value(Y)))) && operator!(is_contained(PoisonMaskElem)) && cast(TVal)() {
        if X == FVal {
            let mut NewSel: *mut Value = null;
            return X;
        }
        if Y == FVal {
            let mut NewSel: *mut Value = null;
            return NewSel;
        }
    }
    if match(FVal, m_OneUse(m_Shuffle(m_Value(X), m_Value(Y)))) && operator!(is_contained(PoisonMaskElem)) && cast(FVal)() {
        if X == TVal {
            let mut NewSel: *mut Value = null;
            return X;
        }
        if Y == TVal {
            let mut NewSel: *mut Value = null;
            return NewSel;
        }
    }
    return null;
}

fn foldSelectToPhiImpl(Sel: *mut SelectInst, BB: *mut BasicBlock, DT: *DominatorTree, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut IDomNode: *mut auto = null;
    if operator!() {
        return null;
    }
    let mut IDom: *mut BasicBlock = ();
    let mut Cond: *mut Value = Sel.getCondition();
    let mut IfTrue: *mut Value = null;
    let mut IfFalse: *mut Value = null;
    let mut TrueSucc: *mut BasicBlock = null;
    let mut FalseSucc: *mut BasicBlock = null;
    if match(IDom.getTerminator(), m_Br(m_Specific(Cond))) {
        IfTrue = Sel.getTrueValue();
        IfFalse = Sel.getFalseValue();
    } else if match(IDom.getTerminator(), m_Br(m_Not(m_Specific(Cond)))) {
        IfTrue = Sel.getFalseValue();
        IfFalse = Sel.getTrueValue();
    } else {
        return null;
    }
    if TrueSucc == FalseSucc {
        return null;
    }
    let mut TrueEdge: BasicBlockEdge = BasicBlockEdge { Start: IDom, End: TrueSucc };
    let mut FalseEdge: BasicBlockEdge = BasicBlockEdge { Start: IDom, End: FalseSucc };
    let mut Inputs: i32 = 0;
    Builder()(BB()());
    let mut PN: *mut auto = Builder()(Sel.getType);
    PN()(&mut Sel);
    return ;
}

fn foldSelectToPhi(Sel: *mut SelectInst, DT: *DominatorTree, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut CandidateBlocks: SmallSetVector<BasicBlock *, 4> = zeroed();
    CandidateBlocks()(Sel()());
    return null;
}

fn foldSelectWithSRem(SI: *mut SelectInst, IC: *mut InstCombinerImpl, Builder: *mut IRBuilderBase) -> *mut Instruction {
    let mut CondVal: *mut Value = SI.getCondition();
    let mut TrueVal: *mut Value = SI.getTrueValue();
    let mut FalseVal: *mut Value = SI.getFalseValue();
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut Op: *mut Value = null;
    let mut RemRes: *mut Value = null;
    let mut Remainder: *mut Value = null;
    let mut C: *APInt = null;
    let mut TrueIfSigned: bool = false;
    if operator!((match(CondVal, m_ICmp(Pred, m_Value(RemRes))) && isSignBitCheck(Pred.operator llvm::CmpInst::Predicate(), *C, TrueIfSigned))) {
        return null;
    }
    if !TrueIfSigned {
        swap(TrueVal, FalseVal);
    }
    let mut FoldToBitwiseAnd: Closure_13 = Closure_13 { Builder: &mut Builder, RemRes: &mut RemRes, Op: &mut Op };
    if match(TrueVal, m_c_Add(m_Specific(RemRes), m_Value(Remainder))) && match(RemRes, m_SRem(m_Value(Op), m_Specific(Remainder))) && IC.isKnownToBeAPowerOfTwo && FalseVal == RemRes {
        return FoldToBitwiseAnd.call(Remainder);
    }
    if match(TrueVal) && match(RemRes, m_SRem(m_Value(Op))) && FalseVal == RemRes {
        return FoldToBitwiseAnd.call(get(RemRes.getType(), 2, false, false));
    }
    return null;
}

fn simplifyNestedSelectsUsingImpliedCond(SI: *mut SelectInst, CondVal: *mut Value, CondIsTrue: bool, DL: *DataLayout) -> *mut Value {
    let mut InnerCondVal: *mut Value = SI.getCondition();
    let mut InnerTrueVal: *mut Value = SI.getTrueValue();
    let mut InnerFalseVal: *mut Value = SI.getFalseValue();
    assert!(CondVal.getType() == InnerCondVal.getType(), "The type of inner condition must match with the outer.");
    if  {
        return if operator*() { InnerTrueVal } else { InnerFalseVal };
    }
    return null;
}

fn InstCombinerImpl::foldAndOrOfSelectUsingImpliedCond(self, Op: *mut Value, SI: *mut SelectInst, IsAnd: bool) -> *mut Instruction {
    assert!(Op.getType().isIntOrIntVectorTy(1), "Op must be either i1 or vector of i1.");
    if SI.getCondition().getType() != Op.getType() {
        return null;
    }
    if simplifyNestedSelectsUsingImpliedCond(SI, Op, IsAnd) {
        V;
    } else {
        return self.createSelectInstWithUnknownProfile(Op, if IsAnd { V } else { getTrue(Op.getType()) }, if IsAnd { getFalse(Op.getType()) } else { V }, "", null);
    }
    return null;
}

fn foldSelectWithFCmpToFabs(SI: *mut SelectInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut CondVal: *mut Value = SI.getCondition();
    let mut ChangedFMF: bool = false;
    return if ChangedFMF { &mut SI } else { null };
