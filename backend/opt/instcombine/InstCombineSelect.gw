            }
            if Op == (*self.X) && Pred == ICMP_SGT && IsZeroOrOne.call(*C + 2) && IsMinMax.call(FalseVal, TrueVal) {
                return true;
            }
            if Op == (*self.Y) && Pred == ICMP_SLT && IsZeroOrOne.call(*C) && IsMinMax.call(FalseVal, TrueVal) {
                return true;
            }
            if Op == (*self.Y) && Pred == ICMP_SGT && IsZeroOrOne.call(*C + 1) && IsMinMax.call(TrueVal, FalseVal) {
                return true;
            }
        }
        return false;
    }

struct Closure_11 {}

fn Closure_11::call(self: *mut Closure_11, V: *mut Value, I: u32) -> auto {
        let mut BI: *mut BitCastInst = dyn_cast(V);
        if BI && I == 0 {
            V = BI.getOperand(0);
        }
        let mut Extract: *mut ExtractValueInst = dyn_cast(V);
        if !Extract {
            return null;
        }
        if Extract.getIndices()[0] != I {
            return null;
        }
        return dyn_cast(Extract.getAggregateOperand());
    }

struct Closure_12 {}

fn Closure_12::call(self: *Closure_12, CmpVal: *mut Value, SelVal: *mut Value) -> bool {
        if CmpVal == SelVal || match(CmpVal, m_BitCast(m_Specific(SelVal))) {
            return true;
        }
        let mut IntC: *mut ConstantInt = dyn_cast(CmpVal);
        let mut FpC: *mut ConstantFP = dyn_cast(SelVal);
        return IntC && FpC && IntC.getValue() == FpC.getValue().bitcastToAPInt();
    }

struct Closure_13 {
    cap_0: *mut InstCombinerImpl,
    Sel: *mut SelectInst,
}

unsafe fn Closure_13::call(self: *mut Closure_13, C: *mut Value, X: *mut Value, Y: *mut Value) -> *mut CallInst {
            let mut V: *mut Value = self.Builder.CreateSelect(C, X, Y, (*self.Sel).getName(), &mut (*self.Sel));
            if dyn_cast(V) {
                I;
            } else {
                I.copyIRFlags(&mut (*self.Sel), true);
            }
            let mut M: *mut Module = (*self.Sel).getModule();
            let mut F: *mut Function = getOrInsertDeclaration(M, vector_reverse, V.getType());
            return Create(F, V, ArrayRef<OperandBundleDef> {}, "", null);
        }

struct Closure_14 {
    Builder: *mut IRBuilderBase,
    RemRes: *mut *mut Value,
    Op: *mut *mut Value,
}

unsafe fn Closure_14::call(self: *mut Closure_14, Remainder: *mut Value) -> auto {
        let mut Add: *mut Value = (*self.Builder).CreateAdd(Remainder, getAllOnesValue((*self.RemRes).getType()), "", false, false);
        return CreateAnd((*self.Op), Add, "");
    }

struct Closure_15 {
    FAbsI: *mut *mut Instruction,
    InnerSel: *mut *mut Value,
}

unsafe fn Closure_15::call(self: *mut Closure_15, V: *mut Value) -> bool {
        return match(V, m_OneUse(m_Instruction((*self.FAbsI), m_FAbs(m_Specific((*self.InnerSel))))));
    }

struct Closure_16 {
    cap_0: DecomposedSelect,
    IsAndVariant: bool,
    AltCond: *mut *mut Value,
}

unsafe fn Closure_16::call(self: *mut Closure_16) {
        return if self.IsAndVariant { match(OuterSel.Cond, m_c_LogicalAnd(m_InnerCond, m_Value((*self.AltCond)))) } else { match(OuterSel.Cond, m_c_LogicalOr(m_InnerCond, m_Value((*self.AltCond)))) };
    }

struct Closure_17 {
    cap_0: *mut InstCombinerImpl,
    One: *mut *mut Constant,
    FalseLogicAnd: *mut bool,
    CondLogicAnd: *mut bool,
    A: *mut *mut Value,
    Zero: *mut *mut Constant,
}

unsafe fn Closure_17::call(self: *mut Closure_17, Common: *mut Value, InnerCond: *mut Value, InnerVal: *mut Value, SelFirst: bool) -> auto {
                let mut InnerSel: *mut Value = self.Builder.CreateSelectWithUnknownProfile(InnerCond, (*self.One), InnerVal, "instcombine", "");
                if SelFirst {
                    swap(Common, InnerSel);
                }
                if (*self.FalseLogicAnd) || ((*self.CondLogicAnd) && Common == (*self.A)) {
                    return self.createSelectInstWithUnknownProfile(Common, InnerSel, (*self.Zero), "", null);
                } else {
                    return CreateAnd(Common, InnerSel, "");
                }
            }

struct Closure_18 {
    cap_0: *mut InstCombinerImpl,
    Zero: *mut *mut Constant,
    TrueLogicOr: *mut bool,
    CondLogicOr: *mut bool,
    A: *mut *mut Value,
    One: *mut *mut Constant,
}

unsafe fn Closure_18::call(self: *mut Closure_18, Common: *mut Value, InnerCond: *mut Value, InnerVal: *mut Value, SelFirst: bool) -> auto {
                let mut InnerSel: *mut Value = self.Builder.CreateSelectWithUnknownProfile(InnerCond, InnerVal, (*self.Zero), "instcombine", "");
                if SelFirst {
                    swap(Common, InnerSel);
                }
                if (*self.TrueLogicOr) || ((*self.CondLogicOr) && Common == (*self.A)) {
                    return self.createSelectInstWithUnknownProfile(Common, (*self.One), InnerSel, "", null);
                } else {
                    return CreateOr(Common, InnerSel, "");
                }
            }

struct Closure_19 {
    CtlzOp: *mut *mut Value,
    ShouldDropNoWrap: *mut bool,
    CR: *mut ConstantRange,
}

unsafe fn Closure_19::call(self: *mut Closure_19, CommonAncestor: *mut Value) -> bool {
        let mut C: *APInt = null;
        if (*self.CtlzOp) == CommonAncestor {
            return true;
        }
        if match((*self.CtlzOp), m_Add(m_Specific(CommonAncestor), m_APInt(C))) {
            (*self.ShouldDropNoWrap) = true;
            (*self.CR) = (*self.CR).add(*C);
            return true;
        }
        if match((*self.CtlzOp), m_Sub(m_APInt(C), m_Specific(CommonAncestor))) {
            (*self.ShouldDropNoWrap) = true;
            (*self.CR) = *C.sub((*self.CR));
            return true;
        }
        if match((*self.CtlzOp), m_Not(m_Specific(CommonAncestor))) {
            (*self.CR) = (*self.CR).binaryNot();
            return true;
        }
        return false;
    }

struct Closure_20 {}

fn Closure_20::call(self: *Closure_20, arg: *mut CallInst) {}

struct Closure_21 {
    Affected: *mut SmallPtrSetImpl<Value *>,
    Depth: *mut u32,
}

unsafe fn Closure_21::call(self: *mut Closure_21, Op: *mut Value) -> bool {
            return Op.getType().isIntOrIntVectorTy() && hasAffectedValue(Op, (*self.Affected), (*self.Depth) + 1);
        }

struct Closure_22 {
    Builder: *mut BuilderTy,
    SI: *mut SelectInst,
}

unsafe fn Closure_22::call(self: *mut Closure_22, Pred: Predicate, X: *mut Value, Z: *mut Value, FAdd: *mut Instruction, C: *mut Constant, Swapped: bool) -> auto {
        if !isRelational(Pred) || !match(Z, m_AnyZeroFP()) {
            return null;
        }
        if !match(FAdd, m_FAdd(m_Specific(X), m_Specific(C))) {
            return null;
        }
        let mut NewSelect: *mut Value = (*self.Builder).CreateSelect((*self.SI).getCondition(), if Swapped { Z } else { X }, if Swapped { X } else { Z }, "", &mut (*self.SI));
        NewSelect.takeName(&mut (*self.SI));
        let mut NewFAdd: *mut Value = (*self.Builder).CreateFAdd(NewSelect, C, "", null);
        NewFAdd.takeName(FAdd);
        let mut SelectFMF: FastMathFlags = (*self.SI).getFastMathFlags();
        let mut FAddFMF: FastMathFlags = FAdd.getFastMathFlags();
        let mut NewFMF: FastMathFlags = intersectRewrite(SelectFMF, FAddFMF) | unionValue(SelectFMF, FAddFMF);
        cast(NewFAdd).setFastMathFlags(NewFMF);
        cast(NewSelect).setFastMathFlags(NewFMF);
        return NewFAdd;
    }

struct Closure_23 {}

fn Closure_23::call(self: *mut Closure_23, Neg: *mut Value, Not: *mut Value, X: *mut *mut Value) -> auto {
        return match(Neg, m_OneUse(m_Neg(m_Value(X)))) && match(Not, m_OneUse(m_Not(m_Specific(X))));
    }

struct Closure_24 {
    CondVal: *mut *mut Value,
    cap_1: *mut InstCombinerImpl,
    SI: *mut SelectInst,
}

unsafe fn Closure_24::call(self: *mut Closure_24, Gep: *mut GetElementPtrInst, Base: *mut Value, Swap: bool) -> auto {
        let mut Ptr: *mut Value = Gep.getPointerOperand();
        if Gep.getNumOperands() != 2 || Gep.getPointerOperand() != Base || !Gep.hasOneUse() {
            return null;
        }
        let mut Idx: *mut Value = Gep.getOperand(1);
        if isa((*self.CondVal).getType()) && !isa(Idx.getType()) {
            return null;
        }
        let mut ElementType: *mut Type = Gep.getSourceElementType();
        let mut NewT: *mut Value = Idx;
        let mut NewF: *mut Value = getNullValue(Idx.getType());
        if Swap {
            swap(NewT, NewF);
        }
        let mut NewSI: *mut Value = self.Builder.CreateSelect((*self.CondVal), NewT, NewF, (*self.SI).getName() + ".idx", &mut (*self.SI));
        return Create(ElementType, Ptr, NewSI, Gep.getNoWrapFlags(), "", null);
    }

struct Closure_25 {
    TrueVal: *mut *mut Value,
    FalseVal: *mut *mut Value,
    FMF: *mut FastMathFlags,
    cap_3: *mut InstCombinerImpl,
    SI: *mut SelectInst,
    CondVal: *mut *mut Value,
    SelType: *mut *mut Type,
}

unsafe fn Closure_25::call(self: *mut Closure_25, IsAnd: bool, A: *mut Value, B: *mut Value) -> auto {
        if simplifySelectInst(B, (*self.TrueVal), (*self.FalseVal), (*self.FMF), self.SQ.getWithInstruction(&mut (*self.SI))) {
            V;
        } else {
            let mut NewTrueVal: *mut Value = if IsAnd { V } else { (*self.TrueVal) };
            let mut NewFalseVal: *mut Value = if IsAnd { (*self.FalseVal) } else { V };
            let mut MDFrom: *mut Instruction = null;
            if NewTrueVal == (*self.TrueVal) && NewFalseVal == (*self.FalseVal) {
                MDFrom = &mut (*self.SI);
            }
            return Create(A, NewTrueVal, NewFalseVal, "", null, MDFrom);
        }
        if (*self.CondVal).hasOneUse() && (*self.SelType).isIntOrIntVectorTy() {
            if dyn_cast(B) {
                Cmp;
            } else if canonicalizeSPF(*Cmp, (*self.TrueVal), (*self.FalseVal), *self) {
                V;
            } else {
                return Create(A, if IsAnd { V } else { (*self.TrueVal) }, if IsAnd { (*self.FalseVal) } else { V }, "", null, if ProfcheckDisableMetadataFixes { null } else { &mut (*self.SI) });
            }
        }
        return null;
    }

struct Closure_26 {
    CC: *mut CondContext,
}

unsafe fn Closure_26::call(self: *mut Closure_26, V: *mut Value) {
            (*self.CC).AffectedValues.insert(V);
        }
