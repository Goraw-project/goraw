static mut NumDeadStore: Statistic = Statistic { "instcombine", "NumDeadStore", "Number of dead stores eliminated" };

static mut NumGlobalCopies: Statistic = Statistic { "instcombine", "NumGlobalCopies", "Number of allocas copied from constant global" };

fn isOnlyCopiedFromConstantMemory(AA: *mut AAResults, V: *mut AllocaInst, TheCopy: *mut *mut MemTransferInst, ToDelete: *mut SmallVectorImpl<Instruction *>, MaxUsers: u32) -> bool {
    let mut Worklist: SmallVector<ValueAndIsOffset, 32> = SmallVector<ValueAndIsOffset, 32> {};
    let mut Visited: SmallPtrSet<ValueAndIsOffset, 32> = SmallPtrSet<ValueAndIsOffset, 32> {};
    Worklist.push(V, false);
    while !Worklist.is_empty() {
        let mut Elem: ValueAndIsOffset = Worklist.pop_back_val();
        if !Visited.insert(Elem).second {
            continue;
        }
        if Visited.len > MaxUsers {
            return false;
        }
        for U in Value.uses() {
            let mut I: *mut Instruction = cast(U.getUser());
            if dyn_cast(I) {
                LI;
            } else {
                if !LI.isSimple() {
                    return false;
                }
                continue;
            }
            if isa(I) {
                Worklist.push(I, true);
                continue;
            }
            if isa(I) {
                Worklist.push(I, IsOffset);
                continue;
            }
            if dyn_cast(I) {
                GEP;
            } else {
                Worklist.push(I, IsOffset || !GEP.hasAllZeroIndices());
                continue;
            }
            if dyn_cast(I) {
                Call;
            } else {
                if Call.isCallee(&mut U) {
                    continue;
                }
                let mut DataOpNo: u32 = Call.getDataOperandNo(&mut U);
                let mut IsArgOperand: bool = Call.isArgOperand(&mut U);
                if IsArgOperand && Call.isInAllocaArgument(DataOpNo) {
                    return false;
                }
                let mut NoCapture: bool = Call.doesNotCapture(DataOpNo);
                if NoCapture && (Call.onlyReadsMemory() || Call.onlyReadsMemory(DataOpNo)) {
                    continue;
                }
            }
            if I.isLifetimeStartOrEnd() {
                assert!(I.use_empty(), "Lifetime markers have no result to use!");
                ToDelete.push(I);
                continue;
            }
            let mut MI: *mut MemTransferInst = dyn_cast(I);
            if !MI {
                return false;
            }
            if MI.isVolatile() {
                return false;
            }
            if U.getOperandNo() == 1 {
                continue;
            }
            if TheCopy {
                return false;
            }
            if IsOffset {
                return false;
            }
            if U.getOperandNo() != 0 {
                return false;
            }
            if isModSet(AA.getModRefInfoMask(MI.getSource(), false)) {
                return false;
            }
            TheCopy = MI;
        }
    }
    return true;
}

fn isOnlyCopiedFromConstantMemory(AA: *mut AAResults, AI: *mut AllocaInst, ToDelete: *mut SmallVectorImpl<Instruction *>, MaxUsers: u32) -> *mut MemTransferInst {
    let mut TheCopy: *mut MemTransferInst = null;
    if isOnlyCopiedFromConstantMemory(AA, AI, TheCopy, ToDelete, MaxUsers) {
        return TheCopy;
    }
    return null;
}

fn isDereferenceableForAllocaSize(V: *Value, AI: *AllocaInst, DL: *DataLayout) -> bool {
    let mut AllocaSize: optional<TypeSize> = AI.getAllocationSize(DL);
    if !AllocaSize || operator(AllocaSize).isScalable() {
        return false;
    }
    return isDereferenceableAndAlignedPointer(V, AI.getAlign(), APInt { 64, operator(AllocaSize).operator unsigned long long(), false, false }, SimplifyQuery { DL, null }, false);
}

fn simplifyAllocaArraySize(IC: *mut InstCombinerImpl, AI: *mut AllocaInst, DT: *mut DominatorTree) -> *mut Instruction {
    if !AI.isArrayAllocation() {
        if AI.getArraySize().getType().isIntegerTy(32) {
            return null;
        }
        return IC.replaceOperand(AI, 0, IC.Builder.getInt32(1));
    }
    if dyn_cast(AI.getArraySize()) {
        C;
    } else {
        if C.getValue().getActiveBits() <= 64 {
            let mut NewTy: *mut Type = get(AI.getAllocatedType(), C.getZExtValue());
            let mut New: *mut AllocaInst = IC.Builder.CreateAlloca(NewTy, AI.getAddressSpace(), null, AI.getName());
            New.setAlignment(AI.getAlign());
            New.setUsedWithInAlloca(AI.isUsedWithInAlloca());
            replaceAllDbgUsesWith(AI, *New, *New, DT);
            return IC.replaceInstUsesWith(AI, New);
        }
    }
    if isa(AI.getArraySize()) {
        return IC.replaceInstUsesWith(AI, get(AI.getType()));
    }
    let mut PtrIdxTy: *mut Type = IC.getDataLayout().getIndexType(AI.getType());
    if AI.getArraySize().getType() != PtrIdxTy {
        let mut V: *mut Value = IC.Builder.CreateIntCast(AI.getArraySize(), PtrIdxTy, false, "");
        return IC.replaceOperand(AI, 0, V);
    }
    return null;
}

struct PointerReplacer {
    UsersToReplace: SmallSetVector<Instruction *, 32>,
    WorkMap: DenseMap<Value *, Value *>,
    IC: *mut InstCombinerImpl,
    Root: *mut Instruction,
    FromAS: u32,
}

fn PointerReplacer::getReplacement(self: *PointerReplacer, V: *mut Value) -> *mut Value {
    return self.WorkMap.lookup(V);
}

fn PointerReplacer::isAvailable(self: *PointerReplacer, I: *mut Instruction) -> bool {
    return I == &mut self.Root || self.UsersToReplace.contains(I);
}

fn PointerReplacer::isEqualOrValidAddrSpaceCast(self: *PointerReplacer, I: *Instruction, FromAS: u32) -> bool {
    let mut ASC: *AddrSpaceCastInst const = dyn_cast(I);
    if !ASC {
        return false;
    }
    let mut ToAS: u32 = ASC.getDestAddressSpace();
    return (FromAS == ToAS) || self.IC.isValidAddrSpaceCast(FromAS, ToAS);
}

fn PointerReplacer::collectUsers(self) -> bool {
    let mut Worklist: SmallVector<Instruction *> = SmallVector<Instruction *> {};
    let mut ValuesToRevisit: SmallSetVector<Instruction *, 32> = SmallSetVector<Instruction *, 32> {};
    let mut PushUsersToWorklist: Closure_1 = Closure_1 { cap_0: self, ValuesToRevisit: &mut ValuesToRevisit, Worklist: &mut Worklist };
    let mut TryPushInstOperand: Closure_2 = Closure_2 { cap_0: self, ValuesToRevisit: &mut ValuesToRevisit, Worklist: &mut Worklist };
    PushUsersToWorklist.call(&mut self.Root);
    while !Worklist.is_empty() {
        let mut Inst: *mut Instruction = Worklist.pop_back_val();
        if dyn_cast(Inst) {
            Load;
        } else {
            if Load.isVolatile() {
                return false;
            }
            self.UsersToReplace.insert(Load);
        }
    }
    return true;
}

fn PointerReplacer::replacePointer(self, V: *mut Value) {
    assert!(cast(self.Root.getType()) != cast(V.getType()), "Invalid usage");
    self.WorkMap[&mut self.Root] = V;
    let mut Worklist: SmallVector<Instruction *> = SmallVector<Instruction *> {};
    let mut PostOrderWorklist: SetVector<Instruction *> = SetVector<Instruction *> {};
    let mut Visited: SmallPtrSet<Instruction *, 32> = SmallPtrSet<Instruction *, 32> {};
    Worklist.push(&mut self.Root);
    while !Worklist.is_empty() {
        let mut I: *mut Instruction = Worklist.back();
        if Visited.insert(I).second {
            for U in I.users() {
                let mut UserInst: *mut Instruction = cast(U);
                if self.UsersToReplace.contains(UserInst) && !Visited.contains(UserInst) {
                    Worklist.push(UserInst);
                }
            }
        } else {
            PostOrderWorklist.insert(I);
            Worklist.pop();
        }
    }
    for I in reverse(PostOrderWorklist) {
        self.replace(I);
    }
}

fn PointerReplacer::replace(self, I: *mut Instruction) {
    if self.getReplacement(I) {
        return;
    }
    if dyn_cast(I) {
        LT;
    } else {
        let mut V: *mut Value = self.getReplacement(LT.getPointerOperand());
        assert!(V, "Operand not replaced");
        let mut NewI: *mut LoadInst = LoadInst { LT.getType(), V, "", LT.getProperties(), null };
        NewI.takeName(LT);
        NewI.copyMetadata(*LT, ArrayRef<unsigned int> {});
        self.IC.InsertNewInstWith(NewI, LT.getIterator());
        self.IC.replaceInstUsesWith(*LT, NewI);
        self.WorkMap[NewI] = NewI;
    }
}

fn InstCombinerImpl::visitAllocaInst(self, AI: *mut AllocaInst) -> *mut Instruction {
    if simplifyAllocaArraySize(*self, AI, self.DT) {
        I;
    } else {
        return I;
    }
    let mut Size: optional<TypeSize> = AI.getAllocationSize(self.DL);
    if Size && operator(Size).isZero() {
        if AI.isArrayAllocation() {
            return self.replaceOperand(AI, 0, get(AI.getArraySize().getType(), 1, false, false));
        }
        let mut EntryBlock: *mut BasicBlock = AI.getParent().getParent().getEntryBlock();
        let mut FirstInst: iterator = EntryBlock.getFirstNonPHIOrDbg(true);
        if &mut operator(FirstInst) != &mut AI {
            let mut EntryAI: *mut AllocaInst = dyn_cast(FirstInst);
            let mut EntryAISize: optional<TypeSize> = if EntryAI { EntryAI.getAllocationSize(self.DL) } else { nullopt };
            if !EntryAISize || !operator(EntryAISize).isZero() {
                AI.moveBefore(FirstInst);
                return &mut AI;
            }
            let mut MaxAlign: Align = if EntryAI.getAlign() > AI.getAlign() { EntryAI.getAlign() } else { AI.getAlign() };
            EntryAI.setAlignment(MaxAlign);
            return self.replaceInstUsesWith(AI, EntryAI);
        }
    }
    let mut ToDelete: SmallVector<Instruction *, 4> = SmallVector<Instruction *, 4> {};
    if isOnlyCopiedFromConstantMemory(self.AA, &mut AI, ToDelete, self.CLOpts.max_copied_from_constant_users) {
        Copy;
    } else {
        let mut TheSrc: *mut Value = Copy.getSource();
        let mut AllocaAlign: Align = AI.getAlign();
        let mut SourceAlign: Align = getOrEnforceKnownAlignment(TheSrc, AllocaAlign, self.DL, &mut AI, &mut self.AC, &mut self.DT);
        if AllocaAlign <= SourceAlign && isDereferenceableForAllocaSize(TheSrc, &mut AI, self.DL) && !isa(TheSrc) {
            while true {
                {
                if DebugFlag && isCurrentDebugType("instcombine", 1) {
                    dbgs() << "Found alloca equal to global: " << AI << 10;
                }
            }
                if !(false) { break; }
            }
            while true {
                {
                if DebugFlag && isCurrentDebugType("instcombine", 1) {
                    dbgs() << "  memcpy = " << *Copy << 10;
                }
            }
                if !(false) { break; }
            }
            let mut SrcAddrSpace: u32 = TheSrc.getType().getPointerAddressSpace();
            if AI.getAddressSpace() == SrcAddrSpace {
                for Delete in ToDelete {
                    self.eraseInstFromFunction(*Delete);
                }
                let mut NewI: *mut Instruction = self.replaceInstUsesWith(AI, TheSrc);
                self.eraseInstFromFunction(*Copy);
                operator(NumGlobalCopies);
                return NewI;
            }
            let mut PtrReplacer: PointerReplacer = PointerReplacer { *self, AI, SrcAddrSpace };
            if PtrReplacer.collectUsers() {
                for Delete in ToDelete {
                    self.eraseInstFromFunction(*Delete);
                }
                PtrReplacer.replacePointer(TheSrc);
                operator(NumGlobalCopies);
            }
        }
    }
    return self.visitAllocSite(AI);
}

fn isSupportedAtomicType(Ty: *mut Type) -> bool {
    return Ty.isIntOrPtrTy() || Ty.isFloatingPointTy();
}

fn InstCombinerImpl::combineLoadToNewType(self, LI: *mut LoadInst, NewTy: *mut Type, Suffix: str) -> *mut LoadInst {
    assert!((!LI.isAtomic() || isSupportedAtomicType(NewTy)), "can't fold an atomic load to requested type");
    let mut NewLoad: *mut LoadInst = self.Builder.CreateLoad(NewTy, LI.getPointerOperand(), LI.getProperties(), LI.getName() + Suffix);
    copyMetadataForLoad(*NewLoad, LI);
    return NewLoad;
}

fn combineStoreToNewValue(IC: *mut InstCombinerImpl, SI: *mut StoreInst, V: *mut Value) -> *mut StoreInst {
    assert!((!SI.isAtomic() || isSupportedAtomicType(V.getType())), "can't fold an atomic store of requested type");
    let mut Ptr: *mut Value = SI.getPointerOperand();
    let mut MD: pair<unsigned int, MDNode *>, 8> = pair<unsigned int, MDNode *>, 8> {};
    SI.getAllMetadata(MD);
    let mut NewStore: *mut StoreInst = IC.Builder.CreateStore(V, Ptr, SI.getProperties());
    for MDPair in MD {
        let mut ID: u32 = MDPair.first;
        let mut N: *mut MDNode = MDPair.second;
        match ID {
            MD_dbg => {
                MD_DIAssignID;
            },
            MD_invariant_load => {
                MD_nonnull;
            },
        }
    }
    return NewStore;
}

fn combineLoadToOperationType(IC: *mut InstCombinerImpl, Load: *mut LoadInst) -> *mut Instruction {
    if !Load.isUnordered() {
        return null;
    }
    if Load.isElementwise() {
        return null;
    }
    if Load.use_empty() {
        return null;
    }
    if Load.getPointerOperand().isSwiftError() {
        return null;
    }
    if Load.hasOneUse() {
        let mut LoadTy: *mut Type = Load.getType();
        if dyn_cast(Load.user_back()) {
            BC;
        } else {
            assert!(!LoadTy.isX86_AMXTy(), "Load from x86_amx* should not happen!");
            if BC.getType().isX86_AMXTy() {
                return null;
            }
        }
        if dyn_cast(Load.user_back()) {
            CastUser;
        } else {
            let mut DestTy: *mut Type = CastUser.getDestTy();
            if CastUser.isNoopCast(IC.getDataLayout()) && LoadTy.isPtrOrPtrVectorTy() == DestTy.isPtrOrPtrVectorTy() && (!Load.isAtomic() || isSupportedAtomicType(DestTy)) {
                let mut NewLoad: *mut LoadInst = IC.combineLoadToNewType(Load, DestTy, "");
                CastUser.replaceAllUsesWith(NewLoad);
                IC.eraseInstFromFunction(*CastUser);
                return &mut Load;
            }
        }
    }
    return null;
}

fn unpackLoadToAggregate(IC: *mut InstCombinerImpl, LI: *mut LoadInst) -> *mut Instruction {
    if !LI.isSimple() {
        return null;
    }
    let mut T: *mut Type = LI.getType();
    if !T.isAggregateType() {
        return null;
    }
    let mut Name: str = LI.getName();
    if dyn_cast(T) {
        ST;
    } else {
        let mut NumElements: u32 = ST.getNumElements();
        if NumElements == 1 {
            let mut NewLoad: *mut LoadInst = IC.combineLoadToNewType(LI, ST.getTypeAtIndex(0), ".unpack");
            NewLoad.setAAMetadata(LI.getAAMetadata());
            NewLoad.copyMetadata(LI, MD_invariant_load);
            return IC.replaceInstUsesWith(LI, IC.Builder.CreateInsertValue(get(T), NewLoad, 0, Name));
        }
        let mut DL: *DataLayout = IC.getDataLayout();
        let mut SL: *StructLayout = DL.getStructLayout(ST);
        if SL.hasPadding() {
            return null;
        }
        let mut Align: Align = LI.getAlign();
        let mut Addr: *mut Value = LI.getPointerOperand();
        let mut IdxType: *mut Type = DL.getIndexType(Addr.getType());
        let mut V: *mut Value = get(T);
        for let mut i: u32 = 0; i < NumElements; i += 1 {
            let mut Ptr: *mut Value = IC.Builder.CreateInBoundsPtrAdd(Addr, IC.Builder.CreateTypeSize(IdxType, SL.getElementOffset(i)), Name + ".elt");
            let mut L: *mut LoadInst = IC.Builder.CreateAlignedLoad(ST.getElementType(i), Ptr, commonAlignment(Align, SL.getElementOffset(i).getKnownMinValue()), Name + ".unpack");
            L.setAAMetadata(LI.getAAMetadata());
            L.copyMetadata(LI, MD_invariant_load);
            V = IC.Builder.CreateInsertValue(V, L, i, "");
        }
        V.setName(Name);
        return IC.replaceInstUsesWith(LI, V);
    }
    if dyn_cast(T) {
        AT;
    } else {
        let mut ET: *mut Type = AT.getElementType();
        let mut NumElements: u64 = AT.getNumElements();
        if NumElements == 1 {
            let mut NewLoad: *mut LoadInst = IC.combineLoadToNewType(LI, ET, ".unpack");
            NewLoad.setAAMetadata(LI.getAAMetadata());
            return IC.replaceInstUsesWith(LI, IC.Builder.CreateInsertValue(get(T), NewLoad, 0, Name));
        }
        if NumElements > IC.CLOpts.maxarray_size {
            return null;
        }
        let mut DL: *DataLayout = IC.getDataLayout();
        let mut EltSize: TypeSize = DL.getTypeAllocSize(ET);
        let mut Align: Align = LI.getAlign();
        let mut Addr: *mut Value = LI.getPointerOperand();
        let mut IdxType: *mut IntegerType = getInt64Ty(T.getContext());
        let mut Zero: *mut ConstantInt = get(IdxType, 0, false, false);
        let mut V: *mut Value = get(T);
        let mut Offset: TypeSize = getZero();
        for let mut i: u64 = 0; i < NumElements; i += 1 {
            let mut Indices: [2]*mut Value = [Zero, get(IdxType, i, false, false)];
            let mut Ptr: *mut Value = IC.Builder.CreateInBoundsGEP(AT, Addr, Indices, Name + ".elt");
            let mut EltAlign: Align = commonAlignment(Align, Offset.getKnownMinValue());
            let mut L: *mut LoadInst = IC.Builder.CreateAlignedLoad(AT.getElementType(), Ptr, EltAlign, Name + ".unpack");
            L.setAAMetadata(LI.getAAMetadata());
            V = IC.Builder.CreateInsertValue(V, L, i, "");
            operator(Offset, EltSize);
        }
        V.setName(Name);
        return IC.replaceInstUsesWith(LI, V);
    }
    return null;
}

fn isObjectSizeLessThanOrEq(V: *mut Value, MaxSize: u64, DL: *DataLayout) -> bool {
    let mut Visited: SmallPtrSet<Value *, 4> = SmallPtrSet<Value *, 4> {};
    let mut Worklist: SmallVector<Value *, 4> = SmallVector<Value *, 4> { 1, V };
    while true {
        {
        let mut P: *mut Value = Worklist.pop_back_val();
        P = P.stripPointerCasts();
        if !Visited.insert(P).second {
            continue;
        }
        if dyn_cast(P) {
            SI;
        } else {
            Worklist.push(SI.getTrueValue());
            Worklist.push(SI.getFalseValue());
            continue;
        }
        if dyn_cast(P) {
            PN;
        } else {
            append_range(Worklist, PN.incoming_values());
            continue;
        }
        if dyn_cast(P) {
            GA;
        } else {
            if GA.isInterposable(true) {
                return false;
            }
            Worklist.push(GA.getAliasee());
            continue;
        }
        if dyn_cast(P) {
            AI;
        } else {
            let mut AllocSize: optional<TypeSize> = AI.getAllocationSize(DL);
            if !AllocSize || operator(AllocSize).isScalable() || operator(AllocSize).getFixedValue() > MaxSize {
                return false;
            }
            continue;
        }
        if dyn_cast(P) {
            GV;
        } else {
            if !GV.hasDefinitiveInitializer() || !GV.isConstant() {
                return false;
            }
            let mut InitSize: u64 = GV.getGlobalSize(DL);
            if InitSize > MaxSize {
                return false;
            }
            continue;
        }
        return false;
    }
        if !(!Worklist.is_empty()) { break; }
    }
    return true;
}

fn canReplaceGEPIdxWithZero(IC: *mut InstCombinerImpl, GEPI: *mut GetElementPtrInst, MemI: *mut Instruction, Idx: *mut u32) -> bool {
    if GEPI.getNumOperands() < 2 {
        return false;
    }
    let mut FirstNZIdx: Closure_3 = Closure_3 {};
    Idx = FirstNZIdx.call(GEPI);
    if Idx == GEPI.getNumOperands() {
        return false;
    }
    if isa(GEPI.getOperand(Idx)) {
        return false;
    }
    let mut Ops: SmallVector<Value *, 4> = SmallVector<Value *, 4> { GEPI.idx_begin(), GEPI.idx_begin() + Idx };
    let mut SourceElementType: *mut Type = GEPI.getSourceElementType();
    if SourceElementType.isScalableTy() {
        return false;
    }
    let mut AllocTy: *mut Type = getIndexedType(SourceElementType, Ops);
    if !AllocTy || !AllocTy.isSized() {
        return false;
    }
    let mut DL: *DataLayout = IC.getDataLayout();
    let mut TyAllocSize: u64 = DL.getTypeAllocSize(AllocTy).getFixedValue();
    let mut IsAllNonNegative: Closure_4 = Closure_4 { Idx: &mut Idx, GEPI: &mut GEPI, IC: &mut IC, MemI: &mut MemI };
    if Idx + 1 != GEPI.getNumOperands() && !GEPI.isInBounds() {
        return false;
    }
    return isObjectSizeLessThanOrEq(GEPI.getOperand(0), TyAllocSize, DL) && IsAllNonNegative.call();
}

fn replaceGEPIdxWithZero(IC: *mut InstCombinerImpl, Ptr: *mut Value, MemI: *mut Instruction) -> *mut Instruction {
    if dyn_cast(Ptr) {
        GEPI;
    } else {
        let mut Idx: u32 = 0;
        if canReplaceGEPIdxWithZero(IC, GEPI, &mut MemI, Idx) {
            let mut NewGEPI: *mut Instruction = GEPI.clone();
            NewGEPI.setOperand(Idx, get(GEPI.getOperand(Idx).getType(), 0, false, false));
            IC.InsertNewInstBefore(NewGEPI, GEPI.getIterator());
            if GEPI.getParent() == MemI.getParent() && isGuaranteedToTransferExecutionToSuccessor(const_iterator { GEPI.getIterator(), null }, const_iterator { MemI.getIterator(), null }, 32) {
                IC.replaceInstUsesWith(*GEPI, NewGEPI);
                IC.eraseInstFromFunction(*GEPI);
            }
            return NewGEPI;
        }
    }
    return null;
}

fn canSimplifyNullStoreOrGEP(SI: *mut StoreInst) -> bool {
    if NullPointerIsDefined(SI.getFunction(), SI.getPointerAddressSpace()) {
        return false;
    }
    let mut Ptr: *mut Value = SI.getPointerOperand();
    if dyn_cast(Ptr) {
        GEPI;
    } else {
        Ptr = GEPI.getOperand(0);
    }
    return (isa(Ptr) && !NullPointerIsDefined(SI.getFunction(), SI.getPointerAddressSpace()));
}

fn canSimplifyNullLoadOrGEP(LI: *mut LoadInst, Op: *mut Value) -> bool {
    if dyn_cast(Op) {
        GEPI;
    } else {
        let mut GEPI0: *Value = GEPI.getOperand(0);
        if isa(GEPI0) && !NullPointerIsDefined(LI.getFunction(), GEPI.getPointerAddressSpace()) {
            return true;
        }
    }
    if isa(Op) || (isa(Op) && !NullPointerIsDefined(LI.getFunction(), LI.getPointerAddressSpace())) {
        return true;
    }
    return false;
}

fn InstCombinerImpl::simplifyNonNullOperand(self, V: *mut Value, UseProvenance: bool, Depth: u32) -> *mut Value {
    if dyn_cast(V) {
        Sel;
    } else {
        if isa(Sel.getOperand(1)) {
            return Sel.getOperand(2);
        }
        if isa(Sel.getOperand(2)) {
            return Sel.getOperand(1);
        }
    }
    if !V.hasOneUse() {
        return null;
    }
    let mut RecursionLimit: u32 = 3;
    if Depth == RecursionLimit {
        return null;
    }
    if dyn_cast(V) {
        GEP;
    } else {
        if UseProvenance || (GEP.isInBounds() && !NullPointerIsDefined(GEP.getFunction(), GEP.getAddressSpace())) {
            if self.simplifyNonNullOperand(GEP.getPointerOperand(), UseProvenance, Depth + 1) {
                Res;
            } else {
                self.replaceOperand(*GEP, 0, Res);
                self.addToWorklist(GEP);
                return null;
            }
        }
    }
    if dyn_cast(V) {
        PHI;
    } else {
        let mut Changed: bool = false;
        for U in PHI.incoming_values() {
            if self.simplifyNonNullOperand(U.get(), UseProvenance, RecursionLimit) {
                Res;
            } else {
                self.replaceUse(U, Res);
                Changed = true;
            }
        }
        if Changed {
            self.addToWorklist(PHI);
        }
        return null;
    }
    return null;
}

fn InstCombinerImpl::visitLoadInst(self, LI: *mut LoadInst) -> *mut Instruction {
    let mut Op: *mut Value = LI.getOperand(0);
    if simplifyLoadInst(&mut LI, Op, self.SQ.getWithInstruction(&mut LI)) {
        Res;
    } else {
        return self.replaceInstUsesWith(LI, Res);
    }
    if combineLoadToOperationType(*self, LI) {
        Res;
    } else {
        return Res;
    }
    if replaceGEPIdxWithZero(*self, Op, LI) {
        NewGEPI;
    } else {
        return self.replaceOperand(LI, 0, NewGEPI);
    }
    if unpackLoadToAggregate(*self, LI) {
        Res;
    } else {
        return Res;
    }
    let mut IsLoadCSE: bool = false;
    let mut BatchAA: BatchAAResults = *self.AA;
    if FindAvailableLoadedValue(&mut LI, BatchAA, &mut IsLoadCSE, DefMaxInstsToScan.operator unsigned int()) {
        AvailableVal;
    } else {
        if IsLoadCSE {
            combineMetadataForCSE(cast(AvailableVal), &mut LI, false);
        }
        return self.replaceInstUsesWith(LI, self.Builder.CreateBitOrPointerCast(AvailableVal, LI.getType(), LI.getName() + ".cast"));
    }
    if !LI.isUnordered() {
        return null;
    }
    if canSimplifyNullLoadOrGEP(LI, Op) {
        self.CreateNonTerminatorUnreachable(&mut LI);
        return self.replaceInstUsesWith(LI, get(LI.getType()));
    }
    if Op.hasOneUse() {
        let mut ASC: *mut AddrSpaceCastInst = dyn_cast(Op);
        let mut SelectOp: *mut Value = Op;
        if ASC && ASC.getOperand(0).hasOneUse() {
            SelectOp = ASC.getOperand(0);
        }
        if dyn_cast(SelectOp) {
            SI;
        } else {
            let mut Alignment: Align = LI.getAlign();
            if isSafeToLoadUnconditionally(SI.getOperand(1), LI.getType(), Alignment, self.SQ.getWithInstruction(SI)) && isSafeToLoadUnconditionally(SI.getOperand(2), LI.getType(), Alignment, self.SQ.getWithInstruction(SI)) {
                let mut MaybeCastedLoadOperand: Closure_5 = Closure_5 { ASC: &mut ASC, cap_1: self };
                let mut LoadOp1: *mut Value = MaybeCastedLoadOperand.call(SI.getOperand(1));
                let mut V1: *mut LoadInst = self.Builder.CreateLoad(LI.getType(), LoadOp1, LI.getProperties(), LoadOp1.getName() + ".val");
                let mut LoadOp2: *mut Value = MaybeCastedLoadOperand.call(SI.getOperand(2));
                let mut V2: *mut LoadInst = self.Builder.CreateLoad(LI.getType(), LoadOp2, LI.getProperties(), LoadOp2.getName() + ".val");
                assert!(LI.isUnordered(), "implied by above");
                V1.copyMetadata(LI, PoisonGeneratingIDs);
                V2.copyMetadata(LI, PoisonGeneratingIDs);
                return Create(SI.getCondition(), V1, V2, "", null, SI);
            }
        }
    }
    if !NullPointerIsDefined(LI.getFunction(), LI.getPointerAddressSpace()) {
        if self.simplifyNonNullOperand(Op, true, 0) {
            V;
        } else {
            return self.replaceOperand(LI, 0, V);
        }
    }
    if isa(LI.getType()) {
        if dyn_cast(Op) {
            II;
        } else {
            if II.getIntrinsicID() == protected_field_ptr {
                let mut DSBundle: []OperandBundleDef = []OperandBundleDef {};
                if II.getOperandBundle(OB_deactivation_symbol) {
                    Bundle;
                } else {
                    DSBundle.push(OperandBundleDef { "deactivation-symbol", cast(operator(Bundle).Inputs[0]) });
                }
                let mut Guard: InsertPointGuard = self.Builder;
                self.Builder.SetInsertPoint(&mut LI);
                let mut NewLI: *mut LoadInst = cast(LI.clone());
                NewLI.setOperand(0, II.getOperand(0));
                self.Builder.Insert(NewLI, "");
                let mut AuthIntr: *mut Function = getOrInsertDeclaration(self.F.getParent(), ptrauth_auth, ArrayRef<Type *> {});
                let mut LIInt: *mut Value = self.Builder.CreatePtrToInt(NewLI, self.Builder.getInt64Ty(), "");
                let mut Auth: *mut Value = self.Builder.CreateCall(AuthIntr, [LIInt, self.Builder.getInt32(2), II.getOperand(1)], DSBundle, "", null);
                Auth = self.Builder.CreateIntToPtr(Auth, self.Builder.getPtrTy(0), "");
                return self.replaceInstUsesWith(LI, Auth);
            }
        }
    }
    return null;
}

fn likeBitCastFromVector(IC: *mut InstCombinerImpl, V: *mut Value) -> *mut Value {
    let mut U: *mut Value = null;
    while dyn_cast(V) {
        IV;
    }
    if !match(V, m_Undef()) || !U {
        return null;
    }
    let mut UT: *mut VectorType = cast(U.getType());
    let mut VT: *mut Type = V.getType();
    let mut DL: *DataLayout = IC.getDataLayout();
    if DL.getTypeStoreSizeInBits(UT) != DL.getTypeStoreSizeInBits(VT) {
        return null;
    }
    if dyn_cast(VT) {
        AT;
    } else {
        if AT.getNumElements() != cast(UT).getNumElements() {
            return null;
        }
    }
    return U;
}

fn combineStoreToValueType(IC: *mut InstCombinerImpl, SI: *mut StoreInst) -> bool {
    if !SI.isUnordered() {
        return false;
    }
    if SI.isElementwise() {
        return false;
    }
    if SI.getPointerOperand().isSwiftError() {
        return false;
    }
    let mut V: *mut Value = SI.getValueOperand();
    if dyn_cast(V) {
        BC;
    } else {
        assert!(!BC.getType().isX86_AMXTy(), "store to x86_amx* should not happen!");
        V = BC.getOperand(0);
        if V.getType().isX86_AMXTy() {
            return false;
        }
        if !SI.isAtomic() || isSupportedAtomicType(V.getType()) {
            combineStoreToNewValue(IC, SI, V);
            return true;
        }
    }
    if likeBitCastFromVector(IC, V) {
        U;
    } else if !SI.isAtomic() || isSupportedAtomicType(U.getType()) {
        combineStoreToNewValue(IC, SI, U);
        return true;
    }
    return false;
}

fn unpackStoreToAggregate(IC: *mut InstCombinerImpl, SI: *mut StoreInst) -> bool {
    if !SI.isSimple() {
        return false;
    }
    let mut V: *mut Value = SI.getValueOperand();
    let mut T: *mut Type = V.getType();
    if !T.isAggregateType() {
        return false;
    }
    if dyn_cast(T) {
        ST;
    } else {
        let mut Count: u32 = ST.getNumElements();
        if Count == 1 {
            V = IC.Builder.CreateExtractValue(V, 0, "");
            combineStoreToNewValue(IC, SI, V);
            return true;
        }
        let mut DL: *DataLayout = IC.getDataLayout();
        let mut SL: *StructLayout = DL.getStructLayout(ST);
        if SL.hasPadding() {
            return false;
        }
        let mut Align: Align = SI.getAlign();
        let mut EltName: str = V.getName();
        operator(EltName, ".elt");
        let mut Addr: *mut Value = SI.getPointerOperand();
        let mut AddrName: str = Addr.getName();
        operator(AddrName, ".repack");
        let mut IdxType: *mut Type = DL.getIndexType(Addr.getType());
        for let mut i: u32 = 0; i < Count; i += 1 {
            let mut Ptr: *mut Value = IC.Builder.CreateInBoundsPtrAdd(Addr, IC.Builder.CreateTypeSize(IdxType, SL.getElementOffset(i)), AddrName);
            let mut Val: *mut Value = IC.Builder.CreateExtractValue(V, i, EltName);
            let mut EltAlign: Align = commonAlignment(Align, SL.getElementOffset(i).getKnownMinValue());
            let mut NS: *mut Instruction = IC.Builder.CreateAlignedStore(Val, Ptr, EltAlign, false);
            NS.setAAMetadata(SI.getAAMetadata());
        }
        return true;
    }
    if dyn_cast(T) {
        AT;
    } else {
        let mut NumElements: u64 = AT.getNumElements();
        if NumElements == 1 {
            V = IC.Builder.CreateExtractValue(V, 0, "");
            combineStoreToNewValue(IC, SI, V);
            return true;
        }
        if NumElements > IC.CLOpts.maxarray_size {
            return false;
        }
        let mut DL: *DataLayout = IC.getDataLayout();
        let mut EltSize: TypeSize = DL.getTypeAllocSize(AT.getElementType());
        let mut Align: Align = SI.getAlign();
        let mut EltName: str = V.getName();
        operator(EltName, ".elt");
        let mut Addr: *mut Value = SI.getPointerOperand();
        let mut AddrName: str = Addr.getName();
        operator(AddrName, ".repack");
        let mut IdxType: *mut IntegerType = getInt64Ty(T.getContext());
        let mut Zero: *mut ConstantInt = get(IdxType, 0, false, false);
        let mut Offset: TypeSize = getZero();
        for let mut i: u64 = 0; i < NumElements; i += 1 {
            let mut Indices: [2]*mut Value = [Zero, get(IdxType, i, false, false)];
            let mut Ptr: *mut Value = IC.Builder.CreateInBoundsGEP(AT, Addr, Indices, AddrName);
            let mut Val: *mut Value = IC.Builder.CreateExtractValue(V, i, EltName);
            let mut EltAlign: Align = commonAlignment(Align, Offset.getKnownMinValue());
            let mut NS: *mut Instruction = IC.Builder.CreateAlignedStore(Val, Ptr, EltAlign, false);
            NS.setAAMetadata(SI.getAAMetadata());
            operator(Offset, EltSize);
        }
        return true;
    }
    return false;
}

fn equivalentAddressValues(A: *mut Value, B: *mut Value) -> bool {
    if A == B {
        return true;
    }
    if isa(A) || isa(A) || isa(A) || isa(A) {
        if dyn_cast(B) {
            BI;
        } else if cast(A).isIdenticalToWhenDefined(BI, false) {
            return true;
        }
    }
    return false;
}

fn InstCombinerImpl::visitStoreInst(self, SI: *mut StoreInst) -> *mut Instruction {
    let mut Val: *mut Value = SI.getOperand(0);
    let mut Ptr: *mut Value = SI.getOperand(1);
    if combineStoreToValueType(*self, SI) {
        return self.eraseInstFromFunction(SI);
    }
    if unpackStoreToAggregate(*self, SI) {
        return self.eraseInstFromFunction(SI);
    }
    if replaceGEPIdxWithZero(*self, Ptr, SI) {
        NewGEPI;
    } else {
        return self.replaceOperand(SI, 1, NewGEPI);
    }
    if !SI.isUnordered() {
        return null;
    }
    if Ptr.hasOneUse() {
        if isa(Ptr) {
            return self.eraseInstFromFunction(SI);
        }
        if dyn_cast(Ptr) {
            GEP;
        } else {
            if isa(GEP.getOperand(0)) {
                if GEP.getOperand(0).hasOneUse() {
                    return self.eraseInstFromFunction(SI);
                }
            }
        }
    }
    if !isModSet(self.AA.getModRefInfoMask(Ptr, false)) {
        return self.eraseInstFromFunction(SI);
    }
    let mut BBI: iterator = SI;
    for let mut ScanInsts: u32 = 6; BBI != SI.getParent().begin() && ScanInsts; ScanInsts -= 1 {
        operator(BBI);
        if operator(BBI).isDebugOrPseudoInst() {
            ScanInsts += 1;
            continue;
        }
        if dyn_cast(BBI) {
            PrevSI;
        } else {
            if PrevSI.isUnordered() && equivalentAddressValues(PrevSI.getOperand(1), SI.getOperand(1)) && PrevSI.getValueOperand().getType() == SI.getValueOperand().getType() {
                operator(NumDeadStore);
                self.Worklist.push(&mut SI);
                self.eraseInstFromFunction(*PrevSI);
                return null;
            }
            break;
        }
        if dyn_cast(BBI) {
            LI;
        } else {
            if LI == Val && equivalentAddressValues(LI.getOperand(0), Ptr) {
                assert!(SI.isUnordered(), "can't eliminate ordering operation");
                return self.eraseInstFromFunction(SI);
            }
            break;
        }
        if operator(BBI).mayWriteToMemory() || operator(BBI).mayReadFromMemory() || operator(BBI).mayThrow(false) {
            break;
        }
    }
    if canSimplifyNullStoreOrGEP(SI) {
        if !isa(Val) {
            return self.replaceOperand(SI, 0, get(Val.getType()));
        }
        return null;
    }
    if isa(Ptr) {
        self.removeInstructionsBeforeUnreachable(SI);
        let mut Worklist: SmallVector<BasicBlock *> = SmallVector<BasicBlock *> {};
        self.handleUnreachableFrom(SI.getNextNode(), Worklist);
        self.handlePotentiallyDeadBlocks(Worklist);
        return null;
    }
    if isa(Val) {
        return self.eraseInstFromFunction(SI);
    }
    let mut C: *mut Constant = null;
    if Val.getType().isByteOrByteVectorTy() && match(Val, m_ImmConstant(C)) {
        return self.replaceOperand(SI, 0, getBitCast(C, getIntFromByteType(C.getType()), false));
    }
    if !NullPointerIsDefined(SI.getFunction(), SI.getPointerAddressSpace()) {
        if self.simplifyNonNullOperand(Ptr, true, 0) {
            V;
        } else {
            return self.replaceOperand(SI, 1, V);
        }
    }
    if isa(Val.getType()) {
        if dyn_cast(Ptr) {
            II;
        } else {
            if II.getIntrinsicID() == protected_field_ptr {
                let mut DSBundle: []OperandBundleDef = []OperandBundleDef {};
                if II.getOperandBundle(OB_deactivation_symbol) {
                    Bundle;
                } else {
                    DSBundle.push(OperandBundleDef { "deactivation-symbol", cast(operator(Bundle).Inputs[0]) });
                }
                let mut Guard: InsertPointGuard = self.Builder;
                self.Builder.SetInsertPoint(&mut SI);
                let mut SignIntr: *mut Function = getOrInsertDeclaration(self.F.getParent(), ptrauth_sign, ArrayRef<Type *> {});
                let mut ValInt: *mut Value = self.Builder.CreatePtrToInt(Val, self.Builder.getInt64Ty(), "");
                let mut Sign: *mut Value = self.Builder.CreateCall(SignIntr, [ValInt, self.Builder.getInt32(2), II.getOperand(1)], DSBundle, "", null);
                Sign = self.Builder.CreateIntToPtr(Sign, self.Builder.getPtrTy(0), "");
                self.replaceOperand(SI, 0, Sign);
                self.replaceOperand(SI, 1, II.getOperand(0));
                return &mut SI;
            }
        }
    }
    return null;
}

fn InstCombinerImpl::mergeStoreIntoSuccessor(self, SI: *mut StoreInst) -> bool {
    if !SI.isUnordered() {
        return false;
    }
    let mut StoreBB: *mut BasicBlock = SI.getParent();
    let mut DestBB: *mut BasicBlock = StoreBB.getTerminator().getSuccessor(0);
    if !DestBB.hasNPredecessors(2) {
        return false;
    }
    let mut PredIter: pred_iterator = pred_begin(DestBB);
    if operator(PredIter) == StoreBB {
        operator(PredIter);
    }
    let mut OtherBB: *mut BasicBlock = operator(PredIter);
    if StoreBB == DestBB || OtherBB == DestBB {
        return false;
    }
    let mut BBI: iterator = OtherBB.getTerminator();
    if BBI == OtherBB.begin() {
        return false;
    }
    let mut OtherStoreIsMergeable: Closure_6 = Closure_6 { SI: &mut SI, cap_1: self };
    let mut OtherStore: *mut StoreInst = null;
    if isa(BBI) {
        operator(BBI);
        while operator(BBI).isDebugOrPseudoInst() {
            if BBI == OtherBB.begin() {
                return false;
            }
            operator(BBI);
        }
        OtherStore = dyn_cast(BBI);
        if !OtherStoreIsMergeable.call(OtherStore) {
            return false;
        }
    } else if dyn_cast(BBI) {
        OtherBr;
    } else {
        if OtherBr.getSuccessor(0) != StoreBB && OtherBr.getSuccessor(1) != StoreBB {
            return false;
        }
        for ; ; operator(BBI) {
            OtherStore = dyn_cast(BBI);
            if OtherStoreIsMergeable.call(OtherStore) {
                break;
            }
            if operator(BBI).mayReadFromMemory() || operator(BBI).mayThrow(false) || operator(BBI).mayWriteToMemory() || BBI == OtherBB.begin() {
                return false;
            }
        }
        for let mut I: iterator = StoreBB.begin(); &mut operator(I) != &mut SI; operator(I) {
            if operator(I).mayReadFromMemory() || operator(I).mayThrow(false) || operator(I).mayWriteToMemory() {
                return false;
            }
        }
    }
    let mut MergedVal: *mut Value = OtherStore.getValueOperand();
    let mut MergedLoc: DebugLoc = getMergedLocation(SI.getDebugLoc(), OtherStore.getDebugLoc());
    if MergedVal != SI.getValueOperand() {
        let mut PN: *mut PHINode = Create(SI.getValueOperand().getType(), 2, "storemerge", null);
        PN.addIncoming(SI.getValueOperand(), SI.getParent());
        self.Builder.SetInsertPoint(OtherStore);
        PN.addIncoming(self.Builder.CreateBitOrPointerCast(MergedVal, PN.getType(), ""), OtherBB);
        MergedVal = self.InsertNewInstBefore(PN, DestBB.begin());
        PN.setDebugLoc(MergedLoc);
    }
    BBI = DestBB.getFirstInsertionPt();
    let mut NewSI: *mut StoreInst = StoreInst { MergedVal, SI.getOperand(1), SI.getProperties(), null };
    self.InsertNewInstBefore(NewSI, BBI);
    NewSI.setDebugLoc(MergedLoc);
    NewSI.mergeDIAssignID([&mut SI, OtherStore]);
    let mut AATags: AAMDNodes = SI.getAAMetadata();
    if AATags {
        NewSI.setAAMetadata(AATags.merge(OtherStore.getAAMetadata()));
    }
    NewSI.setMetadata(MD_access_group, intersectAccessGroups(&mut SI, OtherStore));
    self.eraseInstFromFunction(SI);
    self.eraseInstFromFunction(*OtherStore);
    return true;
}

struct Closure_1 {
    cap_0: *mut PointerReplacer,
    ValuesToRevisit: *mut SmallSetVector<Instruction *, 32>,
    Worklist: *mut SmallVector<Instruction *>,
}

unsafe fn Closure_1::call(self: *mut Closure_1, Inst: *mut Instruction) {
        for U in Inst.users() {
            if dyn_cast(U) {
                I;
            } else if !self.isAvailable(I) && !(*self.ValuesToRevisit).contains(I) {
                (*self.Worklist).push(I);
            }
        }
    }

struct Closure_2 {
    cap_0: *mut PointerReplacer,
    ValuesToRevisit: *mut SmallSetVector<Instruction *, 32>,
    Worklist: *mut SmallVector<Instruction *>,
}

unsafe fn Closure_2::call(self: *mut Closure_2, InstOp: *mut Instruction) -> bool {
        if !self.UsersToReplace.contains(InstOp) {
            if !(*self.ValuesToRevisit).insert(InstOp) {
                return false;
            }
            (*self.Worklist).push(InstOp);
        }
        return true;
    }

struct Closure_3 {}

fn Closure_3::call(self: *Closure_3, GEPI: *GetElementPtrInst) -> u32 {
        let mut I: u32 = 1;
        for let mut IE: u32 = GEPI.getNumOperands(); I != IE; I += 1 {
            let mut V: *mut Value = GEPI.getOperand(I);
            if dyn_cast(V) {
                CI;
            } else if CI.isZero() {
                continue;
            }
            break;
        }
        return I;
    }

struct Closure_4 {
    Idx: *mut u32,
    GEPI: *mut *mut GetElementPtrInst,
    IC: *mut InstCombinerImpl,
    MemI: *mut *mut Instruction,
}

unsafe fn Closure_4::call(self: *mut Closure_4) -> bool {
        for let mut i: u32 = (*self.Idx) + 1;
let mut e: u32 = (*self.GEPI).getNumOperands(); i != e; i += 1 {
            let mut Known: KnownBits = (*self.IC).computeKnownBits((*self.GEPI).getOperand(i), (*self.MemI), 0);
            if Known.isNonNegative() {
                continue;
            }
            return false;
        }
        return true;
    }

struct Closure_5 {
    ASC: *mut *mut AddrSpaceCastInst,
    cap_1: *mut InstCombinerImpl,
}

unsafe fn Closure_5::call(self: *mut Closure_5, Op: *mut Value) -> *mut Value {
                    if (*self.ASC) {
                        return self.Builder.CreateAddrSpaceCast(Op, (*self.ASC).getType(), Op.getName() + ".cast", false);
                    }
                    return Op;
                }

struct Closure_6 {
    SI: *mut StoreInst,
    cap_1: *mut InstCombinerImpl,
}

unsafe fn Closure_6::call(self: *mut Closure_6, OtherStore: *mut StoreInst) -> auto {
        if !OtherStore || OtherStore.getPointerOperand() != (*self.SI).getPointerOperand() {
            return false;
        }
        let mut SIVTy: *mut Type = (*self.SI).getValueOperand().getType();
        let mut OSVTy: *mut Type = OtherStore.getValueOperand().getType();
        if !isBitOrNoopPointerCastable(OSVTy, SIVTy, self.DL) || !(*self.SI).hasSameSpecialState(OtherStore, false, false) {
            return false;
        }
        return !(*self.SI).isElementwise() || self.DL.getTypeStoreSize(SIVTy.getScalarType()) == self.DL.getTypeStoreSize(OSVTy.getScalarType());
    }
