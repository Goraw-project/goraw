fn isObjectSizeLessThanOrEq(V: *mut Value, MaxSize: u64, DL: *DataLayout) -> bool {
    let mut Visited: SmallPtrSet<Value *, 4> = zeroed();
    let mut Worklist: SmallVector<Value *, 4> = zeroed();
    while true {
        {
        let mut P: *mut Value = ();
        P = P.stripPointerCasts();
        if operator!((P)) {
            continue;
        }
        if dyn_cast(P) {
            SI;
        } else {
            Worklist()(SI.getTrueValue());
            Worklist()(SI.getFalseValue());
            continue;
        }
        if dyn_cast(P) {
            PN;
        } else {
            append_range(PN()());
            continue;
        }
        if dyn_cast(P) {
            GA;
        } else {
            if GA.isInterposable {
                return false;
            }
            Worklist()(GA.getAliasee());
            continue;
        }
        if dyn_cast(P) {
            AI;
        } else {
            let mut AllocSize: optional<TypeSize> = zeroed();
            if operator!() || () || () > MaxSize {
                return false;
            }
            continue;
        }
        if dyn_cast(P) {
            GV;
        } else {
            if !GV.hasDefinitiveInitializer() || !GV.isConstant() {
                return false;
            }
            let mut InitSize: u64 = GV.getGlobalSize(DL);
            if InitSize > MaxSize {
                return false;
            }
            continue;
        }
        return false;
    }
        if !(operator!()) { break; }
    }
    return true;
}

fn canReplaceGEPIdxWithZero(IC: *mut InstCombinerImpl, GEPI: *mut GetElementPtrInst, MemI: *mut Instruction, Idx: *mut u32) -> bool {
    if GEPI.getNumOperands() < 2 {
        return false;
    }
    let mut FirstNZIdx: Closure_5 = Closure_5 {};
    Idx = FirstNZIdx.call(GEPI);
    if Idx == GEPI.getNumOperands() {
        return false;
    }
    if isa(GEPI.getOperand(Idx)) {
        return false;
    }
    let mut Ops: SmallVector<Value *, 4> = zeroed();
    let mut SourceElementType: *mut Type = GEPI.getSourceElementType();
    if SourceElementType.isScalableTy() {
        return false;
    }
    let mut AllocTy: *mut Type = getIndexedType(SourceElementType);
    if !AllocTy || !AllocTy.isSized() {
        return false;
    }
    let mut DL: *DataLayout = IC.getDataLayout;
    let mut TyAllocSize: u64 = DL.getTypeAllocSize(AllocTy)();
    let mut IsAllNonNegative: Closure_6 = Closure_6 { Idx: &mut Idx, GEPI: &mut GEPI, IC: &mut IC, MemI: &mut MemI };
    if Idx + 1 != GEPI.getNumOperands() && !GEPI.isInBounds() {
        return false;
    }
    return isObjectSizeLessThanOrEq(GEPI.getOperand(0), TyAllocSize, DL) && IsAllNonNegative.call();
}

fn replaceGEPIdxWithZero(IC: *mut InstCombinerImpl, Ptr: *mut Value, MemI: *mut Instruction) -> *mut Instruction {
    if dyn_cast(Ptr) {
