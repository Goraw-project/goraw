unsafe fn Closure_11::call(self: *mut Closure_11) -> *mut Constant {
            let mut C: *mut Constant = getExactLogBase2(cast((*self.Op)));
            if !C {
                llvm_unreachable_internal("Failed to constant fold udiv -> logbase2", "P:/Goraw/llvm-project/llvm/lib/Transforms/InstCombine/InstCombineMulDivRem.cpp", 1658);
            }
            return C;
        }

