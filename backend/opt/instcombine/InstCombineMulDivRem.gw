fn simplifyValueKnownNonZero(V: *mut Value, IC: *mut InstCombinerImpl, CtxI: *mut Instruction) -> *mut Value {
    if !V.hasOneUse() {
        return null;
    }
    let mut MadeChange: bool = false;
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut One: *mut Value = null;
    if match(V, m_LShr(m_OneUse(m_Shl(m_Value(One), m_Value(A))), m_Value(B))) && match(One) {
        A = IC()(A, B);
        return IC()(One, A);
    }
    let mut I: *mut BinaryOperator = dyn_cast(V);
    if I && I.isLogicalShift && IC.isKnownToBeAPowerOfTwo {
        {
            let mut Guard: InsertPointGuard = IC();
            IC()(I);
            if simplifyValueKnownNonZero(I.getOperand(0), IC, CtxI) {
                V2;
            } else {
                IC.replaceOperand;
                MadeChange = true;
            }
        }
        if I.getOpcode() == LShr && operator!(I.isExact) {
            I.setIsExact;
            MadeChange = true;
        }
        if I.getOpcode() == Shl && operator!(I.hasNoUnsignedWrap) {
            I.setHasNoUnsignedWrap;
            MadeChange = true;
        }
    }
    return if MadeChange { V } else { null };
}

fn foldMulSelectToNegate(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Value {
    let mut Cond: *mut Value = null;
    let mut OtherOp: *mut Value = null;
    if match(&mut I, m_c_Mul(m_OneUse(m_Select(m_Value(Cond))), m_Value(OtherOp))) {
        let mut HasAnyNoWrap: bool = I.hasNoSignedWrap || I.hasNoUnsignedWrap;
        let mut Neg: *mut Value = Builder()(OtherOp, "", HasAnyNoWrap);
        return Builder()(Cond, OtherOp, Neg);
    }
    if match(&mut I, m_c_Mul(m_OneUse(m_Select(m_Value(Cond))), m_Value(OtherOp))) {
        let mut HasAnyNoWrap: bool = I.hasNoSignedWrap || I.hasNoUnsignedWrap;
        let mut Neg: *mut Value = Builder()(OtherOp, "", HasAnyNoWrap);
        return Builder()(Cond, Neg, OtherOp);
    }
    if match(&mut I, m_c_FMul(m_OneUse(m_Select(m_Value(Cond), m_SpecificFP(1.0), m_SpecificFP(-1.0))), m_Value(OtherOp))) {
        return Builder()(Cond, OtherOp, Builder()(OtherOp, &mut I), &mut I);
    }
    if match(&mut I, m_c_FMul(m_OneUse(m_Select(m_Value(Cond), m_SpecificFP(-1.0), m_SpecificFP(1.0))), m_Value(OtherOp))) {
        return Builder()(Cond, Builder()(OtherOp, &mut I), OtherOp, &mut I);
    }
    return null;
}

fn foldMulShl1(Mul: *mut BinaryOperator, CommuteOperands: bool, Builder: *mut BuilderTy) -> *mut Value {
    let mut X: *mut Value = Mul.getOperand(0);
    let mut Y: *mut Value = Mul.getOperand(1);
    if CommuteOperands {
        swap(X, Y);
    }
    let mut HasNSW: bool = Mul.hasNoSignedWrap;
    let mut HasNUW: bool = Mul.hasNoUnsignedWrap;
    let mut Z: *mut Value = null;
    if match(Y, m_Shl(m_Value(Z))) {
        let mut PropagateNSW: bool = HasNSW && cast(Y)();
        return Builder()(X, Z, Mul.getName, HasNUW, PropagateNSW);
    }
    let mut Shift: *mut BinaryOperator = null;
    if match(Y, m_OneUse(m_Add(m_BinOp(Shift)))) && match(Shift, m_OneUse(m_Shl(m_Value(Z)))) {
        let mut PropagateNSW: bool = HasNSW && Shift.hasNoSignedWrap;
        let mut FrX: *mut Value = X;
        if !isGuaranteedNotToBeUndef(X, null, null, null, 0) {
            FrX = Builder()(X, X.getName() + ".fr");
        }
        let mut Shl: *mut Value = Builder()(FrX, Z, "mulshl", HasNUW, PropagateNSW);
        return Builder()(Shl, FrX, Mul.getName, HasNUW, PropagateNSW);
    }
    if match(Y, m_OneUse(m_Not(m_OneUse(m_Shl(m_Value(Z)))))) {
        let mut FrX: *mut Value = X;
        if !isGuaranteedNotToBeUndef(X, null, null, null, 0) {
            FrX = Builder()(X, X.getName() + ".fr");
        }
        let mut Shl: *mut Value = Builder()(FrX, Z, "mulshl");
        return Builder()(Shl, FrX, Mul.getName);
    }
    return null;
}

fn InstCombinerImpl::visitMul(self, I: *mut BinaryOperator) -> *mut Instruction {
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    if simplifyMulInst(Op0, Op1, I.hasNoSignedWrap, I.hasNoUnsignedWrap) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if self.SimplifyAssociativeOrCommutative(I) {
        return &mut I;
    }
    if self.foldVectorBinop(I) {
        X;
    } else {
        return X;
    }
    if self.foldBinopWithPhiOperands(I) {
        Phi;
    } else {
        return Phi;
    }
    if self.foldUsingDistributiveLaws(I) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    let mut Ty: *mut Type = I.getType;
    let mut BitWidth: u32 = Ty.getScalarSizeInBits();
    let mut HasNSW: bool = I.hasNoSignedWrap;
    let mut HasNUW: bool = I.hasNoUnsignedWrap;
    if match(Op1) {
        return if HasNSW { CreateNSWNeg(Op0, "", null) } else { CreateNeg(Op0, "", null) };
    }
    {
        let mut NewOp: *mut Value = null;
        let mut C1: *mut Constant = null;
        let mut C2: *mut Constant = null;
        let mut IVal: *APInt = null;
        if match(&mut I, m_Mul(m_Shl(m_Value(NewOp), m_ImmConstant(C2)), m_ImmConstant(C1))) && match(C1) {
            let mut Shl: *mut Constant = ConstantFoldBinaryOpOperands(Shl, C1, C2);
            assert!(Shl, "Constant folding of immediate constants failed");
            let mut Mul: *mut BinaryOperator = cast(I.getOperand(0));
            let mut BO: *mut BinaryOperator = CreateMul(NewOp, Shl, "");
            if HasNUW && Mul.hasNoUnsignedWrap {
                BO.setHasNoUnsignedWrap;
            }
            if HasNSW && Mul.hasNoSignedWrap && Shl.isNotMinSignedValue() {
                BO.setHasNoSignedWrap;
            }
            return BO();
        }
        if match(&mut I, m_Mul(m_Value(NewOp))) {
            if getExactLogBase2(C1) {
                NewCst;
            } else {
                let mut Shl: *mut BinaryOperator = CreateShl(NewOp, NewCst, "");
                if HasNUW {
                    Shl.setHasNoUnsignedWrap;
                }
                if HasNSW {
                    let mut V: *APInt = null;
                    if match(NewCst) && *V != V.getBitWidth() - 1 {
                        Shl.setHasNoSignedWrap;
                    }
                }
                return Shl;
            }
        }
    }
    {
        let mut NewOp: *mut Value = null;
        let mut ShiftC: *APInt = null;
        let mut MulAP: *APInt = null;
        if BitWidth > 2 && match(&mut I, m_Mul(m_Exact(m_Shr(m_Value(NewOp))))) && (*MulAP - 1).isPowerOf2() && *ShiftC == MulAP.logBase2() {
            let mut BinOp: *mut Value = Op0;
            let mut OpBO: *mut BinaryOperator = cast(Op0);
            let mut NewAdd: *mut BinaryOperator = CreateAdd(NewOp, BinOp, "");
            if HasNSW && (HasNUW || OpBO.getOpcode() == LShr || ShiftC.getZExtValue() < BitWidth - 1) {
                NewAdd.setHasNoSignedWrap;
            }
            NewAdd.setHasNoUnsignedWrap;
            return NewAdd;
        }
    }
    if Op0.hasOneUse() && match(Op1) {
        if Negate(true, HasNSW, Op0, *self) {
            NegOp0;
        } else {
            let mut Op1C: *mut auto = cast(Op1);
            return self.replaceInstUsesWith;
        }
        let mut NegPow2C: *APInt = null;
        let mut X: *mut Value = null;
        if match(Op0, m_ZExtOrSExt(m_Value(X))) && match(Op1) {
            let mut SrcWidth: u32 = X.getType().getScalarSizeInBits();
            let mut ShiftAmt: u32 = NegPow2C.countr_zero();
            if ShiftAmt >= BitWidth - SrcWidth {
                let mut N: *mut Value = null;
                let mut Z: *mut Value = null;
                return CreateShl(Z, get(Ty, ShiftAmt, false, false), "");
            }
        }
    }
    if self.foldBinOpIntoSelectOrPhi(I) {
        FoldedMul;
    } else {
        return FoldedMul;
    }
    if self.foldBinOpSelectBinOp(I) {
        FoldedLogic;
    } else {
        return FoldedLogic;
    }
    if foldMulSelectToNegate(I) {
        FoldedMul;
    } else {
        return self.replaceInstUsesWith;
    }
    {
        let mut NewOp: *mut Value = null;
        let mut Cond: *mut Value = null;
        let mut OtherValue: *mut Value = null;
        let mut C1: *mut Constant = null;
        let mut C2: *mut Constant = null;
        let mut C3: *mut Constant = null;
        if match(&mut I, m_c_Mul(m_OneUse(m_Value(OtherValue)), m_OneUse(m_Select(m_Value(Cond), m_ImmConstant(C2), m_ImmConstant(C3))))) && (match(OtherValue, m_Mul(m_Value(NewOp), m_ImmConstant(C1))) || match(OtherValue, m_Shl(m_Value(NewOp), m_ImmConstant(C1)))) {
            let mut OtherInst: *mut auto = cast(OtherValue);
            let mut Opc: auto = ();
            let mut NewTV: *mut Constant = ConstantFoldBinaryOpOperands(C2, C1);
            let mut NewFV: *mut Constant = ConstantFoldBinaryOpOperands(C3, C1);
            if NewTV && NewFV {
                let mut NewSel: *mut Value = null;
                let mut BO: *mut BinaryOperator = CreateMul(NewOp, NewSel, "");
                if HasNUW && () {
                    BO.setHasNoUnsignedWrap;
                }
                if HasNSW && () && NewTV.isNotMinSignedValue() && NewFV.isNotMinSignedValue() {
                    BO.setHasNoSignedWrap;
                }
                return BO;
            }
        }
    }
    let mut MulC: *mut Constant = null;
    if match(Op1, m_ImmConstant(MulC)) {
        let mut X: *mut Value = null;
        let mut C1: *mut Constant = null;
        if match(Op0, m_OneUse(m_AddLike(m_Value(X), m_ImmConstant(C1)))) {
            let mut NewC: *mut Value = null;
            let mut BOp0: *mut auto = cast(Op0);
            let mut Op0NUW: bool = (BOp0()() == Or || ());
            let mut NewMul: *mut Value = null;
            let mut BO: *mut BinaryOperator = CreateAdd(NewMul, NewC, "");
            if HasNUW && Op0NUW {
                if  {
                    NewMulBO()();
                }
                BO.setHasNoUnsignedWrap;
            }
            return BO;
        }
    }
    let mut X: *mut Value = null;
    if Op0 == Op1 && match(Op0, m_Intrinsic(m_Value(X))) {
        return CreateMul(X, X, "");
    }
    {
        let mut Y: *mut Value = null;
        if I.hasNoSignedWrap && match(Op0, m_OneUse(m_Intrinsic(m_Value(X)))) && match(Op1, m_OneUse(m_Intrinsic(m_Value(Y)))) {
            return self.replaceInstUsesWith;
        }
    }
    let mut Y: *mut Value = null;
    let mut Op1C: *mut Constant = null;
    if match(Op0, m_Neg(m_Value(X))) && match(Op1) {
        return CreateMul(X, getNeg(Op1C, false), "");
    }
    if match(Op0, m_Neg(m_Value(X))) && match(Op1, m_Neg(m_Value(Y))) {
        let mut NewMul: *mut BinaryOperator = CreateMul(X, Y, "");
        if HasNSW && cast(Op0)() && cast(Op1)() {
            NewMul.setHasNoSignedWrap;
        }
        return NewMul;
    }
    if match(&mut I, m_c_Mul(m_OneUse(m_Neg(m_Value(X))), m_Value(Y))) {
        return CreateNeg();
    }
    if match(Op1, m_Neg(m_Value(X))) {
        if Negate(false, false, Op0, *self) {
            NegOp0;
        } else {
            return CreateMul(NegOp0, X, "");
        }
    }
    if Op0.hasOneUse() {
        let mut C1: *APInt = null;
        let mut UDivCheck: Closure_1 = Closure_1 { C1: &mut C1 };
        let mut SDivCheck: Closure_2 = Closure_2 { C1: &mut C1 };
        if match(Op1) && (match(Op0, m_Exact(m_UDiv(m_Value(X)))) || match(Op0, m_Exact(m_SDiv(m_Value(X))))) {
            let mut BOpc: auto = cast(Op0)();
            return CreateExact(X);
        }
    }
    {
        let mut Y: *mut Value = Op1;
        let mut Div: *mut BinaryOperator = dyn_cast(Op0);
        if !Div || (Div.getOpcode() != UDiv && Div.getOpcode() != SDiv) {
            Y = Op0;
            Div = dyn_cast(Op1);
        }
        let mut Neg: *mut Value = self.dyn_castNegVal(Y);
        if Div && Div.hasOneUse && (Div.getOperand(1) == Y || Div.getOperand(1) == Neg) && (Div.getOpcode() == UDiv || Div.getOpcode() == SDiv) {
            let mut X: *mut Value = Div.getOperand(0);
            let mut DivOp1: *mut Value = Div.getOperand(1);
            if Div.isExact {
                if DivOp1 == Y {
                    return self.replaceInstUsesWith;
                }
                return CreateNeg(X, "", null);
            }
            let mut RemOpc: auto = if Div.getOpcode() == UDiv { URem } else { SRem };
            let mut XFreeze: *mut Value = X;
            let mut Rem: *mut Value = null;
            if DivOp1 == Y {
                return CreateSub(XFreeze, Rem, "");
            }
            return CreateSub(Rem, XFreeze, "");
        }
    }
    if Ty.isIntOrIntVectorTy(1) || (match(Op0, m_And(m_Value())) && match(Op1, m_And(m_Value()))) {
        return CreateAnd(Op0, Op1, "");
    }
    if foldMulShl1(I, false) {
        R;
    } else {
        return self.replaceInstUsesWith;
    }
    if foldMulShl1(I, true) {
        R;
    } else {
        return self.replaceInstUsesWith;
    }
    if ((match(Op0, m_ZExt(m_Value(X))) && match(Op1, m_ZExt(m_Value(Y)))) || (match(Op0, m_SExt(m_Value(X))) && match(Op1, m_SExt(m_Value(Y))))) && X.getType().isIntOrIntVectorTy(1) && X.getType() == Y.getType() && (Op0.hasOneUse() || Op1.hasOneUse() || X == Y) {
        let mut And: *mut Value = null;
        return Create(ZExt, And, Ty, "", null);
    }
    if ((match(Op0, m_SExt(m_Value(X))) && match(Op1, m_ZExt(m_Value(Y)))) || (match(Op0, m_ZExt(m_Value(X))) && match(Op1, m_SExt(m_Value(Y))))) && X.getType().isIntOrIntVectorTy(1) && X.getType() == Y.getType() && (Op0.hasOneUse() || Op1.hasOneUse()) {
        let mut And: *mut Value = null;
        return Create(SExt, And, Ty, "", null);
    }
    if match(Op0, m_ZExt(m_Value(X))) && X.getType().isIntOrIntVectorTy(1) {
        return self.createSelectInstWithUnknownProfile(X, Op1, getNullValue(Ty), "", null);
    }
    if match(Op1, m_ZExt(m_Value(X))) && X.getType().isIntOrIntVectorTy(1) {
        return self.createSelectInstWithUnknownProfile(X, Op0, getNullValue(Ty), "", null);
    }
    if match(&mut I, m_c_Mul(m_OneUse(m_SExt(m_Value(X))), m_Value(Y))) && X.getType().isIntOrIntVectorTy(1) {
        return self.createSelectInstWithUnknownProfile;
    }
    let mut ImmC: *mut Constant = null;
    if match(Op1, m_ImmConstant(ImmC)) {
        if match(Op0, m_SExt(m_Value(X))) && X.getType().isIntOrIntVectorTy(1) {
            let mut NegC: *mut Constant = getNeg(ImmC, false);
            return self.createSelectInstWithUnknownProfile(X, NegC, getNullValue(Ty), "", null);
        }
        let mut C: *APInt = null;
        if match(Op0, m_OneUse(m_AShr(m_Value(X)))) && *C == C.getBitWidth() - 1 {
            let mut NegC: *mut Constant = getNeg(ImmC, false);
            let mut IsNeg: *mut Value = null;
            return self.createSelectInstWithUnknownProfile(IsNeg, NegC, getNullValue(Ty), "", null);
        }
    }
    let mut C: *APInt = null;
    if match(&mut I, m_c_BinOp(m_LShr(m_Value(X)), m_Value(Y))) && *C == C.getBitWidth() - 1 {
        let mut IsNeg: *mut Value = null;
        return self.createSelectInstWithUnknownProfile(IsNeg, Y, getNullValue(Ty), "", null);
    }
    if match(&mut I, m_c_BinOp(m_OneUse(m_And(m_Value(X))), m_Value(Y))) {
        let mut Tr: *mut Value = null;
        return self.createSelectInstWithUnknownProfile(Tr, Y, getNullValue(Ty), "", null);
    }
    if match(&mut I, m_c_BinOp(m_Or(m_AShr(m_Value(X))))) {
        let mut Abs: *mut Value = null;
        Abs.takeName;
        return self.replaceInstUsesWith;
    }
    if self.narrowMathIfNoOverflow(I) {
        Ext;
    } else {
        return Ext;
    }
    if self.foldBinOpOfSelectAndCastOfSelectCondition(I) {
        Res;
    } else {
        return Res;
    }
    if self.tryGetLog2(Op0, false) {
        Res;
    } else {
        let mut Shl: *mut BinaryOperator = CreateShl(Op1, Res, "");
        Shl.setHasNoUnsignedWrap;
        return Shl;
    }
    if self.tryGetLog2(Op1, false) {
        Res;
    } else {
        let mut Shl: *mut BinaryOperator = CreateShl(Op0, Res, "");
        Shl.setHasNoUnsignedWrap;
        return Shl;
    }
    let mut Changed: bool = false;
    if !HasNSW && self.willNotOverflowSignedMul {
        Changed = true;
        I.setHasNoSignedWrap;
    }
    if !HasNUW && self.willNotOverflowUnsignedMul(Op0, Op1, I, I.hasNoSignedWrap) {
        Changed = true;
        I.setHasNoUnsignedWrap;
    }
    return if Changed { &mut I } else { null };
}

fn InstCombinerImpl::foldFPSignBitOps(self, I: *mut BinaryOperator) -> *mut Instruction {
    let mut Opcode: BinaryOps = I.getOpcode();
    assert!((Opcode == FMul || Opcode == FDiv), "Expected fmul or fdiv");
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(Op0, m_FNeg(m_Value(X))) && match(Op1, m_FNeg(m_Value(Y))) {
        return CreateWithCopiedFlags(Opcode, X, Y, &mut I);
    }
    if Op0 == Op1 && match(Op0, m_FAbs(m_Value(X))) {
        return CreateWithCopiedFlags(Opcode, X, X, &mut I);
    }
    if match(Op0, m_FAbs(m_Value(X))) && match(Op1, m_FAbs(m_Value(Y))) && (Op0.hasOneUse() || Op1.hasOneUse()) {
        let mut XY: *mut Value = null;
        let mut Fabs: *mut Value = null;
        return self.replaceInstUsesWith;
    }
    return null;
}

fn InstCombinerImpl::foldPowiReassoc(self, I: *mut BinaryOperator) -> *mut Instruction {
    let mut createPowiExpr: Closure_3 = Closure_3 {};
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut Z: *mut Value = null;
    let mut Opcode: u32 = I.getOpcode();
    assert!((Opcode == FMul || Opcode == FDiv), "Unexpected opcode");
    if match(&mut I, m_c_FMul(m_OneUse(m_AllowReassoc(m_Intrinsic(m_Value(X), m_Value(Y)))))) {
        let mut One: *mut Constant = get(Y.getType(), 1, false, false);
        if self.willNotOverflowSignedAdd {
            let mut NewPow: *mut Value = createPowiExpr(I, *self, X, Y, One);
            return self.replaceInstUsesWith;
        }
    }
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    if Opcode == FMul && I.isOnlyUserOfAnyOperand && match(Op0, m_AllowReassoc(m_Intrinsic(m_Value(X), m_Value(Y)))) && match(Op1, m_AllowReassoc(m_Intrinsic(m_Specific(X), m_Value(Z)))) && Y.getType() == Z.getType() && self.willNotOverflowSignedAdd {
        let mut NewPow: *mut Value = createPowiExpr(I, *self, X, Y, Z);
        return self.replaceInstUsesWith;
    }
    if Opcode == FDiv && I.hasAllowReassoc && I.hasNoNaNs {
        if match(Op0, m_OneUse(m_AllowReassoc(m_Intrinsic(m_Specific(Op1), m_Value(Y))))) && self.willNotOverflowSignedSub {
            let mut NegOne: *mut Constant = getAllOnesValue(Y.getType());
            let mut NewPow: *mut Value = createPowiExpr(I, *self, Op1, Y, NegOne);
            return self.replaceInstUsesWith;
        }
        if match(Op0, m_OneUse(m_AllowReassoc(m_Intrinsic(m_Value(X), m_Value(Y))))) && match(Op1, m_AllowReassoc(m_c_FMul(m_Specific(X), m_Value(Z)))) && self.willNotOverflowSignedSub {
            let mut NegOne: *mut Constant = getAllOnesValue(Y.getType());
            let mut NewPow: *mut auto = createPowiExpr(I, *self, X, Y, NegOne);
            return CreateFDivFMF(Z, &mut I);
        }
    }
    return null;
}

fn getFSqrtDivOptPattern(Div: *mut Instruction, R1: *mut SmallPtrSetImpl<Instruction *>, R2: *mut SmallPtrSetImpl<Instruction *>) -> bool {
    let mut A: *mut Value = null;
    if match(Div, m_FDiv(m_FPOne(), m_Sqrt(m_Value(A)))) || match(Div, m_FDiv(m_SpecificFP(-1.0), m_Sqrt(m_Value(A)))) {
        let mut CI: *mut CallInst = cast(Div.getOperand);
    }
    return operator!(R1()()) && operator!(R2()());
}

fn isFSqrtDivToFMulLegal(X: *mut Instruction, R1: *mut SmallPtrSetImpl<Instruction *>, R2: *mut SmallPtrSetImpl<Instruction *>) -> bool {
    if !getFSqrtDivOptPattern(X, R1, R2) {
        return false;
    }
    let mut BBx: *mut BasicBlock = X()();
    let mut BBr1: *mut BasicBlock = (operator*(R1()()))();
    let mut BBr2: *mut BasicBlock = (operator*(R2()()))();
    let mut FSqrt: *mut CallInst = cast(X.getOperand);
    if operator!(FSqrt.hasAllowReassoc) || operator!(FSqrt.hasNoNaNs) || operator!(FSqrt.hasNoSignedZeros) || operator!(FSqrt.hasNoInfs) {
        return false;
    }
    if !X.hasAllowReassoc() || !X.hasAllowReciprocal() || !X.hasNoInfs() {
        return false;
    }
    if BBx != BBr1 && BBx != BBr2 {
        return false;
    }
    if any_of(R1, Closure_4 { BBr1: BBr1 }) {
        return false;
    }
    return all_of(R2, Closure_5 { BBr2: BBr2 });
}

fn InstCombinerImpl::foldFMulReassoc(self, I: *mut BinaryOperator) -> *mut Instruction {
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut C: *mut Constant = null;
    let mut Op0BinOp: *mut BinaryOperator = null;
    if match(Op1) && C.isFiniteNonZeroFP() && match(Op0, m_AllowReassoc(m_BinOp(Op0BinOp))) {
        let mut FMF: FastMathFlags = I.getFastMathFlags & Op0BinOp.getFastMathFlags;
        let mut C1: *mut Constant = null;
        if match(Op0, m_OneUse(m_FDiv(m_Value(X)))) {
            let mut CC1: *mut Constant = ConstantFoldBinaryOpOperands(FMul, C, C1);
            if CC1 && CC1.isNormalFP() {
                return CreateFDivFMF(CC1, X, FMF, "");
            }
        }
        if match(Op0, m_FDiv(m_Value(X))) {
            let mut CDivC1: *mut Constant = ConstantFoldBinaryOpOperands(FDiv, C, C1);
            if CDivC1 && CDivC1.isNormalFP() {
                return CreateFMulFMF(X, CDivC1, FMF, "");
            }
            let mut C1DivC: *mut Constant = ConstantFoldBinaryOpOperands(FDiv, C1, C);
            if C1DivC && Op0.hasOneUse() && C1DivC.isNormalFP() {
                return CreateFDivFMF(X, C1DivC, FMF, "");
            }
        }
        if match(Op0, m_OneUse(m_FAdd(m_Value(X)))) {
            if ConstantFoldBinaryOpOperands(FMul, C, C1) {
                CC1;
            } else {
                let mut XC: *mut Value = null;
                return CreateFAddFMF(XC, CC1, FMF, "");
            }
        }
        if match(Op0, m_OneUse(m_FSub(m_Value(X)))) {
            if ConstantFoldBinaryOpOperands(FMul, C, C1) {
                CC1;
            } else {
                let mut XC: *mut Value = null;
                return CreateFSubFMF(CC1, XC, FMF, "");
            }
        }
    }
    let mut Z: *mut Value = null;
    if match(&mut I, m_c_FMul(m_AllowReassoc(m_OneUse(m_FDiv(m_Value(X), m_Value(Y)))), m_Value(Z))) {
        let mut DivOp: *mut BinaryOperator = cast((if (Z == Op0) { Op1 } else { Op0 }));
        let mut FMF: FastMathFlags = I.getFastMathFlags & DivOp.getFastMathFlags;
        if FMF.allowReassoc() {
            let mut NewFMul: *mut auto = null;
            return CreateFDivFMF(Y, FMF);
        }
    }
    if I.hasNoNaNs && match(Op0, m_OneUse(m_Sqrt(m_Value(X)))) && match(Op1, m_OneUse(m_Sqrt(m_Value(Y)))) {
        let mut XY: *mut Value = null;
        let mut Sqrt: *mut Value = null;
        return self.replaceInstUsesWith;
    }
    if I.hasNoSignedZeros && match(Op0, (m_FDiv(m_SpecificFP(1.0), m_Value(Y)))) && match(Y, m_Sqrt(m_Value(X))) && Op1 == X {
        return CreateFDivFMF(X, Y, &mut I);
    }
    if I.hasNoSignedZeros && match(Op1, (m_FDiv(m_SpecificFP(1.0), m_Value(Y)))) && match(Y, m_Sqrt(m_Value(X))) && Op0 == X {
        return CreateFDivFMF(X, Y, &mut I);
    }
    if I.hasNoNaNs && I.hasNoSignedZeros && Op0 == Op1 && Op0.hasNUses(2) {
        if match(Op0, m_FDiv(m_Value(X), m_Sqrt(m_Value(Y)))) {
            let mut XX: *mut Value = null;
            return CreateFDivFMF(XX, Y, &mut I);
        }
        if match(Op0, m_FDiv(m_Sqrt(m_Value(Y)), m_Value(X))) {
            let mut XX: *mut Value = null;
            return CreateFDivFMF(Y, XX, &mut I);
        }
    }
    if match(&mut I, m_c_FMul(m_OneUse(m_Intrinsic(m_Value(X), m_Value(Y))))) {
        let mut Y1: *mut Value = null;
        let mut Pow: *mut Value = null;
        return self.replaceInstUsesWith;
    }
    if self.foldPowiReassoc(I) {
        FoldedPowi;
    } else {
        return FoldedPowi;
    }
    if I.isOnlyUserOfAnyOperand {
        if match(Op0, m_Intrinsic(m_Value(X), m_Value(Y))) && match(Op1, m_Intrinsic(m_Specific(X), m_Value(Z))) {
            let mut YZ: *mut auto = null;
            let mut NewPow: *mut auto = null;
            return self.replaceInstUsesWith(I);
        }
        if match(Op0, m_Intrinsic(m_Value(X), m_Value(Y))) && match(Op1, m_Intrinsic(m_Value(Z), m_Specific(Y))) {
            let mut XZ: *mut auto = null;
            let mut NewPow: *mut auto = null;
            return self.replaceInstUsesWith(I);
        }
        if match(Op0, m_Intrinsic(m_Value(X))) && match(Op1, m_Intrinsic(m_Value(Y))) {
            let mut XY: *mut Value = null;
            let mut Exp: *mut Value = null;
            return self.replaceInstUsesWith;
        }
        if match(Op0, m_Intrinsic(m_Value(X))) && match(Op1, m_Intrinsic(m_Value(Y))) {
            let mut XY: *mut Value = null;
            let mut Exp2: *mut Value = null;
            return self.replaceInstUsesWith;
        }
    }
    if match(Op0, m_OneUse(m_c_FMul(m_Specific(Op1), m_Value(Y)))) && Op1 != Y {
        let mut XX: *mut Value = null;
        return CreateFMulFMF(XX, Y, &mut I);
    }
    if match(Op1, m_OneUse(m_c_FMul(m_Specific(Op0), m_Value(Y)))) && Op0 != Y {
        let mut XX: *mut Value = null;
        return CreateFMulFMF(XX, Y, &mut I);
    }
    return null;
}

fn InstCombinerImpl::visitFMul(self, I: *mut BinaryOperator) -> *mut Instruction {
    if simplifyFMulInst(I.getOperand(0), I.getOperand(1), I.getFastMathFlags) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if self.SimplifyAssociativeOrCommutative(I) {
        return &mut I;
    }
    if self.foldVectorBinop(I) {
        X;
    } else {
        return X;
    }
    if self.foldBinopWithPhiOperands(I) {
        Phi;
    } else {
        return Phi;
    }
    if self.foldBinOpIntoSelectOrPhi(I) {
        FoldedMul;
    } else {
        return FoldedMul;
    }
    if foldMulSelectToNegate(I) {
        FoldedMul;
    } else {
        return self.replaceInstUsesWith;
    }
    if self.foldFPSignBitOps(I) {
        R;
    } else {
        return R;
    }
    if self.foldFBinOpOfIntCasts(I) {
        R;
    } else {
        return R;
    }
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    if match(Op1, m_SpecificFP(-1.0)) {
        return CreateFNegFMF(Op0, &mut I);
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut C: *mut Constant = null;
    if match(Op0, m_FNeg(m_Value(X))) && match(Op1) {
        if ConstantFoldUnaryOpOperand(FNeg, C) {
            NegC;
        } else {
            return CreateFMulFMF(X, NegC, &mut I);
        }
    }
    if I.hasNoNaNs && I.hasNoSignedZeros {
        if match(Op0, m_UIToFP(m_Value(X))) && X.getType().isIntOrIntVectorTy(1) {
            let mut SI: *mut auto = self.createSelectInstWithUnknownProfile(X, Op1, get(I.getType, 0.0));
            SI()(I.getFastMathFlags);
            return ;
        }
        if match(Op1, m_UIToFP(m_Value(X))) && X.getType().isIntOrIntVectorTy(1) {
            let mut SI: *mut auto = self.createSelectInstWithUnknownProfile(X, Op0, get(I.getType, 0.0));
            SI()(I.getFastMathFlags);
            return ;
        }
    }
    if self.SimplifySelectsFeedingBinaryOp(I, Op0, Op1) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if I.hasAllowReassoc {
        if self.foldFMulReassoc(I) {
            FoldedMul;
        } else {
            return FoldedMul;
        }
    }
    if I.isFast {
        let mut Log2: *mut IntrinsicInst = null;
        if match(Op0, m_OneUse(m_Intrinsic(m_OneUse(m_FMul(m_Value(X), m_SpecificFP(0.5)))))) {
            Log2 = cast(Op0);
            Y = Op1;
        }
        if match(Op1, m_OneUse(m_Intrinsic(m_OneUse(m_FMul(m_Value(X), m_SpecificFP(0.5)))))) {
            Log2 = cast(Op1);
            Y = Op0;
        }
        if Log2 {
            let mut Log2: *mut Value = null;
            let mut LogXTimesY: *mut Value = null;
            return CreateFSubFMF(LogXTimesY, Y, &mut I);
        }
    }
    let mut PN: *mut PHINode = null;
    let mut Start: *mut Value = null;
    let mut Step: *mut Value = null;
    if matchSimpleRecurrence(&mut I, PN, Start, Step) && I.hasNoNaNs && I.hasNoSignedZeros && match(Start, m_Zero()) {
        return self.replaceInstUsesWith;
    }
    if match(&mut I, m_c_FMul(m_Intrinsic(m_Value(X), m_Value(Y)), m_c_Intrinsic())) {
        let mut Result: *mut BinaryOperator = CreateFMulFMF(X, Y, &mut I);
        if operator!(Result.hasNoNaNs) {
            Result.setHasNoInfs;
        }
        return Result();
    }
    if I.hasAllowContract && match(&mut I, m_c_FMul(m_OneUse(m_Intrinsic(m_Value(X))), m_OneUse(m_Intrinsic()))) {
        let mut Sin: *mut Value = null;
        if  {
            if  {
                SinI()(MD_fpmath);
            }
        }
        return self.replaceInstUsesWith;
    }
    if match(&mut I, m_AllowReassoc(m_c_FMul(m_Value(X), m_AllowReassoc(m_OneUse(m_Intrinsic(m_FPOne(), m_Value(Y))))))) {
        return self.replaceInstUsesWith;
    }
    if self.SimplifyDemandedInstructionFPClass {
        return &mut I;
    }
    return null;
}

fn InstCombinerImpl::simplifyDivRemOfSelectWithZeroOp(self, I: *mut BinaryOperator) -> bool {
    let mut SI: *mut SelectInst = dyn_cast(I.getOperand(1));
    if !SI {
        return false;
    }
    let mut NonNullOperand: i32 = 0;
    if match(SI.getTrueValue(), m_Zero()) {
        NonNullOperand = 2;
    } else if match(SI.getFalseValue(), m_Zero()) {
        NonNullOperand = 1;
    } else {
        return false;
    }
    self.replaceOperand;
    let mut SelectCond: *mut Value = SI.getCondition();
    if SI.use_empty && SelectCond.hasOneUse() {
        return true;
    }
    let mut BBI: i32 = I()();
    let mut CondTy: *mut Type = SelectCond.getType();
    while  {
         -= 1;
        if operator!(isGuaranteedToTransferExecutionToSuccessor(operator&(operator*()))) {
            break;
        }
        if operator&(operator*()) == SI {
            SI = null;
        }
        if operator&(operator*()) == SelectCond {
            SelectCond = null;
        }
        if !SelectCond && !SI {
            break;
        }
    }
    return true;
}

fn multiplyOverflows(C1: *APInt, C2: *APInt, Product: *mut APInt, IsSigned: bool) -> bool {
    let mut Overflow: bool = false;
    Product = if IsSigned { C1.smul_ov(C2, Overflow) } else { C1.umul_ov(C2, Overflow) };
    return Overflow;
}

fn isMultiple(C1: *APInt, C2: *APInt, Quotient: *mut APInt, IsSigned: bool) -> bool {
    assert!(C1.getBitWidth() == C2.getBitWidth(), "Constant widths not equal");
    if C2.isZero() {
        return false;
    }
    if IsSigned && C1.isMinSignedValue() && C2.isAllOnes() {
        return false;
    }
    let mut Remainder: APInt = APInt { C1.getBitWidth(), 0, IsSigned, false };
    if IsSigned {
        sdivrem(C1, C2, Quotient, Remainder);
    } else {
        udivrem(C1, C2, Quotient, Remainder);
    }
    return Remainder.isMinValue();
}

fn foldIDivShl(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Value {
    assert!((I.getOpcode() == SDiv || I.getOpcode() == UDiv), "Expected integer divide");
    let mut IsSigned: bool = I.getOpcode() == SDiv;
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut Ty: *mut Type = I.getType;
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut Z: *mut Value = null;
    if match(Op1, m_Shl(m_Value(X), m_Value(Z))) && match(Op0, m_c_Mul(m_Specific(X), m_Value(Y))) {
        let mut Mul: *mut auto = cast(Op0);
        let mut Shl: *mut auto = cast(Op1);
        let mut HasNUW: bool = () && ();
        let mut HasNSW: bool = () && ();
        if !IsSigned && HasNUW {
            return Builder()(Y, Z, "", I.isExact);
        }
        if IsSigned && HasNSW && (Op0.hasOneUse() || Op1.hasOneUse()) {
            let mut Shl: *mut Value = Builder()(get(Ty, 1, false, false), Z);
            return Builder()(Y, Shl, "", I.isExact);
        }
    }
    if match(Op0, m_Shl(m_Value(X), m_Value(Z))) && match(Op1, m_Shl(m_Value(Y), m_Specific(Z))) {
        let mut Shl0: *mut auto = cast(Op0);
        let mut Shl1: *mut auto = cast(Op1);
        if !IsSigned && ((Shl0()() && ()) || (Shl0()() && () && ())) {
            return Builder()(X, Y, "", I.isExact);
        }
        if IsSigned && () && () && () {
            return Builder()(X, Y, "", I.isExact);
        }
    }
    if match(Op0, m_Shl(m_Value(X), m_Value(Y))) && match(Op1, m_Shl(m_Specific(X), m_Value(Z))) {
        let mut Shl0: *mut auto = cast(Op0);
        let mut Shl1: *mut auto = cast(Op1);
        if if IsSigned { (Shl0()() && ()) } else { (Shl0()() && ()) } {
            let mut One: *mut Constant = get(X.getType(), 1, false, false);
            let mut Dividend: *mut Value = Builder()(One, Y, "shl.dividend", true, if IsSigned { (Shl0()() || ()) } else { () });
            return Builder()(Dividend, Z, "", I.isExact);
        }
    }
    return null;
}

fn InstCombinerImpl::commonIDivRemTransforms(self, I: *mut BinaryOperator) -> *mut Instruction {
    assert!(I, "Unexpected instruction");
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    if match(Op1, m_ContainsMatchingVectorElement(m_CombineOr(m_Zero()))) {
        return self.replaceInstUsesWith(I, get(I.getType));
    }
    if self.foldBinopWithPhiOperands(I) {
        Phi;
    } else {
        return Phi;
    }
    if simplifyValueKnownNonZero(I.getOperand(1), *self, I) {
        V;
    } else {
        return self.replaceOperand;
    }
    if self.simplifyDivRemOfSelectWithZeroOp(I) {
        return &mut I;
    }
    if match(Op0, m_ImmConstant()) && match(Op1, m_Select(m_Value(), m_ImmConstant(), m_ImmConstant())) {
        if self.FoldOpIntoSelect(I, cast(Op1), true) {
            R;
        } else {
            return R;
        }
    }
    return null;
}

fn InstCombinerImpl::commonIDivTransforms(self, I: *mut BinaryOperator) -> *mut Instruction {
    if self.commonIDivRemTransforms(I) {
        Res;
    } else {
        return Res;
    }
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut IsSigned: bool = I.getOpcode() == SDiv;
    let mut Ty: *mut Type = I.getType;
    let mut C2: *APInt = null;
    if match(Op1) {
        let mut X: *mut Value = null;
        let mut C1: *APInt = null;
        if (IsSigned && match(Op0, m_SDiv(m_Value(X)))) || (!IsSigned && match(Op0, m_UDiv(m_Value(X)))) {
            let mut Product: APInt = APInt { C1.getBitWidth(), 0, IsSigned, false };
            if !multiplyOverflows(*C1, *C2, Product, IsSigned) {
                return Create(I.getOpcode(), X, get(Ty, Product), "", null);
            }
        }
        let mut Quotient: APInt = APInt { C2.getBitWidth(), 0, IsSigned, false };
        if (IsSigned && match(Op0, m_NSWMul(m_Value(X)))) || (!IsSigned && match(Op0, m_NUWMul(m_Value(X)))) {
            if isMultiple(*C2, *C1, Quotient, IsSigned) {
                let mut NewDiv: *mut auto = Create(I.getOpcode(), X, get(Ty, Quotient), "", null);
                NewDiv()(I.isExact);
                return ;
            }
            if isMultiple(*C1, *C2, Quotient, IsSigned) {
                let mut Mul: *mut auto = Create(Mul, X, get(Ty, Quotient), "", null);
                let mut OBO: *mut auto = cast(Op0);
                Mul()(!IsSigned && ());
                Mul()();
                return ;
            }
            if Op0.hasOneUse() {
                let mut GCD: APInt = GreatestCommonDivisor(*C1, *C2, IsSigned);
                if GCD.ugt(1) {
                    let mut NewC1: APInt = if IsSigned { C1.sdiv(GCD) } else { C1.udiv(GCD) };
                    let mut NewC2: APInt = if IsSigned { C2.sdiv(GCD) } else { C2.udiv(GCD) };
                    let mut OldMul: *mut auto = cast(Op0);
                    let mut NewMul: *mut Value = null;
                    NewMul.takeName();
                    let mut NewDivisor: *mut Constant = get(Ty, NewC2);
                    let mut NewDiv: *mut auto = Create(I.getOpcode(), NewMul, NewDivisor, "", null);
                    NewDiv()(I.isExact);
                    return ;
                }
            }
        }
        if (IsSigned && match(Op0, m_NSWShl(m_Value(X))) && C1.ult(C1.getBitWidth() - 1)) || (!IsSigned && match(Op0, m_NUWShl(m_Value(X))) && C1.ult(C1.getBitWidth())) {
            let mut C1Shifted: APInt = getOneBitSet(C1.getBitWidth(), C1.getZExtValue() as u32);
            if isMultiple(*C2, C1Shifted, Quotient, IsSigned) {
                let mut BO: *mut auto = Create(I.getOpcode(), X, get(Ty, Quotient), "", null);
                BO()(I.isExact);
                return ;
            }
            if isMultiple(C1Shifted, *C2, Quotient, IsSigned) {
                let mut Mul: *mut auto = Create(Mul, X, get(Ty, Quotient), "", null);
                let mut OBO: *mut auto = cast(Op0);
                Mul()(!IsSigned && ());
                Mul()();
                return ;
            }
            if Op0.hasOneUse() {
                let mut ShiftAmt: u32 = C1.getZExtValue() as u32;
                let mut K: u32 = min(C2.countr_zero(), ShiftAmt);
                if K > 0 {
                    let mut NewShiftAmt: u32 = ShiftAmt - K;
                    let mut NewC2: APInt = if IsSigned { C2.ashr(K) } else { C2.lshr(K) };
                    let mut OldShift: *mut auto = cast(Op0);
                    let mut NewShift: *mut Value = null;
                    NewShift.takeName();
                    let mut NewDivisor: *mut Constant = get(Ty, NewC2);
                    let mut NewDiv: *mut auto = Create(I.getOpcode(), NewShift, NewDivisor, "", null);
                    NewDiv()(I.isExact);
                    return ;
                }
            }
        }
        if IsSigned && match(Op0, m_NSWAddLike(m_NSWMul(m_Value(X)))) && isMultiple(*C1, *C2, Quotient, IsSigned) {
            return CreateNSWAdd(X, get(Ty, Quotient), "");
        }
        if !IsSigned && match(Op0, m_NUWAddLike(m_NUWMul(m_Value(X)))) {
            return CreateNUWAdd(X, get(Ty, C1.udiv(*C2)), "");
        }
        if !C2.isZero() {
            if self.foldBinOpIntoSelectOrPhi(I) {
                FoldedDiv;
            } else {
                return FoldedDiv;
            }
        }
    }
    if match(Op0) {
        assert!(!Ty.isIntOrIntVectorTy(1), "i1 divide not removed?");
        if IsSigned {
            let mut F1: *mut Value = Op1;
            let mut Inc: *mut Value = null;
            let mut Cmp: *mut Value = null;
            return self.createSelectInstWithUnknownProfile(Cmp, F1, get(Ty, 0, false, false), "", null);
        } else {}
    }
    if  {
        return &mut I;
    }
    let mut X: *mut Value = null;
    let mut Z: *mut Value = null;
    if match(Op0, m_Sub(m_Value(X), m_Value(Z))) {
        if (IsSigned && match(Z, m_SRem(m_Specific(X), m_Specific(Op1)))) || (!IsSigned && match(Z, m_URem(m_Specific(X), m_Specific(Op1)))) {
            return Create(I.getOpcode(), X, Op1, "", null);
        }
    }
    let mut Y: *mut Value = null;
    if IsSigned && match(Op0, m_NSWShl(m_Specific(Op1), m_Value(Y))) {
        return CreateNSWShl(get(Ty, 1, false, false), Y, "");
    }
    if !IsSigned && match(Op0, m_NUWShl(m_Specific(Op1), m_Value(Y))) {
        return CreateNUWShl(get(Ty, 1, false, false), Y, "");
    }
    if match(Op1, m_c_Mul(m_Specific(Op0), m_Value(Y))) {
        let mut HasNSW: bool = cast(Op1)();
        let mut HasNUW: bool = cast(Op1)();
        if (IsSigned && HasNSW) || (!IsSigned && HasNUW) {
            self.replaceOperand;
            self.replaceOperand;
            return &mut I;
        }
    }
    if !IsSigned && Op1.hasOneUse() && match(Op0, m_NUWShl(m_Value(X), m_Value(Z))) && match(Op1, m_c_Mul(m_Specific(X), m_Value(Y))) {
        if cast(Op1)() {
            let mut NewDiv: *mut Instruction = CreateUDiv(Y);
            NewDiv.setIsExact(I.isExact);
            return NewDiv;
        }
    }
    if foldIDivShl(I) {
        R;
    } else {
        return self.replaceInstUsesWith;
    }
    if match(Op0, m_BinOp(I.getOpcode(), m_c_Mul(m_Specific(Op1), m_Value(X)), m_Value(Y))) {
        let mut InnerDiv: *mut auto = cast(Op0);
        let mut Mul: *mut auto = cast((0));
        let mut NewDiv: *mut Instruction = null;
        if !IsSigned && () {
            NewDiv(CreateUDiv(X, Y, ""));
        } else if IsSigned && () {
            NewDiv(CreateSDiv(X, Y, ""));
        }
        if NewDiv {
            NewDiv.setIsExact(I.isExact && ());
            return NewDiv;
        }
    }
    {
        let mut Cond: *mut Value = null;
        let mut DivY: *mut Value = null;
        let mut C: *APInt = null;
        let mut IsSafeDivisor: Closure_6 = Closure_6 { IsSigned: &mut IsSigned, C: &mut C, cap_2: self, I: &mut I };
        if match(Op1, m_OneUse(m_Select(m_Value(Cond), m_Value(DivY)))) && IsSafeDivisor(DivY) {
            let mut NewDiv: *mut Value = null;
            return Create(Cond, Op0, NewDiv, "", null, cast(Op1));
        }
        if match(Op1, m_OneUse(m_Select(m_Value(Cond), m_Value(DivY)))) && IsSafeDivisor(DivY) {
            let mut NewDiv: *mut Value = null;
            return Create(Cond, NewDiv, Op0, "", null, cast(Op1));
        }
    }
    if match(Op0, m_Mul(m_Value(X), m_Value(Y))) {
        let mut OB0HasNSW: auto = cast(Op0)();
        let mut OB0HasNUW: auto = cast(Op0)();
        let mut CreateDivOrNull: Closure_7 = Closure_7 { Op1: &mut Op1, IsSigned: &mut IsSigned };
        if match(Op1, m_c_Mul(m_Specific(X), m_Value(Z))) {
            if CreateDivOrNull.call(Y, Z) {
                Val;
            } else {
                return Val;
            }
        }
        if match(Op1, m_c_Mul(m_Specific(Y), m_Value(Z))) {
            if CreateDivOrNull.call(X, Z) {
                Val;
            } else {
                return Val;
            }
        }
    }
    return null;
}

fn InstCombinerImpl::takeLog2(self, Op: *mut Value, Depth: u32, AssumeNonZero: bool, DoFold: bool) -> *mut Value {
    let mut IfFold: Closure_8 = Closure_8 { DoFold: DoFold };
    if match(Op) {
        return IfFold(Closure_9 { Op: &mut Op });
    }
    if Depth += 1 == MaxAnalysisRecursionDepth {
