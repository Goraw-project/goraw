fn convertFSqrtDivIntoFMul(CI: *mut CallInst, X: *mut Instruction, R1: *SmallPtrSetImpl<Instruction *>, R2: *SmallPtrSetImpl<Instruction *>, B: *mut BuilderTy, IC: *mut InstCombinerImpl) -> *mut Instruction {
    B()(X);
    let mut SqrtOp: *mut Value = CI.getArgOperand;
    let mut FDiv: *mut auto = cast(B()(get(X.getType, 1.0), SqrtOp));
    let mut R1FPMathMDNode: *mut auto = (operator*(R1()()))(MD_fpmath);
    let mut R1FMF: FastMathFlags = (operator*(R1()()))();
    FDiv()(MD_fpmath);
    FDiv()(R1FMF);
    let mut FSqrt: *mut auto = cast(CI.clone);
    FSqrt()(CI()());
    let mut R2FPMathMDNode: *mut auto = (operator*(R2()()))(MD_fpmath);
    let mut R2FMF: FastMathFlags = (operator*(R2()()))();
    FSqrt()(MD_fpmath);
    FSqrt()(R2FMF);
    let mut FMul: *mut Instruction = null;
    if match(X, m_FDiv(m_SpecificFP(-1.0), m_Specific(CI))) {
        let mut Mul: *mut Value = B()();
        FMul = cast(B()(Mul));
    } else {
        FMul = cast(B()());
    }
    FMul.copyMetadata(*X);
    FMul.copyFastMathFlags(intersectRewrite(R1FMF, R2FMF) | unionValue(R1FMF, R2FMF));
    return IC.replaceInstUsesWith;
}

fn InstCombinerImpl::visitFDiv(self, I: *mut BinaryOperator) -> *mut Instruction {
    let mut M: *mut Module = I;
    if simplifyFDivInst(I.getOperand(0), I.getOperand(1), I.getFastMathFlags) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if self.foldVectorBinop(I) {
        X;
    } else {
        return X;
    }
    if self.foldBinopWithPhiOperands(I) {
        Phi;
    } else {
        return Phi;
    }
    if self.foldFDivConstantDivisor(I) {
        R;
    } else {
        return R;
    }
    if foldFDivConstantDividend(I) {
        R;
    } else {
        return R;
    }
    if self.foldFPSignBitOps(I) {
        R;
    } else {
        return R;
    }
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut R1: SmallPtrSet<Instruction *, 2> = zeroed();
    let mut R2: SmallPtrSet<Instruction *, 2> = zeroed();
    if isFSqrtDivToFMulLegal(&mut I) {
        let mut CI: *mut CallInst = cast(I.getOperand(1));
        if convertFSqrtDivIntoFMul(CI, &mut I, self) {
            D;
        } else {
            return D;
        }
    }
    if isa(Op0) {
        if dyn_cast(Op1) {
            SI;
        } else if self.FoldOpIntoSelect {
            R;
        } else {
            return R;
        }
    }
    if isa(Op1) {
        if dyn_cast(Op0) {
            SI;
        } else if self.FoldOpIntoSelect {
            R;
        } else {
            return R;
        }
    }
    if I.hasAllowReassoc && I.hasAllowReciprocal {
        let mut X: *mut Value = null;
        let mut Y: *mut Value = null;
        if match(Op0, m_OneUse(m_FDiv(m_Value(X), m_Value(Y)))) && (!isa(Y) || !isa(Op1)) {
            let mut YZ: *mut Value = null;
            return CreateFDivFMF(X, YZ, &mut I);
        }
        if match(Op1, m_OneUse(m_FDiv(m_Value(X), m_Value(Y)))) && (!isa(Y) || !isa(Op0)) {
            let mut YZ: *mut Value = null;
            return CreateFDivFMF(YZ, X, &mut I);
        }
        if match(Op1, m_FDiv(m_SpecificFP(1.0), m_Value(Y))) {
            return CreateFMulFMF(Y, Op0, &mut I);
        }
    }
    if I.hasAllowReassoc && Op0.hasOneUse() && Op1.hasOneUse() {
        let mut X: *mut Value = null;
        let mut IsTan: bool = match(Op0, m_Intrinsic(m_Value(X))) && match(Op1, m_Intrinsic(m_Specific(X)));
        let mut IsCot: bool = !IsTan && match(Op0, m_Intrinsic(m_Value(X))) && match(Op1, m_Intrinsic(m_Specific(X)));
        if (IsTan || IsCot) && hasFloatFn(M, I.getType, LibFunc_tan, LibFunc_tanf, LibFunc_tanl) {
            let mut B: i32 = &mut I;
            B()(I.getFastMathFlags);
            let mut Attrs: AttributeList = cast(Op0)()();
            let mut Res: *mut Value = emitUnaryFloatFnCall(X, LibFunc_tan, LibFunc_tanf, LibFunc_tanl, Attrs);
            if IsCot {
                Res = (get(I.getType, 1.0), Res);
            }
            return self.replaceInstUsesWith;
        }
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if I.hasNoNaNs && I.hasAllowReassoc && match(Op1, m_c_FMul(m_Specific(Op0), m_Value(Y))) {
        self.replaceOperand(I, 0, get(I.getType, 1.0));
        self.replaceOperand;
        return &mut I;
    }
    if I.hasNoNaNs && I.hasNoInfs && (match(&mut I, m_FDiv(m_Value(X), m_FAbs())) || match(&mut I, m_FDiv(m_FAbs(m_Value(X))))) {
        let mut V: *mut Value = null;
        return self.replaceInstUsesWith;
    }
    if foldFDivPowDivisor(I) {
        Mul;
    } else {
        return Mul;
    }
    if foldFDivSqrtDivisor(I) {
        Mul;
    } else {
        return Mul;
    }
    if I.hasAllowReassoc && match(Op0, m_OneUse(m_Intrinsic(m_Specific(Op1), m_Value(Y)))) {
        let mut Y1: *mut Value = null;
        let mut Pow: *mut Value = null;
        return self.replaceInstUsesWith;
    }
    if self.foldPowiReassoc(I) {
        FoldedPowi;
    } else {
        return FoldedPowi;
    }
    return null;
}

fn simplifyIRemMulShl(I: *mut BinaryOperator, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut X: *mut Value = null;
    let mut Y: APInt = APInt {};
    let mut Z: APInt = APInt {};
    let mut ShiftByX: bool = false;
    let mut MatchShiftOrMulXC: Closure_20 = Closure_20 {};
    let mut MatchShiftCX: Closure_21 = Closure_21 {};
    let mut Op0PreserveNSW: bool = true;
    let mut Op1PreserveNSW: bool = true;
    if MatchShiftOrMulXC.call(Op0, X, Y, Op0PreserveNSW) && MatchShiftOrMulXC.call(Op1, X, Z, Op1PreserveNSW) {} else if MatchShiftCX.call(Op0, Y, X) && MatchShiftCX.call(Op1, Z, X) {
        ShiftByX = true;
    } else {
        return null;
    }
    let mut IsSRem: bool = I.getOpcode() == SRem;
    let mut BO0: *mut OverflowingBinaryOperator = cast(Op0);
    let mut BO0HasNSW: bool = Op0PreserveNSW && BO0.hasNoSignedWrap();
    let mut BO0HasNUW: bool = BO0.hasNoUnsignedWrap();
    let mut BO0NoWrap: bool = if IsSRem { BO0HasNSW } else { BO0HasNUW };
    let mut RemYZ: APInt = if IsSRem { Y.srem(Z) } else { Y.urem(Z) };
    if RemYZ.isZero() && BO0NoWrap {
        return IC.replaceInstUsesWith(I, getNullValue(I.getType));
    }
    let mut CreateMulOrShift: Closure_22 = Closure_22 { I: &mut I, ShiftByX: &mut ShiftByX, X: &mut X };
    let mut BO1: *mut OverflowingBinaryOperator = cast(Op1);
    let mut BO1HasNSW: bool = Op1PreserveNSW && BO1.hasNoSignedWrap();
    let mut BO1HasNUW: bool = BO1.hasNoUnsignedWrap();
    let mut BO1NoWrap: bool = if IsSRem { BO1HasNSW } else { BO1HasNUW };
    if RemYZ == Y && BO1NoWrap {
        let mut BO: *mut BinaryOperator = CreateMulOrShift.call(Y);
        BO.setHasNoSignedWrap;
        BO.setHasNoUnsignedWrap;
        return BO;
    }
    if Y.uge(Z) && (if IsSRem { (BO0HasNSW && BO1HasNSW) } else { BO0HasNUW }) {
        let mut BO: *mut BinaryOperator = CreateMulOrShift.call(RemYZ);
        BO.setHasNoSignedWrap;
        BO.setHasNoUnsignedWrap;
        return BO;
    }
    return null;
}

fn InstCombinerImpl::commonIRemTransforms(self, I: *mut BinaryOperator) -> *mut Instruction {
    if self.commonIDivRemTransforms(I) {
        Res;
    } else {
        return Res;
    }
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    if isa(Op1) {
        if dyn_cast(Op0) {
            Op0I;
        } else {
            if dyn_cast(Op0I) {
                SI;
            } else {
                if self.FoldOpIntoSelect {
                    R;
                } else {
                    return R;
                }
            }
            if  {
                return &mut I;
            }
        }
    }
    if simplifyIRemMulShl(I, *self) {
        R;
    } else {
        return R;
    }
    return null;
}

fn InstCombinerImpl::visitURem(self, I: *mut BinaryOperator) -> *mut Instruction {
    if simplifyURemInst(I.getOperand(0), I.getOperand(1)) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if self.foldVectorBinop(I) {
        X;
    } else {
        return X;
    }
    if self.commonIRemTransforms(I) {
        common;
    } else {
        return common;
    }
    if narrowUDivURem(I, *self) {
        NarrowRem;
    } else {
        return NarrowRem;
    }
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut Ty: *mut Type = I.getType;
    if self.isKnownToBeAPowerOfTwo {
        let mut N1: *mut Constant = getAllOnesValue(Ty);
        let mut Add: *mut Value = null;
        return CreateAnd(Op0, Add, "");
    }
    if match(Op0) {
        let mut Cmp: *mut Value = null;
        return CreateZExtOrBitCast(Cmp, Ty, "", null);
    }
    if match(Op1) {
        let mut F0: *mut Value = Op0;
        let mut Cmp: *mut Value = null;
        let mut Sub: *mut Value = null;
        return self.createSelectInstWithUnknownProfile(Cmp, F0, Sub, "", null);
    }
    let mut X: *mut Value = null;
    if match(Op1, m_SExt(m_Value(X))) && X.getType().isIntOrIntVectorTy(1) {
        let mut FrozenOp0: *mut Value = Op0;
        let mut Cmp: *mut Value = null;
        return self.createSelectInstWithUnknownProfile(Cmp, getNullValue(Ty), FrozenOp0, "", null);
    }
    if match(Op0, m_Add(m_Value(X))) {
        let mut Val: *mut Value = simplifyICmpInst(ICMP_ULT, X, Op1);
        if Val && match(Val) {
            let mut FrozenOp0: *mut Value = Op0;
            let mut Cmp: *mut Value = null;
            return self.createSelectInstWithUnknownProfile(Cmp, getNullValue(Ty), FrozenOp0, "", null);
        }
    }
    return null;
}

fn InstCombinerImpl::visitSRem(self, I: *mut BinaryOperator) -> *mut Instruction {
    if simplifySRemInst(I.getOperand(0), I.getOperand(1)) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if self.foldVectorBinop(I) {
        X;
    } else {
        return X;
    }
    if self.commonIRemTransforms(I) {
        Common;
    } else {
        return Common;
    }
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    {
        let mut Y: *APInt = null;
        if match(Op1) && !Y.isMinSignedValue() {
            return self.replaceOperand(I, 1, get(I.getType, operator(*Y)));
        }
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(&mut I, m_SRem(m_OneUse(m_NSWNeg(m_Value(X))), m_Value(Y))) {
        return CreateNSWNeg();
    }
    let mut Mask: APInt = getSignMask(I.getType());
    if self.MaskedValueIsZero && self.MaskedValueIsZero {
        return CreateURem(Op0, Op1, I.getName);
    }
    if isa(Op1) || isa(Op1) {
        let mut C: *mut Constant = cast(Op1);
        let mut VWidth: u32 = cast(C.getType())();
        let mut hasNegative: bool = false;
        let mut hasMissing: bool = false;
        for let mut i: u32 = 0; i != VWidth; i += 1 {
            let mut Elt: *mut Constant = C.getAggregateElement(i);
            if !Elt {
                hasMissing = true;
                break;
            }
            if dyn_cast(Elt) {
                RHS;
            } else if RHS.isNegative() {
                hasNegative = true;
            }
        }
        if hasNegative && !hasMissing {
            let mut Elts: SmallVector<Constant *, 16> = zeroed();
            for let mut i: u32 = 0; i != VWidth; i += 1 {
                Elts()[i] = C.getAggregateElement(i);
                if dyn_cast([i]) {
                    RHS;
                } else {
                    if RHS.isNegative() {
                        Elts()[i] = cast(getNeg(RHS, false));
                    }
                }
            }
            let mut NewRHSV: *mut Constant = get();
            if NewRHSV != C {
                return self.replaceOperand;
            }
        }
    }
    return null;
}

fn InstCombinerImpl::visitFRem(self, I: *mut BinaryOperator) -> *mut Instruction {
    if simplifyFRemInst(I.getOperand(0), I.getOperand(1), I.getFastMathFlags) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if self.foldVectorBinop(I) {
        X;
    } else {
        return X;
    }
    if self.foldBinopWithPhiOperands(I) {
        Phi;
    } else {
        return Phi;
    }
    return null;
}

