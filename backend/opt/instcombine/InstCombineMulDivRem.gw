unsafe fn Closure_2::call(self: *mut Closure_2, C: *APInt) -> bool {
            let mut Quot: APInt = APInt {};
            let mut Rem: APInt = APInt {};
            sdivrem(C, *(*self.C1), Quot, Rem);
            return Rem.isZero() && !Quot.isAllOnes();
        }

