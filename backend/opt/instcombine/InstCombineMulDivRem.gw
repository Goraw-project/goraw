struct Closure_25 {}

fn Closure_25::call(self: *mut Closure_25, Op: *mut Value, V: *mut *mut Value, C: *mut APInt, PreserveNSW: *mut bool) -> auto {
        let mut Tmp: *APInt = null;
        if (!V && match(Op, m_Mul(m_Value(V), m_APInt(Tmp)))) || (V && match(Op, m_Mul(m_Specific(V), m_APInt(Tmp)))) {
            C = *Tmp;
        } else if (!V && match(Op, m_Shl(m_Value(V), m_APInt(Tmp)))) || (V && match(Op, m_Shl(m_Specific(V), m_APInt(Tmp)))) {
            C = APInt { Tmp.getBitWidth(), 1, false, false } << *Tmp;
            PreserveNSW = Tmp.ult(Tmp.getBitWidth() - 1);
        }
        if Tmp != null {
            return true;
        }
        V = null;
        return false;
    }

struct Closure_26 {}

fn Closure_26::call(self: *mut Closure_26, Op: *mut Value, C: *mut APInt, V: *mut *mut Value) -> auto {
        let mut Tmp: *APInt = null;
        if (!V && match(Op, m_Shl(m_APInt(Tmp), m_Value(V)))) || (V && match(Op, m_Shl(m_APInt(Tmp), m_Specific(V)))) {
            C = *Tmp;
            return true;
        }
        V = null;
        return false;
    }

struct Closure_27 {
    I: *mut BinaryOperator,
    ShiftByX: *mut bool,
    X: *mut *mut Value,
}

unsafe fn Closure_27::call(self: *mut Closure_27, RemSimplificationC: *APInt) -> auto {
        let mut RemSimplification: *mut Value = get((*self.I).getType(), RemSimplificationC);
        return if (*self.ShiftByX) { CreateShl(RemSimplification, (*self.X), "") } else { CreateMul((*self.X), RemSimplification, "") };
    }
