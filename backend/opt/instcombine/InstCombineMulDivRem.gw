        return self.replaceInstUsesWith;
    }
    return null;
}

fn InstCombinerImpl::visitSDiv(self, I: *mut BinaryOperator) -> *mut Instruction {
    if simplifySDivInst(I.getOperand(0), I.getOperand(1), I.isExact) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if self.foldVectorBinop(I) {
        X;
    } else {
        return X;
