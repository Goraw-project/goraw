fn narrowUDivURem(I: *mut BinaryOperator, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut Opcode: BinaryOps = I.getOpcode();
    let mut N: *mut Value = I.getOperand(0);
    let mut D: *mut Value = I.getOperand(1);
    let mut Ty: *mut Type = I.getType;
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(N, m_ZExt(m_Value(X))) && match(D, m_ZExt(m_Value(Y))) && X.getType() == Y.getType() && (N.hasOneUse() || D.hasOneUse()) {
        let mut NarrowOp: *mut Value = IC()(Opcode, X, Y);
        return ZExtInst { NarrowOp, Ty, "", null };
    }
    let mut C: *mut Constant = null;
    let mut DL: *mut auto = IC.getDataLayout;
    if isa(N) && match(N, m_OneUse(m_ZExt(m_Value(X)))) && match(D) {
        let mut TruncC: *mut Constant = getLosslessUnsignedTrunc(C, X.getType());
        if !TruncC {
            return null;
        }
        return IC()(Opcode, X, TruncC);
    }
    if isa(D) && match(D, m_OneUse(m_ZExt(m_Value(X)))) && match(N) {
        let mut TruncC: *mut Constant = getLosslessUnsignedTrunc(C, X.getType());
        if !TruncC {
            return null;
        }
        return IC()(Opcode, TruncC, X);
    }
    return null;
}

fn InstCombinerImpl::visitUDiv(self, I: *mut BinaryOperator) -> *mut Instruction {
    if simplifyUDivInst(I.getOperand(0), I.getOperand(1), I.isExact) {
        V;
    } else {
