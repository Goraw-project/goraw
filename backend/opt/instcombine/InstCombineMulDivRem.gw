struct Closure_8 {
    IsSigned: *mut bool,
    C: *mut *APInt,
    cap_2: *mut InstCombinerImpl,
    I: *mut BinaryOperator,
}

unsafe fn Closure_8::call(self: *mut Closure_8, V: *mut Value) -> bool {
            if (*self.IsSigned) {
                return match(V, m_APInt((*self.C))) && !(*self.C).isZero() && !(*self.C).isAllOnes();
            }
            return isKnownNonZero(V, self.SQ.getWithInstruction(&mut (*self.I)), 0) && isGuaranteedNotToBePoison(V, self.SQ.AC, &mut (*self.I), self.SQ.DT, 0);
        }

struct Closure_9 {
    Op1: *mut *mut Value,
    IsSigned: *mut bool,
    OB0HasNSW: *mut bool,
    OB0HasNUW: *mut bool,
}

unsafe fn Closure_9::call(self: *mut Closure_9, A: *mut Value, B: *mut Value) -> auto {
            let mut OB1HasNSW: bool = cast((*self.Op1)).hasNoSignedWrap();
            let mut OB1HasNUW: bool = cast((*self.Op1)).hasNoUnsignedWrap();
            let mut C1: *APInt = null;
            let mut C2: *APInt = null;
            if (*self.IsSigned) && (*self.OB0HasNSW) {
                if OB1HasNSW && match(B, m_APInt(C1)) && !C1.isAllOnes() {
                    return CreateSDiv(A, B, "");
                }
            }
            if !(*self.IsSigned) && (*self.OB0HasNUW) {
                if OB1HasNUW {
                    return CreateUDiv(A, B, "");
                }
                if match(A, m_APInt(C1)) && match(B, m_APInt(C2)) && C2.ule(*C1) {
                    return CreateUDiv(A, B, "");
                }
            }
            return null;
        }

struct Closure_10 {
    DoFold: bool,
}

fn Closure_10::call(self: *Closure_10, Fn: function_ref<Value *()>) -> *mut Value {
        if !self.DoFold {
            return -1 as *mut Value;
        }
        return Fn.call();
    }

