    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut Ty: *mut Type = I.getType;
    let mut X: *mut Value = null;
    if match(Op1) || (match(Op1, m_SExt(m_Value(X))) && X.getType().isIntOrIntVectorTy(1)) {
        return CreateNSWNeg(Op0, "", null);
    }
    if I.isExact {
        if match(Op1) && match(Op1) {
            let mut C: *mut Constant = getExactLogBase2(cast(Op1));
