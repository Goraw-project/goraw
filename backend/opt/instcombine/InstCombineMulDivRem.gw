fn foldFDivPowDivisor(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut II: *mut auto = dyn_cast(Op1);
    if operator!() || operator!() || operator!(I.hasAllowReassoc) || operator!(I.hasAllowReciprocal) {
        return null;
    }
    let mut IID: ID = ();
    let mut Args: i32 = 0;
    match IID {
        pow => {
            Args()((0));
        },
        powi => {
            if operator!(I.hasNoInfs) {
                return null;
            }
            Args()((0));
            Args()(Builder()((1)));
            let mut Tys: []*mut Type = void { I.getType, (1)() };
            let mut Pow: *mut Value = Builder()(IID, Tys, &mut I);
            return CreateFMulFMF(Op0, Pow, &mut I);
        },
        exp => {
            exp2;
        },
        _ => {
            return null;
        },
    }
    let mut Pow: *mut Value = Builder()(IID, I.getType, &mut I);
    return CreateFMulFMF(Op0, Pow, &mut I);
}

fn foldFDivSqrtDivisor(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    if operator!(I.hasAllowReassoc) || operator!(I.hasAllowReciprocal) {
