        let mut B: i32 = &mut I;
        let mut CopySign: *mut Value = (copysign, void { C.getType() }, void { getInfinity(I.getType), I.getOperand(0) }, &mut I);
        CopySign.takeName;
        return self.replaceInstUsesWith;
    }
    if operator!((C.hasExactInverseFP() || (I.hasAllowReciprocal && C.isNormalFP()))) {
        return null;
    }
    let mut RecipC: *mut auto = ConstantFoldBinaryOpOperands(FDiv, get(I.getType, 1.0), C, DL);
    if operator!() || operator!() {
        return null;
    }
    return CreateFMulFMF(I.getOperand(0), &mut I);
}

fn foldFDivConstantDividend(I: *mut BinaryOperator) -> *mut Instruction {
    let mut C: *mut Constant = null;
