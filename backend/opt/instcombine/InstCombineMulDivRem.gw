struct Closure_20 {}

fn Closure_20::call(self: *mut Closure_20, Op: *mut Value, V: *mut *mut Value, C: *mut APInt, PreserveNSW: *mut bool) -> auto {
        let mut Tmp: *APInt = null;
        if (!V && match(Op, m_Mul(m_Value(V)))) || (V && match(Op, m_Mul(m_Specific(V)))) {
            C = *Tmp;
        } else if (!V && match(Op, m_Shl(m_Value(V)))) || (V && match(Op, m_Shl(m_Specific(V)))) {
            C = APInt { Tmp.getBitWidth(), 1, false, false } << *Tmp;
            PreserveNSW = Tmp.ult(Tmp.getBitWidth() - 1);
        }
        if Tmp != null {
            return true;
        }
        V = null;
        return false;
    }

struct Closure_21 {}

fn Closure_21::call(self: *mut Closure_21, Op: *mut Value, C: *mut APInt, V: *mut *mut Value) -> auto {
        let mut Tmp: *APInt = null;
        if (!V && match(Op, m_Shl(m_Value(V)))) || (V && match(Op, m_Shl(m_Specific(V)))) {
            C = *Tmp;
            return true;
        }
        V = null;
        return false;
    }

struct Closure_22 {
    I: *mut BinaryOperator,
    ShiftByX: *mut bool,
    X: *mut *mut Value,
}

unsafe fn Closure_22::call(self: *mut Closure_22, RemSimplificationC: *APInt) -> auto {
        let mut RemSimplification: *mut Value = get((*self.I).getType, RemSimplificationC);
        return if (*self.ShiftByX) { CreateShl(RemSimplification, (*self.X), "") } else { CreateMul((*self.X), RemSimplification, "") };
    }
