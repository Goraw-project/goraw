        if I.isExact && cast(Op0)() {
            NewDiv.setIsExact;
        }
        return NewDiv;
    }
    let mut Ty: *mut Type = I.getType;
    if isKnownNegative(Op1) {
        let mut Cmp: *mut Value = null;
        return CreateZExtOrBitCast(Cmp, Ty, "", null);
    }
    if match(Op1, m_SExt(m_Value(X))) && X.getType().isIntOrIntVectorTy(1) {
        let mut Cmp: *mut Value = null;
        return CreateZExtOrBitCast(Cmp, Ty, "", null);
    }
    if narrowUDivURem(I, *self) {
        NarrowDiv;
    } else {
        return NarrowDiv;
    }
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    if match(Op0, m_LShr(m_NUWMul(m_Specific(Op1), m_Value(A)), m_Value(B))) || match(Op0, m_LShr(m_NUWMul(m_Value(A), m_Specific(Op1)), m_Value(B))) {
