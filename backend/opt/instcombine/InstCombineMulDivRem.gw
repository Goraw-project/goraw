}

unsafe fn Closure_21::call(self: *mut Closure_21, Denom: *mut Value) -> auto {
        if self.tryGetLog2((*self.Op1), true) {
            Log2;
        } else {
            return Log2;
        }
        if self.isKnownToBeAPowerOfTwo(Denom, true, &mut (*self.I), 0) {
            return self.Builder.CreateBinaryIntrinsic(cttz, Denom, self.Builder.getTrue(), FMFSource {}, "");
        }
        return null;
    }

