        }
        let mut ShAmt: *mut Value = null;
        if match(Op1, m_NSWShl(m_Value(ShAmt))) {
            return CreateExactAShr(Op0, ShAmt, "");
        }
        if match(Op1) {
            let mut NegPow2C: *mut Constant = getNeg(cast(Op1));
            let mut C: *mut Constant = getExactLogBase2(NegPow2C);
            let mut Ashr: *mut Value = null;
            return CreateNSWNeg(Ashr, "", null);
        }
    }
    let mut Op1C: *APInt = null;
    if match(Op1) {
        let mut Op0Src: *mut Value = null;
        if match(Op0, m_OneUse(m_SExt(m_Value(Op0Src)))) && Op0Src.getType().getScalarSizeInBits() >= Op1C.getSignificantBits() {
            let mut NarrowDivisor: *mut Constant = getTrunc(cast(Op1), Op0Src.getType());
            let mut NarrowOp: *mut Value = null;
            return SExtInst { NarrowOp, Ty, "", null };
        }
        if !Op1C.isMinSignedValue() && match(Op0, m_NSWNeg(m_Value(X))) {
            let mut NegC: *mut Constant = get(Ty, operator((*Op1C)));
            let mut BO: *mut Instruction = CreateSDiv(X, NegC, "");
            BO.setIsExact(I.isExact);
            return BO;
        }
    }
    let mut Y: *mut Value = null;
    if self.dyn_castNegVal(Op0) {
        NegOp0;
    } else if self.dyn_castNegVal(Op1) {
        NegOp1;
    } else if operator!(()()) || (match(Op0, m_NSWNeg(m_Value())) && operator!()) {
        let mut BO: *mut BinaryOperator = CreateSDiv(NegOp0, NegOp1, "");
        BO.setIsExact(I.isExact);
        return BO;
    }
    if match(&mut I, m_SDiv(m_OneUse(m_NSWNeg(m_Value(X))), m_Value(Y))) {
        return CreateNSWNeg();
    }
    if match(&mut I, m_c_BinOp(m_OneUse(m_Intrinsic(m_Value(X))))) {
        let mut Cond: *mut Value = null;
        return self.createSelectInstWithUnknownProfile(Cond, get(Ty, 1, false, false), getAllOnesValue(Ty), "", null);
    }
    let mut KnownDividend: KnownBits = ;
    if operator!(I.isExact) && (match(Op1) || match(Op1)) && KnownDividend.countMinTrailingZeros() >= Op1C.countr_zero() {
        I.setIsExact;
        return &mut I;
    }
    if KnownDividend.isNonNegative() {
        if isKnownNonNegative(Op1) {
            let mut BO: *mut auto = CreateUDiv(Op0, Op1, I.getName);
            BO()(I.isExact);
            return ;
        }
        if match(Op1) {
            let mut CNegLog2: *mut Constant = getExactLogBase2(getNeg(cast(Op1)));
            let mut Shr: *mut Value = null;
            return CreateNeg(Shr, "", null);
        }
        if self.isKnownToBeAPowerOfTwo {
            let mut BO: *mut auto = CreateUDiv(Op0, Op1, I.getName);
            BO()(I.isExact);
            return ;
        }
    }
    if isKnownNegation(Op0, Op1, false, true) {
        let mut MinVal: APInt = getSignedMinValue(Ty.getScalarSizeInBits());
        let mut Cond: *mut Value = null;
        return self.createSelectInstWithUnknownProfile(Cond, get(Ty, 1, false, false), getAllOnesValue(Ty), "", null);
    }
    return null;
}

fn InstCombinerImpl::foldFDivConstantDivisor(self, I: *mut BinaryOperator) -> *mut Instruction {
    let mut C: *mut Constant = null;
