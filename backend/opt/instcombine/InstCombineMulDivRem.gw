    let mut C2: *mut Constant = null;
    let mut NewC: *mut Constant = null;
    if match(I.getOperand(1), m_FMul(m_Value(X))) {
        NewC = ConstantFoldBinaryOpOperands(FDiv, C, C2, DL);
    } else if match(I.getOperand(1), m_FDiv(m_Value(X))) {
        NewC = ConstantFoldBinaryOpOperands(FMul, C, C2, DL);
