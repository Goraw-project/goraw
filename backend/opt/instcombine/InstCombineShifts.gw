static mut ProfcheckDisableMetadataFixes: i32 = 0;

fn canTryToConstantAddTwoShiftAmounts(Sh0: *mut Value, ShAmt0: *mut Value, Sh1: *mut Value, ShAmt1: *mut Value) -> bool {
    if ShAmt0.getType() != ShAmt1.getType() {
        return false;
    }
    let mut MaximalPossibleTotalShiftAmount: u32 = (Sh0.getType().getScalarSizeInBits() - 1) + (Sh1.getType().getScalarSizeInBits() - 1);
    let mut MaximalRepresentableShiftAmount: APInt = getAllOnes(ShAmt0.getType().getScalarSizeInBits());
    return MaximalRepresentableShiftAmount.uge(MaximalPossibleTotalShiftAmount);
}

fn InstCombinerImpl::reassociateShiftAmtsOfTwoSameDirectionShifts(self, Sh0: *mut BinaryOperator, SQ: *SimplifyQuery, AnalyzeForSignBitExtraction: bool) -> *mut Value {
    let mut Sh0Op0: *mut Instruction = null;
    let mut ShAmt0: *mut Value = null;
    if operator!(match(Sh0, m_Shift(m_Instruction(Sh0Op0), m_ZExtOrSelf(m_Value(ShAmt0))))) {
        return null;
    }
    let mut Sh1: *mut Instruction = null;
    let mut Trunc: *mut Value = null;
    match(Sh0Op0, m_CombineOr(m_CombineAnd(m_Trunc(m_Instruction(Sh1)), m_Value(Trunc)), m_Instruction(Sh1)));
    let mut X: *mut Value = null;
    let mut ShAmt1: *mut Value = null;
    if operator!(match(Sh1, m_Shift(m_Value(X), m_ZExtOrSelf(m_Value(ShAmt1))))) {
        return null;
    }
    if !canTryToConstantAddTwoShiftAmounts(Sh0, ShAmt0, Sh1, ShAmt1) {
        return null;
    }
    let mut HadTwoRightShifts: bool = match(Sh0, m_Shr(m_Value(), m_Value())) && match(Sh1, m_Shr(m_Value(), m_Value()));
    if AnalyzeForSignBitExtraction && !HadTwoRightShifts {
        return null;
    }
    let mut ShiftOpcode: BinaryOps = Sh0.getOpcode();
    let mut IdenticalShOpcodes: bool = Sh0.getOpcode() == Sh1.getOpcode();
    if !IdenticalShOpcodes && !AnalyzeForSignBitExtraction {
        return null;
    }
    if Trunc && !AnalyzeForSignBitExtraction && operator!(match(Sh0, m_c_BinOp(m_OneUse(m_Value()), m_Value()))) {
        return null;
    }
    let mut NewShAmt: *mut auto = dyn_cast_or_null(simplifyAddInst(ShAmt0, ShAmt1, false, false, SQ.getWithInstruction));
    if operator!() {
        return null;
    }
    let mut NewShAmtBitWidth: u32 = ()();
    let mut XBitWidth: u32 = X.getType().getScalarSizeInBits();
    if operator!(match()) {
        return null;
    }
    if HadTwoRightShifts && (Trunc || AnalyzeForSignBitExtraction) {
        if operator!(match()) {
            return null;
        }
        if AnalyzeForSignBitExtraction {
            return X;
        }
    }
    assert!(IdenticalShOpcodes, "Should not get here with different shifts.");
    if NewShAmt()() != X.getType() {
        NewShAmt() = ConstantFoldCastOperand(ZExt, X.getType(), SQ.DL);
        if operator!() {
            return null;
        }
    }
    let mut NewShift: *mut BinaryOperator = Create(ShiftOpcode, X);
    if !Trunc {
        if ShiftOpcode == Shl {
            NewShift.setHasNoUnsignedWrap(Sh0.hasNoUnsignedWrap && Sh1.hasNoUnsignedWrap());
            NewShift.setHasNoSignedWrap(Sh0.hasNoSignedWrap && Sh1.hasNoSignedWrap());
        } else {
            NewShift.setIsExact(Sh0.isExact && Sh1.isExact());
        }
    }
    let mut Ret: *mut Instruction = NewShift();
    if Trunc {
        Ret = Create(Trunc, NewShift, Sh0.getType);
    }
    return Ret();
}

fn dropRedundantMaskingOfLeftShiftInput(OuterShift: *mut BinaryOperator, Q: *SimplifyQuery, Builder: *mut BuilderTy) -> *mut Instruction {
    assert!(OuterShift.getOpcode() == Shl, "The input must be 'shl'!");
    let mut Masked: *mut Value = null;
    let mut ShiftShAmt: *mut Value = null;
    match(OuterShift, m_Shift(m_Value(Masked), m_ZExtOrSelf(m_Value(ShiftShAmt))));
    let mut Trunc: *mut Value = null;
    if match(Masked, m_CombineAnd(m_Trunc(m_Value(Masked)), m_Value(Trunc))) && !Trunc.hasOneUse() {
        return null;
    }
    let mut NarrowestTy: *mut Type = OuterShift.getType;
    let mut WidestTy: *mut Type = Masked.getType();
    let mut HadTrunc: bool = WidestTy != NarrowestTy;
    if (WidestTy.getScalarSizeInBits() * 2) > MAX_INT_BITS {
        return null;
    }
    let mut ExtendedTy: *mut Type = WidestTy.getExtendedType();
    let mut MaskShAmt: *mut Value = null;
    let mut MaskA: auto = m_Add(m_Shl(m_Value(MaskShAmt)));
    let mut MaskB: auto = m_Not(m_Shl(m_Value(MaskShAmt)));
    let mut MaskC: auto = m_LShr(m_Value(MaskShAmt));
    let mut MaskD: auto = m_LShr(m_Shl(m_Value(MaskShAmt)));
    let mut X: *mut Value = null;
    let mut NewMask: *mut Constant = null;
    if match(Masked, m_c_And(m_CombineOr(), m_Value(X))) {
        match(MaskShAmt, m_ZExtOrSelf(m_Value(MaskShAmt)));
        if !canTryToConstantAddTwoShiftAmounts(OuterShift, ShiftShAmt, Masked, MaskShAmt) {
            return null;
        }
        let mut SumOfShAmts: *mut auto = dyn_cast_or_null(simplifyAddInst(MaskShAmt, ShiftShAmt, false, false, Q));
        if operator!() {
            return null;
        }
        SumOfShAmts() = replaceUndefsWith(get(()(), ExtendedTy.getScalarSizeInBits()));
        let mut ExtendedSumOfShAmts: *mut auto = ConstantFoldCastOperand(ZExt, ExtendedTy, Q.DL);
        if operator!() {
            return null;
        }
        let mut ExtendedAllOnes: *mut Constant = getAllOnesValue(ExtendedTy);
        let mut ExtendedInvertedMask: *mut Constant = ConstantFoldBinaryOpOperands(Shl, ExtendedAllOnes, Q.DL);
        if !ExtendedInvertedMask {
            return null;
        }
        NewMask = getNot(ExtendedInvertedMask);
    } else if match(Masked, m_c_And(m_CombineOr(), m_Value(X))) || match(Masked, m_Shr(m_Shl(m_Value(X), m_Value(MaskShAmt)))) {
        match(MaskShAmt, m_ZExtOrSelf(m_Value(MaskShAmt)));
        if !canTryToConstantAddTwoShiftAmounts(OuterShift, ShiftShAmt, Masked, MaskShAmt) {
            return null;
        }
        let mut ShAmtsDiff: *mut auto = dyn_cast_or_null(simplifySubInst(ShiftShAmt, MaskShAmt, false, false, Q));
        if operator!() {
            return null;
        }
        let mut WidestTyBitWidth: u32 = WidestTy.getScalarSizeInBits();
        ShAmtsDiff() = replaceUndefsWith(getSigned(()(), -WidestTyBitWidth as i32));
        let mut ExtendedNumHighBitsToClear: *mut auto = ConstantFoldCastOperand(ZExt, getSub(get(WidestTyBitWidth, false)), ExtendedTy, Q.DL);
        if operator!() {
            return null;
        }
        let mut ExtendedAllOnes: *mut Constant = getAllOnesValue(ExtendedTy);
        NewMask = ConstantFoldBinaryOpOperands(LShr, ExtendedAllOnes, Q.DL);
        if !NewMask {
            return null;
        }
    } else {
        return null;
    }
    NewMask = getTrunc(NewMask, NarrowestTy, false);
    let mut NeedMask: bool = operator!(match(NewMask));
    if NeedMask {
        if !Masked.hasOneUse() {
            return null;
        }
        if match(Masked, m_AShr(m_Value(), m_Value())) {
            return null;
        }
    }
    if HadTrunc {
        X = Builder()(X, NarrowestTy);
    }
    let mut NewShift: *mut BinaryOperator = Create(OuterShift.getOpcode(), X, OuterShift.getOperand(1), "", null);
    if !NeedMask {
        return NewShift;
    }
    Builder()(NewShift);
    return Create(And, NewShift, NewMask);
}

fn foldShiftOfShiftedBinOp(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    assert!(I, "Expected a shift as input");
    let mut BinInst: *mut auto = dyn_cast(I.getOperand(0));
    if operator!() || (operator!() && () != Add && () != Sub) || operator!() {
        return null;
    }
    let mut C0: *mut Constant = null;
    let mut C1: *mut Constant = null;
    if operator!(match(I.getOperand(1))) {
        return null;
    }
    let mut ShiftOpcode: BinaryOps = I.getOpcode();
    if (BinInst()() == Add || () == Sub) && ShiftOpcode != Shl {
        return null;
    }
    let mut Ty: *mut Type = I.getType;
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut matchFirstShift: Closure_1 = Closure_1 { Ty: &mut Ty, ShiftOpcode: &mut ShiftOpcode, X: &mut X, C0: &mut C0, C1: &mut C1 };
    let mut FirstShiftIsOp1: bool = false;
    if matchFirstShift((0), (1)) {
        Y = (1);
    } else if matchFirstShift((1), (0)) {
        Y = (0);
        FirstShiftIsOp1 = () == Sub;
    } else {
        return null;
    }
    let mut ShiftSumC: *mut Constant = getAdd(C0, C1, false, false);
    let mut NewShift1: *mut Value = Builder()(ShiftOpcode, X, ShiftSumC);
    let mut NewShift2: *mut Value = Builder()(ShiftOpcode, Y, C1);
    let mut Op1: *mut Value = if FirstShiftIsOp1 { NewShift2 } else { NewShift1 };
    let mut Op2: *mut Value = if FirstShiftIsOp1 { NewShift1 } else { NewShift2 };
    return Create(Op1, Op2);
}

fn InstCombinerImpl::commonShiftTransforms(self, I: *mut BinaryOperator) -> *mut Instruction {
    if self.foldBinopWithPhiOperands(I) {
        Phi;
    } else {
        return Phi;
    }
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    assert!(Op0.getType() == Op1.getType();
    let mut Ty: *mut Type = I.getType;
    let mut Y: *mut Value = null;
    if match(Op1, m_OneUse(m_SExt(m_Value(Y)))) {
        let mut NewExt: *mut Value = null;
        return Create(I.getOpcode(), Op0, NewExt, "", null);
    }
    if  {
        return &mut I;
    }
    if isa(Op0) {
        if dyn_cast(Op1) {
            SI;
        } else if self.FoldOpIntoSelect {
            R;
        } else {
            return R;
        }
    }
    let mut CUI: *mut Constant = null;
    if match(Op1, m_ImmConstant(CUI)) {
        if self.FoldShiftByConstant(Op0, CUI, I) {
            Res;
        } else {
            return Res;
        }
    }
    if  {
        return ;
    }
    let mut A: *mut Value = null;
    let mut C: *mut Constant = null;
    let mut C1: *mut Constant = null;
    if match(Op0) && match(Op1, m_NUWAddLike(m_Value(A))) {
        let mut NewC: *mut Value = null;
        let mut NewShiftOp: *mut BinaryOperator = Create(I.getOpcode(), NewC, A, "", null);
        if I.getOpcode() == Shl {
            NewShiftOp.setHasNoSignedWrap(I.hasNoSignedWrap);
            NewShiftOp.setHasNoUnsignedWrap(I.hasNoUnsignedWrap);
        } else {
            NewShiftOp.setIsExact(I.isExact);
        }
        return NewShiftOp;
    }
    let mut BitWidth: u32 = Ty.getScalarSizeInBits();
    let mut AC: *APInt = null;
    if match(Op0) {
        assert!(!AC.isZero(), "Expected simplify of shifted zero");
        let mut AddC: *APInt = null;
        if match(Op1, m_Add(m_Value(A))) && AddC.isNegative() && (operator(*AddC)).ult(BitWidth) {
            let mut PosOffset: u32 = (operator(*AddC)).getZExtValue();
            let mut isSuitableForPreShift: Closure_2 = Closure_2 { PosOffset: PosOffset, I: &mut I, AC: AC };
            if isSuitableForPreShift() {
                let mut NewC: *mut Constant = get(Ty, if I.getOpcode() == Shl { AC.lshr(PosOffset) } else { AC.shl(PosOffset) });
                let mut NewShiftOp: *mut BinaryOperator = Create(I.getOpcode(), NewC, A, "", null);
                if I.getOpcode() == Shl {
                    NewShiftOp.setHasNoUnsignedWrap(I.hasNoUnsignedWrap);
                } else {
                    NewShiftOp.setIsExact;
                }
                return NewShiftOp();
            }
        }
        let mut C2: u64 = 0;
        let mut X: *mut Value = null;
        if match(Op1, m_NUWSub(m_ConstantInt(C2), m_Value(X))) || (match(Op1, m_Xor(m_Value(X), m_ConstantInt(C2))) && (C2 | )()) {
            if I.getOpcode() == Shl {
                if AC.countl_zero() >= C2 {
                    return CreateExactLShr(get(Ty, AC.shl(C2)), X, "");
                }
                if AC.countl_one() > C2 {
                    return CreateExactAShr(get(Ty, AC.shl(C2)), X, "");
                }
            } else if AC.countr_zero() >= C2 {
                if AC.isSignBitClear() {
                    let mut Shl: *mut auto = CreateNUWShl(get(Ty, AC.lshr(C2)), X, "");
                    Shl()();
                    return ;
                }
                if I.getOpcode() == LShr {
                    return CreateNUWShl(get(Ty, AC.lshr(C2)), X, "");
                }
                return CreateNSWShl(get(Ty, AC.ashr(C2)), X, "");
            }
        }
    }
    if Op1.hasOneUse() && match(Op1, m_SRem(m_Value(A))) && match(C) {
        let mut Mask: *mut Constant = getSub(C, get(Ty, 1, false, false), false, false);
        let mut Rem: *mut Value = null;
        return self.replaceOperand;
    }
    if foldShiftOfShiftedBinOp(I) {
        Logic;
    } else {
        return Logic;
    }
    if match(Op1, m_Or(m_Value())) {
        return self.replaceOperand;
    }
    let mut CmpIntr: *mut Instruction = null;
    if (I.getOpcode() == LShr || I.getOpcode() == AShr) && match(Op0, m_OneUse(m_Instruction(CmpIntr))) && isa(CmpIntr) && match(Op1) {
        let mut Cmp: *mut Value = null;
        return Create(if I.getOpcode() == LShr { ZExt } else { SExt }, Cmp, Ty, "", null);
    }
    return null;
}

fn canEvaluateShiftedShift(OuterShAmt: u32, IsOuterShl: bool, Semantics: ShiftSemantics, InnerShift: *mut Instruction, IC: *mut InstCombinerImpl, CtxI: *mut Instruction) -> bool {
    assert!(InnerShift.isLogicalShift(), "Unexpected instruction type");
    let mut InnerShiftConst: *APInt = null;
    if operator!(match(InnerShift.getOperand)) {
        return false;
    }
    let mut IsInnerShl: bool = InnerShift.getOpcode() == Shl;
    if !IsOuterShl && Semantics == Signed {
        return IsInnerShl && cast(InnerShift)() && *InnerShiftConst == OuterShAmt;
    }
    if IsInnerShl == IsOuterShl {
        return Semantics == Lossy;
    }
    if *InnerShiftConst == OuterShAmt {
        return true;
    }
    let mut TypeWidth: u32 = InnerShift.getType();
    if InnerShiftConst.ugt(OuterShAmt) && InnerShiftConst.ult(TypeWidth) {
        let mut InnerShAmt: u32 = InnerShiftConst.getZExtValue();
        let mut MaskShift: u32 = if IsInnerShl { TypeWidth - InnerShAmt } else { InnerShAmt - OuterShAmt };
        let mut Mask: APInt = getLowBitsSet(TypeWidth, OuterShAmt) << MaskShift;
        if IC.MaskedValueIsZero(InnerShift.getOperand, Mask, CtxI) {
            return true;
        }
    }
    return false;
}

fn InstCombinerImpl::canEvaluateShifted(self, V: *mut Value, NumBits: u32, IsLeftShift: bool, Semantics: ShiftSemantics, CtxI: *mut Instruction) -> bool {
    if match(V, m_ImmConstant()) {
        if Semantics == Lossy {
            return true;
        }
        let mut C: *APInt = null;
        if match(V) && !IsLeftShift {
            return C.countr_zero() >= NumBits;
        }
        return false;
    }
    let mut I: *mut Instruction = dyn_cast(V);
    if !I {
        return false;
    }
    if operator!(I.hasOneUse) {
        return false;
    }
    match I.getOpcode() {
        _ => {
            return false;
        },
        And => {
            Or;
        },
        Shl => {
            LShr;
        },
        Select => {
            let mut SI: *mut SelectInst = cast(I);
            let mut TrueVal: *mut Value = SI.getTrueValue();
            let mut FalseVal: *mut Value = SI.getFalseValue();
            return self.canEvaluateShifted && self.canEvaluateShifted;
        },
        PHI => {
            let mut PN: *mut PHINode = cast(I);
            return true;
        },
        Mul => {
            let mut MulConst: *APInt = null;
            return !IsLeftShift && Semantics == Unsigned && match(I.getOperand) && MulConst.isNegatedPowerOf2() && MulConst.countr_zero() == NumBits;
        },
        Add => {
            let mut BinOp: *mut auto = cast(I);
            if IsLeftShift {
                if Semantics == Lossy {
                    return self.canEvaluateShifted(I.getOperand, NumBits, IsLeftShift, Semantics, I) && self.canEvaluateShifted(I.getOperand, NumBits, IsLeftShift, Semantics, I);
                }
                return false;
            }
            if Semantics == Lossy {
                return false;
            }
            let mut WrapRequired: bool = (Semantics == Signed && ()) || (Semantics == Unsigned && ());
            return WrapRequired && self.canEvaluateShifted(I.getOperand, NumBits, IsLeftShift, Semantics, I) && self.canEvaluateShifted(I.getOperand, NumBits, IsLeftShift, Semantics, I);
        },
    }
}

fn foldShiftedShift(InnerShift: *mut BinaryOperator, OuterShAmt: u32, IsOuterShl: bool, Semantics: ShiftSemantics, Builder: *mut BuilderTy) -> *mut Value {
    let mut IsInnerShl: bool = InnerShift.getOpcode() == Shl;
    let mut ShType: *mut Type = InnerShift.getType;
    let mut TypeWidth: u32 = ShType.getScalarSizeInBits();
    let mut C1: *APInt = null;
    match(InnerShift.getOperand(1));
    let mut InnerShAmt: u32 = C1.getZExtValue();
    let mut NewInnerShift: Closure_3 = Closure_3 { InnerShift: &mut InnerShift, ShType: &mut ShType, IsInnerShl: &mut IsInnerShl };
    if IsInnerShl == IsOuterShl {
        if InnerShAmt + OuterShAmt >= TypeWidth {
            return getNullValue(ShType);
        }
        return NewInnerShift.call(InnerShAmt + OuterShAmt);
    }
    if InnerShAmt == OuterShAmt {
        if !IsOuterShl && Semantics == Signed {
            (((operator!(operator!((IsInnerShl && InnerShift.hasNoSignedWrap && "Signed Semantics should have nsw and inner shl per canEvaluateShiftedShift")))) || (_wassert(L"IsInnerShl && InnerShift->hasNoSignedWrap() && \"Signed Semantics should have nsw and inner shl per \" \"canEvaluateShiftedShift\"", L"llvm\\lib\\Transforms\\InstCombine\\InstCombineShifts.cpp", (770) as u32) , 0)) as void);
            return InnerShift.getOperand(0);
        }
        if !IsOuterShl && Semantics == Unsigned && IsInnerShl && InnerShift.hasNoUnsignedWrap {
            return InnerShift.getOperand(0);
        }
        let mut Mask: APInt = if IsInnerShl { getLowBitsSet(TypeWidth, TypeWidth - OuterShAmt) } else { getHighBitsSet(TypeWidth, TypeWidth - OuterShAmt) };
        let mut And: *mut Value = Builder()(InnerShift.getOperand(0), get(ShType, Mask));
        if  {
            AndI()(InnerShift()());
            AndI()(InnerShift);
        }
        return And;
    }
    assert!(InnerShAmt > OuterShAmt, "Unexpected opposite direction logical shift pair");
    return NewInnerShift.call(InnerShAmt - OuterShAmt);
}

fn InstCombinerImpl::getShiftedValue(self, V: *mut Value, NumBits: u32, IsLeftShift: bool, Semantics: ShiftSemantics) -> *mut Value {
    if dyn_cast(V) {
        C;
    } else {
        let mut ShiftOp: BinaryOps = if IsLeftShift { Shl } else { (if Semantics == Signed { AShr } else { LShr }) };
    }
    let mut I: *mut Instruction = cast(V);
    self.addToWorklist;
    match I.getOpcode() {
        _ => {
            llvm_unreachable_internal("Inconsistency with CanEvaluateShifted", "llvm\\lib\\Transforms\\InstCombine\\InstCombineShifts.cpp", 818);
        },
        And => {
            Or;
        },
        Shl => {
            LShr;
        },
        Select => {
            I.setOperand(1, self.getShiftedValue(I.getOperand, NumBits, IsLeftShift, Semantics));
        },
        PHI => {
            let mut PN: *mut PHINode = cast(I);
            for let mut i: u32 = 0;
let mut e: u32 = PN.getNumIncomingValues(); i != e; i += 1 {
                PN.setIncomingValue(i, self.getShiftedValue(PN.getIncomingValue(i), NumBits, IsLeftShift, Semantics));
            }
            return PN();
        },
        Mul => {
            assert!(!IsLeftShift, "Unexpected shift direction!");
            let mut Neg: *mut auto = CreateNeg(I.getOperand);
            let mut TypeWidth: u32 = I.getType();
            let mut Mask: APInt = getLowBitsSet(TypeWidth, TypeWidth - NumBits);
            let mut And: *mut auto = CreateAnd(get(I.getType, Mask));
            And()(I);
        },
        Add => {
            if IsLeftShift {
                I.dropPoisonGeneratingFlags();
            }
            I.setOperand(0, self.getShiftedValue(I.getOperand, NumBits, IsLeftShift, Semantics));
            I.setOperand(1, self.getShiftedValue(I.getOperand, NumBits, IsLeftShift, Semantics));
            return I();
        },
    }
}

fn canShiftBinOpWithConstantRHS(Shift: *mut BinaryOperator, BO: *mut BinaryOperator) -> bool {
    match BO.getOpcode() {
        _ => {
            return false;
        },
        Add => {
            return Shift.getOpcode() == Shl;
        },
        Or => {
            And;
        },
        Xor => {
            return operator!((Shift.isLogicalShift && match(BO, m_Not(m_Value()))));
        },
    }
}

fn InstCombinerImpl::FoldShiftByConstant(self, Op0: *mut Value, C1: *mut Constant, I: *mut BinaryOperator) -> *mut Instruction {
    let mut C2: *mut Constant = null;
    let mut X: *mut Value = null;
    let mut IsLeftShift: bool = I.getOpcode() == Shl;
    if match(Op0, m_BinOp(I.getOpcode(), m_ImmConstant(C2), m_Value(X))) {
        let mut R: *mut Instruction = Create(I.getOpcode(), X);
        let mut BO0: *mut BinaryOperator = cast(Op0);
        if IsLeftShift {
            R.setHasNoUnsignedWrap(I.hasNoUnsignedWrap && BO0.hasNoUnsignedWrap);
            R.setHasNoSignedWrap(I.hasNoSignedWrap && BO0.hasNoSignedWrap);
        } else {
            R.setIsExact(I.isExact && BO0.isExact);
        }
        return R;
    }
    let mut Ty: *mut Type = I.getType;
    let mut TypeBits: u32 = Ty.getScalarSizeInBits();
    let mut DivC: *APInt = null;
    if !IsLeftShift && match(C1) && match(Op0, m_SDiv(m_Value(X))) && !DivC.isZero() && !DivC.isMinSignedValue() {
        let mut NegDivC: *mut Constant = get(Ty, operator((*DivC)));
        let mut Pred: Predicate = if DivC.isNegative() { ICMP_SGE } else { ICMP_SLE };
        let mut Cmp: *mut Value = null;
        let mut ExtOpcode: CastOps = if (I.getOpcode() == AShr) { SExt } else { ZExt };
        return Create(ExtOpcode, Cmp, Ty, "", null);
    }
    let mut Op1C: *APInt = null;
    if operator!(match(C1)) {
        return null;
    }
    assert!(!Op1C.uge(TypeBits), "Shift over the type width should have been removed already");
    if I.getOpcode() != AShr {
        let mut IsLeftShift: bool = I.getOpcode() == Shl;
        let mut Semantics: ShiftSemantics = if IsLeftShift { Lossy } else { Unsigned };
        if self.canEvaluateShifted {
            while true {
                {
                if DebugFlag && isCurrentDebugType("instcombine", 1) {
                    dbgs() << "ICE: GetShiftedValue propagating shift through expression to eliminate shift:\n  IN: " << *Op0 << "\n  SH: " << "\n";
                }
            }
                if !(false) { break; }
            }
            return self.replaceInstUsesWith;
        }
    }
    if self.foldBinOpIntoSelectOrPhi(I) {
        FoldedShift;
    } else {
        return FoldedShift;
    }
    if !Op0.hasOneUse() {
        return null;
    }
    if  {
        let mut Op0C: *APInt = null;
        if match((1)) {
            if canShiftBinOpWithConstantRHS(I) {
                let mut NewRHS: *mut Value = null;
                let mut NewShift: *mut Value = null;
                NewShift.takeName();
                return Create(NewShift, NewRHS);
            }
        }
    }
    let mut Cond: *mut Value = null;
    let mut TBO: *mut BinaryOperator = null;
    let mut FalseVal: *mut Value = null;
    if match(Op0, m_Select(m_Value(Cond), m_OneUse(m_BinOp(TBO)), m_Value(FalseVal))) {
        let mut C: *APInt = null;
        if !isa(FalseVal) && TBO.getOperand(0) == FalseVal && match(TBO.getOperand(1)) && canShiftBinOpWithConstantRHS(I, TBO) {
            let mut NewRHS: *mut Value = null;
            let mut NewShift: *mut Value = null;
            let mut NewOp: *mut Value = null;
            return Create(Cond, NewOp, NewShift, "", null, if  { null } else { cast(Op0) });
        }
    }
    let mut FBO: *mut BinaryOperator = null;
    let mut TrueVal: *mut Value = null;
    if match(Op0, m_Select(m_Value(Cond), m_Value(TrueVal), m_OneUse(m_BinOp(FBO)))) {
        let mut C: *APInt = null;
        if !isa(TrueVal) && FBO.getOperand(0) == TrueVal && match(FBO.getOperand(1)) && canShiftBinOpWithConstantRHS(I, FBO) {
            let mut NewRHS: *mut Value = null;
            let mut NewShift: *mut Value = null;
            let mut NewOp: *mut Value = null;
            return Create(Cond, NewShift, NewOp, "", null, if  { null } else { cast(Op0) });
        }
    }
    return null;
}

fn InstCombinerImpl::foldLShrOverflowBit(self, I: *mut BinaryOperator) -> *mut Instruction {
    assert!(I.getOpcode() == LShr);
    let mut Add: *mut Value = I.getOperand(0);
    let mut ShiftAmt: *mut Value = I.getOperand(1);
    let mut Ty: *mut Type = I.getType;
    if Ty.getScalarSizeInBits() < 3 {
        return null;
    }
    let mut ShAmtAPInt: *APInt = null;
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if operator!(match(ShiftAmt)) || operator!(match(Add, m_Add(m_OneUse(m_ZExt(m_Value(X))), m_OneUse(m_ZExt(m_Value(Y)))))) {
        return null;
    }
    let mut ShAmt: u32 = ShAmtAPInt.getZExtValue();
    if ShAmt == 1 {
        return null;
    }
    if X.getType().getScalarSizeInBits() != ShAmt || Y.getType().getScalarSizeInBits() != ShAmt {
        return null;
    }
    if !Add.hasOneUse() {}
    let mut AddInst: *mut Instruction = cast(Add);
    let mut NarrowAdd: *mut Value = null;
    let mut Overflow: *mut Value = null;
    if !Add.hasOneUse() {
        self.replaceInstUsesWith;
        self.eraseInstFromFunction(*AddInst);
    }
    return ZExtInst { Overflow, Ty, "", null };
}

fn setShiftFlags(I: *mut BinaryOperator, Q: *SimplifyQuery) -> bool {
    assert!(I, "Expected a shift as input");
    if I.getOpcode() == Shl {
        if I.hasNoUnsignedWrap && I.hasNoSignedWrap {
            return false;
        }
    } else {
        if I.isExact {
            return false;
        }
        if match(I.getOperand(0), m_Shl(m_Value(), m_Specific(I.getOperand(1)))) {
            I.setIsExact;
            return true;
        }
        if match(I.getOperand(1), m_Cttz(m_Specific(I.getOperand(0)), m_Value())) {
            I.setIsExact;
            return true;
        }
    }
    let mut KnownCnt: KnownBits = computeKnownBits(I.getOperand(1), Q, 0);
    let mut BitWidth: u32 = KnownCnt.getBitWidth();
    let mut MaxCnt: u64 = KnownCnt.getMaxValue().getLimitedValue(BitWidth - 1);
    let mut KnownAmt: KnownBits = computeKnownBits(I.getOperand(0), Q, 0);
    let mut Changed: bool = false;
    if I.getOpcode() == Shl {
        if operator!(I.hasNoUnsignedWrap) && MaxCnt <= KnownAmt.countMinLeadingZeros() {
            I.setHasNoUnsignedWrap;
            Changed = true;
        }
        if operator!(I.hasNoSignedWrap) {
            if MaxCnt < KnownAmt.countMinSignBits() || MaxCnt < ComputeNumSignBits(I.getOperand(0), Q.DL, Q.AC, Q.CtxI, Q.DT, true, 0) {
                I.setHasNoSignedWrap;
                Changed = true;
            }
        }
        return Changed;
    }
    Changed = MaxCnt <= KnownAmt.countMinTrailingZeros();
    I.setIsExact;
    return Changed;
}

fn InstCombinerImpl::visitShl(self, I: *mut BinaryOperator) -> *mut Instruction {
    let mut Q: SimplifyQuery = zeroed();
    if simplifyShlInst(I.getOperand(0), I.getOperand(1), I.hasNoSignedWrap, I.hasNoUnsignedWrap, Q) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if self.foldVectorBinop(I) {
        X;
    } else {
        return X;
    }
    if self.commonShiftTransforms(I) {
        V;
    } else {
        return V;
    }
    if dropRedundantMaskingOfLeftShiftInput(&mut I, Q) {
        V;
    } else {
        return V;
    }
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut Ty: *mut Type = I.getType;
    let mut BitWidth: u32 = Ty.getScalarSizeInBits();
    let mut C: *APInt = null;
    if match(Op1) {
        let mut ShAmtC: u32 = C.getZExtValue();
        let mut X: *mut Value = null;
        if match(Op0, m_OneUse(m_ZExt(m_Value(X)))) {
            let mut SrcWidth: u32 = X.getType().getScalarSizeInBits();
        }
        if match(Op0, m_Shr(m_Value(X), m_Specific(Op1))) {
            let mut Mask: APInt = getHighBitsSet(BitWidth, BitWidth - ShAmtC);
            return CreateAnd(X, get(Ty, Mask), "");
        }
        let mut C1: *APInt = null;
        if match(Op0, m_Exact(m_Shr(m_Value(X)))) && C1.ult(BitWidth) {
            let mut ShrAmt: u32 = C1.getZExtValue();
            if ShrAmt < ShAmtC {
                let mut ShiftDiff: *mut Constant = get(Ty, ShAmtC - ShrAmt, false, false);
                let mut NewShl: *mut auto = CreateShl(X, ShiftDiff, "");
                NewShl()(I.hasNoUnsignedWrap || (ShrAmt && cast(Op0)() == LShr && I.hasNoSignedWrap));
                NewShl()(I.hasNoSignedWrap);
                return ;
            }
            if ShrAmt > ShAmtC {
                let mut ShiftDiff: *mut Constant = get(Ty, ShrAmt - ShAmtC, false, false);
                let mut NewShr: *mut auto = Create(cast(Op0)(), X, ShiftDiff);
                NewShr()(true);
                return ;
            }
        }
        if match(Op0, m_OneUse(m_Shr(m_Value(X)))) && C1.ult(BitWidth) {
            let mut ShrAmt: u32 = C1.getZExtValue();
            if ShrAmt < ShAmtC {
                let mut ShiftDiff: *mut Constant = get(Ty, ShAmtC - ShrAmt, false, false);
                let mut NewShl: *mut auto = CreateShl(X, ShiftDiff, "");
                NewShl()(I.hasNoUnsignedWrap || (ShrAmt && cast(Op0)() == LShr && I.hasNoSignedWrap));
                NewShl()(I.hasNoSignedWrap);
                let mut Mask: APInt = getHighBitsSet(BitWidth, BitWidth - ShAmtC);
                return CreateAnd(get(Ty, Mask));
            }
            if ShrAmt > ShAmtC {
                let mut ShiftDiff: *mut Constant = get(Ty, ShrAmt - ShAmtC, false, false);
                let mut OldShr: *mut auto = cast(Op0);
                let mut NewShr: *mut auto = Create(X, ShiftDiff);
                NewShr()();
                let mut Mask: APInt = getHighBitsSet(BitWidth, BitWidth - ShAmtC);
                return CreateAnd(get(Ty, Mask));
            }
        }
        let mut Shr: *mut BinaryOperator = null;
        if match(Op0, m_OneUse(m_Trunc(m_OneUse(m_BinOp(Shr))))) && match(Shr, m_Shr(m_Value(X))) {
            let mut ShrAmtC: u32 = C1.getZExtValue();
            let mut ShDiff: u32 = if ShrAmtC > ShAmtC { ShrAmtC - ShAmtC } else { ShAmtC - ShrAmtC };
            let mut ShiftDiffC: *mut Constant = get(X.getType(), ShDiff, false, false);
            let mut ShiftOpc: BinaryOps = if ShrAmtC > ShAmtC { Shr.getOpcode() } else { Shl };
            let mut NewShift: *mut Value = null;
            let mut Trunc: *mut Value = null;
            let mut Mask: APInt = getHighBitsSet(BitWidth, BitWidth - ShAmtC);
            return CreateAnd(Trunc, get(Ty, Mask), "");
        }
        let mut isSuitableBinOpcode: Closure_4 = Closure_4 {};
        let mut Op0BO: *mut BinaryOperator = null;
        if match(Op0, m_OneUse(m_BinOp(Op0BO))) && isSuitableBinOpcode.call(Op0BO.getOpcode()) {
            let mut Shr: *mut Value = Op0BO.getOperand(0);
            let mut Y: *mut Value = Op0BO.getOperand(1);
            let mut X: *mut Value = null;
            let mut CC: *APInt = null;
            if Op0BO && Y.hasOneUse() && (match(Y, m_Shr(m_Value(), m_Specific(Op1))) || match(Y, m_And(m_OneUse(m_Shr(m_Value(), m_Specific(Op1)))))) {
                swap(Shr, Y);
            }
            if match(Shr, m_OneUse(m_Shr(m_Value(X), m_Specific(Op1)))) {
                let mut YS: *mut Value = null;
                let mut B: *mut Value = null;
                let mut Op1Val: u32 = C.getLimitedValue(BitWidth);
                let mut Bits: APInt = getHighBitsSet(BitWidth, BitWidth - Op1Val);
                let mut Mask: *mut Constant = get(Ty, Bits);
                return CreateAnd(B, Mask, "");
            }
            if match(Shr, m_OneUse(m_And(m_OneUse(m_Shr(m_Value(X), m_Specific(Op1)))))) {
                let mut YS: *mut Value = null;
                let mut M: *mut Value = null;
                let mut NewOp: *mut BinaryOperator = Create(Op0BO.getOpcode(), M, YS, "", null);
                let mut Disjoint: *mut auto = dyn_cast(Op0BO);
                if Disjoint() && () {
                    cast(NewOp)(true);
                }
                return NewOp;
            }
        }
        if match(Op0, m_OneUse(m_Sub(m_Value(X)))) {
            let mut NewLHS: *mut Constant = get(Ty, C1.shl(*C));
            let mut NewShift: *mut Value = null;
            return CreateSub(NewLHS, NewShift, "");
        }
    }
    if setShiftFlags(I, Q) {
        return &mut I;
    }
    let mut X: *mut Value = null;
    if match(Op0, m_OneUse(m_Shr(m_Value(X), m_Specific(Op1)))) {
        let mut AllOnes: *mut Constant = getAllOnesValue(Ty);
        let mut Mask: *mut Value = null;
        return CreateAnd(Mask, X, "");
    }
    if match(Op0, m_LShr(m_Specific(Op1))) {
        let mut AllOnes: *mut Constant = getAllOnesValue(Ty);
        return CreateShl(AllOnes, Op1, "");
    }
    let mut C1: *mut Constant = null;
    if match(Op1, m_ImmConstant(C1)) {
        let mut C2: *mut Constant = null;
        let mut X: *mut Value = null;
        if match(Op0, m_Mul(m_Value(X), m_ImmConstant(C2))) {
            return CreateMul(X);
        }
        if match(Op0, m_ZExt(m_Value(X))) && X.getType().isIntOrIntVectorTy(1) {
            let mut NewC: *mut auto = null;
            return self.createSelectInstWithUnknownProfile(X, getNullValue(Ty));
        }
    }
    if match(Op0) {
        if match(Op1, m_Sub(m_Value(X))) {
            return CreateLShr(get(Ty, getSignMask(BitWidth)), X, "");
        }
        if match(Op1, m_OneUse(m_Cttz(m_Value(X), m_Value()))) {
            let mut NegX: *mut Value = null;
            return CreateAnd(NegX, X, "");
        }
    }
    if match(Op1, m_OneUse(m_Cttz(m_Value(X), m_Value()))) {
        let mut NegX: *mut Value = null;
        let mut LowBit: *mut Value = null;
        let mut Mul: *mut BinaryOperator = CreateMul(LowBit, Op0, "");
        if I.hasNoUnsignedWrap {
            Mul.setHasNoUnsignedWrap;
        }
        return Mul;
    }
    return null;
}

fn InstCombinerImpl::visitLShr(self, I: *mut BinaryOperator) -> *mut Instruction {
    if simplifyLShrInst(I.getOperand(0), I.getOperand(1), I.isExact) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if self.foldVectorBinop(I) {
        X;
    } else {
        return X;
    }
    if self.commonShiftTransforms(I) {
        R;
    } else {
        return R;
    }
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut Ty: *mut Type = I.getType;
    let mut X: *mut Value = null;
    let mut C: *APInt = null;
    let mut BitWidth: u32 = Ty.getScalarSizeInBits();
    let mut Y: *mut Value = null;
    if I.isExact && match(Op0, m_OneUse(m_NUWSub(m_NUWShl(m_Value(X), m_Specific(Op1)), m_Value(Y)))) {
        let mut NewLshr: *mut Value = null;
        let mut NewSub: *mut BinaryOperator = CreateNUWSub(X, NewLshr, "");
        NewSub.setHasNoSignedWrap(cast(Op0)());
        return NewSub;
    }
    if match(Op0, m_Add(m_Value(X), m_Value(Y))) && match(Op1) && () <= 1 && () <= 1 {
        return CreateAnd(X, Y, "");
    }
    if I.isExact && match(Op0, m_OneUse(m_NUWSub(m_Value(X), m_NUWShl(m_Value(Y), m_Specific(Op1))))) {
        let mut NewLshr: *mut Value = null;
        let mut NewSub: *mut BinaryOperator = CreateNUWSub(NewLshr, Y, "");
        NewSub.setHasNoSignedWrap(cast(Op0)());
        return NewSub;
    }
    let mut isSuitableBinOpcode: Closure_5 = Closure_5 {};
    if match(Op0, m_OneUse(m_c_BinOp(m_NUWShl(m_Value(X), m_Specific(Op1)), m_Value(Y)))) {
        let mut Op0OB: *mut BinaryOperator = cast(Op0);
        if isSuitableBinOpcode.call(Op0OB.getOpcode()) {
            let mut OBO: *mut auto = dyn_cast(Op0);
            if operator!() || () {
                let mut NewLshr: *mut Value = null;
                let mut NewBinOp: *mut auto = Create(Op0OB.getOpcode(), NewLshr, X, "", null);
                if OBO() {
                    NewBinOp()(true);
                    NewBinOp()();
                } else if  {
                    cast()();
                }
                return ;
            }
        }
    }
    if match(Op1) {
        let mut ShAmtC: u32 = C.getZExtValue();
        let mut II: *mut auto = dyn_cast(Op0);
        if II() && isPowerOf2_32(BitWidth) && Log2_32(BitWidth) == ShAmtC && (II()() == ctlz || () == cttz || () == ctpop) {
            let mut IsPop: bool = () == ctpop;
            let mut RHS: *mut Constant = getSigned(Ty, if IsPop { -1 } else { 0 }, false);
            let mut Cmp: *mut Value = null;
            return ZExtInst { Cmp, Ty, "", null };
        }
        let mut C1: *APInt = null;
        if match(Op0, m_Shl(m_Value(X))) && C1.ult(BitWidth) {
            if C1.ult(ShAmtC) {
                let mut ShlAmtC: u32 = C1.getZExtValue();
                let mut ShiftDiff: *mut Constant = get(Ty, ShAmtC - ShlAmtC, false, false);
                if cast(Op0)() {
                    let mut NewLShr: *mut auto = CreateLShr(X, ShiftDiff, "");
                    NewLShr()(I.isExact);
                    return ;
                }
                if Op0.hasOneUse() {
                    let mut NewLShr: *mut Value = null;
                    let mut Mask: APInt = getLowBitsSet(BitWidth, BitWidth - ShAmtC);
                    return CreateAnd(NewLShr, get(Ty, Mask), "");
                }
            } else if C1.ugt(ShAmtC) {
                let mut ShlAmtC: u32 = C1.getZExtValue();
                let mut ShiftDiff: *mut Constant = get(Ty, ShlAmtC - ShAmtC, false, false);
                if cast(Op0)() {
                    let mut NewShl: *mut auto = CreateShl(X, ShiftDiff, "");
                    NewShl()(true);
                    NewShl()(ShAmtC > 0);
                    return ;
                }
                if Op0.hasOneUse() {
                    let mut NewShl: *mut Value = null;
                    let mut Mask: APInt = getLowBitsSet(BitWidth, BitWidth - ShAmtC);
                    return CreateAnd(NewShl, get(Ty, Mask), "");
                }
            } else {
                assert!(*C1 == ShAmtC);
                let mut Mask: APInt = getLowBitsSet(BitWidth, BitWidth - ShAmtC);
                return CreateAnd(X, get(Ty, Mask), "");
            }
        }
        if match(Op0, m_OneUse(m_c_Add(m_OneUse(m_Shl(m_Value(X), m_Specific(Op1))), m_Value(Y)))) {
            let mut NewLshr: *mut Value = null;
            let mut NewAdd: *mut Value = null;
            let mut Op1Val: u32 = C.getLimitedValue(BitWidth);
            let mut Bits: APInt = getLowBitsSet(BitWidth, BitWidth - Op1Val);
            let mut Mask: *mut Constant = get(Ty, Bits);
            return CreateAnd(NewAdd, Mask, "");
        }
        if match(Op0, m_OneUse(m_ZExt(m_Value(X)))) && (!Ty.isIntegerTy() || self.shouldChangeType(Ty, X.getType())) {
            assert!(ShAmtC < X.getType().getScalarSizeInBits(), "Big shift not simplified to zero?");
            let mut NewLShr: *mut Value = null;
            return ZExtInst { NewLShr, Ty, "", null };
        }
        if match(Op0, m_SExt(m_Value(X))) {
            let mut SrcTyBitWidth: u32 = X.getType().getScalarSizeInBits();
            if SrcTyBitWidth == 1 {
                let mut NewC: *mut auto = get(Ty, getLowBitsSet(BitWidth, BitWidth - ShAmtC));
                return Create(X, getNullValue(Ty));
            }
            if (!Ty.isIntegerTy() || self.shouldChangeType(Ty, X.getType())) && Op0.hasOneUse() {
                if ShAmtC == BitWidth - 1 {
                    let mut NewLShr: *mut Value = null;
                    return ZExtInst { NewLShr, Ty, "", null };
                }
                if ShAmtC == BitWidth - SrcTyBitWidth {
                    let mut NewShAmt: u32 = min(ShAmtC, SrcTyBitWidth - 1);
                    let mut AShr: *mut Value = null;
                    return ZExtInst { AShr, Ty, "", null };
                }
            }
        }
        if ShAmtC == BitWidth - 1 {
            if match(Op0, m_OneUse(m_SRem(m_Value(X)))) {
                let mut Signbit: *mut Value = null;
                return CreateAnd(Signbit, X, "");
            }
        }
        let mut TruncSrc: *mut Instruction = null;
        if match(Op0, m_OneUse(m_Trunc(m_Instruction(TruncSrc)))) && match(TruncSrc, m_LShr(m_Value(X))) {
            let mut SrcWidth: u32 = X.getType().getScalarSizeInBits();
            let mut AmtSum: u32 = ShAmtC + C1.getZExtValue();
            if AmtSum < SrcWidth && (TruncSrc.hasOneUse || C1.uge(SrcWidth - BitWidth)) {
                let mut SumShift: *mut Value = null;
                let mut Trunc: *mut Value = null;
                let mut MaskC: APInt = getAllOnes(BitWidth).lshr(ShAmtC);
                return CreateAnd(Trunc, get(Ty, MaskC), "");
            }
        }
        let mut MulC: *APInt = null;
        if match(Op0, m_NUWMul(m_Value(X))) {
            if BitWidth > 2 && (*MulC - 1).isPowerOf2() && MulC.logBase2() == ShAmtC {
                if ShAmtC * 2 == BitWidth {
                    return self.replaceInstUsesWith;
                }
                if Op0.hasOneUse() {
                    let mut NewAdd: *mut auto = CreateNUWAdd(X);
                    NewAdd()(cast(Op0)());
                    return ;
                }
            }
            if Op0.hasOneUse() {
                let mut NewMulC: APInt = MulC.lshr(ShAmtC);
                if MulC.eq(NewMulC.shl(ShAmtC)) {
                    let mut NewMul: *mut auto = CreateNUWMul(X, get(Ty, NewMulC), "");
                    assert!(ShAmtC != 0, "lshr X, 0 should be handled by simplifyLShrInst.");
                    NewMul()(true);
                    return ;
                }
            }
        }
        if match(Op0, m_OneUse(m_NSWMul(m_Value(X)))) {
            if BitWidth > 2 && (*MulC - 1).isPowerOf2() && MulC.logBase2() == ShAmtC {
                return CreateNSWAdd(X);
            }
        }
        if match(Op0, m_OneUse(m_Intrinsic(m_OneUse(m_ZExt(m_Value(X)))))) {
            let mut SrcWidth: u32 = X.getType().getScalarSizeInBits();
            let mut WidthDiff: u32 = BitWidth - SrcWidth;
            if SrcWidth % 16 == 0 {
                let mut NarrowSwap: *mut Value = null;
                if ShAmtC >= WidthDiff {
                    let mut NewShift: *mut Value = null;
                    return ZExtInst { NewShift, Ty, "", null };
                } else {
                    let mut NewZExt: *mut Value = null;
                    let mut ShiftDiff: *mut Constant = get(Ty, WidthDiff - ShAmtC, false, false);
                    return CreateShl(NewZExt, ShiftDiff, "");
                }
            }
        }
        let mut BoolX: *mut Value = null;
        let mut BoolY: *mut Value = null;
        if ShAmtC == 1 && match(Op0, m_Add(m_Value(X), m_Value(Y))) && match(X, m_ZExt(m_Value(BoolX))) && match(Y, m_ZExt(m_Value(BoolY))) && BoolX.getType().isIntOrIntVectorTy(1) && BoolY.getType().isIntOrIntVectorTy(1) && (X.hasOneUse() || Y.hasOneUse() || Op0.hasOneUse()) {
            let mut And: *mut Value = null;
            return ZExtInst { And, Ty, "", null };
        }
    }
    let mut Q: SimplifyQuery = zeroed();
    if setShiftFlags(I, Q) {
        return &mut I;
    }
    if match(Op0, m_OneUse(m_Shl(m_Value(X), m_Specific(Op1)))) {
        let mut AllOnes: *mut Constant = getAllOnesValue(Ty);
        let mut Mask: *mut Value = null;
        return CreateAnd(Mask, X, "");
    }
    if match(Op0, m_Shl(m_Specific(Op1))) {
        let mut AllOnes: *mut Constant = getAllOnesValue(Ty);
        return CreateLShr(AllOnes, Op1, "");
    }
    if self.foldLShrOverflowBit(I) {
        Overflow;
    } else {
        return Overflow;
    }
    let mut Shl0_Op0: *mut Value = null;
    let mut Shl0_Op1: *mut Value = null;
    let mut Shl1_Op1: *mut Value = null;
    let mut Shl1: *mut BinaryOperator = null;
    if match(Op0, m_Shl(m_Value(Shl0_Op0), m_Value(Shl0_Op1))) && match(Op1, m_Cttz(m_BinOp(Shl1), m_Value())) && match(Shl1, m_Shl(m_Specific(Shl0_Op0), m_Value(Shl1_Op1))) && self.isKnownToBeAPowerOfTwo {
        let mut Shl0: *mut auto = cast(Op0);
        let mut HasNUW: bool = () && Shl1.hasNoUnsignedWrap;
        let mut HasNSW: bool = () && Shl1.hasNoSignedWrap;
        if HasNUW || HasNSW {
            let mut NewShl: *mut Value = null;
            return CreateLShr(NewShl, Shl1_Op1, "");
        }
    }
    return null;
}

fn InstCombinerImpl::foldVariableSignZeroExtensionOfVariableHighBitExtract(self, OldAShr: *mut BinaryOperator) -> *mut Instruction {
    assert!(OldAShr.getOpcode() == AShr, "Must be called with arithmetic right-shift instruction only.");
    let mut BitWidthSplat: Closure_6 = Closure_6 {};
    let mut NBits: *mut Value = null;
    let mut MaybeTrunc: *mut Instruction = null;
    let mut C1: *mut Constant = null;
    let mut C2: *mut Constant = null;
    if operator!(match(&mut OldAShr, m_AShr(m_Shl(m_Instruction(MaybeTrunc), m_ZExtOrSelf(m_Sub(m_ZExtOrSelf(m_Value(NBits))))), m_ZExtOrSelf(m_Sub(m_ZExtOrSelf()))))) || operator!(BitWidthSplat(C1, &mut OldAShr)) || operator!(BitWidthSplat(C2, &mut OldAShr)) {
        return null;
    }
    let mut HighBitExtract: *mut Instruction = null;
    match(MaybeTrunc, m_TruncOrSelf(m_Instruction(HighBitExtract)));
    let mut HadTrunc: bool = MaybeTrunc != HighBitExtract;
    let mut X: *mut Value = null;
    let mut NumLowBitsToSkip: *mut Value = null;
    if operator!(match(HighBitExtract, m_Shr(m_Value(X), m_Value(NumLowBitsToSkip)))) {
        return null;
    }
    let mut C0: *mut Constant = null;
    if operator!(match(NumLowBitsToSkip, m_ZExtOrSelf(m_Sub(m_ZExtOrSelf(m_Specific(NBits)))))) || operator!(BitWidthSplat(C0, HighBitExtract)) {
        return null;
    }
    if HighBitExtract.getOpcode() == OldAShr.getOpcode() {
        return self.replaceInstUsesWith;
    }
    if HadTrunc && operator!(match(&mut OldAShr, m_c_BinOp(m_OneUse(m_Value()), m_Value()))) {
        return null;
    }
    let mut NewAShr: *mut Instruction = Create(OldAShr.getOpcode(), X, NumLowBitsToSkip, "", null);
    NewAShr.copyIRFlags;
    if !HadTrunc {
        return NewAShr;
    }
    return CreateTruncOrBitCast(NewAShr, OldAShr.getType);
}

fn InstCombinerImpl::visitAShr(self, I: *mut BinaryOperator) -> *mut Instruction {
    if simplifyAShrInst(I.getOperand(0), I.getOperand(1), I.isExact) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if self.foldVectorBinop(I) {
        X;
    } else {
        return X;
    }
    if self.commonShiftTransforms(I) {
        R;
    } else {
        return R;
    }
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut Ty: *mut Type = I.getType;
    let mut BitWidth: u32 = Ty.getScalarSizeInBits();
    let mut ShAmtAPInt: *APInt = null;
    if match(Op1) && ShAmtAPInt.ult(BitWidth) {
        let mut ShAmt: u32 = ShAmtAPInt.getZExtValue();
        let mut X: *mut Value = null;
        if match(Op0, m_Shl(m_ZExt(m_Value(X)), m_Specific(Op1))) && ShAmt == BitWidth - X.getType().getScalarSizeInBits() {
            return SExtInst { X, Ty, "", null };
        }
        let mut ShOp1: *APInt = null;
        if match(Op0, m_NSWShl(m_Value(X))) && ShOp1.ult(BitWidth) {
            let mut ShlAmt: u32 = ShOp1.getZExtValue();
            if ShlAmt < ShAmt {
                let mut ShiftDiff: *mut Constant = get(Ty, ShAmt - ShlAmt, false, false);
                let mut NewAShr: *mut auto = CreateAShr(X, ShiftDiff, "");
                NewAShr()(I.isExact);
                return ;
            }
            if ShlAmt > ShAmt {
                let mut ShiftDiff: *mut Constant = get(Ty, ShlAmt - ShAmt, false, false);
                let mut NewShl: *mut auto = Create(Shl, X, ShiftDiff, "", null);
                NewShl()(true);
                return ;
            }
        }
        if match(Op0, m_AShr(m_Value(X))) && ShOp1.ult(BitWidth) {
            let mut AmtSum: u32 = ShAmt + ShOp1.getZExtValue();
            AmtSum = min(AmtSum, BitWidth - 1);
            return CreateAShr(X, get(Ty, AmtSum, false, false), "");
        }
        if match(Op0, m_OneUse(m_SExt(m_Value(X)))) && (Ty.isVectorTy() || self.shouldChangeType(Ty, X.getType())) {
            let mut SrcTy: *mut Type = X.getType();
            ShAmt = min(ShAmt, SrcTy.getScalarSizeInBits() - 1);
            let mut NewSh: *mut Value = null;
            return SExtInst { NewSh, Ty, "", null };
        }
        if ShAmt == BitWidth - 1 {
            let mut Y: *mut Value = null;
        }
        let mut MulC: *APInt = null;
        if match(Op0, m_OneUse(m_NSWMul(m_Value(X)))) && (BitWidth > 2 && (*MulC - 1).isPowerOf2() && MulC.logBase2() == ShAmt && (ShAmt < BitWidth - 1)) {
            let mut NewAdd: *mut auto = CreateNSWAdd(X);
            NewAdd()(cast(Op0)());
            return ;
        }
    }
    let mut Q: SimplifyQuery = zeroed();
    if setShiftFlags(I, Q) {
        return &mut I;
    }
    let mut X: *mut Value = null;
    if match(Op1) && match(Op0, m_OneUse(m_Shl(m_Value(X)))) {
        let mut Mask: *mut Constant = get(Ty, 1, false, false);
        Mask = mergeUndefsWith(mergeUndefsWith(Mask, cast(Op1)), cast(cast(Op0)(1)));
        return CreateNeg(X, "", null);
    }
    if self.foldVariableSignZeroExtensionOfVariableHighBitExtract(I) {
        R;
    } else {
        return R;
    }
    if self.MaskedValueIsZero {
        let mut Lshr: *mut Instruction = CreateLShr(Op0, Op1, "");
        Lshr.setIsExact(I.isExact);
        return Lshr;
    }
    if match(Op0, m_OneUse(m_Not(m_Value(X)))) {
        let mut NewAShr: *mut auto = null;
        return CreateNot();
    }
    return null;
}

struct Closure_1 {
    Ty: *mut *mut Type,
    ShiftOpcode: *mut BinaryOps,
    X: *mut *mut Value,
    C0: *mut *mut Constant,
    C1: *mut *mut Constant,
}

unsafe fn Closure_1::call(self: *mut Closure_1, V: *mut Value, W: *mut Value) -> auto {
        let mut Size: u32 = (*self.Ty).getScalarSizeInBits();
        let mut Threshold: APInt = APInt { Size, Size, false, false };
    }

