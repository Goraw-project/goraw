struct Closure_3 {
    InnerShift: *mut *mut BinaryOperator,
    ShType: *mut *mut Type,
    IsInnerShl: *mut bool,
}

unsafe fn Closure_3::call(self: *mut Closure_3, ShAmt: u32) -> *mut BinaryOperator {
        (*self.InnerShift).setOperand(1, get((*self.ShType), ShAmt, false, false));
        if (*self.IsInnerShl) {
            (*self.InnerShift).setHasNoUnsignedWrap;
            (*self.InnerShift).setHasNoSignedWrap;
        } else {
            (*self.InnerShift).setIsExact;
        }
        return (*self.InnerShift);
    }

