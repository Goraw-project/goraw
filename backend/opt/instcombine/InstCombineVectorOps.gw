    if V == LHS {
        for let mut i: u32 = 0; i != NumElts; i += 1 {
            Mask()(i);
        }
        return true;
    }
    if V == RHS {
        for let mut i: u32 = 0; i != NumElts; i += 1 {
            Mask()(i + NumElts);
        }
        return true;
    }
    if dyn_cast(V) {
        IEI;
    } else {
        let mut VecOp: *mut Value = IEI.getOperand(0);
        let mut ScalarOp: *mut Value = IEI.getOperand(1);
        let mut IdxOp: *mut Value = IEI.getOperand(2);
        if !isa(IdxOp) {
            return false;
        }
        let mut InsertedIdx: u32 = cast(IdxOp)();
        if isa(ScalarOp) {
            if collectSingleShuffleElements(VecOp, LHS, RHS, Mask) {
                return true;
            }
        } else if dyn_cast(ScalarOp) {
