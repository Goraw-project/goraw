        ShuffleVector => {
            let mut Shuffle: *mut ShuffleVectorInst = cast(UserInstr);
            let mut MaskNumElts: u32 = cast(UserInstr.getType)();
            return true;
        },
        _ => {
            break;
        },
    }
    return false;
}

fn findDemandedEltsByAllUsers(V: *mut Value) -> APInt {
    let mut VWidth: u32 = cast(V.getType())();
    let mut UnionUsedElts: APInt = APInt { VWidth, 0, false, false };
    return UnionUsedElts;
}

fn getPreferredVectorIndex(IndexC: *mut ConstantInt) -> *mut ConstantInt {
    let mut IndexBW: u32 = IndexC.getBitWidth();
    if IndexBW == 64 || IndexC.getValue().getActiveBits() > 64 {
