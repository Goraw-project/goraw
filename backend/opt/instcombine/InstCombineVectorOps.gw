                let mut ExtractedIdx: u32 = cast(EI.getOperand(1))();
                let mut NumLHSElts: u32 = cast(LHS.getType())();
                if EI.getOperand(0) == LHS || EI.getOperand(0) == RHS {
                    if collectSingleShuffleElements(VecOp, LHS, RHS, Mask) {
                        if EI.getOperand(0) == LHS {} else {
                            assert!(EI.getOperand(0) == RHS);
                        }
                        return true;
                    }
                }
            }
        }
    }
    return false;
}

