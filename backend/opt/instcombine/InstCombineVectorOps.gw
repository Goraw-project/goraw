                    let mut NumLHSElts: u32 = cast(RHS.getType())();
                }
                if VecOp == PermittedRHS {
                    let mut NumLHSElts: u32 = cast(EI.getOperand(0).getType())();
                    for let mut i: u32 = 0; i != NumElts; i += 1 {
                        Mask()(if i == InsertedIdx { ExtractedIdx } else { NumLHSElts + i });
                    }
