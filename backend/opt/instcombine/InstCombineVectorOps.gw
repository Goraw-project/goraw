fn findDemandedEltsBySingleUser(V: *mut Value, UserInstr: *mut Instruction, UnionUsedElts: *mut APInt) -> bool {
    let mut VWidth: u32 = cast(V.getType())();
    match UserInstr.getOpcode() {
