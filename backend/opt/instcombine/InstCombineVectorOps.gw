static mut NumAggregateReconstructionsSimplified: Statistic = Statistic { "instcombine", "NumAggregateReconstructionsSimplified", "Number of aggregate reconstructions turned into reuse of the original aggregate" };

fn cheapToScalarize(V: *mut Value, EI: *mut Value) -> bool {
    let mut CEI: *mut ConstantInt = dyn_cast(EI);
    if dyn_cast(V) {
        C;
    } else {
        return CEI || C.getSplatValue(false);
    }
    if CEI && match(V, m_Intrinsic()) {
        let mut EC: ElementCount = cast(V.getType()).getElementCount();
        return CEI.getValue().ult(EC.getKnownMinValue());
    }
    if match(V, m_InsertElt(m_Value(), m_Value(), m_ConstantInt())) {
        return CEI;
    }
    if match(V, m_OneUse(m_Load(m_Value()))) {
        return true;
    }
    if match(V, m_OneUse(m_UnOp())) {
        return true;
    }
    let mut V0: *mut Value = null;
    let mut V1: *mut Value = null;
    if match(V, m_OneUse(m_BinOp(m_Value(V0), m_Value(V1)))) {
        if cheapToScalarize(V0, EI) || cheapToScalarize(V1, EI) {
            return true;
        }
    }
    let mut UnusedPred: CmpPredicate = CmpPredicate {};
    if match(V, m_OneUse(m_Cmp(UnusedPred, m_Value(V0), m_Value(V1)))) {
        if cheapToScalarize(V0, EI) || cheapToScalarize(V1, EI) {
            return true;
        }
    }
    return false;
}

fn InstCombinerImpl::scalarizePHI(self, EI: *mut ExtractElementInst, PN: *mut PHINode) -> *mut Instruction {
    let mut Extracts: SmallVector<Instruction *, 2> = SmallVector<Instruction *, 2> {};
    let mut PHIUser: *mut Instruction = null;
    for U in PN.users() {
        if dyn_cast(U) {
            EU;
        } else {
            if EI.getIndexOperand() == EU.getIndexOperand() {
                Extracts.push(EU);
            } else {
                return null;
            }
        }
    }
    if !PHIUser {
        return null;
    }
    if !PHIUser.hasOneUse() || !(PHIUser.user_back() == PN) || !(isa(PHIUser)) || !cheapToScalarize(PHIUser, EI.getIndexOperand()) {
        return null;
    }
    let mut scalarPHI: *mut PHINode = cast(self.InsertNewInstWith(Create(EI.getType(), PN.getNumIncomingValues(), "", null), PN.getIterator()));
    let mut ScalarizedValues: SmallDenseMap<BasicBlock *, Value *, 4> = SmallDenseMap<BasicBlock *, Value *, 4> {};
    for let mut i: u32 = 0; i < PN.getNumIncomingValues(); i += 1 {
        let mut PHIInVal: *mut Value = PN.getIncomingValue(i);
        let mut inBB: *mut BasicBlock = PN.getIncomingBlock(i);
        let mut Elt: *mut Value = EI.getIndexOperand();
        if ScalarizedValues.lookup(inBB) {
            Existing;
        } else {
            scalarPHI.addIncoming(Existing, inBB);
            continue;
        }
        let mut ScalarVal: *mut Value = null;
        if PHIInVal == PHIUser {
            let mut B0: *mut BinaryOperator = cast(PHIUser);
            let mut opId: u32 = if (B0.getOperand(0) == PN) { 1 } else { 0 };
            let mut Op: *mut Value = self.InsertNewInstWith(Create(B0.getOperand(opId), Elt, B0.getOperand(opId).getName() + ".Elt", null), B0.getIterator());
            let mut FirstOp: *mut Value = if (B0.getOperand(0) == PN) { scalarPHI } else { Op };
            let mut SecondOp: *mut Value = if (B0.getOperand(0) == PN) { Op } else { scalarPHI };
            ScalarVal = self.InsertNewInstWith(CreateWithCopiedFlags(B0.getOpcode(), FirstOp, SecondOp, B0, "", null), B0.getIterator());
        } else {
            let mut newEI: *mut Instruction = Create(PHIInVal, Elt, "", null);
            let mut pos: *mut Instruction = dyn_cast(PHIInVal);
            let mut InsertPos: iterator = iterator {};
            if pos && !isa(pos) {
                InsertPos = operator(pos.getIterator());
            } else {
                InsertPos = inBB.getFirstInsertionPt();
            }
            ScalarVal = self.InsertNewInstWith(newEI, InsertPos);
        }
        ScalarizedValues[inBB] = ScalarVal;
        scalarPHI.addIncoming(ScalarVal, inBB);
    }
    for E in Extracts {
        self.replaceInstUsesWith(*E, scalarPHI);
        self.addToWorklist(E);
    }
    return &mut EI;
}

fn InstCombinerImpl::foldBitcastExtElt(self, Ext: *mut ExtractElementInst) -> *mut Instruction {
    let mut X: *mut Value = null;
    let mut ExtIndexC: u64 = 0;
    if !match(Ext.getVectorOperand(), m_BitCast(m_Value(X))) || !match(Ext.getIndexOperand(), m_ConstantInt(ExtIndexC)) {
        return null;
    }
    let mut NumElts: ElementCount = cast(Ext.getVectorOperandType()).getElementCount();
    let mut DestTy: *mut Type = Ext.getType();
    let mut DestWidth: u32 = DestTy.getPrimitiveSizeInBits().operator unsigned long long();
    let mut IsBigEndian: bool = self.DL.isBigEndian();
    if X.getType().isIntegerTy() {
        assert!(isa(Ext.getVectorOperand().getType()), "Expected fixed vector type for bitcast from scalar integer");
        if IsBigEndian {
            ExtIndexC = NumElts.getKnownMinValue() - 1 - ExtIndexC;
        }
        let mut ShiftAmountC: u32 = ExtIndexC * DestWidth;
        if (!ShiftAmountC || self.isDesirableIntType(X.getType().getPrimitiveSizeInBits().operator unsigned long long())) && Ext.getVectorOperand().hasOneUse() {
            if ShiftAmountC {
                X = self.Builder.CreateLShr(X, ShiftAmountC, "extelt.offset", false);
            }
            if DestTy.isFloatingPointTy() {
                let mut DstIntTy: *mut Type = getIntNTy(X.getContext(), DestWidth);
                let mut Trunc: *mut Value = self.Builder.CreateTrunc(X, DstIntTy, "", false, false);
                return BitCastInst { Trunc, DestTy, "", null };
            }
            return TruncInst { X, DestTy, "", null };
        }
    }
    if !X.getType().isVectorTy() {
        return null;
    }
    let mut SrcTy: *mut VectorType = cast(X.getType());
    let mut NumSrcElts: ElementCount = SrcTy.getElementCount();
    if NumSrcElts == NumElts {
        if findScalarElement(X, ExtIndexC) {
            Elt;
        } else {
            return BitCastInst { Elt, DestTy, "", null };
        }
    }
    assert!(NumSrcElts.isScalable() == NumElts.isScalable(), "Src and Dst must be the same sort of vector type");
    if NumSrcElts.getKnownMinValue() < NumElts.getKnownMinValue() {
        let mut Scalar: *mut Value = null;
        let mut Vec: *mut Value = null;
        let mut InsIndexC: u64 = 0;
        if !match(X, m_InsertElt(m_Value(Vec), m_Value(Scalar), m_ConstantInt(InsIndexC))) {
            return null;
        }
        let mut NarrowingRatio: u32 = NumElts.getKnownMinValue() / NumSrcElts.getKnownMinValue();
        if ExtIndexC / NarrowingRatio != InsIndexC {
            if X.hasOneUse() && Ext.getVectorOperand().hasOneUse() {
                let mut NewBC: *mut Value = self.Builder.CreateBitCast(Vec, Ext.getVectorOperandType(), "");
                return Create(NewBC, Ext.getIndexOperand(), "", null);
            }
            return null;
        }
        let mut Chunk: u32 = ExtIndexC % NarrowingRatio;
        if IsBigEndian {
            Chunk = NarrowingRatio - 1 - Chunk;
        }
        let mut NeedSrcBitcast: bool = SrcTy.getScalarType().isFloatingPointTy();
        let mut NeedDestBitcast: bool = DestTy.isFloatingPointTy();
        if NeedSrcBitcast && NeedDestBitcast {
            return null;
        }
        let mut SrcWidth: u32 = SrcTy.getScalarSizeInBits();
        let mut ShAmt: u32 = Chunk * DestWidth;
        if !X.hasOneUse() || !Ext.getVectorOperand().hasOneUse() {
            if NeedSrcBitcast || NeedDestBitcast {
                return null;
            }
        }
        if NeedSrcBitcast {
            let mut SrcIntTy: *mut Type = getIntNTy(Scalar.getContext(), SrcWidth);
            Scalar = self.Builder.CreateBitCast(Scalar, SrcIntTy, "");
        }
        if ShAmt {
            if !Ext.getVectorOperand().hasOneUse() {
                return null;
            }
            Scalar = self.Builder.CreateLShr(Scalar, ShAmt, "", false);
        }
        if NeedDestBitcast {
            let mut DestIntTy: *mut Type = getIntNTy(Scalar.getContext(), DestWidth);
            return BitCastInst { self.Builder.CreateTrunc(Scalar, DestIntTy, "", false, false), DestTy, "", null };
        }
        return TruncInst { Scalar, DestTy, "", null };
    }
    return null;
}

fn findDemandedEltsBySingleUser(V: *mut Value, UserInstr: *mut Instruction, UnionUsedElts: *mut APInt) -> bool {
    let mut VWidth: u32 = cast(V.getType()).getNumElements();
    match UserInstr.getOpcode() {
        ExtractElement => {
            let mut EEI: *mut ExtractElementInst = cast(UserInstr);
            assert!(EEI.getVectorOperand() == V);
            let mut EEIIndexC: *mut ConstantInt = dyn_cast(EEI.getIndexOperand());
            if EEIIndexC && EEIIndexC.getValue().ult(VWidth) {
                UnionUsedElts.setBit(EEIIndexC.getZExtValue());
                return true;
            }
            break;
        },
        ShuffleVector => {
            let mut Shuffle: *mut ShuffleVectorInst = cast(UserInstr);
            let mut MaskNumElts: u32 = cast(UserInstr.getType()).getNumElements();
            for I in seq(MaskNumElts) {
                let mut MaskVal: u32 = Shuffle.getMaskValue(I);
                if MaskVal == -1 || MaskVal >= 2 * VWidth {
                    continue;
                }
                if Shuffle.getOperand(0) == V && (MaskVal < VWidth) {
                    UnionUsedElts.setBit(MaskVal);
                }
                if Shuffle.getOperand(1) == V && ((MaskVal >= VWidth) && (MaskVal < 2 * VWidth)) {
                    UnionUsedElts.setBit(MaskVal - VWidth);
                }
            }
            return true;
        },
        _ => {
            break;
        },
    }
    return false;
}

fn findDemandedEltsByAllUsers(V: *mut Value) -> APInt {
    let mut VWidth: u32 = cast(V.getType()).getNumElements();
    let mut UnionUsedElts: APInt = APInt { VWidth, 0, false, false };
    for U in V.uses() {
        if dyn_cast(U.getUser()) {
            I;
        } else {
            if !findDemandedEltsBySingleUser(V, I, UnionUsedElts) {
                return getAllOnes(VWidth);
            }
        }
        if UnionUsedElts.isAllOnes() {
            break;
        }
    }
    return UnionUsedElts;
}

fn getPreferredVectorIndex(IndexC: *mut ConstantInt) -> *mut ConstantInt {
    let mut IndexBW: u32 = IndexC.getBitWidth();
    if IndexBW == 64 || IndexC.getValue().getActiveBits() > 64 {
        return null;
    }
    return get(IndexC.getContext(), IndexC.getValue().zextOrTrunc(64));
}

fn foldExtractOfStridedPointerVector(EI: *mut ExtractElementInst, Builder: *mut BuilderTy, DL: *DataLayout) -> *mut Value {
    let mut VecTy: *mut FixedVectorType = dyn_cast(EI.getVectorOperandType());
    if !VecTy || !VecTy.getElementType().isPointerTy() {
        return null;
    }
    let mut NumElts: u32 = VecTy.getNumElements();
    if NumElts < 2 {
        return null;
    }
    let mut IdxWidth: u32 = DL.getIndexTypeSizeInBits(VecTy.getElementType());
    let mut Base: *mut Value = null;
    let mut Offsets: SmallVector<APInt> = SmallVector<APInt> {};
    for let mut I: u32 = 0; I != NumElts; I += 1 {
        let mut Elt: *mut Value = findScalarElement(EI.getVectorOperand(), I);
        if !Elt {
            return null;
        }
        let mut EltBase: *mut Value = null;
        let mut C: *APInt = null;
        let mut Offset: APInt = APInt { IdxWidth, 0, false, false };
        if match(Elt, m_PtrAdd(m_Value(EltBase), m_APInt(C))) {
            Offset = C.sextOrTrunc(IdxWidth);
        } else {
            EltBase = Elt;
        }
        if I == 0 {
            Base = EltBase;
        } else if Base != EltBase {
            return null;
        }
        Offsets.push(Offset);
    }
    let mut Stride: APInt = Offsets[1] - Offsets[0];
    for let mut I: u32 = 1; I != NumElts; I += 1 {
        if Offsets[I] - Offsets[0] != Stride * I {
            return null;
        }
    }
    let mut IdxTy: *mut Type = DL.getIndexType(VecTy.getElementType());
    let mut Idx: *mut Value = Builder.CreateZExtOrTrunc(EI.getIndexOperand(), IdxTy, "");
    let mut Ptr: *mut Value = Builder.CreatePtrAdd(Base, Builder.CreateMul(Idx, get(IdxTy, Stride), "", false, false), "", none());
    return Builder.CreatePtrAdd(Ptr, get(IdxTy, Offsets[0]), "", none());
}

fn InstCombinerImpl::visitExtractElementInst(self, EI: *mut ExtractElementInst) -> *mut Instruction {
    let mut SrcVec: *mut Value = EI.getVectorOperand();
    let mut Index: *mut Value = EI.getIndexOperand();
    if simplifyExtractElementInst(SrcVec, Index, self.SQ.getWithInstruction(&mut EI)) {
        V;
    } else {
        return self.replaceInstUsesWith(EI, V);
    }
    if dyn_cast(EI.getVectorOperand()) {
        SI;
    } else if SI.getCondition().getType().isIntegerTy() && isa(EI.getIndexOperand()) {
        if self.FoldOpIntoSelect(EI, SI, false, false) {
            R;
        } else {
            return R;
        }
    }
    if !isa(Index) {
        if foldExtractOfStridedPointerVector(EI, self.Builder, self.DL) {
            V;
        } else {
            return self.replaceInstUsesWith(EI, V);
        }
    }
    let mut IndexC: *mut ConstantInt = dyn_cast(Index);
    let mut HasKnownValidIndex: bool = false;
    if IndexC {
        if getPreferredVectorIndex(IndexC) {
            NewIdx;
        } else {
            return self.replaceOperand(EI, 1, NewIdx);
        }
        let mut EC: ElementCount = EI.getVectorOperandType().getElementCount();
        let mut NumElts: u32 = EC.getKnownMinValue();
        HasKnownValidIndex = IndexC.getValue().ult(NumElts);
        if dyn_cast(SrcVec) {
            II;
        } else {
            let mut IID: ID = II.getIntrinsicID();
            if IID == stepvector && IndexC.getValue().ult(NumElts) {
                let mut Ty: *mut Type = EI.getType();
                let mut BitWidth: u32 = Ty.getIntegerBitWidth();
                let mut Idx: *mut Value = null;
                if IndexC.getValue().getActiveBits() <= BitWidth {
                    Idx = get(Ty, IndexC.getValue().zextOrTrunc(BitWidth));
                } else {
                    return null;
                }
                return self.replaceInstUsesWith(EI, Idx);
            }
        }
        if !EC.isScalable() && IndexC.getValue().uge(NumElts) {
            return null;
        }
        if self.foldBitcastExtElt(EI) {
            I;
        } else {
            return I;
        }
        if dyn_cast(SrcVec) {
            Phi;
        } else if self.scalarizePHI(EI, Phi) {
            ScalarPHI;
        } else {
            return ScalarPHI;
        }
    }
    let mut V: *mut Value = null;
    if match(SrcVec, m_Intrinsic(m_Value(V), m_Zero())) {
        return Create(V, Index, "", null);
    }
    let mut UO: *mut UnaryOperator = null;
    if match(SrcVec, m_UnOp(UO)) && cheapToScalarize(SrcVec, Index) {
        let mut X: *mut Value = UO.getOperand(0);
        let mut E: *mut Value = self.Builder.CreateExtractElement(X, Index, "");
        return CreateWithCopiedFlags(UO.getOpcode(), E, UO, "", null);
    }
    let mut BO: *mut BinaryOperator = null;
    if match(SrcVec, m_BinOp(BO)) && cheapToScalarize(SrcVec, Index) && (HasKnownValidIndex || isSafeToSpeculativelyExecuteWithVariableReplaced(BO, true)) {
        let mut X: *mut Value = BO.getOperand(0);
        let mut Y: *mut Value = BO.getOperand(1);
        let mut E0: *mut Value = self.Builder.CreateExtractElement(X, Index, "");
        let mut E1: *mut Value = self.Builder.CreateExtractElement(Y, Index, "");
        return CreateWithCopiedFlags(BO.getOpcode(), E0, E1, BO, "", null);
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut Pred: CmpPredicate = CmpPredicate {};
    if match(SrcVec, m_Cmp(Pred, m_Value(X), m_Value(Y))) && cheapToScalarize(SrcVec, Index) {
        let mut E0: *mut Value = self.Builder.CreateExtractElement(X, Index, "");
        let mut E1: *mut Value = self.Builder.CreateExtractElement(Y, Index, "");
        let mut SrcCmpInst: *mut CmpInst = cast(SrcVec);
        return CreateWithCopiedFlags(SrcCmpInst.getOpcode(), Pred.operator llvm::CmpInst::Predicate(), E0, E1, SrcCmpInst, "", null);
    }
    if dyn_cast(SrcVec) {
        I;
    } else {
        if dyn_cast(I) {
            IE;
        } else {
            if isa(IE.getOperand(2)) && IndexC {
                return self.replaceOperand(EI, 0, IE.getOperand(0));
            }
        }
    }
    if IndexC {
        let mut EC: ElementCount = EI.getVectorOperandType().getElementCount();
        let mut NumElts: u32 = EC.getKnownMinValue();
        if !EC.isScalable() && NumElts != 1 {
            if SrcVec.hasOneUse() {
                let mut PoisonElts: APInt = APInt { NumElts, 0, false, false };
                let mut DemandedElts: APInt = APInt { NumElts, 0, false, false };
                DemandedElts.setBit(IndexC.getZExtValue());
                if self.SimplifyDemandedVectorElts(SrcVec, DemandedElts, PoisonElts, 0, false) {
                    V;
                } else {
                    return self.replaceOperand(EI, 0, V);
                }
            } else {
                let mut DemandedElts: APInt = findDemandedEltsByAllUsers(SrcVec);
                if !DemandedElts.isAllOnes() {
                    let mut PoisonElts: APInt = APInt { NumElts, 0, false, false };
                    if self.SimplifyDemandedVectorElts(SrcVec, DemandedElts, PoisonElts, 0, true) {
                        V;
                    } else {
                        if V != SrcVec {
                            self.Worklist.addValue(SrcVec);
                            SrcVec.replaceAllUsesWith(V);
                            return &mut EI;
                        }
                    }
                }
            }
        }
    }
    return null;
}

fn collectSingleShuffleElements(V: *mut Value, LHS: *mut Value, RHS: *mut Value, Mask: *mut SmallVectorImpl<int>) -> bool {
    assert!(LHS.getType() == RHS.getType(), "Invalid CollectSingleShuffleElements");
    let mut NumElts: u32 = cast(V.getType()).getNumElements();
    if match(V, m_Poison()) {
        Mask.assign(NumElts, -1);
        return true;
    }
    if V == LHS {
        for let mut i: u32 = 0; i != NumElts; i += 1 {
            Mask.push(i);
        }
        return true;
    }
    if V == RHS {
        for let mut i: u32 = 0; i != NumElts; i += 1 {
            Mask.push(i + NumElts);
        }
        return true;
    }
    if dyn_cast(V) {
        IEI;
    } else {
        let mut VecOp: *mut Value = IEI.getOperand(0);
        let mut ScalarOp: *mut Value = IEI.getOperand(1);
        let mut IdxOp: *mut Value = IEI.getOperand(2);
        if !isa(IdxOp) {
            return false;
        }
        let mut InsertedIdx: u32 = cast(IdxOp).getZExtValue();
        if isa(ScalarOp) {
            if collectSingleShuffleElements(VecOp, LHS, RHS, Mask) {
                Mask[InsertedIdx] = -1;
                return true;
            }
        } else if dyn_cast(ScalarOp) {
            EI;
        } else {
            if isa(EI.getOperand(1)) {
                let mut ExtractedIdx: u32 = cast(EI.getOperand(1)).getZExtValue();
                let mut NumLHSElts: u32 = cast(LHS.getType()).getNumElements();
                if EI.getOperand(0) == LHS || EI.getOperand(0) == RHS {
                    if collectSingleShuffleElements(VecOp, LHS, RHS, Mask) {
                        if EI.getOperand(0) == LHS {
                            Mask[InsertedIdx % NumElts] = ExtractedIdx;
                        } else {
                            assert!(EI.getOperand(0) == RHS);
                            Mask[InsertedIdx % NumElts] = ExtractedIdx + NumLHSElts;
                        }
                        return true;
                    }
                }
            }
        }
    }
    return false;
}

fn replaceExtractElements(InsElt: *mut InsertElementInst, ExtElt: *mut ExtractElementInst, IC: *mut InstCombinerImpl) -> bool {
    let mut InsVecType: *mut FixedVectorType = cast(InsElt.getType());
    let mut ExtVecType: *mut FixedVectorType = cast(ExtElt.getVectorOperandType());
    let mut NumInsElts: u32 = InsVecType.getNumElements();
    let mut NumExtElts: u32 = ExtVecType.getNumElements();
    if InsVecType.getElementType() != ExtVecType.getElementType() || NumExtElts >= NumInsElts {
        return false;
    }
    let mut ExtVecOp: *mut Value = ExtElt.getVectorOperand();
    if isa(ExtVecOp) {
        return false;
    }
    let mut ExtendMask: SmallVector<int, 16> = SmallVector<int, 16> {};
    for let mut i: u32 = 0; i < NumExtElts; i += 1 {
        ExtendMask.push(i);
    }
    for let mut i: u32 = NumExtElts; i < NumInsElts; i += 1 {
        ExtendMask.push(-1);
    }
    let mut ExtVecOpInst: *mut Instruction = dyn_cast(ExtVecOp);
    let mut InsertionBlock: *mut BasicBlock = if (ExtVecOpInst && !isa(ExtVecOpInst)) { ExtVecOpInst.getParent() } else { ExtElt.getParent() };
    if InsertionBlock != InsElt.getParent() {
        return false;
    }
    if InsElt.hasOneUse() && isa(InsElt.user_back()) {
        return false;
    }
    let mut WideVec: *mut ShuffleVectorInst = ShuffleVectorInst { ExtVecOp, ExtendMask, "", null };
    if ExtVecOpInst && !isa(ExtVecOpInst) {
        WideVec.insertAfter(ExtVecOpInst.getIterator());
    } else {
        IC.InsertNewInstWith(WideVec, ExtElt.getParent().getFirstInsertionPt());
    }
    if ExtVecOpInst {
        WideVec.setDebugLoc(ExtVecOpInst.getDebugLoc());
    } else {
        WideVec.setDebugLoc(getCompilerGenerated());
    }
    for U in ExtVecOp.users() {
        let mut OldExt: *mut ExtractElementInst = dyn_cast(U);
        if !OldExt || OldExt.getParent() != WideVec.getParent() {
            continue;
        }
        let mut NewExt: *mut ExtractElementInst = Create(WideVec, OldExt.getOperand(1), "", null);
        IC.InsertNewInstWith(NewExt, OldExt.getIterator());
        IC.replaceInstUsesWith(*OldExt, NewExt);
        IC.addToWorklist(OldExt);
    }
    return true;
}

fn collectShuffleElements(V: *mut Value, Mask: *mut SmallVectorImpl<int>, PermittedRHS: *mut Value, IC: *mut InstCombinerImpl, Rerun: *mut bool) -> ShuffleOps {
    assert!(V.getType().isVectorTy(), "Invalid shuffle!");
    let mut NumElts: u32 = cast(V.getType()).getNumElements();
    if match(V, m_Poison()) {
        Mask.assign(NumElts, -1);
        return make_pair(if PermittedRHS { get(PermittedRHS.getType()) } else { V }, null);
    }
    if isa(V) {
        Mask.assign(NumElts, 0);
        return make_pair(V, null);
    }
    if dyn_cast(V) {
        IEI;
    } else {
        let mut VecOp: *mut Value = IEI.getOperand(0);
        let mut ScalarOp: *mut Value = IEI.getOperand(1);
        let mut IdxOp: *mut Value = IEI.getOperand(2);
        if dyn_cast(ScalarOp) {
            EI;
        } else {
            if isa(EI.getOperand(1)) && isa(IdxOp) {
                let mut ExtractedIdx: u32 = cast(EI.getOperand(1)).getZExtValue();
                let mut InsertedIdx: u32 = cast(IdxOp).getZExtValue();
                if EI.getOperand(0) == PermittedRHS || PermittedRHS == null {
                    let mut RHS: *mut Value = EI.getOperand(0);
                    let mut LR: ShuffleOps = collectShuffleElements(VecOp, Mask, RHS, IC, Rerun);
                    assert!(LR.second == null || LR.second == RHS);
                    if LR.first.getType() != RHS.getType() {
                        if replaceExtractElements(IEI, EI, IC) {
                            Rerun = true;
                        }
                        for let mut i: u32 = 0; i < NumElts; i += 1 {
                            Mask[i] = i;
                        }
                        return make_pair(V, null);
                    }
                    let mut NumLHSElts: u32 = cast(RHS.getType()).getNumElements();
                    Mask[InsertedIdx % NumElts] = NumLHSElts + ExtractedIdx;
                    return make_pair(LR.first, RHS);
                }
                if VecOp == PermittedRHS {
                    let mut NumLHSElts: u32 = cast(EI.getOperand(0).getType()).getNumElements();
                    for let mut i: u32 = 0; i != NumElts; i += 1 {
                        Mask.push(if i == InsertedIdx { ExtractedIdx } else { NumLHSElts + i });
                    }
                    return make_pair(EI.getOperand(0), PermittedRHS);
                }
                if EI.getOperand(0).getType() == PermittedRHS.getType() && collectSingleShuffleElements(IEI, EI.getOperand(0), PermittedRHS, Mask) {
                    return make_pair(EI.getOperand(0), PermittedRHS);
                }
            }
        }
    }
    for let mut i: u32 = 0; i != NumElts; i += 1 {
        Mask.push(i);
    }
    return make_pair(V, null);
}

fn InstCombinerImpl::foldAggregateConstructionIntoAggregateReuse(self, OrigIVI: *mut InsertValueInst) -> *mut Instruction {
    let mut AggTy: *mut Type = OrigIVI.getType();
    let mut NumAggElts: u32 = 0;
    match AggTy.getTypeID() {
        StructTyID => {
            NumAggElts = AggTy.getStructNumElements();
        },
        ArrayTyID => {
            NumAggElts = AggTy.getArrayNumElements();
        },
        _ => {
            llvm_unreachable_internal("Unhandled aggregate type?", "P:/Goraw/llvm-project/llvm/lib/Transforms/InstCombine/InstCombineVectorOps.cpp", 998);
        },
    }
    assert!(NumAggElts > 0, "Aggregate should have elements.");
    if NumAggElts > 2 {
        return null;
    }
    let mut NotFound: nullopt_t = nullopt;
    let mut FoundMismatch: nullptr_t = null;
    let mut AggElts: optional<Instruction *>, 2> = optional<Instruction *>, 2> { NumAggElts, NotFound };
    let mut KnowAllElts: Closure_1 = Closure_1 { AggElts: &mut AggElts };
    let mut Depth: i32 = 0;
    let mut DepthLimit: i32 = 2 * NumAggElts;
    for let mut CurrIVI: *mut InsertValueInst = &mut OrigIVI; Depth < DepthLimit && CurrIVI && !KnowAllElts.call(); CurrIVI = dyn_cast(CurrIVI.getAggregateOperand()) , Depth += 1 {
        let mut InsertedValue: *mut Instruction = dyn_cast(CurrIVI.getInsertedValueOperand());
        if !InsertedValue {
            return null;
        }
        let mut Indices: ArrayRef<unsigned int> = CurrIVI.getIndices();
        if Indices.len != 1 {
            return null;
        }
        let mut Elt: *mut optional<Instruction *> = AggElts[Indices.front()];
        Elt = Elt.value_or(InsertedValue);
    }
    if !KnowAllElts.call() {
        return null;
    }
    let mut Describe: Closure_2 = Closure_2 {};
    let mut EltDefinedInUseBB: bool = false;
    let mut FindSourceAggregate: Closure_3 = Closure_3 { EltDefinedInUseBB: &mut EltDefinedInUseBB, AggTy: &mut AggTy };
    let mut FindCommonSourceAggregate: Closure_4 = Closure_4 { AggElts: &mut AggElts, Describe: &mut Describe, FindSourceAggregate: &mut FindSourceAggregate };
    let mut SourceAggregate: optional<Value *> = optional<Value *> {};
    SourceAggregate = FindCommonSourceAggregate.call(nullopt, nullopt);
    if Describe.call(SourceAggregate) != NotFound {
        if Describe.call(SourceAggregate) == FoundMismatch {
            return null;
        }
        operator(NumAggregateReconstructionsSimplified);
        return self.replaceInstUsesWith(OrigIVI, operator(SourceAggregate));
    }
    let mut UseBB: *mut BasicBlock = null;
    for I in AggElts {
        let mut BB: *mut BasicBlock = (operator(I)).getParent();
        if !UseBB {
            UseBB = BB;
            continue;
        }
        if UseBB != BB {
            return null;
        }
    }
    if !UseBB {
        return null;
    }
    if pred_empty(UseBB) {
        return null;
    }
    let mut PredCountLimit: i32 = 64;
    let mut Preds: SmallVector<BasicBlock *, 4> = SmallVector<BasicBlock *, 4> {};
    for Pred in predecessors(UseBB) {
        if Preds.len >= PredCountLimit {
            return null;
        }
        Preds.push(Pred);
    }
    let mut SourceAggregates: SmallMapVector<BasicBlock *, Value *, 4> = SmallMapVector<BasicBlock *, Value *, 4> {};
    let mut FoundSrcAgg: bool = false;
    for Pred in Preds {
        let mut IV: iterator, bool> = SourceAggregates.try_emplace(Pred);
        if !IV.second {
            continue;
        }
        SourceAggregate = FindCommonSourceAggregate.call(UseBB, Pred);
        if Describe.call(SourceAggregate) == Found {
            FoundSrcAgg = true;
            IV.first.second = operator(SourceAggregate);
        } else {
            let mut BI: *mut UncondBrInst = dyn_cast(Pred.getTerminator());
            if !BI {
                return null;
            }
        }
    }
    if !FoundSrcAgg {
        return null;
    }
    let mut OrigBB: *mut BasicBlock = OrigIVI.getParent();
    for It in SourceAggregates {
        if Describe.call(It.second) == Found {
            continue;
        }
        if EltDefinedInUseBB {
            return null;
        }
        if UseBB != OrigBB {
            return null;
        }
        let mut ConstAgg: bool = true;
        for Val in AggElts {
            let mut Elt: *mut Value = (operator(Val)).DoPHITranslation(UseBB, It.first);
            if !isa(Elt) {
                ConstAgg = false;
                break;
            }
        }
        if ConstAgg {
            return null;
        }
    }
    for It in SourceAggregates {
        if Describe.call(It.second) == Found {
            continue;
        }
        let mut Pred: *mut BasicBlock = It.first;
        self.Builder.SetInsertPoint(Pred.getTerminator());
        let mut V: *mut Value = get(AggTy);
        for x in enumerate(AggElts) {
            let mut Elt: *mut Value = (operator(Val)).DoPHITranslation(UseBB, Pred);
            V = self.Builder.CreateInsertValue(V, Elt, Idx, "");
        }
        It.second = V;
    }
    let mut Guard: InsertPointGuard = self.Builder;
    self.Builder.SetInsertPoint(UseBB.getFirstNonPHIIt());
    let mut PHI: *mut PHINode = self.Builder.CreatePHI(AggTy, Preds.len, OrigIVI.getName() + ".merged");
    for Pred in Preds {
        PHI.addIncoming(SourceAggregates[Pred], Pred);
    }
    operator(NumAggregateReconstructionsSimplified);
    return self.replaceInstUsesWith(OrigIVI, PHI);
}

fn InstCombinerImpl::visitInsertValueInst(self, I: *mut InsertValueInst) -> *mut Instruction {
    if simplifyInsertValueInst(I.getAggregateOperand(), I.getInsertedValueOperand(), I.getIndices(), self.SQ.getWithInstruction(&mut I)) {
        V;
    } else {
        return self.replaceInstUsesWith(I, V);
    }
    let mut IsRedundant: bool = false;
    let mut FirstIndices: ArrayRef<unsigned int> = I.getIndices();
    let mut V: *mut Value = &mut I;
    let mut Depth: u32 = 0;
    while V.hasOneUse() && Depth < 10 {
        let mut U: *mut User = V.user_back();
        let mut UserInsInst: CastReturnType = dyn_cast(U);
        if !UserInsInst || U.getOperand(0) != V {
            break;
        }
        if UserInsInst.getIndices() == FirstIndices {
            IsRedundant = true;
            break;
        }
        V = UserInsInst;
        Depth += 1;
    }
    if IsRedundant {
        return self.replaceInstUsesWith(I, I.getOperand(0));
    }
    if self.foldAggregateConstructionIntoAggregateReuse(I) {
        NewI;
    } else {
        return NewI;
    }
    return null;
}

fn isShuffleEquivalentToSelect(Shuf: *mut ShuffleVectorInst) -> bool {
    if isa(Shuf.getOperand(0).getType()) {
        return false;
    }
    let mut MaskSize: i32 = Shuf.getShuffleMask().len;
    let mut VecSize: i32 = cast(Shuf.getOperand(0).getType()).getNumElements();
    if MaskSize != VecSize {
        return false;
    }
    for let mut i: i32 = 0; i != MaskSize; i += 1 {
        let mut Elt: i32 = Shuf.getMaskValue(i);
        if Elt != -1 && Elt != i && Elt != i + VecSize {
            return false;
        }
    }
    return true;
}

fn foldInsSequenceIntoSplat(InsElt: *mut InsertElementInst) -> *mut Instruction {
    if InsElt.hasOneUse() && isa(InsElt.user_back()) {
        return null;
    }
    let mut VecTy: *mut VectorType = InsElt.getType();
    if isa(VecTy) {
        return null;
    }
    let mut NumElements: u32 = cast(VecTy).getNumElements();
    if NumElements == 1 {
        return null;
    }
    let mut SplatVal: *mut Value = InsElt.getOperand(1);
    let mut CurrIE: *mut InsertElementInst = &mut InsElt;
    let mut ElementPresent: SmallBitVector = SmallBitVector { NumElements, false };
    let mut FirstIE: *mut InsertElementInst = null;
    while CurrIE {
        let mut Idx: *mut ConstantInt = dyn_cast(CurrIE.getOperand(2));
        if !Idx || CurrIE.getOperand(1) != SplatVal {
            return null;
        }
        let mut NextIE: *mut InsertElementInst = dyn_cast(CurrIE.getOperand(0));
        if CurrIE != &mut InsElt && (!CurrIE.hasOneUse() && (NextIE != null || !Idx.isZero())) {
            return null;
        }
        ElementPresent[Idx.getZExtValue()] = true;
        FirstIE = CurrIE;
        CurrIE = NextIE;
    }
    if FirstIE == &mut InsElt {
        return null;
    }
    if !match(FirstIE.getOperand(0), m_Poison()) {
        if !ElementPresent.all() {
            return null;
        }
    }
    let mut Int64Ty: *mut Type = getInt64Ty(InsElt.getContext());
    let mut PoisonVec: *mut PoisonValue = get(VecTy);
    let mut Zero: *mut Constant = get(Int64Ty, 0, false, false);
    if !cast(FirstIE.getOperand(2)).isZero() {
        FirstIE = Create(PoisonVec, SplatVal, Zero, "", InsElt.getIterator());
    }
    let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> { NumElements, 0 };
    for let mut i: u32 = 0; i != NumElements; i += 1 {
        if !ElementPresent[i] {
            Mask[i] = -1;
        }
    }
    return ShuffleVectorInst { FirstIE, Mask, "", null };
}

fn foldInsEltIntoSplat(InsElt: *mut InsertElementInst) -> *mut Instruction {
    let mut Shuf: *mut ShuffleVectorInst = dyn_cast(InsElt.getOperand(0));
    if !Shuf || !Shuf.isZeroEltSplat() {
        return null;
    }
    if isa(Shuf.getType()) {
        return null;
    }
    let mut IdxC: u64 = 0;
    if !match(InsElt.getOperand(2), m_ConstantInt(IdxC)) {
        return null;
    }
    let mut X: *mut Value = InsElt.getOperand(1);
    let mut Op0: *mut Value = Shuf.getOperand(0);
    if !match(Op0, m_InsertElt(m_Undef(), m_Specific(X), m_ZeroInt())) {
        return null;
    }
    let mut NumMaskElts: u32 = cast(Shuf.getType()).getNumElements();
    let mut NewMask: SmallVector<int, 16> = NumMaskElts;
    for let mut i: u32 = 0; i != NumMaskElts; i += 1 {
        NewMask[i] = if i == IdxC { 0 } else { Shuf.getMaskValue(i) };
    }
    return ShuffleVectorInst { Op0, NewMask, "", null };
}

fn foldInsEltIntoIdentityShuffle(InsElt: *mut InsertElementInst) -> *mut Instruction {
    let mut Shuf: *mut ShuffleVectorInst = dyn_cast(InsElt.getOperand(0));
    if !Shuf || !match(Shuf.getOperand(1), m_Poison()) || !(Shuf.isIdentityWithExtract() || Shuf.isIdentityWithPadding()) {
        return null;
    }
    if isa(Shuf.getType()) {
        return null;
    }
    let mut IdxC: u64 = 0;
    if !match(InsElt.getOperand(2), m_ConstantInt(IdxC)) {
        return null;
    }
    let mut Scalar: *mut Value = InsElt.getOperand(1);
    let mut X: *mut Value = Shuf.getOperand(0);
    if !match(Scalar, m_ExtractElt(m_Specific(X), m_SpecificInt(IdxC))) {
        return null;
    }
    let mut NumMaskElts: u32 = cast(Shuf.getType()).getNumElements();
    let mut NewMask: SmallVector<int, 16> = NumMaskElts;
    let mut OldMask: ArrayRef<int> = Shuf.getShuffleMask();
    for let mut i: u32 = 0; i != NumMaskElts; i += 1 {
        if i != IdxC {
            NewMask[i] = OldMask[i];
        } else if OldMask[i] == IdxC as i32 {
            return null;
        } else {
            assert!(OldMask[i] == PoisonMaskElem, "Unexpected shuffle mask element for identity shuffle");
            NewMask[i] = IdxC;
        }
    }
    return ShuffleVectorInst { X, Shuf.getOperand(1), NewMask, "", null };
}

fn hoistInsEltConst(InsElt2: *mut InsertElementInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut InsElt1: *mut InsertElementInst = dyn_cast(InsElt2.getOperand(0));
    if !InsElt1 || !InsElt1.hasOneUse() {
        return null;
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut ScalarC: *mut Constant = null;
    let mut IdxC1: *mut ConstantInt = null;
    let mut IdxC2: *mut ConstantInt = null;
    if match(InsElt1.getOperand(0), m_Value(X)) && match(InsElt1.getOperand(1), m_Value(Y)) && !isa(Y) && match(InsElt1.getOperand(2), m_ConstantInt(IdxC1)) && match(InsElt2.getOperand(1), m_Constant(ScalarC)) && match(InsElt2.getOperand(2), m_ConstantInt(IdxC2)) && IdxC1 != IdxC2 {
        let mut NewInsElt1: *mut Value = Builder.CreateInsertElement(X, ScalarC, IdxC2, "");
        return Create(NewInsElt1, Y, IdxC1, "", null);
    }
    return null;
}

fn foldConstantInsEltIntoShuffle(InsElt: *mut InsertElementInst) -> *mut Instruction {
    let mut Inst: *mut Instruction = dyn_cast(InsElt.getOperand(0));
    if !Inst || !Inst.hasOneUse() {
        return null;
    }
    if dyn_cast(InsElt.getOperand(0)) {
        Shuf;
    } else {
        let mut ShufConstVec: *mut Constant = null;
        let mut InsEltScalar: *mut Constant = null;
        let mut InsEltIndex: u64 = 0;
        if !match(Shuf.getOperand(1), m_Constant(ShufConstVec)) || !match(InsElt.getOperand(1), m_Constant(InsEltScalar)) || !match(InsElt.getOperand(2), m_ConstantInt(InsEltIndex)) {
            return null;
        }
        if !isShuffleEquivalentToSelect(*Shuf) {
            return null;
        }
        let mut Mask: ArrayRef<int> = Shuf.getShuffleMask();
        let mut NumElts: u32 = Mask.len;
        let mut NewShufElts: SmallVector<Constant *, 16> = NumElts;
        let mut NewMaskElts: SmallVector<int, 16> = NumElts;
        for let mut I: u32 = 0; I != NumElts; I += 1 {
            if I == InsEltIndex {
                NewShufElts[I] = InsEltScalar;
                NewMaskElts[I] = InsEltIndex + NumElts;
            } else {
                NewShufElts[I] = ShufConstVec.getAggregateElement(I);
                NewMaskElts[I] = Mask[I];
            }
            if !NewShufElts[I] {
                return null;
            }
        }
        return ShuffleVectorInst { Shuf.getOperand(0), get(NewShufElts), NewMaskElts, "", null };
    }
    return null;
}

fn narrowInsElt(InsElt: *mut InsertElementInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Vec: *mut Value = InsElt.getOperand(0);
    if !Vec.hasOneUse() {
        return null;
    }
    let mut Scalar: *mut Value = InsElt.getOperand(1);
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut CastOpcode: CastOps = zeroed();
    if match(Vec, m_FPExt(m_Value(X))) && match(Scalar, m_FPExt(m_Value(Y))) {
        CastOpcode = FPExt;
    } else if match(Vec, m_SExt(m_Value(X))) && match(Scalar, m_SExt(m_Value(Y))) {
        CastOpcode = SExt;
    } else if match(Vec, m_ZExt(m_Value(X))) && match(Scalar, m_ZExt(m_Value(Y))) {
        CastOpcode = ZExt;
    } else {
        return null;
    }
    if X.getType().getScalarType() != Y.getType() {
        return null;
    }
    let mut NewInsElt: *mut Value = Builder.CreateInsertElement(X, Y, InsElt.getOperand(2), "");
    return Create(CastOpcode, NewInsElt, InsElt.getType(), "", null);
}

fn foldTruncInsEltPair(InsElt: *mut InsertElementInst, IsBigEndian: bool, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut VecOp: *mut Value = InsElt.getOperand(0);
    let mut ScalarOp: *mut Value = InsElt.getOperand(1);
    let mut IndexOp: *mut Value = InsElt.getOperand(2);
    let mut VTy: *mut FixedVectorType = dyn_cast(InsElt.getType());
    let mut Scalar0: *mut Value = null;
    let mut BaseVec: *mut Value = null;
    let mut Index0: u64 = 0;
    let mut Index1: u64 = 0;
    if !VTy || (VTy.getNumElements() & 1) || !match(IndexOp, m_ConstantInt(Index1)) || !match(VecOp, m_InsertElt(m_Value(BaseVec), m_Value(Scalar0), m_ConstantInt(Index0))) || !match(BaseVec, m_Undef()) {
        return null;
    }
    if Index0 + 1 != Index1 || Index0 & 1 {
        return null;
    }
    let mut X: *mut Value = null;
    let mut ShAmt: u64 = 0;
    if IsBigEndian {
        if !match(ScalarOp, m_Trunc(m_Value(X))) || !match(Scalar0, m_Trunc(m_LShr(m_Specific(X), m_ConstantInt(ShAmt)))) {
            return null;
        }
    } else {
        if !match(Scalar0, m_Trunc(m_Value(X))) || !match(ScalarOp, m_Trunc(m_LShr(m_Specific(X), m_ConstantInt(ShAmt)))) {
            return null;
        }
    }
    let mut SrcTy: *mut Type = X.getType();
    let mut ScalarWidth: u32 = SrcTy.getScalarSizeInBits();
    let mut VecEltWidth: u32 = VTy.getScalarSizeInBits();
    if ScalarWidth != VecEltWidth * 2 || ShAmt != VecEltWidth {
        return null;
    }
    let mut CastTy: *mut Type = get(SrcTy, VTy.getNumElements() / 2);
    let mut CastBaseVec: *mut Value = Builder.CreateBitCast(BaseVec, CastTy, "");
    let mut NewIndex: u64 = if IsBigEndian { Index1 / 2 } else { Index0 / 2 };
    let mut NewInsert: *mut Value = Builder.CreateInsertElement(CastBaseVec, X, NewIndex, "");
    return BitCastInst { NewInsert, VTy, "", null };
}

fn InstCombinerImpl::visitInsertElementInst(self, IE: *mut InsertElementInst) -> *mut Instruction {
    let mut VecOp: *mut Value = IE.getOperand(0);
    let mut ScalarOp: *mut Value = IE.getOperand(1);
    let mut IdxOp: *mut Value = IE.getOperand(2);
    if simplifyInsertElementInst(VecOp, ScalarOp, IdxOp, self.SQ.getWithInstruction(&mut IE)) {
        V;
    } else {
        return self.replaceInstUsesWith(IE, V);
    }
    if dyn_cast(IdxOp) {
        IndexC;
    } else {
        if getPreferredVectorIndex(IndexC) {
            NewIdx;
        } else {
            return self.replaceOperand(IE, 2, NewIdx);
        }
        let mut BaseVec: *mut Value = null;
        let mut OtherScalar: *mut Value = null;
        let mut OtherIndexVal: u64 = 0;
        if match(VecOp, m_OneUse(m_InsertElt(m_Value(BaseVec), m_Value(OtherScalar), m_ConstantInt(OtherIndexVal)))) && !isa(OtherScalar) && OtherIndexVal > IndexC.getZExtValue() {
            let mut NewIns: *mut Value = self.Builder.CreateInsertElement(BaseVec, ScalarOp, IdxOp, "");
            return Create(NewIns, OtherScalar, self.Builder.getInt64(OtherIndexVal), "", null);
        }
    }
    let mut ScalarSrc: *mut Value = null;
    if match(VecOp, m_Undef()) && match(ScalarOp, m_OneUse(m_BitCast(m_Value(ScalarSrc)))) && (ScalarSrc.getType().isIntegerTy() || ScalarSrc.getType().isFloatingPointTy()) {
        let mut ScalarTy: *mut Type = ScalarSrc.getType();
        let mut VecTy: *mut Type = get(ScalarTy, IE.getType().getElementCount());
        let mut NewUndef: *mut Constant = if isa(VecOp) { get(VecTy) } else { get(VecTy) };
        let mut NewInsElt: *mut Value = self.Builder.CreateInsertElement(NewUndef, ScalarSrc, IdxOp, "");
        return BitCastInst { NewInsElt, IE.getType(), "", null };
    }
    let mut VecSrc: *mut Value = null;
    if match(VecOp, m_BitCast(m_Value(VecSrc))) && match(ScalarOp, m_BitCast(m_Value(ScalarSrc))) && (VecOp.hasOneUse() || ScalarOp.hasOneUse()) && VecSrc.getType().isVectorTy() && !ScalarSrc.getType().isVectorTy() && cast(VecSrc.getType()).getElementType() == ScalarSrc.getType() {
        let mut NewInsElt: *mut Value = self.Builder.CreateInsertElement(VecSrc, ScalarSrc, IdxOp, "");
        return BitCastInst { NewInsElt, IE.getType(), "", null };
    }
    let mut InsertedIdx: u64 = 0;
    let mut ExtractedIdx: u64 = 0;
    let mut ExtVecOp: *mut Value = null;
    if isa(IE.getType()) && match(IdxOp, m_ConstantInt(InsertedIdx)) && match(ScalarOp, m_ExtractElt(m_Value(ExtVecOp), m_ConstantInt(ExtractedIdx))) && isa(ExtVecOp.getType()) && ExtractedIdx < cast(ExtVecOp.getType()).getNumElements() {
        let mut isShuffleRootCandidate: Closure_5 = Closure_5 {};
        if isShuffleRootCandidate.call(IE) {
            let mut Rerun: bool = true;
            while Rerun {
                Rerun = false;
                let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> {};
                let mut LR: ShuffleOps = collectShuffleElements(&mut IE, Mask, null, *self, Rerun);
                if LR.first != &mut IE && LR.second != &mut IE {
                    if LR.second == null {
                        LR.second = get(LR.first.getType());
                    }
                    return ShuffleVectorInst { LR.first, LR.second, Mask, "", null };
                }
            }
        }
    }
    if dyn_cast(VecOp.getType()) {
        VecTy;
    } else {
        let mut VWidth: u32 = VecTy.getNumElements();
        let mut PoisonElts: APInt = APInt { VWidth, 0, false, false };
        let mut AllOnesEltMask: APInt = getAllOnes(VWidth);
        if self.SimplifyDemandedVectorElts(&mut IE, AllOnesEltMask, PoisonElts, 0, false) {
            V;
        } else {
            if V != &mut IE {
                return self.replaceInstUsesWith(IE, V);
            }
            return &mut IE;
        }
    }
    if foldConstantInsEltIntoShuffle(IE) {
        Shuf;
    } else {
        return Shuf;
    }
    if hoistInsEltConst(IE, self.Builder) {
        NewInsElt;
    } else {
        return NewInsElt;
    }
    if foldInsSequenceIntoSplat(IE) {
        Broadcast;
    } else {
        return Broadcast;
    }
    if foldInsEltIntoSplat(IE) {
        Splat;
    } else {
        return Splat;
    }
    if foldInsEltIntoIdentityShuffle(IE) {
        IdentityShuf;
    } else {
        return IdentityShuf;
    }
    if narrowInsElt(IE, self.Builder) {
        Ext;
    } else {
        return Ext;
    }
    if foldTruncInsEltPair(IE, self.DL.isBigEndian(), self.Builder) {
        Ext;
    } else {
        return Ext;
    }
    return null;
}

fn canEvaluateShuffled(V: *mut Value, Mask: ArrayRef<int>, Depth: u32) -> bool {
    if isa(V) {
        return true;
    }
    let mut I: *mut Instruction = dyn_cast(V);
    if !I {
        return false;
    }
    if !I.hasOneUse() {
        return false;
    }
    if Depth == 0 {
        return false;
    }
    match I.getOpcode() {
        UDiv => {
            SDiv;
        },
        Add => {
            FAdd;
        },
        InsertElement => {
            let mut CI: *mut ConstantInt = dyn_cast(I.getOperand(2));
            if !CI {
                return false;
            }
            let mut ElementNumber: i32 = CI.getLimitedValue(~0);
            let mut SeenOnce: bool = false;
            for I in Mask {
                if I == ElementNumber {
                    if SeenOnce {
                        return false;
                    }
                    SeenOnce = true;
                }
            }
            return canEvaluateShuffled(I.getOperand(0), Mask, Depth - 1);
        },
    }
    return false;
}

fn buildNew(I: *mut Instruction, NewOps: ArrayRef<Value *>, Builder: *mut IRBuilderBase) -> *mut Value {
    Builder.SetInsertPoint(I);
    match I.getOpcode() {
        Add => {
            FAdd;
        },
        ICmp => {
            assert!(NewOps.len == 2, "icmp with #ops != 2");
            let mut New: *mut Value = Builder.CreateICmp(cast(I).getPredicate(), NewOps[0], NewOps[1], "");
            if dyn_cast(New) {
                NewI;
            } else {
                NewI.copyIRFlags(I, true);
            }
            return New;
        },
        FCmp => {
            assert!(NewOps.len == 2, "fcmp with #ops != 2");
        },
        Trunc => {
            ZExt;
        },
        GetElementPtr => {
            let mut Ptr: *mut Value = NewOps[0];
            let mut Idx: ArrayRef<Value *> = NewOps.slice(1);
            return Builder.CreateGEP(cast(I).getSourceElementType(), Ptr, Idx, "", cast(I).getNoWrapFlags());
        },
    }
    llvm_unreachable_internal("failed to rebuild vector instructions", "P:/Goraw/llvm-project/llvm/lib/Transforms/InstCombine/InstCombineVectorOps.cpp", 2113);
}

fn evaluateInDifferentElementOrder(V: *mut Value, Mask: ArrayRef<int>, Builder: *mut IRBuilderBase) -> *mut Value {
    assert!(V.getType().isVectorTy(), "can't reorder non-vector elements");
    let mut EltTy: *mut Type = V.getType().getScalarType();
    if isa(V) {
        return get(get(EltTy, Mask.len));
    }
    if match(V, m_Undef()) {
        return get(get(EltTy, Mask.len));
    }
    if isa(V) {
        return get(get(EltTy, Mask.len));
    }
    if dyn_cast(V) {
        C;
    } else {
        return getShuffleVector(C, get(C.getType()), Mask, null);
    }
    let mut I: *mut Instruction = cast(V);
    match I.getOpcode() {
        Add => {
            FAdd;
        },
        InsertElement => {
            let mut Element: i32 = cast(I.getOperand(2)).getLimitedValue(~0);
            let mut Found: bool = false;
            let mut Index: i32 = 0;
            for let mut e: i32 = Mask.len; Index != e; Index += 1 {
                if Mask[Index] == Element {
                    Found = true;
                    break;
                }
            }
            if !Found {
                return evaluateInDifferentElementOrder(I.getOperand(0), Mask, Builder);
            }
            let mut V: *mut Value = evaluateInDifferentElementOrder(I.getOperand(0), Mask, Builder);
            Builder.SetInsertPoint(I);
            return Builder.CreateInsertElement(V, I.getOperand(1), Index, "");
        },
    }
    llvm_unreachable_internal("failed to reorder elements of vector instruction!", "P:/Goraw/llvm-project/llvm/lib/Transforms/InstCombine/InstCombineVectorOps.cpp", 2215);
}

fn isShuffleExtractingFromLHS(SVI: *mut ShuffleVectorInst, Mask: ArrayRef<int>) -> bool {
    let mut LHSElems: u32 = cast(SVI.getOperand(0).getType()).getNumElements();
    let mut MaskElems: u32 = Mask.len;
    let mut BegIdx: u32 = Mask.front();
    let mut EndIdx: u32 = Mask.back();
    if BegIdx > EndIdx || EndIdx >= LHSElems || EndIdx - BegIdx != MaskElems - 1 {
        return false;
    }
    for let mut I: u32 = 0; I != MaskElems; I += 1 {
        if Mask[I] as u32 != BegIdx + I {
            return false;
        }
    }
    return true;
}

struct BinopElts {
    Opcode: BinaryOps,
    Op0: *mut Value,
    Op1: *mut Value,
}

fn getAlternateBinop(BO: *mut BinaryOperator, DL: *DataLayout) -> BinopElts {
    let mut BO0: *mut Value = BO.getOperand(0);
    let mut BO1: *mut Value = BO.getOperand(1);
    let mut Ty: *mut Type = BO.getType();
    match BO.getOpcode() {
        Shl => {
            let mut C: *mut Constant = null;
            if match(BO1, m_ImmConstant(C)) {
                let mut ShlOne: *mut Constant = ConstantFoldBinaryOpOperands(Shl, get(Ty, 1, false, false), C, DL);
                assert!(ShlOne, "Constant folding of immediate constants failed");
                return BinopElts { Opcode: Mul, Op0: BO0, Op1: ShlOne };
            }
            break;
        },
        Or => {
            if cast(BO).isDisjoint() {
                return BinopElts { Opcode: Add, Op0: BO0, Op1: BO1 };
            }
            break;
        },
        Sub => {
            if match(BO0, m_ZeroInt()) {
                return BinopElts { Opcode: Mul, Op0: BO1, Op1: getAllOnesValue(Ty) };
            }
        },
        _ => {
            break;
        },
    }
    return BinopElts { Opcode: 0 as BinaryOps, Op0: null, Op1: null };
}

fn foldSelectShuffleOfSelectShuffle(Shuf: *mut ShuffleVectorInst) -> *mut Instruction {
    assert!(Shuf.isSelect(), "Must have select-equivalent shuffle");
    let mut Op0: *mut Value = Shuf.getOperand(0);
    let mut Op1: *mut Value = Shuf.getOperand(1);
    let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> {};
    Shuf.getShuffleMask(Mask);
    let mut NumElts: u32 = Mask.len;
    let mut ShufOp: *mut ShuffleVectorInst = dyn_cast(Op0);
    if ShufOp && ShufOp.isSelect() && (ShufOp.getOperand(0) == Op1 || ShufOp.getOperand(1) == Op1) {
        swap(Op0, Op1);
        commuteShuffleMask(Mask, NumElts);
    }
    ShufOp = dyn_cast(Op1);
    if !ShufOp || !ShufOp.isSelect() || (ShufOp.getOperand(0) != Op0 && ShufOp.getOperand(1) != Op0) {
        return null;
    }
    let mut X: *mut Value = ShufOp.getOperand(0);
    let mut Y: *mut Value = ShufOp.getOperand(1);
    let mut Mask1: SmallVector<int, 16> = SmallVector<int, 16> {};
    ShufOp.getShuffleMask(Mask1);
    assert!(Mask1.len == NumElts, "Vector size changed with select shuffle");
    if Y == Op0 {
        swap(X, Y);
        commuteShuffleMask(Mask1, NumElts);
    }
    let mut NewMask: SmallVector<int, 16> = NumElts;
    for let mut i: u32 = 0; i != NumElts; i += 1 {
        NewMask[i] = if Mask[i] < NumElts as i32 { Mask[i] } else { Mask1[i] };
    }
    assert!((isSelectMask(NewMask, NumElts) || isIdentityMask(NewMask, NumElts)), "Unexpected shuffle mask");
    return ShuffleVectorInst { X, Y, NewMask, "", null };
}

fn foldSelectShuffleWith1Binop(Shuf: *mut ShuffleVectorInst, SQ: *SimplifyQuery) -> *mut Instruction {
    assert!(Shuf.isSelect(), "Must have select-equivalent shuffle");
    let mut Op0: *mut Value = Shuf.getOperand(0);
    let mut Op1: *mut Value = Shuf.getOperand(1);
    let mut C: *mut Constant = null;
    let mut Op0IsBinop: bool = false;
    if match(Op0, m_BinOp(m_Specific(Op1), m_Constant(C))) {
        Op0IsBinop = true;
    } else if match(Op1, m_BinOp(m_Specific(Op0), m_Constant(C))) {
        Op0IsBinop = false;
    } else {
        return null;
    }
    let mut BO: *mut BinaryOperator = cast(if Op0IsBinop { Op0 } else { Op1 });
    let mut BOpcode: BinaryOps = BO.getOpcode();
    let mut IdC: *mut Constant = getBinOpIdentity(BOpcode, Shuf.getType(), true, false);
    if !IdC {
        return null;
    }
    let mut X: *mut Value = if Op0IsBinop { Op1 } else { Op0 };
    let mut IsFloatingPointTy: bool = Shuf.getType().getElementType().isFloatingPointTy();
    if IsFloatingPointTy && !isKnownNeverNaN(X, SQ, 0) {
        return null;
    }
    let mut Mask: ArrayRef<int> = Shuf.getShuffleMask();
    let mut NewC: *mut Constant = if Op0IsBinop { getShuffleVector(C, IdC, Mask, null) } else { getShuffleVector(IdC, C, Mask, null) };
    let mut MightCreatePoisonOrUB: bool = is_contained(Mask, PoisonMaskElem) && (isIntDivRem(BOpcode) || isShift(BOpcode));
    if MightCreatePoisonOrUB {
        NewC = getSafeVectorConstantForBinop(BOpcode, NewC, true);
    }
    let mut NewBO: *mut BinaryOperator = Create(BOpcode, X, NewC, "", null);
    NewBO.copyIRFlags(BO, true);
    if IsFloatingPointTy && NewBO.hasNoInfs() && !isKnownNeverInfinity(X, SQ, 0) {
        NewBO.setHasNoInfs(false);
    }
    if is_contained(Mask, PoisonMaskElem) && !MightCreatePoisonOrUB {
        NewBO.dropPoisonGeneratingFlags();
    }
    return NewBO;
}

fn canonicalizeInsertSplat(Shuf: *mut ShuffleVectorInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Op0: *mut Value = Shuf.getOperand(0);
    let mut Op1: *mut Value = Shuf.getOperand(1);
    let mut Mask: ArrayRef<int> = Shuf.getShuffleMask();
    let mut X: *mut Value = null;
    let mut IndexC: u64 = 0;
    if !match(Op0, m_OneUse(m_InsertElt(m_Poison(), m_Value(X), m_ConstantInt(IndexC)))) || !match(Op1, m_Poison()) || match(Mask, m_ZeroMask {}) || IndexC == 0 {
        return null;
    }
    let mut PoisonVec: *mut PoisonValue = get(Shuf.getType());
    let mut NewIns: *mut Value = Builder.CreateInsertElement(PoisonVec, X, 0 as u64, "");
    let mut NumMaskElts: u32 = cast(Shuf.getType()).getNumElements();
    let mut NewMask: SmallVector<int, 16> = SmallVector<int, 16> { NumMaskElts, 0 };
    for let mut i: u32 = 0; i != NumMaskElts; i += 1 {
        if Mask[i] == PoisonMaskElem {
            NewMask[i] = Mask[i];
        }
    }
    return ShuffleVectorInst { NewIns, NewMask, "", null };
}

fn InstCombinerImpl::foldSelectShuffle(self, Shuf: *mut ShuffleVectorInst) -> *mut Instruction {
    if !Shuf.isSelect() {
        return null;
    }
    let mut NumElts: u32 = cast(Shuf.getType()).getNumElements();
    if !match(Shuf.getOperand(1), m_Undef()) && Shuf.getMaskValue(0) >= NumElts as i32 {
        Shuf.commute();
        return &mut Shuf;
    }
    if foldSelectShuffleOfSelectShuffle(Shuf) {
        I;
    } else {
        return I;
    }
    if foldSelectShuffleWith1Binop(Shuf, self.getSimplifyQuery().getWithInstruction(&mut Shuf)) {
        I;
    } else {
        return I;
    }
    let mut B0: *mut BinaryOperator = null;
    let mut B1: *mut BinaryOperator = null;
    if !match(Shuf.getOperand(0), m_BinOp(B0)) || !match(Shuf.getOperand(1), m_BinOp(B1)) {
        return null;
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut C0: *mut Constant = null;
    let mut C1: *mut Constant = null;
    let mut ConstantsAreOp1: bool = false;
    if match(B0, m_BinOp(m_Constant(C0), m_Value(X))) && match(B1, m_BinOp(m_Constant(C1), m_Value(Y))) {
        ConstantsAreOp1 = false;
    } else if match(B0, m_CombineOr(m_BinOp(m_Value(X), m_Constant(C0)), m_Neg(m_Value(X)))) && match(B1, m_CombineOr(m_BinOp(m_Value(Y), m_Constant(C1)), m_Neg(m_Value(Y)))) {
        ConstantsAreOp1 = true;
    } else {
        return null;
    }
    let mut Opc0: BinaryOps = B0.getOpcode();
    let mut Opc1: BinaryOps = B1.getOpcode();
    let mut DropNSW: bool = false;
    if ConstantsAreOp1 && Opc0 != Opc1 {
        if Opc0 == Shl || Opc1 == Shl {
            DropNSW = true;
        }
        if getAlternateBinop(B0, self.DL) {
            AltB0;
        } else {
            assert!(isa(AltB0.Op1), "Expecting constant with alt binop");
            Opc0 = AltB0.Opcode;
            C0 = cast(AltB0.Op1);
        }
    }
    if Opc0 != Opc1 || !C0 || !C1 {
        return null;
    }
    let mut BOpc: BinaryOps = Opc0;
    let mut Mask: ArrayRef<int> = Shuf.getShuffleMask();
    let mut NewC: *mut Constant = getShuffleVector(C0, C1, Mask, null);
    let mut MightCreatePoisonOrUB: bool = is_contained(Mask, PoisonMaskElem) && (isIntDivRem(BOpc) || isShift(BOpc));
    if MightCreatePoisonOrUB {
        NewC = getSafeVectorConstantForBinop(BOpc, NewC, ConstantsAreOp1);
    }
    let mut V: *mut Value = null;
    if X == Y {
        V = X;
    } else {
        if !B0.hasOneUse() && !B1.hasOneUse() {
            return null;
        }
        if MightCreatePoisonOrUB && !ConstantsAreOp1 {
            return null;
        }
        V = self.Builder.CreateShuffleVector(X, Y, Mask, "");
    }
    let mut NewBO: *mut Value = if ConstantsAreOp1 { self.Builder.CreateBinOp(BOpc, V, NewC, "", null) } else { self.Builder.CreateBinOp(BOpc, NewC, V, "", null) };
    if dyn_cast(NewBO) {
        NewI;
    } else {
        NewI.copyIRFlags(B0, true);
        NewI.andIRFlags(B1);
        if DropNSW {
            NewI.setHasNoSignedWrap(false);
        }
        if is_contained(Mask, PoisonMaskElem) && !MightCreatePoisonOrUB {
            NewI.dropPoisonGeneratingFlags();
        }
    }
    return self.replaceInstUsesWith(Shuf, NewBO);
}

fn foldTruncShuffle(Shuf: *mut ShuffleVectorInst, IsBigEndian: bool) -> *mut Instruction {
    let mut DestType: *mut Type = Shuf.getType();
    let mut X: *mut Value = null;
    if !match(Shuf.getOperand(0), m_BitCast(m_Value(X))) || !match(Shuf.getOperand(1), m_Poison()) || !DestType.isIntOrIntVectorTy() {
        return null;
    }
    let mut SrcType: *mut Type = X.getType();
    if !SrcType.isVectorTy() || !SrcType.isIntOrIntVectorTy() || cast(SrcType).getNumElements() != cast(DestType).getNumElements() || SrcType.getScalarSizeInBits() % DestType.getScalarSizeInBits() != 0 {
        return null;
    }
    assert!(Shuf.changesLength() && !Shuf.increasesLength(), "Expected a shuffle that decreases length");
    let mut TruncRatio: u64 = SrcType.getScalarSizeInBits() / DestType.getScalarSizeInBits();
    let mut Mask: ArrayRef<int> = Shuf.getShuffleMask();
    for let mut i: u32 = 0;
let mut e: u32 = Mask.len; i != e; i += 1 {
        if Mask[i] == PoisonMaskElem {
            continue;
        }
        let mut LSBIndex: u64 = if IsBigEndian { (i + 1) * TruncRatio - 1 } else { i * TruncRatio };
        assert!(LSBIndex <= 2147483647, "Overflowed 32-bits");
        if Mask[i] != LSBIndex as i32 {
            return null;
        }
    }
    return TruncInst { X, DestType, "", null };
}

fn narrowVectorSelect(Shuf: *mut ShuffleVectorInst, Builder: *mut BuilderTy) -> *mut Instruction {
    if !match(Shuf.getOperand(1), m_Poison()) || !Shuf.isIdentityWithExtract() {
        return null;
    }
    let mut Cond: *mut Value = null;
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if !match(Shuf.getOperand(0), m_OneUse(m_Select(m_Value(Cond), m_Value(X), m_Value(Y)))) {
        return null;
    }
    let mut NarrowNumElts: u32 = cast(Shuf.getType()).getNumElements();
    let mut NarrowCond: *mut Value = null;
    if !match(Cond, m_OneUse(m_Shuffle(m_Value(NarrowCond), m_Poison()))) || cast(NarrowCond.getType()).getNumElements() != NarrowNumElts || !cast(Cond).isIdentityWithPadding() {
        return null;
    }
    let mut NarrowX: *mut Value = Builder.CreateShuffleVector(X, Shuf.getShuffleMask(), "");
    let mut NarrowY: *mut Value = Builder.CreateShuffleVector(Y, Shuf.getShuffleMask(), "");
    return Create(NarrowCond, NarrowX, NarrowY, "", null, null);
}

fn foldShuffleOfUnaryOps(Shuf: *mut ShuffleVectorInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut S0: *mut Instruction = dyn_cast(Shuf.getOperand(0));
    let mut X: *mut Value = null;
    if !S0 || !match(S0, m_CombineOr(m_FNeg(m_Value(X)), m_FAbs(m_Value(X)))) {
        return null;
    }
    let mut IsFNeg: bool = S0.getOpcode() == FNeg;
    let mut S1: *mut Instruction = dyn_cast(Shuf.getOperand(1));
    let mut Y: *mut Value = null;
    if !S1 || !match(S1, m_CombineOr(m_FNeg(m_Value(Y)), m_FAbs(m_Value(Y)))) || S0.getOpcode() != S1.getOpcode() || (!S0.hasOneUse() && !S1.hasOneUse()) {
        return null;
    }
    let mut NewShuf: *mut Value = Builder.CreateShuffleVector(X, Y, Shuf.getShuffleMask(), "");
    let mut NewF: *mut Instruction = null;
    if IsFNeg {
        NewF = CreateFNeg(NewShuf, "");
    } else {
        let mut FAbs: *mut Function = getOrInsertDeclaration(Shuf.getModule(), fabs, Shuf.getType());
        NewF = Create(FAbs, [NewShuf], ArrayRef<OperandBundleDef> {}, "", null);
    }
    NewF.copyIRFlags(S0, true);
    NewF.andIRFlags(S1);
    return NewF;
}

fn foldCastShuffle(Shuf: *mut ShuffleVectorInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Cast0: *mut CastInst = dyn_cast(Shuf.getOperand(0));
    if !Cast0 {
        return null;
    }
    let mut CastOpcode: CastOps = Cast0.getOpcode();
    match CastOpcode {
        SExt => {
            ZExt;
        },
        _ => {
            return null;
        },
    }
    let mut CastSrcTy: *mut VectorType = cast(Cast0.getSrcTy());
    let mut ShufTy: *mut VectorType = Shuf.getType();
    let mut ShufOpTy: *mut VectorType = cast(Shuf.getOperand(0).getType());
    if ShufTy.getElementCount().getKnownMinValue() > ShufOpTy.getElementCount().getKnownMinValue() {
        return null;
    }
    if isa(Shuf.getOperand(1)) && Cast0.hasOneUse() && Shuf.isIdentityWithExtract() {
        let mut NewIns: *mut Value = Builder.CreateShuffleVector(Cast0.getOperand(0), get(CastSrcTy), Shuf.getShuffleMask(), "");
        return Create(Cast0.getOpcode(), NewIns, Shuf.getType(), "", null);
    }
    let mut Cast1: *mut CastInst = dyn_cast(Shuf.getOperand(1));
    if !Cast1 || Cast0.getOpcode() != Cast1.getOpcode() || Cast0.getSrcTy() != Cast1.getSrcTy() {
        return null;
    }
    assert!(isa(CastSrcTy) && isa(ShufOpTy), "Expected fixed vector operands for casts and binary shuffle");
    if CastSrcTy.getPrimitiveSizeInBits().operator unsigned long long() > ShufOpTy.getPrimitiveSizeInBits().operator unsigned long long() {
        return null;
    }
    if !Cast0.hasOneUse() && !Cast1.hasOneUse() {
        return null;
    }
    let mut X: *mut Value = Cast0.getOperand(0);
    let mut Y: *mut Value = Cast1.getOperand(0);
    let mut NewShuf: *mut Value = Builder.CreateShuffleVector(X, Y, Shuf.getShuffleMask(), "");
    return Create(CastOpcode, NewShuf, ShufTy, "", null);
}

fn foldIdentityExtractShuffle(Shuf: *mut ShuffleVectorInst) -> *mut Instruction {
    let mut Op0: *mut Value = Shuf.getOperand(0);
    let mut Op1: *mut Value = Shuf.getOperand(1);
    if !Shuf.isIdentityWithExtract() || !match(Op1, m_Poison()) {
        return null;
    }
    let mut X: *mut Value = null;
    if match(Op0, m_BitCast(m_InsertElt(m_Value(), m_Value(X), m_Zero()))) && X.getType().getPrimitiveSizeInBits() == Shuf.getType().getPrimitiveSizeInBits() {
        return BitCastInst { X, Shuf.getType(), "", null };
    }
    let mut Y: *mut Value = null;
    let mut Mask: ArrayRef<int> = ArrayRef<int> {};
    if !match(Op0, m_Shuffle(m_Value(X), m_Value(Y), Mask)) {
        return null;
    }
    if !Op0.hasOneUse() {
        return null;
    }
    let mut NumElts: u32 = cast(Shuf.getType()).getNumElements();
    let mut NewMask: SmallVector<int, 16> = NumElts;
    assert!(NumElts < Mask.len, "Identity with extract must have less elements than its inputs");
    for let mut i: u32 = 0; i != NumElts; i += 1 {
        let mut ExtractMaskElt: i32 = Shuf.getMaskValue(i);
        let mut MaskElt: i32 = Mask[i];
        NewMask[i] = if ExtractMaskElt == PoisonMaskElem { ExtractMaskElt } else { MaskElt };
    }
    return ShuffleVectorInst { X, Y, NewMask, "", null };
}

fn foldShuffleWithInsert(Shuf: *mut ShuffleVectorInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut V0: *mut Value = Shuf.getOperand(0);
    let mut V1: *mut Value = Shuf.getOperand(1);
    let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> {};
    Shuf.getShuffleMask(Mask);
    let mut NumElts: i32 = Mask.len;
    let mut InpNumElts: i32 = cast(V0.getType()).getNumElements();
    let mut X: *mut Value = null;
    let mut IdxC: u64 = 0;
    if match(V0, m_InsertElt(m_Value(X), m_Value(), m_ConstantInt(IdxC))) {
        if !is_contained(Mask, IdxC as i32) {
            return IC.replaceOperand(Shuf, 0, X);
        }
    }
    if match(V1, m_InsertElt(m_Value(X), m_Value(), m_ConstantInt(IdxC))) {
        IdxC += InpNumElts;
        if !is_contained(Mask, IdxC as i32) {
            return IC.replaceOperand(Shuf, 1, X);
        }
    }
    if NumElts != InpNumElts {
        return null;
    }
    let mut isShufflingScalarIntoOp1: Closure_6 = Closure_6 { V0: &mut V0, NumElts: &mut NumElts, Mask: &mut Mask };
    let mut Scalar: *mut Value = null;
    let mut IndexC: *mut ConstantInt = null;
    if isShufflingScalarIntoOp1.call(Scalar, IndexC) {
        return Create(V1, Scalar, IndexC, "", null);
    }
    swap(V0, V1);
    commuteShuffleMask(Mask, NumElts);
    if isShufflingScalarIntoOp1.call(Scalar, IndexC) {
        return Create(V1, Scalar, IndexC, "", null);
    }
    return null;
}

fn foldIdentityPaddedShuffles(Shuf: *mut ShuffleVectorInst) -> *mut Instruction {
    let mut Shuffle0: *mut ShuffleVectorInst = dyn_cast(Shuf.getOperand(0));
    let mut Shuffle1: *mut ShuffleVectorInst = dyn_cast(Shuf.getOperand(1));
    if !Shuffle0 || !Shuffle0.isIdentityWithPadding() || !Shuffle1 || !Shuffle1.isIdentityWithPadding() {
        return null;
    }
    let mut X: *mut Value = Shuffle0.getOperand(0);
    let mut Y: *mut Value = Shuffle1.getOperand(0);
    if X.getType() != Y.getType() || !isPowerOf2_32(cast(Shuf.getType()).getNumElements()) || !isPowerOf2_32(cast(Shuffle0.getType()).getNumElements()) || !isPowerOf2_32(cast(X.getType()).getNumElements()) || match(X, m_Undef()) || match(Y, m_Undef()) {
        return null;
    }
    assert!(match(Shuffle0.getOperand(1), m_Undef()) && match(Shuffle1.getOperand(1), m_Undef()), "Unexpected operand for identity shuffle");
    let mut NarrowElts: i32 = cast(X.getType()).getNumElements();
    let mut WideElts: i32 = cast(Shuffle0.getType()).getNumElements();
    assert!(WideElts > NarrowElts, "Unexpected types for identity with padding");
    let mut Mask: ArrayRef<int> = Shuf.getShuffleMask();
    let mut NewMask: SmallVector<int, 16> = SmallVector<int, 16> { Mask.len, -1 };
    for let mut i: i32 = 0;
let mut e: i32 = Mask.len; i != e; i += 1 {
        if Mask[i] == -1 {
            continue;
        }
        if Mask[i] < WideElts {
            if Shuffle0.getMaskValue(Mask[i]) == -1 {
                continue;
            }
        } else {
            if Shuffle1.getMaskValue(Mask[i] - WideElts) == -1 {
                continue;
            }
        }
        if Mask[i] < WideElts {
            assert!(Mask[i] < NarrowElts, "Unexpected shuffle mask");
            NewMask[i] = Mask[i];
        } else {
            assert!(Mask[i] < (WideElts + NarrowElts), "Unexpected shuffle mask");
            NewMask[i] = Mask[i] - (WideElts - NarrowElts);
        }
    }
    return ShuffleVectorInst { X, Y, NewMask, "", null };
}

fn InstCombinerImpl::simplifyBinOpSplats(self, SVI: *mut ShuffleVectorInst) -> *mut Instruction {
    if !match(SVI.getOperand(1), m_Poison()) || !match(SVI.getShuffleMask(), m_ZeroMask {}) || !SVI.getOperand(0).hasOneUse() {
        return null;
    }
    let mut Op0: *mut Value = SVI.getOperand(0);
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if !match(Op0, m_BinOp(m_Shuffle(m_Value(X), m_Poison(), m_ZeroMask {}), m_Value(Y))) && !match(Op0, m_BinOp(m_Value(X), m_Shuffle(m_Value(Y), m_Poison(), m_ZeroMask {}))) {
        return null;
    }
    if X.getType() != Y.getType() {
        return null;
    }
    let mut BinOp: *mut BinaryOperator = cast(Op0);
    if !isSafeToSpeculativelyExecuteWithVariableReplaced(BinOp, true) {
        return null;
    }
    let mut NewBO: *mut Value = self.Builder.CreateBinOp(BinOp.getOpcode(), X, Y, "", null);
    if dyn_cast(NewBO) {
        NewBOI;
    } else {
        NewBOI.copyIRFlags(BinOp, true);
    }
    return ShuffleVectorInst { NewBO, SVI.getShuffleMask(), "", null };
}

fn InstCombinerImpl::visitShuffleVectorInst(self, SVI: *mut ShuffleVectorInst) -> *mut Instruction {
    let mut LHS: *mut Value = SVI.getOperand(0);
    let mut RHS: *mut Value = SVI.getOperand(1);
    let mut ShufQuery: SimplifyQuery = self.SQ.getWithInstruction(&mut SVI);
    if simplifyShuffleVectorInst(LHS, RHS, SVI.getShuffleMask(), SVI.getType(), ShufQuery) {
        V;
    } else {
        return self.replaceInstUsesWith(SVI, V);
    }
    if self.simplifyBinOpSplats(SVI) {
        I;
    } else {
        return I;
    }
    if match(SVI.getShuffleMask(), m_ZeroMask {}) && !isa(RHS) {
        return self.replaceOperand(SVI, 1, get(RHS.getType()));
    }
    if isa(LHS.getType()) {
        return null;
    }
    let mut VWidth: u32 = cast(SVI.getType()).getNumElements();
    let mut LHSWidth: u32 = cast(LHS.getType()).getNumElements();
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(LHS, m_BitCast(m_Value(X))) && match(RHS, m_BitCast(m_Value(Y))) && X.getType().isVectorTy() && X.getType() == Y.getType() && X.getType().getScalarSizeInBits() == SVI.getType().getScalarSizeInBits() && (LHS.hasOneUse() || RHS.hasOneUse()) {
        let mut V: *mut Value = self.Builder.CreateShuffleVector(X, Y, SVI.getShuffleMask(), SVI.getName() + ".uncasted");
        return BitCastInst { V, SVI.getType(), "", null };
    }
    let mut Mask: ArrayRef<int> = SVI.getShuffleMask();
    if match(LHS, m_BitCast(m_Value(X))) && match(RHS, m_Undef()) && X.getType().isVectorTy() && VWidth == LHSWidth {
        let mut XType: *mut FixedVectorType = cast(X.getType());
        let mut XNumElts: u32 = XType.getNumElements();
        let mut ScaledMask: SmallVector<int, 16> = SmallVector<int, 16> {};
        if scaleShuffleMaskElts(XNumElts, Mask, ScaledMask) {
            if simplifyShuffleVectorInst(X, get(XType), ScaledMask, XType, ShufQuery) {
                V;
            } else {
                return Create(BitCast, V, SVI.getType(), "", null);
            }
        }
    }
    if LHS == RHS {
        assert!(!match(RHS, m_Undef()), "Shuffle with 2 undef ops not simplified?");
        return ShuffleVectorInst { LHS, createUnaryMask(Mask, LHSWidth), "", null };
    }
    if match(LHS, m_Undef()) {
        SVI.commute();
        return &mut SVI;
    }
    if canonicalizeInsertSplat(SVI, self.Builder) {
        I;
    } else {
        return I;
    }
    if self.foldSelectShuffle(SVI) {
        I;
    } else {
        return I;
    }
    if foldTruncShuffle(SVI, self.DL.isBigEndian()) {
        I;
    } else {
        return I;
    }
    if narrowVectorSelect(SVI, self.Builder) {
        I;
    } else {
        return I;
    }
    if foldShuffleOfUnaryOps(SVI, self.Builder) {
        I;
    } else {
        return I;
    }
    if foldCastShuffle(SVI, self.Builder) {
        I;
    } else {
        return I;
    }
    let mut PoisonElts: APInt = APInt { VWidth, 0, false, false };
    let mut AllOnesEltMask: APInt = getAllOnes(VWidth);
    if self.SimplifyDemandedVectorElts(&mut SVI, AllOnesEltMask, PoisonElts, 0, false) {
        V;
    } else {
        if V != &mut SVI {
            return self.replaceInstUsesWith(SVI, V);
        }
        return &mut SVI;
    }
    if foldIdentityExtractShuffle(SVI) {
        I;
    } else {
        return I;
    }
    if foldShuffleWithInsert(SVI, *self) {
        I;
    } else {
        return I;
    }
    if foldIdentityPaddedShuffles(SVI) {
        I;
    } else {
        return I;
    }
    if match(RHS, m_Constant()) {
        if dyn_cast(LHS) {
            SI;
        } else {
            if SI.getCondition().getType().isIntegerTy() && (isa(RHS) || isGuaranteedNotToBePoison(SI.getCondition(), null, null, null, 0)) {
                if self.FoldOpIntoSelect(SVI, SI, false, false) {
                    I;
                } else {
                    return I;
                }
            }
        }
        if dyn_cast(LHS) {
            PN;
        } else {
            if self.foldOpIntoPhi(SVI, PN, true) {
                I;
            } else {
                return I;
            }
        }
    }
    if match(RHS, m_Poison()) && canEvaluateShuffled(LHS, Mask, 5) {
        let mut V: *mut Value = evaluateInDifferentElementOrder(LHS, Mask, self.Builder);
        return self.replaceInstUsesWith(SVI, V);
    }
    let mut MadeChange: bool = false;
    if isShuffleExtractingFromLHS(SVI, Mask) {
        let mut V: *mut Value = LHS;
        let mut MaskElems: u32 = Mask.len;
        let mut SrcTy: *mut FixedVectorType = cast(V.getType());
        let mut VecBitWidth: u32 = self.DL.getTypeSizeInBits(SrcTy).operator unsigned long long();
        let mut SrcElemBitWidth: u32 = self.DL.getTypeSizeInBits(SrcTy.getElementType()).operator unsigned long long();
        assert!(SrcElemBitWidth, "vector elements must have a bitwidth");
        let mut SrcNumElems: u32 = SrcTy.getNumElements();
        let mut BCs: SmallVector<BitCastInst *, 8> = SmallVector<BitCastInst *, 8> {};
        let mut NewBCs: DenseMap<Type *, Value *> = DenseMap<Type *, Value *> {};
        for U in SVI.users() {
            if dyn_cast(U) {
                BC;
            } else {
                if BC.use_empty() {
                    continue;
                }
                if BC.hasOneUse() {
                    let mut BC2: *mut BitCastInst = dyn_cast(BC.user_back());
                    if BC2 && self.isEliminableCastPair(BC, BC2) {
                        continue;
                    }
                }
                BCs.push(BC);
            }
        }
        for BC in BCs {
            let mut BegIdx: u32 = Mask.front();
            let mut TgtTy: *mut Type = BC.getDestTy();
            let mut TgtElemBitWidth: u32 = self.DL.getTypeSizeInBits(TgtTy).operator unsigned long long();
            if !TgtElemBitWidth {
                continue;
            }
            let mut TgtNumElems: u32 = VecBitWidth / TgtElemBitWidth;
            let mut VecBitWidthsEqual: bool = VecBitWidth == TgtNumElems * TgtElemBitWidth;
            let mut BegIsAligned: bool = 0 == ((SrcElemBitWidth * BegIdx) % TgtElemBitWidth);
            if !VecBitWidthsEqual {
                continue;
            }
            if !isValidElementType(TgtTy) {
                continue;
            }
            let mut CastSrcTy: *mut FixedVectorType = get(TgtTy, TgtNumElems);
            if !BegIsAligned {
                let mut ShuffleMask: SmallVector<int, 16> = SmallVector<int, 16> { SrcNumElems, -1 };
                for let mut I: u32 = 0;
let mut E: u32 = MaskElems;
let mut Idx: u32 = BegIdx; I != E; Idx += 1 , I += 1 {
                    ShuffleMask[I] = Idx;
                }
                V = self.Builder.CreateShuffleVector(V, ShuffleMask, SVI.getName() + ".extract");
                BegIdx = 0;
            }
            let mut SrcElemsPerTgtElem: u32 = TgtElemBitWidth / SrcElemBitWidth;
            assert!(SrcElemsPerTgtElem);
            BegIdx /= SrcElemsPerTgtElem;
            if Inserted {
                operator(It).second = self.Builder.CreateBitCast(V, CastSrcTy, SVI.getName() + ".bc");
            }
            let mut Ext: *mut Value = self.Builder.CreateExtractElement(operator(It).second, BegIdx, SVI.getName() + ".extract");
            self.replaceInstUsesWith(*BC, Ext);
            MadeChange = true;
        }
    }
    let mut LHSShuffle: *mut ShuffleVectorInst = dyn_cast(LHS);
    let mut RHSShuffle: *mut ShuffleVectorInst = dyn_cast(RHS);
    if LHSShuffle {
        if !match(LHSShuffle.getOperand(1), m_Poison()) && !match(RHS, m_Poison()) {
            LHSShuffle = null;
        }
    }
    if RHSShuffle {
        if !match(RHSShuffle.getOperand(1), m_Poison()) {
            RHSShuffle = null;
        }
    }
    if !LHSShuffle && !RHSShuffle {
        return if MadeChange { &mut SVI } else { null };
    }
    let mut LHSOp0: *mut Value = null;
    let mut LHSOp1: *mut Value = null;
    let mut RHSOp0: *mut Value = null;
    let mut LHSOp0Width: u32 = 0;
    let mut RHSOp0Width: u32 = 0;
    if LHSShuffle {
        LHSOp0 = LHSShuffle.getOperand(0);
        LHSOp1 = LHSShuffle.getOperand(1);
        LHSOp0Width = cast(LHSOp0.getType()).getNumElements();
    }
    if RHSShuffle {
        RHSOp0 = RHSShuffle.getOperand(0);
        RHSOp0Width = cast(RHSOp0.getType()).getNumElements();
    }
    let mut newLHS: *mut Value = LHS;
    let mut newRHS: *mut Value = RHS;
    if LHSShuffle {
        if match(RHS, m_Poison()) {
            newLHS = LHSOp0;
            newRHS = LHSOp1;
        } else if LHSOp0Width == LHSWidth {
            newLHS = LHSOp0;
        }
    }
    if RHSShuffle && RHSOp0Width == LHSWidth {
        newRHS = RHSOp0;
    }
    if LHSOp0 == RHSOp0 {
        newLHS = LHSOp0;
        newRHS = null;
    }
    if newLHS == LHS && newRHS == RHS {
        return if MadeChange { &mut SVI } else { null };
    }
    let mut LHSMask: ArrayRef<int> = ArrayRef<int> {};
    let mut RHSMask: ArrayRef<int> = ArrayRef<int> {};
    if newLHS != LHS {
        LHSMask = LHSShuffle.getShuffleMask();
    }
    if RHSShuffle && newRHS != RHS {
        RHSMask = RHSShuffle.getShuffleMask();
    }
    let mut newLHSWidth: u32 = if (newLHS != LHS) { LHSOp0Width } else { LHSWidth };
    let mut newMask: SmallVector<int, 16> = SmallVector<int, 16> {};
    let mut isSplat: bool = true;
    let mut SplatElt: i32 = -1;
    for let mut i: u32 = 0; i < VWidth; i += 1 {
        let mut eltMask: i32 = 0;
        if Mask[i] < 0 {
            eltMask = -1;
        } else if Mask[i] < LHSWidth as i32 {
            if newLHS != LHS {
                eltMask = LHSMask[Mask[i]];
                if eltMask >= LHSOp0Width as i32 && isa(LHSOp1) {
                    eltMask = -1;
                }
            } else {
                eltMask = Mask[i];
            }
        } else {
            if match(RHS, m_Poison()) {
                eltMask = -1;
            } else if newRHS != RHS {
                eltMask = RHSMask[Mask[i] - LHSWidth];
                if eltMask >= RHSOp0Width as i32 {
                    assert!(match(RHSShuffle.getOperand(1), m_Poison()), "should have been check above");
                    eltMask = -1;
                }
            } else {
                eltMask = Mask[i] - LHSWidth;
            }
            if eltMask >= 0 && newRHS != null && newLHS != newRHS {
                eltMask += newLHSWidth;
            }
        }
        if eltMask >= 0 {
            if SplatElt >= 0 && SplatElt != eltMask {
                isSplat = false;
            }
            SplatElt = eltMask;
        }
        newMask.push(eltMask);
    }
    if isSplat || newMask == LHSMask || newMask == RHSMask || newMask == Mask {
        if !newRHS {
            newRHS = get(newLHS.getType());
        }
        return ShuffleVectorInst { newLHS, newRHS, newMask, "", null };
    }
    return if MadeChange { &mut SVI } else { null };
}

fn InstCombinerImpl::foldExtractionOfVectorDeinterleave(self, RootZExt: *mut ZExtInst) -> *mut Instruction {
    if self.DL.isBigEndian() {
        return null;
    }
    let mut DIV: *mut Value = null;
    let mut SVI: *mut Instruction = null;
    let mut DI: *mut Instruction = null;
    if !match(&mut RootZExt, m_ZExt(m_CombineOr(m_ExtractValue(m_Instruction(DI, m_Deinterleave2(m_Value(DIV)))), m_Instruction(SVI, m_Shuffle(m_Value(), m_Value()))))) {
        return null;
    }
    let mut isDeinterleaveShuffle: Closure_7 = Closure_7 {};
    if SVI {
        DIV = isDeinterleaveShuffle.call(SVI).first;
        if !DIV {
            return null;
        }
    } else {
        assert!(DI && DIV);
        if !all_of(DI.users(), Closure_8 {}) {
            return null;
        }
    }
    let mut InputVecTy: *mut VectorType = dyn_cast(DIV.getType());
    if !InputVecTy {
        return null;
    }
    let mut InElementTy: *mut IntegerType = dyn_cast(InputVecTy.getElementType());
    if !InElementTy {
        return null;
    }
    if !InputVecTy.getElementCount().isKnownEven() {
        return null;
    }
    let mut Fields: pair<Instruction *, unsigned int>, 4> = pair<Instruction *, unsigned int>, 4> {};
    if SVI {
        for Usr in DIV.users() {
            let mut FieldI: *mut Instruction = dyn_cast(Usr);
            if !FieldI {
                continue;
            }
            if V != DIV {
                continue;
            }
            assert!(Index < 2);
            if FieldI.getParent() != SVI.getParent() {
                continue;
            }
            if FieldI != SVI && FieldI.comesBefore(SVI) {
                SVI = FieldI;
            }
            Fields.push(ValueParamT { FieldI, Index });
        }
    } else {
        for Field in DI.users() {
            let mut FieldI: *mut ExtractValueInst = cast(Field);
            let mut FieldIdx: u32 = *FieldI.idx_begin();
            assert!(FieldIdx < 2);
            Fields.push(ValueParamT { FieldI, FieldIdx });
        }
    }
    let mut FieldReplacements: pair<ZExtInst *, unsigned int>, 4> = pair<ZExtInst *, unsigned int>, 4> {};
    for x in Fields {
        for FieldUsr in Field.users() {
            let mut ZExt: *mut ZExtInst = dyn_cast(FieldUsr);
            if !ZExt {
                return null;
            }
            if ZExt.getDestTy() != ZExt.getSrcTy().getExtendedType() {
                return null;
            }
            FieldReplacements.push(ValueParamT { ZExt, FieldIdx });
        }
    }
    self.Builder.SetInsertPoint(if DI { DI } else { SVI });
    let mut BitcastedTy: *mut VectorType = getExtendedElementVectorType(InputVecTy);
    BitcastedTy = getHalfElementsVectorType(BitcastedTy);
    let mut Freeze: *mut Value = self.Builder.CreateFreeze(DIV, "");
    let mut Bitcast: *mut Value = self.Builder.CreateBitCast(Freeze, BitcastedTy, "");
    let mut InElementBitWidth: u32 = InElementTy.getBitWidth();
    let mut Mask: APInt = getLowBitsSet(InElementBitWidth * 2, InElementBitWidth);
    let mut NewField0: *mut Value = self.Builder.CreateAnd(Bitcast, Mask, "");
    let mut NewField1: *mut Value = self.Builder.CreateLShr(Bitcast, InElementBitWidth, "", false);
    for x in FieldReplacements {
        assert!(Idx < 2, "unsupported field index");
        self.replaceInstUsesWith(*I, if Idx { NewField1 } else { NewField0 });
        self.addToWorklist(I);
    }
    return &mut RootZExt;
}

struct Closure_1 {
    AggElts: *mut optional<Instruction *>, 2>,
}

unsafe fn Closure_1::call(self: *mut Closure_1) -> bool {
        return !is_contained((*self.AggElts), NotFound);
    }

struct Closure_2 {}

fn Closure_2::call(self: *Closure_2, SourceAggregate: optional<Value *>) -> AggregateDescription {
        if SourceAggregate == NotFound {
            return NotFound;
        }
        if operator(SourceAggregate) == FoundMismatch {
            return FoundMismatch;
        }
        return Found;
    }

struct Closure_3 {
    EltDefinedInUseBB: *mut bool,
    AggTy: *mut *mut Type,
}

unsafe fn Closure_3::call(self: *mut Closure_3, Elt: *mut Instruction, EltIdx: u32, UseBB: optional<BasicBlock *>, PredBB: optional<BasicBlock *>) -> auto {
        if UseBB && PredBB {
            Elt = dyn_cast(Elt.DoPHITranslation(operator(UseBB), operator(PredBB)));
            if Elt && Elt.getParent() == operator(UseBB) {
                (*self.EltDefinedInUseBB) = true;
            }
        }
        let mut EVI: *mut ExtractValueInst = dyn_cast_or_null(Elt);
        if !EVI {
            return NotFound;
        }
        let mut SourceAggregate: *mut Value = EVI.getAggregateOperand();
        if SourceAggregate.getType() != (*self.AggTy) {
            return FoundMismatch;
        }
        if EVI.getNumIndices() != 1 || EltIdx != EVI.getIndices().front() {
            return FoundMismatch;
        }
        return SourceAggregate;
    }

struct Closure_4 {
    AggElts: *mut optional<Instruction *>, 2>,
    Describe: *mut (lambda at P:\Goraw\llvm-project\llvm\lib\Transforms\InstCombine\InstCombineVectorOps.cpp:1076:19),
    FindSourceAggregate: *mut (lambda at P:\Goraw\llvm-project\llvm\lib\Transforms\InstCombine\InstCombineVectorOps.cpp:1093:7),
}

unsafe fn Closure_4::call(self: *mut Closure_4, UseBB: optional<BasicBlock *>, PredBB: optional<BasicBlock *>) -> auto {
        let mut SourceAggregate: optional<Value *> = optional<Value *> {};
        for I in enumerate((*self.AggElts)) {
            assert!((*self.Describe).call(SourceAggregate) != FoundMismatch, "We don't store nullptr in SourceAggregate!");
            assert!(((*self.Describe).call(SourceAggregate) == Found) == (I.index() != 0), "SourceAggregate should be valid after the first element,");
            let mut SourceAggregateForElement: optional<Value *> = (*self.FindSourceAggregate).call(operator(I.value()), I.index(), UseBB, PredBB);
            if (*self.Describe).call(SourceAggregateForElement) != Found {
                return SourceAggregateForElement;
            }
            match (*self.Describe).call(SourceAggregate) {
                NotFound => {
                    SourceAggregate = SourceAggregateForElement;
                },
                Found => {
                    if operator(SourceAggregateForElement) != operator(SourceAggregate) {
                        return FoundMismatch;
                    }
                },
                FoundMismatch => {
                    llvm_unreachable_internal("Can't happen. We would have early-exited then.", "P:/Goraw/llvm-project/llvm/lib/Transforms/InstCombine/InstCombineVectorOps.cpp", 1163);
                },
            }
        }
        assert!((*self.Describe).call(SourceAggregate) == Found, "Must be a valid Value");
        return operator(SourceAggregate);
    }

struct Closure_5 {}

fn Closure_5::call(self: *Closure_5, Insert: *mut InsertElementInst) -> bool {
            if !Insert.hasOneUse() {
                return true;
            }
            let mut InsertUser: *mut InsertElementInst = dyn_cast(Insert.user_back());
            if !InsertUser {
                return true;
            }
            return false;
        }

struct Closure_6 {
    V0: *mut *mut Value,
    NumElts: *mut i32,
    Mask: *mut SmallVector<int, 16>,
}

unsafe fn Closure_6::call(self: *mut Closure_6, Scalar: *mut *mut Value, IndexC: *mut *mut ConstantInt) -> bool {
        if !match((*self.V0), m_InsertElt(m_Value(), m_Value(Scalar), m_ConstantInt(IndexC))) {
            return false;
        }
        let mut NewInsIndex: i32 = -1;
        for let mut i: i32 = 0; i != (*self.NumElts); i += 1 {
            if (*self.Mask)[i] == -1 {
                continue;
            }
            if (*self.Mask)[i] == (*self.NumElts) + i {
                continue;
            }
            if NewInsIndex != -1 || (*self.Mask)[i] != IndexC.getSExtValue() {
                return false;
            }
            NewInsIndex = i;
        }
        assert!(NewInsIndex != -1, "Did not fold shuffle with unused operand?");
        IndexC = get(IndexC.getIntegerType(), NewInsIndex, false, false);
        return true;
    }

struct Closure_7 {}

fn Closure_7::call(self: *mut Closure_7, I: *mut Instruction) -> auto {
        let mut V: *mut Value = null;
        let mut ShuffleMask: ArrayRef<int> = ArrayRef<int> {};
        let mut Index: u32 = 0;
        if match(I, m_Shuffle(m_Value(V), m_Undef(), ShuffleMask)) && isa(V.getType()) {
            let mut NumInputElements: u32 = cast(V.getType()).getElementCount().getFixedValue();
            if isDeInterleaveMaskOfFactor(ShuffleMask, 2, Index) && Index < 2 && isSingleSourceMask(ShuffleMask, NumInputElements) && ShuffleMask.len * 2 == NumInputElements {
                return pair<Value *, unsigned int> { V, Index };
            }
        }
        return pair<Value *, unsigned int> { null, 4294967295 };
    }

struct Closure_8 {}

fn Closure_8::call(self: *mut Closure_8, Usr: *mut User) -> auto {
            let mut EV: *mut ExtractValueInst = dyn_cast(Usr);
            return EV && EV.getNumIndices() == 1;
        }
