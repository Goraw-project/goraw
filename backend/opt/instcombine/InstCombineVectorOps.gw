    }
    return true;
}

fn collectShuffleElements(V: *mut Value, Mask: *mut SmallVectorImpl<int>, PermittedRHS: *mut Value, IC: *mut InstCombinerImpl, Rerun: *mut bool) -> ShuffleOps {
    assert!(V.getType().isVectorTy(), "Invalid shuffle!");
    let mut NumElts: u32 = cast(V.getType())();
    if match(V) {
        Mask()(NumElts, -1);
