        let mut ScalarVal: *mut Value = null;
        if PHIInVal(PHIUser) {
            let mut B0: *mut BinaryOperator = cast(PHIUser);
            let mut opId: u32 = if (B0.getOperand(0)) { 1 } else { 0 };
            let mut Op: *mut Value = null;
            let mut FirstOp: *mut Value = if (B0.getOperand(0)) { scalarPHI } else { Op };
            let mut SecondOp: *mut Value = if (B0.getOperand(0)) { Op } else { scalarPHI };
        } else {
            let mut newEI: *mut Instruction = Create(PHIInVal, Elt, "", null);
            let mut pos: *mut Instruction = dyn_cast(PHIInVal);
            let mut InsertPos: i32 = 0;
            if pos && !isa(pos) {
                InsertPos() = pos()() += 1;
            } else {
                InsertPos() = inBB()();
            }
        }
        ScalarizedValues()[inBB] = ScalarVal;
        scalarPHI.addIncoming(ScalarVal, inBB);
    }
    return &mut EI;
}

