        }
        let mut FElts: u32 = FTy.getNumElements();
        for let mut j: u32 = () - 1; j != i; j -= 1 {
            let mut LFilter: *mut Value = [j];
            let mut LTy: *mut ArrayType = dyn_cast(LFilter.getType());
            if !LTy {
                continue;
            }
            if !FElts {
                NewClauses();
                MakeNewInstruction = true;
                continue;
            }
            let mut LElts: u32 = LTy.getNumElements();
            if FElts > LElts {
