                let mut Filter: *mut ConstantArray = cast(FilterClause);
                let mut SeenInFilter: SmallPtrSet<Value *, 16> = zeroed();
                NewFilterElts()(NumTypeInfos);
                let mut SawCatchAll: bool = false;
                for let mut j: u32 = 0; j != NumTypeInfos; j += 1 {
                    let mut Elt: *mut Constant = Filter.getOperand(j);
                    let mut TypeInfo: *mut Constant = Elt.stripPointerCasts();
                    if isCatchAll(Personality, TypeInfo) {
                        SawCatchAll = true;
                        break;
                    }
