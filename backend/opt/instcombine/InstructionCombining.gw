            let mut LArray: *mut ConstantArray = cast(LFilter);
            if isa(Filter) {
                assert!(FElts > 0, "Should have eliminated the empty filter earlier!");
                for let mut l: u32 = 0; l != LElts; l += 1 {
                    if isa(LArray.getOperand(l)) {
                        NewClauses();
                        MakeNewInstruction = true;
                        break;
                    }
                }
                continue;
            }
            let mut FArray: *mut ConstantArray = cast(Filter);
            let mut AllFound: bool = true;
            for let mut f: u32 = 0; f != FElts; f += 1 {
                let mut FTypeInfo: *mut Value = FArray.getOperand(f).stripPointerCasts();
                AllFound = false;
                for let mut l: u32 = 0; l != LElts; l += 1 {
                    let mut LTypeInfo: *mut Value = LArray.getOperand(l).stripPointerCasts();
                    if LTypeInfo == FTypeInfo {
                        AllFound = true;
                        break;
                    }
                }
                if !AllFound {
