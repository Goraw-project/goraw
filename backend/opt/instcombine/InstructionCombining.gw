fn InstCombinePass::run(self, F: *mut Function, AM: *mut FunctionAnalysisManager) -> PreservedAnalyses {
    let mut LRT: *mut auto = AM()(F);
    if LRT()(&mut ID) {
        return all();
    }
    let mut AC: *mut auto = AM()(F);
    let mut DT: *mut auto = AM()(F);
    let mut TLI: *mut auto = AM()(F);
    let mut ORE: *mut auto = AM()(F);
    let mut TTI: *mut auto = AM()(F);
    let mut AA: *mut auto = operator&(AM()(F));
    let mut MAMProxy: *mut auto = AM()(F);
    let mut PSI: *mut ProfileSummaryInfo = (operator*(F));
    let mut BFI: *mut auto = if (PSI && PSI.hasProfileSummary()) { operator&(AM()(F)) } else { null };
    let mut BPI: *mut auto = AM()(F);
    if operator!(combineInstructionsOverFunction(F, PSI, self.Options)) {
        LRT()(&mut ID, false);
        return all();
    }
    let mut PA: PreservedAnalyses = PreservedAnalyses {};
    LRT()(&mut ID, true);
    PA;
    PA;
    return PA;
}

