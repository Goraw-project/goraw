fn Closure_31::call(self: *Closure_31, CB: *mut CallBase) -> bool {
                        let mut Alignment: *APInt = null;
                        let mut Size: *APInt = null;
                        return match(CB.getArgOperand(0), m_APInt(Alignment)) && match(CB.getArgOperand(1), m_APInt(Size)) && Alignment.isPowerOf2() && Size.urem(*Alignment).isZero();
                    }

struct Closure_32 {}

fn Closure_32::call(self: *Closure_32, BBI: iterator) -> CastReturnType {
        let mut FirstInstr: iterator = operator(BBI).getParent().begin();
        while true {
            {
            if BBI != FirstInstr {
                operator(BBI);
            }
        }
            if !(BBI != FirstInstr && operator(BBI).isDebugOrPseudoInst()) { break; }
        }
        return dyn_cast(BBI);
    }

struct Closure_33 {
    cap_0: *mut InstCombinerImpl,
    BB: *mut *mut BasicBlock,
}

unsafe fn Closure_33::call(self: *mut Closure_33, Pred: *mut BasicBlock) -> bool {
            return self.DeadEdges.contains(BasicBlock *> { Pred, (*self.BB) }) || self.DT.dominates((*self.BB), Pred);
        }

struct Closure_35 {}

fn Closure_35::call(self: *Closure_35, Case: *APInt, C: *APInt) -> APInt {
                return Case - C;
            }

struct Closure_36 {}

fn Closure_36::call(self: *Closure_36, Case: *APInt, C: *APInt) -> APInt {
                return C - Case;
            }

struct Closure_37 {}

fn Closure_37::call(self: *Closure_37, Case: *APInt, C: *APInt) -> APInt {
                return Case ^ C;
            }

struct Closure_34 {
    Op0: *mut *mut Value,
    CondOpC: *mut *APInt,
}

unsafe fn Closure_34::call(self: *mut Closure_34, Cond: *mut Value) -> auto {
        if match(Cond, m_Add(m_Value((*self.Op0)), m_APInt((*self.CondOpC)))) {
            return Closure_35 {};
        }
        if match(Cond, m_Sub(m_APInt((*self.CondOpC)), m_Value((*self.Op0)))) {
            return Closure_36 {};
        }
        if match(Cond, m_Xor(m_Value((*self.Op0)), m_APInt((*self.CondOpC)))) && !(*self.CondOpC).isMinSignedValue() && !(*self.CondOpC).isMaxSignedValue() {
            return Closure_37 {};
        }
        return null;
    }

struct Closure_38 {
    ShiftAmt: *mut u64,
}

unsafe fn Closure_38::call(self: *mut Closure_38) {
        return Case.getCaseValue().getValue().countr_zero() >= (*self.ShiftAmt);
    }

struct Closure_39 {
    IsZExt: *mut bool,
    NewWidth: *mut u32,
}

unsafe fn Closure_39::call(self: *mut Closure_39) {
            let mut CaseVal: *APInt = Case.getCaseValue().getValue();
            return if (*self.IsZExt) { CaseVal.isIntN((*self.NewWidth)) } else { CaseVal.isSignedIntN((*self.NewWidth)) };
        }

struct Closure_40 {
    cap_0: *mut InstCombinerImpl,
    FI: *mut FreezeInst,
    Users: *mut SmallVector<User *>,
}

unsafe fn Closure_40::call(self: *mut Closure_40, U: *mut Use) -> auto {
        if !self.DT.dominates(&mut (*self.FI), U) {
            return false;
        }
        (*self.Users).push(U.getUser());
        return true;
    }

struct Closure_42 {}

fn Closure_42::call(self: *mut Closure_42, PN: *mut PHINode) -> auto {
            let mut BestValue: *mut Constant = null;
            for V in PN.incoming_values() {
                if match(V, m_Freeze(m_Undef())) {
                    continue;
                }
                let mut C: *mut Constant = dyn_cast(V);
                if !C {
                    return null;
                }
                if !isGuaranteedNotToBeUndefOrPoison(C, null, null, null, 0) {
                    return null;
                }
                if BestValue && BestValue != C {
                    return null;
                }
                BestValue = C;
            }
            return BestValue;
        }

struct Closure_41 {
    I: *mut FreezeInst,
    cap_1: *mut InstCombinerImpl,
}

unsafe fn Closure_41::call(self: *mut Closure_41, Ty: *mut Type) -> *mut Value {
        let mut pickCommonConstantFromPHI: Closure_42 = Closure_42 {};
        let mut NullValue: *mut Value = getNullValue(Ty);
        let mut BestValue: *mut Value = null;
        for U in (*self.I).users() {
            let mut V: *mut Value = NullValue;
            if match(U, m_Or(m_Value(), m_Value())) {
                V = getAllOnesValue(Ty);
            } else if match(U, m_Select(m_Specific(&mut (*self.I)), m_Constant(), m_Value())) {
                V = getTrue(Ty);
            } else if match(U, m_c_Select(m_Specific(&mut (*self.I)), m_Value(V))) {
                if V == &mut (*self.I) || !isGuaranteedNotToBeUndefOrPoison(V, &mut self.AC, &mut (*self.I), &mut self.DT, 0) {
                    V = NullValue;
                }
            } else if dyn_cast(U) {
                PHI;
            } else {
                if pickCommonConstantFromPHI.call(*PHI) {
                    MaybeV;
                } else {
                    V = MaybeV;
                }
            }
            if !BestValue {
                BestValue = V;
            } else if BestValue != V {
                BestValue = NullValue;
            }
        }
        assert!(BestValue, "Must have at least one use");
        assert!(BestValue != &mut (*self.I), "Cannot replace with itself");
        return BestValue;
    }

struct Closure_43 {}

fn Closure_43::call(self: *mut Closure_43, C: *mut Constant) -> auto {
        let mut Ty: *mut Type = C.getType();
        let mut VTy: *mut FixedVectorType = dyn_cast(Ty);
        if !VTy {
            return null;
        }
        let mut BestValue: *mut Constant = null;
        if !match(C, m_ContainsMatchingVectorElement(m_CombineAnd(m_Unless(m_Undef()), m_Constant(BestValue)))) {
            BestValue = getNullValue(VTy.getScalarType());
        }
        return replaceUndefsWith(C, BestValue);
    }

struct Closure_44 {
    Visited: *mut SmallPtrSet<const User *, 4>,
    AllocaUsers: *mut SmallVector<const User *>,
}

unsafe fn Closure_44::call(self: *mut Closure_44, I: *Instruction) {
        for U in I.users() {
            if (*self.Visited).insert(U).second {
                (*self.AllocaUsers).push(U);
            }
        }
    }

struct Closure_45 {
    DestBlock: *mut *mut BasicBlock,
    cap_1: *mut InstCombinerImpl,
}

unsafe fn Closure_45::call(self: *mut Closure_45, U: *Use) -> bool {
        let mut I: *mut Instruction = dyn_cast(U.getUser());
        if I && I.getParent() != (*self.DestBlock) {
            self.Worklist.add(I);
            return true;
        }
        return false;
    }

struct Closure_46 {}

fn Closure_46::call(self: *mut Closure_46, A: *mut DbgVariableRecord, B: *mut DbgVariableRecord) -> auto {
        return B.getInstruction().comesBefore(A.getInstruction());
    }

struct Closure_47 {
    cap_0: *mut InstCombinerImpl,
}

fn Closure_47::call(self: *mut Closure_47, I: *mut Instruction) -> auto {
            if !self.CLOpts.code_sinking {
                return nullopt;
            }
            let mut BB: *mut BasicBlock = I.getParent();
            let mut UserParent: *mut BasicBlock = null;
            let mut NumUsers: u32 = 0;
            for U in I.uses() {
                let mut User: *mut User = U.getUser();
                if User.isDroppable() {
                    let mut II: CastReturnType = dyn_cast(User);
                    if II.getIntrinsicID() != assume || !II.getOperandBundle("dereferenceable") {
                        continue;
                    }
                }
                if NumUsers > self.CLOpts.max_sink_users {
                    return nullopt;
                }
                let mut UserInst: *mut Instruction = cast(User);
                let mut UserBB: *mut BasicBlock = UserInst.getParent();
                if dyn_cast(UserInst) {
                    PN;
                } else {
                    UserBB = PN.getIncomingBlock(U);
                }
                if UserParent && UserParent != UserBB {
                    return nullopt;
                }
                UserParent = UserBB;
                if NumUsers == 0 {
                    if UserParent == BB || !self.DT.isReachableFromEntry(UserParent) {
                        return nullopt;
                    }
                    let mut Term: *mut Instruction = UserParent.getTerminator();
                    if UserParent.getUniquePredecessor() != BB && !succ_empty(Term) {
                        return nullopt;
                    }
                    assert!(self.DT.dominates(BB, UserParent), "Dominance relation broken?");
                }
                NumUsers += 1;
            }
            if !UserParent {
                return nullopt;
            }
            return UserParent;
        }

struct Closure_48 {}

fn Closure_48::call(self: *Closure_48) {
        let mut MDScopeList: *MDNode const = dyn_cast_or_null(ScopeList);
        if !MDScopeList || operator!(Container.insert(MDScopeList).second) {
            return null;
        }
        for MDOperand in MDScopeList.operands() {
            if dyn_cast(MDOperand) {
                MDScope;
            } else {
                Container.insert(MDScope);
            }
        }
        return MDScopeList;
    }

struct Closure_49 {
    cap_0: *mut InstCombinerImpl,
    MadeIRChange: *mut bool,
}

unsafe fn Closure_49::call(self: *mut Closure_49, BB: *mut BasicBlock, LiveSucc: *mut BasicBlock) {
        for Succ in successors(BB) {
            if Succ != LiveSucc && self.DeadEdges.insert(BasicBlock *> { BB, Succ }).second {
                for PN in Succ.phis() {
                    for U in PN.incoming_values() {
                        if PN.getIncomingBlock(U) == BB && !isa(U) {
                            U.set(get(PN.getType()));
                            (*self.MadeIRChange) = true;
                        }
                    }
                }
            }
        }
    }

struct Closure_50 {
    cap_0: *mut InstCombinerImpl,
    BB: *mut *mut BasicBlock,
}

unsafe fn Closure_50::call(self: *mut Closure_50, Pred: *mut BasicBlock) -> bool {
            return self.DeadEdges.contains(BasicBlock *> { Pred, (*self.BB) }) || self.DT.dominates((*self.BB), Pred);
        }
