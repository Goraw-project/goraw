    }
    if dyn_cast(PtrOp) {
        PN;
    } else {
        if foldGEPOfPhi(GEP, PN, self.Builder) {
            NewPtrOp;
        } else {
            return self.replaceOperand(GEP, 0, NewPtrOp);
        }
    }
    if dyn_cast(PtrOp) {
        Src;
    } else if self.visitGEPOfGEP(GEP, Src) {
        I;
    } else {
        return I;
    }
    if GEP.getNumIndices() == 1 {
        let mut AS: u32 = GEP.getPointerAddressSpace();
        if GEP.getOperand(1).getType().getScalarSizeInBits() == self.DL.getIndexSizeInBits(AS) {
            let mut TyAllocSize: u64 = self.DL.getTypeAllocSize(GEPEltType).getFixedValue();
            if TyAllocSize == 1 {
                let mut X: *mut Value = GEP.getPointerOperand();
                let mut Y: *mut Value = null;
                if match(GEP.getOperand(1), m_Sub(m_PtrToIntOrAddr(m_Value(Y)), m_PtrToIntOrAddr(m_Specific(X)))) && GEPType == Y.getType() {
                    let mut HasNonAddressBits: bool = self.DL.getAddressSizeInBits(AS) != self.DL.getPointerSizeInBits(AS);
                    let mut Changed: bool = GEP.replaceUsesWithIf(Y, function_ref<bool (Use &)> { Closure_28 { HasNonAddressBits: &mut HasNonAddressBits }, null, null });
                    return if Changed { &mut GEP } else { null };
                }
            } else if dyn_cast(GEP.getOperand(1)) {
                ExactIns;
            } else {
                let mut V: *mut Value = null;
                if ExactIns.isExact() {
                    if (has_single_bit(TyAllocSize) && match(GEP.getOperand(1), m_Shr(m_Value(V), m_SpecificInt(countr_zero(TyAllocSize))))) || match(GEP.getOperand(1), m_IDiv(m_Value(V), m_SpecificInt(TyAllocSize))) {
                        return Create(self.Builder.getInt8Ty(), GEP.getPointerOperand(), V, GEP.getNoWrapFlags(), "", null);
                    }
                }
                if ExactIns.isExact() && ExactIns.hasOneUse() {
                    let mut C: *APInt = null;
                    let mut NewC: optional<APInt> = optional<APInt> {};
                    if has_single_bit(TyAllocSize) && match(ExactIns, m_Shr(m_Value(V), m_APInt(C))) && C.uge(countr_zero(TyAllocSize)) {
                        NewC = *C - countr_zero(TyAllocSize);
                    } else if match(ExactIns, m_UDiv(m_Value(V), m_APInt(C))) {
                        let mut Quot: APInt = APInt {};
                        let mut Rem: u64 = 0;
                        udivrem(*C, TyAllocSize, Quot, Rem);
                        if Rem == 0 {
                            NewC = Quot;
                        }
                    } else if match(ExactIns, m_SDiv(m_Value(V), m_APInt(C))) {
                        let mut Quot: APInt = APInt {};
                        let mut Rem: i64 = 0;
                        sdivrem(*C, TyAllocSize, Quot, Rem);
                        if !Quot.isAllOnes() && Rem == 0 {
                            NewC = Quot;
                        }
                    }
                    if NewC.has_value() {
                        let mut NewOp: *mut Value = self.Builder.CreateExactBinOp(ExactIns.getOpcode() as BinaryOps, V, get(V.getType(), operator(NewC)), true, "");
                        return Create(self.Builder.getInt8Ty(), GEP.getPointerOperand(), NewOp, GEP.getNoWrapFlags(), "", null);
                    }
                }
            }
        }
    }
    if GEPType.isVectorTy() {
        return null;
    }
    if !GEP.isInBounds() {
        let mut IdxWidth: u32 = self.DL.getIndexSizeInBits(PtrOp.getType().getPointerAddressSpace());
        let mut BasePtrOffset: APInt = APInt { IdxWidth, 0, false, false };
        let mut UnderlyingPtrOp: *mut Value = PtrOp.stripAndAccumulateInBoundsConstantOffsets(self.DL, BasePtrOffset);
        let mut CanBeNull: bool = false;
        let mut DerefBytes: u64 = UnderlyingPtrOp.getPointerDereferenceableBytes(self.DL, CanBeNull, null);
        if !CanBeNull && DerefBytes != 0 {
            if GEP.accumulateConstantOffset(self.DL, BasePtrOffset) && BasePtrOffset.isNonNegative() {
                let mut AllocSize: APInt = APInt { IdxWidth, DerefBytes, false, false };
                if BasePtrOffset.ule(AllocSize) {
                    return CreateInBounds(GEP.getSourceElementType(), PtrOp, Indices, GEP.getName(), null);
                }
            }
        }
    }
    if GEP.hasNoUnsignedSignedWrap() && !GEP.hasNoUnsignedWrap() && all_of(GEP.indices(), Closure_29 { cap_0: self, GEP: &mut GEP }) {
        GEP.setNoWrapFlags(GEP.getNoWrapFlags() | noUnsignedWrap());
        return &mut GEP;
    }
    if GEP.getNumIndices() == 1 {
        let mut GetPreservedNoWrapFlags: Closure_30 = Closure_30 { GEP: &mut GEP };
        let mut Idx1: *mut Value = null;
        let mut Idx2: *mut Value = null;
        if match(GEP.getOperand(1), m_OneUse(m_AddLike(m_Value(Idx1), m_Value(Idx2)))) {
            let mut NUW: bool = match(GEP.getOperand(1), m_NUWAddLike(m_Value(), m_Value()));
            let mut NWFlags: GEPNoWrapFlags = GetPreservedNoWrapFlags.call(NUW);
            let mut NewPtr: *mut Value = self.Builder.CreateGEP(GEP.getSourceElementType(), GEP.getPointerOperand(), Idx1, "", NWFlags);
            return self.replaceInstUsesWith(GEP, self.Builder.CreateGEP(GEP.getSourceElementType(), NewPtr, Idx2, "", NWFlags));
        }
        let mut C: *mut ConstantInt = null;
        if match(GEP.getOperand(1), m_OneUse(m_SExtLike(m_OneUse(m_NSWAddLike(m_Value(Idx1), m_ConstantInt(C)))))) {
            let mut NUW: bool = match(GEP.getOperand(1), m_NNegZExt(m_NUWAddLike(m_Value(), m_Value())));
            let mut NWFlags: GEPNoWrapFlags = GetPreservedNoWrapFlags.call(NUW);
            let mut NewPtr: *mut Value = self.Builder.CreateGEP(GEP.getSourceElementType(), GEP.getPointerOperand(), self.Builder.CreateSExt(Idx1, GEP.getOperand(1).getType(), ""), "", NWFlags);
            return self.replaceInstUsesWith(GEP, self.Builder.CreateGEP(GEP.getSourceElementType(), NewPtr, self.Builder.CreateSExt(C, GEP.getOperand(1).getType(), ""), "", NWFlags));
        }
    }
    if foldSelectGEP(GEP, self.Builder) {
        R;
    } else {
        return R;
    }
    if Indices.len == 1 && GEP.isInBounds() && GEP.hasNoUnsignedWrap() {
        let mut X: *mut Value = null;
        let mut Y: *mut Value = null;
        if match(Indices[0], m_OneUse(m_SRem(m_Value(X), m_Value(Y)))) && self.isKnownToBeAPowerOfTwo(Y, true, &mut GEP, 0) {
            let mut OldIdxI: *mut Instruction = cast(Indices[0]);
            let mut NewIdx: *mut Value = self.Builder.CreateURem(X, Y, OldIdxI.getName());
            return Create(GEPEltType, PtrOp, [NewIdx], GEP.getNoWrapFlags(), "", null);
        }
    }
    return null;
}

fn isNeverEqualToUnescapedAlloc(V: *mut Value, TLI: *TargetLibraryInfo, AI: *mut Instruction) -> bool {
    if isa(V) {
        return true;
    }
    if dyn_cast(V) {
        LI;
    } else {
        return isa(LI.getPointerOperand());
    }
    return isAllocLikeFn(V, &mut TLI) && V != AI;
}

fn isRemovableWrite(CB: *mut CallBase, UsedV: *mut Value, TLI: *TargetLibraryInfo) -> bool {
    if !CB.use_empty() {
        return false;
    }
    if CB.isTerminator() {
        return false;
    }
    if !CB.willReturn() || !CB.doesNotThrow() {
        return false;
    }
    let mut Dest: optional<MemoryLocation> = getForDest(&mut CB, TLI);
    return Dest && operator(Dest).Ptr == UsedV;
}

fn isAllocSiteRemovable(AI: *mut Instruction, Users: *mut SmallVectorImpl<Instruction *>, TLI: *TargetLibraryInfo, KnowInit: bool, MaxUsers: u32) -> optional<ModRefInfo> {
    let mut Worklist: SmallVector<Instruction *, 4> = SmallVector<Instruction *, 4> {};
    let mut Family: optional<StringRef> = getAllocationFamily(AI, &mut TLI);
    Worklist.push(AI);
    let mut Access: ModRefInfo = if KnowInit { NoModRef } else { Mod };
    while true {
        {
        let mut PI: *mut Instruction = Worklist.pop_back_val();
        for U in PI.users() {
            let mut I: *mut Instruction = cast(U);
            if Users.len >= MaxUsers {
                return nullopt;
            }
            match I.getOpcode() {
                _ => {
                    return nullopt;
                },
                AddrSpaceCast => {
                    BitCast;
                },
                ICmp => {
                    let mut ICI: *mut ICmpInst = cast(I);
                    if !ICI.isEquality() {
                        return nullopt;
                    }
                    let mut OtherIndex: u32 = if (ICI.getOperand(0) == PI) { 1 } else { 0 };
                    if !isNeverEqualToUnescapedAlloc(ICI.getOperand(OtherIndex), TLI, AI) {
                        return nullopt;
                    }
                    let mut AlignmentAndSizeKnownValid: Closure_31 = Closure_31 {};
                    let mut CB: *mut CallBase = dyn_cast(AI);
                    if CB && TLI.getLibFunc(*CB.getCalledFunction()) == LibFunc_aligned_alloc && TLI.has(LibFunc_aligned_alloc) && !AlignmentAndSizeKnownValid.call(CB) {
                        return nullopt;
                    }
                    Users.push(I);
                    continue;
                },
                Call => {
                    if dyn_cast(I) {
                        II;
                    } else {
                        match II.getIntrinsicID() {
                            _ => {
                                return nullopt;
                            },
                            memmove => {
                                memcpy;
                            },
                            assume => {
                                invariant_start;
                            },
                            launder_invariant_group => {
                                Users.push(I);
                            },
                        }
                    }
                },
                Store => {
                    let mut SI: *mut StoreInst = cast(I);
                    if SI.isVolatile() || SI.getPointerOperand() != PI {
                        return nullopt;
                    }
                    if isRefSet(Access) {
                        return nullopt;
                    }
                    operator(Access, Mod);
                    Users.push(I);
                    continue;
                },
                Load => {
                    let mut LI: *mut LoadInst = cast(I);
                    if LI.isVolatile() || LI.getPointerOperand() != PI {
                        return nullopt;
                    }
                    if isModSet(Access) {
                        return nullopt;
                    }
                    operator(Access, Ref);
                    Users.push(I);
                    continue;
                },
            }
            llvm_unreachable_internal("missing a return?", "P:/Goraw/llvm-project/llvm/lib/Transforms/InstCombine/InstructionCombining.cpp", 3855);
        }
    }
        if !(!Worklist.is_empty()) { break; }
    }
    assert!(Access != ModRef);
    return Access;
}

fn InstCombinerImpl::visitAllocSite(self, MI: *mut Instruction) -> *mut Instruction {
    assert!(isa(MI) || isRemovableAlloc(&mut cast(MI), &mut self.TLI);
    let mut RawUsers: SmallVector<Instruction *, 64> = SmallVector<Instruction *, 64> {};
    let mut DVRs: SmallVector<DbgVariableRecord *, 8> = SmallVector<DbgVariableRecord *, 8> {};
    let mut DIB: unique_ptr<DIBuilder> = unique_ptr<DIBuilder> {};
    if isa(MI) {
        findDbgUsers(&mut MI, DVRs);
        DIB.reset(DIBuilder { *MI.getModule(), false, null });
    }
    let mut KnowInitUndef: bool = false;
    let mut KnowInitZero: bool = false;
    let mut Init: *mut Constant = getInitialValueOfAllocation(&mut MI, &mut self.TLI, getInt8Ty(MI.getContext()));
    if Init {
        if isa(Init) {
            KnowInitUndef = true;
        } else if Init.isNullValue() {
            KnowInitZero = true;
        }
    }
    let mut F: *mut Function = *MI.getFunction();
    if F.hasFnAttribute(SanitizeMemory) || F.hasFnAttribute(SanitizeAddress) {
        KnowInitUndef = false;
    }
    let mut Removable: optional<ModRefInfo> = isAllocSiteRemovable(&mut MI, RawUsers, self.TLI, KnowInitZero | KnowInitUndef, self.CLOpts.max_allocsite_removable_users);
    if Removable {
        let mut Users: SmallVector<WeakTrackingVH, 64> = SmallVector<WeakTrackingVH, 64> { RawUsers.begin(), RawUsers.end() };
        for User in Users {
            if !User.operator llvm::Value *() {
                continue;
            }
            let mut I: *mut Instruction = cast(&mut operator(User));
            if dyn_cast(I) {
                II;
            } else {
                if II.getIntrinsicID() == objectsize {
                    let mut InsertedInstructions: SmallVector<Instruction *> = SmallVector<Instruction *> {};
                    let mut Result: *mut Value = lowerObjectSizeCall(II, self.DL, &mut self.TLI, self.AA, true, &mut InsertedInstructions);
                    for Inserted in InsertedInstructions {
                        self.Worklist.add(Inserted);
                    }
                    self.replaceInstUsesWith(*I, Result);
                    self.eraseInstFromFunction(*I);
                    User = null;
                    continue;
                }
                if dyn_cast(I) {
                    MTI;
                } else {
                    if KnowInitZero && isRefSet(operator(Removable)) {
                        let mut Guard: InsertPointGuard = self.Builder;
                        self.Builder.SetInsertPoint(MTI);
                        let mut M: *mut CallInst = self.Builder.CreateMemSet(MTI.getRawDest(), get(getInt8Ty(MI.getContext()), 0, false, false), MTI.getLength(), MTI.getDestAlign(), false, AAMDNodes {});
                        M.copyMetadata(*MTI, ArrayRef<unsigned int> {});
                    }
                }
            }
        }
        for User in Users {
            if !User.operator llvm::Value *() {
                continue;
            }
            let mut I: *mut Instruction = cast(&mut operator(User));
            if dyn_cast(I) {
                C;
            } else {
                self.replaceInstUsesWith(*C, get(C.getType(), C.isFalseWhenEqual(), false, false));
            }
            self.eraseInstFromFunction(*I);
        }
        if dyn_cast(&mut MI) {
            II;
        } else {
            let mut M: *mut Module = II.getModule();
            let mut F: *mut Function = getOrInsertDeclaration(M, donothing, ArrayRef<Type *> {});
            let mut NewII: *mut InvokeInst = Create(F, II.getNormalDest(), II.getUnwindDest(), ArrayRef<Value *> {}, "", II.getParent());
            NewII.setDebugLoc(II.getDebugLoc());
        }
        for DVR in DVRs {
            if DVR.isAddressOfVariable() || DVR.getExpression().startsWithDeref() {
                DVR.eraseFromParent();
            }
        }
        return self.eraseInstFromFunction(MI);
    }
    return null;
}

fn tryToMoveFreeBeforeNullTest(FI: *mut CallInst, DL: *DataLayout) -> *mut Instruction {
    let mut Op: *mut Value = FI.getArgOperand(0);
    let mut FreeInstrBB: *mut BasicBlock = FI.getParent();
    let mut PredBB: *mut BasicBlock = FreeInstrBB.getSinglePredecessor();
    if !PredBB {
        return null;
    }
    let mut SuccBB: *mut BasicBlock = null;
    let mut FreeInstrBBTerminator: *mut Instruction = FreeInstrBB.getTerminator();
    if !match(FreeInstrBBTerminator, m_UnconditionalBr(SuccBB)) {
        return null;
    }
    if FreeInstrBB.len != 2 {
        for Inst in *FreeInstrBB {
            if &mut Inst == &mut FI || &mut Inst == FreeInstrBBTerminator || isa(Inst) {
                continue;
            }
            let mut Cast: *CastInst = dyn_cast(&mut Inst);
            if !Cast || !Cast.isNoopCast(DL) {
                return null;
            }
        }
    }
    let mut TI: *mut Instruction = PredBB.getTerminator();
    let mut TrueBB: *mut BasicBlock = null;
    let mut FalseBB: *mut BasicBlock = null;
    let mut Pred: CmpPredicate = CmpPredicate {};
    if !match(TI, m_Br(m_ICmp(Pred, m_CombineOr(m_Specific(Op), m_Specific(Op.stripPointerCasts())), m_Zero()), TrueBB, FalseBB)) {
        return null;
    }
    if Pred != ICMP_EQ && Pred != ICMP_NE {
        return null;
    }
    if SuccBB != (if Pred == ICMP_EQ { TrueBB } else { FalseBB }) {
        return null;
    }
    assert!(FreeInstrBB == (if Pred == ICMP_EQ { FalseBB } else { TrueBB }), "Broken CFG: missing edge from predecessor to successor");
    for Instr in make_early_inc_range(*FreeInstrBB) {
        if &mut Instr == FreeInstrBBTerminator {
            break;
        }
        Instr.moveBeforePreserving(TI.getIterator());
    }
    assert!(FreeInstrBB.len == 1, "Only the branch instruction should remain");
    let mut Attrs: AttributeList = FI.getAttributes();
    Attrs = Attrs.removeParamAttribute(FI.getContext(), 0, NonNull);
    let mut Dereferenceable: Attribute = Attrs.getParamAttr(0, Dereferenceable);
    if Dereferenceable.isValid() {
        let mut Bytes: u64 = Dereferenceable.getDereferenceableBytes();
        Attrs = Attrs.removeParamAttribute(FI.getContext(), 0, Dereferenceable);
        Attrs = Attrs.addDereferenceableOrNullParamAttr(FI.getContext(), 0, Bytes);
    }
    FI.setAttributes(Attrs);
    return &mut FI;
}

fn InstCombinerImpl::visitFree(self, FI: *mut CallInst, Op: *mut Value) -> *mut Instruction {
    if isa(Op) {
        self.CreateNonTerminatorUnreachable(&mut FI);
        return self.eraseInstFromFunction(FI);
    }
    if isa(Op) {
        return self.eraseInstFromFunction(FI);
    }
    let mut CI: *mut CallInst = dyn_cast(Op);
    if CI && CI.hasOneUse() {
        if getReallocatedOperand(CI) {
            ReallocatedOp;
        } else {
            return self.eraseInstFromFunction(*self.replaceInstUsesWith(*CI, ReallocatedOp));
        }
    }
    if self.MinimizeSize {
        if self.TLI.getLibFunc(FI) == LibFunc_free && self.TLI.has(LibFunc_free) {
            if tryToMoveFreeBeforeNullTest(FI, self.DL) {
                I;
            } else {
                return I;
            }
        }
    }
    return null;
}

fn InstCombinerImpl::visitReturnInst(self, RI: *mut ReturnInst) -> *mut Instruction {
    let mut RetVal: *mut Value = RI.getReturnValue();
    if !RetVal {
        return null;
    }
    let mut F: *mut Function = RI.getFunction();
    let mut RetTy: *mut Type = RetVal.getType();
    if RetTy.isPointerTy() {
        let mut UseProvenance: bool = F.getAttributes().getRetDereferenceableBytes() > 0 && !NullPointerIsDefined(F, RetTy.getPointerAddressSpace());
        if F.hasRetAttribute(NonNull) || UseProvenance {
            if self.simplifyNonNullOperand(RetVal, UseProvenance, 0) {
                V;
            } else {
                return self.replaceOperand(RI, 0, V);
            }
        }
    }
    if !isNoFPClassCompatibleType(RetTy) {
        return null;
    }
    let mut ReturnClass: FPClassTest = F.getAttributes().getRetNoFPClass();
    if ReturnClass == fcNone {
        return null;
    }
    let mut KnownClass: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
    if self.SimplifyDemandedFPClass(&mut RI, 0, operator(ReturnClass), KnownClass, self.SQ.getWithInstruction(&mut RI), 0) {
        return &mut RI;
    }
    return null;
}

fn InstCombinerImpl::removeInstructionsBeforeUnreachable(self, I: *mut Instruction) -> bool {
    let mut Changed: bool = false;
    while I.getPrevNode() {
        Prev;
    }
    return Changed;
}

fn InstCombinerImpl::visitUnreachableInst(self, I: *mut UnreachableInst) -> *mut Instruction {
    self.removeInstructionsBeforeUnreachable(I);
    return null;
}

fn InstCombinerImpl::visitUncondBrInst(self, BI: *mut UncondBrInst) -> *mut Instruction {
    let mut GetLastSinkableStore: Closure_32 = Closure_32 {};
    if GetLastSinkableStore.call(BI) {
        SI;
    } else if self.mergeStoreIntoSuccessor(*SI) {
        return &mut BI;
    }
    return null;
}

fn InstCombinerImpl::addDeadEdge(self, From: *mut BasicBlock, To: *mut BasicBlock, Worklist: *mut SmallVectorImpl<BasicBlock *>) {
    if !self.DeadEdges.insert(BasicBlock *> { From, To }).second {
        return;
    }
    for PN in To.phis() {
        for U in PN.incoming_values() {
            if PN.getIncomingBlock(U) == From && !isa(U) {
                self.replaceUse(U, get(PN.getType()));
                self.addToWorklist(&mut PN);
                self.MadeIRChange = true;
            }
        }
    }
    Worklist.push(To);
}

fn InstCombinerImpl::handleUnreachableFrom(self, I: *mut Instruction, Worklist: *mut SmallVectorImpl<BasicBlock *>) {
    let mut BB: *mut BasicBlock = I.getParent();
    for Inst in make_early_inc_range(make_range(next(BB.getTerminator().getReverseIterator(), 1), next(I.getReverseIterator(), 1))) {
        if !Inst.use_empty() && !Inst.getType().isTokenTy() {
            self.replaceInstUsesWith(Inst, get(Inst.getType()));
            self.MadeIRChange = true;
        }
        if Inst.isEHPad() || Inst.getType().isTokenTy() {
            continue;
        }
        Inst.dropDbgRecords();
        self.eraseInstFromFunction(Inst);
        self.MadeIRChange = true;
    }
    let mut Changed: SmallVector<Value *> = SmallVector<Value *> {};
    if handleUnreachableTerminator(BB.getTerminator(), Changed) {
        self.MadeIRChange = true;
        for V in Changed {
            self.addToWorklist(cast(V));
        }
    }
    for Succ in successors(BB) {
        self.addDeadEdge(BB, Succ, Worklist);
    }
}

fn InstCombinerImpl::handlePotentiallyDeadBlocks(self, Worklist: *mut SmallVectorImpl<BasicBlock *>) {
    while !Worklist.is_empty() {
        let mut BB: *mut BasicBlock = Worklist.pop_back_val();
        if !all_of(predecessors(BB), Closure_33 { cap_0: self, BB: &mut BB }) {
            continue;
        }
        self.handleUnreachableFrom(&mut BB.front(), Worklist);
    }
}

fn InstCombinerImpl::handlePotentiallyDeadSuccessors(self, BB: *mut BasicBlock, LiveSucc: *mut BasicBlock) {
    let mut Worklist: SmallVector<BasicBlock *> = SmallVector<BasicBlock *> {};
    for Succ in successors(BB) {
        if Succ == LiveSucc {
            continue;
        }
        self.addDeadEdge(BB, Succ, Worklist);
    }
    self.handlePotentiallyDeadBlocks(Worklist);
}

fn InstCombinerImpl::visitCondBrInst(self, BI: *mut CondBrInst) -> *mut Instruction {
    let mut Cond: *mut Value = BI.getCondition();
    let mut X: *mut Value = null;
    if match(Cond, m_Not(m_Value(X))) && !isa(X) {
        BI.swapSuccessors();
        if self.BPI {
            self.BPI.swapSuccEdgesProbabilities(BI.getParent());
        }
        return self.replaceOperand(BI, 0, X);
    }
    let mut Y: *mut Value = null;
    if isa(Cond) && match(Cond, m_OneUse(m_LogicalAnd(m_Value(X), m_OneUse(m_Not(m_Value(Y)))))) {
        let mut NotX: *mut Value = self.Builder.CreateNot(X, "not." + X.getName());
        let mut Or: *mut Value = self.Builder.CreateLogicalOr(NotX, Y, "", null);
        if dyn_cast(Or) {
            OrInst;
        } else {
            if dyn_cast(Cond) {
                CondInst;
            } else {
                let mut Weights: SmallVector<uint32_t> = SmallVector<uint32_t> {};
                if extractBranchWeights(*CondInst, Weights) {
                    assert!(Weights.len == 2, "Unexpected number of branch weights!");
                    swap(Weights[0], Weights[1]);
                    setBranchWeights(*OrInst, Weights, false, false);
                }
            }
        }
        BI.swapSuccessors();
        if self.BPI {
            self.BPI.swapSuccEdgesProbabilities(BI.getParent());
        }
        return self.replaceOperand(BI, 0, Or);
    }
    if !isa(Cond) && BI.getSuccessor(0) == BI.getSuccessor(1) {
        return self.replaceOperand(BI, 0, getFalse(Cond.getType()));
    }
    let mut Pred: CmpPredicate = CmpPredicate {};
    if match(Cond, m_OneUse(m_FCmp(Pred, m_Value(), m_Value()))) && !isCanonicalPredicate(Pred) {
        let mut Cmp: *mut CmpInst = cast(Cond);
        Cmp.setPredicate(getInversePredicate(Pred.operator llvm::CmpInst::Predicate()));
        BI.swapSuccessors();
        if self.BPI {
            self.BPI.swapSuccEdgesProbabilities(BI.getParent());
        }
        self.Worklist.push(Cmp);
        return &mut BI;
    }
    if isa(Cond) {
        self.handlePotentiallyDeadSuccessors(BI.getParent(), null);
        return null;
    }
    if dyn_cast(Cond) {
        CI;
    } else {
        self.handlePotentiallyDeadSuccessors(BI.getParent(), BI.getSuccessor(!CI.getZExtValue()));
        return null;
    }
    if !isa(Cond) && BI.getSuccessor(0) != BI.getSuccessor(1) {
        for U in make_early_inc_range(Cond.uses()) {
            let mut Edge0: BasicBlockEdge = BasicBlockEdge { Start: BI.getParent(), End: BI.getSuccessor(0) };
            if self.DT.dominates(Edge0, U) {
                self.replaceUse(U, getTrue(Cond.getType()));
                self.addToWorklist(cast(U.getUser()));
                continue;
            }
            let mut Edge1: BasicBlockEdge = BasicBlockEdge { Start: BI.getParent(), End: BI.getSuccessor(1) };
            if self.DT.dominates(Edge1, U) {
                self.replaceUse(U, getFalse(Cond.getType()));
                self.addToWorklist(cast(U.getUser()));
            }
        }
    }
    self.DC.registerBranch(&mut BI);
    return null;
}

fn simplifySwitchOnSelectUsingRanges(SI: *mut SwitchInst, Select: *mut SelectInst, IsTrueArm: bool) -> *mut Value {
    let mut CstOpIdx: u32 = if IsTrueArm { 1 } else { 2 };
    let mut C: *mut ConstantInt = dyn_cast(Select.getOperand(CstOpIdx));
    if !C {
        return null;
    }
    let mut CstBB: *mut BasicBlock = operator(operator(SI.findCaseValue(C))).getCaseSuccessor();
    if CstBB != SI.getDefaultDest() {
        return null;
    }
    let mut X: *mut Value = Select.getOperand(3 - CstOpIdx);
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut RHSC: *APInt = null;
    if !match(Select.getCondition(), m_ICmp(Pred, m_Specific(X), m_APInt(RHSC))) {
        return null;
    }
    if IsTrueArm {
        Pred = CmpPredicate { Pred: getInversePredicate(Pred.operator llvm::CmpInst::Predicate()), HasSameSign: false };
    }
    let mut CR: ConstantRange = makeExactICmpRegion(Pred.operator llvm::CmpInst::Predicate(), *RHSC);
    for Case in SI.cases() {
        if !CR.contains(Case.getCaseValue().getValue()) {
            return null;
        }
    }
    return X;
}

fn InstCombinerImpl::visitSwitchInst(self, SI: *mut SwitchInst) -> *mut Instruction {
    let mut Cond: *mut Value = SI.getCondition();
    let mut Op0: *mut Value = null;
    let mut CondOpC: *APInt = null;
    let mut MaybeInvertible: Closure_34 = Closure_34 { Op0: &mut Op0, CondOpC: &mut CondOpC };
    let mut InvertFn: InvertFn = MaybeInvertible.call(Cond);
    if InvertFn && Cond.hasOneUse() {
        for Case in SI.cases() {
            let mut New: *APInt = InvertFn.call(Case.getCaseValue().getValue(), *CondOpC);
            Case.setValue(get(SI.getContext(), New));
        }
        return self.replaceOperand(SI, 0, Op0);
    }
    let mut ShiftAmt: u64 = 0;
    if match(Cond, m_Shl(m_Value(Op0), m_ConstantInt(ShiftAmt))) && ShiftAmt < Op0.getType().getScalarSizeInBits() && all_of(SI.cases(), Closure_38 { ShiftAmt: &mut ShiftAmt }) {
        let mut Shl: *mut OverflowingBinaryOperator = cast(Cond);
        if Shl.hasNoUnsignedWrap() || Shl.hasNoSignedWrap() || Shl.hasOneUse() {
            let mut NewCond: *mut Value = Op0;
            if !Shl.hasNoUnsignedWrap() && !Shl.hasNoSignedWrap() {
                let mut BitWidth: u32 = Op0.getType().getScalarSizeInBits();
                NewCond = self.Builder.CreateAnd(Op0, getLowBitsSet(BitWidth, BitWidth - ShiftAmt), "");
            }
            for Case in SI.cases() {
                let mut CaseVal: *APInt = Case.getCaseValue().getValue();
                let mut ShiftedCase: APInt = if Shl.hasNoSignedWrap() { CaseVal.ashr(ShiftAmt) } else { CaseVal.lshr(ShiftAmt) };
                Case.setValue(get(SI.getContext(), ShiftedCase));
            }
            return self.replaceOperand(SI, 0, NewCond);
        }
    }
    if match(Cond, m_ZExtOrSExt(m_Value(Op0))) {
        let mut IsZExt: bool = isa(Cond);
        let mut SrcTy: *mut Type = Op0.getType();
        let mut NewWidth: u32 = SrcTy.getScalarSizeInBits();
        if all_of(SI.cases(), Closure_39 { IsZExt: &mut IsZExt, NewWidth: &mut NewWidth }) {
            for Case in SI.cases() {
                let mut TruncatedCase: APInt = Case.getCaseValue().getValue().trunc(NewWidth);
                Case.setValue(get(SI.getContext(), TruncatedCase));
            }
            return self.replaceOperand(SI, 0, Op0);
        }
    }
    if dyn_cast(Cond) {
        Select;
    } else {
        if simplifySwitchOnSelectUsingRanges(SI, Select, true) {
            V;
        } else {
            return self.replaceOperand(SI, 0, V);
        }
        if simplifySwitchOnSelectUsingRanges(SI, Select, false) {
            V;
        } else {
            return self.replaceOperand(SI, 0, V);
        }
    }
    let mut Known: KnownBits = self.computeKnownBits(Cond, &mut SI, 0);
    let mut LeadingKnownZeros: u32 = Known.countMinLeadingZeros();
    let mut LeadingKnownOnes: u32 = Known.countMinLeadingOnes();
    for C in SI.cases() {
        LeadingKnownZeros = if LeadingKnownZeros < C.getCaseValue().getValue().countl_zero() { LeadingKnownZeros } else { C.getCaseValue().getValue().countl_zero() };
        LeadingKnownOnes = if LeadingKnownOnes < C.getCaseValue().getValue().countl_one() { LeadingKnownOnes } else { C.getCaseValue().getValue().countl_one() };
    }
    let mut NewWidth: u32 = Known.getBitWidth() - if LeadingKnownZeros > LeadingKnownOnes { LeadingKnownZeros } else { LeadingKnownOnes };
    if NewWidth > 0 && NewWidth < Known.getBitWidth() && self.shouldChangeType(Known.getBitWidth(), NewWidth) {
        let mut Ty: *mut IntegerType = get(SI.getContext(), NewWidth);
        self.Builder.SetInsertPoint(&mut SI);
        let mut NewCond: *mut Value = self.Builder.CreateTrunc(Cond, Ty, "trunc", false, false);
        for Case in SI.cases() {
            let mut TruncatedCase: APInt = Case.getCaseValue().getValue().trunc(NewWidth);
            Case.setValue(get(SI.getContext(), TruncatedCase));
        }
        return self.replaceOperand(SI, 0, NewCond);
    }
    if isa(Cond) {
        self.handlePotentiallyDeadSuccessors(SI.getParent(), null);
        return null;
    }
    if dyn_cast(Cond) {
        CI;
    } else {
        self.handlePotentiallyDeadSuccessors(SI.getParent(), operator(operator(SI.findCaseValue(CI))).getCaseSuccessor());
        return null;
    }
    return null;
}

fn InstCombinerImpl::foldExtractOfOverflowIntrinsic(self, EV: *mut ExtractValueInst) -> *mut Instruction {
    let mut WO: *mut WithOverflowInst = dyn_cast(EV.getAggregateOperand());
    if !WO {
        return null;
    }
    let mut OvID: ID = WO.getIntrinsicID();
    let mut C: *APInt = null;
    if match(WO.getRHS(), m_APIntAllowPoison(C)) {
        if *EV.idx_begin() == 0 && (OvID == smul_with_overflow || OvID == umul_with_overflow) {
            if C.isAllOnes() {
                return CreateNeg(WO.getLHS(), "", null);
            }
            if C.isPowerOf2() {
                return CreateShl(WO.getLHS(), get(WO.getLHS().getType(), C.logBase2(), false, false), "");
            }
        }
    }
    if !WO.hasOneUse() {
        return null;
    }
    if *EV.idx_begin() == 0 {
        let mut BinOp: BinaryOps = WO.getBinaryOp();
        let mut LHS: *mut Value = WO.getLHS();
        let mut RHS: *mut Value = WO.getRHS();
        self.replaceInstUsesWith(*WO, get(WO.getType()));
        self.eraseInstFromFunction(*WO);
        return Create(BinOp, LHS, RHS, "", null);
    }
    assert!(*EV.idx_begin() == 1, "Unexpected extract index for overflow inst");
    if OvID == usub_with_overflow {
        return ICmpInst { ICMP_ULT, WO.getLHS(), WO.getRHS(), "" };
    }
    if OvID == smul_with_overflow && WO.getLHS().getType().isIntOrIntVectorTy(1) {
        return CreateAnd(WO.getLHS(), WO.getRHS(), "");
    }
    if OvID == umul_with_overflow && WO.getLHS() == WO.getRHS() {
        let mut BitWidth: u32 = WO.getLHS().getType().getScalarSizeInBits();
        if BitWidth % 2 == 0 {
            return ICmpInst { ICMP_UGT, WO.getLHS(), get(WO.getLHS().getType(), getLowBitsSet(BitWidth, BitWidth / 2)), "" };
        }
    }
    if C {
        let mut NWR: ConstantRange = makeExactNoWrapRegion(WO.getBinaryOp(), *C, WO.getNoWrapKind());
        let mut Pred: Predicate = zeroed();
        let mut NewRHSC: APInt = APInt {};
        let mut Offset: APInt = APInt {};
        NWR.getEquivalentICmp(Pred, NewRHSC, Offset);
        let mut OpTy: *mut Type = WO.getRHS().getType();
        let mut NewLHS: *mut Value = WO.getLHS();
        if Offset != 0 {
            NewLHS = self.Builder.CreateAdd(NewLHS, get(OpTy, Offset), "", false, false);
        }
        return ICmpInst { getInversePredicate(Pred), NewLHS, get(OpTy, NewRHSC), "" };
    }
    return null;
}

fn foldFrexpOfSelect(EV: *mut ExtractValueInst, FrexpCall: *mut IntrinsicInst, SelectInst: *mut SelectInst, Builder: *mut BuilderTy) -> *mut Value {
    if !SelectInst.hasOneUse() || !FrexpCall.hasOneUse() {
        return null;
    }
    let mut Cond: *mut Value = SelectInst.getCondition();
    let mut TrueVal: *mut Value = SelectInst.getTrueValue();
    let mut FalseVal: *mut Value = SelectInst.getFalseValue();
    let mut ConstVal: *APFloat = null;
    let mut VarOp: *mut Value = null;
    let mut ConstIsTrue: bool = false;
    if match(TrueVal, m_APFloat(ConstVal)) {
        VarOp = FalseVal;
        ConstIsTrue = true;
    } else if match(FalseVal, m_APFloat(ConstVal)) {
        VarOp = TrueVal;
        ConstIsTrue = false;
    } else {
        return null;
    }
    Builder.SetInsertPoint(&mut EV);
    let mut NewFrexp: *mut CallInst = Builder.CreateCall(FrexpCall.getCalledFunction(), [VarOp], "frexp", null);
    NewFrexp.copyIRFlags(FrexpCall, true);
    let mut NewEV: *mut Value = Builder.CreateExtractValue(NewFrexp, 0, "mantissa");
    let mut Exp: i32 = 0;
    let mut Mantissa: APFloat = frexp(*ConstVal, Exp, rmNearestTiesToEven);
    let mut ConstantMantissa: *mut Constant = get(TrueVal.getType(), Mantissa);
    let mut NewSel: *mut Value = Builder.CreateSelectFMF(Cond, if ConstIsTrue { ConstantMantissa } else { NewEV }, if ConstIsTrue { NewEV } else { ConstantMantissa }, SelectInst, "select.frexp", null);
    return NewSel;
}

fn InstCombinerImpl::visitExtractValueInst(self, EV: *mut ExtractValueInst) -> *mut Instruction {
    let mut Agg: *mut Value = EV.getAggregateOperand();
    if !EV.hasIndices() {
        return self.replaceInstUsesWith(EV, Agg);
    }
    if simplifyExtractValueInst(Agg, EV.getIndices(), self.SQ.getWithInstruction(&mut EV)) {
        V;
    } else {
        return self.replaceInstUsesWith(EV, V);
    }
    let mut Cond: *mut Value = null;
    let mut TrueVal: *mut Value = null;
    let mut FalseVal: *mut Value = null;
    if match(&mut EV, m_ExtractValue(m_Intrinsic(m_Select(m_Value(Cond), m_Value(TrueVal), m_Value(FalseVal))))) {
        let mut SelInst: *mut SelectInst = cast(cast(Agg).getArgOperand(0));
        if foldFrexpOfSelect(EV, cast(Agg), SelInst, self.Builder) {
            Result;
        } else {
            return self.replaceInstUsesWith(EV, Result);
        }
    }
    if dyn_cast(Agg) {
        IV;
    } else {
        let mut exti: *u32 = null;
        let mut exte: *u32 = null;
        let mut insi: *u32 = null;
        let mut inse: *u32 = null;
        for exti = EV.idx_begin() , insi = IV.idx_begin() , exte = EV.idx_end() , inse = IV.idx_end(); exti != exte && insi != inse; exti += 1 , insi += 1 {
            if *insi != *exti {
                return Create(IV.getAggregateOperand(), EV.getIndices(), "", null);
            }
        }
        if exti == exte && insi == inse {
            return self.replaceInstUsesWith(EV, IV.getInsertedValueOperand());
        }
        if exti == exte {
            let mut NewEV: *mut Value = self.Builder.CreateExtractValue(IV.getAggregateOperand(), EV.getIndices(), "");
            return Create(NewEV, IV.getInsertedValueOperand(), ArrayRef<unsigned int> { insi, inse }, "", null);
        }
        if insi == inse {
            return Create(IV.getInsertedValueOperand(), ArrayRef<unsigned int> { exti, exte }, "", null);
        }
    }
    if self.foldExtractOfOverflowIntrinsic(EV) {
        R;
    } else {
        return R;
    }
    if dyn_cast(Agg) {
        L;
    } else {
        let mut STy: *mut StructType = dyn_cast(Agg.getType());
        if STy && STy.isScalableTy() {
            return null;
        }
        if L.isSimple() && L.hasOneUse() {
            let mut Indices: SmallVector<Value *, 4> = SmallVector<Value *, 4> {};
            Indices.push(self.Builder.getInt32(0));
            for Idx in EV.indices() {
                Indices.push(self.Builder.getInt32(Idx));
            }
            self.Builder.SetInsertPoint(L);
            let mut GEP: *mut Value = self.Builder.CreateInBoundsGEP(L.getType(), L.getPointerOperand(), Indices, "");
            let mut NL: *mut Instruction = self.Builder.CreateLoad(EV.getType(), GEP, "");
            NL.setAAMetadata(L.getAAMetadata());
            return self.replaceInstUsesWith(EV, NL);
        }
    }
    if dyn_cast(Agg) {
        PN;
    } else if self.foldOpIntoPhi(EV, PN, false) {
        Res;
    } else {
        return Res;
    }
    if dyn_cast(Agg) {
        SI;
    } else if self.FoldOpIntoSelect(EV, SI, true, false) {
        R;
    } else {
        return R;
    }
    return null;
}

fn isCatchAll(Personality: EHPersonality, TypeInfo: *mut Constant) -> bool {
    match Personality {
        GNU_C => {
            GNU_C_SjLj;
        },
        Unknown => {
            return false;
        },
        GNU_Ada => {
            return false;
        },
        GNU_CXX => {
            GNU_CXX_SjLj;
        },
    }
    llvm_unreachable_internal("invalid enum", "P:/Goraw/llvm-project/llvm/lib/Transforms/InstCombine/InstructionCombining.cpp", 4865);
}

fn shorter_filter(LHS: *Value, RHS: *Value) -> bool {
    return cast(LHS.getType()).getNumElements() < cast(RHS.getType()).getNumElements();
}

fn InstCombinerImpl::visitLandingPadInst(self, LI: *mut LandingPadInst) -> *mut Instruction {
    let mut Personality: EHPersonality = classifyEHPersonality(LI.getParent().getParent().getPersonalityFn());
    let mut MakeNewInstruction: bool = false;
    let mut NewClauses: SmallVector<Constant *, 16> = SmallVector<Constant *, 16> {};
    let mut CleanupFlag: bool = LI.isCleanup();
    let mut AlreadyCaught: SmallPtrSet<Value *, 16> = SmallPtrSet<Value *, 16> {};
    for let mut i: u32 = 0;
let mut e: u32 = LI.getNumClauses(); i != e; i += 1 {
        let mut isLastClause: bool = i + 1 == e;
        if LI.isCatch(i) {
            let mut CatchClause: *mut Constant = LI.getClause(i);
            let mut TypeInfo: *mut Constant = CatchClause.stripPointerCasts();
            if AlreadyCaught.insert(TypeInfo).second {
                NewClauses.push(CatchClause);
            } else {
                MakeNewInstruction = true;
            }
            if isCatchAll(Personality, TypeInfo) {
                if !isLastClause {
                    MakeNewInstruction = true;
                }
                CleanupFlag = false;
                break;
            }
        } else {
            assert!(LI.isFilter(i), "Unsupported landingpad clause!");
            let mut FilterClause: *mut Constant = LI.getClause(i);
            let mut FilterType: *mut ArrayType = cast(FilterClause.getType());
            let mut NumTypeInfos: u32 = FilterType.getNumElements();
            if !NumTypeInfos {
                NewClauses.push(FilterClause);
                if !isLastClause {
                    MakeNewInstruction = true;
                }
                CleanupFlag = false;
                break;
            }
            let mut MakeNewFilter: bool = false;
            let mut NewFilterElts: SmallVector<Constant *, 16> = SmallVector<Constant *, 16> {};
            if isa(FilterClause) {
                assert!(NumTypeInfos > 0, "Should have handled empty filter already!");
                let mut TypeInfo: *mut Constant = getNullValue(FilterType.getElementType());
                if isCatchAll(Personality, TypeInfo) {
                    MakeNewInstruction = true;
                    continue;
                }
                NewFilterElts.push(TypeInfo);
                if NumTypeInfos > 1 {
                    MakeNewFilter = true;
                }
            } else {
                let mut Filter: *mut ConstantArray = cast(FilterClause);
                let mut SeenInFilter: SmallPtrSet<Value *, 16> = SmallPtrSet<Value *, 16> {};
                NewFilterElts.reserve(NumTypeInfos);
                let mut SawCatchAll: bool = false;
                for let mut j: u32 = 0; j != NumTypeInfos; j += 1 {
                    let mut Elt: *mut Constant = Filter.getOperand(j);
                    let mut TypeInfo: *mut Constant = Elt.stripPointerCasts();
                    if isCatchAll(Personality, TypeInfo) {
                        SawCatchAll = true;
                        break;
                    }
                    if SeenInFilter.insert(TypeInfo).second {
                        NewFilterElts.push(cast(Elt));
                    }
                }
                if SawCatchAll {
                    MakeNewInstruction = true;
                    continue;
                }
                if NewFilterElts.len < NumTypeInfos {
                    MakeNewFilter = true;
                }
            }
            if MakeNewFilter {
                FilterType = get(FilterType.getElementType(), NewFilterElts.len);
                FilterClause = get(FilterType, NewFilterElts);
                MakeNewInstruction = true;
            }
            NewClauses.push(FilterClause);
            if MakeNewFilter && !NewFilterElts.len {
                assert!(MakeNewInstruction, "New filter but not a new instruction!");
                CleanupFlag = false;
                break;
            }
        }
    }
    for let mut i: u32 = 0;
let mut e: u32 = NewClauses.len; i + 1 < e;  {
        let mut j: u32 = 0;
        for j = i; j != e; j += 1 {
            if !isa(NewClauses[j].getType()) {
                break;
            }
        }
        for let mut k: u32 = i; k + 1 < j; k += 1 {
            if shorter_filter(NewClauses[k + 1], NewClauses[k]) {
                stable_sort(NewClauses.begin() + i, NewClauses.begin() + j, shorter_filter);
                MakeNewInstruction = true;
                break;
            }
        }
        i = j + 1;
    }
    for let mut i: u32 = 0; i + 1 < NewClauses.len; i += 1 {
        let mut Filter: *mut Value = NewClauses[i];
        let mut FTy: *mut ArrayType = dyn_cast(Filter.getType());
        if !FTy {
            continue;
        }
        let mut FElts: u32 = FTy.getNumElements();
        for let mut j: u32 = NewClauses.len - 1; j != i; j -= 1 {
            let mut LFilter: *mut Value = NewClauses[j];
            let mut LTy: *mut ArrayType = dyn_cast(LFilter.getType());
            if !LTy {
                continue;
            }
            let mut J: iterator = NewClauses.begin() + j;
            if !FElts {
                NewClauses.erase(J);
                MakeNewInstruction = true;
                continue;
            }
            let mut LElts: u32 = LTy.getNumElements();
            if FElts > LElts {
                continue;
            }
            if isa(LFilter) {
                if isa(Filter) {
                    assert!(FElts <= LElts, "Should have handled this case earlier!");
                    NewClauses.erase(J);
                    MakeNewInstruction = true;
                }
                continue;
            }
            let mut LArray: *mut ConstantArray = cast(LFilter);
            if isa(Filter) {
                assert!(FElts > 0, "Should have eliminated the empty filter earlier!");
                for let mut l: u32 = 0; l != LElts; l += 1 {
                    if isa(LArray.getOperand(l)) {
                        NewClauses.erase(J);
                        MakeNewInstruction = true;
                        break;
                    }
                }
                continue;
            }
            let mut FArray: *mut ConstantArray = cast(Filter);
            let mut AllFound: bool = true;
            for let mut f: u32 = 0; f != FElts; f += 1 {
                let mut FTypeInfo: *mut Value = FArray.getOperand(f).stripPointerCasts();
                AllFound = false;
                for let mut l: u32 = 0; l != LElts; l += 1 {
                    let mut LTypeInfo: *mut Value = LArray.getOperand(l).stripPointerCasts();
                    if LTypeInfo == FTypeInfo {
                        AllFound = true;
                        break;
                    }
                }
                if !AllFound {
                    break;
                }
            }
            if AllFound {
                NewClauses.erase(J);
                MakeNewInstruction = true;
            }
        }
    }
    if MakeNewInstruction {
        let mut NLI: *mut LandingPadInst = Create(LI.getType(), NewClauses.len, "", null);
        for C in NewClauses {
            NLI.addClause(C);
        }
        if NewClauses.is_empty() {
            CleanupFlag = true;
        }
        NLI.setCleanup(CleanupFlag);
        return NLI;
    }
    if LI.isCleanup() != CleanupFlag {
        assert!(!CleanupFlag, "Adding a cleanup, not removing one?!");
        LI.setCleanup(CleanupFlag);
        return &mut LI;
    }
    return null;
}

fn InstCombinerImpl::pushFreezeToPreventPoisonFromPropagating(self, OrigFI: *mut FreezeInst) -> *mut Value {
    let mut OrigOp: *mut Value = OrigFI.getOperand(0);
    let mut OrigOpInst: *mut Instruction = dyn_cast(OrigOp);
    if !OrigOpInst || !OrigOpInst.hasOneUse() || isa(OrigOp) {
        return null;
    }
    if canCreateUndefOrPoison(cast(OrigOp), false) {
        return null;
    }
    let mut MaybePoisonOperand: *mut Value = null;
    for V in OrigOpInst.operands() {
        if isa(V) || isGuaranteedNotToBeUndefOrPoison(V, null, null, null, 0) || (MaybePoisonOperand && MaybePoisonOperand == V) {
            continue;
        }
        if !MaybePoisonOperand {
            MaybePoisonOperand = V;
        } else {
            return null;
        }
    }
    OrigOpInst.dropPoisonGeneratingAnnotations();
    if !MaybePoisonOperand {
        return OrigOp;
    }
    self.Builder.SetInsertPoint(OrigOpInst);
    let mut FrozenMaybePoisonOperand: *mut Value = self.Builder.CreateFreeze(MaybePoisonOperand, MaybePoisonOperand.getName() + ".fr");
    OrigOpInst.replaceUsesOfWith(MaybePoisonOperand, FrozenMaybePoisonOperand);
    return OrigOp;
}

fn InstCombinerImpl::foldFreezeIntoRecurrence(self, FI: *mut FreezeInst, PN: *mut PHINode) -> *mut Instruction {
    let mut StartU: *mut Use = null;
    let mut Worklist: SmallVector<Value *> = SmallVector<Value *> {};
    for U in PN.incoming_values() {
        if self.DT.dominates(PN.getParent(), PN.getIncomingBlock(U)) {
            Worklist.push(U.get());
            continue;
        }
        if StartU {
            return null;
        }
        StartU = &mut U;
    }
    if !StartU || Worklist.is_empty() {
        return null;
    }
    let mut StartV: *mut Value = StartU.get();
    let mut StartBB: *mut BasicBlock = PN.getIncomingBlock(*StartU);
    let mut StartNeedsFreeze: bool = !isGuaranteedNotToBeUndefOrPoison(StartV, null, null, null, 0);
    if StartNeedsFreeze && StartBB.getTerminator() == StartV {
        return null;
    }
    let mut Visited: SmallPtrSet<Value *, 32> = SmallPtrSet<Value *, 32> {};
    let mut DropFlags: SmallVector<Instruction *> = SmallVector<Instruction *> {};
    while !Worklist.is_empty() {
        let mut V: *mut Value = Worklist.pop_back_val();
        if !Visited.insert(V).second {
            continue;
        }
        if Visited.len > 32 {
            return null;
        }
        if V == PN || isGuaranteedNotToBeUndefOrPoison(V, null, null, null, 0) {
            continue;
        }
        let mut I: *mut Instruction = dyn_cast(V);
        if !I || canCreateUndefOrPoison(cast(I), false) {
            return null;
        }
        DropFlags.push(I);
        append_range(Worklist, I.operands());
    }
    for I in DropFlags {
        I.dropPoisonGeneratingAnnotations();
    }
    if StartNeedsFreeze {
        self.Builder.SetInsertPoint(StartBB.getTerminator());
        let mut FrozenStartV: *mut Value = self.Builder.CreateFreeze(StartV, StartV.getName() + ".fr");
        self.replaceUse(*StartU, FrozenStartV);
    }
    return self.replaceInstUsesWith(FI, PN);
}

fn InstCombinerImpl::freezeOtherUses(self, FI: *mut FreezeInst) -> bool {
    let mut Op: *mut Value = FI.getOperand(0);
    if isa(Op) || Op.hasOneUse() {
        return false;
    }
    let mut MoveBefore: iterator = iterator {};
    if isa(Op) {
        MoveBefore = FI.getFunction().getEntryBlock().getFirstNonPHIOrDbgOrAlloca();
    } else {
        let mut MoveBeforeOpt: iterator> = cast(Op).getInsertionPointAfterDef();
        if !MoveBeforeOpt {
            return false;
        }
        MoveBefore = operator(MoveBeforeOpt);
    }
    MoveBefore.setHeadBit(false);
    let mut Changed: bool = false;
    if &mut FI != &mut operator(MoveBefore) {
        FI.moveBefore(*operator(MoveBefore).getParent(), MoveBefore);
        Changed = true;
    }
    let mut Users: SmallVector<User *> = SmallVector<User *> {};
    Changed |= Op.replaceUsesWithIf(&mut FI, function_ref<bool (Use &)> { Closure_40 { cap_0: self, FI: &mut FI, Users: &mut Users }, null, null });
    for U in Users {
        let mut UI: *mut Instruction = cast(U);
        self.Worklist.pushUsersToWorkList(*UI);
        self.Worklist.push(UI);
    }
    return Changed;
}

fn isUsedWithinShuffleVector(V: *mut Value) -> bool {
    for U in V.users() {
        if isa(U) {
            return true;
        } else if match(U, m_BitCast(m_Specific(V))) && isUsedWithinShuffleVector(U) {
            return true;
        }
    }
    return false;
}

fn InstCombinerImpl::visitFreeze(self, I: *mut FreezeInst) -> *mut Instruction {
    let mut Op0: *mut Value = I.getOperand(0);
    if simplifyFreezeInst(Op0, self.SQ.getWithInstruction(&mut I)) {
        V;
    } else {
        return self.replaceInstUsesWith(I, V);
    }
    if dyn_cast(Op0) {
        PN;
    } else {
        if self.foldOpIntoPhi(I, PN, false) {
            NV;
        } else {
            return NV;
        }
        if self.foldFreezeIntoRecurrence(I, PN) {
            NV;
        } else {
            return NV;
        }
    }
    if self.pushFreezeToPreventPoisonFromPropagating(I) {
        NI;
    } else {
        return self.replaceInstUsesWith(I, NI);
    }
    let mut getUndefReplacement: Closure_41 = Closure_41 { I: &mut I, cap_1: self };
    if match(Op0, m_Undef()) {
        if isUsedWithinShuffleVector(&mut I) {
            return null;
        }
        return self.replaceInstUsesWith(I, getUndefReplacement.call(I.getType()));
    }
    let mut getFreezeVectorReplacement: Closure_43 = Closure_43 {};
    let mut C: *mut Constant = null;
    if match(Op0, m_Constant(C)) && C.containsUndefOrPoisonElement() && !C.containsConstantExpression() {
        if getFreezeVectorReplacement.call(C) {
            Repl;
        } else {
            return self.replaceInstUsesWith(I, Repl);
        }
    }
    if self.freezeOtherUses(I) {
        return &mut I;
    }
    return null;
}

fn SoleWriteToDeadLocal(I: *mut Instruction, TLI: *mut TargetLibraryInfo) -> bool {
    let mut CB: *mut CallBase = dyn_cast(I);
    if !CB {
        return false;
    }
    let mut Dest: optional<MemoryLocation> = getForDest(CB, TLI);
    if !Dest {
        return false;
    }
    let mut AI: *AllocaInst = dyn_cast(getUnderlyingObject(operator(Dest).Ptr, MaxLookupSearchDepth, false));
    if !AI {
        return false;
    }
    let mut AllocaUsers: SmallVector<const User *> = SmallVector<const User *> {};
    let mut Visited: SmallPtrSet<const User *, 4> = SmallPtrSet<const User *, 4> {};
    let mut pushUsers: Closure_44 = Closure_44 { Visited: &mut Visited, AllocaUsers: &mut AllocaUsers };
    pushUsers.call(*AI);
    while !AllocaUsers.is_empty() {
        let mut UserI: *Instruction = cast(AllocaUsers.pop_back_val());
        if isa(UserI) || isa(UserI) {
            pushUsers.call(*UserI);
            continue;
        }
        if UserI == CB {
            continue;
        }
        return false;
    }
    return true;
}

fn InstCombinerImpl::tryToSinkInstruction(self, I: *mut Instruction, DestBlock: *mut BasicBlock) -> bool {
    let mut SrcBlock: *mut BasicBlock = I.getParent();
    if isa(I) || I.isEHPad() || I.mayThrow(false) || !I.willReturn() || I.isTerminator() {
        return false;
    }
    if isa(I) {
        return false;
    }
    if isa(DestBlock.getTerminator()) {
        return false;
    }
    if dyn_cast(I) {
        CI;
    } else {
        if CI.isConvergent() {
            return false;
        }
    }
    if I.mayWriteToMemory() {
        if !SoleWriteToDeadLocal(I, self.TLI) {
            return false;
        }
    }
    if I.mayReadFromMemory() && !I.hasMetadata(MD_invariant_load) {
        if DestBlock.getUniquePredecessor() != I.getParent() {
            return false;
        }
        for let mut Scan: iterator = next(I.getIterator(), 1);
let mut E: iterator = I.getParent().end(); Scan != E; operator(Scan) {
            if operator(Scan).mayWriteToMemory() && !isa(Scan) {
                return false;
            }
        }
    }
    I.dropDroppableUses(function_ref<bool (const Use *)> { Closure_45 { DestBlock: &mut DestBlock, cap_1: self }, null, null });
    let mut InsertPos: iterator = DestBlock.getFirstInsertionPt();
    I.moveBefore(*DestBlock, InsertPos);
    operator(NumSunkInst);
    let mut DbgVariableRecords: SmallVector<DbgVariableRecord *, 2> = SmallVector<DbgVariableRecord *, 2> {};
    findDbgUsers(I, DbgVariableRecords);
    if !DbgVariableRecords.is_empty() {
        self.tryToSinkInstructionDbgVariableRecords(I, InsertPos, SrcBlock, DestBlock, DbgVariableRecords);
    }
    return true;
}

fn InstCombinerImpl::tryToSinkInstructionDbgVariableRecords(self, I: *mut Instruction, InsertPos: iterator, SrcBlock: *mut BasicBlock, DestBlock: *mut BasicBlock, DbgVariableRecords: *mut SmallVectorImpl<DbgVariableRecord *>) {
    let mut DbgVariableRecordsToSalvage: SmallVector<DbgVariableRecord *, 2> = SmallVector<DbgVariableRecord *, 2> {};
    for DVR in DbgVariableRecords {
        if DVR.getParent() != DestBlock {
            DbgVariableRecordsToSalvage.push(DVR);
        }
    }
    let mut DbgVariableRecordsToSink: SmallVector<DbgVariableRecord *> = SmallVector<DbgVariableRecord *> {};
    for DVR in DbgVariableRecordsToSalvage {
        if DVR.getParent() == SrcBlock {
            DbgVariableRecordsToSink.push(DVR);
        }
    }
    let mut Order: Closure_46 = Closure_46 {};
    stable_sort(DbgVariableRecordsToSink, Order);
    let mut FilterOutMap: SmallDenseMap<InstVarPair, DbgVariableRecord *> = SmallDenseMap<InstVarPair, DbgVariableRecord *> {};
    if DbgVariableRecordsToSink.len > 1 {
        let mut CountMap: SmallDenseMap<InstVarPair, unsigned int> = SmallDenseMap<InstVarPair, unsigned int> {};
        for DVR in DbgVariableRecordsToSink {
            let mut DbgUserVariable: DebugVariable = DebugVariable { Variable: DVR.getVariable(), Fragment: DVR.getExpression(), InlinedAt: operator(DVR.getDebugLoc()).getInlinedAt() };
            CountMap[make_pair(DVR.getInstruction(), DbgUserVariable)] += 1;
        }
        let mut DupSet: SmallPtrSet<const Instruction *, 4> = SmallPtrSet<const Instruction *, 4> {};
        for It in CountMap {
            if It.second > 1 {
                FilterOutMap[It.first] = null;
                DupSet.insert(It.first.first);
            }
        }
        for Inst in DupSet {
            for DVR in reverse(filterDbgVars(Inst.getDbgRecordRange())) {
                let mut DbgUserVariable: DebugVariable = DebugVariable { Variable: DVR.getVariable(), Fragment: DVR.getExpression(), InlinedAt: operator(DVR.getDebugLoc()).getInlinedAt() };
                let mut FilterIt: iterator = FilterOutMap.find(make_pair(Inst, DbgUserVariable));
                if FilterIt == FilterOutMap.end() {
                    continue;
                }
                if operator(FilterIt).second != null {
                    continue;
                }
                operator(FilterIt).second = &mut DVR;
            }
        }
    }
    let mut DVRClones: SmallVector<DbgVariableRecord *, 2> = SmallVector<DbgVariableRecord *, 2> {};
    let mut SunkVariables: SmallSet<DebugVariable, 4> = SmallSet<DebugVariable, 4> {};
    for DVR in DbgVariableRecordsToSink {
        if DVR.Type == Declare {
            continue;
        }
        let mut DbgUserVariable: DebugVariable = DebugVariable { Variable: DVR.getVariable(), Fragment: DVR.getExpression(), InlinedAt: operator(DVR.getDebugLoc()).getInlinedAt() };
        if !FilterOutMap.is_empty() {
            let mut IVP: InstVarPair = make_pair(DVR.getInstruction(), DbgUserVariable);
            let mut It: iterator = FilterOutMap.find(IVP);
            if It != FilterOutMap.end() && operator(It).second != DVR {
                continue;
            }
        }
        if !SunkVariables.insert(DbgUserVariable).second {
            continue;
        }
        if DVR.isDbgAssign() {
            continue;
        }
        DVRClones.push(DVR.clone());
        while true {
            {
            if DebugFlag && isCurrentDebugType("instcombine", 1) {
                dbgs() << "CLONE: " << *DVRClones.back() << 10;
            }
        }
            if !(false) { break; }
        }
    }
    if DVRClones.is_empty() {
        return;
    }
    salvageDebugInfoForDbgValues(*I, DbgVariableRecordsToSalvage);
    assert!(InsertPos.getHeadBit();
    for DVRClone in DVRClones {
        operator(InsertPos).getParent().insertDbgRecordBefore(DVRClone, InsertPos);
        while true {
            {
            if DebugFlag && isCurrentDebugType("instcombine", 1) {
                dbgs() << "SINK: " << *DVRClone << 10;
            }
        }
            if !(false) { break; }
        }
    }
}

fn InstCombinerImpl::run(self) -> bool {
    while !self.Worklist.isEmpty() {
        while self.Worklist.popDeferred() {
            I;
        }
        let mut I: *mut Instruction = self.Worklist.removeOne();
        if I == null {
            continue;
        }
        if isInstructionTriviallyDead(I, &mut self.TLI) {
            self.eraseInstFromFunction(*I);
            operator(NumDeadInst);
            continue;
        }
        if !shouldExecute(VisitCounter) {
            continue;
        }
        let mut getOptionalSinkBlockForInst: Closure_47 = Closure_47 { cap_0: self };
        let mut OptBB: optional<BasicBlock *> = getOptionalSinkBlockForInst.call(I);
        if OptBB {
            let mut UserParent: *mut BasicBlock = operator(OptBB);
            if self.tryToSinkInstruction(I, UserParent) {
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("instcombine", 1) {
                        dbgs() << "IC: Sink: " << *I << 10;
                    }
                }
                    if !(false) { break; }
                }
                self.MadeIRChange = true;
                for U in I.operands() {
                    if dyn_cast(U.get()) {
                        OpI;
                    } else {
                        self.Worklist.push(OpI);
                    }
                }
            }
        }
        self.Builder.SetInsertPoint(I);
        self.Builder.SetCurrentDebugLocation(I.getDebugLoc());
        self.AnnotationMetadataSource = I;
        let mut OrigI: str = "";
        while true {
            {
            if DebugFlag && isCurrentDebugType("instcombine", 1) {
                let mut SS: raw_string_ostream = OrigI;
                I.print(SS, false);
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("instcombine", 1) {
                dbgs() << "IC: Visiting: " << OrigI << 10;
            }
        }
            if !(false) { break; }
        }
        if self.visit(*I) {
            Result;
        } else {
            operator(NumCombined);
            if Result != I {
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("instcombine", 1) {
                        dbgs() << "IC: Old = " << *I << 10 << "    New = " << *Result << 10;
                    }
                }
                    if !(false) { break; }
                }
                Result.setDebugLoc(Result.getDebugLoc().orElse(I.getDebugLoc()));
                Result.copyMetadata(*I, MD_annotation);
                I.replaceAllUsesWith(Result);
                Result.takeName(I);
                let mut InstParent: *mut BasicBlock = I.getParent();
                let mut InsertPos: iterator = I.getIterator();
                if isa(Result) != isa(I) {
                    if isa(I) {
                        InsertPos = InstParent.getFirstInsertionPt();
                    } else {
                        InsertPos = InstParent.getFirstNonPHIIt();
                    }
                }
                Result.insertInto(InstParent, InsertPos);
                if dyn_cast(Result) {
                    Assume;
                } else {
                    self.AC.registerAssumption(Assume);
                }
                self.Worklist.pushUsersToWorkList(*Result);
                self.Worklist.push(Result);
                self.eraseInstFromFunction(*I);
            } else {
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("instcombine", 1) {
                        dbgs() << "IC: Mod = " << OrigI << 10 << "    New = " << *I << 10;
                    }
                }
                    if !(false) { break; }
                }
                if isInstructionTriviallyDead(I, &mut self.TLI) {
                    self.eraseInstFromFunction(*I);
                } else {
                    self.Worklist.pushUsersToWorkList(*I);
                    self.Worklist.push(I);
                }
            }
            self.MadeIRChange = true;
        }
    }
    self.Worklist.zap();
    return self.MadeIRChange;
}

struct AliasScopeTracker {
    UsedAliasScopesAndLists: SmallPtrSet<const MDNode *, 8>,
    UsedNoAliasScopesAndLists: SmallPtrSet<const MDNode *, 8>,
    CommonScopesOfDisjointDomain: SmallDenseMap<const MDNode *, SmallPtrSet<const MDNode *, 4>, 4>,
}

fn AliasScopeTracker::recordDisjointDomainScopes(self, ScopeList: *MDNode) {
    let mut UsedScopes: SmallDenseMap<const MDNode *, SmallPtrSet<const MDNode *, 4>, 4> = SmallDenseMap<const MDNode *, SmallPtrSet<const MDNode *, 4>, 4> {};
    for MDOperand in ScopeList.operands() {
        let mut MDScope: *MDNode const = cast(MDOperand);
        let mut Domain: *MDNode = MDScope.getDomain();
        if Domain.hasDisjointScopes() {
            UsedScopes[Domain].insert(MDScope);
        }
    }
    for x in UsedScopes {
        if !Inserted {
            set_intersect(operator(It).second, Scopes);
        }
    }
}

fn AliasScopeTracker::isImplicitlyNoAlias(self: *AliasScopeTracker, Scope: *MDNode) -> bool {
    let mut It: const_iterator = self.CommonScopesOfDisjointDomain.find(Scope.getDomain());
    return It != self.CommonScopesOfDisjointDomain.end() && !operator(It).second.contains(Scope);
}

fn AliasScopeTracker::analyse(self, I: *mut Instruction) {
    if !I.hasMetadataOtherThanDebugLoc() {
        return;
    }
    let mut Track: Closure_48 = Closure_48 {};
    if Track.call(I.getMetadata(MD_alias_scope), self.UsedAliasScopesAndLists) {
        AliasScopeList;
    } else {
        self.recordDisjointDomainScopes(AliasScopeList);
    }
    Track.call(I.getMetadata(MD_noalias), self.UsedNoAliasScopesAndLists);
}

fn AliasScopeTracker::isNoAliasScopeDeclDead(self, Inst: *mut Instruction) -> bool {
    let mut Decl: *mut NoAliasScopeDeclInst = dyn_cast(Inst);
    if !Decl {
        return false;
    }
    assert!(Decl.use_empty(), "llvm.experimental.noalias.scope.decl in use ?");
    let mut MDSL: *MDNode = Decl.getScopeList();
    assert!(MDSL.getNumOperands() == 1, "llvm.experimental.noalias.scope should refer to a single scope");
    let mut MDOperand: *MDOperand = MDSL.getOperand(0);
    if dyn_cast(MDOperand) {
        MD;
    } else {
        return !self.UsedAliasScopesAndLists.contains(MD) || (!self.UsedNoAliasScopesAndLists.contains(MD) && !self.isImplicitlyNoAlias(MD));
    }
    return true;
}

fn InstCombinerImpl::prepareWorklist(self, F: *mut Function) -> bool {
    let mut MadeIRChange: bool = false;
    let mut LiveBlocks: SmallPtrSet<BasicBlock *, 32> = SmallPtrSet<BasicBlock *, 32> {};
    let mut InstrsForInstructionWorklist: SmallVector<Instruction *, 128> = SmallVector<Instruction *, 128> {};
    let mut FoldedConstants: DenseMap<Constant *, Constant *> = DenseMap<Constant *, Constant *> {};
    let mut SeenAliasScopes: AliasScopeTracker = AliasScopeTracker {};
    let mut HandleOnlyLiveSuccessor: Closure_49 = Closure_49 { cap_0: self, MadeIRChange: &mut MadeIRChange };
    for BB in self.RPOT {
        if !BB.isEntryBlock() && all_of(predecessors(BB), Closure_50 { cap_0: self, BB: &mut BB }) {
            HandleOnlyLiveSuccessor.call(BB, null);
            continue;
        }
        LiveBlocks.insert(BB);
        for Inst in make_early_inc_range(*BB) {
            if !Inst.use_empty() && (Inst.getNumOperands() == 0 || isa(Inst.getOperand(0))) {
                if ConstantFoldInstruction(&mut Inst, self.DL, &mut self.TLI) {
                    C;
                } else {
                    while true {
                        {
                        if DebugFlag && isCurrentDebugType("instcombine", 1) {
                            dbgs() << "IC: ConstFold to: " << *C << " from: " << Inst << 10;
                        }
                    }
                        if !(false) { break; }
                    }
                    Inst.replaceAllUsesWith(C);
                    operator(NumConstProp);
                    if isInstructionTriviallyDead(&mut Inst, &mut self.TLI) {
                        Inst.eraseFromParent();
                    }
                    MadeIRChange = true;
                    continue;
                }
            }
            for U in Inst.operands() {
                if !isa(U) && !isa(U) {
                    continue;
                }
                let mut C: *mut Constant = cast(U);
                let mut FoldRes: *mut *mut Constant = FoldedConstants[C];
                if !FoldRes {
                    FoldRes = ConstantFoldConstant(C, self.DL, &mut self.TLI);
                }
                if FoldRes != C {
                    while true {
                        {
                        if DebugFlag && isCurrentDebugType("instcombine", 1) {
                            dbgs() << "IC: ConstFold operand of: " << Inst << "\n    Old = " << *C << "\n    New = " << *FoldRes << 10;
                        }
                    }
                        if !(false) { break; }
                    }
                    U = FoldRes;
                    MadeIRChange = true;
                }
            }
            if !Inst.isDebugOrPseudoInst() {
                InstrsForInstructionWorklist.push(&mut Inst);
                SeenAliasScopes.analyse(&mut Inst);
            }
        }
        let mut TI: *mut Instruction = BB.getTerminator();
        if dyn_cast(TI) {
            BI;
        } else {
            if isa(BI.getCondition()) {
                HandleOnlyLiveSuccessor.call(BB, null);
                continue;
            }
            if dyn_cast(BI.getCondition()) {
                Cond;
            } else {
                let mut CondVal: bool = Cond.getZExtValue();
                HandleOnlyLiveSuccessor.call(BB, BI.getSuccessor(!CondVal));
                continue;
            }
        }
    }
    for BB in F {
        if LiveBlocks.count(&mut BB) {
            continue;
        }
        let mut NumDeadInstInBB: u32 = 0;
        NumDeadInstInBB = removeAllNonTerminatorAndEHPadInstructions(&mut BB);
        MadeIRChange |= NumDeadInstInBB != 0;
        operator(NumDeadInst, NumDeadInstInBB);
    }
    self.Worklist.reserve(InstrsForInstructionWorklist.len);
    for Inst in reverse(InstrsForInstructionWorklist) {
        if isInstructionTriviallyDead(Inst, &mut self.TLI) || SeenAliasScopes.isNoAliasScopeDeclDead(Inst) {
            operator(NumDeadInst);
            while true {
                {
                if DebugFlag && isCurrentDebugType("instcombine", 1) {
                    dbgs() << "IC: DCE: " << *Inst << 10;
                }
            }
                if !(false) { break; }
            }
            salvageDebugInfo(*Inst);
            Inst.eraseFromParent();
            MadeIRChange = true;
            continue;
        }
        self.Worklist.push(Inst);
    }
    return MadeIRChange;
}

fn InstCombiner::computeBackEdges(self) {
    let mut Visited: SmallVector<bool> = self.F.getMaxBlockNumber();
    for BB in self.RPOT {
        Visited[BB.getNumber()] = true;
        for Succ in successors(BB) {
            if Visited[Succ.getNumber()] {
                self.BackEdges.insert(BasicBlock *> { BB, Succ });
            }
        }
    }
    self.ComputedBackEdges = true;
}

fn combineInstructionsOverFunction(F: *mut Function, Worklist: *mut InstructionWorklist, AA: *mut AliasAnalysis, AC: *mut AssumptionCache, TLI: *mut TargetLibraryInfo, TTI: *mut TargetTransformInfo, DT: *mut DominatorTree, ORE: *mut OptimizationRemarkEmitter, BFI: *mut BlockFrequencyInfo, BPI: *mut BranchProbabilityInfo, PSI: *mut ProfileSummaryInfo, Opts: *InstCombineOptions) -> bool {
    let mut DL: *DataLayout = F.getDataLayout();
    let mut VerifyFixpoint: bool = Opts.VerifyFixpoint && !F.hasFnAttribute("instcombine-no-verify-fixpoint");
    let mut RPOT: ReversePostOrderTraversal<BasicBlock *> = &mut F.front();
    let mut CLOpts: *InstCombineCLOptions = Global;
    let mut MadeIRChange: bool = false;
    if CLOpts.lower_dbg_declare {
        MadeIRChange = LowerDbgDeclare(F);
    }
    let mut Iteration: u32 = 0;
    while true {
        if Iteration >= Opts.MaxIterations && !VerifyFixpoint {
            while true {
                {
                if DebugFlag && isCurrentDebugType("instcombine", 1) {
                    dbgs() << "\n\n[IC] Iteration limit #" << Opts.MaxIterations << " on " << F.getName() << " reached; stopping without verifying fixpoint\n";
                }
            }
                if !(false) { break; }
            }
            break;
        }
        Iteration += 1;
        operator(NumWorklistIterations);
        while true {
            {
            if DebugFlag && isCurrentDebugType("instcombine", 1) {
                dbgs() << "\n\nINSTCOMBINE ITERATION #" << Iteration << " on " << F.getName() << "\n";
            }
        }
            if !(false) { break; }
        }
        let mut IC: InstCombinerImpl = InstCombinerImpl { Worklist, F, AA, AC, TLI, TTI, DT, ORE, BFI, BPI, PSI, DL, RPOT, CLOpts };
        let mut MadeChangeInThisIteration: bool = IC.prepareWorklist(F);
        MadeChangeInThisIteration |= IC.run();
        if !MadeChangeInThisIteration {
            break;
        }
        MadeIRChange = true;
        if Iteration > Opts.MaxIterations {
            reportFatalUsageError("Instruction Combining on " + F.getName() + " did not reach a fixpoint after " + Opts.MaxIterations + " iterations. " + "Use 'instcombine<no-verify-fixpoint>' or function attribute 'instcombine-no-verify-fixpoint' to suppress this error.");
        }
    }
    if Iteration == 1 {
        operator(NumOneIteration);
    } else if Iteration == 2 {
        operator(NumTwoIterations);
    } else if Iteration == 3 {
        operator(NumThreeIterations);
    } else {
        operator(NumFourOrMoreIterations);
    }
    return MadeIRChange;
}

fn InstCombinePass::printPipeline(self, OS: *mut raw_ostream, MapClassName2PassName: function_ref<StringRef (StringRef)>) {
    self as *mut PassInfoMixin<InstCombinePass>.printPipeline(OS, MapClassName2PassName);
    OS << '<';
    OS << "max-iterations=" << self.Options.MaxIterations << ";";
    OS << (if self.Options.VerifyFixpoint { "" } else { "no-" }) << "verify-fixpoint";
    OS << '>';
}

static mut ID: i8 = 0;

fn InstCombinePass::run(self, F: *mut Function, AM: *mut FunctionAnalysisManager) -> PreservedAnalyses {
    let mut LRT: *mut Result = AM.getResult(F);
    if LRT.shouldSkip(&mut ID) {
        return all();
    }
    let mut AC: *mut Result = AM.getResult(F);
    let mut DT: *mut Result = AM.getResult(F);
    let mut TLI: *mut Result = AM.getResult(F);
    let mut ORE: *mut Result = AM.getResult(F);
    let mut TTI: *mut Result = AM.getResult(F);
    let mut AA: *mut Result = &mut AM.getResult(F);
    let mut MAMProxy: *mut Result = AM.getResult(F);
    let mut PSI: *mut ProfileSummaryInfo = MAMProxy.getCachedResult(*F.getParent());
    let mut BFI: *mut Result = if (PSI && PSI.hasProfileSummary()) { &mut AM.getResult(F) } else { null };
    let mut BPI: *mut Result = AM.getCachedResult(F);
    if !combineInstructionsOverFunction(F, self.Worklist, AA, AC, TLI, TTI, DT, ORE, BFI, BPI, PSI, self.Options) {
        LRT.update(&mut ID, false);
        return all();
    }
    let mut PA: PreservedAnalyses = PreservedAnalyses {};
    LRT.update(&mut ID, true);
    PA.preserve();
    PA.preserveSet();
    return PA;
}

fn InstructionCombiningPass::getAnalysisUsage(self: *InstructionCombiningPass, AU: *mut AnalysisUsage) {
    AU.setPreservesCFG();
    AU.addRequired();
    AU.addRequired();
    AU.addRequired();
    AU.addRequired();
    AU.addRequired();
    AU.addRequired();
    AU.addPreserved();
    AU.addPreserved();
    AU.addRequired();
    getLazyBFIAnalysisUsage(AU);
}

fn InstructionCombiningPass::runOnFunction(self, F: *mut Function) -> bool {
    if self.skipFunction(F) {
        return false;
    }
    let mut AA: *mut AAResults = &mut self.getAnalysis().getAAResults();
    let mut AC: *mut AssumptionCache = self.getAnalysis().getAssumptionCache(F);
    let mut TLI: *mut TargetLibraryInfo = self.getAnalysis().getTLI(F);
    let mut TTI: *mut TargetTransformInfo = self.getAnalysis().getTTI(F);
    let mut DT: *mut DominatorTree = self.getAnalysis().getDomTree();
    let mut ORE: *mut OptimizationRemarkEmitter = self.getAnalysis().getORE();
    let mut PSI: *mut ProfileSummaryInfo = &mut self.getAnalysis().getPSI();
    let mut BFI: *mut BlockFrequencyInfo = if (PSI && PSI.hasProfileSummary()) { &mut self.getAnalysis().getBFI() } else { null };
    let mut BPI: *mut BranchProbabilityInfo = null;
    if self.getAnalysisIfAvailable() {
        WrapperPass;
    } else {
        BPI = &mut WrapperPass.getBPI();
    }
    return combineInstructionsOverFunction(F, self.Worklist, AA, AC, TLI, TTI, DT, ORE, BFI, BPI, PSI, InstCombineOptions {});
}

static mut ID: i8 = 0;

fn initializeInstCombine(Registry: *mut PassRegistry) {
    initializeInstructionCombiningPassPass(Registry);
}

fn createInstructionCombiningPass() -> *mut FunctionPass {
    return InstructionCombiningPass {};
}

