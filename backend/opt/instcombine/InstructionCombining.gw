fn InstCombinerImpl::foldVectorBinop(self, Inst: *mut BinaryOperator) -> *mut Instruction {
    if !isa(Inst.getType()) {
        return null;
    }
    let mut Opcode: BinaryOps = Inst.getOpcode();
    let mut LHS: *mut Value = Inst.getOperand(0);
    let mut RHS: *mut Value = Inst.getOperand(1);
    assert!(cast(LHS.getType()).getElementCount() == cast(Inst.getType()).getElementCount();
    assert!(cast(RHS.getType()).getElementCount() == cast(Inst.getType()).getElementCount();
    let mut foldConstantsThroughSubVectorInsertSplat: Closure_19 = Closure_19 { Opcode: &mut Opcode, cap_1: self, Inst: &mut Inst };
    if foldConstantsThroughSubVectorInsertSplat.call(LHS, RHS, false) {
        Folded;
    } else {
        return Folded;
    }
    if foldConstantsThroughSubVectorInsertSplat.call(RHS, LHS, true) {
        Folded;
    } else {
        return Folded;
    }
    let mut createBinOpReverse: Closure_20 = Closure_20 { cap_0: self, Opcode: &mut Opcode, Inst: &mut Inst };
    let mut V1: *mut Value = null;
    let mut V2: *mut Value = null;
    if match(LHS, m_VecReverse(m_Value(V1))) {
        if match(RHS, m_VecReverse(m_Value(V2))) && (LHS.hasOneUse() || RHS.hasOneUse() || (LHS == RHS && LHS.hasNUses(2))) {
            return createBinOpReverse.call(V1, V2);
        }
        if LHS.hasOneUse() && isSplatValue(RHS, -1, 0) {
            return createBinOpReverse.call(V1, RHS);
        }
    } else if isSplatValue(LHS, -1, 0) && match(RHS, m_OneUse(m_VecReverse(m_Value(V2)))) {
        return createBinOpReverse.call(LHS, V2);
    }
    let mut createBinOpVPReverse: Closure_21 = Closure_21 { cap_0: self, Opcode: &mut Opcode, Inst: &mut Inst };
    let mut EVL: *mut Value = null;
    if match(LHS, m_Intrinsic(m_Value(V1), m_AllOnes(), m_Value(EVL))) {
        if match(RHS, m_Intrinsic(m_Value(V2), m_AllOnes(), m_Specific(EVL))) && (LHS.hasOneUse() || RHS.hasOneUse() || (LHS == RHS && LHS.hasNUses(2))) {
            return createBinOpVPReverse.call(V1, V2, EVL);
        }
        if LHS.hasOneUse() && isSplatValue(RHS, -1, 0) {
            return createBinOpVPReverse.call(V1, RHS, EVL);
        }
    } else if isSplatValue(LHS, -1, 0) && match(RHS, m_Intrinsic(m_Value(V2), m_AllOnes(), m_Value(EVL))) {
        return createBinOpVPReverse.call(LHS, V2, EVL);
    }
    if foldSpliceBinOp(Inst, self.Builder) {
        Folded;
    } else {
        return Folded;
    }
    if foldSpliceBinOp(Inst, self.Builder) {
        Folded;
    } else {
        return Folded;
    }
    if !isSafeToSpeculativelyExecuteWithVariableReplaced(&mut Inst, true) {
        return null;
    }
    let mut createBinOpShuffle: Closure_22 = Closure_22 { cap_0: self, Opcode: &mut Opcode, Inst: &mut Inst };
    let mut Mask: ArrayRef<int> = ArrayRef<int> {};
    if match(LHS, m_Shuffle(m_Value(V1), m_Poison(), Mask)) && match(RHS, m_Shuffle(m_Value(V2), m_Poison(), Mask)) && Inst.getType() == V1.getType() && V1.getType() == V2.getType() && (LHS.hasOneUse() || RHS.hasOneUse() || LHS == RHS) {
        return createBinOpShuffle.call(V1, V2, Mask);
    }
    if Inst.isCommutative() && match(LHS, m_Shuffle(m_Value(V1), m_Value(V2), Mask)) && match(RHS, m_Shuffle(m_Specific(V2), m_Specific(V1), Mask)) {
        let mut LShuf: *mut ShuffleVectorInst = cast(LHS);
        let mut RShuf: *mut ShuffleVectorInst = cast(RHS);
        if LShuf.isSelect() && !is_contained(LShuf.getShuffleMask(), PoisonMaskElem) && RShuf.isSelect() && !is_contained(RShuf.getShuffleMask(), PoisonMaskElem) {
            let mut NewBO: *mut Instruction = Create(Opcode, V1, V2, "", null);
            NewBO.copyIRFlags(&mut Inst, true);
            return NewBO;
        }
    }
    let mut C: *mut Constant = null;
    if match(&mut Inst, m_c_BinOp(m_OneUse(m_Shuffle(m_Value(V1), m_Poison(), Mask)), m_ImmConstant(C))) {
        assert!(Inst.getType().getScalarType() == V1.getType().getScalarType(), "Shuffle should not change scalar type");
        let mut ConstOp1: bool = isa(RHS);
        if self.unshuffleConstant(Mask, C, cast(V1.getType())) {
            NewC;
        } else {
            if isa(V1.getType()) && Inst.isIntDivRem() {
                NewC = getSafeVectorConstantForBinop(Opcode, NewC, ConstOp1);
            }
            let mut NewLHS: *mut Value = if ConstOp1 { V1 } else { NewC };
            let mut NewRHS: *mut Value = if ConstOp1 { NewC } else { V1 };
            return createBinOpShuffle.call(NewLHS, NewRHS, Mask);
        }
    }
    if Inst.isAssociative() && Inst.isCommutative() {
        if isa(RHS) {
            swap(LHS, RHS);
        }
        let mut X: *mut Value = null;
        let mut MaskC: ArrayRef<int> = ArrayRef<int> {};
        let mut SplatIndex: i32 = 0;
        let mut Y: *mut Value = null;
        let mut OtherOp: *mut Value = null;
        if !match(LHS, m_OneUse(m_Shuffle(m_Value(X), m_Undef(), MaskC))) || !match(MaskC, SplatIndex) || X.getType() != Inst.getType() || !match(RHS, m_OneUse(m_BinOp(Opcode, m_Value(Y), m_Value(OtherOp)))) {
            return null;
        }
        if isSplatValue(OtherOp, SplatIndex, 0) {
            swap(Y, OtherOp);
        } else if !isSplatValue(Y, SplatIndex, 0) {
            return null;
        }
        let mut NewBO: *mut Value = self.Builder.CreateBinOp(Opcode, X, Y, "", null);
        let mut NewMask: SmallVector<int, 8> = SmallVector<int, 8> { MaskC.len, SplatIndex };
        let mut NewSplat: *mut Value = self.Builder.CreateShuffleVector(NewBO, NewMask, "");
        let mut R: *mut Instruction = Create(Opcode, NewSplat, OtherOp, "", null);
        if isa(R) {
            R.copyFastMathFlags(&mut Inst);
            R.andIRFlags(RHS);
        }
        if dyn_cast(NewBO) {
            NewInstBO;
        } else {
            NewInstBO.copyIRFlags(R, true);
        }
        return R;
    }
    return null;
}

fn InstCombinerImpl::narrowMathIfNoOverflow(self, BO: *mut BinaryOperator) -> *mut Instruction {
    let mut Op0: *mut Value = BO.getOperand(0);
    let mut Op1: *mut Value = BO.getOperand(1);
    if BO.getOpcode() == Sub {
        swap(Op0, Op1);
    }
    let mut X: *mut Value = null;
    let mut IsSext: bool = match(Op0, m_SExt(m_Value(X)));
    if !IsSext && !match(Op0, m_ZExt(m_Value(X))) {
        return null;
    }
    let mut CastOpc: CastOps = if IsSext { SExt } else { ZExt };
    let mut Y: *mut Value = null;
    if !(match(Op1, m_ZExtOrSExt(m_Value(Y))) && X.getType() == Y.getType() && cast(Op1).getOpcode() == CastOpc && (Op0.hasOneUse() || Op1.hasOneUse())) {
        let mut WideC: *mut Constant = null;
        if !Op0.hasOneUse() || !match(Op1, m_Constant(WideC)) {
            return null;
        }
        let mut NarrowC: *mut Constant = getLosslessInvCast(WideC, X.getType(), CastOpc, self.DL, null);
        if !NarrowC {
            return null;
        }
        Y = NarrowC;
    }
    if BO.getOpcode() == Sub {
        swap(X, Y);
    }
    if !self.willNotOverflow(BO.getOpcode(), X, Y, BO, IsSext) {
        return null;
    }
    let mut NarrowBO: *mut Value = self.Builder.CreateBinOp(BO.getOpcode(), X, Y, "narrow", null);
    if dyn_cast(NarrowBO) {
        NewBinOp;
    } else {
        if IsSext {
            NewBinOp.setHasNoSignedWrap(true);
        } else {
            NewBinOp.setHasNoUnsignedWrap(true);
        }
    }
    return Create(CastOpc, NarrowBO, BO.getType(), "", null);
}

fn getMergedGEPNoWrapFlags(GEP1: *mut GEPOperator, GEP2: *mut GEPOperator) -> GEPNoWrapFlags {
    return GEP1.getNoWrapFlags().intersectForOffsetAdd(GEP2.getNoWrapFlags());
}

fn foldSelectGEP(GEP: *mut GetElementPtrInst, Builder: *mut BuilderTy) -> *mut Instruction {
    if !GEP.hasAllConstantIndices() {
        return null;
    }
    let mut Sel: *mut Instruction = null;
    let mut Cond: *mut Value = null;
    let mut TrueC: *mut Constant = null;
    let mut FalseC: *mut Constant = null;
    if !match(GEP.getPointerOperand(), m_Instruction(Sel)) || !match(Sel, m_Select(m_Value(Cond), m_Constant(TrueC), m_Constant(FalseC))) {
        return null;
    }
    let mut IndexC: SmallVector<Value *, 4> = GEP.indices();
    let mut NW: GEPNoWrapFlags = GEP.getNoWrapFlags();
    let mut Ty: *mut Type = GEP.getSourceElementType();
    let mut NewTrueC: *mut Value = Builder.CreateGEP(Ty, TrueC, IndexC, "", NW);
    let mut NewFalseC: *mut Value = Builder.CreateGEP(Ty, FalseC, IndexC, "", NW);
    return Create(Cond, NewTrueC, NewFalseC, "", null, Sel);
}

fn canonicalizeGEPOfConstGEPI8(GEP: *mut GetElementPtrInst, Src: *mut GEPOperator, IC: *mut InstCombinerImpl) -> *mut Instruction {
    if GEP.getNumIndices() != 1 {
        return null;
    }
    let mut DL: *DataLayout = IC.getDataLayout();
    let mut Base: *mut Value = null;
    let mut C1: *APInt = null;
    if !match(Src, m_PtrAdd(m_Value(Base), m_APInt(C1))) {
        return null;
    }
    let mut VarIndex: *mut Value = null;
    let mut C2: *APInt = null;
    let mut PtrTy: *mut Type = Src.getType().getScalarType();
    let mut IndexSizeInBits: u32 = DL.getIndexTypeSizeInBits(PtrTy);
    if !match(GEP.getOperand(1), m_AddLike(m_Value(VarIndex), m_APInt(C2))) {
        return null;
    }
    if C1.getBitWidth() != IndexSizeInBits || C2.getBitWidth() != IndexSizeInBits {
        return null;
    }
    let mut BaseType: *mut Type = GEP.getSourceElementType();
    if isa(BaseType) {
        return null;
    }
    let mut TypeSize: APInt = APInt { IndexSizeInBits, DL.getTypeAllocSize(BaseType).operator unsigned long long(), false, false };
    let mut NewOffset: APInt = TypeSize * *C2 + *C1;
    if NewOffset.isZero() || (Src.hasOneUse() && GEP.getOperand(1).hasOneUse()) {
        let mut Flags: GEPNoWrapFlags = none();
        if GEP.hasNoUnsignedWrap() && cast(Src).hasNoUnsignedWrap() && match(GEP.getOperand(1), m_NUWAddLike(m_Value(), m_Value())) {
            operator(Flags, noUnsignedWrap());
            if GEP.isInBounds() && cast(Src).isInBounds() {
                operator(Flags, inBounds());
            }
        }
        let mut GEPConst: *mut Value = IC.Builder.CreatePtrAdd(Base, IC.Builder.getInt(NewOffset), "", Flags);
        return Create(BaseType, GEPConst, VarIndex, Flags, "", null);
    }
    return null;
}

fn combineConstantOffsets(GEP: *mut GetElementPtrInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    if !GEP.hasAllConstantIndices() {
        return null;
    }
    let mut NW: GEPNoWrapFlags = all();
    let mut Skipped: SmallVector<GetElementPtrInst *> = SmallVector<GetElementPtrInst *> {};
    let mut InnerGEP: *mut GetElementPtrInst = dyn_cast(GEP.getPointerOperand());
    while true {
        if !InnerGEP {
            return null;
        }
        NW = NW.intersectForReassociate(InnerGEP.getNoWrapFlags());
        if InnerGEP.hasAllConstantIndices() {
            break;
        }
        if !InnerGEP.hasOneUse() {
            return null;
        }
        Skipped.push(InnerGEP);
        InnerGEP = dyn_cast(InnerGEP.getPointerOperand());
    }
    if Skipped.is_empty() {
        return null;
    }
    if !InnerGEP.hasOneUse() {
        return null;
    }
    let mut Ty: *mut Type = GEP.getType();
    if InnerGEP.getType() != Ty {
        return null;
    }
    let mut DL: *DataLayout = IC.getDataLayout();
    let mut Offset: APInt = APInt { DL.getIndexTypeSizeInBits(Ty), 0, false, false };
    if !GEP.accumulateConstantOffset(DL, Offset) || !InnerGEP.accumulateConstantOffset(DL, Offset) {
        return null;
    }
    IC.replaceOperand(*Skipped.back(), 0, InnerGEP.getPointerOperand());
    for SkippedGEP in Skipped {
        SkippedGEP.setNoWrapFlags(NW);
    }
    return IC.replaceInstUsesWith(GEP, IC.Builder.CreatePtrAdd(Skipped.front(), IC.Builder.getInt(Offset), "", NW.intersectForOffsetAdd(GEP.getNoWrapFlags())));
}

fn InstCombinerImpl::visitGEPOfGEP(self, GEP: *mut GetElementPtrInst, Src: *mut GEPOperator) -> *mut Instruction {
    if !shouldMergeGEPs(*cast(&mut GEP), *Src) {
        return null;
    }
    if canonicalizeGEPOfConstGEPI8(GEP, Src, *self) {
        I;
    } else {
        return I;
    }
    if combineConstantOffsets(GEP, *self) {
        I;
    } else {
        return I;
    }
    if Src.getResultElementType() != GEP.getSourceElementType() {
        return null;
    }
    if Src.hasOneUse() && GEP.getNumIndices() == 1 && Src.getNumIndices() == 1 {
        let mut SrcIdx: *mut Value = *Src.idx_begin().operator llvm::Value *();
        let mut GEPIdx: *mut Value = *GEP.idx_begin().operator llvm::Value *();
        let mut ConstOffset: *APInt = null;
        let mut TrueVal: *APInt = null;
        let mut FalseVal: *APInt = null;
        let mut Cond: *mut Value = null;
        if (match(SrcIdx, m_APInt(ConstOffset)) && match(GEPIdx, m_Select(m_Value(Cond), m_APInt(TrueVal), m_APInt(FalseVal)))) || (match(GEPIdx, m_APInt(ConstOffset)) && match(SrcIdx, m_Select(m_Value(Cond), m_APInt(TrueVal), m_APInt(FalseVal)))) {
            let mut Select: *mut SelectInst = if isa(GEPIdx) { cast(GEPIdx) } else { cast(SrcIdx) };
            if !Select.hasOneUse() {
                return null;
            }
            if TrueVal.getBitWidth() != ConstOffset.getBitWidth() || FalseVal.getBitWidth() != ConstOffset.getBitWidth() {
                return null;
            }
            let mut NewTrueVal: APInt = *ConstOffset + *TrueVal;
            let mut NewFalseVal: APInt = *ConstOffset + *FalseVal;
            let mut NewTrue: *mut Constant = get(Select.getType(), NewTrueVal);
            let mut NewFalse: *mut Constant = get(Select.getType(), NewFalseVal);
            let mut NewSelect: *mut Value = self.Builder.CreateSelect(Cond, NewTrue, NewFalse, "", Select);
            let mut Flags: GEPNoWrapFlags = getMergedGEPNoWrapFlags(*Src, *cast(&mut GEP));
            return self.replaceInstUsesWith(GEP, self.Builder.CreateGEP(GEP.getResultElementType(), Src.getPointerOperand(), NewSelect, "", Flags));
        }
    }
    let mut EndsWithSequential: bool = false;
    for let mut I: gep_type_iterator = gep_type_begin(*Src);
let mut E: gep_type_iterator = gep_type_end(*Src); I != E; operator(I) {
        EndsWithSequential = I.isSequential();
    }
    if !EndsWithSequential {
        return null;
    }
    let mut SO1: *mut Value = Src.getOperand(Src.getNumOperands() - 1);
    let mut GO1: *mut Value = GEP.getOperand(1);
    if SO1.getType() != GO1.getType() {
        return null;
    }
    let mut Sum: *mut Value = simplifyAddInst(GO1, SO1, false, false, self.SQ.getWithInstruction(&mut GEP));
    if Sum == null {
        return null;
    }
    let mut Indices: SmallVector<Value *, 8> = SmallVector<Value *, 8> {};
    Indices.append(Src.op_begin() + 1, Src.op_end() - 1);
    Indices.push(Sum);
    Indices.append(GEP.op_begin() + 2, GEP.op_end());
    let mut NumNonZeroIndices: u32 = count_if(Indices, Closure_23 {});
    if NumNonZeroIndices > 1 {
        return null;
    }
    return self.replaceInstUsesWith(GEP, self.Builder.CreateGEP(Src.getSourceElementType(), Src.getOperand(0), Indices, "", getMergedGEPNoWrapFlags(*Src, *cast(&mut GEP))));
}

fn InstCombiner::getFreelyInvertedImpl(self, V: *mut Value, WillInvertAllUses: bool, Builder: *mut BuilderTy, DoesConsume: *mut bool, Depth: u32) -> *mut Value {
    let mut NonNull: Value *const = 1 as *mut Value;
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    if match(V, m_Not(m_Value(A))) {
        DoesConsume = true;
        return A;
    }
    let mut C: *mut Constant = null;
    if match(V, m_ImmConstant(C)) {
        return getNot(C);
    }
    if Depth += 1 >= MaxAnalysisRecursionDepth {
        return null;
    }
    if !WillInvertAllUses {
        return null;
    }
    if dyn_cast(V) {
        I;
    } else {
        if Builder != null {
            return Builder.CreateCmp(I.getInversePredicate(), I.getOperand(0), I.getOperand(1), "", null);
        }
        return NonNull;
    }
    if match(V, m_Add(m_Value(A), m_Value(B))) {
        if self.getFreelyInvertedImpl(B, B.hasOneUse(), Builder, DoesConsume, Depth) {
            BV;
        } else {
            return if Builder { Builder.CreateSub(BV, A, "", false, false) } else { NonNull };
        }
        if self.getFreelyInvertedImpl(A, A.hasOneUse(), Builder, DoesConsume, Depth) {
            AV;
        } else {
            return if Builder { Builder.CreateSub(AV, B, "", false, false) } else { NonNull };
        }
        return null;
    }
    if match(V, m_Xor(m_Value(A), m_Value(B))) {
        if self.getFreelyInvertedImpl(B, B.hasOneUse(), Builder, DoesConsume, Depth) {
            BV;
        } else {
            return if Builder { Builder.CreateXor(A, BV, "") } else { NonNull };
        }
        if self.getFreelyInvertedImpl(A, A.hasOneUse(), Builder, DoesConsume, Depth) {
            AV;
        } else {
            return if Builder { Builder.CreateXor(AV, B, "") } else { NonNull };
        }
        return null;
    }
    if match(V, m_Sub(m_Value(A), m_Value(B))) {
        if self.getFreelyInvertedImpl(A, A.hasOneUse(), Builder, DoesConsume, Depth) {
            AV;
        } else {
            return if Builder { Builder.CreateAdd(AV, B, "", false, false) } else { NonNull };
        }
        return null;
    }
    if match(V, m_AShr(m_Value(A), m_Value(B))) {
        if self.getFreelyInvertedImpl(A, A.hasOneUse(), Builder, DoesConsume, Depth) {
            AV;
        } else {
            return if Builder { Builder.CreateAShr(AV, B, "", false) } else { NonNull };
        }
        return null;
    }
    let mut Cond: *mut Value = null;
    let mut IsSelect: bool = match(V, m_Select(m_Value(Cond), m_Value(A), m_Value(B))) && !shouldAvoidAbsorbingNotIntoSelect(*cast(V));
    if IsSelect || match(V, m_MaxOrMin(m_Value(A), m_Value(B))) {
        let mut LocalDoesConsume: bool = DoesConsume;
        if !self.getFreelyInvertedImpl(B, B.hasOneUse(), null, LocalDoesConsume, Depth) {
            return null;
        }
        if self.getFreelyInvertedImpl(A, A.hasOneUse(), Builder, LocalDoesConsume, Depth) {
            NotA;
        } else {
            DoesConsume = LocalDoesConsume;
            if Builder != null {
                let mut NotB: *mut Value = self.getFreelyInvertedImpl(B, B.hasOneUse(), Builder, DoesConsume, Depth);
                assert!(NotB != null, "Unable to build inverted value for known freely invertable op");
                if dyn_cast(V) {
                    II;
                } else {
                    return Builder.CreateBinaryIntrinsic(getInverseMinMaxIntrinsic(II.getIntrinsicID()), NotA, NotB, FMFSource {}, "");
                }
                return Builder.CreateSelect(Cond, NotA, NotB, "", cast(V));
            }
            return NonNull;
        }
    }
    if dyn_cast(V) {
        PN;
    } else {
        let mut LocalDoesConsume: bool = DoesConsume;
        let mut IncomingValues: pair<Value *, BasicBlock *>, 8> = pair<Value *, BasicBlock *>, 8> {};
        for U in PN.operands() {
            let mut IncomingBlock: *mut BasicBlock = PN.getIncomingBlock(U);
            let mut NewIncomingVal: *mut Value = self.getFreelyInvertedImpl(U.get(), false, null, LocalDoesConsume, MaxAnalysisRecursionDepth - 1);
            if NewIncomingVal == null {
                return null;
            }
            if NewIncomingVal == V {
                return null;
            }
            if Builder != null {
                IncomingValues.push(NewIncomingVal, IncomingBlock);
            }
        }
        DoesConsume = LocalDoesConsume;
        if Builder != null {
            let mut Guard: InsertPointGuard = *Builder;
            Builder.SetInsertPoint(PN);
            let mut NewPN: *mut PHINode = Builder.CreatePHI(PN.getType(), PN.getNumIncomingValues(), "");
            for x in IncomingValues {
                NewPN.addIncoming(Val, Pred);
            }
            return NewPN;
        }
        return NonNull;
    }
    if match(V, m_SExtLike(m_Value(A))) {
        if self.getFreelyInvertedImpl(A, A.hasOneUse(), Builder, DoesConsume, Depth) {
            AV;
        } else {
            return if Builder { Builder.CreateSExt(AV, V.getType(), "") } else { NonNull };
        }
        return null;
    }
    if match(V, m_Trunc(m_Value(A))) {
        if self.getFreelyInvertedImpl(A, A.hasOneUse(), Builder, DoesConsume, Depth) {
            AV;
        } else {
            return if Builder { Builder.CreateTrunc(AV, V.getType(), "", false, false) } else { NonNull };
        }
        return null;
    }
    let mut TryInvertAndOrUsingDeMorgan: Closure_24 = Closure_24 { DoesConsume: &mut DoesConsume, cap_1: self, Depth: &mut Depth, Builder: &mut Builder };
    if match(V, m_Or(m_Value(A), m_Value(B))) {
        return TryInvertAndOrUsingDeMorgan.call(And, false, A, B);
    }
    if match(V, m_And(m_Value(A), m_Value(B))) {
        return TryInvertAndOrUsingDeMorgan.call(Or, false, A, B);
    }
    if match(V, m_LogicalOr(m_Value(A), m_Value(B))) {
        return TryInvertAndOrUsingDeMorgan.call(And, true, A, B);
    }
    if match(V, m_LogicalAnd(m_Value(A), m_Value(B))) {
        return TryInvertAndOrUsingDeMorgan.call(Or, true, A, B);
    }
    return null;
}

fn shouldCanonicalizeGEPToPtrAdd(GEP: *mut GetElementPtrInst) -> bool {
    let mut PtrOp: *mut Value = GEP.getOperand(0);
    let mut GEPEltType: *mut Type = GEP.getSourceElementType();
    if GEPEltType.isIntegerTy(8) {
        return false;
    }
    if GEPEltType.isScalableTy() {
        return true;
    }
    if GEP.getNumIndices() == 1 && match(GEP.getOperand(1), m_OneUse(m_CombineOr(m_Mul(m_Value(), m_ConstantInt()), m_Shl(m_Value(), m_ConstantInt())))) {
        return true;
    }
    let mut PtrOpGep: CastReturnType = dyn_cast(PtrOp);
    return PtrOpGep && PtrOpGep.hasAllConstantIndices() && any_of(GEP.indices(), Closure_25 {});
}

fn foldGEPOfPhi(GEP: *mut GetElementPtrInst, PN: *mut PHINode, Builder: *mut IRBuilderBase) -> *mut Instruction {
    let mut Op1: *mut GetElementPtrInst = dyn_cast(PN.getOperand(0));
    if !Op1 {
        return null;
    }
    if Op1 == &mut GEP {
        return null;
    }
    let mut NW: GEPNoWrapFlags = Op1.getNoWrapFlags();
    let mut DI: i32 = -1;
    for let mut I: op_iterator = PN.op_begin() + 1;
let mut E: op_iterator = PN.op_end(); I != E; I += 1 {
        let mut Op2: *mut GetElementPtrInst = dyn_cast(*I);
        if !Op2 || Op1.getNumOperands() != Op2.getNumOperands() || Op1.getSourceElementType() != Op2.getSourceElementType() {
            return null;
        }
        if Op2 == &mut GEP {
            return null;
        }
        let mut CurTy: *mut Type = null;
        for let mut J: u32 = 0;
let mut F: u32 = Op1.getNumOperands(); J != F; J += 1 {
            if Op1.getOperand(J).getType() != Op2.getOperand(J).getType() {
                return null;
            }
            if Op1.getOperand(J) != Op2.getOperand(J) {
                if DI == -1 {
                    if J > 1 {
                        assert!(CurTy, "No current type?");
                        if CurTy.isStructTy() {
                            return null;
                        }
                    }
                    DI = J;
                } else {
                    return null;
                }
            }
            if J > 0 {
                if J == 1 {
                    CurTy = Op1.getSourceElementType();
                } else {
                    CurTy = getTypeAtIndex(CurTy, Op1.getOperand(J));
                }
            }
        }
        operator(NW, Op2.getNoWrapFlags());
    }
    if DI != -1 && !PN.hasOneUse() {
        return null;
    }
    let mut NewGEP: *mut GetElementPtrInst = cast(Op1.clone());
    NewGEP.setNoWrapFlags(NW);
    if DI == -1 {} else {
        let mut NewPN: *mut PHINode = null;
        {
            let mut Guard: InsertPointGuard = Builder;
            Builder.SetInsertPoint(PN);
            NewPN = Builder.CreatePHI(Op1.getOperand(DI).getType(), PN.getNumOperands(), "");
        }
        for I in PN.operands() {
            NewPN.addIncoming(cast(I).getOperand(DI), PN.getIncomingBlock(I));
        }
        NewGEP.setOperand(DI, NewPN);
    }
    NewGEP.insertBefore(*GEP.getParent(), GEP.getParent().getFirstInsertionPt());
    return NewGEP;
}

fn InstCombinerImpl::visitGetElementPtrInst(self, GEP: *mut GetElementPtrInst) -> *mut Instruction {
    let mut PtrOp: *mut Value = GEP.getOperand(0);
    let mut Indices: SmallVector<Value *, 8> = GEP.indices();
    let mut GEPType: *mut Type = GEP.getType();
    let mut GEPEltType: *mut Type = GEP.getSourceElementType();
    if simplifyGEPInst(GEPEltType, PtrOp, Indices, GEP.getNoWrapFlags(), self.SQ.getWithInstruction(&mut GEP)) {
        V;
    } else {
        return self.replaceInstUsesWith(GEP, V);
    }
    if dyn_cast(GEPType) {
        GEPFVTy;
    } else {
        let mut VWidth: u32 = GEPFVTy.getNumElements();
        let mut PoisonElts: APInt = APInt { VWidth, 0, false, false };
        let mut AllOnesEltMask: APInt = getAllOnes(VWidth);
        if self.SimplifyDemandedVectorElts(&mut GEP, AllOnesEltMask, PoisonElts, 0, false) {
            V;
        } else {
            if V != &mut GEP {
                return self.replaceInstUsesWith(GEP, V);
            }
            return &mut GEP;
        }
    }
    let mut MadeChange: bool = false;
    let mut NewScalarIndexTy: *mut Type = self.DL.getIndexType(GEP.getPointerOperandType().getScalarType());
    let mut GTI: gep_type_iterator = gep_type_begin(GEP);
    for let mut I: op_iterator = GEP.op_begin() + 1;
let mut E: op_iterator = GEP.op_end(); I != E; I += 1 , operator(GTI) {
        if GTI.isStruct() {
            continue;
        }
        let mut IndexTy: *mut Type = operator((*I)).getType();
        let mut NewIndexType: *mut Type = if IndexTy.isVectorTy() { get(NewScalarIndexTy, cast(IndexTy).getElementCount()) } else { NewScalarIndexTy };
        let mut EltTy: *mut Type = GTI.getIndexedType();
        if EltTy.isSized() && self.DL.getTypeAllocSize(EltTy).isZero() {
            if !isa(*I) || !match(I.get(), m_Zero()) {
                *I = getNullValue(NewIndexType);
                MadeChange = true;
            }
        }
        if IndexTy != NewIndexType {
            if IndexTy.getScalarSizeInBits() < NewIndexType.getScalarSizeInBits() {
                if GEP.hasNoUnsignedWrap() && GEP.hasNoUnsignedSignedWrap() {
                    *I = self.Builder.CreateZExt(*I.operator llvm::Value *(), NewIndexType, "", true);
                } else {
                    *I = self.Builder.CreateSExt(*I.operator llvm::Value *(), NewIndexType, "");
                }
            } else {
                *I = self.Builder.CreateTrunc(*I.operator llvm::Value *(), NewIndexType, "", GEP.hasNoUnsignedWrap(), GEP.hasNoUnsignedSignedWrap());
            }
            MadeChange = true;
        }
    }
    if MadeChange {
        return &mut GEP;
    }
    if !GEPEltType.isIntegerTy(8) && GEP.hasAllConstantIndices() {
        let mut Offset: APInt = APInt { self.DL.getIndexTypeSizeInBits(GEPType), 0, false, false };
        if GEP.accumulateConstantOffset(self.DL, Offset) {
            return self.replaceInstUsesWith(GEP, self.Builder.CreatePtrAdd(PtrOp, self.Builder.getInt(Offset), "", GEP.getNoWrapFlags()));
        }
    }
    if shouldCanonicalizeGEPToPtrAdd(GEP) {
        let mut Offset: *mut Value = self.EmitGEPOffset(cast(&mut GEP), false);
        let mut NewGEP: *mut Value = self.Builder.CreatePtrAdd(PtrOp, Offset, "", GEP.getNoWrapFlags());
        return self.replaceInstUsesWith(GEP, NewGEP);
    }
    let mut LastIdx: *mut Constant = dyn_cast(Indices.back());
    if LastIdx && LastIdx.isNullValue() && !LastIdx.getType().isVectorTy() {
        return self.replaceInstUsesWith(GEP, self.Builder.CreateGEP(GEP.getSourceElementType(), PtrOp, drop_end(Indices, 1), "", GEP.getNoWrapFlags()));
    }
    let mut FirstIdx: *mut Constant = dyn_cast(Indices.front());
    if FirstIdx && FirstIdx.isNullValue() && !FirstIdx.getType().isVectorTy() {
        let mut GTI: gep_type_iterator = gep_type_begin(GEP);
        operator(GTI);
        if !GTI.isStruct() && GTI.getSequentialElementStride(self.DL) == self.DL.getTypeAllocSize(GTI.getIndexedType()) {
            return self.replaceInstUsesWith(GEP, self.Builder.CreateGEP(GTI.getIndexedType(), GEP.getPointerOperand(), drop_begin(Indices, 1), "", GEP.getNoWrapFlags()));
        }
    }
    if GEPType.isVectorTy() && any_of(GEP.operands(), Closure_26 {}) {
        let mut NewOps: SmallVector<Value *> = SmallVector<Value *> {};
        for Op in GEP.operands() {
            if operator(Op).getType().isVectorTy() {
                if getSplatValue(Op.operator llvm::Value *()) {
                    Scalar;
                } else {
                    NewOps.push(Scalar);
                    continue;
                }
            }
            NewOps.push(Op.operator llvm::Value *());
        }
        let mut Res: *mut Value = self.Builder.CreateGEP(GEP.getSourceElementType(), NewOps[0], NewOps.drop_front(1), GEP.getName(), GEP.getNoWrapFlags());
        if !Res.getType().isVectorTy() {
            let mut EC: ElementCount = cast(GEPType).getElementCount();
            Res = self.Builder.CreateVectorSplat(EC, Res, "");
        }
        return self.replaceInstUsesWith(GEP, Res);
    }
    let mut SeenNonZeroIndex: bool = false;
    for x in enumerate(Indices) {
        let mut C: *mut Constant = dyn_cast(Idx);
        if C && C.isNullValue() && IdxNum == 0 {
            continue;
        }
        if !SeenNonZeroIndex {
            SeenNonZeroIndex = true;
            continue;
        }
        let mut FrontIndices: ArrayRef<Value *> = Indices.take_front(IdxNum);
        let mut FrontGEP: *mut Value = self.Builder.CreateGEP(GEPEltType, PtrOp, FrontIndices, GEP.getName() + ".split", GEP.getNoWrapFlags());
        let mut BackIndices: SmallVector<Value *> = SmallVector<Value *> {};
        BackIndices.push(getNullValue(NewScalarIndexTy));
        append_range(BackIndices, drop_begin(Indices, IdxNum));
        return Create(getIndexedType(GEPEltType, FrontIndices), FrontGEP, BackIndices, GEP.getNoWrapFlags(), "", null);
    }
    let mut IsCanonicalType: Closure_27 = Closure_27 {};
    if Indices.len == 1 && !IsCanonicalType.call(GEPEltType) {
        let mut Scale: TypeSize = self.DL.getTypeAllocSize(GEPEltType);
        assert!(!Scale.isScalable(), "Should have been handled earlier");
        let mut NewElemTy: *mut Type = self.Builder.getInt8Ty();
        if Scale.getFixedValue() != 1 {
            NewElemTy = get(NewElemTy, Scale.getFixedValue());
