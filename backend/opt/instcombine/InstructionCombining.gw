static mut NumWorklistIterations: Statistic = Statistic { "instcombine", "NumWorklistIterations", "Number of instruction combining iterations performed" };

static mut NumOneIteration: Statistic = Statistic { "instcombine", "NumOneIteration", "Number of functions with one iteration" };

static mut NumTwoIterations: Statistic = Statistic { "instcombine", "NumTwoIterations", "Number of functions with two iterations" };

static mut NumThreeIterations: Statistic = Statistic { "instcombine", "NumThreeIterations", "Number of functions with three iterations" };

static mut NumFourOrMoreIterations: Statistic = Statistic { "instcombine", "NumFourOrMoreIterations", "Number of functions with four or more iterations" };

static mut NumCombined: Statistic = Statistic { "instcombine", "NumCombined", "Number of insts combined" };

static mut NumConstProp: Statistic = Statistic { "instcombine", "NumConstProp", "Number of constant folds" };

static mut NumDeadInst: Statistic = Statistic { "instcombine", "NumDeadInst", "Number of dead inst eliminated" };

static mut NumSunkInst: Statistic = Statistic { "instcombine", "NumSunkInst", "Number of instructions sunk" };

static mut NumExpand: Statistic = Statistic { "instcombine", "NumExpand", "Number of expansions" };

static mut NumFactor: Statistic = Statistic { "instcombine", "NumFactor", "Number of factorizations" };

static mut NumReassoc: Statistic = Statistic { "instcombine", "NumReassoc", "Number of reassociations" };

static mut VisitCounter: CounterInfo = CounterInfo { "instcombine-visit", "Controls which instructions are visited" };

fn InstCombiner@llvm::~IRBuilderInstCombineInserter(self) {}

fn IRBuilderInstCombineInserter@InstCombiner@llvm::InsertHelper(self: *IRBuilderInstCombineInserter@InstCombiner@llvm, I: *mut Instruction, Name: str, InsertPt: iterator) {
    self.InsertHelper(I, Name, InsertPt);
    self.IC.Worklist.add(I);
    if dyn_cast(I) {
        Assume;
    } else {
        self.IC.AC.registerAssumption(Assume);
    }
    if self.IC.AnnotationMetadataSource {
        I.copyMetadata(*self.IC.AnnotationMetadataSource, MD_annotation);
    }
}

fn InstCombiner::targetInstCombineIntrinsic(self, II: *mut IntrinsicInst) -> optional<Instruction *> {
    if II.getCalledFunction().isTargetIntrinsic() {
        return self.TTIForTargetIntrinsicsOnly.instCombineIntrinsic(*self, II);
    }
    return nullopt;
}

fn InstCombiner::targetSimplifyDemandedUseBitsIntrinsic(self, II: *mut IntrinsicInst, DemandedMask: APInt, Known: *mut KnownBits, KnownBitsComputed: *mut bool) -> optional<Value *> {
    if II.getCalledFunction().isTargetIntrinsic() {
        return self.TTIForTargetIntrinsicsOnly.simplifyDemandedUseBitsIntrinsic(*self, II, DemandedMask, Known, KnownBitsComputed);
    }
    return nullopt;
}

fn InstCombiner::targetSimplifyDemandedVectorEltsIntrinsic(self, II: *mut IntrinsicInst, DemandedElts: APInt, PoisonElts: *mut APInt, PoisonElts2: *mut APInt, PoisonElts3: *mut APInt, SimplifyAndSetOp: function<void (Instruction *, unsigned int, APInt, APInt &)>) -> optional<Value *> {
    if II.getCalledFunction().isTargetIntrinsic() {
        return self.TTIForTargetIntrinsicsOnly.simplifyDemandedVectorEltsIntrinsic(*self, II, DemandedElts, PoisonElts, PoisonElts2, PoisonElts3, SimplifyAndSetOp);
    }
    return nullopt;
}

fn InstCombiner::isValidAddrSpaceCast(self: *InstCombiner, FromAS: u32, ToAS: u32) -> bool {
    return self.TTIForTargetIntrinsicsOnly.isValidAddrSpaceCast(FromAS, ToAS);
}

fn InstCombinerImpl::EmitGEPOffset(self, GEP: *mut GEPOperator, RewriteGEP: bool) -> *mut Value {
    if !RewriteGEP {
        return emitGEPOffset(&mut self.Builder, self.DL, GEP, false);
    }
    let mut Guard: InsertPointGuard = self.Builder;
    let mut Inst: *mut Instruction = dyn_cast(GEP);
    if Inst {
        self.Builder.SetInsertPoint(Inst);
    }
    let mut Offset: *mut Value = self.EmitGEPOffset(GEP, false);
    if Inst && !GEP.hasAllConstantIndices() && !GEP.getSourceElementType().isIntegerTy(8) {
        self.replaceInstUsesWith(*Inst, self.Builder.CreateGEP(self.Builder.getInt8Ty(), GEP.getPointerOperand(), Offset, "", GEP.getNoWrapFlags()));
        self.eraseInstFromFunction(*Inst);
    }
    return Offset;
}

fn InstCombinerImpl::EmitGEPOffsets(self, GEPs: ArrayRef<GEPOperator *>, NW: GEPNoWrapFlags, IdxTy: *mut Type, RewriteGEPs: bool) -> *mut Value {
    let mut Add: Closure_1 = Closure_1 { cap_0: self, NW: &mut NW };
    let mut Sum: *mut Value = null;
    let mut OneUseSum: *mut Value = null;
    let mut OneUseBase: *mut Value = null;
    let mut OneUseFlags: GEPNoWrapFlags = all();
    for GEP in reverse(GEPs) {
        let mut Offset: *mut Value = null;
        {
            let mut Guard: InsertPointGuard = self.Builder;
            let mut Inst: *mut Instruction = dyn_cast(GEP);
            if RewriteGEPs && Inst {
                self.Builder.SetInsertPoint(Inst);
            }
            Offset = emitGEPOffset(&mut self.Builder, self.DL, GEP, false);
            if Offset.getType() != IdxTy {
                Offset = self.Builder.CreateVectorSplat(cast(IdxTy).getElementCount(), Offset, "");
            }
            if GEP.hasOneUse() {
                OneUseSum = Add.call(OneUseSum, Offset);
                OneUseFlags = OneUseFlags.intersectForOffsetAdd(GEP.getNoWrapFlags());
                if !OneUseBase {
                    OneUseBase = GEP.getPointerOperand();
                }
                continue;
            }
            if OneUseSum {
                Offset = Add.call(OneUseSum, Offset);
            }
            if RewriteGEPs && Inst && Offset.getType().isVectorTy() == GEP.getType().isVectorTy() && !(GEP.getSourceElementType().isIntegerTy(8) && GEP.getOperand(1) == Offset) {
                self.replaceInstUsesWith(*Inst, self.Builder.CreatePtrAdd(if OneUseBase { OneUseBase } else { GEP.getPointerOperand() }, Offset, "", OneUseFlags.intersectForOffsetAdd(GEP.getNoWrapFlags())));
                self.eraseInstFromFunction(*Inst);
            }
        }
        Sum = Add.call(Sum, Offset);
        OneUseSum = OneUseBase = null;
        OneUseFlags = all();
    }
    if OneUseSum {
        Sum = Add.call(Sum, OneUseSum);
    }
    if !Sum {
        return getNullValue(IdxTy);
    }
    return Sum;
}

fn InstCombinerImpl::isDesirableIntType(self: *InstCombinerImpl, BitWidth: u32) -> bool {
    match BitWidth {
        8 => {
            16;
        },
        _ => {
            return self.DL.isLegalInteger(BitWidth);
        },
    }
}

fn InstCombinerImpl::shouldChangeType(self: *InstCombinerImpl, FromWidth: u32, ToWidth: u32) -> bool {
    let mut FromLegal: bool = FromWidth == 1 || self.DL.isLegalInteger(FromWidth);
    let mut ToLegal: bool = ToWidth == 1 || self.DL.isLegalInteger(ToWidth);
    if ToWidth < FromWidth && self.isDesirableIntType(ToWidth) {
        return true;
    }
    if (FromLegal || self.isDesirableIntType(FromWidth)) && !ToLegal {
        return false;
    }
    if !FromLegal && !ToLegal && ToWidth > FromWidth {
        return false;
    }
    return true;
}

fn InstCombinerImpl::shouldChangeType(self: *InstCombinerImpl, From: *mut Type, To: *mut Type) -> bool {
    if !From.isIntegerTy() || !To.isIntegerTy() {
        return false;
    }
    let mut FromWidth: u32 = From.getPrimitiveSizeInBits().operator unsigned long long();
    let mut ToWidth: u32 = To.getPrimitiveSizeInBits().operator unsigned long long();
    return self.shouldChangeType(FromWidth, ToWidth);
}

fn maintainNoSignedWrap(I: *mut BinaryOperator, B: *mut Value, C: *mut Value) -> bool {
    let mut OBO: *mut OverflowingBinaryOperator = dyn_cast(&mut I);
    if !OBO || !OBO.hasNoSignedWrap() {
        return false;
    }
    let mut BVal: *APInt = null;
    let mut CVal: *APInt = null;
    if !match(B, m_APInt(BVal)) || !match(C, m_APInt(CVal)) {
        return false;
    }
    let mut Overflow: bool = false;
    match I.getOpcode() {
        Add => {
            BVal.sadd_ov(*CVal, Overflow) as void;
        },
        Sub => {
            BVal.ssub_ov(*CVal, Overflow) as void;
        },
        Mul => {
            BVal.smul_ov(*CVal, Overflow) as void;
        },
        _ => {
            return false;
        },
    }
    return !Overflow;
}

fn hasNoUnsignedWrap(I: *mut BinaryOperator) -> bool {
    let mut OBO: *mut OverflowingBinaryOperator = dyn_cast(&mut I);
    return OBO && OBO.hasNoUnsignedWrap();
}

fn hasNoSignedWrap(I: *mut BinaryOperator) -> bool {
    let mut OBO: *mut OverflowingBinaryOperator = dyn_cast(&mut I);
    return OBO && OBO.hasNoSignedWrap();
}

fn simplifyAssocCastAssoc(BinOp1: *mut BinaryOperator, IC: *mut InstCombinerImpl) -> bool {
    let mut Cast: *mut CastInst = dyn_cast(BinOp1.getOperand(0));
    if !Cast || !Cast.hasOneUse() {
        return false;
    }
    let mut CastOpcode: CastOps = Cast.getOpcode();
    if CastOpcode != ZExt {
        return false;
    }
    if !BinOp1.isBitwiseLogicOp() {
        return false;
    }
    let mut AssocOpcode: BinaryOps = BinOp1.getOpcode();
    let mut BinOp2: *mut BinaryOperator = dyn_cast(Cast.getOperand(0));
    if !BinOp2 || !BinOp2.hasOneUse() || BinOp2.getOpcode() != AssocOpcode {
        return false;
    }
    let mut C1: *mut Constant = null;
    let mut C2: *mut Constant = null;
    if !match(BinOp1.getOperand(1), m_Constant(C1)) || !match(BinOp2.getOperand(1), m_Constant(C2)) {
        return false;
    }
    let mut DL: *DataLayout = IC.getDataLayout();
    let mut DestTy: *mut Type = C1.getType();
    let mut CastC2: *mut Constant = ConstantFoldCastOperand(CastOpcode, C2, DestTy, DL);
    if !CastC2 {
        return false;
    }
    let mut FoldedC: *mut Constant = ConstantFoldBinaryOpOperands(AssocOpcode, C1, CastC2, DL);
    if !FoldedC {
        return false;
    }
    IC.replaceOperand(*Cast, 0, BinOp2.getOperand(0));
    IC.replaceOperand(*BinOp1, 1, FoldedC);
    BinOp1.dropPoisonGeneratingFlags();
    Cast.dropPoisonGeneratingFlags();
    return true;
}

fn InstCombinerImpl::simplifyIntToPtrRoundTripCast(self, Val: *mut Value) -> *mut Value {
    let mut IntToPtr: *mut IntToPtrInst = dyn_cast(Val);
    if IntToPtr && self.DL.getTypeSizeInBits(IntToPtr.getDestTy()) == self.DL.getTypeSizeInBits(IntToPtr.getSrcTy()) {
        let mut PtrToInt: *mut PtrToIntInst = dyn_cast(IntToPtr.getOperand(0));
        let mut CastTy: *mut Type = IntToPtr.getDestTy();
        if PtrToInt && CastTy.getPointerAddressSpace() == PtrToInt.getSrcTy().getPointerAddressSpace() && self.DL.getTypeSizeInBits(PtrToInt.getSrcTy()) == self.DL.getTypeSizeInBits(PtrToInt.getDestTy()) {
            return PtrToInt.getOperand(0);
        }
    }
    return null;
}

fn InstCombinerImpl::SimplifyAssociativeOrCommutative(self, I: *mut BinaryOperator) -> bool {
    let mut Opcode: BinaryOps = I.getOpcode();
    let mut Changed: bool = false;
    while true {
        {
        if I.isCommutative() && getComplexity(I.getOperand(0)) < getComplexity(I.getOperand(1)) {
            Changed = !I.swapOperands();
        }
        if I.isCommutative() {
            if self.matchSymmetricPair(I.getOperand(0), I.getOperand(1)) {
                Pair;
            } else {
                self.replaceOperand(I, 0, operator(Pair).first);
                self.replaceOperand(I, 1, operator(Pair).second);
                Changed = true;
            }
        }
        let mut Op0: *mut BinaryOperator = dyn_cast(I.getOperand(0));
        let mut Op1: *mut BinaryOperator = dyn_cast(I.getOperand(1));
        if I.isAssociative() {
            if Op0 && Op0.getOpcode() == Opcode {
                let mut A: *mut Value = Op0.getOperand(0);
                let mut B: *mut Value = Op0.getOperand(1);
                let mut C: *mut Value = I.getOperand(1);
                if simplifyBinOp(Opcode, B, C, self.SQ.getWithInstruction(&mut I)) {
                    V;
                } else {
                    self.replaceOperand(I, 0, A);
                    self.replaceOperand(I, 1, V);
                    let mut IsNUW: bool = hasNoUnsignedWrap(I) && hasNoUnsignedWrap(*Op0);
                    let mut IsNSW: bool = maintainNoSignedWrap(I, B, C) && hasNoSignedWrap(*Op0);
                    if dyn_cast(&mut I) {
                        PDI;
                    } else {
                        PDI.setIsDisjoint(false);
                    }
                    if isa(I) {
                        I.setHasNoUnsignedWrap(IsNUW);
                        I.setHasNoSignedWrap(IsNSW);
                    }
                    Changed = true;
                    operator(NumReassoc);
                    continue;
                }
            }
            if Op1 && Op1.getOpcode() == Opcode {
                let mut A: *mut Value = I.getOperand(0);
                let mut B: *mut Value = Op1.getOperand(0);
                let mut C: *mut Value = Op1.getOperand(1);
                if simplifyBinOp(Opcode, A, B, self.SQ.getWithInstruction(&mut I)) {
                    V;
                } else {
                    self.replaceOperand(I, 0, V);
                    self.replaceOperand(I, 1, C);
                    if !isa(I) {
                        I.dropPoisonGeneratingFlags();
                    }
                    Changed = true;
                    operator(NumReassoc);
                    continue;
                }
            }
        }
        if I.isAssociative() && I.isCommutative() {
            if simplifyAssocCastAssoc(&mut I, *self) {
                Changed = true;
                operator(NumReassoc);
                continue;
            }
            if Op0 && Op0.getOpcode() == Opcode {
                let mut A: *mut Value = Op0.getOperand(0);
                let mut B: *mut Value = Op0.getOperand(1);
                let mut C: *mut Value = I.getOperand(1);
                if simplifyBinOp(Opcode, C, A, self.SQ.getWithInstruction(&mut I)) {
                    V;
                } else {
                    self.replaceOperand(I, 0, V);
                    self.replaceOperand(I, 1, B);
                    if !isa(I) {
                        I.dropPoisonGeneratingFlags();
                    }
                    Changed = true;
                    operator(NumReassoc);
                    continue;
                }
            }
            if Op1 && Op1.getOpcode() == Opcode {
                let mut A: *mut Value = I.getOperand(0);
                let mut B: *mut Value = Op1.getOperand(0);
                let mut C: *mut Value = Op1.getOperand(1);
                if simplifyBinOp(Opcode, C, A, self.SQ.getWithInstruction(&mut I)) {
                    V;
                } else {
                    self.replaceOperand(I, 0, B);
                    self.replaceOperand(I, 1, V);
                    if !isa(I) {
                        I.dropPoisonGeneratingFlags();
                    }
                    Changed = true;
                    operator(NumReassoc);
                    continue;
                }
            }
            let mut A: *mut Value = null;
            let mut B: *mut Value = null;
            let mut C1: *mut Constant = null;
            let mut C2: *mut Constant = null;
            let mut CRes: *mut Constant = null;
            if Op0 && Op1 && Op0.getOpcode() == Opcode && Op1.getOpcode() == Opcode && match(Op0, m_OneUse(m_BinOp(m_Value(A), m_Constant(C1)))) && match(Op1, m_OneUse(m_BinOp(m_Value(B), m_Constant(C2)))) && (CRes = ConstantFoldBinaryOpOperands(Opcode, C1, C2, self.DL)) {
                let mut IsNUW: bool = hasNoUnsignedWrap(I) && hasNoUnsignedWrap(*Op0) && hasNoUnsignedWrap(*Op1);
                let mut NewBO: *mut BinaryOperator = if (IsNUW && Opcode == Add) { CreateNUW(Opcode, A, B, "") } else { Create(Opcode, A, B, "", null) };
                if isa(NewBO) {
                    let mut Flags: FastMathFlags = I.getFastMathFlags() & Op0.getFastMathFlags() & Op1.getFastMathFlags();
                    NewBO.setFastMathFlags(Flags);
                }
                self.InsertNewInstWith(NewBO, I.getIterator());
                NewBO.takeName(Op1);
                self.replaceOperand(I, 0, NewBO);
                self.replaceOperand(I, 1, CRes);
                if !isa(I) {
                    I.dropPoisonGeneratingFlags();
                }
                if IsNUW {
                    I.setHasNoUnsignedWrap(true);
                }
                Changed = true;
                continue;
            }
        }
        return Changed;
    }
        if !(true) { break; }
    }
}

fn leftDistributesOverRight(LOp: BinaryOps, ROp: BinaryOps) -> bool {
    if LOp == And {
        return ROp == Or || ROp == Xor;
    }
    if LOp == Or {
        return ROp == And;
    }
    if LOp == Mul {
        return ROp == Add || ROp == Sub;
    }
    return false;
}

fn rightDistributesOverLeft(LOp: BinaryOps, ROp: BinaryOps) -> bool {
    if isCommutative(ROp) {
        return leftDistributesOverRight(ROp, LOp);
    }
    return isBitwiseLogicOp(LOp) && isShift(ROp);
}

fn getIdentityValue(Opcode: BinaryOps, V: *mut Value) -> *mut Value {
    if isa(V) {
        return null;
    }
    return getBinOpIdentity(Opcode, V.getType(), false, false);
}

fn getBinOpsForFactorization(TopOpcode: BinaryOps, Op: *mut BinaryOperator, LHS: *mut *mut Value, RHS: *mut *mut Value, OtherOp: *mut BinaryOperator) -> BinaryOps {
    assert!(Op, "Expected a binary operator");
    LHS = Op.getOperand(0);
    RHS = Op.getOperand(1);
    if TopOpcode == Add || TopOpcode == Sub {
        let mut C: *mut Constant = null;
        if match(Op, m_Shl(m_Value(), m_ImmConstant(C))) {
            RHS = ConstantFoldBinaryInstruction(Shl, get(Op.getType(), 1, false, false), C);
            assert!(RHS, "Constant folding of immediate constants failed");
            return Mul;
        }
    }
    if isBitwiseLogicOp(TopOpcode) {
        if OtherOp && OtherOp.getOpcode() == AShr && match(Op, m_LShr(m_NonNegative(), m_Value())) {
            return AShr;
        }
    }
    return Op.getOpcode();
}

fn tryFactorization(I: *mut BinaryOperator, SQ: *SimplifyQuery, Builder: *mut BuilderTy, InnerOpcode: BinaryOps, A: *mut Value, B: *mut Value, C: *mut Value, D: *mut Value) -> *mut Value {
    assert!(A && B && C && D, "All values must be provided");
    let mut V: *mut Value = null;
    let mut RetVal: *mut Value = null;
    let mut LHS: *mut Value = I.getOperand(0);
    let mut RHS: *mut Value = I.getOperand(1);
    let mut TopLevelOpcode: BinaryOps = I.getOpcode();
    let mut InnerCommutative: bool = isCommutative(InnerOpcode);
    if leftDistributesOverRight(InnerOpcode, TopLevelOpcode) {
        if A == C || (InnerCommutative && A == D) {
            if A != C {
                swap(C, D);
            }
            V = simplifyBinOp(TopLevelOpcode, B, D, SQ.getWithInstruction(&mut I));
            if !V && (LHS.hasOneUse() || RHS.hasOneUse()) {
                V = Builder.CreateBinOp(TopLevelOpcode, B, D, RHS.getName(), null);
            }
            if V {
                RetVal = Builder.CreateBinOp(InnerOpcode, A, V, "", null);
            }
        }
    }
    if !RetVal && rightDistributesOverLeft(TopLevelOpcode, InnerOpcode) {
        if B == D || (InnerCommutative && B == C) {
            if B != D {
                swap(C, D);
            }
            V = simplifyBinOp(TopLevelOpcode, A, C, SQ.getWithInstruction(&mut I));
            if !V && (LHS.hasOneUse() || RHS.hasOneUse()) {
                V = Builder.CreateBinOp(TopLevelOpcode, A, C, LHS.getName(), null);
            }
            if V {
                RetVal = Builder.CreateBinOp(InnerOpcode, V, B, "", null);
            }
        }
    }
    if !RetVal {
        return null;
    }
    operator(NumFactor);
    RetVal.takeName(&mut I);
    if isa(RetVal) {
        let mut HasNSW: bool = false;
        let mut HasNUW: bool = false;
        if isa(&mut I) {
            HasNSW = I.hasNoSignedWrap();
            HasNUW = I.hasNoUnsignedWrap();
        }
        if dyn_cast(LHS) {
            LOBO;
        } else {
            HasNSW &= LOBO.hasNoSignedWrap();
            HasNUW &= LOBO.hasNoUnsignedWrap();
        }
        if dyn_cast(RHS) {
            ROBO;
        } else {
            HasNSW &= ROBO.hasNoSignedWrap();
            HasNUW &= ROBO.hasNoUnsignedWrap();
        }
        if TopLevelOpcode == Add && InnerOpcode == Mul {
            let mut CInt: *APInt = null;
            if match(V, m_APInt(CInt)) && !CInt.isMinSignedValue() {
                cast(RetVal).setHasNoSignedWrap(HasNSW);
            }
            cast(RetVal).setHasNoUnsignedWrap(HasNUW);
        }
    }
    return RetVal;
}

fn InstCombinerImpl::tryFoldInstWithCtpopWithNot(self, I: *mut Instruction) -> *mut Instruction {
    let mut Opc: u32 = I.getOpcode();
    let mut ConstIdx: u32 = 1;
    match Opc {
        _ => {
            return null;
        },
        Sub => {
            ConstIdx = 0;
        },
        ICmp => {
            if cast(I).isSigned() {
                return null;
            }
        },
        Or => {
            if !match(I, m_DisjointOr(m_Value(), m_Value())) {
                return null;
            }
        },
        Add => {
            break;
        },
    }
    let mut Op: *mut Value = null;
    if !match(I.getOperand(1 - ConstIdx), m_OneUse(m_Ctpop(m_Value(Op)))) {
        return null;
    }
    let mut C: *mut Constant = null;
    if !match(I.getOperand(ConstIdx), m_ImmConstant(C)) {
        return null;
    }
    let mut Ty: *mut Type = Op.getType();
    let mut BitWidthC: *mut Constant = get(Ty, Ty.getScalarSizeInBits(), false, false);
    if Opc == ICmp && !cast(I).isEquality() {
        let mut Cmp: *mut Constant = ConstantFoldCompareInstOperands(ICMP_UGT, C, BitWidthC, self.DL, null, null);
        if !Cmp || !Cmp.isNullValue() {
            return null;
        }
    }
    let mut Consumes: bool = false;
    if !self.isFreeToInvert(Op, Op.hasOneUse(), Consumes) || !Consumes {
        return null;
    }
    let mut NotOp: *mut Value = self.getFreelyInverted(Op, Op.hasOneUse(), &mut self.Builder);
    assert!(NotOp != null, "Desync between isFreeToInvert and getFreelyInverted");
    let mut CtpopOfNotOp: *mut Value = self.Builder.CreateIntrinsic(Ty, ctpop, NotOp, FMFSource {}, "", function_ref<void (CallInst *)> { Closure_2 {}, null, null });
    let mut R: *mut Value = null;
    match Opc {
        Sub => {
            R = self.Builder.CreateAdd(CtpopOfNotOp, getSub(C, BitWidthC, false, false), "", false, false);
        },
        Or => {
            Add;
        },
        ICmp => {
            R = self.Builder.CreateICmp(cast(I).getSwappedPredicate(), CtpopOfNotOp, getSub(BitWidthC, C, false, false), "");
        },
        _ => {
            llvm_unreachable_internal("Unhandled Opcode", "P:/Goraw/llvm-project/llvm/lib/Transforms/InstCombine/InstructionCombining.cpp", 903);
        },
    }
    assert!(R != null);
    return self.replaceInstUsesWith(*I, R);
}

fn InstCombinerImpl::foldBinOpShiftWithShift(self, I: *mut BinaryOperator) -> *mut Instruction {
    let mut DL: *DataLayout = I.getDataLayout();
    let mut IsValidBinOpc: Closure_3 = Closure_3 {};
    let mut IsCompletelyDistributable: Closure_4 = Closure_4 {};
    let mut GetInvShift: Closure_5 = Closure_5 {};
    let mut CanDistributeBinops: Closure_6 = Closure_6 { IsCompletelyDistributable: &mut IsCompletelyDistributable, GetInvShift: &mut GetInvShift, DL: &mut DL };
    let mut MatchBinOp: Closure_7 = Closure_7 { I: &mut I, IsValidBinOpc: &mut IsValidBinOpc, cap_2: self, IsCompletelyDistributable: &mut IsCompletelyDistributable, CanDistributeBinops: &mut CanDistributeBinops, GetInvShift: &mut GetInvShift, DL: &mut DL };
    if MatchBinOp.call(0) {
        R;
    } else {
        return R;
    }
    return MatchBinOp.call(1);
}

fn InstCombinerImpl::foldBinOpOfSelectAndCastOfSelectCondition(self, I: *mut BinaryOperator) -> *mut Instruction {
    let mut Opc: BinaryOps = I.getOpcode();
    let mut LHS: *mut Value = I.getOperand(0);
    let mut RHS: *mut Value = I.getOperand(1);
    let mut A: *mut Value = null;
    let mut CondVal: *mut Value = null;
    let mut TrueVal: *mut Value = null;
    let mut FalseVal: *mut Value = null;
    let mut CastOp: *mut Value = null;
    let mut CastTrueVal: *mut Constant = null;
    let mut CastFalseVal: *mut Constant = null;
    let mut MatchSelectAndCast: Closure_8 = Closure_8 { A: &mut A, CastTrueVal: &mut CastTrueVal, CastFalseVal: &mut CastFalseVal, CondVal: &mut CondVal, TrueVal: &mut TrueVal, FalseVal: &mut FalseVal };
    if MatchSelectAndCast.call(LHS, RHS) {
        CastOp = LHS;
    } else if MatchSelectAndCast.call(RHS, LHS) {
        CastOp = RHS;
    } else {
        return null;
    }
    let mut SI: *mut SelectInst = cast(if CastOp == LHS { RHS } else { LHS });
    let mut NewFoldedConst: Closure_9 = Closure_9 { CastOp: &mut CastOp, RHS: &mut RHS, CastFalseVal: &mut CastFalseVal, CastTrueVal: &mut CastTrueVal, cap_4: self, Opc: &mut Opc };
    if CondVal == A {
        let mut NewTrueVal: *mut Value = NewFoldedConst.call(false, TrueVal);
        return Create(CondVal, NewTrueVal, NewFoldedConst.call(true, FalseVal), "", null, SI);
    }
    if match(A, m_Not(m_Specific(CondVal))) {
        let mut NewTrueVal: *mut Value = NewFoldedConst.call(true, TrueVal);
        return Create(CondVal, NewTrueVal, NewFoldedConst.call(false, FalseVal), "", null, SI);
    }
    return null;
}

fn InstCombinerImpl::tryFactorizationFolds(self, I: *mut BinaryOperator) -> *mut Value {
    let mut LHS: *mut Value = I.getOperand(0);
    let mut RHS: *mut Value = I.getOperand(1);
    let mut Op0: *mut BinaryOperator = dyn_cast(LHS);
    let mut Op1: *mut BinaryOperator = dyn_cast(RHS);
    let mut TopLevelOpcode: BinaryOps = I.getOpcode();
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut C: *mut Value = null;
    let mut D: *mut Value = null;
    let mut LHSOpcode: BinaryOps = zeroed();
    let mut RHSOpcode: BinaryOps = zeroed();
    if Op0 {
        LHSOpcode = getBinOpsForFactorization(TopLevelOpcode, Op0, A, B, Op1);
    }
    if Op1 {
        RHSOpcode = getBinOpsForFactorization(TopLevelOpcode, Op1, C, D, Op0);
    }
    if Op0 && Op1 && LHSOpcode == RHSOpcode {
        if tryFactorization(I, self.SQ, self.Builder, LHSOpcode, A, B, C, D) {
            V;
        } else {
            return V;
        }
    }
    if Op0 {
        if getIdentityValue(LHSOpcode, RHS) {
            Ident;
        } else if tryFactorization(I, self.SQ, self.Builder, LHSOpcode, A, B, RHS, Ident) {
            V;
        } else {
            return V;
        }
    }
    if Op1 {
        if getIdentityValue(RHSOpcode, LHS) {
            Ident;
        } else if tryFactorization(I, self.SQ, self.Builder, RHSOpcode, LHS, Ident, C, D) {
            V;
        } else {
            return V;
        }
    }
    return null;
}

fn InstCombinerImpl::foldUsingDistributiveLaws(self, I: *mut BinaryOperator) -> *mut Value {
    let mut LHS: *mut Value = I.getOperand(0);
    let mut RHS: *mut Value = I.getOperand(1);
    let mut Op0: *mut BinaryOperator = dyn_cast(LHS);
    let mut Op1: *mut BinaryOperator = dyn_cast(RHS);
    let mut TopLevelOpcode: BinaryOps = I.getOpcode();
    if self.tryFactorizationFolds(I) {
        R;
    } else {
        return R;
    }
    if Op0 && rightDistributesOverLeft(Op0.getOpcode(), TopLevelOpcode) {
        let mut A: *mut Value = Op0.getOperand(0);
        let mut B: *mut Value = Op0.getOperand(1);
        let mut C: *mut Value = RHS;
        let mut InnerOpcode: BinaryOps = Op0.getOpcode();
        let mut SQDistributive: SimplifyQuery = self.SQ.getWithInstruction(&mut I).getWithoutUndef();
        let mut L: *mut Value = simplifyBinOp(TopLevelOpcode, A, C, SQDistributive);
        let mut R: *mut Value = simplifyBinOp(TopLevelOpcode, B, C, SQDistributive);
        if L && R {
            operator(NumExpand);
            C = self.Builder.CreateBinOp(InnerOpcode, L, R, "", null);
            C.takeName(&mut I);
            return C;
        }
        if L && L == getBinOpIdentity(InnerOpcode, L.getType(), false, false) {
            operator(NumExpand);
            C = self.Builder.CreateBinOp(TopLevelOpcode, B, C, "", null);
            C.takeName(&mut I);
            return C;
        }
        if R && R == getBinOpIdentity(InnerOpcode, R.getType(), false, false) {
            operator(NumExpand);
            C = self.Builder.CreateBinOp(TopLevelOpcode, A, C, "", null);
            C.takeName(&mut I);
            return C;
        }
    }
    if Op1 && leftDistributesOverRight(TopLevelOpcode, Op1.getOpcode()) {
        let mut A: *mut Value = LHS;
        let mut B: *mut Value = Op1.getOperand(0);
        let mut C: *mut Value = Op1.getOperand(1);
        let mut InnerOpcode: BinaryOps = Op1.getOpcode();
        let mut SQDistributive: SimplifyQuery = self.SQ.getWithInstruction(&mut I).getWithoutUndef();
        let mut L: *mut Value = simplifyBinOp(TopLevelOpcode, A, B, SQDistributive);
        let mut R: *mut Value = simplifyBinOp(TopLevelOpcode, A, C, SQDistributive);
        if L && R {
            operator(NumExpand);
            A = self.Builder.CreateBinOp(InnerOpcode, L, R, "", null);
            A.takeName(&mut I);
            return A;
        }
        if L && L == getBinOpIdentity(InnerOpcode, L.getType(), false, false) {
            operator(NumExpand);
            A = self.Builder.CreateBinOp(TopLevelOpcode, A, C, "", null);
            A.takeName(&mut I);
            return A;
        }
        if R && R == getBinOpIdentity(InnerOpcode, R.getType(), false, false) {
            operator(NumExpand);
            A = self.Builder.CreateBinOp(TopLevelOpcode, A, B, "", null);
            A.takeName(&mut I);
            return A;
        }
    }
    return self.SimplifySelectsFeedingBinaryOp(I, LHS, RHS);
}

fn matchSymmetricPhiNodesPair(LHS: *mut PHINode, RHS: *mut PHINode) -> pair<Value *, Value *>> {
    if LHS.getParent() != RHS.getParent() {
        return nullopt;
    }
    if LHS.getNumIncomingValues() < 2 {
        return nullopt;
    }
    if !equal(LHS.blocks(), RHS.blocks()) {
        return nullopt;
    }
    let mut L0: *mut Value = LHS.getIncomingValue(0);
    let mut R0: *mut Value = RHS.getIncomingValue(0);
    for let mut I: u32 = 1;
let mut E: u32 = LHS.getNumIncomingValues(); I != E; I += 1 {
        let mut L1: *mut Value = LHS.getIncomingValue(I);
        let mut R1: *mut Value = RHS.getIncomingValue(I);
        if (L0 == L1 && R0 == R1) || (L0 == R1 && R0 == L1) {
            continue;
        }
        return nullopt;
    }
    return Value *> { L0, R0 };
}

fn InstCombinerImpl::matchSymmetricPair(self, LHS: *mut Value, RHS: *mut Value) -> pair<Value *, Value *>> {
    let mut LHSInst: *mut Instruction = dyn_cast(LHS);
    let mut RHSInst: *mut Instruction = dyn_cast(RHS);
    if !LHSInst || !RHSInst || LHSInst.getOpcode() != RHSInst.getOpcode() {
        return nullopt;
    }
    match LHSInst.getOpcode() {
        PHI => {
            return matchSymmetricPhiNodesPair(cast(LHS), cast(RHS));
        },
        Select => {
            let mut Cond: *mut Value = LHSInst.getOperand(0);
            let mut TrueVal: *mut Value = LHSInst.getOperand(1);
            let mut FalseVal: *mut Value = LHSInst.getOperand(2);
            if Cond == RHSInst.getOperand(0) && TrueVal == RHSInst.getOperand(2) && FalseVal == RHSInst.getOperand(1) {
                return Value *> { TrueVal, FalseVal };
            }
            return nullopt;
        },
        Call => {
            let mut LHSMinMax: *mut MinMaxIntrinsic = dyn_cast(LHSInst);
            let mut RHSMinMax: *mut MinMaxIntrinsic = dyn_cast(RHSInst);
            if LHSMinMax && RHSMinMax && LHSMinMax.getPredicate() == getSwappedPredicate(RHSMinMax.getPredicate()) && ((LHSMinMax.getLHS() == RHSMinMax.getLHS() && LHSMinMax.getRHS() == RHSMinMax.getRHS()) || (LHSMinMax.getLHS() == RHSMinMax.getRHS() && LHSMinMax.getRHS() == RHSMinMax.getLHS())) {
                return Value *> { LHSMinMax.getLHS(), LHSMinMax.getRHS() };
            }
            return nullopt;
        },
        _ => {
            return nullopt;
        },
    }
}

fn InstCombinerImpl::SimplifySelectsFeedingBinaryOp(self, I: *mut BinaryOperator, LHS: *mut Value, RHS: *mut Value) -> *mut Value {
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut C: *mut Value = null;
    let mut D: *mut Value = null;
    let mut E: *mut Value = null;
    let mut F: *mut Value = null;
    let mut LHSIsSelect: bool = match(LHS, m_Select(m_Value(A), m_Value(B), m_Value(C)));
    let mut RHSIsSelect: bool = match(RHS, m_Select(m_Value(D), m_Value(E), m_Value(F)));
    if !LHSIsSelect && !RHSIsSelect {
        return null;
    }
    let mut SI: *mut SelectInst = cast(if LHSIsSelect { LHS } else { RHS });
    let mut FMF: FastMathFlags = FastMathFlags {};
    let mut Guard: FastMathFlagGuard = self.Builder;
    if dyn_cast(&mut I) {
        FPOp;
    } else {
        FMF = FPOp.getFastMathFlags();
        self.Builder.setFastMathFlags(FMF);
    }
    let mut Opcode: BinaryOps = I.getOpcode();
    let mut Q: SimplifyQuery = self.SQ.getWithInstruction(&mut I);
    let mut Cond: *mut Value = null;
    let mut True: *mut Value = null;
    let mut False: *mut Value = null;
    let mut simplifySelectWithImpliedCond: Closure_10 = Closure_10 { cap_0: self };
    let mut foldAddNegate: Closure_11 = Closure_11 { Opcode: &mut Opcode, True: &mut True, False: &mut False, cap_3: self, Cond: &mut Cond, I: &mut I, SI: &mut SI };
    if LHSIsSelect && RHSIsSelect && A == D {
        Cond = A;
        True = simplifyBinOp(Opcode, B, E, FMF, Q);
        False = simplifyBinOp(Opcode, C, F, FMF, Q);
        if LHS.hasOneUse() && RHS.hasOneUse() {
            if False && !True {
                True = self.Builder.CreateBinOp(Opcode, B, E, "", null);
            } else if True && !False {
                False = self.Builder.CreateBinOp(Opcode, C, F, "", null);
            }
        }
    } else if LHSIsSelect && LHS.hasOneUse() {
        Cond = A;
        let mut TrueRHS: *mut Value = simplifySelectWithImpliedCond.call(RHS, Cond, true);
        let mut FalseRHS: *mut Value = simplifySelectWithImpliedCond.call(RHS, Cond, false);
        True = simplifyBinOp(Opcode, B, TrueRHS, FMF, Q);
        False = simplifyBinOp(Opcode, C, FalseRHS, FMF, Q);
        if foldAddNegate.call(B, C, RHS) {
            NewSel;
        } else {
            return NewSel;
        }
    } else if RHSIsSelect && RHS.hasOneUse() {
        Cond = D;
        let mut TrueLHS: *mut Value = simplifySelectWithImpliedCond.call(LHS, Cond, true);
        let mut FalseLHS: *mut Value = simplifySelectWithImpliedCond.call(LHS, Cond, false);
        True = simplifyBinOp(Opcode, TrueLHS, E, FMF, Q);
        False = simplifyBinOp(Opcode, FalseLHS, F, FMF, Q);
        if foldAddNegate.call(E, F, LHS) {
            NewSel;
        } else {
            return NewSel;
        }
    }
    if !True || !False {
        return null;
    }
    let mut NewSI: *mut Value = self.Builder.CreateSelect(Cond, True, False, I.getName(), SI);
    NewSI.takeName(&mut I);
    return NewSI;
}

fn InstCombinerImpl::freelyInvertAllUsersOf(self, I: *mut Value, IgnoredUser: *mut Value) {
    assert!(!isa(I), "Shouldn't invert users of constant");
    for U in make_early_inc_range(I.users()) {
        if U == IgnoredUser {
            continue;
        }
        match cast(U).getOpcode() {
            Select => {
                let mut SI: *mut SelectInst = cast(U);
                SI.swapValues();
                SI.swapProfMetadata();
                break;
            },
            CondBr => {
                let mut BI: *mut CondBrInst = cast(U);
                BI.swapSuccessors();
                if self.BPI {
                    self.BPI.swapSuccEdgesProbabilities(BI.getParent());
                }
                break;
            },
            Xor => {
                self.replaceInstUsesWith(cast(*U), I);
            },
            _ => {
                llvm_unreachable_internal("Got unexpected user - out of sync with canFreelyInvertAllUsersOf() ?", "P:/Goraw/llvm-project/llvm/lib/Transforms/InstCombine/InstructionCombining.cpp", 1454);
            },
        }
    }
    let mut DbgVariableRecords: SmallVector<DbgVariableRecord *, 4> = SmallVector<DbgVariableRecord *, 4> {};
    findDbgValues(I, DbgVariableRecords);
    for DbgVal in DbgVariableRecords {
        let mut Ops: SmallVector<uint64_t, 1> = [DW_OP_not];
        for let mut Idx: u32 = 0;
let mut End: u32 = DbgVal.getNumVariableLocationOps(); Idx != End; Idx += 1 {
            if DbgVal.getVariableLocationOp(Idx) == I {
                DbgVal.setExpression(appendOpsToArg(DbgVal.getExpression(), Ops, Idx, false));
            }
        }
    }
}

fn InstCombinerImpl::dyn_castNegVal(self: *InstCombinerImpl, V: *mut Value) -> *mut Value {
    let mut NegV: *mut Value = null;
    if match(V, m_Neg(m_Value(NegV))) {
        return NegV;
    }
    if dyn_cast(V) {
        C;
    } else {
        return getNeg(C, false);
    }
    if dyn_cast(V) {
        C;
    } else if C.getType().getElementType().isIntegerTy() {
        return getNeg(C, false);
    }
    if dyn_cast(V) {
        CV;
    } else {
        for let mut i: u32 = 0;
let mut e: u32 = CV.getNumOperands(); i != e; i += 1 {
            let mut Elt: *mut Constant = CV.getAggregateElement(i);
            if !Elt {
                return null;
            }
            if isa(Elt) {
                continue;
            }
            if !isa(Elt) {
                return null;
            }
        }
        return getNeg(CV, false);
    }
    if dyn_cast(V) {
        CV;
    } else if CV.getType().isVectorTy() && CV.getType().getScalarType().isIntegerTy() && CV.getSplatValue(false) {
        return getNeg(CV, false);
    }
    return null;
}

fn InstCombinerImpl::foldFBinOpOfIntCastsFromSign(self, BO: *mut BinaryOperator, OpsFromSigned: bool, IntOps: array<Value *, 2>, Op1FpC: *mut Constant, OpsKnown: *SmallVectorImpl<WithCache<const Value *>>) -> *mut Instruction {
    let mut FPTy: *mut Type = BO.getType();
    let mut IntTy: *mut Type = IntOps[0].getType();
    let mut IntSz: u32 = IntTy.getScalarSizeInBits();
    let mut MaxRepresentableBits: u32 = semanticsPrecision(FPTy.getScalarType().getFltSemantics());
    let mut NumUsedLeadingBits: [2]u32 = [IntSz, IntSz];
    let mut IsNonZero: Closure_12 = Closure_12 { OpsKnown: &mut OpsKnown, cap_1: self, IntOps: &mut IntOps };
    let mut IsNonNeg: Closure_13 = Closure_13 { OpsKnown: &mut OpsKnown, cap_1: self };
    let mut IsValidPromotion: Closure_14 = Closure_14 { OpsFromSigned: &mut OpsFromSigned, BO: &mut BO, IsNonNeg: &mut IsNonNeg, MaxRepresentableBits: &mut MaxRepresentableBits, IntSz: &mut IntSz, NumUsedLeadingBits: &mut NumUsedLeadingBits, cap_6: self, IntOps: &mut IntOps, OpsKnown: &mut OpsKnown, IsNonZero: &mut IsNonZero };
    if Op1FpC != null {
        if OpsFromSigned && BO.getOpcode() == FMul && !match(Op1FpC, m_NonZeroFP()) {
            return null;
        }
        let mut Op1IntC: *mut Constant = ConstantFoldCastOperand(if OpsFromSigned { FPToSI } else { FPToUI }, Op1FpC, IntTy, self.DL);
        if Op1IntC == null {
            return null;
        }
        if ConstantFoldCastOperand(if OpsFromSigned { SIToFP } else { UIToFP }, Op1IntC, FPTy, self.DL) != Op1FpC {
            return null;
        }
        IntOps[1] = Op1IntC;
    }
    if IntTy != IntOps[1].getType() {
        return null;
    }
    if Op1FpC == null {
        if !IsValidPromotion.call(1) {
            return null;
        }
    }
    if !IsValidPromotion.call(0) {
        return null;
    }
    let mut IntOpc: BinaryOps = zeroed();
    let mut NeedsOverflowCheck: bool = true;
    let mut OverflowMaxOutputBits: u32 = if OpsFromSigned { 2 } else { 1 };
    let mut OverflowMaxCurBits: u32 = if NumUsedLeadingBits[0] > NumUsedLeadingBits[1] { NumUsedLeadingBits[0] } else { NumUsedLeadingBits[1] };
    let mut OutputSigned: bool = OpsFromSigned;
    match BO.getOpcode() {
        FAdd => {
            IntOpc = Add;
        },
        FSub => {
            IntOpc = Sub;
        },
        FMul => {
            IntOpc = Mul;
        },
        _ => {
            llvm_unreachable_internal("Unsupported binop", "P:/Goraw/llvm-project/llvm/lib/Transforms/InstCombine/InstructionCombining.cpp", 1645);
        },
    }
    if OverflowMaxOutputBits < IntSz {
        NeedsOverflowCheck = false;
        if IntOpc == Sub {
            OutputSigned = true;
        }
    }
    if NeedsOverflowCheck && !self.willNotOverflow(IntOpc, IntOps[0], IntOps[1], BO, OutputSigned) {
        return null;
    }
    let mut IntBinOp: *mut Value = self.Builder.CreateBinOp(IntOpc, IntOps[0], IntOps[1], "", null);
    if dyn_cast(IntBinOp) {
        IntBO;
    } else {
        IntBO.setHasNoSignedWrap(OutputSigned);
        IntBO.setHasNoUnsignedWrap(!OutputSigned);
    }
    if OutputSigned {
        return SIToFPInst { IntBinOp, FPTy, "", null };
    }
    return UIToFPInst { IntBinOp, FPTy, "", null };
}

fn InstCombinerImpl::foldFBinOpOfIntCasts(self, BO: *mut BinaryOperator) -> *mut Instruction {
    if BO.getType().isVectorTy() {
        return null;
    }
    let mut IntOps: array<Value *, 2> = array<Value *, 2> { [null, null] };
    let mut Op1FpC: *mut Constant = null;
    if !match(BO.getOperand(0), m_IToFP(m_Value(IntOps[0]))) {
        return null;
    }
    if !match(BO.getOperand(1), m_Constant(Op1FpC)) && !match(BO.getOperand(1), m_IToFP(m_Value(IntOps[1]))) {
        return null;
    }
    let mut OpsKnown: SmallVector<WithCache<const Value *>, 2> = [IntOps[0], IntOps[1]];
    if self.foldFBinOpOfIntCastsFromSign(BO, false, IntOps, Op1FpC, OpsKnown) {
        R;
    } else {
        return R;
    }
    return self.foldFBinOpOfIntCastsFromSign(BO, true, IntOps, Op1FpC, OpsKnown);
}

fn InstCombinerImpl::foldBinopOfSextBoolToSelect(self, BO: *mut BinaryOperator) -> *mut Instruction {
    let mut BO0: *mut Value = BO.getOperand(0);
    let mut BO1: *mut Value = BO.getOperand(1);
    let mut X: *mut Value = null;
    let mut C: *mut Constant = null;
    if !match(BO0, m_SExt(m_Value(X))) || !match(BO1, m_ImmConstant(C)) || !X.getType().isIntOrIntVectorTy(1) {
        return null;
    }
    let mut Ones: *mut Constant = getAllOnesValue(BO.getType());
    let mut Zero: *mut Constant = getNullValue(BO.getType());
    let mut TVal: *mut Value = self.Builder.CreateBinOp(BO.getOpcode(), Ones, C, "", null);
    let mut FVal: *mut Value = self.Builder.CreateBinOp(BO.getOpcode(), Zero, C, "", null);
    return self.createSelectInstWithUnknownProfile(X, TVal, FVal, "", null);
}

fn simplifyOperationIntoSelectOperand(I: *mut Instruction, SI: *mut SelectInst, IsTrueArm: bool) -> *mut Value {
    let mut Ops: SmallVector<Value *> = SmallVector<Value *> {};
    for Op in I.operands() {
        let mut V: *mut Value = null;
        if Op == SI {
            V = if IsTrueArm { SI.getTrueValue() } else { SI.getFalseValue() };
        } else if match(SI.getCondition(), m_SpecificICmp(CmpPredicate { Pred: if IsTrueArm { ICMP_EQ } else { ICMP_NE }, HasSameSign: false }, m_Specific(Op), m_Value(V))) && isGuaranteedNotToBeUndefOrPoison(V, null, null, null, 0) {} else if match(Op, m_ZExt(m_Specific(SI.getCondition()))) {
            V = if IsTrueArm { get(Op.getType(), 1, false, false) } else { getNullValue(Op.getType()) };
        } else {
            V = Op;
        }
        Ops.push(V);
    }
    return simplifyInstructionWithOperands(&mut I, Ops, SimplifyQuery { I.getDataLayout(), null });
}

fn foldOperationIntoSelectOperand(I: *mut Instruction, SI: *mut SelectInst, NewOp: *mut Value, IC: *mut InstCombiner) -> *mut Value {
    let mut Clone: *mut Instruction = I.clone();
    Clone.replaceUsesOfWith(SI, NewOp);
    Clone.dropUBImplyingAttrsAndMetadata(ArrayRef<unsigned int> {});
    IC.InsertNewInstBefore(Clone, I.getIterator());
    return Clone;
}

fn InstCombinerImpl::FoldOpIntoSelect(self, Op: *mut Instruction, SI: *mut SelectInst, FoldWithMultiUse: bool, SimplifyBothArms: bool) -> *mut Instruction {
    if !SI.hasOneUser() && !FoldWithMultiUse {
        return null;
    }
    let mut TV: *mut Value = SI.getTrueValue();
    let mut FV: *mut Value = SI.getFalseValue();
    if SI.getType().isIntOrIntVectorTy(1) {
        return null;
    }
    if isa(&mut Op) {
        for IntrinOp in Op.operands() {
            if dyn_cast(IntrinOp) {
                PN;
            } else {
                for PhiOp in PN.operands() {
                    if PhiOp == &mut Op {
                        return null;
                    }
                }
            }
        }
    }
    if dyn_cast(SI.getCondition()) {
        CI;
    } else {
        if CI.hasOneUse() {
            let mut Op0: *mut Value = CI.getOperand(0);
            let mut Op1: *mut Value = CI.getOperand(1);
            if ((TV == Op0 && FV == Op1) || (FV == Op0 && TV == Op1)) && !CI.isCommutative() {
                return null;
            }
        }
    }
    let mut NewTV: *mut Value = simplifyOperationIntoSelectOperand(Op, SI, true);
    let mut NewFV: *mut Value = simplifyOperationIntoSelectOperand(Op, SI, false);
    if !NewTV && !NewFV {
        return null;
    }
    if SimplifyBothArms && !(NewTV && NewFV) {
        return null;
    }
    if !NewTV {
        NewTV = foldOperationIntoSelectOperand(Op, SI, TV, *self);
    }
    if !NewFV {
        NewFV = foldOperationIntoSelectOperand(Op, SI, FV, *self);
    }
    let mut NewSel: *mut SelectInst = Create(SI.getCondition(), NewTV, NewFV, "", null, null);
    NewSel.copyMetadata(*SI, [MD_prof, MD_unpredictable, MD_dbg]);
    return NewSel;
}

fn simplifyInstructionWithPHI(I: *mut Instruction, PN: *mut PHINode, InValue: *mut Value, InBB: *mut BasicBlock, DL: *DataLayout, SQ: SimplifyQuery) -> *mut Value {
    let mut Ops: SmallVector<Value *> = SmallVector<Value *> {};
    for Op in I.operands() {
        if Op == PN {
            Ops.push(InValue);
        } else {
            Ops.push(Op.DoPHITranslation(PN.getParent(), InBB));
        }
    }
    let mut NewVal: *mut Value = simplifyInstructionWithOperands(&mut I, Ops, SQ.getWithInstruction(InBB.getTerminator()));
    if NewVal && NewVal != PN && !match(NewVal, m_ConstantExpr()) {
        return NewVal;
    }
    let mut TerminatorBI: *mut CondBrInst = dyn_cast(InBB.getTerminator());
    let mut ICmp: *ICmpInst = dyn_cast(&mut I);
    if TerminatorBI && TerminatorBI.getSuccessor(0) != TerminatorBI.getSuccessor(1) && ICmp {
        let mut LHSIsTrue: bool = TerminatorBI.getSuccessor(0) == PN.getParent();
        let mut ImpliedCond: optional<bool> = isImpliedCondition(TerminatorBI.getCondition(), ICmp.getCmpPredicate(), Ops[0], Ops[1], DL, LHSIsTrue, 0);
        if ImpliedCond {
            return getBool(I.getType(), ImpliedCond.value());
        }
    }
    return null;
}

fn InstCombinerImpl::foldBinOpSelectBinOp(self, Op: *mut BinaryOperator) -> *mut Instruction {
    assert!(Op.isAssociative(), "The operation must be associative!");
    let mut SI: *mut SelectInst = dyn_cast(Op.getOperand(0));
    let mut Const: *mut Constant = null;
    if !SI || !match(Op.getOperand(1), m_ImmConstant(Const)) || !Op.hasOneUse() || !SI.hasOneUse() {
        return null;
    }
    let mut TV: *mut Value = SI.getTrueValue();
    let mut FV: *mut Value = SI.getFalseValue();
    let mut Input: *mut Value = null;
    let mut NewTV: *mut Value = null;
    let mut NewFV: *mut Value = null;
    let mut Const2: *mut Constant = null;
    if TV.hasOneUse() && match(TV, m_BinOp(Op.getOpcode(), m_Specific(FV), m_ImmConstant(Const2))) {
        NewTV = ConstantFoldBinaryInstruction(Op.getOpcode(), Const, Const2);
        NewFV = Const;
        Input = FV;
    } else if FV.hasOneUse() && match(FV, m_BinOp(Op.getOpcode(), m_Specific(TV), m_ImmConstant(Const2))) {
        NewTV = Const;
        NewFV = ConstantFoldBinaryInstruction(Op.getOpcode(), Const, Const2);
        Input = TV;
    } else {
        return null;
    }
    if !NewTV || !NewFV {
        return null;
    }
    let mut NewSI: *mut Value = self.Builder.CreateSelect(SI.getCondition(), NewTV, NewFV, "", SI);
    return Create(Op.getOpcode(), NewSI, Input, "", null);
}

fn InstCombinerImpl::foldOpIntoPhi(self, I: *mut Instruction, PN: *mut PHINode, AllowMultipleUses: bool) -> *mut Instruction {
    let mut NumPHIValues: u32 = PN.getNumIncomingValues();
    if NumPHIValues == 0 {
        return null;
    }
    let mut OneUse: bool = PN.hasOneUse();
    let mut IdenticalUsers: bool = false;
    if !AllowMultipleUses && !OneUse {
        for U in PN.users() {
            let mut UI: *mut Instruction = cast(U);
            if UI != &mut I && !I.isIdenticalTo(UI) {
                return null;
            }
        }
        IdenticalUsers = true;
    }
    for Op in I.operands() {
        if Op == PN {
            continue;
        }
        let mut I: *mut Instruction = dyn_cast(Op);
        if !I {
            continue;
        }
        if isa(I) {
            if I.getParent() == PN.getParent() {
                continue;
            }
        }
        if self.DT.dominates(I, PN.getParent()) {
            continue;
        }
        return null;
    }
    let mut NewPhiValues: SmallVector<Value *> = SmallVector<Value *> {};
    let mut OpsToMoveUseToIncomingBB: SmallVector<unsigned int> = SmallVector<unsigned int> {};
    let mut SeenNonSimplifiedInVal: bool = false;
    for let mut i: u32 = 0; i != NumPHIValues; i += 1 {
        let mut InVal: *mut Value = PN.getIncomingValue(i);
        let mut InBB: *mut BasicBlock = PN.getIncomingBlock(i);
        if simplifyInstructionWithPHI(I, PN, InVal, InBB, self.DL, self.SQ) {
            NewVal;
        } else {
            NewPhiValues.push(NewVal);
            continue;
        }
        let mut WillFold: Closure_15 = Closure_15 { InVal: &mut InVal, I: &mut I, PN: &mut PN };
        if WillFold.call() {
            OpsToMoveUseToIncomingBB.push(i);
            NewPhiValues.push(null);
            continue;
        }
        if !OneUse && !IdenticalUsers {
            return null;
        }
        if SeenNonSimplifiedInVal {
            return null;
        }
        SeenNonSimplifiedInVal = true;
        let mut BI: *mut UncondBrInst = dyn_cast(InBB.getTerminator());
        if !BI || !self.DT.isReachableFromEntry(InBB) {
            return null;
        }
        NewPhiValues.push(null);
        OpsToMoveUseToIncomingBB.push(i);
        if self.isBackEdge(InBB, PN.getParent()) {
            return null;
        }
    }
    let mut Clones: SmallDenseMap<BasicBlock *, Instruction *> = SmallDenseMap<BasicBlock *, Instruction *> {};
    for OpIndex in OpsToMoveUseToIncomingBB {
        let mut Op: *mut Value = PN.getIncomingValue(OpIndex);
        let mut OpBB: *mut BasicBlock = PN.getIncomingBlock(OpIndex);
        let mut Clone: *mut Instruction = Clones.lookup(OpBB);
        if !Clone {
            Clone = I.clone();
            for U in Clone.operands() {
                if U.operator llvm::Value *() == PN {
                    U = Op;
                } else {
                    U = operator(U).DoPHITranslation(PN.getParent(), OpBB);
                }
            }
            Clone = self.InsertNewInstBefore(Clone, OpBB.getTerminator().getIterator());
            Clones.insert(Instruction *> { OpBB, Clone });
            Clone.dropUBImplyingAttrsAndMetadata(ArrayRef<unsigned int> {});
        }
        NewPhiValues[OpIndex] = Clone;
    }
    let mut NewPN: *mut PHINode = Create(I.getType(), PN.getNumIncomingValues(), "", null);
    self.InsertNewInstBefore(NewPN, PN.getIterator());
    NewPN.takeName(PN);
    NewPN.setDebugLoc(PN.getDebugLoc());
    for let mut i: u32 = 0; i != NumPHIValues; i += 1 {
        NewPN.addIncoming(NewPhiValues[i], PN.getIncomingBlock(i));
    }
    if IdenticalUsers {
        let mut ToReplace: SmallSetVector<Instruction *, 4> = SmallSetVector<Instruction *, 4> {};
        for U in PN.users() {
            let mut User: *mut Instruction = cast(U);
            if User == &mut I {
                continue;
            }
            ToReplace.insert(User);
        }
        for I in ToReplace {
            self.replaceInstUsesWith(*I, NewPN);
            self.eraseInstFromFunction(*I);
        }
        OneUse = true;
    }
    if OneUse {
        replaceAllDbgUsesWith(*PN, *NewPN, *PN, self.DT);
    }
    return self.replaceInstUsesWith(I, NewPN);
}

fn InstCombinerImpl::foldBinopWithRecurrence(self, BO: *mut BinaryOperator) -> *mut Instruction {
    if !BO.isAssociative() {
        return null;
    }
    let mut Opc: BinaryOps = BO.getOpcode();
    let mut BO0: *mut BinaryOperator = dyn_cast(BO.getOperand(0));
    let mut BO1: *mut BinaryOperator = dyn_cast(BO.getOperand(1));
    if !BO0 || !BO1 || !BO0.hasNUses(2) || !BO1.hasNUses(2) || BO0.getOpcode() != Opc || BO1.getOpcode() != Opc || !BO0.isAssociative() || !BO1.isAssociative() || BO0.getParent() != BO1.getParent() {
        return null;
    }
    assert!(BO.isCommutative() && BO0.isCommutative() && BO1.isCommutative(), "Expected commutative instructions!");
    let mut PN0: *mut PHINode = null;
    let mut PN1: *mut PHINode = null;
    let mut Start0: *mut Value = null;
    let mut Step0: *mut Value = null;
    let mut Start1: *mut Value = null;
    let mut Step1: *mut Value = null;
    if !matchSimpleRecurrence(BO0, PN0, Start0, Step0) || !PN0.hasOneUse() || !matchSimpleRecurrence(BO1, PN1, Start1, Step1) || !PN1.hasOneUse() || PN0.getParent() != PN1.getParent() {
        return null;
    }
    assert!(PN0.getNumIncomingValues() == 2 && PN1.getNumIncomingValues() == 2, "Expected PHIs with two incoming values!");
    let mut Init0: *mut Constant = dyn_cast(Start0);
    let mut Init1: *mut Constant = dyn_cast(Start1);
    let mut C0: *mut Constant = dyn_cast(Step0);
    let mut C1: *mut Constant = dyn_cast(Step1);
    if !Init0 || !Init1 || !C0 || !C1 {
        return null;
    }
    let mut Init: *mut Constant = ConstantFoldBinaryInstruction(Opc, Init0, Init1);
    let mut C: *mut Constant = ConstantFoldBinaryInstruction(Opc, C0, C1);
    if !Init || !C {
        return null;
    }
    let mut NewPN: *mut PHINode = Create(PN0.getType(), PN0.getNumIncomingValues(), "reduced.phi", null);
    let mut NewBO: *mut BinaryOperator = Create(Opc, NewPN, C, "", null);
    if Opc == FAdd || Opc == FMul {
        let mut Intersect: FastMathFlags = BO0.getFastMathFlags() & BO1.getFastMathFlags() & BO.getFastMathFlags();
        NewBO.setFastMathFlags(Intersect);
    } else {
        let mut Flags: OverflowTracking = OverflowTracking {};
        Flags.AllKnownNonNegative = false;
        Flags.AllKnownNonZero = false;
        Flags.mergeFlags(*BO0);
        Flags.mergeFlags(*BO1);
        Flags.mergeFlags(BO);
        Flags.applyFlags(*NewBO);
    }
    NewBO.takeName(&mut BO);
    for let mut I: u32 = 0;
let mut E: u32 = PN0.getNumIncomingValues(); I != E; I += 1 {
        let mut V: *mut Value = PN0.getIncomingValue(I);
        let mut BB: *mut BasicBlock = PN0.getIncomingBlock(I);
        if V == Init0 {
            assert!(((PN1.getIncomingValue(0) == Init1 && PN1.getIncomingBlock(0) == BB) || (PN1.getIncomingValue(1) == Init1 && PN1.getIncomingBlock(1) == BB)), "Invalid incoming block!");
            NewPN.addIncoming(Init, BB);
        } else if V == BO0 {
            assert!(((PN1.getIncomingValue(0) == BO1 && PN1.getIncomingBlock(0) == BB) || (PN1.getIncomingValue(1) == BO1 && PN1.getIncomingBlock(1) == BB)), "Invalid incoming block!");
            NewPN.addIncoming(NewBO, BB);
        } else {
            llvm_unreachable_internal("Unexpected incoming value!", "P:/Goraw/llvm-project/llvm/lib/Transforms/InstCombine/InstructionCombining.cpp", 2167);
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("instcombine", 1) {
            dbgs() << "  Combined " << *PN0 << "\n           " << *BO0 << "\n      with " << *PN1 << "\n           " << *BO1 << 10;
        }
    }
        if !(false) { break; }
    }
    self.InsertNewInstWith(NewPN, PN0.getIterator());
    self.InsertNewInstWith(NewBO, BO0.getIterator());
    self.eraseInstFromFunction(*self.replaceInstUsesWith(*BO0, get(BO0.getType())));
    self.eraseInstFromFunction(*self.replaceInstUsesWith(*BO1, get(BO1.getType())));
    self.eraseInstFromFunction(*PN0);
    self.eraseInstFromFunction(*PN1);
    return self.replaceInstUsesWith(BO, NewBO);
}

fn InstCombinerImpl::foldBinopWithPhiOperands(self, BO: *mut BinaryOperator) -> *mut Instruction {
    if self.foldBinopWithRecurrence(BO) {
        NewBO;
    } else {
        return NewBO;
    }
    let mut Phi0: *mut PHINode = dyn_cast(BO.getOperand(0));
    let mut Phi1: *mut PHINode = dyn_cast(BO.getOperand(1));
    if !Phi0 || !Phi1 || !Phi0.hasOneUse() || !Phi1.hasOneUse() || Phi0.getNumOperands() != Phi1.getNumOperands() {
        return null;
    }
    if BO.getParent() != Phi0.getParent() || BO.getParent() != Phi1.getParent() {
        return null;
    }
    let mut C: *mut Constant = getBinOpIdentity(BO.getOpcode(), BO.getType(), false, false);
    if C {
        let mut NewIncomingValues: SmallVector<Value *, 4> = SmallVector<Value *, 4> {};
        let mut CanFoldIncomingValuePair: Closure_16 = Closure_16 { Phi0: &mut Phi0, Phi1: &mut Phi1, C: &mut C, NewIncomingValues: &mut NewIncomingValues };
        if all_of(zip(Phi0.operands(), Phi1.operands()), CanFoldIncomingValuePair) {
            let mut NewPhi: *mut PHINode = Create(Phi0.getType(), Phi0.getNumOperands(), "", null);
            assert!(NewIncomingValues.len == Phi0.getNumOperands(), "The number of collected incoming values should equal the number of the original PHINode operands!");
            for let mut I: u32 = 0; I < Phi0.getNumOperands(); I += 1 {
                NewPhi.addIncoming(NewIncomingValues[I], Phi0.getIncomingBlock(I));
            }
            return NewPhi;
        }
    }
    if Phi0.getNumOperands() != 2 || Phi1.getNumOperands() != 2 {
        return null;
    }
    let mut ConstBB: *mut BasicBlock = null;
    let mut OtherBB: *mut BasicBlock = null;
    let mut C0: *mut Constant = null;
    let mut C1: *mut Constant = null;
    if match(Phi0.getIncomingValue(0), m_ImmConstant(C0)) {
        ConstBB = Phi0.getIncomingBlock(0);
        OtherBB = Phi0.getIncomingBlock(1);
    } else if match(Phi0.getIncomingValue(1), m_ImmConstant(C0)) {
        ConstBB = Phi0.getIncomingBlock(1);
        OtherBB = Phi0.getIncomingBlock(0);
    } else {
        return null;
    }
    if !match(Phi1.getIncomingValueForBlock(ConstBB), m_ImmConstant(C1)) {
        return null;
    }
    let mut PredBlockBranch: *mut UncondBrInst = dyn_cast(OtherBB.getTerminator());
    if !PredBlockBranch || !self.DT.isReachableFromEntry(OtherBB) {
        return null;
    }
    for let mut BBIter: iterator = BO.getParent().begin(); &mut operator(BBIter) != &mut BO; operator(BBIter) {
        if !isGuaranteedToTransferExecutionToSuccessor(&mut operator(BBIter)) {
            return null;
        }
    }
    let mut NewC: *mut Constant = ConstantFoldBinaryOpOperands(BO.getOpcode(), C0, C1, self.DL);
    if !NewC {
        return null;
    }
    self.Builder.SetInsertPoint(PredBlockBranch);
    let mut NewBO: *mut Value = self.Builder.CreateBinOp(BO.getOpcode(), Phi0.getIncomingValueForBlock(OtherBB), Phi1.getIncomingValueForBlock(OtherBB), "", null);
    if dyn_cast(NewBO) {
        NotFoldedNewBO;
    } else {
        NotFoldedNewBO.copyIRFlags(&mut BO, true);
    }
    let mut NewPhi: *mut PHINode = Create(BO.getType(), 2, "", null);
    NewPhi.addIncoming(NewBO, OtherBB);
    NewPhi.addIncoming(NewC, ConstBB);
    return NewPhi;
}

fn InstCombinerImpl::foldBinOpIntoSelectOrPhi(self, I: *mut BinaryOperator) -> *mut Instruction {
    let mut TryFoldOperand: Closure_17 = Closure_17 { I: &mut I, cap_1: self };
    if TryFoldOperand.call(0, isa(I.getOperand(1))) {
        NewI;
    } else {
        return NewI;
    }
    return TryFoldOperand.call(1, isa(I.getOperand(0)));
}

fn shouldMergeGEPs(GEP: *mut GEPOperator, Src: *mut GEPOperator) -> bool {
    if GEP.hasAllZeroIndices() && !Src.hasAllZeroIndices() && !Src.hasOneUse() {
        return false;
    }
    return true;
}

fn InstCombinerImpl::unshuffleConstant(self, ShMask: ArrayRef<int>, C: *mut Constant, NewCTy: *mut VectorType) -> *mut Constant {
    if isa(NewCTy) {
        let mut Splat: *mut Constant = C.getSplatValue(false);
        if !Splat {
            return null;
        }
        return getSplat(NewCTy.getElementCount(), Splat);
    }
    if cast(NewCTy).getNumElements() > cast(C.getType()).getNumElements() {
        return null;
    }
    let mut NewCNumElts: u32 = cast(NewCTy).getNumElements();
    let mut PoisonScalar: *mut PoisonValue = get(C.getType().getScalarType());
    let mut NewVecC: SmallVector<Constant *, 16> = SmallVector<Constant *, 16> { NewCNumElts, PoisonScalar };
    let mut NumElts: u32 = cast(C.getType()).getNumElements();
    for let mut I: u32 = 0; I < NumElts; I += 1 {
        let mut CElt: *mut Constant = C.getAggregateElement(I);
        if ShMask[I] >= 0 {
            let mut MaskElt: i32 = ShMask[I];
            if MaskElt >= NewCNumElts as i32 {
                continue;
            }
            let mut NewCElt: *mut Constant = NewVecC[MaskElt];
            if !CElt || (!isa(NewCElt) && NewCElt != CElt) || I >= NewCNumElts {
                return null;
            }
            NewVecC[MaskElt] = CElt;
        }
    }
    return get(NewVecC);
}

fn constantFoldBinOpWithSplat(Opcode: u32, Vector: *mut Constant, Splat: *mut Constant, SplatLHS: bool, DL: *DataLayout) -> *mut Constant {
    let mut EC: ElementCount = cast(Vector.getType()).getElementCount();
    let mut LHS: *mut Constant = getSplat(EC, Splat);
    let mut RHS: *mut Constant = Vector;
    if !SplatLHS {
        swap(LHS, RHS);
    }
    return ConstantFoldBinaryOpOperands(Opcode, LHS, RHS, DL);
}

