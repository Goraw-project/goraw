fn InstCombiner@llvm::~IRBuilderInstCombineInserter(self) {}

fn IRBuilderInstCombineInserter@InstCombiner@llvm::InsertHelper(self: *IRBuilderInstCombineInserter@InstCombiner@llvm, I: *mut Instruction, Name: str, InsertPt: i32) {
    self.IC.Worklist.add(I);
    if  {
        self.IC.AC.registerAssumption();
    }
    if self.IC.AnnotationMetadataSource {
        I.copyMetadata;
    }
}

fn InstCombiner::targetInstCombineIntrinsic(self, II: *mut IntrinsicInst) -> optional<Instruction *> {
    if II.getCalledFunction() {
        return self.TTIForTargetIntrinsicsOnly.instCombineIntrinsic;
    }
    return nullopt();
}

fn InstCombiner::targetSimplifyDemandedUseBitsIntrinsic(self, II: *mut IntrinsicInst, DemandedMask: APInt, Known: *mut KnownBits, KnownBitsComputed: *mut bool) -> optional<Value *> {
    if II.getCalledFunction() {
        return self.TTIForTargetIntrinsicsOnly.simplifyDemandedUseBitsIntrinsic;
    }
    return nullopt();
}

fn InstCombiner::targetSimplifyDemandedVectorEltsIntrinsic(self, II: *mut IntrinsicInst, DemandedElts: APInt, PoisonElts: *mut APInt, PoisonElts2: *mut APInt, PoisonElts3: *mut APInt, SimplifyAndSetOp: function<void (Instruction *, unsigned int, APInt, APInt &)>) -> optional<Value *> {
    if II.getCalledFunction() {
        return self.TTIForTargetIntrinsicsOnly.simplifyDemandedVectorEltsIntrinsic(*self, II, DemandedElts, PoisonElts, PoisonElts2, PoisonElts3);
    }
    return nullopt();
}

fn InstCombiner::isValidAddrSpaceCast(self: *InstCombiner, FromAS: u32, ToAS: u32) -> bool {
    return self.TTIForTargetIntrinsicsOnly.isValidAddrSpaceCast(FromAS, ToAS);
}

fn InstCombinerImpl::EmitGEPOffset(self, GEP: *mut GEPOperator, RewriteGEP: bool) -> *mut Value {
    if !RewriteGEP {
        return emitGEPOffset(GEP);
    }
    let mut Guard: InsertPointGuard = zeroed();
    let mut Inst: *mut auto = dyn_cast(GEP);
    let mut Offset: *mut Value = self.EmitGEPOffset(GEP, false);
    if Inst() && !GEP.hasAllConstantIndices() && !GEP.getSourceElementType().isIntegerTy(8) {
        self.replaceInstUsesWith;
        self.eraseInstFromFunction(operator*());
    }
    return Offset;
}

fn InstCombinerImpl::EmitGEPOffsets(self, GEPs: ArrayRef<GEPOperator *>, NW: GEPNoWrapFlags, IdxTy: *mut Type, RewriteGEPs: bool) -> *mut Value {
    let mut Add: Closure_1 = Closure_1 { cap_0: self, NW: &mut NW };
    let mut Sum: *mut Value = null;
    let mut OneUseSum: *mut Value = null;
    let mut OneUseBase: *mut Value = null;
    let mut OneUseFlags: GEPNoWrapFlags = all();
    if OneUseSum {
        Sum = Add.call(Sum, OneUseSum);
    }
    if !Sum {
        return getNullValue(IdxTy);
    }
    return Sum;
}

fn InstCombinerImpl::isDesirableIntType(self: *InstCombinerImpl, BitWidth: u32) -> bool {
    match BitWidth {
        8 => {
            16;
        },
        _ => {
            
        },
    }
}

fn InstCombinerImpl::shouldChangeType(self: *InstCombinerImpl, FromWidth: u32, ToWidth: u32) -> bool {
    let mut FromLegal: bool = false;
    let mut ToLegal: bool = false;
    if ToWidth < FromWidth && self.isDesirableIntType(ToWidth) {
        return true;
    }
    if (FromLegal || self.isDesirableIntType(FromWidth)) && !ToLegal {
        return false;
    }
    if !FromLegal && !ToLegal && ToWidth > FromWidth {
        return false;
    }
    return true;
}

fn InstCombinerImpl::shouldChangeType(self: *InstCombinerImpl, From: *mut Type, To: *mut Type) -> bool {
    if !From.isIntegerTy() || !To.isIntegerTy() {
        return false;
    }
    let mut FromWidth: u32 = From.getPrimitiveSizeInBits();
    let mut ToWidth: u32 = To.getPrimitiveSizeInBits();
    return self.shouldChangeType(FromWidth, ToWidth);
}

fn maintainNoSignedWrap(I: *mut BinaryOperator, B: *mut Value, C: *mut Value) -> bool {
    let mut OBO: *mut auto = dyn_cast(&mut I);
    if operator!() || operator!() {
        return false;
    }
    let mut BVal: *APInt = null;
    let mut CVal: *APInt = null;
    if operator!(match(B)) || operator!(match(C)) {
        return false;
    }
    let mut Overflow: bool = false;
    match I.getOpcode() {
        Add => {
            BVal.sadd_ov(*CVal, Overflow) as void;
        },
        Sub => {
            BVal.ssub_ov(*CVal, Overflow) as void;
        },
        Mul => {
            BVal.smul_ov(*CVal, Overflow) as void;
        },
        _ => {
            return false;
        },
    }
    return !Overflow;
}

fn hasNoUnsignedWrap(I: *mut BinaryOperator) -> bool {
    let mut OBO: *mut auto = dyn_cast(&mut I);
    return  && ();
}

fn hasNoSignedWrap(I: *mut BinaryOperator) -> bool {
    let mut OBO: *mut auto = dyn_cast(&mut I);
    return  && ();
}

fn simplifyAssocCastAssoc(BinOp1: *mut BinaryOperator, IC: *mut InstCombinerImpl) -> bool {
    let mut Cast: *mut auto = dyn_cast(BinOp1.getOperand(0));
    if operator!() || operator!() {
        return false;
    }
    let mut CastOpcode: auto = ();
    if CastOpcode() != ZExt {
        return false;
    }
    if !BinOp1 {
        return false;
    }
    let mut AssocOpcode: BinaryOps = BinOp1.getOpcode();
    let mut BinOp2: *mut auto = dyn_cast((0));
    if operator!() || operator!() || () != AssocOpcode {
        return false;
    }
    let mut C1: *mut Constant = null;
    let mut C2: *mut Constant = null;
    if operator!(match(BinOp1.getOperand(1))) || operator!(match((1))) {
        return false;
    }
    let mut DL: *DataLayout = IC.getDataLayout;
    let mut DestTy: *mut Type = C1.getType();
    let mut CastC2: *mut Constant = ConstantFoldCastOperand(C2, DestTy, DL);
    if !CastC2 {
        return false;
    }
    let mut FoldedC: *mut Constant = ConstantFoldBinaryOpOperands(AssocOpcode, C1, CastC2, DL);
    if !FoldedC {
        return false;
    }
    IC.replaceOperand(operator*(), 0, (0));
    IC.replaceOperand;
    BinOp1.dropPoisonGeneratingFlags;
    Cast()();
    return true;
}

fn InstCombinerImpl::simplifyIntToPtrRoundTripCast(self, Val: *mut Value) -> *mut Value {
    let mut IntToPtr: *mut auto = dyn_cast(Val);
