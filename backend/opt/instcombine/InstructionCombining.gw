fn combineInstructionsOverFunction(F: *mut Function, Worklist: *mut InstructionWorklist, AA: *mut AliasAnalysis, AC: *mut AssumptionCache, TLI: *mut TargetLibraryInfo, TTI: *mut TargetTransformInfo, DT: *mut DominatorTree, ORE: *mut OptimizationRemarkEmitter, BFI: *mut BlockFrequencyInfo, BPI: *mut BranchProbabilityInfo, PSI: *mut ProfileSummaryInfo, Opts: *InstCombineOptions) -> bool {
    let mut DL: *DataLayout = F.getDataLayout();
    let mut VerifyFixpoint: bool = Opts.VerifyFixpoint && !F.hasFnAttribute("instcombine-no-verify-fixpoint");
    let mut RPOT: i32 = &mut F.front();
    let mut CLOpts: i32 = 0;
    let mut MadeIRChange: bool = false;
    if CLOpts() {
        MadeIRChange = LowerDbgDeclare(F);
    }
    let mut Iteration: u32 = 0;
    while true {
        if Iteration >= Opts.MaxIterations && !VerifyFixpoint {
            while true {
                {
                if DebugFlag && isCurrentDebugType("instcombine", 1) {
                    dbgs() << "\n\n[IC] Iteration limit #" << Opts.MaxIterations << " on " << F.getName << " reached; stopping without verifying fixpoint\n";
                }
            }
                if !(false) { break; }
            }
            break;
        }
        Iteration += 1;
        operator(NumWorklistIterations);
        while true {
            {
            if DebugFlag && isCurrentDebugType("instcombine", 1) {
                dbgs() << "\n\nINSTCOMBINE ITERATION #" << Iteration << " on " << F.getName << "\n";
            }
        }
            if !(false) { break; }
        }
        let mut IC: InstCombinerImpl = Worklist;
        let mut MadeChangeInThisIteration: bool = IC.prepareWorklist(F);
        MadeChangeInThisIteration |= IC.run();
        if !MadeChangeInThisIteration {
            break;
        }
        MadeIRChange = true;
        if Iteration > Opts.MaxIterations {
            reportFatalUsageError("Instruction Combining on " + F.getName + " did not reach a fixpoint after " + Opts.MaxIterations + " iterations. " + "Use 'instcombine<no-verify-fixpoint>' or function attribute 'instcombine-no-verify-fixpoint' to suppress this error.");
        }
    }
    if Iteration == 1 {
        operator(NumOneIteration);
    } else if Iteration == 2 {
        operator(NumTwoIterations);
    } else if Iteration == 3 {
        operator(NumThreeIterations);
    } else {
        operator(NumFourOrMoreIterations);
    }
    return MadeIRChange;
}

