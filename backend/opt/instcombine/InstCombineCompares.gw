fn InstCombinerImpl::foldICmpXorConstant(self, Cmp: *mut ICmpInst, Xor: *mut BinaryOperator, C: *APInt) -> *mut Instruction {
    if self.foldICmpXorShiftConst(Cmp, Xor, C) {
