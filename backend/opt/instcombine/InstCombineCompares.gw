        if match(Op0, m_OneUse(m_Add(m_c_Add(m_Specific(Op1), m_Value(X)), m_ImmConstant(C)))) && (Pred == ICMP_ULT || Pred == ICMP_UGE) {
            let mut C2: *mut Constant = getNot(C);
