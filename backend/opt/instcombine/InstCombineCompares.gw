        let mut IntPred: Predicate = BAD_ICMP_PREDICATE;
        if Pred == FCMP_OEQ {
            IntPred = ICMP_EQ;
        } else if Pred == FCMP_UNE {
            IntPred = ICMP_NE;
        }
        if IntPred != BAD_ICMP_PREDICATE {
            let mut IntTy: *mut Type = X.getType();
            let mut SignMask: *APInt = operator(getSignMask(IntTy.getScalarSizeInBits()));
            let mut MaskX: *mut Value = null;
            return ICmpInst { IntPred, MaskX, getNullValue(IntTy), "" };
