static mut NumSel: Statistic = Statistic { "instcombine", "NumSel", "Number of select opts" };

fn addWithOverflow(Result: *mut APInt, In1: *APInt, In2: *APInt, IsSigned: bool) -> bool {
    let mut Overflow: bool = false;
    if IsSigned {
        Result = In1.sadd_ov(In2, Overflow);
    } else {
        Result = In1.uadd_ov(In2, Overflow);
    }
    return Overflow;
}

fn subWithOverflow(Result: *mut APInt, In1: *APInt, In2: *APInt, IsSigned: bool) -> bool {
    let mut Overflow: bool = false;
    if IsSigned {
        Result = In1.ssub_ov(In2, Overflow);
    } else {
        Result = In1.usub_ov(In2, Overflow);
    }
    return Overflow;
}

fn hasBranchUse(I: *mut ICmpInst) -> bool {
    return false;
}

fn isSignTest(Pred: *mut Predicate, C: *APInt) -> bool {
    if !isSigned(Pred) {
        return false;
    }
    if C.isZero() {
        return isRelational(Pred);
    }
    if C.isOne() {
        if Pred == ICMP_SLT {
            Pred = ICMP_SLE;
            return true;
        }
    } else if C.isAllOnes() {
        if Pred == ICMP_SGT {
            Pred = ICMP_SGE;
            return true;
        }
    }
    return false;
}

fn InstCombinerImpl::foldCmpLoadFromIndexedGlobal(self, LI: *mut LoadInst, GEP: *mut GetElementPtrInst, ICI: *mut CmpInst, AndCst: *mut ConstantInt) -> *mut Instruction {
    let mut GV: *mut auto = dyn_cast(getUnderlyingObject(GEP));
    if LI.isVolatile() || operator!() || operator!() || operator!() {
        return null;
    }
    let mut EltTy: *mut Type = LI.getType;
    let mut EltSize: TypeSize = zeroed();
    if EltSize()() {
        return null;
    }
    let mut Expr: LinearExpression = decomposeLinearExpression(GEP);
    if !Expr.Index || Expr.BasePtr !=  || Expr.Offset.getBitWidth() > 64 {
        return null;
    }
    let mut Init: *mut Constant = ();
    let mut GlobalSize: TypeSize = zeroed();
    let mut Idx: *mut Value = Expr.Index;
    let mut Stride: *APInt = Expr.Scale;
    let mut ConstOffset: *APInt = Expr.Offset;
    if !ConstOffset.ult(Stride) {
        return null;
    }
    if operator!(Stride(EltSize()())) {
        return null;
    }
    let mut ArrayElementCount: u64 = divideCeil((GlobalSize()() - ConstOffset.getZExtValue()), Stride.getZExtValue());
    if  {
        return null;
    }
    let mut FirstTrueElement: i32 = Undefined;
    let mut SecondTrueElement: i32 = Undefined;
    let mut FirstFalseElement: i32 = Undefined;
    let mut SecondFalseElement: i32 = Undefined;
    let mut TrueRangeEnd: i32 = Undefined;
    let mut FalseRangeEnd: i32 = Undefined;
    let mut MagicBitvector: u64 = 0;
    let mut CompareRHS: *mut Constant = cast(ICI.getOperand(1));
    let mut Offset: APInt = ConstOffset;
    for let mut i: u32 = 0;
let mut e: u32 = ArrayElementCount; i != e; i += 1 , operator(Offset, Stride) {
        let mut Elt: *mut Constant = ConstantFoldLoadFromConst(Init, EltTy, Offset);
        if !Elt {
            return null;
        }
        if AndCst {
            Elt = ConstantFoldBinaryOpOperands(And, Elt, AndCst);
            if !Elt {
                return null;
            }
        }
        let mut C: *mut Constant = ConstantFoldCompareInstOperands(ICI.getPredicate(), Elt, CompareRHS);
        if !C {
            return null;
        }
        if isa(C) {
            if TrueRangeEnd == i as i32 - 1 {
                TrueRangeEnd = i;
            }
            if FalseRangeEnd == i as i32 - 1 {
                FalseRangeEnd = i;
            }
            continue;
        }
        if !isa(C) {
            return null;
        }
        let mut IsTrueForElt: bool = operator!(cast(C)());
        if IsTrueForElt {
            if FirstTrueElement == Undefined {
                FirstTrueElement = TrueRangeEnd = i;
            } else {
                if SecondTrueElement == Undefined {
                    SecondTrueElement = i;
                } else {
                    SecondTrueElement = Overdefined;
                }
                if TrueRangeEnd == i as i32 - 1 {
                    TrueRangeEnd = i;
                } else {
                    TrueRangeEnd = Overdefined;
                }
            }
        } else {
            if FirstFalseElement == Undefined {
                FirstFalseElement = FalseRangeEnd = i;
            } else {
                if SecondFalseElement == Undefined {
                    SecondFalseElement = i;
                } else {
                    SecondFalseElement = Overdefined;
                }
                if FalseRangeEnd == i as i32 - 1 {
                    FalseRangeEnd = i;
                } else {
                    FalseRangeEnd = Overdefined;
                }
            }
        }
        if i < 64 && IsTrueForElt {
            MagicBitvector |= 1 << i;
        }
        if (i & 8) == 0 && i >= 64 && SecondTrueElement == Overdefined && SecondFalseElement == Overdefined && TrueRangeEnd == Overdefined && FalseRangeEnd == Overdefined {
            return null;
        }
    }
    let mut MaskIdx: Closure_1 = Closure_1 { Expr: &mut Expr, Stride: &mut Stride, cap_2: self };
    if SecondTrueElement != Overdefined {
        Idx = MaskIdx.call(Idx);
        if FirstTrueElement == Undefined {
            return self.replaceInstUsesWith;
        }
        let mut FirstTrueIdx: *mut Value = get(Idx.getType(), FirstTrueElement, false, false);
        if SecondTrueElement == Undefined {
            return ICmpInst { ICMP_EQ, Idx, FirstTrueIdx, "" };
        }
        let mut C1: *mut Value = null;
        let mut SecondTrueIdx: *mut Value = get(Idx.getType(), SecondTrueElement, false, false);
        let mut C2: *mut Value = null;
        return CreateOr(C1, C2, "");
    }
    if SecondFalseElement != Overdefined {
        Idx = MaskIdx.call(Idx);
        if FirstFalseElement == Undefined {
            return self.replaceInstUsesWith;
        }
        let mut FirstFalseIdx: *mut Value = get(Idx.getType(), FirstFalseElement, false, false);
        if SecondFalseElement == Undefined {
            return ICmpInst { ICMP_NE, Idx, FirstFalseIdx, "" };
        }
        let mut C1: *mut Value = null;
        let mut SecondFalseIdx: *mut Value = get(Idx.getType(), SecondFalseElement, false, false);
        let mut C2: *mut Value = null;
        return CreateAnd(C1, C2, "");
    }
    if TrueRangeEnd != Overdefined {
        assert!(TrueRangeEnd != FirstTrueElement, "Should emit single compare");
        Idx = MaskIdx.call(Idx);
        if FirstTrueElement {
            let mut Offs: *mut Value = getSigned(Idx.getType(), -FirstTrueElement, false);
        }
        let mut End: *mut Value = get(Idx.getType(), TrueRangeEnd - FirstTrueElement + 1, false, false);
        return ICmpInst { ICMP_ULT, Idx, End, "" };
    }
    if FalseRangeEnd != Overdefined {
        assert!(FalseRangeEnd != FirstFalseElement, "Should emit single compare");
        Idx = MaskIdx.call(Idx);
        if FirstFalseElement {
            let mut Offs: *mut Value = getSigned(Idx.getType(), -FirstFalseElement, false);
        }
        let mut End: *mut Value = get(Idx.getType(), FalseRangeEnd - FirstFalseElement, false, false);
        return ICmpInst { ICMP_UGT, Idx, End, "" };
    }
    {
        let mut Ty: *mut Type = null;
        if ArrayElementCount <= Idx.getType().getIntegerBitWidth() {
            Ty = Idx.getType();
        } else {
            
        }
        if Ty {
            Idx = MaskIdx.call(Idx);
            let mut V: *mut Value = null;
            return ICmpInst { ICMP_NE, V, get(Ty, 0, false, false), "" };
        }
    }
    return null;
}

fn canRewriteGEPAsOffset(Start: *mut Value, Base: *mut Value, NW: *mut GEPNoWrapFlags, DL: *DataLayout, Explored: *mut i32) -> bool {
    let mut WorkList: SmallVector<Value *, 16> = zeroed();
    Explored()(Base);
    while operator!() {
        let mut PHIs: i32 = 0;
        while operator!() {
            if Explored()() >= 100 {
                return false;
            }
            let mut V: *mut Value = ();
            if Explored()(V) {
                WorkList()();
                continue;
            }
            if !isa(V) && !isa(V) {
                return false;
            }
            if  {
                let mut IsNonConst: Closure_2 = Closure_2 {};
                if operator!() || count_if(IsNonConst) > 1 {
                    return false;
                }
                NW = NW.intersectForOffsetAdd();
                if operator!(((0))) {
                    WorkList()((0));
                }
            }
            if WorkList()() == V {
                WorkList()();
                Explored()(V);
            }
            if  {
                if isa(()()) {
                    return false;
                }
                Explored()();
                PHIs()();
            }
        }
    }
    return true;
}

fn setInsertionPoint(Builder: *mut i32, V: *mut Value, Before: bool) {
    if  {
        let mut Parent: *mut BasicBlock = ();
        Builder()(Parent()());
        return;
    }
    if  {
        if !Before {
            I() = operator&(operator*(next()));
        }
        Builder()();
        return;
    }
    if  {
        let mut Entry: *mut BasicBlock = ()();
        Builder()(Entry()());
        return;
    }
    assert!(isa(V), "Setting insertion point for unknown value!");
}

fn rewriteGEPAsOffset(Start: *mut Value, Base: *mut Value, NW: GEPNoWrapFlags, DL: *DataLayout, Explored: *mut i32, IC: *mut InstCombiner) -> *mut Value {
    let mut IndexType: *mut Type = get(Base.getContext(), DL.getIndexTypeSizeInBits(Start.getType()));
    let mut NewInsts: i32 = 0;
    NewInsts()[Base] = getNullValue(IndexType);
    let mut Builder: i32 = Base.getContext();
    return [Start];
}

fn transformToIndexedCompare(GEPLHS: *mut GEPOperator, RHS: *mut Value, Cond: CmpPredicate, DL: *DataLayout, IC: *mut InstCombiner) -> *mut Instruction {
    if GEPLHS()()() {
        return null;
    }
    if !GEPLHS.hasAllConstantIndices() {
        return null;
    }
    let mut Offset: APInt = DL.getIndexTypeSizeInBits(GEPLHS()());
    let mut PtrBase: *mut Value = GEPLHS()(DL, Offset, false);
    if PtrBase.getType() != GEPLHS()() {
        return null;
    }
    let mut Nodes: i32 = 0;
    let mut NW: GEPNoWrapFlags = GEPLHS.getNoWrapFlags();
    if  {
        return null;
    }
    let mut NewRHS: *mut Value = null;
    return getSignedPredicate(Cond.operator llvm::CmpInst::Predicate());
}

fn InstCombinerImpl::foldGEPICmp(self, GEPLHS: *mut GEPOperator, RHS: *mut Value, Cond: CmpPredicate, I: *mut Instruction) -> *mut Instruction {
    if isSigned(Cond.operator llvm::CmpInst::Predicate()) {
        return null;
    }
    if !isa(RHS) {
        RHS = RHS.stripPointerCasts();
    }
    let mut CanFold: Closure_3 = Closure_3 { cap_0: Cond };
    let mut NewICmp: Closure_4 = Closure_4 { cap_0: Cond };
    let mut Base: CommonPointerBase = compute(GEPLHS, RHS);
    if Base.Ptr == RHS && CanFold.call(Base.LHSNW) && !Base.isExpensive() {
        let mut IdxTy: *mut Type = null;
        let mut Offset: *mut Value = self.EmitGEPOffsets(Base(), Base.LHSNW, IdxTy, true);
        return NewICmp.call(Base.LHSNW, Offset, getNullValue(Offset.getType()));
    }
    if GEPLHS.isInBounds() && isEquality(Cond.operator llvm::CmpInst::Predicate()) && isa(RHS) && !NullPointerIsDefined(I.getFunction(), RHS.getType().getPointerAddressSpace()) {
        let mut Base: *mut Value = GEPLHS.getPointerOperand();
        if GEPLHS()()() && Base.getType().isPointerTy() {
            let mut EC: auto = cast(GEPLHS()())();
        }
        return Cond;
    } else if dyn_cast(RHS) {
        GEPRHS;
    } else {
        let mut NW: GEPNoWrapFlags = GEPLHS.getNoWrapFlags() & GEPRHS.getNoWrapFlags();
        if GEPLHS.getOperand(0) != GEPRHS.getOperand(0) {
            let mut IndicesTheSame: bool = GEPLHS.getNumOperands() == GEPRHS.getNumOperands() && GEPLHS.getPointerOperand().getType() == GEPRHS.getPointerOperand().getType() && GEPLHS.getSourceElementType() == GEPRHS.getSourceElementType();
            if IndicesTheSame {
                for let mut i: u32 = 1;
let mut e: u32 = GEPLHS.getNumOperands(); i != e; i += 1 {
                    if GEPLHS.getOperand(i) != GEPRHS.getOperand(i) {
                        IndicesTheSame = false;
                        break;
                    }
                }
            }
            let mut BaseType: *mut Type = GEPLHS.getOperand(0).getType();
            if IndicesTheSame && makeCmpResultType(BaseType) == I.getType && CanFold.call(NW) {
                return ICmpInst { Cond.operator llvm::CmpInst::Predicate(), GEPLHS.getOperand(0), GEPRHS.getOperand(0), "" };
            }
            if GEPLHS.isInBounds() && GEPRHS.isInBounds() && (GEPLHS.hasAllConstantIndices() || GEPLHS()()) && (GEPRHS.hasAllConstantIndices() || GEPRHS()()) && GEPLHS.getOperand(0).stripPointerCasts() == GEPRHS.getOperand(0).stripPointerCasts() && operator!(GEPLHS()()()) {
                let mut LOffset: *mut Value = self.EmitGEPOffset(GEPLHS, false);
                let mut ROffset: *mut Value = self.EmitGEPOffset(GEPRHS, false);
                let mut LHSIndexTy: *mut Type = LOffset.getType();
                let mut RHSIndexTy: *mut Type = ROffset.getType();
                if LHSIndexTy != RHSIndexTy {
                    if LHSIndexTy.getPrimitiveSizeInBits()() < RHSIndexTy.getPrimitiveSizeInBits()() {} else {
                        
                    }
                }
                let mut Cmp: *mut Value = null;
                return self.replaceInstUsesWith;
            }
        }
        if GEPLHS.getOperand(0) == GEPRHS.getOperand(0) && GEPLHS.getNumOperands() == GEPRHS.getNumOperands() && GEPLHS.getSourceElementType() == GEPRHS.getSourceElementType() {
            let mut NumDifferences: u32 = 0;
            let mut DiffOperand: u32 = 0;
            for let mut i: u32 = 1;
let mut e: u32 = GEPRHS.getNumOperands(); i != e; i += 1 {
                if GEPLHS.getOperand(i) != GEPRHS.getOperand(i) {
                    let mut LHSType: *mut Type = GEPLHS.getOperand(i).getType();
                    let mut RHSType: *mut Type = GEPRHS.getOperand(i).getType();
                    if LHSType.getPrimitiveSizeInBits() || (GEPLHS()()() && (!LHSType.isVectorTy() || !RHSType.isVectorTy())) {
                        NumDifferences = 2;
                        break;
                    }
                    if NumDifferences += 1 {
                        break;
                    }
                    DiffOperand = i;
                }
            }
            if NumDifferences == 0 {
                return self.replaceInstUsesWith(I, get(I.getType, isTrueWhenEqual(Cond.operator llvm::CmpInst::Predicate())));
            } else if NumDifferences == 1 && NW != none() {
                let mut LHSV: *mut Value = GEPLHS.getOperand(DiffOperand);
                let mut RHSV: *mut Value = GEPRHS.getOperand(DiffOperand);
                return NewICmp.call(NW, LHSV, RHSV);
            }
        }
        if Base.Ptr && !Base.isExpensive() {
            let mut DoFold: bool = CanFold.call(Base.LHSNW & Base.RHSNW);
            if !DoFold && Base.Ptr.getType().isPointerTy() {
                let mut BW: u32 = 0;
                let mut Alignment: APInt = BW;
                let mut LOff: APInt = APInt { BW, 0, false, false };
                let mut ROff: APInt = APInt { BW, 0, false, false };
                if GEPLHS() == Base.Ptr && RHS == Base.Ptr {
                    DoFold = RoundingSDiv(LOff, Alignment, DOWN) == RoundingSDiv(ROff, Alignment, DOWN);
                }
            }
            if DoFold {
                let mut IdxTy: *mut Type = null;
                let mut L: *mut Value = self.EmitGEPOffsets(Base(), Base.LHSNW, IdxTy, true);
                let mut R: *mut Value = self.EmitGEPOffsets(Base(), Base.RHSNW, IdxTy, true);
                return NewICmp.call(Base.LHSNW & Base.RHSNW, L, R);
            }
        }
    }
    return transformToIndexedCompare(GEPLHS, RHS, Cond, *self);
}

fn InstCombinerImpl::foldAllocaCmp(self, Alloca: *mut AllocaInst) -> bool {
    let mut Tracker: CmpCaptureTracker = Alloca;
    PointerMayBeCaptured(Alloca, &mut Tracker);
    if Tracker.Captured {
        return false;
    }
    let mut Changed: bool = false;
    return Changed;
}

fn InstCombinerImpl::foldICmpAddOpConst(self, X: *mut Value, C: *APInt, Pred: CmpPredicate) -> *mut Instruction {
    assert!(!operator(C), "C should not be zero!");
    if Pred == ICMP_ULT || Pred == ICMP_ULE {
        let mut R: *mut Constant = get(X.getType(), getMaxValue(C.getBitWidth()) - C);
        return ICmpInst { ICMP_UGT, X, R, "" };
    }
    if Pred == ICMP_UGT || Pred == ICMP_UGE {
        return ICmpInst { ICMP_ULT, X, get(X.getType(), operator(C)), "" };
    }
    let mut SMax: APInt = getSignedMaxValue(C.getBitWidth());
    if Pred == ICMP_SLT || Pred == ICMP_SLE {
        return ICmpInst { ICMP_SGT, X, get(X.getType(), SMax - C), "" };
    }
    assert!(Pred == ICMP_SGT || Pred == ICMP_SGE);
    return ICmpInst { ICMP_SLT, X, get(X.getType(), SMax - (C - 1)), "" };
}

fn InstCombinerImpl::foldICmpShrConstConst(self, I: *mut ICmpInst, A: *mut Value, AP1: *APInt, AP2: *APInt) -> *mut Instruction {
    assert!(I.isEquality(), "Cannot fold icmp gt/lt");
    let mut getICmp: Closure_5 = Closure_5 { I: &mut I };
    if AP2.isZero() {
        return null;
    }
    let mut IsAShr: bool = isa(I.getOperand);
    if IsAShr {
        if AP2.isAllOnes() {
            return null;
        }
        if AP2.isNegative() != AP1.isNegative() {
            return null;
        }
        if AP2.sgt(AP1) {
            return null;
        }
    }
    if operator(AP1) {
        return getICmp.call(I.ICMP_UGT, A, get(A.getType(), AP2.logBase2(), false, false));
    }
    if AP1 == AP2 {
        return getICmp.call(I.ICMP_EQ, A, getNullValue(A.getType()));
    }
    let mut Shift: i32 = 0;
    if IsAShr && AP1.isNegative() {
        Shift = AP1.countl_one() - AP2.countl_one();
    } else {
        Shift = AP1.countl_zero() - AP2.countl_zero();
    }
    if Shift > 0 {
        if IsAShr && AP1 == AP2.ashr(Shift) {
            if AP1.isAllOnes() && !AP2.isPowerOf2() {
                return getICmp.call(I.ICMP_UGE, A, get(A.getType(), Shift, false, false));
            }
            return getICmp.call(I.ICMP_EQ, A, get(A.getType(), Shift, false, false));
        } else if AP1 == AP2.lshr(Shift) {
            return getICmp.call(I.ICMP_EQ, A, get(A.getType(), Shift, false, false));
        }
    }
    let mut TorF: *mut auto = get(I.getType, I.getPredicate == I.ICMP_NE);
    return self.replaceInstUsesWith(I);
}

fn InstCombinerImpl::foldICmpShlConstConst(self, I: *mut ICmpInst, A: *mut Value, AP1: *APInt, AP2: *APInt) -> *mut Instruction {
    assert!(I.isEquality(), "Cannot fold icmp gt/lt");
    let mut getICmp: Closure_6 = Closure_6 { I: &mut I };
    if AP2.isZero() {
        return null;
    }
    let mut AP2TrailingZeros: u32 = AP2.countr_zero();
    if operator(AP1) && AP2TrailingZeros != 0 {
        return getICmp.call(I.ICMP_UGE, A, get(A.getType(), AP2.getBitWidth() - AP2TrailingZeros, false, false));
    }
    if AP1 == AP2 {
        return getICmp.call(I.ICMP_EQ, A, getNullValue(A.getType()));
    }
    let mut Shift: i32 = AP1.countr_zero() - AP2TrailingZeros;
    if Shift > 0 && AP2.shl(Shift) == AP1 {
        return getICmp.call(I.ICMP_EQ, A, get(A.getType(), Shift, false, false));
    }
    let mut TorF: *mut auto = get(I.getType, I.getPredicate == I.ICMP_NE);
    return self.replaceInstUsesWith(I);
}

fn processUGT_ADDCST_ADD(I: *mut ICmpInst, A: *mut Value, B: *mut Value, CI2: *mut ConstantInt, CI1: *mut ConstantInt, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut AddWithCst: *mut Instruction = cast(I.getOperand);
    if operator!(AddWithCst.hasOneUse) {
        return null;
    }
    if !CI2.getValue().isPowerOf2() {
        return null;
    }
    let mut NewWidth: u32 = CI2.getValue().countr_zero();
    if NewWidth != 7 && NewWidth != 15 && NewWidth != 31 {
        return null;
    }
    NewWidth += 1;
    if CI1.getBitWidth() == NewWidth || CI1.getValue() != getLowBitsSet(CI1.getBitWidth(), NewWidth) {
        return null;
    }
    if IC.ComputeMaxSignificantBits > NewWidth || IC.ComputeMaxSignificantBits > NewWidth {
        return null;
    }
    let mut OrigAdd: *mut Instruction = cast(AddWithCst.getOperand);
    let mut NewType: *mut Type = get(OrigAdd.getContext, NewWidth);
    let mut F: *mut Function = getOrInsertDeclaration(I, sadd_with_overflow, NewType);
    let mut Builder: *mut BuilderTy = IC();
    Builder()(OrigAdd);
    let mut TruncA: *mut Value = Builder()(A, NewType, A.getName() + ".trunc");
    let mut TruncB: *mut Value = Builder()(B, NewType, B.getName() + ".trunc");
    let mut Call: *mut CallInst = Builder()(F, void { TruncA, TruncB }, "sadd");
    let mut Add: *mut Value = Builder()(Call, 0, "sadd.result");
    let mut ZExt: *mut Value = Builder()(Add, OrigAdd.getType);
    IC.replaceInstUsesWith;
    IC.eraseInstFromFunction(*OrigAdd);
    return Create(Call, 1, "sadd.overflow");
}

fn InstCombinerImpl::foldIRemByPowerOfTwoToBitTest(self, I: *mut ICmpInst) -> *mut Instruction {
    if !I.isEquality() {
        return null;
    }
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut Zero: *mut Value = null;
    if operator!(match(&mut I, m_ICmp(Pred, m_OneUse(m_IRem(m_Value(X), m_Value(Y))), m_CombineAnd(m_Zero(), m_Value(Zero))))) {
        return null;
    }
    if operator!(self.isKnownToBeAPowerOfTwo) {
        return null;
    }
    let mut Mask: *mut Value = null;
    let mut Masked: *mut Value = null;
    return Create(ICmp, Pred.operator llvm::CmpInst::Predicate(), Masked, Zero, "", null);
}

fn InstCombinerImpl::foldSignBitTest(self, I: *mut ICmpInst) -> *mut Instruction {
    let mut Val: *mut Instruction = null;
    let mut Pred: CmpPredicate = CmpPredicate {};
    if !I.isEquality() || operator!(match(&mut I, m_ICmp(Pred, m_Instruction(Val), m_Zero()))) {
        return null;
    }
    let mut X: *mut Value = null;
    let mut XTy: *mut Type = null;
    let mut C: *mut Constant = null;
    if match(Val, m_TruncOrSelf(m_Shr(m_Value(X)))) {
        XTy = X.getType();
        let mut XBitWidth: u32 = XTy.getScalarSizeInBits();
        if operator!(match(C)) {
            return null;
        }
    } else if isa(Val) && (X = self.reassociateShiftAmtsOfTwoSameDirectionShifts) {
        XTy = X.getType();
    } else {
        return null;
    }
    return Create(ICmp, if Pred == ICMP_EQ { ICMP_SGE } else { ICMP_SLT }, X, getNullValue(XTy), "", null);
}

fn InstCombinerImpl::foldICmpWithZero(self, Cmp: *mut ICmpInst) -> *mut Instruction {
    let mut Pred: Predicate = Cmp.getPredicate;
    if operator!(match(Cmp.getOperand, m_Zero())) {
        return null;
    }
    if Pred == ICMP_SGT {
        let mut A: *mut Value = null;
        let mut B: *mut Value = null;
        if match(Cmp.getOperand, m_SMin(m_Value(A), m_Value(B))) {
            if isKnownPositive(A) {
                return Pred;
            }
            if isKnownPositive(B) {
                return Pred;
            }
        }
    }
    if self.foldIRemByPowerOfTwoToBitTest(Cmp) {
        New;
    } else {
        return New;
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
