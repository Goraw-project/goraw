    if Pred == ICMP_UGT {
        if *XorC == operator(C) && (C + 1).isPowerOf2() {
            return ICmpInst { ICMP_ULT, X, Y, "" };
        }
        if *XorC == C && (C + 1).isPowerOf2() {
            return ICmpInst { ICMP_UGT, X, Y, "" };
        }
    }
    if Pred == ICMP_ULT {
        if *XorC == operator(C) && C.isPowerOf2() {
            return ICmpInst { ICMP_UGT, X, get(X.getType(), operator(C)), "" };
        }
        if *XorC == C && (operator(C)).isPowerOf2() {
            return ICmpInst { ICMP_UGT, X, get(X.getType(), operator(C)), "" };
        }
    }
    return null;
}

fn InstCombinerImpl::foldICmpXorShiftConst(self, Cmp: *mut ICmpInst, Xor: *mut BinaryOperator, C: *APInt) -> *mut Instruction {
