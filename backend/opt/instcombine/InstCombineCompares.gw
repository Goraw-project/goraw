fn InstCombinerImpl::foldICmpTruncConstant(self, Cmp: *mut ICmpInst, Trunc: *mut TruncInst, C: *APInt) -> *mut Instruction {
    let mut Pred: Predicate = Cmp.getPredicate;
    let mut X: *mut Value = Trunc.getOperand;
    let mut SrcTy: *mut Type = X.getType();
    let mut DstBits: u32 = Trunc.getType();
    let mut SrcBits: u32 = SrcTy.getScalarSizeInBits();
    if (Trunc.getType, SrcTy) {
        if Trunc.hasNoSignedWrap() {
            return ICmpInst { Pred, X, get(SrcTy, C.sext(SrcBits)), "" };
        }
        if !Cmp && Trunc.hasNoUnsignedWrap() {
            return ICmpInst { Pred, X, get(SrcTy, C.zext(SrcBits)), "" };
