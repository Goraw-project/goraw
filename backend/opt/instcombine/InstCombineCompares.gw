    }
    A = null;
    B = null;
    C = null;
    D = null;
    if BO0 && BO0.getOpcode() == Sub {
        A = BO0.getOperand(0);
        B = BO0.getOperand(1);
    }
    if BO1 && BO1.getOpcode() == Sub {
        C = BO1.getOperand(0);
        D = BO1.getOperand(1);
    }
    if A == Op1 && NoOp0WrapProblem {
        return ICmpInst { Pred, getNullValue(Op1.getType()), B, "" };
