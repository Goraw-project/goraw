}

enum OffsetKind {
    Invalid = 0,
    Value = 1,
    Select = 2,
}

struct OffsetResult {
    Kind: OffsetKind,
    V0: *mut Value,
    V1: *mut Value,
    V2: *mut Value,
    MDFrom: *mut Instruction,
}

fn OffsetResult::invalid(self) -> OffsetResult {
    return OffsetResult { Kind: Invalid, V0: null, V1: null, V2: null, MDFrom: null };
}

fn OffsetResult::value(self, V: *mut Value) -> OffsetResult {
    return OffsetResult { Kind: Value, V0: V, V1: null, V2: null, MDFrom: null };
}

fn OffsetResult::select(self, Cond: *mut Value, TrueV: *mut Value, FalseV: *mut Value, MDFrom: *mut Instruction) -> OffsetResult {
    return OffsetResult { Kind: Select, V0: Cond, V1: TrueV, V2: FalseV, MDFrom: MDFrom };
}

fn OffsetResult::isValid(self: *OffsetResult) -> bool {
    return self.Kind != Invalid;
}

fn OffsetResult::materialize(self: *OffsetResult, Builder: *mut BuilderTy) -> *mut Value {
    match self.Kind {
        Invalid => {
            llvm_unreachable_internal("Invalid offset result", "llvm\\lib\\Transforms\\InstCombine\\InstCombineCompares.cpp", 6153);
        },
        Value => {
            return self.V0;
        },
        Select => {
            return Builder()(self.V0, self.V1, self.V2, "", self.MDFrom);
        },
    }
    llvm_unreachable_internal("Unknown OffsetKind enum", "llvm\\lib\\Transforms\\InstCombine\\InstCombineCompares.cpp", 6159);
}

fn foldICmpEqualityWithOffset(I: *mut ICmpInst, Builder: *mut BuilderTy, SQ: *SimplifyQuery) -> *mut Instruction {
    assert!(I.isEquality(), "Expected an equality icmp");
    let mut Op0: *mut Value = I.getOperand;
    let mut Op1: *mut Value = I.getOperand;
