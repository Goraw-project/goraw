        if  {
            return &mut I;
        }
    }
    if I.hasSameSign() && I {
        let mut PropagateSignBit: Closure_25 = Closure_25 {};
        PropagateSignBit.call(Op0Known, Op1Known);
        PropagateSignBit.call(Op1Known, Op0Known);
    }
    if !isa(Op0) && Op0Known.isConstant() {
        return ICmpInst { Pred, getIntegerValue(Ty, Op0Known.getConstant()), Op1, "" };
    }
    if !isa(Op1) && Op1Known.isConstant() {
        return ICmpInst { Pred, Op0, getIntegerValue(Ty, Op1Known.getConstant()), "" };
    }
    if  {
        return self.replaceInstUsesWith(I, getBool(I.getType, operator*()));
    }
    let mut Op0Min: APInt = APInt { BitWidth, 0, false, false };
    let mut Op0Max: APInt = APInt { BitWidth, 0, false, false };
    let mut Op1Min: APInt = APInt { BitWidth, 0, false, false };
    let mut Op1Max: APInt = APInt { BitWidth, 0, false, false };
    if I {
        Op0Min = Op0Known.getSignedMinValue();
        Op0Max = Op0Known.getSignedMaxValue();
        Op1Min = Op1Known.getSignedMinValue();
        Op1Max = Op1Known.getSignedMaxValue();
    } else {
        Op0Min = Op0Known.getMinValue();
        Op0Max = Op0Known.getMaxValue();
        Op1Min = Op1Known.getMinValue();
        Op1Max = Op1Known.getMaxValue();
    }
    let mut isMinMaxCmp: Closure_26 = Closure_26 { Op0: &mut Op0, Op1: &mut Op1 };
    if operator!(isMinMaxCmp(I)) {
        match Pred {
            _ => {
                break;
            },
            ICMP_ULT => {
                if Op1Min == Op0Max {
                    return ICmpInst { ICMP_NE, Op0, Op1, "" };
                }
                let mut CmpC: *APInt = null;
                if match(Op1) {
                    if *CmpC == Op0Min + 1 {
                        return ICmpInst { ICMP_EQ, Op0, get(Op1.getType(), *CmpC - 1), "" };
                    }
                    if Op0Known.countMinTrailingZeros() >= CmpC.ceilLogBase2() {
                        return ICmpInst { ICMP_EQ, Op0, getNullValue(Op1.getType()), "" };
                    }
                }
                break;
            },
            ICMP_UGT => {
                if Op1Max == Op0Min {
                    return ICmpInst { ICMP_NE, Op0, Op1, "" };
                }
                let mut CmpC: *APInt = null;
                if match(Op1) {
                    if *CmpC == Op0Max - 1 {
                        return ICmpInst { ICMP_EQ, Op0, get(Op1.getType(), *CmpC + 1), "" };
                    }
                    if Op0Known.countMinTrailingZeros() >= CmpC.getActiveBits() {
                        return ICmpInst { ICMP_NE, Op0, getNullValue(Op1.getType()), "" };
                    }
                }
                break;
            },
            ICMP_SLT => {
                if Op1Min == Op0Max {
                    return ICmpInst { ICMP_NE, Op0, Op1, "" };
                }
                let mut CmpC: *APInt = null;
                if match(Op1) {
                    if *CmpC == Op0Min + 1 {
                        return ICmpInst { ICMP_EQ, Op0, get(Op1.getType(), *CmpC - 1), "" };
                    }
                }
                break;
            },
            ICMP_SGT => {
                if Op1Max == Op0Min {
                    return ICmpInst { ICMP_NE, Op0, Op1, "" };
                }
                let mut CmpC: *APInt = null;
                if match(Op1) {
                    if *CmpC == Op0Max - 1 {
                        return ICmpInst { ICMP_EQ, Op0, get(Op1.getType(), *CmpC + 1), "" };
                    }
                }
                break;
            },
        }
    }
    match Pred {
        _ => {
            break;
        },
        ICMP_EQ => {
            ICMP_NE;
        },
        ICMP_SGE => {
            if Op1Min == Op0Max {
                return ICmpInst { ICMP_EQ, Op0, Op1, "" };
            }
        },
        ICMP_SLE => {
            if Op1Max == Op0Min {
                return ICmpInst { ICMP_EQ, Op0, Op1, "" };
            }
        },
        ICMP_UGE => {
            if Op1Min == Op0Max {
                return ICmpInst { ICMP_EQ, Op0, Op1, "" };
            }
        },
        ICMP_ULE => {
            if Op1Max == Op0Min {
                return ICmpInst { ICMP_EQ, Op0, Op1, "" };
            }
        },
    }
    if (I || (I && !I.hasSameSign())) && ((Op0Known.Zero.isNegative() && Op1Known.Zero.isNegative()) || (Op0Known.One.isNegative() && Op1Known.One.isNegative())) {
        I.setPredicate;
        I.setSameSign(true);
        return &mut I;
    }
    return null;
}

fn InstCombinerImpl::foldICmpUsingBoolRange(self, I: *mut ICmpInst) -> *mut Instruction {
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut Pred: CmpPredicate = CmpPredicate {};
    if match(&mut I, m_c_ICmp(Pred, m_Value(X), m_OneUse(m_ZExt(m_Value(Y))))) && Y.getType().isIntOrIntVectorTy(1) && Pred == ICMP_ULT {
        return CreateAnd(Y);
    }
    if match(&mut I, m_c_ICmp(Pred, m_Value(X), m_OneUse(m_SExt(m_Value(Y))))) && Y.getType().isIntOrIntVectorTy(1) && Pred == ICMP_ULE {
        return CreateOr(Y);
    }
    let mut Pred1: CmpPredicate = CmpPredicate {};
    let mut Pred2: CmpPredicate = CmpPredicate {};
    let mut C: *APInt = null;
    let mut ExtI: *mut Instruction = null;
    if match(&mut I, m_c_ICmp(Pred1, m_Value(X), m_CombineAnd(m_Instruction(ExtI), m_ZExtOrSExt(m_ICmp(Pred2))))) && isEquality(Pred1.operator llvm::CmpInst::Predicate()) && isEquality(Pred2.operator llvm::CmpInst::Predicate()) {
        let mut IsSExt: bool = ExtI.getOpcode() == SExt;
        let mut HasOneUse: bool = ExtI.hasOneUse && ExtI.getOperand();
        let mut CreateRangeCheck: Closure_27 = Closure_27 { cap_0: self, Pred1: &mut Pred1, X: &mut X, IsSExt: &mut IsSExt };
        if C.isZero() {
            if Pred2 == ICMP_EQ {
                return self.replaceInstUsesWith(I, getBool(I.getType, Pred1 == ICMP_NE));
            } else if !IsSExt || HasOneUse {
                return CreateRangeCheck.call();
            }
        } else if if IsSExt { C.isAllOnes() } else { C.isOne() } {
            if Pred2 == ICMP_NE {
                return self.replaceInstUsesWith(I, getBool(I.getType, Pred1 == ICMP_NE));
            } else if !IsSExt || HasOneUse {
                return CreateRangeCheck.call();
            }
        } else {
            return Create(ICmp, Pred1.operator llvm::CmpInst::Predicate(), X, getSigned(X.getType(), if Pred2 == ICMP_NE { (if IsSExt { -1 } else { 1 }) } else { 0 }, false), "", null);
        }
    }
    return null;
}

fn canonicalizeCmpWithConstant(I: *mut ICmpInst) -> *mut ICmpInst {
    let mut Pred: CmpPredicate = I.getCmpPredicate();
    if isEquality(Pred.operator llvm::CmpInst::Predicate()) || !isIntPredicate(Pred.operator llvm::CmpInst::Predicate()) || isCanonicalPredicate(Pred) {
        return null;
    }
    let mut Op0: *mut Value = I.getOperand;
    let mut Op1: *mut Value = I.getOperand;
    let mut Op1C: *mut auto = dyn_cast(Op1);
    if operator!() {
        return null;
    }
    let mut FlippedStrictness: auto = getFlippedStrictnessPredicateAndConstant(Pred);
    if operator!() {
        return null;
    }
    let mut NewCmp: *mut auto = ;
    NewCmp()();
    return ;
}

fn InstCombinerImpl::canonicalizeICmpPredicate(self, I: *mut CmpInst) -> *mut CmpInst {
    let mut Pred: Predicate = I.getPredicate();
    if isCanonicalPredicate(CmpPredicate { Pred: Pred, HasSameSign: false }) {
        return null;
    }
    if operator!(self.canFreelyInvertAllUsersOf) {
        return null;
    }
    I.setPredicate(getInversePredicate(Pred));
    I.setName(I.getName + ".not");
    self.freelyInvertAllUsersOf;
    return &mut I;
}

fn canonicalizeICmpBool(I: *mut ICmpInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut A: *mut Value = I.getOperand;
    let mut B: *mut Value = I.getOperand;
    assert!(A.getType().isIntOrIntVectorTy(1), "Bools only");
    if match(B, m_Zero()) {
        match I.getPredicate {
            ICMP_EQ => {
                ICMP_ULE;
            },
            _ => {
                llvm_unreachable_internal("ICmp i1 X, C not simplified as expected.", "llvm\\lib\\Transforms\\InstCombine\\InstCombineCompares.cpp", 7511);
            },
        }
    } else if match(B) {
        match I.getPredicate {
            ICMP_NE => {
                ICMP_ULT;
            },
            _ => {
                llvm_unreachable_internal("ICmp i1 X, C not simplified as expected.", "llvm\\lib\\Transforms\\InstCombine\\InstCombineCompares.cpp", 7520);
            },
        }
    }
    match I.getPredicate {
        _ => {
            llvm_unreachable_internal("Invalid icmp instruction!", "llvm\\lib\\Transforms\\InstCombine\\InstCombineCompares.cpp", 7526);
        },
        ICMP_EQ => {
            return CreateNot(Builder()(A, B));
        },
        ICMP_NE => {
            return CreateXor(A, B, "");
        },
        ICMP_UGT => {
            swap(A, B);
        },
        ICMP_ULT => {
            return CreateAnd(Builder()(A), B);
        },
        ICMP_SGT => {
            swap(A, B);
        },
        ICMP_SLT => {
            return CreateAnd(Builder()(B), A);
        },
        ICMP_UGE => {
            swap(A, B);
        },
        ICMP_ULE => {
            return CreateOr(Builder()(A), B);
        },
        ICMP_SGE => {
            swap(A, B);
        },
        ICMP_SLE => {
            return CreateOr(Builder()(B), A);
        },
    }
}

fn foldICmpWithHighBitMask(Cmp: *mut ICmpInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut NewPred: CmpPredicate = CmpPredicate {};
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(&mut Cmp, m_c_ICmp(Pred, m_OneUse(m_Shl(m_Value(Y))), m_Value(X))) {
        match Pred.operator llvm::CmpInst::Predicate() {
            ICMP_ULE => {
                NewPred = CmpPredicate { Pred: ICMP_NE, HasSameSign: false };
            },
            ICMP_UGT => {
                NewPred = CmpPredicate { Pred: ICMP_EQ, HasSameSign: false };
            },
            _ => {
                return null;
            },
        }
    } else if match(&mut Cmp, m_c_ICmp(Pred, m_OneUse(m_CombineOr(m_Not(m_Shl(m_Value(Y))), m_Add(m_Shl(m_Value(Y))))), m_Value(X))) {
        match Pred.operator llvm::CmpInst::Predicate() {
            ICMP_ULT => {
                NewPred = CmpPredicate { Pred: ICMP_NE, HasSameSign: false };
            },
            ICMP_UGE => {
                NewPred = CmpPredicate { Pred: ICMP_EQ, HasSameSign: false };
            },
            _ => {
                return null;
            },
        }
    } else {
        return null;
    }
    let mut NewX: *mut Value = Builder()(X, Y, X.getName() + ".highbits");
    let mut Zero: *mut Constant = getNullValue(NewX.getType());
    return Create(ICmp, NewPred.operator llvm::CmpInst::Predicate(), NewX, Zero, "", null);
}

fn foldVectorCmp(Cmp: *mut CmpInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Pred: Predicate = Cmp.getPredicate();
    let mut LHS: *mut Value = Cmp.getOperand(0);
    let mut RHS: *mut Value = Cmp.getOperand(1);
    let mut V1: *mut Value = null;
    let mut V2: *mut Value = null;
    let mut createCmpReverse: Closure_28 = Closure_28 { Builder: &mut Builder, Cmp: &mut Cmp };
    if match(LHS, m_VecReverse(m_Value(V1))) {
        if match(RHS, m_VecReverse(m_Value(V2))) && (LHS.hasOneUse() || RHS.hasOneUse()) {
            return createCmpReverse(Pred, V1, V2);
        }
        if LHS.hasOneUse() && isSplatValue(RHS, -1, 0) {
            return createCmpReverse(Pred, V1, RHS);
        }
    } else if isSplatValue(LHS, -1, 0) && match(RHS, m_OneUse(m_VecReverse(m_Value(V2)))) {
        return createCmpReverse(Pred, LHS, V2);
    }
    let mut M: ArrayRef<int> = zeroed();
    if operator!(match(LHS, m_Shuffle(m_Value(V1), m_Undef()))) {
        return null;
    }
    let mut V1Ty: *mut Type = V1.getType();
    if match(RHS, m_Shuffle(m_Value(V2), m_Undef())) && V1Ty == V2.getType() && (LHS.hasOneUse() || RHS.hasOneUse()) {
        let mut NewCmp: *mut Value = Builder()(Pred, V1, V2);
        return NewCmp;
    }
    let mut C: *mut Constant = null;
    if !LHS.hasOneUse() || operator!(match(RHS)) {
        return null;
    }
    let mut ScalarC: *mut Constant = C.getSplatValue(true);
    let mut MaskSplatIndex: i32 = 0;
    if ScalarC && match(MaskSplatIndex) {
        C = getSplat(cast(V1Ty)(), ScalarC);
        let mut NewM: SmallVector<int, 8> = zeroed();
        let mut NewCmp: *mut Value = Builder()(Pred, V1, C);
        return NewCmp;
    }
    return null;
}

fn foldICmpOfUAddOv(I: *mut ICmpInst) -> *mut Instruction {
    let mut Pred: Predicate = I.getPredicate;
    let mut Op0: *mut Value = I.getOperand;
    let mut Op1: *mut Value = I.getOperand;
    let mut UAddOv: *mut Value = null;
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut UAddOvResultPat: auto = m_ExtractValue(m_Intrinsic(m_Value(A), m_Value(B)));
    if match(Op0) && ((Pred == ICMP_ULT && (Op1 == A || Op1 == B)) || (Pred == ICMP_EQ && match(Op1) && (match(A) || match(B))) || (Pred == ICMP_NE && match(Op1) && (match(A) || match(B)))) {
        UAddOv = cast(Op0)();
    } else if match(Op1) && Pred == ICMP_UGT && (Op0 == A || Op0 == B) {
        UAddOv = cast(Op1)();
    } else {
        return null;
    }
    return Create(UAddOv, 1);
}

fn foldICmpInvariantGroup(I: *mut ICmpInst) -> *mut Instruction {
    if operator!(I.getOperand()()) || NullPointerIsDefined(I()()(), I.getOperand()()) {
        return null;
    }
    let mut Ptr: *mut Value = null;
    if match(I.getOperand, m_Intrinsic(m_Value(Ptr))) && match(I.getOperand, m_Zero()) {
        return Create(ICmp, I.getPredicate, Ptr, I.getOperand);
    }
    return null;
}

fn foldICmpOfVectorReduce(I: *mut ICmpInst, DL: *DataLayout, Builder: *mut IRBuilderBase) -> *mut Instruction {
    if operator!(isEquality(I.getPredicate)) {
        return null;
    }
    let mut Op: *mut Value = I.getOperand;
    let mut Const: *mut Value = I.getOperand;
    let mut Vec: *mut Value = null;
    if (match(Const) && match(Op, m_OneUse(m_Intrinsic(m_Value(Vec))))) || (match(Const) && match(Op, m_OneUse(m_Intrinsic(m_Value(Vec))))) {
        let mut VecTy: *mut auto = dyn_cast(Vec.getType());
        if operator!() {
            return null;
        }
        let mut VecEltTy: *mut Type = ();
        let mut ScalarBW: u32 = DL.getTypeSizeInBits(VecEltTy) * ();
        if !DL.fitsInLegalInteger(ScalarBW) {
            return null;
        }
        let mut ScalarTy: *mut Type = get(I.getContext, ScalarBW);
        let mut NewConst: *mut Value = if match(Const) { get(ScalarTy, 0, false, false) } else { getAllOnesValue(ScalarTy) };
        return Create(ICmp, I.getPredicate, Builder.CreateBitCast(Vec, ScalarTy, ""), NewConst);
    }
    return null;
}

fn foldReductionIdiom(I: *mut ICmpInst, Builder: *mut BuilderTy, DL: *DataLayout) -> *mut Instruction {
    if I.getType() {
        return null;
    }
    let mut OuterPred: CmpPredicate = CmpPredicate {};
    let mut InnerPred: CmpPredicate = CmpPredicate {};
    let mut LHS: *mut Value = null;
    let mut RHS: *mut Value = null;
    if operator!(match(&mut I, m_ICmp(OuterPred, m_OneUse(m_BitCast(m_OneUse(m_ICmp(InnerPred, m_Value(LHS), m_Value(RHS))))), m_Zero()))) {
        return null;
    }
    let mut LHSTy: *mut auto = dyn_cast(LHS.getType());
    if operator!() || operator!(()()) {
        return null;
    }
    let mut NumBits: u32 = () * ()();
    if !DL.isLegalInteger(NumBits) {
        return null;
    }
    if isEquality(OuterPred.operator llvm::CmpInst::Predicate()) && InnerPred == ICMP_NE {
        let mut ScalarTy: *mut auto = Builder()(NumBits);
        LHS = Builder()(LHS, LHS.getName() + ".scalar");
        RHS = Builder()(RHS, RHS.getName() + ".scalar");
        return Create(ICmp, OuterPred, LHS, RHS, I.getName);
    }
    return null;
}

fn InstCombinerImpl::foldICmpCommutative(self, Pred: CmpPredicate, Op0: *mut Value, Op1: *mut Value, CtxI: *mut ICmpInst) -> *mut Instruction {
    if  {
        if self.foldGEPICmp(Op1, Pred, CtxI) {
            NI;
        } else {
            return NI;
        }
    }
    if  {
        if self.foldSelectICmp(Pred, Op1, CtxI) {
            NI;
        } else {
            return NI;
        }
    }
    if  {
        if self.foldICmpWithMinMax(CtxI, Op1, Pred) {
            Res;
        } else {
            return Res;
        }
        if self.foldICmpWithClamp(CtxI, Op1) {
            Res;
        } else {
            return Res;
        }
    }
    {
        let mut X: *mut Value = null;
        let mut C: *APInt = null;
        if match(Op0, m_Add(m_Value(X))) && Op1 == X {
            return self.foldICmpAddOpConst(X, *C, Pred);
        }
    }
    {
        let mut X: *mut Value = null;
        let mut C: *mut Constant = null;
        if match(Op0, m_Intrinsic(m_Value(X))) && match(Op1, m_Specific(X)) {
            let mut NullValue: *mut Value = getNullValue(X.getType());
            let mut AllOnesValue: *mut Value = getAllOnesValue(X.getType());
            let mut SMin: APInt = getSignedMinValue(X.getType().getScalarSizeInBits());
            let mut IsIntMinPosion: bool = C.isAllOnesValue();
            match Pred.operator llvm::CmpInst::Predicate() {
                ICMP_ULE => {
                    ICMP_SGE;
                },
                ICMP_UGT => {
                    ICMP_SLT;
                },
                ICMP_UGE => {
                    ICMP_SLE;
                },
                ICMP_ULT => {
                    ICMP_SGT;
                },
                _ => {
                    llvm_unreachable_internal("Invalid predicate!", "llvm\\lib\\Transforms\\InstCombine\\InstCombineCompares.cpp", 7897);
                },
            }
        }
    }
    {
        if match(Op0, m_Intrinsic(m_Specific(Op1))) && (isEquality(Pred.operator llvm::CmpInst::Predicate()) || Pred == ICMP_ULT) {
            let mut NewPred: Predicate = if isEquality(Pred.operator llvm::CmpInst::Predicate()) { Pred.dropSameSign() } else { ICMP_NE };
            return ICmpInst { NewPred, Op1, getNullValue(Op1.getType()), "" };
        }
    }
    let mut Q: SimplifyQuery = zeroed();
    if foldICmpWithLowBitMaskedVal(Pred, Op0, Op1, Q, *self) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    let mut CheckUGT1: Closure_29 = Closure_29 {};
    {
        if match(Op0, m_UDiv(m_Specific(Op1))) {
            return ICmpInst { getSwappedPredicate(Pred.operator llvm::CmpInst::Predicate()), Op1, getNullValue(Op1.getType()), "" };
        }
        if !isUnsigned(Pred.operator llvm::CmpInst::Predicate()) && match(Op0, m_SDiv(m_Specific(Op1))) {
            return ICmpInst { getSwappedPredicate(Pred.operator llvm::CmpInst::Predicate()), Op1, getNullValue(Op1.getType()), "" };
        }
    }
    let mut CheckNE0: Closure_30 = Closure_30 {};
    {
        if match(Op0, m_LShr(m_Specific(Op1))) {
            return ICmpInst { getSwappedPredicate(Pred.operator llvm::CmpInst::Predicate()), Op1, getNullValue(Op1.getType()), "" };
        }
        if (Pred == ICMP_SLT || Pred == ICMP_SGE) && match(Op0, m_AShr(m_Specific(Op1))) {
            return ICmpInst { getSwappedPredicate(Pred.operator llvm::CmpInst::Predicate()), Op1, getNullValue(Op1.getType()), "" };
        }
    }
    let mut X: *mut Value = null;
    let mut ShAmt: u64 = 0;
    if match(Op0, m_NUWShl(m_Value(X), m_ConstantInt(ShAmt))) && !CtxI {
        if ShAmt >= X.getType().getScalarSizeInBits() {
            return null;
        }
        if self.canEvaluateShifted {
            let mut NewOp1: *mut Value = self.getShiftedValue(Op1, ShAmt, false, Unsigned);
            return ICmpInst { Pred.operator llvm::CmpInst::Predicate(), X, NewOp1, "" };
        }
    }
    if match(Op0, m_NSWShl(m_Value(X), m_ConstantInt(ShAmt))) && !CtxI {
        if ShAmt >= X.getType().getScalarSizeInBits() {
            return null;
        }
        if self.canEvaluateShifted {
            let mut NewOp1: *mut Value = self.getShiftedValue(Op1, ShAmt, false, Signed);
            return ICmpInst { Pred.operator llvm::CmpInst::Predicate(), X, NewOp1, "" };
        }
    }
    return null;
}

fn InstCombinerImpl::visitICmpInst(self, I: *mut ICmpInst) -> *mut Instruction {
    let mut Changed: bool = false;
    let mut Q: SimplifyQuery = zeroed();
    let mut Op0: *mut Value = I.getOperand;
    let mut Op1: *mut Value = I.getOperand;
    let mut Op0Cplxity: u32 = getComplexity(Op0);
    let mut Op1Cplxity: u32 = getComplexity(Op1);
    if Op0Cplxity < Op1Cplxity {
        I.swapOperands();
        swap(Op0, Op1);
        Changed = true;
    }
    if simplifyICmpInst(I.getCmpPredicate(), Op0, Op1, Q) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if I.getPredicate == ICMP_NE && match(Op1, m_Zero()) {
        let mut Cond: *mut Value = null;
        let mut SelectTrue: *mut Value = null;
        let mut SelectFalse: *mut Value = null;
        if match(Op0, m_Select(m_Value(Cond), m_Value(SelectTrue), m_Value(SelectFalse))) {
            if self.dyn_castNegVal(SelectTrue) {
                V;
            } else {
                if V == SelectFalse {
                    return Create(ICmp, I.getPredicate, V, Op1);
                }
            }
        }
    }
    if self.foldICmpTruncWithTruncOrExt(I, Q) {
        Res;
    } else {
        return Res;
    }
    if Op0.getType().isIntOrIntVectorTy(1) {
        if canonicalizeICmpBool(I) {
            Res;
        } else {
            return Res;
        }
    }
    if canonicalizeCmpWithConstant(I) {
        Res;
    } else {
        return Res;
    }
    if self.canonicalizeICmpPredicate {
        Res;
    } else {
        return Res;
    }
    if self.foldICmpWithConstant(I) {
        Res;
    } else {
        return Res;
    }
    if self.foldICmpWithDominatingICmp(I) {
        Res;
    } else {
        return Res;
    }
    if self.foldICmpUsingBoolRange(I) {
        Res;
    } else {
        return Res;
    }
    if self.foldICmpUsingKnownBits(I) {
        Res;
    } else {
