    collectOffsetOp(Op0, true);
    collectOffsetOp(Op1, true);
    let mut ApplyOffsetImpl: Closure_22 = Closure_22 { SQ: &mut SQ };
    let mut ApplyOffset: Closure_23 = Closure_23 { ApplyOffsetImpl: &mut ApplyOffsetImpl };
    return null;
}

