    if C.isOne() && C.getBitWidth() > 1 {
        let mut V: *mut Value = null;
        if Pred == ICMP_SLT && match(X, m_Signum(m_Value(V))) {
            return ICmpInst { ICMP_SLT, V, get(V.getType(), 1, false, false), "" };
