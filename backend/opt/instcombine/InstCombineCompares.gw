            }
        },
        Add => {
            if dyn_cast(BOp1) {
                C2;
            } else {
                if BO.hasOneUse {
                    return ICmpInst { Pred, BOp0, getSub(RHS, C2, false, false), "" };
                }
            }
            break;
        },
        Xor => {
            if dyn_cast(BOp1) {
                BOC;
            } else {
                return ICmpInst { Pred, BOp0, getXor(RHS, BOC), "" };
            }
        },
        Or => {
            let mut BOC: *APInt = null;
            if match(BOp1) && BO.hasOneUse && RHS.isAllOnesValue() {
                let mut NotBOC: *mut Constant = getNot(cast(BOp1));
                let mut And: *mut Value = null;
                return ICmpInst { Pred, And, NotBOC, "" };
            }
            let mut Cond: *mut Value = null;
            let mut TV: *mut Value = null;
            let mut FV: *mut Value = null;
            let mut Other: *mut Value = null;
            let mut Sel: *mut Value = null;
            if C.isZero() && match(BO, m_OneUse(m_c_Or(m_CombineAnd(m_Value(Sel), m_Select(m_Value(Cond), m_Value(TV), m_Value(FV))), m_Value(Other)))) && Cond.getType() == Cmp.getType {
                let mut Q: SimplifyQuery = zeroed();
                if if Pred == ICMP_EQ { (match(TV, m_Zero()) && isKnownNonZero(FV, Q, 0)) } else { (match(FV, m_Zero()) && isKnownNonZero(TV, Q, 0)) } {
                    let mut Cmp: *mut Value = null;
                    return Create(if Pred == ICMP_EQ { And } else { Or }, Cmp, Cond, "", null);
                }
                if Sel.hasOneUse() && (if Pred == ICMP_EQ { (match(FV, m_Zero()) && isKnownNonZero(TV, Q, 0)) } else { (match(TV, m_Zero()) && isKnownNonZero(FV, Q, 0)) }) {
                    let mut NotCond: *mut Value = null;
                    let mut Cmp: *mut Value = null;
                    return Create(if Pred == ICMP_EQ { And } else { Or }, Cmp, NotCond, "", null);
                }
            }
            break;
        },
        UDiv => {
            SDiv;
        },
        _ => {
            break;
        },
    }
    return null;
}

fn foldCtpopPow2Test(I: *mut ICmpInst, CtpopLhs: *mut IntrinsicInst, CRhs: *APInt, Builder: *mut BuilderTy, Q: *SimplifyQuery) -> *mut Instruction {
    assert!(CtpopLhs.getIntrinsicID() == ctpop, "Non-ctpop intrin in ctpop fold");
    if operator!(CtpopLhs.hasOneUse) {
        return null;
    }
    let mut Pred: Predicate = I.getPredicate;
    if ((I.isEquality() || Pred == ICMP_UGT) && CRhs == 1) || (Pred == ICMP_ULT && CRhs == 2) {
        let mut Op: *mut Value = CtpopLhs.getArgOperand;
        let mut OpKnown: KnownBits = computeKnownBits(Op, Q.DL, Q.AC, Q.CtxI, Q.DT, true, 0);
        if OpKnown.countMinPopulation() == 1 {
            let mut And: *mut Value = Builder()(Op, getIntegerValue(Op.getType(), operator((OpKnown.One))));
            return ICmpInst { if (Pred == ICMP_EQ || Pred == ICMP_ULT) { ICMP_EQ } else { ICMP_NE }, And, getNullValue(Op.getType()), "" };
        }
    }
    return null;
}

fn InstCombinerImpl::foldICmpEqIntrinsicWithConstant(self, Cmp: *mut ICmpInst, II: *mut IntrinsicInst, C: *APInt) -> *mut Instruction {
    let mut Ty: *mut Type = II.getType;
    let mut BitWidth: u32 = C.getBitWidth();
    let mut Pred: Predicate = Cmp.getPredicate;
    match II.getIntrinsicID() {
        abs => {
            if C.isZero() || C.isMinSignedValue() {
                return Pred;
            }
        },
        bswap => {
            return Pred;
        },
        bitreverse => {
            return Pred;
        },
        ctlz => {
            cttz;
        },
        ctpop => {
            let mut IsZero: bool = C.isZero();
            if IsZero || C == BitWidth {
                return Pred;
            }
            break;
        },
        fshl => {
            fshr;
        },
        umax => {
            uadd_sat;
        },
        ssub_sat => {
            if C.isZero() && II.getType() > 1 {
                return Pred;
            }
        },
        usub_sat => {
            if C.isZero() {
                let mut NewPred: Predicate = if Pred == ICMP_EQ { ICMP_ULE } else { ICMP_UGT };
                return NewPred;
            }
            break;
        },
        _ => {
            break;
        },
    }
    return null;
}

fn foldICmpIntrinsicWithIntrinsic(Cmp: *mut ICmpInst, Builder: *mut BuilderTy) -> *mut Instruction {
    assert!(Cmp.isEquality();
    let mut Pred: Predicate = Cmp.getPredicate;
    let mut Op0: *mut Value = Cmp.getOperand;
    let mut Op1: *mut Value = Cmp.getOperand;
    let mut IIOp0: *auto = dyn_cast(Op0);
    let mut IIOp1: *auto = dyn_cast(Op1);
    if operator!() || operator!() || () != () {
        return null;
    }
    match IIOp0()() {
        bswap => {
            bitreverse;
        },
        fshl => {
            fshr;
        },
        _ => {
            break;
        },
    }
    return null;
}

fn InstCombinerImpl::foldICmpInstWithConstantAllowPoison(self, Cmp: *mut ICmpInst, C: *APInt) -> *mut Instruction {
    let mut Pred: Predicate = Cmp.getPredicate;
    if  {
        match II()() {
            _ => {
                break;
            },
            fshl => {
                fshr;
            },
        }
    }
    return null;
}

fn InstCombinerImpl::foldICmpBinOpWithConstant(self, Cmp: *mut ICmpInst, BO: *mut BinaryOperator, C: *APInt) -> *mut Instruction {
    match BO.getOpcode() {
        Xor => {
            if self.foldICmpXorConstant(Cmp, BO, C) {
                I;
            } else {
                return I;
            }
        },
        And => {
            if self.foldICmpAndConstant(Cmp, BO, C) {
                I;
            } else {
                return I;
            }
        },
        Or => {
            if self.foldICmpOrConstant(Cmp, BO, C) {
                I;
            } else {
                return I;
            }
        },
        Mul => {
            if self.foldICmpMulConstant(Cmp, BO, C) {
                I;
            } else {
                return I;
            }
        },
        Shl => {
            if self.foldICmpShlConstant(Cmp, BO, C) {
                I;
            } else {
                return I;
            }
        },
        LShr => {
            AShr;
        },
        SRem => {
            if self.foldICmpSRemConstant(Cmp, BO, C) {
                I;
            } else {
                return I;
            }
        },
        UDiv => {
            if self.foldICmpUDivConstant(Cmp, BO, C) {
                I;
            } else {
                return I;
            }
        },
        SDiv => {
            if self.foldICmpDivConstant(Cmp, BO, C) {
                I;
            } else {
                return I;
            }
        },
        Sub => {
            if self.foldICmpSubConstant(Cmp, BO, C) {
                I;
            } else {
                return I;
            }
        },
        Add => {
            if self.foldICmpAddConstant(Cmp, BO, C) {
                I;
            } else {
                return I;
            }
        },
        _ => {
            break;
        },
    }
    if self.foldICmpBinOpEqualityWithConstant(Cmp, BO, C) {
        I;
    } else {
        return I;
    }
    return self.foldICmpBinOpWithConstantViaTruthTable(Cmp, BO, C);
}

fn foldICmpUSubSatOrUAddSatWithConstant(Pred: CmpPredicate, II: *mut SaturatingInst, C: *APInt, Builder: *mut BuilderTy) -> *mut Instruction {
    if operator!(II.hasOneUse) {
        return null;
    }
    let mut Op0: *mut Value = II.getOperand;
    let mut Op1: *mut Value = II.getOperand;
    let mut COp1: *APInt = null;
    if operator!(match(Op1)) {
        return null;
    }
    let mut SatVal: APInt = APInt {};
    match II.getIntrinsicID {
        _ => {
            llvm_unreachable_internal("This function only works with usub_sat and uadd_sat for now!", "llvm\\lib\\Transforms\\InstCombine\\InstCombineCompares.cpp", 4222);
        },
        uadd_sat => {
            SatVal = getAllOnes(C.getBitWidth());
        },
        usub_sat => {
            SatVal = getZero(C.getBitWidth());
        },
    }
    let mut SatValCheck: bool = compare(SatVal, C, Pred.operator llvm::CmpInst::Predicate());
    let mut C1: ConstantRange = makeExactNoWrapRegion(II.getBinaryOp, *COp1, II.getNoWrapKind);
    if SatValCheck {
        C1 = C1.inverse();
    }
    let mut C2: ConstantRange = makeExactICmpRegion(Pred.operator llvm::CmpInst::Predicate(), C);
    if II.getBinaryOp == Add {
        C2 = C2.sub(*COp1);
    } else {
        C2 = C2.add(*COp1);
    }
    let mut CombiningOp: BinaryOps = if SatValCheck { Or } else { And };
    let mut Combination: optional<ConstantRange> = zeroed();
    if CombiningOp == Or {
        Combination() = C1.exactUnionWith;
    } else {
        Combination() = C1.exactIntersectWith;
    }
    if operator!() {
        return null;
    }
    let mut EquivPred: Predicate = zeroed();
    let mut EquivInt: APInt = APInt {};
    let mut EquivOffset: APInt = APInt {};
    Combination()(EquivPred, EquivInt, EquivOffset);
    return EquivPred;
}

fn foldICmpOfCmpIntrinsicWithConstant(Pred: CmpPredicate, I: *mut IntrinsicInst, C: *APInt, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut NewPredicate: Predicate> = zeroed();
    match Pred.operator llvm::CmpInst::Predicate() {
        ICMP_EQ => {
            ICMP_NE;
        },
        ICMP_SGT => {
            if C.isAllOnes() {
                NewPredicate() = ICMP_UGE;
            } else if C.isZero() {
                NewPredicate() = ICMP_UGT;
            }
        },
        ICMP_SLT => {
            if C.isZero() {
                NewPredicate() = ICMP_ULT;
            } else if C.isOne() {
                NewPredicate() = ICMP_ULE;
            }
        },
        ICMP_ULT => {
            if C.ugt(1) {
                NewPredicate() = ICMP_UGE;
            }
        },
        ICMP_UGT => {
            if !C.isZero() && !C.isAllOnes() {
                NewPredicate() = ICMP_ULT;
            }
        },
        _ => {
            break;
        },
    }
    if operator!() {
        return null;
    }
    if I.getIntrinsicID() == scmp {
        NewPredicate() = getSignedPredicate(operator*());
    }
    let mut LHS: *mut Value = I.getOperand;
    let mut RHS: *mut Value = I.getOperand;
    return operator*();
}

fn InstCombinerImpl::foldICmpIntrinsicWithConstant(self, Cmp: *mut ICmpInst, II: *mut IntrinsicInst, C: *APInt) -> *mut Instruction {
    let mut Pred: Predicate = Cmp.getPredicate;
    match II.getIntrinsicID() {
        _ => {
            break;
        },
        uadd_sat => {
            usub_sat;
        },
        ctpop => {
            let mut Q: SimplifyQuery = zeroed();
            if foldCtpopPow2Test(Cmp, II, C, Q) {
                R;
            } else {
                return R;
            }
        },
        scmp => {
            ucmp;
        },
    }
    if Cmp.isEquality() {
        return self.foldICmpEqIntrinsicWithConstant(Cmp, II, C);
    }
    let mut Ty: *mut Type = II.getType;
    let mut BitWidth: u32 = C.getBitWidth();
    match II.getIntrinsicID() {
        ctpop => {
            let mut X: *mut Value = II.getArgOperand;
            if C == BitWidth - 1 && Pred == ICMP_UGT {
                return Create(ICmp, ICMP_EQ, X, getAllOnesValue(Ty), "", null);
            }
            if C == BitWidth && Pred == ICMP_ULT {
                return Create(ICmp, ICMP_NE, X, getAllOnesValue(Ty), "", null);
            }
            break;
        },
        ctlz => {
            if Pred == ICMP_UGT && C.ult(BitWidth) {
                let mut Num: u32 = C.getLimitedValue(18446744073709551615);
                let mut Limit: APInt = getOneBitSet(BitWidth, BitWidth - Num - 1);
                return Create(ICmp, ICMP_ULT, II.getArgOperand, get(Ty, Limit));
            }
            if Pred == ICMP_ULT && C.uge(1) && C.ule(BitWidth) {
                let mut Num: u32 = C.getLimitedValue(18446744073709551615);
                let mut Limit: APInt = getLowBitsSet(BitWidth, BitWidth - Num);
                return Create(ICmp, ICMP_UGT, II.getArgOperand, get(Ty, Limit));
            }
            break;
        },
        cttz => {
            if operator!(II.hasOneUse) {
                return null;
            }
            if Pred == ICMP_UGT && C.ult(BitWidth) {
                let mut Mask: APInt = getLowBitsSet(BitWidth, C.getLimitedValue(18446744073709551615) + 1);
                return Create(ICmp, ICMP_EQ, getNullValue(Ty));
            }
            if Pred == ICMP_ULT && C.uge(1) && C.ule(BitWidth) {
                let mut Mask: APInt = getLowBitsSet(BitWidth, C.getLimitedValue(18446744073709551615));
                return Create(ICmp, ICMP_NE, getNullValue(Ty));
            }
            break;
        },
        ssub_sat => {
            if isSigned(Pred) && C.getBitWidth() > 1 {
                if C.isZero() {
                    return Pred;
                }
                if Pred == ICMP_SLT && C.isOne() {
                    return ICMP_SLE;
                }
                if Pred == ICMP_SGT && C.isAllOnes() {
                    return ICMP_SGE;
                }
            }
        },
        abs => {
            if operator!(II.hasOneUse) {
                return null;
            }
            let mut X: *mut Value = II.getArgOperand;
            if Pred == ICMP_UGT && C.isNonNegative() {}
            break;
        },
        _ => {
            break;
        },
    }
    return null;
}

fn InstCombinerImpl::foldICmpInstWithConstantNotInt(self, I: *mut ICmpInst) -> *mut Instruction {
    let mut Op0: *mut Value = I.getOperand;
    let mut Op1: *mut Value = I.getOperand;
    let mut RHSC: *mut Constant = dyn_cast(Op1);
    let mut LHSI: *mut Instruction = dyn_cast(Op0);
    if !RHSC || !LHSI {
        return null;
    }
    match LHSI.getOpcode() {
        IntToPtr => {
            if isa(RHSC) {
                let mut IntPtrTy: *mut Type = null;
                if IntPtrTy == LHSI.getOperand() {
                    let mut NullPtrValue: APInt = zeroed();
                    return I.getPredicate;
                }
            }
        },
        Load => {
            if dyn_cast(LHSI.getOperand) {
                GEP;
            } else if self.foldCmpLoadFromIndexedGlobal(cast(LHSI), GEP, I) {
                Res;
            } else {
                return Res;
            }
        },
    }
    return null;
}

fn InstCombinerImpl::foldSelectICmp(self, Pred: CmpPredicate, SI: *mut SelectInst, RHS: *mut Value, I: *ICmpInst) -> *mut Instruction {
    let mut SimplifyOp: Closure_12 = Closure_12 { Pred: &mut Pred, RHS: &mut RHS, cap_2: self, SI: &mut SI, I: &mut I };
    let mut CI: *mut ConstantInt = null;
    let mut Op1: *mut Value = SimplifyOp.call(SI.getOperand(1), true);
    if Op1 {
        CI = dyn_cast(Op1);
    }
    let mut Op2: *mut Value = SimplifyOp.call(SI.getOperand(2), false);
    if Op2 {
        CI = dyn_cast(Op2);
    }
    let mut Simplifies: Closure_13 = Closure_13 { SI: &mut SI, RHS: &mut RHS };
    let mut Transform: bool = false;
    if Op1 && Op2 {
        Transform = true;
    } else if Simplifies(Op1, 1) || Simplifies(Op2, 2) {
        if SI.hasOneUse {
            Transform = true;
        } else if CI && !CI.isZero() {
            Transform = self.replacedSelectWithOperand(SI, &mut I, if Op1 { 2 } else { 1 });
        }
    }
    if Transform {
        return Create(SI.getOperand(0), Op1, Op2, "", null, SI);
    }
    if isEquality(Pred.operator llvm::CmpInst::Predicate()) {
        let mut CondPred: CmpPredicate = CmpPredicate {};
        let mut C1: *APInt = null;
        let mut C2: *APInt = null;
        let mut P: *APInt = null;
        if match(SI, m_OneUse(m_Select(m_ICmp(CondPred, m_Specific(RHS))))) {
            let mut C1SatisfiesCond: bool = compare(*C1, *P, CondPred.operator llvm::CmpInst::Predicate());
            let mut C2SatisfiesCond: bool = compare(*C2, *P, CondPred.operator llvm::CmpInst::Predicate());
            if C1SatisfiesCond && !C2SatisfiesCond {
                let mut Cmp1: *mut Value = null;
                let mut Cmp2: *mut Value = null;
                if Pred == ICMP_EQ {
                    return CreateOr(Cmp1, Cmp2, "");
                }
                return CreateAnd(Cmp1, Cmp2, "");
            }
        }
    }
    return null;
}

fn isMaskOrZero(V: *Value, Not: bool, Q: *SimplifyQuery, Depth: u32) -> bool {
    if if Not { match(V) } else { match(V) } {
        return true;
    }
    if V.getType().getScalarSizeInBits() == 1 {
        return true;
    }
    if Depth += 1 >= MaxAnalysisRecursionDepth {
        return false;
    }
    let mut X: *mut Value = null;
    let mut I: *Instruction = dyn_cast(V);
    if !I {
        return false;
    }
    match I.getOpcode() {
        ZExt => {
            return !Not && isMaskOrZero(I.getOperand, Not, Q, Depth);
        },
        SExt => {
            return isMaskOrZero(I.getOperand, Not, Q, Depth);
        },
        And => {
            Or;
        },
        Xor => {
            if match(V, m_Not(m_Value(X))) {
                return isMaskOrZero(X, !Not, Q, Depth);
            }
        },
        Select => {
            return isMaskOrZero(I.getOperand, Not, Q, Depth) && isMaskOrZero(I.getOperand, Not, Q, Depth);
        },
        Shl => {
            return Not && isMaskOrZero(I.getOperand, Not, Q, Depth);
        },
        LShr => {
            return !Not && isMaskOrZero(I.getOperand, Not, Q, Depth);
        },
        AShr => {
            return isMaskOrZero(I.getOperand, Not, Q, Depth);
        },
        Add => {
            if !Not && match(I.getOperand) {
                return isKnownToBeAPowerOfTwo(I.getOperand, Q.DL, true, Q.AC, Q.CtxI, Q.DT, Depth);
            }
        },
        Sub => {
            if Not && match(I.getOperand, m_Zero()) {
                return isKnownToBeAPowerOfTwo(I.getOperand, Q.DL, true, Q.AC, Q.CtxI, Q.DT, Depth);
            }
        },
        Call => {
            if  {
                match II()() {
                    umax => {
                        smax;
                    },
                    bitreverse => {
                        return isMaskOrZero((0), !Not, Q, Depth);
                    },
                    _ => {
                        break;
                    },
                }
            }
            break;
        },
        _ => {
            break;
        },
    }
    return false;
}

fn foldICmpWithLowBitMaskedVal(Pred: CmpPredicate, Op0: *mut Value, Op1: *mut Value, Q: *SimplifyQuery, IC: *mut InstCombiner) -> *mut Value {
    let mut DstPred: Predicate = zeroed();
    match Pred.operator llvm::CmpInst::Predicate() {
        ICMP_EQ => {
            DstPred = ICMP_ULE;
        },
        ICMP_NE => {
            DstPred = ICMP_UGT;
        },
        ICMP_ULT => {
            DstPred = ICMP_UGT;
        },
        ICMP_UGE => {
            DstPred = ICMP_ULE;
        },
        ICMP_SLT => {
            DstPred = ICMP_SGT;
        },
        ICMP_SGE => {
            DstPred = ICMP_SLE;
        },
        _ => {
            return null;
        },
    }
    let mut X: *mut Value = null;
    let mut M: *mut Value = null;
    let mut IsLowBitMask: Closure_14 = Closure_14 { Op0: &mut Op0, Op1: &mut Op1, M: &mut M, X: &mut X, Q: &mut Q, Pred: &mut Pred, IC: &mut IC };
    if operator!(IsLowBitMask()) {
        return null;
    }
    return IC()(DstPred, X, M);
}

fn foldICmpWithTruncSignExtendedVal(I: *mut ICmpInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut SrcPred: CmpPredicate = CmpPredicate {};
    let mut X: *mut Value = null;
    let mut C0: *APInt = null;
    let mut C1: *APInt = null;
    if operator!(match(&mut I, m_c_ICmp(SrcPred, m_OneUse(m_AShr(m_Shl(m_Value(X))))))) {
        return null;
    }
    if *C0 != *C1 {
        return null;
    }
    let mut MaskedBits: *APInt = *C0;
    assert!(MaskedBits != 0, "shift by zero should be folded away already.");
    let mut DstPred: Predicate = zeroed();
    match SrcPred.operator llvm::CmpInst::Predicate() {
        ICMP_EQ => {
            DstPred = ICMP_ULT;
        },
        ICMP_NE => {
            DstPred = ICMP_UGE;
        },
        _ => {
            return null;
        },
    }
    let mut XType: *mut Type = X.getType();
    let mut XBitWidth: u32 = XType.getScalarSizeInBits();
    let mut BitWidth: APInt = APInt { XBitWidth, XBitWidth, false, false };
    assert!(BitWidth.ugt(MaskedBits), "shifts should leave some bits untouched");
    let mut KeptBits: APInt = BitWidth - MaskedBits;
    assert!(KeptBits.ugt(0) && KeptBits.ult(BitWidth), "unreachable");
    let mut ICmpCst: APInt = APInt { XBitWidth, 1, false, false }.shl(KeptBits);
    assert!(ICmpCst.isPowerOf2();
    let mut AddCst: APInt = ICmpCst.lshr(1);
    assert!(AddCst.ult(ICmpCst) && AddCst.isPowerOf2();
    let mut T0: *mut Value = Builder()(X, get(XType, AddCst));
    let mut T1: *mut Value = Builder()(DstPred, T0, get(XType, ICmpCst));
    return T1;
}

fn foldShiftIntoShiftInAnotherHandOfAndInICmp(I: *mut ICmpInst, SQ: SimplifyQuery, Builder: *mut BuilderTy) -> *mut Value {
    if !I.isEquality() || operator!(match(I.getOperand, m_Zero())) || operator!(I.getOperand()) {
        return null;
    }
    let mut m_AnyLogicalShift: auto = m_LogicalShift(m_Value(), m_Value());
    let mut XShift: *mut Instruction = null;
    let mut MaybeTruncation: *mut Instruction = null;
    let mut YShift: *mut Instruction = null;
    if operator!(match(I.getOperand, m_c_And(m_CombineAnd(m_Instruction(XShift)), m_CombineAnd(m_TruncOrSelf(m_CombineAnd(m_Instruction(YShift))), m_Instruction(MaybeTruncation))))) {
        return null;
    }
    let mut WidestShift: *mut Instruction = YShift;
    let mut NarrowestShift: *mut Instruction = XShift;
    let mut WidestTy: *mut Type = WidestShift.getType;
    let mut NarrowestTy: *mut Type = NarrowestShift.getType;
    (((operator!(operator!((NarrowestTy == I.getOperand() && "We did not look past any shifts while matching XShift though.")))) || (_wassert(L"NarrowestTy == I.getOperand(0)->getType() && \"We did not look past any shifts while matching XShift though.\"", L"llvm\\lib\\Transforms\\InstCombine\\InstCombineCompares.cpp", (4926) as u32) , 0)) as void);
    let mut HadTrunc: bool = WidestTy != I.getOperand();
    if match(YShift, m_LShr(m_Value(), m_Value())) {
        swap(XShift, YShift);
    }
    let mut XShiftOpcode: u32 = XShift.getOpcode();
    if XShiftOpcode == YShift.getOpcode() {
        return null;
    }
    let mut X: *mut Value = null;
    let mut XShAmt: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut YShAmt: *mut Value = null;
    match(XShift, m_BinOp(m_Value(X), m_ZExtOrSelf(m_Value(XShAmt))));
    match(YShift, m_BinOp(m_Value(Y), m_ZExtOrSelf(m_Value(YShAmt))));
    if !isa(X) && !isa(Y) {
        if operator!(match(I.getOperand, m_c_And(m_OneUse(), m_Value()))) {
            return null;
        }
        if HadTrunc {
            if operator!(MaybeTruncation.hasOneUse) && operator!(NarrowestShift.getOperand()) {
                return null;
            }
        }
    }
    if XShAmt.getType() != YShAmt.getType() {
        return null;
    }
    let mut MaximalPossibleTotalShiftAmount: u32 = (WidestTy.getScalarSizeInBits() - 1) + (NarrowestTy.getScalarSizeInBits() - 1);
    let mut MaximalRepresentableShiftAmount: APInt = getAllOnes(XShAmt.getType().getScalarSizeInBits());
    if MaximalRepresentableShiftAmount.ult(MaximalPossibleTotalShiftAmount) {
        return null;
    }
    let mut NewShAmt: *mut auto = dyn_cast_or_null(simplifyAddInst(XShAmt, YShAmt, false, false, SQ.getWithInstruction));
    if operator!() {
        return null;
    }
    if NewShAmt()() != WidestTy {
        NewShAmt() = ConstantFoldCastOperand(ZExt, WidestTy, SQ.DL);
        if operator!() {
            return null;
        }
    }
    let mut WidestBitWidth: u32 = WidestTy.getScalarSizeInBits();
    if operator!(match()) {
        return null;
    }
    if HadTrunc && match(WidestShift, m_LShr(m_Value(), m_Value())) {
        let mut CanFold: Closure_17 = Closure_17 { WidestBitWidth: WidestBitWidth, NarrowestShift: NarrowestShift, cap_2: SQ, WidestShift: WidestShift };
        if !CanFold.call() {
            return null;
        }
    }
    X = Builder()(X, WidestTy);
    Y = Builder()(Y, WidestTy);
    let mut T0: *mut Value = if XShiftOpcode == LShr { Builder()(X) } else { Builder()(X) };
    let mut T1: *mut Value = Builder()(T0, Y);
    return Builder()(I.getPredicate, T1, getNullValue(WidestTy));
}

fn InstCombinerImpl::foldMultiplicationOverflowCheck(self, I: *mut ICmpInst) -> *mut Value {
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut Mul: *mut Instruction = null;
    let mut Div: *mut Instruction = null;
    let mut NeedNegation: bool = false;
    if !I.isEquality() && match(&mut I, m_c_ICmp(Pred, m_CombineAnd(m_OneUse(m_UDiv(m_Value(X))), m_Instruction(Div)), m_Value(Y))) {
        Mul = null;
        match Pred.operator llvm::CmpInst::Predicate() {
            ICMP_ULT => {
                NeedNegation = false;
            },
            ICMP_UGE => {
                NeedNegation = true;
            },
            _ => {
                return null;
            },
        }
    } else if I.isEquality() && match(&mut I, m_c_ICmp(Pred, m_Value(Y), m_CombineAnd(m_OneUse(m_IDiv(m_CombineAnd(m_c_Mul(m_Value(X)), m_Instruction(Mul)))), m_Instruction(Div)))) {
        NeedNegation = Pred == ICMP_EQ;
    } else {
        return null;
    }
    let mut MulHadOtherUses: bool = Mul && operator!(Mul.hasOneUse);
    let mut Call: *mut Value = null;
    if MulHadOtherUses {
        self.replaceInstUsesWith;
    }
    let mut Res: *mut Value = null;
    if MulHadOtherUses {
        self.eraseInstFromFunction(*Mul);
    }
    return Res;
}

fn foldICmpXNegX(I: *mut ICmpInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut X: *mut Value = null;
    if match(&mut I, m_c_ICmp(Pred, m_NSWNeg(m_Value(X)))) {
        if isSigned(Pred.operator llvm::CmpInst::Predicate()) {
            Pred = CmpPredicate { Pred: getSwappedPredicate(Pred.operator llvm::CmpInst::Predicate()), HasSameSign: false };
        } else if isUnsigned(Pred.operator llvm::CmpInst::Predicate()) {
            Pred = CmpPredicate { Pred: getSignedPredicate(Pred.operator llvm::CmpInst::Predicate()), HasSameSign: false };
        }
        return Create(ICmp, Pred, X, getNullValue(X.getType()), I.getName);
    }
    if match(&mut I, m_c_ICmp(Pred, m_OneUse(m_Neg(m_Value(X))))) && isEquality(Pred.operator llvm::CmpInst::Predicate()) {
        let mut Ty: *mut Type = X.getType();
        let mut BitWidth: u32 = Ty.getScalarSizeInBits();
        let mut MaxSignedVal: *mut Constant = get(Ty, getSignedMaxValue(BitWidth));
        let mut And: *mut Value = Builder()(X, MaxSignedVal);
        let mut Zero: *mut Constant = getNullValue(Ty);
        return Create(ICmp, Pred.operator llvm::CmpInst::Predicate(), And, Zero, "", null);
    }
    return null;
}

fn foldICmpAndXX(I: *mut ICmpInst, Q: *SimplifyQuery, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut Op0: *mut Value = I.getOperand;
    let mut Op1: *mut Value = I.getOperand;
    let mut A: *mut Value = null;
    let mut Pred: Predicate = I.getPredicate;
    if match(Op1, m_c_And(m_Specific(Op0), m_Value())) {
        swap(Op0, Op1);
        Pred = getSwappedPredicate(Pred);
    }
    if operator!(match(Op0, m_c_And(m_Specific(Op1), m_Value(A)))) {
        return null;
    }
    if Pred == ICMP_ULT {
        return ICmpInst { ICMP_NE, Op0, Op1, "" };
    }
    if Pred == ICMP_UGE {
        return ICmpInst { ICMP_EQ, Op0, Op1, "" };
    }
    if isEquality(Pred) && Op0.hasOneUse() {
        if !match(Op1, m_ImmConstant()) {
            if  {
                return Pred;
            }
        }
        if  {
            return Pred;
        }
    }
    if !isSigned(Pred) {
        return null;
    }
    let mut KnownY: KnownBits = IC;
    if KnownY.isNegative() {
        return ICmpInst { getUnsignedPredicate(Pred), Op0, Op1, "" };
    }
    if Pred != ICMP_SLE && Pred != ICMP_SGT {
        return null;
    }
    if KnownY.isNonNegative() {
        return ICmpInst { getSwappedPredicate(Pred), Op1, getNullValue(Op1.getType()), "" };
    }
    if isKnownNegative(Op1, IC.getSimplifyQuery(&mut I)) {
        return ICmpInst { getFlippedStrictnessPredicate(Pred), A, getNullValue(A.getType()), "" };
    }
    return null;
}

fn foldICmpOrXX(I: *mut ICmpInst, Q: *SimplifyQuery, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut Op0: *mut Value = I.getOperand;
    let mut Op1: *mut Value = I.getOperand;
    let mut A: *mut Value = null;
    let mut Pred: Predicate = I.getPredicate;
    if match(Op1, m_c_Or(m_Specific(Op0), m_Value(A))) {
        swap(Op0, Op1);
        Pred = getSwappedPredicate(Pred);
    } else if operator!(match(Op0, m_c_Or(m_Specific(Op1), m_Value(A)))) {
        return null;
    }
    if Pred == ICMP_ULE {
        return ICmpInst { ICMP_EQ, Op0, Op1, "" };
    }
    if Pred == ICMP_UGT {
        return ICmpInst { ICMP_NE, Op0, Op1, "" };
    }
    if isEquality(Pred) && Op0.hasOneUse() {
        if IC(Op1, !isa(Op1) && !Op1.hasNUsesOrMore(3), operator&(IC())) {
            NotOp1;
        } else {
            return Pred;
        }
        if IC(A, A.hasOneUse(), operator&(IC())) {
            NotA;
        } else {
            return Pred;
        }
    }
    return null;
}

fn foldICmpXorXX(I: *mut ICmpInst, Q: *SimplifyQuery, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut Op0: *mut Value = I.getOperand;
    let mut Op1: *mut Value = I.getOperand;
    let mut A: *mut Value = null;
    let mut Pred: Predicate = I.getPredicate;
    if match(Op1, m_c_Xor(m_Specific(Op0), m_Value())) {
        swap(Op0, Op1);
        Pred = getSwappedPredicate(Pred);
    }
    if operator!(match(Op0, m_c_Xor(m_Specific(Op1), m_Value(A)))) {
        return null;
    }
    let mut PredOut: Predicate = getStrictPredicate(Pred);
    if PredOut != Pred && isKnownNonZero(A, Q, 0) {
        return ICmpInst { PredOut, Op0, Op1, "" };
    }
    if match(A) {
        let mut NewPred: Predicate = zeroed();
        match getStrictPredicate(Pred) {
            _ => {
                return null;
            },
            ICMP_SLT => {
                ICMP_UGT;
            },
            ICMP_SGT => {
                ICMP_ULT;
            },
        }
        let mut Const: *mut Constant = getNullValue(Op0.getType());
        return ICmpInst { NewPred, Op0, Const, "" };
    }
    return null;
}

fn isMultipleOf(X: *mut Value, C: *APInt, Q: *SimplifyQuery) -> bool {
    if C.isOne() {
        return true;
    }
    if !C.isPowerOf2() {
        return false;
    }
    return MaskedValueIsZero(X, C - 1, Q, 0);
}

fn InstCombinerImpl::foldICmpBinOp(self, I: *mut ICmpInst, SQ: *SimplifyQuery) -> *mut Instruction {
    let mut Q: SimplifyQuery = SQ.getWithInstruction;
    let mut Op0: *mut Value = I.getOperand;
    let mut Op1: *mut Value = I.getOperand;
    let mut BO0: *mut BinaryOperator = dyn_cast(Op0);
    let mut BO1: *mut BinaryOperator = dyn_cast(Op1);
