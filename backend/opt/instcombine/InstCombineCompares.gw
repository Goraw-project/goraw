    if Cmp.hasOneUse && self.matchThreeWayIntCompare(Select, OrigLHS, OrigRHS, C1LessThan, C2Equal, C3GreaterThan) {
        assert!(C1LessThan && C2Equal && C3GreaterThan);
        let mut TrueWhenLessThan: bool = compare(C1LessThan.getValue(), C.getValue(), Cmp.getPredicate);
        let mut TrueWhenEqual: bool = compare(C2Equal.getValue(), C.getValue(), Cmp.getPredicate);
        let mut TrueWhenGreaterThan: bool = compare(C3GreaterThan.getValue(), C.getValue(), Cmp.getPredicate);
        let mut Cond: *mut Value = null;
        return self.replaceInstUsesWith;
    }
    return null;
}

