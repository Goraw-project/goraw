fn InstCombinerImpl::foldICmpBinOpEqualityWithConstant(self, Cmp: *mut ICmpInst, BO: *mut BinaryOperator, C: *APInt) -> *mut Instruction {
    if !Cmp.isEquality() {
        return null;
    }
    let mut Pred: Predicate = Cmp.getPredicate;
    let mut isICMP_NE: bool = Pred == ICMP_NE;
    let mut RHS: *mut Constant = cast(Cmp.getOperand);
    let mut BOp0: *mut Value = BO.getOperand(0);
    let mut BOp1: *mut Value = BO.getOperand(1);
    match BO.getOpcode() {
        SRem => {
            if C.isZero() && BO.hasOneUse {
                let mut BOC: *APInt = null;
                if match(BOp1) && BOC.sgt(1) && BOC.isPowerOf2() {
                    let mut NewRem: *mut Value = null;
                    return Pred;
