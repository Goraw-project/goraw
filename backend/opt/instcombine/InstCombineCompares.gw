    for let mut I: u32 = 0; I < 4; I += 1 {
        let mut First: bool = (I >> 1) & 1;
        let mut Second: bool = I & 1;
        if  {
            Table()[I] = operator*();
        } else {
            return null;
        }
    }
    if  {
        return self.replaceInstUsesWith(Cmp);
    }
    return null;
}

fn InstCombinerImpl::foldICmpAddConstant(self, Cmp: *mut ICmpInst, Add: *mut BinaryOperator, C: *APInt) -> *mut Instruction {
    let mut Y: *mut Value = Add.getOperand(1);
    let mut X: *mut Value = Add.getOperand(0);
    let mut Pred: CmpPredicate = Cmp.getCmpPredicate();
    let mut ShAmtC: *APInt = null;
    let mut A: *mut Value = null;
    let mut BitWidth: u32 = C.getBitWidth();
    if Pred == ICMP_ULT && match(Add, m_c_NUWAdd(m_Value(A), m_LShr())) && ShAmtC.ult(BitWidth) && C.ule(getOneBitSet(BitWidth, ShAmtC.getZExtValue())) {
        return ICmpInst { Pred.operator llvm::CmpInst::Predicate(), A, get(A.getType(), C), "" };
    }
    let mut C2: *APInt = null;
    if Cmp.isEquality() || operator!(match(Y)) {
        return null;
    }
    let mut Ty: *mut Type = Add.getType;
    if Add.hasNoUnsignedWrap && (Pred == ICMP_UGT || Pred == ICMP_ULT) {
        let mut Overflow: bool = false;
        let mut NewC: APInt = C.usub_ov(*C2, Overflow);
        if !Overflow {
            return ICmpInst { Pred.operator llvm::CmpInst::Predicate(), X, get(Ty, NewC), "" };
        }
    }
    let mut ChosenPred: Predicate = Pred.getPreferredSignedPredicate();
    if Add.hasNoSignedWrap && (ChosenPred == ICMP_SGT || ChosenPred == ICMP_SLT) {
        let mut Overflow: bool = false;
        let mut NewC: APInt = C.ssub_ov(*C2, Overflow);
        if !Overflow {
            return ICmpInst { ChosenPred, X, get(Ty, NewC), "" };
        }
    }
    if isUnsigned(Pred.operator llvm::CmpInst::Predicate()) && Add.hasNoSignedWrap && C.isNonNegative() && (C - *C2).isNonNegative() && computeConstantRange(X, true)(*C2)() {
        return ICmpInst { getSignedPredicate(Pred.operator llvm::CmpInst::Predicate()), X, get(Ty, C - *C2), "" };
    }
    let mut CR: ConstantRange = makeExactICmpRegion(Pred.operator llvm::CmpInst::Predicate(), C).subtract(*C2);
    let mut Upper: *APInt = CR.getUpper();
    let mut Lower: *APInt = CR.getLower();
    if Cmp {
        if Lower.isSignMask() {
            return ICmpInst { ICMP_SLT, X, get(Ty, Upper), "" };
        }
        if Upper.isSignMask() {
            return ICmpInst { ICMP_SGE, X, get(Ty, Lower), "" };
        }
    } else {
        if Lower.isMinValue() {
            return ICmpInst { ICMP_ULT, X, get(Ty, Upper), "" };
        }
        if Upper.isMinValue() {
            return ICmpInst { ICMP_UGE, X, get(Ty, Lower), "" };
        }
    }
    let mut SMax: APInt = getSignedMaxValue(Ty.getScalarSizeInBits());
    let mut SMin: APInt = getSignedMinValue(Ty.getScalarSizeInBits());
    if Pred == ICMP_UGT && C == *C2 + SMax {
        return ICmpInst { ICMP_SLT, X, get(Ty, operator((*C2))), "" };
    }
    if Pred == ICMP_ULT && C == *C2 + SMin {
        return ICmpInst { ICMP_SGT, X, get(Ty, operator((*C2))), "" };
    }
    if Pred == ICMP_SGT && C == *C2 - 1 {
        return ICmpInst { ICMP_ULT, X, get(Ty, SMax - C), "" };
    }
    if Pred == ICMP_SLT && C == *C2 {
        return ICmpInst { ICMP_UGT, X, get(Ty, C ^ SMax), "" };
    }
    if Pred == ICMP_ULT && C2.isAllOnes() {
        let mut Q: SimplifyQuery = zeroed();
        if isKnownNonZero(X, Q, 0) {
            return ICmpInst { ICMP_ULE, X, get(Ty, C), "" };
        }
    }
    if operator!(Add.hasOneUse) {
        return null;
    }
    let mut V: *mut Value = null;
    if match(X, m_ZExt(m_Value(V))) {
        let mut NewCmpTy: *mut Type = V.getType();
        let mut NewCmpBW: u32 = NewCmpTy.getScalarSizeInBits();
        if self.shouldChangeType(Ty, NewCmpTy) {
            let mut SrcCR: ConstantRange = CR.truncate(NewCmpBW, NoUnsignedWrap);
            let mut EquivPred: Predicate = zeroed();
            let mut EquivInt: APInt = APInt {};
            let mut EquivOffset: APInt = APInt {};
            SrcCR.getEquivalentICmp(EquivPred, EquivInt, EquivOffset);
        }
    }
    return null;
}

fn InstCombinerImpl::matchThreeWayIntCompare(self, SI: *mut SelectInst, LHS: *mut *mut Value, RHS: *mut *mut Value, Less: *mut *mut ConstantInt, Equal: *mut *mut ConstantInt, Greater: *mut *mut ConstantInt) -> bool {
    let mut PredA: CmpPredicate = CmpPredicate {};
    if operator!(match(SI.getCondition(), m_ICmp(PredA, m_Value(LHS), m_Value(RHS)))) || !isEquality(PredA.operator llvm::CmpInst::Predicate()) {
        return false;
    }
    let mut EqualVal: *mut Value = SI.getTrueValue();
    let mut UnequalVal: *mut Value = SI.getFalseValue();
    if PredA == ICMP_NE {
        swap(EqualVal, UnequalVal);
    }
    if operator!(match(EqualVal, m_ConstantInt(Equal))) {
        return false;
    }
    let mut PredB: CmpPredicate = CmpPredicate {};
    let mut LHS2: *mut Value = null;
    let mut RHS2: *mut Value = null;
    if operator!(match(UnequalVal, m_Select(m_ICmp(PredB, m_Value(LHS2), m_Value(RHS2)), m_ConstantInt(Less), m_ConstantInt(Greater)))) {
        return false;
    }
    if LHS2 != LHS {
        swap(LHS2, RHS2);
        PredB = CmpPredicate { Pred: getSwappedPredicate(PredB.operator llvm::CmpInst::Predicate()), HasSameSign: false };
    }
    if LHS2 != LHS {
        return false;
    }
    if PredB == ICMP_SGT && isa(RHS2) {
        let mut FlippedStrictness: auto = getFlippedStrictnessPredicateAndConstant(PredB, cast(RHS2));
        if operator!() {
            return false;
        }
        (((operator!(operator!((FlippedStrictness() == ICMP_SGE && "basic correctness failure")))) || (_wassert(L"FlippedStrictness->first == ICmpInst::ICMP_SGE && \"basic correctness failure\"", L"llvm\\lib\\Transforms\\InstCombine\\InstCombineCompares.cpp", (3434) as u32) , 0)) as void);
        RHS2 = ;
        swap(Less, Greater);
        PredB = CmpPredicate { Pred: ICMP_SLT, HasSameSign: false };
    }
    return PredB == ICMP_SLT && RHS == RHS2;
}

fn InstCombinerImpl::foldICmpSelectConstant(self, Cmp: *mut ICmpInst, Select: *mut SelectInst, C: *mut ConstantInt) -> *mut Instruction {
    assert!(C, "Cmp RHS should be a constant int!");
    let mut OrigLHS: *mut Value = null;
