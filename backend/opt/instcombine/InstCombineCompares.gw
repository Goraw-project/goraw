    let mut Pred: Predicate = Cmp.getPredicate;
    let mut TrueIfSigned: bool = false;
    if isSignBitCheck(Cmp.getPredicate, C, TrueIfSigned) {
        if !XorC.isNegative() {
            return self.replaceOperand;
        }
        if TrueIfSigned {
            return ICmpInst { ICMP_SGT, X, getAllOnesValue(X.getType()), "" };
        } else {
            return ICmpInst { ICMP_SLT, X, getNullValue(X.getType()), "" };
        }
