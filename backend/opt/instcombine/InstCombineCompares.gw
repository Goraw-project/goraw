    if Xor.hasOneUse {
        if !Cmp.isEquality() && XorC.isSignMask() {
            Pred = Cmp.getFlippedSignednessPredicate();
            return ICmpInst { Pred, X, get(X.getType(), C ^ *XorC), "" };
        }
        if !Cmp.isEquality() && XorC.isMaxSignedValue() {
            Pred = Cmp.getFlippedSignednessPredicate();
            Pred = Cmp.getSwappedPredicate(Pred);
            return ICmpInst { Pred, X, get(X.getType(), C ^ *XorC), "" };
        }
