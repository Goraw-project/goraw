fn isNeutralValue(BinaryOp: BinaryOps, RHS: *mut Value, IsSigned: bool) -> bool {
    match BinaryOp {
        _ => {
            llvm_unreachable_internal("Unsupported binary op", "llvm\\lib\\Transforms\\InstCombine\\InstCombineCompares.cpp", 6734);
        },
        Add => {
            Sub;
        },
        Mul => {
            return !(RHS.getType().isIntOrIntVectorTy(1) && IsSigned) && match(RHS);
        },
    }
}

fn InstCombinerImpl::computeOverflow(self: *InstCombinerImpl, BinaryOp: BinaryOps, IsSigned: bool, LHS: *mut Value, RHS: *mut Value, CtxI: *mut Instruction) -> OverflowResult {
    match BinaryOp {
        _ => {
            llvm_unreachable_internal("Unsupported binary op", "llvm\\lib\\Transforms\\InstCombine\\InstCombineCompares.cpp", 6750);
        },
        Add => {
            if IsSigned {
                return self.computeOverflowForSignedAdd;
            } else {
                return self.computeOverflowForUnsignedAdd;
            }
        },
        Sub => {
            if IsSigned {
                return self.computeOverflowForSignedSub;
            } else {
                return self.computeOverflowForUnsignedSub;
            }
        },
        Mul => {
            if IsSigned {
                return self.computeOverflowForSignedMul;
            } else {
                return self.computeOverflowForUnsignedMul;
            }
        },
    }
}

fn InstCombinerImpl::OptimizeOverflowCheck(self, BinaryOp: BinaryOps, IsSigned: bool, LHS: *mut Value, RHS: *mut Value, OrigI: *mut Instruction, Result: *mut *mut Value, Overflow: *mut *mut Constant) -> bool {
    if OrigI.isCommutative() && isa(LHS) && !isa(RHS) {
        swap(LHS, RHS);
    }
    let mut OverflowTy: *mut Type = getInt1Ty(LHS.getContext());
    if  {
        OverflowTy = get(OverflowTy);
    }
    if isNeutralValue(BinaryOp, RHS, IsSigned) {
        Result = LHS;
        Overflow = getFalse(OverflowTy);
        return true;
    }
    match self.computeOverflow(BinaryOp, IsSigned, LHS, RHS, &mut OrigI) {
        MayOverflow => {
            return false;
        },
        AlwaysOverflowsLow => {
            AlwaysOverflowsHigh;
        },
        NeverOverflows => {
            
        },
    }
    llvm_unreachable_internal("Unexpected overflow result", "llvm\\lib\\Transforms\\InstCombine\\InstCombineCompares.cpp", 6815);
}

fn processUZExtIdiom(I: *mut ICmpInst, Val: *mut Value, OtherVal: *APInt, IC: *mut InstCombinerImpl) -> *mut Instruction {
    if !isa(Val.getType()) {
        return null;
    }
    let mut Instr: *mut auto = cast(Val);
    let mut Opcode: u32 = ();
    assert!(Opcode == Add || Opcode == Mul);
    let mut LHS: *mut auto = cast((0));
    let mut RHS: *mut auto = cast((1));
    let mut A: *mut Value = (0);
    let mut B: *mut Value = (0);
    let mut TyA: *mut Type = A.getType();
    let mut TyB: *mut Type = B.getType();
    let mut WidthA: u32 = TyA.getPrimitiveSizeInBits();
    let mut WidthB: u32 = TyB.getPrimitiveSizeInBits();
    let mut ResultWidth: u32 = 0;
    let mut ResultType: *mut Type = null;
    if WidthB > WidthA {
        ResultWidth = WidthB;
        ResultType = TyB;
    } else {
        ResultWidth = WidthA;
        ResultType = TyA;
    }
    match I.getPredicate {
        ICMP_UGT => {
            let mut MaxVal: APInt = getMaxValue(ResultWidth);
            MaxVal = MaxVal.zext(OtherVal.getBitWidth());
            if MaxVal.eq(*OtherVal) {
                break;
            }
            return null;
        },
        ICMP_ULT => {
            let mut MaxVal: APInt = getOneBitSet(OtherVal.getBitWidth(), ResultWidth);
            if MaxVal.eq(*OtherVal) {
                break;
            }
            return null;
        },
        _ => {
            return null;
        },
    }
    let mut Builder: *mut BuilderTy = IC();
    Builder()();
    let mut ResultA: *mut Value = A;
    let mut ResultB: *mut Value = B;
    if WidthA < ResultWidth {
        ResultA = Builder()(A, ResultType);
    }
    if WidthB < ResultWidth {
        ResultB = Builder()(B, ResultType);
    }
    let mut ArithResult: *mut Value = null;
    let mut OverflowCheck: *mut Value = null;
    if Opcode == Add {
        ArithResult = Builder()(ResultA, ResultB, "add");
        if I.getPredicate == ICMP_ULT {
            OverflowCheck = Builder()(ArithResult, ResultA, "not.add.overflow");
        } else {
            OverflowCheck = Builder()(ArithResult, ResultA, "add.overflow");
        }
    } else {
        let mut Call: *mut Value = Builder()(umul_with_overflow, ResultType, void { ResultA, ResultB }, null, "umul");
        ArithResult = Builder()(Call, 0, "umul.value");
        OverflowCheck = Builder()(Call, 1, "umul.overflow");
        if I.getPredicate == ICMP_ULT {
            OverflowCheck = Builder()(OverflowCheck);
        }
    }
    IC.addToWorklist();
    if Val.hasNUsesOrMore(2) {}
    return IC.replaceInstUsesWith;
}

fn getDemandedBitsLHSMask(I: *mut ICmpInst, BitWidth: u32) -> APInt {
    let mut RHS: *APInt = null;
    if operator!(match(I.getOperand)) {
        return getAllOnes(BitWidth);
    }
    let mut UnusedBit: bool = false;
    if isSignBitCheck(I.getPredicate, *RHS, UnusedBit) {
        return getSignMask(BitWidth);
    }
    match I.getPredicate {
        ICMP_UGT => {
            return getBitsSetFrom(BitWidth, RHS.countr_one());
        },
        ICMP_ULT => {
            return getBitsSetFrom(BitWidth, RHS.countr_zero());
        },
        _ => {
            return getAllOnes(BitWidth);
        },
    }
}

fn InstCombinerImpl::dominatesAllUses(self: *InstCombinerImpl, DI: *Instruction, UI: *Instruction, DB: *BasicBlock) -> bool {
    assert!(DI && UI, "Instruction not defined\n");
    if operator!(DI()()) {
        return false;
    }
    if DI()() != UI()() {
        return false;
    }
    if DI()() == DB {
        return false;
    }
    return true;
}

fn isChainSelectCmpBranch(SI: *SelectInst) -> bool {
    let mut BB: *BasicBlock = SI()();
    if !BB {
