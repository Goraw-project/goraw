    let mut BI: *mut auto = dyn_cast_or_null(BB.getTerminator());
    if operator!() {
        return false;
    }
    let mut IC: *mut auto = dyn_cast();
    if operator!() || (IC()(0) != SI && (1) != SI) {
        return false;
    }
    return true;
}

fn InstCombinerImpl::replacedSelectWithOperand(self, SI: *mut SelectInst, Icmp: *ICmpInst, SIOpd: u32) -> bool {
    assert!((SIOpd == 1 || SIOpd == 2), "Invalid select operand!");
    if isChainSelectCmpBranch(SI) && Icmp.getPredicate == ICMP_EQ {
        let mut Succ: *mut BasicBlock = SI()()()(1);
        if Succ.getSinglePredecessor() && self.dominatesAllUses {
            operator(NumSel, 0);
            SI.replaceUsesOutsideBlock(SI.getOperand(SIOpd), SI()());
            return true;
        }
    }
    return false;
}

