    if isEquality(Pred) && BO0 && match(I.getOperand) && match(BO0, m_And(m_Value())) {
        let mut NewC: *mut Value = null;
        return ICmpInst { if Pred == ICMP_EQ { ICMP_SLT } else { ICMP_SGE }, BO0.getOperand(0), NewC, "" };
    }
    {
        let mut BO: *mut BinaryOperator = null;
        let mut C: *APInt = null;
        if (Pred == ICMP_ULT || Pred == ICMP_UGE) && match(Op0, m_And(m_BinOp(BO))) && match(BO, m_Add(m_Specific(Op1))) {
            let mut NewPred: Predicate = if Pred == ICMP_ULT { ICMP_NE } else { ICMP_EQ };
            let mut Zero: *mut Constant = getNullValue(Op1.getType());
            return ICmpInst { NewPred, Op1, Zero, "" };
        }
        if (Pred == ICMP_UGT || Pred == ICMP_ULE) && match(Op1, m_And(m_BinOp(BO))) && match(BO, m_Add(m_Specific(Op0))) {
            let mut NewPred: Predicate = if Pred == ICMP_UGT { ICMP_NE } else { ICMP_EQ };
            let mut Zero: *mut Constant = getNullValue(Op1.getType());
            return ICmpInst { NewPred, Op0, Zero, "" };
        }
    }
    let mut NoOp0WrapProblem: bool = false;
    let mut NoOp1WrapProblem: bool = false;
    let mut Op0HasNUW: bool = false;
    let mut Op1HasNUW: bool = false;
    let mut Op0HasNSW: bool = false;
    let mut Op1HasNSW: bool = false;
    let mut hasNoWrapProblem: Closure_18 = Closure_18 {};
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut C: *mut Value = null;
    let mut D: *mut Value = null;
    if BO0 {
        match(BO0, m_AddLike(m_Value(A), m_Value(B)));
        NoOp0WrapProblem = hasNoWrapProblem.call(*BO0, Pred, Op0HasNSW, Op0HasNUW);
    }
    if BO1 {
        match(BO1, m_AddLike(m_Value(C), m_Value(D)));
        NoOp1WrapProblem = hasNoWrapProblem.call(*BO1, Pred, Op1HasNSW, Op1HasNUW);
    }
    if (A == Op1 || B == Op1) && NoOp0WrapProblem {
        return ICmpInst { Pred, if A == Op1 { B } else { A }, getNullValue(Op1.getType()), "" };
    }
    if (C == Op0 || D == Op0) && NoOp1WrapProblem {
        return ICmpInst { Pred, getNullValue(Op0.getType()), if C == Op0 { D } else { C }, "" };
    }
    if A && C && (A == C || A == D || B == C || B == D) && NoOp0WrapProblem && NoOp1WrapProblem {
        let mut Y: *mut Value = null;
        let mut Z: *mut Value = null;
        if A == C {
            Y = B;
            Z = D;
        } else if A == D {
            Y = B;
            Z = C;
        } else if B == C {
            Y = A;
            Z = D;
        } else {
            assert!(B == D);
            Y = A;
            Z = C;
