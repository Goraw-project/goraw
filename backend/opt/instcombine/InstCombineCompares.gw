fn InstCombinerImpl::foldFCmpIntToFPConst(self, I: *mut FCmpInst, LHSI: *mut Instruction, RHSC: *mut Constant) -> *mut Instruction {
    let mut RHS: *APFloat = null;
    if operator!(match(RHSC)) {
        return null;
    }
    let mut MantissaWidth: i32 = LHSI.getType();
    if MantissaWidth == -1 {
        return null;
    }
    let mut IntTy: *mut Type = LHSI.getOperand();
    let mut IntWidth: u32 = IntTy.getScalarSizeInBits();
    let mut LHSUnsigned: bool = isa(LHSI);
    if I.isEquality() {
        let mut P: Predicate = I.getPredicate;
        let mut IsExact: bool = false;
        let mut RHSCvt: APSInt = APSInt { IntWidth, LHSUnsigned };
        RHS.convertToInteger(RHSCvt, rmNearestTiesToEven, &mut IsExact);
        if !IsExact {
            let mut RHSRoundInt: APFloat = *RHS;
            RHSRoundInt.roundToIntegral(rmNearestTiesToEven);
            if *RHS != RHSRoundInt {
                if P == FCMP_OEQ || P == FCMP_UEQ {
                    return self.replaceInstUsesWith(I, getFalse(I.getType));
                }
                assert!(P == FCMP_ONE || P == FCMP_UNE);
                return self.replaceInstUsesWith(I, getTrue(I.getType));
            }
        }
    }
    if IntWidth as i32 > MantissaWidth {
        let mut Exp: i32 = ilogb(*RHS);
        if Exp == IEK_Inf {
            let mut MaxExponent: i32 = ilogb(getLargest(RHS.getSemantics(), false));
            if MaxExponent < IntWidth as i32 - !LHSUnsigned {
                return null;
            }
        } else {
            if MantissaWidth <= Exp && Exp <= IntWidth as i32 - !LHSUnsigned {
                return null;
            }
        }
    }
    assert!(!RHS.isNaN(), "NaN comparison not already folded!");
    let mut Pred: Predicate = zeroed();
    match I.getPredicate {
        _ => {
            llvm_unreachable_internal("Unexpected predicate!", "llvm\\lib\\Transforms\\InstCombine\\InstCombineCompares.cpp", 8454);
        },
        FCMP_UEQ => {
            FCMP_OEQ;
        },
        FCMP_UGT => {
            FCMP_OGT;
        },
        FCMP_UGE => {
            FCMP_OGE;
        },
        FCMP_ULT => {
            FCMP_OLT;
        },
        FCMP_ULE => {
            FCMP_OLE;
        },
        FCMP_UNE => {
            FCMP_ONE;
        },
        FCMP_ORD => {
            return self.replaceInstUsesWith(I, getTrue(I.getType));
        },
        FCMP_UNO => {
            return self.replaceInstUsesWith(I, getFalse(I.getType));
        },
    }
    if !LHSUnsigned {
        let mut SMax: APFloat = RHS.getSemantics();
        SMax.convertFromAPInt(getSignedMaxValue(IntWidth), true, rmNearestTiesToEven);
        if SMax < *RHS {
            if Pred == ICMP_NE || Pred == ICMP_SLT || Pred == ICMP_SLE {
                return self.replaceInstUsesWith(I, getTrue(I.getType));
            }
            return self.replaceInstUsesWith(I, getFalse(I.getType));
        }
    } else {
        let mut UMax: APFloat = RHS.getSemantics();
        UMax.convertFromAPInt(getMaxValue(IntWidth), false, rmNearestTiesToEven);
        if UMax < *RHS {
            if Pred == ICMP_NE || Pred == ICMP_ULT || Pred == ICMP_ULE {
                return self.replaceInstUsesWith(I, getTrue(I.getType));
            }
            return self.replaceInstUsesWith(I, getFalse(I.getType));
        }
    }
    if !LHSUnsigned {
        let mut SMin: APFloat = RHS.getSemantics();
        SMin.convertFromAPInt(getSignedMinValue(IntWidth), true, rmNearestTiesToEven);
        if SMin > *RHS {
            if Pred == ICMP_NE || Pred == ICMP_SGT || Pred == ICMP_SGE {
                return self.replaceInstUsesWith(I, getTrue(I.getType));
            }
            return self.replaceInstUsesWith(I, getFalse(I.getType));
        }
    } else {
        let mut UMin: APFloat = RHS.getSemantics();
        UMin.convertFromAPInt(getMinValue(IntWidth), false, rmNearestTiesToEven);
        if UMin > *RHS {
            if Pred == ICMP_NE || Pred == ICMP_UGT || Pred == ICMP_UGE {
                return self.replaceInstUsesWith(I, getTrue(I.getType));
            }
            return self.replaceInstUsesWith(I, getFalse(I.getType));
        }
    }
    let mut RHSInt: APSInt = APSInt { IntWidth, LHSUnsigned };
    let mut IsExact: bool = false;
    RHS.convertToInteger(RHSInt, rmTowardZero, &mut IsExact);
    if !RHS.isZero() {
        if !IsExact {
            match Pred {
                _ => {
                    llvm_unreachable_internal("Unexpected integer comparison!", "llvm\\lib\\Transforms\\InstCombine\\InstCombineCompares.cpp", 8553);
                },
                ICMP_NE => {
                    return self.replaceInstUsesWith(I, getTrue(I.getType));
                },
                ICMP_EQ => {
                    return self.replaceInstUsesWith(I, getFalse(I.getType));
                },
                ICMP_ULE => {
                    if RHS.isNegative() {
                        return self.replaceInstUsesWith(I, getFalse(I.getType));
                    }
                },
                ICMP_SLE => {
                    if RHS.isNegative() {
                        Pred = ICMP_SLT;
                    }
                },
                ICMP_ULT => {
                    if RHS.isNegative() {
                        return self.replaceInstUsesWith(I, getFalse(I.getType));
                    }
                },
                ICMP_SLT => {
                    if !RHS.isNegative() {
                        Pred = ICMP_SLE;
                    }
                },
                ICMP_UGT => {
                    if RHS.isNegative() {
                        return self.replaceInstUsesWith(I, getTrue(I.getType));
                    }
                },
                ICMP_SGT => {
                    if RHS.isNegative() {
                        Pred = ICMP_SGE;
                    }
                },
                ICMP_UGE => {
                    if RHS.isNegative() {
                        return self.replaceInstUsesWith(I, getTrue(I.getType));
                    }
                },
                ICMP_SGE => {
                    if !RHS.isNegative() {
                        Pred = ICMP_SGT;
                    }
                },
            }
        }
    }
    return Pred;
}

fn InstCombinerImpl::foldCmpSelectOfConstants(self, I: *mut CmpInst) -> *mut Instruction {
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut C1: *mut Value = null;
    let mut C2: *mut Value = null;
    let mut TV1: *mut Constant = null;
    let mut FV1: *mut Constant = null;
    let mut TV2: *mut Constant = null;
    let mut FV2: *mut Constant = null;
    if operator!(match(Op0, m_Select(m_Value(C1)))) || operator!(match(Op1, m_Select(m_Value(C2)))) {
        return null;
    }
    if I.getType != C1.getType() || I.getType != C2.getType() {
        return null;
    }
    let mut Pred: u32 = I.getPredicate();
    let mut DL: *DataLayout = I.getDataLayout;
    let mut Res00: *mut Constant = ConstantFoldCompareInstOperands(Pred, FV1, FV2, DL, null, null);
    let mut Res01: *mut Constant = ConstantFoldCompareInstOperands(Pred, FV1, TV2, DL, null, null);
    let mut Res10: *mut Constant = ConstantFoldCompareInstOperands(Pred, TV1, FV2, DL, null, null);
    let mut Res11: *mut Constant = ConstantFoldCompareInstOperands(Pred, TV1, TV2, DL, null, null);
    if !Res00 || !Res01 || !Res10 || !Res11 {
        return null;
    }
    if (!Res00.isNullValue() && !Res00.isAllOnesValue()) || (!Res01.isNullValue() && !Res01.isAllOnesValue()) || (!Res10.isNullValue() && !Res10.isAllOnesValue()) || (!Res11.isNullValue() && !Res11.isAllOnesValue()) {
        return null;
    }
    let mut Table: bitset<4> = zeroed();
    if !Res00.isNullValue() {
        Table()(0);
    }
    if !Res01.isNullValue() {
        Table()(1);
    }
    if !Res10.isNullValue() {
        Table()(2);
    }
    if !Res11.isNullValue() {
        Table()(3);
    }
    let mut Res: *mut Value = createLogicFromTable(C1, C2, Op0.hasOneUse() && Op1.hasOneUse());
    if !Res {
        return null;
    }
    return self.replaceInstUsesWith;
}

fn foldFCmpReciprocalAndZero(I: *mut FCmpInst, LHSI: *mut Instruction, RHSC: *mut Constant) -> *mut Instruction {
    let mut Pred: Predicate = I.getPredicate;
    if (Pred != FCMP_OGT) && (Pred != FCMP_OLT) && (Pred != FCMP_OGE) && (Pred != FCMP_OLE) {
        return null;
    }
    if operator!(match(RHSC)) {
        return null;
    }
    if !LHSI.hasNoInfs() || operator!(I.hasNoInfs) {
        return null;
    }
    let mut C: *APFloat = null;
    if operator!(match(LHSI.getOperand)) {
        return null;
    }
    if C.isZero() {
        return null;
    }
    if C.isNegative() {
        Pred = I;
    }
    return Pred;
}

fn foldFCmpFpTrunc(I: *mut FCmpInst, FPTrunc: *Instruction, C: *Constant) -> *mut Instruction {
    let mut Pred: Predicate = I.getPredicate;
    let mut DestType: *mut Type = FPTrunc.getOperand();
    let mut CValue: *APFloat = null;
    if operator!(match(&mut C)) {
        return null;
    }
    if Pred == FCMP_ORD || Pred == FCMP_UNO {
        assert!(!CValue.isNaN(), "X ord/uno NaN should be folded away by simplifyFCmpInst()");
        return Pred;
    }
    let mut RoundDown: bool = false;
    if Pred == FCMP_OGE || Pred == FCMP_UGE || Pred == FCMP_OLT || Pred == FCMP_ULT {
        RoundDown = true;
    } else if Pred == FCMP_OGT || Pred == FCMP_UGT || Pred == FCMP_OLE || Pred == FCMP_ULE {
        RoundDown = false;
    } else {
        return null;
    }
    if CValue.isNaN() || CValue.isInfinity() {
        return null;
    }
    let mut ConvertFltSema: Closure_31 = Closure_31 {};
    let mut NextValue: Closure_32 = Closure_32 {};
    let mut NextCValue: APFloat = NextValue.call(*CValue, RoundDown);
    let mut DestFltSema: *fltSemantics = DestType.getScalarType().getFltSemantics();
    let mut ExtCValue: APFloat = ConvertFltSema.call(*CValue, DestFltSema);
    let mut ExtNextCValue: APFloat = ConvertFltSema.call(NextCValue, DestFltSema);
    if NextCValue.isInfinity() {
        let mut PrevCValue: APFloat = NextValue.call(*CValue, !RoundDown);
        let mut Bias: APFloat = ConvertFltSema.call(*CValue - PrevCValue, DestFltSema);
        ExtNextCValue = ExtCValue + Bias;
    }
    let mut ExtMidValue: APFloat = scalbn(ExtCValue + ExtNextCValue, -1, rmNearestTiesToEven);
    let mut SrcFltSema: *fltSemantics = C.getType().getScalarType().getFltSemantics();
    let mut MidValue: APFloat = ConvertFltSema.call(ExtMidValue, SrcFltSema);
    if MidValue != *CValue {
        ExtMidValue.next(!RoundDown);
    }
    if NextCValue.isInfinity() {
        if ConvertFltSema.call(ExtMidValue, SrcFltSema).isInfinity() {
            return null;
        }
        let mut NextExtMidValue: APFloat = NextValue.call(ExtMidValue, RoundDown);
        if ConvertFltSema.call(NextExtMidValue, SrcFltSema).isFinite() {
            return null;
        }
    }
    return Pred;
}

fn foldFabsWithFcmpZero(I: *mut FCmpInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut X: *mut Value = null;
    if operator!(match(I.getOperand, m_FAbs(m_Value(X)))) {
        return null;
    }
    let mut C: *APFloat = null;
    if operator!(match(I.getOperand)) {
        return null;
    }
    if !C.isPosZero() {
        if !C.isSmallestNormalized() {
            return null;
        }
        let mut F: *Function = I;
        let mut Mode: DenormalMode = F.getDenormalMode(C.getSemantics());
        if Mode.Input == PreserveSign || Mode.Input == PositiveZero {
            let mut replaceFCmp: Closure_33 = Closure_33 {};
            match I.getPredicate {
                FCMP_OLT => {
                    return replaceFCmp.call(&mut I, FCMP_OEQ, X);
                },
                FCMP_UGE => {
                    return replaceFCmp.call(&mut I, FCMP_UNE, X);
                },
                FCMP_OGE => {
                    return replaceFCmp.call(&mut I, FCMP_ONE, X);
                },
                FCMP_ULT => {
                    return replaceFCmp.call(&mut I, FCMP_UEQ, X);
                },
                _ => {
                    break;
                },
            }
        }
        return null;
    }
    let mut replacePredAndOp0: Closure_34 = Closure_34 { IC: &mut IC };
    match I.getPredicate {
        FCMP_UGE => {
            FCMP_OLT;
        },
        FCMP_OGT => {
            return replacePredAndOp0(&mut I, FCMP_ONE, X);
        },
        FCMP_UGT => {
            return replacePredAndOp0(&mut I, FCMP_UNE, X);
        },
        FCMP_OLE => {
            return replacePredAndOp0(&mut I, FCMP_OEQ, X);
        },
        FCMP_ULE => {
            return replacePredAndOp0(&mut I, FCMP_UEQ, X);
        },
        FCMP_OGE => {
            (((operator!(operator!((operator!(I.hasNoNaNs) && "fcmp should have simplified")))) || (_wassert(L"!I.hasNoNaNs() && \"fcmp should have simplified\"", L"llvm\\lib\\Transforms\\InstCombine\\InstCombineCompares.cpp", (8895) as u32) , 0)) as void);
        },
        FCMP_ULT => {
            (((operator!(operator!((operator!(I.hasNoNaNs) && "fcmp should have simplified")))) || (_wassert(L"!I.hasNoNaNs() && \"fcmp should have simplified\"", L"llvm\\lib\\Transforms\\InstCombine\\InstCombineCompares.cpp", (8900) as u32) , 0)) as void);
        },
        FCMP_OEQ => {
            FCMP_UEQ;
        },
        _ => {
            return null;
        },
    }
}

fn foldSqrtWithFcmpZero(I: *mut FCmpInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut X: *mut Value = null;
    if operator!(match(I.getOperand, m_Sqrt(m_Value(X)))) {
        return null;
    }
    if operator!(match(I.getOperand)) {
        return null;
    }
    let mut ReplacePredAndOp0: Closure_35 = Closure_35 { I: &mut I, IC: &mut IC, X: &mut X };
    if operator!(cast(I.getOperand)()) {
        I.setHasNoInfs;
    }
    match I.getPredicate {
        FCMP_OLT => {
            FCMP_UGE;
        },
        FCMP_ULT => {
            FCMP_ULE;
        },
        FCMP_OLE => {
            return ReplacePredAndOp0(FCMP_OEQ);
        },
        FCMP_UGT => {
            return ReplacePredAndOp0(FCMP_UNE);
        },
        FCMP_UEQ => {
            return ReplacePredAndOp0(FCMP_ULE);
        },
        FCMP_ONE => {
            return ReplacePredAndOp0(FCMP_OGT);
        },
        FCMP_ORD => {
            return ReplacePredAndOp0(FCMP_OGE);
        },
        FCMP_UNO => {
            return ReplacePredAndOp0(FCMP_ULT);
        },
        _ => {
            llvm_unreachable_internal("Unexpected predicate!", "llvm\\lib\\Transforms\\InstCombine\\InstCombineCompares.cpp", 8978);
        },
    }
}

fn foldFCmpFNegCommonOp(I: *mut FCmpInst) -> *mut Instruction {
    let mut Pred: Predicate = I.getPredicate;
    let mut Op0: *mut Value = I.getOperand;
    let mut Op1: *mut Value = I.getOperand;
    if match(Op0, m_FNeg(m_Value())) && operator!(match(Op1, m_FNeg(m_Value()))) {
        swap(Op0, Op1);
        Pred = I;
    }
    if operator!(match(Op1, m_FNeg(m_Specific(Op0)))) {
        return null;
    }
    let mut Zero: *mut Constant = getZero(Op0.getType(), false);
}

fn foldFCmpFSubIntoFCmp(I: *mut FCmpInst, LHSI: *mut Instruction, RHSC: *mut Constant, CI: *mut InstCombinerImpl) -> *mut Instruction {
    let mut Pred: Predicate = I.getPredicate;
    let mut X: *mut Value = LHSI.getOperand;
    let mut Y: *mut Value = LHSI.getOperand;
    match Pred {
        _ => {
            break;
        },
        FCMP_UGT => {
            FCMP_ULT;
        },
        FCMP_OGT => {
            FCMP_OLT;
        },
    }
    return null;
}

fn foldFCmpFAbsFSubIntToFP(I: *mut FCmpInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut FAbsArg: *mut Value = null;
    if operator!(match(I.getOperand, m_FAbs(m_Value(FAbsArg)))) {
        return null;
    }
    let mut C: *APFloat = null;
    if operator!(match(I.getOperand, (C))) {
        return null;
    }
    let mut Pred: Predicate = I.getPredicate;
    let mut IsStrictLt: bool = Pred == FCMP_OLT || Pred == FCMP_ULT;
    let mut IsLe: bool = Pred == FCMP_OLE || Pred == FCMP_ULE;
    let mut IsStrictGt: bool = Pred == FCMP_OGT || Pred == FCMP_UGT;
    let mut IsGe: bool = Pred == FCMP_OGE || Pred == FCMP_UGE;
    if !IsStrictLt && !IsStrictGt && !IsGe {
        return null;
    }
    let mut One: APFloat = getOne(C.getSemantics(), false);
    let mut Cmp: cmpResult = C.compare(One);
    if IsStrictLt && Cmp == cmpGreaterThan {
        return null;
    }
    if IsGe && Cmp == cmpGreaterThan {
        return null;
    }
    if IsLe && Cmp != cmpGreaterThan {
        return null;
    }
    if IsStrictGt && Cmp != cmpLessThan {
        return null;
    }
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut IsSigned: bool = false;
    if match(FAbsArg, m_FSub(m_UIToFP(m_Value(A)), m_UIToFP(m_Value(B)))) {
        IsSigned = false;
    } else if match(FAbsArg, m_FSub(m_SIToFP(m_Value(A)), m_SIToFP(m_Value(B)))) {
        IsSigned = true;
    } else {
        return null;
    }
    if A.getType() != B.getType() {
        return null;
    }
    let mut FPTy: *mut Type = FAbsArg.getType();
    if operator!(IC.canBeCastedExactlyIntToFP) || operator!(IC.canBeCastedExactlyIntToFP) {
        return null;
    }
    let mut ResultPred: Predicate = if IsStrictLt || IsLe { ICMP_EQ } else { ICMP_NE };
    return ICmpInst { ResultPred, A, B, "" };
}

fn foldFCmpWithFloorAndCeil(I: *mut FCmpInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut LHS: *mut Value = I.getOperand;
    let mut RHS: *mut Value = I.getOperand;
    let mut OpType: *mut Type = LHS.getType();
    let mut Pred: Predicate = I.getPredicate;
    let mut FloorX: bool = match(LHS, m_Intrinsic(m_Specific(RHS)));
    let mut CeilX: bool = match(LHS, m_Intrinsic(m_Specific(RHS)));
    if !FloorX && !CeilX {
        if (FloorX = match(RHS, m_Intrinsic(m_Specific(LHS)))) || (CeilX = match(RHS, m_Intrinsic(m_Specific(LHS)))) {
            swap(LHS, RHS);
            Pred = I;
        }
    }
    if (FloorX || CeilX) && isCommutative(Pred) && LHS.hasOneUse() {
        let mut TruncX: *mut Value = IC()(trunc, RHS);
    }
    match Pred {
        FCMP_OLE => {
            
        },
        FCMP_OGT => {
            if FloorX {
                return IC.replaceInstUsesWith(I, getFalse(I.getType));
            }
        },
        FCMP_OGE => {
            
        },
        FCMP_OLT => {
            if CeilX {
                return IC.replaceInstUsesWith(I, getFalse(I.getType));
            }
        },
        FCMP_ULE => {
            if FloorX {
                return IC.replaceInstUsesWith(I, getTrue(I.getType));
            }
        },
        FCMP_UGT => {
            
        },
        FCMP_UGE => {
            if CeilX {
                return IC.replaceInstUsesWith(I, getTrue(I.getType));
            }
        },
        FCMP_ULT => {
            
        },
        _ => {
            break;
        },
    }
    return null;
}

fn isMinMaxCmpSelectEliminable(Flavor: SelectPatternFlavor, A: *mut Value, B: *mut Value) -> bool {
    let mut APF: *APFloat = null;
    if operator!(match(B)) {
        return false;
    }
    let mut I: *mut auto = dyn_cast(A);
    if operator!() || operator!((I()() == SIToFP || () == UIToFP)) {
        return false;
    }
    let mut IsUnsigned: bool = () == UIToFP;
    let mut BitWidth: u32 = (0)()();
    let mut IntBoundary: APSInt = if (Flavor == SPF_FMAXNUM) { getMinValue(BitWidth, IsUnsigned) } else { getMaxValue(BitWidth, IsUnsigned) };
    let mut ConvertedInt: APSInt = APSInt { BitWidth, IsUnsigned };
    let mut IsExact: bool = false;
    let mut Status: opStatus = APF.convertToInteger(ConvertedInt, rmTowardZero, &mut IsExact);
    return Status == opOK && IsExact && ConvertedInt == IntBoundary;
}

fn InstCombinerImpl::visitFCmpInst(self, I: *mut FCmpInst) -> *mut Instruction {
    let mut Changed: bool = false;
    if getComplexity(I.getOperand) < getComplexity(I.getOperand) {
        I.swapOperands();
        Changed = true;
    }
    let mut Pred: Predicate = I.getPredicate;
    let mut Op0: *mut Value = I.getOperand;
    let mut Op1: *mut Value = I.getOperand;
    if simplifyFCmpInst(Pred, Op0, Op1, I.getFastMathFlags) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    let mut OpType: *mut Type = Op0.getType();
    assert!(OpType == Op1.getType(), "fcmp with different-typed operands?");
    if Op0 == Op1 {
        match Pred {
            _ => {
                break;
            },
            FCMP_UNO => {
                FCMP_ULT;
            },
            FCMP_ORD => {
                FCMP_OEQ;
            },
