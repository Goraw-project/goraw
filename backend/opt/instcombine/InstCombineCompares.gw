                        return FCmpInst { FCMP_ORD, X, getZero(X.getType(), false), "", null };
                    },
                    FCMP_UEQ => {
                        return FCmpInst { FCMP_UNO, X, getZero(X.getType(), false), "", null };
                    },
                    FCMP_UNE => {
                        return self.replaceInstUsesWith(I, getTrue(I.getType));
                    },
                    _ => {
                        break;
                    },
                }
            }
            let mut Fabs: APFloat = TruncC;
            Fabs.clearSign();
            if !Lossy && (Fabs.isZero() || !(Fabs < getSmallestNormalized(FPSem, false))) {
                let mut NewC: *mut Constant = get(X.getType(), TruncC);
            }
        }
    }
    if match(Op0, m_OneUse(m_Intrinsic(m_Value(X)))) && match(Op1) && !C.isZero() && !C.isNaN() {
        let mut IntType: *mut Type = null;
        if  {
            IntType = get(IntType);
        }
        if Pred == FCMP_OLT {
            let mut IntX: *mut Value = null;
            return ICmpInst { ICMP_SLT, IntX, getNullValue(IntType), "" };
        }
    }
    {
        let mut CanonLHS: *mut Value = null;
        match(Op0, m_Intrinsic(m_Value(CanonLHS)));
        let mut CanonRHS: *mut Value = null;
        match(Op1, m_Intrinsic(m_Value(CanonRHS)));
    }
    if I.getType() {
        if foldVectorCmp(I) {
            Res;
        } else {
            return Res;
        }
    }
