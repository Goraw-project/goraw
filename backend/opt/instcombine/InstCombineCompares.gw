    let mut Pow2: *APInt = null;
    if Cmp.isEquality() && match(X, m_Shl(m_Value(Y))) && DstBits > Pow2.logBase2() {
        if C.isZero() {
            let mut NewPred: auto = if (Pred == Cmp.ICMP_EQ) { Cmp.ICMP_UGE } else { Cmp.ICMP_ULT };
            return ;
        }
        if C.isPowerOf2() {
            return ICmpInst { Pred, Y, get(SrcTy, C.logBase2() - Pow2.logBase2(), false, false), "" };
        }
    }
    if Cmp.isEquality() && (Trunc.hasOneUse || Trunc.hasNoUnsignedWrap()) {
        if !SrcTy.isVectorTy() && self.shouldChangeType(DstBits, SrcBits) {
            let mut Mask: *mut Constant = get(SrcTy, getLowBitsSet(SrcBits, DstBits));
            let mut And: *mut Value = null;
            let mut WideC: *mut Constant = get(SrcTy, C.zext(SrcBits));
            return ICmpInst { Pred, And, WideC, "" };
        }
        let mut Known: KnownBits = ;
        if (Known.Zero | Known.One).countl_one() >= SrcBits - DstBits {
            let mut NewRHS: APInt = C.zext(SrcBits);
            operator(NewRHS, Known.One & getHighBitsSet(SrcBits, SrcBits - DstBits));
            return ICmpInst { Pred, X, get(SrcTy, NewRHS), "" };
        }
    }
    let mut ShOp: *mut Value = null;
    let mut ShAmt: u64 = 0;
    let mut TrueIfSigned: bool = false;
    if isSignBitCheck(Pred, C, TrueIfSigned) && match(X, m_Shr(m_Value(ShOp), m_ConstantInt(ShAmt))) && DstBits == SrcBits - ShAmt {
        return if TrueIfSigned { ICmpInst { ICMP_SLT, ShOp, getNullValue(SrcTy), "" } } else { ICmpInst { ICMP_SGT, ShOp, getAllOnesValue(SrcTy), "" } };
    }
    return null;
}

fn InstCombinerImpl::foldICmpTruncWithTruncOrExt(self, Cmp: *mut ICmpInst, Q: *SimplifyQuery) -> *mut Instruction {
