    }
    if A && C && NoOp0WrapProblem && NoOp1WrapProblem && (BO0.hasOneUse || BO1.hasOneUse) && !I {
        let mut AP1: *APInt = null;
        let mut AP2: *APInt = null;
        if match(B) && match(D) && AP1.isNegative() == AP2.isNegative() {
            let mut AP1Abs: APInt = AP1.abs();
            let mut AP2Abs: APInt = AP2.abs();
            if AP1Abs.uge(AP2Abs) {
                let mut Diff: APInt = *AP1 - *AP2;
                let mut C3: *mut Constant = getIntegerValue(BO0.getType, Diff);
                let mut NewAdd: *mut Value = null;
                return ICmpInst { Pred, NewAdd, C, "" };
            } else {
                let mut Diff: APInt = *AP2 - *AP1;
                let mut C3: *mut Constant = getIntegerValue(BO0.getType, Diff);
                let mut NewAdd: *mut Value = null;
                return ICmpInst { Pred, A, NewAdd, "" };
            }
        }
        let mut Cst1: *mut Constant = null;
        let mut Cst2: *mut Constant = null;
        if match(B, m_ImmConstant(Cst1)) && match(D, m_ImmConstant(Cst2)) && isEquality(Pred) {
