    if C == Op0 && NoOp1WrapProblem {
        return ICmpInst { Pred, D, getNullValue(Op0.getType()), "" };
    }
    if A == Op1 && (Pred == ICMP_UGT || Pred == ICMP_ULE) {
        return ICmpInst { Pred, B, A, "" };
    }
    if C == Op0 && (Pred == ICMP_ULT || Pred == ICMP_UGE) {
        return ICmpInst { Pred, C, D, "" };
    }
    if A == Op1 && (Pred == ICMP_UGE || Pred == ICMP_ULT) && isKnownNonZero(B, Q, 0) {
