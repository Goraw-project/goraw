            return self.replaceOperand;
        }
        if operator!(match(Op1)) && isKnownNeverNaN(Op1, self.getSimplifyQuery(&mut I)) {
            return self.replaceOperand;
        }
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if foldFCmpFNegCommonOp(I) {
        R;
    } else {
        return R;
    }
    if I.hasOneUse {
