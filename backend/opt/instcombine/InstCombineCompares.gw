            FCMP_OLT => {
                
            },
            FCMP_OLE => {
                
            },
            FCMP_OGE => {
                
            },
            FCMP_ULT => {
                
            },
            FCMP_UGT => {
                
            },
            FCMP_UGE => {
                
            },
        }
