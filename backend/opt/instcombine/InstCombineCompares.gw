    }
    let mut MaskC: *APInt = null;
    if match(OrOp1) && Cmp.isEquality() {
        if *MaskC == C && (C + 1).isPowerOf2() {
            Pred = if (Pred == ICMP_EQ) { ICMP_ULE } else { ICMP_UGT };
            return ICmpInst { Pred, OrOp0, OrOp1, "" };
        }
        if Or.hasOneUse {
            let mut And: *mut Value = null;
            let mut NewC: *mut Constant = get(Or.getType, C ^ (*MaskC));
            return ICmpInst { Pred, And, NewC, "" };
        }
    }
    let mut X: *mut Value = null;
    let mut TrueIfSigned: bool = false;
    if isSignBitCheck(Pred, C, TrueIfSigned) && match(Or, m_c_Or(m_Add(m_Value(X)))) {
        let mut NewPred: Predicate = if TrueIfSigned { ICMP_SLT } else { ICMP_SGT };
        let mut NewC: *mut Constant = get(X.getType(), if TrueIfSigned { 1 } else { 0 }, false, false);
        return ICmpInst { NewPred, X, NewC, "" };
    }
    let mut OrC: *APInt = null;
    if C.isNonNegative() && match(Or, m_Or(m_Value(X))) {
        match Pred {
            ICMP_SLT => {
                ICMP_SGE;
            },
            ICMP_SLE => {
                ICMP_SGT;
            },
            _ => {
                break;
            },
        }
    }
    if !Cmp.isEquality() || !C.isZero() || operator!(Or.hasOneUse) {
        return null;
    }
    let mut P: *mut Value = null;
    let mut Q: *mut Value = null;
    if match(Or, m_Or(m_PtrToInt(m_Value(P)), m_PtrToInt(m_Value(Q)))) {
        let mut CmpP: *mut Value = null;
        let mut CmpQ: *mut Value = null;
        let mut BOpc: auto = if Pred == ICMP_EQ { And } else { Or };
        return Create(CmpP, CmpQ);
    }
    if foldICmpOrXorSubChain(Cmp, Or) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    return null;
}

fn InstCombinerImpl::foldICmpMulConstant(self, Cmp: *mut ICmpInst, Mul: *mut BinaryOperator, C: *APInt) -> *mut Instruction {
    let mut Pred: Predicate = Cmp.getPredicate;
    let mut MulTy: *mut Type = Mul.getType;
    let mut X: *mut Value = Mul.getOperand(0);
    if X == Mul.getOperand(1) && !Cmp {
        let mut R: APInt = C.sqrtFloor();
        let mut IsSqr: bool = C == R * R;
        if Cmp.isEquality() && (Mul.hasNoUnsignedWrap || (Mul.hasNoSignedWrap && C.isZero())) {
            if !IsSqr {
                return self.replaceInstUsesWith(Cmp, getBool(Cmp.getType, Pred == ICMP_NE));
            }
            return ICmpInst { Pred, X, get(MulTy, R), "" };
        }
        if Mul.hasNoUnsignedWrap {
            if IsSqr {
                return ICmpInst { Pred, X, get(MulTy, R), "" };
            }
            if isLT(Pred) || isLE(Pred) {
                operator(R);
            }
            return ICmpInst { Cmp, X, get(MulTy, R), "" };
        }
    }
    let mut MulC: *APInt = null;
    if operator!(match(Mul.getOperand(1))) {
        return null;
    }
    if isSignTest(Pred, C) && Mul.hasNoSignedWrap {
        if MulC.isNegative() {
            Pred = getSwappedPredicate(Pred);
        }
        return ICmpInst { Pred, X, getNullValue(MulTy), "" };
    }
    if MulC.isZero() {
        return null;
    }
    if Cmp.isEquality() {
        if Mul.hasNoSignedWrap && C.srem(*MulC).isZero() {
            let mut NewC: *mut Constant = get(MulTy, C.sdiv(*MulC));
            return ICmpInst { Pred, X, NewC, "" };
        }
        if C.urem(*MulC).isZero() {
            if (*MulC & 1).isOne() || Mul.hasNoUnsignedWrap {
                let mut NewC: *mut Constant = get(MulTy, C.udiv(*MulC));
                return ICmpInst { Pred, X, NewC, "" };
            }
        }
    }
    let mut NewC: *mut Constant = null;
    if Mul.hasNoSignedWrap && isSigned(Pred) {
        if C.isMinSignedValue() && MulC.isAllOnes() {
            return null;
        }
        if MulC.isNegative() {
            Pred = getSwappedPredicate(Pred);
        }
        if Pred == ICMP_SLT || Pred == ICMP_SGE {
            NewC = get(MulTy, RoundingSDiv(C, *MulC, UP));
        } else {
            assert!((Pred == ICMP_SLE || Pred == ICMP_SGT), "Unexpected predicate");
            NewC = get(MulTy, RoundingSDiv(C, *MulC, DOWN));
        }
    } else if Mul.hasNoUnsignedWrap && isUnsigned(Pred) {
        if Pred == ICMP_ULT || Pred == ICMP_UGE {
            NewC = get(MulTy, RoundingUDiv(C, *MulC, UP));
        } else {
            assert!((Pred == ICMP_ULE || Pred == ICMP_UGT), "Unexpected predicate");
            NewC = get(MulTy, RoundingUDiv(C, *MulC, DOWN));
        }
    }
    return if NewC { ICmpInst { Pred, X, NewC, "" } } else { null };
}

fn foldICmpShlLHSC(Cmp: *mut ICmpInst, Shl: *mut Instruction, C: *APInt) -> *mut Instruction {
    let mut Y: *mut Value = null;
    let mut C2: *APInt = null;
    if operator!(match(Shl, m_NUWShl(m_Value(Y)))) {
        return null;
    }
    let mut ShiftType: *mut Type = Shl.getType;
    let mut TypeBits: u32 = C.getBitWidth();
    let mut Pred: Predicate = Cmp.getPredicate;
    if Cmp {
        if C2.isZero() || C2.ugt(C) {
            return null;
        }
        let mut Div: APInt = APInt {};
        let mut Rem: APInt = APInt {};
        udivrem(C, *C2, Div, Rem);
        let mut CIsPowerOf2: bool = Rem.isZero() && Div.isPowerOf2();
        if !CIsPowerOf2 {
            if Pred == ICMP_ULT {
                Pred = ICMP_ULE;
            } else if Pred == ICMP_UGE {
                Pred = ICMP_UGT;
            }
        }
        let mut CLog2: u32 = Div.logBase2();
        return ICmpInst { Pred, Y, get(ShiftType, CLog2, false, false), "" };
    } else if Cmp && C2.isOne() {
        let mut BitWidthMinusOne: *mut Constant = get(ShiftType, TypeBits - 1, false, false);
        if Pred == ICMP_SGT && C.sle(0) {
            return ICmpInst { ICMP_NE, Y, BitWidthMinusOne, "" };
        }
        if Pred == ICMP_SLT && (C - 1).sle(0) {
            return ICmpInst { ICMP_EQ, Y, BitWidthMinusOne, "" };
        }
    }
    return null;
}

fn InstCombinerImpl::foldICmpShlConstant(self, Cmp: *mut ICmpInst, Shl: *mut BinaryOperator, C: *APInt) -> *mut Instruction {
    let mut ShiftVal: *APInt = null;
    if Cmp.isEquality() && match(Shl.getOperand(0)) {
        return self.foldICmpShlConstConst(Cmp, Shl.getOperand(1), C, *ShiftVal);
    }
    let mut Pred: Predicate = Cmp.getPredicate;
    if C.sle(0) && Shl.hasNoUnsignedWrap && Shl.hasNoSignedWrap {
        return Pred;
    }
    if isEquality(Pred) && C.isZero() && (Shl.hasNoUnsignedWrap || Shl.hasNoSignedWrap) {
        return Pred;
    }
    if Shl.hasNoSignedWrap && (Pred == ICMP_SGT || Pred == ICMP_SLT) {
        if C.isZero() || (if Pred == ICMP_SGT { C.isAllOnes() } else { C.isOne() }) {
            return Pred;
        }
    }
    let mut ShiftAmt: *APInt = null;
    if operator!(match(Shl.getOperand(1))) {
        return foldICmpShlLHSC(Cmp, Shl, C);
    }
    let mut TypeBits: u32 = C.getBitWidth();
    if ShiftAmt.uge(TypeBits) {
        return null;
    }
    let mut X: *mut Value = Shl.getOperand(0);
    let mut ShType: *mut Type = Shl.getType;
    if Shl.hasNoSignedWrap {
        if Pred == ICMP_SGT {
            let mut ShiftedC: APInt = C.ashr(*ShiftAmt);
            return ICmpInst { Pred, X, get(ShType, ShiftedC), "" };
        }
        if (Pred == ICMP_EQ || Pred == ICMP_NE) && C.ashr(*ShiftAmt).shl(*ShiftAmt) == C {
            let mut ShiftedC: APInt = C.ashr(*ShiftAmt);
            return ICmpInst { Pred, X, get(ShType, ShiftedC), "" };
        }
        if Pred == ICMP_SLT {
            assert!(!C.isMinSignedValue(), "Unexpected icmp slt");
            let mut ShiftedC: APInt = (C - 1).ashr(*ShiftAmt) + 1;
            return ICmpInst { Pred, X, get(ShType, ShiftedC), "" };
        }
    }
    if Shl.hasNoUnsignedWrap {
        if Pred == ICMP_UGT {
            let mut ShiftedC: APInt = C.lshr(*ShiftAmt);
            return ICmpInst { Pred, X, get(ShType, ShiftedC), "" };
        }
        if (Pred == ICMP_EQ || Pred == ICMP_NE) && C.lshr(*ShiftAmt).shl(*ShiftAmt) == C {
            let mut ShiftedC: APInt = C.lshr(*ShiftAmt);
            return ICmpInst { Pred, X, get(ShType, ShiftedC), "" };
        }
        if Pred == ICMP_ULT {
            assert!(C.ugt(0), "ult 0 should have been eliminated");
            let mut ShiftedC: APInt = (C - 1).lshr(*ShiftAmt) + 1;
            return ICmpInst { Pred, X, get(ShType, ShiftedC), "" };
        }
    }
    if Cmp.isEquality() && Shl.hasOneUse {
        let mut Mask: *mut Constant = get(ShType, getLowBitsSet(TypeBits, TypeBits - ShiftAmt.getZExtValue()));
        let mut And: *mut Value = null;
        let mut LShrC: *mut Constant = get(ShType, C.lshr(*ShiftAmt));
        return ICmpInst { Pred, And, LShrC, "" };
    }
    let mut TrueIfSigned: bool = false;
    if Shl.hasOneUse && isSignBitCheck(Pred, C, TrueIfSigned) {
        let mut Mask: *mut Constant = get(ShType, getOneBitSet(TypeBits, TypeBits - ShiftAmt.getZExtValue() - 1));
        let mut And: *mut Value = null;
        return ICmpInst { if TrueIfSigned { ICMP_NE } else { ICMP_EQ }, And, getNullValue(ShType), "" };
    }
    if Cmp && Shl.hasOneUse {
        if (C + 1).isPowerOf2() && (Pred == ICMP_ULE || Pred == ICMP_UGT) {
            let mut And: *mut Value = null;
            return ICmpInst { if Pred == ICMP_ULE { ICMP_EQ } else { ICMP_NE }, And, getNullValue(ShType), "" };
        }
        if C.isPowerOf2() && (Pred == ICMP_ULT || Pred == ICMP_UGE) {
            let mut And: *mut Value = null;
            return ICmpInst { if Pred == ICMP_ULT { ICMP_EQ } else { ICMP_NE }, And, getNullValue(ShType), "" };
        }
    }
    let mut Amt: u32 = ShiftAmt.getLimitedValue(TypeBits - 1);
    if Shl.hasOneUse && Amt != 0 && self.shouldChangeType(ShType.getScalarSizeInBits(), TypeBits - Amt) {
        let mut CmpPred: Predicate = Pred;
        let mut RHSC: APInt = C;
        if RHSC.countr_zero() < Amt && isStrictPredicate(CmpPred) {
            if  {
                CmpPred = ;
                RHSC = cast()();
            }
        }
        if RHSC.countr_zero() >= Amt {
            let mut TruncTy: *mut Type = ShType.getWithNewBitWidth(TypeBits - Amt);
            let mut NewC: *mut Constant = get(TruncTy, RHSC.ashr(*ShiftAmt).trunc(TypeBits - Amt));
        }
    }
    return null;
}

fn InstCombinerImpl::foldICmpShrConstant(self, Cmp: *mut ICmpInst, Shr: *mut BinaryOperator, C: *APInt) -> *mut Instruction {
    let mut X: *mut Value = Shr.getOperand(0);
    let mut Pred: Predicate = Cmp.getPredicate;
    if Cmp.isEquality() && Shr.isExact && C.isZero() {
        return Pred;
    }
    let mut IsAShr: bool = Shr.getOpcode() == AShr;
    let mut ShiftValC: *APInt = null;
    if match(X) {
        if Cmp.isEquality() {
            return self.foldICmpShrConstConst(Cmp, Shr.getOperand(1), C, *ShiftValC);
        }
        let mut TrueIfSigned: bool = false;
        if !IsAShr && ShiftValC.isNegative() && isSignBitCheck(Pred, C, TrueIfSigned) {
            return ICmpInst { if TrueIfSigned { ICMP_EQ } else { ICMP_NE }, Shr.getOperand(1), getNullValue(X.getType()), "" };
        }
        if !IsAShr && ShiftValC.isPowerOf2() && (Pred == ICMP_UGT || Pred == ICMP_ULT) {
            let mut IsUGT: bool = Pred == ICMP_UGT;
            assert!(ShiftValC.uge(C), "Expected simplify of compare");
            assert!((IsUGT || !C.isZero()), "Expected X u< 0 to simplify");
            let mut CmpLZ: u32 = if IsUGT { C.countl_zero() } else { (C - 1).countl_zero() };
            let mut ShiftLZ: u32 = ShiftValC.countl_zero();
            let mut NewC: *mut Constant = get(Shr.getType, CmpLZ - ShiftLZ);
            let mut NewPred: auto = if IsUGT { ICMP_ULT } else { ICMP_UGE };
            return ;
        }
    }
    let mut ShiftAmtC: *APInt = null;
    if operator!(match(Shr.getOperand(1))) {
        return null;
    }
    let mut TypeBits: u32 = C.getBitWidth();
    let mut ShAmtVal: u32 = ShiftAmtC.getLimitedValue(TypeBits);
    if ShAmtVal >= TypeBits || ShAmtVal == 0 {
        return null;
    }
    let mut IsExact: bool = Shr.isExact;
    let mut ShrTy: *mut Type = Shr.getType;
    if IsAShr && Shr.hasOneUse {
        if IsExact && (Pred == ICMP_SLT || Pred == ICMP_ULT) && (C - 1).isPowerOf2() && C.countLeadingZeros() > ShAmtVal {
            let mut ShiftedC: APInt = (C - 1).shl(ShAmtVal) + 1;
            return ICmpInst { Pred, X, get(ShrTy, ShiftedC), "" };
        }
        if IsExact || Pred == ICMP_SLT || Pred == ICMP_ULT {
            let mut ShiftedC: APInt = C.shl(ShAmtVal);
            if ShiftedC.ashr(ShAmtVal) == C {
                return ICmpInst { Pred, X, get(ShrTy, ShiftedC), "" };
            }
        }
        if Pred == ICMP_SGT {
            let mut ShiftedC: APInt = (C + 1).shl(ShAmtVal) - 1;
            if !C.isMaxSignedValue() && !(C + 1).shl(ShAmtVal).isMinSignedValue() && (ShiftedC + 1).ashr(ShAmtVal) == (C + 1) {
                return ICmpInst { Pred, X, get(ShrTy, ShiftedC), "" };
            }
        }
        if Pred == ICMP_UGT {
            let mut ShiftedC: APInt = (C + 1).shl(ShAmtVal) - 1;
            if (ShiftedC + 1).ashr(ShAmtVal) == (C + 1) || (C + 1).shl(ShAmtVal).isMinSignedValue() {
                return ICmpInst { Pred, X, get(ShrTy, ShiftedC), "" };
            }
        }
        if C.getBitWidth() > 2 && C.getNumSignBits() <= ShAmtVal {
            if Pred == ICMP_UGT {
                return ICmpInst { ICMP_SLT, X, getNullValue(ShrTy), "" };
            }
            if Pred == ICMP_ULT {
                return ICmpInst { ICMP_SGT, X, getAllOnesValue(ShrTy), "" };
            }
        }
    } else if !IsAShr {
        if Pred == ICMP_ULT || (Pred == ICMP_UGT && IsExact) {
            let mut ShiftedC: APInt = C.shl(ShAmtVal);
            if ShiftedC.lshr(ShAmtVal) == C {
                return ICmpInst { Pred, X, get(ShrTy, ShiftedC), "" };
            }
        }
        if Pred == ICMP_UGT {
            let mut ShiftedC: APInt = (C + 1).shl(ShAmtVal) - 1;
            if (ShiftedC + 1).lshr(ShAmtVal) == (C + 1) {
                return ICmpInst { Pred, X, get(ShrTy, ShiftedC), "" };
            }
        }
    }
    if !Cmp.isEquality() {
        return null;
    }
    assert!(((IsAShr && C.shl(ShAmtVal).ashr(ShAmtVal) == C) || (!IsAShr && C.shl(ShAmtVal).lshr(ShAmtVal) == C)), "Expected icmp+shr simplify did not occur.");
    if Shr.isExact {
        return ICmpInst { Pred, X, get(ShrTy, C << ShAmtVal), "" };
    }
    if Shr.hasOneUse {
        let mut Val: APInt = getHighBitsSet(TypeBits, TypeBits - ShAmtVal);
        let mut Mask: *mut Constant = get(ShrTy, Val);
        let mut And: *mut Value = null;
        return ICmpInst { Pred, And, get(ShrTy, C << ShAmtVal), "" };
    }
    return null;
}

fn InstCombinerImpl::foldICmpSRemConstant(self, Cmp: *mut ICmpInst, SRem: *mut BinaryOperator, C: *APInt) -> *mut Instruction {
    let mut Pred: Predicate = Cmp.getPredicate;
    if Pred == ICMP_UGT || Pred == ICMP_ULT {
        let mut DivisorC: *APInt = null;
        if operator!(match(SRem.getOperand(1))) {
            return null;
        }
        if DivisorC.isZero() {
            return null;
        }
        let mut NormalizedC: APInt = C;
        if Pred == ICMP_ULT {
            assert!(!NormalizedC.isZero(), "ult X, 0 should have been simplified already.");
            operator(NormalizedC);
        }
        if C.isNegative() {
            NormalizedC.flipAllBits();
        }
        if !NormalizedC.uge(DivisorC.abs() - 1) {
            return null;
        }
        let mut Ty: *mut Type = SRem.getType;
    }
    if Pred != ICMP_SGT && Pred != ICMP_SLT && Pred != ICMP_EQ && Pred != ICMP_NE {
        return null;
    }
    if operator!(SRem.hasOneUse) {
        return null;
    }
    let mut DivisorC: *APInt = null;
    if operator!(match(SRem.getOperand(1))) {
        return null;
    }
    if ((Pred == ICMP_SGT || Pred == ICMP_SLT) && !C.isZero()) || ((Pred == ICMP_EQ || Pred == ICMP_NE) && !C.isStrictlyPositive()) {
        return null;
    }
    let mut Ty: *mut Type = SRem.getType;
    let mut SignMask: APInt = getSignMask(Ty.getScalarSizeInBits());
    let mut MaskC: *mut Constant = get(Ty, SignMask | (*DivisorC - 1));
    let mut And: *mut Value = null;
    if Pred == ICMP_EQ || Pred == ICMP_NE {
        return ICmpInst { Pred, And, get(Ty, C), "" };
    }
    if Pred == ICMP_SGT {
        return ICmpInst { ICMP_SGT, And, getNullValue(Ty), "" };
    }
    return ICmpInst { ICMP_UGT, And, get(Ty, SignMask), "" };
}

fn InstCombinerImpl::foldICmpUDivConstant(self, Cmp: *mut ICmpInst, UDiv: *mut BinaryOperator, C: *APInt) -> *mut Instruction {
    let mut Pred: Predicate = Cmp.getPredicate;
    let mut X: *mut Value = UDiv.getOperand(0);
    let mut Y: *mut Value = UDiv.getOperand(1);
    let mut Ty: *mut Type = UDiv.getType;
    let mut C2: *APInt = null;
    if operator!(match(X)) {
        return null;
    }
    assert!(*C2 != 0, "udiv 0, X should have been simplified already.");
    if Pred == ICMP_UGT {
        assert!(!C.isMaxValue(), "icmp ugt X, UINT_MAX should have been simplified already.");
        return ICmpInst { ICMP_ULE, Y, get(Ty, C2.udiv(C + 1)), "" };
    }
    if Pred == ICMP_ULT {
        assert!(C != 0, "icmp ult X, 0 should have been simplified already.");
        return ICmpInst { ICMP_UGT, Y, get(Ty, C2.udiv(C)), "" };
    }
    return null;
}

fn InstCombinerImpl::foldICmpDivConstant(self, Cmp: *mut ICmpInst, Div: *mut BinaryOperator, C: *APInt) -> *mut Instruction {
    let mut Pred: Predicate = Cmp.getPredicate;
    let mut X: *mut Value = Div.getOperand(0);
    let mut Y: *mut Value = Div.getOperand(1);
    let mut Ty: *mut Type = Div.getType;
    let mut DivIsSigned: bool = Div.getOpcode() == SDiv;
    if Cmp.isEquality() && Div.hasOneUse && C.isSignBitSet() && (!DivIsSigned || C.isMinSignedValue()) {
        let mut XBig: *mut Value = null;
        let mut YOne: *mut Value = null;
        let mut Logic: auto = if Pred == ICMP_EQ { And } else { Or };
        return Create(XBig, YOne);
    }
    let mut C2: *APInt = null;
    if operator!(match(Y)) {
        return null;
    }
    if !Cmp.isEquality() && DivIsSigned != Cmp {
        if !DivIsSigned || !C2.isStrictlyPositive() || operator!(isKnownNonNegative(X)) {
            return null;
        }
        DivIsSigned = false;
    }
    if C2.isZero() || C2.isOne() || (DivIsSigned && C2.isAllOnes()) {
        return null;
    }
    let mut Prod: APInt = C * *C2;
    let mut ProdOV: bool = (if DivIsSigned { Prod.sdiv(*C2) } else { Prod.udiv(*C2) }) != C;
    let mut RangeSize: APInt = if Div.isExact { APInt { C2.getBitWidth(), 1, false, false } } else { *C2 };
    let mut LoOverflow: i32 = 0;
    let mut HiOverflow: i32 = 0;
    let mut LoBound: APInt = APInt {};
    let mut HiBound: APInt = APInt {};
    if !DivIsSigned {
        LoBound = Prod;
        HiOverflow = LoOverflow = ProdOV;
        if !HiOverflow {
            HiOverflow = addWithOverflow(HiBound, LoBound, RangeSize, false);
        }
    } else if C2.isStrictlyPositive() {
        if C.isZero() {
            LoBound = operator((RangeSize - 1));
            HiBound = RangeSize;
        } else if C.isStrictlyPositive() {
            LoBound = Prod;
            HiOverflow = LoOverflow = ProdOV;
            if !HiOverflow {
                HiOverflow = addWithOverflow(HiBound, Prod, RangeSize, true);
            }
        } else {
            HiBound = Prod + 1;
            LoOverflow = HiOverflow = if ProdOV { -1 } else { 0 };
            if !LoOverflow {
                let mut DivNeg: APInt = operator(RangeSize);
                LoOverflow = if addWithOverflow(LoBound, HiBound, DivNeg, true) { -1 } else { 0 };
            }
        }
    } else if C2.isNegative() {
        if Div.isExact {
            RangeSize.negate();
        }
        if C.isZero() {
            LoBound = RangeSize + 1;
            HiBound = operator(RangeSize);
            if HiBound == *C2 {
                HiOverflow = 1;
                HiBound = APInt {};
            }
        } else if C.isStrictlyPositive() {
            HiBound = Prod + 1;
            HiOverflow = LoOverflow = if ProdOV { -1 } else { 0 };
            if !LoOverflow {
                LoOverflow = if addWithOverflow(LoBound, HiBound, RangeSize, true) { -1 } else { 0 };
            }
        } else {
            LoBound = Prod;
            LoOverflow = HiOverflow = ProdOV;
            if !HiOverflow {
                HiOverflow = subWithOverflow(HiBound, Prod, RangeSize, true);
            }
        }
        Pred = getSwappedPredicate(Pred);
    }
    match Pred {
        _ => {
            llvm_unreachable_internal("Unhandled icmp predicate!", "llvm\\lib\\Transforms\\InstCombine\\InstCombineCompares.cpp", 3001);
        },
        ICMP_EQ => {
            if LoOverflow && HiOverflow {
                return self.replaceInstUsesWith;
            }
        },
        ICMP_NE => {
            if LoOverflow && HiOverflow {
                return self.replaceInstUsesWith;
            }
        },
        ICMP_ULT => {
            ICMP_SLT;
        },
        ICMP_UGT => {
            ICMP_SGT;
        },
    }
    return null;
}

fn InstCombinerImpl::foldICmpSubConstant(self, Cmp: *mut ICmpInst, Sub: *mut BinaryOperator, C: *APInt) -> *mut Instruction {
    let mut X: *mut Value = Sub.getOperand(0);
    let mut Y: *mut Value = Sub.getOperand(1);
    let mut Pred: Predicate = Cmp.getPredicate;
    let mut Ty: *mut Type = Sub.getType;
    let mut D: *APInt = null;
    if match(Y, m_URem(m_Specific(X))) && !D.isZero() {
        if Pred == ICMP_UGT && C.ult(*D) {
            return ICmpInst { ICMP_UGT, X, get(Ty, *D - 1), "" };
        }
        if Pred == ICMP_ULT && !C.isZero() && C.ule(*D) {
            return ICmpInst { ICMP_ULT, X, get(Ty, *D), "" };
        }
    }
    let mut SubC: *mut Constant = null;
    if Cmp.isEquality() && match(X, m_ImmConstant(SubC)) {
        return ICmpInst { Pred, Y, getSub(SubC, get(Ty, C), false, false), "" };
    }
    let mut C2: *APInt = null;
    let mut SubResult: APInt = APInt {};
    let mut SwappedPred: Predicate = Cmp;
    let mut HasNSW: bool = Sub.hasNoSignedWrap;
    let mut HasNUW: bool = Sub.hasNoUnsignedWrap;
    if match(X) && ((Cmp && HasNUW) || (Cmp && HasNSW)) && !subWithOverflow(SubResult, *C2, C, Cmp) {
        return ICmpInst { SwappedPred, Y, get(Ty, SubResult), "" };
    }
    if Cmp.isEquality() && C.isZero() && none_of((Sub()()), Closure_9 {}) {
        return ICmpInst { Pred, X, Y, "" };
    }
    if operator!(Sub.hasOneUse) {
        return null;
    }
    if Sub.hasNoSignedWrap {
        if Pred == ICMP_SGT && C.isAllOnes() {
            return ICmpInst { ICMP_SGE, X, Y, "" };
        }
        if Pred == ICMP_SGT && C.isZero() {
            return ICmpInst { ICMP_SGT, X, Y, "" };
        }
        if Pred == ICMP_SLT && C.isZero() {
            return ICmpInst { ICMP_SLT, X, Y, "" };
        }
        if Pred == ICMP_SLT && C.isOne() {
            return ICmpInst { ICMP_SLE, X, Y, "" };
        }
    }
    if operator!(match(X)) {
        return null;
    }
    let mut Add: *mut Value = null;
    return ICmpInst { SwappedPred, Add, get(Ty, operator(C)), "" };
}

fn createLogicFromTable(Table: *bitset<4>, Op0: *mut Value, Op1: *mut Value, Builder: *mut IRBuilderBase, HasOneUse: bool) -> *mut Value {
    let mut FoldConstant: Closure_10 = Closure_10 { Builder: &mut Builder, Op0: &mut Op0 };
    match Table()() {
        0 => {
            return FoldConstant.call(false);
        },
        1 => {
            return if HasOneUse { Builder.CreateNot(Builder.CreateOr(Op0, Op1, "", false), "") } else { null };
        },
        2 => {
            return if HasOneUse { Builder.CreateAnd(Builder.CreateNot(Op0, ""), Op1, "") } else { null };
        },
        3 => {
            return Builder.CreateNot(Op0, "");
        },
        4 => {
            return if HasOneUse { Builder.CreateAnd(Op0, Builder.CreateNot(Op1, ""), "") } else { null };
        },
        5 => {
            return Builder.CreateNot(Op1, "");
        },
        6 => {
            return Builder.CreateXor(Op0, Op1, "");
        },
        7 => {
            return if HasOneUse { Builder.CreateNot(Builder.CreateAnd(Op0, Op1, ""), "") } else { null };
        },
        8 => {
            return Builder.CreateAnd(Op0, Op1, "");
        },
        9 => {
            return if HasOneUse { Builder.CreateNot(Builder.CreateXor(Op0, Op1, ""), "") } else { null };
        },
        10 => {
            return Op1;
        },
        11 => {
            return if HasOneUse { Builder.CreateOr(Builder.CreateNot(Op0, ""), Op1, "", false) } else { null };
        },
        12 => {
            return Op0;
        },
        13 => {
            return if HasOneUse { Builder.CreateOr(Op0, Builder.CreateNot(Op1, ""), "", false) } else { null };
        },
        14 => {
            return Builder.CreateOr(Op0, Op1, "", false);
        },
        15 => {
            return FoldConstant.call(true);
        },
        _ => {
            llvm_unreachable_internal("Invalid Operation", "llvm\\lib\\Transforms\\InstCombine\\InstCombineCompares.cpp", 3187);
        },
    }
    return null;
}

fn InstCombinerImpl::foldICmpBinOpWithConstantViaTruthTable(self, Cmp: *mut ICmpInst, BO: *mut BinaryOperator, C: *APInt) -> *mut Instruction {
    let mut A: *mut Value = null;
