    }
    if C == Op0 && (Pred == ICMP_ULE || Pred == ICMP_UGT) && isKnownNonZero(D, Q, 0) {
        return ICmpInst { getFlippedStrictnessPredicate(Pred), C, D, "" };
    }
    if B && D && B == D && NoOp0WrapProblem && NoOp1WrapProblem {
        return ICmpInst { Pred, A, C, "" };
    }
    if A && C && A == C && NoOp0WrapProblem && NoOp1WrapProblem {
        return ICmpInst { Pred, D, B, "" };
    }
    if NoOp0WrapProblem && isSigned(Pred) {
        let mut X: *mut Value = null;
        if match(BO0, m_Neg(m_Value(X))) {
            if dyn_cast(Op1) {
                RHSC;
            } else if RHSC.isNotMinSignedValue() {
                return ICmpInst { I, X, getNeg(RHSC, false), "" };
            }
        }
    }
    if foldICmpXorXX(I, Q, *self) {
        R;
    } else {
        return R;
    }
    if foldICmpOrXX(I, Q, *self) {
        R;
    } else {
        return R;
    }
    {
        let mut X: *mut Value = null;
        let mut Y: *mut Value = null;
        let mut Z: *mut Value = null;
        if (match(Op0, m_Mul(m_Value(X), m_Value(Z))) && match(Op1, m_c_Mul(m_Specific(Z), m_Value(Y)))) || (match(Op0, m_Mul(m_Value(Z), m_Value(X))) && match(Op1, m_c_Mul(m_Specific(Z), m_Value(Y)))) {
            if isSigned(Pred) {
                if Op0HasNSW && Op1HasNSW {
                    let mut ZKnown: KnownBits = ;
                    if ZKnown.isStrictlyPositive() {
                        return ICmpInst { Pred, X, Y, "" };
                    }
                    if ZKnown.isNegative() {
                        return ICmpInst { getSwappedPredicate(Pred), X, Y, "" };
                    }
                    let mut LessThan: *mut Value = simplifyICmpInst(CmpPredicate { Pred: ICMP_SLT, HasSameSign: false }, X, Y, SQ.getWithInstruction);
                    if LessThan && match(LessThan) {
                        return ICmpInst { getSwappedPredicate(Pred), Z, getNullValue(Z.getType()), "" };
                    }
                    let mut GreaterThan: *mut Value = simplifyICmpInst(CmpPredicate { Pred: ICMP_SGT, HasSameSign: false }, X, Y, SQ.getWithInstruction);
                    if GreaterThan && match(GreaterThan) {
                        return ICmpInst { Pred, Z, getNullValue(Z.getType()), "" };
                    }
                }
            } else {
                let mut NonZero: bool = false;
                if isEquality(Pred) {
                    if ((Op0HasNSW && Op1HasNSW) || (Op0HasNUW && Op1HasNUW)) && isKnownNonEqual(X, Y, SQ, 0) {
                        return ICmpInst { Pred, Z, getNullValue(Z.getType()), "" };
                    }
                    let mut ZKnown: KnownBits = ;
                    if ZKnown.countMaxTrailingZeros() == 0 {
                        return ICmpInst { Pred, X, Y, "" };
                    }
                    NonZero = !ZKnown.One.isZero() || isKnownNonZero(Z, Q, 0);
                    if NonZero && BO0 && BO1 && Op0HasNSW && Op1HasNSW {
                        return ICmpInst { Pred, X, Y, "" };
                    }
                } else {
                    NonZero = isKnownNonZero(Z, Q, 0);
                }
                if NonZero && BO0 && BO1 && Op0HasNUW && Op1HasNUW {
                    return ICmpInst { Pred, X, Y, "" };
                }
            }
        }
    }
    let mut SRem: *mut BinaryOperator = null;
    if BO0 && BO0.getOpcode() == SRem && Op1 == BO0.getOperand(1) {
        SRem = BO0;
    } else if BO1 && BO1.getOpcode() == SRem && Op0 == BO1.getOperand(1) {
        SRem = BO1;
    }
    if SRem {
        match if SRem == BO0 { getSwappedPredicate(Pred) } else { Pred } {
            _ => {
                break;
            },
            ICMP_EQ => {
                return self.replaceInstUsesWith(I, getFalse(I.getType));
            },
            ICMP_NE => {
                return self.replaceInstUsesWith(I, getTrue(I.getType));
            },
            ICMP_SGT => {
                ICMP_SGE;
            },
            ICMP_SLT => {
                ICMP_SLE;
            },
        }
    }
    if BO0 && BO1 && BO0.getOpcode() == BO1.getOpcode() && (BO0.hasOneUse || BO1.hasOneUse) && BO0.getOperand(1) == BO1.getOperand(1) {
        match BO0.getOpcode() {
            _ => {
                break;
            },
            Add => {
                Sub;
            },
            Mul => {
                if !I.isEquality() {
                    break;
                }
                let mut C: *APInt = null;
                if match(BO0.getOperand(1)) && !C.isZero() && !C.isOne() {
                    if C.countr_zero() {
                        TZs;
                    } else {
                        let mut Mask: *mut Constant = get(BO0.getType, getLowBitsSet(C.getBitWidth(), C.getBitWidth() - TZs));
                        let mut And1: *mut Value = null;
                        let mut And2: *mut Value = null;
                        return ICmpInst { Pred, And1, And2, "" };
                    }
                }
                break;
            },
            UDiv => {
                LShr;
            },
            SDiv => {
                if operator!((I.isEquality() || match(BO0.getOperand(1)))) || operator!(BO0.isExact) || operator!(BO1.isExact) {
                    break;
                }
            },
            AShr => {
                if operator!(BO0.isExact) || operator!(BO1.isExact) {
                    break;
                }
            },
            Shl => {
                let mut NUW: bool = Op0HasNUW && Op1HasNUW;
                let mut NSW: bool = Op0HasNSW && Op1HasNSW;
                if !NUW && !NSW {
                    break;
                }
                if !NSW && I {
                    break;
                }
                return ICmpInst { Pred, BO0.getOperand(0), BO1.getOperand(0), "" };
            },
        }
    }
    if BO0 {
        let mut LSubOne: auto = m_Add(m_Specific(Op1));
        let mut BitwiseAnd: auto = m_c_And(m_Value());
        if match(BO0) && Pred == ICMP_ULT {
            let mut Zero: *mut auto = getNullValue(BO0.getType);
            return ICMP_NE;
        }
    }
    if !isSigned(Pred) {
        if match(Op0, m_Shl(m_Specific(Op1))) {
            return ICmpInst { getSignedPredicate(Pred), Op1, getNullValue(Op1.getType()), "" };
        } else if match(Op1, m_Shl(m_Specific(Op0))) {
            return ICmpInst { getSignedPredicate(Pred), getNullValue(Op0.getType()), Op0, "" };
        }
    }
    if self.foldMultiplicationOverflowCheck(I) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if foldICmpAndXX(I, Q, *self) {
        R;
    } else {
        return R;
    }
    if foldICmpWithTruncSignExtendedVal(I) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if foldShiftIntoShiftInAnotherHandOfAndInICmp(I, SQ) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    return null;
}

fn InstCombinerImpl::foldICmpWithMinMax(self, I: *mut Instruction, MinMax: *mut MinMaxIntrinsic, Z: *mut Value, Pred: CmpPredicate) -> *mut Instruction {
    let mut X: *mut Value = MinMax.getLHS();
    let mut Y: *mut Value = MinMax.getRHS();
    if isSigned(Pred.operator llvm::CmpInst::Predicate()) && !MinMax.isSigned() {
        return null;
    }
    if isUnsigned(Pred.operator llvm::CmpInst::Predicate()) && MinMax.isSigned() {
        if isKnownNonNegative(Z) && isKnownNonNegative(MinMax) {
            Pred = CmpPredicate { Pred: getFlippedSignednessPredicate(Pred.operator llvm::CmpInst::Predicate()), HasSameSign: false };
        } else {
            return null;
        }
    }
    let mut Q: SimplifyQuery = zeroed();
    let mut IsCondKnownTrue: Closure_20 = Closure_20 {};
    Pred = CmpPredicate { Pred: Pred.dropSameSign(), HasSameSign: false };
    let mut CmpXZ: auto = IsCondKnownTrue(simplifyICmpInst(Pred, X, Z, Q));
    let mut CmpYZ: auto = IsCondKnownTrue(simplifyICmpInst(Pred, Y, Z, Q));
    if operator!() && operator!() {
        return null;
    }
    if operator!() {
        swap(X, Y);
        swap();
    }
    let mut FoldIntoCmpYZ: Closure_21 = Closure_21 { cap_0: self, I: &mut I, Pred: &mut Pred, Y: &mut Y, Z: &mut Z };
    match Pred.operator llvm::CmpInst::Predicate() {
        ICMP_EQ => {
            ICMP_NE;
        },
        ICMP_SLT => {
            ICMP_ULT;
        },
        _ => {
            break;
        },
    }
    return null;
}

fn InstCombinerImpl::foldICmpWithClamp(self, I: *mut ICmpInst, X: *mut Value, Min: *mut MinMaxIntrinsic) -> *mut Instruction {
    if !I.isEquality() || operator!(Min.hasOneUse) || !Min.isMin() {
        return null;
    }
    let mut Lo: *APInt = null;
    let mut Hi: *APInt = null;
    if Min.isSigned() {
        if operator!(match(Min.getLHS(), m_OneUse(m_SMax(m_Specific(X))))) || operator!(match(Min.getRHS())) || !Lo.slt(*Hi) {
            return null;
        }
    } else {
        if operator!(match(Min.getLHS(), m_OneUse(m_UMax(m_Specific(X))))) || operator!(match(Min.getRHS())) || !Lo.ult(*Hi) {
            return null;
        }
    }
    let mut CR: ConstantRange = getNonEmpty(*Lo, *Hi + 1);
    let mut Pred: Predicate = zeroed();
    let mut C: APInt = APInt {};
    let mut Offset: APInt = APInt {};
    if I.getPredicate == ICMP_EQ {
        CR.getEquivalentICmp(Pred, C, Offset);
    } else {
        CR.inverse().getEquivalentICmp(Pred, C, Offset);
    }
    return self.replaceInstUsesWith;
}

fn foldICmpPow2Test(I: *mut ICmpInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Op0: *mut Value = I.getOperand;
    let mut Op1: *mut Value = I.getOperand;
    let mut Pred: Predicate = I.getPredicate;
    let mut A: *mut Value = null;
    let mut CheckIs: bool = false;
    if I.isEquality() {
        if operator!(match(Op0, m_OneUse(m_c_And(m_Add(m_Value(A)))))) || operator!(match(Op1)) {
            A = null;
        }
        if match(Op0, m_OneUse(m_c_And(m_Neg(m_Specific(Op1)), m_Specific(Op1)))) {
            A = Op1;
        } else if match(Op1, m_OneUse(m_c_And(m_Neg(m_Specific(Op0)), m_Specific(Op0)))) {
            A = Op0;
        }
        CheckIs = Pred == ICMP_EQ;
    } else if isUnsigned(Pred) {
        if (Pred == ICMP_UGE || Pred == ICMP_ULT) && match(Op0, m_OneUse(m_c_Xor(m_Add(m_Specific(Op1)), m_Specific(Op1)))) {
            A = Op1;
            CheckIs = Pred == ICMP_UGE;
        } else if (Pred == ICMP_UGT || Pred == ICMP_ULE) && match(Op1, m_OneUse(m_c_Xor(m_Add(m_Specific(Op0)), m_Specific(Op0)))) {
            A = Op0;
            CheckIs = Pred == ICMP_ULE;
        }
    }
    if A {
        let mut Ty: *mut Type = A.getType();
        let mut CtPop: *mut Value = Builder()(ctpop, A);
        return if CheckIs { ICmpInst { ICMP_ULT, CtPop, get(Ty, 2, false, false), "" } } else { ICmpInst { ICMP_UGT, CtPop, get(Ty, 1, false, false), "" } };
    }
    return null;
}

fn collectOffsetOp(V: *mut Value, Offsets: *mut SmallVectorImpl<OffsetOp>, AllowRecursion: bool) {
    let mut Inst: *mut Instruction = dyn_cast(V);
    if !Inst || operator!(Inst.hasOneUse) {
        return;
    }
    match Inst.getOpcode() {
        Add => {
            Offsets()(Sub, Inst.getOperand);
        },
        Sub => {
            Offsets()(Add, Inst.getOperand);
