            SI;
        } else {
            let mut A: *mut Value = null;
            let mut B: *mut Value = null;
            let mut SPR: SelectPatternResult = matchSelectPattern(SI, A, B);
            let mut IsRedundantMinMaxClamp: bool = (SPR.Flavor == SPF_FMAXNUM || SPR.Flavor == SPF_FMINNUM) && isMinMaxCmpSelectEliminable(SPR.Flavor, A, B);
            if SPR.Flavor != SPF_UNKNOWN && !IsRedundantMinMaxClamp {
                return null;
            }
