        let mut ShareCommonDivisor: Closure_19 = Closure_19 { Q: &mut Q };
        let mut IsNegative: bool = isLT(Pred) || isGE(Pred);
        let mut IsAddOrSignedPred: bool = !IsNegative || isSigned(Pred);
        if A && NoOp0WrapProblem && IsAddOrSignedPred && ShareCommonDivisor.call(A, Op1, B, IsNegative) {
            return ICmpInst { getFlippedStrictnessPredicate(Pred), A, Op1, "" };
        }
        if C && NoOp1WrapProblem && ShareCommonDivisor.call(Op0, C, D, isGT(Pred) || isLE(Pred)) {
            return ICmpInst { getFlippedStrictnessPredicate(Pred), Op0, C, "" };
