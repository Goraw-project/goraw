fn isIdempotentRMW(RMWI: *mut AtomicRMWInst) -> bool {
    if dyn_cast(RMWI.getValOperand()) {
        CF;
    } else {
        match RMWI.getOperation() {
            FAdd => {
                return CF.isZero() && CF.isNegative();
            },
            FSub => {
                return CF.isZero() && !CF.isNegative();
            },
            _ => {
                return false;
            },
        }
    }
    let mut C: CastReturnType = dyn_cast(RMWI.getValOperand());
    if !C {
        return false;
    }
    match RMWI.getOperation() {
        Add => {
            Sub;
        },
        And => {
            return C.isMinusOne();
        },
        Min => {
            return C.isMaxValue(true);
        },
        Max => {
            return C.isMinValue(true);
        },
        UMin => {
            return C.isMaxValue(false);
        },
        UMax => {
            return C.isMinValue(false);
        },
        _ => {
            return false;
        },
    }
}

fn isSaturating(RMWI: *mut AtomicRMWInst) -> bool {
    if dyn_cast(RMWI.getValOperand()) {
        CF;
    } else {
        match RMWI.getOperation() {
            FMax => {
                return !CF.isNegative() && CF.isInfinity();
            },
            FMin => {
                return CF.isNegative() && CF.isInfinity();
            },
            FAdd => {
                FSub;
            },
            _ => {
                return false;
            },
        }
    }
    let mut C: CastReturnType = dyn_cast(RMWI.getValOperand());
    if !C {
        return false;
    }
    match RMWI.getOperation() {
        _ => {
            return false;
        },
        Xchg => {
            return true;
        },
        Or => {
            return C.isAllOnesValue();
        },
        And => {
            return C.isZero();
        },
        Min => {
            return C.isMinValue(true);
        },
        Max => {
            return C.isMaxValue(true);
        },
        UMin => {
            return C.isMinValue(false);
        },
        UMax => {
            return C.isMaxValue(false);
        },
    }
}

fn InstCombinerImpl::visitAtomicRMWInst(self, RMWI: *mut AtomicRMWInst) -> *mut Instruction {
    if RMWI.isVolatile() {
        return null;
    }
    if isSaturating(RMWI) && RMWI.getOperation() != Xchg {
        RMWI.setOperation(Xchg);
        return &mut RMWI;
    }
    assert!(RMWI.getOrdering() != NotAtomic && RMWI.getOrdering() != Unordered, "AtomicRMWs don't make sense with Unordered or NotAtomic");
    let mut Op: BinOp = RMWI.getOperation();
    if Op == Add || Op == Sub {
        let mut Val: *mut Value = RMWI.getValOperand();
        let mut X: *mut Value = null;
        if match(Val, m_Neg(m_Value(X))) {
            RMWI.setOperation(if Op == Add { Sub } else { Add });
            return self.replaceOperand(RMWI, 1, X);
        }
    }
    if !isIdempotentRMW(RMWI) {
        return null;
    }
    if RMWI.getType().isIntegerTy() && RMWI.getOperation() != Or {
        RMWI.setOperation(Or);
        return self.replaceOperand(RMWI, 1, get(RMWI.getType(), 0, false, false));
    } else if RMWI.getType().isFloatingPointTy() && RMWI.getOperation() != FAdd {
        RMWI.setOperation(FAdd);
        return self.replaceOperand(RMWI, 1, getNegativeZero(RMWI.getType()));
    }
    return null;
}
