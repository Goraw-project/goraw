//     if match(&mut I, m_c_BinOp(AddOp, m_BinOp(MulOp, m_Value(A), m_Deferred(A)), m_OneUse(m_c_BinOp(MulOp, m_c_BinOp(AddOp, m_BinOp(Mul2Op, m_Deferred(A), M2Rhs), m_Value(B)), m_Deferred(B))))) {
//         return true;
