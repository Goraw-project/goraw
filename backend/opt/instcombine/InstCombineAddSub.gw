    }
    if isa(Op0) {
        if dyn_cast(Op1) {
            SI;
        } else if self.FoldOpIntoSelect {
            NV;
        } else {
            return NV;
        }
    }
    if match(Op1, m_ImmConstant(C)) {
        if ConstantFoldUnaryOpOperand(FNeg, C) {
            NegC;
        } else {
            return CreateFAddFMF(Op0, NegC, &mut I);
