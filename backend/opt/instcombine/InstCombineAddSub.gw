fn MatchMul(E: *mut Value, Op: *mut *mut Value, C: *mut APInt) -> bool {
    let mut AI: *APInt = null;
    if match(E, m_Mul(m_Value(Op))) {
        C = *AI;
        return true;
    }
    if match(E, m_Shl(m_Value(Op))) {
        C = APInt { AI.getBitWidth(), 1, false, false };
        operator(C, *AI);
        return true;
    }
    return false;
}

fn MatchRem(E: *mut Value, Op: *mut *mut Value, C: *mut APInt, IsSigned: *mut bool) -> bool {
    let mut AI: *APInt = null;
    IsSigned = false;
    if match(E, m_SRem(m_Value(Op))) {
        IsSigned = true;
        C = *AI;
        return true;
    }
    if match(E, m_URem(m_Value(Op))) {
        C = *AI;
        return true;
    }
    if match(E, m_And(m_Value(Op))) && (*AI + 1).isPowerOf2() {
        C = *AI + 1;
        return true;
    }
    return false;
}

fn MatchDiv(E: *mut Value, Op: *mut *mut Value, C: *mut APInt, IsSigned: bool) -> bool {
    let mut AI: *APInt = null;
    if IsSigned && match(E, m_SDiv(m_Value(Op))) {
        C = *AI;
        return true;
    }
    if !IsSigned {
        if match(E, m_UDiv(m_Value(Op))) {
            C = *AI;
            return true;
        }
        if match(E, m_LShr(m_Value(Op))) {
            C = APInt { AI.getBitWidth(), 1, false, false };
            operator(C, *AI);
            return true;
        }
    }
    return false;
}

fn MulWillOverflow(C0: *mut APInt, C1: *mut APInt, IsSigned: bool) -> bool {
    let mut overflow: bool = false;
    if IsSigned {
        C0.smul_ov(C1, overflow) as void;
    } else {
        C0.umul_ov(C1, overflow) as void;
    }
    return overflow;
}

fn InstCombinerImpl::SimplifyAddWithRemainder(self, I: *mut BinaryOperator) -> *mut Value {
    let mut LHS: *mut Value = I.getOperand(0);
    let mut RHS: *mut Value = I.getOperand(1);
    let mut X: *mut Value = null;
    let mut MulOpV: *mut Value = null;
    let mut C0: APInt = APInt {};
    let mut MulOpC: APInt = APInt {};
    let mut IsSigned: bool = false;
    if ((MatchRem(LHS, X, C0, IsSigned) && MatchMul(RHS, MulOpV, MulOpC)) || (MatchRem(RHS, X, C0, IsSigned) && MatchMul(LHS, MulOpV, MulOpC))) && C0 == MulOpC {
        let mut RemOpV: *mut Value = null;
        let mut C1: APInt = APInt {};
        let mut Rem2IsSigned: bool = false;
        if MatchRem(MulOpV, RemOpV, C1, Rem2IsSigned) && IsSigned == Rem2IsSigned {
            let mut DivOpV: *mut Value = null;
            let mut DivOpC: APInt = APInt {};
            if MatchDiv(RemOpV, DivOpV, DivOpC, IsSigned) && X == DivOpV && C0 == DivOpC && !MulWillOverflow(C0, C1, IsSigned) {
                let mut NewDivisor: *mut Value = get(X.getType(), C0 * C1);
            }
        }
    }
    let mut FoldDivRem: Closure_1 = Closure_1 { I: &mut I, X: &mut X, C0: &mut C0, IsSigned: &mut IsSigned, cap_4: self };
    if FoldDivRem.call(LHS, RHS) {
        V;
    } else {
        return V;
    }
    if FoldDivRem.call(RHS, LHS) {
        V;
    } else {
        return V;
    }
    return null;
}

fn canonicalizeLowbitMask(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut NBits: *mut Value = null;
    if operator!(match(&mut I, m_Add(m_OneUse(m_Shl(m_Value(NBits)))))) {
