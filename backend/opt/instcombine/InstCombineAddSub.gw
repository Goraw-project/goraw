    cap_0: *mut Type,
}

fn Closure_17::call(self: *Closure_17) {
            let mut Cond: *mut Value = null;
            let mut TrueVal: *mut Value = null;
            let mut FalseVal: *mut Value = null;
            if !match(Select, m_OneUse(m_Select(m_Value(Cond), m_Value(TrueVal), m_Value(FalseVal)))) {
                return null;
            }
            if OtherHandOfSub != TrueVal && OtherHandOfSub != FalseVal {
                return null;
            }
            let mut OtherHandOfSubIsTrueVal: bool = OtherHandOfSub == TrueVal;
            let mut NewSub: *mut Value = SubBuilder(if OtherHandOfSubIsTrueVal { FalseVal } else { TrueVal });
            let mut Zero: *mut Constant = getNullValue(Ty);
            let mut NewSel: *mut SelectInst = Create(Cond, if OtherHandOfSubIsTrueVal { Zero } else { NewSub }, if OtherHandOfSubIsTrueVal { NewSub } else { Zero }, "", null, null);
            NewSel.copyMetadata(cast(*Select), ArrayRef<unsigned int> {});
            return NewSel;
        }

