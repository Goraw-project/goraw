struct Closure_20 {
    Op0: *mut *mut Value,
    cap_1: *mut InstCombinerImpl,
    LHSOp: *mut *mut Value,
    Op1: *mut *mut Value,
    RHSOp: *mut *mut Value,
}

unsafe fn Closure_20::call(self: *mut Closure_20) -> bool {
        if match((*self.Op0), m_ZExt(m_PtrToIntSameSize(self.DL, m_Value((*self.LHSOp))))) && match((*self.Op1), m_ZExt(m_PtrToIntSameSize(self.DL, m_Value((*self.RHSOp))))) {
            return true;
        }
        if match((*self.Op0), m_ZExt(m_PtrToAddr(m_Value((*self.LHSOp))))) && match((*self.Op1), m_ZExt(m_PtrToAddr(m_Value((*self.RHSOp))))) {
            return true;
        }
        if match((*self.Op0), m_ZExt(m_PtrToIntSameSize(self.DL, m_Value((*self.LHSOp))))) && match((*self.Op1), m_PtrToInt(m_Value((*self.RHSOp)))) {
            return true;
        }
        return false;
    }

