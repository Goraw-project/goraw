fn InstCombinerImpl::foldSquareSumInt(self, I: *mut BinaryOperator) -> *mut Instruction {
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    if matchesSquareSum(I, m_SpecificInt(1), A, B) {
        let mut AB: *mut Value = self.Builder.CreateAdd(A, B, "", false, false);
        return CreateMul(AB, AB, "");
    }
    return null;
}

fn InstCombinerImpl::foldSquareSumFP(self, I: *mut BinaryOperator) -> *mut Instruction {
    assert!(I.hasAllowReassoc() && I.hasNoSignedZeros(), "Assumption mismatch");
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    if matchesSquareSum(I, m_SpecificFP(2.0), A, B) {
        let mut AB: *mut Value = self.Builder.CreateFAddFMF(A, B, &mut I, "", null);
        return CreateFMulFMF(AB, AB, &mut I, "");
    }
    return null;
}

fn MatchMul(E: *mut Value, Op: *mut *mut Value, C: *mut APInt) -> bool {
    let mut AI: *APInt = null;
    if match(E, m_Mul(m_Value(Op), m_APInt(AI))) {
        C = *AI;
        return true;
    }
    if match(E, m_Shl(m_Value(Op), m_APInt(AI))) {
        C = APInt { AI.getBitWidth(), 1, false, false };
        operator(C, *AI);
        return true;
    }
    return false;
}

fn MatchRem(E: *mut Value, Op: *mut *mut Value, C: *mut APInt, IsSigned: *mut bool) -> bool {
    let mut AI: *APInt = null;
    IsSigned = false;
    if match(E, m_SRem(m_Value(Op), m_APInt(AI))) {
        IsSigned = true;
        C = *AI;
        return true;
    }
    if match(E, m_URem(m_Value(Op), m_APInt(AI))) {
        C = *AI;
        return true;
    }
    if match(E, m_And(m_Value(Op), m_APInt(AI))) && (*AI + 1).isPowerOf2() {
        C = *AI + 1;
        return true;
    }
    return false;
}

fn MatchDiv(E: *mut Value, Op: *mut *mut Value, C: *mut APInt, IsSigned: bool) -> bool {
    let mut AI: *APInt = null;
    if IsSigned && match(E, m_SDiv(m_Value(Op), m_APInt(AI))) {
        C = *AI;
        return true;
    }
    if !IsSigned {
        if match(E, m_UDiv(m_Value(Op), m_APInt(AI))) {
            C = *AI;
            return true;
        }
        if match(E, m_LShr(m_Value(Op), m_APInt(AI))) {
            C = APInt { AI.getBitWidth(), 1, false, false };
            operator(C, *AI);
            return true;
        }
    }
    return false;
}

fn MulWillOverflow(C0: *mut APInt, C1: *mut APInt, IsSigned: bool) -> bool {
    let mut overflow: bool = false;
    if IsSigned {
        C0.smul_ov(C1, overflow) as void;
    } else {
        C0.umul_ov(C1, overflow) as void;
    }
    return overflow;
}

fn InstCombinerImpl::SimplifyAddWithRemainder(self, I: *mut BinaryOperator) -> *mut Value {
    let mut LHS: *mut Value = I.getOperand(0);
    let mut RHS: *mut Value = I.getOperand(1);
    let mut X: *mut Value = null;
    let mut MulOpV: *mut Value = null;
    let mut C0: APInt = APInt {};
    let mut MulOpC: APInt = APInt {};
    let mut IsSigned: bool = false;
    if ((MatchRem(LHS, X, C0, IsSigned) && MatchMul(RHS, MulOpV, MulOpC)) || (MatchRem(RHS, X, C0, IsSigned) && MatchMul(LHS, MulOpV, MulOpC))) && C0 == MulOpC {
        let mut RemOpV: *mut Value = null;
        let mut C1: APInt = APInt {};
        let mut Rem2IsSigned: bool = false;
        if MatchRem(MulOpV, RemOpV, C1, Rem2IsSigned) && IsSigned == Rem2IsSigned {
            let mut DivOpV: *mut Value = null;
            let mut DivOpC: APInt = APInt {};
            if MatchDiv(RemOpV, DivOpV, DivOpC, IsSigned) && X == DivOpV && C0 == DivOpC && !MulWillOverflow(C0, C1, IsSigned) {
                let mut NewDivisor: *mut Value = get(X.getType(), C0 * C1);
                return if IsSigned { self.Builder.CreateSRem(X, NewDivisor, "srem") } else { self.Builder.CreateURem(X, NewDivisor, "urem") };
            }
        }
    }
    let mut FoldDivRem: Closure_1 = Closure_1 { I: &mut I, X: &mut X, C0: &mut C0, IsSigned: &mut IsSigned, cap_4: self };
    if FoldDivRem.call(LHS, RHS) {
        V;
    } else {
        return V;
    }
    if FoldDivRem.call(RHS, LHS) {
        V;
    } else {
        return V;
    }
    return null;
}

fn canonicalizeLowbitMask(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut NBits: *mut Value = null;
    if !match(&mut I, m_Add(m_OneUse(m_Shl(m_One(), m_Value(NBits))), m_AllOnes())) {
        return null;
    }
    let mut MinusOne: *mut Constant = getAllOnesValue(NBits.getType());
    let mut NotMask: *mut Value = Builder.CreateShl(MinusOne, NBits, "notmask", false, false);
    if dyn_cast(NotMask) {
        BOp;
    } else {
        BOp.setHasNoSignedWrap(true);
        BOp.setHasNoUnsignedWrap(I.hasNoUnsignedWrap());
    }
    return CreateNot(NotMask, I.getName(), null);
}

fn foldToUnsignedSaturatedAdd(I: *mut BinaryOperator) -> *mut Instruction {
    assert!(I.getOpcode() == Add, "Expecting add instruction");
    let mut Ty: *mut Type = I.getType();
    let mut getUAddSat: Closure_2 = Closure_2 { I: &mut I, Ty: &mut Ty };
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(&mut I, m_c_Add(m_c_UMin(m_Value(X), m_Not(m_Value(Y))), m_Deferred(Y))) {
        return Create(getUAddSat.call(), [X, Y], ArrayRef<OperandBundleDef> {}, "", null);
    }
    let mut C: *APInt = null;
    let mut NotC: *APInt = null;
    if match(&mut I, m_Add(m_UMin(m_Value(X), m_APInt(NotC)), m_APInt(C))) && *C == operator(*NotC) {
        return Create(getUAddSat.call(), [X, get(Ty, *C)], ArrayRef<OperandBundleDef> {}, "", null);
    }
    return null;
}

fn combineAddSubWithShlAddSub(Builder: *mut BuilderTy, I: *BinaryOperator) -> *mut Instruction {
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut Cnt: *mut Value = null;
    if match(&mut I, m_c_Add(m_OneUse(m_Shl(m_OneUse(m_Neg(m_Value(B))), m_Value(Cnt))), m_Value(A))) {
        let mut NewShl: *mut Value = Builder.CreateShl(B, Cnt, "", false, false);
        return CreateSub(A, NewShl, "");
    }
    return null;
}

fn foldAddToAshr(Add: *mut BinaryOperator) -> *mut Instruction {
    let mut X: *mut Value = null;
    let mut DivC: *APInt = null;
    if !match(Add.getOperand(0), m_SDiv(m_Value(X), m_Power2(DivC))) || DivC.isNegative() {
        return null;
    }
    let mut MaskC: *APInt = null;
    let mut MaskCCmp: *APInt = null;
    let mut Pred: CmpPredicate = CmpPredicate {};
    if !match(Add.getOperand(1), m_SExt(m_ICmp(Pred, m_And(m_Specific(X), m_APInt(MaskC)), m_APInt(MaskCCmp)))) {
        return null;
    }
    if (Pred != ICMP_UGT || !MaskCCmp.isSignMask()) && (Pred != ICMP_EQ || *MaskCCmp != *MaskC) {
        return null;
    }
    let mut SMin: APInt = getSignedMinValue(Add.getType().getScalarSizeInBits());
    let mut IsMaskValid: bool = if Pred == ICMP_UGT { (*MaskC == (SMin | (*DivC - 1))) } else { (*DivC == 2 && *MaskC == SMin + 1) };
    if !IsMaskValid {
        return null;
    }
    return CreateAShr(X, get(Add.getType(), DivC.exactLogBase2(), false, false), "");
}

fn InstCombinerImpl::foldAddLikeCommutative(self, LHS: *mut Value, RHS: *mut Value, NSW: bool, NUW: bool) -> *mut Instruction {
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut C: *mut Value = null;
    if match(LHS, m_Sub(m_Value(A), m_Value(B))) && match(RHS, m_Sub(m_Value(C), m_Specific(A))) {
        let mut R: *mut Instruction = CreateSub(C, B, "");
        let mut NSWOut: bool = NSW && match(LHS, m_NSWSub(m_Value(), m_Value())) && match(RHS, m_NSWSub(m_Value(), m_Value()));
        let mut NUWOut: bool = match(LHS, m_NUWSub(m_Value(), m_Value())) && match(RHS, m_NUWSub(m_Value(), m_Value()));
        R.setHasNoSignedWrap(NSWOut);
        R.setHasNoUnsignedWrap(NUWOut);
        return R;
    }
    let mut C1: *APInt = null;
    let mut C2: *APInt = null;
    if match(LHS, m_Shl(m_SDiv(m_Specific(RHS), m_APInt(C1)), m_APInt(C2))) {
        let mut One: APInt = APInt { C2.getBitWidth(), 1, false, false };
        let mut MinusC1: APInt = operator((*C1));
        if MinusC1 == (One << *C2) {
            let mut NewRHS: *mut Constant = get(RHS.getType(), MinusC1);
            return CreateSRem(RHS, NewRHS, "");
        }
    }
    if match(LHS, m_c_Add(m_Value(A), m_APInt(C1))) && match(RHS, m_c_And(m_Value(B), m_SpecificInt(operator(*C1)))) {
        if !LHS.hasOneUse() && !RHS.hasOneUse() {
            return null;
        }
        let mut NSWOut: bool = NSW && match(LHS, m_NSWAdd(m_Value(), m_Value()));
        let mut NUWOut: bool = NUW && match(LHS, m_NUWAdd(m_Value(), m_Value()));
        let mut NewOr: *mut Value = self.Builder.CreateOr(B, getIntegerValue(LHS.getType(), *C1), "", false);
        let mut NewAdd: *mut Instruction = CreateAdd(A, NewOr, "");
        NewAdd.setHasNoSignedWrap(NSWOut);
        NewAdd.setHasNoUnsignedWrap(NUWOut);
        return NewAdd;
    }
    return null;
}

fn InstCombinerImpl::canonicalizeCondSignextOfHighBitExtractToSignextHighBitExtract(self, I: *mut BinaryOperator) -> *mut Instruction {
    assert!((I.getOpcode() == Add || I.getOpcode() == Or || I.getOpcode() == Sub), "Expecting add/or/sub instruction");
    let mut X: *mut Value = null;
    let mut Select: *mut Value = null;
    let mut LowBitsToSkip: *mut Instruction = null;
    let mut Extract: *mut Instruction = null;
    if !match(&mut I, m_c_BinOp(m_TruncOrSelf(m_Instruction(Extract, m_LShr(m_Value(X), m_Instruction(LowBitsToSkip)))), m_Value(Select))) {
        return null;
    }
    if I.getOpcode() == Sub && I.getOperand(1) != Select {
        return null;
    }
    let mut XTy: *mut Type = X.getType();
    let mut HadTrunc: bool = I.getType() != XTy;
    if HadTrunc && !match(&mut I, m_c_BinOp(m_OneUse(m_Value()), m_Value())) {
        return null;
    }
    let mut NBits: *mut Value = null;
    if !match(LowBitsToSkip, m_ZExtOrSelf(m_Sub(m_SpecificInt(XTy.getScalarSizeInBits()), m_ZExtOrSelf(m_Value(NBits))))) {
        return null;
    }
    let mut SkipExtInMagic: Closure_3 = Closure_3 { I: &mut I };
    SkipExtInMagic.call(Select);
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut Thr: *APInt = null;
    let mut SignExtendingValue: *mut Value = null;
    let mut Zero: *mut Value = null;
    let mut ShouldSignext: bool = false;
    if !match(Select, m_Select(m_ICmp(Pred, m_Specific(X), m_APInt(Thr)), m_Value(SignExtendingValue), m_Value(Zero))) || !isSignBitCheck(Pred.operator llvm::CmpInst::Predicate(), *Thr, ShouldSignext) {
        return null;
    }
    if !ShouldSignext {
        swap(SignExtendingValue, Zero);
    }
    if !match(Zero, m_Zero()) {
        return null;
    }
    SkipExtInMagic.call(SignExtendingValue);
    let mut SignExtendingValueBaseConstant: *mut Constant = null;
    if !match(SignExtendingValue, m_Shl(m_Constant(SignExtendingValueBaseConstant), m_ZExtOrSelf(m_Specific(NBits)))) {
        return null;
    }
    if if I.getOpcode() == Sub { !match(SignExtendingValueBaseConstant, m_One()) } else { !match(SignExtendingValueBaseConstant, m_AllOnes()) } {
        return null;
    }
    let mut NewAShr: *mut BinaryOperator = CreateAShr(X, LowBitsToSkip, Extract.getName() + ".sext");
    NewAShr.copyIRFlags(Extract, true);
    if !HadTrunc {
        return NewAShr;
    }
    self.Builder.Insert(NewAShr, "");
    return CreateTruncOrBitCast(NewAShr, I.getType(), "", null);
}

fn factorizeMathWithShlOps(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    assert!((I.getOpcode() == Add || I.getOpcode() == Sub), "Expected add/sub");
    let mut Op0: *mut BinaryOperator = dyn_cast(I.getOperand(0));
    let mut Op1: *mut BinaryOperator = dyn_cast(I.getOperand(1));
    if !Op0 || !Op1 || !(Op0.hasOneUse() || Op1.hasOneUse()) {
        return null;
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut ShAmt: *mut Value = null;
    if !match(Op0, m_Shl(m_Value(X), m_Value(ShAmt))) || !match(Op1, m_Shl(m_Value(Y), m_Specific(ShAmt))) {
        return null;
    }
    let mut HasNSW: bool = I.hasNoSignedWrap() && Op0.hasNoSignedWrap() && Op1.hasNoSignedWrap();
    let mut HasNUW: bool = I.hasNoUnsignedWrap() && Op0.hasNoUnsignedWrap() && Op1.hasNoUnsignedWrap();
    let mut NewMath: *mut Value = Builder.CreateBinOp(I.getOpcode(), X, Y, "", null);
    if dyn_cast(NewMath) {
        NewI;
    } else {
        NewI.setHasNoSignedWrap(HasNSW);
        NewI.setHasNoUnsignedWrap(HasNUW);
    }
    let mut NewShl: *mut BinaryOperator = CreateShl(NewMath, ShAmt, "");
    NewShl.setHasNoSignedWrap(HasNSW);
    NewShl.setHasNoUnsignedWrap(HasNUW);
    return NewShl;
}

fn foldBoxMultiply(I: *mut BinaryOperator) -> *mut Instruction {
    let mut BitWidth: u32 = I.getType().getScalarSizeInBits();
    if (BitWidth & 1) {
        return null;
    }
    let mut HalfBits: u32 = BitWidth >> 1;
    let mut HalfMask: APInt = getMaxValue(HalfBits);
    let mut XLo: *mut Value = null;
    let mut YLo: *mut Value = null;
    let mut CrossSum: *mut Value = null;
    if !match(&mut I, m_c_Add(m_Shl(m_Value(CrossSum), m_SpecificInt(HalfBits)), m_OneUse(m_Mul(m_Value(YLo), m_Value(XLo))))) {
        return null;
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if !match(XLo, m_And(m_Value(X), m_SpecificInt(HalfMask))) || !match(YLo, m_And(m_Value(Y), m_SpecificInt(HalfMask))) {
        return null;
    }
    if match(CrossSum, m_c_Add(m_c_Mul(m_LShr(m_Specific(Y), m_SpecificInt(HalfBits)), m_CombineOr(m_Specific(X), m_Specific(XLo))), m_c_Mul(m_LShr(m_Specific(X), m_SpecificInt(HalfBits)), m_CombineOr(m_Specific(Y), m_Specific(YLo))))) {
        return CreateMul(X, Y, "");
    }
    return null;
}

fn checkDivCeilNUW(X: *mut Value, Y: *mut Value, SQ: *SimplifyQuery) -> bool {
    let mut CRX: ConstantRange = computeConstantRange(X, false, SQ, 0);
    let mut CRY: ConstantRange = computeConstantRange(Y, false, SQ, 0);
    let mut MinY: APInt = CRY.getUnsignedMin();
    let mut MaxX: APInt = CRX.getUnsignedMax();
    let mut MaxY: APInt = CRY.getUnsignedMax();
    return !MinY.isZero() && !MaxX.ugt(operator(MaxY));
}

fn InstCombinerImpl::foldDivCeil(self, I: *mut BinaryOperator) -> *mut Instruction {
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut UDivPat: Value>, 20, false>> = m_OneUse(m_UDiv(m_Value(X), m_Value(Y)));
    let mut URemPat: Value>, 23, false>> = m_OneUse(m_URem(m_Deferred(X), m_Deferred(Y)));
    let mut ICmpPat: ICmpInst, false>> = m_OneUse(m_SpecificICmp(CmpPredicate { Pred: ICMP_NE, HasSameSign: false }, URemPat, m_Zero()));
    let mut DivPat: Value>, 20, false>>>> = m_OneUse(m_ZExtOrSelf(UDivPat));
    let mut ZExtCmpPat: ZExtInst>> = m_OneUse(m_ZExt(ICmpPat));
    if !match(&mut I, m_c_Add(DivPat, ZExtCmpPat)) || !checkDivCeilNUW(X, Y, self.SQ.getWithInstruction(&mut I)) {
        return null;
    }
    let mut YMinusOne: *mut Value = self.Builder.CreateAdd(Y, getAllOnesValue(Y.getType()), "", false, false);
    let mut NUWAdd: *mut Value = self.Builder.CreateNUWAdd(X, YMinusOne, "");
    if X.getType() != I.getType() {
        let mut Div: *mut Value = self.Builder.CreateUDiv(NUWAdd, Y, "", false);
        return ZExtInst { Div, I.getType(), "", null };
    }
    return CreateUDiv(NUWAdd, Y, "");
}

fn InstCombinerImpl::visitAdd(self, I: *mut BinaryOperator) -> *mut Instruction {
    if simplifyAddInst(I.getOperand(0), I.getOperand(1), I.hasNoSignedWrap(), I.hasNoUnsignedWrap(), self.SQ.getWithInstruction(&mut I)) {
        V;
    } else {
        return self.replaceInstUsesWith(I, V);
    }
    if self.SimplifyAssociativeOrCommutative(I) {
        return &mut I;
    }
    if self.foldVectorBinop(I) {
        X;
    } else {
        return X;
    }
    if self.foldBinopWithPhiOperands(I) {
        Phi;
    } else {
        return Phi;
    }
    if self.foldUsingDistributiveLaws(I) {
        V;
    } else {
        return self.replaceInstUsesWith(I, V);
    }
    if foldBoxMultiply(I) {
        R;
    } else {
        return R;
    }
    if factorizeMathWithShlOps(I, self.Builder) {
        R;
    } else {
        return R;
    }
    if self.foldAddWithConstant(I) {
        X;
    } else {
        return X;
    }
    if foldNoWrapAdd(I, self.Builder) {
        X;
    } else {
        return X;
    }
    if self.foldBinOpShiftWithShift(I) {
        R;
    } else {
        return R;
    }
    if combineAddSubWithShlAddSub(self.Builder, I) {
        R;
    } else {
        return R;
    }
    let mut LHS: *mut Value = I.getOperand(0);
    let mut RHS: *mut Value = I.getOperand(1);
    if self.foldAddLikeCommutative(LHS, RHS, I.hasNoSignedWrap(), I.hasNoUnsignedWrap()) {
        R;
    } else {
        return R;
    }
    if self.foldAddLikeCommutative(RHS, LHS, I.hasNoSignedWrap(), I.hasNoUnsignedWrap()) {
        R;
    } else {
        return R;
    }
    let mut Ty: *mut Type = I.getType();
    if Ty.isIntOrIntVectorTy(1) {
        return CreateXor(LHS, RHS, "");
    }
    if LHS == RHS {
        let mut Shl: *mut BinaryOperator = CreateShl(LHS, get(Ty, 1, false, false), "");
        Shl.setHasNoSignedWrap(I.hasNoSignedWrap());
        Shl.setHasNoUnsignedWrap(I.hasNoUnsignedWrap());
        return Shl;
    }
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    if match(LHS, m_Neg(m_Value(A))) {
        if match(RHS, m_Neg(m_Value(B))) {
            return CreateNeg(self.Builder.CreateAdd(A, B, "", false, false), "", null);
        }
        let mut Sub: *mut BinaryOperator = CreateSub(RHS, A, "");
        let mut OB0: *mut OverflowingBinaryOperator = cast(LHS);
        Sub.setHasNoSignedWrap(I.hasNoSignedWrap() && OB0.hasNoSignedWrap());
        return Sub;
    }
    if match(RHS, m_Neg(m_Value(B))) {
        let mut Sub: *mut BinaryOperator = CreateSub(LHS, B, "");
        let mut OBO: *mut OverflowingBinaryOperator = cast(RHS);
        Sub.setHasNoSignedWrap(I.hasNoSignedWrap() && OBO.hasNoSignedWrap());
        return Sub;
    }
    if checkForNegativeOperand(I, self.Builder) {
        V;
    } else {
        return self.replaceInstUsesWith(I, V);
    }
    if match(&mut I, m_c_BinOp(m_Add(m_Value(A), m_One()), m_Not(m_Value(B)))) || match(&mut I, m_BinOp(m_c_Add(m_Not(m_Value(B)), m_Value(A)), m_One())) {
        return CreateSub(A, B, "");
    }
    {
        let mut C: *APInt = null;
        if match(&mut I, m_c_BinOp(m_OneUse(m_Add(m_Value(A), m_APIntAllowPoison(C))), m_Not(m_Value(B)))) || match(&mut I, m_BinOp(m_OneUse(m_c_Add(m_Not(m_Value(B)), m_Value(A))), m_APIntAllowPoison(C))) {
            let mut Sub: *mut Value = self.Builder.CreateSub(A, B, "", false, false);
            return CreateAdd(Sub, get(Ty, *C - 1), "");
        }
    }
    if match(LHS, m_OneUse(m_c_Add(m_Value(A), m_Specific(RHS)))) {
        return CreateAdd(A, self.Builder.CreateShl(RHS, 1, "reass.add", false, false), "");
    }
    if match(RHS, m_OneUse(m_c_Add(m_Value(A), m_Specific(LHS)))) {
        return CreateAdd(A, self.Builder.CreateShl(LHS, 1, "reass.add", false, false), "");
    }
    {
        let mut C1: *mut Constant = null;
        let mut C2: *mut Constant = null;
        if match(&mut I, m_c_Add(m_Add(m_Value(A), m_ImmConstant(C1)), m_Sub(m_ImmConstant(C2), m_Value(B)))) && (LHS.hasOneUse() || RHS.hasOneUse()) {
            let mut Sub: *mut Value = self.Builder.CreateSub(A, B, "", false, false);
            return CreateAdd(Sub, getAdd(C1, C2, false, false), "");
        }
        if match(&mut I, m_c_Add(m_OneUse(m_Sub(m_ImmConstant(C1), m_Value(A))), m_Value(B))) {
            let mut Sub: *mut Value = self.Builder.CreateSub(B, A, "reass.sub", false, false);
            return CreateAdd(Sub, C1, "");
        }
    }
    if self.SimplifyAddWithRemainder(I) {
        V;
    } else {
        return self.replaceInstUsesWith(I, V);
    }
    let mut C1: *APInt = null;
    if match(&mut I, m_c_Add(m_And(m_Value(A), m_APInt(C1)), m_Deferred(A))) && C1.isPowerOf2() && (self.ComputeNumSignBits(A, null, 0) > C1.countl_zero()) {
        let mut NewMask: *mut Constant = get(RHS.getType(), *C1 - 1);
        return CreateAnd(A, NewMask, "");
    }
    if (match(RHS, m_ZExt(m_Value(A))) && match(LHS, m_ZExt(m_NUWSub(m_Value(B), m_Specific(A))))) || (match(LHS, m_ZExt(m_Value(A))) && match(RHS, m_ZExt(m_NUWSub(m_Value(B), m_Specific(A))))) {
        return ZExtInst { B, LHS.getType(), "", null };
    }
    if match(&mut I, m_c_BinOp(m_ZExt(m_Value(A)), m_SExt(m_Deferred(A)))) && A.getType().isIntOrIntVectorTy(1) {
        return self.replaceInstUsesWith(I, getNullValue(I.getType()));
    }
    let mut LTPred: CmpPredicate = CmpPredicate {};
    let mut GTPred: CmpPredicate = CmpPredicate {};
    if match(&mut I, m_c_Add(m_SExt(m_c_ICmp(LTPred, m_Value(A), m_Value(B))), m_ZExt(m_c_ICmp(GTPred, m_Deferred(A), m_Deferred(B))))) && A.getType().isIntOrIntVectorTy() {
        if isGT(LTPred.operator llvm::CmpInst::Predicate()) {
            swap(LTPred, GTPred);
            swap(A, B);
        }
        if isLT(LTPred.operator llvm::CmpInst::Predicate()) && isGT(GTPred.operator llvm::CmpInst::Predicate()) && isSigned(LTPred.operator llvm::CmpInst::Predicate()) == isSigned(GTPred.operator llvm::CmpInst::Predicate()) {
            return self.replaceInstUsesWith(I, self.Builder.CreateIntrinsic(Ty, if isSigned(LTPred.operator llvm::CmpInst::Predicate()) { scmp } else { ucmp }, [A, B], FMFSource {}, "", function_ref<void (CallInst *)> { Closure_4 {}, null, null }));
        }
    }
    let mut LHSCache: WithCache<const Value *> = LHS;
    let mut RHSCache: WithCache<const Value *> = RHS;
    match getNoCommonBitsSetResult(LHSCache, RHSCache, self.SQ.getWithInstruction(&mut I)) {
        Known => {
            return CreateDisjointOr(LHS, RHS, "");
        },
        OnlyIfUndefIgnored => {
            return CreateOr(LHS, RHS, "");
        },
        Unknown => {
            break;
        },
    }
    if self.narrowMathIfNoOverflow(I) {
        Ext;
    } else {
        return Ext;
    }
    if match(&mut I, m_c_BinOp(m_Xor(m_Value(A), m_Value(B)), m_c_And(m_Deferred(A), m_Deferred(B)))) {
        return CreateOr(A, B, "");
    }
    if match(&mut I, m_c_BinOp(m_Or(m_Value(A), m_Value(B)), m_c_And(m_Deferred(A), m_Deferred(B)))) {
        self.replaceOperand(I, 0, A);
        self.replaceOperand(I, 1, B);
        return &mut I;
    }
    if match(&mut I, m_c_BinOp(m_Value(A), m_OneUse(m_c_Or(m_Neg(m_Deferred(A)), m_Deferred(A))))) {
        let mut Add: *mut Value = self.Builder.CreateAdd(A, getAllOnesValue(A.getType()), "", I.hasNoUnsignedWrap(), I.hasNoSignedWrap());
        return CreateAnd(Add, A, "");
    }
    {
        let mut LowMask: *APInt = null;
        if match(&mut I, m_c_Add(m_OneUse(m_And(m_Neg(m_Value(A)), m_LowBitMask(LowMask))), m_Deferred(A))) || match(&mut I, m_Add(m_OneUse(m_Or(m_Add(m_Value(A), m_AllOnes()), m_LowBitMask(LowMask))), m_One())) {
            let mut NewAdd: *mut Value = self.Builder.CreateAdd(A, get(Ty, *LowMask), "", false, false);
            return CreateAnd(NewAdd, get(Ty, operator(*LowMask)), "");
        }
    }
    if match(&mut I, m_Add(m_OneUse(m_c_And(m_Value(A), m_OneUse(m_Neg(m_Deferred(A))))), m_AllOnes())) {
        let mut AllOnes: *mut Constant = getAllOnesValue(RHS.getType());
        let mut Dec: *mut Value = self.Builder.CreateAdd(A, AllOnes, "", false, false);
        let mut Not: *mut Value = self.Builder.CreateXor(A, AllOnes, "");
        return CreateAnd(Dec, Not, "");
    }
    if match(&mut I, m_c_Add(m_OneUse(m_Not(m_OneUse(m_Mul(m_Value(A), m_APInt(C1))))), m_Deferred(A))) {
        let mut Ty: *mut Type = I.getType();
        let mut NewMulC: *mut Constant = get(Ty, 1 - *C1);
        let mut NewMul: *mut Value = self.Builder.CreateMul(A, NewMulC, "", false, false);
        return CreateAdd(NewMul, getAllOnesValue(Ty), "");
    }
    let mut NegPow2C: *APInt = null;
    if match(&mut I, m_c_Add(m_OneUse(m_Mul(m_Value(A), m_NegatedPower2(NegPow2C))), m_Value(B))) {
        let mut ShiftAmtC: *mut Constant = get(Ty, NegPow2C.countr_zero(), false, false);
        let mut Shl: *mut Value = self.Builder.CreateShl(A, ShiftAmtC, "", false, false);
        return CreateSub(B, Shl, "");
    }
    let mut BitWidth: u64 = Ty.getScalarSizeInBits();
    if match(LHS, m_AShr(m_Value(A), m_SpecificIntAllowPoison(BitWidth - 1))) && match(RHS, m_OneUse(m_ZExt(m_OneUse(m_SpecificICmp(CmpPredicate { Pred: ICMP_SGT, HasSameSign: false }, m_Specific(A), m_ZeroInt()))))) {
        let mut NotZero: *mut Value = self.Builder.CreateIsNotNull(A, "isnotnull");
        let mut Zext: *mut Value = self.Builder.CreateZExt(NotZero, Ty, "isnotnull.zext", false);
        return CreateOr(LHS, Zext, "");
    }
    {
        let mut Cond: *mut Value = null;
        let mut Ext: *mut Value = null;
        let mut C: *mut Constant = null;
        let mut CondMatcher: Value>> = m_Value(Cond, m_SpecificICmp(CmpPredicate { Pred: ICMP_EQ, HasSameSign: false }, m_Deferred(A), m_ImmConstant(C)));
        if match(&mut I, m_c_Add(m_Value(A), m_Value(Ext, m_ZExtOrSExt(CondMatcher)))) && Ext.hasOneUse() {
            let mut Add: *mut Value = if isa(Ext) { AddOne(C) } else { SubOne(C) };
            return self.replaceInstUsesWith(I, self.Builder.CreateSelect(Cond, Add, A, "", null));
        }
    }
    if match(LHS, m_Add(m_Value(A), m_One())) && match(RHS, m_OneUse(m_SExt(m_OneUse(m_SpecificICmp(CmpPredicate { Pred: ICMP_NE, HasSameSign: false }, m_Specific(A), m_ZeroInt()))))) {
        let mut OneConst: *mut Value = get(A.getType(), 1, false, false);
        let mut UMax: *mut Value = self.Builder.CreateBinaryIntrinsic(umax, A, OneConst, FMFSource {}, "");
        return self.replaceInstUsesWith(I, UMax);
    }
    if foldAddToAshr(I) {
        Ashr;
    } else {
        return Ashr;
    }
    {
        let mut X: *mut Value = null;
        let mut ShiftAmt: *APInt = null;
        let mut Mask: *APInt = null;
        let mut Pred: CmpPredicate = CmpPredicate {};
        if match(&mut I, m_c_Add(m_ZExt(m_SpecificICmp(CmpPredicate { Pred: ICMP_NE, HasSameSign: false }, m_And(m_Value(X), m_LowBitMask(Mask)), m_ZeroInt())), m_OneUse(m_ZExtOrSelf(m_OneUse(m_LShr(m_Deferred(X), m_APInt(ShiftAmt))))))) && Mask.popcount() == *ShiftAmt {
            let mut Xbits: u32 = X.getType().getScalarSizeInBits();
            let mut Ibits: u32 = Ty.getScalarSizeInBits();
            let mut NeedZext: bool = Ibits > Xbits;
            let mut MaskC: *mut Constant = get(Ty, Mask.zext(Ibits));
            if NeedZext || self.willNotOverflowUnsignedAdd(X, MaskC, I) {
                if NeedZext {
                    X = self.Builder.CreateZExt(X, Ty, "", false);
                }
                let mut Add: *mut Value = self.Builder.CreateNUWAdd(X, MaskC, "");
                return CreateLShr(Add, get(Ty, ShiftAmt.zext(Ibits)), "");
            }
        }
    }
    {
        let mut ConsumesLHS: bool = false;
        let mut ConsumesRHS: bool = false;
        if self.isFreeToInvert(LHS, LHS.hasOneUse(), ConsumesLHS) && ConsumesLHS && self.isFreeToInvert(RHS, RHS.hasOneUse(), ConsumesRHS) && ConsumesRHS {
            let mut NotLHS: *mut Value = self.getFreelyInverted(LHS, LHS.hasOneUse(), &mut self.Builder);
            let mut NotRHS: *mut Value = self.getFreelyInverted(RHS, RHS.hasOneUse(), &mut self.Builder);
            assert!(NotLHS != null && NotRHS != null, "isFreeToInvert desynced with getFreelyInverted");
            let mut LHSPlusRHS: *mut Value = self.Builder.CreateAdd(NotLHS, NotRHS, "", false, false);
            return CreateSub(getSigned(RHS.getType(), -2, false), LHSPlusRHS, "");
        }
    }
    if self.tryFoldInstWithCtpopWithNot(&mut I) {
        R;
    } else {
        return R;
    }
    let mut Changed: bool = false;
    if !I.hasNoSignedWrap() && self.willNotOverflowSignedAdd(LHSCache, RHSCache, I) {
        Changed = true;
        I.setHasNoSignedWrap(true);
    }
    if !I.hasNoUnsignedWrap() && self.willNotOverflowUnsignedAdd(LHSCache, RHSCache, I) {
        Changed = true;
        I.setHasNoUnsignedWrap(true);
    }
    if canonicalizeLowbitMask(I, self.Builder) {
        V;
    } else {
        return V;
    }
    if self.canonicalizeCondSignextOfHighBitExtractToSignextHighBitExtract(I) {
        V;
    } else {
        return V;
    }
    if foldToUnsignedSaturatedAdd(I) {
        SatAdd;
    } else {
        return SatAdd;
    }
    if match(&mut I, m_c_BinOp(m_OneUse(m_Intrinsic(m_Value(A), m_Value(B))), m_Deferred(B))) {
        return self.replaceInstUsesWith(I, self.Builder.CreateIntrinsic(umax, [I.getType()], [A, B], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_5 {}, null, null }));
    }
    if match(LHS, m_OneUse(m_Ctpop(m_Value(A)))) && match(RHS, m_OneUse(m_Ctpop(m_Value(B)))) && haveNoCommonBitsSet(A, B, self.SQ.getWithInstruction(&mut I)) {
        return self.replaceInstUsesWith(I, self.Builder.CreateIntrinsic(ctpop, [I.getType()], [self.Builder.CreateDisjointOr(A, B, "")], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_6 {}, null, null }));
    }
    let mut XorC: *APInt = null;
    let mut Pred: CmpPredicate = CmpPredicate {};
    if match(&mut I, m_c_Add(m_ZExt(m_ICmp(Pred, m_Ctpop(m_Value(A)), m_One())), m_OneUse(m_ZExtOrSelf(m_OneUse(m_Xor(m_OneUse(m_TruncOrSelf(m_OneUse(m_Ctlz(m_Deferred(A), m_One())))), m_APInt(XorC))))))) && (Pred == ICMP_UGT || Pred == ICMP_NE) && *XorC == A.getType().getScalarSizeInBits() - 1 {
        let mut Sub: *mut Value = self.Builder.CreateAdd(A, getAllOnesValue(A.getType()), "", false, false);
        let mut Ctlz: *mut Value = self.Builder.CreateIntrinsic(ctlz, [A.getType()], [Sub, self.Builder.getFalse()], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_7 {}, null, null });
        let mut Ret: *mut Value = self.Builder.CreateSub(get(A.getType(), A.getType().getScalarSizeInBits(), false, false), Ctlz, "", true, true);
        return self.replaceInstUsesWith(I, self.Builder.CreateZExtOrTrunc(Ret, I.getType(), ""));
    }
    if self.foldSquareSumInt(I) {
        Res;
    } else {
        return Res;
    }
    if self.foldBinOpOfDisplacedShifts(I) {
        Res;
    } else {
        return Res;
    }
    if self.foldBinOpOfSelectAndCastOfSelectCondition(I) {
        Res;
    } else {
        return Res;
    }
    if self.foldDivCeil(I) {
        Res;
    } else {
        return Res;
    }
    if Changed {
        let mut PHI: *mut PHINode = null;
        let mut Start: *mut Value = null;
        let mut Step: *mut Value = null;
        if matchSimpleRecurrence(&mut I, PHI, Start, Step) {
            self.Worklist.pushUsersToWorkList(*PHI);
        }
    }
    return if Changed { &mut I } else { null };
}

fn factorizeLerp(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut Z: *mut Value = null;
    if !match(&mut I, m_c_FAdd(m_OneUse(m_c_FMul(m_Value(Y), m_OneUse(m_FSub(m_FPOne(), m_Value(Z))))), m_OneUse(m_c_FMul(m_Value(X), m_Deferred(Z))))) {
        return null;
    }
    let mut XY: *mut Value = Builder.CreateFSubFMF(X, Y, &mut I, "", null);
    let mut MulZ: *mut Value = Builder.CreateFMulFMF(Z, XY, &mut I, "", null);
    return CreateFAddFMF(Y, MulZ, &mut I, "");
}

fn factorizeFAddFSub(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    assert!((I.getOpcode() == FAdd || I.getOpcode() == FSub), "Expecting fadd/fsub");
    assert!(I.hasAllowReassoc() && I.hasNoSignedZeros(), "FP factorization requires FMF");
    if factorizeLerp(I, Builder) {
        Lerp;
    } else {
        return Lerp;
    }
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    if !Op0.hasOneUse() || !Op1.hasOneUse() {
        return null;
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut Z: *mut Value = null;
    let mut IsFMul: bool = false;
    if (match(Op0, m_FMul(m_Value(X), m_Value(Z))) && match(Op1, m_c_FMul(m_Value(Y), m_Specific(Z)))) || (match(Op0, m_FMul(m_Value(Z), m_Value(X))) && match(Op1, m_c_FMul(m_Value(Y), m_Specific(Z)))) {
        IsFMul = true;
    } else if match(Op0, m_FDiv(m_Value(X), m_Value(Z))) && match(Op1, m_FDiv(m_Value(Y), m_Specific(Z))) {
        IsFMul = false;
    } else {
        return null;
    }
    let mut IsFAdd: bool = I.getOpcode() == FAdd;
    let mut XY: *mut Value = if IsFAdd { Builder.CreateFAddFMF(X, Y, &mut I, "", null) } else { Builder.CreateFSubFMF(X, Y, &mut I, "", null) };
    let mut C: *APFloat = null;
    if match(XY, m_APFloat(C)) && !C.isNormal() {
        return null;
    }
    return if IsFMul { CreateFMulFMF(XY, Z, &mut I, "") } else { CreateFDivFMF(XY, Z, &mut I, "") };
}

fn InstCombinerImpl::visitFAdd(self, I: *mut BinaryOperator) -> *mut Instruction {
    if simplifyFAddInst(I.getOperand(0), I.getOperand(1), I.getFastMathFlags(), self.SQ.getWithInstruction(&mut I), ebIgnore, NearestTiesToEven) {
        V;
    } else {
        return self.replaceInstUsesWith(I, V);
    }
    if self.SimplifyAssociativeOrCommutative(I) {
        return &mut I;
    }
    if self.foldVectorBinop(I) {
        X;
    } else {
        return X;
    }
    if self.foldBinopWithPhiOperands(I) {
        Phi;
    } else {
        return Phi;
    }
    if self.foldBinOpIntoSelectOrPhi(I) {
        FoldedFAdd;
    } else {
        return FoldedFAdd;
    }
    let mut A: *mut Value = null;
    if match(&mut I, m_OneUse(m_FAdd(m_Value(A), m_AnyZeroFP()))) && canIgnoreSignBitOfZero(operator(I.use_begin())) {
        return self.replaceInstUsesWith(I, A);
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(&mut I, m_c_FAdd(m_FNeg(m_Value(X)), m_Value(Y))) {
        return CreateFSubFMF(Y, X, &mut I, "");
    }
    let mut Z: *mut Value = null;
    if match(&mut I, m_c_FAdd(m_OneUse(m_c_FMul(m_FNeg(m_Value(X)), m_Value(Y))), m_Value(Z))) {
        let mut XY: *mut Value = self.Builder.CreateFMulFMF(X, Y, &mut I, "", null);
        return CreateFSubFMF(Z, XY, &mut I, "");
    }
    if match(&mut I, m_c_FAdd(m_OneUse(m_FDiv(m_FNeg(m_Value(X)), m_Value(Y))), m_Value(Z))) || match(&mut I, m_c_FAdd(m_OneUse(m_FDiv(m_Value(X), m_FNeg(m_Value(Y)))), m_Value(Z))) {
        let mut XY: *mut Value = self.Builder.CreateFDivFMF(X, Y, &mut I, "", null);
        return CreateFSubFMF(Z, XY, &mut I, "");
    }
    if self.foldFBinOpOfIntCasts(I) {
        R;
    } else {
        return R;
    }
    let mut LHS: *mut Value = I.getOperand(0);
    let mut RHS: *mut Value = I.getOperand(1);
    if self.SimplifySelectsFeedingBinaryOp(I, LHS, RHS) {
        V;
    } else {
        return self.replaceInstUsesWith(I, V);
    }
    if I.hasAllowReassoc() && I.hasNoSignedZeros() {
        if factorizeFAddFSub(I, self.Builder) {
            F;
        } else {
            return F;
        }
        if self.foldSquareSumFP(I) {
            F;
        } else {
            return F;
        }
        if match(&mut I, m_c_FAdd(m_OneUse(m_Intrinsic(m_AnyZeroFP(), m_Value(X))), m_Value(Y))) {
            return self.replaceInstUsesWith(I, self.Builder.CreateIntrinsic(vector_reduce_fadd, [X.getType()], [Y, X], &mut I, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_8 {}, null, null }));
        }
        let mut StartC: *APFloat = null;
        let mut C: *APFloat = null;
        if match(LHS, m_OneUse(m_Intrinsic(m_APFloat(StartC), m_Value(X)))) && match(RHS, m_APFloat(C)) {
            let mut NewStartC: *mut Constant = get(I.getType(), *C + *StartC);
            return self.replaceInstUsesWith(I, self.Builder.CreateIntrinsic(vector_reduce_fadd, [X.getType()], [NewStartC, X], &mut I, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_9 {}, null, null }));
        }
        let mut MulC: *mut Constant = null;
        if match(&mut I, m_c_FAdd(m_FMul(m_Value(X), m_ImmConstant(MulC)), m_Deferred(X))) {
            if ConstantFoldBinaryOpOperands(FAdd, MulC, get(I.getType(), 1.0), self.DL) {
                NewMulC;
            } else {
                return CreateFMulFMF(X, NewMulC, &mut I, "");
            }
        }
        if match(&mut I, m_c_FAdd(m_FSub(m_FNeg(m_Value(X)), m_Value(Y)), m_c_FAdd(m_Deferred(X), m_Value(Z)))) {
            return CreateFSubFMF(Z, Y, &mut I, "");
        }
        if self.Builder.simplify(&mut I) {
            V;
        } else {
            return self.replaceInstUsesWith(I, V);
        }
    }
    if match(&mut I, m_c_FAdd(m_Intrinsic(m_Value(X), m_Value(Y)), m_c_Intrinsic(m_Deferred(X), m_Deferred(Y)))) {
        let mut Result: *mut BinaryOperator = CreateFAddFMF(X, Y, &mut I, "");
        if !Result.hasNoNaNs() {
            Result.setHasNoInfs(false);
        }
        return Result;
    }
    return null;
}

fn CommonPointerBase::compute(self, LHS: *mut Value, RHS: *mut Value) -> CommonPointerBase {
    let mut Base: CommonPointerBase = CommonPointerBase {};
    if LHS.getType() != RHS.getType() {
        return Base;
    }
    let mut Ptrs: SmallPtrSet<Value *, 16> = SmallPtrSet<Value *, 16> {};
    let mut Ptr: *mut Value = LHS;
    while true {
        Ptrs.insert(Ptr);
        if dyn_cast(Ptr) {
            GEP;
        } else {
            Ptr = GEP.getPointerOperand();
        }
    }
    let mut First: bool = true;
    while true {
        if Ptrs.contains(RHS) {
            Base.Ptr = RHS;
            break;
        }
        if dyn_cast(RHS) {
            GEP;
        } else {
            Base.RHSGEPs.push(GEP);
            if First {
                First = false;
                Base.RHSNW = GEP.getNoWrapFlags();
            } else {
                Base.RHSNW = Base.RHSNW.intersectForOffsetAdd(GEP.getNoWrapFlags());
            }
            RHS = GEP.getPointerOperand();
        }
    }
    First = true;
    while true {
        if LHS == Base.Ptr {
            break;
        }
        let mut GEP: *mut GEPOperator = cast(LHS);
        Base.LHSGEPs.push(GEP);
        if First {
            First = false;
            Base.LHSNW = GEP.getNoWrapFlags();
        } else {
            Base.LHSNW = Base.LHSNW.intersectForOffsetAdd(GEP.getNoWrapFlags());
        }
        LHS = GEP.getPointerOperand();
    }
    return Base;
}

fn CommonPointerBase::isExpensive(self: *CommonPointerBase) -> bool {
    let mut NumGEPs: u32 = 0;
    let mut ProcessGEPs: Closure_10 = Closure_10 { NumGEPs: &mut NumGEPs };
    ProcessGEPs.call(self.LHSGEPs);
    ProcessGEPs.call(self.RHSGEPs);
    return NumGEPs > 2;
}

fn InstCombinerImpl::OptimizePointerDifference(self, LHS: *mut Value, RHS: *mut Value, Ty: *mut Type, IsNUW: bool) -> *mut Value {
    let mut Base: CommonPointerBase = compute(LHS, RHS);
    if !Base.Ptr || Base.isExpensive() {
        return null;
    }
    let mut RewriteGEPs: bool = !Base.LHSGEPs.is_empty() && !Base.RHSGEPs.is_empty();
    let mut IdxTy: *mut Type = self.DL.getIndexType(LHS.getType());
    let mut Result: *mut Value = self.EmitGEPOffsets(Base.LHSGEPs, Base.LHSNW, IdxTy, RewriteGEPs);
    let mut Offset2: *mut Value = self.EmitGEPOffsets(Base.RHSGEPs, Base.RHSNW, IdxTy, RewriteGEPs);
    if dyn_cast(Result) {
        I;
    } else if IsNUW && match(Offset2, m_Zero()) && Base.LHSNW.isInBounds() && (I.use_empty() || I.hasOneUse()) && I.hasNoSignedWrap() && !I.hasNoUnsignedWrap() && ((I.getOpcode() == Mul && match(I.getOperand(1), m_NonNegative())) || I.getOpcode() == Shl) {
        cast(I).setHasNoUnsignedWrap(true);
    }
    if !match(Offset2, m_Zero()) {
        Result = self.Builder.CreateSub(Result, Offset2, "gepdiff", IsNUW && Base.LHSNW.hasNoUnsignedWrap() && Base.RHSNW.hasNoUnsignedWrap(), Base.LHSNW.isInBounds() && Base.RHSNW.isInBounds());
    }
    return self.Builder.CreateIntCast(Result, Ty, true, "");
}

fn foldSubOfMinMax(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut Ty: *mut Type = I.getType();
    let mut MinMax: *mut MinMaxIntrinsic = dyn_cast(Op1);
    if !MinMax {
        return null;
    }
    let mut X: *mut Value = MinMax.getLHS();
    let mut Y: *mut Value = MinMax.getRHS();
    if match(Op0, m_c_Add(m_Specific(X), m_Specific(Y))) && (Op0.hasOneUse() || Op1.hasOneUse()) {
        let mut InvID: ID = getInverseMinMaxIntrinsic(MinMax.getIntrinsicID());
        let mut F: *mut Function = getOrInsertDeclaration(I.getModule(), InvID, Ty);
        return Create(F, [X, Y], ArrayRef<OperandBundleDef> {}, "", null);
    }
    let mut Z: *mut Value = null;
    if match(Op1, m_OneUse(m_UMin(m_Value(Y), m_Value(Z)))) {
        if match(Op0, m_OneUse(m_c_Add(m_Specific(Y), m_Value(X)))) {
            let mut USub: *mut Value = Builder.CreateIntrinsic(usub_sat, Ty, [Y, Z], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_11 {}, null, null });
            return CreateAdd(X, USub, "");
        }
        if match(Op0, m_OneUse(m_c_Add(m_Specific(Z), m_Value(X)))) {
            let mut USub: *mut Value = Builder.CreateIntrinsic(usub_sat, Ty, [Z, Y], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_12 {}, null, null });
            return CreateAdd(X, USub, "");
        }
    }
    if MinMax.isSigned() && match(Y, m_ZeroInt()) && match(X, m_NSWSub(m_Specific(Op0), m_Value(Z))) {
        let mut InvID: ID = getInverseMinMaxIntrinsic(MinMax.getIntrinsicID());
        let mut F: *mut Function = getOrInsertDeclaration(I.getModule(), InvID, Ty);
        return Create(F, [Op0, Z], ArrayRef<OperandBundleDef> {}, "", null);
    }
    return null;
}

fn InstCombinerImpl::visitSub(self, I: *mut BinaryOperator) -> *mut Instruction {
    if simplifySubInst(I.getOperand(0), I.getOperand(1), I.hasNoSignedWrap(), I.hasNoUnsignedWrap(), self.SQ.getWithInstruction(&mut I)) {
        V;
    } else {
        return self.replaceInstUsesWith(I, V);
    }
    if self.foldVectorBinop(I) {
        X;
    } else {
        return X;
    }
    if self.foldBinopWithPhiOperands(I) {
        Phi;
    } else {
        return Phi;
    }
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    if self.dyn_castNegVal(Op1) {
        V;
    } else {
        let mut Res: *mut BinaryOperator = CreateAdd(Op0, V, "");
        if dyn_cast(Op1) {
            BO;
        } else {
            assert!(BO.getOpcode() == Sub, "Expected a subtraction operator!");
            if BO.hasNoSignedWrap() && I.hasNoSignedWrap() {
                Res.setHasNoSignedWrap(true);
            }
        }
        return Res;
    }
    if factorizeMathWithShlOps(I, self.Builder) {
        R;
    } else {
        return R;
    }
    let mut C: *mut Constant = null;
    if match(Op0, m_ImmConstant(C)) {
        let mut X: *mut Value = null;
        let mut C2: *mut Constant = null;
        if match(Op1, m_AddLike(m_Value(X), m_ImmConstant(C2))) {
            let mut WillNotSOV: bool = self.willNotOverflowSignedSub(C, C2, I);
            let mut Res: *mut BinaryOperator = CreateSub(getSub(C, C2, false, false), X, "");
            let mut Op1NSW: bool = true;
            let mut Op1NUW: bool = true;
            if dyn_cast(Op1) {
                OBO1;
            } else {
                Op1NSW = OBO1.hasNoSignedWrap();
                Op1NUW = OBO1.hasNoUnsignedWrap();
            }
            Res.setHasNoSignedWrap(I.hasNoSignedWrap() && Op1NSW && WillNotSOV);
            Res.setHasNoUnsignedWrap(I.hasNoUnsignedWrap() && Op1NUW);
            return Res;
        }
    }
    let mut TryToNarrowDeduceFlags: Closure_13 = Closure_13 { cap_0: self, I: &mut I, Op0: &mut Op0, Op1: &mut Op1 };
    let mut IsNegation: bool = match(Op0, m_ZeroInt());
    if !IsNegation || none_of(I.users(), match_fn(m_c_Select(m_Specific(Op1), m_Specific(&mut I)))) {
        if Negate(IsNegation, IsNegation && I.hasNoSignedWrap(), Op1, *self) {
            NegOp1;
        } else {
            return CreateAdd(NegOp1, Op0, "");
        }
    }
    if IsNegation {
        return TryToNarrowDeduceFlags.call();
    }
    if self.foldUsingDistributiveLaws(I) {
        V;
    } else {
        return self.replaceInstUsesWith(I, V);
    }
    if I.getType().isIntOrIntVectorTy(1) {
        return CreateXor(Op0, Op1, "");
    }
    if match(Op0, m_AllOnes()) {
        return CreateNot(Op1, "", null);
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(Op0, m_OneUse(m_Add(m_Value(X), m_AllOnes()))) {
        return CreateAdd(self.Builder.CreateNot(Op1, ""), X, "");
    }
    let mut C1: *mut Constant = null;
    let mut C2: *mut Constant = null;
    if match(Op0, m_And(m_Value(X), m_ImmConstant(C1))) && match(Op1, m_And(m_Specific(X), m_ImmConstant(C2))) {
        let mut AndC: *mut Value = ConstantFoldBinaryInstruction(And, C1, C2);
        if C2.isElementWiseEqual(AndC) {
            return CreateAnd(X, ConstantFoldBinaryInstruction(Xor, C1, C2), "");
        }
    }
    let mut Z: *mut Value = null;
    if match(Op0, m_OneUse(m_c_Add(m_OneUse(m_Sub(m_Value(X), m_Value(Y))), m_Value(Z)))) {
        let mut XZ: *mut Value = self.Builder.CreateAdd(X, Z, "", false, false);
        let mut YW: *mut Value = self.Builder.CreateAdd(Y, Op1, "", false, false);
        return CreateSub(XZ, YW, "");
    }
    if match(Op0, m_OneUse(m_Sub(m_Value(X), m_Value(Y)))) {
        let mut LHSSub: *mut OverflowingBinaryOperator = cast(Op0);
        let mut HasNUW: bool = I.hasNoUnsignedWrap() && LHSSub.hasNoUnsignedWrap();
        let mut HasNSW: bool = HasNUW && I.hasNoSignedWrap() && LHSSub.hasNoSignedWrap();
        let mut Add: *mut Value = self.Builder.CreateAdd(Y, Op1, "", HasNUW, HasNSW);
        let mut Sub: *mut BinaryOperator = CreateSub(X, Add, "");
        Sub.setHasNoUnsignedWrap(HasNUW);
        Sub.setHasNoSignedWrap(HasNSW);
        return Sub;
    }
    {
        let mut CX: *mut Constant = null;
        let mut CY: *mut Constant = null;
        if match(Op0, m_OneUse(m_Add(m_Value(X), m_ImmConstant(CX)))) && match(Op1, m_OneUse(m_Add(m_Value(Y), m_ImmConstant(CY)))) {
            let mut OpsSub: *mut Value = self.Builder.CreateSub(X, Y, "", false, false);
            let mut ConstsSub: *mut Constant = getSub(CX, CY, false, false);
            return CreateAdd(OpsSub, ConstsSub, "");
        }
    }
    {
        let mut W: *mut Value = null;
        let mut Z: *mut Value = null;
        if match(Op0, m_AddLike(m_Value(W), m_Value(X))) && match(Op1, m_AddLike(m_Value(Y), m_Value(Z))) {
            let mut R: *mut Instruction = null;
            if W == Y {
                R = CreateSub(X, Z, "");
            } else if W == Z {
                R = CreateSub(X, Y, "");
            } else if X == Y {
                R = CreateSub(W, Z, "");
            } else if X == Z {
                R = CreateSub(W, Y, "");
            }
            if R {
                let mut NSW: bool = I.hasNoSignedWrap() && match(Op0, m_NSWAddLike(m_Value(), m_Value())) && match(Op1, m_NSWAddLike(m_Value(), m_Value()));
                let mut NUW: bool = I.hasNoUnsignedWrap() && match(Op1, m_NUWAddLike(m_Value(), m_Value()));
                R.setHasNoSignedWrap(NSW);
                R.setHasNoUnsignedWrap(NUW);
                return R;
            }
        }
    }
    {
        let mut ConsumesOp0: bool = false;
        let mut ConsumesOp1: bool = false;
        if self.isFreeToInvert(Op0, Op0.hasOneUse(), ConsumesOp0) && self.isFreeToInvert(Op1, Op1.hasOneUse(), ConsumesOp1) && (ConsumesOp0 || ConsumesOp1) {
            let mut NotOp0: *mut Value = self.getFreelyInverted(Op0, Op0.hasOneUse(), &mut self.Builder);
            let mut NotOp1: *mut Value = self.getFreelyInverted(Op1, Op1.hasOneUse(), &mut self.Builder);
            assert!(NotOp0 != null && NotOp1 != null, "isFreeToInvert desynced with getFreelyInverted");
            return CreateSub(NotOp1, NotOp0, "");
        }
    }
    let mut m_AddRdx: Closure_14 = Closure_14 {};
    let mut V0: *mut Value = null;
    let mut V1: *mut Value = null;
    if match(Op0, m_AddRdx.call(V0)) && match(Op1, m_AddRdx.call(V1)) && V0.getType() == V1.getType() {
        let mut Sub: *mut Value = self.Builder.CreateSub(V0, V1, "", false, false);
        let mut Rdx: *mut Value = self.Builder.CreateIntrinsic(vector_reduce_add, [Sub.getType()], [Sub], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_15 {}, null, null });
        return self.replaceInstUsesWith(I, Rdx);
    }
    if dyn_cast(Op0) {
        C;
    } else {
        let mut X: *mut Value = null;
        if match(Op1, m_ZExt(m_Value(X))) && X.getType().isIntOrIntVectorTy(1) {
            let mut SI: *mut SelectInst = Create(X, SubOne(C), C, "", null, null);
            setExplicitlyUnknownBranchWeightsIfProfiled(*SI, "instcombine", &mut self.F);
            return SI;
        }
        if match(Op1, m_SExt(m_Value(X))) && X.getType().isIntOrIntVectorTy(1) {
            let mut SI: *mut SelectInst = Create(X, AddOne(C), C, "", null, null);
            setExplicitlyUnknownBranchWeightsIfProfiled(*SI, "instcombine", &mut self.F);
            return SI;
        }
        if match(Op1, m_Not(m_Value(X))) {
            return CreateAdd(X, AddOne(C), "");
        }
        if dyn_cast(Op1) {
            SI;
        } else if self.FoldOpIntoSelect(I, SI, false, false) {
            R;
        } else {
            return R;
        }
        if dyn_cast(Op1) {
            PN;
        } else if self.foldOpIntoPhi(I, PN, false) {
            R;
        } else {
            return R;
        }
        let mut C2: *mut Constant = null;
        if match(Op1, m_Sub(m_ImmConstant(C2), m_Value(X))) {
            return CreateAdd(X, getSub(C, C2, false, false), "");
        }
    }
    let mut Op0C: *APInt = null;
    if match(Op0, m_APInt(Op0C)) {
        if Op0C.isMask() {
            let mut RHSKnown: KnownBits = computeKnownBits(Op1, self.SQ.getWithInstruction(&mut I).getWithoutDomCondCache(), 0);
            if (*Op0C | RHSKnown.Zero).isAllOnes() {
                return CreateXor(Op1, Op0, "");
            }
        }
        let mut C2: *APInt = null;
        let mut C3: *APInt = null;
        let mut InnerSub: *mut BinaryOperator = null;
        if match(Op1, m_OneUse(m_And(m_BinOp(InnerSub), m_APInt(C2)))) && match(InnerSub, m_Sub(m_APInt(C3), m_Value(X))) && (InnerSub.hasNoUnsignedWrap() || C2.isNegatedPowerOf2()) {
            let mut C2AndC3: APInt = *C2 & *C3;
            let mut C2AndC3Minus1: APInt = C2AndC3 - 1;
            let mut C2AddC3: APInt = *C2 + *C3;
            if (*C3 - C2AndC3Minus1).isPowerOf2() && C2AndC3Minus1.isSubsetOf(C2AddC3) {
                let mut And: *mut Value = self.Builder.CreateAnd(X, get(I.getType(), *C2), "");
                return CreateAdd(And, get(I.getType(), *Op0C - C2AndC3), "");
            }
        }
    }
    {
        let mut Y: *mut Value = null;
        if match(Op1, m_c_Add(m_Specific(Op0), m_Value(Y))) {
            return CreateNeg(Y, "", null);
        }
        if match(Op0, m_Sub(m_Specific(Op1), m_Value(Y))) {
            return CreateNeg(Y, "", null);
        }
    }
    {
        let mut A: *mut Value = null;
        let mut B: *mut Value = null;
        if match(Op1, m_And(m_Value(A), m_Value(B))) && match(Op0, m_c_Or(m_Specific(A), m_Specific(B))) {
            return CreateXor(A, B, "");
        }
    }
    {
        let mut A: *mut Value = null;
        let mut B: *mut Value = null;
        if match(Op0, m_Add(m_Value(A), m_Value(B))) && match(Op1, m_c_Or(m_Specific(A), m_Specific(B))) {
            return CreateAnd(A, B, "");
        }
    }
    {
        let mut A: *mut Value = null;
        let mut B: *mut Value = null;
        if match(Op0, m_Add(m_Value(A), m_Value(B))) && match(Op1, m_c_And(m_Specific(A), m_Specific(B))) {
            return CreateOr(A, B, "");
        }
    }
    {
        let mut A: *mut Value = null;
        let mut B: *mut Value = null;
        if match(Op0, m_And(m_Value(A), m_Value(B))) && match(Op1, m_c_Or(m_Specific(A), m_Specific(B))) && (Op0.hasOneUse() || Op1.hasOneUse()) {
            return CreateNeg(self.Builder.CreateXor(A, B, ""), "", null);
        }
    }
    {
        let mut A: *mut Value = null;
        let mut B: *mut Value = null;
        if match(Op1, m_Xor(m_Value(A), m_Value(B))) && match(Op0, m_c_Or(m_Specific(A), m_Specific(B))) {
            return CreateAnd(A, B, "");
        }
    }
    {
        let mut A: *mut Value = null;
        let mut B: *mut Value = null;
        if match(Op0, m_Xor(m_Value(A), m_Value(B))) && match(Op1, m_c_Or(m_Specific(A), m_Specific(B))) && (Op0.hasOneUse() || Op1.hasOneUse()) {
            return CreateNeg(self.Builder.CreateAnd(A, B, ""), "", null);
        }
    }
    {
        let mut Y: *mut Value = null;
        if match(Op0, m_OneUse(m_c_Or(m_Value(Y), m_Specific(Op1)))) {
            return CreateAnd(Y, self.Builder.CreateNot(Op1, Op1.getName() + ".not"), "");
        }
    }
    {
        let mut X: *mut Value = null;
        if match(Op0, m_OneUse(m_c_And(m_Specific(Op1), m_OneUse(m_Neg(m_Value(X)))))) {
            return CreateNeg(self.Builder.CreateAnd(Op1, self.Builder.CreateAdd(X, getAllOnesValue(I.getType()), "", false, false), ""), "", null);
        }
    }
    {
        let mut C: *mut Constant = null;
        if match(Op0, m_OneUse(m_And(m_Specific(Op1), m_Constant(C)))) {
            return CreateNeg(self.Builder.CreateAnd(Op1, self.Builder.CreateNot(C, ""), ""), "", null);
        }
    }
    {
        let mut C: *mut Value = null;
        let mut X: *mut Value = null;
        let mut m_SubXorCmp: Closure_16 = Closure_16 { C: &mut C, X: &mut X };
        if m_SubXorCmp.call(Op0, Op1) {
            return self.createSelectInstWithUnknownProfile(C, self.Builder.CreateNeg(X, "", false), X, "", null);
        }
        if m_SubXorCmp.call(Op1, Op0) {
            return self.createSelectInstWithUnknownProfile(C, X, self.Builder.CreateNeg(X, "", false), "", null);
        }
    }
    if self.tryFoldInstWithCtpopWithNot(&mut I) {
        R;
    } else {
        return R;
    }
    if foldSubOfMinMax(I, self.Builder) {
        R;
    } else {
        return R;
    }
    {
        let mut SinkSubIntoSelect: Closure_17 = Closure_17 { cap_0: I.getType() };
        if SinkSubIntoSelect.call(Op0, Op1, Closure_18 { cap_0: &mut self.Builder, Op1: Op1 }) {
            NewSel;
        } else {
            return NewSel;
        }
        if SinkSubIntoSelect.call(Op1, Op0, Closure_19 { cap_0: &mut self.Builder, Op0: Op0 }) {
            NewSel;
        } else {
            return NewSel;
        }
    }
    if match(Op1, m_c_And(m_Specific(Op0), m_Value(Y))) && (Op1.hasOneUse() || isa(Y)) {
        return CreateAnd(Op0, self.Builder.CreateNot(Y, Y.getName() + ".not"), "");
    }
    if match(Op0, m_Not(m_Value(X))) && match(Op1, m_c_MaxOrMin(m_Specific(Op0), m_Value(Y))) && !Op0.hasNUsesOrMore(3) && self.isFreeToInvert(Y, Y.hasOneUse()) {
        let mut Not: *mut Value = self.Builder.CreateNot(Op1, "");
        return CreateSub(Not, X, "");
    }
    if match(Op1, m_Not(m_Value(X))) && match(Op0, m_c_MaxOrMin(m_Specific(Op1), m_Value(Y))) && !Op1.hasNUsesOrMore(3) && self.isFreeToInvert(Y, Y.hasOneUse()) {
        let mut Not: *mut Value = self.Builder.CreateNot(Op0, "");
        return CreateSub(X, Not, "");
    }
    if match(Op0, m_c_SMin(m_NSWAddLike(m_Value(X), m_One()), m_Value(Y))) && match(Op1, m_c_SMin(m_Specific(X), m_Specific(Y))) && I.getType().getScalarSizeInBits() != 1 && (Op0.hasOneUse() || Op1.hasOneUse()) {
        let mut Cond: *mut Value = self.Builder.CreateICmpSLT(X, Y, "");
        return ZExtInst { Cond, I.getType(), "", null };
    }
    if match(Op0, m_c_UMin(m_NUWAddLike(m_Value(X), m_One()), m_Value(Y))) && match(Op1, m_c_UMin(m_Specific(X), m_Specific(Y))) && I.getType().getScalarSizeInBits() != 1 && (Op0.hasOneUse() || Op1.hasOneUse()) {
        let mut Cond: *mut Value = self.Builder.CreateICmpULT(X, Y, "");
        return ZExtInst { Cond, I.getType(), "", null };
    }
    let mut LHSOp: *mut Value = null;
    let mut RHSOp: *mut Value = null;
    if match(Op0, m_PtrToIntOrAddr(m_Value(LHSOp))) && match(Op1, m_PtrToIntOrAddr(m_Value(RHSOp))) {
        if self.OptimizePointerDifference(LHSOp, RHSOp, I.getType(), I.hasNoUnsignedWrap()) {
            Res;
        } else {
            return self.replaceInstUsesWith(I, Res);
        }
    }
    if match(Op0, m_Trunc(m_PtrToIntOrAddr(m_Value(LHSOp)))) && match(Op1, m_Trunc(m_PtrToIntOrAddr(m_Value(RHSOp)))) {
        if self.OptimizePointerDifference(LHSOp, RHSOp, I.getType(), false) {
            Res;
        } else {
            return self.replaceInstUsesWith(I, Res);
        }
    }
    let mut MatchSubOfZExtOfPtrToIntOrAddr: Closure_20 = Closure_20 { Op0: &mut Op0, cap_1: self, LHSOp: &mut LHSOp, Op1: &mut Op1, RHSOp: &mut RHSOp };
    if MatchSubOfZExtOfPtrToIntOrAddr.call() {
        if dyn_cast(LHSOp) {
            GEP;
        } else {
            if GEP.getPointerOperand() == RHSOp {
                if GEP.hasNoUnsignedWrap() || GEP.hasNoUnsignedSignedWrap() {
                    let mut Offset: *mut Value = self.EmitGEPOffset(GEP, false);
                    let mut Res: *mut Value = if GEP.hasNoUnsignedWrap() { self.Builder.CreateZExt(Offset, I.getType(), "", GEP.hasNoUnsignedSignedWrap()) } else { self.Builder.CreateSExt(Offset, I.getType(), "") };
                    return self.replaceInstUsesWith(I, Res);
                }
            }
        }
    }
    let mut A: *mut Value = null;
    let mut ShAmt: *APInt = null;
    let mut Ty: *mut Type = I.getType();
    let mut BitWidth: u32 = Ty.getScalarSizeInBits();
    if match(Op1, m_AShr(m_Value(A), m_APInt(ShAmt))) && Op1.hasNUses(2) && *ShAmt == BitWidth - 1 && match(Op0, m_OneUse(m_c_Xor(m_Specific(A), m_Specific(Op1)))) {
        let mut IsNeg: *mut Value = self.Builder.CreateIsNeg(A, "");
        let mut NegA: *mut Value = if I.hasNoUnsignedWrap() { getNullValue(A.getType()) } else { self.Builder.CreateNeg(A, "", I.hasNoSignedWrap()) };
        return Create(IsNeg, NegA, A, "", null, null);
    }
    let mut AddC: *APInt = null;
    let mut AndC: *APInt = null;
    if match(Op0, m_Add(m_Value(X), m_APInt(AddC))) && match(Op1, m_And(m_Specific(X), m_APInt(AndC))) {
        let mut Cttz: u32 = AddC.countr_zero();
        let mut HighMask: APInt = getHighBitsSet(BitWidth, BitWidth - Cttz);
        if (HighMask & *AndC).isZero() {
            return CreateAnd(Op0, get(Ty, operator((*AndC))), "");
        }
    }
    if self.canonicalizeCondSignextOfHighBitExtractToSignextHighBitExtract(I) {
        V;
    } else {
        return V;
    }
    if match(Op1, m_OneUse(m_Intrinsic(m_Specific(Op0), m_Value(Y)))) {
        return self.replaceInstUsesWith(I, self.Builder.CreateIntrinsic(umin, [I.getType()], [Op0, Y], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_21 {}, null, null }));
    }
    if match(Op0, m_OneUse(m_c_UMax(m_Value(X), m_Specific(Op1)))) {
        return self.replaceInstUsesWith(I, self.Builder.CreateIntrinsic(usub_sat, [Ty], [X, Op1], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_22 {}, null, null }));
    }
    if match(Op1, m_OneUse(m_c_UMin(m_Value(X), m_Specific(Op0)))) {
        return self.replaceInstUsesWith(I, self.Builder.CreateIntrinsic(usub_sat, [Ty], [Op0, X], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_23 {}, null, null }));
    }
    if match(Op1, m_OneUse(m_c_UMax(m_Value(X), m_Specific(Op0)))) {
        let mut USub: *mut Value = self.Builder.CreateIntrinsic(usub_sat, [Ty], [X, Op0], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_24 {}, null, null });
        return CreateNeg(USub, "", null);
    }
    if match(Op0, m_OneUse(m_c_UMin(m_Value(X), m_Specific(Op1)))) {
        let mut USub: *mut Value = self.Builder.CreateIntrinsic(usub_sat, [Ty], [Op1, X], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_25 {}, null, null });
        return CreateNeg(USub, "", null);
    }
    if match(Op0, m_SpecificInt(BitWidth)) && match(Op1, m_OneUse(m_Ctpop(m_Value(X)))) {
        return self.replaceInstUsesWith(I, self.Builder.CreateIntrinsic(ctpop, [I.getType()], [self.Builder.CreateNot(X, "")], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_26 {}, null, null }));
    }
    if match(Op0, m_OneUse(m_Mul(m_Value(X), m_Deferred(X)))) && match(Op1, m_OneUse(m_Mul(m_Value(Y), m_Deferred(Y)))) {
        let mut OBO0: *mut OverflowingBinaryOperator = cast(Op0);
        let mut OBO1: *mut OverflowingBinaryOperator = cast(Op1);
        let mut PropagateNSW: bool = I.hasNoSignedWrap() && OBO0.hasNoSignedWrap() && OBO1.hasNoSignedWrap() && BitWidth > 2;
        let mut PropagateNUW: bool = I.hasNoUnsignedWrap() && OBO0.hasNoUnsignedWrap() && OBO1.hasNoUnsignedWrap() && BitWidth > 1;
        let mut Add: *mut Value = self.Builder.CreateAdd(X, Y, "add", PropagateNUW, PropagateNSW);
        let mut Sub: *mut Value = self.Builder.CreateSub(X, Y, "sub", PropagateNUW, PropagateNSW);
        let mut Mul: *mut Value = self.Builder.CreateMul(Add, Sub, "", PropagateNUW, PropagateNSW);
        return self.replaceInstUsesWith(I, Mul);
    }
    if match(Op0, m_OneUse(m_c_SMax(m_Value(X), m_Value(Y)))) && match(Op1, m_OneUse(m_c_SMin(m_Specific(X), m_Specific(Y)))) {
        if I.hasNoUnsignedWrap() || I.hasNoSignedWrap() {
            let mut Sub: *mut Value = self.Builder.CreateSub(X, Y, "sub", false, true);
            let mut Call: *mut Value = self.Builder.CreateBinaryIntrinsic(abs, Sub, self.Builder.getTrue(), FMFSource {}, "");
            return self.replaceInstUsesWith(I, Call);
        }
    }
    if self.foldBinOpOfSelectAndCastOfSelectCondition(I) {
        Res;
    } else {
        return Res;
    }
    if match(Op1, m_SExtLike(m_Value(X))) && match(Op0, m_SExtLike(m_c_NSWAdd(m_Specific(X), m_Value(Y)))) {
        let mut SExtY: *mut Value = self.Builder.CreateSExt(Y, I.getType(), "");
        return self.replaceInstUsesWith(I, SExtY);
    }
    {
        let mut Z: *mut Value = null;
        let mut Add0: *mut Value = null;
        let mut Add1: *mut Value = null;
        if match(Op0, m_SExtLike(m_Value(Add0))) && match(Op1, m_SExtLike(m_Value(Add1))) && ((match(Add0, m_NSWAdd(m_Value(X), m_Value(Y))) && match(Add1, m_c_NSWAdd(m_Specific(X), m_Value(Z)))) || (match(Add0, m_NSWAdd(m_Value(Y), m_Value(X))) && match(Add1, m_c_NSWAdd(m_Specific(X), m_Value(Z))))) {
            let mut NumOfNewInstrs: u32 = 0;
            NumOfNewInstrs += if !isa(Y) { 1 } else { 0 };
            NumOfNewInstrs += if !isa(Z) { 1 } else { 0 };
            let mut NumOfDeadInstrs: u32 = 0;
            if Op0.hasOneUse() {
                NumOfDeadInstrs += 1;
                NumOfDeadInstrs += if Add0.hasOneUse() { 1 } else { 0 };
            }
            if Op1.hasOneUse() {
                NumOfDeadInstrs += 1;
                NumOfDeadInstrs += if Add1.hasOneUse() { 1 } else { 0 };
            }
            if NumOfDeadInstrs >= NumOfNewInstrs {
                let mut SExtY: *mut Value = self.Builder.CreateSExt(Y, I.getType(), "");
                let mut SExtZ: *mut Value = self.Builder.CreateSExt(Z, I.getType(), "");
                let mut Sub: *mut Value = self.Builder.CreateSub(SExtY, SExtZ, "", false, I.hasNoSignedWrap());
                return self.replaceInstUsesWith(I, Sub);
            }
        }
    }
    return TryToNarrowDeduceFlags.call();
}

fn foldFNegIntoConstant(I: *mut Instruction, DL: *DataLayout) -> *mut Instruction {
    let mut FNegOp: *mut Instruction = null;
    if !match(&mut I, m_FNeg(m_OneUse(m_Instruction(FNegOp)))) {
        return null;
    }
    let mut X: *mut Value = null;
    let mut C: *mut Constant = null;
    if match(FNegOp, m_FMul(m_Value(X), m_Constant(C))) {
        if ConstantFoldUnaryOpOperand(FNeg, C, DL) {
            NegC;
        } else {
            let mut FNegF: FastMathFlags = I.getFastMathFlags();
            let mut OpF: FastMathFlags = FNegOp.getFastMathFlags();
            let mut FMF: FastMathFlags = unionValue(FNegF, OpF) | intersectRewrite(FNegF, OpF);
            FMF.setNoInfs(FNegF.noInfs() && OpF.noInfs());
            return CreateFMulFMF(X, NegC, FMF, "");
        }
    }
    if match(FNegOp, m_FDiv(m_Value(X), m_Constant(C))) {
        if ConstantFoldUnaryOpOperand(FNeg, C, DL) {
            NegC;
        } else {
            let mut FDiv: *mut Instruction = CreateFDivFMF(X, NegC, &mut I, "");
            let mut FMF: FastMathFlags = I.getFastMathFlags();
            let mut OpFMF: FastMathFlags = FNegOp.getFastMathFlags();
            FDiv.setHasNoSignedZeros(FMF.noSignedZeros() && OpFMF.noSignedZeros());
            FDiv.setHasNoInfs(FMF.noInfs() && OpFMF.noInfs());
            FDiv.copyMetadata(*FNegOp, ArrayRef<unsigned int> {});
            return FDiv;
        }
    }
    if match(FNegOp, m_FDiv(m_Constant(C), m_Value(X))) {
        if ConstantFoldUnaryOpOperand(FNeg, C, DL) {
            NegC;
        } else {
            let mut FDiv: *mut Instruction = CreateFDivFMF(NegC, X, &mut I, "");
            let mut FMF: FastMathFlags = I.getFastMathFlags();
            let mut OpFMF: FastMathFlags = FNegOp.getFastMathFlags();
            FDiv.setHasNoSignedZeros(FMF.noSignedZeros() && OpFMF.noSignedZeros());
            FDiv.setHasNoInfs(FMF.noInfs() && OpFMF.noInfs());
            FDiv.copyMetadata(*FNegOp, ArrayRef<unsigned int> {});
            return FDiv;
        }
    }
    if I.hasNoSignedZeros() && match(FNegOp, m_FAdd(m_Value(X), m_Constant(C))) {
        if ConstantFoldUnaryOpOperand(FNeg, C, DL) {
            NegC;
        } else {
            return CreateFSubFMF(NegC, X, &mut I, "");
        }
    }
    return null;
}

fn InstCombinerImpl::hoistFNegAboveFMulFDiv(self, FNegOp: *mut Value, FMFSource: *mut Instruction) -> *mut Instruction {
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(FNegOp, m_FMul(m_Value(X), m_Value(Y))) {
        return cast(self.Builder.CreateFMulFMF(X, self.Builder.CreateFNegFMF(Y, &mut FMFSource, "", null), &mut FMFSource, "", null));
    }
    if match(FNegOp, m_FDiv(m_Value(X), m_Value(Y))) {
        let mut FDiv: *mut Instruction = cast(self.Builder.CreateFDivFMF(self.Builder.CreateFNegFMF(X, &mut FMFSource, "", null), Y, &mut FMFSource, "", null));
        FDiv.copyMetadata(*cast(FNegOp), ArrayRef<unsigned int> {});
        return FDiv;
    }
    if dyn_cast(FNegOp) {
        II;
    } else {
        if II.getIntrinsicID() == ldexp {
            let mut FMF: FastMathFlags = FMFSource.getFastMathFlags() | II.getFastMathFlags();
            let mut New: *mut CallInst = self.Builder.CreateCall(II.getCalledFunction(), [self.Builder.CreateFNegFMF(II.getArgOperand(0), FMF, "", null), II.getArgOperand(1)], "", null);
            New.setFastMathFlags(FMF);
            New.copyMetadata(*II, ArrayRef<unsigned int> {});
            return New;
        }
    }
    return null;
}

fn InstCombinerImpl::visitFNeg(self, I: *mut UnaryOperator) -> *mut Instruction {
    let mut Op: *mut Value = I.getOperand(0);
    if simplifyFNegInst(Op, I.getFastMathFlags(), self.getSimplifyQuery().getWithInstruction(&mut I)) {
        V;
    } else {
        return self.replaceInstUsesWith(I, V);
    }
    if foldFNegIntoConstant(I, self.DL) {
        X;
    } else {
        return X;
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if I.hasNoSignedZeros() && match(Op, m_OneUse(m_FSub(m_Value(X), m_Value(Y)))) {
        return CreateFSubFMF(Y, X, &mut I, "");
    }
    let mut OneUse: *mut Value = null;
    if !match(Op, m_OneUse(m_Value(OneUse))) {
        return null;
    }
    if self.hoistFNegAboveFMulFDiv(OneUse, I) {
        R;
    } else {
        return self.replaceInstUsesWith(I, R);
    }
    let mut Cond: *mut Value = null;
    if match(OneUse, m_Select(m_Value(Cond), m_Value(X), m_Value(Y))) {
        let mut propagateSelectFMF: Closure_27 = Closure_27 { I: &mut I, Op: &mut Op };
        let mut P: *mut Value = null;
        if match(X, m_FNeg(m_Value(P))) {
            let mut NegY: *mut Value = self.Builder.CreateFNegFMF(Y, &mut I, Y.getName() + ".neg", null);
            let mut NewSel: *mut SelectInst = Create(Cond, P, NegY, "", null, null);
            propagateSelectFMF.call(NewSel, P == Y);
            return NewSel;
        }
        if match(Y, m_FNeg(m_Value(P))) {
            let mut NegX: *mut Value = self.Builder.CreateFNegFMF(X, &mut I, X.getName() + ".neg", null);
            let mut NewSel: *mut SelectInst = Create(Cond, NegX, P, "", null, null);
            propagateSelectFMF.call(NewSel, P == X);
            return NewSel;
        }
        if match(X, m_ImmConstant()) || match(Y, m_ImmConstant()) {
            let mut NegX: *mut Value = self.Builder.CreateFNegFMF(X, &mut I, X.getName() + ".neg", null);
            let mut NegY: *mut Value = self.Builder.CreateFNegFMF(Y, &mut I, Y.getName() + ".neg", null);
            let mut NewSel: *mut SelectInst = Create(Cond, NegX, NegY, "", null, null);
            propagateSelectFMF.call(NewSel, true);
            return NewSel;
        }
    }
    if match(OneUse, m_CopySign(m_Value(X), m_Value(Y))) {
        let mut FMF: FastMathFlags = I.getFastMathFlags();
        operator(FMF, cast(OneUse).getFastMathFlags());
        let mut NegY: *mut Value = self.Builder.CreateFNegFMF(Y, FMF, "", null);
        let mut NewCopySign: *mut Value = self.Builder.CreateCopySign(X, NegY, FMF, "");
        return self.replaceInstUsesWith(I, NewCopySign);
    }
    let mut Mask: ArrayRef<int> = ArrayRef<int> {};
    if match(OneUse, m_Shuffle(m_Value(X), m_Poison(), Mask)) {
        return ShuffleVectorInst { self.Builder.CreateFNegFMF(X, &mut I, "", null), Mask, "", null };
    }
    if match(OneUse, m_VecReverse(m_Value(X))) {
        let mut Reverse: *mut Value = self.Builder.CreateVectorReverse(self.Builder.CreateFNegFMF(X, &mut I, "", null), "");
        return self.replaceInstUsesWith(I, Reverse);
    }
    return null;
}

fn InstCombinerImpl::visitFSub(self, I: *mut BinaryOperator) -> *mut Instruction {
    if simplifyFSubInst(I.getOperand(0), I.getOperand(1), I.getFastMathFlags(), self.getSimplifyQuery().getWithInstruction(&mut I), ebIgnore, NearestTiesToEven) {
        V;
    } else {
        return self.replaceInstUsesWith(I, V);
    }
    if self.foldVectorBinop(I) {
        X;
    } else {
        return X;
    }
    if self.foldBinopWithPhiOperands(I) {
        Phi;
    } else {
        return Phi;
    }
    let mut Op: *mut Value = null;
    if match(&mut I, m_FNeg(m_Value(Op))) {
        return CreateFNegFMF(Op, &mut I, "", null);
    }
    if foldFNegIntoConstant(I, self.DL) {
        X;
    } else {
        return X;
    }
    if self.foldFBinOpOfIntCasts(I) {
        R;
    } else {
        return R;
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut C: *mut Constant = null;
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    if I.hasNoSignedZeros() || cannotBeNegativeZero(Op0, self.getSimplifyQuery().getWithInstruction(&mut I), 0) {
        if match(Op1, m_OneUse(m_FSub(m_Value(X), m_Value(Y)))) {
            let mut NewSub: *mut Value = self.Builder.CreateFSubFMF(Y, X, &mut I, "", null);
            return CreateFAddFMF(Op0, NewSub, &mut I, "");
        }
    }
    if I.hasNoSignedZeros() && !isa(Op0) && match(Op0, m_OneUse(m_FNeg(m_Value(X)))) {
        let mut FAdd: *mut Value = self.Builder.CreateFAddFMF(X, Op1, &mut I, "", null);
        return CreateFNegFMF(FAdd, &mut I, "", null);
    }
    if isa(Op0) {
        if dyn_cast(Op1) {
            SI;
        } else if self.FoldOpIntoSelect(I, SI, false, false) {
            NV;
        } else {
            return NV;
        }
    }
    if match(Op1, m_ImmConstant(C)) {
        if ConstantFoldUnaryOpOperand(FNeg, C, self.DL) {
            NegC;
        } else {
            return CreateFAddFMF(Op0, NegC, &mut I, "");
        }
    }
    if match(Op1, m_FNeg(m_Value(Y))) {
        return CreateFAddFMF(Op0, Y, &mut I, "");
    }
    let mut Ty: *mut Type = I.getType();
    if match(Op1, m_OneUse(m_FPTrunc(m_FNeg(m_Value(Y))))) {
        return CreateFAddFMF(Op0, self.Builder.CreateFPTrunc(Y, Ty, "", null), &mut I, "");
    }
    if match(Op1, m_OneUse(m_FPExt(m_FNeg(m_Value(Y))))) {
        return CreateFAddFMF(Op0, self.Builder.CreateFPExt(Y, Ty, "", null), &mut I, "");
    }
    if match(Op1, m_OneUse(m_c_FMul(m_FNeg(m_Value(X)), m_Value(Y)))) {
        let mut FMul: *mut Value = self.Builder.CreateFMulFMF(X, Y, &mut I, "", null);
        return CreateFAddFMF(Op0, FMul, &mut I, "");
    }
    if match(Op1, m_OneUse(m_FDiv(m_FNeg(m_Value(X)), m_Value(Y)))) || match(Op1, m_OneUse(m_FDiv(m_Value(X), m_FNeg(m_Value(Y))))) {
        let mut FDiv: *mut Value = self.Builder.CreateFDivFMF(X, Y, &mut I, "", null);
        return CreateFAddFMF(Op0, FDiv, &mut I, "");
    }
    if self.SimplifySelectsFeedingBinaryOp(I, Op0, Op1) {
        V;
    } else {
        return self.replaceInstUsesWith(I, V);
    }
    if I.hasAllowReassoc() && I.hasNoSignedZeros() {
        if match(Op0, m_FSub(m_Specific(Op1), m_Value(X))) {
            return CreateFNegFMF(X, &mut I, "", null);
        }
        if match(Op1, m_c_FAdd(m_Specific(Op0), m_Value(X))) {
            return CreateFNegFMF(X, &mut I, "", null);
        }
        if match(Op0, m_FMul(m_Specific(Op1), m_Constant(C))) {
            if ConstantFoldBinaryOpOperands(FSub, C, get(Ty, 1.0), self.DL) {
                CSubOne;
            } else {
                return CreateFMulFMF(Op1, CSubOne, &mut I, "");
            }
        }
        if match(Op1, m_FMul(m_Specific(Op0), m_Constant(C))) {
            if ConstantFoldBinaryOpOperands(FSub, get(Ty, 1.0), C, self.DL) {
                OneSubC;
            } else {
                return CreateFMulFMF(Op0, OneSubC, &mut I, "");
            }
        }
        let mut Z: *mut Value = null;
        if match(Op0, m_OneUse(m_c_FAdd(m_OneUse(m_FSub(m_Value(X), m_Value(Y))), m_Value(Z)))) {
            let mut XZ: *mut Value = self.Builder.CreateFAddFMF(X, Z, &mut I, "", null);
            let mut YW: *mut Value = self.Builder.CreateFAddFMF(Y, Op1, &mut I, "", null);
            return CreateFSubFMF(XZ, YW, &mut I, "");
        }
        let mut m_FaddRdx: Closure_28 = Closure_28 {};
        let mut A0: *mut Value = null;
        let mut A1: *mut Value = null;
        let mut V0: *mut Value = null;
        let mut V1: *mut Value = null;
        if match(Op0, m_FaddRdx.call(A0, V0)) && match(Op1, m_FaddRdx.call(A1, V1)) && V0.getType() == V1.getType() {
            let mut Sub: *mut Value = self.Builder.CreateFSubFMF(V0, V1, &mut I, "", null);
            let mut Rdx: *mut Value = self.Builder.CreateIntrinsic(vector_reduce_fadd, [Sub.getType()], [A0, Sub], &mut I, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_29 {}, null, null });
            return CreateFSubFMF(Rdx, A1, &mut I, "");
        }
        if factorizeFAddFSub(I, self.Builder) {
            F;
        } else {
            return F;
        }
        if self.Builder.simplify(&mut I) {
            V;
        } else {
            return self.replaceInstUsesWith(I, V);
        }
        if match(Op0, m_OneUse(m_FSub(m_Value(X), m_Value(Y)))) {
            let mut FAdd: *mut Value = self.Builder.CreateFAddFMF(Y, Op1, &mut I, "", null);
            return CreateFSubFMF(X, FAdd, &mut I, "");
        }
    }
    return null;
}

struct Closure_1 {
    I: *mut BinaryOperator,
    X: *mut *mut Value,
    C0: *mut APInt,
    IsSigned: *mut bool,
    cap_4: *mut InstCombinerImpl,
}

unsafe fn Closure_1::call(self: *mut Closure_1, DivSide: *mut Value, RemSide: *mut Value) -> auto {
        let mut Div: *mut Value = null;
        let mut Rem: *mut Value = null;
        let mut C1: APInt = APInt {};
        let mut C2: APInt = APInt {};
        if !DivSide.hasOneUse() || !MatchMul(DivSide, Div, C1) {
            Div = DivSide , C1 = APInt { (*self.I).getType().getScalarSizeInBits(), 1, false, false };
        }
        if !RemSide.hasOneUse() || !MatchMul(RemSide, Rem, C2) {
            Rem = RemSide , C2 = APInt { (*self.I).getType().getScalarSizeInBits(), 1, false, false };
        }
        let mut DivOpV: *mut Value = null;
        let mut DivOpC: APInt = APInt {};
        if MatchRem(Rem, (*self.X), (*self.C0), (*self.IsSigned)) && MatchDiv(Div, DivOpV, DivOpC, (*self.IsSigned)) && (*self.X) == DivOpV && (*self.C0) == DivOpC && !(C1.isOne() && !(*self.IsSigned) && DivOpC.isPowerOf2() && DivOpC != 2) {
            let mut NewC: APInt = C1 - C2 * (*self.C0);
            if !NewC.isZero() && !Rem.hasOneUse() {
                return null;
            }
            if !isGuaranteedNotToBeUndef((*self.X), &mut self.AC, &mut (*self.I), &mut self.DT, 0) {
                return null;
            }
            let mut MulXC2: *mut Value = self.Builder.CreateMul((*self.X), get((*self.X).getType(), C2), "", false, false);
            if NewC.isZero() {
                return MulXC2;
            }
            return self.Builder.CreateAdd(self.Builder.CreateMul(Div, get((*self.X).getType(), NewC), "", false, false), MulXC2, "", false, false);
        }
        return null;
    }

struct Closure_2 {
    I: *mut BinaryOperator,
    Ty: *mut *mut Type,
}

unsafe fn Closure_2::call(self: *mut Closure_2) -> *mut Function {
        return getOrInsertDeclaration((*self.I).getModule(), uadd_sat, (*self.Ty));
    }

