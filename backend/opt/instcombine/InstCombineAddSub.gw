// template <typename FP, typename Mul2Rhs>
// fn matchesSquareSum(I: *mut BinaryOperator, M2Rhs: specific_fpval, A: *mut *mut Value, B: *mut *mut Value) -> bool {
//     let mut MulOp: u32 = if  { FMul } else { Mul };
//     let mut AddOp: u32 = if  { FAdd } else { Add };
