struct FAddendCoef {
    IsFp: bool,
    BufHasFpVal: bool,
    IntVal: i16,
    FpValBuf: AlignedCharArrayUnion<APFloat>,
}

fn FAddendCoef::set(self, C: i16) {
    assert!(!self.insaneIntVal(C), "Insane coefficient");
    self.IsFp = false;
    self.IntVal = C;
}

fn FAddendCoef::isZero(self: *FAddendCoef) -> bool {
    return if self.isInt() { !self.IntVal } else { self.getFpVal().isZero() };
}

fn FAddendCoef::isOne(self: *FAddendCoef) -> bool {
    return self.isInt() && self.IntVal == 1;
}

fn FAddendCoef::isTwo(self: *FAddendCoef) -> bool {
    return self.isInt() && self.IntVal == 2;
}

fn FAddendCoef::isMinusOne(self: *FAddendCoef) -> bool {
    return self.isInt() && self.IntVal == -1;
}

fn FAddendCoef::isMinusTwo(self: *FAddendCoef) -> bool {
    return self.isInt() && self.IntVal == -2;
}

fn FAddendCoef::insaneIntVal(self, V: i32) -> bool {
    return V > 4 || V < -4;
}

fn FAddendCoef::getFpValPtr(self) -> *mut APFloat {}

fn FAddendCoef::getFpValPtr(self: *FAddendCoef) -> *APFloat {}

fn FAddendCoef::getFpVal(self: *FAddendCoef) -> *APFloat {
    assert!(self.IsFp && self.BufHasFpVal, "Incorrect state");
    return *self.getFpValPtr();
}

fn FAddendCoef::getFpVal(self) -> *mut APFloat {
    assert!(self.IsFp && self.BufHasFpVal, "Incorrect state");
    return *self.getFpValPtr();
}

fn FAddendCoef::isInt(self: *FAddendCoef) -> bool {
    return !self.IsFp;
}

struct FAddend {
    Val: *mut Value,
    Coeff: FAddendCoef,
}

fn FAddend::operator+=(self, T: *FAddend) {
    assert!((self.Val == T.Val), "Symbolic-values disagree");
}

fn FAddend::getSymVal(self: *FAddend) -> *mut Value {
    return self.Val;
}

fn FAddend::getCoef(self: *FAddend) -> *FAddendCoef {}

fn FAddend::isConstant(self: *FAddend) -> bool {
    return self.Val == null;
}

fn FAddend::isZero(self: *FAddend) -> bool {}

fn FAddend::set(self, Coefficient: i16, V: *mut Value) {
    self.Val = V;
}

fn FAddend::set(self, Coefficient: *APFloat, V: *mut Value) {
    self.Val = V;
}

fn FAddend::set(self, Coefficient: *ConstantFP, V: *mut Value) {
    self.Val = V;
}

fn FAddend::negate(self) {}

fn FAddend::Scale(self, ScaleAmt: *FAddendCoef) {}

struct FAddCombine {
    CreateInstrNum: u32,
    Builder: *mut BuilderTy,
    Instr: *mut Instruction,
}

fn FAddCombine::initCreateInstNum(self) {
    self.CreateInstrNum = 0;
}

fn FAddCombine::incCreateInstNum(self) {
    self.CreateInstrNum += 1;
}

fn FAddendCoef::~FAddendCoef(self) {
    if self.BufHasFpVal {
        self.getFpValPtr().~APFloat();
    }
}

fn FAddendCoef::set(self, C: *APFloat) {
    let mut P: *mut APFloat = self.getFpValPtr();
    if self.isInt() {
        C;
    } else {
        *P = C;
    }
    self.IsFp = self.BufHasFpVal = true;
}

fn FAddendCoef::convertToFpType(self, Sem: *fltSemantics) {
    if !self.isInt() {
        return;
    }
    let mut P: *mut APFloat = self.getFpValPtr();
    if self.IntVal > 0 {
        APFloat { Sem, self.IntVal };
    } else {
        APFloat { Sem, 0 - self.IntVal };
        P.changeSign();
    }
    self.IsFp = self.BufHasFpVal = true;
}

fn FAddendCoef::createAPFloatFromInt(self, Sem: *fltSemantics, Val: i32) -> APFloat {
    if Val >= 0 {
        return APFloat { Sem, Val };
    }
    let mut T: APFloat = APFloat { Sem, 0 - Val };
    T.changeSign();
    return T;
}

fn FAddendCoef::operator=(self, That: *FAddendCoef) {
    if That.isInt() {
        self.set(That.IntVal);
    } else {
        self.set(That.getFpVal());
    }
}

fn FAddendCoef::operator+=(self, That: *FAddendCoef) {
    let mut RndMode: RoundingMode = NearestTiesToEven;
    if self.isInt() == That.isInt() {
        if self.isInt() {
            self.IntVal += That.IntVal;
        } else {
            self.getFpVal().add(That.getFpVal(), RndMode);
        }
        return;
    }
    if self.isInt() {
        let mut T: *APFloat = That.getFpVal();
        self.convertToFpType(T.getSemantics());
        self.getFpVal().add(T, RndMode);
        return;
    }
    let mut T: *mut APFloat = self.getFpVal();
    T.add(self.createAPFloatFromInt(T.getSemantics(), That.IntVal), RndMode);
}

fn FAddendCoef::operator*=(self, That: *FAddendCoef) {
    if That.isOne() {
        return;
    }
    if That.isMinusOne() {
        self.negate();
        return;
    }
    if self.isInt() && That.isInt() {
        let mut Res: i32 = self.IntVal * That.IntVal as i32;
        assert!(!self.insaneIntVal(Res), "Insane int value");
        self.IntVal = Res;
        return;
    }
    let mut Semantic: *fltSemantics = if self.isInt() { That.getFpVal().getSemantics() } else { self.getFpVal().getSemantics() };
    if self.isInt() {
        self.convertToFpType(Semantic);
    }
    let mut F0: *mut APFloat = self.getFpVal();
    if That.isInt() {
        F0.multiply(self.createAPFloatFromInt(Semantic, That.IntVal), rmNearestTiesToEven);
    } else {
        F0.multiply(That.getFpVal(), rmNearestTiesToEven);
    }
}

fn FAddendCoef::negate(self) {
    if self.isInt() {
        self.IntVal = 0 - self.IntVal;
    } else {
        self.getFpVal().changeSign();
    }
}

fn FAddendCoef::getValue(self: *FAddendCoef, Ty: *mut Type) -> *mut Value {
    return if self.isInt() { get(Ty, self.IntVal) } else { get(Ty.getContext(), self.getFpVal()) };
}

fn FAddend::drillValueDownOneStep(self, Val: *mut Value, Addend0: *mut FAddend, Addend1: *mut FAddend) -> u32 {
    let mut I: *mut Instruction = null;
    if !Val || operator!((I = dyn_cast(Val))) {
        return 0;
    }
    let mut Opcode: u32 = I.getOpcode();
    if Opcode == FAdd || Opcode == FSub {
        let mut C0: *mut ConstantFP = null;
        let mut C1: *mut ConstantFP = null;
        let mut Opnd0: *mut Value = I.getOperand;
        let mut Opnd1: *mut Value = I.getOperand;
        if (C0 = dyn_cast(Opnd0)) && C0.isZero() {
            Opnd0 = null;
        }
        if (C1 = dyn_cast(Opnd1)) && C1.isZero() {
            Opnd1 = null;
        }
        if Opnd0 {
            if !C0 {
                Addend0.set(1, Opnd0);
            } else {
                Addend0.set(C0, null);
            }
        }
        if Opnd1 {
            let mut Addend: *mut FAddend = if Opnd0 { Addend1 } else { Addend0 };
            if !C1 {
                Addend.set(1, Opnd1);
            } else {
                Addend.set(C1, null);
            }
            if Opcode == FSub {
                Addend.negate();
            }
        }
        if Opnd0 || Opnd1 {
            return if Opnd0 && Opnd1 { 2 } else { 1 };
        }
        Addend0.set(C0.getValueAPF().getSemantics(), null);
        return 1;
    }
    if I.getOpcode() == FMul {
        let mut V0: *mut Value = I.getOperand;
        let mut V1: *mut Value = I.getOperand;
        if dyn_cast(V0) {
            C;
        } else {
            Addend0.set(C, V1);
            return 1;
        }
        if dyn_cast(V1) {
            C;
        } else {
            Addend0.set(C, V0);
            return 1;
        }
    }
    return 0;
}

fn FAddend::drillAddendDownOneStep(self: *FAddend, Addend0: *mut FAddend, Addend1: *mut FAddend) -> u32 {
    if self.isConstant() {
        return 0;
    }
    let mut BreakNum: u32 = drillValueDownOneStep(self.Val, Addend0, Addend1);
    if  {
        return BreakNum;
    }
    Addend0.Scale;
    if BreakNum == 2 {
        Addend1.Scale;
    }
    return BreakNum;
}

fn FAddCombine::simplify(self, I: *mut Instruction) -> *mut Value {
    assert!(I.hasAllowReassoc() && I.hasNoSignedZeros(), "Expected 'reassoc'+'nsz' instruction");
    if I.getType() {
        return null;
    }
    assert!((I.getOpcode() == FAdd || I.getOpcode() == FSub), "Expect add/sub");
    self.Instr = I;
    let mut Opnd0: FAddend = FAddend {};
    let mut Opnd1: FAddend = FAddend {};
    let mut Opnd0_0: FAddend = FAddend {};
    let mut Opnd0_1: FAddend = FAddend {};
    let mut Opnd1_0: FAddend = FAddend {};
    let mut Opnd1_1: FAddend = FAddend {};
    let mut OpndNum: u32 = drillValueDownOneStep(I, Opnd0, Opnd1);
    let mut Opnd0_ExpNum: u32 = 0;
    let mut Opnd1_ExpNum: u32 = 0;
    if !Opnd0.isConstant() {
        Opnd0_ExpNum = Opnd0.drillAddendDownOneStep(Opnd0_0, Opnd0_1);
    }
    if OpndNum == 2 && !Opnd1.isConstant() {
        Opnd1_ExpNum = Opnd1.drillAddendDownOneStep(Opnd1_0, Opnd1_1);
    }
    if Opnd0_ExpNum && Opnd1_ExpNum {
        let mut AllOpnds: AddendVect = zeroed();
        AllOpnds()(&mut Opnd0_0);
        AllOpnds()(&mut Opnd1_0);
        if Opnd0_ExpNum == 2 {
            AllOpnds()(&mut Opnd0_1);
        }
        if Opnd1_ExpNum == 2 {
            AllOpnds()(&mut Opnd1_1);
        }
        let mut InstQuota: u32 = 0;
        let mut V0: *mut Value = I.getOperand;
        let mut V1: *mut Value = I.getOperand;
        InstQuota = if ((!isa(V0) && V0.hasOneUse()) && (!isa(V1) && V1.hasOneUse())) { 2 } else { 1 };
        if self.simplifyFAdd(InstQuota) {
            R;
        } else {
            return R;
        }
    }
    if OpndNum != 2 {
        let mut CE: *FAddendCoef = Opnd0.getCoef();
        return if CE.isOne() { Opnd0.getSymVal() } else { null };
    }
    if Opnd1_ExpNum {
        let mut AllOpnds: AddendVect = zeroed();
        AllOpnds()(&mut Opnd0);
        AllOpnds()(&mut Opnd1_0);
        if Opnd1_ExpNum == 2 {
            AllOpnds()(&mut Opnd1_1);
        }
        if self.simplifyFAdd(1) {
            R;
        } else {
            return R;
        }
    }
    if Opnd0_ExpNum {
        let mut AllOpnds: AddendVect = zeroed();
        AllOpnds()(&mut Opnd1);
        AllOpnds()(&mut Opnd0_0);
        if Opnd0_ExpNum == 2 {
            AllOpnds()(&mut Opnd0_1);
        }
        if self.simplifyFAdd(1) {
            R;
        } else {
            return R;
        }
    }
    return null;
}

fn FAddCombine::simplifyFAdd(self, Addends: *mut AddendVect, InstrQuota: u32) -> *mut Value {
    let mut AddendNum: u32 = Addends()();
    assert!(AddendNum <= 4, "Too many addends");
    let mut NextTmpIdx: u32 = 0;
    let mut TmpResult: [3]FAddend = [3]FAddend {};
    let mut SimpVect: AddendVect = zeroed();
    for let mut SymIdx: u32 = 0; SymIdx < AddendNum; SymIdx += 1 {
        let mut ThisAddend: *FAddend = null;
        if !ThisAddend {
            continue;
        }
        let mut Val: *mut Value = ThisAddend.getSymVal();
        let mut StartIdx: u32 = ();
        SimpVect()(ThisAddend);
        for let mut SameSymIdx: u32 = SymIdx + 1; SameSymIdx < AddendNum; SameSymIdx += 1 {
            let mut T: *FAddend = null;
            if T && T.getSymVal() == Val {
                SimpVect()(T);
            }
        }
        if StartIdx + 1 != () {
            let mut R: *mut FAddend = TmpResult[NextTmpIdx += 1];
            R = operator*([StartIdx]);
            for let mut Idx: u32 = StartIdx + 1; Idx < SimpVect()(); Idx += 1 {
                operator+=(R, operator*([Idx]));
            }
            SimpVect()(StartIdx);
            if !R.isZero() {
                SimpVect()(&mut R);
            }
        }
    }
    (((operator!(operator!(((NextTmpIdx <= size(TmpResult) + 1) && "out-of-bound access")))) || (_wassert(L"(NextTmpIdx <= std::size(TmpResult) + 1) && \"out-of-bound access\"", L"llvm\\lib\\Transforms\\InstCombine\\InstCombineAddSub.cpp", (580) as u32) , 0)) as void);
    let mut Result: *mut Value = null;
    if operator!() {
        Result = self.createNaryFAdd(InstrQuota);
    } else {
        Result = get(self.Instr.getType, 0.0);
    }
    return Result;
}

fn FAddCombine::createNaryFAdd(self, Opnds: *AddendVect, InstrQuota: u32) -> *mut Value {
    (((operator!(operator!((operator!(Opnds()()) && "Expect at least one addend")))) || (_wassert(L"!Opnds.empty() && \"Expect at least one addend\"", L"llvm\\lib\\Transforms\\InstCombine\\InstCombineAddSub.cpp", (595) as u32) , 0)) as void);
    let mut InstrNeeded: u32 = self.calcInstrNumber(Opnds);
    if InstrNeeded > InstrQuota {
        return null;
    }
    self.initCreateInstNum();
    let mut LastVal: *mut Value = null;
    let mut LastValNeedNeg: bool = false;
    if LastValNeedNeg {
        LastVal = self.createFNeg(LastVal);
    }
    assert!(self.CreateInstrNum == InstrNeeded, "Inconsistent in instruction numbers");
    return LastVal;
}

fn FAddCombine::createFSub(self, Opnd0: *mut Value, Opnd1: *mut Value) -> *mut Value {
    let mut V: *mut Value = self.Builder(Opnd0, Opnd1);
    if dyn_cast(V) {
        I;
    } else {
        self.createInstPostProc(I, false);
    }
    return V;
}

fn FAddCombine::createFNeg(self, V: *mut Value) -> *mut Value {
    let mut NewV: *mut Value = self.Builder(V);
    if dyn_cast(NewV) {
        I;
    } else {
        self.createInstPostProc(I, true);
    }
    return NewV;
}

fn FAddCombine::createFAdd(self, Opnd0: *mut Value, Opnd1: *mut Value) -> *mut Value {
    let mut V: *mut Value = self.Builder(Opnd0, Opnd1);
    if dyn_cast(V) {
        I;
    } else {
        self.createInstPostProc(I, false);
    }
    return V;
}

fn FAddCombine::createFMul(self, Opnd0: *mut Value, Opnd1: *mut Value) -> *mut Value {
    let mut V: *mut Value = self.Builder(Opnd0, Opnd1);
    if dyn_cast(V) {
        I;
    } else {
        self.createInstPostProc(I, false);
    }
    return V;
}

fn FAddCombine::createInstPostProc(self, NewInstr: *mut Instruction, NoNumber: bool) {
    NewInstr.setDebugLoc(self.Instr.getDebugLoc());
    if !NoNumber {
        self.incCreateInstNum();
    }
    NewInstr.setFastMathFlags(self.Instr.getFastMathFlags());
}

fn FAddCombine::calcInstrNumber(self, Opnds: *AddendVect) -> u32 {
    let mut OpndNum: u32 = Opnds()();
    let mut InstrNeeded: u32 = OpndNum - 1;
    return InstrNeeded;
}

fn FAddCombine::createAddendVal(self, Opnd: *FAddend, NeedNeg: *mut bool) -> *mut Value {
    let mut Coeff: *FAddendCoef = Opnd.getCoef();
    if Opnd.isConstant() {
        NeedNeg = false;
        return Coeff.getValue(self.Instr.getType);
    }
    let mut OpndVal: *mut Value = Opnd.getSymVal();
    if Coeff.isMinusOne() || Coeff.isOne() {
        NeedNeg = Coeff.isMinusOne();
        return OpndVal;
    }
    if Coeff.isTwo() || Coeff.isMinusTwo() {
        NeedNeg = Coeff.isMinusTwo();
        return self.createFAdd(OpndVal, OpndVal);
    }
    NeedNeg = false;
    return self.createFMul(OpndVal, Coeff.getValue(self.Instr.getType));
}

fn checkForNegativeOperand(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Value {
    let mut LHS: *mut Value = I.getOperand(0);
    let mut RHS: *mut Value = I.getOperand(1);
    if !LHS.hasOneUse() && !RHS.hasOneUse() {
        return null;
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut Z: *mut Value = null;
    let mut C1: *APInt = null;
    let mut C2: *APInt = null;
    if match(RHS, m_Add(m_Value(X))) {
        swap(LHS, RHS);
    }
    if match(LHS, m_Add(m_Value(X))) {
        if match(RHS, m_Xor(m_Value(Y))) {
            swap(X, RHS);
        }
        if match(X, m_Xor(m_Value(Y))) {
            if match(Y, m_Or(m_Value(Z))) && (*C2 == operator((*C1))) {
                let mut NewAnd: *mut Value = Builder()(Z, *C1);
                return Builder()(RHS, NewAnd, "sub");
            } else if match(Y, m_And(m_Value(Z))) && (*C1 == *C2) {
                let mut NewOr: *mut Value = Builder()(Z, operator((*C1)));
                return Builder()(RHS, NewOr, "sub");
            }
        }
    }
    LHS = I.getOperand(0);
    RHS = I.getOperand(1);
    if match(RHS, m_Xor(m_Value(Y))) {
        swap(LHS, RHS);
    }
    if match(LHS, m_Xor(m_Value(Y))) {
        if C1.countr_zero() == 0 {
            if match(Y, m_And(m_Value(Z))) && *C1 == (*C2 + 1) {
                let mut NewOr: *mut Value = Builder()(Z, operator((*C2)));
                return Builder()(RHS, NewOr, "sub");
            }
        }
    }
    return null;
}

fn foldNoWrapAdd(Add: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Op0: *mut Value = Add.getOperand(0);
    let mut Op1: *mut Value = Add.getOperand(1);
    let mut Ty: *mut Type = Add.getType;
    let mut Op1C: *mut Constant = null;
    if operator!(match(Op1)) {
        return null;
    }
    let mut X: *mut Value = null;
    let mut C1: *APInt = null;
    let mut C2: *APInt = null;
    if match(Op1) && match(Op0, m_ZExt(m_NUWAddLike(m_Value(X)))) && C1.isNegative() && C1.sge(operator(C2.sext(C1.getBitWidth()))) {
        let mut NewC: APInt = *C2 + C1.trunc(C2.getBitWidth());
        if NewC.isZero() {
            return ZExtInst { X, Ty, "", null };
        }
        if Op0.hasOneUse() {
            return Builder()(X, get(X.getType(), NewC));
        }
    }
    let mut NarrowC: *mut Constant = null;
    if match(Op0, m_OneUse(m_SExtLike(m_NSWAddLike(m_Value(X))))) {
        let mut WideC: *mut Value = Builder()(NarrowC, Ty);
        let mut NewC: *mut Value = Builder()(WideC, Op1C);
        let mut WideX: *mut Value = Builder()(X, Ty);
        return CreateAdd(WideX, NewC, "");
    }
    if match(Op0, m_OneUse(m_ZExt(m_NUWAddLike(m_Value(X))))) {
        let mut WideC: *mut Value = Builder()(NarrowC, Ty);
        let mut NewC: *mut Value = Builder()(WideC, Op1C);
        let mut WideX: *mut Value = Builder()(X, Ty);
        return CreateAdd(WideX, NewC, "");
    }
    return null;
}

fn InstCombinerImpl::foldAddWithConstant(self, Add: *mut BinaryOperator) -> *mut Instruction {
    let mut Op0: *mut Value = Add.getOperand(0);
    let mut Op1: *mut Value = Add.getOperand(1);
    let mut Ty: *mut Type = Add.getType;
    let mut Op1C: *mut Constant = null;
    if !match(Op1, m_ImmConstant(Op1C)) {
        return null;
    }
    if self.foldBinOpIntoSelectOrPhi(Add) {
        NV;
    } else {
        return NV;
    }
    if self.foldBinOpSelectBinOp(Add) {
        FoldedLogic;
    } else {
        return FoldedLogic;
    }
    let mut X: *mut Value = null;
    let mut Op00C: *mut Constant = null;
    if match(Op0, m_Sub(m_Value(X))) {
        return CreateSub(getAdd(Op00C, Op1C, false, false), X, "");
    }
    let mut Y: *mut Value = null;
    if match(Op0, m_OneUse(m_Sub(m_Value(X), m_Value(Y)))) && match(Op1) {
        return CreateAdd(X);
    }
    if match(Op0, m_ZExt(m_Value(X))) && X.getType().getScalarSizeInBits() == 1 {
        return self.createSelectInstWithUnknownProfile(X, AddOne(Op1C), Op1, "", null);
    }
    if match(Op0, m_SExt(m_Value(X))) && X.getType().getScalarSizeInBits() == 1 {
        return self.createSelectInstWithUnknownProfile(X, SubOne(Op1C), Op1, "", null);
    }
    if match(Op0, m_Not(m_Value(X))) {
        let mut COne: *mut Constant = get(Op1C.getType(), 1, false, false);
        let mut WillNotSOV: bool = self.willNotOverflowSignedSub;
        let mut Res: *mut BinaryOperator = CreateSub(getSub(Op1C, COne, false, false), X, "");
        Res.setHasNoSignedWrap(Add.hasNoSignedWrap && WillNotSOV);
        return Res;
    }
    let mut C: *APInt = null;
    let mut BitWidth: u32 = Ty.getScalarSizeInBits();
    if operator!(match(Op1)) {
        return null;
    }
    let mut Op01C: *mut Constant = null;
    if match(Op0, m_DisjointOr(m_Value(X), m_ImmConstant(Op01C))) {
        let mut NewAdd: *mut BinaryOperator = CreateAdd(X, getAdd(Op01C, Op1C, false, false), "");
        NewAdd.setHasNoSignedWrap(Add.hasNoSignedWrap && self.willNotOverflowSignedAdd);
        NewAdd.setHasNoUnsignedWrap(Add.hasNoUnsignedWrap);
        return NewAdd;
    }
    let mut C2: *APInt = null;
    if match(Op0, m_Or(m_Value())) && *C2 == operator(*C) {
        return CreateXor(Op0, get(Add.getType, *C2));
    }
    if C.isSignMask() {
        if Add.hasNoSignedWrap || Add.hasNoUnsignedWrap {
            return CreateDisjointOr(Op0, Op1, "");
        }
        return CreateXor(Op0, Op1, "");
    }
    if match(Op0, m_ZExt(m_Xor(m_Value(X)))) && C2.isMinSignedValue() && C2.sext(Ty.getScalarSizeInBits()) == *C {
        return Create(SExt, X, Ty, "", null);
    }
    if match(Op0, m_Xor(m_Value(X))) {
        if C2.isSignMask() {
            return CreateAdd(X, get(Ty, *C2 ^ *C), "");
        }
        let mut LHSKnown: KnownBits = ;
        if (*C2 | LHSKnown.Zero).isAllOnes() {
            return CreateSub(get(Ty, *C2 + *C), X, "");
        }
        if Op0.hasOneUse() && *C2 == operator((*C)) {
            let mut BitWidth: u32 = Ty.getScalarSizeInBits();
            let mut ShAmt: u32 = 0;
            if C.isPowerOf2() {
                ShAmt = BitWidth - C.logBase2() - 1;
            } else if C2.isPowerOf2() {
                ShAmt = BitWidth - C2.logBase2() - 1;
            }
            if ShAmt && self.MaskedValueIsZero {
                let mut ShAmtC: *mut Constant = get(Ty, ShAmt, false, false);
                let mut NewShl: *mut Value = null;
                return CreateAShr(NewShl, ShAmtC, "");
            }
        }
    }
    if C.isOne() && Op0.hasOneUse() {
        let mut C3: *APInt = null;
        if match(Op0, m_AShr(m_Shl(m_Value(X)))) && C2 == C3 && *C2 == Ty.getScalarSizeInBits() - 1 {
            let mut NotX: *mut Value = null;
            return CreateAnd(NotX, get(Ty, 1, false, false), "");
        }
    }
    if match(Op0, m_OneUse(m_UMax(m_Value(X)))) {
        return self.replaceInstUsesWith;
    }
    {
        let mut SatC: APInt = operator(*C);
        if match(Op0, m_OneUse(m_Intrinsic(m_Value(X)))) {
            return self.replaceInstUsesWith;
        }
    }
    {
        let mut InnerC: *APInt = null;
        if match(Op0, m_ZExt(m_Add(m_Value(X)))) {
            let mut NarrowBW: u32 = InnerC.getBitWidth();
            if C.isIntN(NarrowBW) {
                let mut NarrowC: APInt = C.trunc(NarrowBW);
                let mut Q: SimplifyQuery = zeroed();
                if *InnerC == operator(NarrowC) && (if NarrowC.isOne() { isKnownNonZero(X, Q, 0) } else { ()(NarrowC) }) {
                    return ZExtInst { X, Ty, "", null };
                }
            }
        }
    }
    return null;
}

