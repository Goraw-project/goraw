    let mut MinusOne: *mut Constant = getAllOnesValue(NBits.getType());
    let mut NotMask: *mut Value = Builder()(MinusOne, NBits, "notmask");
    if  {
        BOp()();
        BOp()(I.hasNoUnsignedWrap);
    }
