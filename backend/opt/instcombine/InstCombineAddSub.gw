}

fn foldToUnsignedSaturatedAdd(I: *mut BinaryOperator) -> *mut Instruction {
    assert!(I.getOpcode() == Add, "Expecting add instruction");
    let mut Ty: *mut Type = I.getType;
    let mut getUAddSat: Closure_2 = Closure_2 { I: &mut I, Ty: &mut Ty };
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(&mut I, m_c_Add(m_c_UMin(m_Value(X), m_Not(m_Value(Y))))) {
        return Create(getUAddSat(), void { X, Y });
    }
    let mut C: *APInt = null;
    let mut NotC: *APInt = null;
    if match(&mut I, m_Add(m_UMin(m_Value(X)))) && *C == operator(*NotC) {
        return Create(getUAddSat(), void { X, get(Ty, *C) });
    }
    return null;
}

fn combineAddSubWithShlAddSub(Builder: *mut BuilderTy, I: *BinaryOperator) -> *mut Instruction {
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut Cnt: *mut Value = null;
    if match(&mut I, m_c_Add(m_OneUse(m_Shl(m_OneUse(m_Neg(m_Value(B))), m_Value(Cnt))), m_Value(A))) {
        let mut NewShl: *mut Value = Builder()(B, Cnt);
        return CreateSub(A, NewShl, "");
    }
    return null;
}

fn foldAddToAshr(Add: *mut BinaryOperator) -> *mut Instruction {
    let mut X: *mut Value = null;
    let mut DivC: *APInt = null;
    if operator!(match(Add.getOperand(0), m_SDiv(m_Value(X)))) || DivC.isNegative() {
        return null;
    }
    let mut MaskC: *APInt = null;
    let mut MaskCCmp: *APInt = null;
    let mut Pred: CmpPredicate = CmpPredicate {};
    if operator!(match(Add.getOperand(1), m_SExt(m_ICmp(Pred, m_And(m_Specific(X)))))) {
        return null;
    }
    if (Pred != ICMP_UGT || !MaskCCmp.isSignMask()) && (Pred != ICMP_EQ || *MaskCCmp != *MaskC) {
        return null;
    }
    let mut SMin: APInt = getSignedMinValue(Add.getType());
    let mut IsMaskValid: bool = if Pred == ICMP_UGT { (*MaskC == (SMin | (*DivC - 1))) } else { (*DivC == 2 && *MaskC == SMin + 1) };
    if !IsMaskValid {
        return null;
    }
    return CreateAShr(X, get(Add.getType, DivC.exactLogBase2()));
}

fn InstCombinerImpl::foldAddLikeCommutative(self, LHS: *mut Value, RHS: *mut Value, NSW: bool, NUW: bool) -> *mut Instruction {
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut C: *mut Value = null;
    if match(LHS, m_Sub(m_Value(A), m_Value(B))) && match(RHS, m_Sub(m_Value(C), m_Specific(A))) {
        let mut R: *mut Instruction = CreateSub(C, B, "");
        let mut NSWOut: bool = NSW && match(LHS, m_NSWSub(m_Value(), m_Value())) && match(RHS, m_NSWSub(m_Value(), m_Value()));
        let mut NUWOut: bool = match(LHS, m_NUWSub(m_Value(), m_Value())) && match(RHS, m_NUWSub(m_Value(), m_Value()));
        R.setHasNoSignedWrap(NSWOut);
        R.setHasNoUnsignedWrap(NUWOut);
        return R;
    }
    let mut C1: *APInt = null;
    let mut C2: *APInt = null;
    if match(LHS, m_Shl(m_SDiv(m_Specific(RHS)))) {
        let mut One: APInt = APInt { C2.getBitWidth(), 1, false, false };
        let mut MinusC1: APInt = operator((*C1));
        if MinusC1 == (One << *C2) {
            let mut NewRHS: *mut Constant = get(RHS.getType(), MinusC1);
            return CreateSRem(RHS, NewRHS, "");
        }
    }
    if match(LHS, m_c_Add(m_Value(A))) && match(RHS, m_c_And(m_Value(B))) {
        if !LHS.hasOneUse() && !RHS.hasOneUse() {
            return null;
        }
        let mut NSWOut: bool = NSW && match(LHS, m_NSWAdd(m_Value(), m_Value()));
        let mut NUWOut: bool = NUW && match(LHS, m_NUWAdd(m_Value(), m_Value()));
        let mut NewOr: *mut Value = null;
        let mut NewAdd: *mut Instruction = CreateAdd(A, NewOr, "");
        NewAdd.setHasNoSignedWrap(NSWOut);
        NewAdd.setHasNoUnsignedWrap(NUWOut);
        return NewAdd;
    }
    return null;
}

fn InstCombinerImpl::canonicalizeCondSignextOfHighBitExtractToSignextHighBitExtract(self, I: *mut BinaryOperator) -> *mut Instruction {
    assert!((I.getOpcode() == Add || I.getOpcode() == Or || I.getOpcode() == Sub), "Expecting add/or/sub instruction");
    let mut X: *mut Value = null;
    let mut Select: *mut Value = null;
    let mut LowBitsToSkip: *mut Instruction = null;
    let mut Extract: *mut Instruction = null;
    if operator!(match(&mut I, m_c_BinOp(m_TruncOrSelf(m_Instruction(Extract, m_LShr(m_Value(X), m_Instruction(LowBitsToSkip)))), m_Value(Select)))) {
        return null;
    }
    if I.getOpcode() == Sub && I.getOperand(1) != Select {
        return null;
    }
    let mut XTy: *mut Type = X.getType();
    let mut HadTrunc: bool = I.getType != XTy;
    if HadTrunc && operator!(match(&mut I, m_c_BinOp(m_OneUse(m_Value()), m_Value()))) {
        return null;
    }
    let mut NBits: *mut Value = null;
    if operator!(match(LowBitsToSkip, m_ZExtOrSelf(m_Sub(m_ZExtOrSelf(m_Value(NBits)))))) {
        return null;
    }
    let mut SkipExtInMagic: Closure_3 = Closure_3 { I: &mut I };
    SkipExtInMagic.call(Select);
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut Thr: *APInt = null;
    let mut SignExtendingValue: *mut Value = null;
    let mut Zero: *mut Value = null;
    let mut ShouldSignext: bool = false;
    if operator!(match(Select, m_Select(m_ICmp(Pred, m_Specific(X)), m_Value(SignExtendingValue), m_Value(Zero)))) || !isSignBitCheck(Pred.operator llvm::CmpInst::Predicate(), *Thr, ShouldSignext) {
        return null;
    }
    if !ShouldSignext {
        swap(SignExtendingValue, Zero);
    }
    if !match(Zero, m_Zero()) {
        return null;
    }
    SkipExtInMagic.call(SignExtendingValue);
    let mut SignExtendingValueBaseConstant: *mut Constant = null;
    if operator!(match(SignExtendingValue, m_Shl(m_ZExtOrSelf(m_Specific(NBits))))) {
        return null;
    }
    if if I.getOpcode() == Sub { operator!(match(SignExtendingValueBaseConstant)) } else { operator!(match(SignExtendingValueBaseConstant)) } {
        return null;
    }
    let mut NewAShr: *mut auto = CreateAShr(X, LowBitsToSkip, Extract.getName + ".sext");
    NewAShr()(Extract);
    if !HadTrunc {
        return ;
    }
    return CreateTruncOrBitCast(I.getType);
}

fn factorizeMathWithShlOps(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    assert!((I.getOpcode() == Add || I.getOpcode() == Sub), "Expected add/sub");
    let mut Op0: *mut auto = dyn_cast(I.getOperand(0));
    let mut Op1: *mut auto = dyn_cast(I.getOperand(1));
    if operator!() || operator!() || operator!((Op0()() || ())) {
        return null;
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut ShAmt: *mut Value = null;
    if operator!(match(m_Shl(m_Value(X), m_Value(ShAmt)))) || operator!(match(m_Shl(m_Value(Y), m_Specific(ShAmt)))) {
        return null;
    }
    let mut HasNSW: bool = I.hasNoSignedWrap && () && ();
    let mut HasNUW: bool = I.hasNoUnsignedWrap && () && ();
    let mut NewMath: *mut Value = Builder()(I.getOpcode(), X, Y);
    if  {
        NewI()(HasNSW);
        NewI()(HasNUW);
    }
    let mut NewShl: *mut auto = CreateShl(NewMath, ShAmt, "");
    NewShl()(HasNSW);
    NewShl()(HasNUW);
    return ;
}

fn foldBoxMultiply(I: *mut BinaryOperator) -> *mut Instruction {
    let mut BitWidth: u32 = I.getType();
    if (BitWidth & 1) {
        return null;
    }
    let mut HalfBits: u32 = BitWidth >> 1;
    let mut HalfMask: APInt = getMaxValue(HalfBits);
    let mut XLo: *mut Value = null;
    let mut YLo: *mut Value = null;
    let mut CrossSum: *mut Value = null;
    if operator!(match(&mut I, m_c_Add(m_Shl(m_Value(CrossSum)), m_OneUse(m_Mul(m_Value(YLo), m_Value(XLo)))))) {
        return null;
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if operator!(match(XLo, m_And(m_Value(X)))) || operator!(match(YLo, m_And(m_Value(Y)))) {
        return null;
    }
    if match(CrossSum, m_c_Add(m_c_Mul(m_LShr(m_Specific(Y)), m_CombineOr(m_Specific(X), m_Specific(XLo))), m_c_Mul(m_LShr(m_Specific(X)), m_CombineOr(m_Specific(Y), m_Specific(YLo))))) {
        return CreateMul(X, Y, "");
    }
    return null;
}

fn checkDivCeilNUW(X: *mut Value, Y: *mut Value, SQ: *SimplifyQuery) -> bool {
    let mut CRX: ConstantRange = computeConstantRange(X, false, SQ, 0);
    let mut CRY: ConstantRange = computeConstantRange(Y, false, SQ, 0);
    let mut MinY: APInt = CRY.getUnsignedMin();
    let mut MaxX: APInt = CRX.getUnsignedMax();
    let mut MaxY: APInt = CRY.getUnsignedMax();
    return !MinY.isZero() && !MaxX.ugt(operator(MaxY));
}

fn InstCombinerImpl::foldDivCeil(self, I: *mut BinaryOperator) -> *mut Instruction {
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut UDivPat: auto = m_OneUse(m_UDiv(m_Value(X), m_Value(Y)));
    let mut URemPat: auto = m_OneUse(m_URem());
    let mut ICmpPat: auto = m_OneUse(m_SpecificICmp(ICMP_NE, m_Zero()));
    let mut DivPat: auto = m_OneUse(m_ZExtOrSelf());
    let mut ZExtCmpPat: auto = m_OneUse(m_ZExt());
    if operator!(match(&mut I, m_c_Add())) || operator!(checkDivCeilNUW(X, Y)) {
        return null;
    }
    let mut YMinusOne: *mut Value = null;
    let mut NUWAdd: *mut Value = null;
    if X.getType() != I.getType {
        let mut Div: *mut Value = null;
        return Div;
    }
    return CreateUDiv(NUWAdd, Y, "");
}

fn InstCombinerImpl::visitAdd(self, I: *mut BinaryOperator) -> *mut Instruction {
    if simplifyAddInst(I.getOperand(0), I.getOperand(1), I.hasNoSignedWrap, I.hasNoUnsignedWrap) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if self.SimplifyAssociativeOrCommutative(I) {
        return &mut I;
    }
    if self.foldVectorBinop(I) {
        X;
    } else {
        return X;
    }
    if self.foldBinopWithPhiOperands(I) {
        Phi;
    } else {
        return Phi;
    }
    if self.foldUsingDistributiveLaws(I) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if foldBoxMultiply(I) {
        R;
    } else {
        return R;
    }
    if factorizeMathWithShlOps(I) {
        R;
    } else {
        return R;
    }
    if self.foldAddWithConstant(I) {
        X;
    } else {
        return X;
    }
    if foldNoWrapAdd(I) {
        X;
    } else {
        return X;
    }
    if self.foldBinOpShiftWithShift(I) {
        R;
    } else {
        return R;
    }
    if combineAddSubWithShlAddSub(I) {
        R;
    } else {
        return R;
    }
    let mut LHS: *mut Value = I.getOperand(0);
    let mut RHS: *mut Value = I.getOperand(1);
    if self.foldAddLikeCommutative(LHS, RHS, I.hasNoSignedWrap, I.hasNoUnsignedWrap) {
        R;
    } else {
        return R;
    }
    if self.foldAddLikeCommutative(RHS, LHS, I.hasNoSignedWrap, I.hasNoUnsignedWrap) {
        R;
    } else {
        return R;
    }
    let mut Ty: *mut Type = I.getType;
    if Ty.isIntOrIntVectorTy(1) {
        return CreateXor(LHS, RHS, "");
    }
    if LHS == RHS {
        let mut Shl: *mut auto = CreateShl(LHS, get(Ty, 1, false, false), "");
        Shl()(I.hasNoSignedWrap);
        Shl()(I.hasNoUnsignedWrap);
        return ;
    }
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    if match(LHS, m_Neg(m_Value(A))) {
        if match(RHS, m_Neg(m_Value(B))) {
            return CreateNeg();
        }
        let mut Sub: *mut BinaryOperator = CreateSub(RHS, A, "");
        let mut OB0: *mut auto = cast(LHS);
        Sub.setHasNoSignedWrap(I.hasNoSignedWrap && ());
        return Sub;
    }
    if match(RHS, m_Neg(m_Value(B))) {
        let mut Sub: *mut BinaryOperator = CreateSub(LHS, B, "");
        let mut OBO: *mut auto = cast(RHS);
        Sub.setHasNoSignedWrap(I.hasNoSignedWrap && ());
        return Sub;
    }
    if checkForNegativeOperand(I) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if match(&mut I, m_c_BinOp(m_Add(m_Value(A)), m_Not(m_Value(B)))) || match(&mut I, m_BinOp(m_c_Add(m_Not(m_Value(B)), m_Value(A)))) {
        return CreateSub(A, B, "");
    }
    {
        let mut C: *APInt = null;
        if match(&mut I, m_c_BinOp(m_OneUse(m_Add(m_Value(A))), m_Not(m_Value(B)))) || match(&mut I, m_BinOp(m_OneUse(m_c_Add(m_Not(m_Value(B)), m_Value(A))))) {
            let mut Sub: *mut Value = null;
            return CreateAdd(Sub, get(Ty, *C - 1), "");
        }
    }
    if match(LHS, m_OneUse(m_c_Add(m_Value(A), m_Specific(RHS)))) {
        return CreateAdd(A);
    }
    if match(RHS, m_OneUse(m_c_Add(m_Value(A), m_Specific(LHS)))) {
        return CreateAdd(A);
    }
    {
        let mut C1: *mut Constant = null;
        let mut C2: *mut Constant = null;
        if match(&mut I, m_c_Add(m_Add(m_Value(A), m_ImmConstant(C1)), m_Sub(m_ImmConstant(C2), m_Value(B)))) && (LHS.hasOneUse() || RHS.hasOneUse()) {
            let mut Sub: *mut Value = null;
            return CreateAdd(Sub, getAdd(C1, C2, false, false), "");
        }
        if match(&mut I, m_c_Add(m_OneUse(m_Sub(m_ImmConstant(C1), m_Value(A))), m_Value(B))) {
            let mut Sub: *mut Value = null;
            return CreateAdd(Sub, C1, "");
        }
    }
    if self.SimplifyAddWithRemainder(I) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    let mut C1: *APInt = null;
    if match(&mut I, m_c_Add(m_And(m_Value(A)))) && C1.isPowerOf2() && (self.ComputeNumSignBits > C1.countl_zero()) {
        let mut NewMask: *mut Constant = get(RHS.getType(), *C1 - 1);
