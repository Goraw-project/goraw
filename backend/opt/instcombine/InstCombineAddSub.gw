struct Closure_13 {
    cap_0: *mut InstCombinerImpl,
    I: *mut BinaryOperator,
    Op0: *mut *mut Value,
    Op1: *mut *mut Value,
}

unsafe fn Closure_13::call(self: *mut Closure_13) -> auto {
        if self.narrowMathIfNoOverflow((*self.I)) {
            Ext;
        } else {
            return Ext;
        }
        let mut Changed: bool = false;
        if !(*self.I).hasNoSignedWrap() && self.willNotOverflowSignedSub((*self.Op0), (*self.Op1), (*self.I)) {
            Changed = true;
            (*self.I).setHasNoSignedWrap(true);
        }
        if !(*self.I).hasNoUnsignedWrap() && self.willNotOverflowUnsignedSub((*self.Op0), (*self.Op1), (*self.I)) {
            Changed = true;
            (*self.I).setHasNoUnsignedWrap(true);
        }
        return if Changed { &mut (*self.I) } else { null };
    }

