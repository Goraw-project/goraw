fn foldFNegIntoConstant(I: *mut Instruction, DL: *DataLayout) -> *mut Instruction {
    let mut FNegOp: *mut Instruction = null;
    if operator!(match(&mut I, m_FNeg(m_OneUse(m_Instruction(FNegOp))))) {
        return null;
    }
    let mut X: *mut Value = null;
    let mut C: *mut Constant = null;
    if match(FNegOp, m_FMul(m_Value(X))) {
        if ConstantFoldUnaryOpOperand(FNeg, C, DL) {
            NegC;
        } else {
            let mut FNegF: FastMathFlags = I.getFastMathFlags();
            let mut OpF: FastMathFlags = FNegOp.getFastMathFlags();
            let mut FMF: FastMathFlags = unionValue(FNegF, OpF) | intersectRewrite(FNegF, OpF);
            FMF.setNoInfs(FNegF.noInfs() && OpF.noInfs());
            return CreateFMulFMF(X, NegC, FMF, "");
        }
    }
    if match(FNegOp, m_FDiv(m_Value(X))) {
        if ConstantFoldUnaryOpOperand(FNeg, C, DL) {
            NegC;
        } else {
            let mut FDiv: *mut Instruction = CreateFDivFMF(X, NegC, &mut I, "");
            let mut FMF: FastMathFlags = I.getFastMathFlags();
            let mut OpFMF: FastMathFlags = FNegOp.getFastMathFlags();
            FDiv.setHasNoSignedZeros(FMF.noSignedZeros() && OpFMF.noSignedZeros());
            FDiv.setHasNoInfs(FMF.noInfs() && OpFMF.noInfs());
            FDiv.copyMetadata(*FNegOp);
            return FDiv;
        }
    }
    if match(FNegOp, m_FDiv(m_Value(X))) {
        if ConstantFoldUnaryOpOperand(FNeg, C, DL) {
            NegC;
        } else {
            let mut FDiv: *mut Instruction = CreateFDivFMF(NegC, X, &mut I, "");
            let mut FMF: FastMathFlags = I.getFastMathFlags();
            let mut OpFMF: FastMathFlags = FNegOp.getFastMathFlags();
            FDiv.setHasNoSignedZeros(FMF.noSignedZeros() && OpFMF.noSignedZeros());
            FDiv.setHasNoInfs(FMF.noInfs() && OpFMF.noInfs());
            FDiv.copyMetadata(*FNegOp);
            return FDiv;
        }
    }
    if I.hasNoSignedZeros() && match(FNegOp, m_FAdd(m_Value(X))) {
        if ConstantFoldUnaryOpOperand(FNeg, C, DL) {
            NegC;
        } else {
            return CreateFSubFMF(NegC, X, &mut I, "");
        }
    }
    return null;
}

fn InstCombinerImpl::hoistFNegAboveFMulFDiv(self, FNegOp: *mut Value, FMFSource: *mut Instruction) -> *mut Instruction {
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(FNegOp, m_FMul(m_Value(X), m_Value(Y))) {
        return cast();
    }
    if match(FNegOp, m_FDiv(m_Value(X), m_Value(Y))) {
        let mut FDiv: *mut auto = cast();
        FDiv()(operator*(cast(FNegOp)));
        return ;
    }
    if dyn_cast(FNegOp) {
        II;
    } else {
        if II.getIntrinsicID() == ldexp {
            let mut FMF: FastMathFlags = FMFSource.getFastMathFlags() | II.getFastMathFlags;
            let mut New: *mut CallInst = null;
            New.setFastMathFlags;
            New.copyMetadata;
            return New;
        }
    }
    return null;
}

fn InstCombinerImpl::visitFNeg(self, I: *mut UnaryOperator) -> *mut Instruction {
    let mut Op: *mut Value = I.getOperand;
    if simplifyFNegInst(Op, I.getFastMathFlags, self.getSimplifyQuery(&mut I)) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if foldFNegIntoConstant(I) {
        X;
    } else {
        return X;
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if I.hasNoSignedZeros && match(Op, m_OneUse(m_FSub(m_Value(X), m_Value(Y)))) {
        return CreateFSubFMF(Y, X, &mut I);
    }
    let mut OneUse: *mut Value = null;
    if operator!(match(Op, m_OneUse(m_Value(OneUse)))) {
        return null;
    }
    if self.hoistFNegAboveFMulFDiv {
        R;
    } else {
        return self.replaceInstUsesWith;
    }
    let mut Cond: *mut Value = null;
    if match(OneUse, m_Select(m_Value(Cond), m_Value(X), m_Value(Y))) {
        let mut propagateSelectFMF: Closure_12 = Closure_12 { I: &mut I, Op: &mut Op };
        let mut P: *mut Value = null;
        if match(X, m_FNeg(m_Value(P))) {
            let mut NegY: *mut Value = null;
            let mut NewSel: *mut SelectInst = Create(Cond, P, NegY, "", null, null);
            propagateSelectFMF.call(NewSel, P == Y);
            return NewSel;
        }
        if match(Y, m_FNeg(m_Value(P))) {
            let mut NegX: *mut Value = null;
            let mut NewSel: *mut SelectInst = Create(Cond, NegX, P, "", null, null);
            propagateSelectFMF.call(NewSel, P == X);
            return NewSel;
        }
        if match(X, m_ImmConstant()) || match(Y, m_ImmConstant()) {
            let mut NegX: *mut Value = null;
            let mut NegY: *mut Value = null;
            let mut NewSel: *mut SelectInst = Create(Cond, NegX, NegY, "", null, null);
            propagateSelectFMF.call(NewSel, true);
            return NewSel;
        }
    }
    if match(OneUse, m_CopySign(m_Value(X), m_Value(Y))) {
        let mut FMF: FastMathFlags = I.getFastMathFlags;
        operator&=(FMF, cast(OneUse)());
        let mut NegY: *mut Value = null;
        let mut NewCopySign: *mut Value = null;
        return self.replaceInstUsesWith;
    }
    let mut Mask: ArrayRef<int> = zeroed();
    if match(OneUse, m_VecReverse(m_Value(X))) {
        let mut Reverse: *mut Value = null;
        return self.replaceInstUsesWith;
    }
    return null;
}

fn InstCombinerImpl::visitFSub(self, I: *mut BinaryOperator) -> *mut Instruction {
    if simplifyFSubInst(I.getOperand(0), I.getOperand(1), I.getFastMathFlags, self.getSimplifyQuery(&mut I)) {
        V;
    } else {
        return self.replaceInstUsesWith;
    }
    if self.foldVectorBinop(I) {
        X;
    } else {
        return X;
    }
    if self.foldBinopWithPhiOperands(I) {
        Phi;
    } else {
        return Phi;
    }
    let mut Op: *mut Value = null;
    if match(&mut I, m_FNeg(m_Value(Op))) {
        return CreateFNegFMF(Op, &mut I);
