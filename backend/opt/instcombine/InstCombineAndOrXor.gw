    if IsLogical {
        let mut MDFrom: *mut Instruction = if isa(I) { &mut I } else { null };
        return if IsAnd { Builder()(LHS, SubstituteCmp, "", MDFrom) } else { Builder()(LHS, SubstituteCmp, "", MDFrom) };
    }
    return Builder()(if IsAnd { And } else { Or }, LHS, SubstituteCmp);
}

