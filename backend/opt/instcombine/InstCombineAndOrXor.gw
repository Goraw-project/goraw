fn foldUnsignedUnderflowCheck(PredL: CmpPredicate, LHS0: *mut Value, LHS1: *mut Value, LHSOneUse: bool, PredR: CmpPredicate, RHS0: *mut Value, RHS1: *mut Value, RHSOneUse: bool, IsAnd: bool, Q: *SimplifyQuery, Builder: *mut BuilderTy) -> *mut Value {
