static mut ProfcheckDisableMetadataFixes: i32 = 0;

fn getNewICmpValue(Code: u32, Sign: bool, LHS: *mut Value, RHS: *mut Value, Builder: *mut BuilderTy) -> *mut Value {
    let mut NewPred: Predicate = zeroed();
    if getPredForICmpCode(Code, Sign, LHS.getType(), NewPred) {
        TorF;
    } else {
        return TorF;
    }
    return Builder()(NewPred, LHS, RHS);
}

fn getFCmpValue(Code: u32, LHS: *mut Value, RHS: *mut Value, Builder: *mut BuilderTy, FMF: FMFSource) -> *mut Value {
    let mut NewPred: Predicate = zeroed();
    if getPredForFCmpCode(Code, LHS.getType(), NewPred) {
        TorF;
    } else {
        return TorF;
    }
    return Builder()(NewPred, LHS, RHS, FMF);
}

fn InstCombinerImpl::insertRangeTest(self, V: *mut Value, Lo: *APInt, Hi: *APInt, isSigned: bool, Inside: bool) -> *mut Value {
    assert!((if isSigned { Lo.slt(Hi) } else { Lo.ult(Hi) }), "Lo is not < Hi in range emission code!");
    let mut Ty: *mut Type = V.getType();
    let mut Pred: Predicate = if Inside { ICMP_ULT } else { ICMP_UGE };
    if if isSigned { Lo.isMinSignedValue() } else { Lo.isMinValue() } {
        Pred = if isSigned { getSignedPredicate(Pred) } else { Pred };
    }
    let mut VMinusLo: *mut Value = null;
    let mut HiMinusLo: *mut Constant = get(Ty, Hi - Lo);
}

enum MaskedICmpType {
    AMask_AllOnes = 0,
    AMask_NotAllOnes = 1,
    BMask_AllOnes = 2,
    BMask_NotAllOnes = 3,
    Mask_AllZeros = 4,
    Mask_NotAllZeros = 5,
    AMask_Mixed = 6,
    AMask_NotMixed = 7,
    BMask_Mixed = 8,
    BMask_NotMixed = 9,
}

fn getMaskedICmpType(A: *mut Value, B: *mut Value, C: *mut Value, Pred: Predicate) -> u32 {
    let mut ConstA: *APInt = null;
    let mut ConstB: *APInt = null;
    let mut ConstC: *APInt = null;
    match(A);
    match(B);
    match(C);
    let mut IsEq: bool = (Pred == ICMP_EQ);
    let mut IsAPow2: bool = ConstA && ConstA.isPowerOf2();
    let mut IsBPow2: bool = ConstB && ConstB.isPowerOf2();
    let mut MaskVal: u32 = 0;
    if ConstC && ConstC.isZero() {
        MaskVal |= (if IsEq { (Mask_AllZeros | AMask_Mixed | BMask_Mixed) } else { (Mask_NotAllZeros | AMask_NotMixed | BMask_NotMixed) });
        if IsAPow2 {
            MaskVal |= (if IsEq { (AMask_NotAllOnes | AMask_NotMixed) } else { (AMask_AllOnes | AMask_Mixed) });
        }
        if IsBPow2 {
            MaskVal |= (if IsEq { (BMask_NotAllOnes | BMask_NotMixed) } else { (BMask_AllOnes | BMask_Mixed) });
        }
        return MaskVal;
    }
    if A == C {
        MaskVal |= (if IsEq { (AMask_AllOnes | AMask_Mixed) } else { (AMask_NotAllOnes | AMask_NotMixed) });
        if IsAPow2 {
            MaskVal |= (if IsEq { (Mask_NotAllZeros | AMask_NotMixed) } else { (Mask_AllZeros | AMask_Mixed) });
        }
    } else if ConstA && ConstC && ConstC.isSubsetOf(*ConstA) {
        MaskVal |= (if IsEq { AMask_Mixed } else { AMask_NotMixed });
    }
    if B == C {
        MaskVal |= (if IsEq { (BMask_AllOnes | BMask_Mixed) } else { (BMask_NotAllOnes | BMask_NotMixed) });
        if IsBPow2 {
            MaskVal |= (if IsEq { (Mask_NotAllZeros | BMask_NotMixed) } else { (Mask_AllZeros | BMask_Mixed) });
        }
    } else if ConstB && ConstC && ConstC.isSubsetOf(*ConstB) {
        MaskVal |= (if IsEq { BMask_Mixed } else { BMask_NotMixed });
    }
    return MaskVal;
}

fn conjugateICmpMask(Mask: u32) -> u32 {
    let mut NewMask: u32 = 0;
    NewMask = (Mask & (AMask_AllOnes | BMask_AllOnes | Mask_AllZeros | AMask_Mixed | BMask_Mixed)) << 1;
    NewMask |= (Mask & (AMask_NotAllOnes | BMask_NotAllOnes | Mask_NotAllZeros | AMask_NotMixed | BMask_NotMixed)) >> 1;
    return NewMask;
}

fn decomposeBitTest(Cond: *mut Value, Pred: *mut Predicate, X: *mut *mut Value, Y: *mut *mut Value, Z: *mut *mut Value) -> bool {
    let mut Res: auto = decomposeBitTest(Cond, true, true, true);
    if operator!() {
        return false;
    }
    Pred = ;
    X = ;
    Y = get(X.getType());
    Z = get(X.getType());
    return true;
}

fn getMaskedTypeForICmpPair(A: *mut *mut Value, B: *mut *mut Value, C: *mut *mut Value, D: *mut *mut Value, E: *mut *mut Value, LHS: *mut Value, RHS: *mut Value, PredL: *mut Predicate, PredR: *mut Predicate) -> pair<unsigned int, unsigned int>> {
    let mut L1: *mut Value = null;
    let mut L11: *mut Value = null;
    let mut L12: *mut Value = null;
    let mut L2: *mut Value = null;
    let mut L21: *mut Value = null;
    let mut L22: *mut Value = null;
    if decomposeBitTest(LHS, PredL, L11, L12, L2) {
        L21 = L22 = L1 = null;
    } else {
        let mut LHSCMP: *mut auto = dyn_cast(LHS);
        if operator!() {
            return nullopt();
        }
        if operator!((0)()()) {
            return nullopt();
        }
        PredL = ();
        L1 = (0);
        L2 = (1);
        if operator!(match(L1, m_And(m_Value(L11), m_Value(L12)))) {
            L11 = L1;
            L12 = getAllOnesValue(L1.getType());
        }
        if operator!(match(L2, m_And(m_Value(L21), m_Value(L22)))) {
            L21 = L2;
            L22 = getAllOnesValue(L2.getType());
        }
    }
    if !isEquality(PredL) {
        return nullopt();
    }
    let mut R11: *mut Value = null;
    let mut R12: *mut Value = null;
    let mut R2: *mut Value = null;
    if decomposeBitTest(RHS, PredR, R11, R12, R2) {
        if R11 == L11 || R11 == L12 || R11 == L21 || R11 == L22 {
            A = R11;
            D = R12;
        } else if R12 == L11 || R12 == L12 || R12 == L21 || R12 == L22 {
            A = R12;
            D = R11;
        } else {
            return nullopt();
        }
        E = R2;
    } else {
        let mut RHSCMP: *mut auto = dyn_cast(RHS);
        if operator!() {
            return nullopt();
        }
        if operator!((0)()()) {
            return nullopt();
        }
        PredR = ();
        let mut R1: *mut Value = (0);
        R2 = (1);
        let mut Ok: bool = false;
        if operator!(match(R1, m_And(m_Value(R11), m_Value(R12)))) {
            R11 = R1;
            R12 = getAllOnesValue(R1.getType());
        }
        if R11 == L11 || R11 == L12 || R11 == L21 || R11 == L22 {
            A = R11;
            D = R12;
            E = R2;
            Ok = true;
        } else if R12 == L11 || R12 == L12 || R12 == L21 || R12 == L22 {
            A = R12;
            D = R11;
            E = R2;
            Ok = true;
        }
        if Ok && match(A) {
            Ok = false;
        }
        if !Ok {
            if operator!(match(R2, m_And(m_Value(R11), m_Value(R12)))) {
                R11 = R2;
                R12 = getAllOnesValue(R2.getType());
            }
            if R11 == L11 || R11 == L12 || R11 == L21 || R11 == L22 {
                A = R11;
                D = R12;
                E = R1;
            } else if R12 == L11 || R12 == L12 || R12 == L21 || R12 == L22 {
                A = R12;
                D = R11;
                E = R1;
            } else {
                return nullopt();
            }
        }
    }
    if !isEquality(PredR) {
        return nullopt();
    }
    if L11 == A {
        B = L12;
        C = L2;
    } else if L12 == A {
        B = L11;
        C = L2;
    } else if L21 == A {
        B = L22;
        C = L1;
    } else if L22 == A {
        B = L21;
        C = L1;
    }
    let mut LeftType: u32 = getMaskedICmpType(A, B, C, PredL);
    let mut RightType: u32 = getMaskedICmpType(A, D, E, PredR);
}

fn foldLogOpOfMaskedICmps_NotAllZeros_BMask_Mixed(LHS: *mut Value, RHS: *mut Value, IsAnd: bool, A: *mut Value, B: *mut Value, D: *mut Value, E: *mut Value, PredL: Predicate, PredR: Predicate, Builder: *mut BuilderTy) -> *mut Value {
    let mut BCst: *APInt = null;
    let mut DCst: *APInt = null;
    let mut OrigECst: *APInt = null;
    if operator!(match(B)) || operator!(match(D)) || operator!(match(E)) {
        return null;
    }
    let mut NewCC: Predicate = if IsAnd { ICMP_EQ } else { ICMP_NE };
    let mut ECst: APInt = *OrigECst;
    if PredR != NewCC {
        operator(ECst, *DCst);
    }
    if *BCst == 0 || *DCst == 0 {
        return null;
    }
    if !BCst.intersects(*DCst) {
        let mut Src: *mut Value = null;
        if *DCst == ECst && match(A, m_ElementWiseBitCast(m_Value(Src))) && operator!(Builder()()()(StrictFP)) {
            let mut Ty: *mut Type = Src.getType().getScalarType();
            if !Ty.isIEEELikeFPTy() {
                return null;
            }
            let mut ExpBits: APInt = getInf(Ty.getFltSemantics(), false).bitcastToAPInt();
            if ECst != ExpBits {
                return null;
            }
            let mut FractionBits: APInt = operator(ExpBits);
            FractionBits.clearSignBit();
            if *BCst != FractionBits {
                return null;
            }
            return Builder()(if IsAnd { FCMP_UNO } else { FCMP_ORD }, Src, getZero(Src.getType(), false));
        }
        return null;
    }
    if (((*BCst & *DCst) & ECst) == 0) && (*BCst & (*BCst ^ *DCst)).isPowerOf2() {
        let mut BorD: APInt = *BCst | *DCst;
        let mut BandBxorDorE: APInt = (*BCst & (*BCst ^ *DCst)) | ECst;
        let mut NewMask: *mut Value = get(A.getType(), BorD);
        let mut NewMaskedValue: *mut Value = get(A.getType(), BandBxorDorE);
        let mut NewAnd: *mut Value = Builder()(A, NewMask);
        return Builder()(NewCC, NewAnd, NewMaskedValue);
    }
    let mut IsSubSetOrEqual: Closure_1 = Closure_1 {};
    let mut IsSuperSetOrEqual: Closure_2 = Closure_2 {};
    if !IsSubSetOrEqual.call(BCst, DCst) && !IsSuperSetOrEqual.call(BCst, DCst) {
        return null;
    }
    if ECst.isZero() {
        if IsSubSetOrEqual.call(BCst, DCst) {
            return get(LHS.getType(), !IsAnd, false, false);
        }
        return null;
    }
    if IsSuperSetOrEqual.call(BCst, DCst) {
        if  {
            ICmp()(false);
        }
        return RHS;
    }
    assert!(IsSubSetOrEqual.call(BCst, DCst), "Precondition due to above code");
    if (*BCst & ECst) != 0 {
        if  {
            ICmp()(false);
        }
        return RHS;
    }
    return get(LHS.getType(), !IsAnd, false, false);
}

fn foldLogOpOfMaskedICmpsAsymmetric(LHS: *mut Value, RHS: *mut Value, IsAnd: bool, A: *mut Value, B: *mut Value, C: *mut Value, D: *mut Value, E: *mut Value, PredL: Predicate, PredR: Predicate, LHSMask: u32, RHSMask: u32, Builder: *mut BuilderTy) -> *mut Value {
    assert!(isEquality(PredL) && isEquality(PredR), "Expected equality predicates for masked type of icmps.");
    if !IsAnd {
        LHSMask = conjugateICmpMask(LHSMask);
        RHSMask = conjugateICmpMask(RHSMask);
    }
    if (LHSMask & Mask_NotAllZeros) && (RHSMask & BMask_Mixed) {
        if foldLogOpOfMaskedICmps_NotAllZeros_BMask_Mixed(LHS, RHS, IsAnd, A, B, D, E, PredL, PredR, Builder) {
            V;
        } else {
            return V;
        }
    } else if (LHSMask & BMask_Mixed) && (RHSMask & Mask_NotAllZeros) {
        if foldLogOpOfMaskedICmps_NotAllZeros_BMask_Mixed(RHS, LHS, IsAnd, A, D, B, C, PredR, PredL, Builder) {
            V;
        } else {
            return V;
        }
    }
    return null;
}

fn foldLogOpOfMaskedICmps(LHS: *mut Value, RHS: *mut Value, IsAnd: bool, IsLogical: bool, Builder: *mut BuilderTy, Q: *SimplifyQuery) -> *mut Value {
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut C: *mut Value = null;
    let mut D: *mut Value = null;
    let mut E: *mut Value = null;
    let mut PredL: Predicate = zeroed();
    let mut PredR: Predicate = zeroed();
    let mut MaskPair: pair<unsigned int, unsigned int>> = zeroed();
    if operator!() {
        return null;
    }
    assert!(isEquality(PredL) && isEquality(PredR), "Expected equality predicates for masked type of icmps.");
    let mut LHSMask: u32 = ;
    let mut RHSMask: u32 = ;
    let mut Mask: u32 = LHSMask & RHSMask;
    if Mask == 0 {
        if foldLogOpOfMaskedICmpsAsymmetric(LHS, RHS, IsAnd, A, B, C, D, E, PredL, PredR, LHSMask, RHSMask, Builder) {
            V;
        } else {
            return V;
        }
        return null;
    }
    let mut NewCC: Predicate = if IsAnd { ICMP_EQ } else { ICMP_NE };
    if !IsAnd {
        Mask = conjugateICmpMask(Mask);
    }
    if Mask & Mask_AllZeros {
        if IsLogical && !isGuaranteedNotToBeUndefOrPoison(D, null, null, null, 0) {
            return null;
        }
        let mut NewOr: *mut Value = Builder()(B, D);
        let mut NewAnd: *mut Value = Builder()(A, NewOr);
        let mut Zero: *mut Value = getNullValue(A.getType());
        return Builder()(NewCC, NewAnd, Zero);
    }
    if Mask & BMask_AllOnes {
        if IsLogical && !isGuaranteedNotToBeUndefOrPoison(D, null, null, null, 0) {
            return null;
        }
        let mut NewOr: *mut Value = Builder()(B, D);
        let mut NewAnd: *mut Value = Builder()(A, NewOr);
        return Builder()(NewCC, NewAnd, NewOr);
    }
    if Mask & AMask_AllOnes {
        if IsLogical && !isGuaranteedNotToBeUndefOrPoison(D, null, null, null, 0) {
            return null;
        }
        let mut NewAnd1: *mut Value = Builder()(B, D);
        let mut NewAnd2: *mut Value = Builder()(A, NewAnd1);
        return Builder()(NewCC, NewAnd2, A);
    }
    let mut ConstB: *APInt = null;
    let mut ConstD: *APInt = null;
    if match(B) && match(D) {
        if Mask & (Mask_NotAllZeros | BMask_NotAllOnes) {
            let mut NewMask: APInt = *ConstB & *ConstD;
            if NewMask == *ConstB {
                return LHS;
            }
            if NewMask == *ConstD {
                if IsLogical {
                    if  {
                        RHSI()();
                    }
                }
                return RHS;
            }
        }
        if Mask & AMask_NotAllOnes {
            let mut NewMask: APInt = *ConstB | *ConstD;
            if NewMask == *ConstB {
                return LHS;
            }
            if NewMask == *ConstD {
                return RHS;
            }
        }
        if Mask & (BMask_Mixed | BMask_NotMixed) {
            let mut OldConstC: *APInt = null;
            let mut OldConstE: *APInt = null;
            if operator!(match(C)) || operator!(match(E)) {
                return null;
            }
            let mut FoldBMixed: Closure_3 = Closure_3 { PredL: &mut PredL, ConstB: &mut ConstB, OldConstC: &mut OldConstC, PredR: &mut PredR, ConstD: &mut ConstD, OldConstE: &mut OldConstE, LHS: &mut LHS, IsAnd: &mut IsAnd, Builder: &mut Builder, A: &mut A };
            if Mask & BMask_Mixed {
                return FoldBMixed.call(NewCC, false);
            }
            if Mask & BMask_NotMixed {
                return FoldBMixed.call(NewCC, true);
            }
        }
    }
    if Mask & Mask_NotAllZeros && isKnownToBeAPowerOfTwo(B, false, Q, 0) && isKnownToBeAPowerOfTwo(D, false, Q, 0) {
        if IsLogical {
            D = Builder()(D);
        }
        let mut Mask: *mut Value = Builder()(B, D);
        let mut Masked: *mut Value = Builder()(A, Mask);
        return Builder()(NewCC, Masked, Mask);
    }
    return null;
}

fn InstCombinerImpl::simplifyRangeCheck(self, PredL: CmpPredicate, LHS0: *mut Value, LHS1: *mut Value, PredR: CmpPredicate, RHS0: *mut Value, RHS1: *mut Value, CtxI: *mut Instruction, Inverted: bool) -> *mut Value {
    let mut RangeStart: *mut ConstantInt = dyn_cast(LHS1);
    if !RangeStart {
        return null;
    }
    if Inverted {
        PredL = getInverse(PredL);
        PredR = getInverse(PredR);
    }
    if !((PredL == ICMP_SGT && RangeStart.isMinusOne()) || (PredL == ICMP_SGE && RangeStart.isZero())) {
        return null;
    }
    let mut Input: *mut Value = LHS0;
    let mut RangeEnd: *mut Value = null;
    if match(RHS0, m_SExtOrSelf(m_Specific(Input))) {
        Input = RHS0;
        RangeEnd = RHS1;
    } else if match(RHS1, m_SExtOrSelf(m_Specific(Input))) {
        Input = RHS1;
        RangeEnd = RHS0;
        PredR = getSwapped(PredR);
    } else {
        return null;
    }
    let mut NewPred: Predicate = zeroed();
    match PredR.operator llvm::CmpInst::Predicate() {
        ICMP_SLT => {
            NewPred = ICMP_ULT;
        },
        ICMP_SLE => {
            NewPred = ICMP_ULE;
        },
        _ => {
            return null;
        },
    }
    let mut Known: KnownBits = ;
    if !Known.isNonNegative() {
        return null;
    }
    if Inverted {
        NewPred = getInversePredicate(NewPred);
    }
}

fn foldAndOrOfICmpsWithPow2AndWithZero(Builder: *mut BuilderTy, PredL: CmpPredicate, LHS0: *mut Value, LHS1: *mut Value, LHSOneUse: bool, PredR: CmpPredicate, RHS0: *mut Value, RHS1: *mut Value, RHSOneUse: bool, IsAnd: bool, Q: *SimplifyQuery) -> *mut Value {
    let mut Pred: Predicate = if IsAnd { ICMP_NE } else { ICMP_EQ };
    if PredL != Pred || PredR != Pred {
        return null;
    }
    if match(RHS1, m_Zero()) {
        swap(PredL, PredR);
        swap(LHS0, RHS0);
        swap(LHS1, RHS1);
    }
    if RHS1 == LHS0 {
        swap(RHS0, RHS1);
    }
    if !LHSOneUse || !RHSOneUse || !match(LHS1, m_Zero()) || RHS0 != LHS0 || match(RHS1) || !isKnownToBeAPowerOfTwo(RHS1, true, Q, 0) {
        return null;
    }
    let mut And: *mut Value = Builder()(LHS0, RHS1);
    return Builder()(Pred, And, LHS0);
}

fn foldSignedTruncationCheck(PredL: CmpPredicate, LHS0: *mut Value, LHS1: *mut Value, PredR: CmpPredicate, RHS0: *mut Value, RHS1: *mut Value, CtxI: *mut Instruction, Builder: *mut BuilderTy) -> *mut Value {
    assert!(CtxI.getOpcode() == And);
    let mut tryToMatchSignedTruncationCheck: Closure_4 = Closure_4 {};
    let mut X1: *mut Value = null;
    let mut HighestBit: APInt = APInt {};
    if tryToMatchSignedTruncationCheck.call(PredR, RHS0, RHS1, X1, HighestBit) {
        swap(PredL, PredR);
        swap(LHS0, RHS0);
        swap(LHS1, RHS1);
    } else if !tryToMatchSignedTruncationCheck.call(PredL, LHS0, LHS1, X1, HighestBit) {
        return null;
    }
    assert!(HighestBit.isPowerOf2(), "expected to be power of two (non-zero)");
    let mut tryToDecompose: Closure_5 = Closure_5 {};
    let mut X0: *mut Value = null;
    let mut UnsetBitsMask: APInt = APInt {};
    if !tryToDecompose.call(PredR, RHS0, RHS1, X0, UnsetBitsMask) {
        return null;
    }
    assert!(!UnsetBitsMask.isZero(), "empty mask makes no sense.");
    let mut X: *mut Value = null;
    if X1 == X0 {
        X = X1;
    } else if match(X0, m_Trunc(m_Specific(X1))) {
        UnsetBitsMask = UnsetBitsMask.zext(X1.getType().getScalarSizeInBits());
        X = X1;
    } else {
        return null;
    }
    let mut SignBitsMask: APInt = operator((HighestBit - 1));
    if !UnsetBitsMask.intersects(SignBitsMask) {
        return null;
    }
    if !UnsetBitsMask.isSubsetOf(SignBitsMask) {
        let mut OtherHighestBit: APInt = (operator(UnsetBitsMask)) + 1;
        if !OtherHighestBit.isPowerOf2() {
            return null;
        }
        HighestBit = umin(HighestBit, OtherHighestBit);
    }
    return Builder()(X, get(X.getType(), HighestBit), CtxI.getName + ".simplified");
}

fn foldIsPowerOf2OrZero(PredL: CmpPredicate, LHS0: *mut Value, LHS1: *mut Value, PredR: CmpPredicate, RHS0: *mut Value, RHS1: *mut Value, IsAnd: bool, Builder: *mut BuilderTy, IC: *mut InstCombinerImpl) -> *mut Value {
    let mut X: *mut Value = null;
    if operator!(match(LHS0, m_Ctpop(m_Value(X)))) || operator!(match(LHS1)) || RHS0 != X || operator!(match(RHS1)) {
        return null;
    }
    let mut CtPop: *mut auto = cast(LHS0);
    if IsAnd && PredL == ICMP_NE && PredR == ICMP_NE {
        CtPop()();
        IC.addToWorklist();
        return Builder()(get(1));
    }
    if !IsAnd && PredL == ICMP_EQ && PredR == ICMP_EQ {
        CtPop()();
        IC.addToWorklist();
        return Builder()(get(2));
    }
    return null;
}

fn foldIsPowerOf2(PredL: CmpPredicate, LHS0: *mut Value, LHS1: *mut Value, PredR: CmpPredicate, RHS0: *mut Value, RHS1: *mut Value, JoinedByAnd: bool, Builder: *mut BuilderTy, IC: *mut InstCombinerImpl) -> *mut Value {
    if PredR == (if JoinedByAnd { ICMP_NE } else { ICMP_EQ }) {
        swap(PredL, PredR);
        swap(LHS0, RHS0);
        swap(LHS1, RHS1);
    }
    if JoinedByAnd && PredL == ICMP_NE && match(LHS1) && PredR == ICMP_ULT && match(RHS0, m_Ctpop(m_Specific(LHS0))) && match(RHS1) {
        let mut CtPop: *mut auto = cast(RHS0);
        CtPop()();
        IC.addToWorklist();
        return Builder()(get(1));
    }
    if !JoinedByAnd && PredL == ICMP_EQ && match(LHS1) && PredR == ICMP_UGT && match(RHS0, m_Ctpop(m_Specific(LHS0))) && match(RHS1) {
        let mut CtPop: *mut auto = cast(RHS0);
        CtPop()();
        IC.addToWorklist();
        return Builder()(get(1));
    }
    return null;
}

fn foldNegativePower2AndShiftedMask(A: *mut Value, B: *mut Value, D: *mut Value, E: *mut Value, PredL: Predicate, PredR: Predicate, Builder: *mut BuilderTy) -> *mut Value {
    assert!(isEquality(PredL) && isEquality(PredR), "Expected equality predicates for masked type of icmps.");
    if PredL != ICMP_EQ || PredR != ICMP_NE {
        return null;
    }
    if operator!(match(B)) || operator!(match(D)) || operator!(match(E)) {
        return null;
    }
    let mut isReducible: Closure_6 = Closure_6 {};
    if  {
