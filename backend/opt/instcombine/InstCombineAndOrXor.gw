    let mut Y: *mut Value = null;
    if LHS0 == RHS0 {
        Y = RHS1;
        PredR = getSwapped(PredR);
    } else if LHS0 == RHS1 {
        Y = RHS0;
    } else {
        return null;
    }
    let mut SubstituteCmp: *mut Value = simplifyICmpInst(PredR, Y, LHS1, Q);
    if !SubstituteCmp {
        if !RHSOneUse {
            return null;
        }
        SubstituteCmp = Builder()(PredR, Y, LHS1);
