        let mut ConstVec: *mut Constant = null;
        let mut ShuffleMask: ArrayRef<int> = zeroed();
        if operator!(match(SrcVecI, m_Shuffle(m_Value(Vec)))) {
            return false;
        }
        let mut VecTy: *mut auto = dyn_cast(Vec.getType());
        if operator!() {
            return false;
        }
        let mut NumVecElts: u32 = ();
        let mut FoundVecOffset: bool = false;
        for let mut Idx: u32 = 0; Idx < ShuffleMask()(); Idx += 1 {
            if ShuffleMask()[Idx] == PoisonMaskElem {
                return false;
            }
            let mut ShuffleIdx: u32 = [Idx];
            if ShuffleIdx >= NumVecElts {
                let mut ConstIdx: u32 = ShuffleIdx - NumVecElts;
                let mut ConstElt: *mut auto = dyn_cast(ConstVec.getAggregateElement(ConstIdx));
                if operator!() || operator!() {
                    return false;
                }
                continue;
            }
            if FoundVecOffset {
