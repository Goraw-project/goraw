        if  {
            return self.replaceInstUsesWith(I);
        }
    }
    if match(Op0, m_OneUse()) {
        let mut IsLogical: bool = isa(Op0);
        if  {
            return self.replaceInstUsesWith(I);
        }
    }
    if reassociateFCmps(I) {
        FoldedFCmps;
    } else {
        return FoldedFCmps;
    }
    if self.foldCastedBitwiseLogic(I) {
        CastedAnd;
    } else {
        return CastedAnd;
    }
    if self.foldBinopOfSextBoolToSelect(I) {
        Sel;
    } else {
        return Sel;
    }
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    if match(&mut I, m_c_And(m_SExt(m_Value(A)), m_Value(B))) && A.getType().isIntOrIntVectorTy(1) {
        return self.createSelectInstWithUnknownProfile(A, B, getNullValue(Ty), "", null);
    }
    if match(&mut I, m_c_And(m_Not(m_SExt(m_Value(A))), m_Value(B))) && A.getType().isIntOrIntVectorTy(1) {
        return self.createSelectInstWithUnknownProfile(A, getNullValue(Ty), B, "", null);
    }
    if match(&mut I, m_c_And(m_OneUse(m_ZExt(m_Value(A))), m_Value(B))) && A.getType().isIntOrIntVectorTy(1) {
        return self.createSelectInstWithUnknownProfile;
    }
    if match(&mut I, m_c_And(m_OneUse(m_Add(m_ZExtOrSelf(m_Value(A)))), m_Value(B))) {
        if A.getType().isIntOrIntVectorTy(1) {
            return self.createSelectInstWithUnknownProfile(A, getNullValue(Ty), B, "", null);
        }
        if () <= 1 {
            return self.createSelectInstWithUnknownProfile;
        }
    }
    if match(&mut I, m_c_And(m_OneUse(m_SExtOrSelf(m_AShr(m_Value(X)))), m_Value(Y))) && *C == X.getType().getScalarSizeInBits() - 1 {
        let mut IsNeg: *mut Value = null;
        return self.createSelectInstWithUnknownProfile(IsNeg, Y, getNullValue(Ty), "", null);
    }
    if match(&mut I, m_c_And(m_OneUse(m_SExtOrSelf(m_Not(m_AShr(m_Value(X))))), m_Value(Y))) && *C == X.getType().getScalarSizeInBits() - 1 {
        let mut IsNeg: *mut Value = null;
        return self.createSelectInstWithUnknownProfile(IsNeg, getNullValue(Ty), Y, "", null);
    }
    if self.sinkNotIntoOtherHandOfLogicalOp {
        return &mut I;
    }
    let mut PN: *mut PHINode = null;
    let mut Start: *mut Value = null;
    let mut Step: *mut Value = null;
    if  {
        return self.replaceInstUsesWith;
    }
    if reassociateForUses(I) {
        R;
    } else {
        return R;
    }
    if canonicalizeLogicFirst(I) {
        Canonicalized;
    } else {
        return Canonicalized;
    }
    if self.foldLogicOfIsFPClass(I, Op0, Op1) {
        Folded;
    } else {
        return Folded;
    }
    if self.foldBinOpOfDisplacedShifts(I) {
        Res;
    } else {
        return Res;
    }
    if foldBitwiseLogicWithIntrinsics(I) {
        Res;
    } else {
        return Res;
    }
    if simplifyAndOrWithOpReplaced(Op0, Op1, getAllOnesValue(Ty), false, *self, 0) {
        V;
    } else {
        return CreateAnd(V, Op1, "");
    }
    if simplifyAndOrWithOpReplaced(Op1, Op0, getAllOnesValue(Ty), false, *self, 0) {
        V;
    } else {
        return CreateAnd(Op0, V, "");
    }
    if foldRoundUpToPow2Alignment(I) {
        Res;
    } else {
        return Res;
    }
    return null;
}

fn InstCombinerImpl::matchBSwapOrBitReverse(self, I: *mut Instruction, MatchBSwaps: bool, MatchBitReversals: bool) -> *mut Instruction {
    let mut Insts: SmallVector<Instruction *, 4> = zeroed();
    if operator!(recognizeBSwapOrBitReverseIdiom(&mut I, MatchBSwaps, MatchBitReversals)) {
        return null;
    }
    let mut LastInst: *mut Instruction = ();
    LastInst.removeFromParent();
    return LastInst;
}

fn InstCombinerImpl::convertOrOfShiftsToFunnelShift(self, Or: *mut Instruction) -> ID, SmallVector<Value *, 3>>> {
    assert!(Or.getOpcode() == Or, "Expecting or instruction");
    let mut Width: u32 = Or.getType();
    let mut Or0: *mut Instruction = null;
    let mut Or1: *mut Instruction = null;
    if operator!(match(Or.getOperand, m_Instruction(Or0))) || operator!(match(Or.getOperand, m_Instruction(Or1))) {
        return nullopt();
    }
    let mut IsFshl: bool = true;
    let mut FShiftArgs: SmallVector<Value *, 3> = zeroed();
    if isa(Or0) && isa(Or1) {
        let mut ShVal0: *mut Value = null;
        let mut ShVal1: *mut Value = null;
        let mut ShAmt0: *mut Value = null;
        let mut ShAmt1: *mut Value = null;
        if operator!(match(Or0, m_OneUse(m_LogicalShift(m_Value(ShVal0), m_Value(ShAmt0))))) || operator!(match(Or1, m_OneUse(m_LogicalShift(m_Value(ShVal1), m_Value(ShAmt1))))) || Or0.getOpcode() == Or1.getOpcode() {
            return nullopt();
        }
        if Or0.getOpcode() == LShr {
            swap(Or0, Or1);
            swap(ShVal0, ShVal1);
            swap(ShAmt0, ShAmt1);
        }
        assert!(Or0.getOpcode() == Shl && Or1.getOpcode() == LShr, "Illegal or(shift,shift) pair");
        let mut matchShiftAmount: Closure_14 = Closure_14 { cap_0: self, Or: &mut Or, ShVal0: &mut ShVal0, ShVal1: &mut ShVal1 };
        let mut ShAmt: *mut Value = matchShiftAmount.call(ShAmt0, ShAmt1, Width);
        if !ShAmt {
            ShAmt = matchShiftAmount.call(ShAmt1, ShAmt0, Width);
            IsFshl = false;
        }
        if !ShAmt {
            return nullopt();
        }
        FShiftArgs() = void { ShVal0, ShVal1, ShAmt };
    } else if isa(Or0) || isa(Or1) {
        if !isa(Or1) {
            swap(Or0, Or1);
        }
        let mut High: *mut Value = null;
        let mut ZextHigh: *mut Value = null;
        let mut Low: *mut Value = null;
        let mut ZextHighShlAmt: *APInt = null;
        if operator!(match(Or0, m_OneUse(m_Shl(m_Value(ZextHigh))))) {
            return nullopt();
        }
        if operator!(match(Or1, m_ZExt(m_Value(Low)))) || operator!(match(ZextHigh, m_ZExt(m_Value(High)))) {
            return nullopt();
        }
        let mut HighSize: u32 = High.getType().getScalarSizeInBits();
        let mut LowSize: u32 = Low.getType().getScalarSizeInBits();
        if ZextHighShlAmt.ult(LowSize) || ZextHighShlAmt.ugt(Width - HighSize) {
            return nullopt();
        }
    }
    if FShiftArgs()() {
        return nullopt();
    }
    let mut IID: ID = if IsFshl { fshl } else { fshr };
}

fn matchFunnelShift(Or: *mut Instruction, IC: *mut InstCombinerImpl) -> *mut Instruction {
    if  {
        let mut F: *mut Function = getOrInsertDeclaration(Or.getModule(), Or.getType);
        return Create(F);
    }
    return null;
}

fn matchOrConcat(Or: *mut Instruction, Builder: *mut BuilderTy) -> *mut Value {
    assert!(Or.getOpcode() == Or, "bswap requires an 'or'");
    let mut Op0: *mut Value = Or.getOperand;
    let mut Op1: *mut Value = Or.getOperand;
    let mut Ty: *mut Type = Or.getType;
    let mut Width: u32 = Ty.getScalarSizeInBits();
    if (Width & 1) != 0 {
        return null;
    }
    let mut HalfWidth: u32 = Width / 2;
    if !isa(Op0) {
        swap(Op0, Op1);
    }
    let mut LowerSrc: *mut Value = null;
    let mut ShlVal: *mut Value = null;
    let mut UpperSrc: *mut Value = null;
    let mut C: *APInt = null;
    if operator!(match(Op0, m_OneUse(m_ZExt(m_Value(LowerSrc))))) || operator!(match(Op1, m_OneUse(m_Shl(m_Value(ShlVal))))) || operator!(match(ShlVal, m_OneUse(m_ZExt(m_Value(UpperSrc))))) {
        return null;
    }
    if *C != HalfWidth || LowerSrc.getType() != UpperSrc.getType() || LowerSrc.getType().getScalarSizeInBits() != HalfWidth {
        return null;
    }
    let mut ConcatIntrinsicCalls: Closure_15 = Closure_15 { Builder: &mut Builder, Ty: &mut Ty, HalfWidth: &mut HalfWidth };
    let mut LowerBSwap: *mut Value = null;
    let mut UpperBSwap: *mut Value = null;
    if match(LowerSrc, m_BSwap(m_Value(LowerBSwap))) && match(UpperSrc, m_BSwap(m_Value(UpperBSwap))) {
        return ConcatIntrinsicCalls(bswap, UpperBSwap, LowerBSwap);
    }
    let mut LowerBRev: *mut Value = null;
    let mut UpperBRev: *mut Value = null;
    if match(LowerSrc, m_BitReverse(m_Value(LowerBRev))) && match(UpperSrc, m_BitReverse(m_Value(UpperBRev))) {
        return ConcatIntrinsicCalls(bitreverse, UpperBRev, LowerBRev);
    }
    let mut X: *mut Value = null;
    if match(LowerSrc, m_SExtOrSelf(m_Value(X))) && match(UpperSrc, m_SExtOrSelf(m_AShr(m_Specific(X)))) {
        return Builder()(X, Ty);
    }
    return null;
}

fn areInverseVectorBitmasks(C1: *mut Constant, C2: *mut Constant) -> bool {
    let mut NumElts: u32 = cast(C1.getType())();
    for let mut i: u32 = 0; i != NumElts; i += 1 {
        let mut EltC1: *mut Constant = C1.getAggregateElement(i);
        let mut EltC2: *mut Constant = C2.getAggregateElement(i);
        if !EltC1 || !EltC2 {
            return false;
        }
        if operator!(((match(EltC1, m_Zero()) && match(EltC2)) || (match(EltC2, m_Zero()) && match(EltC1)))) {
            return false;
        }
    }
    return true;
}

fn InstCombinerImpl::getSelectCondition(self, A: *mut Value, B: *mut Value, ABIsTheSame: bool) -> *mut Value {
    let mut Ty: *mut Type = A.getType();
    if !Ty.isIntOrIntVectorTy() || !B.getType().isIntOrIntVectorTy() {
        return null;
    }
    if if ABIsTheSame { (A == B) } else { match(B, m_Not(m_Specific(A))) } {
        if Ty.isIntOrIntVectorTy(1) {
            return A;
        }
        A = peekThroughBitcast(A, false);
        if A.getType().isIntOrIntVectorTy() {
            let mut NumSignBits: u32 = self.ComputeNumSignBits;
        }
        return null;
    }
    if ABIsTheSame {
        return null;
    }
    let mut AConst: *mut Constant = null;
    let mut BConst: *mut Constant = null;
    let mut Cond: *mut Value = null;
    let mut NotB: *mut Value = null;
    if match(A, m_SExt(m_Value(Cond))) && Cond.getType().isIntOrIntVectorTy(1) {
        if match(B, m_SExt(m_Not(m_Specific(Cond)))) {
            return Cond;
        }
        if match(B, m_OneUse(m_Not(m_Value(NotB)))) {
            NotB = peekThroughBitcast(NotB, true);
            if match(NotB, m_SExt(m_Specific(Cond))) {
                return Cond;
            }
        }
    }
    if !Ty.isVectorTy() {
        return null;
    }
    if match(A, (m_Xor(m_SExt(m_Value(Cond))))) && match(B, (m_Xor(m_SExt(m_Specific(Cond))))) && Cond.getType().isIntOrIntVectorTy(1) && areInverseVectorBitmasks(AConst, BConst) {
        AConst = getTrunc(AConst, makeCmpResultType(Ty), false);
    }
    return null;
}

fn InstCombinerImpl::matchSelectFromAndOr(self, A: *mut Value, B: *mut Value, C: *mut Value, D: *mut Value, InvertFalseVal: bool) -> *mut Value {
    let mut OrigType: *mut Type = A.getType();
    A = peekThroughBitcast(A, true);
    C = peekThroughBitcast(C, true);
    if self.getSelectCondition(A, C, InvertFalseVal) {
        Cond;
    } else {
        let mut SelTy: *mut Type = A.getType();
        if  {
            let mut Elts: u32 = ()();
            let mut SelEltSize: u32 = SelTy.getPrimitiveSizeInBits()();
            let mut EltTy: *mut Type = null;
            SelTy = get(EltTy);
        }
        let mut BitcastB: *mut Value = null;
        let mut BitcastD: *mut Value = null;
        let mut Select: *mut Value = null;
    }
    return null;
}

fn foldAndOrOfICmpEqConstantAndICmp(PredL: CmpPredicate, LHS0: *mut Value, LHS1: *mut Value, LHSOneUse: bool, PredR: CmpPredicate, RHS0: *mut Value, RHS1: *mut Value, RHSOneUse: bool, IsAnd: bool, IsLogical: bool, Builder: *mut IRBuilderBase) -> *mut Value {
    if IsAnd {
        PredL = getInverse(PredL);
        PredR = getInverse(PredR);
    }
    let mut CInt: *APInt = null;
    if PredL != ICMP_EQ || operator!(match(LHS1)) || !LHS0.getType().isIntOrIntVectorTy() || !(LHSOneUse || RHSOneUse) {
        return null;
    }
    let mut MatchRHSOp: Closure_16 = Closure_16 { LHS0: LHS0, CInt: CInt };
    let mut Other: *mut Value = null;
    if PredR == ICMP_ULT && MatchRHSOp(RHS1) {
        Other = RHS0;
    } else if PredR == ICMP_UGT && MatchRHSOp(RHS0) {
        Other = RHS1;
    } else {
        return null;
    }
    if IsLogical {
        Other = Builder.CreateFreeze(Other, "");
    }
    return Builder.CreateICmp(if IsAnd { ICMP_ULT } else { ICMP_UGE }, Builder.CreateSub(LHS0, get(LHS0.getType(), *CInt + 1), "", false, false), Other, "");
}

fn InstCombinerImpl::foldAndOrOfICmps(self, LHS: *mut Value, RHS: *mut Value, I: *mut Instruction, IsAnd: bool, IsLogical: bool) -> *mut Value {
    let mut PredL: CmpPredicate = CmpPredicate {};
    let mut PredR: CmpPredicate = CmpPredicate {};
    let mut LHS0: *mut Value = null;
    let mut LHS1: *mut Value = null;
    let mut RHS0: *mut Value = null;
    let mut RHS1: *mut Value = null;
    if operator!(match(LHS, m_ICmpLike(PredL, m_Value(LHS0), m_Value(LHS1)))) || operator!(match(RHS, m_ICmpLike(PredR, m_Value(RHS0), m_Value(RHS1)))) {
        return null;
    }
    let mut LHSOneUse: bool = LHS.hasOneUse();
    let mut RHSOneUse: bool = RHS.hasOneUse();
    let mut Q: SimplifyQuery = zeroed();
    let mut LHSC: *APInt = null;
    let mut RHSC: *APInt = null;
    match(LHS1);
    match(RHS1);
    if predicatesFoldable(PredL.operator llvm::CmpInst::Predicate(), PredR.operator llvm::CmpInst::Predicate()) {
        if LHS0 == RHS1 && LHS1 == RHS0 {
            PredL = CmpPredicate { Pred: getSwappedPredicate(PredL.operator llvm::CmpInst::Predicate()), HasSameSign: false };
            swap(LHS0, LHS1);
        }
        if LHS0 == RHS0 && LHS1 == RHS1 {
            let mut Code: u32 = if IsAnd { getICmpCode(PredL.operator llvm::CmpInst::Predicate()) & getICmpCode(PredR.operator llvm::CmpInst::Predicate()) } else { getICmpCode(PredL.operator llvm::CmpInst::Predicate()) | getICmpCode(PredR.operator llvm::CmpInst::Predicate()) };
            let mut IsSigned: bool = isSigned(PredL.operator llvm::CmpInst::Predicate()) || isSigned(PredR.operator llvm::CmpInst::Predicate());
            return getNewICmpValue(Code, IsSigned, LHS0, LHS1);
        }
    }
    if foldAndOrOfICmpEqConstantAndICmp(PredL, LHS0, LHS1, LHSOneUse, PredR, RHS0, RHS1, RHSOneUse, IsAnd, IsLogical) {
        V;
    } else {
        return V;
    }
    if foldAndOrOfICmpEqConstantAndICmp(PredR, RHS0, RHS1, RHSOneUse, PredL, LHS0, LHS1, LHSOneUse, IsAnd, false) {
        V;
    } else {
        return V;
    }
    if foldAndOrOfICmpsWithConstEq(PredL, LHS0, LHS1, LHS, PredR, RHS0, RHS1, RHSOneUse, IsAnd, IsLogical, Q, I) {
        V;
    } else {
        return V;
    }
    if isa(RHS) {
        if foldAndOrOfICmpsWithConstEq(PredR, RHS0, RHS1, RHS, PredL, LHS0, LHS1, LHSOneUse, IsAnd, false, Q, I) {
            V;
        } else {
            if IsLogical && PredR.hasSameSign() && !RHS.use_empty() {
                let mut CmpR: *mut auto = cast(RHS);
                CmpR()(false);
                self.addToWorklist();
            }
            return V;
        }
    }
    if foldIsPowerOf2OrZero(PredL, LHS0, LHS1, PredR, RHS0, RHS1, IsAnd, *self) {
        V;
    } else {
        return V;
    }
    if foldIsPowerOf2OrZero(PredR, RHS0, RHS1, PredL, LHS0, LHS1, IsAnd, *self) {
        V;
    } else {
        return V;
    }
    if !IsLogical {
        if self.simplifyRangeCheck(PredL, LHS0, LHS1, PredR, RHS0, RHS1, &mut I, !IsAnd) {
            V;
        } else {
            return V;
        }
        if self.simplifyRangeCheck(PredR, RHS0, RHS1, PredL, LHS0, LHS1, &mut I, !IsAnd) {
            V;
        } else {
            return V;
        }
    }
    if IsAnd && !IsLogical {
        if foldSignedTruncationCheck(PredL, LHS0, LHS1, PredR, RHS0, RHS1, I) {
            V;
        } else {
            return V;
        }
    }
    if foldIsPowerOf2(PredL, LHS0, LHS1, PredR, RHS0, RHS1, IsAnd, *self) {
        V;
    } else {
        return V;
    }
    if foldPowerOf2AndShiftedMask(LHS, RHS, IsAnd) {
        V;
    } else {
        return V;
    }
    if !IsLogical {
        if foldUnsignedUnderflowCheck(PredL, LHS0, LHS1, LHSOneUse, PredR, RHS0, RHS1, RHSOneUse, IsAnd, Q) {
            X;
        } else {
            return X;
        }
        if foldUnsignedUnderflowCheck(PredR, RHS0, RHS1, RHSOneUse, PredL, LHS0, LHS1, LHSOneUse, IsAnd, Q) {
            X;
        } else {
            return X;
        }
    }
    if PredL == (if IsAnd { ICMP_EQ } else { ICMP_NE }) && PredL.dropSameSign() == PredR.dropSameSign() && match(LHS1) && match(RHS1) && LHS0.getType() == RHS0.getType() && (!IsLogical || isGuaranteedNotToBePoison(RHS0, null, null, null, 0)) {
        let mut NewOr: *mut Value = null;
    }
    if PredL == (if IsAnd { ICMP_EQ } else { ICMP_NE }) && PredL.dropSameSign() == PredR.dropSameSign() && match(LHS1) && match(RHS1) && LHS0.getType() == RHS0.getType() && (!IsLogical || isGuaranteedNotToBePoison(RHS0, null, null, null, 0)) {
        let mut NewAnd: *mut Value = null;
    }
    if !IsLogical {
        if foldAndOrOfICmpsWithPow2AndWithZero(PredL, LHS0, LHS1, LHSOneUse, PredR, RHS0, RHS1, RHSOneUse, IsAnd, Q) {
            V;
        } else {
            return V;
        }
    }
    if !LHSC || !RHSC {
        return null;
    }
    if PredL == (if IsAnd { ICMP_EQ } else { ICMP_NE }) && PredL.dropSameSign() == PredR.dropSameSign() && LHSOneUse && RHSOneUse {
        let mut V: *mut Value = null;
        let mut AndC: *APInt = null;
        let mut SmallC: *APInt = null;
        let mut BigC: *APInt = null;
        if match(RHS0, m_Trunc(m_Value(V))) && match(LHS0, m_And(m_Specific(V))) {
            SmallC = RHSC;
            BigC = LHSC;
        } else if match(LHS0, m_Trunc(m_Value(V))) && match(RHS0, m_And(m_Specific(V))) {
            SmallC = LHSC;
            BigC = RHSC;
        }
        if SmallC && BigC {
            let mut BigBitSize: u32 = BigC.getBitWidth();
            let mut SmallBitSize: u32 = SmallC.getBitWidth();
            let mut Low: APInt = getLowBitsSet(BigBitSize, SmallBitSize);
            if (Low & *AndC).isZero() && (Low & *BigC).isZero() {
                let mut NewAnd: *mut Value = null;
                let mut N: APInt = SmallC.zext(BigBitSize) | *BigC;
                let mut NewVal: *mut Value = get(NewAnd.getType(), N);
            }
        }
    }
    let mut TrueIfSignedL: bool = false;
    let mut TrueIfSignedR: bool = false;
    if isSignBitCheck(PredL.operator llvm::CmpInst::Predicate(), *LHSC, TrueIfSignedL) && isSignBitCheck(PredR.operator llvm::CmpInst::Predicate(), *RHSC, TrueIfSignedR) && (RHS.hasOneUse() || LHS.hasOneUse()) {
        let mut X: *mut Value = null;
        let mut Y: *mut Value = null;
        if IsAnd {
            if (TrueIfSignedL && !TrueIfSignedR && match(LHS0, m_Or(m_Value(X), m_Value(Y))) && match(RHS0, m_c_And(m_Specific(X), m_Specific(Y)))) || (!TrueIfSignedL && TrueIfSignedR && match(LHS0, m_And(m_Value(X), m_Value(Y))) && match(RHS0, m_c_Or(m_Specific(X), m_Specific(Y)))) {
                let mut NewXor: *mut Value = null;
            }
        } else {
            if (TrueIfSignedL && !TrueIfSignedR && match(LHS0, m_And(m_Value(X), m_Value(Y))) && match(RHS0, m_c_Or(m_Specific(X), m_Specific(Y)))) || (!TrueIfSignedL && TrueIfSignedR && match(LHS0, m_Or(m_Value(X), m_Value(Y))) && match(RHS0, m_c_And(m_Specific(X), m_Specific(Y)))) {
                let mut NewXor: *mut Value = null;
            }
        }
    }
    let mut X: *mut Value = null;
    let mut MaskC: *APInt = null;
    return self.foldAndOrOfICmpsUsingRanges(PredL, LHS0, LHS1, LHSOneUse, PredR, RHS0, RHS1, RHSOneUse, IsAnd);
}

fn InstCombinerImpl::foldBooleanAndOr(self, LHS: *mut Value, RHS: *mut Value, I: *mut Instruction, IsAnd: bool, IsLogical: bool) -> *mut Value {
    if !LHS.getType().isIntOrIntVectorTy(1) {
        return null;
    }
    if foldLogOpOfMaskedICmps(LHS, RHS, IsAnd, IsLogical) {
        V;
    } else {
        return V;
    }
    if self.foldAndOrOfICmps(LHS, RHS, I, IsAnd, IsLogical) {
        Res;
    } else {
        return Res;
    }
    if  {
        if  {
            if self.foldLogicOfFCmps(IsAnd, IsLogical) {
                Res;
            } else {
                return Res;
            }
        }
    }
    if self.foldEqOfParts(LHS, RHS, IsAnd) {
        Res;
    } else {
        return Res;
    }
    return null;
}

fn foldOrOfInversions(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Value {
    assert!(I.getOpcode() == Or, "Simplification only supports or at the moment.");
    let mut Cmp1: *mut Value = null;
    let mut Cmp2: *mut Value = null;
    let mut Cmp3: *mut Value = null;
    let mut Cmp4: *mut Value = null;
    if operator!(match(I.getOperand(0), m_And(m_Value(Cmp1), m_Value(Cmp2)))) || operator!(match(I.getOperand(1), m_And(m_Value(Cmp3), m_Value(Cmp4)))) {
        return null;
    }
    if isKnownInversion(Cmp1, Cmp3) && isKnownInversion(Cmp2, Cmp4) {
        return Builder()(Cmp1, Cmp4);
    }
    if isKnownInversion(Cmp1, Cmp4) && isKnownInversion(Cmp2, Cmp3) {
        return Builder()(Cmp1, Cmp3);
