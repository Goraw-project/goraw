static mut ProfcheckDisableMetadataFixes: opt<bool> = zeroed();

fn getNewICmpValue(Code: u32, Sign: bool, LHS: *mut Value, RHS: *mut Value, Builder: *mut BuilderTy) -> *mut Value {
    let mut NewPred: Predicate = zeroed();
    if getPredForICmpCode(Code, Sign, LHS.getType(), NewPred) {
        TorF;
    } else {
        return TorF;
    }
    return Builder.CreateICmp(NewPred, LHS, RHS, "");
}

fn getFCmpValue(Code: u32, LHS: *mut Value, RHS: *mut Value, Builder: *mut BuilderTy, FMF: FMFSource) -> *mut Value {
    let mut NewPred: Predicate = zeroed();
    if getPredForFCmpCode(Code, LHS.getType(), NewPred) {
        TorF;
    } else {
        return TorF;
    }
    return Builder.CreateFCmpFMF(NewPred, LHS, RHS, FMF, "", null);
}

fn InstCombinerImpl::insertRangeTest(self, V: *mut Value, Lo: *APInt, Hi: *APInt, isSigned: bool, Inside: bool) -> *mut Value {
    assert!((if isSigned { Lo.slt(Hi) } else { Lo.ult(Hi) }), "Lo is not < Hi in range emission code!");
    let mut Ty: *mut Type = V.getType();
    let mut Pred: Predicate = if Inside { ICMP_ULT } else { ICMP_UGE };
    if if isSigned { Lo.isMinSignedValue() } else { Lo.isMinValue() } {
        Pred = if isSigned { getSignedPredicate(Pred) } else { Pred };
        return self.Builder.CreateICmp(Pred, V, get(Ty, Hi), "");
    }
    let mut VMinusLo: *mut Value = self.Builder.CreateSub(V, get(Ty, Lo), V.getName() + ".off", false, false);
    let mut HiMinusLo: *mut Constant = get(Ty, Hi - Lo);
    return self.Builder.CreateICmp(Pred, VMinusLo, HiMinusLo, "");
}

enum MaskedICmpType {
    AMask_AllOnes = 0,
    AMask_NotAllOnes = 1,
    BMask_AllOnes = 2,
    BMask_NotAllOnes = 3,
    Mask_AllZeros = 4,
    Mask_NotAllZeros = 5,
    AMask_Mixed = 6,
    AMask_NotMixed = 7,
    BMask_Mixed = 8,
    BMask_NotMixed = 9,
}

fn getMaskedICmpType(A: *mut Value, B: *mut Value, C: *mut Value, Pred: Predicate) -> u32 {
    let mut ConstA: *APInt = null;
    let mut ConstB: *APInt = null;
    let mut ConstC: *APInt = null;
    match(A, m_APInt(ConstA));
    match(B, m_APInt(ConstB));
    match(C, m_APInt(ConstC));
    let mut IsEq: bool = (Pred == ICMP_EQ);
    let mut IsAPow2: bool = ConstA && ConstA.isPowerOf2();
    let mut IsBPow2: bool = ConstB && ConstB.isPowerOf2();
    let mut MaskVal: u32 = 0;
    if ConstC && ConstC.isZero() {
        MaskVal |= (if IsEq { (Mask_AllZeros | AMask_Mixed | BMask_Mixed) } else { (Mask_NotAllZeros | AMask_NotMixed | BMask_NotMixed) });
        if IsAPow2 {
            MaskVal |= (if IsEq { (AMask_NotAllOnes | AMask_NotMixed) } else { (AMask_AllOnes | AMask_Mixed) });
        }
        if IsBPow2 {
            MaskVal |= (if IsEq { (BMask_NotAllOnes | BMask_NotMixed) } else { (BMask_AllOnes | BMask_Mixed) });
        }
        return MaskVal;
    }
    if A == C {
        MaskVal |= (if IsEq { (AMask_AllOnes | AMask_Mixed) } else { (AMask_NotAllOnes | AMask_NotMixed) });
        if IsAPow2 {
            MaskVal |= (if IsEq { (Mask_NotAllZeros | AMask_NotMixed) } else { (Mask_AllZeros | AMask_Mixed) });
        }
    } else if ConstA && ConstC && ConstC.isSubsetOf(*ConstA) {
        MaskVal |= (if IsEq { AMask_Mixed } else { AMask_NotMixed });
    }
    if B == C {
        MaskVal |= (if IsEq { (BMask_AllOnes | BMask_Mixed) } else { (BMask_NotAllOnes | BMask_NotMixed) });
        if IsBPow2 {
            MaskVal |= (if IsEq { (Mask_NotAllZeros | BMask_NotMixed) } else { (Mask_AllZeros | BMask_Mixed) });
        }
    } else if ConstB && ConstC && ConstC.isSubsetOf(*ConstB) {
        MaskVal |= (if IsEq { BMask_Mixed } else { BMask_NotMixed });
    }
    return MaskVal;
}

fn conjugateICmpMask(Mask: u32) -> u32 {
    let mut NewMask: u32 = 0;
    NewMask = (Mask & (AMask_AllOnes | BMask_AllOnes | Mask_AllZeros | AMask_Mixed | BMask_Mixed)) << 1;
    NewMask |= (Mask & (AMask_NotAllOnes | BMask_NotAllOnes | Mask_NotAllZeros | AMask_NotMixed | BMask_NotMixed)) >> 1;
    return NewMask;
}

fn decomposeBitTest(Cond: *mut Value, Pred: *mut Predicate, X: *mut *mut Value, Y: *mut *mut Value, Z: *mut *mut Value) -> bool {
    let mut Res: optional<DecomposedBitTest> = decomposeBitTest(Cond, true, true, true);
    if !Res {
        return false;
    }
    Pred = operator(Res).Pred;
    X = operator(Res).X;
    Y = get(X.getType(), operator(Res).Mask);
    Z = get(X.getType(), operator(Res).C);
    return true;
}

fn getMaskedTypeForICmpPair(A: *mut *mut Value, B: *mut *mut Value, C: *mut *mut Value, D: *mut *mut Value, E: *mut *mut Value, LHS: *mut Value, RHS: *mut Value, PredL: *mut Predicate, PredR: *mut Predicate) -> pair<unsigned int, unsigned int>> {
    let mut L1: *mut Value = null;
    let mut L11: *mut Value = null;
    let mut L12: *mut Value = null;
    let mut L2: *mut Value = null;
    let mut L21: *mut Value = null;
    let mut L22: *mut Value = null;
    if decomposeBitTest(LHS, PredL, L11, L12, L2) {
        L21 = L22 = L1 = null;
    } else {
        let mut LHSCMP: *mut ICmpInst = dyn_cast(LHS);
        if !LHSCMP {
            return nullopt;
        }
        if !LHSCMP.getOperand(0).getType().isIntOrIntVectorTy() {
            return nullopt;
        }
        PredL = LHSCMP.getPredicate();
        L1 = LHSCMP.getOperand(0);
        L2 = LHSCMP.getOperand(1);
        if !match(L1, m_And(m_Value(L11), m_Value(L12))) {
            L11 = L1;
            L12 = getAllOnesValue(L1.getType());
        }
        if !match(L2, m_And(m_Value(L21), m_Value(L22))) {
            L21 = L2;
            L22 = getAllOnesValue(L2.getType());
        }
    }
    if !isEquality(PredL) {
        return nullopt;
    }
    let mut R11: *mut Value = null;
    let mut R12: *mut Value = null;
    let mut R2: *mut Value = null;
    if decomposeBitTest(RHS, PredR, R11, R12, R2) {
        if R11 == L11 || R11 == L12 || R11 == L21 || R11 == L22 {
            A = R11;
            D = R12;
        } else if R12 == L11 || R12 == L12 || R12 == L21 || R12 == L22 {
            A = R12;
            D = R11;
        } else {
            return nullopt;
        }
        E = R2;
    } else {
        let mut RHSCMP: *mut ICmpInst = dyn_cast(RHS);
        if !RHSCMP {
            return nullopt;
        }
        if !RHSCMP.getOperand(0).getType().isIntOrIntVectorTy() {
            return nullopt;
        }
        PredR = RHSCMP.getPredicate();
        let mut R1: *mut Value = RHSCMP.getOperand(0);
        R2 = RHSCMP.getOperand(1);
        let mut Ok: bool = false;
        if !match(R1, m_And(m_Value(R11), m_Value(R12))) {
            R11 = R1;
            R12 = getAllOnesValue(R1.getType());
        }
        if R11 == L11 || R11 == L12 || R11 == L21 || R11 == L22 {
            A = R11;
            D = R12;
            E = R2;
            Ok = true;
        } else if R12 == L11 || R12 == L12 || R12 == L21 || R12 == L22 {
            A = R12;
            D = R11;
            E = R2;
            Ok = true;
        }
        if Ok && match(A, m_AllOnes()) {
            Ok = false;
        }
        if !Ok {
            if !match(R2, m_And(m_Value(R11), m_Value(R12))) {
                R11 = R2;
                R12 = getAllOnesValue(R2.getType());
            }
            if R11 == L11 || R11 == L12 || R11 == L21 || R11 == L22 {
                A = R11;
                D = R12;
                E = R1;
            } else if R12 == L11 || R12 == L12 || R12 == L21 || R12 == L22 {
                A = R12;
                D = R11;
                E = R1;
            } else {
                return nullopt;
            }
        }
    }
    if !isEquality(PredR) {
        return nullopt;
    }
    if L11 == A {
        B = L12;
        C = L2;
    } else if L12 == A {
        B = L11;
        C = L2;
    } else if L21 == A {
        B = L22;
        C = L1;
    } else if L22 == A {
        B = L21;
        C = L1;
    }
    let mut LeftType: u32 = getMaskedICmpType(A, B, C, PredL);
    let mut RightType: u32 = getMaskedICmpType(A, D, E, PredR);
    return make_pair(LeftType, RightType);
}

fn foldLogOpOfMaskedICmps_NotAllZeros_BMask_Mixed(LHS: *mut Value, RHS: *mut Value, IsAnd: bool, A: *mut Value, B: *mut Value, D: *mut Value, E: *mut Value, PredL: Predicate, PredR: Predicate, Builder: *mut BuilderTy) -> *mut Value {
    let mut BCst: *APInt = null;
    let mut DCst: *APInt = null;
    let mut OrigECst: *APInt = null;
    if !match(B, m_APInt(BCst)) || !match(D, m_APInt(DCst)) || !match(E, m_APInt(OrigECst)) {
        return null;
    }
    let mut NewCC: Predicate = if IsAnd { ICMP_EQ } else { ICMP_NE };
    let mut ECst: APInt = *OrigECst;
    if PredR != NewCC {
        operator(ECst, *DCst);
    }
    if *BCst == 0 || *DCst == 0 {
        return null;
    }
    if !BCst.intersects(*DCst) {
        let mut Src: *mut Value = null;
        if *DCst == ECst && match(A, m_ElementWiseBitCast(m_Value(Src))) && !Builder.GetInsertBlock().getParent().hasFnAttribute(StrictFP) {
            let mut Ty: *mut Type = Src.getType().getScalarType();
            if !Ty.isIEEELikeFPTy() {
                return null;
            }
            let mut ExpBits: APInt = getInf(Ty.getFltSemantics(), false).bitcastToAPInt();
            if ECst != ExpBits {
                return null;
            }
            let mut FractionBits: APInt = operator(ExpBits);
            FractionBits.clearSignBit();
            if *BCst != FractionBits {
                return null;
            }
            return Builder.CreateFCmp(if IsAnd { FCMP_UNO } else { FCMP_ORD }, Src, getZero(Src.getType(), false), "", null);
        }
        return null;
    }
    if (((*BCst & *DCst) & ECst) == 0) && (*BCst & (*BCst ^ *DCst)).isPowerOf2() {
        let mut BorD: APInt = *BCst | *DCst;
        let mut BandBxorDorE: APInt = (*BCst & (*BCst ^ *DCst)) | ECst;
        let mut NewMask: *mut Value = get(A.getType(), BorD);
        let mut NewMaskedValue: *mut Value = get(A.getType(), BandBxorDorE);
        let mut NewAnd: *mut Value = Builder.CreateAnd(A, NewMask, "");
        return Builder.CreateICmp(NewCC, NewAnd, NewMaskedValue, "");
    }
    let mut IsSubSetOrEqual: Closure_1 = Closure_1 {};
    let mut IsSuperSetOrEqual: Closure_2 = Closure_2 {};
    if !IsSubSetOrEqual.call(BCst, DCst) && !IsSuperSetOrEqual.call(BCst, DCst) {
        return null;
    }
    if ECst.isZero() {
        if IsSubSetOrEqual.call(BCst, DCst) {
            return get(LHS.getType(), !IsAnd, false, false);
        }
        return null;
    }
    if IsSuperSetOrEqual.call(BCst, DCst) {
        if dyn_cast(RHS) {
            ICmp;
        } else {
            ICmp.setSameSign(false);
        }
        return RHS;
    }
    assert!(IsSubSetOrEqual.call(BCst, DCst), "Precondition due to above code");
    if (*BCst & ECst) != 0 {
        if dyn_cast(RHS) {
            ICmp;
        } else {
            ICmp.setSameSign(false);
        }
        return RHS;
    }
    return get(LHS.getType(), !IsAnd, false, false);
}

fn foldLogOpOfMaskedICmpsAsymmetric(LHS: *mut Value, RHS: *mut Value, IsAnd: bool, A: *mut Value, B: *mut Value, C: *mut Value, D: *mut Value, E: *mut Value, PredL: Predicate, PredR: Predicate, LHSMask: u32, RHSMask: u32, Builder: *mut BuilderTy) -> *mut Value {
    assert!(isEquality(PredL) && isEquality(PredR), "Expected equality predicates for masked type of icmps.");
    if !IsAnd {
        LHSMask = conjugateICmpMask(LHSMask);
        RHSMask = conjugateICmpMask(RHSMask);
    }
    if (LHSMask & Mask_NotAllZeros) && (RHSMask & BMask_Mixed) {
        if foldLogOpOfMaskedICmps_NotAllZeros_BMask_Mixed(LHS, RHS, IsAnd, A, B, D, E, PredL, PredR, Builder) {
            V;
        } else {
            return V;
        }
    } else if (LHSMask & BMask_Mixed) && (RHSMask & Mask_NotAllZeros) {
        if foldLogOpOfMaskedICmps_NotAllZeros_BMask_Mixed(RHS, LHS, IsAnd, A, D, B, C, PredR, PredL, Builder) {
            V;
        } else {
            return V;
        }
    }
    return null;
}

fn foldLogOpOfMaskedICmps(LHS: *mut Value, RHS: *mut Value, IsAnd: bool, IsLogical: bool, Builder: *mut BuilderTy, Q: *SimplifyQuery) -> *mut Value {
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut C: *mut Value = null;
    let mut D: *mut Value = null;
    let mut E: *mut Value = null;
    let mut PredL: Predicate = zeroed();
    let mut PredR: Predicate = zeroed();
    let mut MaskPair: pair<unsigned int, unsigned int>> = getMaskedTypeForICmpPair(A, B, C, D, E, LHS, RHS, PredL, PredR);
    if !MaskPair {
        return null;
    }
    assert!(isEquality(PredL) && isEquality(PredR), "Expected equality predicates for masked type of icmps.");
    let mut LHSMask: u32 = operator(MaskPair).first;
    let mut RHSMask: u32 = operator(MaskPair).second;
    let mut Mask: u32 = LHSMask & RHSMask;
    if Mask == 0 {
        if foldLogOpOfMaskedICmpsAsymmetric(LHS, RHS, IsAnd, A, B, C, D, E, PredL, PredR, LHSMask, RHSMask, Builder) {
            V;
        } else {
            return V;
        }
        return null;
    }
    let mut NewCC: Predicate = if IsAnd { ICMP_EQ } else { ICMP_NE };
    if !IsAnd {
        Mask = conjugateICmpMask(Mask);
    }
    if Mask & Mask_AllZeros {
        if IsLogical && !isGuaranteedNotToBeUndefOrPoison(D, null, null, null, 0) {
            return null;
        }
        let mut NewOr: *mut Value = Builder.CreateOr(B, D, "", false);
        let mut NewAnd: *mut Value = Builder.CreateAnd(A, NewOr, "");
        let mut Zero: *mut Value = getNullValue(A.getType());
        return Builder.CreateICmp(NewCC, NewAnd, Zero, "");
    }
    if Mask & BMask_AllOnes {
        if IsLogical && !isGuaranteedNotToBeUndefOrPoison(D, null, null, null, 0) {
            return null;
        }
        let mut NewOr: *mut Value = Builder.CreateOr(B, D, "", false);
        let mut NewAnd: *mut Value = Builder.CreateAnd(A, NewOr, "");
        return Builder.CreateICmp(NewCC, NewAnd, NewOr, "");
    }
    if Mask & AMask_AllOnes {
        if IsLogical && !isGuaranteedNotToBeUndefOrPoison(D, null, null, null, 0) {
            return null;
        }
        let mut NewAnd1: *mut Value = Builder.CreateAnd(B, D, "");
        let mut NewAnd2: *mut Value = Builder.CreateAnd(A, NewAnd1, "");
        return Builder.CreateICmp(NewCC, NewAnd2, A, "");
    }
    let mut ConstB: *APInt = null;
    let mut ConstD: *APInt = null;
    if match(B, m_APInt(ConstB)) && match(D, m_APInt(ConstD)) {
        if Mask & (Mask_NotAllZeros | BMask_NotAllOnes) {
            let mut NewMask: APInt = *ConstB & *ConstD;
            if NewMask == *ConstB {
                return LHS;
            }
            if NewMask == *ConstD {
                if IsLogical {
                    if dyn_cast(RHS) {
                        RHSI;
                    } else {
                        RHSI.dropPoisonGeneratingFlags();
                    }
                }
                return RHS;
            }
        }
        if Mask & AMask_NotAllOnes {
            let mut NewMask: APInt = *ConstB | *ConstD;
            if NewMask == *ConstB {
                return LHS;
            }
            if NewMask == *ConstD {
                return RHS;
            }
        }
        if Mask & (BMask_Mixed | BMask_NotMixed) {
            let mut OldConstC: *APInt = null;
            let mut OldConstE: *APInt = null;
            if !match(C, m_APInt(OldConstC)) || !match(E, m_APInt(OldConstE)) {
                return null;
            }
            let mut FoldBMixed: Closure_3 = Closure_3 { PredL: &mut PredL, ConstB: &mut ConstB, OldConstC: &mut OldConstC, PredR: &mut PredR, ConstD: &mut ConstD, OldConstE: &mut OldConstE, LHS: &mut LHS, IsAnd: &mut IsAnd, Builder: &mut Builder, A: &mut A };
            if Mask & BMask_Mixed {
                return FoldBMixed.call(NewCC, false);
            }
            if Mask & BMask_NotMixed {
                return FoldBMixed.call(NewCC, true);
            }
        }
    }
    if Mask & Mask_NotAllZeros && isKnownToBeAPowerOfTwo(B, false, Q, 0) && isKnownToBeAPowerOfTwo(D, false, Q, 0) {
        if IsLogical {
            D = Builder.CreateFreeze(D, "");
        }
        let mut Mask: *mut Value = Builder.CreateOr(B, D, "", false);
        let mut Masked: *mut Value = Builder.CreateAnd(A, Mask, "");
        return Builder.CreateICmp(NewCC, Masked, Mask, "");
    }
    return null;
}

fn InstCombinerImpl::simplifyRangeCheck(self, PredL: CmpPredicate, LHS0: *mut Value, LHS1: *mut Value, PredR: CmpPredicate, RHS0: *mut Value, RHS1: *mut Value, CtxI: *mut Instruction, Inverted: bool) -> *mut Value {
    let mut RangeStart: *mut ConstantInt = dyn_cast(LHS1);
    if !RangeStart {
        return null;
    }
    if Inverted {
        PredL = getInverse(PredL);
        PredR = getInverse(PredR);
    }
    if !((PredL == ICMP_SGT && RangeStart.isMinusOne()) || (PredL == ICMP_SGE && RangeStart.isZero())) {
        return null;
    }
    let mut Input: *mut Value = LHS0;
    let mut RangeEnd: *mut Value = null;
    if match(RHS0, m_SExtOrSelf(m_Specific(Input))) {
        Input = RHS0;
        RangeEnd = RHS1;
    } else if match(RHS1, m_SExtOrSelf(m_Specific(Input))) {
        Input = RHS1;
        RangeEnd = RHS0;
        PredR = getSwapped(PredR);
    } else {
        return null;
    }
    let mut NewPred: Predicate = zeroed();
    match PredR.operator llvm::CmpInst::Predicate() {
        ICMP_SLT => {
            NewPred = ICMP_ULT;
        },
        ICMP_SLE => {
            NewPred = ICMP_ULE;
        },
        _ => {
            return null;
        },
    }
    let mut Known: KnownBits = self.computeKnownBits(RangeEnd, CtxI, 0);
    if !Known.isNonNegative() {
        return null;
    }
    if Inverted {
        NewPred = getInversePredicate(NewPred);
    }
    return self.Builder.CreateICmp(NewPred, Input, RangeEnd, "");
}

fn foldAndOrOfICmpsWithPow2AndWithZero(Builder: *mut BuilderTy, PredL: CmpPredicate, LHS0: *mut Value, LHS1: *mut Value, LHSOneUse: bool, PredR: CmpPredicate, RHS0: *mut Value, RHS1: *mut Value, RHSOneUse: bool, IsAnd: bool, Q: *SimplifyQuery) -> *mut Value {
    let mut Pred: Predicate = if IsAnd { ICMP_NE } else { ICMP_EQ };
    if PredL != Pred || PredR != Pred {
        return null;
    }
    if match(RHS1, m_Zero()) {
        swap(PredL, PredR);
        swap(LHS0, RHS0);
        swap(LHS1, RHS1);
    }
    if RHS1 == LHS0 {
        swap(RHS0, RHS1);
    }
    if !LHSOneUse || !RHSOneUse || !match(LHS1, m_Zero()) || RHS0 != LHS0 || match(RHS1, m_One()) || !isKnownToBeAPowerOfTwo(RHS1, true, Q, 0) {
        return null;
    }
    let mut And: *mut Value = Builder.CreateAnd(LHS0, RHS1, "");
    return Builder.CreateICmp(Pred, And, LHS0, "");
}

fn foldSignedTruncationCheck(PredL: CmpPredicate, LHS0: *mut Value, LHS1: *mut Value, PredR: CmpPredicate, RHS0: *mut Value, RHS1: *mut Value, CtxI: *mut Instruction, Builder: *mut BuilderTy) -> *mut Value {
    assert!(CtxI.getOpcode() == And);
    let mut tryToMatchSignedTruncationCheck: Closure_4 = Closure_4 {};
    let mut X1: *mut Value = null;
    let mut HighestBit: APInt = APInt {};
    if tryToMatchSignedTruncationCheck.call(PredR, RHS0, RHS1, X1, HighestBit) {
        swap(PredL, PredR);
        swap(LHS0, RHS0);
        swap(LHS1, RHS1);
    } else if !tryToMatchSignedTruncationCheck.call(PredL, LHS0, LHS1, X1, HighestBit) {
        return null;
    }
    assert!(HighestBit.isPowerOf2(), "expected to be power of two (non-zero)");
    let mut tryToDecompose: Closure_5 = Closure_5 {};
    let mut X0: *mut Value = null;
    let mut UnsetBitsMask: APInt = APInt {};
    if !tryToDecompose.call(PredR, RHS0, RHS1, X0, UnsetBitsMask) {
        return null;
    }
    assert!(!UnsetBitsMask.isZero(), "empty mask makes no sense.");
    let mut X: *mut Value = null;
    if X1 == X0 {
        X = X1;
    } else if match(X0, m_Trunc(m_Specific(X1))) {
        UnsetBitsMask = UnsetBitsMask.zext(X1.getType().getScalarSizeInBits());
        X = X1;
    } else {
        return null;
    }
    let mut SignBitsMask: APInt = operator((HighestBit - 1));
    if !UnsetBitsMask.intersects(SignBitsMask) {
        return null;
    }
    if !UnsetBitsMask.isSubsetOf(SignBitsMask) {
        let mut OtherHighestBit: APInt = (operator(UnsetBitsMask)) + 1;
        if !OtherHighestBit.isPowerOf2() {
            return null;
        }
        HighestBit = umin(HighestBit, OtherHighestBit);
    }
    return Builder.CreateICmpULT(X, get(X.getType(), HighestBit), CtxI.getName() + ".simplified");
}

fn foldIsPowerOf2OrZero(PredL: CmpPredicate, LHS0: *mut Value, LHS1: *mut Value, PredR: CmpPredicate, RHS0: *mut Value, RHS1: *mut Value, IsAnd: bool, Builder: *mut BuilderTy, IC: *mut InstCombinerImpl) -> *mut Value {
    let mut X: *mut Value = null;
    if !match(LHS0, m_Ctpop(m_Value(X))) || !match(LHS1, m_SpecificInt(1)) || RHS0 != X || !match(RHS1, m_ZeroInt()) {
        return null;
    }
    let mut CtPop: *mut Instruction = cast(LHS0);
    if IsAnd && PredL == ICMP_NE && PredR == ICMP_NE {
        CtPop.dropPoisonGeneratingAnnotations();
        IC.addToWorklist(CtPop);
        return Builder.CreateICmpUGT(CtPop, get(CtPop.getType(), 1, false, false), "");
    }
    if !IsAnd && PredL == ICMP_EQ && PredR == ICMP_EQ {
        CtPop.dropPoisonGeneratingAnnotations();
        IC.addToWorklist(CtPop);
        return Builder.CreateICmpULT(CtPop, get(CtPop.getType(), 2, false, false), "");
    }
    return null;
}

fn foldIsPowerOf2(PredL: CmpPredicate, LHS0: *mut Value, LHS1: *mut Value, PredR: CmpPredicate, RHS0: *mut Value, RHS1: *mut Value, JoinedByAnd: bool, Builder: *mut BuilderTy, IC: *mut InstCombinerImpl) -> *mut Value {
    if PredR == (if JoinedByAnd { ICMP_NE } else { ICMP_EQ }) {
        swap(PredL, PredR);
        swap(LHS0, RHS0);
        swap(LHS1, RHS1);
    }
    if JoinedByAnd && PredL == ICMP_NE && match(LHS1, m_ZeroInt()) && PredR == ICMP_ULT && match(RHS0, m_Ctpop(m_Specific(LHS0))) && match(RHS1, m_SpecificInt(2)) {
        let mut CtPop: *mut Instruction = cast(RHS0);
        CtPop.dropPoisonGeneratingAnnotations();
        IC.addToWorklist(CtPop);
        return Builder.CreateICmpEQ(CtPop, get(CtPop.getType(), 1, false, false), "");
    }
    if !JoinedByAnd && PredL == ICMP_EQ && match(LHS1, m_ZeroInt()) && PredR == ICMP_UGT && match(RHS0, m_Ctpop(m_Specific(LHS0))) && match(RHS1, m_SpecificInt(1)) {
        let mut CtPop: *mut Instruction = cast(RHS0);
        CtPop.dropPoisonGeneratingAnnotations();
        IC.addToWorklist(CtPop);
        return Builder.CreateICmpNE(CtPop, get(CtPop.getType(), 1, false, false), "");
    }
    return null;
}

fn foldNegativePower2AndShiftedMask(A: *mut Value, B: *mut Value, D: *mut Value, E: *mut Value, PredL: Predicate, PredR: Predicate, Builder: *mut BuilderTy) -> *mut Value {
    assert!(isEquality(PredL) && isEquality(PredR), "Expected equality predicates for masked type of icmps.");
    if PredL != ICMP_EQ || PredR != ICMP_NE {
        return null;
    }
    if !match(B, m_NegatedPower2()) || !match(D, m_ShiftedMask()) || !match(E, m_ShiftedMask()) {
        return null;
    }
    let mut isReducible: Closure_6 = Closure_6 {};
    if dyn_cast(B.getType()) {
        BVTy;
    } else {
        let mut BFVTy: *FixedVectorType const = dyn_cast(BVTy);
        let mut BConst: *Constant const = dyn_cast(B);
        let mut DConst: *Constant const = dyn_cast(D);
        let mut EConst: *Constant const = dyn_cast(E);
        if !BFVTy || !BConst || !DConst || !EConst {
            return null;
        }
        for let mut I: u32 = 0; I != BFVTy.getNumElements(); I += 1 {
            let mut BElt: *Constant = BConst.getAggregateElement(I);
            let mut DElt: *Constant = DConst.getAggregateElement(I);
            let mut EElt: *Constant = EConst.getAggregateElement(I);
            if !BElt || !DElt || !EElt {
                return null;
            }
            if !isReducible.call(BElt, DElt, EElt) {
                return null;
            }
        }
    }
    return Builder.CreateICmp(ICMP_ULT, A, D, "");
}

fn foldPowerOf2AndShiftedMask(Cmp0: *mut Value, Cmp1: *mut Value, JoinedByAnd: bool, Builder: *mut BuilderTy) -> *mut Value {
    if !JoinedByAnd {
        return null;
    }
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut C: *mut Value = null;
    let mut D: *mut Value = null;
    let mut E: *mut Value = null;
    let mut CmpPred0: Predicate = zeroed();
    let mut CmpPred1: Predicate = zeroed();
    let mut MaskPair: pair<unsigned int, unsigned int>> = getMaskedTypeForICmpPair(A, B, C, D, E, Cmp0, Cmp1, CmpPred0, CmpPred1);
    if !MaskPair {
        return null;
    }
    let mut compareBMask: i32 = BMask_NotMixed | BMask_NotAllOnes;
    let mut CmpMask0: u32 = operator(MaskPair).first;
    let mut CmpMask1: u32 = operator(MaskPair).second;
    if (CmpMask0 & Mask_AllZeros) && (CmpMask1 == compareBMask) {
        if foldNegativePower2AndShiftedMask(A, B, D, E, CmpPred0, CmpPred1, Builder) {
            V;
        } else {
            return V;
        }
    } else if (CmpMask0 == compareBMask) && (CmpMask1 & Mask_AllZeros) {
        if foldNegativePower2AndShiftedMask(A, D, B, C, CmpPred1, CmpPred0, Builder) {
            V;
        } else {
            return V;
        }
    }
    return null;
}

fn foldUnsignedUnderflowCheck(PredL: CmpPredicate, LHS0: *mut Value, LHS1: *mut Value, LHSOneUse: bool, PredR: CmpPredicate, RHS0: *mut Value, RHS1: *mut Value, RHSOneUse: bool, IsAnd: bool, Q: *SimplifyQuery, Builder: *mut BuilderTy) -> *mut Value {
    if !match(LHS1, m_Zero()) || !isEquality(PredL.operator llvm::CmpInst::Predicate()) {
        return null;
    }
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    if RHS0 == LHS0 {
        A = RHS1;
    } else if RHS1 == LHS0 {
        A = RHS0;
        PredR = getSwapped(PredR);
    } else {
        return null;
    }
    if !match(LHS0, m_c_Add(m_Specific(A), m_Value(B))) || !(LHSOneUse || RHSOneUse) {
        return null;
    }
    let mut GetKnownNonZeroAndOther: Closure_7 = Closure_7 { Q: &mut Q };
    if PredR == ICMP_ULT && PredL == ICMP_NE && IsAnd && GetKnownNonZeroAndOther.call(B, A) {
        return Builder.CreateICmpULT(Builder.CreateNeg(B, "", false), A, "");
    }
    if PredR == ICMP_UGE && PredL == ICMP_EQ && !IsAnd && GetKnownNonZeroAndOther.call(B, A) {
        return Builder.CreateICmpUGE(Builder.CreateNeg(B, "", false), A, "");
    }
    return null;
}

struct IntPart {
    From: *mut Value,
    StartBit: u32,
    NumBits: u32,
}

fn matchIntPart(V: *mut Value) -> optional<IntPart> {
    let mut X: *mut Value = null;
    if !match(V, m_OneUse(m_Trunc(m_Value(X)))) {
        return nullopt;
    }
    let mut NumOriginalBits: u32 = X.getType().getScalarSizeInBits();
    let mut NumExtractedBits: u32 = V.getType().getScalarSizeInBits();
    let mut Y: *mut Value = null;
    let mut Shift: *APInt = null;
    if match(X, m_OneUse(m_LShr(m_Value(Y), m_APInt(Shift)))) && Shift.ule(NumOriginalBits - NumExtractedBits) {
        return IntPart { From: Y, StartBit: Shift.getZExtValue() as u32, NumBits: NumExtractedBits };
    }
    return IntPart { From: X, StartBit: 0, NumBits: NumExtractedBits };
}

fn extractIntPart(P: *IntPart, Builder: *mut IRBuilderBase) -> *mut Value {
    let mut V: *mut Value = P.From;
    if P.StartBit {
        V = Builder.CreateLShr(V, P.StartBit, "", false);
    }
    let mut TruncTy: *mut Type = V.getType().getWithNewBitWidth(P.NumBits);
    if TruncTy != V.getType() {
        V = Builder.CreateTrunc(V, TruncTy, "", false, false);
    }
    return V;
}

fn InstCombinerImpl::foldEqOfParts(self, Cmp0: *mut Value, Cmp1: *mut Value, IsAnd: bool) -> *mut Value {
    if !Cmp0.hasOneUse() || !Cmp1.hasOneUse() {
        return null;
    }
    let mut Pred: Predicate = if IsAnd { ICMP_EQ } else { ICMP_NE };
    let mut GetMatchPart: Closure_8 = Closure_8 { Pred: &mut Pred };
    let mut L0: optional<IntPart> = GetMatchPart.call(Cmp0, 0);
    let mut R0: optional<IntPart> = GetMatchPart.call(Cmp0, 1);
    let mut L1: optional<IntPart> = GetMatchPart.call(Cmp1, 0);
    let mut R1: optional<IntPart> = GetMatchPart.call(Cmp1, 1);
    if !L0 || !R0 || !L1 || !R1 {
        return null;
    }
    if operator(L0).From != operator(L1).From || operator(R0).From != operator(R1).From {
        if operator(L0).From != operator(R1).From || operator(R0).From != operator(L1).From {
            return null;
        }
        swap(L1, R1);
    }
    if operator(L0).StartBit + operator(L0).NumBits != operator(L1).StartBit || operator(R0).StartBit + operator(R0).NumBits != operator(R1).StartBit {
        if operator(L1).StartBit + operator(L1).NumBits != operator(L0).StartBit || operator(R1).StartBit + operator(R1).NumBits != operator(R0).StartBit {
            return null;
        }
        swap(L0, L1);
        swap(R0, R1);
    }
    let mut L: IntPart = IntPart { From: operator(L0).From, StartBit: operator(L0).StartBit, NumBits: operator(L0).NumBits + operator(L1).NumBits };
    let mut R: IntPart = IntPart { From: operator(R0).From, StartBit: operator(R0).StartBit, NumBits: operator(R0).NumBits + operator(R1).NumBits };
    let mut LValue: *mut Value = extractIntPart(L, self.Builder);
    let mut RValue: *mut Value = extractIntPart(R, self.Builder);
    return self.Builder.CreateICmp(Pred, LValue, RValue, "");
}

fn foldAndOrOfICmpsWithConstEq(PredL: CmpPredicate, LHS0: *mut Value, LHS1: *mut Value, LHS: *mut Value, PredR: CmpPredicate, RHS0: *mut Value, RHS1: *mut Value, RHSOneUse: bool, IsAnd: bool, IsLogical: bool, Builder: *mut BuilderTy, Q: *SimplifyQuery, I: *mut Instruction) -> *mut Value {
    if !isa(LHS1) || !isGuaranteedNotToBeUndefOrPoison(LHS1, null, null, null, 0) || isa(LHS0) {
        return null;
    }
    if (IsAnd && PredL != ICMP_EQ) || (!IsAnd && PredL != ICMP_NE) {
        return null;
    }
    let mut Y: *mut Value = null;
    if LHS0 == RHS0 {
        Y = RHS1;
        PredR = getSwapped(PredR);
    } else if LHS0 == RHS1 {
        Y = RHS0;
    } else {
        return null;
    }
    let mut SubstituteCmp: *mut Value = simplifyICmpInst(PredR, Y, LHS1, Q);
    if !SubstituteCmp {
        if !RHSOneUse {
            return null;
        }
        SubstituteCmp = Builder.CreateICmp(PredR.operator llvm::CmpInst::Predicate(), Y, LHS1, "");
    }
    if IsLogical {
        let mut MDFrom: *mut Instruction = if isa(I) { &mut I } else { null };
        return if IsAnd { Builder.CreateLogicalAnd(LHS, SubstituteCmp, "", MDFrom) } else { Builder.CreateLogicalOr(LHS, SubstituteCmp, "", MDFrom) };
    }
    return Builder.CreateBinOp(if IsAnd { And } else { Or }, LHS, SubstituteCmp, "", null);
}

fn InstCombinerImpl::foldAndOrOfICmpsUsingRanges(self, PredL: CmpPredicate, LHS0: *mut Value, LHS1: *mut Value, LHSOneUse: bool, PredR: CmpPredicate, RHS0: *mut Value, RHS1: *mut Value, RHSOneUse: bool, IsAnd: bool) -> *mut Value {
    let mut MatchExactRangeCheck: Closure_9 = Closure_9 {};
    let mut RC1: pair<Value *, ConstantRange>> = MatchExactRangeCheck.call(PredL, LHS0, LHS1);
    if !RC1 {
        return null;
    }
    let mut RC2: pair<Value *, ConstantRange>> = MatchExactRangeCheck.call(PredR, RHS0, RHS1);
    if !RC2 {
        return null;
    }
    if V1 != V2 {
        return null;
    }
    if IsAnd {
        CR1 = CR1.inverse();
        CR2 = CR2.inverse();
    }
    let mut Ty: *mut Type = V1.getType();
    let mut NewV: *mut Value = V1;
    let mut CR: optional<ConstantRange> = CR1.exactUnionWith(CR2);
    if !CR {
        if !LHSOneUse || !RHSOneUse || CR1.isWrappedSet() || CR2.isWrappedSet() {
            return null;
        }
        let mut LowerDiff: APInt = CR1.getLower() ^ CR2.getLower();
        let mut UpperDiff: APInt = (CR1.getUpper() - 1) ^ (CR2.getUpper() - 1);
        let mut CR1Size: APInt = CR1.getUpper() - CR1.getLower();
        if !LowerDiff.isPowerOf2() || LowerDiff != UpperDiff || CR1Size != CR2.getUpper() - CR2.getLower() {
            return null;
        }
        CR = if CR1.getLower().ult(CR2.getLower()) { CR1 } else { CR2 };
        NewV = self.Builder.CreateAnd(NewV, get(Ty, operator(LowerDiff)), "");
    }
    if IsAnd {
        CR = operator(CR).inverse();
    }
    let mut NewPred: Predicate = zeroed();
    let mut NewC: APInt = APInt {};
    let mut Offset: APInt = APInt {};
    operator(CR).getEquivalentICmp(NewPred, NewC, Offset);
    if Offset != 0 {
        NewV = self.Builder.CreateAdd(NewV, get(Ty, Offset), "", false, false);
    }
    return self.Builder.CreateICmp(NewPred, NewV, get(Ty, NewC), "");
}

fn matchIsNotNaN(P: Predicate, LHS: *mut Value, RHS: *mut Value) -> bool {
    return P == FCMP_ORD && match(RHS, m_AnyZeroFP());
}

fn matchUnorderedInfCompare(P: Predicate, LHS: *mut Value, RHS: *mut Value) -> bool {
    return isUnordered(P) && match(RHS, m_Inf());
}

fn matchIsFiniteTest(Builder: *mut BuilderTy, LHS: *mut FCmpInst, RHS: *mut FCmpInst) -> *mut Value {
    let mut LHS0: *mut Value = LHS.getOperand(0);
    let mut LHS1: *mut Value = LHS.getOperand(1);
    let mut RHS0: *mut Value = RHS.getOperand(0);
    let mut RHS1: *mut Value = RHS.getOperand(1);
    let mut PredL: Predicate = LHS.getPredicate();
    let mut PredR: Predicate = RHS.getPredicate();
    if !matchIsNotNaN(PredL, LHS0, LHS1) || !matchUnorderedInfCompare(PredR, RHS0, RHS1) {
        return null;
    }
    return Builder.CreateFCmpFMF(getOrderedPredicate(PredR), RHS0, RHS1, intersect(LHS, RHS), "", null);
}

fn InstCombinerImpl::foldLogicOfFCmps(self, LHS: *mut FCmpInst, RHS: *mut FCmpInst, IsAnd: bool, IsLogicalSelect: bool) -> *mut Value {
    let mut LHS0: *mut Value = LHS.getOperand(0);
    let mut LHS1: *mut Value = LHS.getOperand(1);
    let mut RHS0: *mut Value = RHS.getOperand(0);
    let mut RHS1: *mut Value = RHS.getOperand(1);
    let mut PredL: Predicate = LHS.getPredicate();
    let mut PredR: Predicate = RHS.getPredicate();
    if LHS0 == RHS1 && RHS0 == LHS1 {
        PredR = getSwappedPredicate(PredR);
        swap(RHS0, RHS1);
    }
    if LHS0 == RHS0 && LHS1 == RHS1 {
        let mut FCmpCodeL: u32 = getFCmpCode(PredL);
        let mut FCmpCodeR: u32 = getFCmpCode(PredR);
        let mut NewPred: u32 = if IsAnd { FCmpCodeL & FCmpCodeR } else { FCmpCodeL | FCmpCodeR };
        return getFCmpValue(NewPred, LHS0, LHS1, self.Builder, intersect(LHS, RHS));
    }
    if (PredL == FCMP_ORD && PredR == FCMP_ORD && IsAnd) || (PredL == FCMP_UNO && PredR == FCMP_UNO && !IsAnd) {
        if LHS0.getType() != RHS0.getType() {
            return null;
        }
        if match(LHS1, m_PosZeroFP()) && match(RHS1, m_PosZeroFP()) {
            let mut Y: *mut Value = RHS0;
            let mut FMF: FastMathFlags = LHS.getFastMathFlags() & RHS.getFastMathFlags();
            if IsLogicalSelect {
                Y = self.Builder.CreateFreeze(Y, Y.getName() + ".fr");
                FMF.setNoNaNs(false);
                FMF.setNoInfs(false);
            }
            return self.Builder.CreateFCmpFMF(PredL, LHS0, Y, FMF, "", null);
        }
    }
    if !IsLogicalSelect && IsAnd && stripSignOnlyFPOps(LHS0) == stripSignOnlyFPOps(RHS0) {
        if matchIsFiniteTest(self.Builder, LHS, RHS) {
            Left;
        } else {
            return Left;
        }
        if matchIsFiniteTest(self.Builder, RHS, LHS) {
            Right;
        } else {
            return Right;
        }
    }
    if LHS.hasOneUse() && RHS.hasOneUse() {
        if ClassValRHS {
            if ClassValLHS == ClassValRHS {
                let mut CombinedMask: u32 = if IsAnd { (ClassMaskLHS & ClassMaskRHS) } else { (ClassMaskLHS | ClassMaskRHS) };
                return self.Builder.CreateIntrinsic(is_fpclass, [ClassValLHS.getType()], [ClassValLHS, self.Builder.getInt32(CombinedMask)], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_10 {}, null, null });
            }
        }
    }
    let mut LHSC: *APFloat = null;
    let mut RHSC: *APFloat = null;
    if LHS0 == RHS0 && LHS.hasOneUse() && RHS.hasOneUse() && getSwappedPredicate(PredL) == PredR && match(LHS1, m_APFloatAllowPoison(LHSC)) && match(RHS1, m_APFloatAllowPoison(RHSC)) && LHSC.bitwiseIsEqual(neg(*RHSC)) {
        let mut IsLessThanOrLessEqual: Closure_11 = Closure_11 {};
        if IsLessThanOrLessEqual.call(if IsAnd { PredR } else { PredL }) {
            swap(LHSC, RHSC);
            swap(PredL, PredR);
        }
        if IsLessThanOrLessEqual.call(if IsAnd { PredL } else { PredR }) {
            let mut NewFlag: FastMathFlags = LHS.getFastMathFlags();
            if !IsLogicalSelect {
                operator(NewFlag, RHS.getFastMathFlags());
            }
            let mut FAbs: *mut Value = self.Builder.CreateFAbs(LHS0, NewFlag, "");
            return self.Builder.CreateFCmpFMF(PredL, FAbs, get(LHS0.getType(), *LHSC), NewFlag, "", null);
        }
    }
    return null;
}

fn matchIsFPClassLikeFCmp(Op: *mut Value, ClassVal: *mut *mut Value, ClassMask: *mut u64) -> bool {
    let mut FCmp: *mut FCmpInst = dyn_cast(Op);
    if !FCmp || !FCmp.hasOneUse() {
        return false;
    }
    tie(ClassVal, ClassMask) = fcmpToClassTest(FCmp.getPredicate(), *FCmp.getParent().getParent(), FCmp.getOperand(0), FCmp.getOperand(1), true);
    return ClassVal != null;
}

fn InstCombinerImpl::foldLogicOfIsFPClass(self, BO: *mut BinaryOperator, Op0: *mut Value, Op1: *mut Value) -> *mut Instruction {
    let mut ClassVal0: *mut Value = null;
    let mut ClassVal1: *mut Value = null;
    let mut ClassMask0: u64 = 0;
    let mut ClassMask1: u64 = 0;
    let mut IsLHSClass: bool = match(Op0, m_OneUse(m_Intrinsic(m_Value(ClassVal0), m_ConstantInt(ClassMask0))));
    let mut IsRHSClass: bool = match(Op1, m_OneUse(m_Intrinsic(m_Value(ClassVal1), m_ConstantInt(ClassMask1))));
    if (((IsLHSClass || matchIsFPClassLikeFCmp(Op0, ClassVal0, ClassMask0)) && (IsRHSClass || matchIsFPClassLikeFCmp(Op1, ClassVal1, ClassMask1)))) && ClassVal0 == ClassVal1 {
        let mut NewClassMask: u32 = 0;
        match BO.getOpcode() {
            And => {
                NewClassMask = ClassMask0 & ClassMask1;
            },
            Or => {
                NewClassMask = ClassMask0 | ClassMask1;
            },
            Xor => {
                NewClassMask = ClassMask0 ^ ClassMask1;
            },
            _ => {
                llvm_unreachable_internal("not a binary logic operator", "P:/Goraw/llvm-project/llvm/lib/Transforms/InstCombine/InstCombineAndOrXor.cpp", 1636);
            },
        }
        if IsLHSClass {
            let mut II: *mut IntrinsicInst = cast(Op0);
            II.setArgOperand(1, get(II.getArgOperand(1).getType(), NewClassMask, false, false));
            return self.replaceInstUsesWith(BO, II);
        }
        if IsRHSClass {
            let mut II: *mut IntrinsicInst = cast(Op1);
            II.setArgOperand(1, get(II.getArgOperand(1).getType(), NewClassMask, false, false));
            return self.replaceInstUsesWith(BO, II);
        }
        let mut NewClass: *mut Value = self.Builder.CreateIntrinsic(is_fpclass, [ClassVal0.getType()], [ClassVal0, self.Builder.getInt32(NewClassMask)], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_12 {}, null, null });
        return self.replaceInstUsesWith(BO, NewClass);
    }
    return null;
}

fn InstCombinerImpl::canonicalizeConditionalNegationViaMathToSelect(self, I: *mut BinaryOperator) -> *mut Instruction {
    assert!(I.getOpcode() == Xor, "Only for xor!");
    let mut Cond: *mut Value = null;
    let mut X: *mut Value = null;
    if !match(&mut I, m_c_BinOp(m_OneUse(m_Value()), m_Value())) || !match(I.getOperand(1), m_SExt(m_Value(Cond))) || !Cond.getType().isIntOrIntVectorTy(1) || !match(I.getOperand(0), m_c_Add(m_SExt(m_Specific(Cond)), m_Value(X))) {
        return null;
    }
    return self.createSelectInstWithUnknownProfile(Cond, self.Builder.CreateNeg(X, X.getName() + ".neg", false), X, "", null);
}

fn reassociateFCmps(BO: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Opcode: BinaryOps = BO.getOpcode();
    assert!((Opcode == And || Opcode == Or), "Expecting and/or op for fcmp transform");
    let mut Op0: *mut Value = BO.getOperand(0);
    let mut Op1: *mut Value = BO.getOperand(1);
    let mut X: *mut Value = null;
    if match(Op1, m_FCmp(m_Value(), m_AnyZeroFP())) {
        swap(Op0, Op1);
    }
    let mut BO10: *mut Value = null;
    let mut BO11: *mut Value = null;
    let mut NanPred: Predicate = if Opcode == And { FCMP_ORD } else { FCMP_UNO };
    if !match(Op0, m_SpecificFCmp(CmpPredicate { Pred: NanPred, HasSameSign: false }, m_Value(X), m_AnyZeroFP())) || !match(Op1, m_BinOp(Opcode, m_Value(BO10), m_Value(BO11))) {
        return null;
    }
    let mut Y: *mut Value = null;
    if !match(BO10, m_SpecificFCmp(CmpPredicate { Pred: NanPred, HasSameSign: false }, m_Value(Y), m_AnyZeroFP())) || X.getType() != Y.getType() {
        swap(BO10, BO11);
    }
    if !match(BO10, m_SpecificFCmp(CmpPredicate { Pred: NanPred, HasSameSign: false }, m_Value(Y), m_AnyZeroFP())) || X.getType() != Y.getType() {
        return null;
    }
    let mut NewFCmp: *mut Value = Builder.CreateFCmpFMF(NanPred, X, Y, intersect(Op0, BO10), "", null);
    return Create(Opcode, NewFCmp, BO11, "", null);
}

fn matchDeMorgansLaws(I: *mut BinaryOperator, IC: *mut InstCombiner) -> *mut Instruction {
    let mut Opcode: BinaryOps = I.getOpcode();
    assert!((Opcode == And || Opcode == Or), "Trying to match De Morgan's Laws with something other than and/or");
    let mut FlippedOpcode: BinaryOps = if (Opcode == And) { Or } else { And };
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    if match(Op0, m_OneUse(m_Not(m_Value(A)))) && match(Op1, m_OneUse(m_Not(m_Value(B)))) && !IC.isFreeToInvert(A, A.hasOneUse()) && !IC.isFreeToInvert(B, B.hasOneUse()) {
        let mut AndOr: *mut Value = IC.Builder.CreateBinOp(FlippedOpcode, A, B, I.getName() + ".demorgan", null);
        return CreateNot(AndOr, "", null);
    }
    let mut C: *mut Value = null;
    if match(Op0, m_OneUse(m_c_BinOp(Opcode, m_Value(A), m_Not(m_Value(B))))) && match(Op1, m_Not(m_Value(C))) {
        let mut FlippedBO: *mut Value = IC.Builder.CreateBinOp(FlippedOpcode, B, C, "", null);
        return Create(Opcode, A, IC.Builder.CreateNot(FlippedBO, ""), "", null);
    }
    return null;
}

fn InstCombinerImpl::shouldOptimizeCast(self, CI: *mut CastInst) -> bool {
    let mut CastSrc: *mut Value = CI.getOperand(0);
    if CI.getSrcTy() == CI.getDestTy() || isa(CastSrc) {
        return false;
    }
    if dyn_cast(CastSrc) {
        PrecedingCI;
    } else if self.isEliminableCastPair(PrecedingCI, CI) {
        return false;
    }
    return true;
}

fn foldLogicCastConstant(Logic: *mut BinaryOperator, Cast: *mut CastInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut C: *mut Constant = dyn_cast(Logic.getOperand(1));
    if !C {
        return null;
    }
    let mut LogicOpc: BinaryOps = Logic.getOpcode();
    let mut DestTy: *mut Type = Logic.getType();
    let mut SrcTy: *mut Type = Cast.getSrcTy();
    let mut X: *mut Value = null;
    let mut DL: *DataLayout = IC.getDataLayout();
    if match(Cast, m_OneUse(m_ZExt(m_Value(X)))) {
        let mut Flags: PreservedCastFlags = PreservedCastFlags {};
        if getLosslessUnsignedTrunc(C, SrcTy, DL, &mut Flags) {
            TruncC;
        } else {
            let mut NewOp: *mut Value = IC.Builder.CreateBinOp(LogicOpc, X, TruncC, "", null);
            let mut ZExt: *mut ZExtInst = ZExtInst { NewOp, DestTy, "", null };
            ZExt.setNonNeg(Flags.NNeg);
            ZExt.andIRFlags(Cast);
            return ZExt;
        }
    }
    if match(Cast, m_OneUse(m_SExtLike(m_Value(X)))) {
        if getLosslessSignedTrunc(C, SrcTy, DL, null) {
            TruncC;
        } else {
            let mut NewOp: *mut Value = IC.Builder.CreateBinOp(LogicOpc, X, TruncC, "", null);
            return SExtInst { NewOp, DestTy, "", null };
        }
    }
    return null;
}

fn InstCombinerImpl::foldCastedBitwiseLogic(self, I: *mut BinaryOperator) -> *mut Instruction {
    let mut LogicOpc: BinaryOps = I.getOpcode();
    assert!(I.isBitwiseLogicOp(), "Unexpected opcode for bitwise logic folding");
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut FoldBitwiseICmpZeroWithICmp: Closure_13 = Closure_13 { cap_0: self, LogicOpc: &mut LogicOpc };
    if FoldBitwiseICmpZeroWithICmp.call(Op0, Op1) {
        Ret;
    } else {
        return Ret;
    }
    if FoldBitwiseICmpZeroWithICmp.call(Op1, Op0) {
        Ret;
    } else {
        return Ret;
    }
    let mut Cast0: *mut CastInst = dyn_cast(Op0);
    if !Cast0 {
        return null;
    }
    let mut DestTy: *mut Type = I.getType();
    let mut SrcTy: *mut Type = Cast0.getSrcTy();
    if !SrcTy.isIntOrIntVectorTy() {
        return null;
    }
    if foldLogicCastConstant(I, Cast0, *self) {
        Ret;
    } else {
        return Ret;
    }
    let mut Cast1: *mut CastInst = dyn_cast(Op1);
    if !Cast1 {
        return null;
    }
    let mut CastOpcode: CastOps = Cast0.getOpcode();
    if CastOpcode != Cast1.getOpcode() {
        return null;
    }
    if !Cast0.hasOneUse() && !Cast1.hasOneUse() {
        return null;
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(Cast0, m_ZExtOrSExt(m_Value(X))) && match(Cast1, m_ZExtOrSExt(m_Value(Y))) {
        let mut XNumBits: u32 = X.getType().getScalarSizeInBits();
        let mut YNumBits: u32 = Y.getType().getScalarSizeInBits();
        if XNumBits != YNumBits {
            if !Cast0.hasOneUse() || !Cast1.hasOneUse() {
                return null;
            }
            if XNumBits < YNumBits {
                X = self.Builder.CreateCast(CastOpcode, X, Y.getType(), "", null, FMFSource {});
            } else if YNumBits < XNumBits {
                Y = self.Builder.CreateCast(CastOpcode, Y, X.getType(), "", null, FMFSource {});
            }
        }
        let mut NarrowLogic: *mut Value = self.Builder.CreateBinOp(LogicOpc, X, Y, I.getName(), null);
        let mut Disjoint: *mut PossiblyDisjointInst = dyn_cast(&mut I);
        let mut NewDisjoint: *mut PossiblyDisjointInst = dyn_cast(NarrowLogic);
        if Disjoint && NewDisjoint {
            NewDisjoint.setIsDisjoint(Disjoint.isDisjoint());
        }
        return Create(CastOpcode, NarrowLogic, DestTy, "", null);
    }
    if SrcTy != Cast1.getSrcTy() {
        return null;
    }
    let mut Cast0Src: *mut Value = Cast0.getOperand(0);
    let mut Cast1Src: *mut Value = Cast1.getOperand(0);
    if self.shouldOptimizeCast(Cast0) && self.shouldOptimizeCast(Cast1) {
        let mut NewOp: *mut Value = self.Builder.CreateBinOp(LogicOpc, Cast0Src, Cast1Src, I.getName(), null);
        let mut NewCast: *mut CastInst = Create(CastOpcode, NewOp, DestTy, "", null);
        if dyn_cast(NewCast) {
            NewTrunc;
        } else {
            let mut Trunc0: *mut TruncInst = cast(Cast0);
            let mut Trunc1: *mut TruncInst = cast(Cast1);
            NewTrunc.setHasNoUnsignedWrap(if LogicOpc == And { Trunc0.hasNoUnsignedWrap() || Trunc1.hasNoUnsignedWrap() } else { Trunc0.hasNoUnsignedWrap() && Trunc1.hasNoUnsignedWrap() });
            NewTrunc.setHasNoSignedWrap(Trunc0.hasNoSignedWrap() && Trunc1.hasNoSignedWrap());
        }
        return NewCast;
    }
    return null;
}

fn foldAndToXor(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    assert!(I.getOpcode() == And);
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    if match(&mut I, m_BinOp(m_Or(m_Value(A), m_Value(B)), m_Not(m_c_And(m_Deferred(A), m_Deferred(B))))) {
        return CreateXor(A, B, "");
    }
    if Op0.hasOneUse() || Op1.hasOneUse() {
        if match(&mut I, m_BinOp(m_c_Or(m_Value(A), m_Not(m_Value(B))), m_c_Or(m_Not(m_Deferred(A)), m_Deferred(B)))) {
            return CreateNot(Builder.CreateXor(A, B, ""), "", null);
        }
    }
    return null;
}

fn foldOrToXor(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    assert!(I.getOpcode() == Or);
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    if Op0.hasOneUse() || Op1.hasOneUse() {
        if match(Op0, m_And(m_Value(A), m_Value(B))) && match(Op1, m_Not(m_c_Or(m_Specific(A), m_Specific(B)))) {
            return CreateNot(Builder.CreateXor(A, B, ""), "", null);
        }
    }
    if Op0.hasOneUse() || Op1.hasOneUse() {
        if match(Op0, m_Xor(m_Value(A), m_Value(B))) && match(Op1, m_Not(m_c_Or(m_Specific(A), m_Specific(B)))) {
            return CreateNot(Builder.CreateAnd(A, B, ""), "", null);
        }
    }
    if match(Op0, m_c_And(m_Value(A), m_Not(m_Value(B)))) && match(Op1, m_c_And(m_Not(m_Specific(A)), m_Specific(B))) {
        return CreateXor(A, B, "");
    }
    return null;
}

fn canNarrowShiftAmt(C: *mut Constant, BitWidth: u32) -> bool {
    let mut Threshold: APInt = APInt { C.getType().getScalarSizeInBits(), BitWidth, false, false };
    return match(C, m_SpecificInt_ICMP(ICMP_ULT, Threshold));
}

fn InstCombinerImpl::narrowMaskedBinOp(self, And: *mut BinaryOperator) -> *mut Instruction {
    let mut Op0: *mut Value = And.getOperand(0);
    let mut Op1: *mut Value = And.getOperand(1);
    let mut C: *mut Constant = null;
    if !match(Op0, m_OneUse(m_Add(m_Specific(Op1), m_Constant(C)))) && !match(Op0, m_OneUse(m_Mul(m_Specific(Op1), m_Constant(C)))) && !match(Op0, m_OneUse(m_LShr(m_Specific(Op1), m_Constant(C)))) && !match(Op0, m_OneUse(m_Shl(m_Specific(Op1), m_Constant(C)))) && !match(Op0, m_OneUse(m_Sub(m_Constant(C), m_Specific(Op1)))) {
        return null;
    }
    let mut X: *mut Value = null;
    if !match(Op1, m_ZExt(m_Value(X))) || Op1.hasNUsesOrMore(3) {
        return null;
    }
    let mut Ty: *mut Type = And.getType();
    if !isa(Ty) && !self.shouldChangeType(Ty, X.getType()) {
        return null;
    }
    let mut Opc: BinaryOps = cast(Op0).getOpcode();
    if Opc == LShr || Opc == Shl {
        if !canNarrowShiftAmt(C, X.getType().getScalarSizeInBits()) {
            return null;
        }
    }
    let mut NewC: *mut Value = getTrunc(C, X.getType(), false);
    let mut NewBO: *mut Value = if Opc == Sub { self.Builder.CreateBinOp(Opc, NewC, X, "", null) } else { self.Builder.CreateBinOp(Opc, X, NewC, "", null) };
    return ZExtInst { self.Builder.CreateAnd(NewBO, X, ""), Ty, "", null };
}

fn foldComplexAndOrPatterns(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Opcode: BinaryOps = I.getOpcode();
    assert!(Opcode == And || Opcode == Or);
    let mut FlippedOpcode: BinaryOps = if (Opcode == And) { Or } else { And };
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut C: *mut Value = null;
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut Dummy: *mut Value = null;
    let mut matchNotOrAnd: Closure_14 = Closure_14 { Opcode: Opcode, FlippedOpcode: FlippedOpcode };
    if matchNotOrAnd.call(Op0, m_Value(A), m_Value(B), m_Value(C), X, false) {
        if matchNotOrAnd.call(Op1, m_Specific(A), m_Specific(C), m_Specific(B), Dummy, true) {
            let mut Xor: *mut Value = Builder.CreateXor(B, C, "");
            return if (Opcode == Or) { CreateAnd(Xor, Builder.CreateNot(A, ""), "") } else { CreateNot(Builder.CreateAnd(Xor, A, ""), "", null) };
        }
        if matchNotOrAnd.call(Op1, m_Specific(B), m_Specific(C), m_Specific(A), Dummy, true) {
            let mut Xor: *mut Value = Builder.CreateXor(A, C, "");
            return if (Opcode == Or) { CreateAnd(Xor, Builder.CreateNot(B, ""), "") } else { CreateNot(Builder.CreateAnd(Xor, B, ""), "", null) };
        }
        if match(Op1, m_OneUse(m_Not(m_OneUse(m_c_BinOp(Opcode, m_Specific(A), m_Specific(C)))))) {
            return CreateNot(Builder.CreateBinOp(Opcode, Builder.CreateBinOp(FlippedOpcode, B, C, "", null), A, "", null), "", null);
        }
        if match(Op1, m_OneUse(m_Not(m_OneUse(m_c_BinOp(Opcode, m_Specific(B), m_Specific(C)))))) {
            return CreateNot(Builder.CreateBinOp(Opcode, Builder.CreateBinOp(FlippedOpcode, A, C, "", null), B, "", null), "", null);
        }
        if Opcode == Or && Op0.hasOneUse() && match(Op1, m_OneUse(m_Not(m_Value(Y, m_c_BinOp(Opcode, m_Specific(C), m_c_Xor(m_Specific(A), m_Specific(B))))))) {
            let mut Or: *mut Value = cast(X).getOperand(0);
            return CreateNot(Builder.CreateAnd(Or, Y, ""), "", null);
        }
    }
    if match(Op0, m_OneUse(m_c_BinOp(FlippedOpcode, m_BinOp(FlippedOpcode, m_Value(B), m_Value(C)), m_Value(X, m_Not(m_Value(A)))))) || match(Op0, m_OneUse(m_c_BinOp(FlippedOpcode, m_c_BinOp(FlippedOpcode, m_Value(C), m_Value(X, m_Not(m_Value(A)))), m_Value(B)))) {
        if match(Op1, m_OneUse(m_Not(m_c_BinOp(Opcode, m_c_BinOp(Opcode, m_Specific(A), m_Specific(B)), m_Specific(C))))) || match(Op1, m_OneUse(m_Not(m_c_BinOp(Opcode, m_c_BinOp(Opcode, m_Specific(B), m_Specific(C)), m_Specific(A))))) || match(Op1, m_OneUse(m_Not(m_c_BinOp(Opcode, m_c_BinOp(Opcode, m_Specific(A), m_Specific(C)), m_Specific(B))))) {
            let mut Xor: *mut Value = Builder.CreateXor(B, C, "");
            return if (Opcode == Or) { CreateNot(Builder.CreateOr(Xor, A, "", false), "", null) } else { CreateOr(Xor, X, "") };
        }
        if match(Op1, m_OneUse(m_Not(m_OneUse(m_c_BinOp(Opcode, m_Specific(A), m_Specific(B)))))) {
            return Create(FlippedOpcode, Builder.CreateBinOp(Opcode, C, Builder.CreateNot(B, ""), "", null), X, "", null);
        }
        if match(Op1, m_OneUse(m_Not(m_OneUse(m_c_BinOp(Opcode, m_Specific(A), m_Specific(C)))))) {
            return Create(FlippedOpcode, Builder.CreateBinOp(Opcode, B, Builder.CreateNot(C, ""), "", null), X, "", null);
        }
    }
    return null;
}

fn reassociateForUses(BO: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Opcode: BinaryOps = BO.getOpcode();
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut Z: *mut Value = null;
    if match(&mut BO, m_c_BinOp(Opcode, m_OneUse(m_BinOp(Opcode, m_Value(X), m_Value(Y))), m_OneUse(m_Value(Z)))) {
        if !isa(X) && !isa(Y) && !isa(Z) {
            if !X.hasOneUse() {
                let mut YZ: *mut Value = Builder.CreateBinOp(Opcode, Y, Z, "", null);
                return Create(Opcode, YZ, X, "", null);
            }
            if !Y.hasOneUse() {
                let mut XZ: *mut Value = Builder.CreateBinOp(Opcode, X, Z, "", null);
                return Create(Opcode, XZ, Y, "", null);
            }
        }
    }
    return null;
}

fn canonicalizeLogicFirst(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Ty: *mut Type = I.getType();
    let mut OpC: BinaryOps = I.getOpcode();
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut X: *mut Value = null;
    let mut C: *APInt = null;
    let mut C2: *APInt = null;
    if !(match(Op0, m_OneUse(m_Add(m_Value(X), m_APInt(C2)))) && match(Op1, m_APInt(C))) {
        return null;
    }
    let mut Width: u32 = Ty.getScalarSizeInBits();
    let mut LastOneMath: u32 = Width - C2.countr_zero();
    match OpC {
        And => {
            if C.countl_one() < LastOneMath {
                return null;
            }
        },
        Xor => {
            Or;
        },
        _ => {
            llvm_unreachable_internal("Unexpected BinaryOp!", "P:/Goraw/llvm-project/llvm/lib/Transforms/InstCombine/InstCombineAndOrXor.cpp", 2255);
        },
    }
    let mut NewBinOp: *mut Value = Builder.CreateBinOp(OpC, X, get(Ty, *C), "", null);
    return CreateWithCopiedFlags(Add, NewBinOp, get(Ty, *C2), Op0, "", null);
}

fn InstCombinerImpl::foldBinOpOfDisplacedShifts(self, I: *mut BinaryOperator) -> *mut Instruction {
    assert!((I.isBitwiseLogicOp() || I.getOpcode() == Add), "Unexpected opcode");
    let mut ShAmt: *mut Value = null;
    let mut ShiftedC1: *mut Constant = null;
    let mut ShiftedC2: *mut Constant = null;
    let mut AddC: *mut Constant = null;
    let mut Ty: *mut Type = I.getType();
    let mut BitWidth: u32 = Ty.getScalarSizeInBits();
    if !match(&mut I, m_c_BinOp(m_Shift(m_ImmConstant(ShiftedC1), m_Value(ShAmt)), m_Shift(m_ImmConstant(ShiftedC2), m_AddLike(m_Deferred(ShAmt), m_ImmConstant(AddC))))) {
        return null;
    }
    if !match(AddC, m_SpecificInt_ICMP(ICMP_ULT, APInt { BitWidth, BitWidth, false, false })) {
        return null;
    }
    let mut Op0Inst: *mut Instruction = dyn_cast(I.getOperand(0));
    let mut Op1Inst: *mut Instruction = dyn_cast(I.getOperand(1));
    if !Op0Inst || !Op1Inst {
        return null;
    }
    let mut ShiftOp: BinaryOps = Op0Inst.getOpcode() as BinaryOps;
    if ShiftOp != Op1Inst.getOpcode() {
        return null;
    }
    if I.getOpcode() == Add && ShiftOp != Shl {
        return null;
    }
    let mut NewC: *mut Value = self.Builder.CreateBinOp(I.getOpcode(), ShiftedC1, self.Builder.CreateBinOp(ShiftOp, ShiftedC2, AddC, "", null), "", null);
    return Create(ShiftOp, NewC, ShAmt, "", null);
}

fn foldBitwiseLogicWithIntrinsics(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    assert!(I.isBitwiseLogicOp(), "Should and/or/xor");
    if !I.getOperand(0).hasOneUse() {
        return null;
    }
    let mut X: *mut IntrinsicInst = dyn_cast(I.getOperand(0));
    if !X {
        return null;
    }
    let mut Y: *mut IntrinsicInst = dyn_cast(I.getOperand(1));
    if Y && (!Y.hasOneUse() || X.getIntrinsicID() != Y.getIntrinsicID()) {
        return null;
    }
    let mut IID: ID = X.getIntrinsicID();
    let mut RHSC: *APInt = null;
    if !Y && (!(IID == bswap || IID == bitreverse) || !match(I.getOperand(1), m_APInt(RHSC))) {
        return null;
    }
    match IID {
        fshl => {
            fshr;
        },
        bswap => {
            bitreverse;
        },
        _ => {
            return null;
        },
    }
}

fn simplifyAndOrWithOpReplaced(V: *mut Value, Op: *mut Value, RepOp: *mut Value, SimplifyOnly: bool, IC: *mut InstCombinerImpl, Depth: u32) -> *mut Value {
    if Op == RepOp {
        return null;
    }
    if V == Op {
        return RepOp;
    }
    let mut I: *mut BinaryOperator = dyn_cast(V);
    if !I || !I.isBitwiseLogicOp() || Depth >= 3 {
        return null;
    }
    if !I.hasOneUse() {
        SimplifyOnly = true;
    }
    let mut NewOp0: *mut Value = simplifyAndOrWithOpReplaced(I.getOperand(0), Op, RepOp, SimplifyOnly, IC, Depth + 1);
    let mut NewOp1: *mut Value = simplifyAndOrWithOpReplaced(I.getOperand(1), Op, RepOp, SimplifyOnly, IC, Depth + 1);
    if !NewOp0 && !NewOp1 {
        return null;
    }
    if !NewOp0 {
        NewOp0 = I.getOperand(0);
    }
    if !NewOp1 {
        NewOp1 = I.getOperand(1);
    }
    if simplifyBinOp(I.getOpcode(), NewOp0, NewOp1, IC.getSimplifyQuery().getWithInstruction(I)) {
        Res;
    } else {
        return Res;
    }
    if SimplifyOnly {
        return null;
    }
    return IC.Builder.CreateBinOp(I.getOpcode(), NewOp0, NewOp1, "", null);
}

fn foldRoundUpToPow2Alignment(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut NegP: *APInt = null;
    let mut Add: *mut Value = null;
    if !match(&mut I, m_And(m_Value(Add), m_NegatedPower2(NegP))) {
        return null;
    }
    let mut X: *mut Value = null;
    let mut Cond: *mut Value = null;
    let mut Mask: APInt = operator(*NegP);
    if !match(Add, m_OneUse(m_c_Add(m_Value(X), m_Select(m_Value(Cond), m_ZeroInt(), m_SpecificInt(operator(*NegP)))))) {
        return null;
    }
    if !match(Cond, m_SpecificICmp(CmpPredicate { Pred: ICMP_EQ, HasSameSign: false }, m_And(m_Specific(X), m_SpecificInt(Mask)), m_Zero())) {
        return null;
    }
    let mut Ty: *mut Type = I.getType();
    let mut NewAdd: *mut Value = Builder.CreateAdd(X, get(Ty, Mask), "", false, false);
    return CreateAnd(NewAdd, get(Ty, *NegP), "");
}

fn InstCombinerImpl::reassociateBooleanAndOr(self, LHS: *mut Value, X: *mut Value, Y: *mut Value, I: *mut Instruction, IsAnd: bool, RHSIsLogical: bool) -> *mut Value {
    let mut Opcode: BinaryOps = if IsAnd { And } else { Or };
    let mut Folded: *mut Value = null;
    if self.foldBooleanAndOr(LHS, X, I, IsAnd, false) {
        Res;
    } else {
        Folded = if RHSIsLogical { self.Builder.CreateLogicalOp(Opcode, Res, Y, "", null) } else { self.Builder.CreateBinOp(Opcode, Res, Y, "", null) };
    }
    let mut SI: *mut SelectInst = dyn_cast_or_null(Folded);
    if SI != null {
        setExplicitlyUnknownBranchWeightsIfProfiled(*SI, "instcombine", I.getFunction());
    }
    return Folded;
}

fn InstCombinerImpl::visitAnd(self, I: *mut BinaryOperator) -> *mut Instruction {
    let mut Ty: *mut Type = I.getType();
    if simplifyAndInst(I.getOperand(0), I.getOperand(1), self.SQ.getWithInstruction(&mut I)) {
        V;
    } else {
        return self.replaceInstUsesWith(I, V);
    }
    if self.SimplifyAssociativeOrCommutative(I) {
        return &mut I;
    }
    if self.foldVectorBinop(I) {
        X;
    } else {
        return X;
    }
    if self.foldBinopWithPhiOperands(I) {
        Phi;
    } else {
        return Phi;
    }
    if self.SimplifyDemandedInstructionBits(I) {
        return &mut I;
    }
    if foldAndToXor(I, self.Builder) {
        Xor;
    } else {
        return Xor;
    }
    if foldComplexAndOrPatterns(I, self.Builder) {
        X;
    } else {
        return X;
    }
    if self.foldUsingDistributiveLaws(I) {
        V;
    } else {
        return self.replaceInstUsesWith(I, V);
    }
    if self.foldBinOpShiftWithShift(I) {
        R;
    } else {
        return R;
    }
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut C: *APInt = null;
    if (match(Op0, m_OneUse(m_LogicalShift(m_One(), m_Value(X)))) || (match(Op0, m_OneUse(m_Shl(m_APInt(C), m_Value(X)))) && (*C)[0])) && match(Op1, m_One()) {
        let mut IsZero: *mut Value = self.Builder.CreateICmpEQ(X, get(Ty, 0, false, false), "");
        return ZExtInst { IsZero, Ty, "", null };
    }
    let mut Neg: *mut Value = null;
    if match(&mut I, m_c_And(m_Value(Neg, m_OneUse(m_Neg(m_And(m_Value(), m_One())))), m_Value(Y))) {
        let mut Cmp: *mut Value = self.Builder.CreateIsNull(Neg, "");
        return self.createSelectInstWithUnknownProfile(Cmp, getNullValue(Ty), Y, "", null);
    }
    if match(&mut I, m_c_And(m_Value(Y), m_OneUse(m_CombineOr(m_c_Add(m_Value(X), m_Deferred(Y)), m_Sub(m_Value(X), m_Deferred(Y)))))) && self.isKnownToBeAPowerOfTwo(Y, true, &mut I, 0) {
        return CreateAnd(self.Builder.CreateNot(X, ""), Y, "");
    }
    if match(Op1, m_APInt(C)) {
        let mut XorC: *APInt = null;
        if match(Op0, m_OneUse(m_Xor(m_Value(X), m_APInt(XorC)))) {
            let mut NewC: *mut Constant = get(Ty, *C & *XorC);
            let mut And: *mut Value = self.Builder.CreateAnd(X, Op1, "");
            And.takeName(Op0);
            return CreateXor(And, NewC, "");
        }
        let mut OrC: *APInt = null;
        if match(Op0, m_OneUse(m_Or(m_Value(X), m_APInt(OrC)))) {
            let mut Together: APInt = *C & *OrC;
            let mut And: *mut Value = self.Builder.CreateAnd(X, get(Ty, Together ^ *C), "");
            And.takeName(Op0);
            return CreateOr(And, get(Ty, Together), "");
        }
        let mut Width: u32 = Ty.getScalarSizeInBits();
        let mut ShiftC: *APInt = null;
        if match(Op0, m_OneUse(m_SExt(m_AShr(m_Value(X), m_APInt(ShiftC))))) && ShiftC.ult(Width) {
            if *C == getLowBitsSet(Width, Width - ShiftC.getZExtValue()) {
                let mut Sext: *mut Value = self.Builder.CreateSExt(X, Ty, "");
                let mut ShAmtC: *mut Constant = get(Ty, ShiftC.zext(Width));
                return CreateLShr(Sext, ShAmtC, "");
            }
        }
        if match(Op0, m_AShr(m_Value(X), m_APInt(ShiftC))) && ShiftC.ult(Width) && C.isMask(Width - ShiftC.getZExtValue()) {
            return CreateLShr(X, get(Ty, *ShiftC), "");
        }
        let mut AddC: *APInt = null;
        if match(Op0, m_Add(m_Value(X), m_APInt(AddC))) {
            if Op0.hasOneUse() && C.isPowerOf2() && (*AddC & (*C - 1)) == 0 {
                assert!((*C & *AddC) != 0, "Expected common bit");
                let mut NewAnd: *mut Value = self.Builder.CreateAnd(X, Op1, "");
                return CreateXor(NewAnd, Op1, "");
            }
        }
        let mut isNarrowableBinOpcode: Closure_15 = Closure_15 {};
        let mut BO: *mut BinaryOperator = null;
        if match(Op0, m_OneUse(m_BinOp(BO))) && isNarrowableBinOpcode.call(BO) {
            let mut BOpcode: BinaryOps = BO.getOpcode();
            let mut X: *mut Value = null;
            let mut C1: *APInt = null;
            if match(BO, m_c_BinOp(m_OneUse(m_ZExt(m_Value(X))), m_APInt(C1))) && C.isIntN(X.getType().getScalarSizeInBits()) {
                let mut XWidth: u32 = X.getType().getScalarSizeInBits();
                let mut TruncC1: *mut Constant = get(X.getType(), C1.trunc(XWidth));
                let mut BinOp: *mut Value = if isa(BO.getOperand(0)) { self.Builder.CreateBinOp(BOpcode, X, TruncC1, "", null) } else { self.Builder.CreateBinOp(BOpcode, TruncC1, X, "", null) };
                let mut TruncC: *mut Constant = get(X.getType(), C.trunc(XWidth));
                let mut And: *mut Value = self.Builder.CreateAnd(BinOp, TruncC, "");
                return ZExtInst { And, Ty, "", null };
            }
            if isa(BO.getOperand(0)) && match(BO.getOperand(0), m_OneUse(m_ZExt(m_Value(X)))) && C.isMask(X.getType().getScalarSizeInBits()) {
                Y = BO.getOperand(1);
                let mut TrY: *mut Value = self.Builder.CreateTrunc(Y, X.getType(), Y.getName() + ".tr", false, false);
                let mut NewBO: *mut Value = self.Builder.CreateBinOp(BOpcode, X, TrY, BO.getName() + ".narrow", null);
                return ZExtInst { NewBO, Ty, "", null };
            }
            if isa(BO.getOperand(1)) && match(BO.getOperand(1), m_OneUse(m_ZExt(m_Value(X)))) && C.isMask(X.getType().getScalarSizeInBits()) {
                Y = BO.getOperand(0);
                let mut TrY: *mut Value = self.Builder.CreateTrunc(Y, X.getType(), Y.getName() + ".tr", false, false);
                let mut NewBO: *mut Value = self.Builder.CreateBinOp(BOpcode, TrY, X, BO.getName() + ".narrow", null);
                return ZExtInst { NewBO, Ty, "", null };
            }
        }
        if match(Op0, m_OneUse(m_Xor(m_Value(X), m_Value(Y)))) || match(Op0, m_OneUse(m_Or(m_Value(X), m_Value(Y)))) {
            let mut NotAndMask: APInt = operator((*C));
            let mut BinOp: BinaryOps = cast(Op0).getOpcode();
            if self.MaskedValueIsZero(X, NotAndMask, &mut I, 0) {
                let mut NewRHS: *mut Value = self.Builder.CreateAnd(Y, Op1, Y.getName() + ".masked");
                return Create(BinOp, X, NewRHS, "", null);
            }
            if !isa(Y) && self.MaskedValueIsZero(Y, NotAndMask, &mut I, 0) {
                let mut NewLHS: *mut Value = self.Builder.CreateAnd(X, Op1, X.getName() + ".masked");
                return Create(BinOp, NewLHS, Y, "", null);
            }
        }
        if C.isPowerOf2() && match(Op0, m_OneUse(m_LogicalShift(m_Power2(ShiftC), m_Value(X)))) {
            let mut Log2ShiftC: i32 = ShiftC.exactLogBase2();
            let mut Log2C: i32 = C.exactLogBase2();
            let mut IsShiftLeft: bool = cast(Op0).getOpcode() == Shl;
            let mut BitNum: i32 = if IsShiftLeft { Log2C - Log2ShiftC } else { Log2ShiftC - Log2C };
            assert!(BitNum >= 0, "Expected demanded bits to handle impossible mask");
            let mut Cmp: *mut Value = self.Builder.CreateICmpEQ(X, get(Ty, BitNum, false, false), "");
            return self.createSelectInstWithUnknownProfile(Cmp, get(Ty, *C), getNullValue(Ty), "", null);
        }
        let mut C1: *mut Constant = null;
        let mut C2: *mut Constant = null;
        let mut C3: *APInt = C;
        let mut X: *mut Value = null;
        if C3.isPowerOf2() {
            let mut Log2C3: *mut Constant = get(Ty, C3.countr_zero(), false, false);
            if match(Op0, m_OneUse(m_LShr(m_Shl(m_ImmConstant(C1), m_Value(X)), m_ImmConstant(C2)))) && match(C1, m_Power2()) {
                let mut Log2C1: *mut Constant = getExactLogBase2(C1);
                let mut LshrC: *mut Constant = getAdd(C2, Log2C3, false, false);
                let mut KnownLShrc: KnownBits = self.computeKnownBits(LshrC, null, 0);
                if KnownLShrc.getMaxValue().ult(Width) {
                    let mut CmpC: *mut Constant = getSub(LshrC, Log2C1, false, false);
                    let mut Cmp: *mut Value = self.Builder.CreateICmpEQ(X, CmpC, "");
                    return self.createSelectInstWithUnknownProfile(Cmp, get(Ty, *C3), getNullValue(Ty), "", null);
                }
            }
            if match(Op0, m_OneUse(m_Shl(m_LShr(m_ImmConstant(C1), m_Value(X)), m_ImmConstant(C2)))) && match(C1, m_Power2()) {
                let mut Log2C1: *mut Constant = getExactLogBase2(C1);
                let mut Cmp: *mut Constant = ConstantFoldCompareInstOperands(ICMP_ULT, Log2C3, C2, self.DL, null, null);
                if Cmp && Cmp.isNullValue() {
                    let mut ShlC: *mut Constant = getAdd(C2, Log2C1, false, false);
                    let mut CmpC: *mut Constant = getSub(ShlC, Log2C3, false, false);
                    let mut Cmp: *mut Value = self.Builder.CreateICmpEQ(X, CmpC, "");
                    return self.createSelectInstWithUnknownProfile(Cmp, get(Ty, *C3), getNullValue(Ty), "", null);
                }
            }
        }
    }
    let mut CastOp: *mut Value = null;
    if match(Op0, m_ElementWiseBitCast(m_Value(CastOp))) && match(Op1, m_MaxSignedValue()) && !self.Builder.GetInsertBlock().getParent().hasFnAttribute(NoImplicitFloat) {
        let mut EltTy: *mut Type = CastOp.getType().getScalarType();
        if EltTy.isFloatingPointTy() && hasSignBitInMSB(EltTy.getFltSemantics()) {
            let mut FAbs: *mut Value = self.Builder.CreateFAbs(CastOp, FMFSource {}, "");
            return BitCastInst { FAbs, I.getType(), "", null };
        }
    }
    if match(&mut I, m_And(m_OneUse(m_Shl(m_ZExt(m_Value(X)), m_Value(Y))), m_SignMask())) && match(Y, m_SpecificInt_ICMP(ICMP_EQ, APInt { Ty.getScalarSizeInBits(), Ty.getScalarSizeInBits() - X.getType().getScalarSizeInBits(), false, false })) {
        let mut SExt: *mut Value = self.Builder.CreateSExt(X, Ty, X.getName() + ".signext");
        return CreateAnd(SExt, Op1, "");
    }
    if self.narrowMaskedBinOp(I) {
        Z;
    } else {
        return Z;
    }
    if I.getType().isIntOrIntVectorTy(1) {
        if dyn_cast(Op0) {
            SI0;
        } else {
            if self.foldAndOrOfSelectUsingImpliedCond(Op1, *SI0, true) {
                R;
            } else {
                return R;
            }
        }
        if dyn_cast(Op1) {
            SI1;
        } else {
            if self.foldAndOrOfSelectUsingImpliedCond(Op0, *SI1, true) {
                R;
            } else {
                return R;
            }
        }
    }
    if self.foldBinOpIntoSelectOrPhi(I) {
        FoldedLogic;
    } else {
        return FoldedLogic;
    }
    if matchDeMorgansLaws(I, *self) {
        DeMorgan;
    } else {
        return DeMorgan;
    }
    {
        let mut A: *mut Value = null;
        let mut B: *mut Value = null;
        let mut C: *mut Value = null;
        if match(Op1, m_Not(m_c_Xor(m_Specific(Op0), m_Value(B)))) {
            return CreateAnd(Op0, B, "");
        }
        if match(Op0, m_Not(m_c_Xor(m_Specific(Op1), m_Value(B)))) {
            return CreateAnd(Op1, B, "");
        }
        if match(Op0, m_Xor(m_Value(A), m_Value(B))) && match(Op1, m_Xor(m_Xor(m_Specific(B), m_Value(C)), m_Specific(A))) {
            let mut NotC: *mut Value = if Op1.hasOneUse() { self.Builder.CreateNot(C, "") } else { self.getFreelyInverted(C, C.hasOneUse(), &mut self.Builder) };
            if NotC != null {
                return CreateAnd(Op0, NotC, "");
            }
        }
        if match(Op0, m_Xor(m_Xor(m_Value(A), m_Value(C)), m_Value(B))) && match(Op1, m_Xor(m_Specific(B), m_Specific(A))) {
            let mut NotC: *mut Value = if Op0.hasOneUse() { self.Builder.CreateNot(C, "") } else { self.getFreelyInverted(C, C.hasOneUse(), &mut self.Builder) };
            if NotC != null {
                return CreateAnd(Op1, NotC, "");
            }
        }
        if match(Op1, m_c_Xor(m_Not(m_Value(A)), m_Value(B))) && match(Op0, m_c_Or(m_Specific(A), m_Specific(B))) {
            return CreateAnd(A, B, "");
        }
        if match(Op0, m_c_Xor(m_Not(m_Value(A)), m_Value(B))) && match(Op1, m_c_Or(m_Specific(A), m_Specific(B))) {
            return CreateAnd(A, B, "");
        }
        if match(Op0, m_c_Or(m_Not(m_Value(A)), m_Value(B))) && match(Op1, m_c_Xor(m_Specific(A), m_Specific(B))) {
            return CreateAnd(self.Builder.CreateNot(A, ""), B, "");
        }
        if match(Op1, m_c_Or(m_Not(m_Value(A)), m_Value(B))) && match(Op0, m_c_Xor(m_Specific(A), m_Specific(B))) {
            return CreateAnd(self.Builder.CreateNot(A, ""), B, "");
        }
    }
    if self.foldBooleanAndOr(Op0, Op1, I, true, false) {
        Res;
    } else {
        return self.replaceInstUsesWith(I, Res);
    }
    if match(Op1, m_OneUse(m_LogicalAnd(m_Value(X), m_Value(Y)))) {
        let mut IsLogical: bool = isa(Op1);
        if self.reassociateBooleanAndOr(Op0, X, Y, I, true, IsLogical) {
            V;
        } else {
            return self.replaceInstUsesWith(I, V);
        }
    }
    if match(Op0, m_OneUse(m_LogicalAnd(m_Value(X), m_Value(Y)))) {
        let mut IsLogical: bool = isa(Op0);
        if self.reassociateBooleanAndOr(Op1, X, Y, I, true, IsLogical) {
            V;
        } else {
            return self.replaceInstUsesWith(I, V);
        }
    }
    if reassociateFCmps(I, self.Builder) {
        FoldedFCmps;
    } else {
        return FoldedFCmps;
    }
    if self.foldCastedBitwiseLogic(I) {
        CastedAnd;
    } else {
        return CastedAnd;
    }
    if self.foldBinopOfSextBoolToSelect(I) {
        Sel;
    } else {
        return Sel;
    }
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    if match(&mut I, m_c_And(m_SExt(m_Value(A)), m_Value(B))) && A.getType().isIntOrIntVectorTy(1) {
        return self.createSelectInstWithUnknownProfile(A, B, getNullValue(Ty), "", null);
    }
    if match(&mut I, m_c_And(m_Not(m_SExt(m_Value(A))), m_Value(B))) && A.getType().isIntOrIntVectorTy(1) {
        return self.createSelectInstWithUnknownProfile(A, getNullValue(Ty), B, "", null);
    }
    if match(&mut I, m_c_And(m_OneUse(m_ZExt(m_Value(A))), m_Value(B))) && A.getType().isIntOrIntVectorTy(1) {
        return self.createSelectInstWithUnknownProfile(A, self.Builder.CreateAnd(B, get(Ty, 1, false, false), ""), getNullValue(Ty), "", null);
    }
    if match(&mut I, m_c_And(m_OneUse(m_Add(m_ZExtOrSelf(m_Value(A)), m_AllOnes())), m_Value(B))) {
        if A.getType().isIntOrIntVectorTy(1) {
            return self.createSelectInstWithUnknownProfile(A, getNullValue(Ty), B, "", null);
        }
        if self.computeKnownBits(A, &mut I, 0).countMaxActiveBits() <= 1 {
            return self.createSelectInstWithUnknownProfile(self.Builder.CreateICmpEQ(A, getNullValue(A.getType()), ""), B, getNullValue(Ty), "", null);
        }
    }
    if match(&mut I, m_c_And(m_OneUse(m_SExtOrSelf(m_AShr(m_Value(X), m_APIntAllowPoison(C)))), m_Value(Y))) && *C == X.getType().getScalarSizeInBits() - 1 {
        let mut IsNeg: *mut Value = self.Builder.CreateIsNeg(X, "isneg");
        return self.createSelectInstWithUnknownProfile(IsNeg, Y, getNullValue(Ty), "", null);
    }
    if match(&mut I, m_c_And(m_OneUse(m_SExtOrSelf(m_Not(m_AShr(m_Value(X), m_APIntAllowPoison(C))))), m_Value(Y))) && *C == X.getType().getScalarSizeInBits() - 1 {
        let mut IsNeg: *mut Value = self.Builder.CreateIsNeg(X, "isneg");
        return self.createSelectInstWithUnknownProfile(IsNeg, getNullValue(Ty), Y, "", null);
    }
    if self.sinkNotIntoOtherHandOfLogicalOp(I) {
        return &mut I;
    }
    let mut PN: *mut PHINode = null;
    let mut Start: *mut Value = null;
    let mut Step: *mut Value = null;
    if matchSimpleRecurrence(&mut I, PN, Start, Step) && self.DT.dominates(Step, PN) {
        return self.replaceInstUsesWith(I, self.Builder.CreateAnd(Start, Step, ""));
    }
    if reassociateForUses(I, self.Builder) {
        R;
    } else {
        return R;
    }
    if canonicalizeLogicFirst(I, self.Builder) {
        Canonicalized;
    } else {
        return Canonicalized;
    }
    if self.foldLogicOfIsFPClass(I, Op0, Op1) {
        Folded;
    } else {
        return Folded;
    }
    if self.foldBinOpOfDisplacedShifts(I) {
        Res;
    } else {
        return Res;
    }
    if foldBitwiseLogicWithIntrinsics(I, self.Builder) {
        Res;
    } else {
        return Res;
    }
    if simplifyAndOrWithOpReplaced(Op0, Op1, getAllOnesValue(Ty), false, *self, 0) {
        V;
    } else {
        return CreateAnd(V, Op1, "");
    }
    if simplifyAndOrWithOpReplaced(Op1, Op0, getAllOnesValue(Ty), false, *self, 0) {
        V;
    } else {
        return CreateAnd(Op0, V, "");
    }
    if foldRoundUpToPow2Alignment(I, self.Builder) {
        Res;
    } else {
        return Res;
    }
    return null;
}

fn InstCombinerImpl::matchBSwapOrBitReverse(self, I: *mut Instruction, MatchBSwaps: bool, MatchBitReversals: bool) -> *mut Instruction {
    let mut Insts: SmallVector<Instruction *, 4> = SmallVector<Instruction *, 4> {};
    if !recognizeBSwapOrBitReverseIdiom(&mut I, MatchBSwaps, MatchBitReversals, Insts) {
        return null;
    }
    let mut LastInst: *mut Instruction = Insts.pop_back_val();
    LastInst.removeFromParent();
    for Inst in Insts {
        Inst.setDebugLoc(I.getDebugLoc());
        self.Worklist.push(Inst);
    }
    return LastInst;
}

fn InstCombinerImpl::convertOrOfShiftsToFunnelShift(self, Or: *mut Instruction) -> ID, SmallVector<Value *, 3>>> {
    assert!(Or.getOpcode() == Or, "Expecting or instruction");
    let mut Width: u32 = Or.getType().getScalarSizeInBits();
    let mut Or0: *mut Instruction = null;
    let mut Or1: *mut Instruction = null;
    if !match(Or.getOperand(0), m_Instruction(Or0)) || !match(Or.getOperand(1), m_Instruction(Or1)) {
        return nullopt;
    }
    let mut IsFshl: bool = true;
    let mut FShiftArgs: SmallVector<Value *, 3> = SmallVector<Value *, 3> {};
    if isa(Or0) && isa(Or1) {
        let mut ShVal0: *mut Value = null;
        let mut ShVal1: *mut Value = null;
        let mut ShAmt0: *mut Value = null;
        let mut ShAmt1: *mut Value = null;
        if !match(Or0, m_OneUse(m_LogicalShift(m_Value(ShVal0), m_Value(ShAmt0)))) || !match(Or1, m_OneUse(m_LogicalShift(m_Value(ShVal1), m_Value(ShAmt1)))) || Or0.getOpcode() == Or1.getOpcode() {
            return nullopt;
        }
        if Or0.getOpcode() == LShr {
            swap(Or0, Or1);
            swap(ShVal0, ShVal1);
            swap(ShAmt0, ShAmt1);
        }
        assert!(Or0.getOpcode() == Shl && Or1.getOpcode() == LShr, "Illegal or(shift,shift) pair");
        let mut matchShiftAmount: Closure_16 = Closure_16 { cap_0: self, Or: &mut Or, ShVal0: &mut ShVal0, ShVal1: &mut ShVal1 };
        let mut ShAmt: *mut Value = matchShiftAmount.call(ShAmt0, ShAmt1, Width);
        if !ShAmt {
            ShAmt = matchShiftAmount.call(ShAmt1, ShAmt0, Width);
            IsFshl = false;
        }
        if !ShAmt {
            return nullopt;
        }
        FShiftArgs = [ShVal0, ShVal1, ShAmt];
    } else if isa(Or0) || isa(Or1) {
        if !isa(Or1) {
            swap(Or0, Or1);
        }
        let mut High: *mut Value = null;
        let mut ZextHigh: *mut Value = null;
        let mut Low: *mut Value = null;
        let mut ZextHighShlAmt: *APInt = null;
        if !match(Or0, m_OneUse(m_Shl(m_Value(ZextHigh), m_APInt(ZextHighShlAmt)))) {
            return nullopt;
        }
        if !match(Or1, m_ZExt(m_Value(Low))) || !match(ZextHigh, m_ZExt(m_Value(High))) {
            return nullopt;
        }
        let mut HighSize: u32 = High.getType().getScalarSizeInBits();
        let mut LowSize: u32 = Low.getType().getScalarSizeInBits();
        if ZextHighShlAmt.ult(LowSize) || ZextHighShlAmt.ugt(Width - HighSize) {
            return nullopt;
        }
        for U in ZextHigh.users() {
            let mut X: *mut Value = null;
            let mut Y: *mut Value = null;
            if !match(U, m_Or(m_Value(X), m_Value(Y))) {
                continue;
            }
            if !isa(Y) {
                swap(X, Y);
            }
            let mut ZextLowShlAmt: *APInt = null;
            if !match(X, m_Shl(m_Specific(Or1), m_APInt(ZextLowShlAmt))) || !match(Y, m_Specific(ZextHigh)) || !self.DT.dominates(U, &mut Or) {
                continue;
            }
            if *ZextLowShlAmt + *ZextHighShlAmt != Width {
                continue;
            }
            assert!(ZextLowShlAmt.uge(HighSize) && ZextLowShlAmt.ule(Width - LowSize), "Invalid concat");
            cast(U).dropPoisonGeneratingFlags();
            cast(X).dropPoisonGeneratingFlags();
            FShiftArgs = [U, U, get(Or0.getType(), *ZextHighShlAmt)];
            break;
        }
    }
    if FShiftArgs.is_empty() {
        return nullopt;
    }
    let mut IID: ID = if IsFshl { fshl } else { fshr };
    return make_pair(IID, FShiftArgs);
}

fn matchFunnelShift(Or: *mut Instruction, IC: *mut InstCombinerImpl) -> *mut Instruction {
    if IC.convertOrOfShiftsToFunnelShift(Or) {
        Opt;
    } else {
        let mut F: *mut Function = getOrInsertDeclaration(Or.getModule(), IID, Or.getType());
        return Create(F, FShiftArgs, ArrayRef<OperandBundleDef> {}, "", null);
    }
    return null;
}

fn matchOrConcat(Or: *mut Instruction, Builder: *mut BuilderTy) -> *mut Value {
    assert!(Or.getOpcode() == Or, "bswap requires an 'or'");
    let mut Op0: *mut Value = Or.getOperand(0);
    let mut Op1: *mut Value = Or.getOperand(1);
    let mut Ty: *mut Type = Or.getType();
    let mut Width: u32 = Ty.getScalarSizeInBits();
    if (Width & 1) != 0 {
        return null;
    }
    let mut HalfWidth: u32 = Width / 2;
    if !isa(Op0) {
        swap(Op0, Op1);
    }
    let mut LowerSrc: *mut Value = null;
    let mut ShlVal: *mut Value = null;
    let mut UpperSrc: *mut Value = null;
    let mut C: *APInt = null;
    if !match(Op0, m_OneUse(m_ZExt(m_Value(LowerSrc)))) || !match(Op1, m_OneUse(m_Shl(m_Value(ShlVal), m_APInt(C)))) || !match(ShlVal, m_OneUse(m_ZExt(m_Value(UpperSrc)))) {
        return null;
    }
    if *C != HalfWidth || LowerSrc.getType() != UpperSrc.getType() || LowerSrc.getType().getScalarSizeInBits() != HalfWidth {
        return null;
    }
    let mut ConcatIntrinsicCalls: Closure_17 = Closure_17 { Builder: &mut Builder, Ty: &mut Ty, HalfWidth: &mut HalfWidth };
    let mut LowerBSwap: *mut Value = null;
    let mut UpperBSwap: *mut Value = null;
    if match(LowerSrc, m_BSwap(m_Value(LowerBSwap))) && match(UpperSrc, m_BSwap(m_Value(UpperBSwap))) {
        return ConcatIntrinsicCalls.call(bswap, UpperBSwap, LowerBSwap);
    }
    let mut LowerBRev: *mut Value = null;
    let mut UpperBRev: *mut Value = null;
    if match(LowerSrc, m_BitReverse(m_Value(LowerBRev))) && match(UpperSrc, m_BitReverse(m_Value(UpperBRev))) {
        return ConcatIntrinsicCalls.call(bitreverse, UpperBRev, LowerBRev);
    }
    let mut X: *mut Value = null;
    if match(LowerSrc, m_SExtOrSelf(m_Value(X))) && match(UpperSrc, m_SExtOrSelf(m_AShr(m_Specific(X), m_SpecificInt(X.getType().getScalarSizeInBits() - 1)))) {
        return Builder.CreateSExt(X, Ty, "");
    }
    return null;
}

fn areInverseVectorBitmasks(C1: *mut Constant, C2: *mut Constant) -> bool {
    let mut NumElts: u32 = cast(C1.getType()).getNumElements();
    for let mut i: u32 = 0; i != NumElts; i += 1 {
        let mut EltC1: *mut Constant = C1.getAggregateElement(i);
        let mut EltC2: *mut Constant = C2.getAggregateElement(i);
        if !EltC1 || !EltC2 {
            return false;
        }
        if !((match(EltC1, m_Zero()) && match(EltC2, m_AllOnes())) || (match(EltC2, m_Zero()) && match(EltC1, m_AllOnes()))) {
            return false;
        }
    }
    return true;
}

fn InstCombinerImpl::getSelectCondition(self, A: *mut Value, B: *mut Value, ABIsTheSame: bool) -> *mut Value {
    let mut Ty: *mut Type = A.getType();
    if !Ty.isIntOrIntVectorTy() || !B.getType().isIntOrIntVectorTy() {
        return null;
    }
    if if ABIsTheSame { (A == B) } else { match(B, m_Not(m_Specific(A))) } {
        if Ty.isIntOrIntVectorTy(1) {
            return A;
        }
        A = peekThroughBitcast(A, false);
        if A.getType().isIntOrIntVectorTy() {
            let mut NumSignBits: u32 = self.ComputeNumSignBits(A, null, 0);
            if NumSignBits == A.getType().getScalarSizeInBits() && NumSignBits <= Ty.getScalarSizeInBits() {
                return self.Builder.CreateTrunc(A, makeCmpResultType(A.getType()), "", false, false);
            }
        }
        return null;
    }
    if ABIsTheSame {
        return null;
    }
    let mut AConst: *mut Constant = null;
    let mut BConst: *mut Constant = null;
    if match(A, m_Constant(AConst)) && match(B, m_Constant(BConst)) {
        if AConst == getNot(BConst) && self.ComputeNumSignBits(A, null, 0) == Ty.getScalarSizeInBits() {
            return self.Builder.CreateZExtOrTrunc(A, makeCmpResultType(Ty), "");
        }
    }
    let mut Cond: *mut Value = null;
    let mut NotB: *mut Value = null;
    if match(A, m_SExt(m_Value(Cond))) && Cond.getType().isIntOrIntVectorTy(1) {
        if match(B, m_SExt(m_Not(m_Specific(Cond)))) {
            return Cond;
        }
        if match(B, m_OneUse(m_Not(m_Value(NotB)))) {
            NotB = peekThroughBitcast(NotB, true);
            if match(NotB, m_SExt(m_Specific(Cond))) {
                return Cond;
            }
        }
    }
    if !Ty.isVectorTy() {
        return null;
    }
    if match(A, (m_Xor(m_SExt(m_Value(Cond)), m_Constant(AConst)))) && match(B, (m_Xor(m_SExt(m_Specific(Cond)), m_Constant(BConst)))) && Cond.getType().isIntOrIntVectorTy(1) && areInverseVectorBitmasks(AConst, BConst) {
        AConst = getTrunc(AConst, makeCmpResultType(Ty), false);
        return self.Builder.CreateXor(Cond, AConst, "");
    }
    return null;
}

fn InstCombinerImpl::matchSelectFromAndOr(self, A: *mut Value, B: *mut Value, C: *mut Value, D: *mut Value, InvertFalseVal: bool) -> *mut Value {
    let mut OrigType: *mut Type = A.getType();
    A = peekThroughBitcast(A, true);
    C = peekThroughBitcast(C, true);
    if self.getSelectCondition(A, C, InvertFalseVal) {
        Cond;
    } else {
        let mut SelTy: *mut Type = A.getType();
        if dyn_cast(Cond.getType()) {
            VecTy;
        } else {
            let mut Elts: u32 = VecTy.getElementCount().getKnownMinValue();
            let mut SelEltSize: u32 = SelTy.getPrimitiveSizeInBits().getKnownMinValue();
            let mut EltTy: *mut Type = self.Builder.getIntNTy(SelEltSize / Elts);
            SelTy = get(EltTy, VecTy.getElementCount());
        }
        let mut BitcastB: *mut Value = self.Builder.CreateBitCast(B, SelTy, "");
        if InvertFalseVal {
            D = self.Builder.CreateNot(D, "");
        }
        let mut BitcastD: *mut Value = self.Builder.CreateBitCast(D, SelTy, "");
        let mut Select: *mut Value = self.Builder.CreateSelect(Cond, BitcastB, BitcastD, "", null);
        return self.Builder.CreateBitCast(Select, OrigType, "");
    }
    return null;
}

fn foldAndOrOfICmpEqConstantAndICmp(PredL: CmpPredicate, LHS0: *mut Value, LHS1: *mut Value, LHSOneUse: bool, PredR: CmpPredicate, RHS0: *mut Value, RHS1: *mut Value, RHSOneUse: bool, IsAnd: bool, IsLogical: bool, Builder: *mut IRBuilderBase) -> *mut Value {
    if IsAnd {
        PredL = getInverse(PredL);
        PredR = getInverse(PredR);
    }
    let mut CInt: *APInt = null;
    if PredL != ICMP_EQ || !match(LHS1, m_APIntAllowPoison(CInt)) || !LHS0.getType().isIntOrIntVectorTy() || !(LHSOneUse || RHSOneUse) {
        return null;
    }
    let mut MatchRHSOp: Closure_19 = Closure_19 { LHS0: LHS0, CInt: CInt };
    let mut Other: *mut Value = null;
    if PredR == ICMP_ULT && MatchRHSOp.call(RHS1) {
        Other = RHS0;
    } else if PredR == ICMP_UGT && MatchRHSOp.call(RHS0) {
        Other = RHS1;
    } else {
        return null;
    }
    if IsLogical {
        Other = Builder.CreateFreeze(Other, "");
    }
    return Builder.CreateICmp(if IsAnd { ICMP_ULT } else { ICMP_UGE }, Builder.CreateSub(LHS0, get(LHS0.getType(), *CInt + 1), "", false, false), Other, "");
}

fn InstCombinerImpl::foldAndOrOfICmps(self, LHS: *mut Value, RHS: *mut Value, I: *mut Instruction, IsAnd: bool, IsLogical: bool) -> *mut Value {
    let mut PredL: CmpPredicate = CmpPredicate {};
    let mut PredR: CmpPredicate = CmpPredicate {};
    let mut LHS0: *mut Value = null;
    let mut LHS1: *mut Value = null;
    let mut RHS0: *mut Value = null;
    let mut RHS1: *mut Value = null;
    if !match(LHS, m_ICmpLike(PredL, m_Value(LHS0), m_Value(LHS1))) || !match(RHS, m_ICmpLike(PredR, m_Value(RHS0), m_Value(RHS1))) {
        return null;
    }
    let mut LHSOneUse: bool = LHS.hasOneUse();
    let mut RHSOneUse: bool = RHS.hasOneUse();
    let mut Q: SimplifyQuery = self.SQ.getWithInstruction(&mut I);
    let mut LHSC: *APInt = null;
    let mut RHSC: *APInt = null;
    match(LHS1, m_APInt(LHSC));
    match(RHS1, m_APInt(RHSC));
    if predicatesFoldable(PredL.operator llvm::CmpInst::Predicate(), PredR.operator llvm::CmpInst::Predicate()) {
        if LHS0 == RHS1 && LHS1 == RHS0 {
            PredL = CmpPredicate { Pred: getSwappedPredicate(PredL.operator llvm::CmpInst::Predicate()), HasSameSign: false };
            swap(LHS0, LHS1);
        }
        if LHS0 == RHS0 && LHS1 == RHS1 {
            let mut Code: u32 = if IsAnd { getICmpCode(PredL.operator llvm::CmpInst::Predicate()) & getICmpCode(PredR.operator llvm::CmpInst::Predicate()) } else { getICmpCode(PredL.operator llvm::CmpInst::Predicate()) | getICmpCode(PredR.operator llvm::CmpInst::Predicate()) };
            let mut IsSigned: bool = isSigned(PredL.operator llvm::CmpInst::Predicate()) || isSigned(PredR.operator llvm::CmpInst::Predicate());
            return getNewICmpValue(Code, IsSigned, LHS0, LHS1, self.Builder);
        }
    }
    if foldAndOrOfICmpEqConstantAndICmp(PredL, LHS0, LHS1, LHSOneUse, PredR, RHS0, RHS1, RHSOneUse, IsAnd, IsLogical, self.Builder) {
        V;
    } else {
        return V;
    }
    if foldAndOrOfICmpEqConstantAndICmp(PredR, RHS0, RHS1, RHSOneUse, PredL, LHS0, LHS1, LHSOneUse, IsAnd, false, self.Builder) {
        V;
    } else {
        return V;
    }
    if foldAndOrOfICmpsWithConstEq(PredL, LHS0, LHS1, LHS, PredR, RHS0, RHS1, RHSOneUse, IsAnd, IsLogical, self.Builder, Q, I) {
        V;
    } else {
        return V;
    }
    if isa(RHS) {
        if foldAndOrOfICmpsWithConstEq(PredR, RHS0, RHS1, RHS, PredL, LHS0, LHS1, LHSOneUse, IsAnd, false, self.Builder, Q, I) {
            V;
        } else {
            if IsLogical && PredR.hasSameSign() && !RHS.use_empty() {
                let mut CmpR: *mut ICmpInst = cast(RHS);
                CmpR.setSameSign(false);
                self.addToWorklist(CmpR);
            }
            return V;
        }
    }
    if foldIsPowerOf2OrZero(PredL, LHS0, LHS1, PredR, RHS0, RHS1, IsAnd, self.Builder, *self) {
        V;
    } else {
        return V;
    }
    if foldIsPowerOf2OrZero(PredR, RHS0, RHS1, PredL, LHS0, LHS1, IsAnd, self.Builder, *self) {
        V;
    } else {
        return V;
    }
    if !IsLogical {
        if self.simplifyRangeCheck(PredL, LHS0, LHS1, PredR, RHS0, RHS1, &mut I, !IsAnd) {
            V;
        } else {
            return V;
        }
        if self.simplifyRangeCheck(PredR, RHS0, RHS1, PredL, LHS0, LHS1, &mut I, !IsAnd) {
            V;
        } else {
            return V;
        }
    }
    if IsAnd && !IsLogical {
        if foldSignedTruncationCheck(PredL, LHS0, LHS1, PredR, RHS0, RHS1, I, self.Builder) {
            V;
        } else {
            return V;
        }
    }
    if foldIsPowerOf2(PredL, LHS0, LHS1, PredR, RHS0, RHS1, IsAnd, self.Builder, *self) {
        V;
    } else {
        return V;
    }
    if foldPowerOf2AndShiftedMask(LHS, RHS, IsAnd, self.Builder) {
        V;
    } else {
        return V;
    }
    if !IsLogical {
        if foldUnsignedUnderflowCheck(PredL, LHS0, LHS1, LHSOneUse, PredR, RHS0, RHS1, RHSOneUse, IsAnd, Q, self.Builder) {
            X;
        } else {
            return X;
        }
        if foldUnsignedUnderflowCheck(PredR, RHS0, RHS1, RHSOneUse, PredL, LHS0, LHS1, LHSOneUse, IsAnd, Q, self.Builder) {
            X;
        } else {
            return X;
        }
    }
    if PredL == (if IsAnd { ICMP_EQ } else { ICMP_NE }) && PredL.dropSameSign() == PredR.dropSameSign() && match(LHS1, m_ZeroInt()) && match(RHS1, m_ZeroInt()) && LHS0.getType() == RHS0.getType() && (!IsLogical || isGuaranteedNotToBePoison(RHS0, null, null, null, 0)) {
        let mut NewOr: *mut Value = self.Builder.CreateOr(LHS0, RHS0, "", false);
        return self.Builder.CreateICmp(PredL.operator llvm::CmpInst::Predicate(), NewOr, getNullValue(NewOr.getType()), "");
    }
    if PredL == (if IsAnd { ICMP_EQ } else { ICMP_NE }) && PredL.dropSameSign() == PredR.dropSameSign() && match(LHS1, m_AllOnes()) && match(RHS1, m_AllOnes()) && LHS0.getType() == RHS0.getType() && (!IsLogical || isGuaranteedNotToBePoison(RHS0, null, null, null, 0)) {
        let mut NewAnd: *mut Value = self.Builder.CreateAnd(LHS0, RHS0, "");
        return self.Builder.CreateICmp(PredL.operator llvm::CmpInst::Predicate(), NewAnd, getAllOnesValue(LHS0.getType()), "");
    }
    if !IsLogical {
        if foldAndOrOfICmpsWithPow2AndWithZero(self.Builder, PredL, LHS0, LHS1, LHSOneUse, PredR, RHS0, RHS1, RHSOneUse, IsAnd, Q) {
            V;
        } else {
            return V;
        }
    }
    if !LHSC || !RHSC {
        return null;
    }
    if PredL == (if IsAnd { ICMP_EQ } else { ICMP_NE }) && PredL.dropSameSign() == PredR.dropSameSign() && LHSOneUse && RHSOneUse {
        let mut V: *mut Value = null;
        let mut AndC: *APInt = null;
        let mut SmallC: *APInt = null;
        let mut BigC: *APInt = null;
        if match(RHS0, m_Trunc(m_Value(V))) && match(LHS0, m_And(m_Specific(V), m_APInt(AndC))) {
            SmallC = RHSC;
            BigC = LHSC;
        } else if match(LHS0, m_Trunc(m_Value(V))) && match(RHS0, m_And(m_Specific(V), m_APInt(AndC))) {
            SmallC = LHSC;
            BigC = RHSC;
        }
        if SmallC && BigC {
            let mut BigBitSize: u32 = BigC.getBitWidth();
            let mut SmallBitSize: u32 = SmallC.getBitWidth();
            let mut Low: APInt = getLowBitsSet(BigBitSize, SmallBitSize);
            if (Low & *AndC).isZero() && (Low & *BigC).isZero() {
                let mut NewAnd: *mut Value = self.Builder.CreateAnd(V, Low | *AndC, "");
                let mut N: APInt = SmallC.zext(BigBitSize) | *BigC;
                let mut NewVal: *mut Value = get(NewAnd.getType(), N);
                return self.Builder.CreateICmp(PredL.operator llvm::CmpInst::Predicate(), NewAnd, NewVal, "");
            }
        }
    }
    let mut TrueIfSignedL: bool = false;
    let mut TrueIfSignedR: bool = false;
    if isSignBitCheck(PredL.operator llvm::CmpInst::Predicate(), *LHSC, TrueIfSignedL) && isSignBitCheck(PredR.operator llvm::CmpInst::Predicate(), *RHSC, TrueIfSignedR) && (RHS.hasOneUse() || LHS.hasOneUse()) {
        let mut X: *mut Value = null;
        let mut Y: *mut Value = null;
        if IsAnd {
            if (TrueIfSignedL && !TrueIfSignedR && match(LHS0, m_Or(m_Value(X), m_Value(Y))) && match(RHS0, m_c_And(m_Specific(X), m_Specific(Y)))) || (!TrueIfSignedL && TrueIfSignedR && match(LHS0, m_And(m_Value(X), m_Value(Y))) && match(RHS0, m_c_Or(m_Specific(X), m_Specific(Y)))) {
                let mut NewXor: *mut Value = self.Builder.CreateXor(X, Y, "");
                return self.Builder.CreateIsNeg(NewXor, "");
            }
        } else {
            if (TrueIfSignedL && !TrueIfSignedR && match(LHS0, m_And(m_Value(X), m_Value(Y))) && match(RHS0, m_c_Or(m_Specific(X), m_Specific(Y)))) || (!TrueIfSignedL && TrueIfSignedR && match(LHS0, m_Or(m_Value(X), m_Value(Y))) && match(RHS0, m_c_And(m_Specific(X), m_Specific(Y)))) {
                let mut NewXor: *mut Value = self.Builder.CreateXor(X, Y, "");
                return self.Builder.CreateIsNotNeg(NewXor, "");
            }
        }
    }
    let mut X: *mut Value = null;
    let mut MaskC: *APInt = null;
    if LHS0 == RHS0 && PredL.dropSameSign() == PredR.dropSameSign() && PredL == (if IsAnd { ICMP_NE } else { ICMP_EQ }) && !I.getFunction().hasFnAttribute(NoImplicitFloat) && LHSOneUse && RHSOneUse && match(LHS0, m_And(m_ElementWiseBitCast(m_Value(X)), m_APInt(MaskC))) && X.getType().getScalarType().isIEEELikeFPTy() && APFloat { X.getType().getScalarType().getFltSemantics(), *MaskC }.isPosInfinity() && ((LHSC.isZero() && *RHSC == *MaskC) || (RHSC.isZero() && *LHSC == *MaskC)) {
        return self.Builder.createIsFPClass(X, if IsAnd { fcNormal } else { operator(fcNormal) });
    }
    return self.foldAndOrOfICmpsUsingRanges(PredL, LHS0, LHS1, LHSOneUse, PredR, RHS0, RHS1, RHSOneUse, IsAnd);
}

fn InstCombinerImpl::foldBooleanAndOr(self, LHS: *mut Value, RHS: *mut Value, I: *mut Instruction, IsAnd: bool, IsLogical: bool) -> *mut Value {
    if !LHS.getType().isIntOrIntVectorTy(1) {
        return null;
    }
    if foldLogOpOfMaskedICmps(LHS, RHS, IsAnd, IsLogical, self.Builder, self.SQ.getWithInstruction(&mut I)) {
        V;
    } else {
        return V;
    }
    if self.foldAndOrOfICmps(LHS, RHS, I, IsAnd, IsLogical) {
        Res;
    } else {
        return Res;
    }
    if dyn_cast(LHS) {
        LHSCmp;
    } else if dyn_cast(RHS) {
        RHSCmp;
    } else if self.foldLogicOfFCmps(LHSCmp, RHSCmp, IsAnd, IsLogical) {
        Res;
    } else {
        return Res;
    }
    if self.foldEqOfParts(LHS, RHS, IsAnd) {
        Res;
    } else {
        return Res;
    }
    return null;
}

fn foldOrOfInversions(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Value {
    assert!(I.getOpcode() == Or, "Simplification only supports or at the moment.");
    let mut Cmp1: *mut Value = null;
    let mut Cmp2: *mut Value = null;
    let mut Cmp3: *mut Value = null;
    let mut Cmp4: *mut Value = null;
    if !match(I.getOperand(0), m_And(m_Value(Cmp1), m_Value(Cmp2))) || !match(I.getOperand(1), m_And(m_Value(Cmp3), m_Value(Cmp4))) {
        return null;
    }
    if isKnownInversion(Cmp1, Cmp3) && isKnownInversion(Cmp2, Cmp4) {
        return Builder.CreateXor(Cmp1, Cmp4, "");
    }
    if isKnownInversion(Cmp1, Cmp4) && isKnownInversion(Cmp2, Cmp3) {
        return Builder.CreateXor(Cmp1, Cmp3, "");
    }
    return null;
}

fn matchSubIntegerPackFromVector(V: *mut Value, Vec: *mut *mut Value, VecOffset: *mut i64, Mask: *mut SmallBitVector, DL: *DataLayout) -> bool {
    let mut VecIdx: u64 = 0;
    let mut ShlAmt: u64 = 0;
    if match(V, m_ShlOrSelf(m_ZExtOrSelf(m_ExtractElt(m_Value(Vec), m_ConstantInt(VecIdx))), ShlAmt)) {
        let mut VecTy: *mut FixedVectorType = dyn_cast(Vec.getType());
        if !VecTy {
            return false;
        }
        let mut EltTy: *mut IntegerType = dyn_cast(VecTy.getElementType());
        if !EltTy {
            return false;
        }
        let mut EltBitWidth: u32 = EltTy.getBitWidth();
        let mut TargetBitWidth: u32 = V.getType().getIntegerBitWidth();
        if TargetBitWidth % EltBitWidth != 0 || ShlAmt % EltBitWidth != 0 {
            return false;
        }
        let mut TargetEltWidth: u32 = TargetBitWidth / EltBitWidth;
        let mut ShlEltAmt: u32 = ShlAmt / EltBitWidth;
        let mut MaskIdx: u32 = if DL.isLittleEndian() { ShlEltAmt } else { TargetEltWidth - ShlEltAmt - 1 };
        VecOffset = VecIdx as i64 - MaskIdx as i64;
        Mask.resize(TargetEltWidth, false);
        Mask.set(MaskIdx);
        return true;
    }
    let mut SrcVecI: *mut Instruction = null;
    if !match(V, m_BitCast(m_Instruction(SrcVecI))) {
        return false;
    }
    let mut SrcTy: *mut FixedVectorType = dyn_cast(SrcVecI.getType());
    if !SrcTy {
        return false;
    }
    Mask.resize(SrcTy.getNumElements(), false);
    if isa(SrcVecI) {
        let mut ConstVec: *mut Constant = null;
        let mut ShuffleMask: ArrayRef<int> = ArrayRef<int> {};
        if !match(SrcVecI, m_Shuffle(m_Value(Vec), m_Constant(ConstVec), ShuffleMask)) {
            return false;
        }
        let mut VecTy: *mut FixedVectorType = dyn_cast(Vec.getType());
        if !VecTy {
            return false;
        }
        let mut NumVecElts: u32 = VecTy.getNumElements();
        let mut FoundVecOffset: bool = false;
        for let mut Idx: u32 = 0; Idx < ShuffleMask.len; Idx += 1 {
            if ShuffleMask[Idx] == PoisonMaskElem {
                return false;
            }
            let mut ShuffleIdx: u32 = ShuffleMask[Idx];
            if ShuffleIdx >= NumVecElts {
                let mut ConstIdx: u32 = ShuffleIdx - NumVecElts;
                let mut ConstElt: *mut ConstantInt = dyn_cast(ConstVec.getAggregateElement(ConstIdx));
                if !ConstElt || !ConstElt.isNullValue() {
                    return false;
                }
                continue;
            }
            if FoundVecOffset {
                if VecOffset + Idx != ShuffleIdx {
                    return false;
                }
            } else {
                if ShuffleIdx < Idx {
                    return false;
                }
                VecOffset = ShuffleIdx - Idx;
                FoundVecOffset = true;
            }
            Mask.set(Idx);
        }
        return FoundVecOffset;
    }
    let mut InsertIdx: u64 = 0;
    if !match(SrcVecI, m_InsertElt(m_Value(Vec), m_Zero(), m_ConstantInt(InsertIdx))) {
        return false;
    }
    let mut VecTy: *mut FixedVectorType = dyn_cast(Vec.getType());
    if !VecTy {
        return false;
    }
    VecOffset = 0;
    let mut AlreadyInsertedMaskedElt: bool = Mask.test(InsertIdx);
    Mask.set();
    if !AlreadyInsertedMaskedElt {
        Mask.reset(InsertIdx);
    }
    return true;
}

fn foldIntegerPackFromVector(I: *mut Instruction, Builder: *mut BuilderTy, DL: *DataLayout) -> *mut Instruction {
    assert!(I.getOpcode() == Or);
    let mut LhsVec: *mut Value = null;
    let mut RhsVec: *mut Value = null;
    let mut LhsVecOffset: i64 = 0;
    let mut RhsVecOffset: i64 = 0;
    let mut Mask: SmallBitVector = SmallBitVector {};
    if !matchSubIntegerPackFromVector(I.getOperand(0), LhsVec, LhsVecOffset, Mask, DL) {
        return null;
    }
    if !matchSubIntegerPackFromVector(I.getOperand(1), RhsVec, RhsVecOffset, Mask, DL) {
        return null;
    }
    if LhsVec != RhsVec || LhsVecOffset != RhsVecOffset {
        return null;
    }
    let mut ZeroVecIdx: u32 = cast(LhsVec.getType()).getNumElements();
    let mut ShuffleMask: SmallVector<int> = SmallVector<int> { Mask.len, ZeroVecIdx };
    for Idx in Mask.set_bits() {
        assert!(LhsVecOffset + Idx >= 0);
        ShuffleMask[Idx] = LhsVecOffset + Idx;
    }
    let mut MaskedVec: *mut Value = Builder.CreateShuffleVector(LhsVec, getNullValue(LhsVec.getType()), ShuffleMask, I.getName() + ".v");
    return Create(BitCast, MaskedVec, I.getType(), "", null);
}

fn matchZExtedSubInteger(V: *mut Value, Int: *mut *mut Value, Mask: *mut APInt, Offset: *mut u64, IsShlNUW: *mut bool, IsShlNSW: *mut bool) -> bool {
    let mut ShlOp0: *mut Value = null;
    let mut ShlAmt: u64 = 0;
    if !match(V, m_OneUse(m_Shl(m_Value(ShlOp0), m_ConstantInt(ShlAmt)))) {
        return false;
    }
    IsShlNUW = cast(V).hasNoUnsignedWrap();
    IsShlNSW = cast(V).hasNoSignedWrap();
    let mut ZExtOp0: *mut Value = null;
    if !match(ShlOp0, m_OneUse(m_ZExt(m_Value(ZExtOp0)))) {
        return false;
    }
    let mut MaskedOp0: *mut Value = null;
    let mut ShiftedMaskConst: *APInt = null;
    if !match(ZExtOp0, m_CombineOr(m_OneUse(m_And(m_Value(MaskedOp0), m_APInt(ShiftedMaskConst))), m_Value(MaskedOp0))) {
        return false;
    }
    let mut LShrAmt: u64 = 0;
    if !match(MaskedOp0, m_CombineOr(m_OneUse(m_LShr(m_Value(Int), m_ConstantInt(LShrAmt))), m_Value(Int))) {
        return false;
    }
    if LShrAmt > ShlAmt {
        return false;
    }
    Offset = ShlAmt - LShrAmt;
    Mask = if ShiftedMaskConst { ShiftedMaskConst.shl(LShrAmt) } else { getBitsSetFrom(Int.getType().getScalarSizeInBits(), LShrAmt) };
    return true;
}

fn foldIntegerRepackThroughZExt(Lhs: *mut Value, Rhs: *mut Value, Builder: *mut BuilderTy) -> *mut Value {
    let mut LhsInt: *mut Value = null;
    let mut RhsInt: *mut Value = null;
    let mut LhsMask: APInt = APInt {};
    let mut RhsMask: APInt = APInt {};
    let mut LhsOffset: u64 = 0;
    let mut RhsOffset: u64 = 0;
    let mut IsLhsShlNUW: bool = false;
    let mut IsLhsShlNSW: bool = false;
    let mut IsRhsShlNUW: bool = false;
    let mut IsRhsShlNSW: bool = false;
    if !matchZExtedSubInteger(Lhs, LhsInt, LhsMask, LhsOffset, IsLhsShlNUW, IsLhsShlNSW) {
        return null;
    }
    if !matchZExtedSubInteger(Rhs, RhsInt, RhsMask, RhsOffset, IsRhsShlNUW, IsRhsShlNSW) {
        return null;
    }
    if LhsInt != RhsInt || LhsOffset != RhsOffset {
        return null;
    }
    let mut Mask: APInt = LhsMask | RhsMask;
    let mut DestTy: *mut Type = Lhs.getType();
    let mut Res: *mut Value = Builder.CreateShl(Builder.CreateZExt(Builder.CreateAnd(LhsInt, Mask, LhsInt.getName() + ".mask"), DestTy, LhsInt.getName() + ".zext", false), get(DestTy, LhsOffset, false, false), "", IsLhsShlNUW && IsRhsShlNUW, IsLhsShlNSW && IsRhsShlNSW);
    Res.takeName(Lhs);
    return Res;
}

struct DecomposedBitMaskMul {
    X: *mut Value,
    Factor: APInt,
    Mask: APInt,
    NUW: bool,
    NSW: bool,
}

fn DecomposedBitMaskMul::isCombineableWith(self, Other: DecomposedBitMaskMul) -> bool {
    return self.X == Other.X && !self.Mask.intersects(Other.Mask) && self.Factor == Other.Factor;
}

fn matchBitmaskMul(V: *mut Value) -> optional<DecomposedBitMaskMul> {
    let mut Op: *mut Instruction = dyn_cast(V);
    if !Op {
        return nullopt;
    }
    let mut Original: *mut Value = null;
    let mut Mask: *APInt = null;
    let mut MulConst: *APInt = null;
    if match(Op, m_Mul(m_And(m_Value(Original), m_APInt(Mask)), m_APInt(MulConst))) {
        if MulConst.isZero() || Mask.isZero() {
            return nullopt;
        }
        return DecomposedBitMaskMul { X: Original, Factor: *MulConst, Mask: *Mask, NUW: cast(Op).hasNoUnsignedWrap(), NSW: cast(Op).hasNoSignedWrap() };
    }
    let mut Cond: *mut Value = null;
    let mut EqZero: *APInt = null;
    let mut NeZero: *APInt = null;
    if match(Op, m_Select(m_Value(Cond), m_APInt(EqZero), m_APInt(NeZero))) {
        let mut ICmpDecompose: optional<DecomposedBitTest> = decomposeBitTest(Cond, true, false, true);
        if !ICmpDecompose.has_value() {
            return nullopt;
        }
        if operator(ICmpDecompose).X.getType() != V.getType() {
            return nullopt;
        }
        assert!(isEquality(operator(ICmpDecompose).Pred) && operator(ICmpDecompose).C.isZero();
        if operator(ICmpDecompose).Pred == ICMP_NE {
            swap(EqZero, NeZero);
        }
        if !EqZero.isZero() || NeZero.isZero() {
            return nullopt;
        }
        if !operator(ICmpDecompose).Mask.isPowerOf2() || operator(ICmpDecompose).Mask.isZero() {
            return nullopt;
        }
        if !NeZero.urem(operator(ICmpDecompose).Mask).isZero() {
            return nullopt;
        }
        return DecomposedBitMaskMul { X: operator(ICmpDecompose).X, Factor: NeZero.udiv(operator(ICmpDecompose).Mask), Mask: operator(ICmpDecompose).Mask, NUW: false, NSW: false };
    }
    return nullopt;
}

fn foldBitmaskMul(Op0: *mut Value, Op1: *mut Value, Builder: *mut BuilderTy) -> *mut Value {
    let mut Decomp1: optional<DecomposedBitMaskMul> = matchBitmaskMul(Op1);
    if !Decomp1 {
        return null;
    }
    let mut Decomp0: optional<DecomposedBitMaskMul> = matchBitmaskMul(Op0);
    if !Decomp0 {
        return null;
    }
    if operator(Decomp0).isCombineableWith(operator(Decomp1)) {
        let mut NewAnd: *mut Value = Builder.CreateAnd(operator(Decomp0).X, get(operator(Decomp0).X.getType(), operator(Decomp0).Mask + operator(Decomp1).Mask), "");
        return Builder.CreateMul(NewAnd, get(NewAnd.getType(), operator(Decomp1).Factor), "", operator(Decomp0).NUW && operator(Decomp1).NUW, operator(Decomp0).NSW && operator(Decomp1).NSW);
    }
    return null;
}

fn InstCombinerImpl::foldDisjointOr(self, LHS: *mut Value, RHS: *mut Value) -> *mut Value {
    if foldBitmaskMul(LHS, RHS, self.Builder) {
        Res;
    } else {
        return Res;
    }
    if foldIntegerRepackThroughZExt(LHS, RHS, self.Builder) {
        Res;
    } else {
        return Res;
    }
    return null;
}

fn InstCombinerImpl::reassociateDisjointOr(self, LHS: *mut Value, RHS: *mut Value) -> *mut Value {
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(RHS, m_OneUse(m_DisjointOr(m_Value(X), m_Value(Y)))) {
        if self.foldDisjointOr(LHS, X) {
            Res;
        } else {
            return self.Builder.CreateDisjointOr(Res, Y, "");
        }
        if self.foldDisjointOr(LHS, Y) {
            Res;
        } else {
            return self.Builder.CreateDisjointOr(Res, X, "");
        }
    }
    if match(LHS, m_OneUse(m_DisjointOr(m_Value(X), m_Value(Y)))) {
        if self.foldDisjointOr(X, RHS) {
            Res;
        } else {
            return self.Builder.CreateDisjointOr(Res, Y, "");
        }
        if self.foldDisjointOr(Y, RHS) {
            Res;
        } else {
            return self.Builder.CreateDisjointOr(Res, X, "");
        }
    }
    return null;
}

fn foldOrUnsignedUMulOverflowICmp(I: *mut BinaryOperator, Builder: *mut BuilderTy, DL: *DataLayout) -> *mut Value {
    let mut WOV: *mut Value = null;
    let mut X: *mut Value = null;
    let mut C1: *APInt = null;
    let mut C2: *APInt = null;
    if match(&mut I, m_c_Or(m_ExtractValue(m_Value(WOV, m_Intrinsic(m_Value(X), m_APInt(C1)))), m_OneUse(m_SpecificCmp(CmpPredicate { Pred: ICMP_UGT, HasSameSign: false }, m_ExtractValue(m_Deferred(WOV)), m_APInt(C2))))) && !C1.isZero() {
        let mut NewC: *mut Constant = get(X.getType(), C2.udiv(*C1));
        return Builder.CreateICmp(ICMP_UGT, X, NewC, "");
    }
    return null;
}

fn FoldOrOfSelectSmaxToAbs(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Value {
    let mut X: *mut Value = null;
    let mut Sel: *mut Value = null;
    if match(&mut I, m_c_Or(m_Value(Sel), m_OneUse(m_SMax(m_Value(X), m_ZeroInt())))) {
        let mut NegX: Sub> = m_Neg(m_Specific(X));
        if match(Sel, m_Select(m_SpecificICmp(CmpPredicate { Pred: ICMP_SGT, HasSameSign: false }, m_Specific(X), m_ZeroInt()), m_ZeroInt(), NegX)) || match(Sel, m_Select(m_SpecificICmp(CmpPredicate { Pred: ICMP_SLT, HasSameSign: false }, m_Specific(X), m_ZeroInt()), NegX, m_ZeroInt())) {
            return Builder.CreateBinaryIntrinsic(abs, X, Builder.getFalse(), FMFSource {}, "");
        }
    }
    return null;
}

fn InstCombinerImpl::FoldOrOfLogicalAnds(self, Op0: *mut Value, Op1: *mut Value) -> *mut Instruction {
    let mut C: *mut Value = null;
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    if match(Op1, m_c_LogicalAnd(m_Not(m_Value(C)), m_Value(B))) && match(Op0, m_c_LogicalAnd(m_Specific(C), m_Value(A))) {
        let mut SelOp0: *mut SelectInst = dyn_cast(Op0);
        let mut SelOp1: *mut SelectInst = dyn_cast(Op1);
        let mut MayNeedFreeze: bool = SelOp0 && SelOp1 && match(SelOp1.getTrueValue(), m_Not(m_Specific(SelOp0.getTrueValue())));
        if MayNeedFreeze {
            C = self.Builder.CreateFreeze(C, "");
        }
        if !ProfcheckDisableMetadataFixes {
            let mut C2: *mut Value = null;
            let mut A2: *mut Value = null;
            let mut B2: *mut Value = null;
            if match(Op0, m_LogicalAnd(m_Specific(C), m_Value(A2))) && SelOp0 {
                return Create(C, A, B, "", null, SelOp0);
            } else if match(Op1, m_LogicalAnd(m_Not(m_Value(C2)), m_Value(B2))) && SelOp1 {
                let mut NewSI: *mut SelectInst = Create(C, A, B, "", null, SelOp1);
                NewSI.swapProfMetadata();
                return NewSI;
            } else {
                return self.createSelectInstWithUnknownProfile(C, A, B, "", null);
            }
        }
        return Create(C, A, B, "", null, null);
    }
    if match(Op0, m_c_LogicalAnd(m_Not(m_Value(C)), m_Value(A))) && match(Op1, m_c_LogicalAnd(m_Specific(C), m_Value(B))) {
        let mut SelOp0: *mut SelectInst = dyn_cast(Op0);
        let mut SelOp1: *mut SelectInst = dyn_cast(Op1);
        let mut MayNeedFreeze: bool = SelOp0 && SelOp1 && match(SelOp0.getTrueValue(), m_Not(m_Specific(SelOp1.getTrueValue())));
        if MayNeedFreeze {
            C = self.Builder.CreateFreeze(C, "");
        }
        if !ProfcheckDisableMetadataFixes {
            let mut C2: *mut Value = null;
            let mut A2: *mut Value = null;
            let mut B2: *mut Value = null;
            if match(Op0, m_LogicalAnd(m_Not(m_Value(C2)), m_Value(A2))) && SelOp0 {
                let mut NewSI: *mut SelectInst = Create(C, B, A, "", null, SelOp0);
                NewSI.swapProfMetadata();
                return NewSI;
            } else if match(Op1, m_LogicalAnd(m_Specific(C), m_Value(B2))) && SelOp1 {
                return Create(C, B, A, "", null, SelOp1);
            } else {
                return self.createSelectInstWithUnknownProfile(C, B, A, "", null);
            }
        }
        return Create(C, B, A, "", null, null);
    }
    return null;
}

fn InstCombinerImpl::visitOr(self, I: *mut BinaryOperator) -> *mut Instruction {
    if simplifyOrInst(I.getOperand(0), I.getOperand(1), self.SQ.getWithInstruction(&mut I)) {
        V;
    } else {
        return self.replaceInstUsesWith(I, V);
    }
    if self.SimplifyAssociativeOrCommutative(I) {
        return &mut I;
    }
    if self.foldVectorBinop(I) {
        X;
    } else {
        return X;
    }
    if self.foldBinopWithPhiOperands(I) {
        Phi;
    } else {
        return Phi;
    }
    if self.SimplifyDemandedInstructionBits(I) {
        return &mut I;
    }
    if foldOrToXor(I, self.Builder) {
        Xor;
    } else {
        return Xor;
    }
    if foldComplexAndOrPatterns(I, self.Builder) {
        X;
    } else {
        return X;
    }
    if foldIntegerPackFromVector(I, self.Builder, self.DL) {
        X;
    } else {
        return X;
    }
    if foldOrOfInversions(I, self.Builder) {
        V;
    } else {
        return self.replaceInstUsesWith(I, V);
    }
    if self.foldUsingDistributiveLaws(I) {
        V;
    } else {
        return self.replaceInstUsesWith(I, V);
    }
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut Ty: *mut Type = I.getType();
    if Ty.isIntOrIntVectorTy(1) {
        if dyn_cast(Op0) {
            SI0;
        } else {
            if self.foldAndOrOfSelectUsingImpliedCond(Op1, *SI0, false) {
                R;
            } else {
                return R;
            }
        }
        if dyn_cast(Op1) {
            SI1;
        } else {
            if self.foldAndOrOfSelectUsingImpliedCond(Op0, *SI1, false) {
                R;
            } else {
                return R;
            }
        }
    }
    if self.foldBinOpIntoSelectOrPhi(I) {
        FoldedLogic;
    } else {
        return FoldedLogic;
    }
    if self.foldBinOpSelectBinOp(I) {
        FoldedLogic;
    } else {
        return FoldedLogic;
    }
    if self.matchBSwapOrBitReverse(I, true, true) {
        BitOp;
    } else {
        return BitOp;
    }
    if matchFunnelShift(I, *self) {
        Funnel;
    } else {
        return Funnel;
    }
    if matchOrConcat(I, self.Builder) {
        Concat;
    } else {
        return self.replaceInstUsesWith(I, Concat);
    }
    if self.foldBinOpShiftWithShift(I) {
        R;
    } else {
        return R;
    }
    if self.tryFoldInstWithCtpopWithNot(&mut I) {
        R;
    } else {
        return R;
    }
    if cast(I).isDisjoint() {
        if self.foldAddLikeCommutative(I.getOperand(0), I.getOperand(1), true, true) {
            R;
        } else {
            return R;
        }
        if self.foldAddLikeCommutative(I.getOperand(1), I.getOperand(0), true, true) {
            R;
        } else {
            return R;
        }
        if self.foldDisjointOr(I.getOperand(0), I.getOperand(1)) {
            Res;
        } else {
            return self.replaceInstUsesWith(I, Res);
        }
        if self.reassociateDisjointOr(I.getOperand(0), I.getOperand(1)) {
            Res;
        } else {
            return self.replaceInstUsesWith(I, Res);
        }
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut CV: *APInt = null;
    if match(&mut I, m_c_Or(m_OneUse(m_Xor(m_Value(X), m_APInt(CV))), m_Value(Y))) && !CV.isAllOnes() && self.MaskedValueIsZero(Y, *CV, &mut I, 0) {
        let mut Or: *mut Value = self.Builder.CreateOr(X, Y, "", false);
        return CreateXor(Or, get(Ty, *CV), "");
    }
    if match(&mut I, m_c_DisjointOr(m_OneUse(m_Mul(m_Value(X), m_Value(Y))), m_Deferred(X))) {
        let mut IncrementY: *mut Value = self.Builder.CreateAdd(Y, get(Ty, 1, false, false), "", false, false);
        return CreateMul(X, IncrementY, "");
    }
    let mut Op: *mut Value = null;
    if match(&mut I, m_c_Or(m_OneUse(m_Not(m_Value(Op))), m_OneUse(m_Add(m_Deferred(Op), m_AllOnes())))) {
        let mut NegX: *mut Value = self.Builder.CreateNeg(Op, "", false);
        let mut And: *mut Value = self.Builder.CreateAnd(Op, NegX, "");
        return CreateNot(And, "", null);
    }
    if I.getType().isIntOrIntVectorTy(1) && (Op0.hasOneUse() || Op1.hasOneUse()) {
        if self.FoldOrOfLogicalAnds(Op0, Op1) {
            V;
        } else {
            return V;
        }
    }
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut C: *mut Value = null;
    let mut D: *mut Value = null;
    if match(Op0, m_And(m_Value(A), m_Value(C))) && match(Op1, m_And(m_Value(B), m_Value(D))) {
        let mut C0: *APInt = null;
        let mut C1: *APInt = null;
        if match(C, m_APInt(C0)) && match(D, m_APInt(C1)) {
            let mut X: *mut Value = null;
            if *C0 == operator(*C1) {
                if match(A, m_c_Or(m_Value(X), m_Specific(B))) {
                    return CreateOr(self.Builder.CreateAnd(X, *C0, ""), B, "");
                }
                if match(B, m_c_Or(m_Specific(A), m_Value(X))) {
                    return CreateOr(self.Builder.CreateAnd(X, *C1, ""), A, "");
                }
                if match(A, m_c_Xor(m_Value(X), m_Specific(B))) {
                    return CreateXor(self.Builder.CreateAnd(X, *C0, ""), B, "");
                }
                if match(B, m_c_Xor(m_Specific(A), m_Value(X))) {
                    return CreateXor(self.Builder.CreateAnd(X, *C1, ""), A, "");
                }
            }
            if (*C0 & *C1).isZero() {
                if match(A, m_c_Or(m_Value(X), m_Specific(B))) && self.MaskedValueIsZero(X, operator(*C0), &mut I, 0) {
                    let mut C01: *mut Constant = get(Ty, *C0 | *C1);
                    return CreateAnd(A, C01, "");
                }
                if match(B, m_c_Or(m_Value(X), m_Specific(A))) && self.MaskedValueIsZero(X, operator(*C1), &mut I, 0) {
                    let mut C01: *mut Constant = get(Ty, *C0 | *C1);
                    return CreateAnd(B, C01, "");
                }
                let mut C2: *APInt = null;
                let mut C3: *APInt = null;
                if match(A, m_Or(m_Value(X), m_APInt(C2))) && match(B, m_Or(m_Specific(X), m_APInt(C3))) && (*C2 & operator(*C0)).isZero() && (*C3 & operator(*C1)).isZero() {
                    let mut Or: *mut Value = self.Builder.CreateOr(X, *C2 | *C3, "bitfield");
                    let mut C01: *mut Constant = get(Ty, *C0 | *C1);
                    return CreateAnd(Or, C01, "");
                }
            }
            let mut ShiftAmt: *APInt = null;
            if match(A, m_Trunc(m_LShr(m_Value(X), m_APInt(ShiftAmt)))) && match(B, m_LShr(m_Trunc(m_Specific(X)), m_SpecificInt(*ShiftAmt))) && ShiftAmt.ult(A.getType().getScalarSizeInBits()) && C1.isIntN(A.getType().getScalarSizeInBits() - ShiftAmt.getZExtValue()) {
                return CreateAnd(A, get(I.getType(), *C0 | *C1), "");
            }
            if match(B, m_Trunc(m_LShr(m_Value(X), m_APInt(ShiftAmt)))) && match(A, m_LShr(m_Trunc(m_Specific(X)), m_SpecificInt(*ShiftAmt))) && ShiftAmt.ult(A.getType().getScalarSizeInBits()) && C0.isIntN(A.getType().getScalarSizeInBits() - ShiftAmt.getZExtValue()) {
                return CreateAnd(B, get(I.getType(), *C0 | *C1), "");
            }
        }
        if Op0.hasOneUse() || Op1.hasOneUse() {
            if self.matchSelectFromAndOr(A, C, B, D, false) {
                V;
            } else {
                return self.replaceInstUsesWith(I, V);
            }
            if self.matchSelectFromAndOr(A, C, D, B, false) {
                V;
            } else {
                return self.replaceInstUsesWith(I, V);
            }
            if self.matchSelectFromAndOr(C, A, B, D, false) {
                V;
            } else {
                return self.replaceInstUsesWith(I, V);
            }
            if self.matchSelectFromAndOr(C, A, D, B, false) {
                V;
            } else {
                return self.replaceInstUsesWith(I, V);
            }
            if self.matchSelectFromAndOr(B, D, A, C, false) {
                V;
            } else {
                return self.replaceInstUsesWith(I, V);
            }
            if self.matchSelectFromAndOr(B, D, C, A, false) {
                V;
            } else {
                return self.replaceInstUsesWith(I, V);
            }
            if self.matchSelectFromAndOr(D, B, A, C, false) {
                V;
            } else {
                return self.replaceInstUsesWith(I, V);
            }
            if self.matchSelectFromAndOr(D, B, C, A, false) {
                V;
            } else {
                return self.replaceInstUsesWith(I, V);
            }
        }
    }
    if match(Op0, m_And(m_Value(A), m_Value(C))) && match(Op1, m_Not(m_Or(m_Value(B), m_Value(D)))) && (Op0.hasOneUse() || Op1.hasOneUse()) {
        if self.matchSelectFromAndOr(A, C, B, D, true) {
            V;
        } else {
            return self.replaceInstUsesWith(I, V);
        }
        if self.matchSelectFromAndOr(A, C, D, B, true) {
            V;
        } else {
            return self.replaceInstUsesWith(I, V);
        }
        if self.matchSelectFromAndOr(C, A, B, D, true) {
            V;
        } else {
            return self.replaceInstUsesWith(I, V);
        }
        if self.matchSelectFromAndOr(C, A, D, B, true) {
            V;
        } else {
            return self.replaceInstUsesWith(I, V);
        }
    }
    if match(Op0, m_Xor(m_Value(A), m_Value(B))) {
        if match(Op1, m_c_Xor(m_c_Xor(m_Specific(B), m_Value(C)), m_Specific(A))) || match(Op1, m_c_Xor(m_c_Xor(m_Specific(A), m_Value(C)), m_Specific(B))) {
            return CreateOr(Op0, C, "");
        }
    }
    if match(Op1, m_Xor(m_Value(A), m_Value(B))) {
        if match(Op0, m_c_Xor(m_c_Xor(m_Specific(B), m_Value(C)), m_Specific(A))) || match(Op0, m_c_Xor(m_c_Xor(m_Specific(A), m_Value(C)), m_Specific(B))) {
            return CreateOr(Op1, C, "");
        }
    }
    if matchDeMorgansLaws(I, *self) {
        DeMorgan;
    } else {
        return DeMorgan;
    }
    let mut SwappedForXor: bool = false;
    if match(Op0, m_Xor(m_Value(), m_Value())) {
        swap(Op0, Op1);
        SwappedForXor = true;
    }
    if match(Op1, m_Xor(m_Value(A), m_Value(B))) {
        if match(Op0, m_c_Or(m_Specific(A), m_Value())) {
            return CreateOr(Op0, B, "");
        }
        if match(Op0, m_c_Or(m_Specific(B), m_Value())) {
            return CreateOr(Op0, A, "");
        }
        if match(Op0, m_c_And(m_Specific(A), m_Specific(B))) {
            return CreateOr(A, B, "");
        }
        if (Op0.hasOneUse() || Op1.hasOneUse()) && (match(Op0, m_Not(m_Specific(A))) || match(Op0, m_Not(m_Specific(B)))) {
            return CreateNot(self.Builder.CreateAnd(A, B, ""), "", null);
        }
        let mut And: *mut Instruction = null;
        if (Op0.hasOneUse() || Op1.hasOneUse()) && match(Op0, m_Not(m_Instruction(And, m_c_And(m_Specific(A), m_Value())))) {
            return CreateNot(self.Builder.CreateAnd(And, B, ""), "", null);
        }
        if (Op0.hasOneUse() || Op1.hasOneUse()) && match(Op0, m_Not(m_Instruction(And, m_c_And(m_Specific(B), m_Value())))) {
            return CreateNot(self.Builder.CreateAnd(And, A, ""), "", null);
        }
        if Op0.hasOneUse() && Op1.hasOneUse() && (match(Op0, m_c_Or(m_Not(m_Specific(A)), m_Value(C))) || match(Op0, m_c_Or(m_Not(m_Specific(B)), m_Value(C)))) {
            let mut Nand: *mut Value = self.Builder.CreateNot(self.Builder.CreateAnd(A, B, ""), "nand");
            return CreateOr(Nand, C, "");
        }
    }
    if SwappedForXor {
        swap(Op0, Op1);
    }
    if self.foldBooleanAndOr(Op0, Op1, I, false, false) {
        Res;
    } else {
        return self.replaceInstUsesWith(I, Res);
    }
    if match(Op1, m_OneUse(m_LogicalOr(m_Value(X), m_Value(Y)))) {
        let mut IsLogical: bool = isa(Op1);
        if self.reassociateBooleanAndOr(Op0, X, Y, I, false, IsLogical) {
            V;
        } else {
            return self.replaceInstUsesWith(I, V);
        }
    }
    if match(Op0, m_OneUse(m_LogicalOr(m_Value(X), m_Value(Y)))) {
        let mut IsLogical: bool = isa(Op0);
        if self.reassociateBooleanAndOr(Op1, X, Y, I, false, IsLogical) {
            V;
        } else {
            return self.replaceInstUsesWith(I, V);
        }
    }
    if reassociateFCmps(I, self.Builder) {
        FoldedFCmps;
    } else {
        return FoldedFCmps;
    }
    if self.foldCastedBitwiseLogic(I) {
        CastedOr;
    } else {
        return CastedOr;
    }
    if self.foldBinopOfSextBoolToSelect(I) {
        Sel;
    } else {
        return Sel;
    }
    if match(&mut I, m_c_Or(m_OneUse(m_SExt(m_Value(A))), m_Value(B))) && A.getType().isIntOrIntVectorTy(1) {
        return self.createSelectInstWithUnknownProfile(A, getAllOnesValue(Ty), B, "", null);
    }
    let mut CI: *mut ConstantInt = null;
    if Op0.hasOneUse() && !match(Op1, m_ConstantInt()) && match(Op0, m_Or(m_Value(A), m_ConstantInt(CI))) {
        let mut IsDisjointOuter: bool = cast(I).isDisjoint();
        let mut IsDisjointInner: bool = cast(Op0).isDisjoint();
        let mut Inner: *mut Value = self.Builder.CreateOr(A, Op1, "", IsDisjointOuter);
        Inner.takeName(Op0);
        return if IsDisjointOuter && IsDisjointInner { CreateDisjointOr(Inner, CI, "") } else { CreateOr(Inner, CI, "") };
    }
    {
        let mut X: *mut Value = null;
        let mut Y: *mut Value = null;
        if Op0.hasOneUse() && Op1.hasOneUse() && match(Op0, m_Select(m_Value(X), m_Value(A), m_Value(B))) && match(Op1, m_Select(m_Value(Y), m_Value(C), m_Value(D))) && X == Y {
            let mut orTrue: *mut Value = self.Builder.CreateOr(A, C, "", false);
            let mut orFalse: *mut Value = self.Builder.CreateOr(B, D, "", false);
            return Create(X, orTrue, orFalse, "", null, null);
        }
    }
    {
        let mut X: *mut Value = null;
        let mut Y: *mut Value = null;
        if match(&mut I, m_c_Or(m_OneUse(m_AShr(m_NSWSub(m_Value(Y), m_Value(X)), m_SpecificInt(Ty.getScalarSizeInBits() - 1))), m_Deferred(X))) {
            let mut NewICmpInst: *mut Value = self.Builder.CreateICmpSGT(X, Y, "");
            let mut AllOnes: *mut Value = getAllOnesValue(Ty);
            return self.createSelectInstWithUnknownProfile(NewICmpInst, AllOnes, X, "", null);
        }
    }
    {
        let mut TryXorOpt: Closure_20 = Closure_20 { A: &mut A, B: &mut B };
        if TryXorOpt.call(Op0, Op1) {
            Result;
        } else {
            return Result;
        }
        if TryXorOpt.call(Op1, Op0) {
            Result;
        } else {
            return Result;
        }
    }
    if self.canonicalizeCondSignextOfHighBitExtractToSignextHighBitExtract(I) {
        V;
    } else {
        return V;
    }
    let mut Pred: CmpPredicate = CmpPredicate {};
    let mut Mul: *mut Value = null;
    let mut Ov: *mut Value = null;
    let mut MulIsNotZero: *mut Value = null;
    let mut UMulWithOv: *mut Value = null;
    if match(&mut I, m_c_Or(m_Value(Ov, m_ExtractValue(m_Value(UMulWithOv))), m_Value(MulIsNotZero, m_SpecificICmp(CmpPredicate { Pred: ICMP_NE, HasSameSign: false }, m_Value(Mul, m_ExtractValue(m_Deferred(UMulWithOv))), m_ZeroInt())))) && (Ov.hasOneUse() || (MulIsNotZero.hasOneUse() && Mul.hasOneUse())) {
        let mut A: *mut Value = null;
        let mut B: *mut Value = null;
        if match(UMulWithOv, m_Intrinsic(m_Value(A), m_Value(B))) {
            let mut NotNullA: *mut Value = self.Builder.CreateIsNotNull(A, "");
            let mut NotNullB: *mut Value = self.Builder.CreateIsNotNull(B, "");
            return CreateAnd(NotNullA, NotNullB, "");
        }
    }
    let mut WO: *WithOverflowInst = ;
    let mut WOV: *Value = null;
    let mut C1: *APInt = null;
    let mut C2: *APInt = null;
    if match(&mut I, m_c_Or(m_Value(Ov, m_ExtractValue(m_Value(WOV, m_WithOverflowInst(WO)))), m_OneUse(m_ICmp(Pred, m_ExtractValue(m_Deferred(WOV)), m_APInt(C2))))) && (WO.getBinaryOp() == Add || WO.getBinaryOp() == Sub) && (isEquality(Pred.operator llvm::CmpInst::Predicate()) || WO.isSigned() == isSigned(Pred.operator llvm::CmpInst::Predicate())) && match(WO.getRHS(), m_APInt(C1)) {
        let mut Overflow: bool = false;
        let mut NewC: APInt = if WO.getBinaryOp() == Add { (if isSigned(Pred.operator llvm::CmpInst::Predicate()) { C2.ssub_ov(*C1, Overflow) } else { C2.usub_ov(*C1, Overflow) }) } else { (if isSigned(Pred.operator llvm::CmpInst::Predicate()) { C2.sadd_ov(*C1, Overflow) } else { C2.uadd_ov(*C1, Overflow) }) };
        if !Overflow || isEquality(Pred.operator llvm::CmpInst::Predicate()) {
            let mut NewCmp: *mut Value = self.Builder.CreateICmp(Pred.operator llvm::CmpInst::Predicate(), WO.getLHS(), get(WO.getLHS().getType(), NewC), "");
            return CreateOr(Ov, NewCmp, "");
        }
    }
    if foldOrUnsignedUMulOverflowICmp(I, self.Builder, self.DL) {
        R;
    } else {
        return self.replaceInstUsesWith(I, R);
    }
    if self.sinkNotIntoOtherHandOfLogicalOp(I) {
        return &mut I;
    }
    if match(&mut I, m_c_Or(m_Add(m_Shl(m_One(), m_Value(X)), m_AllOnes()), m_Shl(m_One(), m_Deferred(X)))) && match(&mut I, m_c_Or(m_OneUse(m_Value()), m_Value())) {
        let mut Sub: *mut Value = self.Builder.CreateSub(get(Ty, Ty.getScalarSizeInBits() - 1, false, false), X, "", false, false);
        return CreateLShr(getAllOnesValue(Ty), Sub, "");
    }
    let mut PN: *mut PHINode = null;
    let mut Start: *mut Value = null;
    let mut Step: *mut Value = null;
    if matchSimpleRecurrence(&mut I, PN, Start, Step) && self.DT.dominates(Step, PN) {
        return self.replaceInstUsesWith(I, self.Builder.CreateOr(Start, Step, "", false));
    }
    if match(&mut I, m_c_Or(m_OneUse(m_And(m_Value(A), m_Value(B))), m_OneUse(m_Or(m_Value(C), m_Value(D))))) {
        if match(D, m_OneUse(m_c_And(m_Specific(A), m_Value()))) || match(D, m_OneUse(m_c_And(m_Specific(B), m_Value()))) {
            return CreateOr(C, self.Builder.CreateOr(D, self.Builder.CreateAnd(A, B, ""), "", false), "");
        }
        if match(C, m_OneUse(m_c_And(m_Specific(A), m_Value()))) || match(C, m_OneUse(m_c_And(m_Specific(B), m_Value()))) {
            return CreateOr(self.Builder.CreateOr(C, self.Builder.CreateAnd(A, B, ""), "", false), D, "");
        }
    }
    if reassociateForUses(I, self.Builder) {
        R;
    } else {
        return R;
    }
    if canonicalizeLogicFirst(I, self.Builder) {
        Canonicalized;
    } else {
        return Canonicalized;
    }
    if self.foldLogicOfIsFPClass(I, Op0, Op1) {
        Folded;
    } else {
        return Folded;
    }
    if self.foldBinOpOfDisplacedShifts(I) {
        Res;
    } else {
        return Res;
    }
    let mut CastOp: *mut Value = null;
    if match(Op0, m_ElementWiseBitCast(m_Value(CastOp))) && match(Op1, m_SignMask()) && !self.Builder.GetInsertBlock().getParent().hasFnAttribute(NoImplicitFloat) {
        let mut EltTy: *mut Type = CastOp.getType().getScalarType();
        if EltTy.isFloatingPointTy() && hasSignBitInMSB(EltTy.getFltSemantics()) {
            let mut FAbs: *mut Value = self.Builder.CreateFAbs(CastOp, FMFSource {}, "");
            let mut FNegFAbs: *mut Value = self.Builder.CreateFNeg(FAbs, "", null);
            return BitCastInst { FNegFAbs, I.getType(), "", null };
        }
    }
    if match(Op0, m_OneUse(m_And(m_Value(X), m_APInt(C1)))) && match(Op1, m_APInt(C2)) {
        let mut KnownX: KnownBits = self.computeKnownBits(X, &mut I, 0);
        if (KnownX.One & *C2) == *C2 {
            return CreateAnd(X, get(Ty, *C1 | *C2), "");
        }
    }
    if foldBitwiseLogicWithIntrinsics(I, self.Builder) {
        Res;
    } else {
        return Res;
    }
    if simplifyAndOrWithOpReplaced(Op0, Op1, getNullValue(Ty), false, *self, 0) {
        V;
    } else {
        return CreateOr(V, Op1, "");
    }
    if simplifyAndOrWithOpReplaced(Op1, Op0, getNullValue(Ty), false, *self, 0) {
        V;
    } else {
        return CreateOr(Op0, V, "");
    }
    if cast(I).isDisjoint() {
        if self.SimplifyAddWithRemainder(I) {
            V;
        } else {
            return self.replaceInstUsesWith(I, V);
        }
    }
    if FoldOrOfSelectSmaxToAbs(I, self.Builder) {
        Res;
    } else {
        return self.replaceInstUsesWith(I, Res);
    }
    {
        let mut X: *mut Value = null;
        let mut SignPred: CmpPredicate = CmpPredicate {};
        let mut BitWidth: u32 = Ty.getScalarSizeInBits();
        if match(&mut I, m_c_Or(m_AShr(m_Value(X), m_SpecificIntAllowPoison(BitWidth - 1)), m_ZExt(m_ICmp(SignPred, m_Deferred(X), m_ZeroInt())))) && (SignPred == ICMP_NE || SignPred == ICMP_SGT) && (Op0.hasOneUse() || Op1.hasOneUse()) {
            return self.replaceInstUsesWith(I, self.Builder.CreateIntrinsic(Ty, scmp, [X, getNullValue(Ty)], FMFSource {}, "", function_ref<void (CallInst *)> { Closure_21 {}, null, null }));
        }
    }
    return null;
}

fn foldXorToXor(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    assert!(I.getOpcode() == Xor);
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    if match(&mut I, m_c_Xor(m_And(m_Value(A), m_Value(B)), m_c_Or(m_Deferred(A), m_Deferred(B)))) {
        return CreateXor(A, B, "");
    }
    if match(&mut I, m_Xor(m_c_Or(m_Value(A), m_Not(m_Value(B))), m_c_Or(m_Not(m_Deferred(A)), m_Deferred(B)))) {
        return CreateXor(A, B, "");
    }
    if match(&mut I, m_Xor(m_c_And(m_Value(A), m_Not(m_Value(B))), m_c_And(m_Not(m_Deferred(A)), m_Deferred(B)))) {
        return CreateXor(A, B, "");
    }
    if !Op0.hasOneUse() && !Op1.hasOneUse() {
        return null;
    }
    if (match(Op0, m_Or(m_Value(A), m_Value(B))) && match(Op1, m_Not(m_c_And(m_Specific(A), m_Specific(B))))) || (match(Op0, m_And(m_Value(A), m_Value(B))) && match(Op1, m_Not(m_c_Or(m_Specific(A), m_Specific(B))))) {
        return CreateNot(Builder.CreateXor(A, B, ""), "", null);
    }
    return null;
}

fn InstCombinerImpl::foldXorOfICmps(self, LHS: *mut ICmpInst, RHS: *mut ICmpInst, I: *mut BinaryOperator) -> *mut Value {
    assert!(I.getOpcode() == Xor && I.getOperand(0) == LHS && I.getOperand(1) == RHS, "Should be 'xor' with these operands");
    let mut PredL: Predicate = LHS.getPredicate();
    let mut PredR: Predicate = RHS.getPredicate();
    let mut LHS0: *mut Value = LHS.getOperand(0);
    let mut LHS1: *mut Value = LHS.getOperand(1);
    let mut RHS0: *mut Value = RHS.getOperand(0);
    let mut RHS1: *mut Value = RHS.getOperand(1);
    if predicatesFoldable(PredL, PredR) {
        if LHS0 == RHS1 && LHS1 == RHS0 {
            swap(LHS0, LHS1);
            PredL = getSwappedPredicate(PredL);
        }
        if LHS0 == RHS0 && LHS1 == RHS1 {
            let mut Code: u32 = getICmpCode(PredL) ^ getICmpCode(PredR);
            let mut IsSigned: bool = LHS.isSigned() || RHS.isSigned();
            return getNewICmpValue(Code, IsSigned, LHS0, LHS1, self.Builder);
        }
    }
    let mut LC: *APInt = null;
    let mut RC: *APInt = null;
    if match(LHS1, m_APInt(LC)) && match(RHS1, m_APInt(RC)) && LHS0.getType() == RHS0.getType() && LHS0.getType().isIntOrIntVectorTy() {
        let mut TrueIfSignedL: bool = false;
        let mut TrueIfSignedR: bool = false;
        if (LHS.hasOneUse() || RHS.hasOneUse()) && isSignBitCheck(PredL, *LC, TrueIfSignedL) && isSignBitCheck(PredR, *RC, TrueIfSignedR) {
            let mut XorLR: *mut Value = self.Builder.CreateXor(LHS0, RHS0, "");
            return if TrueIfSignedL == TrueIfSignedR { self.Builder.CreateIsNeg(XorLR, "") } else { self.Builder.CreateIsNotNeg(XorLR, "") };
        }
        if LHS0 == RHS0 {
            let mut CR1: ConstantRange = makeExactICmpRegion(PredL, *LC);
            let mut CR2: ConstantRange = makeExactICmpRegion(PredR, *RC);
            let mut CRUnion: optional<ConstantRange> = CR1.exactUnionWith(CR2);
            let mut CRIntersect: optional<ConstantRange> = CR1.exactIntersectWith(CR2);
            if CRUnion && CRIntersect {
                if operator(CRUnion).exactIntersectWith(operator(CRIntersect).inverse()) {
                    CR;
                } else {
                    if operator(CR).isFullSet() {
                        return getTrue(I.getType());
                    }
                    if operator(CR).isEmptySet() {
                        return getFalse(I.getType());
                    }
                    let mut NewPred: Predicate = zeroed();
                    let mut NewC: APInt = APInt {};
                    let mut Offset: APInt = APInt {};
                    operator(CR).getEquivalentICmp(NewPred, NewC, Offset);
                    if (Offset.isZero() && (LHS.hasOneUse() || RHS.hasOneUse())) || (LHS.hasOneUse() && RHS.hasOneUse()) {
                        let mut NewV: *mut Value = LHS0;
                        let mut Ty: *mut Type = LHS0.getType();
                        if !Offset.isZero() {
                            NewV = self.Builder.CreateAdd(NewV, get(Ty, Offset), "", false, false);
                        }
                        return self.Builder.CreateICmp(NewPred, NewV, get(Ty, NewC), "");
                    }
                }
            }
        }
        let mut X: *mut Value = null;
        let mut Y: *mut Value = null;
        let mut Pow2: *mut Value = null;
        if isEquality(PredL) && isEquality(PredR) && LC.isZero() && RC.isZero() && LHS.hasOneUse() && RHS.hasOneUse() && match(LHS0, m_And(m_Value(X), m_Value(Pow2))) && match(RHS0, m_And(m_Value(Y), m_Specific(Pow2))) && self.isKnownToBeAPowerOfTwo(Pow2, true, &mut I, 0) {
            let mut Xor: *mut Value = self.Builder.CreateXor(X, Y, "");
            let mut And: *mut Value = self.Builder.CreateAnd(Xor, Pow2, "");
            return self.Builder.CreateICmp(if PredL == PredR { ICMP_NE } else { ICMP_EQ }, And, getNullValue(Xor.getType()), "");
        }
    }
    if simplifyBinOp(Or, LHS, RHS, self.SQ) {
        OrICmp;
    } else {
        if simplifyBinOp(And, LHS, RHS, self.SQ) {
            AndICmp;
        } else {
            let mut X: *mut ICmpInst = null;
            let mut Y: *mut ICmpInst = null;
            if OrICmp == LHS && AndICmp == RHS {
                X = LHS;
                Y = RHS;
            }
            if OrICmp == RHS && AndICmp == LHS {
                X = RHS;
                Y = LHS;
            }
            if X && Y && (Y.hasOneUse() || self.canFreelyInvertAllUsersOf(Y, &mut I)) {
                Y.setPredicate(Y.getInversePredicate());
                if !Y.hasOneUse() {
                    let mut Guard: InsertPointGuard = self.Builder;
                    self.Builder.SetInsertPoint(operator((Y.getIterator())));
                    let mut NotY: *mut Value = self.Builder.CreateNot(Y, Y.getName() + ".not");
                    self.Worklist.pushUsersToWorkList(*Y);
                    Y.replaceUsesWithIf(NotY, function_ref<bool (Use &)> { Closure_22 { NotY: NotY }, null, null });
                }
                return self.Builder.CreateAnd(LHS, RHS, "");
            }
        }
    }
    return null;
}

fn visitMaskedMerge(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut B: *mut Value = null;
    let mut X: *mut Value = null;
    let mut D: *mut Value = null;
    let mut M: *mut Value = null;
    if !match(&mut I, m_c_Xor(m_Value(B), m_OneUse(m_c_And(m_Value(D, m_c_Xor(m_Deferred(B), m_Value(X))), m_Value(M))))) {
        return null;
    }
    let mut NotM: *mut Value = null;
    if match(M, m_Not(m_Value(NotM))) {
        let mut NewA: *mut Value = Builder.CreateAnd(D, NotM, "");
        return CreateXor(NewA, X, "");
    }
    let mut C: *mut Constant = null;
    if D.hasOneUse() && match(M, m_Constant(C)) {
        let mut EltTy: *mut Type = C.getType().getScalarType();
        C = replaceUndefsWith(C, getAllOnesValue(EltTy));
        let mut LHS: *mut Value = Builder.CreateAnd(X, C, "");
        let mut NotC: *mut Value = Builder.CreateNot(C, "");
        let mut RHS: *mut Value = Builder.CreateAnd(B, NotC, "");
        return CreateOr(LHS, RHS, "");
    }
    return null;
}

fn foldNotXor(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if !match(&mut I, m_Not(m_OneUse(m_Xor(m_Value(X), m_Value(Y))))) {
        return null;
    }
    let mut hasCommonOperand: Closure_23 = Closure_23 {};
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut C: *mut Value = null;
    let mut D: *mut Value = null;
    if match(X, m_And(m_Value(A), m_Value(B))) && match(Y, m_Or(m_Value(C), m_Value(D))) && hasCommonOperand.call(A, B, C, D) {
        let mut NotY: *mut Value = Builder.CreateNot(Y, "");
        return CreateOr(X, NotY, "");
    }
    if match(Y, m_And(m_Value(A), m_Value(B))) && match(X, m_Or(m_Value(C), m_Value(D))) && hasCommonOperand.call(A, B, C, D) {
        let mut NotX: *mut Value = Builder.CreateNot(X, "");
        return CreateOr(Y, NotX, "");
    }
    return null;
}

fn canonicalizeAbs(Xor: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    assert!(Xor.getOpcode() == Xor, "Expected an xor instruction.");
    let mut Op0: *mut Value = Xor.getOperand(0);
    let mut Op1: *mut Value = Xor.getOperand(1);
    if Op0.hasNUses(2) {
        swap(Op0, Op1);
    }
    let mut Ty: *mut Type = Xor.getType();
    let mut A: *mut Value = null;
    let mut ShAmt: *APInt = null;
    if match(Op1, m_AShr(m_Value(A), m_APInt(ShAmt))) && Op1.hasNUses(2) && *ShAmt == Ty.getScalarSizeInBits() - 1 && match(Op0, m_OneUse(m_c_Add(m_Specific(A), m_Specific(Op1)))) {
        let mut IsNeg: *mut Value = Builder.CreateIsNeg(A, "");
        let mut Add: *mut BinaryOperator = cast(Op0);
        let mut NegA: *mut Value = if Add.hasNoUnsignedWrap() { getNullValue(A.getType()) } else { Builder.CreateNeg(A, "", Add.hasNoSignedWrap()) };
        return Create(IsNeg, NegA, A, "", null, null);
    }
    return null;
}

fn canFreelyInvert(IC: *mut InstCombiner, Op: *mut Value, IgnoredUser: *mut Instruction) -> bool {
    let mut I: *mut Instruction = dyn_cast(Op);
    return I && I.getInsertionPointAfterDef() && IC.isFreeToInvert(I, true) && IC.canFreelyInvertAllUsersOf(I, IgnoredUser);
}

fn freelyInvert(IC: *mut InstCombinerImpl, Op: *mut Value, IgnoredUser: *mut Instruction) -> *mut Value {
    let mut I: *mut Instruction = cast(Op);
    let mut InsertPt: iterator> = I.getInsertionPointAfterDef();
    assert!(InsertPt, "freelyInvert requires an instruction with a valid insertion point");
    IC.Builder.SetInsertPoint(operator(InsertPt));
    let mut NotOp: *mut Value = IC.Builder.CreateNot(Op, Op.getName() + ".not");
    Op.replaceUsesWithIf(NotOp, function_ref<bool (Use &)> { Closure_24 { NotOp: NotOp }, null, null });
    IC.freelyInvertAllUsersOf(NotOp, IgnoredUser);
    return NotOp;
}

fn InstCombinerImpl::sinkNotIntoLogicalOp(self, I: *mut Instruction) -> bool {
    let mut Op0: *mut Value = null;
    let mut Op1: *mut Value = null;
    if !match(&mut I, m_LogicalOp(m_Value(Op0), m_Value(Op1))) {
        return false;
    }
    if Op0 == Op1 {
        return false;
    }
    if match(Op0, m_Not(m_Specific(Op1))) || match(Op1, m_Not(m_Specific(Op0))) {
        return false;
    }
    let mut NewOpc: BinaryOps = if match(&mut I, m_LogicalAnd()) { Or } else { And };
    let mut IsBinaryOp: bool = isa(I);
    if !self.canFreelyInvertAllUsersOf(&mut I, null) {
        return false;
    }
    if !canFreelyInvert(*self, Op0, &mut I) || !canFreelyInvert(*self, Op1, &mut I) {
        return false;
    }
    Op0 = freelyInvert(*self, Op0, &mut I);
    Op1 = freelyInvert(*self, Op1, &mut I);
    let mut InsertPt: iterator> = I.getInsertionPointAfterDef();
    assert!(InsertPt, "sinkNotIntoLogicalOp requires an instruction with a valid insertion point");
    self.Builder.SetInsertPoint(operator(InsertPt));
    let mut NewLogicOp: *mut Value = null;
    if IsBinaryOp {
        NewLogicOp = self.Builder.CreateBinOp(NewOpc, Op0, Op1, I.getName() + ".not", null);
    } else {
        NewLogicOp = self.Builder.CreateLogicalOp(NewOpc, Op0, Op1, I.getName() + ".not", &mut I);
        if dyn_cast(NewLogicOp) {
            SI;
        } else {
            SI.swapProfMetadata();
        }
    }
    self.replaceInstUsesWith(I, NewLogicOp);
    self.freelyInvertAllUsersOf(NewLogicOp, null);
    return true;
}

fn InstCombinerImpl::sinkNotIntoOtherHandOfLogicalOp(self, I: *mut Instruction) -> bool {
    let mut Op0: *mut Value = null;
    let mut Op1: *mut Value = null;
    if !match(&mut I, m_LogicalOp(m_Value(Op0), m_Value(Op1))) {
        return false;
    }
    let mut NewOpc: BinaryOps = if match(&mut I, m_LogicalAnd()) { Or } else { And };
    let mut IsBinaryOp: bool = isa(I);
    let mut NotOp0: *mut Value = null;
    let mut NotOp1: *mut Value = null;
    let mut OpToInvert: *mut *mut Value = null;
    if match(Op0, m_Not(m_Value(NotOp0))) && canFreelyInvert(*self, Op1, &mut I) {
        Op0 = NotOp0;
        OpToInvert = &mut Op1;
    } else if match(Op1, m_Not(m_Value(NotOp1))) && canFreelyInvert(*self, Op0, &mut I) {
        Op1 = NotOp1;
        OpToInvert = &mut Op0;
    } else {
        return false;
    }
    if match(if *OpToInvert == Op1 { Op0 } else { Op1 }, m_Not(m_Specific(*OpToInvert))) {
        return false;
    }
    if !self.canFreelyInvertAllUsersOf(&mut I, null) {
        return false;
    }
    *OpToInvert = freelyInvert(*self, *OpToInvert, &mut I);
    self.Builder.SetInsertPoint(operator(I.getInsertionPointAfterDef()));
    let mut NewBinOp: *mut Value = null;
    if IsBinaryOp {
        NewBinOp = self.Builder.CreateBinOp(NewOpc, Op0, Op1, I.getName() + ".not", null);
    } else {
        NewBinOp = self.Builder.CreateLogicalOp(NewOpc, Op0, Op1, I.getName() + ".not", null);
    }
    self.replaceInstUsesWith(I, NewBinOp);
    self.freelyInvertAllUsersOf(NewBinOp, null);
    return true;
}

fn InstCombinerImpl::foldNot(self, I: *mut BinaryOperator) -> *mut Instruction {
    let mut NotOp: *mut Value = null;
    if !match(&mut I, m_Not(m_Value(NotOp))) {
        return null;
    }
    let mut Ty: *mut Type = I.getType();
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(NotOp, m_OneUse(m_c_And(m_Not(m_Value(X)), m_Value(Y)))) {
        let mut NotY: *mut Value = self.Builder.CreateNot(Y, Y.getName() + ".not");
        return CreateOr(X, NotY, "");
    }
    if match(NotOp, m_OneUse(m_LogicalAnd(m_Not(m_Value(X)), m_Value(Y)))) {
        let mut NotY: *mut Value = self.Builder.CreateNot(Y, Y.getName() + ".not");
        let mut SI: *mut SelectInst = Create(X, getTrue(Ty), NotY, "", null, cast(NotOp));
        SI.swapProfMetadata();
        return SI;
    }
    if match(NotOp, m_OneUse(m_c_Or(m_Not(m_Value(X)), m_Value(Y)))) {
        let mut NotY: *mut Value = self.Builder.CreateNot(Y, Y.getName() + ".not");
        return CreateAnd(X, NotY, "");
    }
    if match(NotOp, m_OneUse(m_LogicalOr(m_Not(m_Value(X)), m_Value(Y)))) {
        let mut NotY: *mut Value = self.Builder.CreateNot(Y, Y.getName() + ".not");
        let mut SI: *mut SelectInst = Create(X, NotY, getFalse(Ty), "", null, cast(NotOp));
        SI.swapProfMetadata();
        return SI;
    }
    let mut NotVal: *mut BinaryOperator = null;
    if match(NotOp, m_BinOp(NotVal)) {
        if match(NotVal, m_OneUse(m_c_Or(m_OneUse(m_Neg(m_Value(X))), m_Value(Y)))) {
            let mut DecX: *mut Value = self.Builder.CreateAdd(X, getAllOnesValue(Ty), "", false, false);
            let mut NotY: *mut Value = self.Builder.CreateNot(Y, "");
            return CreateAnd(DecX, NotY, "");
        }
        if match(NotVal, m_AShr(m_Not(m_Value(X)), m_Value(Y))) {
            return CreateAShr(X, Y, "");
        }
        if match(NotVal, m_LShr(m_Not(m_Value(X)), m_Value(Y))) && isKnownNegative(X, self.SQ.getWithInstruction(NotVal), 0) {
            return CreateAShr(X, Y, "");
        }
        let mut FullShift: u32 = Ty.getScalarSizeInBits() - 1;
        if match(NotVal, m_OneUse(m_AShr(m_Value(X), m_SpecificInt(FullShift)))) {
            let mut IsNotNeg: *mut Value = self.Builder.CreateIsNotNeg(X, "isnotneg");
            return SExtInst { IsNotNeg, Ty, "", null };
        }
        let mut C: *mut Constant = null;
        if match(NotVal, m_AShr(m_Constant(C), m_Value(Y))) && match(C, m_Negative()) {
            return CreateLShr(getNot(C), Y, "");
        }
        if match(NotVal, m_LShr(m_Constant(C), m_Value(Y))) && match(C, m_NonNegative()) {
            return CreateAShr(getNot(C), Y, "");
        }
        if match(NotVal, m_Add(m_Value(X), m_ImmConstant(C))) {
            return CreateSub(getNot(C), X, "");
        }
        if match(NotVal, m_Sub(m_Value(X), m_Value(Y))) {
            if isa(X) || NotVal.hasOneUse() {
                return CreateAdd(self.Builder.CreateNot(X, ""), Y, "");
            }
        }
        if match(NotVal, m_c_Add(m_Not(m_Value(X)), m_Value(Y))) {
            return CreateWithCopiedFlags(Sub, X, Y, NotVal, "", null);
        }
    }
    let mut Pred: CmpPredicate = CmpPredicate {};
    if match(NotOp, m_Cmp(Pred, m_Value(), m_Value())) && (NotOp.hasOneUse() || self.canFreelyInvertAllUsersOf(cast(NotOp), null)) {
        cast(NotOp).setPredicate(getInversePredicate(Pred.operator llvm::CmpInst::Predicate()));
        self.freelyInvertAllUsersOf(NotOp, null);
        return &mut I;
    }
    if match(NotOp, m_OneUse(m_BitCast(m_Value(X)))) && match(X, m_OneUse(m_Cmp(Pred, m_Value(), m_Value()))) {
        cast(X).setPredicate(getInversePredicate(Pred.operator llvm::CmpInst::Predicate()));
        return BitCastInst { X, Ty, "", null };
    }
    if match(NotOp, m_OneUse(m_BitCast(m_OneUse(m_SExt(m_Value(X)))))) && X.getType().isIntOrIntVectorTy(1) {
        let mut SextTy: *mut Type = cast(NotOp).getSrcTy();
        let mut NotX: *mut Value = self.Builder.CreateNot(X, "");
        let mut Sext: *mut Value = self.Builder.CreateSExt(NotX, SextTy, "");
        return BitCastInst { Sext, Ty, "", null };
    }
    if dyn_cast(NotOp) {
        NotOpI;
    } else if self.sinkNotIntoLogicalOp(*NotOpI) {
        return &mut I;
    }
    let mut II: *mut IntrinsicInst = dyn_cast(NotOp);
    if II && II.hasOneUse() {
        if match(NotOp, m_c_MaxOrMin(m_Not(m_Value(X)), m_Value(Y))) {
            let mut InvID: ID = getInverseMinMaxIntrinsic(II.getIntrinsicID());
            let mut NotY: *mut Value = self.Builder.CreateNot(Y, "");
            let mut InvMaxMin: *mut Value = self.Builder.CreateBinaryIntrinsic(InvID, X, NotY, FMFSource {}, "");
            return self.replaceInstUsesWith(I, InvMaxMin);
        }
        if II.getIntrinsicID() == is_fpclass {
            let mut ClassMask: *mut ConstantInt = cast(II.getArgOperand(1));
            II.setArgOperand(1, get(ClassMask.getType(), ~ClassMask.getZExtValue() & fcAllFlags, false, false));
            return self.replaceInstUsesWith(I, II);
        }
    }
    if NotOp.hasOneUse() {
        if dyn_cast(NotOp) {
            Sel;
        } else {
            let mut TV: *mut Value = Sel.getTrueValue();
            let mut FV: *mut Value = Sel.getFalseValue();
            let mut CmpT: *mut CmpInst = dyn_cast(TV);
            let mut CmpF: *mut CmpInst = dyn_cast(FV);
            let mut InvertibleT: bool = (CmpT && CmpT.hasOneUse()) || isa(TV);
            let mut InvertibleF: bool = (CmpF && CmpF.hasOneUse()) || isa(FV);
            if InvertibleT && InvertibleF {
                if CmpT {
                    CmpT.setPredicate(CmpT.getInversePredicate());
                } else {
                    Sel.setTrueValue(getNot(cast(TV)));
                }
                if CmpF {
                    CmpF.setPredicate(CmpF.getInversePredicate());
                } else {
                    Sel.setFalseValue(getNot(cast(FV)));
                }
                return self.replaceInstUsesWith(I, Sel);
            }
        }
    }
    if foldNotXor(I, self.Builder) {
        NewXor;
    } else {
        return NewXor;
    }
    if self.getFreelyInverted(NotOp, NotOp.hasOneUse(), &mut self.Builder) {
        R;
    } else {
        return self.replaceInstUsesWith(I, R);
    }
    return null;
}

fn foldMaskedAddXorPattern(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut X: *mut Value = null;
    let mut Mask: *mut Value = null;
    let mut AddC: *mut Constant = null;
    let mut AddInst: *mut BinaryOperator = null;
    if match(&mut I, m_Xor(m_OneUse(m_And(m_OneUse(m_CombineAnd(m_BinOp(AddInst), m_Add(m_Value(X), m_ImmConstant(AddC)))), m_Value(Mask))), m_Deferred(Mask))) {
        let mut NotC: *mut Value = Builder.CreateNot(AddC, "");
        let mut NewSub: *mut Value = Builder.CreateSub(NotC, X, "", AddInst.hasNoUnsignedWrap(), AddInst.hasNoSignedWrap());
        return CreateAnd(NewSub, Mask, "");
    }
    return null;
}

fn InstCombinerImpl::visitXor(self, I: *mut BinaryOperator) -> *mut Instruction {
    if simplifyXorInst(I.getOperand(0), I.getOperand(1), self.SQ.getWithInstruction(&mut I)) {
        V;
    } else {
        return self.replaceInstUsesWith(I, V);
    }
    if self.SimplifyAssociativeOrCommutative(I) {
        return &mut I;
    }
    if self.foldVectorBinop(I) {
        X;
    } else {
        return X;
    }
    if self.foldBinopWithPhiOperands(I) {
        Phi;
    } else {
        return Phi;
    }
    if foldXorToXor(I, self.Builder) {
        NewXor;
    } else {
        return NewXor;
    }
    if self.foldUsingDistributiveLaws(I) {
        V;
    } else {
        return self.replaceInstUsesWith(I, V);
    }
    if self.SimplifyDemandedInstructionBits(I) {
        return &mut I;
    }
    if self.foldNot(I) {
        R;
    } else {
        return R;
    }
    if self.foldBinOpShiftWithShift(I) {
        R;
    } else {
        return R;
    }
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut M: *mut Value = null;
    if match(&mut I, m_c_Xor(m_OneUse(m_DisjointOr(m_Value(X), m_Value(Y))), m_Value(M))) {
        if simplifyXorInst(X, M, self.SQ.getWithInstruction(&mut I)) {
            XorAC;
        } else {
            return CreateXor(XorAC, Y, "");
        }
        if simplifyXorInst(Y, M, self.SQ.getWithInstruction(&mut I)) {
            XorBC;
        } else {
            return CreateXor(XorBC, X, "");
        }
    }
    if match(&mut I, m_c_Xor(m_c_And(m_Not(m_Value(M)), m_Value()), m_c_And(m_Deferred(M), m_Value()))) {
        if isGuaranteedNotToBeUndef(M, null, null, null, 0) {
            return CreateDisjointOr(Op0, Op1, "");
        } else {
            return CreateOr(Op0, Op1, "");
        }
    }
    if visitMaskedMerge(I, self.Builder) {
        Xor;
    } else {
        return Xor;
    }
    let mut C1: *mut Constant = null;
    if match(Op1, m_Constant(C1)) {
        let mut C2: *mut Constant = null;
        if match(Op0, m_OneUse(m_Or(m_Value(X), m_ImmConstant(C2)))) && match(C1, m_ImmConstant()) {
            C2 = replaceUndefsWith(C2, getAllOnesValue(C2.getType().getScalarType()));
            let mut And: *mut Value = self.Builder.CreateAnd(X, mergeUndefsWith(getNot(C2), C1), "");
            return CreateXor(And, mergeUndefsWith(getXor(C1, C2), C1), "");
        }
        if match(Op0, m_OneUse(m_Or(m_Not(m_Value(X)), m_Constant(C2)))) {
            let mut And: *mut Value = self.Builder.CreateAnd(X, getNot(C2), "");
            return CreateXor(And, getNot(C1), "");
        }
        if match(Op0, m_OneUse(m_And(m_Not(m_Value(X)), m_Constant(C2)))) {
            let mut Or: *mut Value = self.Builder.CreateOr(X, getNot(C2), "", false);
            return CreateXor(Or, getNot(C1), "");
        }
        let mut CA: *APInt = null;
        if match(Op0, m_OneUse(m_TruncOrSelf(m_AShr(m_Value(X), m_APIntAllowPoison(CA))))) && *CA == X.getType().getScalarSizeInBits() - 1 && !match(C1, m_AllOnes()) {
            assert!(!C1.isNullValue(), "Unexpected xor with 0");
            let mut IsNotNeg: *mut Value = self.Builder.CreateIsNotNeg(X, "");
            return self.createSelectInstWithUnknownProfile(IsNotNeg, Op1, self.Builder.CreateNot(Op1, ""), "", null);
        }
    }
    let mut Ty: *mut Type = I.getType();
    {
        let mut RHSC: *APInt = null;
        if match(Op1, m_APInt(RHSC)) {
            let mut X: *mut Value = null;
            let mut C: *APInt = null;
            if RHSC.isSignMask() && match(Op0, m_Sub(m_APInt(C), m_Value(X))) {
                return CreateSub(get(Ty, *C + *RHSC), X, "");
            }
            if RHSC.isSignMask() && match(Op0, m_Add(m_Value(X), m_APInt(C))) {
                return CreateAdd(X, get(Ty, *C + *RHSC), "");
            }
            if match(Op0, m_Or(m_Value(X), m_APInt(C))) && self.MaskedValueIsZero(X, *C, &mut I, 0) {
                return CreateXor(X, get(Ty, *C ^ *RHSC), "");
            }
            let mut II: *mut IntrinsicInst = dyn_cast(Op0);
            if II && II.hasOneUse() && *RHSC == Ty.getScalarSizeInBits() - 1 {
                let mut IID: ID = II.getIntrinsicID();
                if (IID == ctlz || IID == cttz) && match(II.getArgOperand(1), m_One()) && self.isKnownToBeAPowerOfTwo(II.getArgOperand(0), true, null, 0) {
                    IID = if (IID == ctlz) { cttz } else { ctlz };
                    let mut F: *mut Function = getOrInsertDeclaration(II.getModule(), IID, Ty);
                    return Create(F, [II.getArgOperand(0), self.Builder.getTrue()], ArrayRef<OperandBundleDef> {}, "", null);
                }
            }
            if match(Op0, m_OneUse(m_Shl(m_Value(X), m_APInt(C)))) && *RHSC == getAllOnes(Ty.getScalarSizeInBits()).shl(*C) {
                let mut NotX: *mut Value = self.Builder.CreateNot(X, "");
                return CreateShl(NotX, get(Ty, *C), "");
            }
            if match(Op0, m_OneUse(m_LShr(m_Value(X), m_APInt(C)))) && *RHSC == getAllOnes(Ty.getScalarSizeInBits()).lshr(*C) {
                let mut NotX: *mut Value = self.Builder.CreateNot(X, "");
                return CreateLShr(NotX, get(Ty, *C), "");
            }
        }
        let mut CastOp: *mut Value = null;
        if match(Op0, m_ElementWiseBitCast(m_Value(CastOp))) && match(Op1, m_SignMask()) && !self.Builder.GetInsertBlock().getParent().hasFnAttribute(NoImplicitFloat) {
            let mut EltTy: *mut Type = CastOp.getType().getScalarType();
            if EltTy.isFloatingPointTy() && hasSignBitInMSB(EltTy.getFltSemantics()) {
                let mut FNeg: *mut Value = self.Builder.CreateFNeg(CastOp, "", null);
                return BitCastInst { FNeg, I.getType(), "", null };
            }
        }
    }
    {
        let mut X: *mut Value = null;
        let mut C1: *mut ConstantInt = null;
        let mut C2: *mut ConstantInt = null;
        let mut C3: *mut ConstantInt = null;
        if match(Op1, m_ConstantInt(C3)) && match(Op0, m_LShr(m_Xor(m_Value(X), m_ConstantInt(C1)), m_ConstantInt(C2))) && Op0.hasOneUse() {
            let mut FoldConst: APInt = C1.getValue().lshr(C2.getValue());
            operator(FoldConst, C3.getValue());
            let mut Opnd0: *mut Value = self.Builder.CreateLShr(X, C2, "", false);
            Opnd0.takeName(Op0);
            return CreateXor(Opnd0, get(Ty, FoldConst), "");
        }
    }
    if self.foldBinOpIntoSelectOrPhi(I) {
        FoldedLogic;
    } else {
        return FoldedLogic;
    }
    if self.foldBinOpSelectBinOp(I) {
        FoldedLogic;
    } else {
        return FoldedLogic;
    }
    if match(Op1, m_OneUse(m_c_Or(m_Value(X), m_Specific(Op0)))) {
        return CreateAnd(X, self.Builder.CreateNot(Op0, ""), "");
    }
    if match(Op0, m_OneUse(m_c_Or(m_Value(X), m_Specific(Op1)))) {
        return CreateAnd(X, self.Builder.CreateNot(Op1, ""), "");
    }
    if match(Op1, m_OneUse(m_c_And(m_Value(X), m_Specific(Op0)))) {
        return CreateAnd(Op0, self.Builder.CreateNot(X, ""), "");
    }
    if !match(Op1, m_Constant()) && match(Op0, m_OneUse(m_c_And(m_Value(X), m_Specific(Op1)))) {
        return CreateAnd(Op1, self.Builder.CreateNot(X, ""), "");
    }
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut C: *mut Value = null;
    if match(&mut I, m_c_Xor(m_OneUse(m_Xor(m_Value(A), m_Value(B))), m_OneUse(m_c_Or(m_Deferred(A), m_Value(C))))) {
        return CreateXor(self.Builder.CreateAnd(self.Builder.CreateNot(A, ""), C, ""), B, "");
    }
    if match(&mut I, m_c_Xor(m_OneUse(m_Xor(m_Value(A), m_Value(B))), m_OneUse(m_c_Or(m_Deferred(B), m_Value(C))))) {
        return CreateXor(self.Builder.CreateAnd(self.Builder.CreateNot(B, ""), C, ""), A, "");
    }
    if match(Op0, m_And(m_Value(A), m_Value(B))) && match(Op1, m_c_Xor(m_Specific(A), m_Specific(B))) {
        return CreateOr(A, B, "");
    }
    if match(Op0, m_Xor(m_Value(A), m_Value(B))) && match(Op1, m_c_And(m_Specific(A), m_Specific(B))) {
        return CreateOr(A, B, "");
    }
    if match(Op0, m_c_And(m_Value(A), m_Not(m_Value(B)))) && match(Op1, m_Not(m_Specific(A))) {
        return CreateNot(self.Builder.CreateAnd(A, B, ""), "", null);
    }
    if match(&mut I, m_c_Xor(m_c_And(m_Not(m_Value(A)), m_Value(B)), m_Deferred(A))) {
        return CreateOr(A, B, "");
    }
    if match(Op0, m_OneUse(m_c_Or(m_Not(m_Specific(Op1)), m_Value(B)))) {
        return CreateNot(self.Builder.CreateAnd(Op1, B, ""), "", null);
    }
    if match(Op1, m_OneUse(m_c_Or(m_Not(m_Specific(Op0)), m_Value(B)))) {
        return CreateNot(self.Builder.CreateAnd(Op0, B, ""), "", null);
    }
    let mut D: *mut Value = null;
    if match(Op0, m_OneUse(m_Or(m_Value(A), m_Value(B)))) && match(Op1, m_OneUse(m_Or(m_Value(C), m_Value(D)))) {
        if B == C || B == D {
            swap(A, B);
        }
        if A == C {
            swap(C, D);
        }
        if A == D {
            let mut NotA: *mut Value = self.Builder.CreateNot(A, "");
            return CreateAnd(self.Builder.CreateXor(B, C, ""), NotA, "");
        }
    }
    if I.getType().isIntOrIntVectorTy(1) && match(&mut I, m_c_Xor(m_OneUse(m_LogicalAnd(m_Value(A), m_Value(B))), m_OneUse(m_LogicalOr(m_Value(C), m_Value(D))))) {
        let mut NeedFreeze: bool = isa(Op0) && isa(Op1) && B == D;
        if B == C || B == D {
            swap(A, B);
        }
        if A == C {
            swap(C, D);
        }
        if A == D {
            if NeedFreeze {
                A = self.Builder.CreateFreeze(A, "");
            }
            let mut NotB: *mut Value = self.Builder.CreateNot(B, "");
            let mut MDFrom: *mut Instruction = null;
            if dyn_cast(Op0) {
                Op0SI;
            } else {
                if Op0SI.getCondition() == A {
                    MDFrom = Op0SI;
                }
            }
            if dyn_cast(Op1) {
                Op1SI;
            } else {
                if Op1SI.getCondition() == A {
                    MDFrom = Op1SI;
                }
            }
            return if (MDFrom == null || ProfcheckDisableMetadataFixes) { self.createSelectInstWithUnknownProfile(A, NotB, C, "", null) } else { Create(A, NotB, C, "", null, MDFrom) };
        }
    }
    if dyn_cast(I.getOperand(0)) {
        LHS;
    } else if dyn_cast(I.getOperand(1)) {
        RHS;
    } else if self.foldXorOfICmps(LHS, RHS, I) {
        V;
    } else {
        return self.replaceInstUsesWith(I, V);
    }
    if self.foldCastedBitwiseLogic(I) {
        CastedXor;
    } else {
        return CastedXor;
    }
    if canonicalizeAbs(I, self.Builder) {
        Abs;
    } else {
        return Abs;
    }
    if match(&mut I, m_c_Xor(m_OneUse(m_Xor(m_Value(X, m_Unless(m_ConstantExpr())), m_ImmConstant(C1))), m_Value(Y))) {
        return CreateXor(self.Builder.CreateXor(X, Y, ""), C1, "");
    }
    if reassociateForUses(I, self.Builder) {
        R;
    } else {
        return R;
    }
    if canonicalizeLogicFirst(I, self.Builder) {
        Canonicalized;
    } else {
        return Canonicalized;
    }
    if self.foldLogicOfIsFPClass(I, Op0, Op1) {
        Folded;
    } else {
        return Folded;
    }
    if self.canonicalizeConditionalNegationViaMathToSelect(I) {
        Folded;
    } else {
        return Folded;
    }
    if self.foldBinOpOfDisplacedShifts(I) {
        Res;
    } else {
        return Res;
    }
    if foldBitwiseLogicWithIntrinsics(I, self.Builder) {
        Res;
    } else {
        return Res;
    }
    if foldMaskedAddXorPattern(I, self.Builder) {
        Res;
    } else {
        return Res;
    }
    return null;
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, C1: *APInt, C2: *APInt) -> bool {
        return (*C1 & *C2) == *C1;
    }

struct Closure_2 {}

fn Closure_2::call(self: *Closure_2, C1: *APInt, C2: *APInt) -> bool {
        return (*C1 & *C2) == *C2;
    }

struct Closure_3 {
    PredL: *mut Predicate,
    ConstB: *mut *APInt,
    OldConstC: *mut *APInt,
    PredR: *mut Predicate,
    ConstD: *mut *APInt,
    OldConstE: *mut *APInt,
    LHS: *mut *mut Value,
    IsAnd: *mut bool,
    Builder: *mut BuilderTy,
    A: *mut *mut Value,
}

unsafe fn Closure_3::call(self: *mut Closure_3, CC: Predicate, IsNot: bool) -> auto {
                CC = if IsNot { getInversePredicate(CC) } else { CC };
                let mut ConstC: APInt = if (*self.PredL) != CC { *(*self.ConstB) ^ *(*self.OldConstC) } else { *(*self.OldConstC) };
                let mut ConstE: APInt = if (*self.PredR) != CC { *(*self.ConstD) ^ *(*self.OldConstE) } else { *(*self.OldConstE) };
                if ((*(*self.ConstB) & *(*self.ConstD)) & (ConstC ^ ConstE)).getBoolValue() {
                    return if IsNot { null } else { get((*self.LHS).getType(), !(*self.IsAnd), false, false) };
                }
                if IsNot && !(*self.ConstB).isSubsetOf(*(*self.ConstD)) && !(*self.ConstD).isSubsetOf(*(*self.ConstB)) {
                    return null;
                }
                let mut BD: APInt = APInt {};
                let mut CE: APInt = APInt {};
                if IsNot {
                    BD = *(*self.ConstB) & *(*self.ConstD);
                    CE = ConstC & ConstE;
                } else {
                    BD = *(*self.ConstB) | *(*self.ConstD);
                    CE = ConstC | ConstE;
                }
                let mut NewAnd: *mut Value = (*self.Builder).CreateAnd((*self.A), BD, "");
                let mut CEVal: *mut Value = get((*self.A).getType(), CE);
                return (*self.Builder).CreateICmp(CC, NewAnd, CEVal, "");
            }

struct Closure_4 {}

fn Closure_4::call(self: *mut Closure_4, Pred: CmpPredicate, LHS: *mut Value, RHS: *mut Value, X: *mut *mut Value, SignBitMask: *mut APInt) -> auto {
        let mut I01: *APInt = null;
        let mut I1: *APInt = null;
        if Pred != ICMP_ULT || !match(LHS, m_Add(m_Value(X), m_Power2(I01))) || !match(RHS, m_Power2(I1)) || I1.ule(*I01) || I01.shl(1) != *I1 {
            return false;
        }
        SignBitMask = *I01;
        return true;
    }

struct Closure_5 {}

fn Closure_5::call(self: *mut Closure_5, Pred: CmpPredicate, LHS: *mut Value, RHS: *mut Value, X: *mut *mut Value, UnsetBitsMask: *mut APInt) -> auto {
        let mut Res: optional<DecomposedBitTest> = decomposeBitTestICmp(LHS, RHS, Pred.operator llvm::CmpInst::Predicate(), false, false, true);
        if Res && operator(Res).Pred == ICMP_EQ {
            X = operator(Res).X;
            UnsetBitsMask = operator(Res).Mask;
            return true;
        }
        return false;
    }

struct Closure_6 {}

fn Closure_6::call(self: *Closure_6, B: *Value, D: *Value, E: *Value) -> bool {
        let mut BCst: *APInt = null;
        let mut DCst: *APInt = null;
        let mut ECst: *APInt = null;
        return match(B, m_APIntAllowPoison(BCst)) && match(D, m_APInt(DCst)) && match(E, m_APInt(ECst)) && *DCst == *ECst && (isa(B) || (BCst.countLeadingOnes() == DCst.countLeadingZeros()));
    }

struct Closure_7 {
    Q: *mut SimplifyQuery,
}

unsafe fn Closure_7::call(self: *mut Closure_7, NonZero: *mut *mut Value, Other: *mut *mut Value) -> bool {
        if !isKnownNonZero(NonZero, (*self.Q), 0) {
            swap(NonZero, Other);
        }
        return isKnownNonZero(NonZero, (*self.Q), 0);
    }

struct Closure_8 {
    Pred: *mut Predicate,
}

unsafe fn Closure_8::call(self: *mut Closure_8, CmpV: *mut Value, OpNo: u32) -> auto {
        assert!(CmpV.getType().isIntOrIntVectorTy(1), "Must be bool");
        let mut X: *mut Value = null;
        let mut Y: *mut Value = null;
        if if (*self.Pred) == ICMP_NE { match(CmpV, m_Trunc(m_Xor(m_Value(X), m_Value(Y)))) } else { match(CmpV, m_Not(m_Trunc(m_Xor(m_Value(X), m_Value(Y))))) } {
            return IntPart { From: if OpNo == 0 { X } else { Y }, StartBit: 0, NumBits: 1 };
        }
        let mut Cmp: *mut ICmpInst = dyn_cast(CmpV);
        if !Cmp {
            return nullopt;
        }
        if (*self.Pred) == Cmp.getPredicate() {
            return matchIntPart(Cmp.getOperand(OpNo));
        }
        let mut C: *APInt = null;
        if (*self.Pred) == ICMP_EQ && Cmp.getPredicate() == ICMP_ULT {
            if !match(Cmp.getOperand(1), m_Power2(C)) || !match(Cmp.getOperand(0), m_Xor(m_Value(), m_Value())) {
                return nullopt;
            }
        } else if (*self.Pred) == ICMP_NE && Cmp.getPredicate() == ICMP_UGT {
            if !match(Cmp.getOperand(1), m_LowBitMask(C)) || !match(Cmp.getOperand(0), m_Xor(m_Value(), m_Value())) {
                return nullopt;
            }
        } else {
            return nullopt;
        }
        let mut From: u32 = if (*self.Pred) == ICMP_NE { C.popcount() } else { C.countr_zero() };
        let mut I: *mut Instruction = cast(Cmp.getOperand(0));
        return IntPart { From: I.getOperand(OpNo), StartBit: From, NumBits: C.getBitWidth() - From };
    }

struct Closure_9 {}

fn Closure_9::call(self: *mut Closure_9, Pred: CmpPredicate, LHS: *mut Value, RHS: *mut Value) -> auto {
        let mut C: *APInt = null;
        if !match(RHS, m_APInt(C)) {
            return nullopt;
        }
        let mut X: *mut Value = null;
        let mut Mask: *APInt = null;
        if isEquality(Pred.operator llvm::CmpInst::Predicate()) && match(LHS, m_OneUse(m_And(m_Value(X), m_NegatedPower2(Mask)))) && C.countr_zero() >= Mask.countr_zero() {
            let mut CR: ConstantRange = ConstantRange { Lower: *C, Upper: *C - *Mask };
            if Pred == ICMP_NE {
                CR = CR.inverse();
            }
            return make_pair(X, CR);
        }
        let mut CR: ConstantRange = makeExactICmpRegion(Pred.operator llvm::CmpInst::Predicate(), *C);
        let mut C1: *APInt = null;
        if match(LHS, m_AddLike(m_Value(X), m_APInt(C1))) {
            return make_pair(X, CR.subtract(*C1));
        }
        return make_pair(LHS, CR);
    }

struct Closure_10 {}

fn Closure_10::call(self: *Closure_10, arg: *mut CallInst) {}

struct Closure_11 {}

fn Closure_11::call(self: *Closure_11, Pred: Predicate) -> bool {
            match Pred {
                FCMP_OLT => {
                    FCMP_OLE;
                },
                _ => {
                    return false;
                },
            }
        }

struct Closure_12 {}

fn Closure_12::call(self: *Closure_12, arg: *mut CallInst) {}

struct Closure_13 {
    cap_0: *mut InstCombinerImpl,
    LogicOpc: *mut BinaryOps,
}

unsafe fn Closure_13::call(self: *mut Closure_13, Op0: *mut Value, Op1: *mut Value) -> auto {
        let mut A: *mut Value = null;
        let mut IsMatched: bool = match(Op0, m_OneUse(m_LShr(m_Value(A), m_SpecificInt(Op0.getType().getScalarSizeInBits() - 1)))) && match(Op1, m_OneUse(m_ZExt(m_ICmp(m_Value(), m_Value()))));
        if !IsMatched {
            return null;
        }
        let mut ICmpL: *mut Value = self.Builder.CreateICmpSLT(A, getNullValue(A.getType()), "");
        let mut ICmpR: *mut Value = cast(Op1).getOperand(0);
        let mut BitwiseOp: *mut Value = self.Builder.CreateBinOp((*self.LogicOpc), ICmpL, ICmpR, "", null);
        return ZExtInst { BitwiseOp, Op0.getType(), "", null };
    }

struct Closure_14 {
    Opcode: BinaryOps,
    FlippedOpcode: BinaryOps,
}

fn Closure_14::call(self: *Closure_14) {
        if CountUses && !Op.hasOneUse() {
            return false;
        }
        if match(Op, m_c_BinOp(self.FlippedOpcode, m_Value(X, m_Not(m_c_BinOp(self.Opcode, m_A, m_B))), m_C)) {
            return !CountUses || X.hasOneUse();
        }
        return false;
    }

struct Closure_15 {}

fn Closure_15::call(self: *Closure_15, B: *mut BinaryOperator) -> bool {
            match B.getOpcode() {
                Xor => {
                    Or;
                },
                _ => {
                    return false;
                },
            }
        }

struct Closure_16 {
    cap_0: *mut InstCombinerImpl,
    Or: *mut Instruction,
    ShVal0: *mut *mut Value,
    ShVal1: *mut *mut Value,
}

unsafe fn Closure_16::call(self: *mut Closure_16, L: *mut Value, R: *mut Value, Width: u32) -> auto {
            let mut LI: *APInt = null;
            let mut RI: *APInt = null;
            if match(L, m_APIntAllowPoison(LI)) && match(R, m_APIntAllowPoison(RI)) {
                if LI.ult(Width) && RI.ult(Width) && (*LI + *RI) == Width {
                    return get(L.getType(), *LI);
                }
            }
            let mut LC: *mut Constant = null;
            let mut RC: *mut Constant = null;
            if match(L, m_Constant(LC)) && match(R, m_Constant(RC)) && match(L, m_SpecificInt_ICMP(ICMP_ULT, APInt { Width, Width, false, false })) && match(R, m_SpecificInt_ICMP(ICMP_ULT, APInt { Width, Width, false, false })) && match(getAdd(LC, RC, false, false), m_SpecificIntAllowPoison(Width)) {
                return mergeUndefsWith(LC, RC);
            }
            if match(R, m_OneUse(m_Sub(m_SpecificInt(Width), m_Specific(L)))) {
                let mut KnownL: KnownBits = self.computeKnownBits(L, &mut (*self.Or), 0);
                return if KnownL.getMaxValue().ult(Width) { L } else { null };
            }
            if (*self.ShVal0) != (*self.ShVal1) {
                return null;
            }
            if !isPowerOf2_32(Width) {
                return null;
            }
            let mut X: *mut Value = null;
            let mut Mask: u32 = Width - 1;
            if match(L, m_And(m_Value(X), m_SpecificInt(Mask))) && match(R, m_And(m_Neg(m_Specific(X)), m_SpecificInt(Mask))) {
                return X;
            }
            {
                let mut XPlusOne: *mut Value = null;
                if match(L, m_And(m_Value(XPlusOne, m_Add(m_Value(X), m_One())), m_SpecificInt(Mask))) && match(R, m_Xor(m_And(m_Specific(X), m_SpecificInt(Mask)), m_SpecificInt(Mask))) {
                    return XPlusOne;
                }
            }
            if match(R, m_And(m_Neg(m_Specific(L)), m_SpecificInt(Mask))) {
                return L;
            }
            if match(L, m_ZExt(m_And(m_Value(X), m_SpecificInt(Mask)))) && match(R, m_And(m_Neg(m_ZExt(m_And(m_Specific(X), m_SpecificInt(Mask)))), m_SpecificInt(Mask))) {
                return L;
            }
            if match(L, m_ZExt(m_And(m_Value(X), m_SpecificInt(Mask)))) && match(R, m_ZExt(m_And(m_Neg(m_Specific(X)), m_SpecificInt(Mask)))) {
                return L;
            }
            return null;
        }

struct Closure_18 {}

fn Closure_18::call(self: *Closure_18, arg: *mut CallInst) {}

struct Closure_17 {
    Builder: *mut BuilderTy,
    Ty: *mut *mut Type,
    HalfWidth: *mut u32,
}

unsafe fn Closure_17::call(self: *mut Closure_17, id: ID, Lo: *mut Value, Hi: *mut Value) -> *mut Value {
        let mut NewLower: *mut Value = (*self.Builder).CreateZExt(Lo, (*self.Ty), "", false);
        let mut NewUpper: *mut Value = (*self.Builder).CreateZExt(Hi, (*self.Ty), "", false);
        NewUpper = (*self.Builder).CreateShl(NewUpper, (*self.HalfWidth), "", false, false);
        let mut BinOp: *mut Value = (*self.Builder).CreateDisjointOr(NewLower, NewUpper, "");
        return (*self.Builder).CreateIntrinsic(id, (*self.Ty), BinOp, FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_18 {}, null, null });
    }

struct Closure_19 {
    LHS0: *mut Value,
    CInt: *APInt,
}

fn Closure_19::call(self: *Closure_19, RHSOp: *Value) -> bool {
        return match(RHSOp, m_Add(m_Specific(self.LHS0), m_SpecificIntAllowPoison(operator(*self.CInt)))) || (self.CInt.isZero() && RHSOp == self.LHS0);
    }

struct Closure_20 {
    A: *mut *mut Value,
    B: *mut *mut Value,
}

unsafe fn Closure_20::call(self: *mut Closure_20, Lhs: *mut Value, Rhs: *mut Value) -> auto {
            if match(Lhs, m_c_Xor(m_And(m_Value((*self.A)), m_Value((*self.B))), m_Deferred((*self.A)))) && match(Rhs, m_c_Xor(m_And(m_Specific((*self.A)), m_Specific((*self.B))), m_Specific((*self.B)))) {
                return CreateXor((*self.A), (*self.B), "");
            }
            return null;
        }

struct Closure_21 {}

fn Closure_21::call(self: *Closure_21, arg: *mut CallInst) {}

struct Closure_22 {
    NotY: *mut Value,
}

fn Closure_22::call(self: *Closure_22, U: *mut Use) -> bool {
                        return U.getUser() != self.NotY;
                    }

struct Closure_23 {}

fn Closure_23::call(self: *Closure_23, A: *mut Value, B: *mut Value, C: *mut Value, D: *mut Value) -> bool {
        return A == C || A == D || B == C || B == D;
    }

struct Closure_24 {
    NotOp: *mut Value,
}

fn Closure_24::call(self: *Closure_24, U: *mut Use) -> bool {
        return U.getUser() != self.NotOp;
    }
