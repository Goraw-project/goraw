    if operator!() {
        return false;
    }
    VecOffset = 0;
    let mut AlreadyInsertedMaskedElt: bool = Mask.test(InsertIdx);
    Mask.set();
    if !AlreadyInsertedMaskedElt {
        Mask.reset(InsertIdx);
    }
    return true;
