    let mut ShuffleMask: i32 = Mask.len;
    let mut MaskedVec: *mut Value = Builder()(LhsVec, getNullValue(LhsVec.getType()), I.getName + ".v");
    return Create(BitCast, MaskedVec, I.getType);
}

fn matchZExtedSubInteger(V: *mut Value, Int: *mut *mut Value, Mask: *mut APInt, Offset: *mut u64, IsShlNUW: *mut bool, IsShlNSW: *mut bool) -> bool {
