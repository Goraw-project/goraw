        A = RHS0;
        PredR = getSwapped(PredR);
    } else {
        return null;
    }
    if operator!(match(LHS0, m_c_Add(m_Specific(A), m_Value(B)))) || !(LHSOneUse || RHSOneUse) {
        return null;
