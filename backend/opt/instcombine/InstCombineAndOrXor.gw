            if (*self.ShVal0) != (*self.ShVal1) {
                return null;
            }
            if !isPowerOf2_32(Width) {
                return null;
            }
            let mut X: *mut Value = null;
            let mut Mask: u32 = Width - 1;
            if match(L, m_And(m_Value(X))) && match(R, m_And(m_Neg(m_Specific(X)))) {
                return X;
            }
            {
                let mut XPlusOne: *mut Value = null;
                if match(L, m_And(m_Value(XPlusOne, m_Add(m_Value(X))))) && match(R, m_Xor(m_And(m_Specific(X)))) {
                    return XPlusOne;
                }
            }
            if match(R, m_And(m_Neg(m_Specific(L)))) {
                return L;
            }
            if match(L, m_ZExt(m_And(m_Value(X)))) && match(R, m_And(m_Neg(m_ZExt(m_And(m_Specific(X)))))) {
                return L;
            }
            if match(L, m_ZExt(m_And(m_Value(X)))) && match(R, m_ZExt(m_And(m_Neg(m_Specific(X))))) {
                return L;
            }
            return null;
        }

struct Closure_15 {
    Builder: *mut BuilderTy,
    Ty: *mut *mut Type,
    HalfWidth: *mut u32,
}

unsafe fn Closure_15::call(self: *mut Closure_15, id: ID, Lo: *mut Value, Hi: *mut Value) -> auto {
        let mut NewLower: *mut Value = (*self.Builder)()(Lo, (*self.Ty));
        let mut NewUpper: *mut Value = (*self.Builder)()(Hi, (*self.Ty));
        NewUpper = (*self.Builder)()(NewUpper, (*self.HalfWidth));
        let mut BinOp: *mut Value = (*self.Builder)()(NewLower, NewUpper);
    }

struct Closure_16 {
    LHS0: *mut Value,
    CInt: *APInt,
}

fn Closure_16::call(self: *Closure_16, RHSOp: *Value) -> auto {}

struct Closure_17 {
    A: *mut *mut Value,
    B: *mut *mut Value,
}

unsafe fn Closure_17::call(self: *mut Closure_17, Lhs: *mut Value, Rhs: *mut Value) -> auto {
            if match(Lhs, m_c_Xor(m_And(m_Value((*self.A)), m_Value((*self.B))))) && match(Rhs, m_c_Xor(m_And(m_Specific((*self.A)), m_Specific((*self.B))), m_Specific((*self.B)))) {}
            return null;
        }

struct Closure_18 {}

fn Closure_18::call(self: *Closure_18, A: *mut Value, B: *mut Value, C: *mut Value, D: *mut Value) -> bool {
        return A == C || A == D || B == C || B == D;
    }
