fn matchIsNotNaN(P: Predicate, LHS: *mut Value, RHS: *mut Value) -> bool {
    return P == FCMP_ORD && match(RHS);
}

fn matchUnorderedInfCompare(P: Predicate, LHS: *mut Value, RHS: *mut Value) -> bool {
    return isUnordered(P) && match(RHS);
}

fn matchIsFiniteTest(Builder: *mut BuilderTy, LHS: *mut FCmpInst, RHS: *mut FCmpInst) -> *mut Value {
    let mut LHS0: *mut Value = LHS.getOperand;
    let mut LHS1: *mut Value = LHS.getOperand;
    let mut RHS0: *mut Value = RHS.getOperand;
    let mut RHS1: *mut Value = RHS.getOperand;
    let mut PredL: Predicate = LHS.getPredicate;
    let mut PredR: Predicate = RHS.getPredicate;
    if !matchIsNotNaN(PredL, LHS0, LHS1) || !matchUnorderedInfCompare(PredR, RHS0, RHS1) {
        return null;
    }
    return Builder()(getOrderedPredicate(PredR), RHS0, RHS1, intersect(LHS, RHS));
}

fn InstCombinerImpl::foldLogicOfFCmps(self, LHS: *mut FCmpInst, RHS: *mut FCmpInst, IsAnd: bool, IsLogicalSelect: bool) -> *mut Value {
    let mut LHS0: *mut Value = LHS.getOperand;
    let mut LHS1: *mut Value = LHS.getOperand;
    let mut RHS0: *mut Value = RHS.getOperand;
    let mut RHS1: *mut Value = RHS.getOperand;
    let mut PredL: Predicate = LHS.getPredicate;
    let mut PredR: Predicate = RHS.getPredicate;
    if LHS0 == RHS1 && RHS0 == LHS1 {
        PredR = getSwappedPredicate(PredR);
        swap(RHS0, RHS1);
    }
    if LHS0 == RHS0 && LHS1 == RHS1 {
        let mut FCmpCodeL: u32 = getFCmpCode(PredL);
        let mut FCmpCodeR: u32 = getFCmpCode(PredR);
        let mut NewPred: u32 = if IsAnd { FCmpCodeL & FCmpCodeR } else { FCmpCodeL | FCmpCodeR };
        return getFCmpValue(NewPred, LHS0, LHS1, intersect(LHS, RHS));
    }
    if (PredL == FCMP_ORD && PredR == FCMP_ORD && IsAnd) || (PredL == FCMP_UNO && PredR == FCMP_UNO && !IsAnd) {
        if LHS0.getType() != RHS0.getType() {
            return null;
        }
        if match(LHS1) && match(RHS1) {
            let mut Y: *mut Value = RHS0;
            let mut FMF: FastMathFlags = LHS.getFastMathFlags & RHS.getFastMathFlags;
            if IsLogicalSelect {
                FMF.setNoNaNs(false);
                FMF.setNoInfs(false);
            }
        }
    }
    if !IsLogicalSelect && IsAnd && stripSignOnlyFPOps(LHS0) == stripSignOnlyFPOps(RHS0) {
        if matchIsFiniteTest(LHS, RHS) {
            Left;
        } else {
            return Left;
        }
        if matchIsFiniteTest(RHS, LHS) {
            Right;
        } else {
            return Right;
        }
    }
    if LHS.hasOneUse && RHS.hasOneUse {
        if  {
            if  {
                let mut CombinedMask: u32 = 0;
            }
        }
    }
    let mut LHSC: *APFloat = null;
    let mut RHSC: *APFloat = null;
    if LHS0 == RHS0 && LHS.hasOneUse && RHS.hasOneUse && getSwappedPredicate(PredL) == PredR && match(LHS1) && match(RHS1) && LHSC.bitwiseIsEqual(neg(*RHSC)) {
        let mut IsLessThanOrLessEqual: Closure_10 = Closure_10 {};
        if IsLessThanOrLessEqual.call(if IsAnd { PredR } else { PredL }) {
            swap(LHSC, RHSC);
            swap(PredL, PredR);
        }
        if IsLessThanOrLessEqual.call(if IsAnd { PredL } else { PredR }) {
            let mut NewFlag: FastMathFlags = LHS.getFastMathFlags;
            if !IsLogicalSelect {
                operator|=(NewFlag, RHS.getFastMathFlags);
            }
            let mut FAbs: *mut Value = null;
        }
    }
    return null;
}

fn matchIsFPClassLikeFCmp(Op: *mut Value, ClassVal: *mut *mut Value, ClassMask: *mut u64) -> bool {
    let mut FCmp: *mut auto = dyn_cast(Op);
    if operator!() || operator!() {
        return false;
    }
    return ClassVal != null;
}

fn InstCombinerImpl::foldLogicOfIsFPClass(self, BO: *mut BinaryOperator, Op0: *mut Value, Op1: *mut Value) -> *mut Instruction {
    let mut ClassVal0: *mut Value = null;
    let mut ClassVal1: *mut Value = null;
    let mut ClassMask0: u64 = 0;
    let mut ClassMask1: u64 = 0;
    let mut IsLHSClass: bool = match(Op0, m_OneUse(m_Intrinsic(m_Value(ClassVal0), m_ConstantInt(ClassMask0))));
    let mut IsRHSClass: bool = match(Op1, m_OneUse(m_Intrinsic(m_Value(ClassVal1), m_ConstantInt(ClassMask1))));
    if (((IsLHSClass || matchIsFPClassLikeFCmp(Op0, ClassVal0, ClassMask0)) && (IsRHSClass || matchIsFPClassLikeFCmp(Op1, ClassVal1, ClassMask1)))) && ClassVal0 == ClassVal1 {
        let mut NewClassMask: u32 = 0;
        match BO.getOpcode() {
            And => {
                NewClassMask = ClassMask0 & ClassMask1;
            },
            Or => {
                NewClassMask = ClassMask0 | ClassMask1;
            },
            Xor => {
                NewClassMask = ClassMask0 ^ ClassMask1;
            },
            _ => {
                llvm_unreachable_internal("not a binary logic operator", "llvm\\lib\\Transforms\\InstCombine\\InstCombineAndOrXor.cpp", 1636);
            },
        }
        if IsLHSClass {
            let mut II: *mut auto = cast(Op0);
            II()(1, get((1)(), NewClassMask));
            return self.replaceInstUsesWith(BO);
        }
        if IsRHSClass {
            let mut II: *mut auto = cast(Op1);
            II()(1, get((1)(), NewClassMask));
            return self.replaceInstUsesWith(BO);
        }
        let mut NewClass: *mut Value = null;
        return self.replaceInstUsesWith;
    }
    return null;
}

fn InstCombinerImpl::canonicalizeConditionalNegationViaMathToSelect(self, I: *mut BinaryOperator) -> *mut Instruction {
    assert!(I.getOpcode() == Xor, "Only for xor!");
    let mut Cond: *mut Value = null;
    let mut X: *mut Value = null;
    if operator!(match(&mut I, m_c_BinOp(m_OneUse(m_Value()), m_Value()))) || operator!(match(I.getOperand(1), m_SExt(m_Value(Cond)))) || !Cond.getType().isIntOrIntVectorTy(1) || operator!(match(I.getOperand(0), m_c_Add(m_SExt(m_Specific(Cond)), m_Value(X)))) {
        return null;
    }
    return self.createSelectInstWithUnknownProfile;
}

fn reassociateFCmps(BO: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Opcode: BinaryOps = BO.getOpcode();
    assert!((Opcode == And || Opcode == Or), "Expecting and/or op for fcmp transform");
    let mut Op0: *mut Value = BO.getOperand(0);
    let mut Op1: *mut Value = BO.getOperand(1);
    let mut X: *mut Value = null;
    if match(Op1, m_FCmp(m_Value())) {
        swap(Op0, Op1);
    }
    let mut BO10: *mut Value = null;
    let mut BO11: *mut Value = null;
    let mut NanPred: Predicate = if Opcode == And { FCMP_ORD } else { FCMP_UNO };
    if operator!(match(Op0, m_SpecificFCmp(NanPred, m_Value(X)))) || operator!(match(Op1, m_BinOp(Opcode, m_Value(BO10), m_Value(BO11)))) {
        return null;
    }
    let mut Y: *mut Value = null;
    if operator!(match(BO10, m_SpecificFCmp(NanPred, m_Value(Y)))) || X.getType() != Y.getType() {
        swap(BO10, BO11);
    }
    if operator!(match(BO10, m_SpecificFCmp(NanPred, m_Value(Y)))) || X.getType() != Y.getType() {
        return null;
    }
    let mut NewFCmp: *mut Value = Builder()(NanPred, X, Y, intersect(Op0, BO10));
    return Create(Opcode, NewFCmp, BO11, "", null);
}

fn matchDeMorgansLaws(I: *mut BinaryOperator, IC: *mut InstCombiner) -> *mut Instruction {
    let mut Opcode: BinaryOps = I.getOpcode();
    assert!((Opcode == And || Opcode == Or), "Trying to match De Morgan's Laws with something other than and/or");
    let mut FlippedOpcode: BinaryOps = if (Opcode == And) { Or } else { And };
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    if match(Op0, m_OneUse(m_Not(m_Value(A)))) && match(Op1, m_OneUse(m_Not(m_Value(B)))) && !IC.isFreeToInvert(A, A.hasOneUse()) && !IC.isFreeToInvert(B, B.hasOneUse()) {
        let mut AndOr: *mut Value = IC()(FlippedOpcode, A, B, I.getName + ".demorgan");
        return CreateNot(AndOr, "", null);
    }
    let mut C: *mut Value = null;
    if match(Op0, m_OneUse(m_c_BinOp(Opcode, m_Value(A), m_Not(m_Value(B))))) && match(Op1, m_Not(m_Value(C))) {
        let mut FlippedBO: *mut Value = IC()(FlippedOpcode, B, C);
        return Create(Opcode, A, IC()(FlippedBO));
    }
    return null;
}

fn InstCombinerImpl::shouldOptimizeCast(self, CI: *mut CastInst) -> bool {
    let mut CastSrc: *mut Value = CI.getOperand;
    if CI.getSrcTy() == CI.getDestTy() || isa(CastSrc) {
        return false;
    }
    if  {
        if self.isEliminableCastPair(CI) {
            return false;
        }
    }
    return true;
}

fn foldLogicCastConstant(Logic: *mut BinaryOperator, Cast: *mut CastInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut C: *mut Constant = dyn_cast(Logic.getOperand(1));
    if !C {
        return null;
    }
    let mut LogicOpc: BinaryOps = Logic.getOpcode();
    let mut DestTy: *mut Type = Logic.getType;
    let mut SrcTy: *mut Type = Cast.getSrcTy();
    let mut X: *mut Value = null;
    let mut DL: *mut auto = IC.getDataLayout;
    if match(Cast, m_OneUse(m_ZExt(m_Value(X)))) {
        let mut Flags: PreservedCastFlags = PreservedCastFlags {};
        if getLosslessUnsignedTrunc(C, SrcTy, &mut Flags) {
            TruncC;
        } else {
            let mut NewOp: *mut Value = IC()(LogicOpc, X, TruncC);
            let mut ZExt: *mut auto = ZExtInst { NewOp, DestTy, "", null };
            ZExt()(Flags.NNeg);
            ZExt()(Cast);
            return ;
        }
    }
    if match(Cast, m_OneUse(m_SExtLike(m_Value(X)))) {
        if getLosslessSignedTrunc(C, SrcTy) {
            TruncC;
        } else {
            let mut NewOp: *mut Value = IC()(LogicOpc, X, TruncC);
            return SExtInst { NewOp, DestTy, "", null };
        }
    }
    return null;
}

fn InstCombinerImpl::foldCastedBitwiseLogic(self, I: *mut BinaryOperator) -> *mut Instruction {
    let mut LogicOpc: BinaryOps = I.getOpcode();
    assert!(I, "Unexpected opcode for bitwise logic folding");
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut FoldBitwiseICmpZeroWithICmp: Closure_11 = Closure_11 { cap_0: self, LogicOpc: &mut LogicOpc };
    if FoldBitwiseICmpZeroWithICmp.call(Op0, Op1) {
        Ret;
    } else {
        return Ret;
    }
    if FoldBitwiseICmpZeroWithICmp.call(Op1, Op0) {
        Ret;
    } else {
        return Ret;
    }
    let mut Cast0: *mut CastInst = dyn_cast(Op0);
    if !Cast0 {
        return null;
    }
    let mut DestTy: *mut Type = I.getType;
    let mut SrcTy: *mut Type = Cast0.getSrcTy();
    if !SrcTy.isIntOrIntVectorTy() {
        return null;
    }
    if foldLogicCastConstant(I, Cast0, *self) {
        Ret;
    } else {
        return Ret;
    }
    let mut Cast1: *mut CastInst = dyn_cast(Op1);
    if !Cast1 {
        return null;
    }
    let mut CastOpcode: CastOps = Cast0.getOpcode();
    if CastOpcode != Cast1.getOpcode() {
        return null;
    }
    if operator!(Cast0.hasOneUse) && operator!(Cast1.hasOneUse) {
        return null;
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(Cast0, m_ZExtOrSExt(m_Value(X))) && match(Cast1, m_ZExtOrSExt(m_Value(Y))) {
        let mut XNumBits: u32 = X.getType().getScalarSizeInBits();
        let mut YNumBits: u32 = Y.getType().getScalarSizeInBits();
        if XNumBits != YNumBits {
            if operator!(Cast0.hasOneUse) || operator!(Cast1.hasOneUse) {
                return null;
            }
            if XNumBits < YNumBits {} else if YNumBits < XNumBits {}
        }
        let mut NarrowLogic: *mut Value = null;
        let mut Disjoint: *mut auto = dyn_cast(&mut I);
        let mut NewDisjoint: *mut auto = dyn_cast(NarrowLogic);
        if Disjoint() &&  {
            NewDisjoint()();
        }
        return Create(CastOpcode, NarrowLogic, DestTy, "", null);
    }
    if SrcTy != Cast1.getSrcTy() {
        return null;
    }
    let mut Cast0Src: *mut Value = Cast0.getOperand;
    let mut Cast1Src: *mut Value = Cast1.getOperand;
    if self.shouldOptimizeCast(Cast0) && self.shouldOptimizeCast(Cast1) {
        let mut NewOp: *mut Value = null;
        let mut NewCast: *mut auto = Create(CastOpcode, NewOp, DestTy, "", null);
        if  {
            let mut Trunc0: *mut auto = cast(Cast0);
            let mut Trunc1: *mut auto = cast(Cast1);
            NewTrunc()(if LogicOpc == And { () || () } else { () && () });
            NewTrunc()(() && ());
        }
        return ;
    }
    return null;
}

fn foldAndToXor(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    assert!(I.getOpcode() == And);
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    if match(&mut I, m_BinOp(m_Or(m_Value(A), m_Value(B)), m_Not(m_c_And()))) {
        return CreateXor(A, B, "");
    }
    if Op0.hasOneUse() || Op1.hasOneUse() {
        if match(&mut I, m_BinOp(m_c_Or(m_Value(A), m_Not(m_Value(B))), m_c_Or(m_Not()))) {
            return CreateNot(Builder()(A, B));
        }
    }
    return null;
}

fn foldOrToXor(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    assert!(I.getOpcode() == Or);
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    if Op0.hasOneUse() || Op1.hasOneUse() {
        if match(Op0, m_And(m_Value(A), m_Value(B))) && match(Op1, m_Not(m_c_Or(m_Specific(A), m_Specific(B)))) {
            return CreateNot(Builder()(A, B));
        }
    }
    if Op0.hasOneUse() || Op1.hasOneUse() {
        if match(Op0, m_Xor(m_Value(A), m_Value(B))) && match(Op1, m_Not(m_c_Or(m_Specific(A), m_Specific(B)))) {
            return CreateNot(Builder()(A, B));
        }
    }
    if match(Op0, m_c_And(m_Value(A), m_Not(m_Value(B)))) && match(Op1, m_c_And(m_Not(m_Specific(A)), m_Specific(B))) {
        return CreateXor(A, B, "");
    }
    return null;
}

fn canNarrowShiftAmt(C: *mut Constant, BitWidth: u32) -> bool {
    let mut Threshold: APInt = APInt { C.getType().getScalarSizeInBits(), BitWidth, false, false };
    return match(C);
}

fn InstCombinerImpl::narrowMaskedBinOp(self, And: *mut BinaryOperator) -> *mut Instruction {
    let mut Op0: *mut Value = And.getOperand(0);
    let mut Op1: *mut Value = And.getOperand(1);
    let mut C: *mut Constant = null;
    if operator!(match(Op0, m_OneUse(m_Add(m_Specific(Op1))))) && operator!(match(Op0, m_OneUse(m_Mul(m_Specific(Op1))))) && operator!(match(Op0, m_OneUse(m_LShr(m_Specific(Op1))))) && operator!(match(Op0, m_OneUse(m_Shl(m_Specific(Op1))))) && operator!(match(Op0, m_OneUse(m_Sub(m_Specific(Op1))))) {
        return null;
    }
    let mut X: *mut Value = null;
    if operator!(match(Op1, m_ZExt(m_Value(X)))) || Op1.hasNUsesOrMore(3) {
        return null;
    }
    let mut Ty: *mut Type = And.getType;
    if !isa(Ty) && !self.shouldChangeType(Ty, X.getType()) {
        return null;
    }
    let mut Opc: BinaryOps = cast(Op0)();
    if Opc == LShr || Opc == Shl {
        if !canNarrowShiftAmt(C, X.getType().getScalarSizeInBits()) {
            return null;
        }
    }
    let mut NewC: *mut Value = getTrunc(C, X.getType(), false);
    let mut NewBO: *mut Value = null;
}

fn foldComplexAndOrPatterns(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Opcode: BinaryOps = I.getOpcode();
    assert!(Opcode == And || Opcode == Or);
    let mut FlippedOpcode: BinaryOps = if (Opcode == And) { Or } else { And };
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut A: *mut Value = null;
    let mut B: *mut Value = null;
    let mut C: *mut Value = null;
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut Dummy: *mut Value = null;
    let mut matchNotOrAnd: Closure_12 = Closure_12 { Opcode: Opcode, FlippedOpcode: FlippedOpcode };
    if matchNotOrAnd(Op0, m_Value(A), m_Value(B), m_Value(C), X) {
        if matchNotOrAnd(Op1, m_Specific(A), m_Specific(C), m_Specific(B), Dummy, true) {
            let mut Xor: *mut Value = Builder()(B, C);
            return if (Opcode == Or) { CreateAnd(Xor, Builder()(A)) } else { CreateNot(Builder()(Xor, A)) };
        }
        if matchNotOrAnd(Op1, m_Specific(B), m_Specific(C), m_Specific(A), Dummy, true) {
            let mut Xor: *mut Value = Builder()(A, C);
            return if (Opcode == Or) { CreateAnd(Xor, Builder()(B)) } else { CreateNot(Builder()(Xor, B)) };
        }
        if match(Op1, m_OneUse(m_Not(m_OneUse(m_c_BinOp(Opcode, m_Specific(A), m_Specific(C)))))) {
            return CreateNot(Builder()(Opcode, Builder()(FlippedOpcode, B, C), A));
        }
        if match(Op1, m_OneUse(m_Not(m_OneUse(m_c_BinOp(Opcode, m_Specific(B), m_Specific(C)))))) {
            return CreateNot(Builder()(Opcode, Builder()(FlippedOpcode, A, C), B));
        }
        if Opcode == Or && Op0.hasOneUse() && match(Op1, m_OneUse(m_Not(m_Value(Y, m_c_BinOp(Opcode, m_Specific(C), m_c_Xor(m_Specific(A), m_Specific(B))))))) {
            let mut Or: *mut Value = cast(X)(0);
            return CreateNot(Builder()(Or, Y));
        }
    }
    if match(Op0, m_OneUse(m_c_BinOp(FlippedOpcode, m_BinOp(FlippedOpcode, m_Value(B), m_Value(C)), m_Value(X, m_Not(m_Value(A)))))) || match(Op0, m_OneUse(m_c_BinOp(FlippedOpcode, m_c_BinOp(FlippedOpcode, m_Value(C), m_Value(X, m_Not(m_Value(A)))), m_Value(B)))) {
        if match(Op1, m_OneUse(m_Not(m_c_BinOp(Opcode, m_c_BinOp(Opcode, m_Specific(A), m_Specific(B)), m_Specific(C))))) || match(Op1, m_OneUse(m_Not(m_c_BinOp(Opcode, m_c_BinOp(Opcode, m_Specific(B), m_Specific(C)), m_Specific(A))))) || match(Op1, m_OneUse(m_Not(m_c_BinOp(Opcode, m_c_BinOp(Opcode, m_Specific(A), m_Specific(C)), m_Specific(B))))) {
            let mut Xor: *mut Value = Builder()(B, C);
            return if (Opcode == Or) { CreateNot(Builder()(Xor, A)) } else { CreateOr(Xor, X, "") };
        }
        if match(Op1, m_OneUse(m_Not(m_OneUse(m_c_BinOp(Opcode, m_Specific(A), m_Specific(B)))))) {
            return Create(FlippedOpcode, Builder()(Opcode, C, Builder()(B)), X);
        }
        if match(Op1, m_OneUse(m_Not(m_OneUse(m_c_BinOp(Opcode, m_Specific(A), m_Specific(C)))))) {
            return Create(FlippedOpcode, Builder()(Opcode, B, Builder()(C)), X);
        }
    }
    return null;
}

fn reassociateForUses(BO: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Opcode: BinaryOps = BO.getOpcode();
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut Z: *mut Value = null;
    if match(&mut BO, m_c_BinOp(Opcode, m_OneUse(m_BinOp(Opcode, m_Value(X), m_Value(Y))), m_OneUse(m_Value(Z)))) {
        if !isa(X) && !isa(Y) && !isa(Z) {
            if !X.hasOneUse() {
                let mut YZ: *mut Value = Builder()(Opcode, Y, Z);
                return Create(Opcode, YZ, X, "", null);
            }
            if !Y.hasOneUse() {
                let mut XZ: *mut Value = Builder()(Opcode, X, Z);
                return Create(Opcode, XZ, Y, "", null);
            }
        }
    }
    return null;
}

fn canonicalizeLogicFirst(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut Ty: *mut Type = I.getType;
    let mut OpC: BinaryOps = I.getOpcode();
    let mut Op0: *mut Value = I.getOperand(0);
    let mut Op1: *mut Value = I.getOperand(1);
    let mut X: *mut Value = null;
    let mut C: *APInt = null;
    let mut C2: *APInt = null;
    if operator!((match(Op0, m_OneUse(m_Add(m_Value(X)))) && match(Op1))) {
        return null;
    }
    let mut Width: u32 = Ty.getScalarSizeInBits();
    let mut LastOneMath: u32 = Width - C2.countr_zero();
    match OpC {
        And => {
            if C.countl_one() < LastOneMath {
                return null;
            }
        },
        Xor => {
            Or;
        },
        _ => {
            llvm_unreachable_internal("Unexpected BinaryOp!", "llvm\\lib\\Transforms\\InstCombine\\InstCombineAndOrXor.cpp", 2255);
        },
    }
    let mut NewBinOp: *mut Value = Builder()(OpC, X, get(Ty, *C));
    return CreateWithCopiedFlags(Add, NewBinOp, get(Ty, *C2), Op0, "", null);
}

fn InstCombinerImpl::foldBinOpOfDisplacedShifts(self, I: *mut BinaryOperator) -> *mut Instruction {
    assert!((I || I.getOpcode() == Add), "Unexpected opcode");
    let mut ShAmt: *mut Value = null;
    let mut ShiftedC1: *mut Constant = null;
    let mut ShiftedC2: *mut Constant = null;
    let mut AddC: *mut Constant = null;
    let mut Ty: *mut Type = I.getType;
    let mut BitWidth: u32 = Ty.getScalarSizeInBits();
    if operator!(match(&mut I, m_c_BinOp(m_Shift(m_ImmConstant(ShiftedC1), m_Value(ShAmt)), m_Shift(m_ImmConstant(ShiftedC2), m_AddLike(m_ImmConstant(AddC)))))) {
        return null;
    }
    if operator!(match(AddC)) {
        return null;
    }
    let mut Op0Inst: *mut auto = dyn_cast(I.getOperand(0));
    let mut Op1Inst: *mut auto = dyn_cast(I.getOperand(1));
    if operator!() || operator!() {
        return null;
    }
    let mut ShiftOp: BinaryOps = () as BinaryOps;
    if ShiftOp != () {
        return null;
    }
    if I.getOpcode() == Add && ShiftOp != Shl {
        return null;
    }
    let mut NewC: *mut Value = null;
    return Create(ShiftOp, NewC, ShAmt, "", null);
}

fn foldBitwiseLogicWithIntrinsics(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    assert!(I, "Should and/or/xor");
    if !I.getOperand(0).hasOneUse() {
        return null;
    }
    let mut X: *mut IntrinsicInst = dyn_cast(I.getOperand(0));
    if !X {
        return null;
    }
    let mut Y: *mut IntrinsicInst = dyn_cast(I.getOperand(1));
    if Y && (operator!(Y.hasOneUse) || X.getIntrinsicID() != Y.getIntrinsicID()) {
        return null;
    }
    let mut IID: ID = X.getIntrinsicID();
    let mut RHSC: *APInt = null;
    if !Y && (!(IID == bswap || IID == bitreverse) || operator!(match(I.getOperand(1)))) {
        return null;
    }
    match IID {
        fshl => {
            fshr;
        },
        bswap => {
            bitreverse;
        },
        _ => {
            return null;
        },
    }
}

fn simplifyAndOrWithOpReplaced(V: *mut Value, Op: *mut Value, RepOp: *mut Value, SimplifyOnly: bool, IC: *mut InstCombinerImpl, Depth: u32) -> *mut Value {
    if Op == RepOp {
        return null;
    }
    if V == Op {
        return RepOp;
    }
    let mut I: *mut auto = dyn_cast(V);
    if operator!() || operator!() || Depth >= 3 {
        return null;
    }
    if operator!() {
        SimplifyOnly = true;
    }
    let mut NewOp0: *mut Value = simplifyAndOrWithOpReplaced((0), Op, RepOp, SimplifyOnly, IC, Depth + 1);
    let mut NewOp1: *mut Value = simplifyAndOrWithOpReplaced((1), Op, RepOp, SimplifyOnly, IC, Depth + 1);
    if !NewOp0 && !NewOp1 {
        return null;
    }
    if !NewOp0 {
        NewOp0 = (0);
    }
    if !NewOp1 {
        NewOp1 = (1);
    }
    if simplifyBinOp(NewOp0, NewOp1, IC.getSimplifyQuery()) {
        Res;
    } else {
        return Res;
    }
    if SimplifyOnly {
        return null;
    }
    return IC()(NewOp0, NewOp1);
}

fn foldRoundUpToPow2Alignment(I: *mut BinaryOperator, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut NegP: *APInt = null;
    let mut Add: *mut Value = null;
    if operator!(match(&mut I, m_And(m_Value(Add)))) {
        return null;
    }
    let mut X: *mut Value = null;
    let mut Cond: *mut Value = null;
    let mut Mask: APInt = operator(*NegP);
    if operator!(match(Add, m_OneUse(m_c_Add(m_Value(X), m_Select(m_Value(Cond)))))) {
        return null;
    }
    if operator!(match(Cond, m_SpecificICmp(ICMP_EQ, m_And(m_Specific(X)), m_Zero()))) {
        return null;
    }
    let mut Ty: *mut Type = I.getType;
    let mut NewAdd: *mut Value = Builder()(X, get(Ty, Mask));
    return CreateAnd(NewAdd, get(Ty, *NegP), "");
}

fn InstCombinerImpl::reassociateBooleanAndOr(self, LHS: *mut Value, X: *mut Value, Y: *mut Value, I: *mut Instruction, IsAnd: bool, RHSIsLogical: bool) -> *mut Value {
    let mut Opcode: BinaryOps = if IsAnd { And } else { Or };
    let mut Folded: *mut Value = null;
    let mut SI: *mut SelectInst = dyn_cast_or_null(Folded);
    if SI != null {
        setExplicitlyUnknownBranchWeightsIfProfiled(*SI, "instcombine", I.getFunction());
    }
    return Folded;
}

