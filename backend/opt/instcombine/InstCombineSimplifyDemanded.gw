            self.replaceUse;
            return true;
        }
        if isa(V) {
            return false;
        }
        let mut FoldedToConst: *mut Value = getFPClassConstant(VTy, Known.getKnownFPClasses(), false);
        if !FoldedToConst || FoldedToConst == V {
            return false;
        }
        self.replaceUse;
