// Внешние системные функции libc
extern fn abort();
extern fn sqrt(x: f64) -> f64;

fn ShrinkDemandedConstant(I: *mut Instruction, OpNo: u32, Demanded: *APInt) -> bool {
    assert!(I, "No instruction?");
    assert!(OpNo < I.getNumOperands(), "Operand index too large");
    let mut Op: *mut Value = I.getOperand(OpNo);
    let mut C: *APInt = null;
    if !match(Op, m_APInt(C)) {
        return false;
    }
    if C.isSubsetOf(Demanded) {
        return false;
    }
    I.setOperand(OpNo, get(Op.getType(), *C & Demanded));
    return true;
}

fn simplifyShiftSelectingPackedElement(I: *mut Instruction, DemandedMask: *APInt, IC: *mut InstCombinerImpl, Depth: u32) -> *mut Value {
    assert!(I.getOpcode() == LShr, "Only lshr instruction supported");
    let mut ShlAmt: u64 = 0;
    let mut Upper: *mut Value = null;
    let mut Lower: *mut Value = null;
    if !match(I.getOperand(0), m_OneUse(m_c_DisjointOr(m_OneUse(m_Shl(m_Value(Upper), m_ConstantInt(ShlAmt))), m_Value(Lower)))) {
        return null;
    }
    if !isPowerOf2_64(ShlAmt) {
        return null;
    }
    let mut DemandedBitWidth: u64 = DemandedMask.getActiveBits();
    if DemandedBitWidth > ShlAmt {
        return null;
    }
    if Upper.getType().getScalarSizeInBits() < ShlAmt + DemandedBitWidth {
        return null;
    }
    let mut KnownLowerBits: KnownBits = IC.computeKnownBits(Lower, I, Depth);
    if !KnownLowerBits.getMaxValue().isIntN(ShlAmt) {
        return null;
    }
    let mut ShrAmt: *mut Value = I.getOperand(1);
    let mut KnownShrBits: KnownBits = IC.computeKnownBits(ShrAmt, I, Depth);
    if operator(KnownShrBits.Zero) != ShlAmt {
        return null;
    }
    let mut Guard: InsertPointGuard = IC.Builder;
    IC.Builder.SetInsertPoint(I);
    let mut ShrAmtZ: *mut Value = IC.Builder.CreateICmpEQ(ShrAmt, getNullValue(ShrAmt.getType()), ShrAmt.getName() + ".z");
    let mut Select: *mut Value = IC.Builder.CreateSelectWithUnknownProfile(ShrAmtZ, Lower, Upper, "instcombine", "");
    Select.takeName(I);
    return Select;
}

fn getBitWidth(Ty: *mut Type, DL: *DataLayout) -> u32 {
    if Ty.getScalarSizeInBits() {
        BitWidth;
    } else {
        return BitWidth;
    }
    return DL.getPointerTypeSizeInBits(Ty);
}

fn InstCombinerImpl::SimplifyDemandedInstructionBits(self, Inst: *mut Instruction, Known: *mut KnownBits) -> bool {
    let mut DemandedMask: APInt = getAllOnes(Known.getBitWidth());
    let mut V: *mut Value = self.SimplifyDemandedUseBits(&mut Inst, DemandedMask, Known, self.SQ.getWithInstruction(&mut Inst), 0);
    if !V {
        return false;
    }
    if V == &mut Inst {
        return true;
    }
    self.replaceInstUsesWith(Inst, V);
    return true;
}

fn InstCombinerImpl::SimplifyDemandedInstructionBits(self, Inst: *mut Instruction) -> bool {
    let mut Known: KnownBits = getBitWidth(Inst.getType(), self.DL);
    return self.SimplifyDemandedInstructionBits(Inst, Known);
}

fn InstCombinerImpl::SimplifyDemandedInstructionFPClass(self, Inst: *mut Instruction) -> bool {
    let mut Known: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
    let mut V: *mut Value = self.SimplifyDemandedUseFPClass(&mut Inst, fcAllFlags, Known, self.SQ.getWithInstruction(&mut Inst), 0);
    if !V {
        return false;
    }
    if V == &mut Inst {
        return true;
    }
    self.replaceInstUsesWith(Inst, V);
    return true;
}

fn InstCombinerImpl::SimplifyDemandedBits(self, I: *mut Instruction, OpNo: u32, DemandedMask: *APInt, Known: *mut KnownBits, Q: *SimplifyQuery, Depth: u32) -> bool {
    let mut U: *mut Use = I.getOperandUse(OpNo);
    let mut V: *mut Value = U.get();
    if isa(V) {
        computeKnownBits(V, Known, Q, Depth);
        return false;
    }
    Known.resetAll();
    if DemandedMask.isZero() {
        self.replaceUse(U, get(V.getType()));
        return true;
    }
    let mut VInst: *mut Instruction = dyn_cast(V);
    if !VInst {
        computeKnownBits(V, Known, Q, Depth);
        return false;
    }
    if Depth == MaxAnalysisRecursionDepth {
        return false;
    }
    let mut NewVal: *mut Value = null;
    if VInst.hasOneUse() {
        NewVal = self.SimplifyDemandedUseBits(VInst, DemandedMask, Known, Q, Depth);
    } else {
        NewVal = self.SimplifyMultipleUseDemandedBits(VInst, DemandedMask, Known, Q, Depth);
    }
    if !NewVal {
        return false;
    }
    if dyn_cast(U) {
        OpInst;
    } else {
        salvageDebugInfo(*OpInst);
    }
    self.replaceUse(U, NewVal);
    return true;
}

fn InstCombinerImpl::SimplifyDemandedUseBits(self, I: *mut Instruction, DemandedMask: *APInt, Known: *mut KnownBits, Q: *SimplifyQuery, Depth: u32) -> *mut Value {
    assert!(I != null, "Null pointer of Value???");
    assert!(Depth <= MaxAnalysisRecursionDepth, "Limit Search Depth");
    let mut BitWidth: u32 = DemandedMask.getBitWidth();
    let mut VTy: *mut Type = I.getType();
    assert!((!VTy.isIntOrIntVectorTy() || VTy.getScalarSizeInBits() == BitWidth) && Known.getBitWidth() == BitWidth, "Value *V, DemandedMask and Known must have same BitWidth");
    let mut LHSKnown: KnownBits = BitWidth;
    let mut RHSKnown: KnownBits = BitWidth;
    let mut disableWrapFlagsBasedOnUnusedHighBits: Closure_1 = Closure_1 {};
    let mut simplifyOperandsBasedOnUnusedHighBits: Closure_2 = Closure_2 { DemandedMask: &mut DemandedMask, BitWidth: &mut BitWidth, I: &mut I, cap_3: self, LHSKnown: &mut LHSKnown, Q: &mut Q, Depth: &mut Depth, RHSKnown: &mut RHSKnown, disableWrapFlagsBasedOnUnusedHighBits: &mut disableWrapFlagsBasedOnUnusedHighBits };
    match I.getOpcode() {
        _ => {
            computeKnownBits(I, Known, Q, Depth);
        },
        And => {
            if self.SimplifyDemandedBits(I, 1, DemandedMask, RHSKnown, Q, Depth + 1) || self.SimplifyDemandedBits(I, 0, DemandedMask & operator(RHSKnown.Zero), LHSKnown, Q, Depth + 1) {
                return I;
            }
            Known = analyzeKnownBitsFromAndXorOr(cast(I), LHSKnown, RHSKnown, Q, Depth);
            if DemandedMask.isSubsetOf(Known.Zero | Known.One) {
                return getIntegerValue(VTy, Known.One);
            }
            if DemandedMask.isSubsetOf(LHSKnown.Zero | RHSKnown.One) {
                return I.getOperand(0);
            }
            if DemandedMask.isSubsetOf(RHSKnown.Zero | LHSKnown.One) {
                return I.getOperand(1);
            }
            if ShrinkDemandedConstant(I, 1, DemandedMask & operator(LHSKnown.Zero)) {
                return I;
            }
            break;
        },
        Or => {
            if self.SimplifyDemandedBits(I, 1, DemandedMask, RHSKnown, Q, Depth + 1) || self.SimplifyDemandedBits(I, 0, DemandedMask & operator(RHSKnown.One), LHSKnown, Q, Depth + 1) {
                I.dropPoisonGeneratingFlags();
                return I;
            }
            Known = analyzeKnownBitsFromAndXorOr(cast(I), LHSKnown, RHSKnown, Q, Depth);
            if DemandedMask.isSubsetOf(Known.Zero | Known.One) {
                return getIntegerValue(VTy, Known.One);
            }
            if DemandedMask.isSubsetOf(LHSKnown.One | RHSKnown.Zero) {
                return I.getOperand(0);
            }
            if DemandedMask.isSubsetOf(RHSKnown.One | LHSKnown.Zero) {
                return I.getOperand(1);
            }
            if ShrinkDemandedConstant(I, 1, DemandedMask) {
                return I;
            }
            if !cast(I).isDisjoint() {
                let mut LHSCache: WithCache<const Value *> = WithCache<const Value *> { I.getOperand(0), LHSKnown };
                let mut RHSCache: WithCache<const Value *> = WithCache<const Value *> { I.getOperand(1), RHSKnown };
                if haveNoCommonBitsSet(LHSCache, RHSCache, Q) {
                    cast(I).setIsDisjoint(true);
                    return I;
                }
            }
            break;
        },
        Xor => {
            if self.SimplifyDemandedBits(I, 1, DemandedMask, RHSKnown, Q, Depth + 1) || self.SimplifyDemandedBits(I, 0, DemandedMask, LHSKnown, Q, Depth + 1) {
                return I;
            }
            let mut LHS: *mut Value = null;
            let mut RHS: *mut Value = null;
            if DemandedMask == 1 && match(I.getOperand(0), m_Ctpop(m_Value(LHS))) && match(I.getOperand(1), m_Ctpop(m_Value(RHS))) {
                let mut Guard: InsertPointGuard = self.Builder;
                self.Builder.SetInsertPoint(I);
                let mut Xor: *mut Value = self.Builder.CreateXor(LHS, RHS, "");
                return self.Builder.CreateUnaryIntrinsic(ctpop, Xor, FMFSource {}, "");
            }
            Known = analyzeKnownBitsFromAndXorOr(cast(I), LHSKnown, RHSKnown, Q, Depth);
            if DemandedMask.isSubsetOf(Known.Zero | Known.One) {
                return getIntegerValue(VTy, Known.One);
            }
            if DemandedMask.isSubsetOf(RHSKnown.Zero) {
                return I.getOperand(0);
            }
            if DemandedMask.isSubsetOf(LHSKnown.Zero) {
                return I.getOperand(1);
            }
            if DemandedMask.isSubsetOf(RHSKnown.Zero | LHSKnown.Zero) {
                let mut Or: *mut Instruction = CreateOr(I.getOperand(0), I.getOperand(1), "");
                if DemandedMask.isAllOnes() {
                    cast(Or).setIsDisjoint(true);
                }
                Or.takeName(I);
                return self.InsertNewInstWith(Or, I.getIterator());
            }
            if DemandedMask.isSubsetOf(RHSKnown.Zero | RHSKnown.One) && RHSKnown.One.isSubsetOf(LHSKnown.One) {
                let mut AndC: *mut Constant = getIntegerValue(VTy, operator(RHSKnown.One) & DemandedMask);
                let mut And: *mut Instruction = CreateAnd(I.getOperand(0), AndC, "");
                return self.InsertNewInstWith(And, I.getIterator());
            }
            let mut C: *APInt = null;
            if match(I.getOperand(1), m_APInt(C)) && !C.isAllOnes() {
                if (*C | operator(DemandedMask)).isAllOnes() {
                    I.setOperand(1, getAllOnesValue(VTy));
                    return I;
                }
                if ShrinkDemandedConstant(I, 1, DemandedMask) {
                    return I;
                }
            }
            if dyn_cast(I.getOperand(0)) {
                LHSInst;
            } else {
                let mut AndRHS: *mut ConstantInt = null;
                let mut XorRHS: *mut ConstantInt = null;
                if LHSInst.getOpcode() == And && LHSInst.hasOneUse() && match(I.getOperand(1), m_ConstantInt(XorRHS)) && match(LHSInst.getOperand(1), m_ConstantInt(AndRHS)) && (LHSKnown.One & RHSKnown.One & DemandedMask) != 0 {
                    let mut NewMask: APInt = operator((LHSKnown.One & RHSKnown.One & DemandedMask));
                    let mut AndC: *mut Constant = get(VTy, NewMask & AndRHS.getValue());
                    let mut NewAnd: *mut Instruction = CreateAnd(I.getOperand(0), AndC, "");
                    self.InsertNewInstWith(NewAnd, I.getIterator());
                    let mut XorC: *mut Constant = get(VTy, NewMask & XorRHS.getValue());
                    let mut NewXor: *mut Instruction = CreateXor(NewAnd, XorC, "");
                    return self.InsertNewInstWith(NewXor, I.getIterator());
                }
            }
            break;
        },
        Select => {
            if self.SimplifyDemandedBits(I, 2, DemandedMask, RHSKnown, Q, Depth + 1) || self.SimplifyDemandedBits(I, 1, DemandedMask, LHSKnown, Q, Depth + 1) {
                return I;
            }
            let mut CanonicalizeSelectConstant: Closure_3 = Closure_3 {};
            if CanonicalizeSelectConstant.call(I, 1, DemandedMask) || CanonicalizeSelectConstant.call(I, 2, DemandedMask) {
                return I;
            }
            adjustKnownBitsForSelectArm(LHSKnown, I.getOperand(0), I.getOperand(1), false, Q, Depth);
            adjustKnownBitsForSelectArm(RHSKnown, I.getOperand(0), I.getOperand(2), true, Q, Depth);
            Known = LHSKnown.intersectWith(RHSKnown);
            break;
        },
        Trunc => {
            let mut X: *mut Value = null;
            let mut C: *APInt = null;
            if match(I.getOperand(0), m_OneUse(m_LShr(m_Value(X), m_APInt(C)))) {
                if C.ult(VTy.getScalarSizeInBits()) && C.ule(DemandedMask.countl_zero()) {
                    let mut Guard: InsertPointGuard = self.Builder;
                    self.Builder.SetInsertPoint(I);
                    let mut Trunc: *mut Value = self.Builder.CreateTrunc(X, VTy, "", false, false);
                    return self.Builder.CreateLShr(Trunc, C.getZExtValue(), "", false);
                }
            }
        },
        ZExt => {
            let mut SrcBitWidth: u32 = I.getOperand(0).getType().getScalarSizeInBits();
            let mut InputDemandedMask: APInt = DemandedMask.zextOrTrunc(SrcBitWidth);
            let mut InputKnown: KnownBits = SrcBitWidth;
            if self.SimplifyDemandedBits(I, 0, InputDemandedMask, InputKnown, Q, Depth + 1) {
                I.dropPoisonGeneratingFlags();
                return I;
            }
            assert!(InputKnown.getBitWidth() == SrcBitWidth, "Src width changed?");
            if I.getOpcode() == ZExt && I.hasNonNeg() && !InputKnown.isNegative() {
                InputKnown.makeNonNegative();
            }
            Known = InputKnown.zextOrTrunc(BitWidth);
            break;
        },
        SExt => {
            let mut SrcBitWidth: u32 = I.getOperand(0).getType().getScalarSizeInBits();
            let mut InputDemandedBits: APInt = DemandedMask.trunc(SrcBitWidth);
            if DemandedMask.getActiveBits() > SrcBitWidth {
                InputDemandedBits.setBit(SrcBitWidth - 1);
            }
            let mut InputKnown: KnownBits = SrcBitWidth;
            if self.SimplifyDemandedBits(I, 0, InputDemandedBits, InputKnown, Q, Depth + 1) {
                return I;
            }
            if InputKnown.isNonNegative() || DemandedMask.getActiveBits() <= SrcBitWidth {
                let mut NewCast: *mut CastInst = ZExtInst { I.getOperand(0), VTy, "", null };
                NewCast.takeName(I);
                return self.InsertNewInstWith(NewCast, I.getIterator());
            }
            Known = InputKnown.sext(BitWidth);
            break;
        },
        Add => {
            if (DemandedMask & 1) == 0 {
                let mut X: *mut Value = null;
                let mut Y: *mut Value = null;
                if match(I, m_c_Add(m_OneUse(m_ZExt(m_Value(X))), m_OneUse(m_SExt(m_Value(Y))))) && X.getType().isIntOrIntVectorTy(1) && X.getType() == Y.getType() {
                    let mut Guard: InsertPointGuard = self.Builder;
                    self.Builder.SetInsertPoint(I);
                    let mut AndNot: *mut Value = self.Builder.CreateAnd(self.Builder.CreateNot(X, ""), Y, "");
                    return self.Builder.CreateSExt(AndNot, VTy, "");
                }
                if match(I, m_Add(m_SExt(m_Value(X)), m_SExt(m_Value(Y)))) && X.getType().isIntOrIntVectorTy(1) && X.getType() == Y.getType() && (I.getOperand(0).hasOneUse() || I.getOperand(1).hasOneUse()) {
                    let mut Guard: InsertPointGuard = self.Builder;
                    self.Builder.SetInsertPoint(I);
                    let mut Or: *mut Value = self.Builder.CreateOr(X, Y, "", false);
                    return self.Builder.CreateSExt(Or, VTy, "");
                }
            }
            let mut NLZ: u32 = DemandedMask.countl_zero();
            let mut DemandedFromOps: APInt = getLowBitsSet(BitWidth, BitWidth - NLZ);
            if ShrinkDemandedConstant(I, 1, DemandedFromOps) || self.SimplifyDemandedBits(I, 1, DemandedFromOps, RHSKnown, Q, Depth + 1) {
                return disableWrapFlagsBasedOnUnusedHighBits.call(I, NLZ);
            }
            let mut NTZ: u32 = (operator(DemandedMask) & RHSKnown.Zero).countr_one();
            let mut DemandedFromLHS: APInt = DemandedFromOps;
            DemandedFromLHS.clearLowBits(NTZ);
            if ShrinkDemandedConstant(I, 0, DemandedFromLHS) || self.SimplifyDemandedBits(I, 0, DemandedFromLHS, LHSKnown, Q, Depth + 1) {
                return disableWrapFlagsBasedOnUnusedHighBits.call(I, NLZ);
            }
            let mut NtzLHS: u32 = (operator(DemandedMask) & LHSKnown.Zero).countr_one();
            let mut DemandedFromRHS: APInt = DemandedFromOps;
            DemandedFromRHS.clearLowBits(NtzLHS);
            if ShrinkDemandedConstant(I, 1, DemandedFromRHS) {
                return disableWrapFlagsBasedOnUnusedHighBits.call(I, NLZ);
            }
            if DemandedFromOps.isSubsetOf(RHSKnown.Zero) {
                return I.getOperand(0);
            }
            if DemandedFromOps.isSubsetOf(LHSKnown.Zero) {
                return I.getOperand(1);
            }
            {
                let mut C: *APInt = null;
                if match(I.getOperand(1), m_APInt(C)) && C.isOneBitSet(DemandedMask.getActiveBits() - 1) {
                    let mut Guard: InsertPointGuard = self.Builder;
                    self.Builder.SetInsertPoint(I);
                    return self.Builder.CreateXor(I.getOperand(0), get(VTy, *C), "");
                }
            }
            let mut NSW: bool = cast(I).hasNoSignedWrap();
            let mut NUW: bool = cast(I).hasNoUnsignedWrap();
            Known = add(LHSKnown, RHSKnown, NSW, NUW, false);
            break;
        },
        Sub => {
            let mut NLZ: u32 = DemandedMask.countl_zero();
            let mut DemandedFromOps: APInt = getLowBitsSet(BitWidth, BitWidth - NLZ);
            if ShrinkDemandedConstant(I, 1, DemandedFromOps) || self.SimplifyDemandedBits(I, 1, DemandedFromOps, RHSKnown, Q, Depth + 1) {
                return disableWrapFlagsBasedOnUnusedHighBits.call(I, NLZ);
            }
            let mut NTZ: u32 = (operator(DemandedMask) & RHSKnown.Zero).countr_one();
            let mut DemandedFromLHS: APInt = DemandedFromOps;
            DemandedFromLHS.clearLowBits(NTZ);
            if ShrinkDemandedConstant(I, 0, DemandedFromLHS) || self.SimplifyDemandedBits(I, 0, DemandedFromLHS, LHSKnown, Q, Depth + 1) {
                return disableWrapFlagsBasedOnUnusedHighBits.call(I, NLZ);
            }
            if DemandedFromOps.isSubsetOf(RHSKnown.Zero) {
                return I.getOperand(0);
            }
            if DemandedFromOps.isOne() && DemandedFromOps.isSubsetOf(LHSKnown.Zero) {
                return I.getOperand(1);
            }
            let mut LHSC: *APInt = null;
            if match(I.getOperand(0), m_LowBitMask(LHSC)) && DemandedFromOps.isSubsetOf(*LHSC) {
                let mut Guard: InsertPointGuard = self.Builder;
                self.Builder.SetInsertPoint(I);
                return self.Builder.CreateNot(I.getOperand(1), "");
            }
            let mut NSW: bool = cast(I).hasNoSignedWrap();
            let mut NUW: bool = cast(I).hasNoUnsignedWrap();
            Known = sub(LHSKnown, RHSKnown, NSW, NUW);
            break;
        },
        Mul => {
            let mut DemandedFromOps: APInt = APInt {};
            if simplifyOperandsBasedOnUnusedHighBits.call(DemandedFromOps) {
                return I;
            }
            if DemandedMask.isPowerOf2() {
                let mut CTZ: u32 = DemandedMask.countr_zero();
                let mut C: *APInt = null;
                if match(I.getOperand(1), m_APInt(C)) && C.countr_zero() == CTZ {
                    let mut ShiftC: *mut Constant = get(VTy, CTZ, false, false);
                    let mut Shl: *mut Instruction = CreateShl(I.getOperand(0), ShiftC, "");
                    return self.InsertNewInstWith(Shl, I.getIterator());
                }
            }
            if I.getOperand(0) == I.getOperand(1) && DemandedMask.ult(4) {
                let mut One: *mut Constant = get(VTy, 1, false, false);
                let mut And1: *mut Instruction = CreateAnd(I.getOperand(0), One, "");
                return self.InsertNewInstWith(And1, I.getIterator());
            }
            computeKnownBits(I, Known, Q, Depth);
            break;
        },
        Shl => {
            let mut SA: *APInt = null;
            if match(I.getOperand(1), m_APInt(SA)) {
                let mut ShrAmt: *APInt = null;
                if match(I.getOperand(0), m_Shr(m_Value(), m_APInt(ShrAmt))) {
                    if dyn_cast(I.getOperand(0)) {
                        Shr;
                    } else if self.simplifyShrShlDemandedBits(Shr, *ShrAmt, I, *SA, DemandedMask, Known) {
                        R;
                    } else {
                        return R;
                    }
                }
                if I.hasOneUse() {
                    let mut Inst: *mut Instruction = I.user_back();
                    if Inst.getOpcode() == Or {
                        if self.convertOrOfShiftsToFunnelShift(*Inst) {
                            Opt;
                        } else {
                            if (IID == fshl || IID == fshr) && FShiftArgs[0] == FShiftArgs[1] {
                                computeKnownBits(I, Known, Q, Depth);
                                break;
                            }
                        }
                    }
                }
                let mut ShiftAmt: u64 = SA.getLimitedValue(BitWidth - 1);
                if DemandedMask.countr_zero() >= ShiftAmt {
                    if I.hasNoSignedWrap() {
                        let mut NumHiDemandedBits: u32 = BitWidth - DemandedMask.countr_zero();
                        let mut SignBits: u32 = self.ComputeNumSignBits(I.getOperand(0), Q.CtxI, Depth + 1);
                        if SignBits > ShiftAmt && SignBits - ShiftAmt >= NumHiDemandedBits {
                            return I.getOperand(0);
                        }
                    }
                    let mut X: *mut Value = null;
                    let mut C: *mut Constant = null;
                    if match(I.getOperand(0), m_LShr(m_ImmConstant(C), m_Value(X))) {
                        let mut LeftShiftAmtC: *mut Constant = get(VTy, ShiftAmt, false, false);
                        let mut NewC: *mut Constant = ConstantFoldBinaryOpOperands(Shl, C, LeftShiftAmtC, self.DL);
                        if ConstantFoldBinaryOpOperands(LShr, NewC, LeftShiftAmtC, self.DL) == C {
                            let mut Lshr: *mut Instruction = CreateLShr(NewC, X, "");
                            return self.InsertNewInstWith(Lshr, I.getIterator());
                        }
                    }
                }
                let mut DemandedMaskIn: APInt = DemandedMask.lshr(ShiftAmt);
                let mut IOp: *mut ShlOperator = cast(I);
                if IOp.hasNoSignedWrap() {
                    DemandedMaskIn.setHighBits(ShiftAmt + 1);
                } else if IOp.hasNoUnsignedWrap() {
                    DemandedMaskIn.setHighBits(ShiftAmt);
                }
                if self.SimplifyDemandedBits(I, 0, DemandedMaskIn, Known, Q, Depth + 1) {
                    return I;
                }
                Known = shl(Known, makeConstant(APInt { BitWidth, ShiftAmt, false, false }), IOp.hasNoUnsignedWrap(), IOp.hasNoSignedWrap(), false);
            } else {
                if DemandedMask.countl_zero() {
                    CTLZ;
                } else {
                    let mut DemandedFromOp: APInt = getLowBitsSet(BitWidth, BitWidth - CTLZ);
                    if self.SimplifyDemandedBits(I, 0, DemandedFromOp, Known, Q, Depth + 1) {
                        I.dropPoisonGeneratingFlags();
                        return I;
                    }
                }
                computeKnownBits(I, Known, Q, Depth);
            }
            break;
        },
        LShr => {
            let mut SA: *APInt = null;
            if match(I.getOperand(1), m_APInt(SA)) {
                let mut ShiftAmt: u64 = SA.getLimitedValue(BitWidth - 1);
                if I.hasOneUse() {
                    let mut Inst: *mut Instruction = I.user_back();
                    if Inst.getOpcode() == Or {
                        if self.convertOrOfShiftsToFunnelShift(*Inst) {
                            Opt;
                        } else {
                            if (IID == fshl || IID == fshr) && FShiftArgs[0] == FShiftArgs[1] {
                                computeKnownBits(I, Known, Q, Depth);
                                break;
                            }
                        }
                    }
                }
                if DemandedMask.countl_zero() >= ShiftAmt {
                    let mut NumHiDemandedBits: u32 = BitWidth - DemandedMask.countr_zero();
                    let mut SignBits: u32 = self.ComputeNumSignBits(I.getOperand(0), Q.CtxI, Depth + 1);
                    if SignBits >= NumHiDemandedBits {
                        return I.getOperand(0);
                    }
                    let mut X: *mut Value = null;
                    let mut C: *mut Constant = null;
                    if match(I.getOperand(0), m_Shl(m_ImmConstant(C), m_Value(X))) {
                        let mut RightShiftAmtC: *mut Constant = get(VTy, ShiftAmt, false, false);
                        let mut NewC: *mut Constant = ConstantFoldBinaryOpOperands(LShr, C, RightShiftAmtC, self.DL);
                        if ConstantFoldBinaryOpOperands(Shl, NewC, RightShiftAmtC, self.DL) == C {
                            let mut Shl: *mut Instruction = CreateShl(NewC, X, "");
                            return self.InsertNewInstWith(Shl, I.getIterator());
                        }
                    }
                    let mut Factor: *APInt = null;
                    if match(I.getOperand(0), m_OneUse(m_Mul(m_Value(X), m_APInt(Factor)))) && Factor.countr_zero() >= ShiftAmt {
                        let mut Mul: *mut BinaryOperator = CreateMul(X, get(X.getType(), Factor.lshr(ShiftAmt)), "");
                        return self.InsertNewInstWith(Mul, I.getIterator());
                    }
                }
                let mut DemandedMaskIn: APInt = DemandedMask.shl(ShiftAmt);
                if self.SimplifyDemandedBits(I, 0, DemandedMaskIn, Known, Q, Depth + 1) {
                    I.dropPoisonGeneratingFlags();
                    return I;
                }
                operator(Known, ShiftAmt);
                if ShiftAmt {
                    Known.Zero.setHighBits(ShiftAmt);
                }
                break;
            }
            if simplifyShiftSelectingPackedElement(I, DemandedMask, *self, Depth) {
                V;
            } else {
                return V;
            }
            computeKnownBits(I, Known, Q, Depth);
            break;
        },
        AShr => {
            let mut SignBits: u32 = self.ComputeNumSignBits(I.getOperand(0), Q.CtxI, Depth + 1);
            let mut NumHiDemandedBits: u32 = BitWidth - DemandedMask.countr_zero();
            if SignBits >= NumHiDemandedBits {
                return I.getOperand(0);
            }
            if DemandedMask.isOne() {
                let mut NewVal: *mut Instruction = CreateLShr(I.getOperand(0), I.getOperand(1), I.getName());
                return self.InsertNewInstWith(NewVal, I.getIterator());
            }
            let mut SA: *APInt = null;
            if match(I.getOperand(1), m_APInt(SA)) {
                let mut ShiftAmt: u32 = SA.getLimitedValue(BitWidth - 1);
                let mut DemandedMaskIn: APInt = DemandedMask.shl(ShiftAmt);
                let mut ShiftedInBitsDemanded: bool = DemandedMask.countl_zero() < ShiftAmt;
                if ShiftedInBitsDemanded {
                    DemandedMaskIn.setSignBit();
                }
                if self.SimplifyDemandedBits(I, 0, DemandedMaskIn, Known, Q, Depth + 1) {
                    I.dropPoisonGeneratingFlags();
                    return I;
                }
                if Known.Zero[BitWidth - 1] || !ShiftedInBitsDemanded {
                    let mut LShr: *mut BinaryOperator = CreateLShr(I.getOperand(0), I.getOperand(1), "");
                    LShr.setIsExact(cast(I).isExact());
                    LShr.takeName(I);
                    return self.InsertNewInstWith(LShr, I.getIterator());
                }
                Known = ashr(Known, makeConstant(APInt { BitWidth, ShiftAmt, false, false }), ShiftAmt != 0, I.isExact());
            } else {
                computeKnownBits(I, Known, Q, Depth);
            }
            break;
        },
        UDiv => {
            let mut SA: *APInt = null;
            if match(I.getOperand(1), m_APInt(SA)) {
                let mut RHSTrailingZeros: u32 = SA.countr_zero();
                let mut DemandedMaskIn: APInt = getHighBitsSet(BitWidth, BitWidth - RHSTrailingZeros);
                if self.SimplifyDemandedBits(I, 0, DemandedMaskIn, LHSKnown, Q, Depth + 1) {
                    I.dropPoisonGeneratingFlags();
                    return I;
                }
                Known = udiv(LHSKnown, makeConstant(*SA), cast(I).isExact());
            } else {
                computeKnownBits(I, Known, Q, Depth);
            }
            break;
        },
        SRem => {
            let mut Rem: *APInt = null;
            if match(I.getOperand(1), m_APInt(Rem)) && Rem.isPowerOf2() {
                if DemandedMask.ult(*Rem) {
                    return I.getOperand(0);
                }
                let mut LowBits: APInt = *Rem - 1;
                let mut Mask2: APInt = LowBits | getSignMask(BitWidth);
                if self.SimplifyDemandedBits(I, 0, Mask2, LHSKnown, Q, Depth + 1) {
                    return I;
                }
                Known = srem(LHSKnown, makeConstant(*Rem));
                break;
            }
            computeKnownBits(I, Known, Q, Depth);
            break;
        },
        Call => {
            let mut KnownBitsComputed: bool = false;
            if dyn_cast(I) {
                II;
            } else {
                match II.getIntrinsicID() {
                    abs => {
                        if DemandedMask == 1 {
                            return II.getArgOperand(0);
                        }
                        break;
                    },
                    ctpop => {
                        let mut X: *mut Value = null;
                        if DemandedMask == 1 && VTy.getScalarSizeInBits() % 2 == 0 && match(II.getArgOperand(0), m_Not(m_Value(X))) {
                            let mut Ctpop: *mut Function = getOrInsertDeclaration(II.getModule(), ctpop, VTy);
                            return self.InsertNewInstWith(Create(Ctpop, [X], ArrayRef<OperandBundleDef> {}, "", null), I.getIterator());
                        }
                        break;
                    },
                    bswap => {
                        let mut NLZ: u32 = DemandedMask.countl_zero();
                        let mut NTZ: u32 = DemandedMask.countr_zero();
                        NLZ = alignDown(NLZ, 8, 0);
                        NTZ = alignDown(NTZ, 8, 0);
                        if BitWidth - NLZ - NTZ == 8 {
                            let mut NewVal: *mut Instruction = null;
                            if NLZ > NTZ {
                                NewVal = CreateLShr(II.getArgOperand(0), get(VTy, NLZ - NTZ, false, false), "");
                            } else {
                                NewVal = CreateShl(II.getArgOperand(0), get(VTy, NTZ - NLZ, false, false), "");
                            }
                            NewVal.takeName(I);
                            return self.InsertNewInstWith(NewVal, I.getIterator());
                        }
                        break;
                    },
                    ptrmask => {
                        let mut MaskWidth: u32 = I.getOperand(1).getType().getScalarSizeInBits();
                        RHSKnown = MaskWidth;
                        if self.SimplifyDemandedBits(I, 0, DemandedMask, LHSKnown, Q, Depth + 1) || self.SimplifyDemandedBits(I, 1, (DemandedMask & operator(LHSKnown.Zero)).zextOrTrunc(MaskWidth), RHSKnown, Q, Depth + 1) {
                            return I;
                        }
                        RHSKnown = RHSKnown.anyextOrTrunc(BitWidth);
                        Known = LHSKnown & RHSKnown;
                        KnownBitsComputed = true;
                        if DemandedMask.isSubsetOf(Known.Zero) && !match(I.getOperand(1), m_Zero()) {
                            return self.replaceOperand(*I, 1, getNullValue(I.getOperand(1).getType()));
                        }
                        if DemandedMask.isSubsetOf(RHSKnown.One | LHSKnown.Zero) {
                            return I.getOperand(0);
                        }
                        if ShrinkDemandedConstant(I, 1, (DemandedMask & operator(LHSKnown.Zero)).zextOrTrunc(MaskWidth)) {
                            return I;
                        }
                        let mut InnerPtr: *mut Value = null;
                        let mut GEPIndex: u64 = 0;
                        let mut PtrMaskImmediate: u64 = 0;
                        if match(I, m_Intrinsic(m_PtrAdd(m_Value(InnerPtr), m_ConstantInt(GEPIndex)), m_ConstantInt(PtrMaskImmediate))) {
                            LHSKnown = self.computeKnownBits(InnerPtr, I, Depth + 1);
                            if !LHSKnown.isZero() {
                                let mut trailingZeros: u32 = LHSKnown.countMinTrailingZeros();
                                let mut PointerAlignBits: u64 = (1 << trailingZeros) - 1;
                                let mut HighBitsGEPIndex: u64 = GEPIndex & ~PointerAlignBits;
                                let mut MaskedLowBitsGEPIndex: u64 = GEPIndex & PointerAlignBits & PtrMaskImmediate;
                                let mut MaskedGEPIndex: u64 = HighBitsGEPIndex | MaskedLowBitsGEPIndex;
                                if MaskedGEPIndex != GEPIndex {
                                    let mut GEP: *mut GEPOperator = cast(II.getArgOperand(0));
                                    self.Builder.SetInsertPoint(I);
                                    let mut GEPIndexType: *mut Type = self.DL.getIndexType(GEP.getPointerOperand().getType());
                                    let mut MaskedGEP: *mut Value = self.Builder.CreateGEP(GEP.getSourceElementType(), InnerPtr, get(GEPIndexType, MaskedGEPIndex, false, false), GEP.getName(), GEP.isInBounds());
                                    self.replaceOperand(*I, 0, MaskedGEP);
                                    return I;
                                }
                            }
                        }
                        break;
                    },
                    fshr => {
                        fshl;
                    },
                    umax => {
                        let mut C: *APInt = null;
                        let mut CTZ: u32 = DemandedMask.countr_zero();
                        if match(II.getArgOperand(1), m_APInt(C)) && CTZ >= C.getActiveBits() {
                            return II.getArgOperand(0);
                        }
                        break;
                    },
                    umin => {
                        let mut C: *APInt = null;
                        let mut CTZ: u32 = DemandedMask.countr_zero();
                        if match(II.getArgOperand(1), m_APInt(C)) && CTZ >= C.getBitWidth() - C.countl_one() {
                            return II.getArgOperand(0);
                        }
                        break;
                    },
                    _ => {
                        let mut V: optional<Value *> = self.targetSimplifyDemandedUseBitsIntrinsic(*II, DemandedMask, Known, KnownBitsComputed);
                        if V {
                            return operator(V);
                        }
                        break;
                    },
                }
            }
            if !KnownBitsComputed {
                computeKnownBits(I, Known, Q, Depth);
            }
            break;
        },
    }
    if I.getType().isPointerTy() {
        let mut Alignment: Align = I.getPointerAlignment(self.DL);
        Known.Zero.setLowBits(Log2(Alignment));
    }
    if !I.getType().isPointerTy() && DemandedMask.isSubsetOf(Known.Zero | Known.One) {
        return getIntegerValue(VTy, Known.One);
    }
    if self.CLOpts.verify_known_bits {
        let mut ReferenceKnown: KnownBits = computeKnownBits(I, Q, Depth);
        if Known != ReferenceKnown {
            errs() << "Mismatched known bits for " << *I << " in " << I.getFunction().getName() << "\n";
            errs() << "computeKnownBits(): " << ReferenceKnown << "\n";
            errs() << "SimplifyDemandedBits(): " << Known << "\n";
            abort();
        }
    }
    return null;
}

fn InstCombinerImpl::SimplifyMultipleUseDemandedBits(self, I: *mut Instruction, DemandedMask: *APInt, Known: *mut KnownBits, Q: *SimplifyQuery, Depth: u32) -> *mut Value {
    let mut BitWidth: u32 = DemandedMask.getBitWidth();
    let mut ITy: *mut Type = I.getType();
    let mut LHSKnown: KnownBits = BitWidth;
    let mut RHSKnown: KnownBits = BitWidth;
    match I.getOpcode() {
        And => {
            computeKnownBits(I.getOperand(1), RHSKnown, Q, Depth + 1);
            computeKnownBits(I.getOperand(0), LHSKnown, Q, Depth + 1);
            Known = analyzeKnownBitsFromAndXorOr(cast(I), LHSKnown, RHSKnown, Q, Depth);
            computeKnownBitsFromContext(I, Known, Q, Depth);
            if DemandedMask.isSubsetOf(Known.Zero | Known.One) {
                return getIntegerValue(ITy, Known.One);
            }
            if DemandedMask.isSubsetOf(LHSKnown.Zero | RHSKnown.One) {
                return I.getOperand(0);
            }
            if DemandedMask.isSubsetOf(RHSKnown.Zero | LHSKnown.One) {
                return I.getOperand(1);
            }
            break;
        },
        Or => {
            computeKnownBits(I.getOperand(1), RHSKnown, Q, Depth + 1);
            computeKnownBits(I.getOperand(0), LHSKnown, Q, Depth + 1);
            Known = analyzeKnownBitsFromAndXorOr(cast(I), LHSKnown, RHSKnown, Q, Depth);
            computeKnownBitsFromContext(I, Known, Q, Depth);
            if DemandedMask.isSubsetOf(Known.Zero | Known.One) {
                return getIntegerValue(ITy, Known.One);
            }
            if DemandedMask.isSubsetOf(LHSKnown.One | RHSKnown.Zero) {
                return I.getOperand(0);
            }
            if DemandedMask.isSubsetOf(RHSKnown.One | LHSKnown.Zero) {
                return I.getOperand(1);
            }
            break;
        },
        Xor => {
            computeKnownBits(I.getOperand(1), RHSKnown, Q, Depth + 1);
            computeKnownBits(I.getOperand(0), LHSKnown, Q, Depth + 1);
            Known = analyzeKnownBitsFromAndXorOr(cast(I), LHSKnown, RHSKnown, Q, Depth);
            computeKnownBitsFromContext(I, Known, Q, Depth);
            if DemandedMask.isSubsetOf(Known.Zero | Known.One) {
                return getIntegerValue(ITy, Known.One);
            }
            if DemandedMask.isSubsetOf(RHSKnown.Zero) {
                return I.getOperand(0);
            }
            if DemandedMask.isSubsetOf(LHSKnown.Zero) {
                return I.getOperand(1);
            }
            break;
        },
        Add => {
            let mut NLZ: u32 = DemandedMask.countl_zero();
            let mut DemandedFromOps: APInt = getLowBitsSet(BitWidth, BitWidth - NLZ);
            computeKnownBits(I.getOperand(1), RHSKnown, Q, Depth + 1);
            if DemandedFromOps.isSubsetOf(RHSKnown.Zero) {
                return I.getOperand(0);
            }
            computeKnownBits(I.getOperand(0), LHSKnown, Q, Depth + 1);
            if DemandedFromOps.isSubsetOf(LHSKnown.Zero) {
                return I.getOperand(1);
            }
            let mut NSW: bool = cast(I).hasNoSignedWrap();
            let mut NUW: bool = cast(I).hasNoUnsignedWrap();
            Known = add(LHSKnown, RHSKnown, NSW, NUW, false);
            computeKnownBitsFromContext(I, Known, Q, Depth);
            break;
        },
        Sub => {
            let mut NLZ: u32 = DemandedMask.countl_zero();
            let mut DemandedFromOps: APInt = getLowBitsSet(BitWidth, BitWidth - NLZ);
            computeKnownBits(I.getOperand(1), RHSKnown, Q, Depth + 1);
            if DemandedFromOps.isSubsetOf(RHSKnown.Zero) {
                return I.getOperand(0);
            }
            let mut NSW: bool = cast(I).hasNoSignedWrap();
            let mut NUW: bool = cast(I).hasNoUnsignedWrap();
            computeKnownBits(I.getOperand(0), LHSKnown, Q, Depth + 1);
            Known = sub(LHSKnown, RHSKnown, NSW, NUW);
            computeKnownBitsFromContext(I, Known, Q, Depth);
            break;
        },
        AShr => {
            computeKnownBits(I, Known, Q, Depth);
            if DemandedMask.isSubsetOf(Known.Zero | Known.One) {
                return getIntegerValue(ITy, Known.One);
            }
            let mut ShiftRC: *APInt = null;
            let mut ShiftLC: *APInt = null;
            let mut X: *mut Value = null;
            let mut BitWidth: u32 = DemandedMask.getBitWidth();
            if match(I, m_AShr(m_Shl(m_Value(X), m_APInt(ShiftLC)), m_APInt(ShiftRC))) && ShiftLC == ShiftRC && ShiftLC.ult(BitWidth) && DemandedMask.isSubsetOf(getLowBitsSet(BitWidth, BitWidth - ShiftRC.getZExtValue())) {
                return X;
            }
            break;
        },
        _ => {
            computeKnownBits(I, Known, Q, Depth);
        },
    }
    return null;
}

fn InstCombinerImpl::simplifyShrShlDemandedBits(self, Shr: *mut Instruction, ShrOp1: *APInt, Shl: *mut Instruction, ShlOp1: *APInt, DemandedMask: *APInt, Known: *mut KnownBits) -> *mut Value {
    if operator(ShlOp1) || operator(ShrOp1) {
        return null;
    }
    let mut VarX: *mut Value = Shr.getOperand(0);
    let mut Ty: *mut Type = VarX.getType();
    let mut BitWidth: u32 = Ty.getScalarSizeInBits();
    if ShlOp1.uge(BitWidth) || ShrOp1.uge(BitWidth) {
        return null;
    }
    let mut ShlAmt: u32 = ShlOp1.getZExtValue();
    let mut ShrAmt: u32 = ShrOp1.getZExtValue();
    Known.One.clearAllBits();
    Known.Zero.setLowBits(ShlAmt - 1);
    operator(Known.Zero, DemandedMask);
    let mut BitMask1: APInt = getAllOnes(BitWidth);
    let mut BitMask2: APInt = getAllOnes(BitWidth);
    let mut isLshr: bool = (Shr.getOpcode() == LShr);
    BitMask1 = if isLshr { (BitMask1.lshr(ShrAmt) << ShlAmt) } else { (BitMask1.ashr(ShrAmt) << ShlAmt) };
    if ShrAmt <= ShlAmt {
        operator(BitMask2, (ShlAmt - ShrAmt));
    } else {
        BitMask2 = if isLshr { BitMask2.lshr(ShrAmt - ShlAmt) } else { BitMask2.ashr(ShrAmt - ShlAmt) };
    }
    if (BitMask1 & DemandedMask) == (BitMask2 & DemandedMask) {
        if ShrAmt == ShlAmt {
            return VarX;
        }
        if !Shr.hasOneUse() {
            return null;
        }
        let mut New: *mut BinaryOperator = null;
        if ShrAmt < ShlAmt {
            let mut Amt: *mut Constant = get(VarX.getType(), ShlAmt - ShrAmt, false, false);
            New = CreateShl(VarX, Amt, "");
            let mut Orig: *mut BinaryOperator = cast(Shl);
            New.setHasNoSignedWrap(Orig.hasNoSignedWrap());
            New.setHasNoUnsignedWrap(Orig.hasNoUnsignedWrap());
        } else {
            let mut Amt: *mut Constant = get(VarX.getType(), ShrAmt - ShlAmt, false, false);
            New = if isLshr { CreateLShr(VarX, Amt, "") } else { CreateAShr(VarX, Amt, "") };
            if cast(Shr).isExact() {
                New.setIsExact(true);
            }
        }
        return self.InsertNewInstWith(New, Shl.getIterator());
    }
    return null;
}

fn canSkipDemandedEltsInInsertChain(IE: *mut InsertElementInst, VWidth: u32, DepthLimit: u32) -> bool {
    if !IE.hasOneUse() {
        return false;
    }
    let mut UserIE: *mut InsertElementInst = dyn_cast(IE.user_back());
    if !UserIE || UserIE.getOperand(0) != &mut IE {
        return false;
    }
    let mut SeenIndices: SmallBitVector = SmallBitVector { VWidth, false };
    let mut HasNewIndexInRange: Closure_4 = Closure_4 { VWidth: &mut VWidth, SeenIndices: &mut SeenIndices };
    let mut Cur: *mut InsertElementInst = &mut IE;
    for let mut I: u32 = 0; I != DepthLimit; I += 1 {
        if !HasNewIndexInRange.call(*Cur) {
            return false;
        }
        let mut Base: *mut Value = Cur.getOperand(0);
        if match(Base, m_Poison()) {
            return true;
        }
        Cur = dyn_cast(Base);
        if !Cur || !Cur.hasOneUse() {
            return false;
        }
    }
    return true;
}

fn InstCombinerImpl::SimplifyDemandedVectorElts(self, V: *mut Value, DemandedElts: APInt, PoisonElts: *mut APInt, Depth: u32, AllowMultipleUsers: bool) -> *mut Value {
    if isa(V.getType()) {
        return null;
    }
    let mut VWidth: u32 = cast(V.getType()).getNumElements();
    let mut EltMask: APInt = getAllOnes(VWidth);
    assert!((DemandedElts & operator(EltMask)) == 0, "Invalid DemandedElts!");
    if match(V, m_Poison()) {
        PoisonElts = EltMask;
        return null;
    }
    if DemandedElts.isZero() {
        PoisonElts = EltMask;
        return get(V.getType());
    }
    PoisonElts = 0;
    if dyn_cast(V) {
        C;
    } else {
        if DemandedElts.isAllOnes() {
            return null;
        }
        let mut EltTy: *mut Type = cast(V.getType()).getElementType();
        let mut Poison: *mut Constant = get(EltTy);
        let mut Elts: SmallVector<Constant *, 16> = SmallVector<Constant *, 16> {};
        for let mut i: u32 = 0; i != VWidth; i += 1 {
            if !DemandedElts[i] {
                Elts.push(Poison);
                PoisonElts.setBit(i);
                continue;
            }
            let mut Elt: *mut Constant = C.getAggregateElement(i);
            if !Elt {
                return null;
            }
            Elts.push(Elt);
            if isa(Elt) {
                PoisonElts.setBit(i);
            }
        }
        let mut NewCV: *mut Constant = get(Elts);
        return if NewCV != C { NewCV } else { null };
    }
    if Depth == self.CLOpts.simplify_vector_elts_depth {
        return null;
    }
    if !AllowMultipleUsers {
        if !V.hasOneUse() {
            if Depth != 0 {
                return null;
            }
            DemandedElts = EltMask;
        }
    }
    let mut I: *mut Instruction = dyn_cast(V);
    if !I {
        return null;
    }
    let mut MadeChange: bool = false;
    let mut simplifyAndSetOp: Closure_5 = Closure_5 { cap_0: self, Depth: &mut Depth, MadeChange: &mut MadeChange };
    let mut PoisonElts2: APInt = APInt { VWidth, 0, false, false };
    let mut PoisonElts3: APInt = APInt { VWidth, 0, false, false };
    match I.getOpcode() {
        _ => {
            break;
        },
        GetElementPtr => {
            let mut mayIndexStructType: Closure_6 = Closure_6 {};
            if mayIndexStructType.call(cast(*I)) {
                break;
            }
            for let mut i: u32 = 0; i < I.getNumOperands(); i += 1 {
                if if i == 0 { match(I.getOperand(i), m_Undef()) } else { match(I.getOperand(i), m_Poison()) } {
                    PoisonElts = EltMask;
                    return null;
                }
                if I.getOperand(i).getType().isVectorTy() {
                    let mut PoisonEltsOp: APInt = APInt { VWidth, 0, false, false };
                    simplifyAndSetOp.call(I, i, DemandedElts, PoisonEltsOp);
                    if i == 0 {
                        operator(PoisonElts, PoisonEltsOp);
                    }
                }
            }
            break;
        },
        InsertElement => {
            let mut DepthLimit: u32 = self.CLOpts.simplify_vector_elts_depth;
            let mut IE: *mut InsertElementInst = cast(I);
            if Depth == 0 && DemandedElts.isAllOnes() && VWidth > DepthLimit && canSkipDemandedEltsInInsertChain(*IE, VWidth, DepthLimit) {
                return null;
            }
            let mut Idx: *mut ConstantInt = dyn_cast(I.getOperand(2));
            if !Idx {
                simplifyAndSetOp.call(I, 0, DemandedElts, PoisonElts2);
                break;
            }
            let mut IdxNo: u32 = Idx.getZExtValue();
            let mut PreInsertDemandedElts: APInt = DemandedElts;
            if IdxNo < VWidth {
                PreInsertDemandedElts.clearBit(IdxNo);
            }
            let mut Vec: *mut Value = null;
            if PreInsertDemandedElts == 0 && match(I.getOperand(1), m_ExtractElt(m_Value(Vec), m_SpecificInt(IdxNo))) && Vec.getType() == I.getType() {
                return Vec;
            }
            simplifyAndSetOp.call(I, 0, PreInsertDemandedElts, PoisonElts);
            if IdxNo >= VWidth || !DemandedElts[IdxNo] {
                self.Worklist.push(I);
                return I.getOperand(0);
            }
            PoisonElts.clearBit(IdxNo);
            break;
        },
        ShuffleVector => {
            let mut Shuffle: *mut ShuffleVectorInst = cast(I);
            assert!(Shuffle.getOperand(0).getType() == Shuffle.getOperand(1).getType(), "Expected shuffle operands to have same type");
            let mut OpWidth: u32 = cast(Shuffle.getOperand(0).getType()).getNumElements();
            if all_of(Shuffle.getShuffleMask(), equal_to(0)) && DemandedElts.isAllOnes() {
                if !isa(I.getOperand(1)) {
                    I.setOperand(1, get(I.getOperand(1).getType()));
                    MadeChange = true;
                }
                let mut LeftDemanded: APInt = APInt { OpWidth, 1, false, false };
                let mut LHSPoisonElts: APInt = APInt { OpWidth, 0, false, false };
                simplifyAndSetOp.call(I, 0, LeftDemanded, LHSPoisonElts);
                if LHSPoisonElts[0] {
                    PoisonElts = EltMask;
                } else {
                    PoisonElts.clearAllBits();
                }
                break;
            }
            let mut LeftDemanded: APInt = APInt { OpWidth, 0, false, false };
            let mut RightDemanded: APInt = APInt { OpWidth, 0, false, false };
            for let mut i: u32 = 0; i < VWidth; i += 1 {
                if DemandedElts[i] {
                    let mut MaskVal: u32 = Shuffle.getMaskValue(i);
                    if MaskVal != -1 {
                        assert!(MaskVal < OpWidth * 2, "shufflevector mask index out of range!");
                        if MaskVal < OpWidth {
                            LeftDemanded.setBit(MaskVal);
                        } else {
                            RightDemanded.setBit(MaskVal - OpWidth);
                        }
                    }
                }
            }
            let mut LHSPoisonElts: APInt = APInt { OpWidth, 0, false, false };
            simplifyAndSetOp.call(I, 0, LeftDemanded, LHSPoisonElts);
            let mut RHSPoisonElts: APInt = APInt { OpWidth, 0, false, false };
            simplifyAndSetOp.call(I, 1, RightDemanded, RHSPoisonElts);
            if VWidth == OpWidth {
                let mut IsIdentityShuffle: bool = true;
                for let mut i: u32 = 0; i < VWidth; i += 1 {
                    let mut MaskVal: u32 = Shuffle.getMaskValue(i);
                    if DemandedElts[i] && i != MaskVal {
                        IsIdentityShuffle = false;
                        break;
                    }
                }
                if IsIdentityShuffle {
                    return Shuffle.getOperand(0);
                }
            }
            let mut NewPoisonElts: bool = false;
            let mut LHSIdx: u32 = -1;
            let mut LHSValIdx: u32 = -1;
            let mut RHSIdx: u32 = -1;
            let mut RHSValIdx: u32 = -1;
            let mut LHSUniform: bool = true;
            let mut RHSUniform: bool = true;
            for let mut i: u32 = 0; i < VWidth; i += 1 {
                let mut MaskVal: u32 = Shuffle.getMaskValue(i);
                if MaskVal == -1 {
                    PoisonElts.setBit(i);
                } else if !DemandedElts[i] {
                    NewPoisonElts = true;
                    PoisonElts.setBit(i);
                } else if MaskVal < OpWidth {
                    if LHSPoisonElts[MaskVal] {
                        NewPoisonElts = true;
                        PoisonElts.setBit(i);
                    } else {
                        LHSIdx = if LHSIdx == -1 { i } else { OpWidth };
                        LHSValIdx = if LHSValIdx == -1 { MaskVal } else { OpWidth };
                        LHSUniform = LHSUniform && (MaskVal == i);
                    }
                } else {
                    if RHSPoisonElts[MaskVal - OpWidth] {
                        NewPoisonElts = true;
                        PoisonElts.setBit(i);
                    } else {
                        RHSIdx = if RHSIdx == -1 { i } else { OpWidth };
                        RHSValIdx = if RHSValIdx == -1 { MaskVal - OpWidth } else { OpWidth };
                        RHSUniform = RHSUniform && (MaskVal - OpWidth == i);
                    }
                }
            }
            if OpWidth == cast(Shuffle.getType()).getNumElements() {
                let mut Op: *mut Value = null;
                let mut Value: *mut Constant = null;
                let mut Idx: u32 = -1;
                if LHSIdx < OpWidth && RHSUniform {
                    if dyn_cast(Shuffle.getOperand(0)) {
                        CV;
                    } else {
                        Op = Shuffle.getOperand(1);
                        Value = CV.getOperand(LHSValIdx);
                        Idx = LHSIdx;
                    }
                }
                if RHSIdx < OpWidth && LHSUniform {
                    if dyn_cast(Shuffle.getOperand(1)) {
                        CV;
                    } else {
                        Op = Shuffle.getOperand(0);
                        Value = CV.getOperand(RHSValIdx);
                        Idx = RHSIdx;
                    }
                }
                if Op && Value {
                    let mut New: *mut Instruction = Create(Op, Value, get(getInt64Ty(I.getContext()), Idx, false, false), Shuffle.getName(), null);
                    self.InsertNewInstWith(New, Shuffle.getIterator());
                    return New;
                }
            }
            if NewPoisonElts {
                let mut Elts: SmallVector<int, 16> = SmallVector<int, 16> {};
                for let mut i: u32 = 0; i < VWidth; i += 1 {
                    if PoisonElts[i] {
                        Elts.push(PoisonMaskElem);
                    } else {
                        Elts.push(Shuffle.getMaskValue(i));
                    }
                }
                Shuffle.setShuffleMask(Elts);
                MadeChange = true;
            }
            break;
        },
        Select => {
            let mut Sel: *mut SelectInst = cast(I);
            if Sel.getCondition().getType().isVectorTy() {
                simplifyAndSetOp.call(I, 0, DemandedElts, PoisonElts);
            }
            let mut DemandedLHS: APInt = DemandedElts;
            let mut DemandedRHS: APInt = DemandedElts;
            if dyn_cast(Sel.getCondition()) {
                CV;
            } else {
                for let mut i: u32 = 0; i < VWidth; i += 1 {
                    let mut CElt: *mut Constant = CV.getAggregateElement(i);
                    if CElt.isNullValue() {
                        DemandedLHS.clearBit(i);
                    } else if CElt.isOneValue() {
                        DemandedRHS.clearBit(i);
                    }
                }
            }
            simplifyAndSetOp.call(I, 1, DemandedLHS, PoisonElts2);
            simplifyAndSetOp.call(I, 2, DemandedRHS, PoisonElts3);
            PoisonElts = PoisonElts2 & PoisonElts3;
            break;
        },
        BitCast => {
            let mut VTy: *mut VectorType = dyn_cast(I.getOperand(0).getType());
            if !VTy {
                break;
            }
            let mut InVWidth: u32 = cast(VTy).getNumElements();
            let mut InputDemandedElts: APInt = APInt { InVWidth, 0, false, false };
            PoisonElts2 = APInt { InVWidth, 0, false, false };
            let mut Ratio: u32 = 0;
            if VWidth == InVWidth {
                Ratio = 1;
                InputDemandedElts = DemandedElts;
            } else if (VWidth % InVWidth) == 0 {
                Ratio = VWidth / InVWidth;
                for let mut OutIdx: u32 = 0; OutIdx != VWidth; OutIdx += 1 {
                    if DemandedElts[OutIdx] {
                        InputDemandedElts.setBit(OutIdx / Ratio);
                    }
                }
            } else if (InVWidth % VWidth) == 0 {
                Ratio = InVWidth / VWidth;
                for let mut InIdx: u32 = 0; InIdx != InVWidth; InIdx += 1 {
                    if DemandedElts[InIdx / Ratio] {
                        InputDemandedElts.setBit(InIdx);
                    }
                }
            } else {
                break;
            }
            simplifyAndSetOp.call(I, 0, InputDemandedElts, PoisonElts2);
            if VWidth == InVWidth {
                PoisonElts = PoisonElts2;
            } else if (VWidth % InVWidth) == 0 {
                for let mut OutIdx: u32 = 0; OutIdx != VWidth; OutIdx += 1 {
                    if PoisonElts2[OutIdx / Ratio] {
                        PoisonElts.setBit(OutIdx);
                    }
                }
            } else if (InVWidth % VWidth) == 0 {
                for let mut OutIdx: u32 = 0; OutIdx != VWidth; OutIdx += 1 {
                    let mut SubUndef: APInt = PoisonElts2.lshr(OutIdx * Ratio).zextOrTrunc(Ratio);
                    if SubUndef.popcount() == Ratio {
                        PoisonElts.setBit(OutIdx);
                    }
                }
            } else {
                llvm_unreachable_internal("Unimp", "P:/Goraw/llvm-project/llvm/lib/Transforms/InstCombine/InstCombineSimplifyDemanded.cpp", 1946);
            }
            break;
        },
        FPTrunc => {
            FPExt;
        },
        Call => {
            let mut II: *mut IntrinsicInst = dyn_cast(I);
            if !II {
                break;
            }
            match II.getIntrinsicID() {
                masked_gather => {
                    masked_load;
                },
                smulh => {
                    umulh;
                },
                _ => {
                    let mut V: optional<Value *> = self.targetSimplifyDemandedVectorEltsIntrinsic(*II, DemandedElts, PoisonElts, PoisonElts2, PoisonElts3, simplifyAndSetOp);
                    if V {
                        return operator(V);
                    }
                    break;
                },
            }
            break;
        },
    }
    let mut BO: *mut BinaryOperator = null;
    if match(I, m_BinOp(BO)) && !BO.isIntDivRem() && !BO.isShift() {
        let mut X: *mut Value = BO.getOperand(0);
        let mut Y: *mut Value = BO.getOperand(1);
        if DemandedElts == 1 && !X.hasOneUse() && !Y.hasOneUse() && BO.hasOneUse() {
            let mut findShufBO: Closure_7 = Closure_7 { Y: &mut Y, X: &mut X, BO: &mut BO, cap_3: self, I: &mut I };
            let mut ShufBO: *mut User = findShufBO.call(true);
            if !ShufBO {
                ShufBO = findShufBO.call(false);
            }
            if ShufBO {
                let mut ShufBOI: *mut Instruction = cast(ShufBO);
                ShufBOI.andIRFlags(BO);
                self.Worklist.add(ShufBOI);
                return ShufBO;
            }
        }
        simplifyAndSetOp.call(I, 0, DemandedElts, PoisonElts);
        simplifyAndSetOp.call(I, 1, DemandedElts, PoisonElts2);
        operator(PoisonElts, PoisonElts2);
    }
    if PoisonElts.isAllOnes() {
        return get(I.getType());
    }
    return if MadeChange { I } else { null };
}

fn getFPClassConstant(Ty: *mut Type, Mask: FPClassTest, IsCanonicalizing: bool) -> *mut Constant {
    if Mask == fcNone {
        return get(Ty);
    }
    if Mask == fcPosZero {
        return getNullValue(Ty);
    }
    if Ty.isAggregateType() {
        return null;
    }
    if Mask == fcNan && IsCanonicalizing {
        return getQNaN(Ty, false, null);
    }
    match Mask {
        fcNegZero => {
            return getZero(Ty, true);
        },
        fcPosInf => {
            return getInfinity(Ty, false);
        },
        fcNegInf => {
            return getInfinity(Ty, true);
        },
        fcQNan => {
            return if IsCanonicalizing { getQNaN(Ty, false, null) } else { null };
        },
        _ => {
            return null;
        },
    }
}

fn simplifyDemandedFPClassFabs(Known: *mut KnownFPClass, Src: *mut Value, DemandedMask: FPClassTest, KnownSrc: KnownFPClass, NSZ: bool) -> *mut Value {
    if (DemandedMask & fcNan) == fcNone {
        KnownSrc.knownNot(fcNan);
    }
    if (DemandedMask & fcInf) == fcNone {
        KnownSrc.knownNot(fcInf);
    }
    if KnownSrc.getSignBit() == false || ((DemandedMask & fcNan) == fcNone && KnownSrc.isKnownNever(fcNegative)) {
        return Src;
    }
    if NSZ && KnownSrc.isKnownNever(OrderedLessThanZeroMask | fcNan) {
        return Src;
    }
    Known = fabs(KnownSrc);
    Known.knownNot(operator(DemandedMask));
    return null;
}

fn inferFastMathValueFlags(FMF: FastMathFlags, ValidResults: FPClassTest, Known: ArrayRef<KnownFPClass>) -> FastMathFlags {
    if !FMF.noNaNs() && (ValidResults & fcNan) == fcNone {
        if all_of(Known, Closure_8 {}) {
            FMF.setNoNaNs(true);
        }
    }
    if !FMF.noInfs() && (ValidResults & fcInf) == fcNone {
        if all_of(Known, Closure_9 {}) {
            FMF.setNoInfs(true);
        }
    }
    return FMF;
}

fn adjustDemandedMaskFromFlags(DemandedMask: FPClassTest, FMF: FastMathFlags) -> FPClassTest {
    if FMF.noNaNs() {
        operator(DemandedMask, operator(fcNan));
    }
    if FMF.noInfs() {
        operator(DemandedMask, operator(fcInf));
    }
    return DemandedMask;
}

fn simplifyDemandedFPClassResult(FPOp: *mut Instruction, FMF: FastMathFlags, DemandedMask: FPClassTest, Known: *mut KnownFPClass, KnownSrcs: ArrayRef<KnownFPClass>) -> *mut Value {
    let mut ValidResults: FPClassTest = DemandedMask & Known.getKnownFPClasses();
    let mut SingleVal: *mut Constant = getFPClassConstant(FPOp.getType(), ValidResults, true);
    if SingleVal {
        return SingleVal;
    }
    let mut InferredFMF: FastMathFlags = inferFastMathValueFlags(FMF, ValidResults, KnownSrcs);
    if InferredFMF != FMF {
        FPOp.dropUBImplyingAttrsAndMetadata(ArrayRef<unsigned int> {});
        FPOp.setFastMathFlags(InferredFMF);
        return FPOp;
    }
    return null;
}

fn simplifyDemandedFPClassFnegFabs(Known: *mut KnownFPClass, Src: *mut Value, DemandedMask: FPClassTest, KnownSrc: KnownFPClass, NSZ: bool) -> *mut Value {
    if (DemandedMask & fcNan) == fcNone {
        KnownSrc.knownNot(fcNan);
    }
    if (DemandedMask & fcInf) == fcNone {
        KnownSrc.knownNot(fcInf);
    }
    if KnownSrc.getSignBit() == true {
        return Src;
    }
    if NSZ && KnownSrc.isKnownNever(OrderedGreaterThanZeroMask | fcNan) {
        return Src;
    }
    Known = fneg(fabs(KnownSrc));
    Known.knownNot(operator(DemandedMask));
    return null;
}

fn simplifyDemandedFPClassCopysignMag(MagSrc: *mut Value, DemandedMask: FPClassTest, KnownSrc: KnownFPClass, NSZ: bool) -> *mut Value {
    if NSZ {
        let mut NegOrZero: FPClassTest = fcNegative | fcPosZero;
        let mut PosOrZero: FPClassTest = fcPositive | fcNegZero;
        if (DemandedMask & operator(NegOrZero)) == fcNone && KnownSrc.isKnownAlways(NegOrZero) {
            return MagSrc;
        }
        if (DemandedMask & operator(PosOrZero)) == fcNone && KnownSrc.isKnownAlways(PosOrZero) {
            return MagSrc;
        }
    } else {
        if (DemandedMask & operator(fcNegative)) == fcNone && KnownSrc.getSignBit() == true {
            return MagSrc;
        }
        if (DemandedMask & operator(fcPositive)) == fcNone && KnownSrc.getSignBit() == false {
            return MagSrc;
        }
    }
    return null;
}

fn simplifyDemandedFPClassMinMax(Known: *mut KnownFPClass, IID: ID, CI: *CallInst, DemandedMask: FPClassTest, KnownLHS: KnownFPClass, KnownRHS: KnownFPClass, F: *Function, NSZ: bool) -> *mut Value {
    let mut OrderedZeroSign: bool = !NSZ;
    let mut OpKind: MinMaxKind = zeroed();
    match IID {
        maximum => {
            OpKind = maximum;
            if cannotOrderStrictlyLess(KnownLHS.getKnownFPClasses(), KnownRHS.getKnownFPClasses(), OrderedZeroSign) && KnownRHS.isKnownNever(fcNan) {
                return CI.getArgOperand(0);
            }
            if cannotOrderStrictlyGreater(KnownLHS.getKnownFPClasses(), KnownRHS.getKnownFPClasses(), OrderedZeroSign) && KnownLHS.isKnownNever(fcNan) {
                return CI.getArgOperand(1);
            }
            break;
        },
        minimum => {
            OpKind = minimum;
            if cannotOrderStrictlyGreater(KnownLHS.getKnownFPClasses(), KnownRHS.getKnownFPClasses(), OrderedZeroSign) && KnownRHS.isKnownNever(fcNan) {
                return CI.getArgOperand(0);
            }
            if cannotOrderStrictlyLess(KnownLHS.getKnownFPClasses(), KnownRHS.getKnownFPClasses(), OrderedZeroSign) && KnownLHS.isKnownNever(fcNan) {
                return CI.getArgOperand(1);
            }
            break;
        },
        maxnum => {
            maximumnum;
        },
        minnum => {
            minimumnum;
        },
        _ => {
            llvm_unreachable_internal("not a min/max intrinsic", "P:/Goraw/llvm-project/llvm/lib/Transforms/InstCombine/InstCombineSimplifyDemanded.cpp", 2339);
        },
    }
    let mut EltTy: *mut Type = CI.getType().getScalarType();
    let mut Mode: DenormalMode = F.getDenormalMode(EltTy.getFltSemantics());
    Known = minMaxLike(KnownLHS, KnownRHS, OpKind, Mode);
    Known.knownNot(operator(DemandedMask));
    return getFPClassConstant(CI.getType(), Known.getKnownFPClasses(), true);
}

fn simplifyDemandedUseFPClassFPTrunc(IC: *mut InstCombinerImpl, I: *mut Instruction, FMF: FastMathFlags, DemandedMask: FPClassTest, Known: *mut KnownFPClass, SQ: *SimplifyQuery, Depth: u32) -> *mut Value {
    let mut SrcDemandedMask: FPClassTest = DemandedMask;
    if DemandedMask & fcNan {
        operator(SrcDemandedMask, fcNan);
    }
    if DemandedMask & fcNegZero {
        operator(SrcDemandedMask, fcNegSubnormal | fcNegNormal);
    }
    if DemandedMask & fcPosZero {
        operator(SrcDemandedMask, fcPosSubnormal | fcPosNormal);
    }
    if DemandedMask & fcNegSubnormal {
        operator(SrcDemandedMask, fcNegNormal);
    }
    if DemandedMask & fcPosSubnormal {
        operator(SrcDemandedMask, fcPosNormal);
    }
    if DemandedMask & fcPosInf {
        operator(SrcDemandedMask, fcPosNormal);
    }
    if DemandedMask & fcNegInf {
        operator(SrcDemandedMask, fcNegNormal);
    }
    let mut KnownSrc: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
    if IC.SimplifyDemandedFPClass(&mut I, 0, SrcDemandedMask, KnownSrc, SQ, Depth + 1) {
        return &mut I;
    }
    Known = fptrunc(KnownSrc);
    Known.knownNot(operator(DemandedMask));
    return simplifyDemandedFPClassResult(&mut I, FMF, DemandedMask, Known, [KnownSrc]);
}

fn InstCombinerImpl::SimplifyDemandedUseFPClass(self, I: *mut Instruction, DemandedMask: FPClassTest, Known: *mut KnownFPClass, SQ: *SimplifyQuery, Depth: u32) -> *mut Value {
    assert!(Depth <= MaxAnalysisRecursionDepth, "Limit Search Depth");
    assert!(Known == KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} }, "expected uninitialized state");
    let mut VTy: *mut Type = I.getType();
    let mut FMF: FastMathFlags = FastMathFlags {};
    if dyn_cast(I) {
        FPOp;
    } else {
        FMF = FPOp.getFastMathFlags();
        DemandedMask = adjustDemandedMaskFromFlags(DemandedMask, FMF);
    }
    match I.getOpcode() {
        FNeg => {
            let mut FNegSrc: *mut Value = I.getOperand(0);
            let mut FNegFAbsSrc: *mut Value = null;
            if match(FNegSrc, m_OneUse(m_FAbs(m_Value(FNegFAbsSrc)))) {
                let mut KnownSrc: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
                if self.SimplifyDemandedFPClass(cast(FNegSrc), 0, unknown_sign(DemandedMask), KnownSrc, SQ, Depth + 1) {
                    return I;
                }
                let mut FabsFMF: FastMathFlags = cast(FNegSrc).getFastMathFlags();
                let mut ThisDemandedMask: FPClassTest = adjustDemandedMaskFromFlags(DemandedMask, FabsFMF);
                let mut IsNSZ: bool = FMF.noSignedZeros() || FabsFMF.noSignedZeros();
                if simplifyDemandedFPClassFnegFabs(Known, FNegFAbsSrc, ThisDemandedMask, KnownSrc, IsNSZ) {
                    Simplified;
                } else {
                    return Simplified;
                }
                if (ThisDemandedMask & fcNan) == fcNone {
                    KnownSrc.knownNot(fcNan);
                }
                if (ThisDemandedMask & fcInf) == fcNone {
                    KnownSrc.knownNot(fcInf);
                }
                if KnownSrc.getSignBit() == false {
                    return self.replaceOperand(*I, 0, FNegFAbsSrc);
                }
                if IsNSZ && KnownSrc.isKnownNever(OrderedLessThanZeroMask | fcNan) {
                    return self.replaceOperand(*I, 0, FNegFAbsSrc);
                }
                break;
            }
            if self.SimplifyDemandedFPClass(I, 0, fneg(DemandedMask), Known, SQ, Depth + 1) {
                return I;
            }
            Known.fneg();
            Known.knownNot(operator(DemandedMask));
            break;
        },
        FAdd => {
            FSub;
        },
        FMul => {
            let mut KnownLHS: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
            let mut KnownRHS: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
            let mut X: *mut Value = I.getOperand(0);
            let mut Y: *mut Value = I.getOperand(1);
            let mut SrcDemandedMask: FPClassTest = DemandedMask & (fcNan | fcZero | fcSubnormal | fcNormal);
            if DemandedMask & fcInf {
                operator(SrcDemandedMask, fcSubnormal | fcNormal | fcInf);
            }
            if DemandedMask & fcNan {
                operator(SrcDemandedMask, fcZero | fcInf | fcNan);
                operator(SrcDemandedMask, fcSubnormal);
            }
            if DemandedMask & (fcNormal | fcSubnormal) {
                operator(SrcDemandedMask, fcNormal | fcSubnormal);
            }
            if DemandedMask & fcZero {
                operator(SrcDemandedMask, fcNormal | fcSubnormal);
            }
            if X == Y && isGuaranteedNotToBeUndef(X, SQ.AC, SQ.CtxI, SQ.DT, Depth + 1) {
                if self.SimplifyDemandedFPClass(I, 0, SrcDemandedMask, KnownLHS, SQ, Depth + 1) {
                    return I;
                }
                let mut EltTy: *mut Type = VTy.getScalarType();
                let mut Mode: DenormalMode = self.F.getDenormalMode(EltTy.getFltSemantics());
                Known = square(KnownLHS, Mode);
                Known.knownNot(operator(DemandedMask));
                if getFPClassConstant(VTy, Known.getKnownFPClasses(), true) {
                    Folded;
                } else {
                    return Folded;
                }
                if Known.isKnownAlways(fcPosZero | fcPosInf | fcNan) && KnownLHS.isKnownNever(fcSubnormal | fcNormal) {
                    if KnownLHS.isKnownAlways(fcPositive) {
                        return X;
                    }
                    let mut Guard: InsertPointGuard = self.Builder;
                    self.Builder.SetInsertPoint(I);
                    let mut Fabs: *mut Value = self.Builder.CreateFAbs(X, FMF, "");
                    Fabs.takeName(I);
                    return Fabs;
                }
                return null;
            }
            if self.SimplifyDemandedFPClass(I, 1, SrcDemandedMask, KnownRHS, SQ, Depth + 1) || self.SimplifyDemandedFPClass(I, 0, SrcDemandedMask, KnownLHS, SQ, Depth + 1) {
                return I;
            }
            if FMF.noInfs() {
                KnownLHS.knownNot(fcInf);
                KnownRHS.knownNot(fcInf);
            }
            let mut NonNanResult: bool = (DemandedMask & fcNan) == fcNone;
            if (NonNanResult || KnownLHS.isKnownNeverInfOrNaN()) && KnownRHS.isKnownAlways(fcPosZero | fcNan) {
                let mut Guard: InsertPointGuard = self.Builder;
                self.Builder.SetInsertPoint(I);
                let mut Copysign: *mut Value = self.Builder.CreateCopySign(Y, X, FMF, "");
                Copysign.takeName(I);
                return Copysign;
            }
            if KnownLHS.isKnownAlways(fcPosZero | fcNan) && (NonNanResult || KnownRHS.isKnownNeverInfOrNaN()) {
                let mut Guard: InsertPointGuard = self.Builder;
                self.Builder.SetInsertPoint(I);
                let mut Copysign: *mut Value = self.Builder.CreateCopySign(X, Y, FMF, "");
                Copysign.takeName(I);
                return Copysign;
            }
            if (NonNanResult || KnownLHS.isKnownNeverInfOrNaN()) && KnownRHS.isKnownAlways(fcNegZero | fcNan) {
                let mut Guard: InsertPointGuard = self.Builder;
                self.Builder.SetInsertPoint(I);
                let mut Copysign: *mut Value = self.Builder.CreateCopySign(Y, self.Builder.CreateFNegFMF(X, FMF, "", null), FMF, "");
                Copysign.takeName(I);
                return Copysign;
            }
            if KnownLHS.isKnownAlways(fcNegZero | fcNan) && (NonNanResult || KnownRHS.isKnownNeverInfOrNaN()) {
                let mut Guard: InsertPointGuard = self.Builder;
                self.Builder.SetInsertPoint(I);
                let mut Copysign: *mut Value = self.Builder.CreateCopySign(X, self.Builder.CreateFNegFMF(Y, FMF, "", null), FMF, "");
                Copysign.takeName(I);
                return Copysign;
            }
            let mut EltTy: *mut Type = VTy.getScalarType();
            let mut Mode: DenormalMode = self.F.getDenormalMode(EltTy.getFltSemantics());
            if KnownLHS.isKnownAlways(fcInf | fcNan) && (KnownRHS.isKnownNeverNaN() && KnownRHS.cannotBeOrderedGreaterEqZero(Mode)) {
                let mut Guard: InsertPointGuard = self.Builder;
                self.Builder.SetInsertPoint(I);
                let mut Neg: *mut Value = self.Builder.CreateFNegFMF(X, FMF, "", null);
                Neg.takeName(I);
                return Neg;
            }
            if KnownRHS.isKnownAlways(fcInf | fcNan) && (KnownLHS.isKnownNeverNaN() && KnownLHS.cannotBeOrderedGreaterEqZero(Mode)) {
                let mut Guard: InsertPointGuard = self.Builder;
                self.Builder.SetInsertPoint(I);
                let mut Neg: *mut Value = self.Builder.CreateFNegFMF(Y, FMF, "", null);
                Neg.takeName(I);
                return Neg;
            }
            Known = fmul(KnownLHS, KnownRHS, Mode);
            Known.knownNot(operator(DemandedMask));
            if getFPClassConstant(VTy, Known.getKnownFPClasses(), true) {
                SingleVal;
            } else {
                return SingleVal;
            }
            let mut InferredFMF: FastMathFlags = inferFastMathValueFlags(FMF, Known.getKnownFPClasses(), [KnownLHS, KnownRHS]);
            if InferredFMF != FMF {
                I.setFastMathFlags(InferredFMF);
                return I;
            }
            return null;
        },
        FDiv => {
            let mut X: *mut Value = I.getOperand(0);
            let mut Y: *mut Value = I.getOperand(1);
            if X == Y && isGuaranteedNotToBeUndef(X, SQ.AC, SQ.CtxI, SQ.DT, Depth + 1) {
                let mut Guard: InsertPointGuard = self.Builder;
                self.Builder.SetInsertPoint(I);
                let mut IsZeroOrNan: *mut Value = self.Builder.CreateFCmpFMF(FCMP_UEQ, I.getOperand(0), getZero(VTy, false), FMF, "", null);
                let mut Fabs: *mut Value = self.Builder.CreateFAbs(I.getOperand(0), FMF, "");
                let mut IsInfOrNan: *mut Value = self.Builder.CreateFCmpFMF(FCMP_UEQ, Fabs, getInfinity(VTy, false), FMF, "", null);
                let mut IsInfOrZeroOrNan: *mut Value = self.Builder.CreateOr(IsInfOrNan, IsZeroOrNan, "", false);
                return self.Builder.CreateSelectFMFWithUnknownProfile(IsInfOrZeroOrNan, getQNaN(VTy, false, null), get(VTy, getOne(VTy.getScalarType().getFltSemantics(), false)), FMF, "instcombine", "");
            }
            let mut EltTy: *mut Type = VTy.getScalarType();
            let mut Mode: DenormalMode = self.F.getDenormalMode(EltTy.getFltSemantics());
            let mut SrcDemandedMask: FPClassTest = (DemandedMask & fcNan) | fcSubnormal;
            if DemandedMask & (fcSubnormal | fcNormal) {
                operator(SrcDemandedMask, fcNormal);
            }
            if DemandedMask & fcNan {
                operator(SrcDemandedMask, fcZero | fcInf | fcNan);
            }
            if DemandedMask & fcZero {
                operator(SrcDemandedMask, fcNormal | fcSubnormal);
            }
            let mut LHSDemandedMask: FPClassTest = SrcDemandedMask;
            let mut RHSDemandedMask: FPClassTest = SrcDemandedMask;
            if DemandedMask & fcZero {
                assert!((LHSDemandedMask & fcSubnormal), "should not have to worry about daz here");
                operator(LHSDemandedMask, fcZero);
                operator(RHSDemandedMask, fcInf);
            }
            if DemandedMask & fcInf {
                operator(LHSDemandedMask, fcInf | fcNormal | fcSubnormal);
                operator(RHSDemandedMask, fcZero | fcSubnormal | fcNormal);
            }
            let mut KnownLHS: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
            let mut KnownRHS: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
            if self.SimplifyDemandedFPClass(I, 0, LHSDemandedMask, KnownLHS, SQ, Depth + 1) || self.SimplifyDemandedFPClass(I, 1, RHSDemandedMask, KnownRHS, SQ, Depth + 1) {
                return I;
            }
            let mut ResultNotNan: bool = (DemandedMask & fcNan) == fcNone;
            let mut ResultNotInf: bool = (DemandedMask & fcInf) == fcNone;
            let mut CanIgnoreZeroByZeroNan: bool = ResultNotNan || KnownRHS.isKnownNeverLogicalZero(Mode);
            if FMF.noSignedZeros() && KnownLHS.isKnownAlways(fcZero) && KnownRHS.isKnownNeverNaN() && CanIgnoreZeroByZeroNan {
                return getZero(VTy, false);
            }
            if KnownLHS.isKnownAlways(fcPosZero) && KnownRHS.isKnownNeverNaN() && CanIgnoreZeroByZeroNan {
                let mut Guard: InsertPointGuard = self.Builder;
                self.Builder.SetInsertPoint(I);
                let mut Copysign: *mut Value = self.Builder.CreateCopySign(X, Y, FMF, "");
                Copysign.takeName(I);
                return Copysign;
            }
            if !ResultNotInf && ((ResultNotNan || (KnownLHS.isKnownNeverNaN() && KnownLHS.isKnownNeverLogicalZero(Mode))) && (KnownRHS.isKnownAlways(fcPosZero) || (FMF.noSignedZeros() && KnownRHS.isKnownAlways(fcZero)))) {
                let mut Guard: InsertPointGuard = self.Builder;
                self.Builder.SetInsertPoint(I);
                let mut Copysign: *mut Value = self.Builder.CreateCopySign(getInfinity(VTy, false), X, FMF, "");
                Copysign.takeName(I);
                return Copysign;
            }
            if ResultNotNan && ResultNotInf && KnownRHS.isKnownAlways(fcZero) {
                return get(VTy);
            }
            Known = fdiv(KnownLHS, KnownRHS, Mode);
            Known.knownNot(operator(DemandedMask));
            if getFPClassConstant(VTy, Known.getKnownFPClasses(), true) {
                SingleVal;
            } else {
                return SingleVal;
            }
            let mut InferredFMF: FastMathFlags = inferFastMathValueFlags(FMF, Known.getKnownFPClasses(), [KnownLHS, KnownRHS]);
            if InferredFMF != FMF {
                I.setFastMathFlags(InferredFMF);
                return I;
            }
            return null;
        },
        FPTrunc => {
            return simplifyDemandedUseFPClassFPTrunc(*self, *I, FMF, DemandedMask, Known, SQ, Depth);
        },
        FPExt => {
            let mut SrcDemandedMask: FPClassTest = DemandedMask;
            if DemandedMask & fcNan {
                operator(SrcDemandedMask, fcNan);
            }
            if (DemandedMask & fcNegNormal) != fcNone {
                operator(SrcDemandedMask, fcNegSubnormal);
            }
            if (DemandedMask & fcPosNormal) != fcNone {
                operator(SrcDemandedMask, fcPosSubnormal);
            }
            let mut KnownSrc: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
            if self.SimplifyDemandedFPClass(I, 0, SrcDemandedMask, KnownSrc, SQ, Depth + 1) {
                return I;
            }
            let mut DstTy: *fltSemantics = VTy.getScalarType().getFltSemantics();
            let mut SrcTy: *fltSemantics = I.getOperand(0).getType().getScalarType().getFltSemantics();
            Known = fpext(KnownSrc, DstTy, SrcTy);
            Known.knownNot(operator(DemandedMask));
            return simplifyDemandedFPClassResult(I, FMF, DemandedMask, Known, [KnownSrc]);
        },
        Call => {
            let mut CI: *mut CallInst = cast(I);
            let mut IID: ID = CI.getIntrinsicID();
            match IID {
                fabs => {
                    let mut KnownSrc: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
                    if self.SimplifyDemandedFPClass(I, 0, inverse_fabs(DemandedMask), KnownSrc, SQ, Depth + 1) {
                        return I;
                    }
                    if simplifyDemandedFPClassFabs(Known, CI.getArgOperand(0), DemandedMask, KnownSrc, FMF.noSignedZeros()) {
                        Simplified;
                    } else {
                        return Simplified;
                    }
                    break;
                },
                arithmetic_fence => {
                    if self.SimplifyDemandedFPClass(I, 0, DemandedMask, Known, SQ, Depth + 1) {
                        return I;
                    }
                },
                copysign => {
                    let mut DemandedMaskAnySign: FPClassTest = unknown_sign(DemandedMask);
                    let mut KnownMag: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
                    if self.SimplifyDemandedFPClass(CI, 0, DemandedMaskAnySign, KnownMag, SQ, Depth + 1) {
                        return I;
                    }
                    if (DemandedMask & fcNegative) == DemandedMask {
                        CI.setOperand(1, get(VTy, -1.0));
                        return I;
                    }
                    if (DemandedMask & fcPositive) == DemandedMask {
                        CI.setOperand(1, getZero(VTy, false));
                        return I;
                    }
                    if simplifyDemandedFPClassCopysignMag(CI.getArgOperand(0), DemandedMask, KnownMag, FMF.noSignedZeros()) {
                        Simplified;
                    } else {
                        return Simplified;
                    }
                    let mut KnownSign: KnownFPClass = computeKnownFPClass(CI.getArgOperand(1), fcAllFlags, SQ, Depth + 1);
                    if KnownMag.getSignBit() && KnownSign.getSignBit() && operator(KnownMag.getSignBit()) == operator(KnownSign.getSignBit()) {
                        return CI.getOperand(0);
                    }
                    if FMF.noNaNs() {
                        KnownSign.knownNot(fcNan);
                    }
                    if KnownSign.getSignBit() == false {
                        CI.dropUBImplyingAttrsAndMetadata(ArrayRef<unsigned int> {});
                        CI.setOperand(1, getZero(VTy, false));
                        return I;
                    }
                    if KnownSign.getSignBit() == true {
                        CI.dropUBImplyingAttrsAndMetadata(ArrayRef<unsigned int> {});
                        CI.setOperand(1, get(VTy, -1.0));
                        return I;
                    }
                    Known = copysign(KnownMag, KnownSign);
                    Known.knownNot(operator(DemandedMask));
                    break;
                },
                fma => {
                    fmuladd;
                },
                maximum => {
                    minimum;
                },
                exp => {
                    exp2;
                },
                log => {
                    log2;
                },
                sqrt => {
                    let mut DemandedSrcMask: FPClassTest = DemandedMask & (fcNegZero | fcPositive | fcNan);
                    if DemandedMask & fcNan {
                        operator(DemandedSrcMask, fcNan | (fcNegative & operator(fcNegZero)));
                    }
                    if DemandedMask & fcPosNormal {
                        operator(DemandedSrcMask, fcPosSubnormal);
                    }
                    let mut KnownSrc: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
                    if self.SimplifyDemandedFPClass(I, 0, DemandedSrcMask, KnownSrc, SQ, Depth + 1) {
                        return I;
                    }
                    if (DemandedMask & fcNan) == fcNone {
                        KnownSrc.knownNot((fcNegative & operator(fcNegZero)) | fcNan);
                    }
                    if (DemandedMask & fcPosInf) == fcNone {
                        KnownSrc.knownNot(fcPosInf);
                    }
                    let mut EltTy: *mut Type = VTy.getScalarType();
                    let mut Mode: DenormalMode = self.F.getDenormalMode(EltTy.getFltSemantics());
                    if KnownSrc.isKnownNever(fcPositive) && KnownSrc.isKnownNeverLogicalZero(Mode) {
                        return getQNaN(VTy, false, null);
                    }
                    Known = sqrt(KnownSrc, Mode);
                    Known.knownNot(operator(DemandedMask));
                    if Known.getKnownFPClasses() == fcZero {
                        if FMF.noSignedZeros() {
                            return getZero(VTy, false);
                        }
                        let mut Guard: InsertPointGuard = self.Builder;
                        self.Builder.SetInsertPoint(CI);
                        let mut Copysign: *mut Value = self.Builder.CreateCopySign(getZero(VTy, false), CI.getArgOperand(0), FMF, "");
                        Copysign.takeName(CI);
                        return Copysign;
                    }
                    return simplifyDemandedFPClassResult(CI, FMF, DemandedMask, Known, [KnownSrc]);
                },
                ldexp => {
                    let mut SrcDemandedMask: FPClassTest = DemandedMask & fcInf;
                    if DemandedMask & fcNan {
                        operator(SrcDemandedMask, fcNan);
                    }
                    if DemandedMask & fcPosInf {
                        operator(SrcDemandedMask, fcPosNormal | fcPosSubnormal);
                    }
                    if DemandedMask & fcNegInf {
                        operator(SrcDemandedMask, fcNegNormal | fcNegSubnormal);
                    }
                    if DemandedMask & (fcPosNormal | fcPosSubnormal) {
                        operator(SrcDemandedMask, fcPosNormal | fcPosSubnormal);
                    }
                    if DemandedMask & (fcNegNormal | fcNegSubnormal) {
                        operator(SrcDemandedMask, fcNegNormal | fcNegSubnormal);
                    }
                    if DemandedMask & fcPosZero {
                        operator(SrcDemandedMask, fcPosFinite);
                    }
                    if DemandedMask & fcNegZero {
                        operator(SrcDemandedMask, fcNegFinite);
                    }
                    let mut KnownSrc: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
                    if self.SimplifyDemandedFPClass(CI, 0, SrcDemandedMask, KnownSrc, SQ, Depth + 1) {
                        return CI;
                    }
                    let mut EltTy: *mut Type = VTy.getScalarType();
                    let mut FltSem: *fltSemantics = EltTy.getFltSemantics();
                    let mut Mode: DenormalMode = self.F.getDenormalMode(FltSem);
                    let mut KnownExpBits: KnownBits = computeKnownBits(CI.getArgOperand(1), SQ, Depth + 1);
                    Known = ldexp(KnownSrc, KnownExpBits, FltSem, Mode);
                    Known.knownNot(operator(DemandedMask));
                    return simplifyDemandedFPClassResult(CI, FMF, DemandedMask, Known, [KnownSrc]);
                },
                trunc => {
                    floor;
                },
                fptrunc_round => {
                    return simplifyDemandedUseFPClassFPTrunc(*self, *CI, FMF, DemandedMask, Known, SQ, Depth);
                },
                canonicalize => {
                    let mut EltTy: *mut Type = VTy.getScalarType();
                    if EltTy.isIEEELikeFPTy() {
                        let mut Mode: DenormalMode = self.F.getDenormalMode(EltTy.getFltSemantics());
                        let mut SrcDemandedMask: FPClassTest = DemandedMask;
                        if (DemandedMask & fcQNan) != fcNone {
                            operator(SrcDemandedMask, fcSNan);
                        }
                        if Mode != getIEEE() {
                            if DemandedMask & fcPosZero {
                                operator(SrcDemandedMask, fcPosSubnormal);
                            }
                            if DemandedMask & fcNegZero {
                                operator(SrcDemandedMask, fcNegSubnormal);
                            }
                        }
                        if Mode == getPreserveSign() {
                            if (DemandedMask & fcPosZero) == fcNone {
                                operator(SrcDemandedMask, operator(fcPosSubnormal));
                            }
                            if (DemandedMask & fcNegZero) == fcNone {
                                operator(SrcDemandedMask, operator(fcNegSubnormal));
                            }
                        }
                        let mut KnownSrc: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
                        if self.SimplifyDemandedFPClass(I, 0, SrcDemandedMask, KnownSrc, SQ, Depth + 1) {
                            return I;
                        }
                        Known = canonicalize(KnownSrc, Mode);
                        Known.knownNot(operator(DemandedMask));
                        if getFPClassConstant(VTy, Known.getKnownFPClasses(), false) {
                            SingleVal;
                        } else {
                            return SingleVal;
                        }
                        if KnownSrc.isKnownNeverNaN() && (Mode == getIEEE() || KnownSrc.isKnownNeverSubnormal()) {
                            return CI.getArgOperand(0);
                        }
                        let mut InferredFMF: FastMathFlags = inferFastMathValueFlags(FMF, Known.getKnownFPClasses(), KnownSrc);
                        if InferredFMF != FMF {
                            CI.dropUBImplyingAttrsAndMetadata(ArrayRef<unsigned int> {});
                            CI.setFastMathFlags(InferredFMF);
                            return CI;
                        }
                        return null;
                    }
                },
                _ => {
                    Known = computeKnownFPClass(I, DemandedMask, SQ, Depth + 1);
                },
            }
            break;
        },
        Select => {
            let mut KnownLHS: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
            let mut KnownRHS: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
            if self.SimplifyDemandedFPClass(I, 2, DemandedMask, KnownRHS, SQ, Depth + 1) || self.SimplifyDemandedFPClass(I, 1, DemandedMask, KnownLHS, SQ, Depth + 1) {
                return I;
            }
            if KnownLHS.isKnownNever(DemandedMask) {
                return I.getOperand(2);
            }
            if KnownRHS.isKnownNever(DemandedMask) {
                return I.getOperand(1);
            }
            adjustKnownFPClassForSelectArm(KnownLHS, I.getOperand(0), I.getOperand(1), false, SQ, Depth);
            adjustKnownFPClassForSelectArm(KnownRHS, I.getOperand(0), I.getOperand(2), true, SQ, Depth);
            Known = KnownLHS.intersectWith(KnownRHS);
            Known.knownNot(operator(DemandedMask));
            break;
        },
        ExtractElement => {
            if self.SimplifyDemandedFPClass(I, 0, DemandedMask, Known, SQ, Depth + 1) {
                return I;
            }
            Known.knownNot(operator(DemandedMask));
            break;
        },
        InsertElement => {
            let mut KnownInserted: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
            let mut KnownVec: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
            if self.SimplifyDemandedFPClass(I, 1, DemandedMask, KnownInserted, SQ, Depth + 1) || self.SimplifyDemandedFPClass(I, 0, DemandedMask, KnownVec, SQ, Depth + 1) {
                return I;
            }
            Known = KnownVec | KnownInserted;
            Known.knownNot(operator(DemandedMask));
            break;
        },
        ShuffleVector => {
            let mut KnownLHS: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
            let mut KnownRHS: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
            if self.SimplifyDemandedFPClass(I, 1, DemandedMask, KnownRHS, SQ, Depth + 1) || self.SimplifyDemandedFPClass(I, 0, DemandedMask, KnownLHS, SQ, Depth + 1) {
                return I;
            }
            Known = KnownLHS | KnownRHS;
            Known.knownNot(operator(DemandedMask));
            break;
        },
        InsertValue => {
            let mut KnownAgg: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
            let mut KnownElt: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
            if self.SimplifyDemandedFPClass(I, 0, DemandedMask, KnownAgg, SQ, Depth + 1) || self.SimplifyDemandedFPClass(I, 1, DemandedMask, KnownElt, SQ, Depth + 1) {
                return I;
            }
            Known = KnownAgg | KnownElt;
            break;
        },
        ExtractValue => {
            let mut ExtractSrc: *mut Value = null;
            if match(I, m_ExtractValue(m_OneUse(m_Value(ExtractSrc)))) {
                if dyn_cast(ExtractSrc) {
                    II;
                } else {
                    let mut IID: ID = II.getIntrinsicID();
                    match IID {
                        frexp => {
                            let mut SrcDemandedMask: FPClassTest = fcNone;
                            if DemandedMask & fcNan {
                                operator(SrcDemandedMask, fcNan);
                            }
                            if DemandedMask & fcNegFinite {
                                operator(SrcDemandedMask, fcNegFinite);
                            }
                            if DemandedMask & fcPosFinite {
                                operator(SrcDemandedMask, fcPosFinite);
                            }
                            if DemandedMask & fcPosInf {
                                operator(SrcDemandedMask, fcPosInf);
                            }
                            if DemandedMask & fcNegInf {
                                operator(SrcDemandedMask, fcNegInf);
                            }
                            let mut KnownSrc: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
                            if self.SimplifyDemandedFPClass(II, 0, SrcDemandedMask, KnownSrc, SQ, Depth + 1) {
                                return I;
                            }
                            let mut EltTy: *mut Type = VTy.getScalarType();
                            let mut Mode: DenormalMode = self.F.getDenormalMode(EltTy.getFltSemantics());
                            Known = frexp_mant(KnownSrc, Mode);
                            Known.setKnownFPClasses(Known.getKnownFPClasses() & DemandedMask);
                            if getFPClassConstant(VTy, Known.getKnownFPClasses(), true) {
                                SingleVal;
                            } else {
                                return SingleVal;
                            }
                            if Known.isKnownAlways(fcInf | fcNan) {
                                return II.getArgOperand(0);
                            }
                            return null;
                        },
                        _ => {
                            break;
                        },
                    }
                }
            }
            let mut KnownSrc: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
            if self.SimplifyDemandedFPClass(I, 0, DemandedMask, KnownSrc, SQ, Depth + 1) {
                return I;
            }
            Known = KnownSrc;
            break;
        },
        PHI => {
            let mut PhiRecursionLimit: u32 = MaxAnalysisRecursionDepth - 2;
            if Depth >= PhiRecursionLimit {
                break;
            }
            let mut P: *mut PHINode = cast(I);
            let mut ContextSQ: SimplifyQuery = SQ.getWithoutCondContext();
            let mut First: bool = true;
            let mut Changed: bool = false;
            for let mut I: u32 = 0;
let mut E: u32 = P.getNumIncomingValues(); I != E; I += 1 {
                let mut PredBB: *mut BasicBlock = P.getIncomingBlock(I);
                let mut CtxI: *Instruction = PredBB.getTerminator();
                let mut KnownSrc: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
                if self.SimplifyDemandedFPClass(P, P.getOperandNumForIncomingValue(I), DemandedMask, KnownSrc, ContextSQ.getWithInstruction(CtxI), Depth + 1) {
                    P.setIncomingValueForBlock(PredBB, P.getIncomingValue(I));
                    Changed = true;
                }
                if First {
                    Known = KnownSrc;
                    First = false;
                } else {
                    operator(Known, KnownSrc);
                }
            }
            if Changed {
                return P;
            }
            Known.knownNot(operator(DemandedMask));
            break;
        },
        _ => {
            Known = computeKnownFPClass(I, DemandedMask, SQ, Depth + 1);
        },
    }
    return getFPClassConstant(VTy, Known.getKnownFPClasses(), false);
}

fn InstCombinerImpl::SimplifyMultipleUseDemandedFPClass(self, I: *mut Instruction, DemandedMask: FPClassTest, Known: *mut KnownFPClass, SQ: *SimplifyQuery, Depth: u32) -> *mut Value {
    let mut FMF: FastMathFlags = FastMathFlags {};
    if dyn_cast(I) {
        FPOp;
    } else {
        FMF = FPOp.getFastMathFlags();
        DemandedMask = adjustDemandedMaskFromFlags(DemandedMask, FMF);
    }
    match I.getOpcode() {
        Select => {
            let mut KnownRHS: KnownFPClass = computeKnownFPClass(I.getOperand(2), DemandedMask, SQ, Depth + 1);
            if KnownRHS.isKnownNever(DemandedMask) {
                return I.getOperand(1);
            }
            let mut KnownLHS: KnownFPClass = computeKnownFPClass(I.getOperand(1), DemandedMask, SQ, Depth + 1);
            if KnownLHS.isKnownNever(DemandedMask) {
                return I.getOperand(2);
            }
            adjustKnownFPClassForSelectArm(KnownLHS, I.getOperand(0), I.getOperand(1), false, SQ, Depth);
            adjustKnownFPClassForSelectArm(KnownRHS, I.getOperand(0), I.getOperand(2), true, SQ, Depth);
            Known = KnownLHS.intersectWith(KnownRHS);
            Known.knownNot(operator(DemandedMask));
            break;
        },
        FNeg => {
            let mut Src: *mut Value = null;
            let mut FNegSrc: *mut Value = I.getOperand(0);
            if !match(FNegSrc, m_FAbs(m_Value(Src))) {
                Known = computeKnownFPClass(I, DemandedMask, SQ, Depth + 1);
                break;
            }
            let mut KnownSrc: KnownFPClass = computeKnownFPClass(Src, fcAllFlags, SQ, Depth + 1);
            let mut FabsFMF: FastMathFlags = cast(FNegSrc).getFastMathFlags();
            let mut ThisDemandedMask: FPClassTest = adjustDemandedMaskFromFlags(DemandedMask, FabsFMF);
            if simplifyDemandedFPClassFnegFabs(Known, Src, ThisDemandedMask, KnownSrc, false) {
                Simplified;
            } else {
                return Simplified;
            }
            break;
        },
        Call => {
            let mut CI: *CallInst = cast(I);
            let mut IID: ID = CI.getIntrinsicID();
            match IID {
                fabs => {
                    let mut Src: *mut Value = CI.getArgOperand(0);
                    let mut KnownSrc: KnownFPClass = computeKnownFPClass(Src, fcAllFlags, SQ, Depth + 1);
                    if simplifyDemandedFPClassFabs(Known, CI.getArgOperand(0), DemandedMask, KnownSrc, false) {
                        Simplified;
                    } else {
                        return Simplified;
                    }
                    break;
                },
                copysign => {
                    let mut Mag: *mut Value = CI.getArgOperand(0);
                    let mut Sign: *mut Value = CI.getArgOperand(1);
                    let mut KnownMag: KnownFPClass = computeKnownFPClass(Mag, fcAllFlags, SQ, Depth + 1);
                    KnownMag.knownNot(operator(unknown_sign(DemandedMask)));
                    if simplifyDemandedFPClassCopysignMag(Mag, DemandedMask, KnownMag, false) {
                        Simplified;
                    } else {
                        return Simplified;
                    }
                    let mut KnownSign: KnownFPClass = computeKnownFPClass(Sign, fcAllFlags, SQ, Depth + 1);
                    if FMF.noInfs() {
                        KnownSign.knownNot(fcInf);
                    }
                    if FMF.noNaNs() {
                        KnownSign.knownNot(fcNan);
                    }
                    if KnownSign.getSignBit() && KnownMag.getSignBit() && operator(KnownSign.getSignBit()) == operator(KnownMag.getSignBit()) {
                        return Mag;
                    }
                    Known = copysign(KnownMag, KnownSign);
                    break;
                },
                maxnum => {
                    minnum;
                },
                _ => {
                    break;
                },
            }
        },
        _ => {
            Known = computeKnownFPClass(I, DemandedMask, SQ, Depth + 1);
        },
    }
    return getFPClassConstant(I.getType(), Known.getKnownFPClasses(), false);
}

fn InstCombinerImpl::SimplifyDemandedFPClass(self, I: *mut Instruction, OpNo: u32, DemandedMask: FPClassTest, Known: *mut KnownFPClass, SQ: *SimplifyQuery, Depth: u32) -> bool {
    let mut U: *mut Use = I.getOperandUse(OpNo);
    let mut V: *mut Value = U.get();
    let mut VTy: *mut Type = V.getType();
    if DemandedMask == fcNone {
        if isa(V) {
            return false;
        }
        self.replaceUse(U, get(VTy));
        return true;
    }
    let mut VInst: *mut Instruction = dyn_cast(V);
    if !VInst {
        Known = computeKnownFPClass(V, fcAllFlags, SQ, Depth);
        Known.knownNot(operator(DemandedMask));
        if Known.getKnownFPClasses() == fcNone {
            if isa(V) {
                return false;
            }
