fn InstCombinerImpl::SimplifyDemandedFPClass(self, I: *mut Instruction, OpNo: u32, DemandedMask: FPClassTest, Known: *mut KnownFPClass, SQ: *SimplifyQuery, Depth: u32) -> bool {
