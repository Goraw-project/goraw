fn leftDistributesOverRight(LOp: BinaryOps, HasNUW: bool, HasNSW: bool, ROp: ID) -> bool {
    match ROp {
        umax => {
            umin;
        },
        smax => {
            smin;
        },
        _ => {
            return false;
        },
    }
}

fn rightDistributesOverLeft(LOp: BinaryOps, HasNUW: bool, HasNSW: bool, ROp: ID) -> bool {
    if isCommutative(LOp) || LOp == Shl {
        return leftDistributesOverRight(LOp, HasNUW, HasNSW, ROp);
    }
    match ROp {
        umax => {
            umin;
        },
        smax => {
            smin;
        },
        _ => {
            return false;
        },
    }
}

fn foldIntrinsicUsingDistributiveLaws(II: *mut IntrinsicInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut LHS: *mut Value = II.getOperand(0);
    let mut RHS: *mut Value = II.getOperand(1);
    let mut TopLevelOpcode: ID = II.getIntrinsicID();
    let mut Op0: *mut OverflowingBinaryOperator = dyn_cast(LHS);
    let mut Op1: *mut OverflowingBinaryOperator = dyn_cast(RHS);
    if !Op0 || !Op1 {
        return null;
    }
    if Op0.getOpcode() != Op1.getOpcode() {
        return null;
    }
    if !Op0.hasOneUse() || !Op1.hasOneUse() {
        return null;
    }
    let mut InnerOpcode: BinaryOps = Op0.getOpcode() as BinaryOps;
    let mut HasNUW: bool = Op0.hasNoUnsignedWrap() && Op1.hasNoUnsignedWrap();
    let mut HasNSW: bool = Op0.hasNoSignedWrap() && Op1.hasNoSignedWrap();
    let mut A: *mut Value = Op0.getOperand(0);
    let mut B: *mut Value = Op0.getOperand(1);
    let mut C: *mut Value = Op1.getOperand(0);
    let mut D: *mut Value = Op1.getOperand(1);
    if Op0.isCommutative() && A != C && B != D {
        if A == D || B == C {
            swap(C, D);
        } else {
            return null;
        }
    }
    if A == C && leftDistributesOverRight(InnerOpcode, HasNUW, HasNSW, TopLevelOpcode) {
        let mut NewIntrinsic: *mut Value = Builder.CreateBinaryIntrinsic(TopLevelOpcode, B, D, FMFSource {}, "");
        return Builder.CreateNoWrapBinOp(InnerOpcode, A, NewIntrinsic, HasNUW, HasNSW, "");
    }
    if B == D && rightDistributesOverLeft(InnerOpcode, HasNUW, HasNSW, TopLevelOpcode) {
        let mut NewIntrinsic: *mut Value = Builder.CreateBinaryIntrinsic(TopLevelOpcode, A, C, FMFSource {}, "");
        return Builder.CreateNoWrapBinOp(InnerOpcode, NewIntrinsic, B, HasNUW, HasNSW, "");
    }
    return null;
}

fn foldNeonShift(II: *mut IntrinsicInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut Arg0: *mut Value = II.getArgOperand(0);
    let mut ShiftConst: *mut Constant = dyn_cast(II.getArgOperand(1));
    if !ShiftConst {
        return null;
    }
    let mut ElemBits: i32 = Arg0.getType().getScalarSizeInBits();
    let mut AllPositive: bool = true;
    let mut AllNegative: bool = true;
    let mut Check: Closure_12 = Closure_12 { AllNegative: &mut AllNegative, AllPositive: &mut AllPositive, ElemBits: &mut ElemBits };
    if dyn_cast(Arg0.getType()) {
        VTy;
    } else {
        for let mut I: u32 = 0;
let mut E: u32 = VTy.getNumElements(); I < E; I += 1 {
            if !Check.call(ShiftConst.getAggregateElement(I)) {
                return null;
            }
        }
    }
    let mut B: *mut IRBuilderBase = IC.Builder;
    if AllPositive {
        return IC.replaceInstUsesWith(*II, B.CreateShl(Arg0, ShiftConst, "", false, false));
    }
    let mut NegAmt: *mut Value = B.CreateNeg(ShiftConst, "", false);
    let mut IID: ID = II.getIntrinsicID();
    let mut IsSigned: bool = IID == arm_neon_vshifts || IID == aarch64_neon_sshl;
    let mut Result: *mut Value = if IsSigned { B.CreateAShr(Arg0, NegAmt, "", false) } else { B.CreateLShr(Arg0, NegAmt, "", false) };
    return IC.replaceInstUsesWith(*II, Result);
}

fn foldSinAndCosToSinCos(II: *mut IntrinsicInst, B: *mut IRBuilderBase, IC: *mut InstCombinerImpl) -> *mut Value {
    let mut IID: ID = II.getIntrinsicID();
    let mut IsSin: bool = IID == sin;
    let mut MatchID: ID = if IsSin { cos } else { sin };
    let mut Arg: *mut Value = II.getArgOperand(0);
    if isa(Arg) {
        return null;
    }
    let mut Match: *mut IntrinsicInst = null;
    for U in Arg.users() {
        if dyn_cast(U) {
            Cand;
        } else {
            if Cand != II && !Cand.use_empty() && Cand.getIntrinsicID() == MatchID {
                Match = Cand;
                break;
            }
        }
    }
    if !Match {
        return null;
    }
    let mut Guard: InsertPointGuard = B;
    if dyn_cast(Arg) {
        ArgInst;
    } else {
        let mut InsertPt: iterator> = ArgInst.getInsertionPointAfterDef();
        if !InsertPt {
            return null;
        }
        B.SetInsertPoint(operator(InsertPt));
    }
    let mut SinCosFunc: *mut Function = getOrInsertDeclaration(II.getModule(), sincos, Arg.getType());
    let mut SinCos: *mut CallInst = B.CreateCall(SinCosFunc, Arg, "sincos", null);
    SinCos.setFastMathFlags(II.getFastMathFlags() & Match.getFastMathFlags());
    if getMostGenericFPMath(II.getMetadata(MD_fpmath), Match.getMetadata(MD_fpmath)) {
        MD;
    } else {
        SinCos.setMetadata(MD_fpmath, MD);
    }
    let mut Sin: *mut Value = B.CreateExtractValue(SinCos, 0, "sin");
    let mut Cos: *mut Value = B.CreateExtractValue(SinCos, 1, "cos");
    IC.replaceInstUsesWith(*Match, if IsSin { Cos } else { Sin });
    IC.eraseInstFromFunction(*Match);
    return if IsSin { Sin } else { Cos };
}

fn foldCmpIntrinsicOfExtended(II: *mut IntrinsicInst, Builder: *mut BuilderTy, DL: *DataLayout) -> *mut Value {
    let mut ExtIdx: u32 = 0;
    let mut X: *mut Value = null;
    if !match(II.getArgOperand(0), m_ZExtOrSExt(m_Value(X))) {
        ExtIdx = 1;
        if !match(II.getArgOperand(1), m_ZExtOrSExt(m_Value(X))) {
            return null;
        }
    }
    let mut CastOpc: CastOps = cast(II.getArgOperand(ExtIdx)).getOpcode() as CastOps;
    let mut NarrowTy: *mut Type = X.getType();
    let mut OtherOp: *mut Value = II.getArgOperand(1 - ExtIdx);
    let mut Y: *mut Value = null;
    let mut WideC: *mut Constant = null;
    if match(OtherOp, m_ZExtOrSExt(m_Value(Y))) {
        if cast(OtherOp).getOpcode() != CastOpc || Y.getType() != NarrowTy {
            return null;
        }
    } else if match(OtherOp, m_ImmConstant(WideC)) {
        Y = getLosslessInvCast(WideC, NarrowTy, CastOpc, DL, null);
        if !Y {
            return null;
        }
    } else {
        return null;
    }
    let mut NewIID: ID = if II.getIntrinsicID() == scmp && CastOpc == SExt { scmp } else { ucmp };
    if ExtIdx != 0 {
        swap(X, Y);
    }
    return Builder.CreateIntrinsic(II.getType(), NewIID, [X, Y], FMFSource {}, "", function_ref<void (CallInst *)> { Closure_13 {}, null, null });
}

fn InstCombinerImpl::visitCallInst(self, CI: *mut CallInst) -> *mut Instruction {
    if !CI.use_empty() {
        let mut Args: SmallVector<Value *, 8> = CI.args();
        if simplifyCall(&mut CI, CI.getCalledOperand(), Args, self.SQ.getWithInstruction(&mut CI)) {
            V;
        } else {
            return self.replaceInstUsesWith(CI, V);
        }
    }
    if getFreedOperand(&mut CI, &mut self.TLI) {
        FreedOp;
    } else {
        return self.visitFree(CI, FreedOp);
    }
    if CI.getFunction().doesNotThrow() && !CI.doesNotThrow() {
        CI.setDoesNotThrow();
        return &mut CI;
    }
    let mut II: *mut IntrinsicInst = dyn_cast(&mut CI);
    if !II {
        return self.visitCallBase(CI);
    }
    if dyn_cast(II) {
        MI;
    } else {
        if MI.getLengthInBytes() {
            NumBytes;
        } else {
            if operator(NumBytes).isZero() {
                return self.eraseInstFromFunction(CI);
            }
            if MI.isAtomic() && (operator(NumBytes).isNegative() || (operator(NumBytes).getZExtValue() % MI.getElementSizeInBytes() != 0)) {
                self.CreateNonTerminatorUnreachable(MI);
                assert!(MI.getType().isVoidTy(), "non void atomic unordered mem intrinsic");
                return self.eraseInstFromFunction(*MI);
            }
        }
        if MI.isVolatile() {
            return null;
        }
        if dyn_cast(MI) {
            MTI;
        } else {
            if MTI.getSource() == MTI.getDest() {
                return self.eraseInstFromFunction(CI);
            }
        }
        let mut IsPointerUndefined: Closure_14 = Closure_14 { MI: MI };
        let mut SrcIsUndefined: bool = false;
        if dyn_cast(MI) {
            MTI;
        } else {
            if self.SimplifyAnyMemTransfer(MTI) {
                I;
            } else {
                return I;
            }
            SrcIsUndefined = IsPointerUndefined.call(MTI.getRawSource());
        }
        if SrcIsUndefined || IsPointerUndefined.call(MI.getRawDest()) {
            self.Builder.CreateAssumption(self.Builder.CreateIsNull(MI.getLength(), ""));
            return self.eraseInstFromFunction(CI);
        }
        if dyn_cast(MI) {
            MMI;
        } else {
            if dyn_cast(MMI.getSource()) {
                GVSrc;
            } else if GVSrc.isConstant() {
                let mut M: *mut Module = CI.getModule();
                let mut MemCpyID: ID = if MMI.isAtomic() { memcpy_element_unordered_atomic } else { memcpy };
                let mut Tys: [3]*mut Type = [CI.getArgOperand(0).getType(), CI.getArgOperand(1).getType(), CI.getArgOperand(2).getType()];
                CI.setCalledFunction(getOrInsertDeclaration(M, MemCpyID, Tys));
                return II;
            }
        }
    }
    if dyn_cast(II.getType()) {
        IIFVTy;
    } else {
        let mut VWidth: u32 = IIFVTy.getNumElements();
        let mut PoisonElts: APInt = APInt { VWidth, 0, false, false };
        let mut AllOnesEltMask: APInt = getAllOnes(VWidth);
        if self.SimplifyDemandedVectorElts(II, AllOnesEltMask, PoisonElts, 0, false) {
            V;
        } else {
            if V != II {
                return self.replaceInstUsesWith(*II, V);
            }
            return II;
        }
    }
    if II.isCommutative() {
        if self.matchSymmetricPair(II.getOperand(0), II.getOperand(1)) {
            Pair;
        } else {
            self.replaceOperand(*II, 0, operator(Pair).first);
            self.replaceOperand(*II, 1, operator(Pair).second);
            II.dropPoisonGeneratingAnnotations();
            II.dropUBImplyingAttrsAndMetadata(ArrayRef<unsigned int> {});
            return II;
        }
        if canonicalizeConstantArg0ToArg1(CI) {
            NewCall;
        } else {
            return NewCall;
        }
    }
    if CI.use_empty() && isa(CI) {
        if simplifyConstrainedFPCall(&mut CI, self.SQ.getWithInstruction(&mut CI)) {
            return self.eraseInstFromFunction(CI);
        }
    }
    let mut IID: ID = II.getIntrinsicID();
    match IID {
        objectsize => {
            let mut InsertedInstructions: SmallVector<Instruction *> = SmallVector<Instruction *> {};
            if lowerObjectSizeCall(II, self.DL, &mut self.TLI, self.AA, false, &mut InsertedInstructions) {
                V;
            } else {
                for Inserted in InsertedInstructions {
                    self.Worklist.add(Inserted);
                }
                return self.replaceInstUsesWith(CI, V);
            }
            return null;
        },
        abs => {
            let mut IIOperand: *mut Value = II.getArgOperand(0);
            let mut IntMinIsPoison: bool = cast(II.getArgOperand(1)).isOneValue();
            let mut X: *mut Value = null;
            if match(IIOperand, m_Neg(m_Value(X))) {
                return Create(II.getCalledFunction(), [X, self.Builder.getInt1(IntMinIsPoison || cast(IIOperand).hasNoSignedWrap())], ArrayRef<OperandBundleDef> {}, "", null);
            }
            if match(IIOperand, m_c_Select(m_Neg(m_Value(X)), m_Deferred(X))) {
                return Create(II.getCalledFunction(), [X, II.getArgOperand(1)], ArrayRef<OperandBundleDef> {}, "", null);
            }
            let mut Y: *mut Value = null;
            if match(IIOperand, m_OneUse(m_c_Mul(m_Value(X), m_Intrinsic(m_Value(Y))))) {
                let mut NSW: bool = cast(IIOperand).hasNoSignedWrap() && IntMinIsPoison;
                let mut XY: *mut Value = if NSW { self.Builder.CreateNSWMul(X, Y, "") } else { self.Builder.CreateMul(X, Y, "", false, false) };
                return Create(II.getCalledFunction(), [XY, II.getArgOperand(1)], ArrayRef<OperandBundleDef> {}, "", null);
            }
            if getKnownSignOrZero(IIOperand, self.SQ.getWithInstruction(II)) {
                Known;
            } else {
                if !operator(Known) {
                    return self.replaceInstUsesWith(*II, IIOperand);
                }
                if IntMinIsPoison {
                    return CreateNSWNeg(IIOperand, "", null);
                }
                return CreateNeg(IIOperand, "", null);
            }
            if match(IIOperand, m_OneUse(m_SExt(m_Value(X)))) {
                let mut NarrowAbs: *mut Value = self.Builder.CreateBinaryIntrinsic(abs, X, self.Builder.getFalse(), FMFSource {}, "");
                return Create(ZExt, NarrowAbs, II.getType(), "", null);
            }
            let mut C: *APInt = null;
            if match(IIOperand, m_SRem(m_Value(X), m_APInt(C))) && *C == 2 {
                return CreateAnd(X, get(II.getType(), 1, false, false), "");
            }
            break;
        },
        umin => {
            let mut I0: *mut Value = II.getArgOperand(0);
            let mut I1: *mut Value = II.getArgOperand(1);
            if match(I1, m_One()) {
                assert!(II.getType().getScalarSizeInBits() != 1, "Expected simplify of umin with max constant");
                let mut Zero: *mut Value = getNullValue(I0.getType());
                let mut Cmp: *mut Value = self.Builder.CreateICmpNE(I0, Zero, "");
                return Create(ZExt, Cmp, II.getType(), "", null);
            }
            if foldMinimumOverTrailingOrLeadingZeroCount(I0, I1, self.DL, self.Builder) {
                FoldedCttz;
            } else {
                return self.replaceInstUsesWith(*II, FoldedCttz);
            }
            if foldMinimumOverTrailingOrLeadingZeroCount(I0, I1, self.DL, self.Builder) {
                FoldedCtlz;
            } else {
                return self.replaceInstUsesWith(*II, FoldedCtlz);
            }
        },
        umax => {
            let mut I0: *mut Value = II.getArgOperand(0);
            let mut I1: *mut Value = II.getArgOperand(1);
            let mut X: *mut Value = null;
            let mut Y: *mut Value = null;
            if match(I0, m_ZExt(m_Value(X))) && match(I1, m_ZExt(m_Value(Y))) && (I0.hasOneUse() || I1.hasOneUse()) && X.getType() == Y.getType() {
                let mut NarrowMaxMin: *mut Value = self.Builder.CreateBinaryIntrinsic(IID, X, Y, FMFSource {}, "");
                return Create(ZExt, NarrowMaxMin, II.getType(), "", null);
            }
            let mut C: *mut Constant = null;
            if match(I0, m_ZExt(m_Value(X))) && match(I1, m_Constant(C)) && I0.hasOneUse() {
                if getLosslessUnsignedTrunc(C, X.getType(), self.DL, null) {
                    NarrowC;
                } else {
                    let mut NarrowMaxMin: *mut Value = self.Builder.CreateBinaryIntrinsic(IID, X, NarrowC, FMFSource {}, "");
                    return Create(ZExt, NarrowMaxMin, II.getType(), "", null);
                }
            }
            let mut foldMaxMulShift: Closure_15 = Closure_15 { cap_0: self, II: &mut II };
            if IID == umax {
                if foldMaxMulShift.call(I0, I1) {
                    I;
                } else {
                    return I;
                }
                if foldMaxMulShift.call(I1, I0) {
                    I;
                } else {
                    return I;
                }
            }
        },
        smax => {
            smin;
        },
        scmp => {
            ucmp;
        },
        bitreverse => {
            let mut IIOperand: *mut Value = II.getArgOperand(0);
            let mut X: *mut Value = null;
            if match(IIOperand, m_ZExt(m_Value(X))) && X.getType().isIntOrIntVectorTy(1) {
                let mut Ty: *mut Type = II.getType();
                let mut SignBit: APInt = getSignMask(Ty.getScalarSizeInBits());
                let mut SI: *mut SelectInst = Create(X, get(Ty, SignBit), getNullValue(Ty), "", null, null);
                setExplicitlyUnknownBranchWeightsIfProfiled(*SI, "instcombine", &mut self.F);
                return SI;
            }
            if foldBitOrderCrossLogicOp(IIOperand, self.Builder) {
                crossLogicOpFold;
            } else {
                return crossLogicOpFold;
            }
            break;
        },
        bswap => {
            let mut IIOperand: *mut Value = II.getArgOperand(0);
            let mut X: *mut Value = null;
            let mut Y: *mut Value = null;
            if match(IIOperand, m_OneUse(m_LogicalShift(m_Value(X), m_Value(Y)))) {
                let mut BitWidth: u32 = IIOperand.getType().getScalarSizeInBits();
                if self.MaskedValueIsZero(Y, getLowBitsSet(BitWidth, 3), null, 0) {
