                            break;
                        }
                        if operator(Count) == 0 || isDereferenceablePointer(Ptr.operator llvm::Value *(), APInt { 64, operator(Count), false, false }, self.getSimplifyQuery().getWithInstruction(II), false) {
                            return RemoveBundle.call();
                        }
                        break;
                    },
                    Ignore => {
                        return RemoveBundle.call();
                    },
                    NonNull => {
                        if isKnownNonZero(Ptr.operator llvm::Value *(), self.getSimplifyQuery().getWithInstruction(II), 0) {
                            return RemoveBundle.call();
                        }
                        let mut LI: *mut LoadInst = dyn_cast(Ptr);
                        if LI && isValidAssumeForContext(II, LI, &mut self.DT, true) {
                            let mut MD: *mut MDNode = get(II.getContext(), ArrayRef<Metadata *> {});
                            LI.setMetadata(MD_nonnull, MD);
                            LI.setMetadata(MD_noundef, MD);
                            return RemoveBundle.call();
                        }
                        let mut GEP: *mut GEPOperator = dyn_cast(Ptr);
                        if GEP && GEP.isInBounds() && !NullPointerIsDefined(II.getFunction(), operator(Ptr).getType().getPointerAddressSpace()) {
                            self.Builder.CreateNonnullAssumption(GEP.stripInBoundsOffsets(function_ref<void (const Value *)> { Closure_21 {}, null, null }));
                            return RemoveBundle.call();
                        }
                        break;
                    },
                    NoUndef => {
                        if isGuaranteedNotToBeUndefOrPoison(Val.operator llvm::Value *(), &mut self.AC, II, &mut self.DT, 0) {
                            return RemoveBundle.call();
                        }
                        let mut LI: *mut LoadInst = dyn_cast(Val);
                        if LI && isValidAssumeForContext(II, LI, &mut self.DT, true) {
                            LI.setMetadata(MD_noundef, get(II.getContext(), ArrayRef<Metadata *> {}));
                            return RemoveBundle.call();
                        }
                    },
                    SeparateStorage => {
                        let mut MaybeSimplifyHint: Closure_22 = Closure_22 { cap_0: self };
                        MaybeSimplifyHint.call(Ptr1);
                        MaybeSimplifyHint.call(Ptr2);
                    },
                    DereferenceableOrNull => {
                        break;
                    },
                    Cold => {
                        break;
                    },
                }
            }
            if II.hasOperandBundles() {
                break;
            }
            let mut IIOperand: *mut Value = II.getArgOperand(0);
            let mut A: *mut Value = null;
            let mut B: *mut Value = null;
            if match(IIOperand, m_LogicalAnd(m_Value(A), m_Value(B))) {
                self.Builder.CreateAssumption(A);
                self.Builder.CreateAssumption(B);
                return self.eraseInstFromFunction(*II);
            }
            if match(IIOperand, m_Not(m_LogicalOr(m_Value(A), m_Value(B)))) {
                self.Builder.CreateAssumption(self.Builder.CreateNot(A, ""));
                self.Builder.CreateAssumption(self.Builder.CreateNot(B, ""));
                return self.eraseInstFromFunction(*II);
            }
            if match(IIOperand, m_CombineOr(m_SpecificICmp(CmpPredicate { Pred: ICMP_NE, HasSameSign: false }, m_Value(A), m_Zero()), m_Not(m_SpecificICmp(CmpPredicate { Pred: ICMP_EQ, HasSameSign: false }, m_Value(A), m_Zero())))) && A.getType().isPointerTy() {
                self.Builder.CreateNonnullAssumption(A);
                return self.eraseInstFromFunction(*II);
            }
            let mut AlignMask: u64 = 1;
            if (match(IIOperand, m_Not(m_Trunc(m_Value(A)))) || match(IIOperand, m_SpecificICmp(CmpPredicate { Pred: ICMP_EQ, HasSameSign: false }, m_And(m_Value(A), m_ConstantInt(AlignMask)), m_Zero()))) {
                if isPowerOf2_64(AlignMask + 1) && match(A, m_PtrToIntOrAddr(m_Value(A))) {
                    self.Builder.CreateAlignmentAssumption(self.getDataLayout(), A, AlignMask + 1, null);
                    return self.eraseInstFromFunction(*II);
                }
            }
            let mut CI: *mut ConstantInt = dyn_cast(IIOperand);
            if CI || isa(IIOperand) {
                if !CI || CI.isZero() {
                    self.CreateNonTerminatorUnreachable(II);
                }
                return self.eraseInstFromFunction(*II);
            }
            self.AC.updateAffectedValues(cast(II));
            break;
        },
        experimental_guard => {
            let mut NextInst: *mut Instruction = II.getNextNode();
            for let mut i: u32 = 0; i < self.CLOpts.guard_widening_window; i += 1 {
                if !isSafeToSpeculativelyExecute(NextInst, null, null, null, null, true, true) {
                    break;
                }
                NextInst = NextInst.getNextNode();
            }
            let mut NextCond: *mut Value = null;
            if match(NextInst, m_Intrinsic(m_Value(NextCond))) {
                let mut CurrCond: *mut Value = II.getArgOperand(0);
                if CurrCond != NextCond {
                    let mut MoveI: *mut Instruction = II.getNextNode();
                    while MoveI != NextInst {
                        let mut Temp: *mut Instruction = MoveI;
                        MoveI = MoveI.getNextNode();
                        Temp.moveBefore(II.getIterator());
                    }
                    self.replaceOperand(*II, 0, self.Builder.CreateAnd(CurrCond, NextCond, ""));
                }
                self.eraseInstFromFunction(*NextInst);
                return II;
            }
            break;
        },
        vector_insert => {
            let mut Vec: *mut Value = II.getArgOperand(0);
            let mut SubVec: *mut Value = II.getArgOperand(1);
            let mut Idx: *mut Value = II.getArgOperand(2);
            let mut DstTy: *mut FixedVectorType = dyn_cast(II.getType());
            let mut VecTy: *mut FixedVectorType = dyn_cast(Vec.getType());
            let mut SubVecTy: *mut FixedVectorType = dyn_cast(SubVec.getType());
            if DstTy && VecTy && SubVecTy {
                let mut DstNumElts: u32 = DstTy.getNumElements();
                let mut VecNumElts: u32 = VecTy.getNumElements();
                let mut SubVecNumElts: u32 = SubVecTy.getNumElements();
                let mut IdxN: u32 = cast(Idx).getZExtValue();
                if VecNumElts == SubVecNumElts {
                    return self.replaceInstUsesWith(CI, SubVec);
                }
                let mut WidenMask: SmallVector<int, 8> = SmallVector<int, 8> {};
                let mut i: u32 = 0;
                for i = 0; i != SubVecNumElts; i += 1 {
                    WidenMask.push(i);
                }
                for ; i != VecNumElts; i += 1 {
                    WidenMask.push(PoisonMaskElem);
                }
                let mut WidenShuffle: *mut Value = self.Builder.CreateShuffleVector(SubVec, WidenMask, "");
                let mut Mask: SmallVector<int, 8> = SmallVector<int, 8> {};
                for let mut i: u32 = 0; i != IdxN; i += 1 {
                    Mask.push(i);
                }
                for let mut i: u32 = DstNumElts; i != DstNumElts + SubVecNumElts; i += 1 {
                    Mask.push(i);
                }
                for let mut i: u32 = IdxN + SubVecNumElts; i != DstNumElts; i += 1 {
                    Mask.push(i);
                }
                let mut Shuffle: *mut Value = self.Builder.CreateShuffleVector(Vec, WidenShuffle, Mask, "");
                return self.replaceInstUsesWith(CI, Shuffle);
            }
            break;
        },
        vector_extract => {
            let mut Vec: *mut Value = II.getArgOperand(0);
            let mut Idx: *mut Value = II.getArgOperand(1);
            let mut ReturnType: *mut Type = II.getType();
            let mut ExtractIdx: u64 = cast(Idx).getZExtValue();
            let mut InsertTuple: *mut Value = null;
            let mut InsertIdx: *mut Value = null;
            let mut InsertValue: *mut Value = null;
            if match(Vec, m_Intrinsic(m_Value(InsertTuple), m_Value(InsertValue), m_Value(InsertIdx))) && InsertValue.getType() == ReturnType {
                let mut Index: u64 = cast(InsertIdx).getZExtValue();
                if ExtractIdx == Index {
                    return self.replaceInstUsesWith(CI, InsertValue);
                } else {
                    return self.replaceOperand(CI, 0, InsertTuple);
                }
            }
            let mut ALMUpperBound: *mut ConstantInt = null;
            if match(Vec, m_Intrinsic(m_Value(), m_ConstantInt(ALMUpperBound))) {
                let mut Attrs: *AttributeSet = II.getFunction().getAttributes().getFnAttrs();
                let mut VScaleMin: u32 = Attrs.getVScaleRangeMin();
                let mut ScaleFactor: u32 = if cast(ReturnType).isScalableTy() { VScaleMin } else { 1 };
                if ExtractIdx * ScaleFactor >= ALMUpperBound.getZExtValue() {
                    return self.replaceInstUsesWith(CI, getNullValue(ReturnType));
                }
            }
            let mut DstTy: *mut VectorType = dyn_cast(ReturnType);
            let mut VecTy: *mut VectorType = dyn_cast(Vec.getType());
            if DstTy && VecTy {
                let mut DstEltCnt: ElementCount = DstTy.getElementCount();
                let mut VecEltCnt: ElementCount = VecTy.getElementCount();
                let mut IdxN: u32 = cast(Idx).getZExtValue();
                if DstEltCnt == VecTy.getElementCount() {
                    self.replaceInstUsesWith(CI, Vec);
                    return self.eraseInstFromFunction(CI);
                }
                if VecEltCnt.isScalable() || DstEltCnt.isScalable() {
                    break;
                }
                let mut Mask: SmallVector<int, 8> = SmallVector<int, 8> {};
                for let mut i: u32 = 0; i != DstEltCnt.getKnownMinValue(); i += 1 {
                    Mask.push(IdxN + i);
                }
                let mut Shuffle: *mut Value = self.Builder.CreateShuffleVector(Vec, Mask, "");
                return self.replaceInstUsesWith(CI, Shuffle);
            }
            break;
        },
        experimental_vp_reverse => {
            let mut X: *mut Value = null;
            let mut Vec: *mut Value = II.getArgOperand(0);
            let mut Mask: *mut Value = II.getArgOperand(1);
            if !match(Mask, m_AllOnes()) {
                break;
            }
            let mut EVL: *mut Value = II.getArgOperand(2);
            if match(Vec, m_OneUse(m_UnOp(m_Intrinsic(m_Value(X), m_AllOnes(), m_Specific(EVL))))) {
                let mut OldUnOp: *mut UnaryOperator = cast(Vec);
                let mut NewUnOp: *mut UnaryOperator = CreateWithCopiedFlags(OldUnOp.getOpcode(), X, OldUnOp, OldUnOp.getName(), II.getIterator());
                return self.replaceInstUsesWith(CI, NewUnOp);
            }
            break;
        },
        vector_reduce_or => {
            vector_reduce_and;
        },
        vector_reduce_add => {
            if IID == vector_reduce_add {
                let mut Arg: *mut Value = II.getArgOperand(0);
                let mut Vect: *mut Value = null;
                if simplifyReductionOperand(Arg, true) {
                    NewOp;
                } else {
                    self.replaceUse(II.getOperandUse(0), NewOp);
                    return II;
                }
                if getSplatValue(Arg) {
                    Splat;
                } else {
                    let mut VecToReduceCount: ElementCount = cast(Arg.getType()).getElementCount();
                    if VecToReduceCount.isFixed() {
                        let mut VectorSize: u32 = VecToReduceCount.getFixedValue();
                        return CreateMul(Splat, get(Splat.getType(), VectorSize, false, true), "");
                    }
                }
                if match(Arg, m_ZExtOrSExtOrSelf(m_Value(Vect))) {
                    if dyn_cast(Vect.getType()) {
                        FTy;
                    } else if FTy.getElementType() == self.Builder.getInt1Ty() {
                        let mut V: *mut Value = self.Builder.CreateBitCast(Vect, self.Builder.getIntNTy(FTy.getNumElements()), "");
                        let mut Res: *mut Value = self.Builder.CreateUnaryIntrinsic(ctpop, V, FMFSource {}, "");
                        Res = self.Builder.CreateZExtOrTrunc(Res, II.getType(), "");
                        if Arg != Vect && cast(Arg).getOpcode() == SExt {
                            Res = self.Builder.CreateNeg(Res, "", false);
                        }
                        return self.replaceInstUsesWith(CI, Res);
                    }
                }
            }
        },
        vector_reduce_xor => {
            if IID == vector_reduce_xor {
                let mut Arg: *mut Value = II.getArgOperand(0);
                let mut Vect: *mut Value = null;
                if simplifyReductionOperand(Arg, true) {
                    NewOp;
                } else {
                    self.replaceUse(II.getOperandUse(0), NewOp);
                    return II;
                }
                if match(Arg, m_ZExtOrSExtOrSelf(m_Value(Vect))) {
                    if dyn_cast(Vect.getType()) {
                        VTy;
                    } else if VTy.getElementType() == self.Builder.getInt1Ty() {
                        let mut Res: *mut Value = self.Builder.CreateAddReduce(Vect);
                        if Arg != Vect {
                            Res = self.Builder.CreateCast(cast(Arg).getOpcode(), Res, II.getType(), "", null, FMFSource {});
                        }
                        return self.replaceInstUsesWith(CI, Res);
                    }
                }
            }
        },
        vector_reduce_mul => {
            if IID == vector_reduce_mul {
                let mut Arg: *mut Value = II.getArgOperand(0);
                if simplifyReductionOperand(Arg, true) {
                    NewOp;
                } else {
                    self.replaceUse(II.getOperandUse(0), NewOp);
                    return II;
                }
                let mut Vect: *mut Value = null;
                let mut IsZext: bool = match(Arg, m_ZExt(m_Value(Vect))) && Vect.getType().isIntOrIntVectorTy(1);
                let mut IsSext: bool = match(Arg, m_SExt(m_Value(Vect))) && Vect.getType().isIntOrIntVectorTy(1) && cast(Vect.getType()).getElementCount().isKnownEven();
                if IsZext || IsSext {
                    let mut Res: *mut Value = self.Builder.CreateAndReduce(Vect);
                    return Create(ZExt, Res, II.getType(), "", null);
                }
                if Arg.getType().isIntOrIntVectorTy(1) {
                    return self.replaceInstUsesWith(CI, self.Builder.CreateAndReduce(Arg));
                }
            }
        },
        vector_reduce_umin => {
            vector_reduce_umax;
        },
        vector_reduce_smin => {
            vector_reduce_smax;
        },
        vector_reduce_fmax => {
            vector_reduce_fmin;
        },
        is_fpclass => {
            if self.foldIntrinsicIsFPClass(*II) {
                I;
            } else {
                return I;
            }
            break;
        },
        threadlocal_address => {
            let mut MinAlign: Align = getKnownAlignment(II.getArgOperand(0), self.DL, II, &mut self.AC, &mut self.DT);
            let mut Align: MaybeAlign = II.getRetAlign();
            if MinAlign > Align.valueOrOne() {
                II.addRetAttr(getWithAlignment(II.getContext(), MinAlign));
                return II;
            }
            break;
        },
        fptoui_sat => {
            fptosi_sat;
        },
        frexp => {
            if match(II.getArgOperand(0), m_ExtractValue(m_Intrinsic(m_Value()))) {
                let mut Res: *mut Value = self.Builder.CreateInsertValue(get(II.getType()), II.getArgOperand(0), 0, "");
                Res = self.Builder.CreateInsertValue(Res, getNullValue(II.getType().getStructElementType(1)), 1, "");
                return self.replaceInstUsesWith(*II, Res);
            }
            break;
        },
        get_active_lane_mask => {
            let mut Op0: *APInt = null;
            let mut Op1: *APInt = null;
            if match(II.getOperand(0), m_StrictlyPositive(Op0)) && match(II.getOperand(1), m_APInt(Op1)) {
                let mut OpTy: *mut Type = II.getOperand(0).getType();
                return self.replaceInstUsesWith(*II, self.Builder.CreateIntrinsic(II.getType(), get_active_lane_mask, [getNullValue(OpTy), get(OpTy, Op1.usub_sat(*Op0))], FMFSource {}, "", function_ref<void (CallInst *)> { Closure_23 {}, null, null }));
            }
            break;
        },
        experimental_get_vector_length => {
            let mut BitWidth: u32 = if II.getArgOperand(0).getType().getScalarSizeInBits() > II.getType().getScalarSizeInBits() { II.getArgOperand(0).getType().getScalarSizeInBits() } else { II.getType().getScalarSizeInBits() };
            let mut Cnt: ConstantRange = computeConstantRangeIncludingKnownBits(II.getArgOperand(0), false, self.SQ.getWithInstruction(II)).zextOrTrunc(BitWidth);
            let mut MaxLanes: ConstantRange = cast(II.getArgOperand(1)).getValue().zextOrTrunc(Cnt.getBitWidth());
            if cast(II.getArgOperand(2)).isOne() {
                MaxLanes = MaxLanes.multiply(getVScaleRange(II.getFunction(), Cnt.getBitWidth()), 0);
            }
            if Cnt.icmp(ICMP_ULE, MaxLanes) {
                return self.replaceInstUsesWith(*II, self.Builder.CreateZExtOrTrunc(II.getArgOperand(0), II.getType(), ""));
            }
            return null;
        },
        _ => {
            let mut V: optional<Instruction *> = self.targetInstCombineIntrinsic(*II);
            if V {
                return operator(V);
            }
            break;
        },
    }
    if isSafeToSpeculativelyExecuteWithVariableReplaced(&mut CI, true) {
        for Op in II.args() {
            if dyn_cast(Op) {
                Sel;
            } else {
                let mut IsVectorCond: bool = Sel.getCondition().getType().isVectorTy();
                if IsVectorCond && (!isNotCrossLaneOperation(II) || !II.getType().isVectorTy()) {
                    continue;
                }
                let mut SimplifyBothArms: bool = !Op.getType().isVectorTy() && II.getType().isVectorTy();
                if self.FoldOpIntoSelect(*II, Sel, false, SimplifyBothArms) {
                    R;
                } else {
                    return R;
                }
            }
            if dyn_cast(Op) {
                Phi;
            } else if self.foldOpIntoPhi(*II, Phi, false) {
                R;
            } else {
                return R;
            }
        }
    }
    if self.foldShuffledIntrinsicOperands(II) {
        Shuf;
    } else {
        return Shuf;
    }
    if self.foldReversedIntrinsicOperands(II) {
        Reverse;
    } else {
        return self.replaceInstUsesWith(*II, Reverse);
    }
    if foldIdempotentBinaryIntrinsicRecurrence(*self, II) {
        Res;
    } else {
        return self.replaceInstUsesWith(*II, Res);
    }
    return self.visitCallBase(*II);
}

fn InstCombinerImpl::visitFenceInst(self, FI: *mut FenceInst) -> *mut Instruction {
    let mut NFI: *mut FenceInst = dyn_cast(FI.getNextNode());
    if NFI && FI.isIdenticalTo(NFI) {
        return self.eraseInstFromFunction(FI);
    }
    let mut isIdenticalOrStrongerFence: Closure_24 = Closure_24 {};
    if NFI && isIdenticalOrStrongerFence.call(NFI, &mut FI) {
        return self.eraseInstFromFunction(FI);
    }
    if dyn_cast_or_null(FI.getPrevNode()) {
        PFI;
    } else if isIdenticalOrStrongerFence.call(PFI, &mut FI) {
        return self.eraseInstFromFunction(FI);
    }
    return null;
}

fn InstCombinerImpl::visitInvokeInst(self, II: *mut InvokeInst) -> *mut Instruction {
    return self.visitCallBase(II);
}

fn InstCombinerImpl::visitCallBrInst(self, CBI: *mut CallBrInst) -> *mut Instruction {
    return self.visitCallBase(CBI);
}

fn parseFormatStringSpecifiers(FormatStr: str) -> Bitset<256> {
    let mut Specifiers: Bitset<256> = Bitset<256> {};
    for let mut I: u64 = 0; I < FormatStr.len; I += 1 {
        if FormatStr[I] != '%' {
            continue;
        }
        if I + 1 < FormatStr.len && FormatStr[I + 1] == '%' {
            I += 1;
            continue;
        }
        let mut J: u64 = FormatStr.find_first_not_of("0123456789-+ #0$.*'hlLjztqwvI", I + 1);
        if J == npos {
            break;
        }
        Specifiers.set(FormatStr[J] as u8);
        I = J;
    }
    return Specifiers;
}

fn isAspectNeeded(Aspect: str, CI: *mut CallInst, FirstArgIdx: optional<unsigned int>, Specifiers: *optional<Bitset<256>>) -> bool {
    if Aspect == "float" {
        if Specifiers {
            let mut FloatSpecifiers: Bitset<256> = ['f', 'F', 'e', 'E', 'g', 'G', 'a', 'A'];
            return (operator(Specifiers) & FloatSpecifiers).any();
        }
        if !FirstArgIdx {
            return true;
        }
        return any_of(make_range(next(CI.arg_begin(), operator(FirstArgIdx)), CI.arg_end()), Closure_25 {});
    }
    if Aspect == "fixed" {
        if Specifiers {
            let mut FixedSpecifiers: Bitset<256> = ['r', 'R', 'k', 'K'];
            return (operator(Specifiers) & FixedSpecifiers).any();
        }
        return true;
    }
    return true;
}

fn referenceAspect(Aspect: str, ImplName: str, M: *mut Module, B: *mut IRBuilderBase) {
    let mut Name: str = ImplName;
    operator(Name, '_');
    operator(Name, Aspect);
    let mut Ctx: *mut LLVMContext = M.getContext();
    let mut RelocNoneFn: *mut Function = getOrInsertDeclaration(M, reloc_none, ArrayRef<Type *> {});
    B.CreateCall(RelocNoneFn, [get(Ctx, get(Ctx, Name.operator StringRef()))], "", null);
}

fn optimizeModularFormat(CI: *mut CallInst, B: *mut IRBuilderBase) -> *mut Value {
    if !CI.hasFnAttr("modular-format") {
        return null;
    }
    let mut Args: SmallVector<StringRef> = split(CI.getFnAttr("modular-format").getValueAsString(), ',');
    if Args.len < 5 {
        return null;
    }
    let mut FormatIdxStr: str = Args[1];
    let mut FirstArgIdxStr: str = Args[2];
    let mut FnName: str = Args[3];
    let mut ImplName: str = Args[4];
    let mut AllAspects: ArrayRef<StringRef> = Args.drop_front(5);
    let mut FormatIdx: u32 = 0;
    let mut FirstArgIdx: optional<unsigned int> = optional<unsigned int> {};
    let mut Error: bool = false;
    Error = FormatIdxStr.getAsInteger(10, FormatIdx);
    assert!(!Error, "invalid format arg index");
    FormatIdx -= 1;
    FirstArgIdx.emplace();
    Error = FirstArgIdxStr.getAsInteger(10, operator(FirstArgIdx));
    assert!(!Error, "invalid first arg index");
    if operator(FirstArgIdx) > 0 {
        operator(FirstArgIdx) -= 1;
    } else {
        FirstArgIdx.reset();
    }
    if AllAspects.is_empty() {
        return null;
    }
    let mut FormatVal: *mut Value = CI.getArgOperand(FormatIdx);
    let mut FormatStr: str = "";
    let mut Specifiers: optional<Bitset<256>> = optional<Bitset<256>> {};
    if getConstantStringInfo(FormatVal, FormatStr, true) {
        Specifiers = parseFormatStringSpecifiers(FormatStr);
    }
    let mut NeededAspects: SmallVector<StringRef> = SmallVector<StringRef> {};
    for Aspect in AllAspects {
        if isAspectNeeded(Aspect, CI, FirstArgIdx, Specifiers) {
            NeededAspects.push(Aspect);
        }
    }
    if NeededAspects.len == AllAspects.len {
        return null;
    }
    let mut M: *mut Module = CI.getModule();
    let mut Ctx: *mut LLVMContext = M.getContext();
    let mut Callee: *mut Function = CI.getCalledFunction();
    let mut ModularFn: FunctionCallee = M.getOrInsertFunction(FnName, Callee.getFunctionType(), Callee.getAttributes().removeFnAttribute(Ctx, "modular-format"));
    let mut New: *mut CallInst = cast(CI.clone());
    New.setCalledFunction(ModularFn);
    New.removeFnAttr("modular-format");
    B.Insert(New, "");
    sort(NeededAspects);
    for Request in NeededAspects {
        referenceAspect(Request, ImplName, M, B);
    }
    return New;
}

fn InstCombinerImpl::tryOptimizeCall(self, CI: *mut CallInst) -> *mut Instruction {
    if !CI.getCalledFunction() {
        return null;
    }
    if CI.isMustTailCall() || CI.isNoTailCall() {
        return null;
    }
    let mut InstCombineRAUW: Closure_26 = Closure_26 { cap_0: self };
    let mut InstCombineErase: Closure_27 = Closure_27 { cap_0: self };
    let mut Simplifier: LibCallSimplifier = LibCallSimplifier { self.DL, &mut self.TLI, &mut self.DT, &mut self.DC, &mut self.AC, self.ORE, self.BFI, self.PSI, function_ref<void (Instruction *, Value *)> { InstCombineRAUW, null, null }, function_ref<void (Instruction *)> { InstCombineErase, null, null } };
    if Simplifier.optimizeCall(CI, self.Builder) {
        With;
    } else {
        operator(NumSimplified);
        return if CI.use_empty() { CI } else { self.replaceInstUsesWith(*CI, With) };
    }
    if optimizeModularFormat(CI, self.Builder) {
        With;
    } else {
        operator(NumSimplified);
        return if CI.use_empty() { CI } else { self.replaceInstUsesWith(*CI, With) };
    }
    return null;
}

fn findInitTrampolineFromAlloca(TrampMem: *mut Value) -> *mut IntrinsicInst {
    let mut Underlying: *mut Value = TrampMem.stripPointerCasts();
    if Underlying != TrampMem && (!Underlying.hasOneUse() || Underlying.user_back() != TrampMem) {
        return null;
    }
    if !isa(Underlying) {
        return null;
    }
    let mut InitTrampoline: *mut IntrinsicInst = null;
    for U in TrampMem.users() {
        let mut II: *mut IntrinsicInst = dyn_cast(U);
        if !II {
            return null;
        }
        if II.getIntrinsicID() == init_trampoline {
            if InitTrampoline {
                return null;
            }
            InitTrampoline = II;
            continue;
        }
        if II.getIntrinsicID() == adjust_trampoline {
            continue;
        }
        return null;
    }
    if !InitTrampoline {
        return null;
    }
    if InitTrampoline.getOperand(0) != TrampMem {
        return null;
    }
    return InitTrampoline;
}

fn findInitTrampolineFromBB(AdjustTramp: *mut IntrinsicInst, TrampMem: *mut Value) -> *mut IntrinsicInst {
    for let mut I: iterator = AdjustTramp.getIterator();
let mut E: iterator = AdjustTramp.getParent().begin(); I != E;  {
        let mut Inst: *mut Instruction = &mut operator(operator(I));
        if dyn_cast(I) {
            II;
        } else if II.getIntrinsicID() == init_trampoline && II.getOperand(0) == TrampMem {
            return II;
        }
        if Inst.mayWriteToMemory() {
            return null;
        }
    }
    return null;
}

fn findInitTrampoline(Callee: *mut Value) -> *mut IntrinsicInst {
    Callee = Callee.stripPointerCasts();
    let mut AdjustTramp: *mut IntrinsicInst = dyn_cast(Callee);
    if !AdjustTramp || AdjustTramp.getIntrinsicID() != adjust_trampoline {
        return null;
    }
    let mut TrampMem: *mut Value = AdjustTramp.getOperand(0);
    if findInitTrampolineFromAlloca(TrampMem) {
        IT;
    } else {
        return IT;
    }
    if findInitTrampolineFromBB(AdjustTramp, TrampMem) {
        IT;
    } else {
        return IT;
    }
    return null;
}

fn InstCombinerImpl::foldPtrAuthIntrinsicCallee(self, Call: *mut CallBase) -> *mut Instruction {
    let mut Callee: *Value = Call.getCalledOperand();
    let mut IPC: *IntToPtrInst const = dyn_cast(Callee);
    if !IPC || !IPC.isNoopCast(self.DL) {
        return null;
    }
    let mut II: *IntrinsicInst const = dyn_cast(IPC.getOperand(0));
    if !II {
        return null;
    }
    let mut IIID: ID = II.getIntrinsicID();
    if IIID != ptrauth_resign && IIID != ptrauth_sign {
        return null;
    }
    let mut PtrAuthBundleOrNone: optional<OperandBundleUse> = optional<OperandBundleUse> {};
    let mut NewBundles: SmallVector<OperandBundleDef, 2> = SmallVector<OperandBundleDef, 2> {};
    for let mut BI: u32 = 0;
let mut BE: u32 = Call.getNumOperandBundles(); BI != BE; BI += 1 {
        let mut Bundle: OperandBundleUse = Call.getOperandBundleAt(BI);
        if Bundle.getTagID() == OB_ptrauth {
            PtrAuthBundleOrNone = Bundle;
        } else {
            NewBundles.push(Bundle);
        }
    }
    if !PtrAuthBundleOrNone {
        return null;
    }
    let mut NewCallee: *mut Value = null;
    match IIID {
        ptrauth_resign => {
            if II.getOperand(3) != operator(PtrAuthBundleOrNone).Inputs[0].operator llvm::Value *() {
                return null;
            }
            if II.getOperand(4) != operator(PtrAuthBundleOrNone).Inputs[1].operator llvm::Value *() {
                return null;
            }
            if II.getOperand(1) != operator(PtrAuthBundleOrNone).Inputs[0].operator llvm::Value *() {
                return null;
            }
            let mut NewBundleOps: [2]*mut Value = [II.getOperand(1), II.getOperand(2)];
            NewBundles.push("ptrauth", NewBundleOps);
            NewCallee = II.getOperand(0);
            break;
        },
        ptrauth_sign => {
            if II.getOperand(1) != operator(PtrAuthBundleOrNone).Inputs[0].operator llvm::Value *() {
                return null;
            }
            if II.getOperand(2) != operator(PtrAuthBundleOrNone).Inputs[1].operator llvm::Value *() {
                return null;
            }
            NewCallee = II.getOperand(0);
            break;
        },
        _ => {
            llvm_unreachable_internal("unexpected intrinsic ID", "P:/Goraw/llvm-project/llvm/lib/Transforms/InstCombine/InstCombineCalls.cpp", 4960);
        },
    }
    if !NewCallee {
        return null;
    }
    NewCallee = self.Builder.CreateBitOrPointerCast(NewCallee, Callee.getType(), "");
    let mut NewCall: *mut CallBase = Create(&mut Call, NewBundles, null);
    NewCall.setCalledOperand(NewCallee);
    return NewCall;
}

fn InstCombinerImpl::foldPtrAuthConstantCallee(self, Call: *mut CallBase) -> *mut Instruction {
    let mut CPA: *mut ConstantPtrAuth = dyn_cast(Call.getCalledOperand());
    if !CPA {
        return null;
    }
    let mut CalleeF: *mut Function = dyn_cast(CPA.getPointer());
    if !CalleeF {
        return null;
    }
    let mut PAB: optional<OperandBundleUse> = Call.getOperandBundle(OB_ptrauth);
    if !PAB {
        return null;
    }
    let mut Key: *mut ConstantInt = cast(operator(PAB).Inputs[0]);
    let mut Discriminator: *mut Value = operator(PAB).Inputs[1].operator llvm::Value *();
    if !CPA.isKnownCompatibleWith(Key, Discriminator, self.DL) {
        return null;
    }
    let mut NewCall: *mut CallBase = removeOperandBundle(&mut Call, OB_ptrauth, null);
    NewCall.setCalledOperand(CalleeF);
    return NewCall;
}

fn InstCombinerImpl::annotateAnyAllocSite(self, Call: *mut CallBase, TLI: *TargetLibraryInfo) -> bool {
    let mut Changed: bool = false;
    if !Call.getType().isPointerTy() {
        return Changed;
    }
    let mut Size: optional<APInt> = getAllocSize(&mut Call, TLI, function_ref<const Value *(const Value *)> { Closure_28 {}, null, null });
    if Size && operator(Size) != 0 {
        if Call.hasRetAttr(NonNull) {
            Changed = !Call.hasRetAttr(Dereferenceable);
            Call.addRetAttr(getWithDereferenceableBytes(Call.getContext(), operator(Size).getLimitedValue(18446744073709551615)));
        } else {
            Changed = !Call.hasRetAttr(DereferenceableOrNull);
            Call.addRetAttr(getWithDereferenceableOrNullBytes(Call.getContext(), operator(Size).getLimitedValue(18446744073709551615)));
        }
    }
    let mut Alignment: *mut Value = getAllocAlignment(&mut Call, TLI);
    if !Alignment {
        return Changed;
    }
    let mut AlignOpC: *mut ConstantInt = dyn_cast(Alignment);
    if AlignOpC && AlignOpC.getValue().ult(MaximumAlignment) {
        let mut AlignmentVal: u64 = AlignOpC.getZExtValue();
        if isPowerOf2_64(AlignmentVal) {
            let mut ExistingAlign: Align = Call.getRetAlign().valueOrOne();
            let mut NewAlign: Align = AlignmentVal;
            if NewAlign > ExistingAlign {
                Call.addRetAttr(getWithAlignment(Call.getContext(), NewAlign));
                Changed = true;
            }
        }
    }
    return Changed;
}

fn InstCombinerImpl::visitCallBase(self, Call: *mut CallBase) -> *mut Instruction {
    let mut Changed: bool = self.annotateAnyAllocSite(Call, &mut self.TLI);
    let mut ArgNos: SmallVector<unsigned int, 4> = SmallVector<unsigned int, 4> {};
    let mut ArgNo: u32 = 0;
    for V in Call.args() {
        if V.getType().isPointerTy() {
            let mut UseProvenance: bool = Call.getParamDereferenceableBytes(ArgNo) > 0 && !NullPointerIsDefined(Call.getFunction(), V.getType().getPointerAddressSpace());
            if Call.paramHasAttr(ArgNo, NonNull) || UseProvenance {
                if self.simplifyNonNullOperand(V, UseProvenance, 0) {
                    Res;
                } else {
                    self.replaceOperand(Call, ArgNo, Res);
                    Changed = true;
                }
            } else if isKnownNonZero(V, self.getSimplifyQuery().getWithInstruction(&mut Call), 0) {
                ArgNos.push(ArgNo);
            }
        }
        ArgNo += 1;
    }
    assert!(ArgNo == Call.arg_size(), "Call arguments not processed correctly.");
    if !ArgNos.is_empty() {
        let mut AS: AttributeList = Call.getAttributes();
        let mut Ctx: *mut LLVMContext = Call.getContext();
        AS = AS.addParamAttribute(Ctx, ArgNos, get(Ctx, NonNull, 0));
        Call.setAttributes(AS);
        Changed = true;
    }
    let mut Callee: *mut Value = Call.getCalledOperand();
    let mut CalleeF: *mut Function = dyn_cast(Callee);
    if (!CalleeF || CalleeF.getFunctionType() != Call.getFunctionType()) && self.transformConstExprCastCall(Call) {
        return null;
    }
    if CalleeF {
        if Call.isConvergent() && !CalleeF.isConvergent() && !CalleeF.isIntrinsic() {
            while true {
                {
                if DebugFlag && isCurrentDebugType("instcombine", 1) {
                    dbgs() << "Removing convergent attr from instr " << Call << "\n";
                }
            }
                if !(false) { break; }
            }
            Call.setNotConvergent();
            return &mut Call;
        }
        if (CalleeF.getCallingConv() != Call.getCallingConv() && !(CalleeF.getCallingConv() == C && isCallingConvCCompatible(&mut Call)) && !(Call.getCallingConv() == C && isCallingConvCCompatible(CalleeF))) && !CalleeF.isDeclaration() {
            let mut OldCall: *mut Instruction = &mut Call;
            self.CreateNonTerminatorUnreachable(OldCall);
            if !OldCall.getType().isVoidTy() {
                self.replaceInstUsesWith(*OldCall, get(OldCall.getType()));
            }
            if isa(OldCall) {
                return self.eraseInstFromFunction(*OldCall);
            }
            cast(OldCall).setCalledFunction(CalleeF.getFunctionType(), getNullValue(CalleeF.getType()));
            return null;
        }
    }
    if (isa(Callee) && !NullPointerIsDefined(Call.getFunction(), 0)) || isa(Callee) {
        if !Call.getType().isVoidTy() {
            self.replaceInstUsesWith(Call, get(Call.getType()));
        }
        if Call.isTerminator() {
            return null;
        }
        self.CreateNonTerminatorUnreachable(&mut Call);
        return self.eraseInstFromFunction(Call);
    }
    if findInitTrampoline(Callee) {
        II;
    } else {
        return self.transformCallThroughTrampoline(Call, *II);
    }
    if self.foldPtrAuthIntrinsicCallee(Call) {
        NewCall;
    } else {
        return NewCall;
    }
    if self.foldPtrAuthConstantCallee(Call) {
        NewCall;
    } else {
        return NewCall;
    }
    if isa(Callee) && !Call.doesNotThrow() {
        let mut IA: *mut InlineAsm = cast(Callee);
        if !IA.canThrow() {
            Call.setDoesNotThrow();
            Changed = true;
        }
    }
    if dyn_cast(&mut Call) {
        CI;
    } else {
        let mut I: *mut Instruction = self.tryOptimizeCall(CI);
        if I {
            return self.eraseInstFromFunction(*I);
        }
    }
    if !Call.use_empty() && !Call.isMustTailCall() {
        if Call.getReturnedArgOperand() {
            ReturnedArg;
        } else {
            let mut CallTy: *mut Type = Call.getType();
            let mut RetArgTy: *mut Type = ReturnedArg.getType();
            if RetArgTy.canLosslesslyBitCastTo(CallTy) {
                return self.replaceInstUsesWith(Call, self.Builder.CreateBitOrPointerCast(ReturnedArg, CallTy, ""));
            }
        }
    }
    if Call.getMetadata(MD_callee_type) && !Call.isIndirectCall() {
        Call.setMetadata(MD_callee_type, null);
        Changed = true;
    }
    let mut Bundle: optional<OperandBundleUse> = Call.getOperandBundle(OB_kcfi);
    if Bundle && !Call.isIndirectCall() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("instcombine-kcfi", 1) {
                {
                    if CalleeF {
                        let mut FunctionType: *mut ConstantInt = null;
                        let mut ExpectedType: *mut ConstantInt = cast(operator(Bundle).Inputs[0]);
                        if CalleeF.getMetadata(MD_kcfi_type) {
                            MD;
                        } else {
                            FunctionType = extract(MD.getOperand(0));
                        }
                        if FunctionType && FunctionType.getZExtValue() != ExpectedType.getZExtValue() {
                            dbgs() << Call.getModule().getName() << ": warning: kcfi: " << Call.getCaller().getName() << ": call to " << CalleeF.getName() << " using a mismatching function pointer type\n";
                        }
                    }
                }
            }
        }
            if !(false) { break; }
        }
        return removeOperandBundle(&mut Call, OB_kcfi, null);
    }
    if isRemovableAlloc(&mut Call, &mut self.TLI) {
        return self.visitAllocSite(Call);
    }
    match Call.getIntrinsicID() {
        experimental_gc_statepoint => {
            let mut GCSP: *mut GCStatepointInst = *cast(&mut Call);
            let mut LiveGcValues: SmallPtrSet<Value *, 32> = SmallPtrSet<Value *, 32> {};
            for Reloc in GCSP.getGCRelocates() {
                let mut GCR: *mut GCRelocateInst = *Reloc;
                if GCR.use_empty() {
                    self.eraseInstFromFunction(GCR);
                    continue;
                }
                let mut DerivedPtr: *mut Value = GCR.getDerivedPtr();
                let mut BasePtr: *mut Value = GCR.getBasePtr();
                if isa(DerivedPtr) || isa(BasePtr) {
                    self.replaceInstUsesWith(GCR, get(GCR.getType()));
                    self.eraseInstFromFunction(GCR);
                    continue;
                }
                if dyn_cast(GCR.getType()) {
                    PT;
                } else {
                    if isa(DerivedPtr) {
                        self.replaceInstUsesWith(GCR, get(PT));
                        self.eraseInstFromFunction(GCR);
                        continue;
                    }
                    if !GCR.hasRetAttr(NonNull) && isKnownNonZero(DerivedPtr, self.getSimplifyQuery().getWithInstruction(&mut Call), 0) {
                        GCR.addRetAttr(NonNull);
                        self.Worklist.pushUsersToWorkList(GCR);
                    }
                }
                if GCR.getBasePtr() == GCR.getDerivedPtr() && GCR.getBasePtrIndex() != GCR.getDerivedPtrIndex() {
                    let mut OpIntTy: *mut Type = GCR.getOperand(2).getType();
                    GCR.setOperand(2, get(OpIntTy, GCR.getBasePtrIndex(), false, false));
                }
                LiveGcValues.insert(BasePtr);
                LiveGcValues.insert(DerivedPtr);
            }
            let mut Bundle: optional<OperandBundleUse> = GCSP.getOperandBundle(OB_gc_live);
            let mut NumOfGCLives: u32 = LiveGcValues.len;
            if !Bundle || NumOfGCLives == operator(Bundle).Inputs.len {
                break;
            }
            let mut Val2Idx: DenseMap<Value *, unsigned int> = DenseMap<Value *, unsigned int> {};
            let mut NewLiveGc: []*mut Value = []*mut Value {};
            for V in operator(Bundle).Inputs {
                if !Inserted {
                    continue;
                }
                if LiveGcValues.count(V) {
                    operator(It).second = NewLiveGc.len;
                    NewLiveGc.push(V);
                } else {
                    operator(It).second = NumOfGCLives;
                }
            }
            for Reloc in GCSP.getGCRelocates() {
                let mut GCR: *mut GCRelocateInst = *Reloc;
                let mut BasePtr: *mut Value = GCR.getBasePtr();
                assert!(Val2Idx.count(BasePtr) && Val2Idx[BasePtr] != NumOfGCLives, "Missed live gc for base pointer");
                let mut OpIntTy1: *mut Type = GCR.getOperand(1).getType();
                GCR.setOperand(1, get(OpIntTy1, Val2Idx[BasePtr], false, false));
                let mut DerivedPtr: *mut Value = GCR.getDerivedPtr();
                assert!(Val2Idx.count(DerivedPtr) && Val2Idx[DerivedPtr] != NumOfGCLives, "Missed live gc for derived pointer");
                let mut OpIntTy2: *mut Type = GCR.getOperand(2).getType();
                GCR.setOperand(2, get(OpIntTy2, Val2Idx[DerivedPtr], false, false));
            }
            let mut NewBundle: OperandBundleDef = OperandBundleDef { "gc-live", move(NewLiveGc) };
            return Create(&mut Call, NewBundle, null);
        },
        _ => {
            break;
        },
    }
    return if Changed { &mut Call } else { null };
}

fn InstCombinerImpl::transformConstExprCastCall(self, Call: *mut CallBase) -> bool {
    let mut Callee: *mut Function = dyn_cast(Call.getCalledOperand().stripPointerCasts());
    if !Callee {
        return false;
    }
    assert!(!isa(Call), "CallBr's don't have a single point after a def to insert at");
    if Callee.isDeclaration() {
        return false;
    }
    if Callee.hasFnAttribute("thunk") {
        return false;
    }
    if Callee.hasFnAttribute(Naked) {
        return false;
    }
    if Call.isMustTailCall() {
        return false;
    }
    let mut Caller: *mut Instruction = &mut Call;
    let mut CallerPAL: *AttributeList = Call.getAttributes();
    let mut FT: *mut FunctionType = Callee.getFunctionType();
    let mut OldRetTy: *mut Type = Caller.getType();
    let mut NewRetTy: *mut Type = FT.getReturnType();
    if OldRetTy != NewRetTy {
        if NewRetTy.isStructTy() {
            return false;
        }
        if !isBitOrNoopPointerCastable(NewRetTy, OldRetTy, self.DL) {
            if !Caller.use_empty() {
                return false;
            }
        }
        if !CallerPAL.isEmpty() && !Caller.use_empty() {
            let mut RAttrs: AttrBuilder = AttrBuilder { Ctx: FT.getContext(), Attrs: CallerPAL.getRetAttrs() };
            if RAttrs.overlaps(typeIncompatible(NewRetTy, CallerPAL.getRetAttrs(), ASK_ALL)) {
                return false;
            }
        }
        if !Caller.use_empty() {
            let mut PhisNotSupportedBlock: *mut BasicBlock = null;
            if dyn_cast(Caller) {
                II;
            } else {
                PhisNotSupportedBlock = II.getNormalDest();
            }
            if PhisNotSupportedBlock {
                for U in Caller.users() {
                    if dyn_cast(U) {
                        PN;
                    } else if PN.getParent() == PhisNotSupportedBlock {
                        return false;
                    }
                }
            }
        }
    }
    let mut NumActualArgs: u32 = Call.arg_size();
    let mut NumCommonArgs: u32 = if FT.getNumParams() < NumActualArgs { FT.getNumParams() } else { NumActualArgs };
    if Callee.getAttributes().hasAttrSomewhere(InAlloca, null) || Callee.getAttributes().hasAttrSomewhere(Preallocated, null) {
        return false;
    }
    let mut AI: op_iterator = Call.arg_begin();
    for let mut i: u32 = 0;
let mut e: u32 = NumCommonArgs; i != e; i += 1 , AI += 1 {
        let mut ParamTy: *mut Type = FT.getParamType(i);
        let mut ActTy: *mut Type = operator((*AI)).getType();
        if !isBitOrNoopPointerCastable(ActTy, ParamTy, self.DL) {
            return false;
        }
        if AttrBuilder { Ctx: FT.getContext(), Attrs: CallerPAL.getParamAttrs(i) }.overlaps(typeIncompatible(ParamTy, CallerPAL.getParamAttrs(i), ASK_UNSAFE_TO_DROP)) {
            return false;
        }
        if Call.isInAllocaArgument(i) || CallerPAL.hasParamAttr(i, Preallocated) {
            return false;
        }
        if CallerPAL.hasParamAttr(i, SwiftError) {
            return false;
        }
        if CallerPAL.hasParamAttr(i, ByVal) != Callee.getAttributes().hasParamAttr(i, ByVal) {
            return false;
        }
    }
    if FT.getNumParams() < NumActualArgs && FT.isVarArg() && !CallerPAL.isEmpty() {
        let mut SRetIdx: u32 = 0;
        if CallerPAL.hasAttrSomewhere(StructRet, &mut SRetIdx) && SRetIdx - FirstArgIndex >= FT.getNumParams() {
            return false;
        }
    }
    let mut Args: SmallVector<Value *, 8> = SmallVector<Value *, 8> {};
    let mut ArgAttrs: SmallVector<AttributeSet, 8> = SmallVector<AttributeSet, 8> {};
    Args.reserve(NumActualArgs);
    ArgAttrs.reserve(NumActualArgs);
    let mut RAttrs: AttrBuilder = AttrBuilder { Ctx: FT.getContext(), Attrs: CallerPAL.getRetAttrs() };
    RAttrs.remove(typeIncompatible(NewRetTy, CallerPAL.getRetAttrs(), ASK_ALL));
    let mut Ctx: *mut LLVMContext = Call.getContext();
    AI = Call.arg_begin();
    for let mut i: u32 = 0; i != NumCommonArgs; i += 1 , AI += 1 {
        let mut ParamTy: *mut Type = FT.getParamType(i);
        let mut NewArg: *mut Value = *AI.operator llvm::Value *();
        if operator((*AI)).getType() != ParamTy {
            NewArg = self.Builder.CreateBitOrPointerCast(*AI.operator llvm::Value *(), ParamTy, "");
        }
        Args.push(NewArg);
        let mut IncompatibleAttrs: AttributeMask = typeIncompatible(ParamTy, CallerPAL.getParamAttrs(i), ASK_SAFE_TO_DROP);
        ArgAttrs.push(CallerPAL.getParamAttrs(i).removeAttributes(Ctx, IncompatibleAttrs));
    }
    for let mut i: u32 = NumCommonArgs; i != FT.getNumParams(); i += 1 {
        Args.push(getNullValue(FT.getParamType(i)));
        ArgAttrs.push(AttributeSet {});
    }
    if FT.getNumParams() < NumActualArgs {
        if FT.isVarArg() {
            for let mut i: u32 = FT.getNumParams(); i != NumActualArgs; i += 1 , AI += 1 {
                let mut PTy: *mut Type = getPromotedType(operator((*AI)).getType());
                let mut NewArg: *mut Value = *AI.operator llvm::Value *();
                if PTy != operator((*AI)).getType() {
                    let mut opcode: CastOps = getCastOpcode(*AI.operator llvm::Value *(), false, PTy, false);
                    NewArg = self.Builder.CreateCast(opcode, *AI.operator llvm::Value *(), PTy, "", null, FMFSource {});
                }
                Args.push(NewArg);
                ArgAttrs.push(CallerPAL.getParamAttrs(i));
            }
        }
    }
    let mut FnAttrs: AttributeSet = CallerPAL.getFnAttrs();
    if NewRetTy.isVoidTy() {
        Caller.setName("");
    }
    assert!((ArgAttrs.len == FT.getNumParams() || FT.isVarArg()), "missing argument attributes");
    let mut NewCallerPAL: AttributeList = get(Ctx, FnAttrs, get(Ctx, RAttrs), ArgAttrs);
    let mut OpBundles: SmallVector<OperandBundleDef, 1> = SmallVector<OperandBundleDef, 1> {};
    Call.getOperandBundlesAsDefs(OpBundles);
    let mut NewCall: *mut CallBase = null;
    if dyn_cast(Caller) {
        II;
    } else {
        NewCall = self.Builder.CreateInvoke(Callee, II.getNormalDest(), II.getUnwindDest(), Args, OpBundles, "");
    }
    NewCall.takeName(Caller);
    NewCall.setCallingConv(Call.getCallingConv());
    NewCall.setAttributes(NewCallerPAL);
    NewCall.copyMetadata(*Caller, [MD_prof]);
    let mut NC: *mut Instruction = NewCall;
    let mut NV: *mut Value = NC;
    if OldRetTy != NV.getType() && !Caller.use_empty() {
        assert!(!NV.getType().isVoidTy();
        NV = NC = CreateBitOrPointerCast(NC, OldRetTy, "", null);
        NC.setDebugLoc(Caller.getDebugLoc());
        let mut OptInsertPt: iterator> = NewCall.getInsertionPointAfterDef();
        assert!(OptInsertPt, "No place to insert cast");
        self.InsertNewInstBefore(NC, operator(OptInsertPt));
        self.Worklist.pushUsersToWorkList(*Caller);
    }
    if !Caller.use_empty() {
        self.replaceInstUsesWith(*Caller, NV);
    } else if Caller.hasValueHandle() {
        if OldRetTy == NV.getType() {
            ValueIsRAUWd(Caller, NV);
        } else {
            ValueIsDeleted(Caller);
        }
    }
    self.eraseInstFromFunction(*Caller);
    return true;
}

fn InstCombinerImpl::transformCallThroughTrampoline(self, Call: *mut CallBase, Tramp: *mut IntrinsicInst) -> *mut Instruction {
    let mut FTy: *mut FunctionType = Call.getFunctionType();
    let mut Attrs: AttributeList = Call.getAttributes();
    if Attrs.hasAttrSomewhere(Nest, null) {
        return null;
    }
    let mut NestF: *mut Function = cast(Tramp.getArgOperand(1).stripPointerCasts());
    let mut NestFTy: *mut FunctionType = NestF.getFunctionType();
    let mut NestAttrs: AttributeList = NestF.getAttributes();
    if !NestAttrs.isEmpty() {
        let mut NestArgNo: u32 = 0;
        let mut NestTy: *mut Type = null;
        let mut NestAttr: AttributeSet = AttributeSet {};
        for let mut I: param_iterator = NestFTy.param_begin();
let mut E: param_iterator = NestFTy.param_end(); I != E; NestArgNo += 1 , I += 1 {
            let mut AS: AttributeSet = NestAttrs.getParamAttrs(NestArgNo);
            if AS.hasAttribute(Nest) {
                NestTy = *I;
                NestAttr = AS;
                break;
            }
        }
        if NestTy {
            let mut NewArgs: []*mut Value = []*mut Value {};
            let mut NewArgAttrs: []AttributeSet = []AttributeSet {};
            NewArgs.reserve(Call.arg_size() + 1);
            NewArgAttrs.reserve(Call.arg_size());
            {
                let mut ArgNo: u32 = 0;
                let mut I: op_iterator = Call.arg_begin();
                let mut E: op_iterator = Call.arg_end();
                while true {
                    {
                    if ArgNo == NestArgNo {
                        let mut NestVal: *mut Value = Tramp.getArgOperand(2);
                        if NestVal.getType() != NestTy {
                            NestVal = self.Builder.CreateBitCast(NestVal, NestTy, "nest");
                        }
                        NewArgs.push(NestVal);
                        NewArgAttrs.push(NestAttr);
                    }
                    if I == E {
                        break;
                    }
                    NewArgs.push(*I.operator llvm::Value *());
                    NewArgAttrs.push(Attrs.getParamAttrs(ArgNo));
                    ArgNo += 1;
                    I += 1;
                }
                    if !(true) { break; }
                }
            }
            let mut NewTypes: []*mut Type = []*mut Type {};
            NewTypes.reserve(FTy.getNumParams() + 1);
            {
                let mut ArgNo: u32 = 0;
                let mut I: param_iterator = FTy.param_begin();
                let mut E: param_iterator = FTy.param_end();
                while true {
                    {
                    if ArgNo == NestArgNo {
                        NewTypes.push(NestTy);
                    }
                    if I == E {
                        break;
                    }
                    NewTypes.push(*I);
                    ArgNo += 1;
                    I += 1;
                }
                    if !(true) { break; }
                }
            }
            let mut NewFTy: *mut FunctionType = get(FTy.getReturnType(), NewTypes, FTy.isVarArg());
            let mut NewPAL: AttributeList = get(FTy.getContext(), Attrs.getFnAttrs(), Attrs.getRetAttrs(), NewArgAttrs);
            let mut OpBundles: SmallVector<OperandBundleDef, 1> = SmallVector<OperandBundleDef, 1> {};
            Call.getOperandBundlesAsDefs(OpBundles);
            let mut NewCaller: *mut Instruction = null;
            if dyn_cast(&mut Call) {
                II;
            } else {
                NewCaller = Create(NewFTy, NestF, II.getNormalDest(), II.getUnwindDest(), NewArgs, OpBundles, "", null);
                cast(NewCaller).setCallingConv(II.getCallingConv());
                cast(NewCaller).setAttributes(NewPAL);
            }
            NewCaller.setDebugLoc(Call.getDebugLoc());
            return NewCaller;
        }
    }
    Call.setCalledFunction(FTy, NestF);
    return &mut Call;
}

