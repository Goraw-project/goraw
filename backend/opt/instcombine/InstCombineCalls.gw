struct Closure_19 {}

fn Closure_19::call(self: *Closure_19, I: *Instruction) -> ClassifyResult {
                if isa(I) {
                    return Alloca;
                }
                if dyn_cast(I) {
                    CI;
                } else {
                    if dyn_cast(CI) {
                        II;
                    } else {
                        if II.getIntrinsicID() == stackrestore {
                            return StackRestore;
                        }
                        if II.mayHaveSideEffects() {
                            return CallWithSideEffects;
                        }
                    }
                }
                return None;
            }

struct Closure_20 {
    Idx: type,
    II: *mut *mut IntrinsicInst,
    cap_2: *mut InstCombinerImpl,
}

unsafe fn Closure_20::call(self: *mut Closure_20) -> auto {
                    if (*self.II).getNumOperandBundles() == 1 {
                        return self.eraseInstFromFunction(*(*self.II));
                    }
                    return removeOperandBundleAt((*self.II), self.Idx, null);
                }

