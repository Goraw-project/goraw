fn leftDistributesOverRight(LOp: BinaryOps, HasNUW: bool, HasNSW: bool, ROp: ID) -> bool {
    match ROp {
        umax => {
            umin;
        },
        smax => {
            smin;
        },
        _ => {
            return false;
        },
    }
}

fn rightDistributesOverLeft(LOp: BinaryOps, HasNUW: bool, HasNSW: bool, ROp: ID) -> bool {
    if isCommutative(LOp) || LOp == Shl {
        return leftDistributesOverRight(LOp, HasNUW, HasNSW, ROp);
    }
    match ROp {
        umax => {
            umin;
        },
        smax => {
            smin;
        },
        _ => {
            return false;
        },
    }
}

fn foldIntrinsicUsingDistributiveLaws(II: *mut IntrinsicInst, Builder: *mut BuilderTy) -> *mut Value {
    let mut LHS: *mut Value = II.getOperand;
    let mut RHS: *mut Value = II.getOperand;
    let mut TopLevelOpcode: ID = II.getIntrinsicID();
    let mut Op0: *mut OverflowingBinaryOperator = dyn_cast(LHS);
    let mut Op1: *mut OverflowingBinaryOperator = dyn_cast(RHS);
    if !Op0 || !Op1 {
        return null;
    }
    if Op0.getOpcode() != Op1.getOpcode() {
        return null;
    }
    if !Op0.hasOneUse() || !Op1.hasOneUse() {
        return null;
    }
    let mut InnerOpcode: BinaryOps = Op0.getOpcode() as BinaryOps;
    let mut HasNUW: bool = Op0.hasNoUnsignedWrap() && Op1.hasNoUnsignedWrap();
    let mut HasNSW: bool = Op0.hasNoSignedWrap() && Op1.hasNoSignedWrap();
    let mut A: *mut Value = Op0.getOperand(0);
    let mut B: *mut Value = Op0.getOperand(1);
    let mut C: *mut Value = Op1.getOperand(0);
    let mut D: *mut Value = Op1.getOperand(1);
    if Op0.isCommutative() && A != C && B != D {
        if A == D || B == C {
            swap(C, D);
        } else {
            return null;
        }
    }
    if A == C && leftDistributesOverRight(InnerOpcode, HasNUW, HasNSW, TopLevelOpcode) {
        let mut NewIntrinsic: *mut Value = Builder()(TopLevelOpcode, B, D);
        return Builder()(InnerOpcode, A, NewIntrinsic, HasNUW, HasNSW);
    }
    if B == D && rightDistributesOverLeft(InnerOpcode, HasNUW, HasNSW, TopLevelOpcode) {
        let mut NewIntrinsic: *mut Value = Builder()(TopLevelOpcode, A, C);
        return Builder()(InnerOpcode, NewIntrinsic, B, HasNUW, HasNSW);
    }
    return null;
}

fn foldNeonShift(II: *mut IntrinsicInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut Arg0: *mut Value = II.getArgOperand;
    let mut ShiftConst: *mut auto = dyn_cast(II.getArgOperand);
    if operator!() {
        return null;
