    }

struct Closure_12 {
    AllNegative: *mut bool,
    AllPositive: *mut bool,
    ElemBits: *mut i32,
}

unsafe fn Closure_12::call(self: *mut Closure_12, C: *mut Constant) -> auto {
        if dyn_cast_or_null(C) {
            CI;
        } else {
            let mut V: *APInt = CI.getValue();
            if V.isNonNegative() {
                (*self.AllNegative) = false;
                return (*self.AllPositive) && V.ult((*self.ElemBits));
            }
            (*self.AllPositive) = false;
            return (*self.AllNegative) && V.sgt(-(*self.ElemBits));
        }
        return false;
    }

