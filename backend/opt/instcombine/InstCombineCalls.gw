fn isIdempotentBinaryIntrinsic(IID: ID) -> bool {
    match IID {
        smax => {
            smin;
        },
        _ => {
            return false;
        },
    }
}

fn foldIdempotentBinaryIntrinsicRecurrence(IC: *mut InstCombinerImpl, II: *mut IntrinsicInst) -> *mut Value {
    let mut PN: *mut PHINode = null;
    let mut Init: *mut Value = null;
    let mut OtherOp: *mut Value = null;
    let mut IID: ID = II.getIntrinsicID();
    if !isIdempotentBinaryIntrinsic(IID) || !matchSimpleBinaryIntrinsicRecurrence(II, PN, Init, OtherOp) || !IC.getDominatorTree().dominates(OtherOp, PN) {
        return null;
    }
    let mut InvariantBinaryInst: *mut Value = IC.Builder.CreateBinaryIntrinsic(IID, Init, OtherOp, FMFSource {}, "");
    if isa(InvariantBinaryInst) {
        cast(InvariantBinaryInst).copyFastMathFlags(II);
    }
    return InvariantBinaryInst;
}

fn simplifyReductionOperand(Arg: *mut Value, CanReorderLanes: bool) -> *mut Value {
    if !CanReorderLanes {
        return null;
    }
    let mut V: *mut Value = null;
    if match(Arg, m_VecReverse(m_Value(V))) {
        return V;
    }
    let mut Mask: ArrayRef<int> = ArrayRef<int> {};
    if !isa(Arg.getType()) || !match(Arg, m_Shuffle(m_Value(V), m_Undef(), Mask)) || !cast(Arg).isSingleSource() {
        return null;
    }
    let mut Sz: i32 = Mask.len;
    let mut UsedIndices: SmallBitVector = SmallBitVector { Sz, false };
    for Idx in Mask {
        if Idx == PoisonMaskElem || UsedIndices.test(Idx) {
            return null;
        }
        UsedIndices.set(Idx);
    }
    return if UsedIndices.all() { V } else { null };
}

