        StrippedInvariantGroupsArg() = (0)();
    }
    if StrippedArg() ==  {
        return null;
    }
    let mut Result: *mut Value = IC()();
    if Result.getType().getPointerAddressSpace() != II.getType() {
        Result = IC()(Result, II.getType);
    }
    return cast(Result);
}

fn foldCttzCtlz(II: *mut IntrinsicInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    assert!((II.getIntrinsicID() == cttz || II.getIntrinsicID() == ctlz), "Expected cttz or ctlz intrinsic");
    let mut IsTZ: bool = II.getIntrinsicID() == cttz;
    let mut Op0: *mut Value = II.getArgOperand;
    let mut Op1: *mut Value = II.getArgOperand;
    let mut X: *mut Value = null;
    if match(Op0, m_BitReverse(m_Value(X))) {
        let mut ID: ID = if IsTZ { ctlz } else { cttz };
        let mut F: *mut Function = getOrInsertDeclaration(II, ID, II.getType);
        return Create(F, void { X, II.getArgOperand });
    }
    if II.getType(1) {
        if match(Op1, m_Zero()) {
            return CreateNot(Op0, "", null);
        }
        (((operator!(operator!((match(Op1) && "Expected ctlz/cttz operand to be 0 or 1")))) || (_wassert(L"match(Op1, m_One()) && \"Expected ctlz/cttz operand to be 0 or 1\"", L"llvm\\lib\\Transforms\\InstCombine\\InstCombineCalls.cpp", (493) as u32) , 0)) as void);
        return IC.replaceInstUsesWith(II, getNullValue(II.getType));
    }
    if II.hasOneUse && match(Op1, m_Zero()) && match(II, m_Shift(m_Value(), m_Specific(&mut II))) {
        return Create(II.getCalledFunction, void { Op0, IC()() });
    }
    let mut C: *mut Constant = null;
    if IsTZ {
        if match(Op0, m_Neg(m_Value(X))) {
            return Create(II.getCalledFunction, void { X, Op1 });
        }
        if match(Op0, m_c_And(m_Neg(m_Value(X)))) {
            return Create(II.getCalledFunction, void { X, Op1 });
        }
        if match(Op0, m_Mul(m_Value(X))) {
            return Create(II.getCalledFunction, void { X, Op1 });
        }
        if match(Op0, m_OneUse(m_SExt(m_Value(X)))) {
            let mut Zext: *mut auto = IC()(X, II.getType);
            let mut CttzZext: *mut auto = IC()(cttz, Op1);
            return IC.replaceInstUsesWith(II);
        }
        if match(Op0, m_OneUse(m_ZExt(m_Value(X)))) && match(Op1) {
            let mut Cttz: *mut auto = IC()(cttz, X, IC()());
            let mut ZextCttz: *mut auto = IC()(II.getType);
            return IC.replaceInstUsesWith(II);
        }
        let mut Y: *mut Value = null;
        let mut SPF: SelectPatternFlavor = matchSelectPattern(Op0, X, Y, null, 0).Flavor;
        if SPF == SPF_ABS || SPF == SPF_NABS {
            return Create(II.getCalledFunction, void { X, Op1 });
        }
        if match(Op0, m_Intrinsic(m_Value(X))) {
            return Create(II.getCalledFunction, void { X, Op1 });
        }
        if match(Op0, m_Shl(m_ImmConstant(C), m_Value(X))) && match(Op1) {
            let mut ConstCttz: *mut Value = IC()(cttz, C, Op1);
            return CreateAdd(ConstCttz, X, "");
        }
        if match(Op0, m_Exact(m_LShr(m_ImmConstant(C), m_Value(X)))) && match(Op1) {
            let mut ConstCttz: *mut Value = IC()(cttz, C, Op1);
            return CreateSub(ConstCttz, X, "");
        }
        if match(Op0, m_Add(m_LShr(m_Value(X)))) {
            let mut Width: *mut Value = get(II.getType, II.getType());
            return CreateSub(Width, X, "");
        }
    } else {
        if match(Op0, m_LShr(m_ImmConstant(C), m_Value(X))) && match(Op1) {
            let mut ConstCtlz: *mut Value = IC()(ctlz, C, Op1);
            return CreateAdd(ConstCtlz, X, "");
        }
        if match(Op0, m_NUWShl(m_ImmConstant(C), m_Value(X))) && match(Op1) {
            let mut ConstCtlz: *mut Value = IC()(ctlz, C, Op1);
            return CreateSub(ConstCtlz, X, "");
        }
        if Op0.hasOneUse() && match(Op0, m_c_And(m_Not(m_Value(X)), m_Add())) {
            let mut Ty: *mut Type = II.getType;
            let mut BitWidth: u32 = Ty.getScalarSizeInBits();
            let mut Cttz: *mut auto = IC()(cttz, Ty, void { X, IC()() });
            let mut Bw: *mut auto = get(Ty, APInt { BitWidth, BitWidth, false, false });
            return IC.replaceInstUsesWith(II, IC()());
        }
    }
    if  {
        if IsTZ {
            return IC.replaceInstUsesWith(II);
        }
        let mut BO: *mut BinaryOperator = CreateSub(get(()() - 1));
        BO.setHasNoSignedWrap;
        BO.setHasNoUnsignedWrap;
        return BO();
    }
    let mut Known: KnownBits = IC;
    let mut PossibleZeros: u32 = if IsTZ { Known.countMaxTrailingZeros() } else { Known.countMaxLeadingZeros() };
    let mut DefiniteZeros: u32 = if IsTZ { Known.countMinTrailingZeros() } else { Known.countMinLeadingZeros() };
    if PossibleZeros == DefiniteZeros {
        let mut C: *mut auto = get(Op0.getType(), DefiniteZeros, false, false);
        return IC.replaceInstUsesWith(II);
    }
    if !Known.One.isZero() || isKnownNonZero(Op0, IC.getSimplifyQuery(&mut II)) {
        if operator!(match(II.getArgOperand)) {
            return Create(II.getCalledFunction, void { Op0, IC()() });
        }
    }
    let mut BitWidth: u32 = Op0.getType().getScalarSizeInBits();
    if BitWidth != 1 && !II && !II {
        let mut Range: ConstantRange = ConstantRange { Lower: APInt { BitWidth, DefiniteZeros, false, false }, Upper: APInt { BitWidth, PossibleZeros + 1, false, false } };
        II.addRangeRetAttr;
        return &mut II;
    }
    return null;
}

fn foldCtpop(II: *mut IntrinsicInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    assert!(II.getIntrinsicID() == ctpop, "Expected ctpop intrinsic");
    let mut Ty: *mut Type = II.getType;
    let mut BitWidth: u32 = Ty.getScalarSizeInBits();
    let mut Op0: *mut Value = II.getArgOperand;
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(Op0, m_BitReverse(m_Value(X))) || match(Op0, m_BSwap(m_Value(X))) {
        return Create(II.getCalledFunction, X);
    }
    if (match(Op0, m_FShl(m_Value(X), m_Value(Y), m_Value())) || match(Op0, m_FShr(m_Value(X), m_Value(Y), m_Value()))) && X == Y {
        return Create(II.getCalledFunction, X);
    }
    if Op0.hasOneUse() && match(Op0, m_c_Or(m_Value(X), m_Neg())) {
        let mut Cttz: *mut auto = IC()(cttz, Ty, void { X, IC()() });
        let mut Bw: *mut auto = get(Ty, APInt { BitWidth, BitWidth, false, false });
        return IC.replaceInstUsesWith(II, IC()());
    }
    if match(Op0, m_c_And(m_Not(m_Value(X)), m_Add())) {
        let mut F: *mut Function = getOrInsertDeclaration(II, cttz, Ty);
        return Create(F, void { X, IC()() });
    }
    if match(Op0, m_OneUse(m_ZExt(m_Value(X)))) {
        let mut NarrowPop: *mut Value = IC()(ctpop, X);
        return Create(ZExt, NarrowPop, Ty, "", null);
    }
    let mut Known: KnownBits = BitWidth;
    IC;
    if (operator(Known.Zero)).isPowerOf2() {
        return CreateLShr(Op0, get(Ty, (operator(Known.Zero)).exactLogBase2(), false, false), "");
    }
    if IC.isKnownToBeAPowerOfTwo {
        return Create(ZExt, IC()(ICMP_NE, Op0, getNullValue(Ty)), Ty);
    }
    if BitWidth != 1 {
        let mut OldRange: ConstantRange = II.getRange(getFull(BitWidth));
        let mut Lower: u32 = Known.countMinPopulation();
        let mut Upper: u32 = Known.countMaxPopulation() + 1;
        if Lower == 0 && OldRange.contains(getZero(BitWidth)) && isKnownNonZero(Op0, IC.getSimplifyQuery(&mut II)) {
            Lower = 1;
        }
        let mut Range: ConstantRange = ConstantRange { Lower: APInt { BitWidth, Lower, false, false }, Upper: APInt { BitWidth, Upper, false, false } };
        Range = Range.intersectWith(OldRange, Unsigned);
        if Range != OldRange {
            II.addRangeRetAttr;
            return &mut II;
        }
    }
    return null;
}

fn simplifyNeonTbl(II: *mut IntrinsicInst, IC: *mut InstCombiner, IsExtension: bool) -> *mut Instruction {
    let mut C: *mut auto = dyn_cast(II.getArgOperand(II.arg_size - 1));
    if operator!() {
        return null;
    }
    let mut RetTy: *mut auto = cast(II.getType);
    let mut NumIndexes: u32 = ();
    if operator!(()(8)) || (NumIndexes != 8 && NumIndexes != 16) {
        return null;
    }
    let mut StartIndex: u32 = IsExtension as u32;
    let mut SourceTy: *mut auto = cast(II.getArgOperand());
    let mut NumElementsPerSource: u32 = ();
    if NumIndexes > NumElementsPerSource {
        return null;
    }
    let mut NumSourceOperands: u32 = II.arg_size - 1 - IsExtension as u32;
    let mut ValueToShuffleSlot: i32 = 0;
    let mut ShuffleOperands: [2]*mut Value = void { get(), get() };
    let mut Indexes: [16]i32 = zeroed();
    for let mut I: u32 = 0; I < NumIndexes; I += 1 {
        let mut COp: *mut Constant = (I);
        if !COp || (!isa(COp) && !isa(COp)) {
            return null;
        }
        if isa(COp) {
            Indexes[I] = -1;
            continue;
        }
        let mut Index: u64 = cast(COp)();
        let mut SourceOperandIndex: u32 = Index / NumElementsPerSource;
        let mut SourceOperandElementIndex: u32 = Index % NumElementsPerSource;
        let mut SourceOperand: *mut Value = null;
        if SourceOperandIndex >= NumSourceOperands {
            SourceOperandIndex = NumSourceOperands;
            if IsExtension {
                SourceOperand = II.getArgOperand;
                SourceOperandElementIndex = I;
            } else {
                SourceOperand = getNullValue();
                SourceOperandElementIndex = 0;
            }
        } else {
            SourceOperand = II.getArgOperand;
        }
        if cast(SourceOperand.getType())() != NumElementsPerSource {
            return null;
        }
        let mut NumSlots: u32 = ();
        if NumSlots == 2 && operator!((SourceOperand)) {
            return null;
        }
        if  {
            ShuffleOperands[()] = SourceOperand;
        }
        let mut RemappedIndex: u32 = 0;
        Indexes[I] = RemappedIndex;
    }
    let mut Shuf: *mut Value = IC()(ShuffleOperands[0], ShuffleOperands[1], Indexes(NumIndexes));
    return IC.replaceInstUsesWith;
}

fn haveSameOperands(I: *IntrinsicInst, E: *IntrinsicInst, NumOperands: u32) -> bool {
    (((operator!(operator!((I.arg_size >= NumOperands && "Not enough operands")))) || (_wassert(L"I.arg_size() >= NumOperands && \"Not enough operands\"", L"llvm\\lib\\Transforms\\InstCombine\\InstCombineCalls.cpp", (858) as u32) , 0)) as void);
    (((operator!(operator!((E.arg_size >= NumOperands && "Not enough operands")))) || (_wassert(L"E.arg_size() >= NumOperands && \"Not enough operands\"", L"llvm\\lib\\Transforms\\InstCombine\\InstCombineCalls.cpp", (859) as u32) , 0)) as void);
    for let mut i: u32 = 0; i < NumOperands; i += 1 {
        if I.getArgOperand != E.getArgOperand {
            return false;
        }
    }
    return true;
}

fn removeTriviallyEmptyRange(EndI: *mut IntrinsicInst, IC: *mut InstCombinerImpl, IsStart: function<bool (const IntrinsicInst &)>) -> bool {
    while  {
        if  {
            if I()() || () == EndI.getIntrinsicID() {
                continue;
            }
            if IsStart()(operator*()) {
                if haveSameOperands(EndI, operator*(), EndI.arg_size) {
                    IC.eraseInstFromFunction(operator*());
                    IC.eraseInstFromFunction;
                    return true;
                }
                continue;
            }
        }
        break;
    }
    return false;
}

fn InstCombinerImpl::visitVAEndInst(self, I: *mut VAEndInst) -> *mut Instruction {
    removeTriviallyEmptyRange(I, *self, Closure_1 { I: &mut I });
    return null;
}

fn canonicalizeConstantArg0ToArg1(Call: *mut CallInst) -> *mut CallInst {
    (((operator!(operator!((Call.arg_size > 1 && "Need at least 2 args to swap")))) || (_wassert(L"Call.arg_size() > 1 && \"Need at least 2 args to swap\"", L"llvm\\lib\\Transforms\\InstCombine\\InstCombineCalls.cpp", (915) as u32) , 0)) as void);
    let mut Arg0: *mut Value = Call.getArgOperand;
    let mut Arg1: *mut Value = Call.getArgOperand;
    if isa(Arg0) && !isa(Arg1) {
        Call.setArgOperand;
        Call.setArgOperand;
        let mut CallAttr: AttributeList = Call.getAttributes;
        let mut LHSAttr: AttributeSet = CallAttr.getParamAttrs(0);
        let mut RHSAttr: AttributeSet = CallAttr.getParamAttrs(1);
        let mut Ctx: *mut LLVMContext = Call.getContext;
        Call.setAttributes;
        return &mut Call;
    }
    return null;
}

fn createOverflowTuple(II: *mut IntrinsicInst, Result: *mut Value, Overflow: *mut Constant) -> *mut Instruction {
    let mut V: [2]*mut Constant = [get(Result.getType()), Overflow];
    let mut ST: *mut StructType = cast(II.getType);
    let mut Struct: *mut Constant = get(ST, V);
    return Create(Struct, Result, 0);
}

fn InstCombinerImpl::foldIntrinsicWithOverflowCommon(self, II: *mut IntrinsicInst) -> *mut Instruction {
    let mut WO: *mut WithOverflowInst = cast(II);
    let mut OperationResult: *mut Value = null;
    let mut OverflowResult: *mut Constant = null;
    if self.OptimizeOverflowCheck(WO.getBinaryOp, WO.isSigned, WO.getLHS, WO.getRHS, *WO, OperationResult, OverflowResult) {
        return createOverflowTuple(WO, OperationResult, OverflowResult);
    }
    return null;
}

fn inputDenormalIsIEEE(F: *Function, Ty: *Type) -> bool {
    Ty = Ty.getScalarType();
    return F.getDenormalMode(Ty.getFltSemantics()).Input == IEEE;
}

fn inputDenormalIsDAZ(F: *Function, Ty: *Type) -> bool {
    Ty = Ty.getScalarType();
    return F.getDenormalMode(Ty.getFltSemantics()).inputsAreZero();
}

fn mayFlushDenormalsToPositiveZero(CI: *CallInst) -> bool {
    let mut Mode: DenormalMode = CI(CI.getType()());
    return Mode.inputsMayBePositiveZero() || Mode.outputsMayBePositiveZero();
}

fn fpclassTestIsFCmp0(Mask: FPClassTest, F: *Function, Ty: *mut Type) -> Predicate {
    match Mask as u32 {
        fcZero => {
            if inputDenormalIsIEEE(F, Ty) {
                return FCMP_OEQ;
            }
        },
        fcZero | fcSubnormal => {
            if inputDenormalIsDAZ(F, Ty) {
                return FCMP_OEQ;
            }
        },
        fcPositive | fcNegZero => {
            if inputDenormalIsIEEE(F, Ty) {
                return FCMP_OGE;
            }
        },
        fcPositive | fcNegZero | fcNegSubnormal => {
            if inputDenormalIsDAZ(F, Ty) {
                return FCMP_OGE;
            }
        },
        fcPosSubnormal | fcPosNormal | fcPosInf => {
            if inputDenormalIsIEEE(F, Ty) {
                return FCMP_OGT;
            }
        },
        fcNegative | fcPosZero => {
            if inputDenormalIsIEEE(F, Ty) {
                return FCMP_OLE;
            }
        },
        fcNegative | fcPosZero | fcPosSubnormal => {
            if inputDenormalIsDAZ(F, Ty) {
                return FCMP_OLE;
            }
        },
        fcNegSubnormal | fcNegNormal | fcNegInf => {
            if inputDenormalIsIEEE(F, Ty) {
                return FCMP_OLT;
            }
        },
        fcPosNormal | fcPosInf => {
            if inputDenormalIsDAZ(F, Ty) {
                return FCMP_OGT;
            }
        },
        fcNegNormal | fcNegInf => {
            if inputDenormalIsDAZ(F, Ty) {
                return FCMP_OLT;
            }
        },
        ~fcZero & ~fcNan => {
            if inputDenormalIsIEEE(F, Ty) {
                return FCMP_ONE;
            }
        },
        ~(fcZero | fcSubnormal) & ~fcNan => {
            if inputDenormalIsDAZ(F, Ty) {
                return FCMP_ONE;
            }
        },
        _ => {
            break;
        },
    }
    return BAD_FCMP_PREDICATE;
}

fn InstCombinerImpl::foldIntrinsicIsFPClass(self, II: *mut IntrinsicInst) -> *mut Instruction {
    let mut Src0: *mut Value = II.getArgOperand;
    let mut Src1: *mut Value = II.getArgOperand;
    let mut CMask: *ConstantInt = cast(Src1);
    let mut Mask: FPClassTest = CMask.getZExtValue() as FPClassTest;
    let mut IsUnordered: bool = (Mask & fcNan) == fcNan;
    let mut IsOrdered: bool = (Mask & fcNan) == fcNone;
    let mut OrderedMask: FPClassTest = Mask & ~fcNan;
    let mut OrderedInvertedMask: FPClassTest = ~OrderedMask & ~fcNan;
    let mut IsStrict: bool = II()(StrictFP);
    let mut FNegSrc: *mut Value = null;
    if match(Src0, m_FNeg(m_Value(FNegSrc))) {
        return Create(II.getCalledFunction, void { FNegSrc, get(Src1.getType(), fneg(Mask), false, false) });
    }
    let mut FAbsSrc: *mut Value = null;
    if match(Src0, m_FAbs(m_Value(FAbsSrc))) {
        return Create(II.getCalledFunction, void { FAbsSrc, get(Src1.getType(), inverse_fabs(Mask), false, false) });
    }
    if (OrderedMask == fcInf || OrderedInvertedMask == fcInf) && (IsOrdered || IsUnordered) && !IsStrict {
        let mut Inf: *mut Constant = getInfinity(Src0.getType(), false);
        let mut Pred: Predicate = if IsUnordered { FCMP_UEQ } else { FCMP_OEQ };
        if OrderedInvertedMask == fcInf {
            Pred = if IsUnordered { FCMP_UNE } else { FCMP_ONE };
        }
        let mut Fabs: *mut Value = null;
        let mut CmpInf: *mut Value = null;
        CmpInf.takeName;
        return self.replaceInstUsesWith;
    }
    if (OrderedMask == fcPosInf || OrderedMask == fcNegInf) && (IsOrdered || IsUnordered) && !IsStrict {
        let mut Inf: *mut Constant = getInfinity(Src0.getType(), OrderedMask == fcNegInf);
        let mut EqInf: *mut Value = null;
        EqInf.takeName;
        return self.replaceInstUsesWith;
    }
    if (OrderedInvertedMask == fcPosInf || OrderedInvertedMask == fcNegInf) && (IsOrdered || IsUnordered) && !IsStrict {
        let mut Inf: *mut Constant = getInfinity(Src0.getType(), OrderedInvertedMask == fcNegInf);
        let mut NeInf: *mut Value = null;
        NeInf.takeName;
        return self.replaceInstUsesWith;
    }
    if Mask == fcNan && !IsStrict {
        let mut IsNan: *mut Value = null;
        IsNan.takeName;
        return self.replaceInstUsesWith;
    }
    if Mask == (~fcNan & fcAllFlags) && !IsStrict {
        let mut FCmp: *mut Value = null;
        FCmp.takeName;
        return self.replaceInstUsesWith;
    }
    let mut PredType: Predicate = BAD_FCMP_PREDICATE;
    if !IsStrict && (IsOrdered || IsUnordered) && (PredType = fpclassTestIsFCmp0(OrderedMask, operator*(II), Src0.getType())) != BAD_FCMP_PREDICATE {
        let mut Zero: *mut Constant = getZero(Src0.getType(), false);
        let mut FCmp: *mut Value = null;
        FCmp.takeName;
        return self.replaceInstUsesWith;
    }
    let mut Known: KnownFPClass = computeKnownFPClass(Src0, Mask);
    if Known.isKnownAlways(Mask) {
        return self.replaceInstUsesWith(II, get(II.getType, true));
    }
    if (Mask & Known.getKnownFPClasses()) != Mask {
        II.setArgOperand;
        return &mut II;
    }
    return null;
}

fn getKnownSign(Op: *mut Value, SQ: *SimplifyQuery) -> optional<bool> {
    let mut Known: KnownBits = computeKnownBits(Op, SQ, 0);
    if Known.isNonNegative() {
        return false;
    }
    if Known.isNegative() {
        return true;
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(Op, m_NSWSub(m_Value(X), m_Value(Y))) {
        return isImpliedByDomCondition(ICMP_SLT, X, Y, SQ.CtxI, SQ.DL);
    }
    return nullopt();
}

fn getKnownSignOrZero(Op: *mut Value, SQ: *SimplifyQuery) -> optional<bool> {
    if  {
        return ;
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(Op, m_NSWSub(m_Value(X), m_Value(Y))) {
        return isImpliedByDomCondition(ICMP_SLE, X, Y, SQ.CtxI, SQ.DL);
    }
    return nullopt();
}

fn signBitMustBeTheSame(Op0: *mut Value, Op1: *mut Value, SQ: *SimplifyQuery) -> bool {
    let mut Known1: optional<bool> = zeroed();
    if operator!() {
        return false;
    }
    let mut Known0: optional<bool> = zeroed();
    if operator!() {
        return false;
    }
    return operator*() == operator*();
}

fn ldexpSaturatingAddIsSafe(FpTy: *mut Type, ExpTy: *mut Type) -> bool {
    let mut FltSem: *fltSemantics = FpTy.getScalarType().getFltSemantics();
    if !semanticsHasInf(FltSem) {
        return false;
    }
    let mut ExpBits: u32 = min(ExpTy.getScalarSizeInBits(), 32);
    let mut SignedMax: i32 = maxIntN(ExpBits) as i32;
    let mut SignedMin: i32 = minIntN(ExpBits) as i32;
    let mut ScaledUp: APFloat = scalbn(getSmallest(FltSem, false), SignedMax, rmNearestTiesToEven);
    let mut ScaledDown: APFloat = scalbn(getLargest(FltSem, false), SignedMin, rmNearestTiesToEven);
    return ScaledUp.isInfinity() && ScaledDown.isZero();
}

fn moveAddAfterMinMax(II: *mut IntrinsicInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut MinMaxID: ID = II.getIntrinsicID();
    assert!((MinMaxID == smax || MinMaxID == smin || MinMaxID == umax || MinMaxID == umin), "Expected a min or max intrinsic");
    let mut Op0: *mut Value = II.getArgOperand;
    let mut Op1: *mut Value = II.getArgOperand;
    let mut X: *mut Value = null;
    let mut C0: *APInt = null;
    let mut C1: *APInt = null;
    if operator!(match(Op0, m_OneUse(m_Add(m_Value(X))))) || operator!(match(Op1)) {
        return null;
    }
    let mut IsSigned: bool = MinMaxID == smax || MinMaxID == smin;
    let mut Add: *mut auto = cast(Op0);
    if (IsSigned && operator!()) || (!IsSigned && operator!()) {
        return null;
    }
    let mut Overflow: bool = false;
    let mut CDiff: APInt = if IsSigned { C1.ssub_ov(*C0, Overflow) } else { C1.usub_ov(*C0, Overflow) };
    assert!(!Overflow, "Expected simplify of min/max");
    let mut NewMinMaxC: *mut Constant = get(II.getType, CDiff);
    let mut NewMinMax: *mut Value = Builder()(MinMaxID, X, NewMinMaxC);
    return if IsSigned { CreateNSWAdd(NewMinMax, (1)) } else { CreateNUWAdd(NewMinMax, (1)) };
}

fn InstCombinerImpl::matchSAddSubSat(self, MinMax1: *mut IntrinsicInst) -> *mut Instruction {
    let mut Ty: *mut Type = MinMax1.getType;
    let mut MinMax2: *mut Instruction = null;
    let mut AddSub: *mut BinaryOperator = null;
    let mut MinValue: *APInt = null;
    let mut MaxValue: *APInt = null;
    if match(&mut MinMax1, m_SMin(m_Instruction(MinMax2))) {
        if operator!(match(MinMax2, m_SMax(m_BinOp(AddSub)))) {
            return null;
        }
    } else if match(&mut MinMax1, m_SMax(m_Instruction(MinMax2))) {
        if operator!(match(MinMax2, m_SMin(m_BinOp(AddSub)))) {
            return null;
        }
    } else {
        return null;
    }
    if !(*MaxValue + 1).isPowerOf2() || operator(*MinValue) != *MaxValue + 1 {
        return null;
    }
    let mut NewBitWidth: u32 = (*MaxValue + 1).logBase2() + 1;
    if !self.shouldChangeType(Ty.getScalarType().getIntegerBitWidth(), NewBitWidth) {
        return null;
    }
    if operator!(MinMax2.hasOneUse) || operator!(AddSub.hasOneUse) {
        return null;
    }
    let mut NewTy: *mut Type = Ty.getWithNewBitWidth(NewBitWidth);
    let mut IntrinsicID: ID = zeroed();
    if AddSub.getOpcode() == Add {
        IntrinsicID = sadd_sat;
    } else if AddSub.getOpcode() == Sub {
        IntrinsicID = ssub_sat;
    } else {
        return null;
    }
    if self.ComputeMaxSignificantBits > NewBitWidth || self.ComputeMaxSignificantBits > NewBitWidth {
        return null;
    }
    let mut AT: *mut Value = null;
    let mut BT: *mut Value = null;
    let mut Sat: *mut Value = null;
    return Create(SExt, Sat, Ty, "", null);
}

fn foldClampRangeOfTwo(II: *mut IntrinsicInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut I0: *mut Value = II.getArgOperand;
    let mut I1: *mut Value = II.getArgOperand;
    let mut X: *mut Value = null;
    let mut C0: *APInt = null;
    let mut C1: *APInt = null;
    if operator!(match(I1)) || !I0.hasOneUse() {
        return null;
    }
    let mut Pred: Predicate = BAD_ICMP_PREDICATE;
    match II.getIntrinsicID() {
        smax => {
            if match(I0, m_SMin(m_Value(X))) && *C0 == *C1 + 1 {
                Pred = ICMP_SGT;
            }
        },
        smin => {
            if match(I0, m_SMax(m_Value(X))) && *C1 == *C0 + 1 {
                Pred = ICMP_SLT;
            }
        },
        umax => {
            if match(I0, m_UMin(m_Value(X))) && *C0 == *C1 + 1 {
                Pred = ICMP_UGT;
            }
        },
        umin => {
            if match(I0, m_UMax(m_Value(X))) && *C1 == *C0 + 1 {
                Pred = ICMP_ULT;
            }
        },
        _ => {
            llvm_unreachable_internal("Expected min/max intrinsic", "llvm\\lib\\Transforms\\InstCombine\\InstCombineCalls.cpp", 1389);
        },
    }
    if Pred == BAD_ICMP_PREDICATE {
        return null;
    }
    let mut Cmp: *mut Value = Builder()(Pred, X, I1);
    return Create(Cmp, get(II.getType, *C0), I1);
}

fn reassociateMinMaxWithConstants(II: *mut IntrinsicInst, Builder: *mut IRBuilderBase, SQ: *SimplifyQuery) -> *mut Value {
    let mut MinMaxID: ID = II.getIntrinsicID();
    let mut LHS: *mut auto = dyn_cast(II.getArgOperand);
