    if InnerMinMaxID != MinMaxID && !(((MinMaxID == umax && InnerMinMaxID == smax) || (MinMaxID == smin && InnerMinMaxID == umin)) && isKnownNonNegative(C0, SQ, 0) && isKnownNonNegative(C1, SQ, 0)) {
        return null;
    }
    let mut Pred: Predicate = getPredicate(MinMaxID);
    let mut CondC: *mut Value = Builder.CreateICmp(Pred, C0, C1, "");
    let mut NewC: *mut Value = Builder.CreateSelect(CondC, C0, C1, "", null);
    return Builder(InnerMinMaxID, II.getType, void { (0), NewC });
}

fn reassociateMinMaxWithConstantInOperand(II: *mut IntrinsicInst, Builder: *mut BuilderTy) -> *mut Instruction {
