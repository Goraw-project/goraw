struct Closure_24 {}

fn Closure_24::call(self: *Closure_24, FI1: *mut FenceInst, FI2: *mut FenceInst) -> bool {
        let mut FI1SyncScope: ID = FI1.getSyncScopeID();
        if FI1SyncScope != FI2.getSyncScopeID() || (FI1SyncScope != System && FI1SyncScope != SingleThread) {
            return false;
        }
        return isAtLeastOrStrongerThan(FI1.getOrdering(), FI2.getOrdering());
    }

