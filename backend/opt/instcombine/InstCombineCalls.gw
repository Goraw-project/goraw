    let mut ElemBits: i32 = Arg0.getType().getScalarSizeInBits();
    let mut AllPositive: bool = true;
    let mut AllNegative: bool = true;
    let mut Check: Closure_5 = Closure_5 { AllNegative: &mut AllNegative, AllPositive: &mut AllPositive, ElemBits: &mut ElemBits };
    if  {
        for let mut I: u32 = 0;
let mut E: u32 = (); I < E; I += 1 {
            if operator!(Check((I))) {
                return null;
            }
        }
    } else if operator!(Check()) {
        return null;
    }
    let mut B: *mut IRBuilderBase = IC();
    if AllPositive {
        return IC.replaceInstUsesWith(*II, B(Arg0));
    }
    let mut NegAmt: *mut Value = B.CreateNeg();
    let mut IID: ID = II.getIntrinsicID();
    let mut IsSigned: bool = false;
    let mut Result: *mut Value = if IsSigned { B.CreateAShr(Arg0, NegAmt, "", false) } else { B.CreateLShr(Arg0, NegAmt, "", false) };
    return IC.replaceInstUsesWith;
}

fn foldSinAndCosToSinCos(II: *mut IntrinsicInst, B: *mut IRBuilderBase, IC: *mut InstCombinerImpl) -> *mut Value {
