        (((operator!(operator!((OptInsertPt() && "No place to insert cast")))) || (_wassert(L"OptInsertPt && \"No place to insert cast\"", L"llvm\\lib\\Transforms\\InstCombine\\InstCombineCalls.cpp", (5567) as u32) , 0)) as void);
    }
    if operator!(Caller.use_empty) {
        self.replaceInstUsesWith;
    } else if Caller.hasValueHandle {
        if OldRetTy == NV.getType() {
            ValueIsRAUWd(Caller, NV);
        } else {
            ValueIsDeleted(Caller);
        }
    }
    self.eraseInstFromFunction(*Caller);
    return true;
}

fn InstCombinerImpl::transformCallThroughTrampoline(self, Call: *mut CallBase, Tramp: *mut IntrinsicInst) -> *mut Instruction {
    let mut FTy: *mut FunctionType = Call.getFunctionType();
    let mut Attrs: AttributeList = Call.getAttributes();
    if Attrs.hasAttrSomewhere(Nest, null) {
        return null;
    }
    let mut NestF: *mut Function = cast(Tramp.getArgOperand());
    let mut NestFTy: *mut FunctionType = NestF.getFunctionType();
    let mut NestAttrs: AttributeList = NestF.getAttributes();
    if !NestAttrs.isEmpty() {
        let mut NestArgNo: u32 = 0;
        let mut NestTy: *mut Type = null;
        let mut NestAttr: AttributeSet = AttributeSet {};
        for let mut I: param_iterator = NestFTy.param_begin();
let mut E: param_iterator = NestFTy.param_end(); I != E; NestArgNo += 1 , I += 1 {
            let mut AS: AttributeSet = NestAttrs.getParamAttrs(NestArgNo);
            if AS.hasAttribute(Nest) {
                NestTy = *I;
                NestAttr = AS;
                break;
            }
        }
        if NestTy {
            let mut NewArgs: i32 = 0;
            let mut NewArgAttrs: i32 = 0;
            NewArgs()(Call.arg_size() + 1);
            NewArgAttrs()(Call.arg_size());
            {
                let mut ArgNo: u32 = 0;
                let mut I: op_iterator = Call.arg_begin();
                let mut E: op_iterator = Call.arg_end();
                while true {
                    {
                    if ArgNo == NestArgNo {
                        let mut NestVal: *mut Value = Tramp.getArgOperand;
                        NewArgs()(NestVal);
                        NewArgAttrs()(NestAttr);
                    }
                    if I == E {
                        break;
                    }
                    NewArgs()(*I);
                    NewArgAttrs()(Attrs.getParamAttrs(ArgNo));
                    ArgNo += 1;
                    I += 1;
                }
                    if !(true) { break; }
                }
            }
            let mut NewTypes: i32 = 0;
            NewTypes()(FTy.getNumParams() + 1);
            {
                let mut ArgNo: u32 = 0;
                let mut I: param_iterator = FTy.param_begin();
                let mut E: param_iterator = FTy.param_end();
                while true {
                    {
                    if ArgNo == NestArgNo {
                        NewTypes()(NestTy);
                    }
                    if I == E {
                        break;
                    }
                    NewTypes()(*I);
                    ArgNo += 1;
                    I += 1;
                }
                    if !(true) { break; }
                }
            }
            let mut NewFTy: *mut FunctionType = get(FTy.getReturnType(), FTy.isVarArg());
            let mut NewPAL: AttributeList = get(FTy.getContext(), Attrs.getFnAttrs(), Attrs.getRetAttrs());
            let mut OpBundles: SmallVector<OperandBundleDef, 1> = zeroed();
            Call.getOperandBundlesAsDefs();
            let mut NewCaller: *mut Instruction = null;
            if dyn_cast(&mut Call) {
                II;
            } else {
                NewCaller = Create(NewFTy, NestF, II.getNormalDest(), II.getUnwindDest());
                cast(NewCaller)(II.getCallingConv);
                cast(NewCaller)(NewPAL);
            }
            NewCaller.setDebugLoc(Call.getDebugLoc);
            return NewCaller;
        }
    }
    Call;
    return &mut Call;
}

