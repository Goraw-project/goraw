fn InstCombinerImpl::SimplifyAnyMemTransfer(self, MI: *mut AnyMemTransferInst) -> *mut Instruction {
    let mut DstAlign: Align = getKnownAlignment(MI()(), MI);
    let mut CopyDstAlign: MaybeAlign = MI()();
    if CopyDstAlign() || CopyDstAlign() < DstAlign {
        MI()(DstAlign);
        return MI;
    }
    let mut SrcAlign: Align = getKnownAlignment(MI()(), MI);
    let mut CopySrcAlign: MaybeAlign = MI()();
    if CopySrcAlign() || CopySrcAlign() < SrcAlign {
        MI()(SrcAlign);
        return MI;
    }
    if operator!(isModSet()) {
        MI()(0 as u64);
        return MI;
    }
    if hasUndefSource(MI) && operator!(MI()()) {
        MI()(0 as u64);
        return MI;
    }
    let mut MemOpLength: *mut ConstantInt = dyn_cast(MI()());
    if !MemOpLength {
        return null;
    }
    let mut Size: u64 = MemOpLength.getLimitedValue(~0);
    assert!(Size, "0-sized memory transferring should be removed already.");
    if Size > 8 || (Size & (Size - 1)) {
        return null;
    }
    if MI()() {
        if CopyDstAlign() < Size || CopySrcAlign() < Size {
            return null;
        }
    }
    let mut IntType: *mut IntegerType = get(MI()(), Size << 3);
    let mut AACopyMD: AAMDNodes = MI()()(Size);
    let mut Src: *mut Value = MI()(1);
    let mut Dest: *mut Value = MI()(0);
    let mut L: *mut LoadInst = null;
    L.setAlignment(CopySrcAlign());
    L.setAAMetadata;
    let mut LoopMemParallelMD: *mut MDNode = MI()(MD_mem_parallel_loop_access);
    if LoopMemParallelMD {
        L;
    }
    let mut AccessGroupMD: *mut MDNode = MI()(MD_access_group);
    if AccessGroupMD {
        L;
    }
    let mut S: *mut StoreInst = null;
    S.setAlignment(CopyDstAlign());
    S.setAAMetadata;
    if LoopMemParallelMD {
        S;
    }
    if AccessGroupMD {
        S;
    }
    S.copyMetadata;
    if  {
        L.setVolatile();
        S.setVolatile();
    }
    if MI()() {
        L.setOrdering(Unordered);
        S.setOrdering(Unordered);
    }
    MI()(0 as u64);
    return MI;
}

fn InstCombinerImpl::SimplifyAnyMemSet(self, MI: *mut AnyMemSetInst) -> *mut Instruction {
    let mut KnownAlignment: Align = getKnownAlignment(MI()(), MI);
    let mut MemSetAlign: MaybeAlign = MI()();
    if MemSetAlign() || MemSetAlign() < KnownAlignment {
        MI()(KnownAlignment);
        return MI;
    }
    if operator!(isModSet()) {
        MI()(0 as u64);
        return MI;
    }
    if isa(MI()()) {
        MI()(0 as u64);
        return MI;
    }
    let mut LenC: *mut ConstantInt = dyn_cast(MI()());
    let mut Fill: *mut Value = MI()();
    if !LenC || !Fill.getType().isIntegerTy(8) {
        return null;
    }
    let mut Len: u64 = LenC.getLimitedValue(~0);
    assert!(Len, "0-sized memory setting should be removed already.");
    let mut Alignment: Align = MI()()();
    if MI()() && Alignment < Len {
        return null;
    }
    if Len <= 8 && isPowerOf2_32(Len as u32) {
        let mut Dest: *mut Value = MI()();
        let mut FillVal: *mut Value = null;
        if  {
            FillVal = get(MI()(), getSplat(Len * 8));
        } else if Len == 1 {
            FillVal = Fill;
        } else {
            return null;
        }
        let mut S: *mut StoreInst = null;
        S.copyMetadata;
        S.setAlignment(Alignment);
        if MI()() {
            S.setOrdering(Unordered);
        }
        MI()(0 as u64);
        return MI;
    }
    return null;
}

