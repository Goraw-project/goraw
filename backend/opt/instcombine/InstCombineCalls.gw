static mut NumSimplified: Statistic = Statistic { "instcombine", "NumSimplified", "Number of library calls simplified" };

fn getPromotedType(Ty: *mut Type) -> *mut Type {
    if dyn_cast(Ty) {
        ITy;
    } else {
        if ITy.getBitWidth() < 32 {
            return getInt32Ty(Ty.getContext());
        }
    }
    return Ty;
}

fn hasUndefSource(MI: *mut AnyMemTransferInst) -> bool {
    let mut Src: *mut Value = MI.getRawSource();
    while isa(Src) {
        if !Src.hasOneUse() {
            return false;
        }
        Src = cast(Src).getOperand(0);
    }
    return isa(Src) && Src.hasOneUse();
}

fn InstCombinerImpl::SimplifyAnyMemTransfer(self, MI: *mut AnyMemTransferInst) -> *mut Instruction {
    let mut DstAlign: Align = getKnownAlignment(MI.getRawDest(), self.DL, MI, &mut self.AC, &mut self.DT);
    let mut CopyDstAlign: MaybeAlign = MI.getDestAlign();
    if !CopyDstAlign || operator(CopyDstAlign) < DstAlign {
        MI.setDestAlignment(DstAlign);
        return MI;
    }
    let mut SrcAlign: Align = getKnownAlignment(MI.getRawSource(), self.DL, MI, &mut self.AC, &mut self.DT);
    let mut CopySrcAlign: MaybeAlign = MI.getSourceAlign();
    if !CopySrcAlign || operator(CopySrcAlign) < SrcAlign {
        MI.setSourceAlignment(SrcAlign);
        return MI;
    }
    if !isModSet(self.AA.getModRefInfoMask(MI.getDest(), false)) {
        MI.setLength(0 as u64);
        return MI;
    }
    if hasUndefSource(MI) && !MI.isVolatile() {
        MI.setLength(0 as u64);
        return MI;
    }
    let mut MemOpLength: *mut ConstantInt = dyn_cast(MI.getLength());
    if !MemOpLength {
        return null;
    }
    let mut Size: u64 = MemOpLength.getLimitedValue(~0);
    assert!(Size, "0-sized memory transferring should be removed already.");
    if Size > 8 || (Size & (Size - 1)) {
        return null;
    }
    if MI.isAtomic() {
        if operator(CopyDstAlign) < Size || operator(CopySrcAlign) < Size {
            return null;
        }
    }
    let mut IntType: *mut IntegerType = get(MI.getContext(), Size << 3);
    let mut AACopyMD: AAMDNodes = MI.getAAMetadata().adjustForAccess(Size);
    let mut Src: *mut Value = MI.getArgOperand(1);
    let mut Dest: *mut Value = MI.getArgOperand(0);
    let mut L: *mut LoadInst = self.Builder.CreateLoad(IntType, Src, "");
    L.setAlignment(operator(CopySrcAlign));
    L.setAAMetadata(AACopyMD);
    let mut LoopMemParallelMD: *mut MDNode = MI.getMetadata(MD_mem_parallel_loop_access);
    if LoopMemParallelMD {
        L.setMetadata(MD_mem_parallel_loop_access, LoopMemParallelMD);
    }
    let mut AccessGroupMD: *mut MDNode = MI.getMetadata(MD_access_group);
    if AccessGroupMD {
        L.setMetadata(MD_access_group, AccessGroupMD);
    }
    let mut S: *mut StoreInst = self.Builder.CreateStore(L, Dest, false);
    S.setAlignment(operator(CopyDstAlign));
    S.setAAMetadata(AACopyMD);
    if LoopMemParallelMD {
        S.setMetadata(MD_mem_parallel_loop_access, LoopMemParallelMD);
    }
    if AccessGroupMD {
        S.setMetadata(MD_access_group, AccessGroupMD);
    }
    S.copyMetadata(*MI, MD_DIAssignID);
    if dyn_cast(MI) {
        MT;
    } else {
        L.setVolatile(MT.isVolatile());
        S.setVolatile(MT.isVolatile());
    }
    if MI.isAtomic() {
        L.setOrdering(Unordered);
        S.setOrdering(Unordered);
    }
    MI.setLength(0 as u64);
    return MI;
}

fn InstCombinerImpl::SimplifyAnyMemSet(self, MI: *mut AnyMemSetInst) -> *mut Instruction {
    let mut KnownAlignment: Align = getKnownAlignment(MI.getDest(), self.DL, MI, &mut self.AC, &mut self.DT);
    let mut MemSetAlign: MaybeAlign = MI.getDestAlign();
    if !MemSetAlign || operator(MemSetAlign) < KnownAlignment {
        MI.setDestAlignment(KnownAlignment);
        return MI;
    }
    if !isModSet(self.AA.getModRefInfoMask(MI.getDest(), false)) {
        MI.setLength(0 as u64);
        return MI;
    }
    if isa(MI.getValue()) {
        MI.setLength(0 as u64);
        return MI;
    }
    let mut LenC: *mut ConstantInt = dyn_cast(MI.getLength());
    let mut Fill: *mut Value = MI.getValue();
    if !LenC || !Fill.getType().isIntegerTy(8) {
        return null;
    }
    let mut Len: u64 = LenC.getLimitedValue(~0);
    assert!(Len, "0-sized memory setting should be removed already.");
    let mut Alignment: Align = MI.getDestAlign().valueOrOne();
    if MI.isAtomic() && Alignment < Len {
        return null;
    }
    if Len <= 8 && isPowerOf2_32(Len as u32) {
        let mut Dest: *mut Value = MI.getDest();
        let mut FillVal: *mut Value = null;
        if dyn_cast(Fill) {
            FillC;
        } else {
            FillVal = get(MI.getContext(), getSplat(Len * 8, FillC.getValue()));
        }
        let mut S: *mut StoreInst = self.Builder.CreateStore(FillVal, Dest, MI.isVolatile());
        S.copyMetadata(*MI, MD_DIAssignID);
        for DbgAssign in getDVRAssignmentMarkers(S) {
            if is_contained(DbgAssign.location_ops(), Fill) {
                DbgAssign.replaceVariableLocationOp(Fill, FillVal, false);
            }
        }
        S.setAlignment(Alignment);
        if MI.isAtomic() {
            S.setOrdering(Unordered);
        }
        MI.setLength(0 as u64);
        return MI;
    }
    return null;
}

fn InstCombinerImpl::simplifyMaskedLoad(self, II: *mut IntrinsicInst) -> *mut Value {
    let mut LoadPtr: *mut Value = II.getArgOperand(0);
    let mut Alignment: Align = II.getParamAlign(0).valueOrOne();
    let mut Mask: *mut Value = II.getArgOperand(1);
    if match(Mask, m_AllOnesOrPoison()) {
        let mut L: *mut LoadInst = self.Builder.CreateAlignedLoad(II.getType(), LoadPtr, Alignment, "unmaskedload");
        L.copyMetadata(II, ArrayRef<unsigned int> {});
        return L;
    }
    if isDereferenceablePointer(LoadPtr, II.getType(), self.SQ.getWithInstruction(&mut II), false) {
        let mut LI: *mut LoadInst = self.Builder.CreateAlignedLoad(II.getType(), LoadPtr, Alignment, "unmaskedload");
        LI.copyMetadata(II, ArrayRef<unsigned int> {});
        return self.Builder.CreateSelect(II.getArgOperand(1), LI, II.getArgOperand(2), "", null);
    }
    return null;
}

fn InstCombinerImpl::simplifyMaskedStore(self, II: *mut IntrinsicInst) -> *mut Instruction {
    let mut StorePtr: *mut Value = II.getArgOperand(1);
    let mut Alignment: Align = II.getParamAlign(1).valueOrOne();
    let mut ConstMask: *mut Constant = dyn_cast(II.getArgOperand(2));
    if !ConstMask {
        return null;
    }
    if match(ConstMask, m_ZeroOrPoison()) {
        return self.eraseInstFromFunction(II);
    }
    if match(ConstMask, m_AllOnesOrPoison()) {
        let mut S: *mut StoreInst = StoreInst { II.getArgOperand(0), StorePtr, false, Alignment, null };
        S.copyMetadata(II, ArrayRef<unsigned int> {});
        return S;
    }
    if isa(ConstMask.getType()) {
        return null;
    }
    let mut DemandedElts: APInt = possiblyDemandedEltsInMask(ConstMask);
    let mut PoisonElts: APInt = APInt { DemandedElts.getBitWidth(), 0, false, false };
    if self.SimplifyDemandedVectorElts(II.getOperand(0), DemandedElts, PoisonElts, 0, false) {
        V;
    } else {
        return self.replaceOperand(II, 0, V);
    }
    return null;
}

fn InstCombinerImpl::simplifyMaskedGather(self, II: *mut IntrinsicInst) -> *mut Instruction {
    let mut ConstMask: *mut Constant = dyn_cast(II.getArgOperand(1));
    if !ConstMask {
        return null;
    }
    if ConstMask.isAllOnesValue() {
        if getSplatValue(II.getArgOperand(0)) {
            SplatPtr;
        } else {
            let mut VecTy: *mut VectorType = cast(II.getType());
            let mut Alignment: Align = II.getParamAlign(0).valueOrOne();
            let mut L: *mut LoadInst = self.Builder.CreateAlignedLoad(VecTy.getElementType(), SplatPtr, Alignment, "load.scalar");
            let mut Shuf: *mut Value = self.Builder.CreateVectorSplat(VecTy.getElementCount(), L, "broadcast");
            return self.replaceInstUsesWith(II, cast(Shuf));
        }
    }
    return null;
}

fn InstCombinerImpl::simplifyMaskedScatter(self, II: *mut IntrinsicInst) -> *mut Instruction {
    let mut ConstMask: *mut Constant = dyn_cast(II.getArgOperand(2));
    if !ConstMask {
        return null;
    }
    if match(ConstMask, m_ZeroOrPoison()) {
        return self.eraseInstFromFunction(II);
    }
    if getSplatValue(II.getArgOperand(1)) {
        SplatPtr;
    } else {
        if getSplatValue(II.getArgOperand(0)) {
            SplatValue;
        } else {
            if maskContainsAllOneOrUndef(ConstMask) {
                let mut Alignment: Align = II.getParamAlign(1).valueOrOne();
                let mut S: *mut StoreInst = StoreInst { SplatValue, SplatPtr, false, Alignment, null };
                S.copyMetadata(II, ArrayRef<unsigned int> {});
                return S;
            }
        }
        if ConstMask.isAllOnesValue() {
            let mut Alignment: Align = II.getParamAlign(1).valueOrOne();
            let mut WideLoadTy: *mut VectorType = cast(II.getArgOperand(1).getType());
            let mut VF: ElementCount = WideLoadTy.getElementCount();
            let mut RunTimeVF: *mut Value = self.Builder.CreateElementCount(self.Builder.getInt32Ty(), VF);
            let mut LastLane: *mut Value = self.Builder.CreateSub(RunTimeVF, self.Builder.getInt32(1), "", false, false);
            let mut Extract: *mut Value = self.Builder.CreateExtractElement(II.getArgOperand(0), LastLane, "");
            let mut S: *mut StoreInst = StoreInst { Extract, SplatPtr, false, Alignment, null };
            S.copyMetadata(II, ArrayRef<unsigned int> {});
            return S;
        }
    }
    if isa(ConstMask.getType()) {
        return null;
    }
    let mut DemandedElts: APInt = possiblyDemandedEltsInMask(ConstMask);
    let mut PoisonElts: APInt = APInt { DemandedElts.getBitWidth(), 0, false, false };
    if self.SimplifyDemandedVectorElts(II.getOperand(0), DemandedElts, PoisonElts, 0, false) {
        V;
    } else {
        return self.replaceOperand(II, 0, V);
    }
    if self.SimplifyDemandedVectorElts(II.getOperand(1), DemandedElts, PoisonElts, 0, false) {
        V;
    } else {
        return self.replaceOperand(II, 1, V);
    }
    return null;
}

fn simplifyInvariantGroupIntrinsic(II: *mut IntrinsicInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    let mut Arg: *mut Value = II.getArgOperand(0);
    let mut StrippedArg: *mut Value = Arg.stripPointerCasts();
    let mut StrippedInvariantGroupsArg: *mut Value = StrippedArg;
    while dyn_cast(StrippedInvariantGroupsArg) {
        Intr;
    }
    if StrippedArg == StrippedInvariantGroupsArg {
        return null;
    }
    let mut Result: *mut Value = IC.Builder.CreateLaunderInvariantGroup(StrippedInvariantGroupsArg);
    if Result.getType().getPointerAddressSpace() != II.getType().getPointerAddressSpace() {
        Result = IC.Builder.CreateAddrSpaceCast(Result, II.getType(), "", false);
    }
    return cast(Result);
}

fn foldCttzCtlz(II: *mut IntrinsicInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    assert!((II.getIntrinsicID() == cttz || II.getIntrinsicID() == ctlz), "Expected cttz or ctlz intrinsic");
    let mut IsTZ: bool = II.getIntrinsicID() == cttz;
    let mut Op0: *mut Value = II.getArgOperand(0);
    let mut Op1: *mut Value = II.getArgOperand(1);
    let mut X: *mut Value = null;
    if match(Op0, m_BitReverse(m_Value(X))) {
        let mut ID: ID = if IsTZ { ctlz } else { cttz };
        let mut F: *mut Function = getOrInsertDeclaration(II.getModule(), ID, II.getType());
        return Create(F, [X, II.getArgOperand(1)], ArrayRef<OperandBundleDef> {}, "", null);
    }
    if II.getType().isIntOrIntVectorTy(1) {
        if match(Op1, m_Zero()) {
            return CreateNot(Op0, "", null);
        }
        assert!(match(Op1, m_One()), "Expected ctlz/cttz operand to be 0 or 1");
        return IC.replaceInstUsesWith(II, getNullValue(II.getType()));
    }
    if II.hasOneUse() && match(Op1, m_Zero()) && match(II.user_back(), m_Shift(m_Value(), m_Specific(&mut II))) {
        return Create(II.getCalledFunction(), [Op0, IC.Builder.getTrue()], ArrayRef<OperandBundleDef> {}, "", null);
    }
    let mut C: *mut Constant = null;
    if IsTZ {
        if match(Op0, m_Neg(m_Value(X))) {
            return Create(II.getCalledFunction(), [X, Op1], ArrayRef<OperandBundleDef> {}, "", null);
        }
        if match(Op0, m_c_And(m_Neg(m_Value(X)), m_Deferred(X))) {
            return Create(II.getCalledFunction(), [X, Op1], ArrayRef<OperandBundleDef> {}, "", null);
        }
        if match(Op0, m_Mul(m_Value(X), m_CheckedInt(function_ref<bool (const APInt &)> { Closure_1 {}, null, null }))) {
            return Create(II.getCalledFunction(), [X, Op1], ArrayRef<OperandBundleDef> {}, "", null);
        }
        if match(Op0, m_OneUse(m_SExt(m_Value(X)))) {
            let mut Zext: *mut Value = IC.Builder.CreateZExt(X, II.getType(), "", false);
            let mut CttzZext: *mut Value = IC.Builder.CreateBinaryIntrinsic(cttz, Zext, Op1, FMFSource {}, "");
            return IC.replaceInstUsesWith(II, CttzZext);
        }
        if match(Op0, m_OneUse(m_ZExt(m_Value(X)))) && match(Op1, m_One()) {
            let mut Cttz: *mut Value = IC.Builder.CreateBinaryIntrinsic(cttz, X, IC.Builder.getTrue(), FMFSource {}, "");
            let mut ZextCttz: *mut Value = IC.Builder.CreateZExt(Cttz, II.getType(), "", false);
            return IC.replaceInstUsesWith(II, ZextCttz);
        }
        let mut Y: *mut Value = null;
        let mut SPF: SelectPatternFlavor = matchSelectPattern(Op0, X, Y, null, 0).Flavor;
        if SPF == SPF_ABS || SPF == SPF_NABS {
            return Create(II.getCalledFunction(), [X, Op1], ArrayRef<OperandBundleDef> {}, "", null);
        }
        if match(Op0, m_Intrinsic(m_Value(X))) {
            return Create(II.getCalledFunction(), [X, Op1], ArrayRef<OperandBundleDef> {}, "", null);
        }
        if match(Op0, m_Shl(m_ImmConstant(C), m_Value(X))) && match(Op1, m_One()) {
            let mut ConstCttz: *mut Value = IC.Builder.CreateBinaryIntrinsic(cttz, C, Op1, FMFSource {}, "");
            return CreateAdd(ConstCttz, X, "");
        }
        if match(Op0, m_Exact(m_LShr(m_ImmConstant(C), m_Value(X)))) && match(Op1, m_One()) {
            let mut ConstCttz: *mut Value = IC.Builder.CreateBinaryIntrinsic(cttz, C, Op1, FMFSource {}, "");
            return CreateSub(ConstCttz, X, "");
        }
        if match(Op0, m_Add(m_LShr(m_AllOnes(), m_Value(X)), m_One())) {
            let mut Width: *mut Value = get(II.getType(), II.getType().getScalarSizeInBits(), false, false);
            return CreateSub(Width, X, "");
        }
    } else {
        if match(Op0, m_LShr(m_ImmConstant(C), m_Value(X))) && match(Op1, m_One()) {
            let mut ConstCtlz: *mut Value = IC.Builder.CreateBinaryIntrinsic(ctlz, C, Op1, FMFSource {}, "");
            return CreateAdd(ConstCtlz, X, "");
        }
        if match(Op0, m_NUWShl(m_ImmConstant(C), m_Value(X))) && match(Op1, m_One()) {
            let mut ConstCtlz: *mut Value = IC.Builder.CreateBinaryIntrinsic(ctlz, C, Op1, FMFSource {}, "");
            return CreateSub(ConstCtlz, X, "");
        }
        if Op0.hasOneUse() && match(Op0, m_c_And(m_Not(m_Value(X)), m_Add(m_Deferred(X), m_AllOnes()))) {
            let mut Ty: *mut Type = II.getType();
            let mut BitWidth: u32 = Ty.getScalarSizeInBits();
            let mut Cttz: *mut Value = IC.Builder.CreateIntrinsic(cttz, Ty, [X, IC.Builder.getFalse()], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_2 {}, null, null });
            let mut Bw: *mut Constant = get(Ty, APInt { BitWidth, BitWidth, false, false });
            return IC.replaceInstUsesWith(II, IC.Builder.CreateSub(Bw, Cttz, "", false, false));
        }
    }
    if IC.tryGetLog2(Op0, match(Op1, m_One())) {
        R;
    } else {
        if IsTZ {
            return IC.replaceInstUsesWith(II, R);
        }
        let mut BO: *mut BinaryOperator = CreateSub(get(R.getType(), R.getType().getScalarSizeInBits() - 1, false, false), R, "");
        BO.setHasNoSignedWrap(true);
        BO.setHasNoUnsignedWrap(true);
        return BO;
    }
    let mut Known: KnownBits = IC.computeKnownBits(Op0, &mut II, 0);
    let mut PossibleZeros: u32 = if IsTZ { Known.countMaxTrailingZeros() } else { Known.countMaxLeadingZeros() };
    let mut DefiniteZeros: u32 = if IsTZ { Known.countMinTrailingZeros() } else { Known.countMinLeadingZeros() };
    if PossibleZeros == DefiniteZeros {
        let mut C: *mut Constant = get(Op0.getType(), DefiniteZeros, false, false);
        return IC.replaceInstUsesWith(II, C);
    }
    if !Known.One.isZero() || isKnownNonZero(Op0, IC.getSimplifyQuery().getWithInstruction(&mut II), 0) {
        if !match(II.getArgOperand(1), m_One()) {
            return Create(II.getCalledFunction(), [Op0, IC.Builder.getTrue()], ArrayRef<OperandBundleDef> {}, "", null);
        }
    }
    let mut BitWidth: u32 = Op0.getType().getScalarSizeInBits();
    if BitWidth != 1 && !II.hasRetAttr(Range) && !II.getMetadata(MD_range) {
        let mut Range: ConstantRange = ConstantRange { Lower: APInt { BitWidth, DefiniteZeros, false, false }, Upper: APInt { BitWidth, PossibleZeros + 1, false, false } };
        II.addRangeRetAttr(Range);
        return &mut II;
    }
    return null;
}

fn foldCtpop(II: *mut IntrinsicInst, IC: *mut InstCombinerImpl) -> *mut Instruction {
    assert!(II.getIntrinsicID() == ctpop, "Expected ctpop intrinsic");
    let mut Ty: *mut Type = II.getType();
    let mut BitWidth: u32 = Ty.getScalarSizeInBits();
    let mut Op0: *mut Value = II.getArgOperand(0);
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(Op0, m_BitReverse(m_Value(X))) || match(Op0, m_BSwap(m_Value(X))) {
        return Create(II.getCalledFunction(), X, ArrayRef<OperandBundleDef> {}, "", null);
    }
    if (match(Op0, m_FShl(m_Value(X), m_Value(Y), m_Value())) || match(Op0, m_FShr(m_Value(X), m_Value(Y), m_Value()))) && X == Y {
        return Create(II.getCalledFunction(), X, ArrayRef<OperandBundleDef> {}, "", null);
    }
    if Op0.hasOneUse() && match(Op0, m_c_Or(m_Value(X), m_Neg(m_Deferred(X)))) {
        let mut Cttz: *mut Value = IC.Builder.CreateIntrinsic(cttz, Ty, [X, IC.Builder.getFalse()], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_3 {}, null, null });
        let mut Bw: *mut Constant = get(Ty, APInt { BitWidth, BitWidth, false, false });
        return IC.replaceInstUsesWith(II, IC.Builder.CreateSub(Bw, Cttz, "", false, false));
    }
    if match(Op0, m_c_And(m_Not(m_Value(X)), m_Add(m_Deferred(X), m_AllOnes()))) {
        let mut F: *mut Function = getOrInsertDeclaration(II.getModule(), cttz, Ty);
        return Create(F, [X, IC.Builder.getFalse()], ArrayRef<OperandBundleDef> {}, "", null);
    }
    if match(Op0, m_OneUse(m_ZExt(m_Value(X)))) {
        let mut NarrowPop: *mut Value = IC.Builder.CreateUnaryIntrinsic(ctpop, X, FMFSource {}, "");
        return Create(ZExt, NarrowPop, Ty, "", null);
    }
    let mut Known: KnownBits = BitWidth;
    IC.computeKnownBits(Op0, Known, &mut II, 0);
    if (operator(Known.Zero)).isPowerOf2() {
        return CreateLShr(Op0, get(Ty, (operator(Known.Zero)).exactLogBase2(), false, false), "");
    }
    if IC.isKnownToBeAPowerOfTwo(Op0, true, null, 0) {
        return Create(ZExt, IC.Builder.CreateICmp(ICMP_NE, Op0, getNullValue(Ty), ""), Ty, "", null);
    }
    if BitWidth != 1 {
        let mut OldRange: ConstantRange = II.getRange().value_or(getFull(BitWidth));
        let mut Lower: u32 = Known.countMinPopulation();
        let mut Upper: u32 = Known.countMaxPopulation() + 1;
        if Lower == 0 && OldRange.contains(getZero(BitWidth)) && isKnownNonZero(Op0, IC.getSimplifyQuery().getWithInstruction(&mut II), 0) {
            Lower = 1;
        }
        let mut Range: ConstantRange = ConstantRange { Lower: APInt { BitWidth, Lower, false, false }, Upper: APInt { BitWidth, Upper, false, false } };
        Range = Range.intersectWith(OldRange, Unsigned);
        if Range != OldRange {
            II.addRangeRetAttr(Range);
            return &mut II;
        }
    }
    return null;
}

fn simplifyNeonTbl(II: *mut IntrinsicInst, IC: *mut InstCombiner, IsExtension: bool) -> *mut Instruction {
    let mut C: *mut Constant = dyn_cast(II.getArgOperand(II.arg_size() - 1));
    if !C {
        return null;
    }
    let mut RetTy: *mut FixedVectorType = cast(II.getType());
    let mut NumIndexes: u32 = RetTy.getNumElements();
    if !RetTy.getElementType().isIntegerTy(8) || (NumIndexes != 8 && NumIndexes != 16) {
        return null;
    }
    let mut StartIndex: u32 = IsExtension as u32;
    let mut SourceTy: *mut FixedVectorType = cast(II.getArgOperand(StartIndex).getType());
    let mut NumElementsPerSource: u32 = SourceTy.getNumElements();
    if NumIndexes > NumElementsPerSource {
        return null;
    }
    let mut NumSourceOperands: u32 = II.arg_size() - 1 - IsExtension as u32;
    let mut ValueToShuffleSlot: SmallDenseMap<Value *, unsigned int, 2> = SmallDenseMap<Value *, unsigned int, 2> {};
    let mut ShuffleOperands: [2]*mut Value = [get(SourceTy), get(SourceTy)];
    let mut Indexes: [16]i32 = zeroed();
    for let mut I: u32 = 0; I < NumIndexes; I += 1 {
        let mut COp: *mut Constant = C.getAggregateElement(I);
        if !COp || (!isa(COp) && !isa(COp)) {
            return null;
        }
        if isa(COp) {
            Indexes[I] = -1;
            continue;
        }
        let mut Index: u64 = cast(COp).getZExtValue();
        let mut SourceOperandIndex: u32 = Index / NumElementsPerSource;
        let mut SourceOperandElementIndex: u32 = Index % NumElementsPerSource;
        let mut SourceOperand: *mut Value = null;
        if SourceOperandIndex >= NumSourceOperands {
            SourceOperandIndex = NumSourceOperands;
            if IsExtension {
                SourceOperand = II.getArgOperand(0);
                SourceOperandElementIndex = I;
            } else {
                SourceOperand = getNullValue(SourceTy);
                SourceOperandElementIndex = 0;
            }
        } else {
            SourceOperand = II.getArgOperand(SourceOperandIndex + StartIndex);
        }
        if cast(SourceOperand.getType()).getNumElements() != NumElementsPerSource {
            return null;
        }
        let mut NumSlots: u32 = ValueToShuffleSlot.len;
        if NumSlots == 2 && !ValueToShuffleSlot.contains(SourceOperand) {
            return null;
        }
        if Inserted {
            ShuffleOperands[operator(It).getSecond()] = SourceOperand;
        }
        let mut RemappedIndex: u32 = (operator(It).getSecond() * NumElementsPerSource) + SourceOperandElementIndex;
        Indexes[I] = RemappedIndex;
    }
    let mut Shuf: *mut Value = IC.Builder.CreateShuffleVector(ShuffleOperands[0], ShuffleOperands[1], ArrayRef<int> { Indexes, NumIndexes }, "");
    return IC.replaceInstUsesWith(II, Shuf);
}

fn haveSameOperands(I: *IntrinsicInst, E: *IntrinsicInst, NumOperands: u32) -> bool {
    assert!(I.arg_size() >= NumOperands, "Not enough operands");
    assert!(E.arg_size() >= NumOperands, "Not enough operands");
    for let mut i: u32 = 0; i < NumOperands; i += 1 {
        if I.getArgOperand(i) != E.getArgOperand(i) {
            return false;
        }
    }
    return true;
}

fn removeTriviallyEmptyRange(EndI: *mut IntrinsicInst, IC: *mut InstCombinerImpl, IsStart: function<bool (const IntrinsicInst &)>) -> bool {
    let mut BI: reverse_iterator = EndI;
    let mut BE: reverse_iterator = EndI.getParent().rend();
    for ; BI != BE; operator(BI) {
        if dyn_cast(&mut operator(BI)) {
            I;
        } else {
            if I.isDebugOrPseudoInst() || I.getIntrinsicID() == EndI.getIntrinsicID() {
                continue;
            }
            if IsStart.call(*I) {
                if haveSameOperands(EndI, *I, EndI.arg_size()) {
                    IC.eraseInstFromFunction(*I);
                    IC.eraseInstFromFunction(EndI);
                    return true;
                }
                continue;
            }
        }
        break;
    }
    return false;
}

fn InstCombinerImpl::visitVAEndInst(self, I: *mut VAEndInst) -> *mut Instruction {
    removeTriviallyEmptyRange(I, *self, Closure_4 { I: &mut I });
    return null;
}

fn canonicalizeConstantArg0ToArg1(Call: *mut CallInst) -> *mut CallInst {
    assert!(Call.arg_size() > 1, "Need at least 2 args to swap");
    let mut Arg0: *mut Value = Call.getArgOperand(0);
    let mut Arg1: *mut Value = Call.getArgOperand(1);
    if isa(Arg0) && !isa(Arg1) {
        Call.setArgOperand(0, Arg1);
        Call.setArgOperand(1, Arg0);
        let mut CallAttr: AttributeList = Call.getAttributes();
        let mut LHSAttr: AttributeSet = CallAttr.getParamAttrs(0);
        let mut RHSAttr: AttributeSet = CallAttr.getParamAttrs(1);
        let mut Ctx: *mut LLVMContext = Call.getContext();
        Call.setAttributes(CallAttr.setAttributesAtIndex(Ctx, FirstArgIndex + 0, RHSAttr).setAttributesAtIndex(Ctx, FirstArgIndex + 1, LHSAttr));
        return &mut Call;
    }
    return null;
}

fn createOverflowTuple(II: *mut IntrinsicInst, Result: *mut Value, Overflow: *mut Constant) -> *mut Instruction {
    let mut V: [2]*mut Constant = [get(Result.getType()), Overflow];
    let mut ST: *mut StructType = cast(II.getType());
    let mut Struct: *mut Constant = get(ST, V);
    return Create(Struct, Result, 0, "", null);
}

fn InstCombinerImpl::foldIntrinsicWithOverflowCommon(self, II: *mut IntrinsicInst) -> *mut Instruction {
    let mut WO: *mut WithOverflowInst = cast(II);
    let mut OperationResult: *mut Value = null;
    let mut OverflowResult: *mut Constant = null;
    if self.OptimizeOverflowCheck(WO.getBinaryOp(), WO.isSigned(), WO.getLHS(), WO.getRHS(), *WO, OperationResult, OverflowResult) {
        return createOverflowTuple(WO, OperationResult, OverflowResult);
    }
    for U in WO.users() {
        if !match(U, m_ExtractValue(m_Value())) {
            continue;
        }
        for AssumeVH in self.AC.assumptionsFor(U) {
            if !AssumeVH.operator llvm::Value *() {
                continue;
            }
            let mut I: *mut CallInst = cast(AssumeVH);
            if !match(I.getArgOperand(0), m_Not(m_Specific(U))) {
                continue;
            }
            if !isValidAssumeForContext(I, II, null, true) {
                continue;
            }
            let mut Result: *mut Value = self.Builder.CreateBinOp(WO.getBinaryOp(), WO.getLHS(), WO.getRHS(), "", null);
            Result.takeName(WO);
            if dyn_cast(Result) {
                Inst;
            } else {
                if WO.isSigned() {
                    Inst.setHasNoSignedWrap(true);
                } else {
                    Inst.setHasNoUnsignedWrap(true);
                }
            }
            return createOverflowTuple(WO, Result, getFalse(U.getType()));
        }
    }
    return null;
}

fn inputDenormalIsIEEE(F: *Function, Ty: *Type) -> bool {
    Ty = Ty.getScalarType();
    return F.getDenormalMode(Ty.getFltSemantics()).Input == IEEE;
}

fn inputDenormalIsDAZ(F: *Function, Ty: *Type) -> bool {
    Ty = Ty.getScalarType();
    return F.getDenormalMode(Ty.getFltSemantics()).inputsAreZero();
}

fn mayFlushDenormalsToPositiveZero(CI: *CallInst) -> bool {
    let mut Mode: DenormalMode = CI.getFunction().getDenormalMode(CI.getType().getScalarType().getFltSemantics());
    return Mode.inputsMayBePositiveZero() || Mode.outputsMayBePositiveZero();
}

fn fpclassTestIsFCmp0(Mask: FPClassTest, F: *Function, Ty: *mut Type) -> Predicate {
    match Mask as u32 {
        fcZero => {
            if inputDenormalIsIEEE(F, Ty) {
                return FCMP_OEQ;
            }
        },
        fcZero | fcSubnormal => {
            if inputDenormalIsDAZ(F, Ty) {
                return FCMP_OEQ;
            }
        },
        fcPositive | fcNegZero => {
            if inputDenormalIsIEEE(F, Ty) {
                return FCMP_OGE;
            }
        },
        fcPositive | fcNegZero | fcNegSubnormal => {
            if inputDenormalIsDAZ(F, Ty) {
                return FCMP_OGE;
            }
        },
        fcPosSubnormal | fcPosNormal | fcPosInf => {
            if inputDenormalIsIEEE(F, Ty) {
                return FCMP_OGT;
            }
        },
        fcNegative | fcPosZero => {
            if inputDenormalIsIEEE(F, Ty) {
                return FCMP_OLE;
            }
        },
        fcNegative | fcPosZero | fcPosSubnormal => {
            if inputDenormalIsDAZ(F, Ty) {
                return FCMP_OLE;
            }
        },
        fcNegSubnormal | fcNegNormal | fcNegInf => {
            if inputDenormalIsIEEE(F, Ty) {
                return FCMP_OLT;
            }
        },
        fcPosNormal | fcPosInf => {
            if inputDenormalIsDAZ(F, Ty) {
                return FCMP_OGT;
            }
        },
        fcNegNormal | fcNegInf => {
            if inputDenormalIsDAZ(F, Ty) {
                return FCMP_OLT;
            }
        },
        operator(fcZero) & operator(fcNan) => {
            if inputDenormalIsIEEE(F, Ty) {
                return FCMP_ONE;
            }
        },
        operator((fcZero | fcSubnormal)) & operator(fcNan) => {
            if inputDenormalIsDAZ(F, Ty) {
                return FCMP_ONE;
            }
        },
        _ => {
            break;
        },
    }
    return BAD_FCMP_PREDICATE;
}

fn InstCombinerImpl::foldIntrinsicIsFPClass(self, II: *mut IntrinsicInst) -> *mut Instruction {
    let mut Src0: *mut Value = II.getArgOperand(0);
    let mut Src1: *mut Value = II.getArgOperand(1);
    let mut CMask: *ConstantInt = cast(Src1);
    let mut Mask: FPClassTest = CMask.getZExtValue() as FPClassTest;
    let mut IsUnordered: bool = (Mask & fcNan) == fcNan;
    let mut IsOrdered: bool = (Mask & fcNan) == fcNone;
    let mut OrderedMask: FPClassTest = Mask & operator(fcNan);
    let mut OrderedInvertedMask: FPClassTest = operator(OrderedMask) & operator(fcNan);
    let mut IsStrict: bool = II.getFunction().getAttributes().hasFnAttr(StrictFP);
    let mut FNegSrc: *mut Value = null;
    if match(Src0, m_FNeg(m_Value(FNegSrc))) {
        return Create(II.getCalledFunction(), [FNegSrc, get(Src1.getType(), fneg(Mask), false, false)], ArrayRef<OperandBundleDef> {}, "", null);
    }
    let mut FAbsSrc: *mut Value = null;
    if match(Src0, m_FAbs(m_Value(FAbsSrc))) {
        return Create(II.getCalledFunction(), [FAbsSrc, get(Src1.getType(), inverse_fabs(Mask), false, false)], ArrayRef<OperandBundleDef> {}, "", null);
    }
    if (OrderedMask == fcInf || OrderedInvertedMask == fcInf) && (IsOrdered || IsUnordered) && !IsStrict {
        let mut Inf: *mut Constant = getInfinity(Src0.getType(), false);
        let mut Pred: Predicate = if IsUnordered { FCMP_UEQ } else { FCMP_OEQ };
        if OrderedInvertedMask == fcInf {
            Pred = if IsUnordered { FCMP_UNE } else { FCMP_ONE };
        }
        let mut Fabs: *mut Value = self.Builder.CreateFAbs(Src0, FMFSource {}, "");
        let mut CmpInf: *mut Value = self.Builder.CreateFCmp(Pred, Fabs, Inf, "", null);
        CmpInf.takeName(&mut II);
        return self.replaceInstUsesWith(II, CmpInf);
    }
    if (OrderedMask == fcPosInf || OrderedMask == fcNegInf) && (IsOrdered || IsUnordered) && !IsStrict {
        let mut Inf: *mut Constant = getInfinity(Src0.getType(), OrderedMask == fcNegInf);
        let mut EqInf: *mut Value = if IsUnordered { self.Builder.CreateFCmpUEQ(Src0, Inf, "", null) } else { self.Builder.CreateFCmpOEQ(Src0, Inf, "", null) };
        EqInf.takeName(&mut II);
        return self.replaceInstUsesWith(II, EqInf);
    }
    if (OrderedInvertedMask == fcPosInf || OrderedInvertedMask == fcNegInf) && (IsOrdered || IsUnordered) && !IsStrict {
        let mut Inf: *mut Constant = getInfinity(Src0.getType(), OrderedInvertedMask == fcNegInf);
        let mut NeInf: *mut Value = if IsUnordered { self.Builder.CreateFCmpUNE(Src0, Inf, "", null) } else { self.Builder.CreateFCmpONE(Src0, Inf, "", null) };
        NeInf.takeName(&mut II);
        return self.replaceInstUsesWith(II, NeInf);
    }
    if Mask == fcNan && !IsStrict {
        let mut IsNan: *mut Value = self.Builder.CreateFCmpUNO(Src0, getZero(Src0.getType(), false), "", null);
        IsNan.takeName(&mut II);
        return self.replaceInstUsesWith(II, IsNan);
    }
    if Mask == (operator(fcNan) & fcAllFlags) && !IsStrict {
        let mut FCmp: *mut Value = self.Builder.CreateFCmpORD(Src0, getZero(Src0.getType(), false), "", null);
        FCmp.takeName(&mut II);
        return self.replaceInstUsesWith(II, FCmp);
    }
    let mut PredType: Predicate = BAD_FCMP_PREDICATE;
    if !IsStrict && (IsOrdered || IsUnordered) && (PredType = fpclassTestIsFCmp0(OrderedMask, *II.getFunction(), Src0.getType())) != BAD_FCMP_PREDICATE {
        let mut Zero: *mut Constant = getZero(Src0.getType(), false);
        let mut FCmp: *mut Value = self.Builder.CreateFCmp(if IsUnordered { getUnorderedPredicate(PredType) } else { PredType }, Src0, Zero, "", null);
        FCmp.takeName(&mut II);
        return self.replaceInstUsesWith(II, FCmp);
    }
    let mut Known: KnownFPClass = computeKnownFPClass(Src0, Mask, self.SQ.getWithInstruction(&mut II), 0);
    if Known.isKnownAlways(Mask) {
        return self.replaceInstUsesWith(II, get(II.getType(), true, false, false));
    }
    if (Mask & Known.getKnownFPClasses()) != Mask {
        II.setArgOperand(1, get(Src1.getType(), Mask & Known.getKnownFPClasses(), false, false));
        return &mut II;
    }
    return null;
}

fn getKnownSign(Op: *mut Value, SQ: *SimplifyQuery) -> optional<bool> {
    let mut Known: KnownBits = computeKnownBits(Op, SQ, 0);
    if Known.isNonNegative() {
        return false;
    }
    if Known.isNegative() {
        return true;
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(Op, m_NSWSub(m_Value(X), m_Value(Y))) {
        return isImpliedByDomCondition(CmpPredicate { Pred: ICMP_SLT, HasSameSign: false }, X, Y, SQ.CtxI, SQ.DL);
    }
    return nullopt;
}

fn getKnownSignOrZero(Op: *mut Value, SQ: *SimplifyQuery) -> optional<bool> {
    if getKnownSign(Op, SQ) {
        Sign;
    } else {
        return Sign;
    }
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    if match(Op, m_NSWSub(m_Value(X), m_Value(Y))) {
        return isImpliedByDomCondition(CmpPredicate { Pred: ICMP_SLE, HasSameSign: false }, X, Y, SQ.CtxI, SQ.DL);
    }
    return nullopt;
}

fn signBitMustBeTheSame(Op0: *mut Value, Op1: *mut Value, SQ: *SimplifyQuery) -> bool {
    let mut Known1: optional<bool> = getKnownSign(Op1, SQ);
    if !Known1 {
        return false;
    }
    let mut Known0: optional<bool> = getKnownSign(Op0, SQ);
    if !Known0 {
        return false;
    }
    return operator(Known0) == operator(Known1);
}

fn ldexpSaturatingAddIsSafe(FpTy: *mut Type, ExpTy: *mut Type) -> bool {
    let mut FltSem: *fltSemantics = FpTy.getScalarType().getFltSemantics();
    if !semanticsHasInf(FltSem) {
        return false;
    }
    let mut ExpBits: u32 = if ExpTy.getScalarSizeInBits() < 32 { ExpTy.getScalarSizeInBits() } else { 32 };
    let mut SignedMax: i32 = maxIntN(ExpBits) as i32;
    let mut SignedMin: i32 = minIntN(ExpBits) as i32;
    let mut ScaledUp: APFloat = scalbn(getSmallest(FltSem, false), SignedMax, rmNearestTiesToEven);
    let mut ScaledDown: APFloat = scalbn(getLargest(FltSem, false), SignedMin, rmNearestTiesToEven);
    return ScaledUp.isInfinity() && ScaledDown.isZero();
}

fn moveAddAfterMinMax(II: *mut IntrinsicInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut MinMaxID: ID = II.getIntrinsicID();
    assert!((MinMaxID == smax || MinMaxID == smin || MinMaxID == umax || MinMaxID == umin), "Expected a min or max intrinsic");
    let mut Op0: *mut Value = II.getArgOperand(0);
    let mut Op1: *mut Value = II.getArgOperand(1);
    let mut X: *mut Value = null;
    let mut C0: *APInt = null;
    let mut C1: *APInt = null;
    if !match(Op0, m_OneUse(m_Add(m_Value(X), m_APInt(C0)))) || !match(Op1, m_APInt(C1)) {
        return null;
    }
    let mut IsSigned: bool = MinMaxID == smax || MinMaxID == smin;
    let mut Add: *mut BinaryOperator = cast(Op0);
    if (IsSigned && !Add.hasNoSignedWrap()) || (!IsSigned && !Add.hasNoUnsignedWrap()) {
        return null;
    }
    let mut Overflow: bool = false;
    let mut CDiff: APInt = if IsSigned { C1.ssub_ov(*C0, Overflow) } else { C1.usub_ov(*C0, Overflow) };
    assert!(!Overflow, "Expected simplify of min/max");
    let mut NewMinMaxC: *mut Constant = get(II.getType(), CDiff);
    let mut NewMinMax: *mut Value = Builder.CreateBinaryIntrinsic(MinMaxID, X, NewMinMaxC, FMFSource {}, "");
    return if IsSigned { CreateNSWAdd(NewMinMax, Add.getOperand(1), "") } else { CreateNUWAdd(NewMinMax, Add.getOperand(1), "") };
}

fn InstCombinerImpl::matchSAddSubSat(self, MinMax1: *mut IntrinsicInst) -> *mut Instruction {
    let mut Ty: *mut Type = MinMax1.getType();
    let mut MinMax2: *mut Instruction = null;
    let mut AddSub: *mut BinaryOperator = null;
    let mut MinValue: *APInt = null;
    let mut MaxValue: *APInt = null;
    if match(&mut MinMax1, m_SMin(m_Instruction(MinMax2), m_APInt(MaxValue))) {
        if !match(MinMax2, m_SMax(m_BinOp(AddSub), m_APInt(MinValue))) {
            return null;
        }
    } else if match(&mut MinMax1, m_SMax(m_Instruction(MinMax2), m_APInt(MinValue))) {
        if !match(MinMax2, m_SMin(m_BinOp(AddSub), m_APInt(MaxValue))) {
            return null;
        }
    } else {
        return null;
    }
    if !(*MaxValue + 1).isPowerOf2() || operator(*MinValue) != *MaxValue + 1 {
        return null;
    }
    let mut NewBitWidth: u32 = (*MaxValue + 1).logBase2() + 1;
    if !self.shouldChangeType(Ty.getScalarType().getIntegerBitWidth(), NewBitWidth) {
        return null;
    }
    if !MinMax2.hasOneUse() || !AddSub.hasOneUse() {
        return null;
    }
    let mut NewTy: *mut Type = Ty.getWithNewBitWidth(NewBitWidth);
    let mut IntrinsicID: ID = zeroed();
    if AddSub.getOpcode() == Add {
        IntrinsicID = sadd_sat;
    } else if AddSub.getOpcode() == Sub {
        IntrinsicID = ssub_sat;
    } else {
        return null;
    }
    if self.ComputeMaxSignificantBits(AddSub.getOperand(0), AddSub, 0) > NewBitWidth || self.ComputeMaxSignificantBits(AddSub.getOperand(1), AddSub, 0) > NewBitWidth {
        return null;
    }
    let mut AT: *mut Value = self.Builder.CreateTrunc(AddSub.getOperand(0), NewTy, "", false, false);
    let mut BT: *mut Value = self.Builder.CreateTrunc(AddSub.getOperand(1), NewTy, "", false, false);
    let mut Sat: *mut Value = self.Builder.CreateIntrinsic(IntrinsicID, NewTy, [AT, BT], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_5 {}, null, null });
    return Create(SExt, Sat, Ty, "", null);
}

fn foldClampRangeOfTwo(II: *mut IntrinsicInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut I0: *mut Value = II.getArgOperand(0);
    let mut I1: *mut Value = II.getArgOperand(1);
    let mut X: *mut Value = null;
    let mut C0: *APInt = null;
    let mut C1: *APInt = null;
    if !match(I1, m_APInt(C1)) || !I0.hasOneUse() {
        return null;
    }
    let mut Pred: Predicate = BAD_ICMP_PREDICATE;
    match II.getIntrinsicID() {
        smax => {
            if match(I0, m_SMin(m_Value(X), m_APInt(C0))) && *C0 == *C1 + 1 {
                Pred = ICMP_SGT;
            }
        },
        smin => {
            if match(I0, m_SMax(m_Value(X), m_APInt(C0))) && *C1 == *C0 + 1 {
                Pred = ICMP_SLT;
            }
        },
        umax => {
            if match(I0, m_UMin(m_Value(X), m_APInt(C0))) && *C0 == *C1 + 1 {
                Pred = ICMP_UGT;
            }
        },
        umin => {
            if match(I0, m_UMax(m_Value(X), m_APInt(C0))) && *C1 == *C0 + 1 {
                Pred = ICMP_ULT;
            }
        },
        _ => {
            llvm_unreachable_internal("Expected min/max intrinsic", "P:/Goraw/llvm-project/llvm/lib/Transforms/InstCombine/InstCombineCalls.cpp", 1389);
        },
    }
    if Pred == BAD_ICMP_PREDICATE {
        return null;
    }
    let mut Cmp: *mut Value = Builder.CreateICmp(Pred, X, I1, "");
    return Create(Cmp, get(II.getType(), *C0), I1, "", null, null);
}

fn reassociateMinMaxWithConstants(II: *mut IntrinsicInst, Builder: *mut IRBuilderBase, SQ: *SimplifyQuery) -> *mut Value {
    let mut MinMaxID: ID = II.getIntrinsicID();
    let mut LHS: *mut MinMaxIntrinsic = dyn_cast(II.getArgOperand(0));
    if !LHS {
        return null;
    }
    let mut C0: *mut Constant = null;
    let mut C1: *mut Constant = null;
    if !match(LHS.getArgOperand(1), m_ImmConstant(C0)) || !match(II.getArgOperand(1), m_ImmConstant(C1)) {
        return null;
    }
    let mut InnerMinMaxID: ID = LHS.getIntrinsicID();
    if InnerMinMaxID != MinMaxID && !(((MinMaxID == umax && InnerMinMaxID == smax) || (MinMaxID == smin && InnerMinMaxID == umin)) && isKnownNonNegative(C0, SQ, 0) && isKnownNonNegative(C1, SQ, 0)) {
        return null;
    }
    let mut Pred: Predicate = getPredicate(MinMaxID);
    let mut CondC: *mut Value = Builder.CreateICmp(Pred, C0, C1, "");
    let mut NewC: *mut Value = Builder.CreateSelect(CondC, C0, C1, "", null);
    return Builder.CreateIntrinsic(InnerMinMaxID, II.getType(), [LHS.getArgOperand(0), NewC], FMFSource {}, "", ArrayRef<OperandBundleDef> {}, function_ref<void (CallInst *)> { Closure_6 {}, null, null });
}

fn reassociateMinMaxWithConstantInOperand(II: *mut IntrinsicInst, Builder: *mut BuilderTy) -> *mut Instruction {
    let mut X: *mut Value = null;
    let mut Y: *mut Value = null;
    let mut C: *mut Constant = null;
    let mut Inner: *mut Instruction = null;
    if !match(II, m_c_MaxOrMin(m_OneUse(m_CombineAnd(m_Instruction(Inner), m_MaxOrMin(m_Value(X), m_ImmConstant(C)))), m_Value(Y))) {
        return null;
    }
    let mut MinMaxID: ID = II.getIntrinsicID();
    let mut InnerMM: *mut IntrinsicInst = dyn_cast(Inner);
    if !InnerMM || InnerMM.getIntrinsicID() != MinMaxID || match(X, m_ImmConstant()) || match(Y, m_ImmConstant()) {
        return null;
    }
    let mut MinMax: *mut Function = getOrInsertDeclaration(II.getModule(), MinMaxID, II.getType());
    let mut NewInner: *mut Value = Builder.CreateBinaryIntrinsic(MinMaxID, X, Y, FMFSource {}, "");
    NewInner.takeName(Inner);
    return Create(MinMax, [NewInner, C], ArrayRef<OperandBundleDef> {}, "", null);
}

fn factorizeMinMaxTree(II: *mut IntrinsicInst) -> *mut Instruction {
    let mut LHS: *mut IntrinsicInst = dyn_cast(II.getArgOperand(0));
    let mut RHS: *mut IntrinsicInst = dyn_cast(II.getArgOperand(1));
    let mut MinMaxID: ID = II.getIntrinsicID();
    if !LHS || !RHS || LHS.getIntrinsicID() != MinMaxID || RHS.getIntrinsicID() != MinMaxID || (!LHS.hasOneUse() && !RHS.hasOneUse()) {
        return null;
    }
    let mut A: *mut Value = LHS.getArgOperand(0);
    let mut B: *mut Value = LHS.getArgOperand(1);
    let mut C: *mut Value = RHS.getArgOperand(0);
    let mut D: *mut Value = RHS.getArgOperand(1);
    let mut MinMaxOp: *mut Value = null;
    let mut ThirdOp: *mut Value = null;
    if LHS.hasOneUse() {
        if D == A || C == A {
            MinMaxOp = RHS;
            ThirdOp = B;
        } else if D == B || C == B {
            MinMaxOp = RHS;
            ThirdOp = A;
        }
    } else {
        assert!(RHS.hasOneUse(), "Expected one-use operand");
        if D == A || D == B {
            MinMaxOp = LHS;
            ThirdOp = C;
        } else if C == A || C == B {
            MinMaxOp = LHS;
            ThirdOp = D;
        }
    }
    if !MinMaxOp || !ThirdOp {
        return null;
    }
    let mut Mod: *mut Module = II.getModule();
    let mut MinMax: *mut Function = getOrInsertDeclaration(Mod, MinMaxID, II.getType());
    return Create(MinMax, [MinMaxOp, ThirdOp], ArrayRef<OperandBundleDef> {}, "", null);
}

fn InstCombinerImpl::foldShuffledIntrinsicOperands(self, II: *mut IntrinsicInst) -> *mut Instruction {
    if !II.getType().isVectorTy() || !isTriviallyVectorizable(II.getIntrinsicID()) || !II.getCalledFunction().isSpeculatable() {
        return null;
    }
    let mut X: *mut Value = null;
    let mut C: *mut Constant = null;
    let mut Mask: ArrayRef<int> = ArrayRef<int> {};
    let mut NonConstArg: *mut Use = find_if_not(II.args(), Closure_7 { II: &mut II });
    if !NonConstArg || !match(NonConstArg, m_Shuffle(m_Value(X), m_Poison(), Mask)) {
        return null;
    }
    if none_of(II.args(), match_fn(m_OneUse(m_Shuffle(m_Value(), m_Value())))) {
        return null;
    }
    let mut NewArgs: SmallVector<Value *, 4> = SmallVector<Value *, 4> {};
    let mut SrcTy: *mut Type = X.getType();
    for Arg in II.args() {
        if isVectorIntrinsicWithScalarOpAtArg(II.getIntrinsicID(), Arg.getOperandNo(), null) {
            NewArgs.push(Arg.operator llvm::Value *());
        } else if match(&mut Arg, m_Shuffle(m_Value(X), m_Poison(), Mask)) && X.getType() == SrcTy {
            NewArgs.push(X);
        } else if match(&mut Arg, m_ImmConstant(C)) {
            if self.unshuffleConstant(Mask, C, cast(SrcTy)) {
                ShuffledC;
            } else {
                NewArgs.push(ShuffledC);
            }
        } else {
            return null;
        }
    }
    let mut FPI: *mut Instruction = if isa(II) { II } else { null };
    let mut ResTy: *mut VectorType = get(II.getType().getScalarType(), cast(SrcTy));
    let mut NewIntrinsic: *mut Value = self.Builder.CreateIntrinsic(ResTy, II.getIntrinsicID(), NewArgs, FPI, "", function_ref<void (CallInst *)> { Closure_8 {}, null, null });
    return ShuffleVectorInst { NewIntrinsic, Mask, "", null };
}

fn InstCombinerImpl::foldReversedIntrinsicOperands(self, II: *mut IntrinsicInst) -> *mut Value {
    if !II.getType().isVectorTy() || !isTriviallyVectorizable(II.getIntrinsicID()) {
        return null;
    }
    if none_of(II.args(), Closure_9 {}) {
        return null;
    }
    let mut X: *mut Value = null;
    let mut C: *mut Constant = null;
    let mut NewArgs: SmallVector<Value *> = SmallVector<Value *> {};
    for Arg in II.args() {
        if isVectorIntrinsicWithScalarOpAtArg(II.getIntrinsicID(), Arg.getOperandNo(), null) {
            NewArgs.push(Arg.operator llvm::Value *());
        } else if match(&mut Arg, m_VecReverse(m_Value(X))) {
            NewArgs.push(X);
        } else if isSplatValue(Arg.operator llvm::Value *(), -1, 0) {
            NewArgs.push(Arg.operator llvm::Value *());
        } else if match(&mut Arg, m_ImmConstant(C)) {
            NewArgs.push(self.Builder.CreateVectorReverse(C, ""));
        } else {
            return null;
        }
    }
    let mut FPI: *mut Instruction = if isa(II) { II } else { null };
    let mut NewIntrinsic: *mut Value = self.Builder.CreateIntrinsic(II.getType(), II.getIntrinsicID(), NewArgs, FPI, "", function_ref<void (CallInst *)> { Closure_10 {}, null, null });
    return self.Builder.CreateVectorReverse(NewIntrinsic, "");
}

