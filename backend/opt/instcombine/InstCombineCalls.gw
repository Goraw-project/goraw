fn Closure_22::call(self: *Closure_22, U: *Use) {
                            let mut Hint: *mut Value = U.get();
                            let mut UnderlyingObject: *mut Value = getUnderlyingObject(Hint, 0, false);
                            if Hint != UnderlyingObject {
                                self.replaceUse(U, UnderlyingObject);
                            }
                        }

