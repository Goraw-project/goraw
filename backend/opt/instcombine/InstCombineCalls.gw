fn parseFormatStringSpecifiers(FormatStr: str) -> Bitset<256> {
    let mut Specifiers: Bitset<256> = zeroed();
    for let mut I: u64 = 0; I < FormatStr.len; I += 1 {
        if FormatStr[I] != '%' {
            continue;
        }
        if I + 1 < FormatStr.len && FormatStr[I + 1] == '%' {
            I += 1;
            continue;
        }
        let mut J: u64 = FormatStr.find_first_not_of("0123456789-+ #0$.*'hlLjztqwvI", I + 1);
        if J == npos {
            break;
        }
        Specifiers()(FormatStr[J] as u8);
        I = J;
    }
    return ;
}

fn isAspectNeeded(Aspect: str, CI: *mut CallInst, FirstArgIdx: optional<unsigned int>, Specifiers: *optional<Bitset<256>>) -> bool {
    if Aspect == "float" {
        if Specifiers() {
            let mut FloatSpecifiers: Bitset<256> = void { 'f', 'F', 'e', 'E', 'g', 'G', 'a', 'A' };
            return (Specifiers() & )();
        }
        if operator!() {
            return true;
        }
        return any_of(make_range(next(CI, operator*()), CI), Closure_10 {});
    }
    if Aspect == "fixed" {
        if Specifiers() {
            let mut FixedSpecifiers: Bitset<256> = void { 'r', 'R', 'k', 'K' };
            return (Specifiers() & )();
        }
        return true;
    }
    return true;
}

fn referenceAspect(Aspect: str, ImplName: str, M: *mut Module, B: *mut IRBuilderBase) {
    let mut Name: str = zeroed();
    operator+=(Name(), '_');
    operator+=(Name(), Aspect);
    let mut Ctx: *mut LLVMContext = M.getContext();
    let mut RelocNoneFn: *mut Function = getOrInsertDeclaration(M, reloc_none);
    B(RelocNoneFn, void { get(Ctx, get(Ctx)) });
}

fn optimizeModularFormat(CI: *mut CallInst, B: *mut IRBuilderBase) -> *mut Value {
    if !CI {
        return null;
    }
    let mut Args: i32 = split()(CI.getValueAsString(), ',');
    if Args()() < 5 {
        return null;
    }
    let mut FormatIdxStr: str = [1];
    let mut FirstArgIdxStr: str = [2];
    let mut FnName: str = [3];
    let mut ImplName: str = [4];
    let mut AllAspects: ArrayRef<StringRef> = zeroed();
    let mut FormatIdx: u32 = 0;
    let mut FirstArgIdx: optional<unsigned int> = zeroed();
    let mut Error: bool = false;
    Error = FormatIdxStr;
    assert!(!Error, "invalid format arg index");
    FormatIdx -= 1;
    FirstArgIdx()();
    Error = FirstArgIdxStr(10, operator*());
    assert!(!Error, "invalid first arg index");
    if operator*() > 0 {
        operator*() -= 1;
    } else {
        FirstArgIdx()();
    }
    if AllAspects()() {
        return null;
    }
    let mut FormatVal: *mut Value = CI.getArgOperand;
    let mut FormatStr: str = "";
    let mut Specifiers: optional<Bitset<256>> = zeroed();
    let mut NeededAspects: i32 = 0;
    if NeededAspects()() == () {
        return null;
    }
    let mut M: *mut Module = CI;
    let mut Ctx: *mut LLVMContext = M.getContext();
    let mut Callee: *mut Function = CI.getCalledFunction;
    let mut ModularFn: FunctionCallee = M.getOrInsertFunction(FnName, Callee.getFunctionType(), Callee.getAttributes().removeFnAttribute(Ctx, "modular-format"));
    let mut New: *mut CallInst = cast(CI.clone);
    New;
    New;
    B;
    sort();
    return New();
}

fn InstCombinerImpl::tryOptimizeCall(self, CI: *mut CallInst) -> *mut Instruction {
    if operator!(CI.getCalledFunction) {
        return null;
    }
    if CI.isMustTailCall() || CI.isNoTailCall() {
        return null;
    }
    let mut InstCombineRAUW: Closure_11 = Closure_11 { cap_0: self };
    let mut InstCombineErase: Closure_12 = Closure_12 { cap_0: self };
    let mut Simplifier: LibCallSimplifier = zeroed();
    if Simplifier.optimizeCall {
        With;
    } else {
        operator(NumSimplified);
        return if CI.use_empty { CI } else { self.replaceInstUsesWith };
    }
    if optimizeModularFormat(CI) {
        With;
    } else {
        operator(NumSimplified);
        return if CI.use_empty { CI } else { self.replaceInstUsesWith };
    }
    return null;
}

fn findInitTrampolineFromAlloca(TrampMem: *mut Value) -> *mut IntrinsicInst {
    let mut Underlying: *mut Value = TrampMem.stripPointerCasts();
    if Underlying != TrampMem && (!Underlying.hasOneUse() || Underlying.user_back() != TrampMem) {
        return null;
    }
    if !isa(Underlying) {
        return null;
    }
    let mut InitTrampoline: *mut IntrinsicInst = null;
    if !InitTrampoline {
        return null;
    }
    if InitTrampoline.getOperand != TrampMem {
        return null;
    }
    return InitTrampoline;
}

fn findInitTrampolineFromBB(AdjustTramp: *mut IntrinsicInst, TrampMem: *mut Value) -> *mut IntrinsicInst {
    for let mut I: i32 = AdjustTramp()(); ;  {
        let mut Inst: *mut Instruction = operator&(operator*( -= 1));
        if dyn_cast() {
            II;
        } else if II.getIntrinsicID() == init_trampoline && II.getOperand == TrampMem {
            return II;
        }
        if Inst.mayWriteToMemory() {
            return null;
        }
    }
    return null;
}

fn findInitTrampoline(Callee: *mut Value) -> *mut IntrinsicInst {
    Callee = Callee.stripPointerCasts();
    let mut AdjustTramp: *mut IntrinsicInst = dyn_cast(Callee);
    if !AdjustTramp || AdjustTramp.getIntrinsicID() != adjust_trampoline {
        return null;
    }
    let mut TrampMem: *mut Value = AdjustTramp.getOperand;
    if findInitTrampolineFromAlloca(TrampMem) {
        IT;
    } else {
        return IT;
    }
    if findInitTrampolineFromBB(AdjustTramp, TrampMem) {
        IT;
    } else {
        return IT;
    }
    return null;
}

fn InstCombinerImpl::foldPtrAuthIntrinsicCallee(self, Call: *mut CallBase) -> *mut Instruction {
    let mut Callee: *Value = Call.getCalledOperand();
    let mut IPC: *auto = dyn_cast(Callee);
    if operator!() || operator!() {
        return null;
    }
    let mut II: *auto = dyn_cast((0));
    if operator!() {
        return null;
    }
    let mut IIID: ID = ();
    if IIID != ptrauth_resign && IIID != ptrauth_sign {
        return null;
    }
    let mut PtrAuthBundleOrNone: optional<OperandBundleUse> = zeroed();
    let mut NewBundles: SmallVector<OperandBundleDef, 2> = zeroed();
    for let mut BI: u32 = 0;
let mut BE: u32 = Call.getNumOperandBundles(); BI != BE; BI += 1 {
        let mut Bundle: OperandBundleUse = Call.getOperandBundleAt(BI);
        if Bundle.getTagID() == OB_ptrauth {
            PtrAuthBundleOrNone() = Bundle;
        } else {
            NewBundles()(Bundle);
        }
    }
    if operator!() {
        return null;
    }
    let mut NewCallee: *mut Value = null;
    match IIID {
        ptrauth_resign => {
            if II()(3) != [0] {
                return null;
            }
            if II()(4) != [1] {
                return null;
            }
            if II()(1) != [0] {
                return null;
            }
            let mut NewBundleOps: []*mut Value = void { (1), (2) };
            NewBundles()("ptrauth", NewBundleOps);
            NewCallee = (0);
            break;
        },
        ptrauth_sign => {
            if II()(1) != [0] {
                return null;
            }
            if II()(2) != [1] {
                return null;
            }
            NewCallee = (0);
            break;
        },
        _ => {
            llvm_unreachable_internal("unexpected intrinsic ID", "llvm\\lib\\Transforms\\InstCombine\\InstCombineCalls.cpp", 4960);
        },
    }
    if !NewCallee {
        return null;
    }
    let mut NewCall: *mut CallBase = Create(&mut Call);
    NewCall.setCalledOperand(NewCallee);
    return NewCall();
}

