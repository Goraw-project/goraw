}

fn Closure_14::call(self: *Closure_14, Ptr: *mut Value) -> bool {
            return isa(Ptr) && !NullPointerIsDefined(self.MI.getFunction(), cast(Ptr.getType()).getAddressSpace());
        }

struct Closure_15 {
    cap_0: *mut InstCombinerImpl,
    II: *mut *mut IntrinsicInst,
}

unsafe fn Closure_15::call(self: *mut Closure_15, A: *mut Value, B: *mut Value) -> auto {
                let mut C: *APInt = null;
                let mut X: *mut Value = null;
                if !match(A, m_NUWShl(m_Value(X), m_APInt(C))) && !(match(A, m_NUWMul(m_Value(X), m_APInt(C))) && !C.isOne()) {
                    return null;
                }
                if C.isZero() {
                    return null;
                }
                if !match(B, m_OneUse(m_Add(m_Specific(X), m_One()))) {
                    return null;
                }
                let mut Cmp: *mut Value = self.Builder.CreateICmpEQ(X, get(X.getType(), 0, false, false), "");
                let mut NewSelect: *mut Value = null;
                NewSelect = self.Builder.CreateSelectWithUnknownProfile(Cmp, get(X.getType(), 1, false, false), A, "instcombine", "");
                return self.replaceInstUsesWith(*(*self.II), NewSelect);
            }

