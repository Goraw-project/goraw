fn ?$DOTGraphTraits@PEAVSelectionDAG@llvm::getNodeLabel(self, Node: *SDNode, G: *SelectionDAG) -> str {
    return getSimpleNodeLabel(Node, G);
}

fn SelectionDAG::viewGraph(self, Title: str) {
    ViewGraph(self, "dag." + self.getMachineFunction().getName(), false, Title, DOT);
}

fn SelectionDAG::viewGraph(self) {
    self.viewGraph("");
}

fn SelectionDAG::dumpDotGraph(self, FileName: str, Title: str) {
    dumpDotGraphToFile(self, FileName, Title, false, "");
}

fn SelectionDAG::clearGraphAttrs(self) {
    errs() << "SelectionDAG::clearGraphAttrs is only available in builds with " << "ABI breaking checks enabled on systems with Graphviz or gv!\n";
}

fn SelectionDAG::setGraphAttrs(self, N: *SDNode, Attrs: *u8) {
    errs() << "SelectionDAG::setGraphAttrs is only available in builds with " << "ABI breaking checks enabled on systems with Graphviz or gv!\n";
}

fn SelectionDAG::getGraphAttrs(self: *SelectionDAG, N: *SDNode) -> str {
    errs() << "SelectionDAG::getGraphAttrs is only available in builds with " << "ABI breaking checks enabled on systems with Graphviz or gv!\n";
    return "";
}

fn SelectionDAG::setGraphColor(self, N: *SDNode, Color: *u8) {
    errs() << "SelectionDAG::setGraphColor is only available in builds with " << "ABI breaking checks enabled on systems with Graphviz or gv!\n";
}

fn SelectionDAG::setSubgraphColorHelper(self, N: *mut SDNode, Color: *u8, visited: *mut DenseSet<SDNode *>, level: i32, printed: *mut bool) -> bool {
    let mut hit_limit: bool = false;
    if level >= 20 {
        if !printed {
            printed = true;
            while true {
                {
                if DebugFlag && isCurrentDebugType("dag-printer", 1) {
                    dbgs() << "setSubgraphColor hit max level\n";
                }
            }
                if !(false) { break; }
            }
        }
        return true;
    }
    let mut oldSize: u32 = visited.len;
    visited.insert(N);
    if visited.len != oldSize {
        self.setGraphColor(N, Color);
        for let mut i: SDNodeIterator = begin(N);
let mut iend: SDNodeIterator = end(N); i != iend; operator(i) {
            hit_limit = self.setSubgraphColorHelper(operator(i), Color, visited, level + 1, printed) || hit_limit;
        }
    }
    return hit_limit;
}

fn SelectionDAG::setSubgraphColor(self, N: *mut SDNode, Color: *u8) {
    let mut visited: DenseSet<SDNode *> = DenseSet<SDNode *> {};
    let mut printed: bool = false;
    if self.setSubgraphColorHelper(N, Color, visited, 0, printed) {
        if strcmp(Color, "red") == 0 {
            self.setSubgraphColorHelper(N, "blue", visited, 0, printed);
        } else if strcmp(Color, "yellow") == 0 {
            self.setSubgraphColorHelper(N, "green", visited, 0, printed);
        }
    }
}

fn ScheduleDAGSDNodes::getGraphNodeLabel(self: *ScheduleDAGSDNodes, SU: *SUnit) -> str {
    let mut s: str = "";
    let mut O: raw_string_ostream = raw_string_ostream { s };
    O << *SU << ": ";
    if SU.getNode() {
        let mut GluedNodes: SmallVector<SDNode *, 4> = SmallVector<SDNode *, 4> {};
        for let mut N: *mut SDNode = SU.getNode(); N; N = N.getGluedNode() {
            GluedNodes.push(N);
        }
        while !GluedNodes.is_empty() {
            O << getSimpleNodeLabel(GluedNodes.back(), self.DAG);
            GluedNodes.pop();
            if !GluedNodes.is_empty() {
                O << "\n    ";
            }
        }
    } else {
        O << "CROSS RC COPY";
    }
    return s;
}

fn ScheduleDAGSDNodes::getCustomGraphFeatures(self: *ScheduleDAGSDNodes, GW: *mut GraphWriter<ScheduleDAG *>) {
    if self.DAG {
        GW.emitSimpleNode(null, "plaintext=circle", "GraphRoot", 0, null);
        let mut N: *SDNode = self.DAG.getRoot().getNode();
        if N && N.getNodeId() != -1 {
            GW.emitEdge(null, -1, &mut self.SUnits[N.getNodeId()], -1, "color=blue,style=dashed");
        }
    }
}
