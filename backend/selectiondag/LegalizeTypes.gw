static mut EnableExpensiveChecks: opt<bool> = opt<bool> { "enable-legalize-types-checking", Hidden };

fn DAGTypeLegalizer::PerformExpensiveChecks(self) {
    let mut NewNodes: SmallVector<SDNode *, 16> = SmallVector<SDNode *, 16> {};
    for Node in self.DAG.allnodes() {
        if Node.getNodeId() == NewNode {
            NewNodes.push(&mut Node);
        }
        for let mut i: u32 = 0;
let mut e: u32 = Node.getNumValues(); i != e; i += 1 {
            let mut Res: SDValue = SDValue { Node: &mut Node, ResNo: i };
            let mut Failed: bool = false;
            let mut ResId: u32 = self.ValueToIdMap.lookup(Res);
            let mut Mapped: u32 = 0;
            if ResId {
                let mut I: iterator = self.ReplacedValues.find(ResId);
                if I != self.ReplacedValues.end() {
                    Mapped |= 1;
                    for U in Node.uses() {
                        if U.getResNo() == i {
                            assert!(U.getUser().getNodeId() == NewNode, "Remapped value has non-trivial use!");
                        }
                    }
                    let mut NewValId: u32 = operator(I).second;
                    I = self.ReplacedValues.find(NewValId);
                    while I != self.ReplacedValues.end() {
                        NewValId = operator(I).second;
                        I = self.ReplacedValues.find(NewValId);
                    }
                    let mut NewVal: SDValue = self.getSDValue(NewValId);
                    NewVal as void;
                    assert!(NewVal.getNode().getNodeId() != NewNode, "ReplacedValues maps to a new node!");
                }
                if self.PromotedIntegers.count(ResId) {
                    Mapped |= 2;
                }
                if self.SoftenedFloats.count(ResId) {
                    Mapped |= 4;
                }
                if self.ScalarizedVectors.count(ResId) {
                    Mapped |= 8;
                }
                if self.ExpandedIntegers.count(ResId) {
                    Mapped |= 16;
                }
                if self.ExpandedFloats.count(ResId) {
                    Mapped |= 32;
                }
                if self.SplitVectors.count(ResId) {
                    Mapped |= 64;
                }
                if self.WidenedVectors.count(ResId) {
                    Mapped |= 128;
                }
                if self.SoftPromotedHalfs.count(ResId) {
                    Mapped |= 256;
                }
            }
            if Node.getNodeId() != Processed {
                if (Node.getNodeId() == NewNode && Mapped > 1) || (Node.getNodeId() != NewNode && Mapped != 0) {
                    dbgs() << "Unprocessed value in a map!";
                    Failed = true;
                }
            } else if self.isTypeLegal(Res.getValueType()) || self.IgnoreNodeResults(&mut Node) {
                if Mapped > 1 {
                    dbgs() << "Value with legal type was transformed!";
                    Failed = true;
                }
            } else {
                if Mapped == 0 {
                    let mut NodeById: SDValue = self.IdToValueMap.lookup(ResId);
                    if operator(NodeById).getNodeId() == Processed {
                        dbgs() << "Processed value not in any map!";
                        Failed = true;
                    }
                } else if Mapped & (Mapped - 1) {
                    dbgs() << "Value in multiple maps!";
                    Failed = true;
                }
            }
            if Failed {
                if Mapped & 1 {
                    dbgs() << " ReplacedValues";
                }
                if Mapped & 2 {
                    dbgs() << " PromotedIntegers";
                }
                if Mapped & 4 {
                    dbgs() << " SoftenedFloats";
                }
                if Mapped & 8 {
                    dbgs() << " ScalarizedVectors";
                }
                if Mapped & 16 {
                    dbgs() << " ExpandedIntegers";
                }
                if Mapped & 32 {
                    dbgs() << " ExpandedFloats";
                }
                if Mapped & 64 {
                    dbgs() << " SplitVectors";
                }
                if Mapped & 128 {
                    dbgs() << " WidenedVectors";
                }
                if Mapped & 256 {
                    dbgs() << " SoftPromoteHalfs";
                }
                dbgs() << "\n";
                llvm_unreachable_internal(null, "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeTypes.cpp", 179);
            }
        }
    }
    for N in NewNodes {
        for U in N.users() {
            assert!(U.getNodeId() == NewNode, "NewNode used by non-NewNode!");
        }
    }
}

fn DAGTypeLegalizer::run(self) -> bool {
    let mut Changed: bool = false;
    let mut Dummy: HandleSDNode = HandleSDNode { self.DAG.getRoot() };
    Dummy.setNodeId(Unanalyzed);
    self.DAG.setRoot(SDValue {});
    for Node in self.DAG.allnodes() {
        if Node.getNumOperands() == 0 {
            Node.setNodeId(ReadyToProcess);
            self.Worklist.push(&mut Node);
        } else {
            Node.setNodeId(Unanalyzed);
        }
    }
    while !self.Worklist.is_empty() {
        if EnableExpensiveChecks {
            self.PerformExpensiveChecks();
        }
        let mut N: *mut SDNode = self.Worklist.pop_back_val();
        assert!(N.getNodeId() == ReadyToProcess, "Node should be ready if on worklist!");
        let mut FastMathFlags: SDNodeFlags = N.getFlags() & SDNodeFlags { Flags: FastMathFlags };
        let mut FlagsInserter: FlagInserter = FlagInserter { self.DAG, FastMathFlags };
        while true {
            {
            if DebugFlag && isCurrentDebugType("legalize-types", 1) {
                dbgs() << "\nLegalizing node: ";
                N.dump(&mut self.DAG);
            }
        }
            if !(false) { break; }
        }
        if self.IgnoreNodeResults(N) {
            while true {
                {
                if DebugFlag && isCurrentDebugType("legalize-types", 1) {
                    dbgs() << "Ignoring node results\n";
                }
            }
                if !(false) { break; }
            }
        }
        for let mut i: u32 = 0;
let mut NumResults: u32 = N.getNumValues(); i < NumResults; i += 1 {
            let mut ResultVT: EVT = N.getValueType(i);
            while true {
                {
                if DebugFlag && isCurrentDebugType("legalize-types", 1) {
                    dbgs() << "Analyzing result type: " << ResultVT << "\n";
                }
            }
                if !(false) { break; }
            }
            match self.getTypeAction(ResultVT) {
                TypeLegal => {
                    while true {
                        {
                        if DebugFlag && isCurrentDebugType("legalize-types", 1) {
                            dbgs() << "Legal result type\n";
                        }
                    }
                        if !(false) { break; }
                    }
                },
                TypeScalarizeScalableVector => {
                    report_fatal_error("Scalarization of scalable vectors is not supported.", true);
                },
                TypePromoteInteger => {
                    self.PromoteIntegerResult(N, i);
                },
                TypeExpandInteger => {
                    self.ExpandIntegerResult(N, i);
                },
                TypeSoftenFloat => {
                    self.SoftenFloatResult(N, i);
                },
                TypeExpandFloat => {
                    self.ExpandFloatResult(N, i);
                },
                TypeScalarizeVector => {
                    self.ScalarizeVectorResult(N, i);
                },
                TypeSplitVector => {
                    self.SplitVectorResult(N, i);
                },
                TypeWidenVector => {
                    self.WidenVectorResult(N, i);
                },
                TypeSoftPromoteHalf => {
                    self.SoftPromoteHalfResult(N, i);
                },
            }
        }
        N.getNumOperands();
        assert!(N.getNodeId() == ReadyToProcess, "Node ID recalculated?");
        N.setNodeId(Processed);
        for User in N.users() {
            let mut NodeId: i32 = User.getNodeId();
            if NodeId > 0 {
                User.setNodeId(NodeId - 1);
                if NodeId - 1 == ReadyToProcess {
                    self.Worklist.push(User);
                }
                continue;
            }
            if NodeId == NewNode {
                continue;
            }
            assert!(NodeId == Unanalyzed, "Unknown node ID!");
            User.setNodeId(User.getNumOperands() - 1);
            if User.getNumOperands() == 1 {
                self.Worklist.push(User);
            }
        }
    }
    if EnableExpensiveChecks {
        self.PerformExpensiveChecks();
    }
    self.DAG.setRoot(Dummy.getValue());
    self.DAG.RemoveDeadNodes();
    for Node in self.DAG.allnodes() {
        let mut Failed: bool = false;
        if !self.IgnoreNodeResults(&mut Node) {
            for let mut i: u32 = 0;
let mut NumVals: u32 = Node.getNumValues(); i < NumVals; i += 1 {
                if !self.isTypeLegal(Node.getValueType(i)) {
                    dbgs() << "Result type " << i << " illegal: ";
                    Node.dump(&mut self.DAG);
                    Failed = true;
                }
            }
        }
        for let mut i: u32 = 0;
let mut NumOps: u32 = Node.getNumOperands(); i < NumOps; i += 1 {
            if !self.IgnoreNodeResults(Node.getOperand(i).getNode()) && !self.isTypeLegal(Node.getOperand(i).getValueType()) {
                dbgs() << "Operand type " << i << " illegal: ";
                Node.getOperand(i).dump(&mut self.DAG);
                Failed = true;
            }
        }
        if Node.getNodeId() != Processed {
            if Node.getNodeId() == NewNode {
                dbgs() << "New node not analyzed?\n";
            } else if Node.getNodeId() == Unanalyzed {
                dbgs() << "Unanalyzed node not noticed?\n";
            } else if Node.getNodeId() > 0 {
                dbgs() << "Operand not processed?\n";
            } else if Node.getNodeId() == ReadyToProcess {
                dbgs() << "Not added to worklist?\n";
            }
            Failed = true;
        }
        if Failed {
            Node.dump(&mut self.DAG);
            dbgs() << "\n";
            llvm_unreachable_internal(null, "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeTypes.cpp", 477);
        }
    }
    return Changed;
}

fn DAGTypeLegalizer::AnalyzeNewNode(self, N: *mut SDNode) -> *mut SDNode {
    if N.getNodeId() != NewNode && N.getNodeId() != Unanalyzed {
        return N;
    }
    let mut NewOps: []SDValue = []SDValue {};
    let mut NumProcessed: u32 = 0;
    for let mut i: u32 = 0;
let mut e: u32 = N.getNumOperands(); i != e; i += 1 {
        let mut OrigOp: SDValue = N.getOperand(i);
        let mut Op: SDValue = OrigOp;
        self.AnalyzeNewValue(Op);
        if Op.getNode().getNodeId() == Processed {
            NumProcessed += 1;
        }
        if !NewOps.is_empty() {
            NewOps.push(Op);
        } else if Op != OrigOp {
            append_range(NewOps, N.ops().take_front(i));
            NewOps.push(Op);
        }
    }
    if !NewOps.is_empty() {
        let mut M: *mut SDNode = self.DAG.UpdateNodeOperands(N, ArrayRef<SDValue> { NewOps });
        if M != N {
            N.setNodeId(NewNode);
            if M.getNodeId() != NewNode && M.getNodeId() != Unanalyzed {
                return M;
            }
            N = M;
        }
    }
    N.setNodeId(N.getNumOperands() - NumProcessed);
    if N.getNodeId() == ReadyToProcess {
        self.Worklist.push(N);
    }
    return N;
}

fn DAGTypeLegalizer::AnalyzeNewValue(self, Val: *mut SDValue) {
    Val.setNode(self.AnalyzeNewNode(Val.getNode()));
    if Val.getNode().getNodeId() == Processed {
        self.RemapValue(Val);
    }
}

fn DAGTypeLegalizer::RemapValue(self, V: *mut SDValue) {
    let mut Id: TableId = self.getTableId(V);
    V = self.getSDValue(Id);
}

fn DAGTypeLegalizer::RemapId(self, Id: *mut TableId) {
    let mut I: iterator = self.ReplacedValues.find(Id);
    if I != self.ReplacedValues.end() {
        assert!(Id != operator(I).second, "Id is mapped to itself.");
        self.RemapId(operator(I).second);
        Id = operator(I).second;
    }
}

struct NodeUpdateListener {
    DTL: *mut DAGTypeLegalizer,
    NodesToAnalyze: *mut SmallSetVector<SDNode *, 16>,
}

fn NodeUpdateListener::NodeDeleted(self, N: *mut SDNode, E: *mut SDNode) {
    assert!(N.getNodeId() != ReadyToProcess && N.getNodeId() != Processed, "Invalid node ID for RAUW deletion!");
    assert!(E, "Node not replaced?");
    self.DTL.NoteDeletion(N, E);
    self.NodesToAnalyze.remove(N);
    if E.getNodeId() == NewNode {
        self.NodesToAnalyze.insert(E);
    }
}

fn NodeUpdateListener::NodeUpdated(self, N: *mut SDNode) {
    assert!(N.getNodeId() != ReadyToProcess && N.getNodeId() != Processed, "Invalid node ID for RAUW deletion!");
    N.setNodeId(NewNode);
    self.NodesToAnalyze.insert(N);
}

fn DAGTypeLegalizer::ReplaceValueWith(self, From: SDValue, To: SDValue) {
    assert!(From.getNode() != To.getNode(), "Potential legalization loop!");
    self.AnalyzeNewValue(To);
    let mut NodesToAnalyze: SmallSetVector<SDNode *, 16> = SmallSetVector<SDNode *, 16> {};
    let mut NUL: NodeUpdateListener = NodeUpdateListener { DTL: *self, NodesToAnalyze: NodesToAnalyze };
    while true {
        {
        let mut FromId: TableId = self.getTableId(From);
        let mut ToId: TableId = self.getTableId(To);
        if FromId != ToId {
            self.ReplacedValues[FromId] = ToId;
        }
        self.DAG.ReplaceAllUsesOfValueWith(From, To);
        while !NodesToAnalyze.is_empty() {
            let mut N: *mut SDNode = NodesToAnalyze.pop_back_val();
            if N.getNodeId() != NewNode {
                continue;
            }
            let mut M: *mut SDNode = self.AnalyzeNewNode(N);
            if M != N {
                assert!(M.getNodeId() != NewNode, "Analysis resulted in NewNode!");
                assert!(N.getNumValues() == M.getNumValues(), "Node morphing changed the number of results!");
                for let mut i: u32 = 0;
let mut e: u32 = N.getNumValues(); i != e; i += 1 {
                    let mut OldVal: SDValue = SDValue { Node: N, ResNo: i };
                    let mut NewVal: SDValue = SDValue { Node: M, ResNo: i };
                    if M.getNodeId() == Processed {
                        self.RemapValue(NewVal);
                    }
                    let mut OldValId: TableId = self.getTableId(OldVal);
                    let mut NewValId: TableId = self.getTableId(NewVal);
                    self.DAG.ReplaceAllUsesOfValueWith(OldVal, NewVal);
                    self.RemapId(OldValId);
                    self.RemapId(NewValId);
                    if OldValId != NewValId {
                        self.ReplacedValues[OldValId] = NewValId;
                    }
                }
            }
        }
    }
        if !(!From.use_empty()) { break; }
    }
}

fn DAGTypeLegalizer::SetPromotedInteger(self, Op: SDValue, Result: SDValue) {
    assert!(Result.getValueType() == self.TLI.getTypeToTransformTo(*self.DAG.getContext(), Op.getValueType()), "Invalid type for promoted integer");
    self.AnalyzeNewValue(Result);
    let mut OpIdEntry: *mut u32 = self.PromotedIntegers[self.getTableId(Op)];
    assert!((OpIdEntry == 0), "Node is already promoted!");
    OpIdEntry = self.getTableId(Result);
    self.DAG.transferDbgValues(Op, Result, 0, 0, true);
}

fn DAGTypeLegalizer::SetSoftenedFloat(self, Op: SDValue, Result: SDValue) {
    let mut VT: EVT = Result.getValueType();
    let mut Ctx: *mut LLVMContext = *self.DAG.getContext();
    assert!((VT == getIntegerVT(Ctx, 80) || VT == self.TLI.getTypeToTransformTo(Ctx, Op.getValueType())), "Invalid type for softened float");
    self.AnalyzeNewValue(Result);
    let mut OpIdEntry: *mut u32 = self.SoftenedFloats[self.getTableId(Op)];
    assert!((OpIdEntry == 0), "Node is already converted to integer!");
    OpIdEntry = self.getTableId(Result);
}

fn DAGTypeLegalizer::SetSoftPromotedHalf(self, Op: SDValue, Result: SDValue) {
    assert!(Result.getValueType() == EVT { i16 }, "Invalid type for soft-promoted half");
    self.AnalyzeNewValue(Result);
    let mut OpIdEntry: *mut u32 = self.SoftPromotedHalfs[self.getTableId(Op)];
    assert!((OpIdEntry == 0), "Node is already promoted!");
    OpIdEntry = self.getTableId(Result);
}

fn DAGTypeLegalizer::SetScalarizedVector(self, Op: SDValue, Result: SDValue) {
    assert!(Result.getValueSizeInBits().getFixedValue() >= Op.getScalarValueSizeInBits(), "Invalid type for scalarized vector");
    self.AnalyzeNewValue(Result);
    let mut OpIdEntry: *mut u32 = self.ScalarizedVectors[self.getTableId(Op)];
    assert!((OpIdEntry == 0), "Node is already scalarized!");
    OpIdEntry = self.getTableId(Result);
}

fn DAGTypeLegalizer::GetExpandedInteger(self, Op: SDValue, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut Entry: *mut pair<TableId, TableId> = self.ExpandedIntegers[self.getTableId(Op)];
    assert!((Entry.first != 0), "Operand isn't expanded");
    Lo = self.getSDValue(Entry.first);
    Hi = self.getSDValue(Entry.second);
}

fn DAGTypeLegalizer::SetExpandedInteger(self, Op: SDValue, Lo: SDValue, Hi: SDValue) {
    assert!(Lo.getValueType() == self.TLI.getTypeToTransformTo(*self.DAG.getContext(), Op.getValueType()) && Hi.getValueType() == Lo.getValueType(), "Invalid type for expanded integer");
    self.AnalyzeNewValue(Lo);
    self.AnalyzeNewValue(Hi);
    if self.DAG.getDataLayout().isBigEndian() {
        self.DAG.transferDbgValues(Op, Hi, 0, Hi.getValueSizeInBits().operator unsigned long long(), false);
        self.DAG.transferDbgValues(Op, Lo, Hi.getValueSizeInBits().operator unsigned long long(), Lo.getValueSizeInBits().operator unsigned long long(), true);
    } else {
        self.DAG.transferDbgValues(Op, Lo, 0, Lo.getValueSizeInBits().operator unsigned long long(), false);
        self.DAG.transferDbgValues(Op, Hi, Lo.getValueSizeInBits().operator unsigned long long(), Hi.getValueSizeInBits().operator unsigned long long(), true);
    }
    let mut Entry: *mut pair<TableId, TableId> = self.ExpandedIntegers[self.getTableId(Op)];
    assert!((Entry.first == 0), "Node already expanded");
    Entry.first = self.getTableId(Lo);
    Entry.second = self.getTableId(Hi);
}

fn DAGTypeLegalizer::GetExpandedFloat(self, Op: SDValue, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut Entry: *mut pair<TableId, TableId> = self.ExpandedFloats[self.getTableId(Op)];
    assert!((Entry.first != 0), "Operand isn't expanded");
    Lo = self.getSDValue(Entry.first);
    Hi = self.getSDValue(Entry.second);
}

fn DAGTypeLegalizer::SetExpandedFloat(self, Op: SDValue, Lo: SDValue, Hi: SDValue) {
    assert!(Lo.getValueType() == self.TLI.getTypeToTransformTo(*self.DAG.getContext(), Op.getValueType()) && Hi.getValueType() == Lo.getValueType(), "Invalid type for expanded float");
    self.AnalyzeNewValue(Lo);
    self.AnalyzeNewValue(Hi);
    let mut Entry: *mut pair<TableId, TableId> = self.ExpandedFloats[self.getTableId(Op)];
    assert!((Entry.first == 0), "Node already expanded");
    Entry.first = self.getTableId(Lo);
    Entry.second = self.getTableId(Hi);
}

fn DAGTypeLegalizer::GetSplitVector(self, Op: SDValue, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut Entry: *mut pair<TableId, TableId> = self.SplitVectors[self.getTableId(Op)];
    Lo = self.getSDValue(Entry.first);
    Hi = self.getSDValue(Entry.second);
    assert!(Lo.getNode(), "Operand isn't split");
}

fn DAGTypeLegalizer::SetSplitVector(self, Op: SDValue, Lo: SDValue, Hi: SDValue) {
    assert!(Lo.getValueType().getVectorElementType() == Op.getValueType().getVectorElementType() && Lo.getValueType().getVectorElementCount() * 2 == Op.getValueType().getVectorElementCount() && Hi.getValueType() == Lo.getValueType(), "Invalid type for split vector");
    self.AnalyzeNewValue(Lo);
    self.AnalyzeNewValue(Hi);
    let mut Entry: *mut pair<TableId, TableId> = self.SplitVectors[self.getTableId(Op)];
    assert!((Entry.first == 0), "Node already split");
    Entry.first = self.getTableId(Lo);
    Entry.second = self.getTableId(Hi);
}

fn DAGTypeLegalizer::SetWidenedVector(self, Op: SDValue, Result: SDValue) {
    assert!(Result.getValueType() == self.TLI.getTypeToTransformTo(*self.DAG.getContext(), Op.getValueType()), "Invalid type for widened vector");
    self.AnalyzeNewValue(Result);
    let mut OpIdEntry: *mut u32 = self.WidenedVectors[self.getTableId(Op)];
    assert!((OpIdEntry == 0), "Node already widened!");
    OpIdEntry = self.getTableId(Result);
}

fn DAGTypeLegalizer::BitConvertToInteger(self, Op: SDValue) -> SDValue {
    let mut BitWidth: u32 = Op.getValueSizeInBits().operator unsigned long long();
    return self.DAG.getNode(BITCAST, SDLoc { Op }, getIntegerVT(*self.DAG.getContext(), BitWidth), Op);
}

fn DAGTypeLegalizer::BitConvertVectorToIntegerVector(self, Op: SDValue) -> SDValue {
    assert!(Op.getValueType().isVector(), "Only applies to vectors!");
    let mut EltWidth: u32 = Op.getScalarValueSizeInBits();
    let mut EltNVT: EVT = getIntegerVT(*self.DAG.getContext(), EltWidth);
    let mut EltCnt: ElementCount = Op.getValueType().getVectorElementCount();
    return self.DAG.getNode(BITCAST, SDLoc { Op }, getVectorVT(*self.DAG.getContext(), EltNVT, EltCnt), Op);
}

fn DAGTypeLegalizer::CreateStackStoreLoad(self, Op: SDValue, DestVT: EVT) -> SDValue {
    let mut dl: SDLoc = SDLoc { Op };
    let mut DestAlign: Align = self.DAG.getReducedAlign(DestVT, false);
    let mut OpAlign: Align = self.DAG.getReducedAlign(Op.getValueType(), false);
    let mut Align: Align = if DestAlign > OpAlign { DestAlign } else { OpAlign };
    let mut StackPtr: SDValue = self.DAG.CreateStackTemporary(Op.getValueType().getStoreSize(), Align);
    let mut Store: SDValue = self.DAG.getStore(self.DAG.getEntryNode(), dl, Op, StackPtr, MachinePointerInfo { 0, 0 }, Align, MONone, MMOMetadata {});
    return self.DAG.getLoad(DestVT, dl, Store, StackPtr, MachinePointerInfo { 0, 0 }, MaybeAlign { Align }, MONone, MMOMetadata {});
}

fn DAGTypeLegalizer::CustomLowerNode(self, N: *mut SDNode, VT: EVT, LegalizeResult: bool) -> bool {
    if self.TLI.getOperationAction(N.getOpcode(), VT) != Custom {
        return false;
    }
    let mut Results: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    if LegalizeResult {
        self.TLI.ReplaceNodeResults(N, Results, self.DAG);
    } else {
        self.TLI.LowerOperationWrapper(N, Results, self.DAG);
    }
    if Results.len == 0 {
        return false;
    }
    assert!(Results.len == N.getNumValues(), "Custom lowering returned the wrong number of results!");
    for let mut i: u32 = 0;
let mut e: u32 = Results.len; i != e; i += 1 {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: i }, Results[i]);
    }
    return true;
}

fn DAGTypeLegalizer::CustomWidenLowerNode(self, N: *mut SDNode, VT: EVT) -> bool {
    if self.TLI.getOperationAction(N.getOpcode(), VT) != Custom {
        return false;
    }
    let mut Results: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    self.TLI.ReplaceNodeResults(N, Results, self.DAG);
    if Results.len == 0 {
        return false;
    }
    assert!(Results.len == N.getNumValues(), "Custom lowering returned the wrong number of results!");
    for let mut i: u32 = 0;
let mut e: u32 = Results.len; i != e; i += 1 {
        let mut WasWidened: bool = SDValue { Node: N, ResNo: i }.getValueType() != Results[i].getValueType();
        if WasWidened {
            self.SetWidenedVector(SDValue { Node: N, ResNo: i }, Results[i]);
        } else {
            self.ReplaceValueWith(SDValue { Node: N, ResNo: i }, Results[i]);
        }
    }
    return true;
}

fn DAGTypeLegalizer::DisintegrateMERGE_VALUES(self, N: *mut SDNode, ResNo: u32) -> SDValue {
    for let mut i: u32 = 0;
let mut e: u32 = N.getNumValues(); i != e; i += 1 {
        if i != ResNo {
            self.ReplaceValueWith(SDValue { Node: N, ResNo: i }, N.getOperand(i));
        }
    }
    return N.getOperand(ResNo);
}

fn DAGTypeLegalizer::GetPairElements(self, Pair: SDValue, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { Pair };
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), Pair.getValueType());
    tie(Lo, Hi) = self.DAG.SplitScalar(Pair, dl, NVT, NVT);
}

fn DAGTypeLegalizer::JoinIntegers(self, Lo: SDValue, Hi: SDValue) -> SDValue {
    let mut dlHi: SDLoc = SDLoc { Hi };
    let mut dlLo: SDLoc = SDLoc { Lo };
    let mut LVT: EVT = Lo.getValueType();
    let mut HVT: EVT = Hi.getValueType();
    let mut NVT: EVT = getIntegerVT(*self.DAG.getContext(), LVT.getSizeInBits() + HVT.getSizeInBits().operator unsigned long long());
    Lo = self.DAG.getNode(ZERO_EXTEND, dlLo, NVT, Lo);
    Hi = self.DAG.getNode(ANY_EXTEND, dlHi, NVT, Hi);
    Hi = self.DAG.getNode(SHL, dlHi, NVT, Hi, self.DAG.getShiftAmountConstant(LVT.getSizeInBits().operator unsigned long long(), NVT, dlHi));
    return self.DAG.getNode(OR, dlHi, NVT, Lo, Hi);
}

fn DAGTypeLegalizer::PromoteTargetBoolean(self, Bool: SDValue, ValVT: EVT) -> SDValue {
    return self.TLI.promoteTargetBoolean(self.DAG, Bool, ValVT);
}

fn DAGTypeLegalizer::SplitInteger(self, Op: SDValue, LoVT: EVT, HiVT: EVT, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { Op };
    assert!(LoVT.getSizeInBits() + HiVT.getSizeInBits() == Op.getValueSizeInBits(), "Invalid integer splitting!");
    Lo = self.DAG.getNode(TRUNCATE, dl, LoVT, Op);
    Hi = self.DAG.getNode(SRL, dl, Op.getValueType(), Op, self.DAG.getShiftAmountConstant(LoVT.getSizeInBits().operator unsigned long long(), Op.getValueType(), dl));
    Hi = self.DAG.getNode(TRUNCATE, dl, HiVT, Hi);
}

fn DAGTypeLegalizer::SplitInteger(self, Op: SDValue, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut HalfVT: EVT = getIntegerVT(*self.DAG.getContext(), Op.getValueSizeInBits().operator unsigned long long() / 2);
    self.SplitInteger(Op, HalfVT, HalfVT, Lo, Hi);
}

fn SelectionDAG::LegalizeTypes(self) -> bool {
    return DAGTypeLegalizer { *self }.run();
}
