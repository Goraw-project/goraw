static mut NumFastIselFailures: Statistic = Statistic { "isel", "NumFastIselFailures", "Number of instructions fast isel failed on" };

static mut NumFastIselSuccess: Statistic = Statistic { "isel", "NumFastIselSuccess", "Number of instructions fast isel selected" };

static mut NumFastIselBlocks: Statistic = Statistic { "isel", "NumFastIselBlocks", "Number of blocks selected entirely by fast isel" };

static mut NumDAGBlocks: Statistic = Statistic { "isel", "NumDAGBlocks", "Number of blocks selected using DAG" };

static mut NumDAGIselRetries: Statistic = Statistic { "isel", "NumDAGIselRetries", "Number of times dag isel has to try another path" };

static mut NumEntryBlocks: Statistic = Statistic { "isel", "NumEntryBlocks", "Number of entry blocks encountered" };

static mut NumFastIselFailLowerArguments: Statistic = Statistic { "isel", "NumFastIselFailLowerArguments", "Number of entry blocks where fast isel failed to lower arguments" };

static mut EnableFastISelAbort: opt<int> = opt<int> { "fast-isel-abort", Hidden, "Enable abort calls when \"fast\" instruction selection fails to lower an instruction: 0 disable the abort, 1 will abort but for args, calls and terminators, 2 will also abort for argument lowering, and 3 will never fallback to SelectionDAG." };

static mut EnableFastISelFallbackReport: opt<bool> = opt<bool> { "fast-isel-report-on-fallback", Hidden, "Emit a diagnostic when \"fast\" instruction selection falls back to SelectionDAG." };

static mut UseMBPI: opt<bool> = opt<bool> { "use-mbpi", "use Machine Branch Probability Info", init(true), Hidden };

static mut DumpSortedDAG: opt<bool> = opt<bool> { "dump-sorted-dags", Hidden, "Print DAGs with sorted nodes in debug dump", init(false) };

static mut FilterDAGBasicBlockName: string> = string> { "filter-view-dags", Hidden, "Only display the basic block whose name matches this for all view-*-dags options" };

static mut ViewDAGCombine1: opt<bool> = opt<bool> { "view-dag-combine1-dags", Hidden, "Pop up a window to show dags before the first dag combine pass" };

static mut ViewLegalizeTypesDAGs: opt<bool> = opt<bool> { "view-legalize-types-dags", Hidden, "Pop up a window to show dags before legalize types" };

static mut ViewDAGCombineLT: opt<bool> = opt<bool> { "view-dag-combine-lt-dags", Hidden, "Pop up a window to show dags before the post legalize types dag combine pass" };

static mut ViewLegalizeDAGs: opt<bool> = opt<bool> { "view-legalize-dags", Hidden, "Pop up a window to show dags before legalize" };

static mut ViewDAGCombine2: opt<bool> = opt<bool> { "view-dag-combine2-dags", Hidden, "Pop up a window to show dags before the second dag combine pass" };

static mut ViewISelDAGs: opt<bool> = opt<bool> { "view-isel-dags", Hidden, "Pop up a window to show isel dags as they are selected" };

static mut ViewSchedDAGs: opt<bool> = opt<bool> { "view-sched-dags", Hidden, "Pop up a window to show sched dags as they are processed" };

static mut ViewSUnitDAGs: opt<bool> = opt<bool> { "view-sunit-dags", Hidden, "Pop up a window to show SUnit dags after they are processed" };

static mut Registry: FunctionPassCtor> = FunctionPassCtor> {};

static mut ISHeuristic: FunctionPassCtor, false, RegisterPassParser<RegisterScheduler>> = FunctionPassCtor, false, RegisterPassParser<RegisterScheduler>> { "pre-RA-sched", init(&mut createDefaultScheduler), Hidden, "Instruction schedulers available (before register allocation):" };

static mut defaultListDAGScheduler: RegisterScheduler = RegisterScheduler { "default", "Best scheduler for the target", createDefaultScheduler };

fn dontUseFastISelFor(Fn: *Function) -> bool {
    return any_of(Fn.args(), Closure_1 {});
}

fn maintainPGOProfile(TM: *TargetMachine, OptLevel: CodeGenOptLevel) -> bool {
    if OptLevel != None {
        return true;
    }
    if TM.getPGOOption() {
        let mut Options: *PGOOptions = operator(TM.getPGOOption());
        return Options.Action == IRUse || Options.Action == SampleUse || Options.CSAction == CSIRUse;
    }
    return false;
}

struct OptLevelChanger {
    IS: *mut SelectionDAGISel,
    SavedOptLevel: CodeGenOptLevel,
    SavedFastISel: bool,
}

fn OptLevelChanger::OptLevelChanger(self, ISel: *mut SelectionDAGISel, NewOptLevel: CodeGenOptLevel) {
    self.SavedOptLevel = self.IS.OptLevel;
    self.SavedFastISel = self.IS.TM.Options.EnableFastISel;
    if NewOptLevel != self.SavedOptLevel {
        self.IS.OptLevel = NewOptLevel;
        self.IS.TM.setOptLevel(NewOptLevel);
        while true {
            {
            if DebugFlag && isCurrentDebugType("isel", 1) {
                dbgs() << "\nChanging optimization level for Function " << self.IS.MF.getFunction().getName() << "\n";
            }
        }
            if !(false) { break; }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("isel", 1) {
                dbgs() << "\tBefore: -O" << self.SavedOptLevel as i32 << " ; After: -O" << NewOptLevel as i32 << "\n";
            }
        }
            if !(false) { break; }
        }
        if NewOptLevel == None {
            self.IS.TM.setFastISel(self.IS.TM.getO0WantsFastISel());
        }
    }
    if dontUseFastISelFor(self.IS.MF.getFunction()) {
        self.IS.TM.setFastISel(false);
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("isel", 1) {
            dbgs() << "\tFastISel is " << (if self.IS.TM.Options.EnableFastISel { "enabled" } else { "disabled" }) << "\n";
        }
    }
        if !(false) { break; }
    }
}

fn OptLevelChanger::~OptLevelChanger(self) {
    if self.IS.OptLevel == self.SavedOptLevel {
        return;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("isel", 1) {
            dbgs() << "\nRestoring optimization level for Function " << self.IS.MF.getFunction().getName() << "\n";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("isel", 1) {
            dbgs() << "\tBefore: -O" << self.IS.OptLevel as i32 << " ; After: -O" << self.SavedOptLevel as i32 << "\n";
        }
    }
        if !(false) { break; }
    }
    self.IS.OptLevel = self.SavedOptLevel;
    self.IS.TM.setOptLevel(self.SavedOptLevel);
    self.IS.TM.setFastISel(self.SavedFastISel);
}

fn createDefaultScheduler(IS: *mut SelectionDAGISel, OptLevel: CodeGenOptLevel) -> *mut ScheduleDAGSDNodes {
    let mut TLI: *TargetLowering = IS.TLI;
    let mut ST: *TargetSubtargetInfo = IS.MF.getSubtarget();
    if ST.getDAGScheduler(OptLevel) {
        SchedulerCtor;
    } else {
        return SchedulerCtor(IS, OptLevel);
    }
    if OptLevel == None || (ST.enableMachineScheduler() && ST.enableMachineSchedDefaultSched()) || TLI.getSchedulingPreference() == Source {
        return createSourceListDAGScheduler(IS, OptLevel);
    }
    if TLI.getSchedulingPreference() == RegPressure {
        return createBURRListDAGScheduler(IS, OptLevel);
    }
    if TLI.getSchedulingPreference() == Hybrid {
        return createHybridListDAGScheduler(IS, OptLevel);
    }
    if TLI.getSchedulingPreference() == VLIW {
        return createVLIWDAGScheduler(IS, OptLevel);
    }
    if TLI.getSchedulingPreference() == Fast {
        return createFastDAGScheduler(IS, OptLevel);
    }
    if TLI.getSchedulingPreference() == Linearize {
        return createDAGLinearizer(IS, OptLevel);
    }
    assert!(TLI.getSchedulingPreference() == ILP, "Unknown sched type!");
    return createILPListDAGScheduler(IS, OptLevel);
}

fn TargetLowering::EmitInstrWithCustomInserter(self: *TargetLowering, MI: *mut MachineInstr, MBB: *mut MachineBasicBlock) -> *mut MachineBasicBlock {
    match MI.getOpcode() {
        STATEPOINT => {
            STACKMAP;
        },
        _ => {
            break;
        },
    }
    dbgs() << "If a target marks an instruction with 'usesCustomInserter', it must implement TargetLowering::EmitInstrWithCustomInserter!\n";
    llvm_unreachable_internal(null, "P:/Goraw/llvm-project/llvm/lib/CodeGen/SelectionDAG/SelectionDAGISel.cpp", 351);
}

fn TargetLowering::AdjustInstrPostInstrSelection(self: *TargetLowering, MI: *mut MachineInstr, Node: *mut SDNode) {
    assert!(!MI.hasPostISelHook(IgnoreBundle), "If a target marks an instruction with 'hasPostISelHook', it must implement TargetLowering::AdjustInstrPostInstrSelection!");
}

fn SelectionDAGISelLegacy::SelectionDAGISelLegacy(self, ID: *mut i8, S: unique_ptr<SelectionDAGISel>) {
    initializeBranchProbabilityInfoWrapperPassPass(*getPassRegistry());
    initializeAAResultsWrapperPassPass(*getPassRegistry());
    initializeTargetLibraryInfoWrapperPassPass(*getPassRegistry());
}

fn SelectionDAGISelLegacy::runOnMachineFunction(self, MF: *mut MachineFunction) -> bool {
    if MF.getProperties().hasSelected() {
        return false;
    }
    if EnableFastISelAbort.operator int() && !operator(self.Selector).TM.Options.EnableFastISel {
        reportFatalUsageError("-fast-isel-abort > 0 requires -fast-isel");
    }
    MF.setUseDebugInstrRef(MF.shouldUseDebugInstrRef());
    let mut NewOptLevel: CodeGenOptLevel = if self.skipFunction(MF.getFunction()) { None } else { operator(self.Selector).OptLevel };
    operator(self.Selector).MF = &mut MF;
    let mut OLC: OptLevelChanger = OptLevelChanger { operator(self.Selector), NewOptLevel };
    operator(self.Selector).initializeAnalysisResults(*self);
    return operator(self.Selector).runOnMachineFunction(MF);
}

fn SelectionDAGISel::SelectionDAGISel(self, tm: *mut TargetMachine, OL: CodeGenOptLevel) {
    initializeBranchProbabilityInfoWrapperPassPass(*getPassRegistry());
    initializeAAResultsWrapperPassPass(*getPassRegistry());
    initializeTargetLibraryInfoWrapperPassPass(*getPassRegistry());
}

fn SelectionDAGISel::~SelectionDAGISel(self) {
    self.CurDAG;
}

fn SelectionDAGISelLegacy::getAnalysisUsage(self: *SelectionDAGISelLegacy, AU: *mut AnalysisUsage) {
    let mut OptLevel: CodeGenOptLevel = operator(self.Selector).OptLevel;
    let mut RegisterPGOPasses: bool = maintainPGOProfile(operator(self.Selector).TM, operator(self.Selector).OptLevel);
    if OptLevel != None {
        AU.addRequired();
    }
    AU.addRequired();
    AU.addRequired();
    AU.addPreserved();
    AU.addRequired();
    AU.addRequired();
    AU.addRequired();
    if UseMBPI && RegisterPGOPasses {
        AU.addRequired();
    }
    AU.addRequired();
    AU.addRequired();
    AU.addPreserved();
    if RegisterPGOPasses {
        getLazyBFIAnalysisUsage(AU);
    }
    AU.addRequired();
    self.getAnalysisUsage(AU);
}

fn SelectionDAGISelPass::run(self, MF: *mut MachineFunction, MFAM: *mut MachineFunctionAnalysisManager) -> PreservedAnalyses {
    if MF.getProperties().hasSelected() {
        return all();
    }
    if EnableFastISelAbort.operator int() && !operator(self.Selector).TM.Options.EnableFastISel {
        reportFatalUsageError("-fast-isel-abort > 0 requires -fast-isel");
    }
    MF.setUseDebugInstrRef(MF.shouldUseDebugInstrRef());
    operator(self.Selector).MF = &mut MF;
    let mut NewOptLevel: CodeGenOptLevel = if (MF.getFunction().hasOptNone() || self.shouldSkipOptimizationForOptBisect(MF.getFunction())) { None } else { operator(self.Selector).OptLevel };
    let mut OLC: OptLevelChanger = OptLevelChanger { operator(self.Selector), NewOptLevel };
    operator(self.Selector).initializeAnalysisResults(MFAM);
    operator(self.Selector).runOnMachineFunction(MF);
    return getMachineFunctionPassPreservedAnalyses();
}

fn SelectionDAGISel::initializeAnalysisResults(self, MFAM: *mut MachineFunctionAnalysisManager) {
    let mut FAM: *mut FunctionAnalysisManager = MFAM.getResult(*self.MF).getManager();
    let mut MAMP: *mut Result = MFAM.getResult(*self.MF);
    let mut Fn: *mut Function = self.MF.getFunction();
    self.FuncName = Fn.getName();
    self.MatchFilterFuncName = isFunctionInPrintList(self.FuncName);
    let mut Subtarget: *TargetSubtargetInfo = self.MF.getSubtarget();
    let mut RegisterPGOPasses: bool = maintainPGOProfile(self.TM, self.OptLevel);
    self.TII = Subtarget.getInstrInfo();
    self.TLI = Subtarget.getTargetLowering();
    self.RegInfo = &mut self.MF.getRegInfo();
    self.LibInfo = &mut FAM.getResult(Fn);
    self.GFI = if Fn.hasGC() { &mut FAM.getResult(Fn) } else { null };
    self.ORE = make_unique(&mut Fn);
    self.AC = &mut FAM.getResult(Fn);
    let mut PSI: *mut Result = MAMP.getCachedResult(*Fn.getParent());
    let mut BFI: *mut BlockFrequencyInfo = null;
    if PSI && PSI.hasProfileSummary() && RegisterPGOPasses {
        BFI = &mut FAM.getResult(Fn);
    }
    let mut FnVarLocs: *FunctionVarLocs = null;
    if isAssignmentTrackingEnabled(*Fn.getParent()) {
        FnVarLocs = &mut FAM.getResult(Fn);
    }
    let mut UA: *mut Result = FAM.getCachedResult(Fn);
    let mut LibcallResult: *ModuleLibcallLoweringInfo = MAMP.getCachedResult(*Fn.getParent());
    if !LibcallResult {
        reportFatalUsageError("'" + name() + "' analysis required");
    }
    self.LibcallLowering = &mut getLibcallLowering(*LibcallResult, Subtarget);
    self.CurDAG.init(*self.MF, MFAM, self.LibInfo, self.LibcallLowering, UA, PSI, BFI, FnVarLocs);
    if UseMBPI && RegisterPGOPasses {
        operator(self.FuncInfo).BPI = &mut FAM.getResult(Fn);
    } else {
        operator(self.FuncInfo).BPI = null;
    }
    if self.OptLevel != None {
        self.BatchAA.emplace(FAM.getResult(Fn));
    } else {
        self.BatchAA = nullopt;
    }
    self.SP = &mut FAM.getResult(Fn);
    self.TTI = &mut FAM.getResult(Fn);
    self.HwMode = Subtarget.getHwMode(HwMode_Default);
}

fn SelectionDAGISel::initializeAnalysisResults(self, MFP: *mut MachineFunctionPass) {
    let mut Fn: *mut Function = self.MF.getFunction();
    self.FuncName = Fn.getName();
    self.MatchFilterFuncName = isFunctionInPrintList(self.FuncName);
    let mut Subtarget: *TargetSubtargetInfo = self.MF.getSubtarget();
    let mut RegisterPGOPasses: bool = maintainPGOProfile(self.TM, self.OptLevel);
    self.TII = Subtarget.getInstrInfo();
    self.TLI = Subtarget.getTargetLowering();
    self.RegInfo = &mut self.MF.getRegInfo();
    self.LibInfo = &mut MFP.getAnalysis().getTLI(Fn);
    self.GFI = if Fn.hasGC() { &mut MFP.getAnalysis().getFunctionInfo(Fn) } else { null };
    self.ORE = make_unique(&mut Fn);
    self.AC = &mut MFP.getAnalysis().getAssumptionCache(Fn);
    let mut PSI: *mut ProfileSummaryInfo = &mut MFP.getAnalysis().getPSI();
    let mut BFI: *mut BlockFrequencyInfo = null;
    if PSI && PSI.hasProfileSummary() && RegisterPGOPasses {
        BFI = &mut MFP.getAnalysis().getBFI();
    }
    let mut FnVarLocs: *FunctionVarLocs = null;
    if isAssignmentTrackingEnabled(*Fn.getParent()) {
        FnVarLocs = MFP.getAnalysis().getResults();
    }
    let mut UA: *mut UniformityInfo = null;
    if MFP.getAnalysisIfAvailable() {
        UAPass;
    } else {
        UA = &mut UAPass.getUniformityInfo();
    }
    self.LibcallLowering = &mut MFP.getAnalysis().getLibcallLowering(*Fn.getParent(), Subtarget);
    self.CurDAG.init(*self.MF, self.LibInfo, self.LibcallLowering, UA, PSI, BFI, FnVarLocs);
    if UseMBPI && RegisterPGOPasses {
        operator(self.FuncInfo).BPI = &mut MFP.getAnalysis().getBPI();
    } else {
        operator(self.FuncInfo).BPI = null;
    }
    if self.OptLevel != None {
        self.BatchAA.emplace(MFP.getAnalysis().getAAResults());
    } else {
        self.BatchAA = nullopt;
    }
    self.SP = &mut MFP.getAnalysis().getLayoutInfo();
    self.TTI = &mut MFP.getAnalysis().getTTI(Fn);
    self.HwMode = Subtarget.getHwMode(HwMode_Default);
}

fn SelectionDAGISel::runOnMachineFunction(self, mf: *mut MachineFunction) -> bool {
    operator(self.SwiftError).setFunction(mf);
    let mut Fn: *Function = mf.getFunction();
    let mut InstrRef: bool = mf.useDebugInstrRef();
    operator(self.FuncInfo).set(self.MF.getFunction(), *self.MF, self.CurDAG);
    while true {
        {
        if DebugFlag && (isCurrentDebugType("isel", 0) || (isCurrentDebugType("isel-dump", 0) && self.MatchFilterFuncName)) {
            dbgs() << "\n\n\n=== " << self.FuncName << 10;
        }
    }
        if !(false) { break; }
    }
    operator(self.SDB).init(self.GFI, self.getBatchAA(), self.AC, self.LibInfo, *self.TTI);
    self.MF.setHasInlineAsm(false);
    operator(self.FuncInfo).SplitCSR = false;
    if self.OptLevel != None && self.TLI.supportSplitCSR(self.MF) {
        operator(self.FuncInfo).SplitCSR = true;
        for BB in Fn {
            if !succ_empty(&mut BB) {
                continue;
            }
            let mut Term: *Instruction = BB.getTerminator();
            if isa(Term) || isa(Term) {
                continue;
            }
            operator(self.FuncInfo).SplitCSR = false;
            break;
        }
    }
    let mut EntryMBB: *mut MachineBasicBlock = &mut self.MF.front();
    if operator(self.FuncInfo).SplitCSR {
        self.TLI.initializeSplitCSR(EntryMBB);
    }
    self.SelectAllBasicBlocks(Fn);
    if self.FastISelFailed && EnableFastISelFallbackReport {
        let mut DiagFallback: DiagnosticInfoISelFallback = DiagnosticInfoISelFallback { Fn, DS_Warning };
        Fn.getContext().diagnose(DiagFallback);
    }
    let mut MRI: *mut MachineRegisterInfo = self.MF.getRegInfo();
    for let mut I: iterator = operator(self.FuncInfo).RegFixups.begin();
let mut E: iterator = operator(self.FuncInfo).RegFixups.end(); I != E; operator(I) {
        let mut From: Register = operator(I).first;
        let mut To: Register = operator(I).second;
        while true {
            let mut J: iterator = operator(self.FuncInfo).RegFixups.find(To);
            if J == E {
                break;
            }
            To = operator(J).second;
        }
        if From.isVirtual() && To.isVirtual() {
            MRI.constrainRegClass(To, MRI.getRegClass(From), 0);
        }
        if !MRI.use_empty(To) {
            MRI.clearKillFlags(From);
        }
        MRI.replaceRegWith(From, To);
    }
    let mut TRI: *TargetRegisterInfo = *self.MF.getSubtarget().getRegisterInfo();
    self.RegInfo.EmitLiveInCopies(EntryMBB, TRI, *self.TII);
    if operator(self.FuncInfo).SplitCSR {
        let mut Returns: SmallVector<MachineBasicBlock *, 4> = SmallVector<MachineBasicBlock *, 4> {};
        for MBB in mf {
            if !MBB.succ_empty() {
                continue;
            }
            let mut Term: iterator = MBB.getFirstTerminator();
            if Term != MBB.end() && operator(Term).isReturn(AnyInBundle) {
                Returns.push(&mut MBB);
                continue;
            }
        }
        self.TLI.insertCopiesSplitCSR(EntryMBB, Returns);
    }
    let mut LiveInMap: DenseMap<MCRegister, Register> = DenseMap<MCRegister, Register> {};
    if !operator(self.FuncInfo).ArgDbgValues.is_empty() {
        for LI in self.RegInfo.liveins() {
            if LI.second.operator unsigned int() {
                LiveInMap.insert(LI);
            }
        }
    }
    for let mut i: u32 = 0;
let mut e: u32 = operator(self.FuncInfo).ArgDbgValues.len; i != e; i += 1 {
        let mut MI: *mut MachineInstr = operator(self.FuncInfo).ArgDbgValues[e - i - 1];
        assert!(MI.getOpcode() != DBG_VALUE_LIST, "Function parameters should not be described by DBG_VALUE_LIST.");
        let mut hasFI: bool = MI.getDebugOperand(0).isFI();
        let mut Reg: Register = if hasFI { TRI.getFrameRegister(*self.MF) } else { MI.getDebugOperand(0).getReg() };
        if Reg.isPhysical() {
            EntryMBB.insert(EntryMBB.begin(), MI);
        } else {
            let mut Def: *mut MachineInstr = self.RegInfo.getVRegDef(Reg);
            if Def {
                let mut InsertPos: iterator = Def;
                Def.getParent().insert(next(InsertPos, 1), MI);
            } else {
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("isel", 1) {
                        dbgs() << "Dropping debug info for dead vreg" << printReg(Reg, null, 0, null) << 10;
                    }
                }
                    if !(false) { break; }
                }
            }
        }
        if InstrRef {
            continue;
        }
        if !Reg.isPhysical() {
            continue;
        }
        let mut LDI: iterator = LiveInMap.find(Reg.operator MCRegister());
        if LDI != LiveInMap.end() {
            assert!(!hasFI, "There's no handling of frame pointer updating here yet - add if needed");
            let mut Def: *mut MachineInstr = self.RegInfo.getVRegDef(operator(LDI).second);
            let mut InsertPos: iterator = Def;
            let mut Variable: *MDNode = MI.getDebugVariable();
            let mut Expr: *MDNode = MI.getDebugExpression();
            let mut DL: DebugLoc = MI.getDebugLoc();
            let mut IsIndirect: bool = MI.isIndirectDebugValue();
            if IsIndirect {
                assert!(MI.getDebugOffset().getImm() == 0, "DBG_VALUE with nonzero offset");
            }
            assert!(cast(Variable).isValidLocationForIntrinsic(DL.operator llvm::DILocation *()), "Expected inlined-at fields to agree");
            assert!(MI.getOpcode() != DBG_VALUE_LIST, "Didn't expect to see a DBG_VALUE_LIST here");
            BuildMI(*EntryMBB, operator(InsertPos), DL, self.TII.get(DBG_VALUE), IsIndirect, operator(LDI).second, Variable, Expr);
            let mut CopyUseMI: *mut MachineInstr = null;
            for UseMI in self.RegInfo.use_instructions(operator(LDI).second) {
                if UseMI.isDebugValue() {
                    continue;
                }
                if UseMI.isCopy() && !CopyUseMI && UseMI.getParent() == EntryMBB {
                    CopyUseMI = &mut UseMI;
                    continue;
                }
                CopyUseMI = null;
                break;
            }
            if CopyUseMI && TRI.getRegSizeInBits(operator(LDI).second, MRI) == TRI.getRegSizeInBits(CopyUseMI.getOperand(0).getReg(), MRI) {
                let mut NewMI: *mut MachineInstr = BuildMI(*self.MF, DL, self.TII.get(DBG_VALUE), IsIndirect, CopyUseMI.getOperand(0).getReg(), Variable, Expr).operator llvm::MachineInstr *();
                let mut Pos: iterator = CopyUseMI;
                EntryMBB.insertAfter(Pos, NewMI);
            }
        }
    }
    if self.MF.useDebugInstrRef() {
        self.MF.finalizeDebugInstrRefs();
    }
    let mut MFI: *mut MachineFrameInfo = self.MF.getFrameInfo();
    for MBB in *self.MF {
        if MFI.hasCalls() && self.MF.hasInlineAsm() {
            break;
        }
        for MI in MBB {
            let mut MCID: *MCInstrDesc = self.TII.get(MI.getOpcode());
            if (MCID.isCall() && !MCID.isReturn()) || MI.isStackAligningInlineAsm() {
                MFI.setHasCalls(true);
            }
            if MI.isInlineAsm() {
                self.MF.setHasInlineAsm(true);
            }
        }
    }
    operator(self.FuncInfo).clear();
    while true {
        {
        if DebugFlag && (isCurrentDebugType("isel", 0) || (isCurrentDebugType("isel-dump", 0) && self.MatchFilterFuncName)) {
            dbgs() << "*** MachineFunction at end of ISel ***\n";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && (isCurrentDebugType("isel", 0) || (isCurrentDebugType("isel-dump", 0) && self.MatchFilterFuncName)) {
            self.MF.print(dbgs(), null);
        }
    }
        if !(false) { break; }
    }
    return true;
}

fn reportFastISelFailure(MF: *mut MachineFunction, ORE: *mut OptimizationRemarkEmitter, R: *mut OptimizationRemarkMissed, ShouldAbort: bool) {
    if !R.getLocation().isValid() || ShouldAbort {
        R << (" (in function: " + MF.getName() + ")");
    }
    if ShouldAbort {
        reportFatalUsageError(R.getMsg());
    }
    ORE.emit(R);
    while true {
        {
        if DebugFlag && isCurrentDebugType("isel", 1) {
            dbgs() << R.getMsg() << "\n";
        }
    }
        if !(false) { break; }
    }
}

fn preserveFakeUses(Begin: iterator, End: iterator) {
    let mut I: iterator = End;
    if operator(I) == Begin || !isa(operator(I)) {
        return;
    }
    let mut HaveFakeUse: bool = false;
    let mut HaveTailCall: bool = false;
    while true {
        {
        if dyn_cast(operator(I)) {
            CI;
        } else if CI.isTailCall() {
            HaveTailCall = true;
            break;
        }
        if dyn_cast(I) {
            II;
        } else if II.getIntrinsicID() == fake_use {
            HaveFakeUse = true;
        }
    }
        if !(I != Begin) { break; }
    }
    if !HaveTailCall || !HaveFakeUse {
        return;
    }
    let mut FakeUses: SmallVector<IntrinsicInst *> = SmallVector<IntrinsicInst *> {};
    for let mut Inst: iterator = I; Inst != End; operator(Inst, 0) {
        let mut FakeUse: *mut IntrinsicInst = dyn_cast(Inst);
        if FakeUse && FakeUse.getIntrinsicID() == fake_use {
            let mut UsedDef: CastReturnType = dyn_cast(FakeUse.getOperand(0));
            if !UsedDef || UsedDef.getParent() != operator(I).getParent() || UsedDef.comesBefore(&mut operator(I)) {
                FakeUses.push(FakeUse);
            }
        }
    }
    for Inst in FakeUses {
        Inst.moveBefore(*Inst.getParent(), I);
    }
}

fn SelectionDAGISel::SelectBasicBlock(self, Begin: const_iterator, End: const_iterator, HadTailCall: *mut bool) {
    self.CurDAG.NewNodesMustHaveLegalTypes = false;
    for let mut I: const_iterator = Begin; I != End && !operator(self.SDB).HasTailCall; operator(I) {
        if !self.ElidedArgCopyInstrs.count(&mut operator(I)) {
            operator(self.SDB).visit(operator(I));
        } else {
            operator(self.SDB).visitDbgInfo(operator(I));
        }
    }
    self.CurDAG.setRoot(operator(self.SDB).getControlRoot());
    HadTailCall = operator(self.SDB).HasTailCall;
    operator(self.SDB).resolveOrClearDbgInfo();
    operator(self.SDB).clear();
    self.CodeGenAndEmitDAG();
}

fn SelectionDAGISel::ComputeLiveOutVRegInfo(self) {
    let mut Added: SmallPtrSet<SDNode *, 16> = SmallPtrSet<SDNode *, 16> {};
    let mut Worklist: SmallVector<SDNode *, 128> = SmallVector<SDNode *, 128> {};
    Worklist.push(self.CurDAG.getRoot().getNode());
    Added.insert(self.CurDAG.getRoot().getNode());
    let mut Known: KnownBits = KnownBits {};
    while true {
        {
        let mut N: *mut SDNode = Worklist.pop_back_val();
        for Op in N.op_values() {
            if Op.getValueType() == Other && Added.insert(Op.getNode()).second {
                Worklist.push(Op.getNode());
            }
        }
        if N.getOpcode() != CopyToReg {
            continue;
        }
        let mut DestReg: Register = cast(N.getOperand(1)).getReg();
        if !DestReg.isVirtual() {
            continue;
        }
        let mut Src: SDValue = N.getOperand(2);
        let mut SrcVT: EVT = Src.getValueType();
        if !SrcVT.isInteger() {
            continue;
        }
        let mut NumSignBits: u32 = self.CurDAG.ComputeNumSignBits(Src, 0);
        Known = self.CurDAG.computeKnownBits(Src, 0);
        operator(self.FuncInfo).AddLiveOutRegInfo(DestReg, NumSignBits, Known);
    }
        if !(!Worklist.is_empty()) { break; }
    }
}

fn SelectionDAGISel::CodeGenAndEmitDAG(self) {
    let mut GroupName: str = "sdag";
    let mut GroupDescription: str = "Instruction Selection and Scheduling";
    let mut BlockName: str = "";
    let mut MatchFilterBB: bool = false;
    MatchFilterBB as void;
    self.CurDAG.NewNodesMustHaveLegalTypes = false;
    MatchFilterBB = (FilterDAGBasicBlockName.is_empty() || FilterDAGBasicBlockName == operator(self.FuncInfo).MBB.getBasicBlock().getName());
    {
        BlockName = (self.MF.getName() + ":" + operator(self.FuncInfo).MBB.getBasicBlock().getName());
    }
    while true {
        {
        if DebugFlag && (isCurrentDebugType("isel", 0) || (isCurrentDebugType("isel-dump", 0) && self.MatchFilterFuncName)) {
            dbgs() << "\nInitial selection DAG: " << printMBBReference(*operator(self.FuncInfo).MBB) << " '" << BlockName << "'\n";
            self.CurDAG.dump(DumpSortedDAG);
        }
    }
        if !(false) { break; }
    }
    if ViewDAGCombine1 && MatchFilterBB {
        self.CurDAG.viewGraph("dag-combine1 input for " + BlockName);
    }
    {
        let mut T: NamedRegionTimer = NamedRegionTimer { "combine1", "DAG Combining 1", GroupName, GroupDescription, TimePassesIsEnabled };
        self.CurDAG.Combine(BeforeLegalizeTypes, self.getBatchAA(), self.OptLevel);
    }
    while true {
        {
        if DebugFlag && (isCurrentDebugType("isel", 0) || (isCurrentDebugType("isel-dump", 0) && self.MatchFilterFuncName)) {
            dbgs() << "\nOptimized lowered selection DAG: " << printMBBReference(*operator(self.FuncInfo).MBB) << " '" << BlockName << "'\n";
            self.CurDAG.dump(DumpSortedDAG);
        }
    }
        if !(false) { break; }
    }
    if ViewLegalizeTypesDAGs && MatchFilterBB {
        self.CurDAG.viewGraph("legalize-types input for " + BlockName);
    }
    let mut Changed: bool = false;
    {
        let mut T: NamedRegionTimer = NamedRegionTimer { "legalize_types", "Type Legalization", GroupName, GroupDescription, TimePassesIsEnabled };
        Changed = self.CurDAG.LegalizeTypes();
    }
    while true {
        {
        if DebugFlag && (isCurrentDebugType("isel", 0) || (isCurrentDebugType("isel-dump", 0) && self.MatchFilterFuncName)) {
            dbgs() << "\nType-legalized selection DAG: " << printMBBReference(*operator(self.FuncInfo).MBB) << " '" << BlockName << "'\n";
            self.CurDAG.dump(DumpSortedDAG);
        }
    }
        if !(false) { break; }
    }
    self.CurDAG.NewNodesMustHaveLegalTypes = true;
    if Changed {
        if ViewDAGCombineLT && MatchFilterBB {
            self.CurDAG.viewGraph("dag-combine-lt input for " + BlockName);
        }
        {
            let mut T: NamedRegionTimer = NamedRegionTimer { "combine_lt", "DAG Combining after legalize types", GroupName, GroupDescription, TimePassesIsEnabled };
            self.CurDAG.Combine(AfterLegalizeTypes, self.getBatchAA(), self.OptLevel);
        }
        while true {
            {
            if DebugFlag && (isCurrentDebugType("isel", 0) || (isCurrentDebugType("isel-dump", 0) && self.MatchFilterFuncName)) {
                dbgs() << "\nOptimized type-legalized selection DAG: " << printMBBReference(*operator(self.FuncInfo).MBB) << " '" << BlockName << "'\n";
                self.CurDAG.dump(DumpSortedDAG);
            }
        }
            if !(false) { break; }
        }
    }
    {
        let mut T: NamedRegionTimer = NamedRegionTimer { "legalize_vec", "Vector Legalization", GroupName, GroupDescription, TimePassesIsEnabled };
        Changed = self.CurDAG.LegalizeVectors();
    }
    if Changed {
        while true {
            {
            if DebugFlag && (isCurrentDebugType("isel", 0) || (isCurrentDebugType("isel-dump", 0) && self.MatchFilterFuncName)) {
                dbgs() << "\nVector-legalized selection DAG: " << printMBBReference(*operator(self.FuncInfo).MBB) << " '" << BlockName << "'\n";
                self.CurDAG.dump(DumpSortedDAG);
            }
        }
            if !(false) { break; }
        }
        {
            let mut T: NamedRegionTimer = NamedRegionTimer { "legalize_types2", "Type Legalization 2", GroupName, GroupDescription, TimePassesIsEnabled };
            self.CurDAG.LegalizeTypes();
        }
        while true {
            {
            if DebugFlag && (isCurrentDebugType("isel", 0) || (isCurrentDebugType("isel-dump", 0) && self.MatchFilterFuncName)) {
                dbgs() << "\nVector/type-legalized selection DAG: " << printMBBReference(*operator(self.FuncInfo).MBB) << " '" << BlockName << "'\n";
                self.CurDAG.dump(DumpSortedDAG);
            }
        }
            if !(false) { break; }
        }
        if ViewDAGCombineLT && MatchFilterBB {
            self.CurDAG.viewGraph("dag-combine-lv input for " + BlockName);
        }
        {
            let mut T: NamedRegionTimer = NamedRegionTimer { "combine_lv", "DAG Combining after legalize vectors", GroupName, GroupDescription, TimePassesIsEnabled };
            self.CurDAG.Combine(AfterLegalizeVectorOps, self.getBatchAA(), self.OptLevel);
        }
        while true {
            {
            if DebugFlag && (isCurrentDebugType("isel", 0) || (isCurrentDebugType("isel-dump", 0) && self.MatchFilterFuncName)) {
                dbgs() << "\nOptimized vector-legalized selection DAG: " << printMBBReference(*operator(self.FuncInfo).MBB) << " '" << BlockName << "'\n";
                self.CurDAG.dump(DumpSortedDAG);
            }
        }
            if !(false) { break; }
        }
    }
    if ViewLegalizeDAGs && MatchFilterBB {
        self.CurDAG.viewGraph("legalize input for " + BlockName);
    }
    {
        let mut T: NamedRegionTimer = NamedRegionTimer { "legalize", "DAG Legalization", GroupName, GroupDescription, TimePassesIsEnabled };
        self.CurDAG.Legalize();
    }
    while true {
        {
        if DebugFlag && (isCurrentDebugType("isel", 0) || (isCurrentDebugType("isel-dump", 0) && self.MatchFilterFuncName)) {
            dbgs() << "\nLegalized selection DAG: " << printMBBReference(*operator(self.FuncInfo).MBB) << " '" << BlockName << "'\n";
            self.CurDAG.dump(DumpSortedDAG);
        }
    }
        if !(false) { break; }
    }
    if ViewDAGCombine2 && MatchFilterBB {
        self.CurDAG.viewGraph("dag-combine2 input for " + BlockName);
    }
    {
        let mut T: NamedRegionTimer = NamedRegionTimer { "combine2", "DAG Combining 2", GroupName, GroupDescription, TimePassesIsEnabled };
        self.CurDAG.Combine(AfterLegalizeDAG, self.getBatchAA(), self.OptLevel);
    }
    while true {
        {
        if DebugFlag && (isCurrentDebugType("isel", 0) || (isCurrentDebugType("isel-dump", 0) && self.MatchFilterFuncName)) {
            dbgs() << "\nOptimized legalized selection DAG: " << printMBBReference(*operator(self.FuncInfo).MBB) << " '" << BlockName << "'\n";
            self.CurDAG.dump(DumpSortedDAG);
        }
    }
        if !(false) { break; }
    }
    if self.OptLevel != None {
        self.ComputeLiveOutVRegInfo();
    }
    if ViewISelDAGs && MatchFilterBB {
        self.CurDAG.viewGraph("isel input for " + BlockName);
    }
    {
        let mut T: NamedRegionTimer = NamedRegionTimer { "isel", "Instruction Selection", GroupName, GroupDescription, TimePassesIsEnabled };
        self.DoInstructionSelection();
    }
    while true {
        {
        if DebugFlag && (isCurrentDebugType("isel", 0) || (isCurrentDebugType("isel-dump", 0) && self.MatchFilterFuncName)) {
            dbgs() << "\nSelected selection DAG: " << printMBBReference(*operator(self.FuncInfo).MBB) << " '" << BlockName << "'\n";
            self.CurDAG.dump(DumpSortedDAG);
        }
    }
        if !(false) { break; }
    }
    if ViewSchedDAGs && MatchFilterBB {
        self.CurDAG.viewGraph("scheduler input for " + BlockName);
    }
    let mut Scheduler: *mut ScheduleDAGSDNodes = self.CreateScheduler();
    {
        let mut T: NamedRegionTimer = NamedRegionTimer { "sched", "Instruction Scheduling", GroupName, GroupDescription, TimePassesIsEnabled };
        Scheduler.Run(self.CurDAG, operator(self.FuncInfo).MBB);
    }
    if ViewSUnitDAGs && MatchFilterBB {
        Scheduler.viewGraph();
    }
    let mut FirstMBB: *mut MachineBasicBlock = operator(self.FuncInfo).MBB;
    let mut LastMBB: *mut MachineBasicBlock = null;
    {
        let mut T: NamedRegionTimer = NamedRegionTimer { "emit", "Instruction Creation", GroupName, GroupDescription, TimePassesIsEnabled };
        LastMBB = operator(self.FuncInfo).MBB = Scheduler.EmitSchedule(operator(self.FuncInfo).InsertPt);
    }
    if FirstMBB != LastMBB {
        operator(self.SDB).UpdateSplitBlock(FirstMBB, LastMBB);
    }
    {
        let mut T: NamedRegionTimer = NamedRegionTimer { "cleanup", "Instruction Scheduling Cleanup", GroupName, GroupDescription, TimePassesIsEnabled };
        Scheduler;
    }
    self.CurDAG.clear();
}

struct ISelUpdater {
    ISelPosition: *mut allnodes_iterator,
}

fn ISelUpdater::NodeDeleted(self, N: *mut SDNode, E: *mut SDNode) {
    if self.ISelPosition == N {
        operator(self.ISelPosition);
    }
}

fn ISelUpdater::NodeInserted(self, N: *mut SDNode) {
    let mut CurNode: *mut SDNode = &mut operator(self.ISelPosition);
    if self.DAG.getPCSections(CurNode) {
        MD;
    } else {
        self.DAG.addPCSections(N, MD);
    }
    if self.DAG.getMMRAMetadata(CurNode) {
        MMRA;
    } else {
        self.DAG.addMMRAMetadata(N, MMRA);
    }
}

fn SelectionDAGISel::EnforceNodeIdInvariant(self, Node: *mut SDNode) {
    let mut Nodes: SmallVector<SDNode *, 4> = SmallVector<SDNode *, 4> {};
    Nodes.push(Node);
    while !Nodes.is_empty() {
        let mut N: *mut SDNode = Nodes.pop_back_val();
        for U in N.users() {
            let mut UId: i32 = U.getNodeId();
            if UId > 0 {
                InvalidateNodeId(U);
                Nodes.push(U);
            }
        }
    }
}

fn SelectionDAGISel::InvalidateNodeId(self, N: *mut SDNode) {
    let mut InvalidId: i32 = -(N.getNodeId() + 1);
    N.setNodeId(InvalidId);
}

fn SelectionDAGISel::getUninvalidatedNodeId(self, N: *mut SDNode) -> i32 {
    let mut Id: i32 = N.getNodeId();
    if Id < -1 {
        return -(Id + 1);
    }
    return Id;
}

fn SelectionDAGISel::DoInstructionSelection(self) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("isel", 1) {
            dbgs() << "===== Instruction selection begins: " << printMBBReference(*operator(self.FuncInfo).MBB) << " '" << operator(self.FuncInfo).MBB.getName() << "'\n";
        }
    }
        if !(false) { break; }
    }
    self.PreprocessISelDAG();
    {
        self.DAGSize = self.CurDAG.AssignTopologicalOrder();
        let mut Dummy: HandleSDNode = self.CurDAG.getRoot();
        let mut ISelPosition: allnodes_iterator = self.CurDAG.getRoot().getNode();
        operator(ISelPosition);
        let mut ISU: ISelUpdater = ISelUpdater { *self.CurDAG, ISelPosition };
        while ISelPosition != self.CurDAG.allnodes_begin() {
            let mut Node: *mut SDNode = &mut operator(operator(ISelPosition));
            if Node.use_empty() {
                continue;
            }
            let mut Nodes: SmallVector<SDNode *, 4> = SmallVector<SDNode *, 4> {};
            Nodes.push(Node);
            while !Nodes.is_empty() {
                let mut N: *mut SDNode = Nodes.pop_back_val();
                if N.getOpcode() == TokenFactor || N.getNodeId() < 0 {
                    continue;
                }
                for Op in N.op_values() {
                    if operator(Op).getOpcode() == TokenFactor {
                        Nodes.push(Op.getNode());
                    } else {
                        assert!(operator(Op).getNodeId() != -1, "Node has already selected predecessor node");
                    }
                }
            }
            if !self.TLI.isStrictFPEnabled() && Node.isStrictFPOpcode() {
                let mut ActionVT: EVT = EVT {};
                match Node.getOpcode() {
                    STRICT_SINT_TO_FP => {
                        STRICT_UINT_TO_FP;
                    },
                    _ => {
                        ActionVT = Node.getValueType(0);
                    },
                }
                if self.TLI.getOperationAction(Node.getOpcode(), ActionVT) == Expand {
                    Node = self.CurDAG.mutateStrictFPToFP(Node);
                }
            }
            while true {
                {
                if DebugFlag && isCurrentDebugType("isel", 1) {
                    dbgs() << "\nISEL: Starting selection on root node: ";
                    Node.dump(self.CurDAG);
                }
            }
                if !(false) { break; }
            }
            self.Select(Node);
        }
        self.CurDAG.setRoot(Dummy.getValue());
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("isel", 1) {
            dbgs() << "\n===== Instruction selection ends:\n";
        }
    }
        if !(false) { break; }
    }
    self.PostprocessISelDAG();
}

fn hasExceptionPointerOrCodeUser(CPI: *CatchPadInst) -> bool {
    for U in CPI.users() {
        if dyn_cast(U) {
            EHPtrCall;
        } else {
            let mut IID: ID = EHPtrCall.getIntrinsicID();
            if IID == eh_exceptionpointer || IID == eh_exceptioncode {
                return true;
            }
        }
    }
    return false;
}

fn mapWasmLandingPadIndex(MBB: *mut MachineBasicBlock, CPI: *CatchPadInst) {
    let mut MF: *mut MachineFunction = MBB.getParent();
    let mut IsSingleCatchAllClause: bool = CPI.arg_size() == 1 && cast(CPI.getArgOperand(0)).isNullValue();
    let mut IsCatchLongjmp: bool = CPI.arg_size() == 0;
    if !IsSingleCatchAllClause && !IsCatchLongjmp {
        let mut IntrFound: bool = false;
        for U in CPI.users() {
            if dyn_cast(U) {
                Call;
            } else {
                let mut IID: ID = Call.getIntrinsicID();
                if IID == wasm_landingpad_index {
                    let mut IndexArg: *mut Value = Call.getArgOperand(1);
                    let mut Index: i32 = cast(IndexArg).getZExtValue();
                    MF.setWasmLandingPadIndex(MBB, Index);
                    IntrFound = true;
                    break;
                }
            }
        }
        assert!(IntrFound, "wasm.landingpad.index intrinsic not found!");
        IntrFound as void;
    }
}

fn SelectionDAGISel::PrepareEHLandingPad(self) -> bool {
    let mut MBB: *mut MachineBasicBlock = operator(self.FuncInfo).MBB;
    let mut PersonalityFn: *Constant = operator(self.FuncInfo).Fn.getPersonalityFn();
    let mut LLVMBB: *BasicBlock = MBB.getBasicBlock();
    let mut PtrRC: *TargetRegisterClass = self.TLI.getRegClassFor(self.TLI.getPointerTy(self.CurDAG.getDataLayout(), 0), false);
    let mut Pers: EHPersonality = classifyEHPersonality(PersonalityFn);
    if isFuncletEHPersonality(Pers) {
        if dyn_cast(LLVMBB.getFirstNonPHIIt()) {
            CPI;
        } else {
            if hasExceptionPointerOrCodeUser(CPI) {
                let mut EHPhysReg: MCRegister = self.TLI.getExceptionPointerRegister(operator(self.FuncInfo).ExceptionModel, PersonalityFn).operator MCRegister();
                assert!(EHPhysReg.operator unsigned int(), "target lacks exception pointer register");
                MBB.addLiveIn(EHPhysReg, getAll());
                let mut VReg: Register = operator(self.FuncInfo).getCatchPadExceptionPointerVReg(CPI, PtrRC);
                BuildMI(*MBB, operator(self.FuncInfo).InsertPt, MIMetadata { DL: operator(self.SDB).getCurDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(COPY), VReg).addReg(EHPhysReg, Kill, 0);
            }
        }
        return true;
    }
    let mut Label: *mut MCSymbol = self.MF.addLandingPad(MBB);
    let mut II: *MCInstrDesc = self.TII.get(EH_LABEL);
    BuildMI(*MBB, operator(self.FuncInfo).InsertPt, MIMetadata { DL: operator(self.SDB).getCurDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, II).addSym(Label, 0);
    let mut TRI: *TargetRegisterInfo = *self.MF.getSubtarget().getRegisterInfo();
    if TRI.getCustomEHPadPreservedMask(*self.MF) {
        RegMask;
    } else {
        self.MF.getRegInfo().addPhysRegsUsedFromRegMask(RegMask);
    }
    if Pers == Wasm_CXX || Pers == Wasm_D {
        if dyn_cast(LLVMBB.getFirstNonPHIIt()) {
            CPI;
        } else {
            mapWasmLandingPadIndex(MBB, CPI);
        }
    } else {
        self.MF.setCallSiteLandingPad(Label, operator(self.SDB).LPadToCallSiteMap[MBB]);
        if self.TLI.getExceptionPointerRegister(operator(self.FuncInfo).ExceptionModel, PersonalityFn).operator MCRegister() {
            Reg.operator unsigned int();
        } else {
            operator(self.FuncInfo).ExceptionPointerVirtReg = MBB.addLiveIn(Reg, PtrRC);
        }
        if self.TLI.getExceptionSelectorRegister(operator(self.FuncInfo).ExceptionModel, PersonalityFn).operator MCRegister() {
            Reg.operator unsigned int();
        } else {
            operator(self.FuncInfo).ExceptionSelectorVirtReg = MBB.addLiveIn(Reg, PtrRC);
        }
    }
    return true;
}

fn SelectionDAGISel::reportIPToStateForBlocks(self, MF: *mut MachineFunction) {
    let mut EHInfo: *mut WinEHFuncInfo = MF.getWinEHFuncInfo();
    if !EHInfo {
        return;
    }
    for MBB in *MF {
        let mut BB: *BasicBlock = MBB.getBasicBlock();
        let mut State: i32 = EHInfo.BlockToStateMap[BB];
        if BB.getFirstMayFaultInst() {
            let mut MBBb: iterator = MBB.getFirstNonPHI();
            if MBBb == MBB.end() {
                continue;
            }
            let mut MIb: *mut MachineInstr = &mut operator(MBBb);
            if MIb.isTerminator(AnyInBundle) {
                continue;
            }
            let mut BeginLabel: *mut MCSymbol = MF.getContext().createTempSymbol();
            let mut EndLabel: *mut MCSymbol = MF.getContext().createTempSymbol();
            EHInfo.addIPToStateRange(State, BeginLabel, EndLabel);
            BuildMI(MBB, MBBb, MIMetadata { DL: operator(self.SDB).getCurDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(EH_LABEL)).addSym(BeginLabel, 0);
            let mut MBBe: instr_iterator = MBB.instr_end();
            let mut MIe: *mut MachineInstr = &mut operator((operator(MBBe)));
            while MIe.isTerminator(AnyInBundle) {
                MIe = &mut operator((operator(MBBe)));
            }
            operator(MBBe);
            BuildMI(MBB, MBBe, MIMetadata { DL: operator(self.SDB).getCurDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(EH_LABEL)).addSym(EndLabel, 0);
        }
    }
}

fn isFoldedOrDeadInstruction(I: *Instruction, FuncInfo: *FunctionLoweringInfo) -> bool {
    return !I.mayWriteToMemory() && !I.isTerminator() && !I.isEHPad() && !FuncInfo.isExportedInst(I);
}

fn processIfEntryValueDbgDeclare(FuncInfo: *mut FunctionLoweringInfo, Arg: *Value, Expr: *mut DIExpression, Var: *mut DILocalVariable, DbgLoc: DebugLoc) -> bool {
    if !Expr.isEntryValue() || !isa(Arg) {
        return false;
    }
    let mut ArgIt: iterator = FuncInfo.ValueMap.find(Arg);
    if ArgIt == FuncInfo.ValueMap.end() {
        return false;
    }
    let mut ArgVReg: Register = operator(ArgIt).getSecond();
    for x in FuncInfo.RegInfo.liveins() {
        if VirtReg == ArgVReg {
            Expr = append(Expr, DW_OP_deref);
            FuncInfo.MF.setVariableDbgInfo(Var, Expr, PhysReg, DbgLoc.operator llvm::DILocation *());
            while true {
                {
                if DebugFlag && isCurrentDebugType("isel", 1) {
                    dbgs() << "processDbgDeclare: setVariableDbgInfo Var=" << *Var << ", Expr=" << *Expr << ",  MCRegister=" << PhysReg.operator unsigned int() << ", DbgLoc=" << DbgLoc.operator llvm::DILocation *() << "\n";
                }
            }
                if !(false) { break; }
            }
            return true;
        }
    }
    return false;
}

fn processDbgDeclare(FuncInfo: *mut FunctionLoweringInfo, Address: *Value, Expr: *mut DIExpression, Var: *mut DILocalVariable, DbgLoc: DebugLoc) -> bool {
    if !Address {
        while true {
            {
            if DebugFlag && isCurrentDebugType("isel", 1) {
                dbgs() << "processDbgDeclares skipping " << *Var << " (bad address)\n";
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    if processIfEntryValueDbgDeclare(FuncInfo, Address, Expr, Var, DbgLoc) {
        return true;
    }
    if !Address.getType().isPointerTy() {
        return false;
    }
    let mut MF: *mut MachineFunction = FuncInfo.MF;
    let mut DL: *DataLayout = MF.getDataLayout();
    assert!(Var, "Missing variable");
    assert!(DbgLoc, "Missing location");
    let mut Offset: APInt = APInt { DL.getIndexTypeSizeInBits(Address.getType()), 0, false, false };
    Address = Address.stripAndAccumulateInBoundsConstantOffsets(DL, Offset);
    let mut FI: i32 = max();
    if dyn_cast(Address) {
        AI;
    } else {
        let mut SI: iterator = FuncInfo.StaticAllocaMap.find(AI);
        if SI != FuncInfo.StaticAllocaMap.end() {
            FI = operator(SI).second;
        }
    }
    if FI == max() {
        return false;
    }
    if Offset.getBoolValue() {
        Expr = prepend(Expr, ApplyOffset, Offset.getZExtValue());
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("isel", 1) {
            dbgs() << "processDbgDeclare: setVariableDbgInfo Var=" << *Var << ", Expr=" << *Expr << ",  FI=" << FI << ", DbgLoc=" << DbgLoc.operator llvm::DILocation *() << "\n";
        }
    }
        if !(false) { break; }
    }
    MF.setVariableDbgInfo(Var, Expr, FI, DbgLoc.operator llvm::DILocation *());
    return true;
}

fn processDbgDeclares(FuncInfo: *mut FunctionLoweringInfo) {
    for I in instructions(*FuncInfo.Fn) {
        for DVR in filterDbgVars(I.getDbgRecordRange()) {
            if DVR.Type == Declare && processDbgDeclare(FuncInfo, DVR.getVariableLocationOp(0), DVR.getExpression(), DVR.getVariable(), DVR.getDebugLoc()) {
                FuncInfo.PreprocessedDVRDeclares.insert(&mut DVR);
            }
        }
    }
}

fn processSingleLocVars(FuncInfo: *mut FunctionLoweringInfo, FnVarLocs: *FunctionVarLocs) {
    for let mut It: *VarLocInfo = FnVarLocs.single_locs_begin();
let mut End: *VarLocInfo = FnVarLocs.single_locs_end(); It != End; It += 1 {
        assert!(!It.Values.hasArgList(), "Single loc variadic ops not supported");
        processDbgDeclare(FuncInfo, It.Values.getVariableLocationOp(0), It.Expr, FnVarLocs.getDILocalVariable(It.VariableID), It.DL);
    }
}

fn SelectionDAGISel::SelectAllBasicBlocks(self, Fn: *Function) {
    self.FastISelFailed = false;
    let mut FastIS: *mut FastISel = null;
    if self.TM.Options.EnableFastISel {
        while true {
            {
            if DebugFlag && isCurrentDebugType("isel", 1) {
                dbgs() << "Enabling fast-isel\n";
            }
        }
            if !(false) { break; }
        }
        FastIS = self.TLI.createFastISel(operator(self.FuncInfo), self.LibInfo, self.LibcallLowering);
    }
    let mut RPOT: ReversePostOrderTraversal<const Function *> = &mut Fn;
    assert!(operator(RPOT.begin()) == &mut Fn.getEntryBlock();
    operator(NumEntryBlocks);
    operator(self.FuncInfo).MBB = operator(self.FuncInfo).getMBB(&mut Fn.getEntryBlock());
    operator(self.FuncInfo).InsertPt = operator(self.FuncInfo).MBB.begin();
    self.CurDAG.setFunctionLoweringInfo(self.FuncInfo.get());
    if !FastIS {
        self.LowerArguments(Fn);
    } else {
        FastIS.startNewBlock();
        if !FastIS.lowerArguments() {
            self.FastISelFailed = true;
            operator(NumFastIselFailLowerArguments);
            let mut R: OptimizationRemarkMissed = OptimizationRemarkMissed { "sdagisel", "FastISelFailure", Fn.getSubprogram(), &mut Fn.getEntryBlock() };
            R << "FastISel didn't lower all arguments: " << NV { "Prototype", Fn.getFunctionType() };
            reportFastISelFailure(*self.MF, operator(self.ORE), R, EnableFastISelAbort.operator int() > 1);
            self.LowerArguments(Fn);
            self.CurDAG.setRoot(operator(self.SDB).getControlRoot());
            operator(self.SDB).clear();
            self.CodeGenAndEmitDAG();
        }
        if operator(self.FuncInfo).InsertPt != operator(self.FuncInfo).MBB.begin() {
            FastIS.setLastLocalValue(&mut operator(prev(operator(self.FuncInfo).InsertPt, 1)));
        } else {
            FastIS.setLastLocalValue(null);
        }
    }
    let mut Inserted: bool = operator(self.SwiftError).createEntriesInEntryBlock(operator(self.SDB).getCurDebugLoc());
    if FastIS && Inserted {
        FastIS.setLastLocalValue(&mut operator(prev(operator(self.FuncInfo).InsertPt, 1)));
    }
    if isAssignmentTrackingEnabled(*Fn.getParent()) {
        assert!(self.CurDAG.getFunctionVarLocs(), "expected AssignmentTrackingAnalysis pass results");
        processSingleLocVars(operator(self.FuncInfo), self.CurDAG.getFunctionVarLocs());
    } else {
        processDbgDeclares(operator(self.FuncInfo));
    }
    operator(self.FuncInfo).VisitedBBs.assign(Fn.getMaxBlockNumber(), false);
    for LLVMBB in RPOT {
        if self.OptLevel != None {
            let mut AllPredsVisited: bool = true;
            for Pred in predecessors(LLVMBB) {
                if !operator(self.FuncInfo).VisitedBBs[Pred.getNumber()] {
                    AllPredsVisited = false;
                    break;
                }
            }
            if AllPredsVisited {
                for PN in LLVMBB.phis() {
                    operator(self.FuncInfo).ComputePHILiveOutRegInfo(&mut PN);
                }
            } else {
                for PN in LLVMBB.phis() {
                    operator(self.FuncInfo).InvalidatePHILiveOutRegInfo(&mut PN);
                }
            }
            operator(self.FuncInfo).VisitedBBs[LLVMBB.getNumber()] = true;
        }
        {
            let mut BBStart: iterator = LLVMBB.getFirstNonPHIIt();
            let mut BBEnd: iterator = LLVMBB.end();
            preserveFakeUses(BBStart, BBEnd);
        }
        let mut Begin: const_iterator = LLVMBB.getFirstNonPHIIt();
        let mut End: const_iterator = LLVMBB.end();
        let mut BI: const_iterator = End;
        operator(self.FuncInfo).MBB = operator(self.FuncInfo).getMBB(LLVMBB);
        if !operator(self.FuncInfo).MBB {
            continue;
        }
        operator(self.FuncInfo).InsertPt = operator(self.FuncInfo).MBB.end();
        operator(self.FuncInfo).ExceptionPointerVirtReg = Register { Reg: 0 };
        operator(self.FuncInfo).ExceptionSelectorVirtReg = Register { Reg: 0 };
        if LLVMBB.isEHPad() {
            if !self.PrepareEHLandingPad() {
                continue;
            }
            if !FastIS {
                let mut NewRoot: SDValue = self.TLI.lowerEHPadEntry(self.CurDAG.getRoot(), operator(self.SDB).getCurSDLoc(), *self.CurDAG);
                if NewRoot && NewRoot != self.CurDAG.getRoot() {
                    self.CurDAG.setRoot(NewRoot);
                }
            }
        }
        if FastIS {
            if LLVMBB != &mut Fn.getEntryBlock() {
                FastIS.startNewBlock();
            }
            let mut NumFastIselRemaining: u32 = distance(Begin, End);
            operator(self.SwiftError).preassignVRegs(operator(self.FuncInfo).MBB, Begin, End);
            for ; BI != Begin; operator(BI) {
                let mut Inst: *Instruction = &mut operator(prev(BI, 1));
                if isFoldedOrDeadInstruction(Inst, operator(self.FuncInfo)) || self.ElidedArgCopyInstrs.count(Inst) {
                    NumFastIselRemaining -= 1;
                    FastIS.handleDbgInfo(Inst);
                    continue;
                }
                FastIS.recomputeInsertPt();
                if FastIS.selectInstruction(Inst) {
                    NumFastIselRemaining -= 1;
                    operator(NumFastIselSuccess);
                    FastIS.handleDbgInfo(Inst);
                    let mut BeforeInst: *Instruction = Inst;
                    while BeforeInst != &mut operator(Begin) {
                        BeforeInst = &mut operator(prev(BeforeInst, 1));
                        if !isFoldedOrDeadInstruction(BeforeInst, operator(self.FuncInfo)) {
                            break;
                        }
                    }
                    if BeforeInst != Inst && isa(BeforeInst) && BeforeInst.hasOneUse() && FastIS.tryToFoldLoad(cast(BeforeInst), Inst) {
                        while true {
                            {
                            if DebugFlag && isCurrentDebugType("isel", 1) {
                                dbgs() << "FastISel folded load: " << *BeforeInst << "\n";
                            }
                        }
                            if !(false) { break; }
                        }
                        FastIS.handleDbgInfo(BeforeInst);
                        BI = next(BeforeInst, 1);
                        NumFastIselRemaining -= 1;
                        operator(NumFastIselSuccess);
                    }
                    continue;
                }
                self.FastISelFailed = true;
                if isa(Inst) && !isa(Inst) && !isa(Inst) && !isa(Inst) {
                    let mut R: OptimizationRemarkMissed = OptimizationRemarkMissed { "sdagisel", "FastISelFailure", Inst.getDebugLoc(), LLVMBB };
                    R << "FastISel missed call";
                    if R.isEnabled() || EnableFastISelAbort.operator int() {
                        let mut InstStrStorage: str = "";
                        let mut InstStr: raw_string_ostream = InstStrStorage;
                        InstStr << *Inst;
                        R << ": " << InstStrStorage;
                    }
                    reportFastISelFailure(*self.MF, operator(self.ORE), R, EnableFastISelAbort.operator int() > 2);
                    if cast(Inst).hasOperandBundles() {
                        operator(NumFastIselFailures, NumFastIselRemaining);
                        break;
                    }
                    if !Inst.getType().isVoidTy() && !Inst.getType().isTokenTy() && !Inst.use_empty() {
                        let mut R: *mut Register = operator(self.FuncInfo).ValueMap[Inst];
                        if !R.operator unsigned int() {
                            R = operator(self.FuncInfo).CreateRegs(Inst);
                        }
                    }
                    let mut HadTailCall: bool = false;
                    let mut SavedInsertPt: iterator = operator(self.FuncInfo).InsertPt;
                    self.SelectBasicBlock(Inst.getIterator(), BI, HadTailCall);
                    if HadTailCall {
                        FastIS.removeDeadCode(SavedInsertPt, operator(self.FuncInfo).MBB.end());
                        operator(BI);
                        break;
                    }
                    let mut RemainingNow: u32 = distance(Begin, BI);
                    operator(NumFastIselFailures, NumFastIselRemaining - RemainingNow);
                    NumFastIselRemaining = RemainingNow;
                    continue;
                }
                let mut R: OptimizationRemarkMissed = OptimizationRemarkMissed { "sdagisel", "FastISelFailure", Inst.getDebugLoc(), LLVMBB };
                let mut ShouldAbort: bool = EnableFastISelAbort.operator int();
                if Inst.isTerminator() {
                    R << "FastISel missed terminator";
                    ShouldAbort = (EnableFastISelAbort.operator int() > 2);
                } else {
                    R << "FastISel missed";
                }
                if R.isEnabled() || EnableFastISelAbort.operator int() {
                    let mut InstStrStorage: str = "";
                    let mut InstStr: raw_string_ostream = InstStrStorage;
                    InstStr << *Inst;
                    R << ": " << InstStrStorage;
                }
                reportFastISelFailure(*self.MF, operator(self.ORE), R, ShouldAbort);
                operator(NumFastIselFailures, NumFastIselRemaining);
                break;
            }
            FastIS.recomputeInsertPt();
        }
        if self.SP.shouldEmitSDCheck(*LLVMBB) {
            let mut FunctionBasedInstrumentation: bool = self.TLI.getSSPStackGuardCheck(*Fn.getParent(), *self.LibcallLowering) && Fn.hasMinSize();
            operator(self.SDB).SPDescriptor.initialize(LLVMBB, operator(self.FuncInfo).getMBB(LLVMBB), FunctionBasedInstrumentation);
        }
        if Begin != BI {
            operator(NumDAGBlocks);
        } else {
            operator(NumFastIselBlocks);
        }
        if Begin != BI {
            let mut HadTailCall: bool = false;
            self.SelectBasicBlock(Begin, BI, HadTailCall);
            if FastIS && HadTailCall && operator(self.FuncInfo).InsertPt != operator(self.FuncInfo).MBB.end() {
                FastIS.removeDeadCode(operator(self.FuncInfo).InsertPt, operator(self.FuncInfo).MBB.end());
            }
        }
        if FastIS {
            FastIS.finishBasicBlock();
        }
        self.FinishBasicBlock();
        operator(self.FuncInfo).PHINodesToUpdate.clear();
        self.ElidedArgCopyInstrs.clear();
    }
    if Fn.getParent().getModuleFlag("eh-asynch") {
        self.reportIPToStateForBlocks(self.MF);
    }
    self.SP.copyToMachineFrameInfo(self.MF.getFrameInfo());
    operator(self.SwiftError).propagateVRegs();
    FastIS;
    operator(self.SDB).clearDanglingDebugInfo();
    operator(self.SDB).SPDescriptor.resetPerFunctionState();
}

fn SelectionDAGISel::FinishBasicBlock(self) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("isel", 1) {
            dbgs() << "Total amount of phi nodes to update: " << operator(self.FuncInfo).PHINodesToUpdate.len << "\n";
            for let mut i: u32 = 0;
let mut e: u32 = operator(self.FuncInfo).PHINodesToUpdate.len; i != e; i += 1 {
                dbgs() << "Node " << i << " : (" << operator(self.FuncInfo).PHINodesToUpdate[i].first << ", " << printReg(operator(self.FuncInfo).PHINodesToUpdate[i].second, null, 0, null) << ")\n";
            }
        }
    }
        if !(false) { break; }
    }
    for let mut i: u32 = 0;
let mut e: u32 = operator(self.FuncInfo).PHINodesToUpdate.len; i != e; i += 1 {
        let mut PHI: MachineInstrBuilder = MachineInstrBuilder { MF: *self.MF, MI: operator(self.FuncInfo).PHINodesToUpdate[i].first };
        assert!(operator(PHI).isPHI(), "This is not a machine PHI node that we are updating!");
        if !operator(self.FuncInfo).MBB.isSuccessor(operator(PHI).getParent()) {
            continue;
        }
        PHI.addReg(operator(self.FuncInfo).PHINodesToUpdate[i].second, RegState {}, 0).addMBB(operator(self.FuncInfo).MBB, 0);
    }
    if operator(self.SDB).SPDescriptor.shouldEmitFunctionBasedCheckStackProtector() {
        let mut ParentMBB: *mut MachineBasicBlock = operator(self.SDB).SPDescriptor.getParentMBB();
        operator(self.FuncInfo).MBB = ParentMBB;
        operator(self.FuncInfo).InsertPt = findSplitPointForStackProtector(ParentMBB, *self.TII);
        operator(self.SDB).visitSPDescriptorParent(operator(self.SDB).SPDescriptor, ParentMBB);
        self.CurDAG.setRoot(operator(self.SDB).getRoot());
        operator(self.SDB).clear();
        self.CodeGenAndEmitDAG();
        operator(self.SDB).SPDescriptor.resetPerBBState();
    } else if operator(self.SDB).SPDescriptor.shouldEmitStackProtector() {
        let mut ParentMBB: *mut MachineBasicBlock = operator(self.SDB).SPDescriptor.getParentMBB();
        let mut SuccessMBB: *mut MachineBasicBlock = operator(self.SDB).SPDescriptor.getSuccessMBB();
        let mut SplitPoint: iterator = findSplitPointForStackProtector(ParentMBB, *self.TII);
        SuccessMBB.splice(SuccessMBB.end(), ParentMBB, SplitPoint, ParentMBB.end());
        operator(self.FuncInfo).MBB = ParentMBB;
        operator(self.FuncInfo).InsertPt = ParentMBB.end();
        operator(self.SDB).visitSPDescriptorParent(operator(self.SDB).SPDescriptor, ParentMBB);
        self.CurDAG.setRoot(operator(self.SDB).getRoot());
        operator(self.SDB).clear();
        self.CodeGenAndEmitDAG();
        let mut FailureMBB: *mut MachineBasicBlock = operator(self.SDB).SPDescriptor.getFailureMBB();
        if FailureMBB.is_empty() {
            operator(self.FuncInfo).MBB = FailureMBB;
            operator(self.FuncInfo).InsertPt = FailureMBB.end();
            operator(self.SDB).visitSPDescriptorFailure(operator(self.SDB).SPDescriptor);
            self.CurDAG.setRoot(operator(self.SDB).getRoot());
            operator(self.SDB).clear();
            self.CodeGenAndEmitDAG();
        }
        operator(self.SDB).SPDescriptor.resetPerBBState();
    }
    for BTB in operator(operator(self.SDB).SL).BitTestCases {
        if !BTB.Emitted {
            operator(self.FuncInfo).MBB = BTB.Parent;
            operator(self.FuncInfo).InsertPt = operator(self.FuncInfo).MBB.end();
            operator(self.SDB).visitBitTestHeader(BTB, operator(self.FuncInfo).MBB);
            self.CurDAG.setRoot(operator(self.SDB).getRoot());
            operator(self.SDB).clear();
            self.CodeGenAndEmitDAG();
        }
        let mut UnhandledProb: BranchProbability = BTB.Prob;
        for let mut j: u32 = 0;
let mut ej: u32 = BTB.Cases.len; j != ej; j += 1 {
            operator(UnhandledProb, BTB.Cases[j].ExtraProb);
            operator(self.FuncInfo).MBB = BTB.Cases[j].ThisBB;
            operator(self.FuncInfo).InsertPt = operator(self.FuncInfo).MBB.end();
            let mut NextMBB: *mut MachineBasicBlock = null;
            if (BTB.ContiguousRange || BTB.FallthroughUnreachable) && j + 2 == ej {
                NextMBB = BTB.Cases[j + 1].TargetBB;
            } else if j + 1 == ej {
                NextMBB = BTB.Default;
            } else {
                NextMBB = BTB.Cases[j + 1].ThisBB;
            }
            operator(self.SDB).visitBitTestCase(BTB, NextMBB, UnhandledProb, BTB.Reg, BTB.Cases[j], operator(self.FuncInfo).MBB);
            self.CurDAG.setRoot(operator(self.SDB).getRoot());
            operator(self.SDB).clear();
            self.CodeGenAndEmitDAG();
            if (BTB.ContiguousRange || BTB.FallthroughUnreachable) && j + 2 == ej {
                BTB.Cases.pop();
                break;
            }
        }
        for P in operator(self.FuncInfo).PHINodesToUpdate {
            let mut PHI: MachineInstrBuilder = MachineInstrBuilder { MF: *self.MF, MI: P.first };
            let mut PHIBB: *mut MachineBasicBlock = operator(PHI).getParent();
            assert!(operator(PHI).isPHI(), "This is not a machine PHI node that we are updating!");
            if PHIBB == BTB.Default {
                PHI.addReg(P.second, RegState {}, 0).addMBB(BTB.Parent, 0);
                if !BTB.ContiguousRange {
                    PHI.addReg(P.second, RegState {}, 0).addMBB(BTB.Cases.back().ThisBB, 0);
                }
            }
            for BT in BTB.Cases {
                let mut cBB: *mut MachineBasicBlock = BT.ThisBB;
                if cBB.isSuccessor(PHIBB) {
                    PHI.addReg(P.second, RegState {}, 0).addMBB(cBB, 0);
                }
            }
        }
    }
    operator(operator(self.SDB).SL).BitTestCases.clear();
    for let mut i: u32 = 0;
let mut e: u32 = operator(operator(self.SDB).SL).JTCases.len; i != e; i += 1 {
        if !operator(operator(self.SDB).SL).JTCases[i].first.Emitted {
            operator(self.FuncInfo).MBB = operator(operator(self.SDB).SL).JTCases[i].first.HeaderBB;
            operator(self.FuncInfo).InsertPt = operator(self.FuncInfo).MBB.end();
            operator(self.SDB).visitJumpTableHeader(operator(operator(self.SDB).SL).JTCases[i].second, operator(operator(self.SDB).SL).JTCases[i].first, operator(self.FuncInfo).MBB);
            self.CurDAG.setRoot(operator(self.SDB).getRoot());
            operator(self.SDB).clear();
            self.CodeGenAndEmitDAG();
        }
        operator(self.FuncInfo).MBB = operator(operator(self.SDB).SL).JTCases[i].second.MBB;
        operator(self.FuncInfo).InsertPt = operator(self.FuncInfo).MBB.end();
        operator(self.SDB).visitJumpTable(operator(operator(self.SDB).SL).JTCases[i].second);
        self.CurDAG.setRoot(operator(self.SDB).getRoot());
        operator(self.SDB).clear();
        self.CodeGenAndEmitDAG();
        for let mut pi: u32 = 0;
let mut pe: u32 = operator(self.FuncInfo).PHINodesToUpdate.len; pi != pe; pi += 1 {
            let mut PHI: MachineInstrBuilder = MachineInstrBuilder { MF: *self.MF, MI: operator(self.FuncInfo).PHINodesToUpdate[pi].first };
            let mut PHIBB: *mut MachineBasicBlock = operator(PHI).getParent();
            assert!(operator(PHI).isPHI(), "This is not a machine PHI node that we are updating!");
            if PHIBB == operator(operator(self.SDB).SL).JTCases[i].second.Default {
                PHI.addReg(operator(self.FuncInfo).PHINodesToUpdate[pi].second, RegState {}, 0).addMBB(operator(operator(self.SDB).SL).JTCases[i].first.HeaderBB, 0);
            }
            if operator(self.FuncInfo).MBB.isSuccessor(PHIBB) {
                PHI.addReg(operator(self.FuncInfo).PHINodesToUpdate[pi].second, RegState {}, 0).addMBB(operator(self.FuncInfo).MBB, 0);
            }
        }
    }
    operator(operator(self.SDB).SL).JTCases.clear();
    for let mut i: u32 = 0;
let mut e: u32 = operator(operator(self.SDB).SL).SwitchCases.len; i != e; i += 1 {
        operator(self.FuncInfo).MBB = operator(operator(self.SDB).SL).SwitchCases[i].ThisBB;
        operator(self.FuncInfo).InsertPt = operator(self.FuncInfo).MBB.end();
        let mut Succs: SmallVector<MachineBasicBlock *, 2> = SmallVector<MachineBasicBlock *, 2> {};
        Succs.push(operator(operator(self.SDB).SL).SwitchCases[i].TrueBB);
        if operator(operator(self.SDB).SL).SwitchCases[i].TrueBB != operator(operator(self.SDB).SL).SwitchCases[i].FalseBB {
            Succs.push(operator(operator(self.SDB).SL).SwitchCases[i].FalseBB);
        }
        operator(self.SDB).visitSwitchCase(operator(operator(self.SDB).SL).SwitchCases[i], operator(self.FuncInfo).MBB);
        self.CurDAG.setRoot(operator(self.SDB).getRoot());
        operator(self.SDB).clear();
        self.CodeGenAndEmitDAG();
        let mut ThisBB: *mut MachineBasicBlock = operator(self.FuncInfo).MBB;
        for Succ in Succs {
            operator(self.FuncInfo).MBB = Succ;
            operator(self.FuncInfo).InsertPt = operator(self.FuncInfo).MBB.end();
            if ThisBB.isSuccessor(operator(self.FuncInfo).MBB) {
                for let mut MBBI: iterator = operator(self.FuncInfo).MBB.begin();
let mut MBBE: iterator = operator(self.FuncInfo).MBB.end(); MBBI != MBBE && operator(MBBI).isPHI(); operator(MBBI) {
                    let mut PHI: MachineInstrBuilder = MachineInstrBuilder { MF: *self.MF, MI: MBBI };
                    for let mut pn: u32 = 0; ; pn += 1 {
                        assert!(pn != operator(self.FuncInfo).PHINodesToUpdate.len, "Didn't find PHI entry!");
                        if operator(self.FuncInfo).PHINodesToUpdate[pn].first == PHI.operator llvm::MachineInstr *() {
                            PHI.addReg(operator(self.FuncInfo).PHINodesToUpdate[pn].second, RegState {}, 0).addMBB(ThisBB, 0);
                            break;
                        }
                    }
                }
            }
        }
    }
    operator(operator(self.SDB).SL).SwitchCases.clear();
}

fn SelectionDAGISel::CreateScheduler(self) -> *mut ScheduleDAGSDNodes {
    return ISHeuristic.operator llvm::ScheduleDAGSDNodes *(*)(llvm::SelectionDAGISel *, llvm::CodeGenOptLevel)()(self, self.OptLevel);
}

fn SelectionDAGISel::CheckAndMask(self: *SelectionDAGISel, LHS: SDValue, RHS: *mut ConstantSDNode, DesiredMaskS: i64) -> bool {
    let mut ActualMask: *APInt = RHS.getAPIntValue();
    let mut DesiredMask: *APInt = APInt { LHS.getValueSizeInBits().operator unsigned long long(), DesiredMaskS, false, true };
    if ActualMask == DesiredMask {
        return true;
    }
    if !ActualMask.isSubsetOf(DesiredMask) {
        return false;
    }
    let mut NeededMask: APInt = DesiredMask & operator(ActualMask);
    if self.CurDAG.MaskedValueIsZero(LHS, NeededMask, 0) {
        return true;
    }
    return false;
}

fn SelectionDAGISel::CheckOrMask(self: *SelectionDAGISel, LHS: SDValue, RHS: *mut ConstantSDNode, DesiredMaskS: i64) -> bool {
    let mut ActualMask: *APInt = RHS.getAPIntValue();
    let mut DesiredMask: *APInt = APInt { LHS.getValueSizeInBits().operator unsigned long long(), DesiredMaskS, false, true };
    if ActualMask == DesiredMask {
        return true;
    }
    if !ActualMask.isSubsetOf(DesiredMask) {
        return false;
    }
    let mut NeededMask: APInt = DesiredMask & operator(ActualMask);
    let mut Known: KnownBits = self.CurDAG.computeKnownBits(LHS, 0);
    if NeededMask.isSubsetOf(Known.One) {
        return true;
    }
    return false;
}

fn SelectionDAGISel::SelectInlineAsmMemoryOperands(self, Ops: *mut []SDValue, DL: *SDLoc) {
    let mut Handles: list<HandleSDNode> = list<HandleSDNode> {};
    Handles.push(Ops[Op_InputChain]);
    Handles.push(Ops[Op_AsmString]);
    Handles.push(Ops[Op_MDNode]);
    Handles.push(Ops[Op_ExtraInfo]);
    let mut i: u32 = Op_FirstOperand;
    let mut e: u32 = Ops.len;
    if Ops[e - 1].getValueType() == Glue {
        e -= 1;
    }
    while i != e {
        let mut Flags: Flag = operator(Ops[i]).getAsZExtVal();
        if !Flags.isMemKind() && !Flags.isFuncKind() {
            Handles.insert(Handles.end(), Ops.begin() + i, Ops.begin() + i + Flags.getNumOperandRegisters() + 1);
            i += Flags.getNumOperandRegisters() + 1;
        } else {
            assert!(Flags.getNumOperandRegisters() == 1, "Memory operand with multiple values?");
            let mut TiedToOperand: u32 = 0;
            if Flags.isUseOperandTiedToDef(TiedToOperand) {
                let mut CurOp: u32 = Op_FirstOperand;
                Flags = operator(Ops[CurOp]).getAsZExtVal();
                for ; TiedToOperand; TiedToOperand -= 1 {
                    CurOp += Flags.getNumOperandRegisters() + 1;
                    Flags = operator(Ops[CurOp]).getAsZExtVal();
                }
            }
            let mut SelOps: []SDValue = []SDValue {};
            let mut ConstraintID: ConstraintCode = Flags.getMemoryConstraintID();
            if self.SelectInlineAsmMemoryOperand(Ops[i + 1], ConstraintID, SelOps) {
                report_fatal_error("Could not match memory address.  Inline asm failure!", true);
            }
            Flags = Flag { if Flags.isMemKind() { Mem } else { Func }, SelOps.len };
            Flags.setMemConstraint(ConstraintID);
            Handles.push(self.CurDAG.getTargetConstant(Flags.operator unsigned int(), DL, i32, false));
            append_range(Handles, SelOps);
            i += 2;
        }
    }
    if e != Ops.len {
        Handles.push(Ops.back());
    }
    Ops.clear();
    for handle in Handles {
        Ops.push(handle.getValue());
    }
}

fn findNonImmUse(Root: *mut SDNode, Def: *mut SDNode, ImmedUse: *mut SDNode, IgnoreChains: bool) -> bool {
    let mut Visited: SmallPtrSet<const SDNode *, 16> = SmallPtrSet<const SDNode *, 16> {};
    let mut WorkList: SmallVector<const SDNode *, 16> = SmallVector<const SDNode *, 16> {};
    if ImmedUse.isOnlyUserOf(Def) {
        return false;
    }
    Visited.insert(ImmedUse);
    for Op in ImmedUse.op_values() {
        let mut N: *mut SDNode = Op.getNode();
        if (Op.getValueType() == Other && IgnoreChains) || N == Def {
            continue;
        }
        if !Visited.insert(N).second {
            continue;
        }
        WorkList.push(N);
    }
    if Root != ImmedUse {
        for Op in Root.op_values() {
            let mut N: *mut SDNode = Op.getNode();
            if (Op.getValueType() == Other && IgnoreChains) || N == Def {
                continue;
            }
            if !Visited.insert(N).second {
                continue;
            }
            WorkList.push(N);
        }
    }
    return hasPredecessorHelper(Def, Visited, WorkList, 0, true);
}

fn SelectionDAGISel::IsProfitableToFold(self: *SelectionDAGISel, N: SDValue, U: *mut SDNode, Root: *mut SDNode) -> bool {
    if self.OptLevel == None {
        return false;
    }
    return N.hasOneUse();
}

fn SelectionDAGISel::IsLegalToFold(self, N: SDValue, U: *mut SDNode, Root: *mut SDNode, OptLevel: CodeGenOptLevel, IgnoreChains: bool) -> bool {
    if OptLevel == None {
        return false;
    }
    let mut VT: EVT = Root.getValueType(Root.getNumValues() - 1);
    while VT == Glue {
        let mut GU: *mut SDNode = Root.getGluedUser();
        if !GU {
            break;
        }
        Root = GU;
        VT = Root.getValueType(Root.getNumValues() - 1);
        IgnoreChains = false;
    }
    return !findNonImmUse(Root, N.getNode(), U, IgnoreChains);
}

fn SelectionDAGISel::Select_INLINEASM(self, N: *mut SDNode) {
    let mut DL: SDLoc = N;
    let mut Ops: []SDValue = []SDValue { N.op_begin(), N.op_end(), SDValue> {} };
    self.SelectInlineAsmMemoryOperands(Ops, DL);
    let mut VTs: [2]EVT = [Other, Glue];
    let mut New: SDValue = self.CurDAG.getNode(N.getOpcode(), DL, VTs, Ops);
    operator(New).setNodeId(-1);
    self.ReplaceUses(N, New.getNode());
    self.CurDAG.RemoveDeadNode(N);
}

fn SelectionDAGISel::Select_READ_REGISTER(self, Op: *mut SDNode) {
    let mut dl: SDLoc = Op;
    let mut MD: *mut MDNodeSDNode = cast(Op.getOperand(1));
    let mut RegStr: *MDString = cast(MD.getMD().getOperand(0));
    let mut VT: EVT = Op.getValueType(0);
    let mut Ty: LLT = if VT.isSimple() { getLLTForMVT(VT.getSimpleVT()) } else { LLT {} };
    let mut MF: *MachineFunction = self.CurDAG.getMachineFunction();
    let mut Reg: Register = self.TLI.getRegisterByName(RegStr.getString().ptr, Ty, MF);
    let mut New: SDValue = SDValue {};
    if !Reg.operator unsigned int() {
        let mut Fn: *Function = MF.getFunction();
        Fn.getContext().diagnose(DiagnosticInfoGenericWithLoc { "invalid register \"" + RegStr.getString().ptr + "\" for llvm.read_register", Fn, Op.getDebugLoc(), DS_Error });
        New = SDValue { Node: self.CurDAG.getMachineNode(IMPLICIT_DEF, dl, VT), ResNo: 0 };
        self.ReplaceUses(SDValue { Node: Op, ResNo: 1 }, Op.getOperand(0));
    } else {
        New = self.CurDAG.getCopyFromReg(Op.getOperand(0), dl, Reg, Op.getValueType(0));
    }
    operator(New).setNodeId(-1);
    self.ReplaceUses(Op, New.getNode());
    self.CurDAG.RemoveDeadNode(Op);
}

fn SelectionDAGISel::Select_WRITE_REGISTER(self, Op: *mut SDNode) {
    let mut dl: SDLoc = Op;
    let mut MD: *mut MDNodeSDNode = cast(Op.getOperand(1));
    let mut RegStr: *MDString = cast(MD.getMD().getOperand(0));
    let mut VT: EVT = Op.getOperand(2).getValueType();
    let mut Ty: LLT = if VT.isSimple() { getLLTForMVT(VT.getSimpleVT()) } else { LLT {} };
    let mut MF: *MachineFunction = self.CurDAG.getMachineFunction();
    let mut Reg: Register = self.TLI.getRegisterByName(RegStr.getString().ptr, Ty, MF);
    if !Reg.operator unsigned int() {
        let mut Fn: *Function = MF.getFunction();
        Fn.getContext().diagnose(DiagnosticInfoGenericWithLoc { "invalid register \"" + RegStr.getString().ptr + "\" for llvm.write_register", Fn, Op.getDebugLoc(), DS_Error });
        self.ReplaceUses(SDValue { Node: Op, ResNo: 0 }, Op.getOperand(0));
    } else {
        let mut New: SDValue = self.CurDAG.getCopyToReg(Op.getOperand(0), dl, Reg, Op.getOperand(2));
        operator(New).setNodeId(-1);
        self.ReplaceUses(Op, New.getNode());
    }
    self.CurDAG.RemoveDeadNode(Op);
}

fn SelectionDAGISel::Select_UNDEF(self, N: *mut SDNode) {
    self.CurDAG.SelectNodeTo(N, IMPLICIT_DEF, N.getValueType(0));
}

fn SelectionDAGISel::Select_FAKE_USE(self, N: *mut SDNode) {
    self.CurDAG.SelectNodeTo(N, FAKE_USE, N.getValueType(0), N.getOperand(1), N.getOperand(0));
}

fn SelectionDAGISel::Select_RELOC_NONE(self, N: *mut SDNode) {
    self.CurDAG.SelectNodeTo(N, RELOC_NONE, N.getValueType(0), N.getOperand(1), N.getOperand(0));
}

fn SelectionDAGISel::Select_FREEZE(self, N: *mut SDNode) {
    self.CurDAG.SelectNodeTo(N, COPY, N.getValueType(0), N.getOperand(0));
}

fn SelectionDAGISel::Select_ARITH_FENCE(self, N: *mut SDNode) {
    self.CurDAG.SelectNodeTo(N, ARITH_FENCE, N.getValueType(0), N.getOperand(0));
}

fn SelectionDAGISel::Select_MEMBARRIER(self, N: *mut SDNode) {
    self.CurDAG.SelectNodeTo(N, MEMBARRIER, N.getValueType(0), N.getOperand(0));
}

fn SelectionDAGISel::Select_CONVERGENCECTRL_ANCHOR(self, N: *mut SDNode) {
    self.CurDAG.SelectNodeTo(N, CONVERGENCECTRL_ANCHOR, N.getValueType(0));
}

fn SelectionDAGISel::Select_CONVERGENCECTRL_ENTRY(self, N: *mut SDNode) {
    self.CurDAG.SelectNodeTo(N, CONVERGENCECTRL_ENTRY, N.getValueType(0));
}

fn SelectionDAGISel::Select_CONVERGENCECTRL_LOOP(self, N: *mut SDNode) {
    self.CurDAG.SelectNodeTo(N, CONVERGENCECTRL_LOOP, N.getValueType(0), N.getOperand(0));
}

fn SelectionDAGISel::pushStackMapLiveVariable(self, Ops: *mut SmallVectorImpl<SDValue>, OpVal: SDValue, DL: SDLoc) {
    let mut OpNode: *mut SDNode = OpVal.getNode();
    assert!(OpNode.getOpcode() != FrameIndex);
    if OpNode.getOpcode() == Constant {
        Ops.push(self.CurDAG.getTargetConstant(ConstantOp, DL, i64, false));
        Ops.push(self.CurDAG.getTargetConstant(OpNode.getAsZExtVal(), DL, OpVal.getValueType(), false));
    } else {
        Ops.push(OpVal);
    }
}

fn SelectionDAGISel::Select_STACKMAP(self, N: *mut SDNode) {
    let mut Ops: SmallVector<SDValue, 32> = SmallVector<SDValue, 32> {};
    let mut It: *mut SDUse = N.op_begin();
    let mut DL: SDLoc = N;
    let mut Chain: SDValue = *It += 1.operator const llvm::SDValue &();
    let mut InGlue: SDValue = *It += 1.operator const llvm::SDValue &();
    let mut ID: SDValue = *It += 1.operator const llvm::SDValue &();
    assert!(ID.getValueType() == i64);
    Ops.push(ID);
    let mut Shad: SDValue = *It += 1.operator const llvm::SDValue &();
    assert!(Shad.getValueType() == i32);
    Ops.push(Shad);
    for ; It != N.op_end(); It += 1 {
        self.pushStackMapLiveVariable(Ops, *It.operator const llvm::SDValue &(), DL);
    }
    Ops.push(Chain);
    Ops.push(InGlue);
    let mut NodeTys: SDVTList = self.CurDAG.getVTList(Other, Glue);
    self.CurDAG.SelectNodeTo(N, STACKMAP, NodeTys, Ops);
}

fn SelectionDAGISel::Select_PATCHPOINT(self, N: *mut SDNode) {
    let mut Ops: SmallVector<SDValue, 32> = SmallVector<SDValue, 32> {};
    let mut It: *mut SDUse = N.op_begin();
    let mut DL: SDLoc = N;
    let mut Chain: SDValue = *It += 1.operator const llvm::SDValue &();
    let mut Glue: optional<SDValue> = optional<SDValue> {};
    if It.getValueType() == Glue {
        Glue = *It += 1;
    }
    let mut RegMask: SDValue = *It += 1.operator const llvm::SDValue &();
    let mut ID: SDValue = *It += 1.operator const llvm::SDValue &();
    assert!(ID.getValueType() == i64);
    Ops.push(ID);
    let mut Shad: SDValue = *It += 1.operator const llvm::SDValue &();
    assert!(Shad.getValueType() == i32);
    Ops.push(Shad);
    Ops.push(*It += 1.operator const llvm::SDValue &());
    let mut NumArgs: SDValue = *It += 1.operator const llvm::SDValue &();
    assert!(NumArgs.getValueType() == i32);
    Ops.push(NumArgs);
    Ops.push(*It += 1.operator const llvm::SDValue &());
    for let mut I: u64 = operator(NumArgs).getAsZExtVal(); I != 0; I -= 1 {
        Ops.push(*It += 1.operator const llvm::SDValue &());
    }
    for ; It != N.op_end(); It += 1 {
        self.pushStackMapLiveVariable(Ops, *It.operator const llvm::SDValue &(), DL);
    }
    Ops.push(RegMask);
    Ops.push(Chain);
    if Glue.has_value() {
        Ops.push(operator(Glue));
    }
    let mut NodeTys: SDVTList = N.getVTList();
    self.CurDAG.SelectNodeTo(N, PATCHPOINT, NodeTys, Ops);
}

fn GetVBR(Val: u64, MatcherTable: *u8, Idx: *mut u64) -> u64 {
    assert!(Val >= 128, "Not a VBR");
    Val &= 127;
    let mut Shift: u32 = 7;
    let mut NextBits: u64 = 0;
    while true {
        {
        NextBits = MatcherTable[Idx += 1];
        Val |= (NextBits & 127) << Shift;
        Shift += 7;
    }
        if !(NextBits & 128) { break; }
    }
    return Val;
}

fn GetSignedVBR(MatcherTable: *u8, Idx: *mut u64) -> i64 {
    let mut Val: i64 = 0;
    let mut Shift: u32 = 0;
    let mut NextBits: u64 = 0;
    while true {
        {
        NextBits = MatcherTable[Idx += 1];
        Val |= (NextBits & 127) << Shift;
        Shift += 7;
    }
        if !(NextBits & 128) { break; }
    }
    if Shift < 64 && (NextBits & 64) {
        Val |= 18446744073709551615 << Shift;
    }
    return Val;
}

fn getSimpleVT(MatcherTable: *u8, MatcherIndex: *mut u64) -> SimpleValueType {
    let mut SimpleVT: u32 = MatcherTable[MatcherIndex += 1];
    if SimpleVT & 128 {
        SimpleVT = GetVBR(SimpleVT, MatcherTable, MatcherIndex);
    }
    return SimpleVT as SimpleValueType;
}

fn getHwModeVT(MatcherTable: *u8, MatcherIndex: *mut u64, SDISel: *SelectionDAGISel) -> MVT {
    let mut Index: u32 = MatcherTable[MatcherIndex += 1];
    return SDISel.getValueTypeForHwMode(Index);
}

fn SelectionDAGISel::Select_JUMP_TABLE_DEBUG_INFO(self, N: *mut SDNode) {
    let mut dl: SDLoc = N;
    self.CurDAG.SelectNodeTo(N, JUMP_TABLE_DEBUG_INFO, Glue, self.CurDAG.getTargetConstant(N.getConstantOperandVal(1), dl, i64, true));
}

fn SelectionDAGISel::UpdateChains(self, NodeToMatch: *mut SDNode, InputChain: SDValue, ChainNodesMatched: *mut SmallVectorImpl<SDNode *>, isMorphNodeTo: bool) {
    let mut NowDeadNodes: SmallVector<SDNode *, 4> = SmallVector<SDNode *, 4> {};
    if !ChainNodesMatched.is_empty() {
        assert!(InputChain.getNode(), "Matched input chains but didn't produce a chain");
        for let mut i: u32 = 0;
let mut e: u32 = ChainNodesMatched.len; i != e; i += 1 {
            let mut ChainNode: *mut SDNode = ChainNodesMatched[i];
            if !ChainNode {
                continue;
            }
            assert!(ChainNode.getOpcode() != DELETED_NODE, "Deleted node left in chain");
            if ChainNode == NodeToMatch && isMorphNodeTo {
                continue;
            }
            let mut ChainVal: SDValue = SDValue { Node: ChainNode, ResNo: ChainNode.getNumValues() - 1 };
            if ChainVal.getValueType() == Glue {
                ChainVal = ChainVal.getValue(operator(ChainVal).getNumValues() - 2);
            }
            assert!(ChainVal.getValueType() == Other, "Not a chain?");
            let mut NDL: DAGNodeDeletedListener = DAGNodeDeletedListener { *self.CurDAG, Closure_2 { ChainNodesMatched: &mut ChainNodesMatched } };
            if ChainNode.getOpcode() != TokenFactor {
                self.ReplaceUses(ChainVal, InputChain);
            }
            if ChainNode != NodeToMatch && ChainNode.use_empty() && !is_contained(NowDeadNodes, ChainNode) {
                NowDeadNodes.push(ChainNode);
            }
        }
    }
    if !NowDeadNodes.is_empty() {
        self.CurDAG.RemoveDeadNodes(NowDeadNodes);
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("isel", 1) {
            dbgs() << "ISEL: Match complete!\n";
        }
    }
        if !(false) { break; }
    }
}

fn HandleMergeInputChains(ChainNodesMatched: *SmallVectorImpl<SDNode *>, InputGlue: SDValue, CurDAG: *mut SelectionDAG) -> SDValue {
    let mut Visited: SmallPtrSet<const SDNode *, 16> = SmallPtrSet<const SDNode *, 16> {};
    let mut Worklist: SmallVector<const SDNode *, 8> = SmallVector<const SDNode *, 8> {};
    let mut InputChains: SmallVector<SDValue, 3> = SmallVector<SDValue, 3> {};
    let mut Max: u32 = 8192;
    if ChainNodesMatched.len == 1 {
        return ChainNodesMatched[0].getOperand(0);
    }
    let mut AddChains: function<void (const SDValue)> = Closure_3 { Visited: &mut Visited, AddChains: &mut AddChains, InputChains: &mut InputChains };
    for N in ChainNodesMatched {
        Worklist.push(N);
        Visited.insert(N);
    }
    while !Worklist.is_empty() {
        AddChains.call(Worklist.pop_back_val().getOperand(0));
    }
    if InputChains.len == 0 {
        return CurDAG.getEntryNode();
    }
    Visited.clear();
    for V in InputChains {
        if InputChains.len != 1 && operator(V).getValueType(operator(V).getNumValues() - 1) == Glue && InputGlue.getNode() == V.getNode() {
            return SDValue {};
        }
        Worklist.push(V.getNode());
    }
    for N in ChainNodesMatched {
        if hasPredecessorHelper(N, Visited, Worklist, Max, true) {
            return SDValue {};
        }
    }
    if InputChains.len == 1 {
        return InputChains[0];
    }
    return CurDAG.getNode(TokenFactor, ChainNodesMatched[0], Other, InputChains);
}

fn SelectionDAGISel::MorphNode(self, Node: *mut SDNode, TargetOpc: u32, VTList: SDVTList, Ops: ArrayRef<SDValue>, EmitNodeInfo: u32) -> *mut SDNode {
    let mut OldGlueResultNo: i32 = -1;
    let mut OldChainResultNo: i32 = -1;
    let mut NTMNumResults: u32 = Node.getNumValues();
    if Node.getValueType(NTMNumResults - 1) == Glue {
        OldGlueResultNo = NTMNumResults - 1;
        if NTMNumResults != 1 && Node.getValueType(NTMNumResults - 2) == Other {
            OldChainResultNo = NTMNumResults - 2;
        }
    } else if Node.getValueType(NTMNumResults - 1) == Other {
        OldChainResultNo = NTMNumResults - 1;
    }
    let mut Res: *mut SDNode = self.CurDAG.MorphNodeTo(Node, ~TargetOpc, VTList, Ops);
    if Res == Node {
        Res.setNodeId(-1);
    }
    let mut ResNumResults: u32 = Res.getNumValues();
    if (EmitNodeInfo & OPFL_GlueOutput) && OldGlueResultNo != -1 && OldGlueResultNo as u32 != ResNumResults - 1 {
        self.ReplaceUses(SDValue { Node: Node, ResNo: OldGlueResultNo }, SDValue { Node: Res, ResNo: ResNumResults - 1 });
    }
    if (EmitNodeInfo & OPFL_GlueOutput) != 0 {
        ResNumResults -= 1;
    }
    if (EmitNodeInfo & OPFL_Chain) && OldChainResultNo != -1 && OldChainResultNo as u32 != ResNumResults - 1 {
        self.ReplaceUses(SDValue { Node: Node, ResNo: OldChainResultNo }, SDValue { Node: Res, ResNo: ResNumResults - 1 });
    }
    if Res != Node {
        self.ReplaceNode(Node, Res);
    } else {
        EnforceNodeIdInvariant(Res);
    }
    return Res;
}

fn CheckSame(MatcherTable: *u8, MatcherIndex: *mut u64, N: SDValue, RecordedNodes: *pair<SDValue, SDNode *>>) -> bool {
    let mut RecNo: u32 = MatcherTable[MatcherIndex += 1];
    assert!(RecNo < RecordedNodes.len, "Invalid CheckSame");
    return N == RecordedNodes[RecNo].first;
}

fn CheckChildSame(MatcherTable: *u8, MatcherIndex: *mut u64, N: SDValue, RecordedNodes: *pair<SDValue, SDNode *>>, ChildNo: u32) -> bool {
    if ChildNo >= N.getNumOperands() {
        return false;
    }
    return CheckSame(MatcherTable, MatcherIndex, N.getOperand(ChildNo), RecordedNodes);
}

fn CheckPatternPredicate(Opcode: u32, MatcherTable: *u8, MatcherIndex: *mut u64, SDISel: *SelectionDAGISel) -> bool {
    let mut TwoBytePredNo: bool = Opcode == OPC_CheckPatternPredicateTwoByte;
    let mut PredNo: u32 = if TwoBytePredNo || Opcode == OPC_CheckPatternPredicate { MatcherTable[MatcherIndex += 1] } else { Opcode - OPC_CheckPatternPredicate0 };
    if TwoBytePredNo {
        PredNo |= MatcherTable[MatcherIndex += 1] << 8;
    }
    return SDISel.CheckPatternPredicate(PredNo);
}

fn CheckNodePredicate(Opcode: u32, MatcherTable: *u8, MatcherIndex: *mut u64, SDISel: *SelectionDAGISel, Op: SDValue) -> bool {
    let mut PredNo: u32 = if Opcode == OPC_CheckPredicate { MatcherTable[MatcherIndex += 1] } else { Opcode - OPC_CheckPredicate0 };
    return SDISel.CheckNodePredicate(Op, PredNo);
}

fn CheckOpcode(MatcherTable: *u8, MatcherIndex: *mut u64, N: *mut SDNode) -> bool {
    let mut Opc: u16 = MatcherTable[MatcherIndex += 1];
    Opc |= MatcherTable[MatcherIndex += 1] as u16 << 8;
    return N.getOpcode() == Opc;
}

fn CheckType(VT: SimpleValueType, N: SDValue, TLI: *TargetLowering, DL: *DataLayout) -> bool {
    if N.getValueType() == VT {
        return true;
    }
    return VT == iPTR && N.getValueType() == TLI.getPointerTy(DL, 0);
}

fn CheckChildType(VT: SimpleValueType, N: SDValue, TLI: *TargetLowering, DL: *DataLayout, ChildNo: u32) -> bool {
    if ChildNo >= N.getNumOperands() {
        return false;
    }
    return CheckType(VT, N.getOperand(ChildNo), TLI, DL);
}

fn CheckCondCode(MatcherTable: *u8, MatcherIndex: *mut u64, N: SDValue) -> bool {
    return cast(N).get() == MatcherTable[MatcherIndex += 1] as CondCode;
}

fn CheckChild2CondCode(MatcherTable: *u8, MatcherIndex: *mut u64, N: SDValue) -> bool {
    if 2 >= N.getNumOperands() {
        return false;
    }
    return CheckCondCode(MatcherTable, MatcherIndex, N.getOperand(2));
}

fn CheckValueType(MatcherTable: *u8, MatcherIndex: *mut u64, N: SDValue, TLI: *TargetLowering, DL: *DataLayout) -> bool {
    let mut VT: SimpleValueType = getSimpleVT(MatcherTable, MatcherIndex);
    if cast(N).getVT() == VT {
        return true;
    }
    return VT == iPTR && cast(N).getVT() == TLI.getPointerTy(DL, 0);
}

fn CheckInteger(MatcherTable: *u8, MatcherIndex: *mut u64, N: SDValue) -> bool {
    let mut Val: i64 = GetSignedVBR(MatcherTable, MatcherIndex);
    let mut C: *mut ConstantSDNode = dyn_cast(N);
    return C && C.getAPIntValue().trySExtValue() == Val;
}

fn CheckChildInteger(MatcherTable: *u8, MatcherIndex: *mut u64, N: SDValue, ChildNo: u32) -> bool {
    if ChildNo >= N.getNumOperands() {
        return false;
    }
    return CheckInteger(MatcherTable, MatcherIndex, N.getOperand(ChildNo));
}

fn CheckAndImm(MatcherTable: *u8, MatcherIndex: *mut u64, N: SDValue, SDISel: *SelectionDAGISel) -> bool {
    let mut Val: i64 = MatcherTable[MatcherIndex += 1];
    if Val & 128 {
        Val = GetVBR(Val, MatcherTable, MatcherIndex);
    }
    if operator(N).getOpcode() != AND {
        return false;
    }
    let mut C: *mut ConstantSDNode = dyn_cast(operator(N).getOperand(1));
    return C && SDISel.CheckAndMask(N.getOperand(0), C, Val);
}

fn CheckOrImm(MatcherTable: *u8, MatcherIndex: *mut u64, N: SDValue, SDISel: *SelectionDAGISel) -> bool {
    let mut Val: i64 = MatcherTable[MatcherIndex += 1];
    if Val & 128 {
        Val = GetVBR(Val, MatcherTable, MatcherIndex);
    }
    if operator(N).getOpcode() != OR {
        return false;
    }
    let mut C: *mut ConstantSDNode = dyn_cast(operator(N).getOperand(1));
    return C && SDISel.CheckOrMask(N.getOperand(0), C, Val);
}

fn IsPredicateKnownToFail(Table: *u8, Index: u64, N: SDValue, Result: *mut bool, SDISel: *SelectionDAGISel, RecordedNodes: *mut pair<SDValue, SDNode *>>) -> u64 {
    let mut Opcode: u32 = Table[Index += 1];
    match Opcode {
        _ => {
            Result = false;
        },
        OPC_CheckSame => {
            Result = !CheckSame(Table, Index, N, RecordedNodes);
        },
        OPC_CheckChild0Same => {
            OPC_CheckChild1Same;
        },
        OPC_CheckPatternPredicate => {
            OPC_CheckPatternPredicate0;
        },
        OPC_CheckPredicate => {
            OPC_CheckPredicate0;
        },
        OPC_CheckOpcode => {
            Result = !CheckOpcode(Table, Index, N.getNode());
        },
        OPC_CheckType => {
            OPC_CheckTypeI32;
        },
        OPC_CheckTypeRes => {
            OPC_CheckTypeResByHwMode;
        },
        OPC_CheckChild0Type => {
            OPC_CheckChild1Type;
        },
        OPC_CheckCondCode => {
            Result = !CheckCondCode(Table, Index, N);
        },
        OPC_CheckChild2CondCode => {
            Result = !CheckChild2CondCode(Table, Index, N);
        },
        OPC_CheckValueType => {
            Result = !CheckValueType(Table, Index, N, SDISel.TLI, SDISel.CurDAG.getDataLayout());
        },
        OPC_CheckInteger => {
            Result = !CheckInteger(Table, Index, N);
        },
        OPC_CheckChild0Integer => {
            OPC_CheckChild1Integer;
        },
        OPC_CheckAndImm => {
            Result = !CheckAndImm(Table, Index, N, SDISel);
        },
        OPC_CheckOrImm => {
            Result = !CheckOrImm(Table, Index, N, SDISel);
        },
    }
}

struct MatchScope {
    FailIndex: u32,
    NodeStack: SmallVector<SDValue, 4>,
    NumRecordedNodes: u32,
    NumMatchedMemRefs: u32,
    InputChain: SDValue,
    InputGlue: SDValue,
    HasChainNodesMatched: bool,
}

struct MatchStateUpdater {
    NodeToMatch: *mut *mut SDNode,
    RecordedNodes: *mut pair<SDValue, SDNode *>>,
    MatchScopes: *mut SmallVectorImpl<MatchScope>,
}

fn MatchStateUpdater::NodeDeleted(self, N: *mut SDNode, E: *mut SDNode) {
    if !E || E.isMachineOpcode() {
        return;
    }
    if N == *self.NodeToMatch {
        *self.NodeToMatch = E;
    }
    for I in self.RecordedNodes {
        if I.first.getNode() == N {
            I.first.setNode(E);
        }
    }
    for I in self.MatchScopes {
        for J in I.NodeStack {
            if J.getNode() == N {
                J.setNode(E);
            }
        }
    }
}

fn SelectionDAGISel::SelectCodeCommon(self, NodeToMatch: *mut SDNode, MatcherTable: *u8, TableSize: u32, OperandLists: *u8) {
    match NodeToMatch.getOpcode() {
        _ => {
            break;
        },
        EntryToken => {
            BasicBlock;
        },
        AssertSext => {
            AssertZext;
        },
        INLINEASM => {
            INLINEASM_BR;
        },
        READ_REGISTER => {
            self.Select_READ_REGISTER(NodeToMatch);
        },
        WRITE_REGISTER => {
            self.Select_WRITE_REGISTER(NodeToMatch);
        },
        POISON => {
            UNDEF;
        },
        FAKE_USE => {
            self.Select_FAKE_USE(NodeToMatch);
        },
        RELOC_NONE => {
            self.Select_RELOC_NONE(NodeToMatch);
        },
        FREEZE => {
            self.Select_FREEZE(NodeToMatch);
        },
        ARITH_FENCE => {
            self.Select_ARITH_FENCE(NodeToMatch);
        },
        MEMBARRIER => {
            self.Select_MEMBARRIER(NodeToMatch);
        },
        STACKMAP => {
            self.Select_STACKMAP(NodeToMatch);
        },
        PATCHPOINT => {
            self.Select_PATCHPOINT(NodeToMatch);
        },
        JUMP_TABLE_DEBUG_INFO => {
            self.Select_JUMP_TABLE_DEBUG_INFO(NodeToMatch);
        },
        CONVERGENCECTRL_ANCHOR => {
            self.Select_CONVERGENCECTRL_ANCHOR(NodeToMatch);
        },
        CONVERGENCECTRL_ENTRY => {
            self.Select_CONVERGENCECTRL_ENTRY(NodeToMatch);
        },
        CONVERGENCECTRL_LOOP => {
            self.Select_CONVERGENCECTRL_LOOP(NodeToMatch);
        },
    }
    assert!(!NodeToMatch.isMachineOpcode(), "Node already selected!");
    let mut NodeStack: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut N: SDValue = SDValue { Node: NodeToMatch, ResNo: 0 };
    NodeStack.push(N);
    let mut MatchScopes: SmallVector<MatchScope, 8> = SmallVector<MatchScope, 8> {};
    let mut RecordedNodes: pair<SDValue, SDNode *>, 8> = pair<SDValue, SDNode *>, 8> {};
    let mut MatchedMemRefs: SmallVector<MachineMemOperand *, 2> = SmallVector<MachineMemOperand *, 2> {};
    let mut InputChain: SDValue = SDValue {};
    let mut InputGlue: SDValue = SDValue {};
    let mut DeactivationSymbol: SDValue = SDValue {};
    let mut ChainNodesMatched: SmallVector<SDNode *, 3> = SmallVector<SDNode *, 3> {};
    while true {
        {
        if DebugFlag && isCurrentDebugType("isel", 1) {
            dbgs() << "ISEL: Starting pattern match\n";
        }
    }
        if !(false) { break; }
    }
    let mut MatcherIndex: u64 = 0;
    if !self.OpcodeOffset.is_empty() {
        if N.getOpcode() < self.OpcodeOffset.len {
            MatcherIndex = self.OpcodeOffset[N.getOpcode()];
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("isel", 1) {
                dbgs() << "  Initial Opcode index to " << MatcherIndex << "\n";
            }
        }
            if !(false) { break; }
        }
    } else if MatcherTable[0] == OPC_SwitchOpcode {
        let mut Idx: u64 = 1;
        while true {
            let mut CaseSize: u32 = MatcherTable[Idx += 1];
            if CaseSize & 128 {
                CaseSize = GetVBR(CaseSize, MatcherTable, Idx);
            }
            if CaseSize == 0 {
                break;
            }
            let mut Opc: u16 = MatcherTable[Idx += 1];
            Opc |= MatcherTable[Idx += 1] as u16 << 8;
            if Opc >= self.OpcodeOffset.len {
                self.OpcodeOffset.resize((Opc + 1) * 2);
            }
            self.OpcodeOffset[Opc] = Idx;
            Idx += CaseSize;
        }
        if N.getOpcode() < self.OpcodeOffset.len {
            MatcherIndex = self.OpcodeOffset[N.getOpcode()];
        }
    }
    while true {
        assert!(MatcherIndex < TableSize, "Invalid index");
        let mut CurrentOpcodeIndex: u64 = MatcherIndex;
        let mut Opcode: BuiltinOpcodes = MatcherTable[MatcherIndex += 1] as BuiltinOpcodes;
        match Opcode {
            OPC_Scope => {
                let mut FailIndex: u64 = 0;
                while true {
                    let mut NumToSkip: u32 = MatcherTable[MatcherIndex += 1];
                    if NumToSkip & 128 {
                        NumToSkip = GetVBR(NumToSkip, MatcherTable, MatcherIndex);
                    }
                    if NumToSkip == 0 {
                        FailIndex = 0;
                        break;
                    }
                    FailIndex = MatcherIndex + NumToSkip;
                    let mut MatcherIndexOfPredicate: u64 = MatcherIndex;
                    MatcherIndexOfPredicate as void;
                    let mut Result: bool = false;
                    MatcherIndex = IsPredicateKnownToFail(MatcherTable, MatcherIndex, N, Result, *self, RecordedNodes);
                    if !Result {
                        break;
                    }
                    while true {
                        {
                        if DebugFlag && isCurrentDebugType("isel", 1) {
                            dbgs() << "  Skipped scope entry (due to false predicate) at " << "index " << MatcherIndexOfPredicate << ", continuing at " << FailIndex << "\n";
                        }
                    }
                        if !(false) { break; }
                    }
                    operator(NumDAGIselRetries);
                    MatcherIndex = FailIndex;
                }
                if FailIndex == 0 {
                    break;
                }
                let mut NewEntry: *mut MatchScope = MatchScopes.push();
                NewEntry.FailIndex = FailIndex;
                NewEntry.NodeStack.append(NodeStack.begin(), NodeStack.end());
                NewEntry.NumRecordedNodes = RecordedNodes.len;
                NewEntry.NumMatchedMemRefs = MatchedMemRefs.len;
                NewEntry.InputChain = InputChain;
                NewEntry.InputGlue = InputGlue;
                NewEntry.HasChainNodesMatched = !ChainNodesMatched.is_empty();
                continue;
            },
            OPC_RecordNode => {
                let mut Parent: *mut SDNode = null;
                if NodeStack.len > 1 {
                    Parent = NodeStack[NodeStack.len - 2].getNode();
                }
                RecordedNodes.push(N, Parent);
                continue;
            },
            OPC_RecordChild0 => {
                OPC_RecordChild1;
            },
            OPC_RecordMemRef => {
                if dyn_cast(N) {
                    MN;
                } else {
                    append_range(MatchedMemRefs, MN.memoperands());
                }
            },
            OPC_CaptureGlueInput => {
                if operator(N).getNumOperands() != 0 && operator(N).getOperand(operator(N).getNumOperands() - 1).getValueType() == Glue {
                    InputGlue = operator(N).getOperand(operator(N).getNumOperands() - 1);
                }
            },
            OPC_CaptureDeactivationSymbol => {
                if operator(N).getNumOperands() != 0 && operator(N).getOperand(operator(N).getNumOperands() - 1).getOpcode() == DEACTIVATION_SYMBOL {
                    DeactivationSymbol = operator(N).getOperand(operator(N).getNumOperands() - 1);
                }
            },
            OPC_MoveChild => {
                let mut ChildNo: u32 = MatcherTable[MatcherIndex += 1];
                if ChildNo >= N.getNumOperands() {
                    break;
                }
                N = N.getOperand(ChildNo);
                NodeStack.push(N);
                continue;
            },
            OPC_MoveChild0 => {
                OPC_MoveChild1;
            },
            OPC_MoveSibling => {
                OPC_MoveSibling0;
            },
            OPC_MoveParent => {
                NodeStack.pop();
            },
            OPC_CheckSame => {
                if !CheckSame(MatcherTable, MatcherIndex, N, RecordedNodes) {
                    break;
                }
            },
            OPC_CheckChild0Same => {
                OPC_CheckChild1Same;
            },
            OPC_CheckPatternPredicate => {
                OPC_CheckPatternPredicate0;
            },
            OPC_CheckPredicate0 => {
                OPC_CheckPredicate1;
            },
            OPC_CheckPredicateWithOperands => {
                let mut OpNum: u32 = MatcherTable[MatcherIndex += 1];
                let mut Operands: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
                for let mut i: u32 = 0; i < OpNum; i += 1 {
                    Operands.push(RecordedNodes[MatcherTable[MatcherIndex += 1]].first);
                }
                let mut PredNo: u32 = MatcherTable[MatcherIndex += 1];
                if !self.CheckNodePredicateWithOperands(N, PredNo, Operands) {
                    break;
                }
                continue;
            },
            OPC_CheckComplexPat => {
                OPC_CheckComplexPat0;
            },
            OPC_CheckOpcode => {
                if !CheckOpcode(MatcherTable, MatcherIndex, N.getNode()) {
                    break;
                }
            },
            OPC_CheckType => {
                OPC_CheckTypeI32;
            },
            OPC_CheckTypeRes => {
                OPC_CheckTypeResByHwMode;
            },
            OPC_SwitchOpcode => {
                let mut CurNodeOpcode: u32 = N.getOpcode();
                let mut SwitchStart: u32 = MatcherIndex - 1;
                SwitchStart as void;
                let mut CaseSize: u32 = 0;
                while true {
                    CaseSize = MatcherTable[MatcherIndex += 1];
                    if CaseSize & 128 {
                        CaseSize = GetVBR(CaseSize, MatcherTable, MatcherIndex);
                    }
                    if CaseSize == 0 {
                        break;
                    }
                    let mut Opc: u16 = MatcherTable[MatcherIndex += 1];
                    Opc |= MatcherTable[MatcherIndex += 1] as u16 << 8;
                    if CurNodeOpcode == Opc {
                        break;
                    }
                    MatcherIndex += CaseSize;
                }
                if CaseSize == 0 {
                    break;
                }
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("isel", 1) {
                        dbgs() << "  OpcodeSwitch from " << SwitchStart << " to " << MatcherIndex << "\n";
                    }
                }
                    if !(false) { break; }
                }
                continue;
            },
            OPC_SwitchType => {
                let mut CurNodeVT: MVT = N.getSimpleValueType();
                let mut SwitchStart: u32 = MatcherIndex - 1;
                SwitchStart as void;
                let mut CaseSize: u32 = 0;
                while true {
                    CaseSize = MatcherTable[MatcherIndex += 1];
                    if CaseSize & 128 {
                        CaseSize = GetVBR(CaseSize, MatcherTable, MatcherIndex);
                    }
                    if CaseSize == 0 {
                        break;
                    }
                    let mut CaseVT: MVT = getSimpleVT(MatcherTable, MatcherIndex);
                    if CaseVT == iPTR {
                        CaseVT = self.TLI.getPointerTy(self.CurDAG.getDataLayout(), 0);
                    }
                    if CurNodeVT == CaseVT {
                        break;
                    }
                    MatcherIndex += CaseSize;
                }
                if CaseSize == 0 {
                    break;
                }
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("isel", 1) {
                        dbgs() << "  TypeSwitch[" << CurNodeVT << "] from " << SwitchStart << " to " << MatcherIndex << 10;
                    }
                }
                    if !(false) { break; }
                }
                continue;
            },
            OPC_CheckChild0Type => {
                OPC_CheckChild1Type;
            },
            OPC_CheckChild0TypeByHwMode => {
                OPC_CheckChild1TypeByHwMode;
            },
            OPC_CheckCondCode => {
                if !CheckCondCode(MatcherTable, MatcherIndex, N) {
                    break;
                }
            },
            OPC_CheckChild2CondCode => {
                if !CheckChild2CondCode(MatcherTable, MatcherIndex, N) {
                    break;
                }
            },
            OPC_CheckValueType => {
                if !CheckValueType(MatcherTable, MatcherIndex, N, self.TLI, self.CurDAG.getDataLayout()) {
                    break;
                }
            },
            OPC_CheckInteger => {
                if !CheckInteger(MatcherTable, MatcherIndex, N) {
                    break;
                }
            },
            OPC_CheckChild0Integer => {
                OPC_CheckChild1Integer;
            },
            OPC_CheckAndImm => {
                if !CheckAndImm(MatcherTable, MatcherIndex, N, *self) {
                    break;
                }
            },
            OPC_CheckOrImm => {
                if !CheckOrImm(MatcherTable, MatcherIndex, N, *self) {
                    break;
                }
            },
            OPC_CheckImmAllOnesV => {
                if !isConstantSplatVectorAllOnes(N.getNode(), false) {
                    break;
                }
            },
            OPC_CheckImmAllZerosV => {
                if !isConstantSplatVectorAllZeros(N.getNode(), false) {
                    break;
                }
            },
            OPC_CheckUndef => {
                if !N.isUndef() {
                    break;
                }
            },
            OPC_CheckFoldableChainNode => {
                assert!(NodeStack.len != 1, "No parent node");
                let mut HasMultipleUses: bool = false;
                for let mut i: u32 = 1;
let mut e: u32 = NodeStack.len - 1; i != e; i += 1 {
                    let mut NNonChainUses: u32 = 0;
                    let mut NS: *mut SDNode = NodeStack[i].getNode();
                    for U in NS.uses() {
                        if U.getValueType() != Other {
                            if NNonChainUses += 1 > 1 {
                                HasMultipleUses = true;
                                break;
                            }
                        }
                    }
                    if HasMultipleUses {
                        break;
                    }
                }
                if HasMultipleUses {
                    break;
                }
                if !self.IsProfitableToFold(N, NodeStack[NodeStack.len - 2].getNode(), NodeToMatch) || !IsLegalToFold(N, NodeStack[NodeStack.len - 2].getNode(), NodeToMatch, self.OptLevel, true) {
                    break;
                }
                continue;
            },
            OPC_EmitInteger => {
                OPC_EmitIntegerI8;
            },
            OPC_EmitRegister => {
                OPC_EmitRegisterI32;
            },
            OPC_EmitRegister2 => {
                OPC_EmitRegisterByHwMode2;
            },
            OPC_EmitConvertToTarget => {
                OPC_EmitConvertToTarget0;
            },
            OPC_EmitMergeInputChains1_0 => {
                OPC_EmitMergeInputChains1_1;
            },
            OPC_EmitMergeInputChains => {
                assert!(!InputChain.getNode(), "EmitMergeInputChains should be the first chain producing node");
                let mut NumChains: u32 = MatcherTable[MatcherIndex += 1];
                assert!(NumChains != 0, "Can't TF zero chains");
                assert!(ChainNodesMatched.is_empty(), "Should only have one EmitMergeInputChains per match");
                for let mut i: u32 = 0; i != NumChains; i += 1 {
                    let mut RecNo: u32 = MatcherTable[MatcherIndex += 1];
                    assert!(RecNo < RecordedNodes.len, "Invalid EmitMergeInputChains");
                    ChainNodesMatched.push(RecordedNodes[RecNo].first.getNode());
                    if ChainNodesMatched.back() != NodeToMatch && !RecordedNodes[RecNo].first.hasOneUse() {
                        ChainNodesMatched.clear();
                        break;
                    }
                }
                if ChainNodesMatched.is_empty() {
                    break;
                }
                InputChain = HandleMergeInputChains(ChainNodesMatched, InputGlue, self.CurDAG);
                if !InputChain.getNode() {
                    break;
                }
                continue;
            },
            OPC_EmitCopyToReg => {
                OPC_EmitCopyToReg0;
            },
            OPC_EmitNodeXForm => {
                let mut XFormNo: u32 = MatcherTable[MatcherIndex += 1];
                let mut RecNo: u32 = MatcherTable[MatcherIndex += 1];
                assert!(RecNo < RecordedNodes.len, "Invalid EmitNodeXForm");
                let mut Res: SDValue = self.RunSDNodeXForm(RecordedNodes[RecNo].first, XFormNo);
                RecordedNodes.push(Res, null);
                continue;
            },
            OPC_Coverage => {
                let mut index: u32 = MatcherTable[MatcherIndex += 1];
                index |= (MatcherTable[MatcherIndex += 1] << 8);
                index |= (MatcherTable[MatcherIndex += 1] << 16);
                index |= (MatcherTable[MatcherIndex += 1] << 24);
                dbgs() << "COVERED: " << self.getPatternForIndex(index) << "\n";
                dbgs() << "INCLUDED: " << self.getIncludePathForIndex(index) << "\n";
                continue;
            },
            OPC_EmitNode => {
                OPC_EmitNodeByHwMode;
            },
            OPC_CompleteMatch => {
                let mut NumResults: u32 = MatcherTable[MatcherIndex += 1];
                for let mut i: u32 = 0; i != NumResults; i += 1 {
                    let mut ResSlot: u32 = MatcherTable[MatcherIndex += 1];
                    if ResSlot & 128 {
                        ResSlot = GetVBR(ResSlot, MatcherTable, MatcherIndex);
                    }
                    assert!(ResSlot < RecordedNodes.len, "Invalid CompleteMatch");
                    let mut Res: SDValue = RecordedNodes[ResSlot].first;
                    assert!(i < NodeToMatch.getNumValues() && NodeToMatch.getValueType(i) != Other && NodeToMatch.getValueType(i) != Glue, "Invalid number of results to complete!");
                    assert!((NodeToMatch.getValueType(i) == Res.getValueType() || NodeToMatch.getValueType(i) == iPTR || Res.getValueType() == iPTR || NodeToMatch.getValueType(i).getSizeInBits() == Res.getValueSizeInBits()), "invalid replacement");
                    self.ReplaceUses(SDValue { Node: NodeToMatch, ResNo: i }, Res);
                }
                self.UpdateChains(NodeToMatch, InputChain, ChainNodesMatched, false);
                if NodeToMatch.getValueType(NodeToMatch.getNumValues() - 1) == Glue && InputGlue.getNode() {
                    self.ReplaceUses(SDValue { Node: NodeToMatch, ResNo: NodeToMatch.getNumValues() - 1 }, InputGlue);
                }
                assert!(NodeToMatch.use_empty(), "Didn't replace all uses of the node?");
                self.CurDAG.RemoveDeadNode(NodeToMatch);
                return;
            },
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("isel", 1) {
                dbgs() << "  Match failed at index " << CurrentOpcodeIndex << "\n";
            }
        }
            if !(false) { break; }
        }
        operator(NumDAGIselRetries);
        while true {
            if MatchScopes.is_empty() {
                self.CannotYetSelect(NodeToMatch);
                return;
            }
            let mut LastScope: *mut MatchScope = MatchScopes.back();
            RecordedNodes.resize(LastScope.NumRecordedNodes);
            NodeStack.assign(LastScope.NodeStack.begin(), LastScope.NodeStack.end());
            N = NodeStack.back();
            if LastScope.NumMatchedMemRefs != MatchedMemRefs.len {
                MatchedMemRefs.resize(LastScope.NumMatchedMemRefs);
            }
            MatcherIndex = LastScope.FailIndex;
            while true {
                {
                if DebugFlag && isCurrentDebugType("isel", 1) {
                    dbgs() << "  Continuing at " << MatcherIndex << "\n";
                }
            }
                if !(false) { break; }
            }
            InputChain = LastScope.InputChain;
            InputGlue = LastScope.InputGlue;
            if !LastScope.HasChainNodesMatched {
                ChainNodesMatched.clear();
            }
            let mut NumToSkip: u32 = MatcherTable[MatcherIndex += 1];
            if NumToSkip & 128 {
                NumToSkip = GetVBR(NumToSkip, MatcherTable, MatcherIndex);
            }
            if NumToSkip != 0 {
                LastScope.FailIndex = MatcherIndex + NumToSkip;
                break;
            }
            MatchScopes.pop();
        }
    }
}

fn SelectionDAGISel::mayRaiseFPException(self: *SelectionDAGISel, N: *mut SDNode) -> bool {
    if N.isMachineOpcode() {
        let mut MCID: *MCInstrDesc = self.TII.get(N.getMachineOpcode());
        return MCID.mayRaiseFPException();
    }
    if N.isTargetOpcode() {
        let mut TSI: *SelectionDAGTargetInfo = self.CurDAG.getSelectionDAGInfo();
        return TSI.mayRaiseFPException(N.getOpcode());
    }
    return N.isStrictFPOpcode();
}

fn SelectionDAGISel::isOrEquivalentToAdd(self: *SelectionDAGISel, N: *SDNode) -> bool {
    assert!(N.getOpcode() == OR, "Unexpected opcode");
    let mut C: *mut ConstantSDNode = dyn_cast(N.getOperand(1));
    if !C {
        return false;
    }
    if dyn_cast(N.getOperand(0)) {
        FN;
    } else {
        let mut MFI: *mut MachineFrameInfo = self.MF.getFrameInfo();
        let mut A: Align = MFI.getObjectAlign(FN.getIndex());
        let mut Off: i32 = C.getSExtValue();
        return (Off >= 0) && (((A.value() - 1) & Off) == Off);
    }
    return false;
}

fn SelectionDAGISel::CannotYetSelect(self, N: *mut SDNode) {
    let mut msg: str = "";
    let mut Msg: raw_string_ostream = msg;
    Msg << "Cannot select: ";
    Msg.enable_colors(errs().has_colors());
    if N.getOpcode() != INTRINSIC_W_CHAIN && N.getOpcode() != INTRINSIC_WO_CHAIN && N.getOpcode() != INTRINSIC_VOID {
        N.printrFull(Msg, self.CurDAG);
        Msg << "\nIn function: " << self.MF.getName();
    } else {
        let mut HasInputChain: bool = N.getOperand(0).getValueType() == Other;
        let mut iid: u32 = N.getConstantOperandVal(HasInputChain);
        if iid < num_intrinsics {
            Msg << "intrinsic %" << getBaseName(iid as ID);
        } else {
            Msg << "unknown intrinsic #" << iid;
        }
    }
    report_fatal_error(msg, true);
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, Arg: *Argument) -> bool {
        return Arg.hasAttribute(SwiftAsync);
    }

struct Closure_2 {
    ChainNodesMatched: *mut SmallVectorImpl<SDNode *>,
}

unsafe fn Closure_2::call(self: *mut Closure_2, N: *mut SDNode, E: *mut SDNode) {
                replace((*self.ChainNodesMatched), N, null as *mut SDNode);
            }

struct Closure_3 {
    Visited: *mut SmallPtrSet<const SDNode *, 16>,
    AddChains: *mut function<void (const SDValue)>,
    InputChains: *mut SmallVector<SDValue, 3>,
}

unsafe fn Closure_3::call(self: *mut Closure_3, V: SDValue) {
        if V.getValueType() != Other {
            return;
        }
        if operator(V).getOpcode() == EntryToken {
            return;
        }
        if !(*self.Visited).insert(V.getNode()).second {
            return;
        }
        if operator(V).getOpcode() == TokenFactor {
            for Op in operator(V).op_values() {
                (*self.AddChains).call(Op);
            }
        } else {
            (*self.InputChains).push(V);
        }
    }
