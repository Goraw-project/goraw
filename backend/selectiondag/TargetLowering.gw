        let mut NewOp1: SDValue = self.SimplifyMultipleUseDemandedVectorElts(Op1, (*self.DemandedElts), (*self.TLO).DAG, (*self.Depth) + 1);
        if NewOp0 || NewOp1 {
            let mut NewOp: SDValue = (*self.TLO).DAG.getNode((*self.Opcode), SDLoc { (*self.Op) }, (*self.VT), if NewOp0 {} else { Op0 }, if NewOp1 {} else { Op1 }, operator((*self.Op)).getFlags());
