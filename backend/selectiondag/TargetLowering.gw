unsafe fn Closure_31::call(self: *mut Closure_31, Lo: *mut SDValue, Hi: *mut SDValue, ShiftAmt: u32) {
        if ShiftAmt == 0 {
            return;
        }
        if ShiftAmt < (*self.HBitWidth) {
