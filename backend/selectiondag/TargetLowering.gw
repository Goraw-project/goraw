fn ArgListEntry@TargetLoweringBase@llvm::setAttributes(self, Call: *CallBase, ArgIdx: u32) {
    setArgListEntryAttributes(*self, *Call, ArgIdx);
}

fn ArgListEntry@TargetLoweringBase@llvm::setAttributes(self, Attrs: *AttributeList, ArgIdx: u32) {
    setArgListEntryAttributes(*self, Attrs, ArgIdx);
}

fn TargetLowering::getArgListForFunctionType(self, FuncTy: *mut FunctionType, FuncAttrs: *AttributeList, Ops: ArrayRef<SDValue>) -> ArgListTy {
    assert!(Ops.len == FuncTy.getNumParams(), "argument count does not match the function type");
    let mut Args: ArgListTy = ArgListTy {};
    Args.reserve(Ops.len);
    for let mut I: u32 = 0;
let mut E: u32 = FuncTy.getNumParams(); I != E; I += 1 {
        let mut Entry: ArgListEntry = ArgListEntry { Ops[I], FuncTy.getParamType(I) };
        Entry.setAttributes(FuncAttrs, I);
        Args.push(Entry);
    }
    return Args;
}

fn TargetLowering::makeLibCall(self: *TargetLowering, DAG: *mut SelectionDAG, LibcallImpl: LibcallImpl, RetVT: EVT, Ops: ArrayRef<SDValue>, CallOptions: MakeLibCallOptions, dl: *SDLoc, InChain: SDValue) -> pair<SDValue, SDValue> {
    if LibcallImpl == Unsupported {
        reportFatalInternalError("unsupported library call operation");
    }
    if !InChain {
        InChain = DAG.getEntryNode();
    }
    let mut Args: ArgListTy = ArgListTy {};
    Args.reserve(Ops.len);
    let mut OpsTypeOverrides: ArrayRef<Type *> = ArrayRef<Type *> { CallOptions.OpsTypeOverrides };
    for let mut i: u32 = 0; i < Ops.len; i += 1 {
        let mut NewOp: SDValue = Ops[i];
        let mut Ty: *mut Type = if i < OpsTypeOverrides.len && OpsTypeOverrides[i] { OpsTypeOverrides[i] } else { NewOp.getValueType().getTypeForEVT(*DAG.getContext()) };
        let mut Entry: ArgListEntry = ArgListEntry { NewOp, Ty };
        if CallOptions.IsSoften {
            Entry.OrigTy = CallOptions.OpsVTBeforeSoften[i].getTypeForEVT(*DAG.getContext());
        }
        Entry.IsSExt = self.shouldSignExtendTypeInLibCall(Entry.Ty, CallOptions.IsSigned);
        Entry.IsZExt = !Entry.IsSExt;
        if CallOptions.IsSoften && !self.shouldExtendTypeInLibCall(CallOptions.OpsVTBeforeSoften[i]) {
            Entry.IsSExt = Entry.IsZExt = false;
        }
        Args.push(Entry);
    }
    let mut Callee: SDValue = DAG.getExternalSymbol(LibcallImpl, EVT { self.getPointerTy(DAG.getDataLayout(), 0) });
    let mut RetTy: *mut Type = RetVT.getTypeForEVT(*DAG.getContext());
    let mut OrigRetTy: *mut Type = RetTy;
    let mut CLI: CallLoweringInfo = CallLoweringInfo { DAG };
    let mut signExtend: bool = self.shouldSignExtendTypeInLibCall(RetTy, CallOptions.IsSigned);
    let mut zeroExtend: bool = !signExtend;
    if CallOptions.IsSoften {
        OrigRetTy = CallOptions.RetVTBeforeSoften.getTypeForEVT(*DAG.getContext());
        if !self.shouldExtendTypeInLibCall(CallOptions.RetVTBeforeSoften) {
            signExtend = zeroExtend = false;
        }
    }
    CLI.setDebugLoc(dl).setChain(InChain).setLibCallee(self.getLibcallImplCallingConv(LibcallImpl), RetTy, OrigRetTy, Callee, move(Args)).setNoReturn(CallOptions.DoesNotReturn).setDiscardResult(!CallOptions.IsReturnValueUsed).setIsPostTypeLegalization(CallOptions.IsPostTypeLegalization).setSExtResult(signExtend).setZExtResult(zeroExtend);
    return self.LowerCallTo(CLI);
}

fn TargetLowering::findOptimalMemOpLowering(self: *TargetLowering, Context: *mut LLVMContext, MemOps: *mut []EVT, Limit: u32, Op: *MemOp, DstAS: u32, SrcAS: u32, FuncAttributes: *AttributeList, LargestVT: *mut EVT) -> bool {
    let mut VT: EVT = self.getOptimalMemOpType(Context, Op, FuncAttributes);
    if VT == EVT { Other } {
        VT = EVT { LAST_INTEGER_VALUETYPE };
        if Op.isFixedDstAlign() {
            let mut LoadsFromSrc: bool = Op.isMemcpyOrMemmove() && !Op.isMemcpyStrSrc();
            while VT != EVT { i8 } {
                let mut VTSize: u32 = VT.getSizeInBits().operator unsigned long long() / 8;
                let mut DstOk: bool = Op.getDstAlign() >= VTSize || self.allowsMisalignedMemoryAccesses(VT, DstAS, Op.getDstAlign(), MONone, null);
                let mut SrcOk: bool = !LoadsFromSrc || Op.getSrcAlign() >= VTSize || self.allowsMisalignedMemoryAccesses(VT, SrcAS, Op.getSrcAlign(), MONone, null);
                if DstOk && SrcOk {
                    break;
                }
                VT = EVT { (VT.getSimpleVT().SimpleTy - 1) as SimpleValueType };
            }
        }
        assert!(VT.isInteger());
        let mut LVT: MVT = MVT { SimpleTy: LAST_INTEGER_VALUETYPE };
        while !self.isTypeLegal(EVT { LVT }) {
            LVT = MVT { SimpleTy: (LVT.SimpleTy - 1) as SimpleValueType };
        }
        assert!(LVT.isInteger());
        if VT.bitsGT(EVT { LVT }) {
            VT = EVT { LVT };
        }
    }
    let mut NumMemOps: u32 = 0;
    let mut Size: u64 = Op.len;
    while Size {
        let mut VTSize: u32 = VT.getSizeInBits().operator unsigned long long() / 8;
        while VTSize > Size {
            let mut NewVT: EVT = VT;
            let mut NewVTSize: u32 = 0;
            let mut Found: bool = false;
            if VT.isVector() || VT.isFloatingPoint() {
                NewVT = EVT { if (VT.getSizeInBits().operator unsigned long long() > 64) { i64 } else { i32 } };
                if self.isOperationLegalOrCustom(STORE, NewVT, false) && self.isSafeMemOpType(NewVT.getSimpleVT()) {
                    Found = true;
                } else if NewVT == EVT { i64 } && self.isOperationLegalOrCustom(STORE, EVT { f64 }, false) && self.isSafeMemOpType(MVT { SimpleTy: f64 }) {
                    NewVT = EVT { f64 };
                    Found = true;
                }
            }
            if !Found {
                while true {
                    {
                    NewVT = EVT { (NewVT.getSimpleVT().SimpleTy - 1) as SimpleValueType };
                    if NewVT == EVT { i8 } {
                        break;
                    }
                }
                    if !(!self.isSafeMemOpType(NewVT.getSimpleVT())) { break; }
                }
            }
            NewVTSize = NewVT.getSizeInBits().operator unsigned long long() / 8;
            let mut Fast: u32 = 0;
            if NumMemOps && !Op.isVolatile() && NewVTSize < Size && self.allowsMisalignedMemoryAccesses(VT, DstAS, if Op.isFixedDstAlign() { Op.getDstAlign() } else { Align { ShiftValue: 1 } }, MONone, &mut Fast) && Fast {
                VTSize = Size;
            } else {
                VT = NewVT;
                VTSize = NewVTSize;
            }
        }
        if NumMemOps += 1 > Limit {
            return false;
        }
        MemOps.push(VT);
        Size -= VTSize;
    }
    return true;
}

fn TargetLowering::softenSetCCOperands(self: *TargetLowering, DAG: *mut SelectionDAG, VT: EVT, NewLHS: *mut SDValue, NewRHS: *mut SDValue, CCCode: *mut CondCode, dl: *SDLoc, OldLHS: SDValue, OldRHS: SDValue) {
    let mut Chain: SDValue = SDValue {};
    return self.softenSetCCOperands(DAG, VT, NewLHS, NewRHS, CCCode, dl, OldLHS, OldRHS, Chain, false);
}

fn selectFPCmpLibcall(Libcalls: *LibcallLoweringInfo, BoolLC: Libcall, TriStateLC: Libcall, GenericLC: Libcall, TriStateCC: CondCode) -> CondCode> {
    if Libcalls.getLibcallImpl(BoolLC) != Unsupported {
        return CondCode> { BoolLC, SETNE };
    }
    if Libcalls.getLibcallImpl(TriStateLC) != Unsupported {
        return CondCode> { TriStateLC, TriStateCC };
    }
    return CondCode> { GenericLC, TriStateCC };
}

fn TargetLowering::softenSetCCOperands(self: *TargetLowering, DAG: *mut SelectionDAG, VT: EVT, NewLHS: *mut SDValue, NewRHS: *mut SDValue, CCCode: *mut CondCode, dl: *SDLoc, OldLHS: SDValue, OldRHS: SDValue, Chain: *mut SDValue, IsSignaling: bool) {
    assert!((VT == EVT { f32 } || VT == EVT { f64 } || VT == EVT { f128 } || VT == EVT { ppcf128 }), "Unsupported setcc type!");
    let mut OrigCCCode: CondCode = CCCode;
    let mut LC1: Libcall = UNKNOWN_LIBCALL;
    let mut LC2: Libcall = UNKNOWN_LIBCALL;
    let mut CC1: CondCode = SETCC_INVALID;
    let mut CC2: CondCode = SETCC_INVALID;
    let mut ShouldInvertCC: bool = false;
    match CCCode {
        SETEQ => {
            SETOEQ;
        },
        SETNE => {
            SETUNE;
        },
        SETGE => {
            SETOGE;
        },
        SETLT => {
            SETOLT;
        },
        SETLE => {
            SETOLE;
        },
        SETGT => {
            SETOGT;
        },
        SETO => {
            ShouldInvertCC = true;
        },
        SETUO => {
            LC1 = getFPLibCall(VT, UO_F32, UO_F64, UNKNOWN_LIBCALL, UO_F128, UO_PPCF128);
        },
        SETONE => {
            ShouldInvertCC = true;
        },
        SETUEQ => {
            LC1 = getFPLibCall(VT, UO_F32, UO_F64, UNKNOWN_LIBCALL, UO_F128, UO_PPCF128);
        },
        _ => {
            ShouldInvertCC = true;
        },
    }
    let mut RetVT: EVT = EVT { self.getCmpLibcallReturnType() };
    let mut Ops: [2]SDValue = [NewLHS, NewRHS];
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    let mut OpsVT: [2]EVT = [OldLHS.getValueType(), OldRHS.getValueType()];
    CallOptions.setTypeListBeforeSoften(ArrayRef<EVT> { OpsVT }, RetVT);
    let mut ReportNoLibcall: Closure_1 = Closure_1 { DAG: &mut DAG, OrigCCCode: &mut OrigCCCode, VT: &mut VT, NewLHS: &mut NewLHS, RetVT: &mut RetVT, NewRHS: &mut NewRHS, dl: &mut dl, CCCode: &mut CCCode };
    let mut LC1Impl: LibcallImpl = DAG.getLibcalls().getLibcallImpl(LC1);
    if LC1Impl == Unsupported {
        ReportNoLibcall.call();
        return;
    }
    let mut Call: pair<SDValue, SDValue> = self.makeLibCall(DAG, LC1Impl, RetVT, ArrayRef<SDValue> { Ops }, CallOptions, dl, Chain);
    NewLHS = Call.first;
    NewRHS = DAG.getConstant(0, dl, RetVT, false, false);
    CCCode = CC1;
    if ShouldInvertCC {
        assert!(RetVT.isInteger());
        CCCode = getSetCCInverse(CCCode, RetVT);
    }
    if LC2 == UNKNOWN_LIBCALL {
        Chain = Call.second;
    } else {
        let mut LC2Impl: LibcallImpl = DAG.getLibcalls().getLibcallImpl(LC2);
        if LC2Impl == Unsupported {
            ReportNoLibcall.call();
            return;
        }
        assert!(CCCode == (if ShouldInvertCC { SETEQ } else { SETNE }), "unordered call should be simple boolean");
        let mut SetCCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), RetVT);
        if self.getBooleanContents(RetVT) == ZeroOrOneBooleanContent {
            NewLHS = DAG.getNode(AssertZext, dl, RetVT, Call.first, DAG.getValueType(EVT { i1 }));
        }
        let mut Tmp: SDValue = DAG.getSetCC(dl, SetCCVT, NewLHS, NewRHS, CCCode, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut Call2: pair<SDValue, SDValue> = self.makeLibCall(DAG, LC2Impl, RetVT, ArrayRef<SDValue> { Ops }, CallOptions, dl, Chain);
        CCCode = CC2;
        if ShouldInvertCC {
            CCCode = getSetCCInverse(CCCode, RetVT);
        }
        NewLHS = DAG.getSetCC(dl, SetCCVT, Call2.first, NewRHS, CCCode, SDValue {}, false, SDNodeFlags { Flags: None });
        if Chain {
            Chain = DAG.getNode(TokenFactor, dl, EVT { Other }, Call.second, Call2.second);
        }
        NewLHS = DAG.getNode(if ShouldInvertCC { AND } else { OR }, dl, Tmp.getValueType(), Tmp, NewLHS);
        NewRHS = SDValue {};
    }
}

fn TargetLowering::getJumpTableEncoding(self: *TargetLowering) -> u32 {
    if !self.isPositionIndependent() {
        return EK_BlockAddress;
    }
    return EK_LabelDifference32;
}

fn TargetLowering::getPICJumpTableRelocBase(self: *TargetLowering, Table: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    return Table;
}

fn TargetLowering::getPICJumpTableRelocBaseExpr(self: *TargetLowering, MF: *MachineFunction, JTI: u32, Ctx: *mut MCContext) -> *MCExpr {
    return create(MF.getJTISymbol(JTI, Ctx, false), Ctx, SMLoc {});
}

fn TargetLowering::expandIndirectJTBranch(self: *TargetLowering, dl: *SDLoc, Value: SDValue, Addr: SDValue, JTI: i32, DAG: *mut SelectionDAG) -> SDValue {
    let mut Chain: SDValue = Value;
    if DAG.getTarget().getTargetTriple().isOSBinFormatCOFF() {
        Chain = DAG.getJumpTableDebugInfo(JTI, Chain, dl);
    }
    return DAG.getNode(BRIND, dl, EVT { Other }, Chain, Addr);
}

fn TargetLowering::isOffsetFoldingLegal(self: *TargetLowering, GA: *GlobalAddressSDNode) -> bool {
    let mut TM: *TargetMachine = self.getTargetMachine();
    let mut GV: *GlobalValue = GA.getGlobal();
    if !TM.shouldAssumeDSOLocal(GV) {
        return false;
    }
    if self.isPositionIndependent() {
        return false;
    }
    return true;
}

fn TargetLowering::ShrinkDemandedConstant(self: *TargetLowering, Op: SDValue, DemandedBits: *APInt, DemandedElts: *APInt, TLO: *mut TargetLoweringOpt) -> bool {
    let mut DL: SDLoc = SDLoc { Op };
    let mut Opcode: u32 = Op.getOpcode();
    if DemandedBits.isZero() || DemandedElts.isZero() {
        return false;
    }
    if self.targetShrinkDemandedConstant(Op, DemandedBits, DemandedElts, TLO) {
        return TLO.New.getNode();
    }
    match Opcode {
        _ => {
            break;
        },
        XOR => {
            AND;
        },
    }
    return false;
}

fn TargetLowering::ShrinkDemandedConstant(self: *TargetLowering, Op: SDValue, DemandedBits: *APInt, TLO: *mut TargetLoweringOpt) -> bool {
    let mut VT: EVT = Op.getValueType();
    let mut DemandedElts: APInt = if VT.isVector() { getAllOnes(VT.getVectorNumElements()) } else { APInt { 1, 1, false, false } };
    return self.ShrinkDemandedConstant(Op, DemandedBits, DemandedElts, TLO);
}

fn TargetLowering::ShrinkDemandedOp(self: *TargetLowering, Op: SDValue, BitWidth: u32, DemandedBits: *APInt, TLO: *mut TargetLoweringOpt) -> bool {
    assert!(Op.getNumOperands() == 2, "ShrinkDemandedOp only supports binary operators!");
    assert!(Op.getNode().getNumValues() == 1, "ShrinkDemandedOp only supports nodes with one result!");
    let mut VT: EVT = Op.getValueType();
    let mut DAG: *mut SelectionDAG = TLO.DAG;
    let mut dl: SDLoc = SDLoc { Op };
    if VT.isVector() {
        return false;
    }
    assert!(Op.getOperand(0).getValueType().getScalarSizeInBits() == BitWidth && Op.getOperand(1).getValueType().getScalarSizeInBits() == BitWidth, "ShrinkDemandedOp only supports operands that have the same size!");
    if !Op.getNode().hasOneUse() {
        return false;
    }
    let mut DemandedSize: u32 = DemandedBits.getActiveBits();
    for let mut SmallVTBits: u32 = bit_ceil(DemandedSize); SmallVTBits < BitWidth; SmallVTBits = NextPowerOf2(SmallVTBits) {
        let mut SmallVT: EVT = getIntegerVT(*DAG.getContext(), SmallVTBits);
        if self.isTruncateFree(Op, SmallVT) && self.isZExtFree(SmallVT, VT) {
            let mut Flags: SDNodeFlags = SDNodeFlags { Flags: if operator(Op).getFlags().hasDisjoint() { Disjoint } else { None } };
            let mut Opcode: u32 = Op.getOpcode();
            if Opcode == PTRADD {
                Opcode = ADD;
            }
            let mut X: SDValue = DAG.getNode(Opcode, dl, SmallVT, DAG.getNode(TRUNCATE, dl, SmallVT, Op.getOperand(0)), DAG.getNode(TRUNCATE, dl, SmallVT, Op.getOperand(1)), Flags);
            assert!(DemandedSize <= SmallVTBits, "Narrowed below demanded bits?");
            let mut Z: SDValue = DAG.getNode(ANY_EXTEND, dl, VT, X);
            return TLO.CombineTo(Op, Z);
        }
    }
    return false;
}

fn TargetLowering::SimplifyDemandedBits(self: *TargetLowering, Op: SDValue, DemandedBits: *APInt, DCI: *mut DAGCombinerInfo) -> bool {
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut TLO: TargetLoweringOpt = TargetLoweringOpt { DAG, !DCI.isBeforeLegalize(), !DCI.isBeforeLegalizeOps() };
    let mut Known: KnownBits = KnownBits {};
    let mut Simplified: bool = self.SimplifyDemandedBits(Op, DemandedBits, Known, TLO, 0, false);
    if Simplified {
        DCI.AddToWorklist(Op.getNode());
        DCI.CommitTargetLoweringOpt(TLO);
    }
    return Simplified;
}

fn TargetLowering::SimplifyDemandedBits(self: *TargetLowering, Op: SDValue, DemandedBits: *APInt, DemandedElts: *APInt, DCI: *mut DAGCombinerInfo) -> bool {
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut TLO: TargetLoweringOpt = TargetLoweringOpt { DAG, !DCI.isBeforeLegalize(), !DCI.isBeforeLegalizeOps() };
    let mut Known: KnownBits = KnownBits {};
    let mut Simplified: bool = self.SimplifyDemandedBits(Op, DemandedBits, DemandedElts, Known, TLO, 0, false);
    if Simplified {
        DCI.AddToWorklist(Op.getNode());
        DCI.CommitTargetLoweringOpt(TLO);
    }
    return Simplified;
}

fn TargetLowering::SimplifyDemandedBits(self: *TargetLowering, Op: SDValue, DemandedBits: *APInt, Known: *mut KnownBits, TLO: *mut TargetLoweringOpt, Depth: u32, AssumeSingleUse: bool) -> bool {
    let mut VT: EVT = Op.getValueType();
    let mut DemandedElts: APInt = if VT.isFixedLengthVector() { getAllOnes(VT.getVectorNumElements()) } else { APInt { 1, 1, false, false } };
    return self.SimplifyDemandedBits(Op, DemandedBits, DemandedElts, Known, TLO, Depth, AssumeSingleUse);
}

fn TargetLowering::SimplifyMultipleUseDemandedBits(self: *TargetLowering, Op: SDValue, DemandedBits: *APInt, DemandedElts: *APInt, DAG: *mut SelectionDAG, Depth: u32) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    if Depth >= MaxRecursionDepth {
        return SDValue {};
    }
    if Op.isUndef() {
        return SDValue {};
    }
    if DemandedBits == 0 || DemandedElts == 0 {
        return DAG.getUNDEF(VT);
    }
    let mut IsLE: bool = DAG.getDataLayout().isLittleEndian();
    let mut NumElts: u32 = DemandedElts.getBitWidth();
    let mut BitWidth: u32 = DemandedBits.getBitWidth();
    let mut LHSKnown: KnownBits = KnownBits {};
    let mut RHSKnown: KnownBits = KnownBits {};
    match Op.getOpcode() {
        BITCAST => {
            if VT.isScalableVector() {
                return SDValue {};
            }
            let mut Src: SDValue = peekThroughBitcasts(Op.getOperand(0));
            let mut SrcVT: EVT = Src.getValueType();
            let mut DstVT: EVT = Op.getValueType();
            if SrcVT == DstVT {
                return Src;
            }
            let mut NumSrcEltBits: u32 = SrcVT.getScalarSizeInBits();
            let mut NumDstEltBits: u32 = DstVT.getScalarSizeInBits();
            if NumSrcEltBits == NumDstEltBits {
                if self.SimplifyMultipleUseDemandedBits(Src, DemandedBits, DemandedElts, DAG, Depth + 1) {
                    V;
                } else {
                    return DAG.getBitcast(DstVT, V);
                }
            }
            if SrcVT.isVector() && (NumDstEltBits % NumSrcEltBits) == 0 {
                let mut Scale: u32 = NumDstEltBits / NumSrcEltBits;
                let mut NumSrcElts: u32 = SrcVT.getVectorNumElements();
                let mut DemandedSrcBits: APInt = getZero(NumSrcEltBits);
                for let mut i: u32 = 0; i != Scale; i += 1 {
                    let mut EltOffset: u32 = if IsLE { i } else { (Scale - 1 - i) };
                    let mut BitOffset: u32 = EltOffset * NumSrcEltBits;
                    operator(DemandedSrcBits, DemandedBits.extractBits(NumSrcEltBits, BitOffset));
                }
                let mut DemandedSrcElts: APInt = ScaleBitMask(DemandedElts, NumSrcElts, false);
                if self.SimplifyMultipleUseDemandedBits(Src, DemandedSrcBits, DemandedSrcElts, DAG, Depth + 1) {
                    V;
                } else {
                    return DAG.getBitcast(DstVT, V);
                }
            }
            if IsLE && (NumSrcEltBits % NumDstEltBits) == 0 {
                let mut Scale: u32 = NumSrcEltBits / NumDstEltBits;
                let mut NumSrcElts: u32 = if SrcVT.isVector() { SrcVT.getVectorNumElements() } else { 1 };
                let mut DemandedSrcBits: APInt = getZero(NumSrcEltBits);
                let mut DemandedSrcElts: APInt = getZero(NumSrcElts);
                for let mut i: u32 = 0; i != NumElts; i += 1 {
                    if DemandedElts[i] {
                        let mut Offset: u32 = (i % Scale) * NumDstEltBits;
                        DemandedSrcBits.insertBits(DemandedBits, Offset);
                        DemandedSrcElts.setBit(i / Scale);
                    }
                }
                if self.SimplifyMultipleUseDemandedBits(Src, DemandedSrcBits, DemandedSrcElts, DAG, Depth + 1) {
                    V;
                } else {
                    return DAG.getBitcast(DstVT, V);
                }
            }
            break;
        },
        SCALAR_TO_VECTOR => {
            if !VT.isScalableVector() && !DemandedElts[0] {
                return DAG.getPOISON(VT);
            }
            break;
        },
        AND => {
            LHSKnown = DAG.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            RHSKnown = DAG.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            if DemandedBits.isSubsetOf(LHSKnown.Zero | RHSKnown.One) {
                return Op.getOperand(0);
            }
            if DemandedBits.isSubsetOf(RHSKnown.Zero | LHSKnown.One) {
                return Op.getOperand(1);
            }
            break;
        },
        OR => {
            LHSKnown = DAG.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            RHSKnown = DAG.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            if DemandedBits.isSubsetOf(LHSKnown.One | RHSKnown.Zero) {
                return Op.getOperand(0);
            }
            if DemandedBits.isSubsetOf(RHSKnown.One | LHSKnown.Zero) {
                return Op.getOperand(1);
            }
            break;
        },
        XOR => {
            LHSKnown = DAG.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            RHSKnown = DAG.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            if DemandedBits.isSubsetOf(RHSKnown.Zero) {
                return Op.getOperand(0);
            }
            if DemandedBits.isSubsetOf(LHSKnown.Zero) {
                return Op.getOperand(1);
            }
            break;
        },
        ADD => {
            MUL;
        },
        SHL => {
            if DAG.getValidMaximumShiftAmount(Op, DemandedElts, Depth + 1) {
                MaxSA;
            } else {
                let mut Op0: SDValue = Op.getOperand(0);
                let mut ShAmt: u32 = operator(MaxSA);
                let mut NumSignBits: u32 = DAG.ComputeNumSignBits(Op0, DemandedElts, Depth + 1);
                let mut UpperDemandedBits: u32 = BitWidth - DemandedBits.countr_zero();
                if NumSignBits > ShAmt && (NumSignBits - ShAmt) >= (UpperDemandedBits) {
                    return Op0;
                }
            }
            break;
        },
        SRL => {
            if DAG.getValidMaximumShiftAmount(Op, DemandedElts, Depth + 1) {
                MaxSA;
            } else {
                let mut Op0: SDValue = Op.getOperand(0);
                let mut ShAmt: u32 = operator(MaxSA);
                if DemandedBits.countl_zero() >= ShAmt {
                    let mut NumSignBits: u32 = DAG.ComputeNumSignBits(Op0, DemandedElts, Depth + 1);
                    if DemandedBits.countr_zero() >= (BitWidth - NumSignBits) {
                        return Op0;
                    }
                }
            }
            break;
        },
        SETCC => {
            let mut Op0: SDValue = Op.getOperand(0);
            let mut Op1: SDValue = Op.getOperand(1);
            let mut CC: CondCode = cast(Op.getOperand(2)).get();
            if DemandedBits.isSignMask() && Op0.getScalarValueSizeInBits() == BitWidth && self.getBooleanContents(Op0.getValueType()) == ZeroOrNegativeOneBooleanContent {
                if CC == SETLT && Op1.getValueType().isInteger() && (isNullConstant(Op1) || isBuildVectorAllZeros(Op1.getNode())) {
                    return Op0;
                }
            }
            break;
        },
        SIGN_EXTEND_INREG => {
            let mut Op0: SDValue = Op.getOperand(0);
            let mut ExVT: EVT = cast(Op.getOperand(1)).getVT();
            let mut ExBits: u32 = ExVT.getScalarSizeInBits();
            if DemandedBits.getActiveBits() <= ExBits && self.shouldRemoveRedundantExtend(Op) {
                return Op0;
            }
            let mut NumSignBits: u32 = DAG.ComputeNumSignBits(Op0, DemandedElts, Depth + 1);
            if NumSignBits >= (BitWidth - ExBits + 1) {
                return Op0;
            }
            break;
        },
        ANY_EXTEND_VECTOR_INREG => {
            SIGN_EXTEND_VECTOR_INREG;
        },
        INSERT_VECTOR_ELT => {
            if VT.isScalableVector() {
                return SDValue {};
            }
            let mut Vec: SDValue = Op.getOperand(0);
            let mut CIdx: *mut ConstantSDNode = dyn_cast(Op.getOperand(2));
            let mut VecVT: EVT = Vec.getValueType();
            if CIdx && CIdx.getAPIntValue().ult(VecVT.getVectorNumElements()) && !DemandedElts[CIdx.getZExtValue()] {
                return Vec;
            }
            break;
        },
        INSERT_SUBVECTOR => {
            if VT.isScalableVector() {
                return SDValue {};
            }
            let mut Vec: SDValue = Op.getOperand(0);
            let mut Sub: SDValue = Op.getOperand(1);
            let mut Idx: u64 = Op.getConstantOperandVal(2);
            let mut NumSubElts: u32 = Sub.getValueType().getVectorNumElements();
            let mut DemandedSubElts: APInt = DemandedElts.extractBits(NumSubElts, Idx);
            if DemandedSubElts == 0 {
                return Vec;
            }
            break;
        },
        VECTOR_SHUFFLE => {
            assert!(!VT.isScalableVector());
            let mut ShuffleMask: ArrayRef<int> = cast(Op).getMask();
            let mut AllUndef: bool = true;
            let mut IdentityLHS: bool = true;
            let mut IdentityRHS: bool = true;
            for let mut i: u32 = 0; i != NumElts; i += 1 {
                let mut M: i32 = ShuffleMask[i];
                if M < 0 || !DemandedElts[i] {
                    continue;
                }
                AllUndef = false;
                IdentityLHS &= (M == i as i32);
                IdentityRHS &= ((M - NumElts) == i);
            }
            if AllUndef {
                return DAG.getUNDEF(Op.getValueType());
            }
            if IdentityLHS {
                return Op.getOperand(0);
            }
            if IdentityRHS {
                return Op.getOperand(1);
            }
            break;
        },
        _ => {
            if VT.isScalableVector() {
                return SDValue {};
            }
        },
    }
    return SDValue {};
}

fn TargetLowering::SimplifyMultipleUseDemandedBits(self: *TargetLowering, Op: SDValue, DemandedBits: *APInt, DAG: *mut SelectionDAG, Depth: u32) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    let mut DemandedElts: APInt = if VT.isFixedLengthVector() { getAllOnes(VT.getVectorNumElements()) } else { APInt { 1, 1, false, false } };
    return self.SimplifyMultipleUseDemandedBits(Op, DemandedBits, DemandedElts, DAG, Depth);
}

fn TargetLowering::SimplifyMultipleUseDemandedVectorElts(self: *TargetLowering, Op: SDValue, DemandedElts: *APInt, DAG: *mut SelectionDAG, Depth: u32) -> SDValue {
    let mut DemandedBits: APInt = getAllOnes(Op.getScalarValueSizeInBits());
    return self.SimplifyMultipleUseDemandedBits(Op, DemandedBits, DemandedElts, DAG, Depth);
}

fn combineShiftToAVG(Op: SDValue, TLO: *mut TargetLoweringOpt, TLI: *TargetLowering, DemandedBits: *APInt, DemandedElts: *APInt, Depth: u32) -> SDValue {
    assert!((Op.getOpcode() == SRL || Op.getOpcode() == SRA), "SRL or SRA node is required here!");
    let mut N1C: *mut ConstantSDNode = isConstOrConstSplat(Op.getOperand(1), DemandedElts, false, false);
    if !N1C || !N1C.isOne() {
        return SDValue {};
    }
    let mut Add: SDValue = Op.getOperand(0);
    if Add.getOpcode() != ADD {
        return SDValue {};
    }
    let mut ExtOpA: SDValue = Add.getOperand(0);
    let mut ExtOpB: SDValue = Add.getOperand(1);
    let mut Add2: SDValue = SDValue {};
    let mut MatchOperands: Closure_2 = Closure_2 { DemandedElts: &mut DemandedElts, ExtOpA: &mut ExtOpA, ExtOpB: &mut ExtOpB, Add2: &mut Add2 };
    let mut IsCeil: bool = (ExtOpA.getOpcode() == ADD && MatchOperands.call(ExtOpA.getOperand(0), ExtOpA.getOperand(1), ExtOpB, ExtOpA)) || (ExtOpB.getOpcode() == ADD && MatchOperands.call(ExtOpB.getOperand(0), ExtOpB.getOperand(1), ExtOpA, ExtOpB));
    let mut DAG: *mut SelectionDAG = TLO.DAG;
    let mut ShiftOpc: u32 = Op.getOpcode();
    let mut IsSigned: bool = false;
    let mut KnownBits: u32 = 0;
    let mut NumSignedA: u32 = DAG.ComputeNumSignBits(ExtOpA, DemandedElts, Depth);
    let mut NumSignedB: u32 = DAG.ComputeNumSignBits(ExtOpB, DemandedElts, Depth);
    let mut NumSigned: u32 = if NumSignedA < NumSignedB { NumSignedA } else { NumSignedB } - 1;
    let mut NumZeroA: u32 = DAG.computeKnownBits(ExtOpA, DemandedElts, Depth).countMinLeadingZeros();
    let mut NumZeroB: u32 = DAG.computeKnownBits(ExtOpB, DemandedElts, Depth).countMinLeadingZeros();
    let mut NumZero: u32 = if NumZeroA < NumZeroB { NumZeroA } else { NumZeroB };
    match ShiftOpc {
        _ => {
            llvm_unreachable_internal("Unexpected ShiftOpc in combineShiftToAVG", "llvm\\lib\\CodeGen\\SelectionDAG\\TargetLowering.cpp", 1202);
        },
        SRA => {
            if NumZero >= 2 && NumSigned < NumZero {
                IsSigned = false;
                KnownBits = NumZero;
                break;
            }
            if NumSigned >= 1 {
                IsSigned = true;
                KnownBits = NumSigned;
                break;
            }
            return SDValue {};
        },
        SRL => {
            if NumZero >= 1 && NumSigned < NumZero {
                IsSigned = false;
                KnownBits = NumZero;
                break;
            }
            if NumSigned >= 1 && DemandedBits.isSignBitClear() {
                IsSigned = true;
                KnownBits = NumSigned;
                break;
            }
            return SDValue {};
        },
    }
    let mut AVGOpc: u32 = if IsCeil { (if IsSigned { AVGCEILS } else { AVGCEILU }) } else { (if IsSigned { AVGFLOORS } else { AVGFLOORU }) };
    let mut VT: EVT = Op.getValueType();
    let mut MinWidth: u32 = if VT.getScalarSizeInBits() - KnownBits > 8 { VT.getScalarSizeInBits() - KnownBits } else { 8 };
    let mut NVT: EVT = getIntegerVT(*DAG.getContext(), bit_ceil(MinWidth));
    if NVT.getScalarSizeInBits() > VT.getScalarSizeInBits() {
        return SDValue {};
    }
    if VT.isVector() {
        NVT = getVectorVT(*DAG.getContext(), NVT, VT.getVectorElementCount());
    }
    if TLO.LegalTypes() && !TLI.isOperationLegal(AVGOpc, NVT) {
        if TLO.LegalOperations() && !TLI.isOperationLegal(AVGOpc, VT) {
            return SDValue {};
        }
        if DAG.willNotOverflowAdd(IsSigned, Add.getOperand(0), Add.getOperand(1)) && (!Add2 || DAG.willNotOverflowAdd(IsSigned, Add2.getOperand(0), Add2.getOperand(1))) {
            NVT = VT;
        } else {
            return SDValue {};
        }
    }
    if !IsCeil && !TLI.isOperationLegal(AVGOpc, NVT) && (isa(ExtOpA) || isa(ExtOpB)) {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { Op };
    let mut ResultAVG: SDValue = DAG.getNode(AVGOpc, DL, NVT, DAG.getExtOrTrunc(IsSigned, ExtOpA, DL, NVT), DAG.getExtOrTrunc(IsSigned, ExtOpB, DL, NVT));
    return DAG.getExtOrTrunc(IsSigned, ResultAVG, DL, VT);
}

fn TargetLowering::SimplifyDemandedBits(self: *TargetLowering, Op: SDValue, OriginalDemandedBits: *APInt, OriginalDemandedElts: *APInt, Known: *mut KnownBits, TLO: *mut TargetLoweringOpt, Depth: u32, AssumeSingleUse: bool) -> bool {
    let mut BitWidth: u32 = OriginalDemandedBits.getBitWidth();
    assert!(Op.getScalarValueSizeInBits() == BitWidth, "Mask size mismatches value type size!");
    Known = KnownBits { BitWidth };
    let mut VT: EVT = Op.getValueType();
    let mut IsLE: bool = TLO.DAG.getDataLayout().isLittleEndian();
    let mut NumElts: u32 = OriginalDemandedElts.getBitWidth();
    assert!((!VT.isFixedLengthVector() || NumElts == VT.getVectorNumElements()), "Unexpected vector size");
    let mut DemandedBits: APInt = OriginalDemandedBits;
    let mut DemandedElts: APInt = OriginalDemandedElts;
    let mut dl: SDLoc = SDLoc { Op };
    if Op.isUndef() {
        return false;
    }
    if Op.getOpcode() == TargetConstant {
        return false;
    }
    if Op.getOpcode() == Constant {
        Known = makeConstant(operator(Op).getAsAPIntVal());
        return false;
    }
    if Op.getOpcode() == ConstantFP {
        Known = makeConstant(cast(Op).getValueAPF().bitcastToAPInt());
        return false;
    }
    let mut HasMultiUse: bool = false;
    if !AssumeSingleUse && !Op.getNode().hasOneUse() {
        if Depth >= MaxRecursionDepth {
            return false;
        }
        DemandedBits = getAllOnes(BitWidth);
        DemandedElts = getAllOnes(NumElts);
        HasMultiUse = true;
    } else if OriginalDemandedBits == 0 || OriginalDemandedElts == 0 {
        return TLO.CombineTo(Op, TLO.DAG.getUNDEF(VT));
    } else if Depth >= MaxRecursionDepth {
        return false;
    }
    let mut Known2: KnownBits = KnownBits {};
    match Op.getOpcode() {
        SCALAR_TO_VECTOR => {
            if VT.isScalableVector() {
                return false;
            }
            if !DemandedElts[0] {
                return TLO.CombineTo(Op, TLO.DAG.getPOISON(VT));
            }
            let mut SrcKnown: KnownBits = KnownBits {};
            let mut Src: SDValue = Op.getOperand(0);
            let mut SrcBitWidth: u32 = Src.getScalarValueSizeInBits();
            let mut SrcDemandedBits: APInt = DemandedBits.zext(SrcBitWidth);
            if self.SimplifyDemandedBits(Src, SrcDemandedBits, SrcKnown, TLO, Depth + 1, false) {
                return true;
            }
            if DemandedElts == 1 {
                Known = SrcKnown.anyextOrTrunc(BitWidth);
            }
            break;
        },
        BUILD_VECTOR => {
            Known = TLO.DAG.computeKnownBits(Op, DemandedElts, Depth);
        },
        SPLAT_VECTOR => {
            let mut Scl: SDValue = Op.getOperand(0);
            let mut DemandedSclBits: APInt = DemandedBits.zextOrTrunc(Scl.getValueSizeInBits().operator unsigned long long());
            let mut KnownScl: KnownBits = KnownBits {};
            if self.SimplifyDemandedBits(Scl, DemandedSclBits, KnownScl, TLO, Depth + 1, false) {
                return true;
            }
            Known = KnownScl.trunc(BitWidth);
            break;
        },
        FREEZE => {
            let mut N0: SDValue = Op.getOperand(0);
            if TLO.DAG.isGuaranteedNotToBeUndefOrPoison(N0, DemandedElts, UndefOrPoison, Depth + 1) {
                return TLO.CombineTo(Op, N0);
            }
            break;
        },
        LOAD => {
            let mut LD: *mut LoadSDNode = cast(Op);
            if self.getTargetConstantFromLoad(LD) {
                Known = TLO.DAG.computeKnownBits(Op, DemandedElts, Depth);
                return false;
            }
            if isZEXTLoad(Op.getNode()) && Op.getResNo() == 0 {
                let mut MemVT: EVT = LD.getMemoryVT();
                let mut MemBits: u32 = MemVT.getScalarSizeInBits();
                Known.Zero.setBitsFrom(MemBits);
                return false;
            }
            break;
        },
        INSERT_VECTOR_ELT => {
            if VT.isScalableVector() {
                return false;
            }
            let mut Vec: SDValue = Op.getOperand(0);
            let mut Scl: SDValue = Op.getOperand(1);
            let mut CIdx: *mut ConstantSDNode = dyn_cast(Op.getOperand(2));
            let mut VecVT: EVT = Vec.getValueType();
            let mut DemandedVecElts: APInt = DemandedElts;
            if CIdx && CIdx.getAPIntValue().ult(VecVT.getVectorNumElements()) {
                let mut Idx: u32 = CIdx.getZExtValue();
                DemandedVecElts.clearBit(Idx);
                if !DemandedElts[Idx] {
                    return TLO.CombineTo(Op, Vec);
                }
            }
            let mut KnownScl: KnownBits = KnownBits {};
            let mut NumSclBits: u32 = Scl.getScalarValueSizeInBits();
            let mut DemandedSclBits: APInt = DemandedBits.zextOrTrunc(NumSclBits);
            if self.SimplifyDemandedBits(Scl, DemandedSclBits, KnownScl, TLO, Depth + 1, false) {
                return true;
            }
            Known = KnownScl.anyextOrTrunc(BitWidth);
            let mut KnownVec: KnownBits = KnownBits {};
            if self.SimplifyDemandedBits(Vec, DemandedBits, DemandedVecElts, KnownVec, TLO, Depth + 1, false) {
                return true;
            }
            if !operator(DemandedVecElts) {
                Known = Known.intersectWith(KnownVec);
            }
            return false;
        },
        INSERT_SUBVECTOR => {
            if VT.isScalableVector() {
                return false;
            }
            let mut Src: SDValue = Op.getOperand(0);
            let mut Sub: SDValue = Op.getOperand(1);
            let mut Idx: u64 = Op.getConstantOperandVal(2);
            let mut NumSubElts: u32 = Sub.getValueType().getVectorNumElements();
            let mut DemandedSubElts: APInt = DemandedElts.extractBits(NumSubElts, Idx);
            let mut DemandedSrcElts: APInt = DemandedElts;
            DemandedSrcElts.clearBits(Idx, Idx + NumSubElts);
            let mut KnownSub: KnownBits = KnownBits {};
            let mut KnownSrc: KnownBits = KnownBits {};
            if self.SimplifyDemandedBits(Sub, DemandedBits, DemandedSubElts, KnownSub, TLO, Depth + 1, false) {
                return true;
            }
            if self.SimplifyDemandedBits(Src, DemandedBits, DemandedSrcElts, KnownSrc, TLO, Depth + 1, false) {
                return true;
            }
            Known.setAllConflict();
            if !operator(DemandedSubElts) {
                Known = Known.intersectWith(KnownSub);
            }
            if !operator(DemandedSrcElts) {
                Known = Known.intersectWith(KnownSrc);
            }
            if !DemandedBits.isAllOnes() || !DemandedSubElts.isAllOnes() || !DemandedSrcElts.isAllOnes() {
                let mut NewSub: SDValue = self.SimplifyMultipleUseDemandedBits(Sub, DemandedBits, DemandedSubElts, TLO.DAG, Depth + 1);
                let mut NewSrc: SDValue = self.SimplifyMultipleUseDemandedBits(Src, DemandedBits, DemandedSrcElts, TLO.DAG, Depth + 1);
                if NewSub || NewSrc {
                    NewSub = if NewSub {} else { Sub };
                    NewSrc = if NewSrc {} else { Src };
                    let mut NewOp: SDValue = TLO.DAG.getNode(Op.getOpcode(), dl, VT, NewSrc, NewSub, Op.getOperand(2));
                    return TLO.CombineTo(Op, NewOp);
                }
            }
            break;
        },
        EXTRACT_SUBVECTOR => {
            if VT.isScalableVector() {
                return false;
            }
            let mut Src: SDValue = Op.getOperand(0);
            if Src.getValueType().isScalableVector() {
                break;
            }
            let mut Idx: u64 = Op.getConstantOperandVal(1);
            let mut NumSrcElts: u32 = Src.getValueType().getVectorNumElements();
            let mut DemandedSrcElts: APInt = DemandedElts.zext(NumSrcElts).shl(Idx);
            if self.SimplifyDemandedBits(Src, DemandedBits, DemandedSrcElts, Known, TLO, Depth + 1, false) {
                return true;
            }
            if !DemandedBits.isAllOnes() || !DemandedSrcElts.isAllOnes() {
                let mut DemandedSrc: SDValue = self.SimplifyMultipleUseDemandedBits(Src, DemandedBits, DemandedSrcElts, TLO.DAG, Depth + 1);
                if DemandedSrc {
                    let mut NewOp: SDValue = TLO.DAG.getNode(Op.getOpcode(), dl, VT, DemandedSrc, Op.getOperand(1));
                    return TLO.CombineTo(Op, NewOp);
                }
            }
            break;
        },
        CONCAT_VECTORS => {
            if VT.isScalableVector() {
                return false;
            }
            Known.setAllConflict();
            let mut SubVT: EVT = Op.getOperand(0).getValueType();
            let mut NumSubVecs: u32 = Op.getNumOperands();
            let mut NumSubElts: u32 = SubVT.getVectorNumElements();
            for let mut i: u32 = 0; i != NumSubVecs; i += 1 {
                let mut DemandedSubElts: APInt = DemandedElts.extractBits(NumSubElts, i * NumSubElts);
                if self.SimplifyDemandedBits(Op.getOperand(i), DemandedBits, DemandedSubElts, Known2, TLO, Depth + 1, false) {
                    return true;
                }
                if !operator(DemandedSubElts) {
                    Known = Known.intersectWith(Known2);
                }
            }
            break;
        },
        VECTOR_SHUFFLE => {
            assert!(!VT.isScalableVector());
            let mut ShuffleMask: ArrayRef<int> = cast(Op).getMask();
            let mut DemandedLHS: APInt = APInt {};
            let mut DemandedRHS: APInt = APInt {};
            if !getShuffleDemandedElts(NumElts, ShuffleMask, DemandedElts, DemandedLHS, DemandedRHS, false) {
                break;
            }
            if !operator(DemandedLHS) || !operator(DemandedRHS) {
                let mut Op0: SDValue = Op.getOperand(0);
                let mut Op1: SDValue = Op.getOperand(1);
                Known.setAllConflict();
                if !operator(DemandedLHS) {
                    if self.SimplifyDemandedBits(Op0, DemandedBits, DemandedLHS, Known2, TLO, Depth + 1, false) {
                        return true;
                    }
                    Known = Known.intersectWith(Known2);
                }
                if !operator(DemandedRHS) {
                    if self.SimplifyDemandedBits(Op1, DemandedBits, DemandedRHS, Known2, TLO, Depth + 1, false) {
                        return true;
                    }
                    Known = Known.intersectWith(Known2);
                }
                let mut DemandedOp0: SDValue = self.SimplifyMultipleUseDemandedBits(Op0, DemandedBits, DemandedLHS, TLO.DAG, Depth + 1);
                let mut DemandedOp1: SDValue = self.SimplifyMultipleUseDemandedBits(Op1, DemandedBits, DemandedRHS, TLO.DAG, Depth + 1);
                if DemandedOp0 || DemandedOp1 {
                    Op0 = if DemandedOp0 {} else { Op0 };
                    Op1 = if DemandedOp1 {} else { Op1 };
                    let mut NewOp: SDValue = TLO.DAG.getVectorShuffle(VT, dl, Op0, Op1, ShuffleMask);
                    return TLO.CombineTo(Op, NewOp);
                }
            }
            break;
        },
        AND => {
            let mut Op0: SDValue = Op.getOperand(0);
            let mut Op1: SDValue = Op.getOperand(1);
            if isConstOrConstSplat(Op1, DemandedElts, false, false) {
                RHSC;
            } else {
                let mut LHSKnown: KnownBits = TLO.DAG.computeKnownBits(Op0, DemandedElts, Depth);
                if (LHSKnown.Zero & DemandedBits) == (operator(RHSC.getAPIntValue()) & DemandedBits) {
                    return TLO.CombineTo(Op, Op0);
                }
                if self.ShrinkDemandedConstant(Op, operator(LHSKnown.Zero) & DemandedBits, DemandedElts, TLO) {
                    return true;
                }
                if isBitwiseNot(Op0, false) && Op0.hasOneUse() && LHSKnown.One == operator(RHSC.getAPIntValue()) {
                    let mut Xor: SDValue = TLO.DAG.getNode(XOR, dl, VT, Op0.getOperand(0), Op1);
                    return TLO.CombineTo(Op, Xor);
                }
            }
            let mut X: SDValue = SDValue {};
            let mut Y: SDValue = SDValue {};
            if sd_match(Op, m_And(m_Value(Y), m_OneUse(m_AnyOf(m_Add(m_Value(X), m_Deferred(Y)), m_Sub(m_Value(X), m_Deferred(Y)))))) && TLO.DAG.isKnownToBeAPowerOfTwo(Y, DemandedElts, true, 0) {
                return TLO.CombineTo(Op, TLO.DAG.getNode(AND, dl, VT, TLO.DAG.getNOT(dl, X, VT), Y));
            }
            if Op0.getOpcode() == INSERT_SUBVECTOR && !VT.isScalableVector() && (Op0.getOperand(0).isUndef() || isBuildVectorOfConstantSDNodes(Op0.getOperand(0).getNode())) && operator(Op0).hasOneUse() {
                let mut NumSubElts: u32 = Op0.getOperand(1).getValueType().getVectorNumElements();
                let mut SubIdx: u32 = Op0.getConstantOperandVal(2);
                let mut DemandedSub: APInt = getBitsSet(NumElts, SubIdx, SubIdx + NumSubElts);
                let mut KnownSubMask: KnownBits = TLO.DAG.computeKnownBits(Op1, DemandedSub & DemandedElts, Depth + 1);
                if DemandedBits.isSubsetOf(KnownSubMask.One) {
                    let mut NewAnd: SDValue = TLO.DAG.getNode(AND, dl, VT, Op0.getOperand(0), Op1);
                    let mut NewInsert: SDValue = TLO.DAG.getNode(INSERT_SUBVECTOR, dl, VT, NewAnd, Op0.getOperand(1), Op0.getOperand(2));
                    return TLO.CombineTo(Op, NewInsert);
                }
            }
            if self.SimplifyDemandedBits(Op1, DemandedBits, DemandedElts, Known, TLO, Depth + 1, false) {
                return true;
            }
            if self.SimplifyDemandedBits(Op0, operator(Known.Zero) & DemandedBits, DemandedElts, Known2, TLO, Depth + 1, false) {
                return true;
            }
            if DemandedBits.isSubsetOf(Known2.Zero | Known.One) {
                return TLO.CombineTo(Op, Op0);
            }
            if DemandedBits.isSubsetOf(Known.Zero | Known2.One) {
                return TLO.CombineTo(Op, Op1);
            }
            if DemandedBits.isSubsetOf(Known.Zero | Known2.Zero) {
                return TLO.CombineTo(Op, TLO.DAG.getConstant(0, dl, VT, false, false));
            }
            if self.ShrinkDemandedConstant(Op, operator(Known2.Zero) & DemandedBits, DemandedElts, TLO) {
                return true;
            }
            if self.ShrinkDemandedOp(Op, BitWidth, DemandedBits, TLO) {
                return true;
            }
            if !DemandedBits.isAllOnes() || !DemandedElts.isAllOnes() {
                let mut DemandedOp0: SDValue = self.SimplifyMultipleUseDemandedBits(Op0, DemandedBits, DemandedElts, TLO.DAG, Depth + 1);
                let mut DemandedOp1: SDValue = self.SimplifyMultipleUseDemandedBits(Op1, DemandedBits, DemandedElts, TLO.DAG, Depth + 1);
                if DemandedOp0 || DemandedOp1 {
                    Op0 = if DemandedOp0 {} else { Op0 };
                    Op1 = if DemandedOp1 {} else { Op1 };
                    let mut NewOp: SDValue = TLO.DAG.getNode(Op.getOpcode(), dl, VT, Op0, Op1);
                    return TLO.CombineTo(Op, NewOp);
                }
            }
            operator(Known, Known2);
            break;
        },
        OR => {
            let mut Op0: SDValue = Op.getOperand(0);
            let mut Op1: SDValue = Op.getOperand(1);
            if self.SimplifyDemandedBits(Op1, DemandedBits, DemandedElts, Known, TLO, Depth + 1, false) {
                operator(Op).dropFlags(Disjoint);
                return true;
            }
            if self.SimplifyDemandedBits(Op0, operator(Known.One) & DemandedBits, DemandedElts, Known2, TLO, Depth + 1, false) {
                operator(Op).dropFlags(Disjoint);
                return true;
            }
            if DemandedBits.isSubsetOf(Known2.One | Known.Zero) {
                return TLO.CombineTo(Op, Op0);
            }
            if DemandedBits.isSubsetOf(Known.One | Known2.Zero) {
                return TLO.CombineTo(Op, Op1);
            }
            if self.ShrinkDemandedConstant(Op, DemandedBits, DemandedElts, TLO) {
                return true;
            }
            if self.ShrinkDemandedOp(Op, BitWidth, DemandedBits, TLO) {
                return true;
            }
            if !DemandedBits.isAllOnes() || !DemandedElts.isAllOnes() {
                let mut DemandedOp0: SDValue = self.SimplifyMultipleUseDemandedBits(Op0, DemandedBits, DemandedElts, TLO.DAG, Depth + 1);
                let mut DemandedOp1: SDValue = self.SimplifyMultipleUseDemandedBits(Op1, DemandedBits, DemandedElts, TLO.DAG, Depth + 1);
                if DemandedOp0 || DemandedOp1 {
                    Op0 = if DemandedOp0 {} else { Op0 };
                    Op1 = if DemandedOp1 {} else { Op1 };
                    let mut NewOp: SDValue = TLO.DAG.getNode(Op.getOpcode(), dl, VT, Op0, Op1);
                    return TLO.CombineTo(Op, NewOp);
                }
            }
            let mut X: SDValue = SDValue {};
            let mut Y: SDValue = SDValue {};
            let mut C1: SDValue = SDValue {};
            let mut C2: SDValue = SDValue {};
            if sd_match(Op, m_Or(m_OneUse(m_And(m_Value(X), m_Value(C1))), m_OneUse(m_And(m_Or(m_Deferred(X), m_Value(Y)), m_Value(C2))))) {
                if TLO.DAG.FoldConstantArithmetic(OR, dl, VT, ArrayRef<SDValue> { [C1, C2] }, SDNodeFlags { Flags: None }) {
                    C12;
                } else {
                    let mut MaskX: SDValue = TLO.DAG.getNode(AND, dl, VT, X, C12);
                    let mut MaskY: SDValue = TLO.DAG.getNode(AND, dl, VT, Y, C2);
                    return TLO.CombineTo(Op, TLO.DAG.getNode(OR, dl, VT, MaskX, MaskY));
                }
            }
            operator(Known, Known2);
            break;
        },
        XOR => {
            let mut Op0: SDValue = Op.getOperand(0);
            let mut Op1: SDValue = Op.getOperand(1);
            if self.SimplifyDemandedBits(Op1, DemandedBits, DemandedElts, Known, TLO, Depth + 1, false) {
                return true;
            }
            if self.SimplifyDemandedBits(Op0, DemandedBits, DemandedElts, Known2, TLO, Depth + 1, false) {
                return true;
            }
            if DemandedBits.isSubsetOf(Known.Zero) {
                return TLO.CombineTo(Op, Op0);
            }
            if DemandedBits.isSubsetOf(Known2.Zero) {
                return TLO.CombineTo(Op, Op1);
            }
            if self.ShrinkDemandedOp(Op, BitWidth, DemandedBits, TLO) {
                return true;
            }
            if DemandedBits.isSubsetOf(Known.Zero | Known2.Zero) {
                return TLO.CombineTo(Op, TLO.DAG.getNode(OR, dl, VT, Op0, Op1));
            }
            let mut C: *mut ConstantSDNode = isConstOrConstSplat(Op1, DemandedElts, false, false);
            if C {
                if C.getAPIntValue() == Known2.One {
                    let mut ANDC: SDValue = TLO.DAG.getConstant(operator(C.getAPIntValue()) & DemandedBits, dl, VT, false, false);
                    return TLO.CombineTo(Op, TLO.DAG.getNode(AND, dl, VT, Op0, ANDC));
                }
                if !C.isAllOnes() && DemandedBits.isSubsetOf(C.getAPIntValue()) {
                    let mut New: SDValue = TLO.DAG.getNOT(dl, Op0, VT);
                    return TLO.CombineTo(Op, New);
                }
                let mut Op0Opcode: u32 = Op0.getOpcode();
                if (Op0Opcode == SRL || Op0Opcode == SHL) && Op0.hasOneUse() {
                    if isConstOrConstSplat(Op0.getOperand(1), DemandedElts, false, false) {
                        ShiftC;
                    } else {
                        if ShiftC.getAPIntValue().ult(BitWidth) {
                            let mut ShiftAmt: u64 = ShiftC.getZExtValue();
                            let mut Ones: APInt = getAllOnes(BitWidth);
                            Ones = if Op0Opcode == SHL { Ones.shl(ShiftAmt) } else { Ones.lshr(ShiftAmt) };
                            if (DemandedBits & C.getAPIntValue()) == (DemandedBits & Ones) && self.isDesirableToCommuteXorWithShift(Op.getNode()) {
                                let mut Not: SDValue = TLO.DAG.getNOT(dl, Op0.getOperand(0), VT);
                                return TLO.CombineTo(Op, TLO.DAG.getNode(Op0Opcode, dl, VT, Not, Op0.getOperand(1)));
                            }
                        }
                    }
                }
            }
            if !C || !C.isAllOnes() {
                if self.ShrinkDemandedConstant(Op, DemandedBits, DemandedElts, TLO) {
                    return true;
                }
            }
            if !DemandedBits.isAllOnes() || !DemandedElts.isAllOnes() {
                let mut DemandedOp0: SDValue = self.SimplifyMultipleUseDemandedBits(Op0, DemandedBits, DemandedElts, TLO.DAG, Depth + 1);
                let mut DemandedOp1: SDValue = self.SimplifyMultipleUseDemandedBits(Op1, DemandedBits, DemandedElts, TLO.DAG, Depth + 1);
                if DemandedOp0 || DemandedOp1 {
                    Op0 = if DemandedOp0 {} else { Op0 };
                    Op1 = if DemandedOp1 {} else { Op1 };
                    let mut NewOp: SDValue = TLO.DAG.getNode(Op.getOpcode(), dl, VT, Op0, Op1);
                    return TLO.CombineTo(Op, NewOp);
                }
            }
            operator(Known, Known2);
            break;
        },
        SELECT => {
            if self.SimplifyDemandedBits(Op.getOperand(2), DemandedBits, DemandedElts, Known, TLO, Depth + 1, false) {
                return true;
            }
        },
        VSELECT => {
            if self.SimplifyDemandedBits(Op.getOperand(2), DemandedBits, DemandedElts, Known, TLO, Depth + 1, false) {
                return true;
            }
        },
        SELECT_CC => {
            if self.SimplifyDemandedBits(Op.getOperand(3), DemandedBits, DemandedElts, Known, TLO, Depth + 1, false) {
                return true;
            }
        },
        SETCC => {
            let mut Op0: SDValue = Op.getOperand(0);
            let mut Op1: SDValue = Op.getOperand(1);
            let mut CC: CondCode = cast(Op.getOperand(2)).get();
            if Op1.getValueType().isInteger() && (((CC == SETLT || CC == SETGE) && isNullOrNullSplat(Op1, false)) || ((CC == SETLE || CC == SETGT) && isAllOnesOrAllOnesSplat(Op1, false))) {
                let mut KnownOp0: KnownBits = KnownBits {};
                if self.SimplifyDemandedBits(Op0, getSignMask(Op0.getScalarValueSizeInBits()), DemandedElts, KnownOp0, TLO, Depth + 1, false) {
                    return true;
                }
                if DemandedBits.isSignMask() && Op0.getScalarValueSizeInBits() == BitWidth && self.getBooleanContents(Op0.getValueType()) == ZeroOrNegativeOneBooleanContent {
                    if CC == SETGE || CC == SETGT {
                        let mut DL: SDLoc = SDLoc { Op };
                        let mut VT: EVT = Op0.getValueType();
                        let mut NotOp0: SDValue = TLO.DAG.getNOT(DL, Op0, VT);
                        return TLO.CombineTo(Op, NotOp0);
                    }
                    return TLO.CombineTo(Op, Op0);
                }
            }
            if self.getBooleanContents(Op0.getValueType()) == ZeroOrOneBooleanContent && BitWidth > 1 {
                Known.Zero.setBitsFrom(1);
            }
            break;
        },
        SHL => {
            let mut Op0: SDValue = Op.getOperand(0);
            let mut Op1: SDValue = Op.getOperand(1);
            let mut ShiftVT: EVT = Op1.getValueType();
            if TLO.DAG.getValidShiftAmount(Op, DemandedElts, Depth + 1) {
                KnownSA;
            } else {
                let mut ShAmt: u32 = operator(KnownSA);
                if ShAmt == 0 {
                    return TLO.CombineTo(Op, Op0);
                }
                if Op0.getOpcode() == SRL {
                    if !DemandedBits.intersects(getLowBitsSet(BitWidth, ShAmt)) {
                        if TLO.DAG.getValidShiftAmount(Op0, DemandedElts, Depth + 2) {
                            InnerSA;
                        } else {
                            let mut C1: u32 = operator(InnerSA);
                            let mut Opc: u32 = SHL;
                            let mut Diff: i32 = ShAmt - C1;
                            if Diff < 0 {
                                Diff = -Diff;
                                Opc = SRL;
                            }
                            let mut NewSA: SDValue = TLO.DAG.getConstant(Diff, dl, ShiftVT, false, false);
                            return TLO.CombineTo(Op, TLO.DAG.getNode(Opc, dl, VT, Op0.getOperand(0), NewSA));
                        }
                    }
                }
                if Op0.getOpcode() == ANY_EXTEND {
                    let mut InnerOp: SDValue = Op0.getOperand(0);
                    let mut InnerVT: EVT = InnerOp.getValueType();
                    let mut InnerBits: u32 = InnerVT.getScalarSizeInBits();
                    if ShAmt < InnerBits && DemandedBits.getActiveBits() <= InnerBits && self.isTypeDesirableForOp(SHL, InnerVT) {
                        let mut NarrowShl: SDValue = TLO.DAG.getNode(SHL, dl, InnerVT, InnerOp, TLO.DAG.getShiftAmountConstant(ShAmt, InnerVT, dl));
                        return TLO.CombineTo(Op, TLO.DAG.getNode(ANY_EXTEND, dl, VT, NarrowShl));
                    }
                    if InnerOp.getOpcode() == SRL && Op0.hasOneUse() && InnerOp.hasOneUse() {
                        if TLO.DAG.getValidShiftAmount(InnerOp, DemandedElts, Depth + 2) {
                            SA2;
                        } else {
                            let mut InnerShAmt: u32 = operator(SA2);
                            if InnerShAmt < ShAmt && InnerShAmt < InnerBits && DemandedBits.getActiveBits() <= (InnerBits - InnerShAmt + ShAmt) && DemandedBits.countr_zero() >= ShAmt {
                                let mut NewSA: SDValue = TLO.DAG.getConstant(ShAmt - InnerShAmt, dl, ShiftVT, false, false);
                                let mut NewExt: SDValue = TLO.DAG.getNode(ANY_EXTEND, dl, VT, InnerOp.getOperand(0));
                                return TLO.CombineTo(Op, TLO.DAG.getNode(SHL, dl, VT, NewExt, NewSA));
                            }
                        }
                    }
                }
                let mut InDemandedMask: APInt = DemandedBits.lshr(ShAmt);
                if self.SimplifyDemandedBits(Op0, InDemandedMask, DemandedElts, Known, TLO, Depth + 1, false) {
                    operator(Op).dropFlags(NoWrap);
                    return true;
                }
                operator(Known, ShAmt);
                Known.Zero.setLowBits(ShAmt);
                if !InDemandedMask.isAllOnes() || !DemandedElts.isAllOnes() {
                    let mut DemandedOp0: SDValue = self.SimplifyMultipleUseDemandedBits(Op0, InDemandedMask, DemandedElts, TLO.DAG, Depth + 1);
                    if DemandedOp0 {
                        let mut NewOp: SDValue = TLO.DAG.getNode(SHL, dl, VT, DemandedOp0, Op1);
                        return TLO.CombineTo(Op, NewOp);
                    }
                }
                if ShAmt < DemandedBits.getActiveBits() && !VT.isVector() && Op.getNode().hasOneUse() {
                    let mut DemandedSize: u32 = DemandedBits.getActiveBits();
                    for let mut SmallVTBits: u32 = bit_ceil(DemandedSize); SmallVTBits < BitWidth; SmallVTBits = NextPowerOf2(SmallVTBits) {
                        let mut SmallVT: EVT = getIntegerVT(*TLO.DAG.getContext(), SmallVTBits);
                        if self.isNarrowingProfitable(Op.getNode(), VT, SmallVT) && self.isTypeDesirableForOp(SHL, SmallVT) && self.isTruncateFree(VT, SmallVT) && self.isZExtFree(SmallVT, VT) && (!TLO.LegalOperations() || self.isOperationLegal(SHL, SmallVT)) {
                            assert!(DemandedSize <= SmallVTBits, "Narrowed below demanded bits?");
                            let mut NarrowShl: SDValue = TLO.DAG.getNode(SHL, dl, SmallVT, TLO.DAG.getNode(TRUNCATE, dl, SmallVT, Op.getOperand(0)), TLO.DAG.getShiftAmountConstant(ShAmt, SmallVT, dl));
                            return TLO.CombineTo(Op, TLO.DAG.getNode(ANY_EXTEND, dl, VT, NarrowShl));
                        }
                    }
                }
                let mut HalfWidth: u32 = BitWidth / 2;
                if (BitWidth % 2) == 0 && !VT.isVector() && ShAmt < HalfWidth && DemandedBits.countLeadingOnes() >= HalfWidth {
                    let mut HalfVT: EVT = getIntegerVT(*TLO.DAG.getContext(), HalfWidth);
                    if self.isNarrowingProfitable(Op.getNode(), VT, HalfVT) && self.isTypeDesirableForOp(SHL, HalfVT) && self.isTruncateFree(VT, HalfVT) && self.isZExtFree(HalfVT, VT) && (!TLO.LegalOperations() || self.isOperationLegal(SHL, HalfVT)) {
                        if (Known.countMinLeadingZeros() >= HalfWidth) {
                            IsNUW;
                        } else {
                            let mut IsNSW: bool = Known.countMinSignBits() > HalfWidth;
                            let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
                            Flags.setNoSignedWrap(IsNSW);
                            Flags.setNoUnsignedWrap(IsNUW);
                            let mut NewOp: SDValue = TLO.DAG.getNode(TRUNCATE, dl, HalfVT, Op0);
                            let mut NewShiftAmt: SDValue = TLO.DAG.getShiftAmountConstant(ShAmt, HalfVT, dl);
                            let mut NewShift: SDValue = TLO.DAG.getNode(SHL, dl, HalfVT, NewOp, NewShiftAmt, Flags);
                            let mut NewExt: SDValue = TLO.DAG.getNode(ZERO_EXTEND, dl, VT, NewShift);
                            return TLO.CombineTo(Op, NewExt);
                        }
                    }
                }
            }
            if TLO.DAG.getValidMaximumShiftAmount(Op, DemandedElts, Depth + 1) {
                MaxSA;
            } else {
                let mut ShAmt: u32 = operator(MaxSA);
                let mut NumSignBits: u32 = TLO.DAG.ComputeNumSignBits(Op0, DemandedElts, Depth + 1);
                let mut UpperDemandedBits: u32 = BitWidth - DemandedBits.countr_zero();
                if NumSignBits > ShAmt && (NumSignBits - ShAmt) >= (UpperDemandedBits) {
                    return TLO.CombineTo(Op, Op0);
                }
            }
            break;
        },
        SRL => {
            let mut Op0: SDValue = Op.getOperand(0);
            let mut Op1: SDValue = Op.getOperand(1);
            let mut ShiftVT: EVT = Op1.getValueType();
            if TLO.DAG.getValidShiftAmount(Op, DemandedElts, Depth + 1) {
                KnownSA;
            } else {
                let mut ShAmt: u32 = operator(KnownSA);
                if ShAmt == 0 {
                    return TLO.CombineTo(Op, Op0);
                }
                if Op0.getOpcode() == SHL {
                    if !DemandedBits.intersects(getHighBitsSet(BitWidth, ShAmt)) {
                        if TLO.DAG.getValidShiftAmount(Op0, DemandedElts, Depth + 2) {
                            InnerSA;
                        } else {
                            let mut C1: u32 = operator(InnerSA);
                            let mut Opc: u32 = SRL;
                            let mut Diff: i32 = ShAmt - C1;
                            if Diff < 0 {
                                Diff = -Diff;
                                Opc = SHL;
                            }
                            let mut NewSA: SDValue = TLO.DAG.getConstant(Diff, dl, ShiftVT, false, false);
                            return TLO.CombineTo(Op, TLO.DAG.getNode(Opc, dl, VT, Op0.getOperand(0), NewSA));
                        }
                    }
                }
                if Op0.getOpcode() == SRA && Op0.hasOneUse() {
                    if !DemandedBits.intersects(getHighBitsSet(BitWidth, ShAmt)) {
                        if TLO.DAG.getValidShiftAmount(Op0, DemandedElts, Depth + 2) {
                            InnerSA;
                        } else {
                            let mut C1: u32 = operator(InnerSA);
                            let mut Combined: u32 = if C1 + ShAmt < BitWidth - 1 { C1 + ShAmt } else { BitWidth - 1 };
                            let mut NewSA: SDValue = TLO.DAG.getConstant(Combined, dl, ShiftVT, false, false);
                            return TLO.CombineTo(Op, TLO.DAG.getNode(SRA, dl, VT, Op0.getOperand(0), NewSA));
                        }
                    }
                }
                let mut InDemandedMask: APInt = (DemandedBits << ShAmt);
                if operator(Op).getFlags().hasExact() {
                    InDemandedMask.setLowBits(ShAmt);
                }
                if (BitWidth % 2) == 0 && !VT.isVector() {
                    let mut HiBits: APInt = getHighBitsSet(BitWidth, BitWidth / 2);
                    let mut HalfVT: EVT = getIntegerVT(*TLO.DAG.getContext(), BitWidth / 2);
                    if self.isNarrowingProfitable(Op.getNode(), VT, HalfVT) && self.isTypeDesirableForOp(SRL, HalfVT) && self.isTruncateFree(VT, HalfVT) && self.isZExtFree(HalfVT, VT) && (!TLO.LegalOperations() || self.isOperationLegal(SRL, HalfVT)) && ((InDemandedMask.countLeadingZeros() >= (BitWidth / 2)) || TLO.DAG.MaskedValueIsZero(Op0, HiBits, 0)) {
                        let mut NewOp: SDValue = TLO.DAG.getNode(TRUNCATE, dl, HalfVT, Op0);
                        let mut NewShiftAmt: SDValue = TLO.DAG.getShiftAmountConstant(ShAmt, HalfVT, dl);
                        let mut NewShift: SDValue = TLO.DAG.getNode(SRL, dl, HalfVT, NewOp, NewShiftAmt);
                        return TLO.CombineTo(Op, TLO.DAG.getNode(ZERO_EXTEND, dl, VT, NewShift));
                    }
                }
                if self.SimplifyDemandedBits(Op0, InDemandedMask, DemandedElts, Known, TLO, Depth + 1, false) {
                    return true;
                }
                operator(Known, ShAmt);
                Known.Zero.setHighBits(ShAmt);
                if !InDemandedMask.isAllOnes() || !DemandedElts.isAllOnes() {
                    let mut DemandedOp0: SDValue = self.SimplifyMultipleUseDemandedBits(Op0, InDemandedMask, DemandedElts, TLO.DAG, Depth + 1);
                    if DemandedOp0 {
                        let mut NewOp: SDValue = TLO.DAG.getNode(SRL, dl, VT, DemandedOp0, Op1);
                        return TLO.CombineTo(Op, NewOp);
                    }
                }
            }
            if TLO.DAG.getValidMaximumShiftAmount(Op, DemandedElts, Depth + 1) {
                MaxSA;
            } else {
                let mut ShAmt: u32 = operator(MaxSA);
                if DemandedBits.countl_zero() >= ShAmt {
                    let mut NumSignBits: u32 = TLO.DAG.ComputeNumSignBits(Op0, DemandedElts, Depth + 1);
                    if DemandedBits.countr_zero() >= (BitWidth - NumSignBits) {
                        return TLO.CombineTo(Op, Op0);
                    }
                }
            }
            if combineShiftToAVG(Op, TLO, *self, DemandedBits, DemandedElts, Depth + 1) {
                AVG;
            } else {
                return TLO.CombineTo(Op, AVG);
            }
            break;
        },
        SRA => {
            let mut Op0: SDValue = Op.getOperand(0);
            let mut Op1: SDValue = Op.getOperand(1);
            let mut ShiftVT: EVT = Op1.getValueType();
            let mut NumHiDemandedBits: u32 = BitWidth - DemandedBits.countr_zero();
            if TLO.DAG.ComputeNumSignBits(Op0, DemandedElts, Depth + 1) >= NumHiDemandedBits {
                return TLO.CombineTo(Op, Op0);
            }
            if DemandedBits.isOne() {
                return TLO.CombineTo(Op, TLO.DAG.getNode(SRL, dl, VT, Op0, Op1));
            }
            if TLO.DAG.getValidShiftAmount(Op, DemandedElts, Depth + 1) {
                KnownSA;
            } else {
                let mut ShAmt: u32 = operator(KnownSA);
                if ShAmt == 0 {
                    return TLO.CombineTo(Op, Op0);
                }
                if Op0.getOpcode() == SHL {
                    if TLO.DAG.getValidShiftAmount(Op0, DemandedElts, Depth + 2) {
                        InnerSA;
                    } else {
                        let mut LowBits: u32 = BitWidth - ShAmt;
                        let mut ExtVT: EVT = VT.changeElementType(*TLO.DAG.getContext(), getIntegerVT(*TLO.DAG.getContext(), LowBits));
                        if operator(InnerSA) == ShAmt {
                            if !TLO.LegalOperations() || self.getOperationAction(SIGN_EXTEND_INREG, ExtVT) == Legal {
                                return TLO.CombineTo(Op, TLO.DAG.getNode(SIGN_EXTEND_INREG, dl, VT, Op0.getOperand(0), TLO.DAG.getValueType(ExtVT)));
                            }
                            let mut NumSignBits: u32 = TLO.DAG.ComputeNumSignBits(Op0.getOperand(0), DemandedElts, 0);
                            if NumSignBits > ShAmt {
                                return TLO.CombineTo(Op, Op0.getOperand(0));
                            }
                        }
                    }
                }
                let mut InDemandedMask: APInt = (DemandedBits << ShAmt);
                if operator(Op).getFlags().hasExact() {
                    InDemandedMask.setLowBits(ShAmt);
                }
                if DemandedBits.countl_zero() < ShAmt {
                    InDemandedMask.setSignBit();
                }
                if self.SimplifyDemandedBits(Op0, InDemandedMask, DemandedElts, Known, TLO, Depth + 1, false) {
                    return true;
                }
                operator(Known, ShAmt);
                if Known.Zero[BitWidth - ShAmt - 1] || DemandedBits.countl_zero() >= ShAmt {
                    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
                    Flags.setExact(operator(Op).getFlags().hasExact());
                    return TLO.CombineTo(Op, TLO.DAG.getNode(SRL, dl, VT, Op0, Op1, Flags));
                }
                let mut Log2: i32 = DemandedBits.exactLogBase2();
                if Log2 >= 0 {
                    let mut NewSA: SDValue = TLO.DAG.getConstant(BitWidth - 1 - Log2, dl, ShiftVT, false, false);
                    return TLO.CombineTo(Op, TLO.DAG.getNode(SRL, dl, VT, Op0, NewSA));
                }
                if Known.One[BitWidth - ShAmt - 1] {
                    Known.One.setHighBits(ShAmt);
                }
                if !InDemandedMask.isAllOnes() || !DemandedElts.isAllOnes() {
                    let mut DemandedOp0: SDValue = self.SimplifyMultipleUseDemandedBits(Op0, InDemandedMask, DemandedElts, TLO.DAG, Depth + 1);
                    if DemandedOp0 {
                        let mut NewOp: SDValue = TLO.DAG.getNode(SRA, dl, VT, DemandedOp0, Op1);
                        return TLO.CombineTo(Op, NewOp);
                    }
                }
            }
            if combineShiftToAVG(Op, TLO, *self, DemandedBits, DemandedElts, Depth + 1) {
                AVG;
            } else {
                return TLO.CombineTo(Op, AVG);
            }
            break;
        },
        FSHL => {
            FSHR;
        },
        ROTL => {
            ROTR;
        },
        SMIN => {
            SMAX;
        },
        BITREVERSE => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut DemandedSrcBits: APInt = DemandedBits.reverseBits();
            if self.SimplifyDemandedBits(Src, DemandedSrcBits, DemandedElts, Known2, TLO, Depth + 1, false) {
                return true;
            }
            Known = Known2.reverseBits();
            break;
        },
        BSWAP => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut NLZ: u32 = DemandedBits.countl_zero();
            let mut NTZ: u32 = DemandedBits.countr_zero();
            NLZ = alignDown(NLZ, 8, 0);
            NTZ = alignDown(NTZ, 8, 0);
            if BitWidth - NLZ - NTZ == 8 {
                let mut ShiftOpcode: u32 = if NLZ > NTZ { SRL } else { SHL };
                if !TLO.LegalOperations() || self.isOperationLegal(ShiftOpcode, VT) {
                    let mut ShiftAmount: u32 = if NLZ > NTZ { NLZ - NTZ } else { NTZ - NLZ };
                    let mut ShAmt: SDValue = TLO.DAG.getShiftAmountConstant(ShiftAmount, VT, dl);
                    let mut NewOp: SDValue = TLO.DAG.getNode(ShiftOpcode, dl, VT, Src, ShAmt);
                    return TLO.CombineTo(Op, NewOp);
                }
            }
            let mut DemandedSrcBits: APInt = DemandedBits.byteSwap();
            if self.SimplifyDemandedBits(Src, DemandedSrcBits, DemandedElts, Known2, TLO, Depth + 1, false) {
                return true;
            }
            Known = Known2.byteSwap();
            break;
        },
        CTPOP => {
            if DemandedBits.isOne() && !TLO.LegalOps && !VT.isVector() {
                return TLO.CombineTo(Op, TLO.DAG.getNode(PARITY, dl, VT, Op.getOperand(0)));
            }
            Known = TLO.DAG.computeKnownBits(Op, DemandedElts, Depth);
            break;
        },
        PDEP => {
            let mut Op0: SDValue = Op.getOperand(0);
            let mut Op1: SDValue = Op.getOperand(1);
            let mut DemandedBitsLZ: u32 = DemandedBits.countl_zero();
            let mut LoMask: APInt = getLowBitsSet(BitWidth, BitWidth - DemandedBitsLZ);
            if self.SimplifyDemandedBits(Op1, LoMask, Known, TLO, Depth + 1, false) {
                return true;
            }
            let mut Known2: KnownBits = KnownBits {};
            let mut Count: u64 = (operator(Known.Zero) & LoMask).popcount();
            let mut DemandedMask: APInt = getLowBitsSet(BitWidth, Count);
            if self.SimplifyDemandedBits(Op0, DemandedMask, Known2, TLO, Depth + 1, false) {
                return true;
            }
            Known.One.clearAllBits();
            Known.Zero.setLowBits(Known2.countMinTrailingZeros());
            break;
        },
        SIGN_EXTEND_INREG => {
            let mut Op0: SDValue = Op.getOperand(0);
            let mut ExVT: EVT = cast(Op.getOperand(1)).getVT();
            let mut ExVTBits: u32 = ExVT.getScalarSizeInBits();
            if DemandedBits.isSignMask() {
                let mut MinSignedBits: u32 = TLO.DAG.ComputeMaxSignificantBits(Op0, DemandedElts, Depth + 1);
                let mut AlreadySignExtended: bool = ExVTBits >= MinSignedBits;
                if !AlreadySignExtended {
                    let mut ShiftAmt: SDValue = TLO.DAG.getShiftAmountConstant(BitWidth - ExVTBits, VT, dl);
                    return TLO.CombineTo(Op, TLO.DAG.getNode(SHL, dl, VT, Op0, ShiftAmt));
                }
            }
            if DemandedBits.getActiveBits() <= ExVTBits {
                return TLO.CombineTo(Op, Op0);
            }
            let mut InputDemandedBits: APInt = DemandedBits.getLoBits(ExVTBits);
            InputDemandedBits.setBit(ExVTBits - 1);
            if self.SimplifyDemandedBits(Op0, InputDemandedBits, DemandedElts, Known, TLO, Depth + 1, false) {
                return true;
            }
            if Known.Zero[ExVTBits - 1] {
                return TLO.CombineTo(Op, TLO.DAG.getZeroExtendInReg(Op0, dl, ExVT));
            }
            let mut Mask: APInt = getLowBitsSet(BitWidth, ExVTBits);
            if Known.One[ExVTBits - 1] {
                Known.One.setBitsFrom(ExVTBits);
                operator(Known.Zero, Mask);
            } else {
                operator(Known.Zero, Mask);
                operator(Known.One, Mask);
            }
            break;
        },
        BUILD_PAIR => {
            let mut HalfVT: EVT = Op.getOperand(0).getValueType();
            let mut HalfBitWidth: u32 = HalfVT.getScalarSizeInBits();
            let mut MaskLo: APInt = DemandedBits.getLoBits(HalfBitWidth).trunc(HalfBitWidth);
            let mut MaskHi: APInt = DemandedBits.getHiBits(HalfBitWidth).trunc(HalfBitWidth);
            let mut KnownLo: KnownBits = KnownBits {};
            let mut KnownHi: KnownBits = KnownBits {};
            if self.SimplifyDemandedBits(Op.getOperand(0), MaskLo, KnownLo, TLO, Depth + 1, false) {
                return true;
            }
            if self.SimplifyDemandedBits(Op.getOperand(1), MaskHi, KnownHi, TLO, Depth + 1, false) {
                return true;
            }
            Known = KnownHi.concat(KnownLo);
            break;
        },
        ZERO_EXTEND_VECTOR_INREG => {
            if VT.isScalableVector() {
                return false;
            }
        },
        ZERO_EXTEND => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut SrcVT: EVT = Src.getValueType();
            let mut InBits: u32 = SrcVT.getScalarSizeInBits();
            let mut InElts: u32 = if SrcVT.isFixedLengthVector() { SrcVT.getVectorNumElements() } else { 1 };
            let mut IsVecInReg: bool = Op.getOpcode() == ZERO_EXTEND_VECTOR_INREG;
            if DemandedBits.getActiveBits() <= InBits {
                if IsLE && IsVecInReg && DemandedElts == 1 && VT.getSizeInBits() == SrcVT.getSizeInBits() {
                    return TLO.CombineTo(Op, TLO.DAG.getBitcast(VT, Src));
                }
                let mut Opc: u32 = if IsVecInReg { ANY_EXTEND_VECTOR_INREG } else { ANY_EXTEND };
                if !TLO.LegalOperations() || self.isOperationLegal(Opc, VT) {
                    return TLO.CombineTo(Op, TLO.DAG.getNode(Opc, dl, VT, Src));
                }
            }
            let mut InDemandedBits: APInt = DemandedBits.trunc(InBits);
            let mut InDemandedElts: APInt = DemandedElts.zext(InElts);
            if self.SimplifyDemandedBits(Src, InDemandedBits, InDemandedElts, Known, TLO, Depth + 1, false) {
                operator(Op).dropFlags(NonNeg);
                return true;
            }
            assert!(Known.getBitWidth() == InBits, "Src width has changed?");
            Known = Known.zext(BitWidth);
            if self.SimplifyMultipleUseDemandedBits(Src, InDemandedBits, InDemandedElts, TLO.DAG, Depth + 1) {
                NewSrc;
            } else {
                return TLO.CombineTo(Op, TLO.DAG.getNode(Op.getOpcode(), dl, VT, NewSrc));
            }
            break;
        },
        SIGN_EXTEND_VECTOR_INREG => {
            if VT.isScalableVector() {
                return false;
            }
        },
        SIGN_EXTEND => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut SrcVT: EVT = Src.getValueType();
            let mut InBits: u32 = SrcVT.getScalarSizeInBits();
            let mut InElts: u32 = if SrcVT.isFixedLengthVector() { SrcVT.getVectorNumElements() } else { 1 };
            let mut IsVecInReg: bool = Op.getOpcode() == SIGN_EXTEND_VECTOR_INREG;
            let mut InDemandedElts: APInt = DemandedElts.zext(InElts);
            let mut InDemandedBits: APInt = DemandedBits.trunc(InBits);
            InDemandedBits.setBit(InBits - 1);
            if DemandedBits.getActiveBits() <= InBits {
                if IsLE && IsVecInReg && DemandedElts == 1 && VT.getSizeInBits() == SrcVT.getSizeInBits() {
                    return TLO.CombineTo(Op, TLO.DAG.getBitcast(VT, Src));
                }
                if self.getBooleanContents(VT) != ZeroOrNegativeOneBooleanContent || TLO.DAG.ComputeNumSignBits(Src, InDemandedElts, Depth + 1) != InBits {
                    let mut Opc: u32 = if IsVecInReg { ANY_EXTEND_VECTOR_INREG } else { ANY_EXTEND };
                    if !TLO.LegalOperations() || self.isOperationLegal(Opc, VT) {
                        return TLO.CombineTo(Op, TLO.DAG.getNode(Opc, dl, VT, Src));
                    }
                }
            }
            if self.SimplifyDemandedBits(Src, InDemandedBits, InDemandedElts, Known, TLO, Depth + 1, false) {
                return true;
            }
            assert!(Known.getBitWidth() == InBits, "Src width has changed?");
            Known = Known.sext(BitWidth);
            if Known.isNonNegative() {
                let mut Opc: u32 = if IsVecInReg { ZERO_EXTEND_VECTOR_INREG } else { ZERO_EXTEND };
                if !TLO.LegalOperations() || self.isOperationLegal(Opc, VT) {
                    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
                    if !IsVecInReg {
                        operator(Flags, SDNodeFlags { Flags: NonNeg });
                    }
                    return TLO.CombineTo(Op, TLO.DAG.getNode(Opc, dl, VT, Src, Flags));
                }
            }
            if self.SimplifyMultipleUseDemandedBits(Src, InDemandedBits, InDemandedElts, TLO.DAG, Depth + 1) {
                NewSrc;
            } else {
                return TLO.CombineTo(Op, TLO.DAG.getNode(Op.getOpcode(), dl, VT, NewSrc));
            }
            break;
        },
        ANY_EXTEND_VECTOR_INREG => {
            if VT.isScalableVector() {
                return false;
            }
        },
        ANY_EXTEND => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut SrcVT: EVT = Src.getValueType();
            let mut InBits: u32 = SrcVT.getScalarSizeInBits();
            let mut InElts: u32 = if SrcVT.isFixedLengthVector() { SrcVT.getVectorNumElements() } else { 1 };
            let mut IsVecInReg: bool = Op.getOpcode() == ANY_EXTEND_VECTOR_INREG;
            if IsLE && IsVecInReg && DemandedElts == 1 && VT.getSizeInBits() == SrcVT.getSizeInBits() {
                return TLO.CombineTo(Op, TLO.DAG.getBitcast(VT, Src));
            }
            let mut InDemandedBits: APInt = DemandedBits.trunc(InBits);
            let mut InDemandedElts: APInt = DemandedElts.zext(InElts);
            if self.SimplifyDemandedBits(Src, InDemandedBits, InDemandedElts, Known, TLO, Depth + 1, false) {
                return true;
            }
            assert!(Known.getBitWidth() == InBits, "Src width has changed?");
            Known = Known.anyext(BitWidth);
            if self.SimplifyMultipleUseDemandedBits(Src, InDemandedBits, InDemandedElts, TLO.DAG, Depth + 1) {
                NewSrc;
            } else {
                return TLO.CombineTo(Op, TLO.DAG.getNode(Op.getOpcode(), dl, VT, NewSrc));
            }
            break;
        },
        TRUNCATE => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut OperandBitWidth: u32 = Src.getScalarValueSizeInBits();
            let mut TruncMask: APInt = DemandedBits.zext(OperandBitWidth);
            if self.SimplifyDemandedBits(Src, TruncMask, DemandedElts, Known, TLO, Depth + 1, false) {
                operator(Op).dropFlags(NoWrap);
                return true;
            }
            Known = Known.trunc(BitWidth);
            if self.SimplifyMultipleUseDemandedBits(Src, TruncMask, DemandedElts, TLO.DAG, Depth + 1) {
                NewSrc;
            } else {
                return TLO.CombineTo(Op, TLO.DAG.getNode(TRUNCATE, dl, VT, NewSrc));
            }
            match Src.getOpcode() {
                _ => {
                    break;
                },
                SRL => {
                    if TLO.LegalTypes() && !self.isTypeDesirableForOp(SRL, VT) {
                        break;
                    }
                },
            }
            break;
        },
        AssertZext => {
            let mut ZVT: EVT = cast(Op.getOperand(1)).getVT();
            let mut InMask: APInt = getLowBitsSet(BitWidth, ZVT.getSizeInBits().operator unsigned long long());
            if self.SimplifyDemandedBits(Op.getOperand(0), operator(InMask) | DemandedBits, Known, TLO, Depth + 1, false) {
                return true;
            }
            operator(Known.Zero, operator(InMask));
            operator(Known.One, (operator(Known.Zero)));
            break;
        },
        EXTRACT_VECTOR_ELT => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut Idx: SDValue = Op.getOperand(1);
            let mut SrcEltCnt: ElementCount = Src.getValueType().getVectorElementCount();
            let mut EltBitWidth: u32 = Src.getScalarValueSizeInBits();
            if SrcEltCnt.isScalable() {
                return false;
            }
            let mut NumSrcElts: u32 = SrcEltCnt.getFixedValue();
            let mut DemandedSrcElts: APInt = getAllOnes(NumSrcElts);
            if dyn_cast(Idx) {
                CIdx;
            } else if CIdx.getAPIntValue().ult(NumSrcElts) {
                DemandedSrcElts = getOneBitSet(NumSrcElts, CIdx.getZExtValue());
            }
            let mut DemandedSrcBits: APInt = DemandedBits;
            if BitWidth > EltBitWidth {
                DemandedSrcBits = DemandedSrcBits.trunc(EltBitWidth);
            }
            if self.SimplifyDemandedBits(Src, DemandedSrcBits, DemandedSrcElts, Known2, TLO, Depth + 1, false) {
                return true;
            }
            if !DemandedSrcBits.isAllOnes() || !DemandedSrcElts.isAllOnes() {
                if self.SimplifyMultipleUseDemandedBits(Src, DemandedSrcBits, DemandedSrcElts, TLO.DAG, Depth + 1) {
                    DemandedSrc;
                } else {
                    let mut NewOp: SDValue = TLO.DAG.getNode(Op.getOpcode(), dl, VT, DemandedSrc, Idx);
                    return TLO.CombineTo(Op, NewOp);
                }
            }
            Known = Known2;
            if BitWidth > EltBitWidth {
                Known = Known.anyext(BitWidth);
            }
            break;
        },
        BITCAST => {
            if VT.isScalableVector() {
                return false;
            }
            let mut Src: SDValue = Op.getOperand(0);
            let mut SrcVT: EVT = Src.getValueType();
            let mut NumSrcEltBits: u32 = SrcVT.getScalarSizeInBits();
            if !TLO.LegalOperations() && !VT.isVector() && !SrcVT.isVector() && DemandedBits == getSignMask(Op.getValueSizeInBits().operator unsigned long long()) && SrcVT.isFloatingPoint() {
                if self.isOperationLegalOrCustom(FGETSIGN, VT, false) {
                    let mut Sign: SDValue = TLO.DAG.getNode(FGETSIGN, dl, VT, Src);
                    let mut ShVal: u32 = Op.getValueSizeInBits().operator unsigned long long() - 1;
                    let mut ShAmt: SDValue = TLO.DAG.getShiftAmountConstant(ShVal, VT, dl);
                    return TLO.CombineTo(Op, TLO.DAG.getNode(SHL, dl, VT, Sign, ShAmt));
                }
            }
            if SrcVT.isVector() && (BitWidth % NumSrcEltBits) == 0 {
                let mut Scale: u32 = BitWidth / NumSrcEltBits;
                let mut NumSrcElts: u32 = SrcVT.getVectorNumElements();
                let mut DemandedSrcBits: APInt = getZero(NumSrcEltBits);
                for let mut i: u32 = 0; i != Scale; i += 1 {
                    let mut EltOffset: u32 = if IsLE { i } else { (Scale - 1 - i) };
                    let mut BitOffset: u32 = EltOffset * NumSrcEltBits;
                    operator(DemandedSrcBits, DemandedBits.extractBits(NumSrcEltBits, BitOffset));
                }
                let mut DemandedSrcElts: APInt = ScaleBitMask(DemandedElts, NumSrcElts, false);
                let mut KnownSrcUndef: APInt = APInt {};
                let mut KnownSrcZero: APInt = APInt {};
                if self.SimplifyDemandedVectorElts(Src, DemandedSrcElts, KnownSrcUndef, KnownSrcZero, TLO, Depth + 1, false) {
                    return true;
                }
                let mut KnownSrcBits: KnownBits = KnownBits {};
                if self.SimplifyDemandedBits(Src, DemandedSrcBits, DemandedSrcElts, KnownSrcBits, TLO, Depth + 1, false) {
                    return true;
                }
            } else if IsLE && (NumSrcEltBits % BitWidth) == 0 {
                let mut Scale: u32 = NumSrcEltBits / BitWidth;
                let mut NumSrcElts: u32 = if SrcVT.isVector() { SrcVT.getVectorNumElements() } else { 1 };
                let mut DemandedSrcBits: APInt = getZero(NumSrcEltBits);
                let mut DemandedSrcElts: APInt = getZero(NumSrcElts);
                for let mut i: u32 = 0; i != NumElts; i += 1 {
                    if DemandedElts[i] {
                        let mut Offset: u32 = (i % Scale) * BitWidth;
                        DemandedSrcBits.insertBits(DemandedBits, Offset);
                        DemandedSrcElts.setBit(i / Scale);
                    }
                }
                if SrcVT.isVector() {
                    let mut KnownSrcUndef: APInt = APInt {};
                    let mut KnownSrcZero: APInt = APInt {};
                    if self.SimplifyDemandedVectorElts(Src, DemandedSrcElts, KnownSrcUndef, KnownSrcZero, TLO, Depth + 1, false) {
                        return true;
                    }
                }
                let mut KnownSrcBits: KnownBits = KnownBits {};
                if self.SimplifyDemandedBits(Src, DemandedSrcBits, DemandedSrcElts, KnownSrcBits, TLO, Depth + 1, false) {
                    return true;
                }
                if !DemandedSrcBits.isAllOnes() || !DemandedSrcElts.isAllOnes() {
                    if self.SimplifyMultipleUseDemandedBits(Src, DemandedSrcBits, DemandedSrcElts, TLO.DAG, Depth + 1) {
                        DemandedSrc;
                    } else {
                        let mut NewOp: SDValue = TLO.DAG.getBitcast(VT, DemandedSrc);
                        return TLO.CombineTo(Op, NewOp);
                    }
                }
            }
            if Depth > 0 {
                Known = TLO.DAG.computeKnownBits(Op, DemandedElts, Depth);
                return false;
            }
            break;
        },
        MUL => {
            if DemandedBits.isPowerOf2() {
                let mut CTZ: u32 = DemandedBits.countr_zero();
                let mut C: *mut ConstantSDNode = isConstOrConstSplat(Op.getOperand(1), DemandedElts, false, false);
                if C && C.getAPIntValue().countr_zero() == CTZ {
                    let mut AmtC: SDValue = TLO.DAG.getShiftAmountConstant(CTZ, VT, dl);
                    let mut Shl: SDValue = TLO.DAG.getNode(SHL, dl, VT, Op.getOperand(0), AmtC);
                    return TLO.CombineTo(Op, Shl);
                }
            }
        },
        PTRADD => {
            if Op.getOperand(0).getValueType() != Op.getOperand(1).getValueType() {
                break;
            }
        },
        ADD => {
            SUB;
        },
        FABS => {
            let mut Op0: SDValue = Op.getOperand(0);
            let mut SignMask: APInt = getSignMask(BitWidth);
            if !DemandedBits.intersects(SignMask) {
                return TLO.CombineTo(Op, Op0);
            }
            if self.SimplifyDemandedBits(Op0, DemandedBits, DemandedElts, Known, TLO, Depth + 1, false) {
                return true;
            }
            if Known.isNonNegative() {
                return TLO.CombineTo(Op, Op0);
            }
            if Known.isNegative() {
                return TLO.CombineTo(Op, TLO.DAG.getNode(FNEG, dl, VT, Op0, operator(Op).getFlags()));
            }
            operator(Known.Zero, SignMask);
            operator(Known.One, operator(SignMask));
            break;
        },
        FCOPYSIGN => {
            let mut Op0: SDValue = Op.getOperand(0);
            let mut Op1: SDValue = Op.getOperand(1);
            let mut BitWidth0: u32 = Op0.getScalarValueSizeInBits();
            let mut BitWidth1: u32 = Op1.getScalarValueSizeInBits();
            let mut SignMask0: APInt = getSignMask(BitWidth0);
            let mut SignMask1: APInt = getSignMask(BitWidth1);
            if !DemandedBits.intersects(SignMask0) {
                return TLO.CombineTo(Op, Op0);
            }
            if self.SimplifyDemandedBits(Op0, operator(SignMask0) & DemandedBits, DemandedElts, Known, TLO, Depth + 1, false) || self.SimplifyDemandedBits(Op1, SignMask1, DemandedElts, Known2, TLO, Depth + 1, false) {
                return true;
            }
            if Known2.isNonNegative() {
                return TLO.CombineTo(Op, TLO.DAG.getNode(FABS, dl, VT, Op0, operator(Op).getFlags()));
            }
            if Known2.isNegative() {
                return TLO.CombineTo(Op, TLO.DAG.getNode(FNEG, dl, VT, TLO.DAG.getNode(FABS, SDLoc { Op0 }, VT, Op0)));
            }
            operator(Known.Zero, operator(SignMask0));
            operator(Known.One, operator(SignMask0));
            break;
        },
        FNEG => {
            let mut Op0: SDValue = Op.getOperand(0);
            let mut SignMask: APInt = getSignMask(BitWidth);
            if !DemandedBits.intersects(SignMask) {
                return TLO.CombineTo(Op, Op0);
            }
            if self.SimplifyDemandedBits(Op0, DemandedBits, DemandedElts, Known, TLO, Depth + 1, false) {
                return true;
            }
            if !Known.isSignUnknown() {
                operator(Known.Zero, SignMask);
                operator(Known.One, SignMask);
            }
            break;
        },
        _ => {
            if Op.getOpcode() >= BUILTIN_OP_END || Op.getOpcode() == INTRINSIC_WO_CHAIN {
                if Op.getValueType().isScalableVector() {
                    break;
                }
                if self.SimplifyDemandedBitsForTargetNode(Op, DemandedBits, DemandedElts, Known, TLO, Depth) {
                    return true;
                }
                break;
            }
        },
    }
    if !self.isTargetCanonicalConstantNode(Op) && DemandedBits.isSubsetOf(Known.Zero | Known.One) {
        if any_of(operator(Op).ops(), Closure_3 {}) {
            return false;
        }
        if VT.isInteger() {
            return TLO.CombineTo(Op, TLO.DAG.getConstant(Known.One, dl, VT, false, false));
        }
        if VT.isFloatingPoint() {
            return TLO.CombineTo(Op, TLO.DAG.getConstantFP(APFloat { VT.getFltSemantics(), Known.One }, dl, VT, false));
        }
    }
    if HasMultiUse && Known.isUnknown() && !OriginalDemandedElts.isAllOnes() {
        Known = TLO.DAG.computeKnownBits(Op, OriginalDemandedElts, Depth);
    }
    return false;
}

fn TargetLowering::SimplifyDemandedVectorElts(self: *TargetLowering, Op: SDValue, DemandedElts: *APInt, DCI: *mut DAGCombinerInfo) -> bool {
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut TLO: TargetLoweringOpt = TargetLoweringOpt { DAG, !DCI.isBeforeLegalize(), !DCI.isBeforeLegalizeOps() };
    let mut KnownUndef: APInt = APInt {};
    let mut KnownZero: APInt = APInt {};
    let mut Simplified: bool = self.SimplifyDemandedVectorElts(Op, DemandedElts, KnownUndef, KnownZero, TLO, 0, false);
    if Simplified {
        DCI.AddToWorklist(Op.getNode());
        DCI.CommitTargetLoweringOpt(TLO);
    }
    return Simplified;
}

fn getKnownUndefForVectorBinop(BO: SDValue, DAG: *mut SelectionDAG, UndefOp0: *APInt, UndefOp1: *APInt) -> APInt {
    let mut VT: EVT = BO.getValueType();
    assert!(DAG.getTargetLoweringInfo().isBinOp(BO.getOpcode()) && VT.isVector(), "Vector binop only");
    let mut EltVT: EVT = VT.getVectorElementType();
    let mut NumElts: u32 = if VT.isFixedLengthVector() { VT.getVectorNumElements() } else { 1 };
    assert!(UndefOp0.getBitWidth() == NumElts && UndefOp1.getBitWidth() == NumElts, "Bad type for undef analysis");
    let mut getUndefOrConstantElt: Closure_4 = Closure_4 { DAG: &mut DAG, EltVT: &mut EltVT };
    let mut KnownUndef: APInt = getZero(NumElts);
    for let mut i: u32 = 0; i != NumElts; i += 1 {
        let mut C0: SDValue = getUndefOrConstantElt.call(BO.getOperand(0), i, UndefOp0);
        let mut C1: SDValue = getUndefOrConstantElt.call(BO.getOperand(1), i, UndefOp1);
        if C0 && C1 && C0.getValueType() == EltVT && C1.getValueType() == EltVT {
            if DAG.getNode(BO.getOpcode(), SDLoc { BO }, EltVT, C0, C1).isUndef() {
                KnownUndef.setBit(i);
            }
        }
    }
    return KnownUndef;
}

fn TargetLowering::SimplifyDemandedVectorElts(self: *TargetLowering, Op: SDValue, OriginalDemandedElts: *APInt, KnownUndef: *mut APInt, KnownZero: *mut APInt, TLO: *mut TargetLoweringOpt, Depth: u32, AssumeSingleUse: bool) -> bool {
    let mut VT: EVT = Op.getValueType();
    let mut Opcode: u32 = Op.getOpcode();
    let mut DemandedElts: APInt = OriginalDemandedElts;
    let mut NumElts: u32 = DemandedElts.getBitWidth();
    assert!(VT.isVector(), "Expected vector op");
    KnownUndef = KnownZero = getZero(NumElts);
    if !self.shouldSimplifyDemandedVectorElts(Op, TLO) {
        return false;
    }
    if VT.isScalableVector() {
        return false;
    }
    assert!(VT.getVectorNumElements() == NumElts, "Mask size mismatches value type element count!");
    if Op.isUndef() {
        KnownUndef.setAllBits();
        return false;
    }
    if !AssumeSingleUse && !Op.getNode().hasOneUse() {
        DemandedElts.setAllBits();
    }
    if DemandedElts == 0 {
        KnownUndef.setAllBits();
        return TLO.CombineTo(Op, TLO.DAG.getUNDEF(VT));
    }
    if Depth >= MaxRecursionDepth {
        return false;
    }
    let mut DL: SDLoc = SDLoc { Op };
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    let mut IsLE: bool = TLO.DAG.getDataLayout().isLittleEndian();
    let mut TryShrinkBinOp: Closure_5 = Closure_5 { cap_0: self, Op: &mut Op, DemandedElts: &mut DemandedElts, EltSizeInBits: &mut EltSizeInBits, VT: &mut VT, TLO: &mut TLO, DL: &mut DL, Opcode: &mut Opcode };
    let mut SimplifyDemandedVectorEltsBinOp: Closure_6 = Closure_6 { cap_0: self, DemandedElts: &mut DemandedElts, TLO: &mut TLO, Depth: &mut Depth, Opcode: &mut Opcode, Op: &mut Op, VT: &mut VT, TryShrinkBinOp: &mut TryShrinkBinOp };
    match Opcode {
        SCALAR_TO_VECTOR => {
            if !DemandedElts[0] {
                return TLO.CombineTo(Op, TLO.DAG.getPOISON(VT));
            }
            break;
        },
        BITCAST => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut SrcVT: EVT = Src.getValueType();
            if !SrcVT.isVector() {
                if IsLE {
                    let mut DemandedSrcBits: APInt = getZero(SrcVT.getSizeInBits().operator unsigned long long());
                    let mut EltSize: u32 = VT.getScalarSizeInBits();
                    for let mut I: u32 = 0; I != NumElts; I += 1 {
                        if DemandedElts[I] {
                            let mut Offset: u32 = I * EltSize;
                            DemandedSrcBits.setBits(Offset, Offset + EltSize);
                        }
                    }
                    let mut Known: KnownBits = KnownBits {};
                    if self.SimplifyDemandedBits(Src, DemandedSrcBits, Known, TLO, Depth + 1, false) {
                        return true;
                    }
                }
                break;
            }
            let mut NumSrcElts: u32 = SrcVT.getVectorNumElements();
            if NumSrcElts == NumElts {
                return self.SimplifyDemandedVectorElts(Src, DemandedElts, KnownUndef, KnownZero, TLO, Depth + 1, false);
            }
            let mut SrcDemandedElts: APInt = APInt {};
            let mut SrcZero: APInt = APInt {};
            let mut SrcUndef: APInt = APInt {};
            if (NumElts % NumSrcElts) == 0 {
                let mut Scale: u32 = NumElts / NumSrcElts;
                SrcDemandedElts = ScaleBitMask(DemandedElts, NumSrcElts, false);
                if self.SimplifyDemandedVectorElts(Src, SrcDemandedElts, SrcUndef, SrcZero, TLO, Depth + 1, false) {
                    return true;
                }
                if IsLE {
                    let mut SrcEltSizeInBits: u32 = SrcVT.getScalarSizeInBits();
                    let mut SrcDemandedBits: APInt = getZero(SrcEltSizeInBits);
                    for let mut i: u32 = 0; i != NumElts; i += 1 {
                        if DemandedElts[i] {
                            let mut Ofs: u32 = (i % Scale) * EltSizeInBits;
                            SrcDemandedBits.setBits(Ofs, Ofs + EltSizeInBits);
                        }
                    }
                    let mut Known: KnownBits = KnownBits {};
                    if self.SimplifyDemandedBits(Src, SrcDemandedBits, SrcDemandedElts, Known, TLO, Depth + 1, false) {
                        return true;
                    }
                    for let mut SubElt: u32 = 0; SubElt != Scale; SubElt += 1 {
                        if !Known.Zero.extractBits(EltSizeInBits, SubElt * EltSizeInBits).isAllOnes() {
                            continue;
                        }
                        for let mut SrcElt: u32 = 0; SrcElt != NumSrcElts; SrcElt += 1 {
                            let mut Elt: u32 = Scale * SrcElt + SubElt;
                            if DemandedElts[Elt] && !SrcUndef[SrcElt] {
                                KnownZero.setBit(Elt);
                            }
                        }
                    }
                }
                for let mut i: u32 = 0; i != NumSrcElts; i += 1 {
                    if SrcDemandedElts[i] {
                        if SrcZero[i] {
                            KnownZero.setBits(i * Scale, (i + 1) * Scale);
                        }
                        if SrcUndef[i] {
                            KnownUndef.setBits(i * Scale, (i + 1) * Scale);
                        }
                    }
                }
            }
            if (NumSrcElts % NumElts) == 0 {
                let mut Scale: u32 = NumSrcElts / NumElts;
                SrcDemandedElts = ScaleBitMask(DemandedElts, NumSrcElts, false);
                if self.SimplifyDemandedVectorElts(Src, SrcDemandedElts, SrcUndef, SrcZero, TLO, Depth + 1, false) {
                    return true;
                }
                for let mut i: u32 = 0; i != NumElts; i += 1 {
                    if DemandedElts[i] {
                        if SrcZero.extractBits(Scale, i * Scale).isAllOnes() {
                            KnownZero.setBit(i);
                        }
                        if SrcUndef.extractBits(Scale, i * Scale).isAllOnes() {
                            KnownUndef.setBit(i);
                        }
                    }
                }
            }
            break;
        },
        FREEZE => {
            let mut N0: SDValue = Op.getOperand(0);
            if TLO.DAG.isGuaranteedNotToBeUndefOrPoison(N0, DemandedElts, UndefOrPoison, Depth + 1) {
                return TLO.CombineTo(Op, N0);
            }
            if N0.getOpcode() == SCALAR_TO_VECTOR && DemandedElts == 1 {
                let mut Scalar: SDValue = N0.getOperand(0);
                let mut IsPromotedLoad: bool = Scalar.getOpcode() == LOAD && Scalar.getValueType() != VT.getVectorElementType();
                if !IsPromotedLoad {
                    return TLO.CombineTo(Op, TLO.DAG.getNode(SCALAR_TO_VECTOR, DL, VT, TLO.DAG.getFreeze(Scalar)));
                }
            }
            break;
        },
        BUILD_VECTOR => {
            if !DemandedElts.isAllOnes() {
                if any_of(operator(Op).op_values(), Closure_7 { Op: &mut Op }) {
                    let mut Ops: SmallVector<SDValue, 32> = SmallVector<SDValue, 32> { operator(Op).ops() };
                    let mut Updated: bool = false;
                    for let mut i: u32 = 0; i != NumElts; i += 1 {
                        if !DemandedElts[i] && !Ops[i].isUndef() {
                            Ops[i] = TLO.DAG.getUNDEF(Ops[0].getValueType());
                            KnownUndef.setBit(i);
                            Updated = true;
                        }
                    }
                    if Updated {
                        return TLO.CombineTo(Op, TLO.DAG.getBuildVector(VT, DL, ArrayRef<SDValue> { Ops }));
                    }
                }
            }
            for let mut i: u32 = 0; i != NumElts; i += 1 {
                let mut SrcOp: SDValue = Op.getOperand(i);
                if SrcOp.isUndef() {
                    KnownUndef.setBit(i);
                } else if EltSizeInBits == SrcOp.getScalarValueSizeInBits() && (isNullConstant(SrcOp) || isNullFPConstant(SrcOp)) {
                    KnownZero.setBit(i);
                }
            }
            break;
        },
        CONCAT_VECTORS => {
            let mut SubVT: EVT = Op.getOperand(0).getValueType();
            let mut NumSubVecs: u32 = Op.getNumOperands();
            let mut NumSubElts: u32 = SubVT.getVectorNumElements();
            for let mut i: u32 = 0; i != NumSubVecs; i += 1 {
                let mut SubOp: SDValue = Op.getOperand(i);
                let mut SubElts: APInt = DemandedElts.extractBits(NumSubElts, i * NumSubElts);
                let mut SubUndef: APInt = APInt {};
                let mut SubZero: APInt = APInt {};
                if self.SimplifyDemandedVectorElts(SubOp, SubElts, SubUndef, SubZero, TLO, Depth + 1, false) {
                    return true;
                }
                KnownUndef.insertBits(SubUndef, i * NumSubElts);
                KnownZero.insertBits(SubZero, i * NumSubElts);
            }
            if !DemandedElts.isAllOnes() {
                let mut FoundNewSub: bool = false;
                let mut DemandedSubOps: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
                for let mut i: u32 = 0; i != NumSubVecs; i += 1 {
                    let mut SubOp: SDValue = Op.getOperand(i);
                    let mut SubElts: APInt = DemandedElts.extractBits(NumSubElts, i * NumSubElts);
                    let mut NewSubOp: SDValue = self.SimplifyMultipleUseDemandedVectorElts(SubOp, SubElts, TLO.DAG, Depth + 1);
                    DemandedSubOps.push(ValueParamT { if NewSubOp {} else { SubOp } });
                    FoundNewSub = if NewSubOp { true } else { FoundNewSub };
                }
                if FoundNewSub {
                    let mut NewOp: SDValue = TLO.DAG.getNode(Op.getOpcode(), SDLoc { Op }, VT, ArrayRef<SDValue> { DemandedSubOps });
                    return TLO.CombineTo(Op, NewOp);
                }
            }
            break;
        },
        INSERT_SUBVECTOR => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut Sub: SDValue = Op.getOperand(1);
            let mut Idx: u64 = Op.getConstantOperandVal(2);
            let mut NumSubElts: u32 = Sub.getValueType().getVectorNumElements();
            let mut DemandedSubElts: APInt = DemandedElts.extractBits(NumSubElts, Idx);
            let mut DemandedSrcElts: APInt = DemandedElts;
            DemandedSrcElts.clearBits(Idx, Idx + NumSubElts);
            if operator(DemandedSubElts) {
                return TLO.CombineTo(Op, Src);
            }
            let mut SubUndef: APInt = APInt {};
            let mut SubZero: APInt = APInt {};
            if self.SimplifyDemandedVectorElts(Sub, DemandedSubElts, SubUndef, SubZero, TLO, Depth + 1, false) {
                return true;
            }
            if operator(DemandedSrcElts) && !Src.isUndef() {
                return TLO.CombineTo(Op, TLO.DAG.getNode(INSERT_SUBVECTOR, DL, VT, TLO.DAG.getUNDEF(VT), Sub, Op.getOperand(2)));
            }
            if self.SimplifyDemandedVectorElts(Src, DemandedSrcElts, KnownUndef, KnownZero, TLO, Depth + 1, false) {
                return true;
            }
            KnownUndef.insertBits(SubUndef, Idx);
            KnownZero.insertBits(SubZero, Idx);
            if !DemandedSrcElts.isAllOnes() || !DemandedSubElts.isAllOnes() {
                let mut NewSrc: SDValue = self.SimplifyMultipleUseDemandedVectorElts(Src, DemandedSrcElts, TLO.DAG, Depth + 1);
                let mut NewSub: SDValue = self.SimplifyMultipleUseDemandedVectorElts(Sub, DemandedSubElts, TLO.DAG, Depth + 1);
                if NewSrc || NewSub {
                    NewSrc = if NewSrc {} else { Src };
                    NewSub = if NewSub {} else { Sub };
                    let mut NewOp: SDValue = TLO.DAG.getNode(Op.getOpcode(), SDLoc { Op }, VT, NewSrc, NewSub, Op.getOperand(2));
                    return TLO.CombineTo(Op, NewOp);
                }
            }
            break;
        },
        EXTRACT_SUBVECTOR => {
            let mut Src: SDValue = Op.getOperand(0);
            if Src.getValueType().isScalableVector() {
                break;
            }
            let mut Idx: u64 = Op.getConstantOperandVal(1);
            let mut NumSrcElts: u32 = Src.getValueType().getVectorNumElements();
            let mut DemandedSrcElts: APInt = DemandedElts.zext(NumSrcElts).shl(Idx);
            let mut SrcUndef: APInt = APInt {};
            let mut SrcZero: APInt = APInt {};
            if self.SimplifyDemandedVectorElts(Src, DemandedSrcElts, SrcUndef, SrcZero, TLO, Depth + 1, false) {
                return true;
            }
            KnownUndef = SrcUndef.extractBits(NumElts, Idx);
            KnownZero = SrcZero.extractBits(NumElts, Idx);
            let mut NewSrc: SDValue = self.SimplifyMultipleUseDemandedVectorElts(Src, DemandedSrcElts, TLO.DAG, Depth + 1);
            if NewSrc {
                let mut NewOp: SDValue = TLO.DAG.getNode(Op.getOpcode(), SDLoc { Op }, VT, NewSrc, Op.getOperand(1));
                return TLO.CombineTo(Op, NewOp);
            }
            break;
        },
        INSERT_VECTOR_ELT => {
            let mut Vec: SDValue = Op.getOperand(0);
            let mut Scl: SDValue = Op.getOperand(1);
            let mut CIdx: *mut ConstantSDNode = dyn_cast(Op.getOperand(2));
            if CIdx && CIdx.getAPIntValue().ult(NumElts) {
                let mut Idx: u32 = CIdx.getZExtValue();
                if !DemandedElts[Idx] {
                    return TLO.CombineTo(Op, Vec);
                }
                let mut DemandedVecElts: APInt = DemandedElts;
                DemandedVecElts.clearBit(Idx);
                if self.SimplifyDemandedVectorElts(Vec, DemandedVecElts, KnownUndef, KnownZero, TLO, Depth + 1, false) {
                    return true;
                }
                KnownUndef.setBitVal(Idx, Scl.isUndef());
                KnownZero.setBitVal(Idx, isNullConstant(Scl) || isNullFPConstant(Scl));
                break;
            }
            let mut VecUndef: APInt = APInt {};
            let mut VecZero: APInt = APInt {};
            if self.SimplifyDemandedVectorElts(Vec, DemandedElts, VecUndef, VecZero, TLO, Depth + 1, false) {
                return true;
            }
            break;
        },
        VSELECT => {
            let mut Sel: SDValue = Op.getOperand(0);
            let mut LHS: SDValue = Op.getOperand(1);
            let mut RHS: SDValue = Op.getOperand(2);
            let mut UndefSel: APInt = APInt {};
            let mut ZeroSel: APInt = APInt {};
            if self.SimplifyDemandedVectorElts(Sel, DemandedElts, UndefSel, ZeroSel, TLO, Depth + 1, false) {
                return true;
            }
            let mut DemandedLHS: APInt = DemandedElts;
            let mut DemandedRHS: APInt = DemandedElts;
            let mut UndefLHS: APInt = APInt {};
            let mut ZeroLHS: APInt = APInt {};
            let mut UndefRHS: APInt = APInt {};
            let mut ZeroRHS: APInt = APInt {};
            if self.SimplifyDemandedVectorElts(LHS, DemandedLHS, UndefLHS, ZeroLHS, TLO, Depth + 1, false) {
                return true;
            }
            if self.SimplifyDemandedVectorElts(RHS, DemandedRHS, UndefRHS, ZeroRHS, TLO, Depth + 1, false) {
                return true;
            }
            KnownUndef = UndefLHS & UndefRHS;
            KnownZero = ZeroLHS & ZeroRHS;
            let mut DemandedSel: APInt = DemandedElts & operator(KnownZero);
            if DemandedSel != DemandedElts {
                if self.SimplifyDemandedVectorElts(Sel, DemandedSel, UndefSel, ZeroSel, TLO, Depth + 1, false) {
                    return true;
                }
            }
            break;
        },
        VECTOR_SHUFFLE => {
            let mut LHS: SDValue = Op.getOperand(0);
            let mut RHS: SDValue = Op.getOperand(1);
            let mut ShuffleMask: ArrayRef<int> = cast(Op).getMask();
            let mut DemandedLHS: APInt = APInt { NumElts, 0, false, false };
            let mut DemandedRHS: APInt = APInt { NumElts, 0, false, false };
            for let mut i: u32 = 0; i != NumElts; i += 1 {
                let mut M: i32 = ShuffleMask[i];
                if M < 0 || !DemandedElts[i] {
                    continue;
                }
                assert!(0 <= M && M < (2 * NumElts) as i32, "Shuffle index out of range");
                if M < NumElts as i32 {
                    DemandedLHS.setBit(M);
                } else {
                    DemandedRHS.setBit(M - NumElts);
                }
            }
            let mut FoldLHS: bool = operator(DemandedLHS) && !LHS.isUndef();
            let mut FoldRHS: bool = operator(DemandedRHS) && !RHS.isUndef();
            if FoldLHS || FoldRHS {
                LHS = if FoldLHS { TLO.DAG.getUNDEF(LHS.getValueType()) } else { LHS };
                RHS = if FoldRHS { TLO.DAG.getUNDEF(RHS.getValueType()) } else { RHS };
                let mut NewOp: SDValue = TLO.DAG.getVectorShuffle(VT, SDLoc { Op }, LHS, RHS, ShuffleMask);
                return TLO.CombineTo(Op, NewOp);
            }
            let mut UndefLHS: APInt = APInt {};
            let mut ZeroLHS: APInt = APInt {};
            let mut UndefRHS: APInt = APInt {};
            let mut ZeroRHS: APInt = APInt {};
            if self.SimplifyDemandedVectorElts(LHS, DemandedLHS, UndefLHS, ZeroLHS, TLO, Depth + 1, false) {
                return true;
            }
            if self.SimplifyDemandedVectorElts(RHS, DemandedRHS, UndefRHS, ZeroRHS, TLO, Depth + 1, false) {
                return true;
            }
            let mut Updated: bool = false;
            let mut IdentityLHS: bool = true;
            let mut IdentityRHS: bool = true;
            let mut NewMask: SmallVector<int, 32> = SmallVector<int, 32> { ShuffleMask };
            for let mut i: u32 = 0; i != NumElts; i += 1 {
                let mut M: *mut i32 = NewMask[i];
                if M < 0 {
                    continue;
                }
                if !DemandedElts[i] || (M < NumElts as i32 && UndefLHS[M]) || (M >= NumElts as i32 && UndefRHS[M - NumElts]) {
                    Updated = true;
                    M = -1;
                }
                IdentityLHS &= (M < 0) || (M == i as i32);
                IdentityRHS &= (M < 0) || ((M - NumElts) == i);
            }
            if Updated && !IdentityLHS && !IdentityRHS && !TLO.LegalOps {
                let mut LegalShuffle: SDValue = self.buildLegalVectorShuffle(VT, DL, LHS, RHS, MutableArrayRef<int> { NewMask }, TLO.DAG);
                if LegalShuffle {
                    return TLO.CombineTo(Op, LegalShuffle);
                }
            }
            for let mut i: u32 = 0; i != NumElts; i += 1 {
                let mut M: i32 = ShuffleMask[i];
                if M < 0 {
                    KnownUndef.setBit(i);
                } else if M < NumElts as i32 {
                    if UndefLHS[M] {
                        KnownUndef.setBit(i);
                    }
                    if ZeroLHS[M] {
                        KnownZero.setBit(i);
                    }
                } else {
                    if UndefRHS[M - NumElts] {
                        KnownUndef.setBit(i);
                    }
                    if ZeroRHS[M - NumElts] {
                        KnownZero.setBit(i);
                    }
                }
            }
            break;
        },
        ANY_EXTEND_VECTOR_INREG => {
            SIGN_EXTEND_VECTOR_INREG;
        },
        ADD => {
            let mut Op0: SDValue = Op.getOperand(0);
            let mut Op1: SDValue = Op.getOperand(1);
            if Op0 == Op1 && operator(Op).isOnlyUserOf(Op0.getNode()) {
                let mut UndefLHS: APInt = APInt {};
                let mut ZeroLHS: APInt = APInt {};
                if self.SimplifyDemandedVectorElts(Op0, DemandedElts, UndefLHS, ZeroLHS, TLO, Depth + 1, true) {
                    return true;
                }
            }
        },
        AVGCEILS => {
            AVGCEILU;
        },
        SHL => {
            SRL;
        },
        MUL => {
            MULHU;
        },
        TRUNCATE => {
            SIGN_EXTEND;
        },
        SINT_TO_FP => {
            UINT_TO_FP;
        },
        _ => {
            if Op.getOpcode() >= BUILTIN_OP_END {
                if self.SimplifyDemandedVectorEltsForTargetNode(Op, DemandedElts, KnownUndef, KnownZero, TLO, Depth) {
                    return true;
                }
            } else {
                let mut Known: KnownBits = KnownBits {};
                let mut DemandedBits: APInt = getAllOnes(EltSizeInBits);
                if self.SimplifyDemandedBits(Op, DemandedBits, OriginalDemandedElts, Known, TLO, Depth, AssumeSingleUse) {
                    return true;
                }
            }
            break;
        },
    }
    assert!((KnownUndef & KnownZero) == 0, "Elements flagged as undef AND zero");
    if DemandedElts.isSubsetOf(KnownUndef) {
        return TLO.CombineTo(Op, TLO.DAG.getUNDEF(VT));
    }
    return false;
}

fn TargetLowering::computeKnownBitsForTargetNode(self: *TargetLowering, Op: SDValue, Known: *mut KnownBits, DemandedElts: *APInt, DAG: *SelectionDAG, Depth: u32) {
    assert!((Op.getOpcode() >= BUILTIN_OP_END || Op.getOpcode() == INTRINSIC_WO_CHAIN || Op.getOpcode() == INTRINSIC_W_CHAIN || Op.getOpcode() == INTRINSIC_VOID), "Should use MaskedValueIsZero if you don't know whether Op is a target node!");
    Known.resetAll();
}

fn TargetLowering::computeKnownBitsForTargetInstr(self: *TargetLowering, Analysis: *mut GISelValueTracking, R: Register, Known: *mut KnownBits, DemandedElts: *APInt, MRI: *MachineRegisterInfo, Depth: u32) {
    Known.resetAll();
}

fn TargetLowering::computeKnownFPClassForTargetInstr(self: *TargetLowering, Analysis: *mut GISelValueTracking, R: Register, Known: *mut KnownFPClass, DemandedElts: *APInt, MRI: *MachineRegisterInfo, Depth: u32) {
    Known.resetAll();
}

fn TargetLowering::computeKnownBitsForStackObjectPointer(self: *TargetLowering, Known: *mut KnownBits, arg: *MachineFunction, Alignment: Align) {
    Known.Zero.setLowBits(Log2(Alignment));
}

fn TargetLowering::annotateStackObjectPointer(self: *TargetLowering, Ptr: SDValue, DAG: *mut SelectionDAG, DL: *SDLoc, Alignment: Align) -> SDValue {
    let mut PtrVT: EVT = Ptr.getValueType();
    let mut RegSize: u32 = PtrVT.getScalarSizeInBits();
    let mut Known: KnownBits = KnownBits { RegSize };
    self.computeKnownBitsForStackObjectPointer(Known, DAG.getMachineFunction(), Alignment);
    let mut NumZeroBits: u32 = Known.countMinLeadingZeros();
    if !NumZeroBits {
        return Ptr;
    }
    let mut FromVT: EVT = getIntegerVT(*DAG.getContext(), RegSize - NumZeroBits);
    return DAG.getNode(AssertZext, DL, PtrVT, Ptr, DAG.getValueType(FromVT));
}

fn TargetLowering::computeKnownAlignForTargetInstr(self: *TargetLowering, Analysis: *mut GISelValueTracking, R: Register, MRI: *MachineRegisterInfo, Depth: u32) -> Align {
    return Align { ShiftValue: 1 };
}

fn TargetLowering::ComputeNumSignBitsForTargetNode(self: *TargetLowering, Op: SDValue, arg: *APInt, arg: *SelectionDAG, Depth: u32) -> u32 {
    assert!((Op.getOpcode() >= BUILTIN_OP_END || Op.getOpcode() == INTRINSIC_WO_CHAIN || Op.getOpcode() == INTRINSIC_W_CHAIN || Op.getOpcode() == INTRINSIC_VOID), "Should use ComputeNumSignBits if you don't know whether Op is a target node!");
    return 1;
}

fn TargetLowering::computeNumSignBitsForTargetInstr(self: *TargetLowering, Analysis: *mut GISelValueTracking, R: Register, DemandedElts: *APInt, MRI: *MachineRegisterInfo, Depth: u32) -> u32 {
    return 1;
}

fn TargetLowering::SimplifyDemandedVectorEltsForTargetNode(self: *TargetLowering, Op: SDValue, DemandedElts: *APInt, KnownUndef: *mut APInt, KnownZero: *mut APInt, TLO: *mut TargetLoweringOpt, Depth: u32) -> bool {
    assert!((Op.getOpcode() >= BUILTIN_OP_END || Op.getOpcode() == INTRINSIC_WO_CHAIN || Op.getOpcode() == INTRINSIC_W_CHAIN || Op.getOpcode() == INTRINSIC_VOID), "Should use SimplifyDemandedVectorElts if you don't know whether Op is a target node!");
    return false;
}

fn TargetLowering::SimplifyDemandedBitsForTargetNode(self: *TargetLowering, Op: SDValue, DemandedBits: *APInt, DemandedElts: *APInt, Known: *mut KnownBits, TLO: *mut TargetLoweringOpt, Depth: u32) -> bool {
    assert!((Op.getOpcode() >= BUILTIN_OP_END || Op.getOpcode() == INTRINSIC_WO_CHAIN || Op.getOpcode() == INTRINSIC_W_CHAIN || Op.getOpcode() == INTRINSIC_VOID), "Should use SimplifyDemandedBits if you don't know whether Op is a target node!");
    self.computeKnownBitsForTargetNode(Op, Known, DemandedElts, TLO.DAG, Depth);
    return false;
}

fn TargetLowering::SimplifyMultipleUseDemandedBitsForTargetNode(self: *TargetLowering, Op: SDValue, DemandedBits: *APInt, DemandedElts: *APInt, DAG: *mut SelectionDAG, Depth: u32) -> SDValue {
    assert!((Op.getOpcode() >= BUILTIN_OP_END || Op.getOpcode() == INTRINSIC_WO_CHAIN || Op.getOpcode() == INTRINSIC_W_CHAIN || Op.getOpcode() == INTRINSIC_VOID), "Should use SimplifyMultipleUseDemandedBits if you don't know whether Op is a target node!");
    return SDValue {};
}

fn TargetLowering::buildLegalVectorShuffle(self: *TargetLowering, VT: EVT, DL: *SDLoc, N0: SDValue, N1: SDValue, Mask: MutableArrayRef<int>, DAG: *mut SelectionDAG) -> SDValue {
    let mut LegalMask: bool = self.isShuffleMaskLegal(ArrayRef<int> { Mask }, VT);
    if !LegalMask {
        swap(N0, N1);
        commuteMask(Mask);
        LegalMask = self.isShuffleMaskLegal(ArrayRef<int> { Mask }, VT);
    }
    if !LegalMask {
        return SDValue {};
    }
    return DAG.getVectorShuffle(VT, DL, N0, N1, ArrayRef<int> { Mask });
}

fn TargetLowering::getTargetConstantFromLoad(self: *TargetLowering, arg: *mut LoadSDNode) -> *Constant {
    return null;
}

fn TargetLowering::isGuaranteedNotToBeUndefOrPoisonForTargetNode(self: *TargetLowering, Op: SDValue, DemandedElts: *APInt, DAG: *SelectionDAG, Kind: UndefPoisonKind, Depth: u32) -> bool {
    assert!((Op.getOpcode() >= BUILTIN_OP_END || Op.getOpcode() == INTRINSIC_WO_CHAIN || Op.getOpcode() == INTRINSIC_W_CHAIN || Op.getOpcode() == INTRINSIC_VOID), "Should use isGuaranteedNotToBeUndefOrPoison if you don't know whether Op is a target node!");
    return !self.canCreateUndefOrPoisonForTargetNode(Op, DemandedElts, DAG, Kind, true, Depth) && all_of(operator(Op).ops(), Closure_8 { DAG: &mut DAG, Kind: &mut Kind, Depth: &mut Depth });
}

fn TargetLowering::canCreateUndefOrPoisonForTargetNode(self: *TargetLowering, Op: SDValue, DemandedElts: *APInt, DAG: *SelectionDAG, Kind: UndefPoisonKind, ConsiderFlags: bool, Depth: u32) -> bool {
    assert!((Op.getOpcode() >= BUILTIN_OP_END || Op.getOpcode() == INTRINSIC_WO_CHAIN || Op.getOpcode() == INTRINSIC_W_CHAIN || Op.getOpcode() == INTRINSIC_VOID), "Should use canCreateUndefOrPoison if you don't know whether Op is a target node!");
    return true;
}

fn TargetLowering::computeKnownFPClassForTargetNode(self: *TargetLowering, Op: SDValue, Known: *mut KnownFPClass, DemandedElts: *APInt, DAG: *SelectionDAG, Depth: u32) {
    assert!((Op.getOpcode() >= BUILTIN_OP_END || Op.getOpcode() == INTRINSIC_WO_CHAIN || Op.getOpcode() == INTRINSIC_W_CHAIN || Op.getOpcode() == INTRINSIC_VOID), "Should use computeKnownFPClass if you don't know whether Op is a target node!");
}

fn TargetLowering::isKnownNeverNaNForTargetNode(self: *TargetLowering, Op: SDValue, DemandedElts: *APInt, DAG: *SelectionDAG, SNaN: bool, Depth: u32) -> bool {
    assert!((Op.getOpcode() >= BUILTIN_OP_END || Op.getOpcode() == INTRINSIC_WO_CHAIN || Op.getOpcode() == INTRINSIC_W_CHAIN || Op.getOpcode() == INTRINSIC_VOID), "Should use isKnownNeverNaN if you don't know whether Op is a target node!");
    return false;
}

fn TargetLowering::isSplatValueForTargetNode(self: *TargetLowering, Op: SDValue, DemandedElts: *APInt, UndefElts: *mut APInt, DAG: *SelectionDAG, Depth: u32) -> bool {
    assert!((Op.getOpcode() >= BUILTIN_OP_END || Op.getOpcode() == INTRINSIC_WO_CHAIN || Op.getOpcode() == INTRINSIC_W_CHAIN || Op.getOpcode() == INTRINSIC_VOID), "Should use isSplatValue if you don't know whether Op is a target node!");
    return false;
}

fn TargetLowering::isConstTrueVal(self: *TargetLowering, N: SDValue) -> bool {
    if !N {
        return false;
    }
    let mut EltWidth: u32 = 0;
    let mut CVal: APInt = APInt {};
    if isConstOrConstSplat(N, false, true) {
        CN;
    } else {
        CVal = CN.getAPIntValue();
        EltWidth = N.getValueType().getScalarSizeInBits();
    }
    if EltWidth < CVal.getBitWidth() {
        CVal = CVal.trunc(EltWidth);
    }
    match self.getBooleanContents(N.getValueType()) {
        UndefinedBooleanContent => {
            return CVal[0];
        },
        ZeroOrOneBooleanContent => {
            return CVal.isOne();
        },
        ZeroOrNegativeOneBooleanContent => {
            return CVal.isAllOnes();
        },
    }
    llvm_unreachable_internal("Invalid boolean contents", "llvm\\lib\\CodeGen\\SelectionDAG\\TargetLowering.cpp", 4343);
}

fn TargetLowering::isConstFalseVal(self: *TargetLowering, N: SDValue) -> bool {
    if !N {
        return false;
    }
    let mut CN: *ConstantSDNode = dyn_cast(N);
    if !CN {
        let mut BV: *BuildVectorSDNode = dyn_cast(N);
        if !BV {
            return false;
        }
        CN = BV.getConstantSplatNode(null);
        if !CN {
            return false;
        }
    }
    if self.getBooleanContents(operator(N).getValueType(0)) == UndefinedBooleanContent {
        return !CN.getAPIntValue()[0];
    }
    return CN.isZero();
}

fn TargetLowering::isExtendedTrueVal(self: *TargetLowering, N: *ConstantSDNode, VT: EVT, SExt: bool) -> bool {
    if VT == EVT { i1 } {
        return N.isOne();
    }
    let mut Cnt: BooleanContent = self.getBooleanContents(VT);
    match Cnt {
        ZeroOrOneBooleanContent => {
            return (N.isOne() && !SExt) || (SExt && (N.getValueType(0) != EVT { i1 }));
        },
        UndefinedBooleanContent => {
            ZeroOrNegativeOneBooleanContent;
        },
    }
    llvm_unreachable_internal("Unexpected enumeration.", "llvm\\lib\\CodeGen\\SelectionDAG\\TargetLowering.cpp", 4385);
}

fn TargetLowering::foldSetCCWithAnd(self: *TargetLowering, VT: EVT, N0: SDValue, N1: SDValue, Cond: CondCode, DL: *SDLoc, DCI: *mut DAGCombinerInfo) -> SDValue {
    if N1.getOpcode() == AND && N0.getOpcode() != AND {
        swap(N0, N1);
    }
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut OpVT: EVT = N0.getValueType();
    if N0.getOpcode() != AND || !OpVT.isInteger() || (Cond != SETEQ && Cond != SETNE) {
        return SDValue {};
    }
    if Cond == SETNE && isNullConstant(N1) && (self.getBooleanContents(OpVT) == UndefinedBooleanContent || self.getBooleanContents(OpVT) == ZeroOrOneBooleanContent) {
        let mut NumEltBits: u32 = OpVT.getScalarSizeInBits();
        let mut UpperBits: APInt = getHighBitsSet(NumEltBits, NumEltBits - 1);
        if DAG.MaskedValueIsZero(N0, UpperBits, 0) {
            return DAG.getBoolExtOrTrunc(N0, DL, VT, OpVT);
        }
    }
    let mut AndC: *mut ConstantSDNode = dyn_cast(N0.getOperand(1));
    if AndC && isNullConstant(N1) && AndC.getAPIntValue().isPowerOf2() && self.isTypeLegal(OpVT) && N0.hasOneUse() {
        let mut NarrowVT: EVT = getIntegerVT(*DAG.getContext(), AndC.getAPIntValue().getActiveBits());
        if self.isTruncateFree(OpVT, NarrowVT) && self.isTypeLegal(NarrowVT) {
            let mut Trunc: SDValue = DAG.getZExtOrTrunc(N0.getOperand(0), DL, NarrowVT);
            let mut Zero: SDValue = DAG.getConstant(0, DL, NarrowVT, false, false);
            return DAG.getSetCC(DL, VT, Trunc, Zero, if Cond == SETEQ { SETGE } else { SETLT }, SDValue {}, false, SDNodeFlags { Flags: None });
        }
    }
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    if N0.getOperand(0) == N1 {
        X = N0.getOperand(1);
        Y = N0.getOperand(0);
    } else if N0.getOperand(1) == N1 {
        X = N0.getOperand(0);
        Y = N0.getOperand(1);
    } else {
        return SDValue {};
    }
    let mut Zero: SDValue = DAG.getConstant(0, DL, OpVT, false, false);
    if self.isXAndYEqZeroPreferableToXAndYEqY(Cond, OpVT) && DAG.isKnownToBeAPowerOfTwo(Y, false, 0) {
        assert!(OpVT.isInteger());
        Cond = getSetCCInverse(Cond, OpVT);
        if DCI.isBeforeLegalizeOps() || self.isCondCodeLegal(Cond, N0.getSimpleValueType()) {
            return DAG.getSetCC(DL, VT, N0, Zero, Cond, SDValue {}, false, SDNodeFlags { Flags: None });
        }
    } else if N0.hasOneUse() && self.hasAndNotCompare(Y) {
        if isNullConstant(Y) {
            return SDValue {};
        }
        let mut NotX: SDValue = DAG.getNOT(SDLoc { X }, X, OpVT);
        let mut NewAnd: SDValue = DAG.getNode(AND, SDLoc { N0 }, OpVT, NotX, Y);
        return DAG.getSetCC(DL, VT, NewAnd, Zero, Cond, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    return SDValue {};
}

fn TargetLowering::foldSetCCWithOr(self: *TargetLowering, VT: EVT, N0: SDValue, N1: SDValue, Cond: CondCode, DL: *SDLoc, DCI: *mut DAGCombinerInfo) -> SDValue {
    if N1.getOpcode() == OR && N0.getOpcode() != OR {
        swap(N0, N1);
    }
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut OpVT: EVT = N0.getValueType();
    if !N0.hasOneUse() || !OpVT.isInteger() || (Cond != SETEQ && Cond != SETNE) {
        return SDValue {};
    }
    let mut X: SDValue = SDValue {};
    if sd_match(N0, m_Or(m_Value(X), m_Specific(N1))) && self.hasAndNotCompare(X) {
        if isNullConstant(N1) {
            return SDValue {};
        }
        let mut NotY: SDValue = DAG.getNOT(SDLoc { N1 }, N1, OpVT);
        let mut NewAnd: SDValue = DAG.getNode(AND, SDLoc { N0 }, OpVT, X, NotY);
        return DAG.getSetCC(DL, VT, NewAnd, DAG.getConstant(0, DL, OpVT, false, false), Cond, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    return SDValue {};
}

fn TargetLowering::optimizeSetCCOfSignedTruncationCheck(self: *TargetLowering, SCCVT: EVT, N0: SDValue, N1: SDValue, Cond: CondCode, DCI: *mut DAGCombinerInfo, DL: *SDLoc) -> SDValue {
    let mut C1: *mut ConstantSDNode = null;
    if !(C1 = dyn_cast(N1)) {
        return SDValue {};
    }
    if operator(N0).getOpcode() != ADD {
        return SDValue {};
    }
    let mut C01: *mut ConstantSDNode = null;
    if !(C01 = dyn_cast(operator(N0).getOperand(1))) {
        return SDValue {};
    }
    let mut X: SDValue = operator(N0).getOperand(0);
    let mut XVT: EVT = X.getValueType();
    let mut I1: APInt = C1.getAPIntValue();
    let mut NewCond: CondCode = zeroed();
    if Cond == SETULT {
        NewCond = SETEQ;
    } else if Cond == SETULE {
        NewCond = SETEQ;
        operator(I1, 1);
    } else if Cond == SETUGT {
        NewCond = SETNE;
        operator(I1, 1);
    } else if Cond == SETUGE {
        NewCond = SETNE;
    } else {
        return SDValue {};
    }
    let mut I01: APInt = C01.getAPIntValue();
    let mut checkConstants: Closure_9 = Closure_9 { I1: &mut I1, I01: &mut I01 };
    if checkConstants.call() {} else {
        I1.negate();
        I01.negate();
        assert!(XVT.isInteger());
        NewCond = getSetCCInverse(NewCond, XVT);
        if !checkConstants.call() {
            return SDValue {};
        }
    }
    let mut KeptBits: u32 = I1.logBase2();
    let mut KeptBitsMinusOne: u32 = I01.logBase2();
    if KeptBits != (KeptBitsMinusOne + 1) {
        return SDValue {};
    }
    assert!(KeptBits > 0 && KeptBits < XVT.getSizeInBits().operator unsigned long long(), "unreachable");
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    if !self.shouldTransformSignedTruncationCheck(XVT, KeptBits) {
        return SDValue {};
    }
    let mut SExtInReg: SDValue = DAG.getNode(SIGN_EXTEND_INREG, DL, XVT, X, DAG.getValueType(getIntegerVT(*DAG.getContext(), KeptBits)));
    return DAG.getSetCC(DL, SCCVT, SExtInReg, X, NewCond, SDValue {}, false, SDNodeFlags { Flags: None });
}

fn TargetLowering::optimizeSetCCByHoistingAndByConstFromLogicalShift(self: *TargetLowering, SCCVT: EVT, N0: SDValue, N1C: SDValue, Cond: CondCode, DCI: *mut DAGCombinerInfo, DL: *SDLoc) -> SDValue {
    assert!(isConstOrConstSplat(N1C, false, false) && isConstOrConstSplat(N1C, false, false).isZero(), "Should be a comparison with 0.");
    assert!((Cond == SETEQ || Cond == SETNE), "Valid only for [in]equality comparisons.");
    let mut NewShiftOpcode: u32 = 0;
    let mut X: SDValue = SDValue {};
    let mut C: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut Match: Closure_10 = Closure_10 { NewShiftOpcode: &mut NewShiftOpcode, X: &mut X, C: &mut C, Y: &mut Y, DAG: &mut DAG, cap_5: self };
    if N0.getOpcode() != AND || !N0.hasOneUse() {
        return SDValue {};
    }
    X = N0.getOperand(0);
    let mut Mask: SDValue = N0.getOperand(1);
    if !Match.call(Mask) {
        swap(X, Mask);
        if !Match.call(Mask) {
            return SDValue {};
        }
    }
    let mut VT: EVT = X.getValueType();
    let mut T0: SDValue = DAG.getNode(NewShiftOpcode, DL, VT, X, Y);
    let mut T1: SDValue = DAG.getNode(AND, DL, VT, T0, C);
    let mut T2: SDValue = DAG.getSetCC(DL, SCCVT, T1, N1C, Cond, SDValue {}, false, SDNodeFlags { Flags: None });
    return T2;
}

fn TargetLowering::foldSetCCWithBinOp(self: *TargetLowering, VT: EVT, N0: SDValue, N1: SDValue, Cond: CondCode, DL: *SDLoc, DCI: *mut DAGCombinerInfo) -> SDValue {
    let mut BOpcode: u32 = N0.getOpcode();
    assert!((BOpcode == ADD || BOpcode == SUB || BOpcode == XOR), "Unexpected binop");
    assert!((Cond == SETEQ || Cond == SETNE), "Unexpected condcode");
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut OpVT: EVT = N0.getValueType();
    let mut X: SDValue = N0.getOperand(0);
    let mut Y: SDValue = N0.getOperand(1);
    if X == N1 {
        return DAG.getSetCC(DL, VT, Y, DAG.getConstant(0, DL, OpVT, false, false), Cond, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    if Y != N1 {
        return SDValue {};
    }
    if BOpcode == ADD || BOpcode == XOR {
        return DAG.getSetCC(DL, VT, X, DAG.getConstant(0, DL, OpVT, false, false), Cond, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    if !N0.hasOneUse() || OpVT.getScalarSizeInBits() == 1 {
        return SDValue {};
    }
    let mut One: SDValue = DAG.getShiftAmountConstant(1, OpVT, DL);
    let mut YShl1: SDValue = DAG.getNode(SHL, DL, N1.getValueType(), Y, One);
    if !DCI.isCalledByLegalizer() {
        DCI.AddToWorklist(YShl1.getNode());
    }
    return DAG.getSetCC(DL, VT, X, YShl1, Cond, SDValue {}, false, SDNodeFlags { Flags: None });
}

fn simplifySetCCWithCTPOP(TLI: *TargetLowering, VT: EVT, N0: SDValue, C1: *APInt, Cond: CondCode, dl: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut CTPOP: SDValue = N0;
    if N0.getOpcode() == TRUNCATE && N0.hasOneUse() && !VT.isVector() && N0.getScalarValueSizeInBits() > Log2_32(N0.getOperand(0).getScalarValueSizeInBits()) {
        CTPOP = N0.getOperand(0);
    }
    if CTPOP.getOpcode() != CTPOP || !CTPOP.hasOneUse() {
        return SDValue {};
    }
    let mut CTVT: EVT = CTPOP.getValueType();
    let mut CTOp: SDValue = CTPOP.getOperand(0);
    if Cond == SETULT || Cond == SETUGT {
        if CTVT.isVector() && TLI.isCtpopFast(CTVT) {
            return SDValue {};
        }
        let mut CostLimit: u32 = TLI.getCustomCtpopCost(CTVT, Cond);
        if C1.ugt(CostLimit + (Cond == SETULT)) {
            return SDValue {};
        }
        if C1 == 0 && (Cond == SETULT) {
            return SDValue {};
        }
        let mut Passes: u32 = C1.getLimitedValue(18446744073709551615) - (Cond == SETULT);
        let mut NegOne: SDValue = DAG.getAllOnesConstant(dl, CTVT, false, false);
        let mut Result: SDValue = CTOp;
        for let mut i: u32 = 0; i < Passes; i += 1 {
            let mut Add: SDValue = DAG.getNode(ADD, dl, CTVT, Result, NegOne);
            Result = DAG.getNode(AND, dl, CTVT, Result, Add);
        }
        let mut CC: CondCode = if Cond == SETULT { SETEQ } else { SETNE };
        return DAG.getSetCC(dl, VT, Result, DAG.getConstant(0, dl, CTVT, false, false), CC, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    if (Cond == SETEQ || Cond == SETNE) && C1 == 1 {
        if TLI.isCtpopFast(CTVT) {
            return SDValue {};
        }
        let mut Zero: SDValue = DAG.getConstant(0, dl, CTVT, false, false);
        let mut NegOne: SDValue = DAG.getAllOnesConstant(dl, CTVT, false, false);
        assert!(CTVT.isInteger());
        let mut Add: SDValue = DAG.getNode(ADD, dl, CTVT, CTOp, NegOne);
        if DAG.isKnownNeverZero(CTOp, 0) {
            let mut And: SDValue = DAG.getNode(AND, dl, CTVT, CTOp, Add);
            let mut RHS: SDValue = DAG.getSetCC(dl, VT, And, Zero, Cond, SDValue {}, false, SDNodeFlags { Flags: None });
            return RHS;
        }
        let mut Xor: SDValue = DAG.getNode(XOR, dl, CTVT, CTOp, Add);
        let mut CmpCond: CondCode = if Cond == SETEQ { SETUGT } else { SETULE };
        return DAG.getSetCC(dl, VT, Xor, Add, CmpCond, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    return SDValue {};
}

fn foldSetCCWithRotate(VT: EVT, N0: SDValue, N1: SDValue, Cond: CondCode, dl: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    if Cond != SETEQ && Cond != SETNE {
        return SDValue {};
    }
    let mut C1: *mut ConstantSDNode = isConstOrConstSplat(N1, true, false);
    if !C1 || !(C1.isZero() || C1.isAllOnes()) {
        return SDValue {};
    }
    let mut getRotateSource: Closure_11 = Closure_11 {};
    if getRotateSource.call(N0) {
        R;
    } else {
        return DAG.getSetCC(dl, VT, R, N1, Cond, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    let mut OpVT: EVT = N0.getValueType();
    if N0.hasOneUse() && N0.getOpcode() == OR && C1.isZero() {
        if getRotateSource.call(N0.getOperand(0)) {
            R;
        } else {
            let mut NewOr: SDValue = DAG.getNode(OR, dl, OpVT, R, N0.getOperand(1));
            return DAG.getSetCC(dl, VT, NewOr, N1, Cond, SDValue {}, false, SDNodeFlags { Flags: None });
        }
        if getRotateSource.call(N0.getOperand(1)) {
            R;
        } else {
            let mut NewOr: SDValue = DAG.getNode(OR, dl, OpVT, R, N0.getOperand(0));
            return DAG.getSetCC(dl, VT, NewOr, N1, Cond, SDValue {}, false, SDNodeFlags { Flags: None });
        }
    }
    return SDValue {};
}

fn foldSetCCWithFunnelShift(VT: EVT, N0: SDValue, N1: SDValue, Cond: CondCode, dl: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    if Cond != SETEQ && Cond != SETNE {
        return SDValue {};
    }
    let mut C1: *mut ConstantSDNode = isConstOrConstSplat(N1, true, false);
    if !C1 || !C1.isZero() {
        return SDValue {};
    }
    if !N0.hasOneUse() || (N0.getOpcode() != FSHL && N0.getOpcode() != FSHR) {
        return SDValue {};
    }
    let mut BitWidth: u32 = N0.getScalarValueSizeInBits();
    let mut ShAmtC: *mut ConstantSDNode = isConstOrConstSplat(N0.getOperand(2), false, false);
    if !ShAmtC {
        return SDValue {};
    }
    let mut ShAmt: u64 = ShAmtC.getAPIntValue().urem(BitWidth);
    if ShAmt == 0 {
        return SDValue {};
    }
    if N0.getOpcode() == FSHR {
        ShAmt = BitWidth - ShAmt;
    }
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    let mut matchOr: Closure_12 = Closure_12 { X: &mut X, Y: &mut Y };
    let mut OpVT: EVT = N0.getValueType();
    let mut ShAmtVT: EVT = N0.getOperand(2).getValueType();
    let mut F0: SDValue = N0.getOperand(0);
    let mut F1: SDValue = N0.getOperand(1);
    if matchOr.call(F0, F1) {
        let mut NewShAmt: SDValue = DAG.getConstant(ShAmt, dl, ShAmtVT, false, false);
        let mut Shift: SDValue = DAG.getNode(SHL, dl, OpVT, Y, NewShAmt);
        let mut NewOr: SDValue = DAG.getNode(OR, dl, OpVT, Shift, X);
        return DAG.getSetCC(dl, VT, NewOr, N1, Cond, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    if matchOr.call(F1, F0) {
        let mut NewShAmt: SDValue = DAG.getConstant(BitWidth - ShAmt, dl, ShAmtVT, false, false);
        let mut Shift: SDValue = DAG.getNode(SRL, dl, OpVT, Y, NewShAmt);
        let mut NewOr: SDValue = DAG.getNode(OR, dl, OpVT, Shift, X);
        return DAG.getSetCC(dl, VT, NewOr, N1, Cond, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    return SDValue {};
}

fn TargetLowering::SimplifySetCC(self: *TargetLowering, VT: EVT, N0: SDValue, N1: SDValue, Cond: CondCode, foldBooleans: bool, DCI: *mut DAGCombinerInfo, dl: *SDLoc) -> SDValue {
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut Layout: *DataLayout = DAG.getDataLayout();
    let mut OpVT: EVT = N0.getValueType();
    let mut Attr: AttributeList = DAG.getMachineFunction().getFunction().getAttributes();
    if DAG.FoldSetCC(VT, N0, N1, Cond, dl, SDNodeFlags { Flags: None }) {
        Fold;
    } else {
        return Fold;
    }
    let mut N0ConstOrSplat: bool = isConstOrConstSplat(N0, false, true);
