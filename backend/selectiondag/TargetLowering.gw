        } else if ShiftAmt == (*self.HBitWidth) {
            Lo = Hi;
            Hi = (*self.DAG).getConstant(0, (*self.dl), (*self.HiLoVT), false, false);
        } else {
            Lo = (*self.DAG).getNode(SRL, (*self.dl), (*self.HiLoVT), Hi, (*self.DAG).getShiftAmountConstant(ShiftAmt - (*self.HBitWidth), (*self.HiLoVT), (*self.dl)));
