unsafe fn Closure_39::call(self: *mut Closure_39, PrefCC: CondCode, AltCC: CondCode, PrefCommuteCC: CondCode, AltCommuteCC: CondCode) -> SDValue {
        let mut BoolVTList: SDVTList = (*self.DAG).getVTList((*self.BoolVT));
        for CC in [PrefCC, AltCC] {
            if (*self.DAG).doesNodeExist(SETCC, BoolVTList, ArrayRef<SDValue> { [(*self.Op0), (*self.Op1), (*self.DAG).getCondCode(CC)] }) {
