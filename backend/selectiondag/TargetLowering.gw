unsafe fn Closure_30::call(self: *mut Closure_30, Lo: SDValue, Hi: SDValue, ShiftAmt: u32) -> SDValue {
        assert!(ShiftAmt > 0 && ShiftAmt < (*self.HBitWidth));
        if (*self.HasFSHR) {
            return (*self.DAG).getNode(FSHR, (*self.dl), (*self.HiLoVT), Hi, Lo, (*self.DAG).getShiftAmountConstant(ShiftAmt, (*self.HiLoVT), (*self.dl)));
        }
        return (*self.DAG).getNode(OR, (*self.dl), (*self.HiLoVT), (*self.DAG).getNode(SRL, (*self.dl), (*self.HiLoVT), Lo, (*self.DAG).getShiftAmountConstant(ShiftAmt, (*self.HiLoVT), (*self.dl))), (*self.DAG).getNode(SHL, (*self.dl), (*self.HiLoVT), Hi, (*self.DAG).getShiftAmountConstant((*self.HBitWidth) - ShiftAmt, (*self.HiLoVT), (*self.dl))));
