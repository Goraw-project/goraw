unsafe fn Closure_5::call(self: *mut Closure_5, Op0: SDValue, Op1: SDValue) -> bool {
        let mut ShrunkSize: u32 = self.getPreferredShrunkVectorSizeInBits((*self.Op), (*self.DemandedElts));
        if !ShrunkSize {
            return false;
        }
        assert!(ShrunkSize % (*self.EltSizeInBits) == 0, "Shrunk size not a multiple of element size");
        assert!(ShrunkSize < (*self.VT).getSizeInBits().operator unsigned long long(), "Shrunk size must be < original vector size");
        assert!(ShrunkSize >= (*self.EltSizeInBits) * (*self.DemandedElts).getActiveBits(), "Shrunk size must be >= demanded size");
        let mut ShrunkVT: EVT = (*self.VT).changeVectorElementCount(*(*self.TLO).DAG.getContext(), getFixed(ShrunkSize / (*self.EltSizeInBits)));
        Op0 = (*self.TLO).DAG.getExtractSubvector((*self.DL), ShrunkVT, Op0, 0);
        Op1 = (*self.TLO).DAG.getExtractSubvector((*self.DL), ShrunkVT, Op1, 0);
        let mut NewOp: SDValue = (*self.TLO).DAG.getNode((*self.Opcode), (*self.DL), ShrunkVT, Op0, Op1, operator((*self.Op)).getFlags());
        return (*self.TLO).CombineTo((*self.Op), (*self.TLO).DAG.getInsertSubvector((*self.DL), (*self.TLO).DAG.getUNDEF((*self.VT)), NewOp, 0));
