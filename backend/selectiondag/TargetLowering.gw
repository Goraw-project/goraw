struct Closure_18 {
    EltBits: *mut u32,
    MagicFactors: *mut SmallVector<SDValue, 16>,
    DAG: *mut SelectionDAG,
    SVTBits: *mut u32,
    dl: *mut SDLoc,
    SVT: *mut EVT,
    Factors: *mut SmallVector<SDValue, 16>,
