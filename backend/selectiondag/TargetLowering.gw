        }
        (*self.PAmts).push((*self.DAG).getConstant(P, (*self.DL), (*self.SVT), false, false));
        (*self.AAmts).push((*self.DAG).getConstant(A, (*self.DL), (*self.SVT), false, false));
        (*self.QAmts).push((*self.DAG).getConstant(Q, (*self.DL), (*self.SVT), false, false));
        return true;
    }

