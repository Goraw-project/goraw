struct Closure_20 {
    EltBits: *mut u32,
    DAG: *mut SelectionDAG,
    ShSVT: *mut EVT,
    SVT: *mut EVT,
    KnownLeadingZeros: *mut u32,
    AllowEvenToWiden: *mut bool,
    AllowWiden: *mut bool,
    UseWiden: *mut bool,
    dl: *mut SDLoc,
    WideSVT: *mut EVT,
    SVTBits: *mut u32,
    UseNPQ: *mut bool,
    UsePreShift: *mut bool,
    UsePostShift: *mut bool,
    PreShifts: *mut SmallVector<SDValue, 16>,
    MagicFactors: *mut SmallVector<SDValue, 16>,
    NPQFactors: *mut SmallVector<SDValue, 16>,
    PostShifts: *mut SmallVector<SDValue, 16>,
}

unsafe fn Closure_20::call(self: *mut Closure_20, C: *mut ConstantSDNode) -> bool {
        if C.isZero() {
            return false;
        }
        let mut Divisor: APInt = C.getAPIntValue().trunc((*self.EltBits));
        let mut PreShift: SDValue = SDValue {};
        let mut MagicFactor: SDValue = SDValue {};
        let mut NPQFactor: SDValue = SDValue {};
        let mut PostShift: SDValue = SDValue {};
        if Divisor.isOne() {
            PreShift = PostShift = (*self.DAG).getUNDEF((*self.ShSVT));
            MagicFactor = NPQFactor = (*self.DAG).getUNDEF((*self.SVT));
        } else {
            let mut magics: UnsignedDivisionByConstantInfo = get(Divisor, if (*self.KnownLeadingZeros) < Divisor.countl_zero() { (*self.KnownLeadingZeros) } else { Divisor.countl_zero() }, !(*self.AllowEvenToWiden), (*self.AllowWiden));
            if magics.Widen {
                (*self.UseWiden) = true;
                MagicFactor = (*self.DAG).getConstant(magics.Magic, (*self.dl), (*self.WideSVT), false, false);
            } else {
                MagicFactor = (*self.DAG).getConstant(magics.Magic.zext((*self.SVTBits)), (*self.dl), (*self.SVT), false, false);
            }
            assert!(magics.PreShift < Divisor.getBitWidth(), "We shouldn't generate an undefined shift!");
            assert!(magics.PostShift < Divisor.getBitWidth(), "We shouldn't generate an undefined shift!");
            assert!((!magics.IsAdd || magics.PreShift == 0), "Unexpected pre-shift");
            PreShift = (*self.DAG).getConstant(magics.PreShift, (*self.dl), (*self.ShSVT), false, false);
            PostShift = (*self.DAG).getConstant(magics.PostShift, (*self.dl), (*self.ShSVT), false, false);
            NPQFactor = (*self.DAG).getConstant(if magics.IsAdd { getOneBitSet((*self.SVTBits), (*self.EltBits) - 1) } else { getZero((*self.SVTBits)) }, (*self.dl), (*self.SVT), false, false);
            (*self.UseNPQ) |= magics.IsAdd;
            (*self.UsePreShift) |= magics.PreShift != 0;
            (*self.UsePostShift) |= magics.PostShift != 0;
        }
        (*self.PreShifts).push(ValueParamT { PreShift });
        (*self.MagicFactors).push(ValueParamT { MagicFactor });
        (*self.NPQFactors).push(ValueParamT { NPQFactor });
        (*self.PostShifts).push(ValueParamT { PostShift });
        return true;
    }

