                    if LHS.getOpcode() == SHL && isa(LHS.getOperand(1)) && LHS.getConstantOperandAPInt(1) == (EltBits / 2) && (*self.DAG).MaskedValueIsZero(RHS, HiBits, 0) {
                        Lo = RHS;
                        Hi = LHS.getOperand(0);
                        return true;
                    }
                    return false;
                }

