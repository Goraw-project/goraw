struct Closure_33 {
    DAG: *mut SelectionDAG,
    DL: *mut SDLoc,
    HiLoVT: *mut EVT,
}

unsafe fn Closure_33::call(self: *mut Closure_33, Opc: u32, LL: SDValue, LH: SDValue, RL: SDValue, RH: SDValue) -> SDValue &>> {
        let mut AddSubNode: SDValue = (*self.DAG).getNode(if Opc == ADD { UADDO } else { USUBO }, (*self.DL), (*self.DAG).getVTList((*self.HiLoVT), EVT { i1 }), LL, RL);
        let mut OutL: SDValue = AddSubNode.getValue(0);
        let mut Overflow: SDValue = AddSubNode.getValue(1);
        let mut AddSubWithOverflow: SDValue = (*self.DAG).getNode(if Opc == ADD { UADDO_CARRY } else { USUBO_CARRY }, (*self.DL), (*self.DAG).getVTList((*self.HiLoVT), EVT { i1 }), LH, RH, Overflow);
        let mut OutH: SDValue = AddSubWithOverflow.getValue(0);
        return make_pair(OutL, OutH);
    }

struct Closure_34 {
    HiLoVT: *mut EVT,
    DAG: *mut SelectionDAG,
    DL: *mut SDLoc,
}

unsafe fn Closure_34::call(self: *mut Closure_34, LL: SDValue, LH: SDValue, Shift: u32) -> SDValue &>> {
        let mut HBitWidth: u32 = (*self.HiLoVT).getScalarSizeInBits();
        if Shift < HBitWidth {
            let mut ShAmt: SDValue = (*self.DAG).getShiftAmountConstant(Shift, (*self.HiLoVT), (*self.DL));
            let mut ResL: SDValue = (*self.DAG).getNode(FSHR, (*self.DL), (*self.HiLoVT), LH, LL, ShAmt);
            let mut ResH: SDValue = (*self.DAG).getNode(SRL, (*self.DL), (*self.HiLoVT), LH, ShAmt);
            return make_pair(ResL, ResH);
        }
        let mut Zero: SDValue = (*self.DAG).getConstant(0, (*self.DL), (*self.HiLoVT), false, false);
        if Shift == HBitWidth {
            return make_pair(LH, Zero);
        }
        assert!(Shift - HBitWidth < HBitWidth, "We shouldn't generate an undefined shift");
        let mut ShAmt: SDValue = (*self.DAG).getShiftAmountConstant(Shift - HBitWidth, (*self.HiLoVT), (*self.DL));
        return make_pair((*self.DAG).getNode(SRL, (*self.DL), (*self.HiLoVT), LH, ShAmt), Zero);
    }

