                    let mut ShCt: u32 = C1.logBase2();
                    if C1.isPowerOf2() && !self.shouldAvoidTransformToShift(ShValTy, ShCt) {
                        return DAG.getNode(TRUNCATE, dl, VT, DAG.getNode(SRL, dl, ShValTy, N0, DAG.getShiftAmountConstant(ShCt, ShValTy, dl)));
                    }
                }
            }
        }
        if C1.getSignificantBits() <= 64 && !self.isLegalICmpImmediate(C1.getSExtValue()) {
            if (Cond == SETEQ || Cond == SETNE) && N0.getOpcode() == AND && N0.hasOneUse() {
                if dyn_cast(N0.getOperand(1)) {
                    AndRHS;
                } else {
                    let mut AndRHSC: *APInt = AndRHS.getAPIntValue();
                    if AndRHSC.isNegatedPowerOf2() && C1.isSubsetOf(AndRHSC) {
                        let mut ShiftBits: u32 = AndRHSC.countr_zero();
                        if !self.shouldAvoidTransformToShift(ShValTy, ShiftBits) {
                            let mut NewC: APInt = C1.lshr(ShiftBits);
                            if NewC.getSignificantBits() <= 64 && !self.isLegalICmpImmediate(NewC.getSExtValue()) {
                                let mut SignedC: APInt = C1.ashr(ShiftBits);
                                if SignedC.getSignificantBits() <= 64 && self.isLegalICmpImmediate(SignedC.getSExtValue()) {
                                    let mut Shift: SDValue = DAG.getNode(SRA, dl, ShValTy, N0.getOperand(0), DAG.getShiftAmountConstant(ShiftBits, ShValTy, dl));
                                    let mut CmpRHS: SDValue = DAG.getConstant(SignedC, dl, ShValTy, false, false);
                                    return DAG.getSetCC(dl, VT, Shift, CmpRHS, Cond, SDValue {}, false, SDNodeFlags { Flags: None });
                                }
                            }
                            let mut Shift: SDValue = DAG.getNode(SRL, dl, ShValTy, N0.getOperand(0), DAG.getShiftAmountConstant(ShiftBits, ShValTy, dl));
                            let mut CmpRHS: SDValue = DAG.getConstant(NewC, dl, ShValTy, false, false);
                            return DAG.getSetCC(dl, VT, Shift, CmpRHS, Cond, SDValue {}, false, SDNodeFlags { Flags: None });
                        }
                    }
                }
            } else if Cond == SETULT || Cond == SETUGE || Cond == SETULE || Cond == SETUGT {
                let mut AdjOne: bool = (Cond == SETULE || Cond == SETUGT);
                let mut ShiftBits: u32 = 0;
                let mut NewC: APInt = C1;
                let mut NewCond: CondCode = Cond;
                if AdjOne {
                    ShiftBits = C1.countr_one();
                    NewC = NewC + 1;
                    NewCond = if (Cond == SETULE) { SETULT } else { SETUGE };
                } else {
                    ShiftBits = C1.countr_zero();
                }
                let mut RangeWidth: APInt = NewC;
                NewC.lshrInPlace(ShiftBits);
                if ShiftBits && NewC.getSignificantBits() <= 64 && self.isLegalICmpImmediate(NewC.getSExtValue()) && !self.shouldAvoidTransformToShift(ShValTy, ShiftBits) {
                    if N0.getOpcode() == ADD && N0.hasOneUse() {
                        if isConstOrConstSplat(N0.getOperand(1), false, false) {
                            AddC;
                        } else {
                            let mut AddVal: *APInt = AddC.getAPIntValue();
                            if AddVal.countr_zero() >= ShiftBits {
                                let mut RangeLower: APInt = operator(AddVal);
                                let mut Overflow: bool = false;
                                RangeLower.uadd_ov(RangeWidth, Overflow) as void;
                                if !RangeWidth.isZero() && !Overflow {
                                    let mut Shift: SDValue = DAG.getNode(SRL, dl, ShValTy, N0.getOperand(0), DAG.getShiftAmountConstant(ShiftBits, ShValTy, dl));
                                    let mut Offset: APInt = operator(RangeLower.lshr(ShiftBits));
                                    let mut ShiftedAdd: SDValue = DAG.getNode(ADD, dl, ShValTy, Shift, DAG.getConstant(Offset, dl, ShValTy, false, false));
                                    let mut CmpRHS: SDValue = DAG.getConstant(NewC, dl, ShValTy, false, false);
                                    return DAG.getSetCC(dl, VT, ShiftedAdd, CmpRHS, NewCond, SDValue {}, false, SDNodeFlags { Flags: None });
                                }
                            }
                        }
                    }
                    let mut Shift: SDValue = DAG.getNode(SRL, dl, ShValTy, N0, DAG.getShiftAmountConstant(ShiftBits, ShValTy, dl));
                    let mut CmpRHS: SDValue = DAG.getConstant(NewC, dl, ShValTy, false, false);
                    return DAG.getSetCC(dl, VT, Shift, CmpRHS, NewCond, SDValue {}, false, SDNodeFlags { Flags: None });
                }
            }
        }
    }
    if !isa(N0) && isa(N1) {
        let mut CFP: *mut ConstantFPSDNode = cast(N1);
        assert!(!CFP.getValueAPF().isNaN(), "Unexpected NaN value");
        if Cond == SETO || Cond == SETUO {
            return DAG.getSetCC(dl, VT, N0, N0, Cond, SDValue {}, false, SDNodeFlags { Flags: None });
        }
        if N0.getOpcode() == FNEG {
            let mut SwapCond: CondCode = getSetCCSwappedOperands(Cond);
            if DCI.isBeforeLegalizeOps() || self.isCondCodeLegal(SwapCond, N0.getSimpleValueType()) {
                let mut NegN1: SDValue = DAG.getNode(FNEG, dl, N0.getValueType(), N1);
                return DAG.getSetCC(dl, VT, N0.getOperand(0), NegN1, SwapCond, SDValue {}, false, SDNodeFlags { Flags: None });
            }
        }
        if self.isOperationLegalOrCustom(IS_FPCLASS, N0.getValueType(), false) && !self.isFPImmLegal(CFP.getValueAPF(), CFP.getValueType(0), false) {
            let mut IsFabs: bool = N0.getOpcode() == FABS;
            let mut Op: SDValue = if IsFabs { N0.getOperand(0) } else { N0 };
            if (Cond == SETOEQ || Cond == SETUEQ) && CFP.isInfinity() {
                let mut Flag: FPClassTest = if CFP.isNegative() { (if IsFabs { fcNone } else { fcNegInf }) } else { (if IsFabs { fcInf } else { fcPosInf }) };
                if Cond == SETUEQ {
                    operator(Flag, fcNan);
                }
                return DAG.getNode(IS_FPCLASS, dl, VT, Op, DAG.getTargetConstant(Flag, dl, EVT { i32 }, false));
            }
        }
        if !self.isCondCodeLegal(Cond, N0.getSimpleValueType()) {
            if CFP.getValueAPF().isInfinity() {
                let mut IsNegInf: bool = CFP.getValueAPF().isNegative();
                let mut NewCond: CondCode = SETCC_INVALID;
                match Cond {
                    SETOEQ => {
                        NewCond = if IsNegInf { SETOLE } else { SETOGE };
                    },
                    SETUEQ => {
                        NewCond = if IsNegInf { SETULE } else { SETUGE };
                    },
                    SETUNE => {
                        NewCond = if IsNegInf { SETUGT } else { SETULT };
                    },
                    SETONE => {
                        NewCond = if IsNegInf { SETOGT } else { SETOLT };
                    },
                    _ => {
                        break;
                    },
                }
                if NewCond != SETCC_INVALID && self.isCondCodeLegal(NewCond, N0.getSimpleValueType()) {
                    return DAG.getSetCC(dl, VT, N0, N1, NewCond, SDValue {}, false, SDNodeFlags { Flags: None });
                }
            }
        }
    }
    if N0 == N1 {
        assert!(!N0.getValueType().isInteger(), "Integer types should be handled by FoldSetCC");
        let mut EqTrue: bool = isTrueWhenEqual(Cond);
        let mut UOF: u32 = getUnorderedFlavor(Cond);
        if UOF == 2 {
            return DAG.getBoolConstant(EqTrue, dl, VT, OpVT);
        }
        if UOF == EqTrue {
            return DAG.getBoolConstant(EqTrue, dl, VT, OpVT);
        }
        let mut NewCond: CondCode = if UOF == 0 { SETO } else { SETUO };
        if NewCond != Cond && (DCI.isBeforeLegalizeOps() || self.isCondCodeLegal(NewCond, N0.getSimpleValueType())) {
            return DAG.getSetCC(dl, VT, N0, N1, NewCond, SDValue {}, false, SDNodeFlags { Flags: None });
        }
    }
    if (isSignedIntSetCC(Cond) || isUnsignedIntSetCC(Cond)) && N0.getValueType().isInteger() {
        if isBitwiseNot(N0, false) {
            if isBitwiseNot(N1, false) {
                return DAG.getSetCC(dl, VT, N1.getOperand(0), N0.getOperand(0), Cond, SDValue {}, false, SDNodeFlags { Flags: None });
            }
            if DAG.isConstantIntBuildVectorOrConstantInt(N1, true) && !DAG.isConstantIntBuildVectorOrConstantInt(N0.getOperand(0), true) {
                let mut Not: SDValue = DAG.getNOT(dl, N1, OpVT);
                return DAG.getSetCC(dl, VT, Not, N0.getOperand(0), Cond, SDValue {}, false, SDNodeFlags { Flags: None });
            }
        }
    }
    if (Cond == SETEQ || Cond == SETNE) && N0.getValueType().isInteger() {
        if N0.getOpcode() == ADD || N0.getOpcode() == SUB || N0.getOpcode() == XOR {
            if N0.getOpcode() == N1.getOpcode() {
                if N0.getOperand(0) == N1.getOperand(0) {
                    return DAG.getSetCC(dl, VT, N0.getOperand(1), N1.getOperand(1), Cond, SDValue {}, false, SDNodeFlags { Flags: None });
                }
                if N0.getOperand(1) == N1.getOperand(1) {
                    return DAG.getSetCC(dl, VT, N0.getOperand(0), N1.getOperand(0), Cond, SDValue {}, false, SDNodeFlags { Flags: None });
                }
                if self.isCommutativeBinOp(N0.getOpcode()) {
                    if N0.getOperand(0) == N1.getOperand(1) {
                        return DAG.getSetCC(dl, VT, N0.getOperand(1), N1.getOperand(0), Cond, SDValue {}, false, SDNodeFlags { Flags: None });
                    }
                    if N0.getOperand(1) == N1.getOperand(0) {
                        return DAG.getSetCC(dl, VT, N0.getOperand(0), N1.getOperand(1), Cond, SDValue {}, false, SDNodeFlags { Flags: None });
                    }
                }
            }
            let mut LegalRHSImm: bool = false;
            if dyn_cast(N1) {
                RHSC;
            } else {
                if dyn_cast(N0.getOperand(1)) {
                    LHSR;
                } else {
                    if N0.getOpcode() == ADD && N0.getNode().hasOneUse() {
                        return DAG.getSetCC(dl, VT, N0.getOperand(0), DAG.getConstant(RHSC.getAPIntValue() - LHSR.getAPIntValue(), dl, N0.getValueType(), false, false), Cond, SDValue {}, false, SDNodeFlags { Flags: None });
                    }
                    if N0.getOpcode() == XOR && N0.getNode().hasOneUse() {
                        return DAG.getSetCC(dl, VT, N0.getOperand(0), DAG.getConstant(LHSR.getAPIntValue() ^ RHSC.getAPIntValue(), dl, N0.getValueType(), false, false), Cond, SDValue {}, false, SDNodeFlags { Flags: None });
                    }
                }
                if dyn_cast(N0.getOperand(0)) {
                    SUBC;
                } else if N0.getOpcode() == SUB && N0.getNode().hasOneUse() {
                    return DAG.getSetCC(dl, VT, N0.getOperand(1), DAG.getConstant(SUBC.getAPIntValue() - RHSC.getAPIntValue(), dl, N0.getValueType(), false, false), Cond, SDValue {}, false, SDNodeFlags { Flags: None });
                }
                if RHSC.getValueType(0).getSizeInBits().operator unsigned long long() <= 64 {
                    LegalRHSImm = self.isLegalICmpImmediate(RHSC.getSExtValue());
                }
            }
            if !LegalRHSImm || N0.hasOneUse() {
                if self.foldSetCCWithBinOp(VT, N0, N1, Cond, dl, DCI) {
                    V;
                } else {
                    return V;
                }
            }
        }
        if N1.getOpcode() == ADD || N1.getOpcode() == SUB || N1.getOpcode() == XOR {
            if self.foldSetCCWithBinOp(VT, N1, N0, Cond, dl, DCI) {
                V;
            } else {
                return V;
            }
        }
        if self.foldSetCCWithAnd(VT, N0, N1, Cond, dl, DCI) {
            V;
        } else {
            return V;
        }
        if self.foldSetCCWithOr(VT, N0, N1, Cond, dl, DCI) {
            V;
        } else {
            return V;
        }
    }
    if (N0.getOpcode() == UREM || N0.getOpcode() == SREM) && N0.hasOneUse() && (Cond == SETEQ || Cond == SETNE) {
        if !self.isIntDivCheap(VT, Attr) && !Attr.hasFnAttr(MinSize) {
            if N0.getOpcode() == UREM {
                if self.buildUREMEqFold(VT, N0, N1, Cond, DCI, dl) {
                    Folded;
                } else {
                    return Folded;
                }
            } else if N0.getOpcode() == SREM {
                if self.buildSREMEqFold(VT, N0, N1, Cond, DCI, dl) {
                    Folded;
                } else {
                    return Folded;
                }
            }
        }
    }
    if N0.getValueType().getScalarType() == EVT { i1 } && foldBooleans {
        let mut Temp: SDValue = SDValue {};
        match Cond {
            _ => {
                llvm_unreachable_internal("Unknown integer setcc!", "llvm\\lib\\CodeGen\\SelectionDAG\\TargetLowering.cpp", 5908);
            },
            SETEQ => {
                Temp = DAG.getNode(XOR, dl, OpVT, N0, N1);
            },
            SETNE => {
                N0 = DAG.getNode(XOR, dl, OpVT, N0, N1);
            },
            SETGT => {
                SETULT;
            },
            SETLT => {
                SETUGT;
            },
            SETULE => {
                SETGE;
            },
            SETUGE => {
                SETLE;
            },
        }
        if VT.getScalarType() != EVT { i1 } {
            if !DCI.isCalledByLegalizer() {
                DCI.AddToWorklist(N0.getNode());
            }
            let mut ExtendCode: NodeType = getExtendForContent(self.getBooleanContents(OpVT));
            N0 = DAG.getNode(ExtendCode, dl, VT, N0);
        }
        return N0;
    }
    if N0.getOpcode() == TRUNCATE && N1.getOpcode() == TRUNCATE && N0.getOperand(0).getValueType() == N1.getOperand(0).getValueType() && ((!isSignedIntSetCC(Cond) && operator(N0).getFlags().hasNoUnsignedWrap() && operator(N1).getFlags().hasNoUnsignedWrap()) || (!isUnsignedIntSetCC(Cond) && operator(N0).getFlags().hasNoSignedWrap() && operator(N1).getFlags().hasNoSignedWrap())) && self.isTypeDesirableForOp(SETCC, N0.getOperand(0).getValueType()) {
        if VT.getScalarType() == EVT { i1 } {
            return DAG.getSetCC(dl, VT, N0.getOperand(0), N1.getOperand(0), Cond, SDValue {}, false, SDNodeFlags { Flags: None });
        }
        let mut OldCCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), N0.getValueType());
        if VT == OldCCVT {
            let mut NewCCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), N0.getOperand(0).getValueType());
            return DAG.getBoolExtOrTrunc(DAG.getSetCC(dl, NewCCVT, N0.getOperand(0), N1.getOperand(0), Cond, SDValue {}, false, SDNodeFlags { Flags: None }), dl, VT, N0.getOperand(0).getValueType());
        }
    }
    if VT.isVector() && isZeroOrZeroSplat(N1, false) && N0.getOpcode() == SUB && operator(N0).getFlags().hasNoSignedWrap() && isSignedIntSetCC(Cond) {
        return DAG.getSetCC(dl, VT, N0.getOperand(0), N0.getOperand(1), Cond, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    return SDValue {};
}

fn TargetLowering::isGAPlusOffset(self: *TargetLowering, WN: *mut SDNode, GA: **mut GlobalValue, Offset: *mut i64) -> bool {
    let mut N: *mut SDNode = self.unwrapAddress(SDValue { Node: WN, ResNo: 0 }).getNode();
    if dyn_cast(N) {
        GASD;
    } else {
        GA = GASD.getGlobal();
        Offset += GASD.getOffset();
        return true;
    }
    if N.isAnyAdd() {
        let mut N1: SDValue = N.getOperand(0);
        let mut N2: SDValue = N.getOperand(1);
        if self.isGAPlusOffset(N1.getNode(), GA, Offset) {
            if dyn_cast(N2) {
                V;
            } else {
                Offset += V.getSExtValue();
                return true;
            }
        } else if self.isGAPlusOffset(N2.getNode(), GA, Offset) {
            if dyn_cast(N1) {
                V;
            } else {
                Offset += V.getSExtValue();
                return true;
            }
        }
    }
    return false;
}

fn TargetLowering::PerformDAGCombine(self: *TargetLowering, N: *mut SDNode, DCI: *mut DAGCombinerInfo) -> SDValue {
    return SDValue {};
}

fn TargetLowering::getConstraintType(self: *TargetLowering, Constraint: str) -> ConstraintType {
    let mut S: u32 = Constraint.len;
    if S == 1 {
        match Constraint[0] {
            _ => {
                break;
            },
            'r' => {
                return C_RegisterClass;
            },
            'm' => {
                'o';
            },
            'p' => {
                return C_Address;
            },
            'n' => {
                'E';
            },
            'i' => {
                's';
            },
        }
    }
    if S > 1 && Constraint[0] == '{' && Constraint[S - 1] == '}' {
        if S == 8 && Constraint[1..1 + 6] == "memory" {
            return C_Memory;
        }
        return C_Register;
    }
    return C_Unknown;
}

fn TargetLowering::LowerXConstraint(self: *TargetLowering, ConstraintVT: EVT) -> *u8 {
    if ConstraintVT.isInteger() {
        return "r";
    }
    if ConstraintVT.isFloatingPoint() {
        return "f";
    }
    return null;
}

fn TargetLowering::LowerAsmOutputForConstraint(self: *TargetLowering, Chain: *mut SDValue, Glue: *mut SDValue, DL: *SDLoc, OpInfo: *AsmOperandInfo, DAG: *mut SelectionDAG) -> SDValue {
    return SDValue {};
}

fn TargetLowering::LowerAsmOperandForConstraint(self: *TargetLowering, Op: SDValue, Constraint: str, Ops: *mut []SDValue, DAG: *mut SelectionDAG) {
    if Constraint.len > 1 {
        return;
    }
    let mut ConstraintLetter: i8 = Constraint[0];
    match ConstraintLetter {
        _ => {
            break;
        },
        'X' => {
            'i';
        },
    }
}

fn TargetLowering::CollectTargetIntrinsicOperands(self: *TargetLowering, I: *CallInst, Ops: *mut SmallVectorImpl<SDValue>, DAG: *mut SelectionDAG) {}

fn TargetLowering::getRegForInlineAsmConstraint(self: *TargetLowering, RI: *TargetRegisterInfo, Constraint: str, VT: MVT) -> pair<unsigned int, const TargetRegisterClass *> {
    if !Constraint.starts_with("{") {
        return pair<unsigned int, const TargetRegisterClass *> { make_pair(0, null as *mut TargetRegisterClass) };
    }
    assert!(*(Constraint.end() - 1) == '}', "Not a brace enclosed constraint?");
    let mut RegName: str = Constraint.ptr + 1[0..Constraint.len - 2];
    let mut R: pair<unsigned int, const TargetRegisterClass *> = make_pair(0, null as *TargetRegisterClass);
    for RC in RI.regclasses() {
        if !self.isLegalRC(*RI, RC) {
            continue;
        }
        for PR in RC {
            if RegName.equals_insensitive(RI.getRegAsmName(MCRegister { Reg: PR })) {
                let mut S: pair<unsigned int, const TargetRegisterClass *> = pair<unsigned int, const TargetRegisterClass *> { make_pair(PR, &mut RC) };
                if RI.isTypeLegalForClass(RC, VT) {
                    return S;
                }
                if !R.second {
                    R = S;
                }
            }
        }
    }
    return R;
}

fn AsmOperandInfo@TargetLowering@llvm::isMatchingInputConstraint(self: *AsmOperandInfo@TargetLowering@llvm) -> bool {
    assert!(!self.ConstraintCode.is_empty(), "No known constraint!");
    return isdigit(self.ConstraintCode[0] as u8);
}

fn AsmOperandInfo@TargetLowering@llvm::getMatchedOperand(self: *AsmOperandInfo@TargetLowering@llvm) -> u32 {
    assert!(!self.ConstraintCode.is_empty(), "No known constraint!");
    return atoi(self.ConstraintCode.ptr);
}

fn TargetLowering::ParseConstraints(self: *TargetLowering, DL: *DataLayout, TRI: *TargetRegisterInfo, Call: *CallBase) -> AsmOperandInfoVector {
    let mut ConstraintOperands: AsmOperandInfoVector = AsmOperandInfoVector {};
    let mut IA: *InlineAsm = cast(Call.getCalledOperand());
    let mut maCount: u32 = 0;
    let mut ArgNo: u32 = 0;
    let mut ResNo: u32 = 0;
    let mut LabelNo: u32 = 0;
    for CI in IA.ParseConstraints() {
        ConstraintOperands.emplace_back(move(CI));
        let mut OpInfo: *mut AsmOperandInfo = ConstraintOperands.back();
        if OpInfo.multipleAlternatives.len > maCount {
            maCount = OpInfo.multipleAlternatives.len;
        }
        OpInfo.ConstraintVT = MVT { SimpleTy: Other };
        match OpInfo.Type {
            isOutput => {
                if OpInfo.isIndirect {
                    OpInfo.CallOperandVal = Call.getArgOperand(ArgNo);
                    break;
                }
                assert!(!Call.getType().isVoidTy(), "Bad inline asm!");
                let mut VT: EVT = EVT {};
                if dyn_cast(Call.getType()) {
                    STy;
                } else {
                    VT = self.getAsmOperandValueType(DL, STy.getElementType(ResNo), false);
                }
                OpInfo.ConstraintVT = if VT.isSimple() { VT.getSimpleVT() } else { MVT { SimpleTy: Other } };
                ResNo += 1;
                break;
            },
            isInput => {
                OpInfo.CallOperandVal = Call.getArgOperand(ArgNo);
            },
            isLabel => {
                OpInfo.CallOperandVal = cast(&mut Call).getIndirectDest(LabelNo);
            },
            isClobber => {
                break;
            },
        }
        if OpInfo.CallOperandVal {
            let mut OpTy: *mut Type = OpInfo.CallOperandVal.getType();
            if OpInfo.isIndirect {
                OpTy = Call.getParamElementType(ArgNo);
                assert!(OpTy, "Indirect operand must have elementtype attribute");
            }
            if dyn_cast(OpTy) {
                STy;
            } else if STy.getNumElements() == 1 {
                OpTy = STy.getElementType(0);
            }
            if !OpTy.isSingleValueType() && OpTy.isSized() {
                let mut BitSize: u32 = DL.getTypeSizeInBits(OpTy).operator unsigned long long();
                match BitSize {
                    _ => {
                        break;
                    },
                    1 => {
                        8;
                    },
                }
            }
            let mut VT: EVT = self.getAsmOperandValueType(DL, OpTy, true);
            OpInfo.ConstraintVT = if VT.isSimple() { VT.getSimpleVT() } else { MVT { SimpleTy: Other } };
            ArgNo += 1;
        }
    }
    if !ConstraintOperands.is_empty() {
        if maCount {
            let mut bestMAIndex: u32 = 0;
            let mut bestWeight: i32 = -1;
            let mut weight: i32 = -1;
            let mut maIndex: u32 = 0;
            for maIndex = 0; maIndex < maCount; maIndex += 1 {
                let mut weightSum: i32 = 0;
                for let mut cIndex: u32 = 0;
let mut eIndex: u32 = ConstraintOperands.len; cIndex != eIndex; cIndex += 1 {
                    let mut OpInfo: *mut AsmOperandInfo = ConstraintOperands[cIndex];
                    if OpInfo.Type == isClobber {
                        continue;
                    }
                    if OpInfo.hasMatchingInput() {
                        let mut Input: *mut AsmOperandInfo = ConstraintOperands[OpInfo.MatchingInput];
                        if OpInfo.ConstraintVT != Input.ConstraintVT {
                            if (OpInfo.ConstraintVT.isInteger() != Input.ConstraintVT.isInteger()) || (OpInfo.ConstraintVT.getSizeInBits() != Input.ConstraintVT.getSizeInBits()) {
                                weightSum = -1;
                                break;
                            }
                        }
                    }
                    weight = self.getMultipleConstraintMatchWeight(OpInfo, maIndex);
                    if weight == -1 {
                        weightSum = -1;
                        break;
                    }
                    weightSum += weight;
                }
                if weightSum > bestWeight {
                    bestWeight = weightSum;
                    bestMAIndex = maIndex;
                }
            }
            for cInfo in ConstraintOperands {
                if cInfo.Type != isClobber {
                    cInfo.selectAlternative(bestMAIndex);
                }
            }
        }
    }
    for let mut cIndex: u32 = 0;
let mut eIndex: u32 = ConstraintOperands.len; cIndex != eIndex; cIndex += 1 {
        let mut OpInfo: *mut AsmOperandInfo = ConstraintOperands[cIndex];
        if OpInfo.hasMatchingInput() {
            let mut Input: *mut AsmOperandInfo = ConstraintOperands[OpInfo.MatchingInput];
            if OpInfo.ConstraintVT != Input.ConstraintVT {
                let mut MatchRC: pair<unsigned int, const TargetRegisterClass *> = self.getRegForInlineAsmConstraint(TRI, OpInfo.ConstraintCode, OpInfo.ConstraintVT);
                let mut InputRC: pair<unsigned int, const TargetRegisterClass *> = self.getRegForInlineAsmConstraint(TRI, Input.ConstraintCode, Input.ConstraintVT);
                let mut OutOpIsIntOrFP: bool = OpInfo.ConstraintVT.isInteger() || OpInfo.ConstraintVT.isFloatingPoint();
                let mut InOpIsIntOrFP: bool = Input.ConstraintVT.isInteger() || Input.ConstraintVT.isFloatingPoint();
                if (OutOpIsIntOrFP != InOpIsIntOrFP) || (MatchRC.second != InputRC.second) {
                    report_fatal_error("Unsupported asm: input constraint with a matching output constraint of incompatible type!", true);
                }
            }
        }
    }
    return ConstraintOperands;
}

fn getConstraintPiority(CT: ConstraintType) -> u32 {
    match CT {
        C_Immediate => {
            C_Other;
        },
        C_Memory => {
            C_Address;
        },
        C_RegisterClass => {
            return 2;
        },
        C_Register => {
            return 1;
        },
        C_Unknown => {
            return 0;
        },
    }
    llvm_unreachable_internal("Invalid constraint type", "llvm\\lib\\CodeGen\\SelectionDAG\\TargetLowering.cpp", 6444);
}

fn TargetLowering::getMultipleConstraintMatchWeight(self: *TargetLowering, info: *mut AsmOperandInfo, maIndex: i32) -> ConstraintWeight {
    let mut rCodes: *mut ConstraintCodeVector = null;
    if maIndex >= info.multipleAlternatives.len as i32 {
        rCodes = &mut info.Codes;
    } else {
        rCodes = &mut info.multipleAlternatives[maIndex].Codes;
    }
    let mut BestWeight: ConstraintWeight = CW_Invalid;
    for rCode in *rCodes {
        let mut weight: ConstraintWeight = self.getSingleConstraintMatchWeight(info, rCode.ptr);
        if weight > BestWeight {
            BestWeight = weight;
        }
    }
    return BestWeight;
}

fn TargetLowering::getSingleConstraintMatchWeight(self: *TargetLowering, info: *mut AsmOperandInfo, constraint: *u8) -> ConstraintWeight {
    let mut weight: ConstraintWeight = CW_Invalid;
    let mut CallOperandVal: *mut Value = info.CallOperandVal;
    if !CallOperandVal {
        return CW_Default;
    }
    match *constraint {
        'i' => {
            'n';
        },
        's' => {
            if isa(CallOperandVal) {
                weight = CW_Constant;
            }
        },
        'E' => {
            'F';
        },
        '<' => {
            '>';
        },
        'r' => {
            'g';
        },
        'X' => {
            weight = CW_Default;
        },
    }
    return weight;
}

fn TargetLowering::getConstraintPreferences(self: *TargetLowering, OpInfo: *mut AsmOperandInfo) -> ConstraintGroup {
    let mut Ret: ConstraintGroup = ConstraintGroup {};
    Ret.reserve(OpInfo.Codes.len);
    for Code in OpInfo.Codes {
        let mut CType: ConstraintType = self.getConstraintType(Code);
        if OpInfo.isIndirect && !(CType == C_Memory || CType == C_Register || CType == C_RegisterClass) {
            continue;
        }
        if CType == C_Memory && OpInfo.hasMatchingInput() {
            continue;
        }
        Ret.emplace_back(Code, CType);
    }
    stable_sort(Ret, Closure_15 {});
    return Ret;
}

fn lowerImmediateIfPossible(P: *mut ConstraintPair, Op: SDValue, DAG: *mut SelectionDAG, TLI: *TargetLowering) -> bool {
    assert!((P.second == C_Other || P.second == C_Immediate), "need immediate or other");
    if !Op.getNode() {
        return false;
    }
    let mut ResultOps: []SDValue = []SDValue {};
    TLI.LowerAsmOperandForConstraint(Op, P.first, ResultOps, *DAG);
    return !ResultOps.is_empty();
}

fn TargetLowering::ComputeConstraintToUse(self: *TargetLowering, OpInfo: *mut AsmOperandInfo, Op: SDValue, DAG: *mut SelectionDAG) {
    assert!(!OpInfo.Codes.is_empty(), "Must have at least one constraint");
    if OpInfo.Codes.len == 1 {
        OpInfo.ConstraintCode = OpInfo.Codes[0];
        OpInfo.ConstraintType = self.getConstraintType(OpInfo.ConstraintCode);
    } else {
        let mut G: ConstraintGroup = self.getConstraintPreferences(OpInfo);
        if G.len == 0 {
            return;
        }
        let mut BestIdx: u32 = 0;
        for let mut E: u32 = G.len; BestIdx < E && (G[BestIdx].second == C_Other || G[BestIdx].second == C_Immediate); BestIdx += 1 {
            if lowerImmediateIfPossible(G[BestIdx], Op, DAG, *self) {
                break;
            }
            if BestIdx + 1 == E {
                BestIdx = 0;
                break;
            }
        }
        OpInfo.ConstraintCode = G[BestIdx].first;
        OpInfo.ConstraintType = G[BestIdx].second;
    }
    if OpInfo.ConstraintCode == "X" && OpInfo.CallOperandVal {
        let mut v: *mut Value = OpInfo.CallOperandVal;
        if isa(v) || isa(v) {
            return;
        }
        if isa(v) || isa(v) {
            OpInfo.ConstraintCode = "i";
            return;
        }
        if self.LowerXConstraint(EVT { OpInfo.ConstraintVT }) {
            Repl;
        } else {
            OpInfo.ConstraintCode = Repl;
            OpInfo.ConstraintType = self.getConstraintType(OpInfo.ConstraintCode);
        }
    }
}

fn BuildExactSDIV(TLI: *TargetLowering, N: *mut SDNode, dl: *SDLoc, DAG: *mut SelectionDAG, Created: *mut SmallVectorImpl<SDNode *>) -> SDValue {
    let mut Op0: SDValue = N.getOperand(0);
    let mut Op1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut ShVT: EVT = TLI.getShiftAmountTy(VT, DAG.getDataLayout());
    let mut ShSVT: EVT = ShVT.getScalarType();
    let mut UseSRA: bool = false;
    let mut Shifts: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut Factors: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut BuildSDIVPattern: Closure_16 = Closure_16 { UseSRA: &mut UseSRA, Shifts: &mut Shifts, DAG: &mut DAG, dl: &mut dl, ShSVT: &mut ShSVT, Factors: &mut Factors };
    if !matchUnaryPredicate(Op1, function<bool (ConstantSDNode *)> { BuildSDIVPattern }, false, false) {
        return SDValue {};
    }
    let mut Shift: SDValue = SDValue {};
    let mut Factor: SDValue = SDValue {};
    if Op1.getOpcode() == BUILD_VECTOR {
        Shift = DAG.getBuildVector(ShVT, dl, ArrayRef<SDValue> { Shifts });
        Factor = DAG.getBuildVector(VT, dl, ArrayRef<SDValue> { Factors });
    } else if Op1.getOpcode() == SPLAT_VECTOR {
        assert!(Shifts.len == 1 && Factors.len == 1, "Expected matchUnaryPredicate to return one element for scalable vectors");
        Shift = DAG.getSplatVector(ShVT, dl, Shifts[0]);
        Factor = DAG.getSplatVector(VT, dl, Factors[0]);
    } else {
        assert!(isa(Op1), "Expected a constant");
        Shift = Shifts[0];
        Factor = Factors[0];
    }
    let mut Res: SDValue = Op0;
    if UseSRA {
        Res = DAG.getNode(SRA, dl, VT, Res, Shift, SDNodeFlags { Flags: Exact });
        Created.push(Res.getNode());
    }
    return DAG.getNode(MUL, dl, VT, Res, Factor);
}

fn BuildExactUDIV(TLI: *TargetLowering, N: *mut SDNode, dl: *SDLoc, DAG: *mut SelectionDAG, Created: *mut SmallVectorImpl<SDNode *>) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut ShVT: EVT = TLI.getShiftAmountTy(VT, DAG.getDataLayout());
    let mut ShSVT: EVT = ShVT.getScalarType();
    let mut UseSRL: bool = false;
    let mut Shifts: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut Factors: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut BuildUDIVPattern: Closure_17 = Closure_17 { UseSRL: &mut UseSRL, Shifts: &mut Shifts, DAG: &mut DAG, dl: &mut dl, ShSVT: &mut ShSVT, Factors: &mut Factors };
    let mut Op1: SDValue = N.getOperand(1);
    if !matchUnaryPredicate(Op1, function<bool (ConstantSDNode *)> { BuildUDIVPattern }, false, false) {
        return SDValue {};
    }
    let mut Shift: SDValue = SDValue {};
    let mut Factor: SDValue = SDValue {};
    if Op1.getOpcode() == BUILD_VECTOR {
        Shift = DAG.getBuildVector(ShVT, dl, ArrayRef<SDValue> { Shifts });
        Factor = DAG.getBuildVector(VT, dl, ArrayRef<SDValue> { Factors });
    } else if Op1.getOpcode() == SPLAT_VECTOR {
        assert!(Shifts.len == 1 && Factors.len == 1, "Expected matchUnaryPredicate to return one element for scalable vectors");
        Shift = DAG.getSplatVector(ShVT, dl, Shifts[0]);
        Factor = DAG.getSplatVector(VT, dl, Factors[0]);
    } else {
        assert!(isa(Op1), "Expected a constant");
        Shift = Shifts[0];
        Factor = Factors[0];
    }
    let mut Res: SDValue = N.getOperand(0);
    if UseSRL {
        Res = DAG.getNode(SRL, dl, VT, Res, Shift, SDNodeFlags { Flags: Exact });
        Created.push(Res.getNode());
    }
    return DAG.getNode(MUL, dl, VT, Res, Factor);
}

fn TargetLowering::BuildSDIVPow2(self: *TargetLowering, N: *mut SDNode, Divisor: *APInt, DAG: *mut SelectionDAG, Created: *mut SmallVectorImpl<SDNode *>) -> SDValue {
    let mut Attr: AttributeList = DAG.getMachineFunction().getFunction().getAttributes();
    if self.isIntDivCheap(N.getValueType(0), Attr) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn TargetLowering::BuildSREMPow2(self: *TargetLowering, N: *mut SDNode, Divisor: *APInt, DAG: *mut SelectionDAG, Created: *mut SmallVectorImpl<SDNode *>) -> SDValue {
    let mut Attr: AttributeList = DAG.getMachineFunction().getFunction().getAttributes();
    if self.isIntDivCheap(N.getValueType(0), Attr) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn TargetLowering::buildSDIVPow2WithCMov(self: *TargetLowering, N: *mut SDNode, Divisor: *APInt, DAG: *mut SelectionDAG, Created: *mut SmallVectorImpl<SDNode *>) -> SDValue {
    let mut Lg2: u32 = Divisor.countr_zero();
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    let mut N0: SDValue = N.getOperand(0);
    let mut Zero: SDValue = DAG.getConstant(0, DL, VT, false, false);
    let mut Lg2Mask: APInt = getLowBitsSet(VT.getSizeInBits().operator unsigned long long(), Lg2);
    let mut Pow2MinusOne: SDValue = DAG.getConstant(Lg2Mask, DL, VT, false, false);
    let mut CCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT);
    let mut Cmp: SDValue = DAG.getSetCC(DL, CCVT, N0, Zero, SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut Add: SDValue = DAG.getNode(ADD, DL, VT, N0, Pow2MinusOne);
    let mut CMov: SDValue = DAG.getNode(SELECT, DL, VT, Cmp, Add, N0);
    Created.push(Cmp.getNode());
    Created.push(Add.getNode());
    Created.push(CMov.getNode());
    let mut SRA: SDValue = DAG.getNode(SRA, DL, VT, CMov, DAG.getShiftAmountConstant(Lg2, VT, DL));
    if Divisor.isNonNegative() {
        return SRA;
    }
    Created.push(SRA.getNode());
    return DAG.getNode(SUB, DL, VT, Zero, SRA);
}

fn TargetLowering::BuildSDIV(self: *TargetLowering, N: *mut SDNode, DAG: *mut SelectionDAG, IsAfterLegalization: bool, IsAfterLegalTypes: bool, Created: *mut SmallVectorImpl<SDNode *>) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    if N.getFlags().hasExact() {
        return BuildExactSDIV(*self, N, dl, DAG, Created);
    }
    let mut VT: EVT = N.getValueType(0);
    let mut SVT: EVT = VT.getScalarType();
    let mut ShVT: EVT = self.getShiftAmountTy(VT, DAG.getDataLayout());
    let mut ShSVT: EVT = ShVT.getScalarType();
    let mut EltBits: u32 = VT.getScalarSizeInBits();
    let mut MulVT: EVT = EVT {};
    let mut QueryVT: EVT = VT;
    if VT.isVector() {
        QueryVT = self.getLegalTypeToTransformTo(*DAG.getContext(), VT);
        if !QueryVT.isVector() || QueryVT.getVectorElementType() != VT.getVectorElementType() {
            return SDValue {};
        }
    } else if !self.isTypeLegal(VT) {
        if !VT.isSimple() {
            return SDValue {};
        }
        if self.getTypeAction(VT.getSimpleVT()) != TypePromoteInteger {
            return SDValue {};
        }
        MulVT = self.getTypeToTransformTo(*DAG.getContext(), VT);
        if MulVT.getSizeInBits().operator unsigned long long() < (2 * EltBits) || !self.isOperationLegal(MUL, MulVT) {
            return SDValue {};
        }
    }
    let mut HasMULHS: bool = self.isOperationLegalOrCustom(MULHS, QueryVT, IsAfterLegalization);
    let mut HasSMUL_LOHI: bool = self.isOperationLegalOrCustom(SMUL_LOHI, QueryVT, IsAfterLegalization);
    if self.isTypeLegal(VT) && !HasMULHS && !HasSMUL_LOHI && MulVT == EVT {} {
        let mut WideVT: EVT = VT.widenIntegerElementType(*DAG.getContext());
        if (!IsAfterLegalTypes && self.isOperationExpand(SDIV, VT) && self.isOperationCustom(SDIVREM, VT.getScalarType())) || self.isOperationLegalOrCustom(MUL, WideVT, false) {
            MulVT = WideVT;
        }
    }
    if !HasMULHS && !HasSMUL_LOHI && MulVT == EVT {} {
        return SDValue {};
    }
    if IsAfterLegalTypes && VT.isVector() {
        SVT = self.getTypeToTransformTo(*DAG.getContext(), SVT);
        if SVT.bitsLT(VT.getScalarType()) {
            return SDValue {};
        }
        ShSVT = self.getTypeToTransformTo(*DAG.getContext(), ShSVT);
        if ShSVT.bitsLT(ShVT.getScalarType()) {
            return SDValue {};
        }
    }
    let mut SVTBits: u32 = SVT.getSizeInBits().operator unsigned long long();
    let mut MagicFactors: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut Factors: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut Shifts: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut ShiftMasks: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut BuildSDIVPattern: Closure_18 = Closure_18 { EltBits: &mut EltBits, MagicFactors: &mut MagicFactors, DAG: &mut DAG, SVTBits: &mut SVTBits, dl: &mut dl, SVT: &mut SVT, Factors: &mut Factors, Shifts: &mut Shifts, ShSVT: &mut ShSVT, ShiftMasks: &mut ShiftMasks };
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    if !matchUnaryPredicate(N1, function<bool (ConstantSDNode *)> { BuildSDIVPattern }, false, true) {
        return SDValue {};
    }
    let mut MagicFactor: SDValue = SDValue {};
    let mut Factor: SDValue = SDValue {};
    let mut Shift: SDValue = SDValue {};
    let mut ShiftMask: SDValue = SDValue {};
    if N1.getOpcode() == BUILD_VECTOR {
        MagicFactor = DAG.getBuildVector(VT, dl, ArrayRef<SDValue> { MagicFactors });
        Factor = DAG.getBuildVector(VT, dl, ArrayRef<SDValue> { Factors });
        Shift = DAG.getBuildVector(ShVT, dl, ArrayRef<SDValue> { Shifts });
        ShiftMask = DAG.getBuildVector(VT, dl, ArrayRef<SDValue> { ShiftMasks });
    } else if N1.getOpcode() == SPLAT_VECTOR {
        assert!(MagicFactors.len == 1 && Factors.len == 1 && Shifts.len == 1 && ShiftMasks.len == 1, "Expected matchUnaryPredicate to return one element for scalable vectors");
        MagicFactor = DAG.getSplatVector(VT, dl, MagicFactors[0]);
        Factor = DAG.getSplatVector(VT, dl, Factors[0]);
        Shift = DAG.getSplatVector(ShVT, dl, Shifts[0]);
        ShiftMask = DAG.getSplatVector(VT, dl, ShiftMasks[0]);
    } else {
        assert!(isa(N1), "Expected a constant");
        MagicFactor = MagicFactors[0];
        Factor = Factors[0];
        Shift = Shifts[0];
        ShiftMask = ShiftMasks[0];
    }
    let mut GetMULHS: Closure_19 = Closure_19 { HasMULHS: &mut HasMULHS, DAG: &mut DAG, dl: &mut dl, VT: &mut VT, HasSMUL_LOHI: &mut HasSMUL_LOHI, MulVT: &mut MulVT, EltBits: &mut EltBits };
    let mut Q: SDValue = GetMULHS.call(N0, MagicFactor);
    if !Q {
        return SDValue {};
    }
    Created.push(Q.getNode());
    Factor = DAG.getNode(MUL, dl, VT, N0, Factor);
    Created.push(Factor.getNode());
    Q = DAG.getNode(ADD, dl, VT, Q, Factor);
    Created.push(Q.getNode());
    Q = DAG.getNode(SRA, dl, VT, Q, Shift);
    Created.push(Q.getNode());
    let mut SignShift: SDValue = DAG.getConstant(EltBits - 1, dl, ShVT, false, false);
    let mut T: SDValue = DAG.getNode(SRL, dl, VT, Q, SignShift);
    Created.push(T.getNode());
    T = DAG.getNode(AND, dl, VT, T, ShiftMask);
    Created.push(T.getNode());
    return DAG.getNode(ADD, dl, VT, Q, T);
}

fn TargetLowering::BuildUDIV(self: *TargetLowering, N: *mut SDNode, DAG: *mut SelectionDAG, IsAfterLegalization: bool, IsAfterLegalTypes: bool, Created: *mut SmallVectorImpl<SDNode *>) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    if N.getFlags().hasExact() {
        return BuildExactUDIV(*self, N, dl, DAG, Created);
    }
    let mut VT: EVT = N.getValueType(0);
    let mut SVT: EVT = VT.getScalarType();
    let mut ShVT: EVT = self.getShiftAmountTy(VT, DAG.getDataLayout());
    let mut ShSVT: EVT = ShVT.getScalarType();
    let mut EltBits: u32 = VT.getScalarSizeInBits();
    let mut MulVT: EVT = EVT {};
    let mut QueryVT: EVT = VT;
    if VT.isVector() {
        QueryVT = self.getLegalTypeToTransformTo(*DAG.getContext(), VT);
        if !QueryVT.isVector() || QueryVT.getVectorElementType() != VT.getVectorElementType() {
            return SDValue {};
        }
    } else if !self.isTypeLegal(VT) {
        if !VT.isSimple() {
            return SDValue {};
        }
        if self.getTypeAction(VT.getSimpleVT()) != TypePromoteInteger {
            return SDValue {};
        }
        MulVT = self.getTypeToTransformTo(*DAG.getContext(), VT);
        if MulVT.getSizeInBits().operator unsigned long long() < (2 * EltBits) || !self.isOperationLegal(MUL, MulVT) {
            return SDValue {};
        }
    }
    let mut HasMULHU: bool = self.isOperationLegalOrCustom(MULHU, QueryVT, IsAfterLegalization);
    let mut HasUMUL_LOHI: bool = self.isOperationLegalOrCustom(UMUL_LOHI, QueryVT, IsAfterLegalization);
    if self.isTypeLegal(VT) && !HasMULHU && !HasUMUL_LOHI && MulVT == EVT {} {
        let mut WideVT: EVT = VT.widenIntegerElementType(*DAG.getContext());
        if (!IsAfterLegalTypes && self.isOperationExpand(UDIV, VT) && self.isOperationCustom(UDIVREM, VT.getScalarType())) || self.isOperationLegalOrCustom(MUL, WideVT, false) {
            MulVT = WideVT;
        }
    }
    if !HasMULHU && !HasUMUL_LOHI && MulVT == EVT {} {
        return SDValue {};
    }
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut KnownLeadingZeros: u32 = DAG.computeKnownBits(N0, 0).countMinLeadingZeros();
    if IsAfterLegalTypes && VT.isVector() {
        SVT = self.getTypeToTransformTo(*DAG.getContext(), SVT);
        if SVT.bitsLT(VT.getScalarType()) {
            return SDValue {};
        }
        ShSVT = self.getTypeToTransformTo(*DAG.getContext(), ShSVT);
        if ShSVT.bitsLT(ShVT.getScalarType()) {
            return SDValue {};
        }
    }
    let mut SVTBits: u32 = SVT.getSizeInBits().operator unsigned long long();
    let mut WideSVT: EVT = EVT { i64 };
    let mut HasWideMULHU: bool = VT == EVT { i32 } && self.isOperationLegalOrCustom(MULHU, WideSVT, IsAfterLegalization);
    let mut HasWideUMUL_LOHI: bool = VT == EVT { i32 } && self.isOperationLegalOrCustom(UMUL_LOHI, WideSVT, IsAfterLegalization);
    let mut AllowWiden: bool = (HasWideMULHU || HasWideUMUL_LOHI);
    let mut AllowEvenToWiden: bool = AllowWiden && self.isZExtFree(VT, WideSVT);
    let mut UseNPQ: bool = false;
    let mut UsePreShift: bool = false;
    let mut UsePostShift: bool = false;
    let mut UseWiden: bool = false;
    let mut PreShifts: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut PostShifts: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut MagicFactors: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut NPQFactors: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut BuildUDIVPattern: Closure_20 = Closure_20 { EltBits: &mut EltBits, DAG: &mut DAG, ShSVT: &mut ShSVT, SVT: &mut SVT, KnownLeadingZeros: &mut KnownLeadingZeros, AllowEvenToWiden: &mut AllowEvenToWiden, AllowWiden: &mut AllowWiden, UseWiden: &mut UseWiden, dl: &mut dl, WideSVT: &mut WideSVT, SVTBits: &mut SVTBits, UseNPQ: &mut UseNPQ, UsePreShift: &mut UsePreShift, UsePostShift: &mut UsePostShift, PreShifts: &mut PreShifts, MagicFactors: &mut MagicFactors, NPQFactors: &mut NPQFactors, PostShifts: &mut PostShifts };
    if !matchUnaryPredicate(N1, function<bool (ConstantSDNode *)> { BuildUDIVPattern }, false, true) {
        return SDValue {};
    }
    let mut PreShift: SDValue = SDValue {};
    let mut PostShift: SDValue = SDValue {};
    let mut MagicFactor: SDValue = SDValue {};
    let mut NPQFactor: SDValue = SDValue {};
    if N1.getOpcode() == BUILD_VECTOR {
        PreShift = DAG.getBuildVector(ShVT, dl, ArrayRef<SDValue> { PreShifts });
        MagicFactor = DAG.getBuildVector(VT, dl, ArrayRef<SDValue> { MagicFactors });
        NPQFactor = DAG.getBuildVector(VT, dl, ArrayRef<SDValue> { NPQFactors });
        PostShift = DAG.getBuildVector(ShVT, dl, ArrayRef<SDValue> { PostShifts });
    } else if N1.getOpcode() == SPLAT_VECTOR {
        assert!(PreShifts.len == 1 && MagicFactors.len == 1 && NPQFactors.len == 1 && PostShifts.len == 1, "Expected matchUnaryPredicate to return one for scalable vectors");
        PreShift = DAG.getSplatVector(ShVT, dl, PreShifts[0]);
        MagicFactor = DAG.getSplatVector(VT, dl, MagicFactors[0]);
        NPQFactor = DAG.getSplatVector(VT, dl, NPQFactors[0]);
        PostShift = DAG.getSplatVector(ShVT, dl, PostShifts[0]);
    } else {
        assert!(isa(N1), "Expected a constant");
        PreShift = PreShifts[0];
        MagicFactor = MagicFactors[0];
        PostShift = PostShifts[0];
    }
    if UseWiden {
        let mut WideN0: SDValue = DAG.getNode(ZERO_EXTEND, dl, WideSVT, N0);
        let mut High: SDValue = SDValue {};
        if HasWideMULHU {
            High = DAG.getNode(MULHU, dl, WideSVT, WideN0, MagicFactor);
        } else {
            assert!(HasWideUMUL_LOHI);
            let mut LoHi: SDValue = DAG.getNode(UMUL_LOHI, dl, DAG.getVTList(WideSVT, WideSVT), WideN0, MagicFactor);
            High = LoHi.getValue(1);
        }
        Created.push(High.getNode());
        return DAG.getNode(TRUNCATE, dl, VT, High);
    }
    let mut Q: SDValue = N0;
    if UsePreShift {
        Q = DAG.getNode(SRL, dl, VT, Q, PreShift);
        Created.push(Q.getNode());
    }
    let mut GetMULHU: Closure_21 = Closure_21 { HasMULHU: &mut HasMULHU, DAG: &mut DAG, dl: &mut dl, VT: &mut VT, HasUMUL_LOHI: &mut HasUMUL_LOHI, MulVT: &mut MulVT, EltBits: &mut EltBits };
    Q = GetMULHU.call(Q, MagicFactor);
    if !Q {
        return SDValue {};
    }
    Created.push(Q.getNode());
    if UseNPQ {
        let mut NPQ: SDValue = DAG.getNode(SUB, dl, VT, N0, Q);
        Created.push(NPQ.getNode());
        if VT.isVector() {
            NPQ = GetMULHU.call(NPQ, NPQFactor);
        } else {
            NPQ = DAG.getNode(SRL, dl, VT, NPQ, DAG.getConstant(1, dl, ShVT, false, false));
        }
        Created.push(NPQ.getNode());
        Q = DAG.getNode(ADD, dl, VT, NPQ, Q);
        Created.push(Q.getNode());
    }
    if UsePostShift {
        Q = DAG.getNode(SRL, dl, VT, Q, PostShift);
        Created.push(Q.getNode());
    }
    let mut SetCCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT);
    let mut One: SDValue = DAG.getConstant(1, dl, VT, false, false);
    let mut IsOne: SDValue = DAG.getSetCC(dl, SetCCVT, N1, One, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
    return DAG.getSelect(dl, VT, IsOne, N0, Q, SDNodeFlags { Flags: None });
}

fn turnVectorIntoSplatVector(Values: MutableArrayRef<SDValue>, Predicate: function<bool (SDValue)>, AlternativeReplacement: SDValue) {
    let mut Replacement: SDValue = SDValue {};
    let mut SplatValue: *mut SDValue = find_if_not(Values, Predicate);
    if SplatValue != Values.end() {
        if all_of(Values, Closure_22 { cap_0: function<bool (SDValue)> { Predicate }, SplatValue: SplatValue }) {
            Replacement = *SplatValue;
        }
    }
    if !Replacement {
        if !AlternativeReplacement {
            return;
        }
        Replacement = AlternativeReplacement;
    }
    replace_if(Values.begin(), Values.end(), Predicate, Replacement);
}

fn TargetLowering::buildUREMEqFold(self: *TargetLowering, SETCCVT: EVT, REMNode: SDValue, CompTargetNode: SDValue, Cond: CondCode, DCI: *mut DAGCombinerInfo, DL: *SDLoc) -> SDValue {
    let mut Built: SmallVector<SDNode *, 5> = SmallVector<SDNode *, 5> {};
    if self.prepareUREMEqFold(SETCCVT, REMNode, CompTargetNode, Cond, DCI, DL, Built) {
        Folded;
    } else {
        for N in Built {
            DCI.AddToWorklist(N);
        }
        return Folded;
    }
    return SDValue {};
}

fn TargetLowering::prepareUREMEqFold(self: *TargetLowering, SETCCVT: EVT, REMNode: SDValue, CompTargetNode: SDValue, Cond: CondCode, DCI: *mut DAGCombinerInfo, DL: *SDLoc, Created: *mut SmallVectorImpl<SDNode *>) -> SDValue {
    assert!((Cond == SETEQ || Cond == SETNE), "Only applicable for (in)equality comparisons.");
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut VT: EVT = REMNode.getValueType();
    let mut SVT: EVT = VT.getScalarType();
    let mut ShVT: EVT = self.getShiftAmountTy(VT, DAG.getDataLayout());
    let mut ShSVT: EVT = ShVT.getScalarType();
    if !DCI.isBeforeLegalizeOps() && !self.isOperationLegalOrCustom(MUL, VT, false) {
        return SDValue {};
    }
    let mut ComparingWithAllZeros: bool = true;
    let mut AllComparisonsWithNonZerosAreTautological: bool = true;
    let mut HadTautologicalLanes: bool = false;
    let mut AllLanesAreTautological: bool = true;
    let mut HadEvenDivisor: bool = false;
    let mut AllDivisorsArePowerOfTwo: bool = true;
    let mut HadTautologicalInvertedLanes: bool = false;
    let mut PAmts: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut KAmts: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut QAmts: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut BuildUREMPattern: Closure_23 = Closure_23 { ComparingWithAllZeros: &mut ComparingWithAllZeros, HadTautologicalInvertedLanes: &mut HadTautologicalInvertedLanes, HadTautologicalLanes: &mut HadTautologicalLanes, AllLanesAreTautological: &mut AllLanesAreTautological, AllComparisonsWithNonZerosAreTautological: &mut AllComparisonsWithNonZerosAreTautological, HadEvenDivisor: &mut HadEvenDivisor, AllDivisorsArePowerOfTwo: &mut AllDivisorsArePowerOfTwo, ShSVT: &mut ShSVT, KAmts: &mut KAmts, DAG: &mut DAG, DL: &mut DL, PAmts: &mut PAmts, SVT: &mut SVT, QAmts: &mut QAmts };
    let mut N: SDValue = REMNode.getOperand(0);
    let mut D: SDValue = REMNode.getOperand(1);
    if !matchBinaryPredicate(D, CompTargetNode, function<bool (ConstantSDNode *, ConstantSDNode *)> { BuildUREMPattern }, false, false) {
        return SDValue {};
    }
    if AllLanesAreTautological {
        return SDValue {};
    }
    if AllDivisorsArePowerOfTwo {
        return SDValue {};
    }
    let mut PVal: SDValue = SDValue {};
    let mut KVal: SDValue = SDValue {};
    let mut QVal: SDValue = SDValue {};
    if D.getOpcode() == BUILD_VECTOR {
        if HadTautologicalLanes {
            turnVectorIntoSplatVector(MutableArrayRef<SDValue> { PAmts }, function<bool (SDValue)> { isNullConstant }, SDValue {});
            turnVectorIntoSplatVector(MutableArrayRef<SDValue> { KAmts }, function<bool (SDValue)> { isAllOnesConstant }, DAG.getConstant(0, DL, ShSVT, false, false));
        }
        PVal = DAG.getBuildVector(VT, DL, ArrayRef<SDValue> { PAmts });
        KVal = DAG.getBuildVector(ShVT, DL, ArrayRef<SDValue> { KAmts });
        QVal = DAG.getBuildVector(VT, DL, ArrayRef<SDValue> { QAmts });
    } else if D.getOpcode() == SPLAT_VECTOR {
        assert!(PAmts.len == 1 && KAmts.len == 1 && QAmts.len == 1, "Expected matchBinaryPredicate to return one element for SPLAT_VECTORs");
        PVal = DAG.getSplatVector(VT, DL, PAmts[0]);
        KVal = DAG.getSplatVector(ShVT, DL, KAmts[0]);
        QVal = DAG.getSplatVector(VT, DL, QAmts[0]);
    } else {
        PVal = PAmts[0];
        KVal = KAmts[0];
        QVal = QAmts[0];
    }
    if !ComparingWithAllZeros && !AllComparisonsWithNonZerosAreTautological {
        if !DCI.isBeforeLegalizeOps() && !self.isOperationLegalOrCustom(SUB, VT, false) {
            return SDValue {};
        }
        assert!(CompTargetNode.getValueType() == N.getValueType(), "Expecting that the types on LHS and RHS of comparisons match.");
        N = DAG.getNode(SUB, DL, VT, N, CompTargetNode);
    }
    let mut Op0: SDValue = DAG.getNode(MUL, DL, VT, N, PVal);
    Created.push(Op0.getNode());
    if HadEvenDivisor {
        if !DCI.isBeforeLegalizeOps() && !self.isOperationLegalOrCustom(ROTR, VT, false) {
            return SDValue {};
        }
        Op0 = DAG.getNode(ROTR, DL, VT, Op0, KVal);
        Created.push(Op0.getNode());
    }
    let mut NewCC: SDValue = DAG.getSetCC(DL, SETCCVT, Op0, QVal, (if (Cond == SETEQ) { SETULE } else { SETUGT }), SDValue {}, false, SDNodeFlags { Flags: None });
    if !HadTautologicalInvertedLanes {
        return NewCC;
    }
    assert!(VT.isVector(), "Can/should only get here for vectors.");
    Created.push(NewCC.getNode());
    let mut TautologicalInvertedChannels: SDValue = DAG.getSetCC(DL, SETCCVT, D, CompTargetNode, SETULE, SDValue {}, false, SDNodeFlags { Flags: None });
    Created.push(TautologicalInvertedChannels.getNode());
    if self.isOperationLegalOrCustom(VSELECT, SETCCVT, false) {
        let mut Replacement: SDValue = DAG.getBoolConstant(if Cond == SETEQ { false } else { true }, DL, SETCCVT, SETCCVT);
        return DAG.getNode(VSELECT, DL, SETCCVT, TautologicalInvertedChannels, Replacement, NewCC);
    }
    if self.isOperationLegalOrCustom(XOR, SETCCVT, false) {
        return DAG.getNode(XOR, DL, SETCCVT, NewCC, TautologicalInvertedChannels);
    }
    return SDValue {};
}

fn TargetLowering::buildSREMEqFold(self: *TargetLowering, SETCCVT: EVT, REMNode: SDValue, CompTargetNode: SDValue, Cond: CondCode, DCI: *mut DAGCombinerInfo, DL: *SDLoc) -> SDValue {
    let mut Built: SmallVector<SDNode *, 7> = SmallVector<SDNode *, 7> {};
    if self.prepareSREMEqFold(SETCCVT, REMNode, CompTargetNode, Cond, DCI, DL, Built) {
        Folded;
    } else {
        assert!(Built.len <= 7, "Max size prediction failed.");
        for N in Built {
            DCI.AddToWorklist(N);
        }
        return Folded;
    }
    return SDValue {};
}

fn TargetLowering::prepareSREMEqFold(self: *TargetLowering, SETCCVT: EVT, REMNode: SDValue, CompTargetNode: SDValue, Cond: CondCode, DCI: *mut DAGCombinerInfo, DL: *SDLoc, Created: *mut SmallVectorImpl<SDNode *>) -> SDValue {
    assert!((Cond == SETEQ || Cond == SETNE), "Only applicable for (in)equality comparisons.");
    let mut DAG: *mut SelectionDAG = DCI.DAG;
    let mut VT: EVT = REMNode.getValueType();
    let mut SVT: EVT = VT.getScalarType();
    let mut ShVT: EVT = self.getShiftAmountTy(VT, DAG.getDataLayout());
    let mut ShSVT: EVT = ShVT.getScalarType();
    if !DCI.isBeforeLegalizeOps() && !self.isOperationLegalOrCustom(MUL, VT, false) {
        return SDValue {};
    }
    let mut CompTarget: *mut ConstantSDNode = isConstOrConstSplat(CompTargetNode, false, false);
    if !CompTarget || !CompTarget.isZero() {
        return SDValue {};
    }
    let mut HadOneDivisor: bool = false;
    let mut AllDivisorsAreOnes: bool = true;
    let mut HadEvenDivisor: bool = false;
    let mut AllDivisorsArePowerOfTwo: bool = true;
    let mut PAmts: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut AAmts: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut KAmts: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut QAmts: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut BuildSREMPattern: Closure_24 = Closure_24 { HadOneDivisor: &mut HadOneDivisor, AllDivisorsAreOnes: &mut AllDivisorsAreOnes, HadEvenDivisor: &mut HadEvenDivisor, AllDivisorsArePowerOfTwo: &mut AllDivisorsArePowerOfTwo, SVT: &mut SVT, ShSVT: &mut ShSVT, KAmts: &mut KAmts, DAG: &mut DAG, DL: &mut DL, PAmts: &mut PAmts, AAmts: &mut AAmts, QAmts: &mut QAmts };
    let mut N: SDValue = REMNode.getOperand(0);
    let mut D: SDValue = REMNode.getOperand(1);
    if !matchUnaryPredicate(D, function<bool (ConstantSDNode *)> { BuildSREMPattern }, false, false) {
        return SDValue {};
    }
    if AllDivisorsAreOnes {
        return SDValue {};
    }
    if AllDivisorsArePowerOfTwo {
        return SDValue {};
    }
    let mut PVal: SDValue = SDValue {};
    let mut AVal: SDValue = SDValue {};
    let mut KVal: SDValue = SDValue {};
    let mut QVal: SDValue = SDValue {};
    if D.getOpcode() == BUILD_VECTOR {
        if HadOneDivisor {
            turnVectorIntoSplatVector(MutableArrayRef<SDValue> { PAmts }, function<bool (SDValue)> { isNullConstant }, SDValue {});
            turnVectorIntoSplatVector(MutableArrayRef<SDValue> { AAmts }, function<bool (SDValue)> { isAllOnesConstant }, DAG.getConstant(0, DL, SVT, false, false));
            turnVectorIntoSplatVector(MutableArrayRef<SDValue> { KAmts }, function<bool (SDValue)> { isAllOnesConstant }, DAG.getConstant(0, DL, ShSVT, false, false));
        }
        PVal = DAG.getBuildVector(VT, DL, ArrayRef<SDValue> { PAmts });
        AVal = DAG.getBuildVector(VT, DL, ArrayRef<SDValue> { AAmts });
        KVal = DAG.getBuildVector(ShVT, DL, ArrayRef<SDValue> { KAmts });
        QVal = DAG.getBuildVector(VT, DL, ArrayRef<SDValue> { QAmts });
    } else if D.getOpcode() == SPLAT_VECTOR {
        assert!(PAmts.len == 1 && AAmts.len == 1 && KAmts.len == 1 && QAmts.len == 1, "Expected matchUnaryPredicate to return one element for scalable vectors");
        PVal = DAG.getSplatVector(VT, DL, PAmts[0]);
        AVal = DAG.getSplatVector(VT, DL, AAmts[0]);
        KVal = DAG.getSplatVector(ShVT, DL, KAmts[0]);
        QVal = DAG.getSplatVector(VT, DL, QAmts[0]);
    } else {
        assert!(isa(D), "Expected a constant");
        PVal = PAmts[0];
        AVal = AAmts[0];
        KVal = KAmts[0];
        QVal = QAmts[0];
    }
    let mut Op0: SDValue = DAG.getNode(MUL, DL, VT, N, PVal);
    Created.push(Op0.getNode());
    if !DCI.isBeforeLegalizeOps() && !self.isOperationLegalOrCustom(ADD, VT, false) {
        return SDValue {};
    }
    Op0 = DAG.getNode(ADD, DL, VT, Op0, AVal);
    Created.push(Op0.getNode());
    if HadEvenDivisor {
        if !DCI.isBeforeLegalizeOps() && !self.isOperationLegalOrCustom(ROTR, VT, false) {
            return SDValue {};
        }
        Op0 = DAG.getNode(ROTR, DL, VT, Op0, KVal);
        Created.push(Op0.getNode());
    }
    return DAG.getSetCC(DL, SETCCVT, Op0, QVal, if (Cond == SETEQ) { SETULE } else { SETUGT }, SDValue {}, false, SDNodeFlags { Flags: None });
}

fn TargetLowering::getSqrtInputTest(self: *TargetLowering, Op: SDValue, DAG: *mut SelectionDAG, Mode: *DenormalMode, Flags: SDNodeFlags) -> SDValue {
    let mut DL: SDLoc = SDLoc { Op };
    let mut VT: EVT = Op.getValueType();
    let mut CCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT);
    let mut FPZero: SDValue = DAG.getConstantFP(0.0, DL, VT, false);
    if Mode.Input == PreserveSign || Mode.Input == PositiveZero {
        return DAG.getSetCC(DL, CCVT, Op, FPZero, SETEQ, SDValue {}, false, Flags);
    }
    let mut FltSem: *fltSemantics = VT.getFltSemantics();
    let mut SmallestNorm: APFloat = getSmallestNormalized(FltSem, false);
    let mut NormC: SDValue = DAG.getConstantFP(SmallestNorm, DL, VT, false);
    let mut Fabs: SDValue = DAG.getNode(FABS, DL, VT, Op, Flags);
    return DAG.getSetCC(DL, CCVT, Fabs, NormC, SETLT, SDValue {}, false, Flags);
}

fn TargetLowering::getNegatedExpression(self: *TargetLowering, Op: SDValue, DAG: *mut SelectionDAG, LegalOps: bool, OptForSize: bool, Cost: *mut NegatibleCost, Depth: u32) -> SDValue {
    if Op.getOpcode() == FNEG {
        Cost = Cheaper;
        return Op.getOperand(0);
    }
    if Depth > MaxRecursionDepth {
        return SDValue {};
    }
    Depth += 1;
    let mut Flags: SDNodeFlags = operator(Op).getFlags();
    let mut VT: EVT = Op.getValueType();
    let mut Opcode: u32 = Op.getOpcode();
    if !Op.hasOneUse() && Opcode != ConstantFP {
        let mut IsFreeExtend: bool = Opcode == FP_EXTEND && self.isFPExtFree(VT, Op.getOperand(0).getValueType());
        if !IsFreeExtend {
            return SDValue {};
        }
    }
    let mut RemoveDeadNode: Closure_25 = Closure_25 { DAG: &mut DAG };
    let mut DL: SDLoc = SDLoc { Op };
    let mut Handles: list<HandleSDNode> = list<HandleSDNode> {};
    match Opcode {
        ConstantFP => {
            let mut IsOpLegal: bool = self.isOperationLegal(ConstantFP, VT) || self.isFPImmLegal(neg(cast(Op).getValueAPF()), VT, OptForSize);
            if LegalOps && !IsOpLegal {
                break;
            }
            let mut V: APFloat = cast(Op).getValueAPF();
            V.changeSign();
            let mut CFP: SDValue = DAG.getConstantFP(V, DL, VT, false);
            if !Op.hasOneUse() && CFP.use_empty() {
                break;
            }
            Cost = Neutral;
            return CFP;
        },
        SPLAT_VECTOR => {
            let mut X: SDValue = Op.getOperand(0);
            if !self.isOperationLegal(SPLAT_VECTOR, VT) {
                break;
            }
            let mut NegX: SDValue = self.getCheaperNegatedExpression(X, DAG, LegalOps, OptForSize, 0);
            if !NegX {
                break;
            }
            Cost = Cheaper;
            return DAG.getNode(SPLAT_VECTOR, DL, VT, NegX);
        },
        BUILD_VECTOR => {
            if any_of(operator(Op).op_values(), Closure_26 {}) {
                break;
            }
            let mut IsOpLegal: bool = (self.isOperationLegal(ConstantFP, VT) && self.isOperationLegal(BUILD_VECTOR, VT)) || all_of(operator(Op).op_values(), Closure_27 { cap_0: self, VT: &mut VT, OptForSize: &mut OptForSize });
            if LegalOps && !IsOpLegal {
                break;
            }
            let mut Ops: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
            for C in operator(Op).op_values() {
                if C.isUndef() {
                    Ops.push(ValueParamT { C });
                    continue;
                }
                let mut V: APFloat = cast(C).getValueAPF();
                V.changeSign();
                Ops.push(DAG.getConstantFP(V, DL, C.getValueType(), false));
            }
            Cost = Neutral;
            return DAG.getBuildVector(VT, DL, ArrayRef<SDValue> { Ops });
        },
        FADD => {
            if !Flags.hasNoSignedZeros() {
                break;
            }
            if LegalOps && !self.isOperationLegalOrCustom(FSUB, VT, false) {
                break;
            }
            let mut X: SDValue = Op.getOperand(0);
            let mut Y: SDValue = Op.getOperand(1);
            let mut CostX: NegatibleCost = Expensive;
            let mut NegX: SDValue = self.getNegatedExpression(X, DAG, LegalOps, OptForSize, CostX, Depth);
            if NegX {
                Handles.emplace_back(NegX);
            }
            let mut CostY: NegatibleCost = Expensive;
            let mut NegY: SDValue = self.getNegatedExpression(Y, DAG, LegalOps, OptForSize, CostY, Depth);
            Handles.clear();
            if NegX && (CostX <= CostY) {
                Cost = CostX;
                let mut N: SDValue = DAG.getNode(FSUB, DL, VT, NegX, Y, Flags);
                if NegY != N {
                    RemoveDeadNode.call(NegY);
                }
                return N;
            }
            if NegY {
                Cost = CostY;
                let mut N: SDValue = DAG.getNode(FSUB, DL, VT, NegY, X, Flags);
                if NegX != N {
                    RemoveDeadNode.call(NegX);
                }
                return N;
            }
            break;
        },
        FSUB => {
            if !Flags.hasNoSignedZeros() {
                break;
            }
            let mut X: SDValue = Op.getOperand(0);
            let mut Y: SDValue = Op.getOperand(1);
            if isConstOrConstSplatFP(X, true) {
                C;
            } else if C.isZero() {
                Cost = Cheaper;
                return Y;
            }
            Cost = Neutral;
            return DAG.getNode(FSUB, DL, VT, Y, X, Flags);
        },
        FMUL => {
            FDIV;
        },
        FMA => {
            FMULADD;
        },
        FP_EXTEND => {
            FSIN;
        },
        FP_ROUND => {
            if self.getNegatedExpression(Op.getOperand(0), DAG, LegalOps, OptForSize, Cost, Depth) {
                NegV;
            } else {
                return DAG.getNode(FP_ROUND, DL, VT, NegV, Op.getOperand(1));
            }
        },
        SELECT => {
            VSELECT;
        },
    }
    return SDValue {};
}

fn TargetLowering::expandMUL_LOHI(self: *TargetLowering, Opcode: u32, VT: EVT, dl: *SDLoc, LHS: SDValue, RHS: SDValue, Result: *mut SmallVectorImpl<SDValue>, HiLoVT: EVT, DAG: *mut SelectionDAG, Kind: MulExpansionKind, LL: SDValue, LH: SDValue, RL: SDValue, RH: SDValue) -> bool {
    assert!(Opcode == MUL || Opcode == UMUL_LOHI || Opcode == SMUL_LOHI);
    let mut HasMULHS: bool = (Kind == Always) || self.isOperationLegalOrCustom(MULHS, HiLoVT, false);
    let mut HasMULHU: bool = (Kind == Always) || self.isOperationLegalOrCustom(MULHU, HiLoVT, false);
    let mut HasSMUL_LOHI: bool = (Kind == Always) || self.isOperationLegalOrCustom(SMUL_LOHI, HiLoVT, false);
    let mut HasUMUL_LOHI: bool = (Kind == Always) || self.isOperationLegalOrCustom(UMUL_LOHI, HiLoVT, false);
    if !HasMULHU && !HasMULHS && !HasUMUL_LOHI && !HasSMUL_LOHI {
        return false;
    }
    let mut OuterBitSize: u32 = VT.getScalarSizeInBits();
    let mut InnerBitSize: u32 = HiLoVT.getScalarSizeInBits();
    assert!((LL.getNode() && LH.getNode() && RL.getNode() && RH.getNode()) || (!LL.getNode() && !LH.getNode() && !RL.getNode() && !RH.getNode()));
    let mut MakeMUL_LOHI: Closure_28 = Closure_28 { HasSMUL_LOHI: &mut HasSMUL_LOHI, HasUMUL_LOHI: &mut HasUMUL_LOHI, DAG: &mut DAG, HiLoVT: &mut HiLoVT, dl: &mut dl, HasMULHS: &mut HasMULHS, HasMULHU: &mut HasMULHU };
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    if !LL.getNode() && !RL.getNode() && self.isOperationLegalOrCustom(TRUNCATE, HiLoVT, false) {
        LL = DAG.getNode(TRUNCATE, dl, HiLoVT, LHS);
        RL = DAG.getNode(TRUNCATE, dl, HiLoVT, RHS);
    }
    if !LL.getNode() {
        return false;
    }
    let mut HighMask: APInt = getHighBitsSet(OuterBitSize, InnerBitSize);
    if DAG.MaskedValueIsZero(LHS, HighMask, 0) && DAG.MaskedValueIsZero(RHS, HighMask, 0) {
        if MakeMUL_LOHI.call(LL, RL, Lo, Hi, false) {
            Result.push(ValueParamT { Lo });
            Result.push(ValueParamT { Hi });
            if Opcode != MUL {
                let mut Zero: SDValue = DAG.getConstant(0, dl, HiLoVT, false, false);
                Result.push(ValueParamT { Zero });
                Result.push(ValueParamT { Zero });
            }
            return true;
        }
    }
    if !VT.isVector() && Opcode == MUL && DAG.ComputeMaxSignificantBits(LHS, 0) <= InnerBitSize && DAG.ComputeMaxSignificantBits(RHS, 0) <= InnerBitSize {
        if MakeMUL_LOHI.call(LL, RL, Lo, Hi, true) {
            Result.push(ValueParamT { Lo });
            Result.push(ValueParamT { Hi });
            return true;
        }
    }
    let mut ShiftAmount: u32 = OuterBitSize - InnerBitSize;
    let mut Shift: SDValue = DAG.getShiftAmountConstant(ShiftAmount, VT, dl);
    if !LH.getNode() && !RH.getNode() && self.isOperationLegalOrCustom(SRL, VT, false) && self.isOperationLegalOrCustom(TRUNCATE, HiLoVT, false) {
        LH = DAG.getNode(SRL, dl, VT, LHS, Shift);
        LH = DAG.getNode(TRUNCATE, dl, HiLoVT, LH);
        RH = DAG.getNode(SRL, dl, VT, RHS, Shift);
        RH = DAG.getNode(TRUNCATE, dl, HiLoVT, RH);
    }
    if !LH.getNode() {
        return false;
    }
    if !MakeMUL_LOHI.call(LL, RL, Lo, Hi, false) {
        return false;
    }
    Result.push(ValueParamT { Lo });
    if Opcode == MUL {
        RH = DAG.getNode(MUL, dl, HiLoVT, LL, RH);
        LH = DAG.getNode(MUL, dl, HiLoVT, LH, RL);
        Hi = DAG.getNode(ADD, dl, HiLoVT, Hi, RH);
        Hi = DAG.getNode(ADD, dl, HiLoVT, Hi, LH);
        Result.push(ValueParamT { Hi });
        return true;
    }
    let mut Merge: Closure_29 = Closure_29 { DAG: &mut DAG, dl: &mut dl, VT: &mut VT, Shift: &mut Shift };
    let mut Next: SDValue = DAG.getNode(ZERO_EXTEND, dl, VT, Hi);
    if !MakeMUL_LOHI.call(LL, RH, Lo, Hi, false) {
        return false;
    }
    Next = DAG.getNode(ADD, dl, VT, Next, Merge.call(Lo, Hi));
    if !MakeMUL_LOHI.call(LH, RL, Lo, Hi, false) {
        return false;
    }
    let mut Zero: SDValue = DAG.getConstant(0, dl, HiLoVT, false, false);
    let mut BoolType: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT);
    let mut UseGlue: bool = (self.isOperationLegalOrCustom(ADDC, VT, false) && self.isOperationLegalOrCustom(ADDE, VT, false));
    if UseGlue {
        Next = DAG.getNode(ADDC, dl, DAG.getVTList(VT, EVT { Glue }), Next, Merge.call(Lo, Hi));
    } else {
        Next = DAG.getNode(UADDO_CARRY, dl, DAG.getVTList(VT, BoolType), Next, Merge.call(Lo, Hi), DAG.getConstant(0, dl, BoolType, false, false));
    }
    let mut Carry: SDValue = Next.getValue(1);
    Result.push(DAG.getNode(TRUNCATE, dl, HiLoVT, Next));
    Next = DAG.getNode(SRL, dl, VT, Next, Shift);
    if !MakeMUL_LOHI.call(LH, RH, Lo, Hi, Opcode == SMUL_LOHI) {
        return false;
    }
    if UseGlue {
        Hi = DAG.getNode(ADDE, dl, DAG.getVTList(HiLoVT, EVT { Glue }), Hi, Zero, Carry);
    } else {
        Hi = DAG.getNode(UADDO_CARRY, dl, DAG.getVTList(HiLoVT, BoolType), Hi, Zero, Carry);
    }
    Next = DAG.getNode(ADD, dl, VT, Next, Merge.call(Lo, Hi));
    if Opcode == SMUL_LOHI {
        let mut NextSub: SDValue = DAG.getNode(SUB, dl, VT, Next, DAG.getNode(ZERO_EXTEND, dl, VT, RL));
        Next = DAG.getSelectCC(dl, LH, Zero, NextSub, Next, SETLT, SDNodeFlags { Flags: None });
        NextSub = DAG.getNode(SUB, dl, VT, Next, DAG.getNode(ZERO_EXTEND, dl, VT, LL));
        Next = DAG.getSelectCC(dl, RH, Zero, NextSub, Next, SETLT, SDNodeFlags { Flags: None });
    }
    Result.push(DAG.getNode(TRUNCATE, dl, HiLoVT, Next));
    Next = DAG.getNode(SRL, dl, VT, Next, Shift);
    Result.push(DAG.getNode(TRUNCATE, dl, HiLoVT, Next));
    return true;
}

fn TargetLowering::expandMUL(self: *TargetLowering, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue, HiLoVT: EVT, DAG: *mut SelectionDAG, Kind: MulExpansionKind, LL: SDValue, LH: SDValue, RL: SDValue, RH: SDValue) -> bool {
    let mut Result: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
    let mut Ok: bool = self.expandMUL_LOHI(N.getOpcode(), N.getValueType(0), SDLoc { N }, N.getOperand(0), N.getOperand(1), Result, HiLoVT, DAG, Kind, LL, LH, RL, RH);
    if Ok {
        assert!(Result.len == 2);
        Lo = Result[0];
        Hi = Result[1];
    }
    return Ok;
}

fn TargetLowering::expandUDIVREMByConstantViaUREMDecomposition(self: *TargetLowering, N: *mut SDNode, Divisor: APInt, Result: *mut SmallVectorImpl<SDValue>, HiLoVT: EVT, DAG: *mut SelectionDAG, LL: SDValue, LH: SDValue) -> bool {
    let mut Opcode: u32 = N.getOpcode();
    let mut VT: EVT = N.getValueType(0);
    let mut BitWidth: u32 = Divisor.getBitWidth();
    let mut HBitWidth: u32 = BitWidth / 2;
    assert!(VT.getScalarSizeInBits() == BitWidth && HiLoVT.getScalarSizeInBits() == HBitWidth, "Unexpected VTs");
    let mut TrailingZeros: u32 = 0;
    if !Divisor[0] {
        TrailingZeros = Divisor.countr_zero();
        Divisor.lshrInPlace(TrailingZeros);
    }
    let mut HalfMaxPlus1: APInt = getOneBitSet(BitWidth, HBitWidth);
    if Divisor.uge(HalfMaxPlus1) {
        return false;
    }
    let mut BestChunkWidth: u32 = 0;
    let mut AltChunkWidth: u32 = 0;
    for let mut I: u32 = HBitWidth;
let mut E: u32 = HBitWidth / 2; I > E; I -= 1 {
        if I == HBitWidth - 1 {
            continue;
        }
        let mut Mod: APInt = getOneBitSet(Divisor.getBitWidth(), I).urem(Divisor);
        if Mod.isOne() {
            BestChunkWidth = I;
            break;
        }
        if I != HBitWidth && Mod == Divisor - 1 {
            AltChunkWidth = I;
        }
    }
    let mut Alternate: bool = false;
    if !BestChunkWidth {
        if !AltChunkWidth {
            return false;
        }
        Alternate = true;
        BestChunkWidth = AltChunkWidth;
    }
    let mut dl: SDLoc = SDLoc { N };
    assert!(!LL == !LH, "Expected both input halves or no input halves!");
    if !LL {
        tie(LL, LH) = DAG.SplitScalar(N.getOperand(0), dl, HiLoVT, HiLoVT);
    }
    let mut HasFSHR: bool = self.isOperationLegal(FSHR, HiLoVT);
    let mut GetFSHR: Closure_30 = Closure_30 { HBitWidth: &mut HBitWidth, HasFSHR: &mut HasFSHR, DAG: &mut DAG, dl: &mut dl, HiLoVT: &mut HiLoVT };
    let mut ShiftRight: Closure_31 = Closure_31 { HBitWidth: &mut HBitWidth, GetFSHR: &mut GetFSHR, DAG: &mut DAG, dl: &mut dl, HiLoVT: &mut HiLoVT };
    let mut PartialRemL: SDValue = SDValue {};
    let mut PartialRemH: SDValue = SDValue {};
    if TrailingZeros && Opcode != UDIV {
        if TrailingZeros < HBitWidth {
            let mut Mask: APInt = getLowBitsSet(HBitWidth, TrailingZeros);
            PartialRemL = DAG.getNode(AND, dl, HiLoVT, LL, DAG.getConstant(Mask, dl, HiLoVT, false, false));
        } else if TrailingZeros == HBitWidth {
            PartialRemL = LL;
        } else {
            PartialRemL = LL;
            let mut Mask: APInt = getLowBitsSet(HBitWidth, TrailingZeros - HBitWidth);
            PartialRemH = DAG.getNode(AND, dl, HiLoVT, LH, DAG.getConstant(Mask, dl, HiLoVT, false, false));
        }
    }
    let mut Sum: SDValue = SDValue {};
    if BestChunkWidth == HBitWidth {
        assert!(!Alternate);
        ShiftRight.call(LL, LH, TrailingZeros);
        let mut SetCCType: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), HiLoVT);
        if self.isOperationLegalOrCustom(UADDO_CARRY, HiLoVT, false) {
            let mut VTList: SDVTList = DAG.getVTList(HiLoVT, SetCCType);
            Sum = DAG.getNode(UADDO, dl, VTList, LL, LH);
            Sum = DAG.getNode(UADDO_CARRY, dl, VTList, Sum, DAG.getConstant(0, dl, HiLoVT, false, false), Sum.getValue(1));
        } else {
            Sum = DAG.getNode(ADD, dl, HiLoVT, LL, LH);
            let mut Carry: SDValue = DAG.getSetCC(dl, SetCCType, Sum, LL, SETULT, SDValue {}, false, SDNodeFlags { Flags: None });
            if self.getBooleanContents(HiLoVT) == ZeroOrOneBooleanContent {
                Carry = DAG.getZExtOrTrunc(Carry, dl, HiLoVT);
            } else {
                Carry = DAG.getSelect(dl, HiLoVT, Carry, DAG.getConstant(1, dl, HiLoVT, false, false), DAG.getConstant(0, dl, HiLoVT, false, false), SDNodeFlags { Flags: None });
            }
            Sum = DAG.getNode(ADD, dl, HiLoVT, Sum, Carry);
        }
    } else {
        let mut Mask: SDValue = DAG.getConstant(getLowBitsSet(HBitWidth, BestChunkWidth), dl, HiLoVT, false, false);
        for let mut I: u32 = 0; I < BitWidth - TrailingZeros; I += BestChunkWidth {
            let mut Shift: u32 = I + TrailingZeros;
            let mut Chunk: SDValue = SDValue {};
            if Shift == 0 {
                Chunk = LL;
            } else if Shift >= HBitWidth {
                Chunk = DAG.getNode(SRL, dl, HiLoVT, LH, DAG.getShiftAmountConstant(Shift - HBitWidth, HiLoVT, dl));
            } else {
                Chunk = GetFSHR.call(LL, LH, Shift);
            }
            if I + BestChunkWidth < BitWidth - TrailingZeros {
                Chunk = DAG.getNode(AND, dl, HiLoVT, Chunk, Mask);
            }
            if !Sum {
                Sum = Chunk;
            } else {
                let mut ChunkNum: u32 = I / BestChunkWidth;
                let mut Opc: u32 = if (Alternate && (ChunkNum % 2) != 0) { SUB } else { ADD };
                Sum = DAG.getNode(Opc, dl, HiLoVT, Sum, Chunk);
            }
        }
        if Alternate {
            let mut NumChunks: u32 = divideCeil(BitWidth - TrailingZeros, BestChunkWidth);
            assert!(NumChunks <= 4);
            let mut Adjust: APInt = getOneBitSet(HBitWidth, BestChunkWidth);
            Adjust.setBit(0);
            if NumChunks == 4 {
                operator(Adjust, 1);
            }
            Sum = DAG.getNode(ADD, dl, HiLoVT, Sum, DAG.getConstant(Adjust, dl, HiLoVT, false, false));
        }
    }
    let mut RemL: SDValue = DAG.getNode(UREM, dl, HiLoVT, Sum, DAG.getConstant(Divisor.trunc(HBitWidth), dl, HiLoVT, false, false));
    let mut RemH: SDValue = DAG.getConstant(0, dl, HiLoVT, false, false);
    if Opcode != UREM {
        if BestChunkWidth != HBitWidth {
            ShiftRight.call(LL, LH, TrailingZeros);
        }
        let mut Dividend: SDValue = DAG.getNode(BUILD_PAIR, dl, VT, LL, LH);
        let mut Rem: SDValue = DAG.getNode(BUILD_PAIR, dl, VT, RemL, RemH);
        Dividend = DAG.getNode(SUB, dl, VT, Dividend, Rem);
        let mut MulFactor: APInt = Divisor.multiplicativeInverse();
        let mut Quotient: SDValue = DAG.getNode(MUL, dl, VT, Dividend, DAG.getConstant(MulFactor, dl, VT, false, false));
        let mut QuotL: SDValue = SDValue {};
        let mut QuotH: SDValue = SDValue {};
        tie(QuotL, QuotH) = DAG.SplitScalar(Quotient, dl, HiLoVT, HiLoVT);
        Result.push(ValueParamT { QuotL });
        Result.push(ValueParamT { QuotH });
    }
    if Opcode != UDIV {
        if TrailingZeros {
            if TrailingZeros < HBitWidth {
                RemH = DAG.getNode(SRL, dl, HiLoVT, RemL, DAG.getShiftAmountConstant(HBitWidth - TrailingZeros, HiLoVT, dl));
                RemL = DAG.getNode(SHL, dl, HiLoVT, RemL, DAG.getShiftAmountConstant(TrailingZeros, HiLoVT, dl));
                RemL = DAG.getNode(OR, dl, HiLoVT, RemL, PartialRemL, SDNodeFlags { Flags: Disjoint });
            } else if TrailingZeros == HBitWidth {
                RemH = RemL;
                RemL = PartialRemL;
            } else {
                RemH = DAG.getNode(SHL, dl, HiLoVT, RemL, DAG.getShiftAmountConstant(TrailingZeros - HBitWidth, HiLoVT, dl));
                RemH = DAG.getNode(OR, dl, HiLoVT, RemH, PartialRemH, SDNodeFlags { Flags: Disjoint });
                RemL = PartialRemL;
            }
        }
        Result.push(ValueParamT { RemL });
        Result.push(ValueParamT { RemH });
    }
    return true;
}

fn TargetLowering::expandUDIVREMByConstantViaUMulHiMagic(self: *TargetLowering, N: *mut SDNode, Divisor: *APInt, Result: *mut SmallVectorImpl<SDValue>, HiLoVT: EVT, DAG: *mut SelectionDAG, LL: SDValue, LH: SDValue) -> bool {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = operator(N0).getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    assert!(!Divisor.isOne(), "Magic algorithm does not work for division by 1");
    let mut MakeMUL_LOHIByConst: Closure_32 = Closure_32 { DAG: &mut DAG, DL: &mut DL, VT: &mut VT, HiLoVT: &mut HiLoVT, cap_4: self };
    let mut MakeAddSubLong: Closure_33 = Closure_33 { DAG: &mut DAG, DL: &mut DL, HiLoVT: &mut HiLoVT };
    let mut MakeSRLLong: Closure_34 = Closure_34 { HiLoVT: &mut HiLoVT, DAG: &mut DAG, DL: &mut DL };
    let mut KnownLeadingZeros: u32 = DAG.computeKnownBits(N0, 0).countMinLeadingZeros();
    let mut Magics: UnsignedDivisionByConstantInfo = get(Divisor, if KnownLeadingZeros < Divisor.countl_zero() { KnownLeadingZeros } else { Divisor.countl_zero() }, true, false);
    assert!(!LL == !LH, "Expected both input halves or no input halves!");
    if !LL {
        tie(LL, LH) = DAG.SplitScalar(N0, DL, HiLoVT, HiLoVT);
    }
    let mut QL: SDValue = LL;
    let mut QH: SDValue = LH;
    if Magics.PreShift != 0 {
        tie(QL, QH) = MakeSRLLong.call(QL, QH, Magics.PreShift);
    }
    let mut UMulResult: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    if !MakeMUL_LOHIByConst.call(UMUL_LOHI, QL, QH, Magics.Magic, UMulResult) {
        return false;
    }
    QL = UMulResult[2];
    QH = UMulResult[3];
    if Magics.IsAdd {
        tie(NPQL, NPQH) = MakeSRLLong.call(NPQL, NPQH, 1);
        tie(QL, QH) = MakeAddSubLong.call(ADD, NPQL, NPQH, QL, QH);
    }
    if Magics.PostShift != 0 {
        tie(QL, QH) = MakeSRLLong.call(QL, QH, Magics.PostShift);
    }
    let mut Opcode: u32 = N.getOpcode();
    if Opcode != UREM {
        Result.push(ValueParamT { QL });
        Result.push(ValueParamT { QH });
    }
    if Opcode != UDIV {
        let mut MulResult: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
        if !MakeMUL_LOHIByConst.call(MUL, QL, QH, Divisor, MulResult) {
            return false;
        }
        assert!(MulResult.len == 2);
        Result.push(ValueParamT { RemL });
        Result.push(ValueParamT { RemH });
    }
    return true;
}

fn TargetLowering::expandDIVREMByConstant(self: *TargetLowering, N: *mut SDNode, Result: *mut SmallVectorImpl<SDValue>, HiLoVT: EVT, DAG: *mut SelectionDAG, LL: SDValue, LH: SDValue) -> bool {
    let mut Opcode: u32 = N.getOpcode();
    if Opcode == SREM || Opcode == SDIV || Opcode == SDIVREM {
        return false;
    }
    assert!((Opcode == UREM || Opcode == UDIV || Opcode == UDIVREM), "Unexpected opcode");
    let mut CN: *mut ConstantSDNode = dyn_cast(N.getOperand(1));
    if !CN {
        return false;
    }
    let mut Divisor: APInt = CN.getAPIntValue();
    let mut CanDecomposeUREMWithoutMulHi: bool = Opcode == UREM && self.getLibcallImpl(getUREM(N.getValueType(0))) == Unsupported && self.isOperationLegalOrCustom(UDIVREM, HiLoVT, false);
    if !CanDecomposeUREMWithoutMulHi && !self.isOperationLegalOrCustom(MULHU, HiLoVT, false) && !self.isOperationLegalOrCustom(UMUL_LOHI, HiLoVT, false) {
        return false;
    }
    if DAG.shouldOptForSize() && !CanDecomposeUREMWithoutMulHi {
        return false;
    }
    if Divisor.ule(1) {
        return false;
    }
    if self.expandUDIVREMByConstantViaUREMDecomposition(N, Divisor, Result, HiLoVT, DAG, LL, LH) {
        return true;
    }
    if self.expandUDIVREMByConstantViaUMulHiMagic(N, Divisor, Result, HiLoVT, DAG, LL, LH) {
        return true;
    }
    return false;
}

fn isNonZeroModBitWidthOrUndef(Z: SDValue, BW: u32) -> bool {
    return matchUnaryPredicate(Z, function<bool (ConstantSDNode *)> { Closure_35 { BW: BW } }, true, true);
}

fn TargetLowering::expandFunnelShift(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Node.getValueType(0);
    if VT.isVector() && (!self.isOperationLegalOrCustom(SHL, VT, false) || !self.isOperationLegalOrCustom(SRL, VT, false) || !self.isOperationLegalOrCustom(SUB, VT, false) || !self.isOperationLegalOrCustomOrPromote(OR, VT, false)) {
        return SDValue {};
    }
    let mut X: SDValue = Node.getOperand(0);
    let mut Y: SDValue = Node.getOperand(1);
    let mut Z: SDValue = Node.getOperand(2);
    let mut BW: u32 = VT.getScalarSizeInBits();
    let mut IsFSHL: bool = Node.getOpcode() == FSHL;
    let mut DL: SDLoc = SDLoc { SDValue { Node: Node, ResNo: 0 } };
    let mut ShVT: EVT = Z.getValueType();
    let mut RevOpcode: u32 = if IsFSHL { FSHR } else { FSHL };
    if !self.isOperationLegalOrCustom(Node.getOpcode(), VT, false) && self.isOperationLegalOrCustom(RevOpcode, VT, false) && isPowerOf2_32(BW) {
        if isNonZeroModBitWidthOrUndef(Z, BW) {
            Z = DAG.getNegative(Z, DL, ShVT);
        } else {
            let mut One: SDValue = DAG.getConstant(1, DL, ShVT, false, false);
            if IsFSHL {
                Y = DAG.getNode(RevOpcode, DL, VT, X, Y, One);
                X = DAG.getNode(SRL, DL, VT, X, One);
            } else {
                X = DAG.getNode(RevOpcode, DL, VT, X, Y, One);
                Y = DAG.getNode(SHL, DL, VT, Y, One);
            }
            Z = DAG.getNOT(DL, Z, ShVT);
        }
        return DAG.getNode(RevOpcode, DL, VT, X, Y, Z);
    }
    let mut ShX: SDValue = SDValue {};
    let mut ShY: SDValue = SDValue {};
    let mut ShAmt: SDValue = SDValue {};
    let mut InvShAmt: SDValue = SDValue {};
    if isNonZeroModBitWidthOrUndef(Z, BW) {
        let mut BitWidthC: SDValue = DAG.getConstant(BW, DL, ShVT, false, false);
        ShAmt = DAG.getNode(UREM, DL, ShVT, Z, BitWidthC);
        InvShAmt = DAG.getNode(SUB, DL, ShVT, BitWidthC, ShAmt);
        ShX = DAG.getNode(SHL, DL, VT, X, if IsFSHL { ShAmt } else { InvShAmt });
        ShY = DAG.getNode(SRL, DL, VT, Y, if IsFSHL { InvShAmt } else { ShAmt });
    } else {
        let mut Mask: SDValue = DAG.getConstant(BW - 1, DL, ShVT, false, false);
        if isPowerOf2_32(BW) {
            ShAmt = DAG.getNode(AND, DL, ShVT, Z, Mask);
            InvShAmt = DAG.getNode(AND, DL, ShVT, DAG.getNOT(DL, Z, ShVT), Mask);
        } else {
            let mut BitWidthC: SDValue = DAG.getConstant(BW, DL, ShVT, false, false);
            ShAmt = DAG.getNode(UREM, DL, ShVT, Z, BitWidthC);
            InvShAmt = DAG.getNode(SUB, DL, ShVT, Mask, ShAmt);
        }
        let mut One: SDValue = DAG.getConstant(1, DL, ShVT, false, false);
        if IsFSHL {
            ShX = DAG.getNode(SHL, DL, VT, X, ShAmt);
            let mut ShY1: SDValue = DAG.getNode(SRL, DL, VT, Y, One);
            ShY = DAG.getNode(SRL, DL, VT, ShY1, InvShAmt);
        } else {
            let mut ShX1: SDValue = DAG.getNode(SHL, DL, VT, X, One);
            ShX = DAG.getNode(SHL, DL, VT, ShX1, InvShAmt);
            ShY = DAG.getNode(SRL, DL, VT, Y, ShAmt);
        }
    }
    return DAG.getNode(OR, DL, VT, ShX, ShY);
}

fn TargetLowering::expandROT(self: *TargetLowering, Node: *mut SDNode, AllowVectorOps: bool, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Node.getValueType(0);
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    let mut IsLeft: bool = Node.getOpcode() == ROTL;
    let mut Op0: SDValue = Node.getOperand(0);
    let mut Op1: SDValue = Node.getOperand(1);
    let mut DL: SDLoc = SDLoc { SDValue { Node: Node, ResNo: 0 } };
    let mut ShVT: EVT = Op1.getValueType();
    let mut Zero: SDValue = DAG.getConstant(0, DL, ShVT, false, false);
    let mut RevRot: u32 = if IsLeft { ROTR } else { ROTL };
    if !self.isOperationLegalOrCustom(Node.getOpcode(), VT, false) && self.isOperationLegalOrCustom(RevRot, VT, false) && isPowerOf2_32(EltSizeInBits) {
        let mut Sub: SDValue = DAG.getNode(SUB, DL, ShVT, Zero, Op1);
        return DAG.getNode(RevRot, DL, VT, Op0, Sub);
    }
    if !AllowVectorOps && VT.isVector() && (!self.isOperationLegalOrCustom(SHL, VT, false) || !self.isOperationLegalOrCustom(SRL, VT, false) || !self.isOperationLegalOrCustom(SUB, VT, false) || !self.isOperationLegalOrCustomOrPromote(OR, VT, false) || !self.isOperationLegalOrCustomOrPromote(AND, VT, false)) {
        return SDValue {};
    }
    let mut ShOpc: u32 = if IsLeft { SHL } else { SRL };
    let mut HsOpc: u32 = if IsLeft { SRL } else { SHL };
    let mut BitWidthMinusOneC: SDValue = DAG.getConstant(EltSizeInBits - 1, DL, ShVT, false, false);
    let mut ShVal: SDValue = SDValue {};
    let mut HsVal: SDValue = SDValue {};
    if isPowerOf2_32(EltSizeInBits) {
        let mut NegOp1: SDValue = DAG.getNode(SUB, DL, ShVT, Zero, Op1);
        let mut ShAmt: SDValue = DAG.getNode(AND, DL, ShVT, Op1, BitWidthMinusOneC);
        ShVal = DAG.getNode(ShOpc, DL, VT, Op0, ShAmt);
        let mut HsAmt: SDValue = DAG.getNode(AND, DL, ShVT, NegOp1, BitWidthMinusOneC);
        HsVal = DAG.getNode(HsOpc, DL, VT, Op0, HsAmt);
    } else {
        let mut BitWidthC: SDValue = DAG.getConstant(EltSizeInBits, DL, ShVT, false, false);
        let mut ShAmt: SDValue = DAG.getNode(UREM, DL, ShVT, Op1, BitWidthC);
        ShVal = DAG.getNode(ShOpc, DL, VT, Op0, ShAmt);
        let mut HsAmt: SDValue = DAG.getNode(SUB, DL, ShVT, BitWidthMinusOneC, ShAmt);
        let mut One: SDValue = DAG.getConstant(1, DL, ShVT, false, false);
        HsVal = DAG.getNode(HsOpc, DL, VT, DAG.getNode(HsOpc, DL, VT, Op0, One), HsAmt);
    }
    return DAG.getNode(OR, DL, VT, ShVal, HsVal);
}

fn canNarrowCLMULToLegal(TLI: *TargetLowering, Ctx: *mut LLVMContext, VT: EVT, HalveDepth: u32, TotalDepth: u32) -> bool {
    if HalveDepth > 2 || TotalDepth > 8 || !VT.isFixedLengthVector() {
        return false;
    }
    if TLI.isOperationLegalOrCustom(CLMUL, VT, false) {
        return true;
    }
    if !TLI.isTypeLegal(VT) {
        return false;
    }
    let mut BW: u32 = VT.getScalarSizeInBits();
    if BW % 2 == 0 {
        let mut HalfEltVT: EVT = getIntegerVT(Ctx, BW / 2);
        let mut HalfVT: EVT = VT.changeVectorElementType(Ctx, HalfEltVT);
        if TLI.isTypeLegal(HalfVT) && canNarrowCLMULToLegal(TLI, Ctx, HalfVT, HalveDepth + 1, TotalDepth + 1) {
            return true;
        }
    }
    let mut WideVT: EVT = VT.getDoubleNumVectorElementsVT(Ctx);
    if TLI.isTypeLegal(WideVT) && canNarrowCLMULToLegal(TLI, Ctx, WideVT, HalveDepth, TotalDepth + 1) {
        return true;
    }
    return false;
}

fn TargetLowering::expandCLMUL(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = SDLoc { Node };
    let mut VT: EVT = Node.getValueType(0);
    let mut X: SDValue = Node.getOperand(0);
    let mut Y: SDValue = Node.getOperand(1);
    let mut BW: u32 = VT.getScalarSizeInBits();
    let mut Opcode: u32 = Node.getOpcode();
    let mut Ctx: *mut LLVMContext = *DAG.getContext();
    match Opcode {
        CLMUL => {
            if VT.isVector() {
                let mut HalfBW: u32 = BW / 2;
                if BW % 2 == 0 {
                    let mut HalfEltVT: EVT = getIntegerVT(Ctx, HalfBW);
                    let mut HalfVT: EVT = getVectorVT(Ctx, HalfEltVT, VT.getVectorElementCount());
                    if self.isTypeLegal(HalfVT) && canNarrowCLMULToLegal(*self, Ctx, HalfVT, 1, 0) {
                        let mut ShAmt: SDValue = DAG.getShiftAmountConstant(HalfBW, VT, DL);
                        let mut XLo: SDValue = DAG.getNode(TRUNCATE, DL, HalfVT, X);
                        let mut XHi: SDValue = DAG.getNode(TRUNCATE, DL, HalfVT, DAG.getNode(SRL, DL, VT, X, ShAmt));
                        let mut YLo: SDValue = DAG.getNode(TRUNCATE, DL, HalfVT, Y);
                        let mut YHi: SDValue = DAG.getNode(TRUNCATE, DL, HalfVT, DAG.getNode(SRL, DL, VT, Y, ShAmt));
                        let mut Lo: SDValue = DAG.getNode(CLMUL, DL, HalfVT, XLo, YLo);
                        let mut LoH: SDValue = DAG.getNode(CLMULH, DL, HalfVT, XLo, YLo);
                        let mut Cross1: SDValue = DAG.getNode(CLMUL, DL, HalfVT, XLo, YHi);
                        let mut Cross2: SDValue = DAG.getNode(CLMUL, DL, HalfVT, XHi, YLo);
                        let mut Cross: SDValue = DAG.getNode(XOR, DL, HalfVT, Cross1, Cross2);
                        let mut Hi: SDValue = DAG.getNode(XOR, DL, HalfVT, LoH, Cross);
                        let mut LoExt: SDValue = DAG.getNode(ZERO_EXTEND, DL, VT, Lo);
                        let mut HiExt: SDValue = DAG.getNode(ANY_EXTEND, DL, VT, Hi);
                        let mut HiShifted: SDValue = DAG.getNode(SHL, DL, VT, HiExt, ShAmt);
                        return DAG.getNode(OR, DL, VT, LoExt, HiShifted);
                    }
                }
                {
                    let mut ExtVT: EVT = VT.widenIntegerElementType(Ctx);
                    if self.isTypeLegal(ExtVT) && self.isOperationLegalOrCustom(CLMUL, ExtVT, false) {
                        let mut NumElts: u32 = VT.getVectorMinNumElements();
                        if self.isOperationLegal(CLMUL, ExtVT) || NumElts < BW {
                            let mut XExt: SDValue = DAG.getNode(ANY_EXTEND, DL, ExtVT, X);
                            let mut YExt: SDValue = DAG.getNode(ANY_EXTEND, DL, ExtVT, Y);
                            let mut Mul: SDValue = DAG.getNode(CLMUL, DL, ExtVT, XExt, YExt);
                            return DAG.getNode(TRUNCATE, DL, VT, Mul);
                        }
                    }
                }
                let mut EC: ElementCount = VT.getVectorElementCount();
                if EC.isFixed() {
                    let mut WideVT: EVT = getVectorVT(Ctx, VT.getVectorElementType(), EC * 2);
                    if self.isTypeLegal(WideVT) && canNarrowCLMULToLegal(*self, Ctx, WideVT, 0, 0) {
                        let mut Undef: SDValue = DAG.getUNDEF(WideVT);
                        let mut XWide: SDValue = DAG.getNode(INSERT_SUBVECTOR, DL, WideVT, Undef, X, DAG.getVectorIdxConstant(0, DL, false));
                        let mut YWide: SDValue = DAG.getNode(INSERT_SUBVECTOR, DL, WideVT, Undef, Y, DAG.getVectorIdxConstant(0, DL, false));
                        let mut WideRes: SDValue = DAG.getNode(CLMUL, DL, WideVT, XWide, YWide);
                        return DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, WideRes, DAG.getVectorIdxConstant(0, DL, false));
                    }
                }
            }
            if isConstOrConstSplat(Y, true, false) {
                C;
            } else {
                let mut YVal: *APInt = C.getAPIntValue();
                let mut N: u32 = YVal.countr_one();
                if YVal.isAllOnes() || (YVal.isMask() && isPowerOf2_32(N)) {
                    let mut R: SDValue = X;
                    for let mut I: u32 = 1; I < N; I <<= 1 {
                        let mut ShAmt: SDValue = DAG.getShiftAmountConstant(I, VT, DL);
                        let mut Shifted: SDValue = DAG.getNode(SHL, DL, VT, R, ShAmt);
                        R = DAG.getNode(XOR, DL, VT, R, Shifted);
                    }
                    return R;
                }
            }
            let mut S: u32 = 1;
            while S < 32 && divideCeil(BW, S) > (1 << S) {
                S += 1;
            }
            let mut HolesCost: u32 = S * S + 3 * S + S * (S - 1) + (S - 1);
            let mut KnownY: KnownBits = DAG.computeKnownBits(Y, 0);
            let mut NaiveCost: u32 = 0;
            for let mut I: u32 = 0; I < BW; I += 1 {
                if KnownY.Zero[I] {
                    continue;
                }
                if self.hasBitTest(Y, DAG.getShiftAmountConstant(I, VT, DL)) {
                    NaiveCost += 5;
                } else {
                    NaiveCost += 3;
                }
            }
            if HolesCost < NaiveCost && self.isOperationLegalOrCustom(MUL, self.getTypeToTransformTo(Ctx, VT), false) {
                let mut MaskVal: APInt = getSplat(BW, APInt { S, 1, false, false });
                let mut M: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { S };
                let mut Xp: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { S };
                let mut Yp: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { S };
                for let mut I: u32 = 0; I < S; I += 1 {
                    M[I] = DAG.getConstant(MaskVal.shl(I), DL, VT, false, false);
                    Xp[I] = DAG.getNode(AND, DL, VT, X, M[I]);
                    Yp[I] = DAG.getNode(AND, DL, VT, Y, M[I]);
                }
                let mut Res: SDValue = DAG.getConstant(0, DL, VT, false, false);
                for let mut I: u32 = 0; I < S; I += 1 {
                    let mut Zi: SDValue = DAG.getConstant(0, DL, VT, false, false);
                    for let mut J: u32 = 0; J < S; J += 1 {
                        let mut K: u32 = (I + S - J) % S;
                        let mut P: SDValue = DAG.getNode(MUL, DL, VT, Xp[J], Yp[K]);
                        Zi = DAG.getNode(XOR, DL, VT, Zi, P);
                    }
                    Zi = DAG.getNode(AND, DL, VT, Zi, M[I]);
                    Res = DAG.getNode(OR, DL, VT, Res, Zi, SDNodeFlags { Flags: Disjoint });
                }
                return Res;
            }
            let mut SetCCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), Ctx, VT);
            let mut Res: SDValue = DAG.getConstant(0, DL, VT, false, false);
            for let mut I: u32 = 0; I < BW; I += 1 {
                let mut ShiftAmt: SDValue = DAG.getShiftAmountConstant(I, VT, DL);
                let mut Mask: SDValue = DAG.getConstant(getOneBitSet(BW, I), DL, VT, false, false);
                let mut YMasked: SDValue = DAG.getNode(AND, DL, VT, Y, Mask);
                let mut Part: SDValue = SDValue {};
                if !self.hasBitTest(Y, ShiftAmt) && self.isOperationLegalOrCustom(MUL, self.getTypeToTransformTo(*DAG.getContext(), VT), false) {
                    Part = DAG.getNode(MUL, DL, VT, X, YMasked);
                } else {
                    let mut Zero: SDValue = DAG.getConstant(0, DL, VT, false, false);
                    let mut Cond: SDValue = DAG.getSetCC(DL, SetCCVT, YMasked, Zero, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
                    let mut XShifted: SDValue = DAG.getNode(SHL, DL, VT, X, ShiftAmt);
                    Part = DAG.getSelect(DL, VT, Cond, Zero, XShifted, SDNodeFlags { Flags: None });
                }
                Res = DAG.getNode(XOR, DL, VT, Res, Part);
            }
            return Res;
        },
        CLMULR => {
            if self.isOperationLegalOrCustom(CLMUL, VT, false) && self.isOperationLegalOrCustom(CLMULH, VT, false) {
                let mut Lo: SDValue = DAG.getNode(CLMUL, DL, VT, X, Y);
                let mut Hi: SDValue = DAG.getNode(CLMULH, DL, VT, X, Y);
                Lo = DAG.getNode(SRL, DL, VT, Lo, DAG.getShiftAmountConstant(BW - 1, VT, DL));
                Hi = DAG.getNode(SHL, DL, VT, Hi, DAG.getShiftAmountConstant(1, VT, DL));
                return DAG.getNode(OR, DL, VT, Lo, Hi);
            }
        },
        CLMULH => {
            let mut ExtVT: EVT = VT.widenIntegerElementType(Ctx);
            if !self.isOperationLegalOrCustom(ZERO_EXTEND, ExtVT, false) || !self.isOperationLegalOrCustom(SRL, ExtVT, false) || (!self.isOperationLegalOrCustom(CLMUL, ExtVT, false) && (self.isOperationLegalOrCustom(CLMUL, VT, false) || canNarrowCLMULToLegal(*self, Ctx, VT, 0, 0))) {
                let mut XRev: SDValue = DAG.getNode(BITREVERSE, DL, VT, X);
                let mut YRev: SDValue = DAG.getNode(BITREVERSE, DL, VT, Y);
                let mut ClMul: SDValue = DAG.getNode(CLMUL, DL, VT, XRev, YRev);
                let mut Res: SDValue = DAG.getNode(BITREVERSE, DL, VT, ClMul);
                if Opcode == CLMULH {
                    Res = DAG.getNode(SRL, DL, VT, Res, DAG.getShiftAmountConstant(1, VT, DL));
                }
                return Res;
            }
            let mut XExt: SDValue = DAG.getNode(ZERO_EXTEND, DL, ExtVT, X);
            let mut YExt: SDValue = DAG.getNode(ZERO_EXTEND, DL, ExtVT, Y);
            let mut ClMul: SDValue = DAG.getNode(CLMUL, DL, ExtVT, XExt, YExt);
            let mut ShAmt: u32 = if Opcode == CLMULR { BW - 1 } else { BW };
            let mut HiBits: SDValue = DAG.getNode(SRL, DL, ExtVT, ClMul, DAG.getShiftAmountConstant(ShAmt, ExtVT, DL));
            return DAG.getNode(TRUNCATE, DL, VT, HiBits);
        },
    }
    llvm_unreachable_internal("Expected CLMUL, CLMULR, or CLMULH", "llvm\\lib\\CodeGen\\SelectionDAG\\TargetLowering.cpp", 9297);
}

fn TargetLowering::expandPEXT(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = SDLoc { Node };
    let mut VT: EVT = Node.getValueType(0);
    let mut Val: SDValue = Node.getOperand(0);
    let mut Msk: SDValue = Node.getOperand(1);
    let mut BW: u32 = VT.getScalarSizeInBits();
    if VT.isVector() && self.isOperationLegal(PEXT, VT.getVectorElementType()) {
        return DAG.UnrollVectorOp(Node, 0);
    }
    let mut X: SDValue = DAG.getNode(AND, DL, VT, Val, Msk);
    let mut M: SDValue = Msk;
    let mut One: SDValue = DAG.getShiftAmountConstant(1, VT, DL);
    let mut Mk: SDValue = DAG.getNode(SHL, DL, VT, DAG.getNOT(DL, M, VT), One);
    for let mut I: u32 = 1; I < BW; I *= 2 {
        let mut Mp: SDValue = DAG.getNode(CLMUL, DL, VT, Mk, DAG.getAllOnesConstant(DL, VT, false, false));
        let mut Mv: SDValue = DAG.getNode(AND, DL, VT, Mp, M);
        let mut ShiftI: SDValue = DAG.getShiftAmountConstant(I, VT, DL);
        let mut MvS: SDValue = DAG.getNode(SRL, DL, VT, Mv, ShiftI);
        M = DAG.getNode(OR, DL, VT, DAG.getNode(XOR, DL, VT, M, Mv), MvS, SDNodeFlags { Flags: Disjoint });
        let mut T: SDValue = DAG.getNode(AND, DL, VT, X, Mv);
        let mut TS: SDValue = DAG.getNode(SRL, DL, VT, T, ShiftI);
        X = DAG.getNode(OR, DL, VT, DAG.getNode(XOR, DL, VT, X, T), TS, SDNodeFlags { Flags: Disjoint });
        if I * 2 < BW {
            Mk = DAG.getNode(AND, DL, VT, Mk, DAG.getNOT(DL, Mp, VT));
        }
    }
    return X;
}

fn TargetLowering::expandPDEP(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = SDLoc { Node };
    let mut VT: EVT = Node.getValueType(0);
    let mut Val: SDValue = Node.getOperand(0);
    let mut Msk: SDValue = Node.getOperand(1);
    let mut BW: u32 = VT.getScalarSizeInBits();
    if VT.isVector() && self.isOperationLegal(PDEP, VT.getVectorElementType()) {
        return DAG.UnrollVectorOp(Node, 0);
    }
    let mut LogBW: u32 = Log2_32_Ceil(BW);
    let mut MvArray: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { LogBW };
    let mut One: SDValue = DAG.getShiftAmountConstant(1, VT, DL);
    let mut Mc: SDValue = Msk;
    let mut Mk: SDValue = DAG.getNode(SHL, DL, VT, DAG.getNOT(DL, Msk, VT), One);
    for let mut S: u32 = 0; S < LogBW; S += 1 {
        let mut ShiftS: u32 = 1 << S;
        let mut Mp: SDValue = DAG.getNode(CLMUL, DL, VT, Mk, DAG.getAllOnesConstant(DL, VT, false, false));
        let mut Mv: SDValue = DAG.getNode(AND, DL, VT, Mp, Mc);
        MvArray[S] = Mv;
        if S + 1 < LogBW {
            let mut McXorMv: SDValue = DAG.getNode(XOR, DL, VT, Mc, Mv);
            let mut MvShifted: SDValue = DAG.getNode(SRL, DL, VT, Mv, DAG.getShiftAmountConstant(ShiftS, VT, DL));
            Mc = DAG.getNode(OR, DL, VT, McXorMv, MvShifted, SDNodeFlags { Flags: Disjoint });
            Mk = DAG.getNode(AND, DL, VT, Mk, DAG.getNOT(DL, Mp, VT));
        }
    }
    let mut X: SDValue = Val;
    for let mut S: i32 = LogBW as i32 - 1; S >= 0; S -= 1 {
        let mut ShiftSv: SDValue = DAG.getShiftAmountConstant(1 << S, VT, DL);
        let mut T: SDValue = DAG.getNode(SHL, DL, VT, X, ShiftSv);
        let mut UnshiftedBits: SDValue = DAG.getNode(AND, DL, VT, X, DAG.getNOT(DL, MvArray[S], VT));
        let mut ShiftedBits: SDValue = DAG.getNode(AND, DL, VT, T, MvArray[S]);
        X = DAG.getNode(OR, DL, VT, UnshiftedBits, ShiftedBits, SDNodeFlags { Flags: Disjoint });
    }
    return DAG.getNode(AND, DL, VT, X, Msk);
}

fn TargetLowering::expandShiftParts(self: *TargetLowering, Node: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue, DAG: *mut SelectionDAG) {
    assert!(Node.getNumOperands() == 3, "Not a double-shift!");
    let mut VT: EVT = Node.getValueType(0);
    let mut VTBits: u32 = VT.getScalarSizeInBits();
    assert!(isPowerOf2_32(VTBits), "Power-of-two integer type expected");
    let mut IsSHL: bool = Node.getOpcode() == SHL_PARTS;
    let mut IsSRA: bool = Node.getOpcode() == SRA_PARTS;
    let mut ShOpLo: SDValue = Node.getOperand(0);
    let mut ShOpHi: SDValue = Node.getOperand(1);
    let mut ShAmt: SDValue = Node.getOperand(2);
    let mut ShAmtVT: EVT = ShAmt.getValueType();
    let mut ShAmtCCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), ShAmtVT);
    let mut dl: SDLoc = SDLoc { Node };
    let mut SafeShAmt: SDValue = DAG.getNode(AND, dl, ShAmtVT, ShAmt, DAG.getConstant(VTBits - 1, dl, ShAmtVT, false, false));
    let mut Tmp1: SDValue = if IsSRA { DAG.getNode(SRA, dl, VT, ShOpHi, DAG.getConstant(VTBits - 1, dl, ShAmtVT, false, false)) } else { DAG.getConstant(0, dl, VT, false, false) };
    let mut Tmp2: SDValue = SDValue {};
    let mut Tmp3: SDValue = SDValue {};
    if IsSHL {
        Tmp2 = DAG.getNode(FSHL, dl, VT, ShOpHi, ShOpLo, ShAmt);
        Tmp3 = DAG.getNode(SHL, dl, VT, ShOpLo, SafeShAmt);
    } else {
        Tmp2 = DAG.getNode(FSHR, dl, VT, ShOpHi, ShOpLo, ShAmt);
        Tmp3 = DAG.getNode(if IsSRA { SRA } else { SRL }, dl, VT, ShOpHi, SafeShAmt);
    }
    let mut AndNode: SDValue = DAG.getNode(AND, dl, ShAmtVT, ShAmt, DAG.getConstant(VTBits, dl, ShAmtVT, false, false));
    let mut Cond: SDValue = DAG.getSetCC(dl, ShAmtCCVT, AndNode, DAG.getConstant(0, dl, ShAmtVT, false, false), SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
    if IsSHL {
        Hi = DAG.getNode(SELECT, dl, VT, Cond, Tmp3, Tmp2);
        Lo = DAG.getNode(SELECT, dl, VT, Cond, Tmp1, Tmp3);
    } else {
        Lo = DAG.getNode(SELECT, dl, VT, Cond, Tmp3, Tmp2);
        Hi = DAG.getNode(SELECT, dl, VT, Cond, Tmp1, Tmp3);
    }
}

fn TargetLowering::expandFCANONICALIZE(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Node.getValueType(0);
    let mut DL: SDLoc = SDLoc { Node };
    let mut Flags: SDNodeFlags = Node.getFlags();
    Flags.setNoFPExcept(true);
    let mut One: SDValue = DAG.getConstantFP(1.0, DL, VT, false);
    let mut Mul: SDValue = DAG.getNode(STRICT_FMUL, DL, ArrayRef<EVT> { [VT, EVT { Other }] }, ArrayRef<SDValue> { [DAG.getEntryNode(), Node.getOperand(0), One] }, Flags);
    return Mul;
}

fn TargetLowering::expandCONVERT_TO_ARBITRARY_FP(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut ResVT: EVT = Node.getValueType(0);
    let mut dl: SDLoc = SDLoc { Node };
    let mut FloatVal: SDValue = Node.getOperand(0);
    let mut SemEnum: u64 = Node.getConstantOperandVal(1);
    let mut Sem: Semantics = SemEnum as Semantics;
    let mut RoundMode: RoundingMode = Node.getConstantOperandVal(2) as RoundingMode;
    let mut Saturate: bool = Node.getConstantOperandVal(3) != 0;
    match Sem {
        S_Float8E5M2 => {
            S_Float8E4M3FN;
        },
        _ => {
            DAG.getContext().emitError("CONVERT_TO_ARBITRARY_FP: not implemented destination format (semantics enum " + SemEnum + ")");
        },
    }
    match RoundMode {
        NearestTiesToEven => {
            TowardZero;
        },
        _ => {
            DAG.getContext().emitError("CONVERT_TO_ARBITRARY_FP: unsupported rounding mode (enum " + RoundMode as i32 + ")");
        },
    }
    let mut DstSem: *fltSemantics = EnumToSemantics(Sem);
    let mut DstBits: u32 = getSizeInBits(DstSem);
    let mut DstPrecision: u32 = semanticsPrecision(DstSem);
    let mut DstMant: u32 = DstPrecision - 1;
    let mut DstHasSign: bool = semanticsHasSignedRepr(DstSem);
    let mut DstExpBits: u32 = DstBits - (if DstHasSign { 1 } else { 0 }) - DstMant;
    let mut DstBias: i32 = 1 - semanticsMinExponent(DstSem);
    let mut DstExpMax: u32 = (1 << DstExpBits) - 1;
    let mut DstMantMask: u64 = if (DstMant > 0) { ((1 << DstMant) - 1) } else { 0 };
    let mut DstNFBehavior: fltNonfiniteBehavior = DstSem.nonFiniteBehavior;
    let mut DstNanEnc: fltNanEncoding = DstSem.nanEncoding;
    let mut DstExpMaxNormal: u32 = if DstNFBehavior == IEEE754 { DstExpMax - 1 } else { DstExpMax };
    let mut DstMaxMantAtMaxExp: u64 = DstMantMask;
    if DstNFBehavior == NanOnly && DstNanEnc == AllOnes {
        DstMaxMantAtMaxExp = DstMantMask - 1;
    }
    let mut SrcVT: EVT = FloatVal.getValueType();
    let mut SrcSem: *fltSemantics = SrcVT.getScalarType().getFltSemantics();
    let mut SrcBits: u32 = getSizeInBits(SrcSem);
    let mut SrcPrecision: u32 = semanticsPrecision(SrcSem);
    let mut SrcMant: u32 = SrcPrecision - 1;
    let mut SrcMantMask: u64 = (1 << SrcMant) - 1;
    let mut IntScalarVT: EVT = getIntegerVT(*DAG.getContext(), SrcBits);
    let mut IntVT: EVT = ResVT.changeElementType(*DAG.getContext(), IntScalarVT);
    let mut SetCCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), IntVT);
    let mut FPSetCCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), SrcVT);
    let mut Zero: SDValue = DAG.getConstant(0, dl, IntVT, false, false);
    let mut One: SDValue = DAG.getConstant(1, dl, IntVT, false, false);
    let mut Src: SDValue = DAG.getNode(BITCAST, dl, IntVT, FloatVal);
    let mut SignBit: SDValue = DAG.getNode(SRL, dl, IntVT, Src, DAG.getShiftAmountConstant(SrcBits - 1, IntVT, dl));
    let mut FPZero: SDValue = DAG.getConstantFP(0.0, dl, SrcVT, false);
    let mut FPInf: SDValue = DAG.getConstantFP(getInf(SrcSem, false), dl, SrcVT, false);
    let mut AbsVal: SDValue = DAG.getNode(FABS, dl, SrcVT, FloatVal);
    let mut IsNaN: SDValue = DAG.getSetCC(dl, FPSetCCVT, FloatVal, FPZero, SETUO, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut IsInf: SDValue = DAG.getSetCC(dl, FPSetCCVT, AbsVal, FPInf, SETOEQ, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut IsZero: SDValue = DAG.getSetCC(dl, FPSetCCVT, FloatVal, FPZero, SETOEQ, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut FrexpExpScalarVT: EVT = self.getValueType(DAG.getDataLayout(), getInt32Ty(*DAG.getContext()), false);
    let mut FrexpExpVT: EVT = SrcVT.changeElementType(*DAG.getContext(), FrexpExpScalarVT);
    let mut Frexp: SDValue = DAG.getNode(FFREXP, dl, DAG.getVTList(SrcVT, FrexpExpVT), FloatVal);
    let mut FrexpFrac: SDValue = Frexp.getValue(0);
    let mut FrexpExp: SDValue = Frexp.getValue(1);
    let mut FrexpFracInt: SDValue = DAG.getNode(BITCAST, dl, IntVT, FrexpFrac);
    let mut EffSrcMant: SDValue = DAG.getNode(AND, dl, IntVT, FrexpFracInt, DAG.getConstant(SrcMantMask, dl, IntVT, false, false));
    let mut FrexpExpExt: SDValue = DAG.getSExtOrTrunc(FrexpExp, dl, IntVT);
    let mut NewExp: SDValue = DAG.getNode(ADD, dl, IntVT, FrexpExpExt, DAG.getConstant(DstBias - 1, dl, IntVT, false, false));
    let mut ComputeRoundUp: Closure_36 = Closure_36 { RoundMode: &mut RoundMode, DAG: &mut DAG, dl: &mut dl, IntVT: &mut IntVT, Zero: &mut Zero, SetCCVT: &mut SetCCVT, SignBit: &mut SignBit };
    let mut TruncMant: SDValue = SDValue {};
    let mut RoundUp: SDValue = SDValue {};
    if SrcMant > DstMant {
        let mut Shift: u32 = SrcMant - DstMant;
        let mut ShiftConst: SDValue = DAG.getShiftAmountConstant(Shift, IntVT, dl);
        TruncMant = DAG.getNode(SRL, dl, IntVT, EffSrcMant, ShiftConst);
        let mut RoundBit: SDValue = SDValue {};
        if Shift >= 1 {
            let mut RoundBitShift: SDValue = DAG.getShiftAmountConstant(Shift - 1, IntVT, dl);
            let mut ShiftedMant: SDValue = DAG.getNode(SRL, dl, IntVT, EffSrcMant, RoundBitShift);
            RoundBit = DAG.getNode(AND, dl, IntVT, ShiftedMant, One);
        } else {
            RoundBit = Zero;
        }
        let mut StickyBits: SDValue = SDValue {};
        if Shift >= 2 {
            let mut StickyMask: u64 = maskTrailingOnes(Shift - 1);
            StickyBits = DAG.getNode(AND, dl, IntVT, EffSrcMant, DAG.getConstant(StickyMask, dl, IntVT, false, false));
            StickyBits = DAG.getSetCC(dl, SetCCVT, StickyBits, Zero, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
            StickyBits = DAG.getNode(ZERO_EXTEND, dl, IntVT, StickyBits);
        } else {
            StickyBits = Zero;
        }
        let mut LSB: SDValue = DAG.getNode(AND, dl, IntVT, TruncMant, One);
        RoundUp = ComputeRoundUp.call(RoundBit, StickyBits, LSB);
    } else {
        let mut MantShift: SDValue = DAG.getShiftAmountConstant(DstMant - SrcMant, IntVT, dl);
        TruncMant = DAG.getNode(SHL, dl, IntVT, EffSrcMant, MantShift);
        RoundUp = Zero;
    }
    let mut RoundedMant: SDValue = DAG.getNode(ADD, dl, IntVT, TruncMant, RoundUp);
    let mut MantOverflow: SDValue = DAG.getSetCC(dl, SetCCVT, RoundedMant, DAG.getConstant(DstMantMask, dl, IntVT, false, false), SETGT, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut AdjMant: SDValue = DAG.getSelect(dl, IntVT, MantOverflow, Zero, RoundedMant, SDNodeFlags { Flags: None });
    let mut AdjExp: SDValue = DAG.getNode(ADD, dl, IntVT, NewExp, DAG.getNode(ZERO_EXTEND, dl, IntVT, MantOverflow));
    let mut SignShifted: SDValue = if DstHasSign { DAG.getNode(SHL, dl, IntVT, SignBit, DAG.getShiftAmountConstant(DstBits - 1, IntVT, dl)) } else { Zero };
    let mut ExpIsNeg: SDValue = DAG.getSetCC(dl, SetCCVT, AdjExp, DAG.getConstant(1, dl, IntVT, false, false), SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut DenormResult: SDValue = SDValue {};
    {
        let mut DenormShift: SDValue = DAG.getNode(SUB, dl, IntVT, One, NewExp);
        let mut ImplicitOne: SDValue = DAG.getNode(SHL, dl, IntVT, One, DAG.getShiftAmountConstant(SrcMant, IntVT, dl));
        let mut FullSrcMant: SDValue = DAG.getNode(OR, dl, IntVT, EffSrcMant, ImplicitOne);
        let mut MantDelta: i64 = SrcMant as i64 - DstMant;
        let mut TotalShift: SDValue = DAG.getNode(ADD, dl, IntVT, DenormShift, DAG.getSignedConstant(MantDelta, dl, IntVT, false, false));
        let mut ShiftVT: EVT = self.getShiftAmountTy(IntVT, DAG.getDataLayout());
        let mut MaxShift: SDValue = DAG.getConstant(SrcBits - 1, dl, IntVT, false, false);
        let mut ClampedShift: SDValue = DAG.getNode(UMIN, dl, IntVT, TotalShift, MaxShift);
        let mut DenormTruncMant: SDValue = DAG.getNode(SRL, dl, IntVT, FullSrcMant, DAG.getZExtOrTrunc(ClampedShift, dl, ShiftVT));
        let mut DenormRoundUp: SDValue = SDValue {};
        {
            let mut SafeShift: SDValue = DAG.getNode(UMAX, dl, IntVT, ClampedShift, One);
            let mut RoundBitPos: SDValue = DAG.getNode(SUB, dl, IntVT, SafeShift, One);
            let mut RoundBitPosAmt: SDValue = DAG.getZExtOrTrunc(RoundBitPos, dl, ShiftVT);
            let mut DenormRoundBit: SDValue = DAG.getNode(AND, dl, IntVT, DAG.getNode(SRL, dl, IntVT, FullSrcMant, RoundBitPosAmt), One);
            let mut StickyMask: SDValue = DAG.getNode(SUB, dl, IntVT, DAG.getNode(SHL, dl, IntVT, One, RoundBitPosAmt), One);
            let mut DenormStickyBits: SDValue = DAG.getNode(AND, dl, IntVT, FullSrcMant, StickyMask);
            let mut HasSticky: SDValue = DAG.getNode(ZERO_EXTEND, dl, IntVT, DAG.getSetCC(dl, SetCCVT, DenormStickyBits, Zero, SETNE, SDValue {}, false, SDNodeFlags { Flags: None }));
            let mut DenormLSB: SDValue = DAG.getNode(AND, dl, IntVT, DenormTruncMant, One);
            DenormRoundUp = ComputeRoundUp.call(DenormRoundBit, HasSticky, DenormLSB);
            let mut ShiftGEOne: SDValue = DAG.getSetCC(dl, SetCCVT, ClampedShift, One, SETUGE, SDValue {}, false, SDNodeFlags { Flags: None });
            DenormRoundUp = DAG.getSelect(dl, IntVT, ShiftGEOne, DenormRoundUp, Zero, SDNodeFlags { Flags: None });
        }
        let mut DenormRoundedMant: SDValue = DAG.getNode(ADD, dl, IntVT, DenormTruncMant, DenormRoundUp);
        let mut DenormMantOF: SDValue = DAG.getSetCC(dl, SetCCVT, DenormRoundedMant, DAG.getConstant(DstMantMask, dl, IntVT, false, false), SETGT, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut DenormFinalMant: SDValue = DAG.getSelect(dl, IntVT, DenormMantOF, Zero, DenormRoundedMant, SDNodeFlags { Flags: None });
        let mut DenormFinalExp: SDValue = DAG.getSelect(dl, IntVT, DenormMantOF, One, Zero, SDNodeFlags { Flags: None });
        let mut DenormExpShifted: SDValue = DAG.getNode(SHL, dl, IntVT, DenormFinalExp, DAG.getShiftAmountConstant(DstMant, IntVT, dl));
        DenormResult = DAG.getNode(OR, dl, IntVT, DAG.getNode(OR, dl, IntVT, SignShifted, DenormExpShifted), DenormFinalMant);
    }
    let mut ExpOF: SDValue = DAG.getSetCC(dl, SetCCVT, AdjExp, DAG.getConstant(DstExpMaxNormal, dl, IntVT, false, false), SETGT, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut ExpAtMax: SDValue = DAG.getSetCC(dl, SetCCVT, AdjExp, DAG.getConstant(DstExpMaxNormal, dl, IntVT, false, false), SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut MantExceedsMax: SDValue = DAG.getSetCC(dl, SetCCVT, AdjMant, DAG.getConstant(DstMaxMantAtMaxExp, dl, IntVT, false, false), SETGT, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut ExpMantOF: SDValue = DAG.getNode(AND, dl, SetCCVT, ExpAtMax, MantExceedsMax);
    let mut IsOverflow: SDValue = DAG.getNode(OR, dl, SetCCVT, ExpOF, ExpMantOF);
    let mut OverflowResult: SDValue = SDValue {};
    if Saturate {
        let mut MaxFinite: u64 = (DstExpMaxNormal as u64 << DstMant) | DstMaxMantAtMaxExp;
        OverflowResult = DAG.getNode(OR, dl, IntVT, SignShifted, DAG.getConstant(MaxFinite, dl, IntVT, false, false));
    } else if DstNFBehavior == IEEE754 {
        let mut InfBits: u64 = DstExpMax as u64 << DstMant;
        OverflowResult = DAG.getNode(OR, dl, IntVT, SignShifted, DAG.getConstant(InfBits, dl, IntVT, false, false));
    } else {
        OverflowResult = DAG.getPOISON(IntVT);
    }
    let mut NormExpShifted: SDValue = DAG.getNode(SHL, dl, IntVT, AdjExp, DAG.getShiftAmountConstant(DstMant, IntVT, dl));
    let mut NormResult: SDValue = DAG.getNode(OR, dl, IntVT, DAG.getNode(OR, dl, IntVT, SignShifted, NormExpShifted), AdjMant);
    let mut NaNResult: SDValue = SDValue {};
    if DstNFBehavior == IEEE754 {
        let mut QNaNBit: u64 = if (DstMant > 0) { (1 << (DstMant - 1)) } else { 0 };
        NaNResult = DAG.getConstant((DstExpMax as u64 << DstMant) | QNaNBit, dl, IntVT, false, false);
    } else if DstNFBehavior == NanOnly && DstNanEnc == AllOnes {
        NaNResult = DAG.getConstant((DstExpMax as u64 << DstMant) | DstMantMask, dl, IntVT, false, false);
    } else {
        NaNResult = DAG.getPOISON(IntVT);
    }
    let mut InfResult: SDValue = SDValue {};
    if DstNFBehavior == IEEE754 {
        let mut InfBits: u64 = DstExpMax as u64 << DstMant;
        InfResult = DAG.getNode(OR, dl, IntVT, SignShifted, DAG.getConstant(InfBits, dl, IntVT, false, false));
    } else if Saturate {
        let mut MaxFinite: u64 = (DstExpMaxNormal as u64 << DstMant) | DstMaxMantAtMaxExp;
        InfResult = DAG.getNode(OR, dl, IntVT, SignShifted, DAG.getConstant(MaxFinite, dl, IntVT, false, false));
    } else {
        InfResult = DAG.getPOISON(IntVT);
    }
    let mut ZeroResult: SDValue = SignShifted;
    let mut FiniteResult: SDValue = DAG.getSelect(dl, IntVT, ExpIsNeg, DenormResult, NormResult, SDNodeFlags { Flags: None });
    FiniteResult = DAG.getSelect(dl, IntVT, IsOverflow, OverflowResult, FiniteResult, SDNodeFlags { Flags: None });
    let mut Result: SDValue = FiniteResult;
    Result = DAG.getSelect(dl, IntVT, IsZero, ZeroResult, Result, SDNodeFlags { Flags: None });
    Result = DAG.getSelect(dl, IntVT, IsInf, InfResult, Result, SDNodeFlags { Flags: None });
    if !DstHasSign && Saturate {
        let mut IsNegative: SDValue = DAG.getSetCC(dl, FPSetCCVT, FloatVal, FPZero, SETOLT, SDValue {}, false, SDNodeFlags { Flags: None });
        Result = DAG.getSelect(dl, IntVT, IsNegative, Zero, Result, SDNodeFlags { Flags: None });
    }
    Result = DAG.getSelect(dl, IntVT, IsNaN, NaNResult, Result, SDNodeFlags { Flags: None });
    return DAG.getZExtOrTrunc(Result, dl, ResVT);
}

fn TargetLowering::expandCONVERT_FROM_ARBITRARY_FP(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut dl: SDLoc = SDLoc { Node };
    let mut DstVT: EVT = Node.getValueType(0);
    let mut DstScalarVT: EVT = DstVT.getScalarType();
    let mut IntVal: SDValue = Node.getOperand(0);
    let mut SemEnum: u64 = Node.getConstantOperandVal(1);
    let mut Sem: Semantics = SemEnum as Semantics;
    match Sem {
        S_Float8E5M2 => {
            S_Float8E4M3FN;
        },
        _ => {
            DAG.getContext().emitError("CONVERT_FROM_ARBITRARY_FP: not implemented source format (semantics enum " + SemEnum + ")");
        },
    }
    let mut SrcSem: *fltSemantics = EnumToSemantics(Sem);
    let mut SrcBits: u32 = getSizeInBits(SrcSem);
    let mut SrcPrecision: u32 = semanticsPrecision(SrcSem);
    let mut SrcMant: u32 = SrcPrecision - 1;
    let mut SrcHasSign: bool = semanticsHasSignedRepr(SrcSem);
    let mut SrcExp: u32 = SrcBits - (if SrcHasSign { 1 } else { 0 }) - SrcMant;
    let mut SrcBias: i32 = 1 - semanticsMinExponent(SrcSem);
    let mut NFBehavior: fltNonfiniteBehavior = SrcSem.nonFiniteBehavior;
    let mut DstSem: *fltSemantics = DstScalarVT.getFltSemantics();
    let mut DstBits: u32 = getSizeInBits(DstSem);
    let mut DstMant: u32 = semanticsPrecision(DstSem) - 1;
    let mut DstExpBits: u32 = DstBits - DstMant - 1;
    let mut DstMinExp: i32 = semanticsMinExponent(DstSem);
    let mut DstBias: i32 = 1 - DstMinExp;
    let mut DstExpAllOnes: u64 = (1 << DstExpBits) - 1;
    let mut IntScalarVT: EVT = getIntegerVT(*DAG.getContext(), DstBits);
    let mut IntVT: EVT = IntScalarVT;
    if DstVT.isVector() {
        IntVT = getVectorVT(*DAG.getContext(), IntScalarVT, DstVT.getVectorElementCount());
    } else if !self.isTypeLegal(IntScalarVT) {
        if self.getTypeAction(*DAG.getContext(), IntScalarVT) != TypePromoteInteger {
            DAG.getContext().emitError("CONVERT_FROM_ARBITRARY_FP: the requested integer value type for its legalization is not supported");
            return SDValue {};
        }
        IntVT = self.getTypeToTransformTo(*DAG.getContext(), IntScalarVT);
    }
    let mut Src: SDValue = DAG.getZExtOrTrunc(IntVal, dl, IntVT);
    let mut SetCCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), IntVT);
    let mut Zero: SDValue = DAG.getConstant(0, dl, IntVT, false, false);
    let mut One: SDValue = DAG.getConstant(1, dl, IntVT, false, false);
    let mut MantMask: u64 = if (SrcMant > 0) { ((1 << SrcMant) - 1) } else { 0 };
    let mut ExpMask: u64 = (1 << SrcExp) - 1;
    let mut MantField: SDValue = DAG.getNode(AND, dl, IntVT, Src, DAG.getConstant(MantMask, dl, IntVT, false, false));
    let mut ExpField: SDValue = DAG.getNode(AND, dl, IntVT, DAG.getNode(SRL, dl, IntVT, Src, DAG.getShiftAmountConstant(SrcMant, IntVT, dl)), DAG.getConstant(ExpMask, dl, IntVT, false, false));
    let mut SignShifted: SDValue = if SrcHasSign { DAG.getNode(SHL, dl, IntVT, DAG.getNode(SRL, dl, IntVT, Src, DAG.getShiftAmountConstant(SrcBits - 1, IntVT, dl)), DAG.getShiftAmountConstant(DstBits - 1, IntVT, dl)) } else { Zero };
    let mut ExpAllOnes: SDValue = DAG.getConstant(ExpMask, dl, IntVT, false, false);
    let mut IsExpAllOnes: SDValue = DAG.getSetCC(dl, SetCCVT, ExpField, ExpAllOnes, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut IsExpZero: SDValue = DAG.getSetCC(dl, SetCCVT, ExpField, Zero, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut IsMantZero: SDValue = DAG.getSetCC(dl, SetCCVT, MantField, Zero, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut IsMantNonZero: SDValue = DAG.getSetCC(dl, SetCCVT, MantField, Zero, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut IsNaN: SDValue = SDValue {};
    if NFBehavior == FiniteOnly {
        IsNaN = DAG.getBoolConstant(false, dl, SetCCVT, IntVT);
    } else if NFBehavior == IEEE754 {
        IsNaN = DAG.getNode(AND, dl, SetCCVT, IsExpAllOnes, IsMantNonZero);
    } else {
        assert!(SrcSem.nanEncoding == AllOnes);
        let mut MantAllOnes: SDValue = DAG.getConstant(MantMask, dl, IntVT, false, false);
        let mut IsMantAllOnes: SDValue = DAG.getSetCC(dl, SetCCVT, MantField, MantAllOnes, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
        IsNaN = DAG.getNode(AND, dl, SetCCVT, IsExpAllOnes, IsMantAllOnes);
    }
    let mut IsInf: SDValue = SDValue {};
    if NFBehavior == IEEE754 {
        IsInf = DAG.getNode(AND, dl, SetCCVT, IsExpAllOnes, IsMantZero);
    } else {
        IsInf = DAG.getBoolConstant(false, dl, SetCCVT, IntVT);
    }
    let mut IsZero: SDValue = DAG.getNode(AND, dl, SetCCVT, IsExpZero, IsMantZero);
    let mut IsDenorm: SDValue = DAG.getNode(AND, dl, SetCCVT, IsExpZero, IsMantNonZero);
    let mut BiasAdjust: i32 = DstBias - SrcBias;
    let mut NormDstExp: SDValue = DAG.getNode(ADD, dl, IntVT, ExpField, DAG.getConstant(APInt { IntVT.getScalarSizeInBits(), BiasAdjust, true, false }, dl, IntVT, false, false));
    let mut NormDstMant: SDValue = SDValue {};
    if DstMant > SrcMant {
        let mut NormDstMantShift: SDValue = DAG.getShiftAmountConstant(DstMant - SrcMant, IntVT, dl);
        NormDstMant = DAG.getNode(SHL, dl, IntVT, MantField, NormDstMantShift);
    } else {
        NormDstMant = MantField;
    }
    let mut DstMantShift: SDValue = DAG.getShiftAmountConstant(DstMant, IntVT, dl);
    let mut NormExpShifted: SDValue = DAG.getNode(SHL, dl, IntVT, NormDstExp, DstMantShift);
    let mut NormResult: SDValue = DAG.getNode(OR, dl, IntVT, DAG.getNode(OR, dl, IntVT, SignShifted, NormExpShifted), NormDstMant);
    let mut DenormResult: SDValue = NormResult;
    if BiasAdjust != 0 {
        let mut IntVTBits: u32 = IntVT.getScalarSizeInBits();
        let mut LeadingZeros: SDValue = DAG.getNode(CTLZ_ZERO_POISON, dl, IntVT, MantField);
        let mut DenormExpConst: i32 = IntVTBits as i32 + DstBias - SrcBias - SrcMant as i32;
        let mut DenormDstExp: SDValue = DAG.getNode(SUB, dl, IntVT, DAG.getConstant(APInt { IntVTBits, DenormExpConst, true, false }, dl, IntVT, false, false), LeadingZeros);
        let mut MantMSB: SDValue = DAG.getNode(SUB, dl, IntVT, DAG.getConstant(IntVTBits - 1, dl, IntVT, false, false), LeadingZeros);
        let mut LeadingOne: SDValue = DAG.getNode(SHL, dl, IntVT, One, MantMSB);
        let mut Frac: SDValue = DAG.getNode(XOR, dl, IntVT, MantField, LeadingOne);
        let mut ShiftSub: u32 = IntVTBits - 1 - DstMant;
        let mut ShiftAmount: SDValue = DAG.getNode(SUB, dl, IntVT, LeadingZeros, DAG.getConstant(ShiftSub, dl, IntVT, false, false));
        let mut DenormDstMant: SDValue = DAG.getNode(SHL, dl, IntVT, Frac, ShiftAmount);
        let mut DenormExpShifted: SDValue = DAG.getNode(SHL, dl, IntVT, DenormDstExp, DstMantShift);
        DenormResult = DAG.getNode(OR, dl, IntVT, DAG.getNode(OR, dl, IntVT, SignShifted, DenormExpShifted), DenormDstMant);
    }
    let mut FiniteResult: SDValue = DAG.getSelect(dl, IntVT, IsDenorm, DenormResult, NormResult, SDNodeFlags { Flags: None });
    let mut QNaNBit: u64 = if (DstMant > 0) { (1 << (DstMant - 1)) } else { 0 };
    let mut NaNResult: SDValue = DAG.getConstant((DstExpAllOnes << DstMant) | QNaNBit, dl, IntVT, false, false);
    let mut InfResult: SDValue = DAG.getNode(OR, dl, IntVT, SignShifted, DAG.getConstant(DstExpAllOnes << DstMant, dl, IntVT, false, false));
    if semanticsMaxExponent(SrcSem) > semanticsMaxExponent(DstSem) {
        let mut IsOverflow: SDValue = DAG.getSetCC(dl, SetCCVT, NormDstExp, DAG.getConstant(DstExpAllOnes, dl, IntVT, false, false), SETUGE, SDValue {}, false, SDNodeFlags { Flags: None });
        FiniteResult = DAG.getSelect(dl, IntVT, IsOverflow, InfResult, FiniteResult, SDNodeFlags { Flags: None });
    }
    let mut ZeroResult: SDValue = SignShifted;
    let mut Result: SDValue = FiniteResult;
    Result = DAG.getSelect(dl, IntVT, IsZero, ZeroResult, Result, SDNodeFlags { Flags: None });
    Result = DAG.getSelect(dl, IntVT, IsInf, InfResult, Result, SDNodeFlags { Flags: None });
    Result = DAG.getSelect(dl, IntVT, IsNaN, NaNResult, Result, SDNodeFlags { Flags: None });
    if !DstVT.bitsEq(IntVT) {
        assert!(!IntVT.isVector() && IntVT.bitsGT(DstVT));
        let mut Alignment: Align = DAG.getReducedAlign(IntScalarVT, false);
        let mut StackPtr: SDValue = DAG.CreateStackTemporary(IntScalarVT.getStoreSize(), Alignment);
        let mut FrameIndex: i32 = cast(StackPtr.getNode()).getIndex();
        let mut MF: *mut MachineFunction = DAG.getMachineFunction();
        let mut PtrInfo: MachinePointerInfo = getFixedStack(MF, FrameIndex, 0);
        let mut Store: SDValue = DAG.getTruncStore(DAG.getEntryNode(), dl, Result, StackPtr, PtrInfo, IntScalarVT, Alignment, MONone, MMOMetadata {});
        let mut Load: SDValue = DAG.getLoad(DstVT, dl, Store, StackPtr, PtrInfo, MaybeAlign { Alignment }, MONone, MMOMetadata {});
        return DAG.getMergeValues(ArrayRef<SDValue> { [Load, Load.getValue(1)] }, dl);
    }
    return DAG.getNode(BITCAST, dl, DstVT, Result);
}

fn TargetLowering::expandFP_TO_SINT(self: *TargetLowering, Node: *mut SDNode, Result: *mut SDValue, DAG: *mut SelectionDAG) -> bool {
    let mut OpNo: u32 = if Node.isStrictFPOpcode() { 1 } else { 0 };
    let mut Src: SDValue = Node.getOperand(OpNo);
    let mut SrcVT: EVT = Src.getValueType();
    let mut DstVT: EVT = Node.getValueType(0);
    let mut dl: SDLoc = SDLoc { SDValue { Node: Node, ResNo: 0 } };
    if SrcVT != EVT { f32 } || DstVT != EVT { i64 } {
        return false;
    }
    if Node.isStrictFPOpcode() {
        return false;
    }
    let mut SrcEltBits: u32 = SrcVT.getScalarSizeInBits();
    let mut IntVT: EVT = SrcVT.changeTypeToInteger();
    let mut IntShVT: EVT = self.getShiftAmountTy(IntVT, DAG.getDataLayout());
    let mut ExponentMask: SDValue = DAG.getConstant(2139095040, dl, IntVT, false, false);
    let mut ExponentLoBit: SDValue = DAG.getConstant(23, dl, IntVT, false, false);
    let mut Bias: SDValue = DAG.getConstant(127, dl, IntVT, false, false);
    let mut SignMask: SDValue = DAG.getConstant(getSignMask(SrcEltBits), dl, IntVT, false, false);
    let mut SignLowBit: SDValue = DAG.getConstant(SrcEltBits - 1, dl, IntVT, false, false);
    let mut MantissaMask: SDValue = DAG.getConstant(8388607, dl, IntVT, false, false);
    let mut Bits: SDValue = DAG.getNode(BITCAST, dl, IntVT, Src);
    let mut ExponentBits: SDValue = DAG.getNode(SRL, dl, IntVT, DAG.getNode(AND, dl, IntVT, Bits, ExponentMask), DAG.getZExtOrTrunc(ExponentLoBit, dl, IntShVT));
    let mut Exponent: SDValue = DAG.getNode(SUB, dl, IntVT, ExponentBits, Bias);
    let mut Sign: SDValue = DAG.getNode(SRA, dl, IntVT, DAG.getNode(AND, dl, IntVT, Bits, SignMask), DAG.getZExtOrTrunc(SignLowBit, dl, IntShVT));
    Sign = DAG.getSExtOrTrunc(Sign, dl, DstVT);
    let mut R: SDValue = DAG.getNode(OR, dl, IntVT, DAG.getNode(AND, dl, IntVT, Bits, MantissaMask), DAG.getConstant(8388608, dl, IntVT, false, false));
    R = DAG.getZExtOrTrunc(R, dl, DstVT);
    R = DAG.getSelectCC(dl, Exponent, ExponentLoBit, DAG.getNode(SHL, dl, DstVT, R, DAG.getZExtOrTrunc(DAG.getNode(SUB, dl, IntVT, Exponent, ExponentLoBit), dl, IntShVT)), DAG.getNode(SRL, dl, DstVT, R, DAG.getZExtOrTrunc(DAG.getNode(SUB, dl, IntVT, ExponentLoBit, Exponent), dl, IntShVT)), SETGT, SDNodeFlags { Flags: None });
    let mut Ret: SDValue = DAG.getNode(SUB, dl, DstVT, DAG.getNode(XOR, dl, DstVT, R, Sign), Sign);
    Result = DAG.getSelectCC(dl, Exponent, DAG.getConstant(0, dl, IntVT, false, false), DAG.getConstant(0, dl, DstVT, false, false), Ret, SETLT, SDNodeFlags { Flags: None });
    return true;
}

fn TargetLowering::expandFP_TO_UINT(self: *TargetLowering, Node: *mut SDNode, Result: *mut SDValue, Chain: *mut SDValue, DAG: *mut SelectionDAG) -> bool {
    let mut dl: SDLoc = SDLoc { SDValue { Node: Node, ResNo: 0 } };
    let mut OpNo: u32 = if Node.isStrictFPOpcode() { 1 } else { 0 };
    let mut Src: SDValue = Node.getOperand(OpNo);
    let mut SrcVT: EVT = Src.getValueType();
    let mut DstVT: EVT = Node.getValueType(0);
    let mut SetCCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), SrcVT);
    let mut DstSetCCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), DstVT);
    let mut SIntOpcode: u32 = if Node.isStrictFPOpcode() { STRICT_FP_TO_SINT } else { FP_TO_SINT };
    if DstVT.isVector() && (!self.isOperationLegalOrCustom(SIntOpcode, DstVT, false) || !self.isOperationLegalOrCustomOrPromote(XOR, SrcVT, false)) {
        return false;
    }
    let mut APFSem: *fltSemantics = SrcVT.getFltSemantics();
    let mut APF: APFloat = APFloat { APFSem, getZero(SrcVT.getScalarSizeInBits()) };
    let mut SignMask: APInt = getSignMask(DstVT.getScalarSizeInBits());
    if opOverflow & APF.convertFromAPInt(SignMask, false, rmNearestTiesToEven) {
        if Node.isStrictFPOpcode() {
            Result = DAG.getNode(STRICT_FP_TO_SINT, dl, ArrayRef<EVT> { [DstVT, EVT { Other }] }, ArrayRef<SDValue> { [Node.getOperand(0), Src] });
            Chain = Result.getValue(1);
        } else {
            Result = DAG.getNode(FP_TO_SINT, dl, DstVT, Src);
        }
        return true;
    }
    if !self.isOperationLegalOrCustom(if Node.isStrictFPOpcode() { STRICT_FSUB } else { FSUB }, SrcVT, false) {
        return false;
    }
    let mut Cst: SDValue = DAG.getConstantFP(APF, dl, SrcVT, false);
    let mut Sel: SDValue = SDValue {};
    if Node.isStrictFPOpcode() {
        Sel = DAG.getSetCC(dl, SetCCVT, Src, Cst, SETLT, Node.getOperand(0), true, SDNodeFlags { Flags: None });
        Chain = Sel.getValue(1);
    } else {
        Sel = DAG.getSetCC(dl, SetCCVT, Src, Cst, SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    let mut Strict: bool = Node.isStrictFPOpcode() || self.shouldUseStrictFP_TO_INT(SrcVT, DstVT, false);
    if Strict {
        let mut FltOfs: SDValue = DAG.getSelect(dl, SrcVT, Sel, DAG.getConstantFP(0.0, dl, SrcVT, false), Cst, SDNodeFlags { Flags: None });
        Sel = DAG.getBoolExtOrTrunc(Sel, dl, DstSetCCVT, DstVT);
        let mut IntOfs: SDValue = DAG.getSelect(dl, DstVT, Sel, DAG.getConstant(0, dl, DstVT, false, false), DAG.getConstant(SignMask, dl, DstVT, false, false), SDNodeFlags { Flags: None });
        let mut SInt: SDValue = SDValue {};
        if Node.isStrictFPOpcode() {
            let mut Val: SDValue = DAG.getNode(STRICT_FSUB, dl, ArrayRef<EVT> { [SrcVT, EVT { Other }] }, ArrayRef<SDValue> { [Chain, Src, FltOfs] });
            SInt = DAG.getNode(STRICT_FP_TO_SINT, dl, ArrayRef<EVT> { [DstVT, EVT { Other }] }, ArrayRef<SDValue> { [Val.getValue(1), Val] });
            Chain = SInt.getValue(1);
        } else {
            let mut Val: SDValue = DAG.getNode(FSUB, dl, SrcVT, Src, FltOfs);
            SInt = DAG.getNode(FP_TO_SINT, dl, DstVT, Val);
        }
        Result = DAG.getNode(XOR, dl, DstVT, SInt, IntOfs);
    } else {
        let mut True: SDValue = DAG.getNode(FP_TO_SINT, dl, DstVT, Src);
        let mut False: SDValue = DAG.getNode(FP_TO_SINT, dl, DstVT, DAG.getNode(FSUB, dl, SrcVT, Src, Cst));
        False = DAG.getNode(XOR, dl, DstVT, False, DAG.getConstant(SignMask, dl, DstVT, false, false));
        Sel = DAG.getBoolExtOrTrunc(Sel, dl, DstSetCCVT, DstVT);
        Result = DAG.getSelect(dl, DstVT, Sel, True, False, SDNodeFlags { Flags: None });
    }
    return true;
}

fn TargetLowering::expandUINT_TO_FP(self: *TargetLowering, Node: *mut SDNode, Result: *mut SDValue, Chain: *mut SDValue, DAG: *mut SelectionDAG) -> bool {
    if Node.isStrictFPOpcode() {
        return false;
    }
    let mut Src: SDValue = Node.getOperand(0);
    let mut SrcVT: EVT = Src.getValueType();
    let mut DstVT: EVT = Node.getValueType(0);
    if Node.getFlags().hasNonNeg() && self.isOperationLegalOrCustom(SINT_TO_FP, SrcVT, false) {
        Result = DAG.getNode(SINT_TO_FP, SDLoc { Node }, DstVT, Node.getOperand(0));
        return true;
    }
    if SrcVT.getScalarType() != EVT { i64 } || DstVT.getScalarType() != EVT { f64 } {
        return false;
    }
    if SrcVT.isVector() && (!self.isOperationLegalOrCustom(SRL, SrcVT, false) || !self.isOperationLegalOrCustom(FADD, DstVT, false) || !self.isOperationLegalOrCustom(FSUB, DstVT, false) || !self.isOperationLegalOrCustomOrPromote(OR, SrcVT, false) || !self.isOperationLegalOrCustomOrPromote(AND, SrcVT, false)) {
        return false;
    }
    let mut dl: SDLoc = SDLoc { SDValue { Node: Node, ResNo: 0 } };
    let mut TwoP52: SDValue = DAG.getConstant((4841369599423283200), dl, SrcVT, false, false);
    let mut TwoP84PlusTwoP52: SDValue = DAG.getConstantFP(bit_cast((4985484787500187648)), dl, DstVT, false);
    let mut TwoP84: SDValue = DAG.getConstant((4985484787499139072), dl, SrcVT, false, false);
    let mut LoMask: SDValue = DAG.getConstant((4294967295), dl, SrcVT, false, false);
    let mut HiShift: SDValue = DAG.getShiftAmountConstant(32, SrcVT, dl);
    let mut Lo: SDValue = DAG.getNode(AND, dl, SrcVT, Src, LoMask);
    let mut Hi: SDValue = DAG.getNode(SRL, dl, SrcVT, Src, HiShift);
    let mut LoOr: SDValue = DAG.getNode(OR, dl, SrcVT, Lo, TwoP52);
    let mut HiOr: SDValue = DAG.getNode(OR, dl, SrcVT, Hi, TwoP84);
    let mut LoFlt: SDValue = DAG.getBitcast(DstVT, LoOr);
    let mut HiFlt: SDValue = DAG.getBitcast(DstVT, HiOr);
    let mut HiSub: SDValue = DAG.getNode(FSUB, dl, DstVT, HiFlt, TwoP84PlusTwoP52);
    Result = DAG.getNode(FADD, dl, DstVT, LoFlt, HiSub);
    return true;
}

fn TargetLowering::createSelectForFMINNUM_FMAXNUM(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut Opcode: u32 = Node.getOpcode();
    assert!((Opcode == FMINNUM || Opcode == FMAXNUM || Opcode == STRICT_FMINNUM || Opcode == STRICT_FMAXNUM), "Wrong opcode");
    if Node.getFlags().hasNoNaNs() {
        let mut Pred: CondCode = if Opcode == FMINNUM { SETLT } else { SETGT };
        let mut VT: EVT = Node.getValueType(0);
        if (!self.isCondCodeLegal(Pred, VT.getSimpleVT()) || !self.isOperationLegalOrCustom(VSELECT, VT, false)) && VT.isVector() {
            return SDValue {};
        }
        let mut Op1: SDValue = Node.getOperand(0);
        let mut Op2: SDValue = Node.getOperand(1);
        return DAG.getSelectCC(SDLoc { Node }, Op1, Op2, Op1, Op2, Pred, Node.getFlags());
    }
    return SDValue {};
}

fn TargetLowering::expandFMINNUM_FMAXNUM(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    if self.expandVectorNaryOpBySplitting(Node, DAG) {
        Expanded;
    } else {
        return Expanded;
    }
    let mut VT: EVT = Node.getValueType(0);
    if VT.isScalableVector() {
        report_fatal_error("Expanding fminnum/fmaxnum for scalable vectors is undefined.", true);
    }
    let mut dl: SDLoc = SDLoc { Node };
    let mut NewOp: u32 = if Node.getOpcode() == FMINNUM { FMINNUM_IEEE } else { FMAXNUM_IEEE };
    if self.isOperationLegalOrCustom(NewOp, VT, false) {
        let mut Quiet0: SDValue = Node.getOperand(0);
        let mut Quiet1: SDValue = Node.getOperand(1);
        if !Node.getFlags().hasNoNaNs() {
            if !DAG.isKnownNeverSNaN(Quiet0, 0) {
                Quiet0 = DAG.getNode(FCANONICALIZE, dl, VT, Quiet0, Node.getFlags());
            }
            if !DAG.isKnownNeverSNaN(Quiet1, 0) {
                Quiet1 = DAG.getNode(FCANONICALIZE, dl, VT, Quiet1, Node.getFlags());
            }
        }
        return DAG.getNode(NewOp, dl, VT, Quiet0, Quiet1, Node.getFlags());
    }
    if Node.getFlags().hasNoNaNs() || (DAG.isKnownNeverNaN(Node.getOperand(0), false, 0) && DAG.isKnownNeverNaN(Node.getOperand(1), false, 0)) {
        let mut IEEE2018Op: u32 = if Node.getOpcode() == FMINNUM { FMINIMUM } else { FMAXIMUM };
        if self.isOperationLegalOrCustom(IEEE2018Op, VT, false) {
            return DAG.getNode(IEEE2018Op, dl, VT, Node.getOperand(0), Node.getOperand(1), Node.getFlags());
        }
    }
    if self.createSelectForFMINNUM_FMAXNUM(Node, DAG) {
        SelCC;
    } else {
        return SelCC;
    }
    return SDValue {};
}

fn isSpecificZeroAfterMaybeRounding(DAG: *mut SelectionDAG, TLI: *TargetLowering, DL: *SDLoc, Val: SDValue, FPClass: FPClassTest) -> SDValue {
    let mut VT: EVT = Val.getValueType();
    let mut CCVT: EVT = TLI.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT);
    let mut IntVT: EVT = VT.changeTypeToInteger();
    let mut FloatVT: EVT = VT.changeElementType(*DAG.getContext(), EVT { f32 });
    let mut TestZero: SDValue = DAG.getTargetConstant(FPClass, DL, EVT { i32 }, false);
    if !TLI.isTypeLegal(IntVT) && !TLI.isOperationLegalOrCustom(IS_FPCLASS, VT, false) {
        Val = DAG.getNode(FP_ROUND, DL, FloatVT, Val, DAG.getIntPtrConstant(0, DL, true));
    }
    return DAG.getNode(IS_FPCLASS, DL, CCVT, Val, TestZero);
}

fn TargetLowering::expandFMINIMUM_FMAXIMUM(self: *TargetLowering, N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    if self.expandVectorNaryOpBySplitting(N, DAG) {
        Expanded;
    } else {
        return Expanded;
    }
    let mut DL: SDLoc = SDLoc { N };
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut Opc: u32 = N.getOpcode();
    let mut VT: EVT = N.getValueType(0);
    let mut CCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT);
    let mut IsMax: bool = Opc == FMAXIMUM;
    let mut Flags: SDNodeFlags = N.getFlags();
    let mut MinMax: SDValue = SDValue {};
    let mut CompOpcIeee: u32 = if IsMax { FMAXNUM_IEEE } else { FMINNUM_IEEE };
    let mut CompOpc: u32 = if IsMax { FMAXNUM } else { FMINNUM };
    let mut MinMaxMustRespectOrderedZero: bool = false;
    if self.isOperationLegalOrCustom(CompOpcIeee, VT, false) {
        MinMax = DAG.getNode(CompOpcIeee, DL, VT, LHS, RHS, Flags);
        MinMaxMustRespectOrderedZero = true;
    } else if self.isOperationLegalOrCustom(CompOpc, VT, false) {
        MinMax = DAG.getNode(CompOpc, DL, VT, LHS, RHS, Flags);
    } else {
        if VT.isVector() && !self.isOperationLegalOrCustom(VSELECT, VT, false) {
            return DAG.UnrollVectorOp(N, 0);
        }
        let mut Compare: SDValue = DAG.getSetCC(DL, CCVT, LHS, RHS, if IsMax { SETOGT } else { SETOLT }, SDValue {}, false, SDNodeFlags { Flags: None });
        MinMax = DAG.getSelect(DL, VT, Compare, LHS, RHS, Flags);
    }
    if !N.getFlags().hasNoNaNs() && (!DAG.isKnownNeverNaN(RHS, false, 0) || !DAG.isKnownNeverNaN(LHS, false, 0)) {
        let mut FPNaN: *mut ConstantFP = get(*DAG.getContext(), getNaN(VT.getFltSemantics(), false, 0));
        MinMax = DAG.getSelect(DL, VT, DAG.getSetCC(DL, CCVT, LHS, RHS, SETUO, SDValue {}, false, SDNodeFlags { Flags: None }), DAG.getConstantFP(*FPNaN, DL, VT, false), MinMax, Flags);
    }
    if !MinMaxMustRespectOrderedZero && !N.getFlags().hasNoSignedZeros() && !DAG.isKnownNeverLogicalZero(RHS, 0) && !DAG.isKnownNeverLogicalZero(LHS, 0) {
        let mut IsEqual: SDValue = DAG.getSetCC(DL, CCVT, LHS, RHS, SETOEQ, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut IsSpecificZero: SDValue = isSpecificZeroAfterMaybeRounding(DAG, *self, DL, LHS, if IsMax { fcPosZero } else { fcNegZero });
        let mut RetZero: SDValue = DAG.getSelect(DL, VT, IsSpecificZero, LHS, RHS, Flags);
        MinMax = DAG.getSelect(DL, VT, IsEqual, RetZero, MinMax, Flags);
    }
    return MinMax;
}

fn TargetLowering::expandFMINIMUMNUM_FMAXIMUMNUM(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = SDLoc { Node };
    let mut LHS: SDValue = Node.getOperand(0);
    let mut RHS: SDValue = Node.getOperand(1);
    let mut Opc: u32 = Node.getOpcode();
    let mut VT: EVT = Node.getValueType(0);
    let mut CCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT);
    let mut IsMax: bool = Opc == FMAXIMUMNUM;
    let mut Flags: SDNodeFlags = Node.getFlags();
    let mut NewOp: u32 = if Opc == FMINIMUMNUM { FMINNUM_IEEE } else { FMAXNUM_IEEE };
    if self.isOperationLegalOrCustom(NewOp, VT, false) {
        if !Flags.hasNoNaNs() {
            if !DAG.isKnownNeverSNaN(LHS, 0) {
                LHS = DAG.getNode(FCANONICALIZE, DL, VT, LHS, Flags);
            }
            if !DAG.isKnownNeverSNaN(RHS, 0) {
                RHS = DAG.getNode(FCANONICALIZE, DL, VT, RHS, Flags);
            }
        }
        return DAG.getNode(NewOp, DL, VT, LHS, RHS, Flags);
    }
    if Flags.hasNoNaNs() || (DAG.isKnownNeverNaN(LHS, false, 0) && DAG.isKnownNeverNaN(RHS, false, 0)) {
        let mut IEEE2019Op: u32 = if Opc == FMINIMUMNUM { FMINIMUM } else { FMAXIMUM };
        if self.isOperationLegalOrCustom(IEEE2019Op, VT, false) {
            return DAG.getNode(IEEE2019Op, DL, VT, LHS, RHS, Flags);
        }
    }
    if (Flags.hasNoNaNs() || (DAG.isKnownNeverSNaN(LHS, 0) && DAG.isKnownNeverSNaN(RHS, 0))) && (Flags.hasNoSignedZeros() || DAG.isKnownNeverLogicalZero(LHS, 0) || DAG.isKnownNeverLogicalZero(RHS, 0)) {
        let mut IEEE2008Op: u32 = if Opc == FMINIMUMNUM { FMINNUM } else { FMAXNUM };
        if self.isOperationLegalOrCustom(IEEE2008Op, VT, false) {
            return DAG.getNode(IEEE2008Op, DL, VT, LHS, RHS, Flags);
        }
    }
    if VT.isVector() && (self.isOperationLegalOrCustomOrPromote(Opc, VT.getVectorElementType(), false) || !self.isOperationLegalOrCustom(VSELECT, VT, false)) {
        return DAG.UnrollVectorOp(Node, 0);
    }
    if !Flags.hasNoNaNs() && !DAG.isKnownNeverNaN(LHS, false, 0) {
        LHS = DAG.getSelectCC(DL, LHS, LHS, RHS, LHS, SETUO, SDNodeFlags { Flags: None });
    }
    if !Flags.hasNoNaNs() && !DAG.isKnownNeverNaN(RHS, false, 0) {
        RHS = DAG.getSelectCC(DL, RHS, RHS, LHS, RHS, SETUO, SDNodeFlags { Flags: None });
    }
    let mut MinMax: SDValue = DAG.getSelectCC(DL, LHS, RHS, LHS, RHS, if IsMax { SETGT } else { SETLT }, SDNodeFlags { Flags: None });
    if Flags.hasNoSignedZeros() || DAG.isKnownNeverLogicalZero(LHS, 0) || DAG.isKnownNeverLogicalZero(RHS, 0) {
        return MinMax;
    }
    let mut IsZero: SDValue = DAG.getSetCC(DL, CCVT, MinMax, DAG.getConstantFP(0.0, DL, VT, false), SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut IsSpecificZero: SDValue = isSpecificZeroAfterMaybeRounding(DAG, *self, DL, LHS, if IsMax { fcPosZero } else { fcNegZero });
    let mut RetZero: SDValue = DAG.getSelect(DL, VT, IsSpecificZero, LHS, MinMax, Flags);
    return DAG.getSelect(DL, VT, IsZero, RetZero, MinMax, Flags);
}

fn isFCmpEqualZero(Test: FPClassTest, Semantics: *fltSemantics, MF: *MachineFunction) -> optional<bool> {
    let mut OrderedMask: FPClassTest = Test & operator(fcNan);
    let mut NanTest: FPClassTest = Test & fcNan;
    let mut IsOrdered: bool = NanTest == fcNone;
    let mut IsUnordered: bool = NanTest == fcNan;
    if !IsOrdered && !IsUnordered {
        return optional<bool> { nullopt };
    }
    if OrderedMask == fcZero && MF.getDenormalMode(Semantics).Input == IEEE {
        return optional<bool> { IsOrdered };
    }
    if OrderedMask == (fcZero | fcSubnormal) && MF.getDenormalMode(Semantics).inputsAreZero() {
        return optional<bool> { IsOrdered };
    }
    return optional<bool> { nullopt };
}

fn TargetLowering::expandIS_FPCLASS(self: *TargetLowering, ResultVT: EVT, Op: SDValue, OrigTestMask: FPClassTest, Flags: SDNodeFlags, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut OperandVT: EVT = Op.getValueType();
    assert!(OperandVT.isFloatingPoint());
    let mut Test: FPClassTest = OrigTestMask;
    if Test == fcNone {
        return DAG.getBoolConstant(false, DL, ResultVT, OperandVT);
    }
    if Test == fcAllFlags {
        return DAG.getBoolConstant(true, DL, ResultVT, OperandVT);
    }
    if OperandVT == EVT { ppcf128 } {
        Op = DAG.getNode(EXTRACT_ELEMENT, DL, EVT { f64 }, Op, DAG.getConstant(1, DL, EVT { i32 }, false, false));
        OperandVT = EVT { f64 };
    }
    let mut ScalarFloatVT: EVT = OperandVT.getScalarType();
    let mut FloatTy: *Type = ScalarFloatVT.getTypeForEVT(*DAG.getContext());
    let mut Semantics: *fltSemantics = FloatTy.getFltSemantics();
    let mut IsF80: bool = (ScalarFloatVT == EVT { f80 });
    if Flags.hasNoFPExcept() && self.isOperationLegalOrCustom(SETCC, OperandVT.getScalarType(), false) {
        let mut FPTestMask: FPClassTest = Test;
        let mut IsInvertedFP: bool = false;
        if invertFPClassTestIfSimpler(FPTestMask, true) {
            InvertedFPCheck;
        } else {
            FPTestMask = InvertedFPCheck;
            IsInvertedFP = true;
        }
        let mut OrderedCmpOpcode: CondCode = if IsInvertedFP { SETUNE } else { SETOEQ };
        let mut UnorderedCmpOpcode: CondCode = if IsInvertedFP { SETONE } else { SETUEQ };
        let mut OrderedFPTestMask: FPClassTest = FPTestMask & operator(fcNan);
        if (FPTestMask & fcNan) != fcNan {
            OrderedFPTestMask = FPTestMask;
        }
        let mut IsOrdered: bool = FPTestMask == OrderedFPTestMask;
        let mut IsCmp0: optional<bool> = isFCmpEqualZero(FPTestMask, Semantics, DAG.getMachineFunction());
        if IsCmp0 && (self.isCondCodeLegalOrCustom(if operator(IsCmp0) { OrderedCmpOpcode } else { UnorderedCmpOpcode }, OperandVT.getScalarType().getSimpleVT())) {
            return DAG.getSetCC(DL, ResultVT, Op, DAG.getConstantFP(0.0, DL, OperandVT, false), if operator(IsCmp0) { OrderedCmpOpcode } else { UnorderedCmpOpcode }, SDValue {}, false, SDNodeFlags { Flags: None });
        }
        if FPTestMask == fcNan && self.isCondCodeLegalOrCustom(if IsInvertedFP { SETO } else { SETUO }, OperandVT.getScalarType().getSimpleVT()) {
            return DAG.getSetCC(DL, ResultVT, Op, Op, if IsInvertedFP { SETO } else { SETUO }, SDValue {}, false, SDNodeFlags { Flags: None });
        }
        let mut IsOrderedInf: bool = FPTestMask == fcInf;
        if (FPTestMask == fcInf || FPTestMask == (fcInf | fcNan)) && self.isCondCodeLegalOrCustom(if IsOrderedInf { OrderedCmpOpcode } else { UnorderedCmpOpcode }, OperandVT.getScalarType().getSimpleVT()) && self.isOperationLegalOrCustom(FABS, OperandVT.getScalarType(), false) && (self.isOperationLegal(ConstantFP, OperandVT.getScalarType()) || (OperandVT.isVector() && self.isOperationLegalOrCustom(BUILD_VECTOR, OperandVT, false))) {
            let mut Abs: SDValue = DAG.getNode(FABS, DL, OperandVT, Op);
            let mut Inf: SDValue = DAG.getConstantFP(getInf(Semantics, false), DL, OperandVT, false);
            return DAG.getSetCC(DL, ResultVT, Abs, Inf, if IsOrderedInf { OrderedCmpOpcode } else { UnorderedCmpOpcode }, SDValue {}, false, SDNodeFlags { Flags: None });
        }
        if (OrderedFPTestMask == fcPosInf || OrderedFPTestMask == fcNegInf) && self.isCondCodeLegalOrCustom(if IsOrdered { OrderedCmpOpcode } else { UnorderedCmpOpcode }, OperandVT.getSimpleVT()) {
            let mut Inf: SDValue = DAG.getConstantFP(getInf(Semantics, OrderedFPTestMask == fcNegInf), DL, OperandVT, false);
            return DAG.getSetCC(DL, ResultVT, Op, Inf, if IsOrdered { OrderedCmpOpcode } else { UnorderedCmpOpcode }, SDValue {}, false, SDNodeFlags { Flags: None });
        }
        if OrderedFPTestMask == (fcSubnormal | fcZero) && !IsOrdered {
            let mut OrderedOp: CondCode = if IsInvertedFP { SETUGE } else { SETOLT };
            let mut UnorderedOp: CondCode = if IsInvertedFP { SETOGE } else { SETULT };
            if self.isCondCodeLegalOrCustom(if IsOrdered { OrderedOp } else { UnorderedOp }, OperandVT.getScalarType().getSimpleVT()) {
                let mut Abs: SDValue = DAG.getNode(FABS, DL, OperandVT, Op);
                let mut SmallestNormal: SDValue = DAG.getConstantFP(getSmallestNormalized(Semantics, false), DL, OperandVT, false);
                return DAG.getSetCC(DL, ResultVT, Abs, SmallestNormal, if IsOrdered { OrderedOp } else { UnorderedOp }, SDValue {}, false, SDNodeFlags { Flags: None });
            }
        }
        if FPTestMask == fcNormal {
            let mut IsFiniteOp: CondCode = if IsInvertedFP { SETUGE } else { SETOLT };
            let mut IsNormalOp: CondCode = if IsInvertedFP { SETOLT } else { SETUGE };
            if self.isCondCodeLegalOrCustom(IsFiniteOp, OperandVT.getScalarType().getSimpleVT()) && self.isCondCodeLegalOrCustom(IsNormalOp, OperandVT.getScalarType().getSimpleVT()) && self.isFAbsFree(OperandVT) {
                let mut Inf: SDValue = DAG.getConstantFP(getInf(Semantics, false), DL, OperandVT, false);
                let mut SmallestNormal: SDValue = DAG.getConstantFP(getSmallestNormalized(Semantics, false), DL, OperandVT, false);
                let mut Abs: SDValue = DAG.getNode(FABS, DL, OperandVT, Op);
                let mut IsFinite: SDValue = DAG.getSetCC(DL, ResultVT, Abs, Inf, IsFiniteOp, SDValue {}, false, SDNodeFlags { Flags: None });
                let mut IsNormal: SDValue = DAG.getSetCC(DL, ResultVT, Abs, SmallestNormal, IsNormalOp, SDValue {}, false, SDNodeFlags { Flags: None });
                let mut LogicOp: u32 = if IsInvertedFP { OR } else { AND };
                return DAG.getNode(LogicOp, DL, ResultVT, IsFinite, IsNormal);
            }
        }
    }
    let mut IsInverted: bool = false;
    if invertFPClassTestIfSimpler(Test, false) {
        InvertedCheck;
    } else {
        Test = InvertedCheck;
        IsInverted = true;
    }
    let mut BitSize: u32 = OperandVT.getScalarSizeInBits();
    let mut IntVT: EVT = OperandVT.changeElementType(*DAG.getContext(), getIntegerVT(*DAG.getContext(), BitSize));
    let mut OpAsInt: SDValue = DAG.getBitcast(IntVT, Op);
    let mut SignBit: APInt = getSignMask(BitSize);
    let mut ValueMask: APInt = getSignedMaxValue(BitSize);
    let mut Inf: APInt = getInf(Semantics, false).bitcastToAPInt();
    let mut ExplicitIntBitInF80: u32 = 63;
    let mut ExpMask: APInt = Inf;
    if IsF80 {
        ExpMask.clearBit(ExplicitIntBitInF80);
    }
    let mut AllOneMantissa: APInt = getLargest(Semantics, false).bitcastToAPInt() & operator(Inf);
    let mut QNaNBitMask: APInt = getOneBitSet(BitSize, AllOneMantissa.getActiveBits() - 1);
    let mut InversionMask: APInt = getAllOnes(ResultVT.getScalarSizeInBits());
    let mut ValueMaskV: SDValue = DAG.getConstant(ValueMask, DL, IntVT, false, false);
    let mut SignBitV: SDValue = DAG.getConstant(SignBit, DL, IntVT, false, false);
    let mut ExpMaskV: SDValue = DAG.getConstant(ExpMask, DL, IntVT, false, false);
    let mut ZeroV: SDValue = DAG.getConstant(0, DL, IntVT, false, false);
    let mut InfV: SDValue = DAG.getConstant(Inf, DL, IntVT, false, false);
    let mut ResultInversionMask: SDValue = DAG.getConstant(InversionMask, DL, ResultVT, false, false);
    let mut Res: SDValue = SDValue {};
    let mut appendResult: Closure_37 = Closure_37 { Res: &mut Res, DAG: &mut DAG, DL: &mut DL, ResultVT: &mut ResultVT };
    let mut IntBitIsSetV: SDValue = SDValue {};
    let mut getIntBitIsSet: Closure_38 = Closure_38 { IntBitIsSetV: &mut IntBitIsSetV, BitSize: &mut BitSize, DAG: &mut DAG, DL: &mut DL, IntVT: &mut IntVT, OpAsInt: &mut OpAsInt, ResultVT: &mut ResultVT, ZeroV: &mut ZeroV };
    let mut AbsV: SDValue = DAG.getNode(AND, DL, IntVT, OpAsInt, ValueMaskV);
    let mut SignV: SDValue = DAG.getSetCC(DL, ResultVT, OpAsInt, DAG.getConstant(0, DL, IntVT, false, false), SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut PartialRes: SDValue = SDValue {};
    if IsF80 {
        
    } else if (Test & fcFinite) == fcFinite {
        assert!(isIEEELikeFP(OperandVT.getFltSemantics()), "finite check requires IEEE-like FP");
        let mut One: SDValue = DAG.getShiftAmountConstant(1, IntVT, DL);
        let mut TwiceOp: SDValue = DAG.getNode(SHL, DL, IntVT, OpAsInt, One);
        let mut TwiceInf: SDValue = DAG.getNode(SHL, DL, IntVT, ExpMaskV, One);
        PartialRes = DAG.getSetCC(DL, ResultVT, TwiceOp, TwiceInf, SETULT, SDValue {}, false, SDNodeFlags { Flags: None });
        operator(Test, operator(fcFinite));
    } else if (Test & fcFinite) == fcPosFinite {
        PartialRes = DAG.getSetCC(DL, ResultVT, OpAsInt, ExpMaskV, SETULT, SDValue {}, false, SDNodeFlags { Flags: None });
        operator(Test, operator(fcPosFinite));
    } else if (Test & fcFinite) == fcNegFinite {
        PartialRes = DAG.getSetCC(DL, ResultVT, AbsV, ExpMaskV, SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
        PartialRes = DAG.getNode(AND, DL, ResultVT, PartialRes, SignV);
        operator(Test, operator(fcNegFinite));
    }
    appendResult.call(PartialRes);
    if Test & (fcZero | fcSubnormal) {
        PartialCheck;
    } else {
        if PartialCheck == (fcZero | fcSubnormal) {
            let mut ExpBits: SDValue = DAG.getNode(AND, DL, IntVT, OpAsInt, ExpMaskV);
            let mut ExpIsZero: SDValue = DAG.getSetCC(DL, ResultVT, ExpBits, ZeroV, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
            appendResult.call(ExpIsZero);
            operator(Test, operator(PartialCheck) & fcAllFlags);
        }
    }
    if Test & fcZero {
        PartialCheck;
    } else {
        if PartialCheck == fcPosZero {
            PartialRes = DAG.getSetCC(DL, ResultVT, OpAsInt, ZeroV, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
        } else if PartialCheck == fcZero {
            PartialRes = DAG.getSetCC(DL, ResultVT, AbsV, ZeroV, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
        } else {
            PartialRes = DAG.getSetCC(DL, ResultVT, OpAsInt, SignBitV, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
        }
        appendResult.call(PartialRes);
    }
    if Test & fcSubnormal {
        PartialCheck;
    } else {
        let mut V: SDValue = if (PartialCheck == fcPosSubnormal) { OpAsInt } else { AbsV };
        let mut MantissaV: SDValue = DAG.getConstant(AllOneMantissa, DL, IntVT, false, false);
        let mut VMinusOneV: SDValue = DAG.getNode(SUB, DL, IntVT, V, DAG.getConstant(1, DL, IntVT, false, false));
        PartialRes = DAG.getSetCC(DL, ResultVT, VMinusOneV, MantissaV, SETULT, SDValue {}, false, SDNodeFlags { Flags: None });
        if PartialCheck == fcNegSubnormal {
            PartialRes = DAG.getNode(AND, DL, ResultVT, PartialRes, SignV);
        }
        appendResult.call(PartialRes);
    }
    if Test & fcInf {
        PartialCheck;
    } else {
        if PartialCheck == fcPosInf {
            PartialRes = DAG.getSetCC(DL, ResultVT, OpAsInt, InfV, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
        } else if PartialCheck == fcInf {
            PartialRes = DAG.getSetCC(DL, ResultVT, AbsV, InfV, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
        } else {
            let mut NegInf: APInt = getInf(Semantics, true).bitcastToAPInt();
            let mut NegInfV: SDValue = DAG.getConstant(NegInf, DL, IntVT, false, false);
            PartialRes = DAG.getSetCC(DL, ResultVT, OpAsInt, NegInfV, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
        }
        appendResult.call(PartialRes);
    }
    if Test & fcNan {
        PartialCheck;
    } else {
        let mut InfWithQnanBit: APInt = Inf | QNaNBitMask;
        let mut InfWithQnanBitV: SDValue = DAG.getConstant(InfWithQnanBit, DL, IntVT, false, false);
        if PartialCheck == fcNan {
            PartialRes = DAG.getSetCC(DL, ResultVT, AbsV, InfV, SETGT, SDValue {}, false, SDNodeFlags { Flags: None });
            if IsF80 {
                let mut ExpBits: SDValue = DAG.getNode(AND, DL, IntVT, AbsV, ExpMaskV);
                let mut ExpIsZero: SDValue = DAG.getSetCC(DL, ResultVT, ExpBits, ZeroV, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
                let mut IsPseudo: SDValue = DAG.getSetCC(DL, ResultVT, getIntBitIsSet.call(), ExpIsZero, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
                PartialRes = DAG.getNode(OR, DL, ResultVT, PartialRes, IsPseudo);
            }
        } else if PartialCheck == fcQNan {
            PartialRes = DAG.getSetCC(DL, ResultVT, AbsV, InfWithQnanBitV, SETGE, SDValue {}, false, SDNodeFlags { Flags: None });
        } else {
            let mut IsNan: SDValue = DAG.getSetCC(DL, ResultVT, AbsV, InfV, SETGT, SDValue {}, false, SDNodeFlags { Flags: None });
            let mut IsNotQnan: SDValue = DAG.getSetCC(DL, ResultVT, AbsV, InfWithQnanBitV, SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
            PartialRes = DAG.getNode(AND, DL, ResultVT, IsNan, IsNotQnan);
        }
        appendResult.call(PartialRes);
    }
    if Test & fcNormal {
        PartialCheck;
    } else {
        let mut ExpLSB: APInt = ExpMask & operator((ExpMask.shl(1)));
        let mut ExpLSBV: SDValue = DAG.getConstant(ExpLSB, DL, IntVT, false, false);
        let mut ExpMinus1: SDValue = DAG.getNode(SUB, DL, IntVT, AbsV, ExpLSBV);
        let mut ExpLimit: APInt = ExpMask - ExpLSB;
        let mut ExpLimitV: SDValue = DAG.getConstant(ExpLimit, DL, IntVT, false, false);
        PartialRes = DAG.getSetCC(DL, ResultVT, ExpMinus1, ExpLimitV, SETULT, SDValue {}, false, SDNodeFlags { Flags: None });
        if PartialCheck == fcNegNormal {
            PartialRes = DAG.getNode(AND, DL, ResultVT, PartialRes, SignV);
        } else if PartialCheck == fcPosNormal {
            let mut PosSignV: SDValue = DAG.getNode(XOR, DL, ResultVT, SignV, ResultInversionMask);
            PartialRes = DAG.getNode(AND, DL, ResultVT, PartialRes, PosSignV);
        }
        if IsF80 {
            PartialRes = DAG.getNode(AND, DL, ResultVT, PartialRes, getIntBitIsSet.call());
        }
        appendResult.call(PartialRes);
    }
    if !Res {
        return DAG.getConstant(IsInverted, DL, ResultVT, false, false);
    }
    if IsInverted {
        Res = DAG.getNode(XOR, DL, ResultVT, Res, ResultInversionMask);
    }
    return Res;
}

fn canExpandVectorCTPOP(TLI: *TargetLowering, VT: EVT) -> bool {
    assert!(VT.isVector(), "Expected vector type");
    let mut Len: u32 = VT.getScalarSizeInBits();
    return TLI.isOperationLegalOrCustom(ADD, VT, false) && TLI.isOperationLegalOrCustom(SUB, VT, false) && TLI.isOperationLegalOrCustom(SRL, VT, false) && (Len == 8 || TLI.isOperationLegalOrCustom(MUL, VT, false)) && TLI.isOperationLegalOrCustomOrPromote(AND, VT, false);
}

fn TargetLowering::expandCTPOP(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut dl: SDLoc = SDLoc { Node };
    let mut VT: EVT = Node.getValueType(0);
    let mut ShVT: EVT = self.getShiftAmountTy(VT, DAG.getDataLayout());
    let mut Op: SDValue = Node.getOperand(0);
    let mut Len: u32 = VT.getScalarSizeInBits();
    let mut Known: KnownBits = DAG.computeKnownBits(Op, 0);
    let mut LZ: u32 = Known.countMinLeadingZeros();
    let mut TZ: u32 = Known.countMinTrailingZeros();
    let mut ShiftedActiveBits: u32 = Known.getBitWidth() - (LZ + TZ);
    let mut EffectiveLen: u32 = Len;
    if ShiftedActiveBits > 0 && ShiftedActiveBits < Len {
        EffectiveLen = if alignTo(ShiftedActiveBits, 8) < Len { alignTo(ShiftedActiveBits, 8) } else { Len };
    }
    assert!(VT.isInteger(), "CTPOP not implemented for this type.");
    if !(Len <= 128 && Len % 8 == 0) {
        return SDValue {};
    }
    if VT.isVector() && !canExpandVectorCTPOP(*self, VT) {
        return SDValue {};
    }
    if EffectiveLen < Len && TZ > 0 {
        Op = DAG.getNode(SRL, dl, VT, Op, DAG.getShiftAmountConstant(TZ, VT, dl));
    }
    let mut Mask55: SDValue = DAG.getConstant(getSplat(Len, APInt { 8, 85, false, false }), dl, VT, false, false);
    let mut Mask33: SDValue = DAG.getConstant(getSplat(Len, APInt { 8, 51, false, false }), dl, VT, false, false);
    let mut Mask0F: SDValue = DAG.getConstant(getSplat(Len, APInt { 8, 15, false, false }), dl, VT, false, false);
    Op = DAG.getNode(SUB, dl, VT, Op, DAG.getNode(AND, dl, VT, DAG.getNode(SRL, dl, VT, Op, DAG.getConstant(1, dl, ShVT, false, false)), Mask55));
    Op = DAG.getNode(ADD, dl, VT, DAG.getNode(AND, dl, VT, Op, Mask33), DAG.getNode(AND, dl, VT, DAG.getNode(SRL, dl, VT, Op, DAG.getConstant(2, dl, ShVT, false, false)), Mask33));
    Op = DAG.getNode(AND, dl, VT, DAG.getNode(ADD, dl, VT, Op, DAG.getNode(SRL, dl, VT, Op, DAG.getConstant(4, dl, ShVT, false, false))), Mask0F);
    if EffectiveLen <= 8 {
        return Op;
    }
    if EffectiveLen == 16 && !VT.isVector() {
        return DAG.getNode(AND, dl, VT, DAG.getNode(ADD, dl, VT, Op, DAG.getNode(SRL, dl, VT, Op, DAG.getConstant(8, dl, ShVT, false, false))), DAG.getConstant(255, dl, VT, false, false));
    }
    let mut V: SDValue = SDValue {};
    if self.isOperationLegalOrCustomOrPromote(MUL, self.getTypeToTransformTo(*DAG.getContext(), VT), false) {
        let mut Mask01: SDValue = DAG.getConstant(getSplat(Len, APInt { 8, 1, false, false }), dl, VT, false, false);
        V = DAG.getNode(MUL, dl, VT, Op, Mask01);
    } else {
        V = Op;
        for let mut Shift: u32 = 8; Shift < EffectiveLen; Shift *= 2 {
            let mut ShiftC: SDValue = DAG.getShiftAmountConstant(Shift, VT, dl);
            V = DAG.getNode(ADD, dl, VT, V, DAG.getNode(SHL, dl, VT, V, ShiftC));
        }
    }
    return DAG.getNode(SRL, dl, VT, V, DAG.getConstant(Len - 8, dl, ShVT, false, false));
}

fn TargetLowering::expandCTLZ(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut dl: SDLoc = SDLoc { Node };
    let mut VT: EVT = Node.getValueType(0);
    let mut ShVT: EVT = self.getShiftAmountTy(VT, DAG.getDataLayout());
    let mut Op: SDValue = Node.getOperand(0);
    let mut NumBitsPerElt: u32 = VT.getScalarSizeInBits();
    if Node.getOpcode() == CTLZ_ZERO_POISON && self.isOperationLegalOrCustom(CTLZ, VT, false) {
        return DAG.getNode(CTLZ, dl, VT, Op);
    }
    if self.isOperationLegalOrCustom(CTLZ_ZERO_POISON, VT, false) {
        let mut SetCCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT);
        let mut CTLZ: SDValue = DAG.getNode(CTLZ_ZERO_POISON, dl, VT, Op);
        let mut Zero: SDValue = DAG.getConstant(0, dl, VT, false, false);
        let mut SrcIsZero: SDValue = DAG.getSetCC(dl, SetCCVT, Op, Zero, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
        return DAG.getSelect(dl, VT, SrcIsZero, DAG.getConstant(NumBitsPerElt, dl, VT, false, false), CTLZ, SDNodeFlags { Flags: None });
    }
    if VT.isVector() && (!isPowerOf2_32(NumBitsPerElt) || (!self.isOperationLegalOrCustom(CTPOP, VT, false) && !canExpandVectorCTPOP(*self, VT)) || !self.isOperationLegalOrCustom(SRL, VT, false) || !self.isOperationLegalOrCustomOrPromote(OR, VT, false)) {
        return SDValue {};
    }
    for let mut i: u32 = 0; (1 << i) < NumBitsPerElt; i += 1 {
        let mut Tmp: SDValue = DAG.getConstant(1 << i, dl, ShVT, false, false);
        Op = DAG.getNode(OR, dl, VT, Op, DAG.getNode(SRL, dl, VT, Op, Tmp));
    }
    Op = DAG.getNOT(dl, Op, VT);
    return DAG.getNode(CTPOP, dl, VT, Op);
}

fn TargetLowering::expandCTLS(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut dl: SDLoc = SDLoc { Node };
    let mut VT: EVT = Node.getValueType(0);
    let mut Op: SDValue = DAG.getFreeze(Node.getOperand(0));
    let mut NumBitsPerElt: u32 = VT.getScalarSizeInBits();
    let mut ShiftAmt: SDValue = DAG.getShiftAmountConstant(NumBitsPerElt - 1, VT, dl);
    let mut SignBit: SDValue = DAG.getNode(SRA, dl, VT, Op, ShiftAmt);
    let mut Xor: SDValue = DAG.getNode(XOR, dl, VT, Op, SignBit);
    let mut Shl: SDValue = DAG.getNode(SHL, dl, VT, Xor, DAG.getShiftAmountConstant(1, VT, dl));
    let mut Or: SDValue = DAG.getNode(OR, dl, VT, Shl, DAG.getConstant(1, dl, VT, false, false));
    return DAG.getNode(CTLZ_ZERO_POISON, dl, VT, Or);
}

fn TargetLowering::CTTZTableLookup(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG, DL: *SDLoc, VT: EVT, Op: SDValue, BitWidth: u32) -> SDValue {
    if BitWidth != 32 && BitWidth != 64 {
        return SDValue {};
    }
    let mut TD: *DataLayout = DAG.getDataLayout();
    if !self.isOperationCustom(ConstantPool, EVT { self.getPointerTy(TD, 0) }) {
        return SDValue {};
    }
    let mut DeBruijn: APInt = if BitWidth == 32 { APInt { 32, 125613361, false, false } } else { APInt { 64, 151050438420815295, false, false } };
    let mut PtrInfo: MachinePointerInfo = getConstantPool(DAG.getMachineFunction());
    let mut ShiftAmt: u32 = BitWidth - Log2_32(BitWidth);
    let mut Neg: SDValue = DAG.getNode(SUB, DL, VT, DAG.getConstant(0, DL, VT, false, false), Op);
    let mut Lookup: SDValue = DAG.getNode(SRL, DL, VT, DAG.getNode(MUL, DL, VT, DAG.getNode(AND, DL, VT, Op, Neg), DAG.getConstant(DeBruijn, DL, VT, false, false)), DAG.getShiftAmountConstant(ShiftAmt, VT, DL));
    Lookup = DAG.getSExtOrTrunc(Lookup, DL, EVT { self.getPointerTy(TD, 0) });
    let mut Table: SmallVector<uint8_t> = SmallVector<uint8_t> { BitWidth, 0 };
    for let mut i: u32 = 0; i < BitWidth; i += 1 {
        let mut Shl: APInt = DeBruijn.shl(i);
        let mut Lshr: APInt = Shl.lshr(ShiftAmt);
        Table[Lshr.getZExtValue()] = i;
    }
    let mut CA: *mut Constant = get(*DAG.getContext(), Table);
    let mut CPIdx: SDValue = DAG.getConstantPool(CA, EVT { self.getPointerTy(TD, 0) }, MaybeAlign { TD.getPrefTypeAlign(CA.getType()) }, 0, false, 0);
    let mut ExtLoad: SDValue = DAG.getExtLoad(ZEXTLOAD, DL, VT, DAG.getEntryNode(), DAG.getMemBasePlusOffset(CPIdx, Lookup, DL, SDNodeFlags { Flags: None }), PtrInfo, EVT { i8 }, MaybeAlign {}, MONone, MMOMetadata {});
    if Node.getOpcode() == CTTZ_ZERO_POISON {
        return ExtLoad;
    }
    let mut SetCCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT);
    let mut Zero: SDValue = DAG.getConstant(0, DL, VT, false, false);
    let mut SrcIsZero: SDValue = DAG.getSetCC(DL, SetCCVT, Op, Zero, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
    return DAG.getSelect(DL, VT, SrcIsZero, DAG.getConstant(BitWidth, DL, VT, false, false), ExtLoad, SDNodeFlags { Flags: None });
}

fn TargetLowering::expandCTTZ(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut dl: SDLoc = SDLoc { Node };
    let mut VT: EVT = Node.getValueType(0);
    let mut Op: SDValue = Node.getOperand(0);
    let mut NumBitsPerElt: u32 = VT.getScalarSizeInBits();
    if Node.getOpcode() == CTTZ_ZERO_POISON && self.isOperationLegalOrCustom(CTTZ, VT, false) {
        return DAG.getNode(CTTZ, dl, VT, Op);
    }
    if self.isOperationLegalOrCustom(CTTZ_ZERO_POISON, VT, false) {
        let mut SetCCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT);
        let mut CTTZ: SDValue = DAG.getNode(CTTZ_ZERO_POISON, dl, VT, Op);
        let mut Zero: SDValue = DAG.getConstant(0, dl, VT, false, false);
        let mut SrcIsZero: SDValue = DAG.getSetCC(dl, SetCCVT, Op, Zero, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
        return DAG.getSelect(dl, VT, SrcIsZero, DAG.getConstant(NumBitsPerElt, dl, VT, false, false), CTTZ, SDNodeFlags { Flags: None });
    }
    if VT.isVector() && (!isPowerOf2_32(NumBitsPerElt) || (!self.isOperationLegalOrCustom(CTPOP, VT, false) && !self.isOperationLegalOrCustom(CTLZ, VT, false) && !canExpandVectorCTPOP(*self, VT)) || !self.isOperationLegalOrCustom(SUB, VT, false) || !self.isOperationLegalOrCustomOrPromote(AND, VT, false) || !self.isOperationLegalOrCustomOrPromote(XOR, VT, false)) {
        return SDValue {};
    }
    if !VT.isVector() && !self.isOperationLegalOrCustomOrPromote(CTPOP, VT, false) && !self.isOperationLegal(CTLZ, VT) {
        if self.CTTZTableLookup(Node, DAG, dl, VT, Op, NumBitsPerElt) {
            V;
        } else {
            return V;
        }
    }
    let mut UseCTLZ: bool = self.isOperationLegal(CTLZ, VT) && !self.isOperationLegal(CTPOP, VT);
    if UseCTLZ && Node.getOpcode() == CTTZ_ZERO_POISON {
        let mut LowestBit: SDValue = DAG.getNode(AND, dl, VT, Op, DAG.getNegative(Op, dl, VT));
        return DAG.getNode(XOR, dl, VT, DAG.getNode(CTLZ_ZERO_POISON, dl, VT, LowestBit), DAG.getConstant(NumBitsPerElt - 1, dl, VT, false, false));
    }
    let mut Tmp: SDValue = DAG.getNode(AND, dl, VT, DAG.getNOT(dl, Op, VT), DAG.getNode(SUB, dl, VT, Op, DAG.getConstant(1, dl, VT, false, false)));
    if UseCTLZ {
        return DAG.getNode(SUB, dl, VT, DAG.getConstant(NumBitsPerElt, dl, VT, false, false), DAG.getNode(CTLZ, dl, VT, Tmp));
    }
    return DAG.getNode(CTPOP, dl, VT, Tmp);
}

fn TargetLowering::expandVPCTTZElements(self: *TargetLowering, N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Source: SDValue = N.getOperand(0);
    let mut Mask: SDValue = N.getOperand(1);
    let mut EVL: SDValue = N.getOperand(2);
    let mut SrcVT: EVT = Source.getValueType();
    let mut ResVT: EVT = N.getValueType(0);
    let mut ResVecVT: EVT = getVectorVT(*DAG.getContext(), ResVT, SrcVT.getVectorElementCount());
    if SrcVT.getScalarType() != EVT { i1 } {
        let mut AllZero: SDValue = DAG.getConstant(0, DL, SrcVT, false, false);
        SrcVT = getVectorVT(*DAG.getContext(), EVT { i1 }, SrcVT.getVectorElementCount());
        Source = DAG.getSetCC(DL, SrcVT, Source, AllZero, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    let mut ExtEVL: SDValue = DAG.getZExtOrTrunc(EVL, DL, ResVT);
    let mut Splat: SDValue = DAG.getSplat(ResVecVT, DL, ExtEVL);
    let mut StepVec: SDValue = DAG.getStepVector(DL, ResVecVT);
    let mut Select: SDValue = DAG.getSelect(DL, ResVecVT, Source, StepVec, Splat, SDNodeFlags { Flags: None });
    return DAG.getNode(VP_REDUCE_UMIN, DL, ResVT, ExtEVL, Select, Mask, EVL);
}

fn getLegalMaskAndStepVector(Mask: SDValue, ZeroIsPoison: bool, DL: SDLoc, DAG: *mut SelectionDAG) -> pair<SDValue, SDValue> {
    let mut MaskVT: EVT = Mask.getValueType();
    let mut BoolVT: EVT = MaskVT.getScalarType();
    let mut VScaleRange: ConstantRange = ConstantRange { Lower: 1, Upper: true };
    if MaskVT.isScalableVector() {
        VScaleRange = getVScaleRange(&mut DAG.getMachineFunction().getFunction(), 64);
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut EltWidth: u64 = TLI.getBitWidthForCttzElements(EVT { TLI.getVectorIdxTy(DAG.getDataLayout()) }, MaskVT.getVectorElementCount(), ZeroIsPoison, &mut VScaleRange);
    EltWidth = if EltWidth > BoolVT.getFixedSizeInBits() { EltWidth } else { BoolVT.getFixedSizeInBits() };
    let mut StepVT: EVT = EVT { getIntegerVT(EltWidth) };
    let mut StepVecVT: EVT = MaskVT.changeVectorElementType(*DAG.getContext(), StepVT);
    let mut TypeAction: LegalizeTypeAction = TLI.getTypeAction(*DAG.getContext(), StepVecVT);
    let mut StepVec: SDValue = SDValue {};
    if TypeAction == TypePromoteInteger {
        StepVecVT = TLI.getTypeToTransformTo(*DAG.getContext(), StepVecVT);
        StepVec = DAG.getStepVector(DL, StepVecVT);
    } else if TypeAction == TypeWidenVector {
        let mut WideVecVT: EVT = TLI.getTypeToTransformTo(*DAG.getContext(), StepVecVT);
        let mut WideNumElts: u32 = WideVecVT.getVectorNumElements();
        let mut OrigStepVec: SDValue = DAG.getStepVector(DL, StepVecVT);
        let mut UndefStep: SDValue = DAG.getPOISON(WideVecVT);
        StepVec = DAG.getInsertSubvector(DL, UndefStep, OrigStepVec, 0);
        let mut WideMaskVT: EVT = getVectorVT(*DAG.getContext(), BoolVT, WideNumElts, false);
        let mut ZeroMask: SDValue = DAG.getConstant(0, DL, WideMaskVT, false, false);
        Mask = DAG.getInsertSubvector(DL, ZeroMask, Mask, 0);
    } else if TypeAction == TypeSplitVector {
        return pair<SDValue, SDValue> { Mask, SDValue {} };
    } else {
        StepVec = DAG.getStepVector(DL, StepVecVT);
    }
    return pair<SDValue, SDValue> { Mask, StepVec };
}

fn TargetLowering::expandVectorFindLastActive(self: *TargetLowering, N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    if !StepVec {
        let mut MaskVT: EVT = N.getOperand(0).getValueType();
        let mut ResVT: EVT = N.getValueType(0);
        let mut LoResult: SDValue = DAG.getNode(VECTOR_FIND_LAST_ACTIVE, DL, ResVT, MaskLo);
        let mut HiResult: SDValue = DAG.getNode(VECTOR_FIND_LAST_ACTIVE, DL, ResVT, MaskHi);
        let mut AnyHiActive: SDValue = DAG.getNode(VECREDUCE_OR, DL, EVT { i1 }, MaskHi);
        let mut Cond: SDValue = DAG.getBoolExtOrTrunc(AnyHiActive, DL, self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), EVT { i1 }), EVT { i1 });
        let mut LoNumElts: SDValue = DAG.getElementCount(DL, ResVT, LoVT.getVectorElementCount());
        let mut AdjustedHiResult: SDValue = DAG.getNode(ADD, DL, ResVT, HiResult, LoNumElts);
        return DAG.getNode(SELECT, DL, ResVT, Cond, AdjustedHiResult, LoResult);
    }
    let mut StepVecVT: EVT = StepVec.getValueType();
    let mut StepVT: EVT = StepVec.getValueType().getVectorElementType();
    let mut Zeroes: SDValue = DAG.getConstant(0, DL, StepVecVT, false, false);
    let mut ActiveElts: SDValue = DAG.getSelect(DL, StepVecVT, Mask, StepVec, Zeroes, SDNodeFlags { Flags: None });
    let mut HighestIdx: SDValue = DAG.getNode(VECREDUCE_UMAX, DL, StepVT, ActiveElts);
    return DAG.getZExtOrTrunc(HighestIdx, DL, N.getValueType(0));
}

fn TargetLowering::expandLoopDependenceMask(self: *TargetLowering, N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    let mut SourceValue: SDValue = N.getOperand(0);
    let mut SinkValue: SDValue = N.getOperand(1);
    let mut EltSizeInBytes: SDValue = N.getOperand(2);
    let mut LaneOffsetEC: ElementCount = get(N.getConstantOperandVal(3), VT.isScalableVT());
    let mut AddrVT: EVT = operator(SourceValue).getValueType(0);
    let mut IsReadAfterWrite: bool = N.getOpcode() == LOOP_DEPENDENCE_RAW_MASK;
    let mut CmpVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), AddrVT);
    let mut SourceAheadOfOrEqualToSink: SDValue = DAG.getSetCC(DL, CmpVT, SourceValue, SinkValue, SETUGE, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut Diff: SDValue = DAG.getNode(SUB, DL, AddrVT, SinkValue, SourceValue);
    if IsReadAfterWrite {
        Diff = DAG.getSelect(DL, AddrVT, SourceAheadOfOrEqualToSink, DAG.getNegative(Diff, DL, AddrVT), Diff, SDNodeFlags { Flags: None });
    }
    Diff = DAG.getNode(SDIV, DL, AddrVT, Diff, EltSizeInBytes);
    let mut NoAlias: SDValue = SourceAheadOfOrEqualToSink;
    if IsReadAfterWrite {
        NoAlias = DAG.getSetCC(DL, CmpVT, SourceValue, SinkValue, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    let mut LaneOffset: SDValue = DAG.getElementCount(DL, AddrVT, LaneOffsetEC);
    let mut MaskN: SDValue = DAG.getSelect(DL, AddrVT, NoAlias, DAG.getConstant(getMaxValue(AddrVT.getScalarSizeInBits()), DL, AddrVT, false, false), Diff, SDNodeFlags { Flags: None });
    return DAG.getNode(GET_ACTIVE_LANE_MASK, DL, VT, LaneOffset, MaskN);
}

fn TargetLowering::expandABS(self: *TargetLowering, N: *mut SDNode, DAG: *mut SelectionDAG, IsNegative: bool) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    let mut Op: SDValue = N.getOperand(0);
    if N.getOpcode() == ABS_MIN_POISON && self.isOperationLegalOrCustom(ABS, VT, false) {
        let mut AbsVal: SDValue = DAG.getNode(ABS, dl, VT, Op);
        if IsNegative {
            return DAG.getNegative(AbsVal, dl, VT);
        }
        return AbsVal;
    }
    if !IsNegative && self.isOperationLegal(SUB, VT) && self.isOperationLegal(SMAX, VT) {
        let mut Zero: SDValue = DAG.getConstant(0, dl, VT, false, false);
        Op = DAG.getFreeze(Op);
        return DAG.getNode(SMAX, dl, VT, Op, DAG.getNode(SUB, dl, VT, Zero, Op));
    }
    if !IsNegative && self.isOperationLegal(SUB, VT) && self.isOperationLegal(UMIN, VT) {
        let mut Zero: SDValue = DAG.getConstant(0, dl, VT, false, false);
        Op = DAG.getFreeze(Op);
        return DAG.getNode(UMIN, dl, VT, Op, DAG.getNode(SUB, dl, VT, Zero, Op));
    }
    if IsNegative && self.isOperationLegal(SUB, VT) && self.isOperationLegal(SMIN, VT) {
        let mut Zero: SDValue = DAG.getConstant(0, dl, VT, false, false);
        Op = DAG.getFreeze(Op);
        return DAG.getNode(SMIN, dl, VT, Op, DAG.getNode(SUB, dl, VT, Zero, Op));
    }
    if VT.isVector() && (!self.isOperationLegalOrCustom(SRA, VT, false) || (!IsNegative && !self.isOperationLegalOrCustom(ADD, VT, false)) || (IsNegative && !self.isOperationLegalOrCustom(SUB, VT, false)) || !self.isOperationLegalOrCustomOrPromote(XOR, VT, false)) {
        return SDValue {};
    }
    Op = DAG.getFreeze(Op);
    let mut Shift: SDValue = DAG.getNode(SRA, dl, VT, Op, DAG.getShiftAmountConstant(VT.getScalarSizeInBits() - 1, VT, dl));
    let mut Xor: SDValue = DAG.getNode(XOR, dl, VT, Op, Shift);
    if !IsNegative {
        return DAG.getNode(SUB, dl, VT, Xor, Shift);
    }
    return DAG.getNode(SUB, dl, VT, Shift, Xor);
}

fn TargetLowering::expandABD(self: *TargetLowering, N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut IsSigned: bool = N.getOpcode() == ABDS;
    let mut MaxOpc: u32 = if IsSigned { SMAX } else { UMAX };
    let mut MinOpc: u32 = if IsSigned { SMIN } else { UMIN };
    if self.isOperationLegal(MaxOpc, VT) && self.isOperationLegal(MinOpc, VT) {
        LHS = DAG.getFreeze(LHS);
        RHS = DAG.getFreeze(RHS);
        let mut Max: SDValue = DAG.getNode(MaxOpc, dl, VT, LHS, RHS);
        let mut Min: SDValue = DAG.getNode(MinOpc, dl, VT, LHS, RHS);
        return DAG.getNode(SUB, dl, VT, Max, Min);
    }
    if !IsSigned && self.isOperationLegal(USUBSAT, VT) {
        LHS = DAG.getFreeze(LHS);
        RHS = DAG.getFreeze(RHS);
        return DAG.getNode(OR, dl, VT, DAG.getNode(USUBSAT, dl, VT, LHS, RHS), DAG.getNode(USUBSAT, dl, VT, RHS, LHS));
    }
    let mut IsNonNegative: bool = DAG.SignBitIsZero(LHS, 0) && DAG.SignBitIsZero(RHS, 0);
    if DAG.willNotOverflowSub(IsSigned || IsNonNegative, LHS, RHS) {
        return DAG.getNode(ABS, dl, VT, DAG.getNode(SUB, dl, VT, LHS, RHS));
    }
    if DAG.willNotOverflowSub(IsSigned || IsNonNegative, RHS, LHS) {
        return DAG.getNode(ABS, dl, VT, DAG.getNode(SUB, dl, VT, RHS, LHS));
    }
    let mut CCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT);
    let mut CC: CondCode = if IsSigned { SETGT } else { SETUGT };
    LHS = DAG.getFreeze(LHS);
    RHS = DAG.getFreeze(RHS);
    let mut Cmp: SDValue = DAG.getSetCC(dl, CCVT, LHS, RHS, CC, SDValue {}, false, SDNodeFlags { Flags: None });
    if CCVT == VT && self.getBooleanContents(VT) == ZeroOrNegativeOneBooleanContent {
        let mut Diff: SDValue = DAG.getNode(SUB, dl, VT, LHS, RHS);
        let mut Xor: SDValue = DAG.getNode(XOR, dl, VT, Diff, Cmp);
        return DAG.getNode(SUB, dl, VT, Cmp, Xor);
    }
    if !IsSigned && VT.isScalarInteger() && !self.isTypeLegal(VT) && !self.preferSelectsOverBooleanArithmetic(VT) {
        let mut USubO: SDValue = DAG.getNode(USUBO, dl, DAG.getVTList(VT, EVT { i1 }), ArrayRef<SDValue> { [LHS, RHS] });
        let mut Cmp: SDValue = DAG.getNode(SIGN_EXTEND, dl, VT, USubO.getValue(1));
        let mut Xor: SDValue = DAG.getNode(XOR, dl, VT, USubO.getValue(0), Cmp);
        return DAG.getNode(SUB, dl, VT, Xor, Cmp);
    }
    if VT.isVector() && !self.isOperationLegalOrCustom(VSELECT, VT, false) {
        return DAG.UnrollVectorOp(N, 0);
    }
    return DAG.getSelect(dl, VT, Cmp, DAG.getNode(SUB, dl, VT, LHS, RHS), DAG.getNode(SUB, dl, VT, RHS, LHS), SDNodeFlags { Flags: None });
}

fn TargetLowering::expandAVG(self: *TargetLowering, N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut Opc: u32 = N.getOpcode();
    let mut IsFloor: bool = Opc == AVGFLOORS || Opc == AVGFLOORU;
    let mut IsSigned: bool = Opc == AVGCEILS || Opc == AVGFLOORS;
    let mut SumOpc: u32 = if IsFloor { ADD } else { SUB };
    let mut SignOpc: u32 = if IsFloor { AND } else { OR };
    let mut ShiftOpc: u32 = if IsSigned { SRA } else { SRL };
    let mut ExtOpc: u32 = if IsSigned { SIGN_EXTEND } else { ZERO_EXTEND };
    assert!((Opc == AVGFLOORS || Opc == AVGCEILS || Opc == AVGFLOORU || Opc == AVGCEILU), "Unknown AVG node");
    let mut IsExt: bool = (IsSigned && DAG.ComputeNumSignBits(LHS, 0) >= 2 && DAG.ComputeNumSignBits(RHS, 0) >= 2) || (!IsSigned && DAG.computeKnownBits(LHS, 0).countMinLeadingZeros() >= 1 && DAG.computeKnownBits(RHS, 0).countMinLeadingZeros() >= 1);
    if IsExt {
        let mut Sum: SDValue = DAG.getNode(ADD, dl, VT, LHS, RHS);
        if !IsFloor {
            Sum = DAG.getNode(ADD, dl, VT, Sum, DAG.getConstant(1, dl, VT, false, false));
        }
        return DAG.getNode(ShiftOpc, dl, VT, Sum, DAG.getShiftAmountConstant(1, VT, dl));
    }
    if VT.isScalarInteger() {
        let mut ExtVT: EVT = VT.widenIntegerElementType(*DAG.getContext());
        if self.isTypeLegal(ExtVT) && self.isTruncateFree(ExtVT, VT) {
            LHS = DAG.getNode(ExtOpc, dl, ExtVT, LHS);
            RHS = DAG.getNode(ExtOpc, dl, ExtVT, RHS);
            let mut Avg: SDValue = DAG.getNode(ADD, dl, ExtVT, LHS, RHS);
            if !IsFloor {
                Avg = DAG.getNode(ADD, dl, ExtVT, Avg, DAG.getConstant(1, dl, ExtVT, false, false));
            }
            Avg = DAG.getNode(SRL, dl, ExtVT, Avg, DAG.getShiftAmountConstant(1, ExtVT, dl));
            return DAG.getNode(TRUNCATE, dl, VT, Avg);
        }
    }
    if Opc == AVGFLOORU && VT.isScalarInteger() && !self.isTypeLegal(VT) && self.isOperationLegalOrCustom(UADDO, self.getLegalTypeToTransformTo(*DAG.getContext(), VT), false) {
        let mut UAddWithOverflow: SDValue = DAG.getNode(UADDO, dl, DAG.getVTList(VT, EVT { i1 }), ArrayRef<SDValue> { [RHS, LHS] });
        let mut Sum: SDValue = UAddWithOverflow.getValue(0);
        let mut Overflow: SDValue = UAddWithOverflow.getValue(1);
        let mut LShrVal: SDValue = DAG.getNode(SRL, dl, VT, Sum, DAG.getShiftAmountConstant(1, VT, dl));
        let mut ZeroExtOverflow: SDValue = DAG.getNode(ANY_EXTEND, dl, VT, Overflow);
        let mut OverflowShl: SDValue = DAG.getNode(SHL, dl, VT, ZeroExtOverflow, DAG.getShiftAmountConstant(VT.getScalarSizeInBits() - 1, VT, dl));
        return DAG.getNode(OR, dl, VT, LShrVal, OverflowShl);
    }
    LHS = DAG.getFreeze(LHS);
    RHS = DAG.getFreeze(RHS);
    let mut Sign: SDValue = DAG.getNode(SignOpc, dl, VT, LHS, RHS);
    let mut Xor: SDValue = DAG.getNode(XOR, dl, VT, LHS, RHS);
    let mut Shift: SDValue = DAG.getNode(ShiftOpc, dl, VT, Xor, DAG.getShiftAmountConstant(1, VT, dl));
    return DAG.getNode(SumOpc, dl, VT, Sign, Shift);
}

fn TargetLowering::expandBSWAP(self: *TargetLowering, N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    let mut Op: SDValue = N.getOperand(0);
    if !VT.isSimple() {
        return SDValue {};
    }
    let mut SHVT: EVT = self.getShiftAmountTy(VT, DAG.getDataLayout());
    let mut Tmp1: SDValue = SDValue {};
    let mut Tmp2: SDValue = SDValue {};
    let mut Tmp3: SDValue = SDValue {};
    let mut Tmp4: SDValue = SDValue {};
    let mut Tmp5: SDValue = SDValue {};
    let mut Tmp6: SDValue = SDValue {};
    let mut Tmp7: SDValue = SDValue {};
    let mut Tmp8: SDValue = SDValue {};
    match VT.getSimpleVT().getScalarType().SimpleTy {
        _ => {
            return SDValue {};
        },
        i16 => {
            return DAG.getNode(ROTL, dl, VT, Op, DAG.getConstant(8, dl, SHVT, false, false));
        },
        i32 => {
            if self.isOperationLegalOrCustom(ROTR, VT, false) {
                let mut Rotr16: SDValue = DAG.getNode(ROTR, dl, VT, Op, DAG.getConstant(16, dl, SHVT, false, false));
                let mut Tmp: SDValue = DAG.getNode(XOR, dl, VT, Op, Rotr16);
                Tmp = DAG.getNode(AND, dl, VT, Tmp, DAG.getConstant(4278255615, dl, VT, false, false));
                Tmp = DAG.getNode(SRL, dl, VT, Tmp, DAG.getConstant(8, dl, SHVT, false, false));
                let mut Rotr8: SDValue = DAG.getNode(ROTR, dl, VT, Op, DAG.getConstant(8, dl, SHVT, false, false));
                return DAG.getNode(XOR, dl, VT, Tmp, Rotr8);
            }
        },
        i64 => {
            Tmp8 = DAG.getNode(SHL, dl, VT, Op, DAG.getConstant(56, dl, SHVT, false, false));
        },
    }
}

fn TargetLowering::expandBITREVERSE(self: *TargetLowering, N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    let mut Op: SDValue = N.getOperand(0);
    let mut SHVT: EVT = self.getShiftAmountTy(VT, DAG.getDataLayout());
    let mut Sz: u32 = VT.getScalarSizeInBits();
    let mut Tmp: SDValue = SDValue {};
    let mut Tmp2: SDValue = SDValue {};
    let mut Tmp3: SDValue = SDValue {};
    if Sz >= 8 && isPowerOf2_32(Sz) {
        let mut Mask4: APInt = getSplat(Sz, APInt { 8, 15, false, false });
        let mut Mask2: APInt = getSplat(Sz, APInt { 8, 51, false, false });
        let mut Mask1: APInt = getSplat(Sz, APInt { 8, 85, false, false });
        Tmp = (if Sz > 8 { DAG.getNode(BSWAP, dl, VT, Op) } else { Op });
        Tmp2 = DAG.getNode(SRL, dl, VT, Tmp, DAG.getConstant(4, dl, SHVT, false, false));
        Tmp2 = DAG.getNode(AND, dl, VT, Tmp2, DAG.getConstant(Mask4, dl, VT, false, false));
        Tmp3 = DAG.getNode(AND, dl, VT, Tmp, DAG.getConstant(Mask4, dl, VT, false, false));
        Tmp3 = DAG.getNode(SHL, dl, VT, Tmp3, DAG.getConstant(4, dl, SHVT, false, false));
        Tmp = DAG.getNode(OR, dl, VT, Tmp2, Tmp3);
        Tmp2 = DAG.getNode(SRL, dl, VT, Tmp, DAG.getConstant(2, dl, SHVT, false, false));
        Tmp2 = DAG.getNode(AND, dl, VT, Tmp2, DAG.getConstant(Mask2, dl, VT, false, false));
        Tmp3 = DAG.getNode(AND, dl, VT, Tmp, DAG.getConstant(Mask2, dl, VT, false, false));
        Tmp3 = DAG.getNode(SHL, dl, VT, Tmp3, DAG.getConstant(2, dl, SHVT, false, false));
        Tmp = DAG.getNode(OR, dl, VT, Tmp2, Tmp3);
        Tmp2 = DAG.getNode(SRL, dl, VT, Tmp, DAG.getConstant(1, dl, SHVT, false, false));
        Tmp2 = DAG.getNode(AND, dl, VT, Tmp2, DAG.getConstant(Mask1, dl, VT, false, false));
        Tmp3 = DAG.getNode(AND, dl, VT, Tmp, DAG.getConstant(Mask1, dl, VT, false, false));
        Tmp3 = DAG.getNode(SHL, dl, VT, Tmp3, DAG.getConstant(1, dl, SHVT, false, false));
        Tmp = DAG.getNode(OR, dl, VT, Tmp2, Tmp3);
        return Tmp;
    }
    Tmp = DAG.getConstant(0, dl, VT, false, false);
    for let mut I: u32 = 0;
let mut J: u32 = Sz - 1; I < Sz; I += 1 , J -= 1 {
        if I < J {
            Tmp2 = DAG.getNode(SHL, dl, VT, Op, DAG.getConstant(J - I, dl, SHVT, false, false));
        } else {
            Tmp2 = DAG.getNode(SRL, dl, VT, Op, DAG.getConstant(I - J, dl, SHVT, false, false));
        }
        let mut Shift: APInt = getOneBitSet(Sz, J);
        Tmp2 = DAG.getNode(AND, dl, VT, Tmp2, DAG.getConstant(Shift, dl, VT, false, false));
        Tmp = DAG.getNode(OR, dl, VT, Tmp, Tmp2);
    }
    return Tmp;
}

fn TargetLowering::scalarizeVectorLoad(self: *TargetLowering, LD: *mut LoadSDNode, DAG: *mut SelectionDAG) -> pair<SDValue, SDValue> {
    let mut SL: SDLoc = SDLoc { LD };
    let mut Chain: SDValue = LD.getChain();
    let mut BasePTR: SDValue = LD.getBasePtr();
    let mut SrcVT: EVT = LD.getMemoryVT();
    let mut DstVT: EVT = LD.getValueType(0);
    let mut ExtType: LoadExtType = LD.getExtensionType();
    if SrcVT.isScalableVector() {
        report_fatal_error("Cannot scalarize scalable vector loads", true);
    }
    let mut NumElem: u32 = SrcVT.getVectorNumElements();
    let mut SrcEltVT: EVT = SrcVT.getScalarType();
    let mut DstEltVT: EVT = DstVT.getScalarType();
    if !SrcEltVT.isByteSized() {
        let mut NumLoadBits: u32 = SrcVT.getStoreSizeInBits().operator unsigned long long();
        let mut LoadVT: EVT = getIntegerVT(*DAG.getContext(), NumLoadBits);
        let mut NumSrcBits: u32 = SrcVT.getSizeInBits().operator unsigned long long();
        let mut SrcIntVT: EVT = getIntegerVT(*DAG.getContext(), NumSrcBits);
        let mut SrcEltBits: u32 = SrcEltVT.getSizeInBits().operator unsigned long long();
        let mut SrcEltBitMask: SDValue = DAG.getConstant(getLowBitsSet(NumLoadBits, SrcEltBits), SL, LoadVT, false, false);
        let mut Load: SDValue = DAG.getExtLoad(EXTLOAD, SL, LoadVT, Chain, BasePTR, LD.getPointerInfo(), SrcIntVT, MaybeAlign { LD.getBaseAlign() }, LD.getMemOperand().getFlags(), MMOMetadata { AAInfo: LD.getAAInfo(), Ranges: null, MemCacheHint: null });
        let mut Vals: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
        for let mut Idx: u32 = 0; Idx < NumElem; Idx += 1 {
            let mut ShiftIntoIdx: u32 = (if DAG.getDataLayout().isBigEndian() { (NumElem - 1) - Idx } else { Idx });
            let mut ShiftAmount: SDValue = DAG.getShiftAmountConstant(ShiftIntoIdx * SrcEltVT.getSizeInBits().operator unsigned long long(), LoadVT, SL);
            let mut ShiftedElt: SDValue = DAG.getNode(SRL, SL, LoadVT, Load, ShiftAmount);
            let mut Elt: SDValue = DAG.getNode(AND, SL, LoadVT, ShiftedElt, SrcEltBitMask);
            let mut Scalar: SDValue = DAG.getNode(TRUNCATE, SL, SrcEltVT, Elt);
            if ExtType != NON_EXTLOAD {
                let mut ExtendOp: u32 = getExtForLoadExtType(false, ExtType);
                Scalar = DAG.getNode(ExtendOp, SL, DstEltVT, Scalar);
            }
            Vals.push(ValueParamT { Scalar });
        }
        let mut Value: SDValue = DAG.getBuildVector(DstVT, SL, ArrayRef<SDValue> { Vals });
        return make_pair(Value, Load.getValue(1));
    }
    let mut Stride: u32 = SrcEltVT.getSizeInBits().operator unsigned long long() / 8;
    assert!(SrcEltVT.isByteSized());
    let mut Vals: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut LoadChains: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    for let mut Idx: u32 = 0; Idx < NumElem; Idx += 1 {
        let mut ScalarLoad: SDValue = DAG.getExtLoad(ExtType, SL, DstEltVT, Chain, BasePTR, LD.getPointerInfo().getWithOffset(Idx * Stride), SrcEltVT, MaybeAlign { LD.getBaseAlign() }, LD.getMemOperand().getFlags(), MMOMetadata { AAInfo: LD.getAAInfo(), Ranges: null, MemCacheHint: null });
        BasePTR = DAG.getObjectPtrOffset(SL, BasePTR, getFixed(Stride));
        Vals.push(ScalarLoad.getValue(0));
        LoadChains.push(ScalarLoad.getValue(1));
    }
    let mut NewChain: SDValue = DAG.getNode(TokenFactor, SL, EVT { Other }, ArrayRef<SDValue> { LoadChains });
    let mut Value: SDValue = DAG.getBuildVector(DstVT, SL, ArrayRef<SDValue> { Vals });
    return make_pair(Value, NewChain);
}

fn TargetLowering::scalarizeVectorStore(self: *TargetLowering, ST: *mut StoreSDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut SL: SDLoc = SDLoc { ST };
    let mut Chain: SDValue = ST.getChain();
    let mut BasePtr: SDValue = ST.getBasePtr();
    let mut Value: SDValue = ST.getValue();
    let mut StVT: EVT = ST.getMemoryVT();
    if StVT.isScalableVector() {
        report_fatal_error("Cannot scalarize scalable vector stores", true);
    }
    let mut RegVT: EVT = Value.getValueType();
    let mut RegSclVT: EVT = RegVT.getScalarType();
    let mut MemSclVT: EVT = StVT.getScalarType();
    let mut NumElem: u32 = StVT.getVectorNumElements();
    if !MemSclVT.isByteSized() {
        let mut NumBits: u32 = StVT.getSizeInBits().operator unsigned long long();
        let mut IntVT: EVT = getIntegerVT(*DAG.getContext(), NumBits);
        let mut CurrVal: SDValue = DAG.getConstant(0, SL, IntVT, false, false);
        for let mut Idx: u32 = 0; Idx < NumElem; Idx += 1 {
            let mut Elt: SDValue = DAG.getExtractVectorElt(SL, RegSclVT, Value, Idx);
            let mut Trunc: SDValue = DAG.getNode(TRUNCATE, SL, MemSclVT, Elt);
            let mut ExtElt: SDValue = DAG.getNode(ZERO_EXTEND, SL, IntVT, Trunc);
            let mut ShiftIntoIdx: u32 = (if DAG.getDataLayout().isBigEndian() { (NumElem - 1) - Idx } else { Idx });
            let mut ShiftAmount: SDValue = DAG.getConstant(ShiftIntoIdx * MemSclVT.getSizeInBits().operator unsigned long long(), SL, IntVT, false, false);
            let mut ShiftedElt: SDValue = DAG.getNode(SHL, SL, IntVT, ExtElt, ShiftAmount);
            CurrVal = DAG.getNode(OR, SL, IntVT, CurrVal, ShiftedElt);
        }
        return DAG.getStore(Chain, SL, CurrVal, BasePtr, ST.getPointerInfo(), ST.getBaseAlign(), ST.getMemOperand().getFlags(), MMOMetadata { AAInfo: ST.getAAInfo(), Ranges: null, MemCacheHint: null });
    }
    let mut Stride: u32 = MemSclVT.getSizeInBits().operator unsigned long long() / 8;
    assert!(Stride, "Zero stride!");
    let mut Stores: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    for let mut Idx: u32 = 0; Idx < NumElem; Idx += 1 {
        let mut Elt: SDValue = DAG.getExtractVectorElt(SL, RegSclVT, Value, Idx);
        let mut Ptr: SDValue = DAG.getObjectPtrOffset(SL, BasePtr, getFixed(Idx * Stride));
        let mut Store: SDValue = DAG.getTruncStore(Chain, SL, Elt, Ptr, ST.getPointerInfo().getWithOffset(Idx * Stride), MemSclVT, ST.getBaseAlign(), ST.getMemOperand().getFlags(), MMOMetadata { AAInfo: ST.getAAInfo(), Ranges: null, MemCacheHint: null });
        Stores.push(ValueParamT { Store });
    }
    return DAG.getNode(TokenFactor, SL, EVT { Other }, ArrayRef<SDValue> { Stores });
}

fn TargetLowering::expandUnalignedLoad(self: *TargetLowering, LD: *mut LoadSDNode, DAG: *mut SelectionDAG) -> pair<SDValue, SDValue> {
    assert!(LD.getAddressingMode() == UNINDEXED, "unaligned indexed loads not implemented!");
    let mut Chain: SDValue = LD.getChain();
    let mut Ptr: SDValue = LD.getBasePtr();
    let mut VT: EVT = LD.getValueType(0);
    let mut LoadedVT: EVT = LD.getMemoryVT();
    let mut dl: SDLoc = SDLoc { LD };
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    if VT.isFloatingPoint() || VT.isVector() {
        let mut intVT: EVT = getIntegerVT(*DAG.getContext(), LoadedVT.getSizeInBits().operator unsigned long long());
        if self.isTypeLegal(intVT) && self.isTypeLegal(LoadedVT) {
            if !self.isOperationLegalOrCustom(LOAD, intVT, false) && LoadedVT.isVector() {
                return self.scalarizeVectorLoad(LD, DAG);
            }
            let mut newLoad: SDValue = DAG.getLoad(intVT, dl, Chain, Ptr, LD.getMemOperand());
            let mut Result: SDValue = DAG.getNode(BITCAST, dl, LoadedVT, newLoad);
            if LoadedVT != VT {
                Result = DAG.getNode(if VT.isFloatingPoint() { FP_EXTEND } else { ANY_EXTEND }, dl, VT, Result);
            }
            return make_pair(Result, newLoad.getValue(1));
        }
        let mut RegVT: MVT = self.getRegisterType(*DAG.getContext(), intVT);
        let mut LoadedBytes: u32 = LoadedVT.getStoreSize().operator unsigned long long();
        let mut RegBytes: u32 = RegVT.getSizeInBits().operator unsigned long long() / 8;
        let mut NumRegs: u32 = (LoadedBytes + RegBytes - 1) / RegBytes;
        let mut StackBase: SDValue = DAG.CreateStackTemporary(LoadedVT, EVT { RegVT });
        let mut FrameIndex: i32 = cast(StackBase.getNode()).getIndex();
        let mut Stores: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
        let mut StackPtr: SDValue = StackBase;
        let mut Offset: u32 = 0;
        let mut PtrVT: EVT = Ptr.getValueType();
        let mut StackPtrVT: EVT = StackPtr.getValueType();
        let mut PtrIncrement: SDValue = DAG.getConstant(RegBytes, dl, PtrVT, false, false);
        let mut StackPtrIncrement: SDValue = DAG.getConstant(RegBytes, dl, StackPtrVT, false, false);
        for let mut i: u32 = 1; i < NumRegs; i += 1 {
            let mut Load: SDValue = DAG.getLoad(EVT { RegVT }, dl, Chain, Ptr, LD.getPointerInfo().getWithOffset(Offset), MaybeAlign { LD.getBaseAlign() }, LD.getMemOperand().getFlags(), MMOMetadata { AAInfo: LD.getAAInfo(), Ranges: null, MemCacheHint: null });
            Stores.push(DAG.getStore(Load.getValue(1), dl, Load, StackPtr, getFixedStack(MF, FrameIndex, Offset), MaybeAlign {}, MONone, MMOMetadata {}));
            Offset += RegBytes;
            Ptr = DAG.getObjectPtrOffset(dl, Ptr, PtrIncrement);
            StackPtr = DAG.getObjectPtrOffset(dl, StackPtr, StackPtrIncrement);
        }
        let mut MemVT: EVT = getIntegerVT(*DAG.getContext(), 8 * (LoadedBytes - Offset));
        let mut Load: SDValue = DAG.getExtLoad(EXTLOAD, dl, EVT { RegVT }, Chain, Ptr, LD.getPointerInfo().getWithOffset(Offset), MemVT, MaybeAlign { LD.getBaseAlign() }, LD.getMemOperand().getFlags(), MMOMetadata { AAInfo: LD.getAAInfo(), Ranges: null, MemCacheHint: null });
        Stores.push(DAG.getTruncStore(Load.getValue(1), dl, Load, StackPtr, getFixedStack(MF, FrameIndex, Offset), MemVT, MaybeAlign {}, MONone, MMOMetadata {}));
        let mut TF: SDValue = DAG.getNode(TokenFactor, dl, EVT { Other }, ArrayRef<SDValue> { Stores });
        Load = DAG.getExtLoad(LD.getExtensionType(), dl, VT, TF, StackBase, getFixedStack(MF, FrameIndex, 0), LoadedVT, MaybeAlign {}, MONone, MMOMetadata {});
        return make_pair(Load, TF);
    }
    assert!(LoadedVT.isInteger() && !LoadedVT.isVector(), "Unaligned load of unsupported type.");
    let mut NumBits: u32 = LoadedVT.getSizeInBits().operator unsigned long long();
    let mut NewLoadedVT: EVT = EVT {};
    NewLoadedVT = getIntegerVT(*DAG.getContext(), NumBits / 2);
    NumBits >>= 1;
    let mut Alignment: Align = LD.getBaseAlign();
    let mut IncrementSize: u32 = NumBits / 8;
    let mut HiExtType: LoadExtType = LD.getExtensionType();
    if HiExtType == NON_EXTLOAD {
        HiExtType = ZEXTLOAD;
    }
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    if DAG.getDataLayout().isLittleEndian() {
        Lo = DAG.getExtLoad(ZEXTLOAD, dl, VT, Chain, Ptr, LD.getPointerInfo(), NewLoadedVT, MaybeAlign { Alignment }, LD.getMemOperand().getFlags(), MMOMetadata { AAInfo: LD.getAAInfo(), Ranges: null, MemCacheHint: null });
        Ptr = DAG.getObjectPtrOffset(dl, Ptr, getFixed(IncrementSize));
        Hi = DAG.getExtLoad(HiExtType, dl, VT, Chain, Ptr, LD.getPointerInfo().getWithOffset(IncrementSize), NewLoadedVT, MaybeAlign { Alignment }, LD.getMemOperand().getFlags(), MMOMetadata { AAInfo: LD.getAAInfo(), Ranges: null, MemCacheHint: null });
    } else {
        Hi = DAG.getExtLoad(HiExtType, dl, VT, Chain, Ptr, LD.getPointerInfo(), NewLoadedVT, MaybeAlign { Alignment }, LD.getMemOperand().getFlags(), MMOMetadata { AAInfo: LD.getAAInfo(), Ranges: null, MemCacheHint: null });
        Ptr = DAG.getObjectPtrOffset(dl, Ptr, getFixed(IncrementSize));
        Lo = DAG.getExtLoad(ZEXTLOAD, dl, VT, Chain, Ptr, LD.getPointerInfo().getWithOffset(IncrementSize), NewLoadedVT, MaybeAlign { Alignment }, LD.getMemOperand().getFlags(), MMOMetadata { AAInfo: LD.getAAInfo(), Ranges: null, MemCacheHint: null });
    }
    let mut ShiftAmount: SDValue = DAG.getShiftAmountConstant(NumBits, VT, dl);
    let mut Result: SDValue = DAG.getNode(SHL, dl, VT, Hi, ShiftAmount);
    Result = DAG.getNode(OR, dl, VT, Result, Lo);
    let mut TF: SDValue = DAG.getNode(TokenFactor, dl, EVT { Other }, Lo.getValue(1), Hi.getValue(1));
    return make_pair(Result, TF);
}

fn TargetLowering::expandUnalignedStore(self: *TargetLowering, ST: *mut StoreSDNode, DAG: *mut SelectionDAG) -> SDValue {
    assert!(ST.getAddressingMode() == UNINDEXED, "unaligned indexed stores not implemented!");
    let mut Chain: SDValue = ST.getChain();
    let mut Ptr: SDValue = ST.getBasePtr();
    let mut Val: SDValue = ST.getValue();
    let mut VT: EVT = Val.getValueType();
    let mut Alignment: Align = ST.getBaseAlign();
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut StoreMemVT: EVT = ST.getMemoryVT();
    let mut dl: SDLoc = SDLoc { ST };
    if StoreMemVT.isFloatingPoint() || StoreMemVT.isVector() {
        let mut intVT: EVT = getIntegerVT(*DAG.getContext(), VT.getSizeInBits().operator unsigned long long());
        if self.isTypeLegal(intVT) {
            if !self.isOperationLegalOrCustom(STORE, intVT, false) && StoreMemVT.isVector() {
                let mut Result: SDValue = self.scalarizeVectorStore(ST, DAG);
                return Result;
            }
            let mut Result: SDValue = DAG.getNode(BITCAST, dl, intVT, Val);
            Result = DAG.getStore(Chain, dl, Result, Ptr, ST.getPointerInfo(), Alignment, ST.getMemOperand().getFlags(), MMOMetadata {});
            return Result;
        }
        let mut RegVT: MVT = self.getRegisterType(*DAG.getContext(), getIntegerVT(*DAG.getContext(), StoreMemVT.getSizeInBits().operator unsigned long long()));
        let mut PtrVT: EVT = Ptr.getValueType();
        let mut StoredBytes: u32 = StoreMemVT.getStoreSize().operator unsigned long long();
        let mut RegBytes: u32 = RegVT.getSizeInBits().operator unsigned long long() / 8;
        let mut NumRegs: u32 = (StoredBytes + RegBytes - 1) / RegBytes;
        let mut StackPtr: SDValue = DAG.CreateStackTemporary(StoreMemVT, EVT { RegVT });
        let mut FrameIndex: i32 = cast(StackPtr.getNode()).getIndex();
        let mut Store: SDValue = DAG.getTruncStore(Chain, dl, Val, StackPtr, getFixedStack(MF, FrameIndex, 0), StoreMemVT, MaybeAlign {}, MONone, MMOMetadata {});
        let mut StackPtrVT: EVT = StackPtr.getValueType();
        let mut PtrIncrement: SDValue = DAG.getConstant(RegBytes, dl, PtrVT, false, false);
        let mut StackPtrIncrement: SDValue = DAG.getConstant(RegBytes, dl, StackPtrVT, false, false);
        let mut Stores: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
        let mut Offset: u32 = 0;
        for let mut i: u32 = 1; i < NumRegs; i += 1 {
            let mut Load: SDValue = DAG.getLoad(EVT { RegVT }, dl, Store, StackPtr, getFixedStack(MF, FrameIndex, Offset), MaybeAlign {}, MONone, MMOMetadata {});
            Stores.push(DAG.getStore(Load.getValue(1), dl, Load, Ptr, ST.getPointerInfo().getWithOffset(Offset), ST.getBaseAlign(), ST.getMemOperand().getFlags(), MMOMetadata {}));
            Offset += RegBytes;
            StackPtr = DAG.getObjectPtrOffset(dl, StackPtr, StackPtrIncrement);
            Ptr = DAG.getObjectPtrOffset(dl, Ptr, PtrIncrement);
        }
        let mut LoadMemVT: EVT = getIntegerVT(*DAG.getContext(), 8 * (StoredBytes - Offset));
        let mut Load: SDValue = DAG.getExtLoad(EXTLOAD, dl, EVT { RegVT }, Store, StackPtr, getFixedStack(MF, FrameIndex, Offset), LoadMemVT, MaybeAlign {}, MONone, MMOMetadata {});
        Stores.push(DAG.getTruncStore(Load.getValue(1), dl, Load, Ptr, ST.getPointerInfo().getWithOffset(Offset), LoadMemVT, ST.getBaseAlign(), ST.getMemOperand().getFlags(), MMOMetadata { AAInfo: ST.getAAInfo(), Ranges: null, MemCacheHint: null }));
        let mut Result: SDValue = DAG.getNode(TokenFactor, dl, EVT { Other }, ArrayRef<SDValue> { Stores });
        return Result;
    }
    assert!(StoreMemVT.isInteger() && !StoreMemVT.isVector(), "Unaligned store of unknown type.");
    let mut NewStoredVT: EVT = StoreMemVT.getHalfSizedIntegerVT(*DAG.getContext());
    let mut NumBits: u32 = NewStoredVT.getFixedSizeInBits();
    let mut IncrementSize: u32 = NumBits / 8;
    let mut ShiftAmount: SDValue = DAG.getShiftAmountConstant(NumBits, Val.getValueType(), dl);
    let mut Lo: SDValue = Val;
    let mut C: *mut ConstantSDNode = dyn_cast(Lo);
    if C && !C.isOpaque() {
        Lo = DAG.getNode(AND, dl, VT, Lo, DAG.getConstant(getLowBitsSet(VT.getSizeInBits().operator unsigned long long(), NumBits), dl, VT, false, false));
    }
    let mut Hi: SDValue = DAG.getNode(SRL, dl, VT, Val, ShiftAmount);
    let mut Store1: SDValue = SDValue {};
    let mut Store2: SDValue = SDValue {};
    Store1 = DAG.getTruncStore(Chain, dl, if DAG.getDataLayout().isLittleEndian() { Lo } else { Hi }, Ptr, ST.getPointerInfo(), NewStoredVT, Alignment, ST.getMemOperand().getFlags(), MMOMetadata {});
    Ptr = DAG.getObjectPtrOffset(dl, Ptr, getFixed(IncrementSize));
    Store2 = DAG.getTruncStore(Chain, dl, if DAG.getDataLayout().isLittleEndian() { Hi } else { Lo }, Ptr, ST.getPointerInfo().getWithOffset(IncrementSize), NewStoredVT, Alignment, ST.getMemOperand().getFlags(), MMOMetadata { AAInfo: ST.getAAInfo(), Ranges: null, MemCacheHint: null });
    let mut Result: SDValue = DAG.getNode(TokenFactor, dl, EVT { Other }, Store1, Store2);
    return Result;
}

fn TargetLowering::IncrementMemoryAddress(self: *TargetLowering, Addr: SDValue, Mask: SDValue, DL: *SDLoc, DataVT: EVT, DAG: *mut SelectionDAG, IsCompressedMemory: bool) -> SDValue {
    let mut Increment: SDValue = SDValue {};
    let mut AddrVT: EVT = Addr.getValueType();
    let mut MaskVT: EVT = Mask.getValueType();
    assert!(DataVT.getVectorElementCount() == MaskVT.getVectorElementCount(), "Incompatible types of Data and Mask");
    if IsCompressedMemory {
        if DataVT.isScalableVector() {
            let mut MaskExtVT: EVT = MaskVT.changeElementType(*DAG.getContext(), EVT { i32 });
            let mut MaskExt: SDValue = DAG.getNode(ZERO_EXTEND, DL, MaskExtVT, Mask);
            Increment = DAG.getNode(VECREDUCE_ADD, DL, EVT { i32 }, MaskExt);
        } else {
            let mut MaskIntVT: EVT = getIntegerVT(*DAG.getContext(), MaskVT.getSizeInBits().operator unsigned long long());
            let mut MaskInIntReg: SDValue = DAG.getBitcast(MaskIntVT, Mask);
            if MaskIntVT.getSizeInBits().operator unsigned long long() < 32 {
                MaskInIntReg = DAG.getNode(ZERO_EXTEND, DL, EVT { i32 }, MaskInIntReg);
                MaskIntVT = EVT { i32 };
            }
            Increment = DAG.getNode(CTPOP, DL, MaskIntVT, MaskInIntReg);
        }
        let mut Scale: SDValue = DAG.getConstant(DataVT.getScalarSizeInBits() / 8, DL, AddrVT, false, false);
        Increment = DAG.getZExtOrTrunc(Increment, DL, AddrVT);
        Increment = DAG.getNode(MUL, DL, AddrVT, Increment, Scale);
    } else {
        Increment = DAG.getTypeSize(DL, AddrVT, DataVT.getStoreSize());
    }
    return DAG.getNode(ADD, DL, AddrVT, Addr, Increment);
}

fn clampDynamicVectorIndex(DAG: *mut SelectionDAG, Idx: SDValue, VecVT: EVT, dl: *SDLoc, SubEC: ElementCount) -> SDValue {
    assert!(!(SubEC.isScalable() && VecVT.isFixedLengthVector()), "Cannot index a scalable vector within a fixed-width vector");
    let mut NElts: u32 = VecVT.getVectorMinNumElements();
    let mut NumSubElts: u32 = SubEC.getKnownMinValue();
    let mut IdxVT: EVT = Idx.getValueType();
    if VecVT.isScalableVector() && !SubEC.isScalable() {
        if dyn_cast(Idx) {
            IdxCst;
        } else if IdxCst.getZExtValue() + (NumSubElts - 1) < NElts {
            return Idx;
        }
        let mut VS: SDValue = DAG.getVScale(dl, IdxVT, APInt { IdxVT.getFixedSizeInBits(), NElts, false, false });
        let mut SubOpcode: u32 = if NumSubElts <= NElts { SUB } else { USUBSAT };
        let mut Sub: SDValue = DAG.getNode(SubOpcode, dl, IdxVT, VS, DAG.getConstant(NumSubElts, dl, IdxVT, false, false));
        return DAG.getNode(UMIN, dl, IdxVT, Idx, Sub);
    }
    if isPowerOf2_32(NElts) && NumSubElts == 1 {
        let mut Imm: APInt = getLowBitsSet(IdxVT.getSizeInBits().operator unsigned long long(), Log2_32(NElts));
        return DAG.getNode(AND, dl, IdxVT, Idx, DAG.getConstant(Imm, dl, IdxVT, false, false));
    }
    let mut MaxIndex: u32 = if NumSubElts < NElts { NElts - NumSubElts } else { 0 };
    return DAG.getNode(UMIN, dl, IdxVT, Idx, DAG.getConstant(MaxIndex, dl, IdxVT, false, false));
}

fn TargetLowering::getVectorElementPointer(self: *TargetLowering, DAG: *mut SelectionDAG, VecPtr: SDValue, VecVT: EVT, Index: SDValue, PtrArithFlags: SDNodeFlags) -> SDValue {
    return self.getVectorSubVecPointer(DAG, VecPtr, VecVT, getVectorVT(*DAG.getContext(), VecVT.getVectorElementType(), 1, false), Index, PtrArithFlags);
}

fn TargetLowering::getVectorSubVecPointer(self: *TargetLowering, DAG: *mut SelectionDAG, VecPtr: SDValue, VecVT: EVT, SubVecVT: EVT, Index: SDValue, PtrArithFlags: SDNodeFlags) -> SDValue {
    let mut dl: SDLoc = SDLoc { Index };
    Index = DAG.getZExtOrTrunc(Index, dl, VecPtr.getValueType());
    let mut EltVT: EVT = VecVT.getVectorElementType();
    let mut EltSize: u32 = EltVT.getFixedSizeInBits() / 8;
    assert!(EltSize * 8 == EltVT.getFixedSizeInBits(), "Converting bits to bytes lost precision");
    assert!(SubVecVT.getVectorElementType() == EltVT, "Sub-vector must be a vector with matching element type");
    Index = clampDynamicVectorIndex(DAG, Index, VecVT, dl, SubVecVT.getVectorElementCount());
    let mut IdxVT: EVT = Index.getValueType();
    if SubVecVT.isScalableVector() {
        Index = DAG.getNode(MUL, dl, IdxVT, Index, DAG.getVScale(dl, IdxVT, APInt { IdxVT.getSizeInBits().operator unsigned long long(), 1, false, false }));
    }
    Index = DAG.getNode(MUL, dl, IdxVT, Index, DAG.getConstant(EltSize, dl, IdxVT, false, false));
    return DAG.getMemBasePlusOffset(VecPtr, Index, dl, PtrArithFlags);
}

fn TargetLowering::LowerToTLSEmulatedModel(self: *TargetLowering, GA: *GlobalAddressSDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut PtrVT: EVT = EVT { self.getPointerTy(DAG.getDataLayout(), 0) };
    let mut VoidPtrType: *mut PointerType = get(*DAG.getContext(), 0);
    let mut dl: SDLoc = SDLoc { GA };
    let mut Args: ArgListTy = ArgListTy {};
    let mut GV: *GlobalValue = cast(GA.getGlobal().stripPointerCastsAndAliases());
    let mut NameString: str = "__emutls_v.";
    operator(NameString, GV.getName());
    let mut EmuTlsVarName: str = NameString.operator StringRef();
    let mut EmuTlsVar: *GlobalVariable = GV.getParent().getNamedGlobal(EmuTlsVarName);
    assert!(EmuTlsVar, "Cannot find EmuTlsVar ");
    Args.emplace_back(DAG.getGlobalAddress(EmuTlsVar, dl, PtrVT, 0, false, 0), VoidPtrType);
    let mut EmuTlsGetAddr: SDValue = DAG.getExternalSymbol("__emutls_get_address", PtrVT);
    let mut CLI: CallLoweringInfo = CallLoweringInfo { DAG };
    CLI.setDebugLoc(dl).setChain(DAG.getEntryNode());
    CLI.setLibCallee(C, VoidPtrType, EmuTlsGetAddr, move(Args));
    let mut CallResult: pair<SDValue, SDValue> = self.LowerCallTo(CLI);
    let mut MFI: *mut MachineFrameInfo = DAG.getMachineFunction().getFrameInfo();
    MFI.setAdjustsStack(true);
    MFI.setHasCalls(true);
    assert!((GA.getOffset() == 0), "Emulated TLS must have zero offset in GlobalAddressSDNode");
    return CallResult.first;
}

fn TargetLowering::lowerCmpEqZeroToCtlzSrl(self: *TargetLowering, Op: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    assert!((operator(Op).getOpcode() == SETCC), "Input has to be a SETCC node.");
    if !self.isCtlzFast() {
        return SDValue {};
    }
    let mut CC: CondCode = cast(Op.getOperand(2)).get();
    let mut dl: SDLoc = SDLoc { Op };
    if isNullConstant(Op.getOperand(1)) && CC == SETEQ {
        let mut VT: EVT = Op.getOperand(0).getValueType();
        let mut Zext: SDValue = Op.getOperand(0);
        if VT.bitsLT(EVT { i32 }) {
            VT = EVT { i32 };
            Zext = DAG.getNode(ZERO_EXTEND, dl, VT, Op.getOperand(0));
        }
        let mut Log2b: u32 = Log2_32(VT.getSizeInBits().operator unsigned long long());
        let mut Clz: SDValue = DAG.getNode(CTLZ, dl, VT, Zext);
        let mut Scc: SDValue = DAG.getNode(SRL, dl, VT, Clz, DAG.getConstant(Log2b, dl, EVT { i32 }, false, false));
        return DAG.getNode(TRUNCATE, dl, EVT { i32 }, Scc);
    }
    return SDValue {};
}

fn TargetLowering::expandIntMINMAX(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut Op0: SDValue = Node.getOperand(0);
    let mut Op1: SDValue = Node.getOperand(1);
    let mut VT: EVT = Op0.getValueType();
    let mut BoolVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT);
    let mut Opcode: u32 = Node.getOpcode();
    let mut DL: SDLoc = SDLoc { Node };
    let mut AltOpcode: u32 = getOppositeSignednessMinMaxOpcode(Opcode);
    if self.isOperationLegal(AltOpcode, VT) && DAG.SignBitIsZero(Op0, 0) && DAG.SignBitIsZero(Op1, 0) {
        return DAG.getNode(AltOpcode, DL, VT, Op0, Op1);
    }
    if Opcode == UMAX && isOneOrOneSplat(Op1, true) && BoolVT == VT && self.getBooleanContents(VT) == ZeroOrNegativeOneBooleanContent {
        Op0 = DAG.getFreeze(Op0);
        let mut Zero: SDValue = DAG.getConstant(0, DL, VT, false, false);
        return DAG.getNode(SUB, DL, VT, Op0, DAG.getSetCC(DL, VT, Op0, Zero, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None }));
    }
    if Opcode == UMIN && self.isOperationLegal(SUB, VT) && self.isOperationLegal(USUBSAT, VT) {
        return DAG.getNode(SUB, DL, VT, Op0, DAG.getNode(USUBSAT, DL, VT, Op0, Op1));
    }
    if Opcode == UMAX && self.isOperationLegal(ADD, VT) && self.isOperationLegal(USUBSAT, VT) {
        return DAG.getNode(ADD, DL, VT, Op0, DAG.getNode(USUBSAT, DL, VT, Op1, Op0));
    }
    if VT.isVector() && !self.isOperationLegalOrCustom(VSELECT, VT, false) {
        return DAG.UnrollVectorOp(Node, 0);
    }
    let mut buildMinMax: Closure_39 = Closure_39 { DAG: &mut DAG, BoolVT: &mut BoolVT, Op0: &mut Op0, Op1: &mut Op1, DL: &mut DL, VT: &mut VT };
    match Opcode {
        SMAX => {
            return buildMinMax.call(SETGT, SETGE, SETLT, SETLE);
        },
        SMIN => {
            return buildMinMax.call(SETLT, SETLE, SETGT, SETGE);
        },
        UMAX => {
            return buildMinMax.call(SETUGT, SETUGE, SETULT, SETULE);
        },
        UMIN => {
            return buildMinMax.call(SETULT, SETULE, SETUGT, SETUGE);
        },
    }
    llvm_unreachable_internal("How did we get here?", "llvm\\lib\\CodeGen\\SelectionDAG\\TargetLowering.cpp", 12539);
}

fn TargetLowering::expandAddSubSat(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut Opcode: u32 = Node.getOpcode();
    let mut LHS: SDValue = Node.getOperand(0);
    let mut RHS: SDValue = Node.getOperand(1);
    let mut VT: EVT = LHS.getValueType();
    let mut dl: SDLoc = SDLoc { Node };
    assert!(VT == RHS.getValueType(), "Expected operands to be the same type");
    assert!(VT.isInteger(), "Expected operands to be integers");
    if Opcode == USUBSAT && self.isOperationLegal(UMAX, VT) {
        let mut Max: SDValue = DAG.getNode(UMAX, dl, VT, LHS, RHS);
        return DAG.getNode(SUB, dl, VT, Max, RHS);
    }
    if Opcode == USUBSAT && isOneOrOneSplat(RHS, false) && !self.isOperationLegalOrCustom(USUBO_CARRY, VT, false) {
        LHS = DAG.getFreeze(LHS);
        let mut Zero: SDValue = DAG.getConstant(0, dl, VT, false, false);
        let mut BoolVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT);
        let mut IsNonZero: SDValue = DAG.getSetCC(dl, BoolVT, LHS, Zero, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut Subtrahend: SDValue = DAG.getBoolExtOrTrunc(IsNonZero, dl, VT, BoolVT);
        Subtrahend = DAG.getNode(AND, dl, VT, Subtrahend, DAG.getConstant(1, dl, VT, false, false));
        return DAG.getNode(SUB, dl, VT, LHS, Subtrahend);
    }
    if Opcode == UADDSAT && self.isOperationLegal(UMIN, VT) {
        let mut InvRHS: SDValue = DAG.getNOT(dl, RHS, VT);
        let mut Min: SDValue = DAG.getNode(UMIN, dl, VT, LHS, InvRHS);
        return DAG.getNode(ADD, dl, VT, Min, RHS);
    }
    let mut OverflowOp: u32 = 0;
    match Opcode {
        SADDSAT => {
            OverflowOp = SADDO;
        },
        UADDSAT => {
            OverflowOp = UADDO;
        },
        SSUBSAT => {
            OverflowOp = SSUBO;
        },
        USUBSAT => {
            OverflowOp = USUBO;
        },
        _ => {
            llvm_unreachable_internal("Expected method to receive signed or unsigned saturation addition or subtraction node.", "llvm\\lib\\CodeGen\\SelectionDAG\\TargetLowering.cpp", 12595);
        },
    }
    if VT.isVector() && !self.isOperationLegalOrCustom(VSELECT, VT, false) {
        return DAG.UnrollVectorOp(Node, 0);
    }
    let mut BitWidth: u32 = LHS.getScalarValueSizeInBits();
    let mut BoolVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT);
    let mut Result: SDValue = DAG.getNode(OverflowOp, dl, DAG.getVTList(VT, BoolVT), LHS, RHS);
    let mut SumDiff: SDValue = Result.getValue(0);
    let mut Overflow: SDValue = Result.getValue(1);
    let mut Zero: SDValue = DAG.getConstant(0, dl, VT, false, false);
    let mut AllOnes: SDValue = DAG.getAllOnesConstant(dl, VT, false, false);
    if Opcode == UADDSAT {
        if self.getBooleanContents(VT) == ZeroOrNegativeOneBooleanContent {
            let mut OverflowMask: SDValue = DAG.getSExtOrTrunc(Overflow, dl, VT);
            return DAG.getNode(OR, dl, VT, SumDiff, OverflowMask);
        }
        return DAG.getSelect(dl, VT, Overflow, AllOnes, SumDiff, SDNodeFlags { Flags: None });
    }
    if Opcode == USUBSAT {
        if self.getBooleanContents(VT) == ZeroOrNegativeOneBooleanContent {
            let mut OverflowMask: SDValue = DAG.getSExtOrTrunc(Overflow, dl, VT);
            let mut Not: SDValue = DAG.getNOT(dl, OverflowMask, VT);
            return DAG.getNode(AND, dl, VT, SumDiff, Not);
        }
        return DAG.getSelect(dl, VT, Overflow, Zero, SumDiff, SDNodeFlags { Flags: None });
    }
    assert!((Opcode == SADDSAT || Opcode == SSUBSAT), "Expected signed saturating add/sub opcode");
    let mut MinVal: APInt = getSignedMinValue(BitWidth);
    let mut MaxVal: APInt = getSignedMaxValue(BitWidth);
    let mut KnownLHS: KnownBits = DAG.computeKnownBits(LHS, 0);
    let mut KnownRHS: KnownBits = DAG.computeKnownBits(RHS, 0);
    let mut LHSIsNonNegative: bool = KnownLHS.isNonNegative();
    let mut RHSIsNonNegative: bool = if Opcode == SADDSAT { KnownRHS.isNonNegative() } else { KnownRHS.isNegative() };
    if LHSIsNonNegative || RHSIsNonNegative {
        let mut SatMax: SDValue = DAG.getConstant(MaxVal, dl, VT, false, false);
        return DAG.getSelect(dl, VT, Overflow, SatMax, SumDiff, SDNodeFlags { Flags: None });
    }
    let mut LHSIsNegative: bool = KnownLHS.isNegative();
    let mut RHSIsNegative: bool = if Opcode == SADDSAT { KnownRHS.isNegative() } else { KnownRHS.isNonNegative() };
    if LHSIsNegative || RHSIsNegative {
        let mut SatMin: SDValue = DAG.getConstant(MinVal, dl, VT, false, false);
        return DAG.getSelect(dl, VT, Overflow, SatMin, SumDiff, SDNodeFlags { Flags: None });
    }
    let mut SatMin: SDValue = DAG.getConstant(MinVal, dl, VT, false, false);
    let mut Shift: SDValue = DAG.getNode(SRA, dl, VT, SumDiff, DAG.getConstant(BitWidth - 1, dl, VT, false, false));
    Result = DAG.getNode(XOR, dl, VT, Shift, SatMin);
    return DAG.getSelect(dl, VT, Overflow, Result, SumDiff, SDNodeFlags { Flags: None });
}

fn TargetLowering::expandCMP(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut Opcode: u32 = Node.getOpcode();
    let mut LHS: SDValue = Node.getOperand(0);
    let mut RHS: SDValue = Node.getOperand(1);
    let mut VT: EVT = LHS.getValueType();
    let mut ResVT: EVT = Node.getValueType(0);
    let mut BoolVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT);
    let mut dl: SDLoc = SDLoc { Node };
    let mut LTPredicate: CondCode = (if Opcode == UCMP { SETULT } else { SETLT });
    let mut GTPredicate: CondCode = (if Opcode == UCMP { SETUGT } else { SETGT });
    let mut IsLT: SDValue = DAG.getSetCC(dl, BoolVT, LHS, RHS, LTPredicate, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut IsGT: SDValue = DAG.getSetCC(dl, BoolVT, LHS, RHS, GTPredicate, SDValue {}, false, SDNodeFlags { Flags: None });
    if self.preferSelectsOverBooleanArithmetic(VT) || BoolVT.getScalarSizeInBits() == 1 || self.getBooleanContents(BoolVT) == UndefinedBooleanContent {
        let mut SelectZeroOrOne: SDValue = DAG.getSelect(dl, ResVT, IsGT, DAG.getConstant(1, dl, ResVT, false, false), DAG.getConstant(0, dl, ResVT, false, false), SDNodeFlags { Flags: None });
        return DAG.getSelect(dl, ResVT, IsLT, DAG.getAllOnesConstant(dl, ResVT, false, false), SelectZeroOrOne, SDNodeFlags { Flags: None });
    }
    if self.getBooleanContents(BoolVT) == ZeroOrNegativeOneBooleanContent {
        swap(IsGT, IsLT);
    }
    return DAG.getSExtOrTrunc(DAG.getNode(SUB, dl, BoolVT, IsGT, IsLT), dl, ResVT);
}

fn TargetLowering::expandShlSat(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut Opcode: u32 = Node.getOpcode();
    let mut IsSigned: bool = Opcode == SSHLSAT;
    let mut LHS: SDValue = Node.getOperand(0);
    let mut RHS: SDValue = Node.getOperand(1);
    let mut VT: EVT = LHS.getValueType();
    let mut dl: SDLoc = SDLoc { Node };
    assert!((Node.getOpcode() == SSHLSAT || Node.getOpcode() == USHLSAT), "Expected a SHLSAT opcode");
    assert!(VT.isInteger(), "Expected operands to be integers");
    if VT.isVector() && !self.isOperationLegalOrCustom(VSELECT, VT, false) {
        return DAG.UnrollVectorOp(Node, 0);
    }
    let mut BW: u32 = VT.getScalarSizeInBits();
    let mut BoolVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT);
    let mut Result: SDValue = DAG.getNode(SHL, dl, VT, LHS, RHS);
    let mut Orig: SDValue = DAG.getNode(if IsSigned { SRA } else { SRL }, dl, VT, Result, RHS);
    let mut SatVal: SDValue = SDValue {};
    if IsSigned {
        let mut SatMin: SDValue = DAG.getConstant(getSignedMinValue(BW), dl, VT, false, false);
        let mut SatMax: SDValue = DAG.getConstant(getSignedMaxValue(BW), dl, VT, false, false);
        let mut Cond: SDValue = DAG.getSetCC(dl, BoolVT, LHS, DAG.getConstant(0, dl, VT, false, false), SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
        SatVal = DAG.getSelect(dl, VT, Cond, SatMin, SatMax, SDNodeFlags { Flags: None });
    } else {
        SatVal = DAG.getConstant(getMaxValue(BW), dl, VT, false, false);
    }
    let mut Cond: SDValue = DAG.getSetCC(dl, BoolVT, LHS, Orig, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
    return DAG.getSelect(dl, VT, Cond, SatVal, Result, SDNodeFlags { Flags: None });
}

fn TargetLowering::forceExpandMultiply(self: *TargetLowering, DAG: *mut SelectionDAG, dl: *SDLoc, Signed: bool, Lo: *mut SDValue, Hi: *mut SDValue, LHS: SDValue, RHS: SDValue, HiLHS: SDValue, HiRHS: SDValue) {
    let mut VT: EVT = LHS.getValueType();
    assert!(RHS.getValueType() == VT, "Mismatching operand types");
    assert!((HiLHS && HiRHS) || (!HiLHS && !HiRHS));
    assert!((!Signed || !HiLHS), "Signed flag should only be set when HiLHS and RiRHS are null");
    let mut Bits: u32 = VT.getScalarSizeInBits();
    let mut HalfBits: u32 = Bits / 2;
    let mut Mask: SDValue = DAG.getConstant(getLowBitsSet(Bits, HalfBits), dl, VT, false, false);
    let mut LL: SDValue = DAG.getNode(AND, dl, VT, LHS, Mask);
    let mut RL: SDValue = DAG.getNode(AND, dl, VT, RHS, Mask);
    let mut T: SDValue = DAG.getNode(MUL, dl, VT, LL, RL);
    let mut TL: SDValue = DAG.getNode(AND, dl, VT, T, Mask);
    let mut Shift: SDValue = DAG.getShiftAmountConstant(HalfBits, VT, dl);
    let mut TH: SDValue = DAG.getNode(SRL, dl, VT, T, Shift);
    let mut ShiftOpc: u32 = if Signed { SRA } else { SRL };
    let mut LH: SDValue = DAG.getNode(ShiftOpc, dl, VT, LHS, Shift);
    let mut RH: SDValue = DAG.getNode(ShiftOpc, dl, VT, RHS, Shift);
    let mut U: SDValue = DAG.getNode(ADD, dl, VT, DAG.getNode(MUL, dl, VT, LH, RL), TH);
    let mut UL: SDValue = DAG.getNode(AND, dl, VT, U, Mask);
    let mut UH: SDValue = DAG.getNode(ShiftOpc, dl, VT, U, Shift);
    let mut V: SDValue = DAG.getNode(ADD, dl, VT, DAG.getNode(MUL, dl, VT, LL, RH), UL);
    let mut VH: SDValue = DAG.getNode(ShiftOpc, dl, VT, V, Shift);
    Lo = DAG.getNode(ADD, dl, VT, TL, DAG.getNode(SHL, dl, VT, V, Shift));
    Hi = DAG.getNode(ADD, dl, VT, DAG.getNode(MUL, dl, VT, LH, RH), DAG.getNode(ADD, dl, VT, UH, VH));
    if HiLHS {
        let mut RHLL: SDValue = DAG.getNode(MUL, dl, VT, HiRHS, LHS);
        let mut RLLH: SDValue = DAG.getNode(MUL, dl, VT, RHS, HiLHS);
        Hi = DAG.getNode(ADD, dl, VT, Hi, DAG.getNode(ADD, dl, VT, RHLL, RLLH));
    }
}

fn TargetLowering::forceExpandWideMUL(self: *TargetLowering, DAG: *mut SelectionDAG, dl: *SDLoc, Signed: bool, LHS: SDValue, RHS: SDValue, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut VT: EVT = LHS.getValueType();
    assert!(RHS.getValueType() == VT, "Mismatching operand types");
    let mut WideVT: EVT = VT.widenIntegerElementType(*DAG.getContext());
    let mut LC: Libcall = UNKNOWN_LIBCALL;
    if WideVT == EVT { i16 } {
        LC = MUL_I16;
    } else if WideVT == EVT { i32 } {
        LC = MUL_I32;
    } else if WideVT == EVT { i64 } {
        LC = MUL_I64;
    } else if WideVT == EVT { i128 } {
        LC = MUL_I128;
    }
    let mut LibcallImpl: LibcallImpl = self.getLibcallImpl(LC);
    if LibcallImpl == Unsupported {
        self.forceExpandMultiply(DAG, dl, Signed, Lo, Hi, LHS, RHS, SDValue {}, SDValue {});
        return;
    }
    let mut HiLHS: SDValue = SDValue {};
    let mut HiRHS: SDValue = SDValue {};
    if Signed {
        let mut LoSize: u32 = VT.getFixedSizeInBits();
        let mut Shift: SDValue = DAG.getShiftAmountConstant(LoSize - 1, VT, dl);
        HiLHS = DAG.getNode(SRA, dl, VT, LHS, Shift);
        HiRHS = DAG.getNode(SRA, dl, VT, RHS, Shift);
    } else {
        HiLHS = DAG.getConstant(0, dl, VT, false, false);
        HiRHS = DAG.getConstant(0, dl, VT, false, false);
    }
    let mut Ret: SDValue = SDValue {};
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    CallOptions.setIsSigned(Signed);
    CallOptions.setIsPostTypeLegalization(true);
    if self.shouldSplitFunctionArgumentsAsLittleEndian(DAG.getDataLayout()) {
        let mut Args: [4]SDValue = [LHS, HiLHS, RHS, HiRHS];
        Ret = self.makeLibCall(DAG, LC, WideVT, ArrayRef<SDValue> { Args }, CallOptions, dl, SDValue {}).first;
    } else {
        let mut Args: [4]SDValue = [HiLHS, LHS, HiRHS, RHS];
        Ret = self.makeLibCall(DAG, LC, WideVT, ArrayRef<SDValue> { Args }, CallOptions, dl, SDValue {}).first;
    }
    assert!(Ret.getOpcode() == MERGE_VALUES, "Ret value is a collection of constituent nodes holding result.");
    if DAG.getDataLayout().isLittleEndian() {
        Lo = Ret.getOperand(0);
        Hi = Ret.getOperand(1);
    } else {
        Lo = Ret.getOperand(1);
        Hi = Ret.getOperand(0);
    }
}

fn TargetLowering::expandFixedPointMul(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    assert!((Node.getOpcode() == SMULFIX || Node.getOpcode() == UMULFIX || Node.getOpcode() == SMULFIXSAT || Node.getOpcode() == UMULFIXSAT), "Expected a fixed point multiplication opcode");
    let mut dl: SDLoc = SDLoc { Node };
    let mut LHS: SDValue = Node.getOperand(0);
    let mut RHS: SDValue = Node.getOperand(1);
    let mut VT: EVT = LHS.getValueType();
    let mut Scale: u32 = Node.getConstantOperandVal(2);
    let mut Saturating: bool = (Node.getOpcode() == SMULFIXSAT || Node.getOpcode() == UMULFIXSAT);
    let mut Signed: bool = (Node.getOpcode() == SMULFIX || Node.getOpcode() == SMULFIXSAT);
    let mut BoolVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT);
    let mut VTSize: u32 = VT.getScalarSizeInBits();
    if !Scale {
        if !Saturating {
            if self.isOperationLegalOrCustom(MUL, VT, false) {
                return DAG.getNode(MUL, dl, VT, LHS, RHS);
            }
        } else if Signed && self.isOperationLegalOrCustom(SMULO, VT, false) {
            let mut Result: SDValue = DAG.getNode(SMULO, dl, DAG.getVTList(VT, BoolVT), LHS, RHS);
            let mut Product: SDValue = Result.getValue(0);
            let mut Overflow: SDValue = Result.getValue(1);
            let mut Zero: SDValue = DAG.getConstant(0, dl, VT, false, false);
            let mut MinVal: APInt = getSignedMinValue(VTSize);
            let mut MaxVal: APInt = getSignedMaxValue(VTSize);
            let mut SatMin: SDValue = DAG.getConstant(MinVal, dl, VT, false, false);
            let mut SatMax: SDValue = DAG.getConstant(MaxVal, dl, VT, false, false);
            let mut Xor: SDValue = DAG.getNode(XOR, dl, VT, LHS, RHS);
            let mut ProdNeg: SDValue = DAG.getSetCC(dl, BoolVT, Xor, Zero, SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
            Result = DAG.getSelect(dl, VT, ProdNeg, SatMin, SatMax, SDNodeFlags { Flags: None });
            return DAG.getSelect(dl, VT, Overflow, Result, Product, SDNodeFlags { Flags: None });
        } else if !Signed && self.isOperationLegalOrCustom(UMULO, VT, false) {
            let mut Result: SDValue = DAG.getNode(UMULO, dl, DAG.getVTList(VT, BoolVT), LHS, RHS);
            let mut Product: SDValue = Result.getValue(0);
            let mut Overflow: SDValue = Result.getValue(1);
            let mut MaxVal: APInt = getMaxValue(VTSize);
            let mut SatMax: SDValue = DAG.getConstant(MaxVal, dl, VT, false, false);
            return DAG.getSelect(dl, VT, Overflow, SatMax, Product, SDNodeFlags { Flags: None });
        }
    }
    assert!(((Signed && Scale < VTSize) || (!Signed && Scale <= VTSize)), "Expected scale to be less than the number of bits if signed or at most the number of bits if unsigned.");
    assert!(LHS.getValueType() == RHS.getValueType(), "Expected both operands to be the same type");
    let mut getSaturatingSelect: Closure_40 = Closure_40 { VT: &mut VT, DAG: &mut DAG, dl: &mut dl, BoolVT: &mut BoolVT };
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    let mut LoHiOp: u32 = if Signed { SMUL_LOHI } else { UMUL_LOHI };
    let mut HiOp: u32 = if Signed { MULHS } else { MULHU };
    let mut WideVT: EVT = VT.widenIntegerElementType(*DAG.getContext());
    if self.isOperationLegalOrCustom(LoHiOp, VT, false) {
        let mut Result: SDValue = DAG.getNode(LoHiOp, dl, DAG.getVTList(VT, VT), LHS, RHS);
        Lo = Result.getValue(0);
        Hi = Result.getValue(1);
    } else if self.isOperationLegalOrCustom(HiOp, VT, false) {
        Lo = DAG.getNode(MUL, dl, VT, LHS, RHS);
        Hi = DAG.getNode(HiOp, dl, VT, LHS, RHS);
    } else if self.isOperationLegalOrCustom(MUL, WideVT, false) {
        let mut Ext: u32 = if Signed { SIGN_EXTEND } else { ZERO_EXTEND };
        let mut LHSExt: SDValue = DAG.getNode(Ext, dl, WideVT, LHS);
        let mut RHSExt: SDValue = DAG.getNode(Ext, dl, WideVT, RHS);
        let mut Res: SDValue = DAG.getNode(MUL, dl, WideVT, LHSExt, RHSExt);
        Lo = DAG.getNode(TRUNCATE, dl, VT, Res);
        let mut Shifted: SDValue = DAG.getNode(SRA, dl, WideVT, Res, DAG.getShiftAmountConstant(VTSize, WideVT, dl));
        Hi = DAG.getNode(TRUNCATE, dl, VT, Shifted);
    } else if VT.isVector() {
        return SDValue {};
    } else {
        self.forceExpandWideMUL(DAG, dl, Signed, LHS, RHS, Lo, Hi);
    }
    if Scale == VTSize {
        return Hi;
    }
    let mut Result: SDValue = DAG.getNode(FSHR, dl, VT, Hi, Lo, DAG.getShiftAmountConstant(Scale, VT, dl));
    if !Saturating {
        return Result;
    }
    if !Signed {
        let mut MaxVal: APInt = getMaxValue(VTSize);
        let mut LowMask: SDValue = DAG.getConstant(getLowBitsSet(VTSize, Scale), dl, VT, false, false);
        return getSaturatingSelect.call(Hi, LowMask, DAG.getConstant(MaxVal, dl, VT, false, false), Result, SETUGT);
    }
    let mut SatMin: SDValue = DAG.getConstant(getSignedMinValue(VTSize), dl, VT, false, false);
    let mut SatMax: SDValue = DAG.getConstant(getSignedMaxValue(VTSize), dl, VT, false, false);
    if Scale == 0 {
        let mut Sign: SDValue = DAG.getNode(SRA, dl, VT, Lo, DAG.getShiftAmountConstant(VTSize - 1, VT, dl));
        let mut Overflow: SDValue = DAG.getSetCC(dl, BoolVT, Hi, Sign, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut Zero: SDValue = DAG.getConstant(0, dl, VT, false, false);
        let mut ResultIfOverflow: SDValue = getSaturatingSelect.call(Hi, Zero, SatMin, SatMax, SETLT);
        return DAG.getSelect(dl, VT, Overflow, ResultIfOverflow, Result, SDNodeFlags { Flags: None });
    }
    let mut LowMask: SDValue = DAG.getConstant(getLowBitsSet(VTSize, Scale - 1), dl, VT, false, false);
    let mut HighMask: SDValue = DAG.getConstant(getHighBitsSet(VTSize, VTSize - Scale + 1), dl, VT, false, false);
    Result = getSaturatingSelect.call(Hi, LowMask, SatMax, Result, SETGT);
    Result = getSaturatingSelect.call(Hi, HighMask, SatMin, Result, SETLT);
    return Result;
}

fn TargetLowering::expandFixedPointDiv(self: *TargetLowering, Opcode: u32, dl: *SDLoc, LHS: SDValue, RHS: SDValue, Scale: u32, DAG: *mut SelectionDAG) -> SDValue {
    assert!((Opcode == SDIVFIX || Opcode == SDIVFIXSAT || Opcode == UDIVFIX || Opcode == UDIVFIXSAT), "Expected a fixed point division opcode");
    let mut VT: EVT = LHS.getValueType();
    let mut Signed: bool = Opcode == SDIVFIX || Opcode == SDIVFIXSAT;
    let mut Saturating: bool = Opcode == SDIVFIXSAT || Opcode == UDIVFIXSAT;
    let mut BoolVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT);
    let mut LHSLead: u32 = if Signed { DAG.ComputeNumSignBits(LHS, 0) - 1 } else { DAG.computeKnownBits(LHS, 0).countMinLeadingZeros() };
    let mut RHSTrail: u32 = DAG.computeKnownBits(RHS, 0).countMinTrailingZeros();
    if LHSLead + RHSTrail < Scale + (Saturating && Signed) as u32 {
        return SDValue {};
    }
    let mut LHSShift: u32 = if LHSLead < Scale { LHSLead } else { Scale };
    let mut RHSShift: u32 = Scale - LHSShift;
    if LHSShift {
        LHS = DAG.getNode(SHL, dl, VT, LHS, DAG.getShiftAmountConstant(LHSShift, VT, dl));
    }
    if RHSShift {
        RHS = DAG.getNode(if Signed { SRA } else { SRL }, dl, VT, RHS, DAG.getShiftAmountConstant(RHSShift, VT, dl));
    }
    let mut Quot: SDValue = SDValue {};
    if Signed {
        let mut Rem: SDValue = SDValue {};
        if self.isTypeLegal(VT) && self.isOperationLegalOrCustom(SDIVREM, VT, false) {
            Quot = DAG.getNode(SDIVREM, dl, DAG.getVTList(VT, VT), LHS, RHS);
            Rem = Quot.getValue(1);
            Quot = Quot.getValue(0);
        } else {
            Quot = DAG.getNode(SDIV, dl, VT, LHS, RHS);
            Rem = DAG.getNode(SREM, dl, VT, LHS, RHS);
        }
        let mut Zero: SDValue = DAG.getConstant(0, dl, VT, false, false);
        let mut RemNonZero: SDValue = DAG.getSetCC(dl, BoolVT, Rem, Zero, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut LHSNeg: SDValue = DAG.getSetCC(dl, BoolVT, LHS, Zero, SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut RHSNeg: SDValue = DAG.getSetCC(dl, BoolVT, RHS, Zero, SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut QuotNeg: SDValue = DAG.getNode(XOR, dl, BoolVT, LHSNeg, RHSNeg);
        let mut Sub1: SDValue = DAG.getNode(SUB, dl, VT, Quot, DAG.getConstant(1, dl, VT, false, false));
        Quot = DAG.getSelect(dl, VT, DAG.getNode(AND, dl, BoolVT, RemNonZero, QuotNeg), Sub1, Quot, SDNodeFlags { Flags: None });
    } else {
        Quot = DAG.getNode(UDIV, dl, VT, LHS, RHS);
    }
    return Quot;
}

fn TargetLowering::expandUADDSUBO(self: *TargetLowering, Node: *mut SDNode, Result: *mut SDValue, Overflow: *mut SDValue, DAG: *mut SelectionDAG) {
    let mut dl: SDLoc = SDLoc { Node };
    let mut LHS: SDValue = Node.getOperand(0);
    let mut RHS: SDValue = Node.getOperand(1);
    let mut IsAdd: bool = Node.getOpcode() == UADDO;
    let mut OpcCarry: u32 = if IsAdd { UADDO_CARRY } else { USUBO_CARRY };
    if self.isOperationLegalOrCustom(OpcCarry, Node.getValueType(0), false) {
        let mut CarryIn: SDValue = DAG.getConstant(0, dl, Node.getValueType(1), false, false);
        let mut NodeCarry: SDValue = DAG.getNode(OpcCarry, dl, Node.getVTList(), ArrayRef<SDValue> { [LHS, RHS, CarryIn] });
        Result = SDValue { Node: NodeCarry.getNode(), ResNo: 0 };
        Overflow = SDValue { Node: NodeCarry.getNode(), ResNo: 1 };
        return;
    }
    Result = DAG.getNode(if IsAdd { ADD } else { SUB }, dl, LHS.getValueType(), LHS, RHS);
    let mut ResultType: EVT = Node.getValueType(1);
    let mut SetCCType: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), Node.getValueType(0));
    let mut SetCC: SDValue = SDValue {};
    if IsAdd && isOneConstant(RHS) {
        SetCC = DAG.getSetCC(dl, SetCCType, Result, DAG.getConstant(0, dl, Node.getValueType(0), false, false), SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
    } else if IsAdd && isAllOnesConstant(RHS) {
        SetCC = DAG.getSetCC(dl, SetCCType, LHS, DAG.getConstant(0, dl, Node.getValueType(0), false, false), SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
    } else {
        let mut CC: CondCode = if IsAdd { SETULT } else { SETUGT };
        SetCC = DAG.getSetCC(dl, SetCCType, Result, LHS, CC, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    Overflow = DAG.getBoolExtOrTrunc(SetCC, dl, ResultType, ResultType);
}

fn TargetLowering::expandSADDSUBO(self: *TargetLowering, Node: *mut SDNode, Result: *mut SDValue, Overflow: *mut SDValue, DAG: *mut SelectionDAG) {
    let mut dl: SDLoc = SDLoc { Node };
    let mut LHS: SDValue = Node.getOperand(0);
    let mut RHS: SDValue = Node.getOperand(1);
    let mut IsAdd: bool = Node.getOpcode() == SADDO;
    Result = DAG.getNode(if IsAdd { ADD } else { SUB }, dl, LHS.getValueType(), LHS, RHS);
    let mut ResultType: EVT = Node.getValueType(1);
    let mut OType: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), Node.getValueType(0));
    let mut OpcSat: u32 = if IsAdd { SADDSAT } else { SSUBSAT };
    if self.isOperationLegal(OpcSat, LHS.getValueType()) {
        let mut Sat: SDValue = DAG.getNode(OpcSat, dl, LHS.getValueType(), LHS, RHS);
        let mut SetCC: SDValue = DAG.getSetCC(dl, OType, Result, Sat, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
        Overflow = DAG.getBoolExtOrTrunc(SetCC, dl, ResultType, ResultType);
        return;
    }
    let mut Zero: SDValue = DAG.getConstant(0, dl, LHS.getValueType(), false, false);
    if IsAdd {
        let mut ResultLowerThanLHS: SDValue = DAG.getSetCC(dl, OType, Result, LHS, SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut RHSNegative: SDValue = DAG.getSetCC(dl, OType, RHS, Zero, SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
        Overflow = DAG.getBoolExtOrTrunc(DAG.getNode(XOR, dl, OType, RHSNegative, ResultLowerThanLHS), dl, ResultType, ResultType);
    } else {
        let mut LHSLessThanRHS: SDValue = DAG.getSetCC(dl, OType, LHS, RHS, SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut ResultNegative: SDValue = DAG.getSetCC(dl, OType, Result, Zero, SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
        Overflow = DAG.getBoolExtOrTrunc(DAG.getNode(XOR, dl, OType, LHSLessThanRHS, ResultNegative), dl, ResultType, ResultType);
    }
}

fn TargetLowering::expandMULO(self: *TargetLowering, Node: *mut SDNode, Result: *mut SDValue, Overflow: *mut SDValue, DAG: *mut SelectionDAG) -> bool {
    let mut dl: SDLoc = SDLoc { Node };
    let mut VT: EVT = Node.getValueType(0);
    let mut SetCCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT);
    let mut LHS: SDValue = Node.getOperand(0);
    let mut RHS: SDValue = Node.getOperand(1);
    let mut isSigned: bool = Node.getOpcode() == SMULO;
    if isConstOrConstSplat(RHS, false, false) {
        RHSC;
    } else {
        let mut C: *APInt = RHSC.getAPIntValue();
        if C.isPowerOf2() {
            let mut UseArithShift: bool = isSigned && !C.isMinSignedValue();
            let mut ShiftAmt: SDValue = DAG.getShiftAmountConstant(C.logBase2(), VT, dl);
            Result = DAG.getNode(SHL, dl, VT, LHS, ShiftAmt);
            Overflow = DAG.getSetCC(dl, SetCCVT, DAG.getNode(if UseArithShift { SRA } else { SRL }, dl, VT, Result, ShiftAmt), LHS, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
            return true;
        }
    }
    let mut BottomHalf: SDValue = SDValue {};
    let mut TopHalf: SDValue = SDValue {};
    let mut WideVT: EVT = VT.widenIntegerElementType(*DAG.getContext());
    let mut Ops: [2]u32 = [[UMUL_LOHI, MULHU, ZERO_EXTEND], [SMUL_LOHI, MULHS, SIGN_EXTEND]];
    if self.isOperationLegalOrCustom(Ops[isSigned][0], VT, false) {
        BottomHalf = DAG.getNode(Ops[isSigned][0], dl, DAG.getVTList(VT, VT), LHS, RHS);
        TopHalf = BottomHalf.getValue(1);
    } else if self.isOperationLegalOrCustom(Ops[isSigned][1], VT, false) {
        BottomHalf = DAG.getNode(MUL, dl, VT, LHS, RHS);
        TopHalf = DAG.getNode(Ops[isSigned][1], dl, VT, LHS, RHS);
    } else if self.isTypeLegal(WideVT) {
        LHS = DAG.getNode(Ops[isSigned][2], dl, WideVT, LHS);
        RHS = DAG.getNode(Ops[isSigned][2], dl, WideVT, RHS);
        let mut Mul: SDValue = DAG.getNode(MUL, dl, WideVT, LHS, RHS);
        BottomHalf = DAG.getNode(TRUNCATE, dl, VT, Mul);
        let mut ShiftAmt: SDValue = DAG.getShiftAmountConstant(VT.getScalarSizeInBits(), WideVT, dl);
        TopHalf = DAG.getNode(TRUNCATE, dl, VT, DAG.getNode(SRL, dl, WideVT, Mul, ShiftAmt));
    } else {
        if VT.isVector() {
            return false;
        }
        self.forceExpandWideMUL(DAG, dl, isSigned, LHS, RHS, BottomHalf, TopHalf);
    }
    Result = BottomHalf;
    if isSigned {
        let mut ShiftAmt: SDValue = DAG.getShiftAmountConstant(VT.getScalarSizeInBits() - 1, BottomHalf.getValueType(), dl);
        let mut Sign: SDValue = DAG.getNode(SRA, dl, VT, BottomHalf, ShiftAmt);
        Overflow = DAG.getSetCC(dl, SetCCVT, TopHalf, Sign, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
    } else {
        Overflow = DAG.getSetCC(dl, SetCCVT, TopHalf, DAG.getConstant(0, dl, VT, false, false), SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    let mut RType: EVT = Node.getValueType(1);
    if RType.bitsLT(Overflow.getValueType()) {
        Overflow = DAG.getNode(TRUNCATE, dl, RType, Overflow);
    }
    assert!(RType.getSizeInBits() == Overflow.getValueSizeInBits(), "Unexpected result type for S/UMULO legalization");
    return true;
}

fn TargetLowering::expandMULH(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut dl: SDLoc = SDLoc { Node };
    let mut VT: EVT = Node.getValueType(0);
    let mut LHS: SDValue = Node.getOperand(0);
    let mut RHS: SDValue = Node.getOperand(1);
    let mut IsSigned: bool = Node.getOpcode() == MULHS;
    let mut LoHiOp: u32 = if IsSigned { SMUL_LOHI } else { UMUL_LOHI };
    if self.isOperationLegalOrCustom(LoHiOp, VT, false) {
        return DAG.getNode(LoHiOp, dl, DAG.getVTList(VT, VT), LHS, RHS).getValue(1);
    }
    let mut WideVT: EVT = VT.widenIntegerElementType(*DAG.getContext());
    if self.isOperationLegalOrCustom(MUL, WideVT, false) {
        let mut BW: u32 = VT.getScalarSizeInBits();
        LHS = DAG.getExtOrTrunc(IsSigned, LHS, dl, WideVT);
        RHS = DAG.getExtOrTrunc(IsSigned, RHS, dl, WideVT);
        return DAG.getNode(TRUNCATE, dl, VT, DAG.getNode(SRL, dl, WideVT, DAG.getNode(MUL, dl, WideVT, LHS, RHS), DAG.getShiftAmountConstant(BW, WideVT, dl)));
    }
    if !VT.isFixedLengthVector() {
        let mut Lo: SDValue = SDValue {};
        let mut Hi: SDValue = SDValue {};
        self.forceExpandWideMUL(DAG, dl, IsSigned, LHS, RHS, Lo, Hi);
        return Hi;
    }
    return SDValue {};
}

fn TargetLowering::expandVecReduce(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut dl: SDLoc = SDLoc { Node };
    let mut BaseOpcode: NodeType = getVecReduceBaseOpcode(Node.getOpcode());
    let mut Op: SDValue = Node.getOperand(0);
    let mut Flags: SDNodeFlags = Node.getFlags();
    let mut VT: EVT = Op.getValueType();
    if VT.isPow2VectorType() {
        let mut WidenSrc: bool = false;
        match Node.getOpcode() {
            VECREDUCE_FADD => {
                VECREDUCE_FMUL;
            },
        }
        while VT.getVectorElementCount().isKnownMultipleOf(2) {
            let mut HalfVT: EVT = VT.getHalfNumVectorElementsVT(*DAG.getContext());
            if !self.isOperationLegalOrCustom(BaseOpcode, HalfVT, false) {
                if WidenSrc && Op.getOpcode() != BUILD_VECTOR {
                    let mut WideVT: EVT = self.getTypeToTransformTo(*DAG.getContext(), HalfVT);
                    if WideVT.isVector() && WideVT.getScalarType() == HalfVT.getScalarType() && WideVT.getVectorNumElements() >= HalfVT.getVectorNumElements() && self.isOperationLegalOrCustom(BaseOpcode, WideVT, false) {
                        let mut Lo: SDValue = SDValue {};
                        let mut Hi: SDValue = SDValue {};
                        tie(Lo, Hi) = DAG.SplitVector(Op, dl);
                        Lo = DAG.getInsertSubvector(dl, DAG.getPOISON(WideVT), Lo, 0);
                        Hi = DAG.getInsertSubvector(dl, DAG.getPOISON(WideVT), Hi, 0);
                        Op = DAG.getNode(BaseOpcode, dl, WideVT, Lo, Hi, Flags);
                        Op = DAG.getExtractSubvector(dl, HalfVT, Op, 0);
                        VT = HalfVT;
                        continue;
                    }
                }
                break;
            }
            let mut Lo: SDValue = SDValue {};
            let mut Hi: SDValue = SDValue {};
            tie(Lo, Hi) = DAG.SplitVector(Op, dl);
            Op = DAG.getNode(BaseOpcode, dl, HalfVT, Lo, Hi, Flags);
            VT = HalfVT;
            if self.isOperationLegalOrCustom(Node.getOpcode(), HalfVT, false) {
                return DAG.getNode(Node.getOpcode(), dl, Node.getValueType(0), Op, Flags);
            }
        }
    }
    if VT.isScalableVector() {
        reportFatalInternalError("Expanding reductions for scalable vectors is undefined.");
    }
    let mut EltVT: EVT = VT.getVectorElementType();
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    DAG.ExtractVectorElements(Op, Ops, 0, NumElts, EVT {});
    let mut Res: SDValue = Ops[0];
    for let mut i: u32 = 1; i < NumElts; i += 1 {
        Res = DAG.getNode(BaseOpcode, dl, EltVT, Res, Ops[i], Flags);
    }
    if EltVT != Node.getValueType(0) {
        Res = DAG.getNode(ANY_EXTEND, dl, Node.getValueType(0), Res);
    }
    return Res;
}

fn TargetLowering::expandVecReduceSeq(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut dl: SDLoc = SDLoc { Node };
    let mut AccOp: SDValue = Node.getOperand(0);
    let mut VecOp: SDValue = Node.getOperand(1);
    let mut Flags: SDNodeFlags = Node.getFlags();
    let mut VT: EVT = VecOp.getValueType();
    let mut EltVT: EVT = VT.getVectorElementType();
    if VT.isScalableVector() {
        report_fatal_error("Expanding reductions for scalable vectors is undefined.", true);
    }
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    DAG.ExtractVectorElements(VecOp, Ops, 0, NumElts, EVT {});
    let mut BaseOpcode: u32 = getVecReduceBaseOpcode(Node.getOpcode());
    let mut Res: SDValue = AccOp;
    for let mut i: u32 = 0; i < NumElts; i += 1 {
        Res = DAG.getNode(BaseOpcode, dl, EltVT, Res, Ops[i], Flags);
    }
    return Res;
}

fn TargetLowering::expandREM(self: *TargetLowering, Node: *mut SDNode, Result: *mut SDValue, DAG: *mut SelectionDAG) -> bool {
    let mut VT: EVT = Node.getValueType(0);
    let mut dl: SDLoc = SDLoc { Node };
    let mut isSigned: bool = Node.getOpcode() == SREM;
    let mut DivOpc: u32 = if isSigned { SDIV } else { UDIV };
    let mut DivRemOpc: u32 = if isSigned { SDIVREM } else { UDIVREM };
    let mut Dividend: SDValue = Node.getOperand(0);
    let mut Divisor: SDValue = Node.getOperand(1);
    if self.isOperationLegalOrCustom(DivRemOpc, VT, false) {
        let mut VTs: SDVTList = DAG.getVTList(VT, VT);
        Result = DAG.getNode(DivRemOpc, dl, VTs, Dividend, Divisor).getValue(1);
        return true;
    }
    if self.isOperationLegalOrCustom(DivOpc, VT, false) {
        let mut Divide: SDValue = DAG.getNode(DivOpc, dl, VT, Dividend, Divisor);
        let mut Mul: SDValue = DAG.getNode(MUL, dl, VT, Divide, Divisor);
        Result = DAG.getNode(SUB, dl, VT, Dividend, Mul);
        return true;
    }
    return false;
}

fn TargetLowering::expandFP_TO_INT_SAT(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut IsSigned: bool = Node.getOpcode() == FP_TO_SINT_SAT;
    let mut dl: SDLoc = SDLoc { SDValue { Node: Node, ResNo: 0 } };
    let mut Src: SDValue = Node.getOperand(0);
    let mut SrcVT: EVT = Src.getValueType();
    let mut DstVT: EVT = Node.getValueType(0);
    let mut SatVT: EVT = cast(Node.getOperand(1)).getVT();
    let mut SatWidth: u32 = SatVT.getScalarSizeInBits();
    let mut DstWidth: u32 = DstVT.getScalarSizeInBits();
    assert!(SatWidth <= DstWidth, "Expected saturation width smaller than result width");
    let mut MinInt: APInt = APInt {};
    let mut MaxInt: APInt = APInt {};
    if IsSigned {
        MinInt = getSignedMinValue(SatWidth).sext(DstWidth);
        MaxInt = getSignedMaxValue(SatWidth).sext(DstWidth);
    } else {
        MinInt = getMinValue(SatWidth).zext(DstWidth);
        MaxInt = getMaxValue(SatWidth).zext(DstWidth);
    }
    if SrcVT == EVT { f16 } || SrcVT == EVT { bf16 } {
        Src = DAG.getNode(FP_EXTEND, dl, EVT { f32 }, Src);
        SrcVT = Src.getValueType();
    }
    let mut Sem: *fltSemantics = SrcVT.getFltSemantics();
    let mut MinFloat: APFloat = APFloat { U: Sem };
    let mut MaxFloat: APFloat = APFloat { U: Sem };
    let mut MinStatus: opStatus = MinFloat.convertFromAPInt(MinInt, IsSigned, rmTowardZero);
    let mut MaxStatus: opStatus = MaxFloat.convertFromAPInt(MaxInt, IsSigned, rmTowardZero);
    let mut AreExactFloatBounds: bool = !(MinStatus & opInexact) && !(MaxStatus & opInexact);
    let mut MinFloatNode: SDValue = DAG.getConstantFP(MinFloat, dl, SrcVT, false);
    let mut MaxFloatNode: SDValue = DAG.getConstantFP(MaxFloat, dl, SrcVT, false);
    let mut EmitMinMax: Closure_41 = Closure_41 { cap_0: self, SrcVT: &mut SrcVT, Src: &mut Src, DAG: &mut DAG, dl: &mut dl, MinFloatNode: &mut MinFloatNode, MaxFloatNode: &mut MaxFloatNode, IsSigned: &mut IsSigned, DstVT: &mut DstVT };
    if AreExactFloatBounds {
        if EmitMinMax.call(FMINIMUMNUM, FMAXIMUMNUM, false) {
            Res;
        } else {
            return Res;
        }
        if EmitMinMax.call(FMINNUM, FMAXNUM, true) {
            Res;
        } else {
            return Res;
        }
        if EmitMinMax.call(FMINIMUM, FMAXIMUM, true) {
            Res;
        } else {
            return Res;
        }
    }
    let mut MinIntNode: SDValue = DAG.getConstant(MinInt, dl, DstVT, false, false);
    let mut MaxIntNode: SDValue = DAG.getConstant(MaxInt, dl, DstVT, false, false);
    let mut FpToInt: SDValue = DAG.getNode(if IsSigned { FP_TO_SINT } else { FP_TO_UINT }, dl, DstVT, Src);
    let mut Select: SDValue = FpToInt;
    let mut SetCCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), SrcVT);
    let mut ULT: SDValue = DAG.getSetCC(dl, SetCCVT, Src, MinFloatNode, SETULT, SDValue {}, false, SDNodeFlags { Flags: None });
    Select = DAG.getSelect(dl, DstVT, ULT, MinIntNode, Select, SDNodeFlags { Flags: None });
    let mut OGT: SDValue = DAG.getSetCC(dl, SetCCVT, Src, MaxFloatNode, SETOGT, SDValue {}, false, SDNodeFlags { Flags: None });
    Select = DAG.getSelect(dl, DstVT, OGT, MaxIntNode, Select, SDNodeFlags { Flags: None });
    if !IsSigned {
        return Select;
    }
    let mut ZeroInt: SDValue = DAG.getConstant(0, dl, DstVT, false, false);
    let mut IsNan: SDValue = DAG.getSetCC(dl, SetCCVT, Src, Src, SETUO, SDValue {}, false, SDNodeFlags { Flags: None });
    return DAG.getSelect(dl, DstVT, IsNan, ZeroInt, Select, SDNodeFlags { Flags: None });
}

fn TargetLowering::expandRoundInexactToOdd(self: *TargetLowering, ResultVT: EVT, Op: SDValue, dl: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut OperandVT: EVT = Op.getValueType();
    if OperandVT.getScalarType() == ResultVT.getScalarType() {
        return Op;
    }
    let mut ResultIntVT: EVT = ResultVT.changeTypeToInteger();
    let mut Narrow: SDValue = DAG.getFPExtendOrRound(Op, dl, ResultVT);
    let mut NarrowAsWide: SDValue = DAG.getFPExtendOrRound(Narrow, dl, OperandVT);
    let mut NarrowBits: SDValue = DAG.getNode(BITCAST, dl, ResultIntVT, Narrow);
    let mut One: SDValue = DAG.getConstant(1, dl, ResultIntVT, false, false);
    let mut NegativeOne: SDValue = DAG.getAllOnesConstant(dl, ResultIntVT, false, false);
    let mut And: SDValue = DAG.getNode(AND, dl, ResultIntVT, NarrowBits, One);
    let mut ResultIntVTCCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), And.getValueType());
    let mut Zero: SDValue = DAG.getConstant(0, dl, ResultIntVT, false, false);
    let mut AlreadyOdd: SDValue = DAG.getSetCC(dl, ResultIntVTCCVT, And, Zero, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut WideSetCCVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), Op.getValueType());
    let mut KeepNarrow: SDValue = DAG.getSetCC(dl, WideSetCCVT, Op, NarrowAsWide, SETUEQ, SDValue {}, false, SDNodeFlags { Flags: None });
    KeepNarrow = DAG.getNode(OR, dl, WideSetCCVT, KeepNarrow, AlreadyOdd);
    let mut AbsWide: SDValue = DAG.getNode(FABS, dl, OperandVT, Op);
    let mut AbsNarrowAsWide: SDValue = DAG.getNode(FABS, dl, OperandVT, NarrowAsWide);
    let mut NarrowIsRd: SDValue = DAG.getSetCC(dl, WideSetCCVT, AbsWide, AbsNarrowAsWide, SETOGT, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut Adjust: SDValue = DAG.getSelect(dl, ResultIntVT, NarrowIsRd, One, NegativeOne, SDNodeFlags { Flags: None });
    let mut Adjusted: SDValue = DAG.getNode(ADD, dl, ResultIntVT, NarrowBits, Adjust);
    Op = DAG.getSelect(dl, ResultIntVT, KeepNarrow, NarrowBits, Adjusted, SDNodeFlags { Flags: None });
    return DAG.getNode(BITCAST, dl, ResultVT, Op);
}

fn TargetLowering::expandFP_ROUND(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Node.getOpcode() == FP_ROUND, "Unexpected opcode!");
    let mut Op: SDValue = Node.getOperand(0);
    let mut VT: EVT = Node.getValueType(0);
    let mut dl: SDLoc = SDLoc { Node };
    if VT.getScalarType() == EVT { bf16 } {
        if Node.getConstantOperandVal(1) == 1 {
            return DAG.getNode(FP_TO_BF16, dl, VT, Node.getOperand(0));
        }
        let mut OperandVT: EVT = Op.getValueType();
        let mut IsNaN: SDValue = DAG.getSetCC(dl, self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), OperandVT), Op, Op, SETUO, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut F32: EVT = VT.changeElementType(*DAG.getContext(), EVT { f32 });
        let mut I32: EVT = F32.changeTypeToInteger();
        Op = self.expandRoundInexactToOdd(F32, Op, dl, DAG);
        Op = DAG.getNode(BITCAST, dl, I32, Op);
        let mut NaN: SDValue = DAG.getNode(OR, dl, I32, Op, DAG.getConstant(4194304, dl, I32, false, false));
        let mut One: SDValue = DAG.getConstant(1, dl, I32, false, false);
        let mut Lsb: SDValue = DAG.getNode(SRL, dl, I32, Op, DAG.getShiftAmountConstant(16, I32, dl));
        Lsb = DAG.getNode(AND, dl, I32, Lsb, One);
        let mut RoundingBias: SDValue = DAG.getNode(ADD, dl, I32, Lsb, DAG.getConstant(32767, dl, I32, false, false));
        let mut Add: SDValue = DAG.getNode(ADD, dl, I32, Op, RoundingBias);
        Op = DAG.getSelect(dl, I32, IsNaN, NaN, Add, SDNodeFlags { Flags: None });
        Op = DAG.getNode(SRL, dl, I32, Op, DAG.getShiftAmountConstant(16, I32, dl));
        let mut I16: EVT = I32.changeElementType(*DAG.getContext(), EVT { i16 });
        Op = DAG.getNode(TRUNCATE, dl, I16, Op);
        return DAG.getNode(BITCAST, dl, VT, Op);
    }
    return SDValue {};
}

fn TargetLowering::expandVectorSplice(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    assert!((Node.getOpcode() == VECTOR_SPLICE_LEFT || Node.getOpcode() == VECTOR_SPLICE_RIGHT), "Unexpected opcode!");
    assert!((Node.getValueType(0).isScalableVector() || !isa(Node.getOperand(2))), "Fixed length vector types with constant offsets expected to use SHUFFLE_VECTOR!");
    let mut VT: EVT = Node.getValueType(0);
    let mut V1: SDValue = Node.getOperand(0);
    let mut V2: SDValue = Node.getOperand(1);
    let mut Offset: SDValue = Node.getOperand(2);
    let mut DL: SDLoc = SDLoc { Node };
    let mut Alignment: Align = DAG.getReducedAlign(VT, false);
    let mut MemVT: EVT = getVectorVT(*DAG.getContext(), VT.getVectorElementType(), VT.getVectorElementCount() * 2);
    let mut StackPtr: SDValue = DAG.CreateStackTemporary(MemVT.getStoreSize(), Alignment);
    let mut PtrVT: EVT = StackPtr.getValueType();
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut FrameIndex: i32 = cast(StackPtr.getNode()).getIndex();
    let mut PtrInfo: MachinePointerInfo = getFixedStack(MF, FrameIndex, 0);
    let mut StoreV1: SDValue = DAG.getStore(DAG.getEntryNode(), DL, V1, StackPtr, PtrInfo, Alignment, MONone, MMOMetadata {});
    let mut VTBytes: SDValue = DAG.getTypeSize(DL, PtrVT, VT.getStoreSize());
    let mut StackPtr2: SDValue = DAG.getNode(ADD, DL, PtrVT, StackPtr, VTBytes);
    let mut StoreV2: SDValue = DAG.getStore(StoreV1, DL, V2, StackPtr2, PtrInfo, Alignment, MONone, MMOMetadata {});
    let mut EltByteSize: SDValue = DAG.getTypeSize(DL, PtrVT, VT.getVectorElementType().getStoreSize());
    Offset = DAG.getZExtOrTrunc(Offset, DL, PtrVT);
    let mut TrailingBytes: SDValue = DAG.getNode(MUL, DL, PtrVT, Offset, EltByteSize);
    TrailingBytes = DAG.getNode(UMIN, DL, PtrVT, TrailingBytes, VTBytes);
    if Node.getOpcode() == VECTOR_SPLICE_LEFT {
        StackPtr = DAG.getMemBasePlusOffset(StackPtr, TrailingBytes, DL, SDNodeFlags { Flags: None });
    } else {
        StackPtr = DAG.getNode(SUB, DL, PtrVT, StackPtr2, TrailingBytes);
    }
    return DAG.getLoad(VT, DL, StoreV2, StackPtr, getUnknownStack(MF), MaybeAlign { Alignment }, MONone, MMOMetadata {});
}

fn TargetLowering::expandVECTOR_COMPRESS(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = SDLoc { Node };
    let mut Vec: SDValue = Node.getOperand(0);
    let mut Mask: SDValue = Node.getOperand(1);
    let mut Passthru: SDValue = Node.getOperand(2);
    let mut VecVT: EVT = Vec.getValueType();
    let mut ScalarVT: EVT = VecVT.getScalarType();
    let mut MaskVT: EVT = Mask.getValueType();
    let mut MaskScalarVT: EVT = MaskVT.getScalarType();
    if VecVT.isScalableVector() {
        report_fatal_error("Cannot expand masked_compress for scalable vectors.", true);
    }
    let mut Alignment: Align = DAG.getReducedAlign(VecVT, false);
    let mut StackPtr: SDValue = DAG.CreateStackTemporary(VecVT.getStoreSize(), Alignment);
    let mut FI: i32 = cast(StackPtr.getNode()).getIndex();
    let mut PtrInfo: MachinePointerInfo = getFixedStack(DAG.getMachineFunction(), FI, 0);
    let mut PositionVT: MVT = self.getVectorIdxTy(DAG.getDataLayout());
    let mut Chain: SDValue = DAG.getEntryNode();
    let mut OutPos: SDValue = DAG.getConstant(0, DL, EVT { PositionVT }, false, false);
    let mut HasPassthru: bool = !Passthru.isUndef();
    if HasPassthru {
        Chain = DAG.getStore(Chain, DL, Passthru, StackPtr, PtrInfo, Alignment, MONone, MMOMetadata {});
    }
    let mut LastWriteVal: SDValue = SDValue {};
    let mut PassthruSplatVal: APInt = APInt {};
    let mut IsSplatPassthru: bool = isConstantSplatVector(Passthru.getNode(), PassthruSplatVal);
    if IsSplatPassthru {
        LastWriteVal = DAG.getConstant(PassthruSplatVal, DL, ScalarVT, false, false);
    } else if HasPassthru {
        let mut PopcountVT: EVT = ScalarVT.changeTypeToInteger();
        let mut Popcount: SDValue = DAG.getNode(TRUNCATE, DL, MaskVT.changeVectorElementType(*DAG.getContext(), EVT { i1 }), Mask);
        Popcount = DAG.getNode(ZERO_EXTEND, DL, MaskVT.changeVectorElementType(*DAG.getContext(), PopcountVT), Popcount);
        Popcount = DAG.getNode(VECREDUCE_ADD, DL, PopcountVT, Popcount);
        let mut LastElmtPtr: SDValue = self.getVectorElementPointer(DAG, StackPtr, VecVT, Popcount, SDNodeFlags { Flags: None });
        LastWriteVal = DAG.getLoad(ScalarVT, DL, Chain, LastElmtPtr, getUnknownStack(DAG.getMachineFunction()), MaybeAlign {}, MONone, MMOMetadata {});
        Chain = LastWriteVal.getValue(1);
    }
    let mut NumElms: u32 = VecVT.getVectorNumElements();
    for let mut I: u32 = 0; I < NumElms; I += 1 {
        let mut ValI: SDValue = DAG.getExtractVectorElt(DL, ScalarVT, Vec, I);
        let mut OutPtr: SDValue = self.getVectorElementPointer(DAG, StackPtr, VecVT, OutPos, SDNodeFlags { Flags: None });
        Chain = DAG.getStore(Chain, DL, ValI, OutPtr, getUnknownStack(DAG.getMachineFunction()), MaybeAlign {}, MONone, MMOMetadata {});
        let mut MaskI: SDValue = DAG.getExtractVectorElt(DL, MaskScalarVT, Mask, I);
        MaskI = DAG.getFreeze(MaskI);
        MaskI = DAG.getNode(TRUNCATE, DL, EVT { i1 }, MaskI);
        MaskI = DAG.getNode(ZERO_EXTEND, DL, EVT { PositionVT }, MaskI);
        OutPos = DAG.getNode(ADD, DL, EVT { PositionVT }, OutPos, MaskI);
        if HasPassthru && I == NumElms - 1 {
            let mut EndOfVector: SDValue = DAG.getConstant(VecVT.getVectorNumElements() - 1, DL, EVT { PositionVT }, false, false);
            let mut AllLanesSelected: SDValue = DAG.getSetCC(DL, EVT { i1 }, OutPos, EndOfVector, SETUGT, SDValue {}, false, SDNodeFlags { Flags: None });
            OutPos = DAG.getNode(UMIN, DL, EVT { PositionVT }, OutPos, EndOfVector);
            OutPtr = self.getVectorElementPointer(DAG, StackPtr, VecVT, OutPos, SDNodeFlags { Flags: None });
            LastWriteVal = DAG.getSelect(DL, ScalarVT, AllLanesSelected, ValI, LastWriteVal, SDNodeFlags { Flags: Unpredictable });
            Chain = DAG.getStore(Chain, DL, LastWriteVal, OutPtr, getUnknownStack(DAG.getMachineFunction()), MaybeAlign {}, MONone, MMOMetadata {});
        }
    }
    return DAG.getLoad(VecVT, DL, Chain, StackPtr, PtrInfo, MaybeAlign { Alignment }, MONone, MMOMetadata {});
}

fn TargetLowering::expandCttzElts(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = SDLoc { Node };
    let mut VT: EVT = Node.getValueType(0);
    let mut Op: SDValue = Node.getOperand(0);
    let mut EC: ElementCount = Op.getValueType().getVectorElementCount();
    let mut ZeroIsPoison: bool = Node.getOpcode() == CTTZ_ELTS_ZERO_POISON;
    if !StepVec {
        let mut ResVT: EVT = Node.getValueType(0);
        let mut LoNumElts: SDValue = DAG.getElementCount(DL, ResVT, MaskLo.getValueType().getVectorElementCount());
        let mut ResLo: SDValue = DAG.getNode(CTTZ_ELTS, DL, ResVT, MaskLo);
        let mut ResHi: SDValue = DAG.getNode(Node.getOpcode(), DL, ResVT, MaskHi);
        let mut ResLoNotNumElts: SDValue = DAG.getSetCC(DL, self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), ResVT), ResLo, LoNumElts, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut Sum: SDValue = DAG.getNode(ADD, DL, ResVT, LoNumElts, ResHi, SDNodeFlags { Flags: NoUnsignedWrap });
        return DAG.getSelect(DL, ResVT, ResLoNotNumElts, ResLo, Sum, SDNodeFlags { Flags: None });
    }
    let mut StepVecVT: EVT = StepVec.getValueType();
    let mut StepVT: EVT = StepVecVT.getVectorElementType();
    if self.getTypeAction(StepVT.getSimpleVT()) == TypePromoteInteger {
        StepVT = self.getTypeToTransformTo(*DAG.getContext(), StepVT);
    }
    let mut VL: SDValue = DAG.getElementCount(DL, StepVT, EC);
    let mut SplatVL: SDValue = DAG.getSplat(StepVecVT, DL, VL);
    StepVec = DAG.getNode(SUB, DL, StepVecVT, SplatVL, StepVec);
    let mut Zeroes: SDValue = DAG.getConstant(0, DL, StepVecVT, false, false);
    let mut Select: SDValue = DAG.getSelect(DL, StepVecVT, Mask, StepVec, Zeroes, SDNodeFlags { Flags: None });
    let mut Max: SDValue = DAG.getNode(VECREDUCE_UMAX, DL, StepVecVT.getVectorElementType(), Select);
    let mut Sub: SDValue = DAG.getNode(SUB, DL, StepVT, VL, DAG.getZExtOrTrunc(Max, DL, StepVT));
    return DAG.getZExtOrTrunc(Sub, DL, VT);
}

fn TargetLowering::expandVectorMatch(self: *TargetLowering, N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Source: SDValue = N.getOperand(0);
    let mut Needle: SDValue = N.getOperand(1);
    let mut Mask: SDValue = N.getOperand(2);
    let mut SourceVT: EVT = Source.getValueType();
    let mut NeedleVT: EVT = Needle.getValueType();
    let mut ResVT: EVT = N.getValueType(0);
    let mut CmpVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), SourceVT);
    assert!(NeedleVT.isFixedLengthVector(), "Needle must be a fixed vector");
    let mut Ret: SDValue = DAG.getConstant(0, DL, CmpVT, false, false);
    let mut NeedleEltVT: EVT = NeedleVT.getVectorElementType();
    for let mut I: u32 = 0;
let mut E: u32 = NeedleVT.getVectorNumElements(); I != E; I += 1 {
        let mut Splat: SDValue = SDValue {};
        if NeedleVT == SourceVT {
            Splat = DAG.getVectorShuffle(SourceVT, DL, Needle, DAG.getUNDEF(SourceVT), ArrayRef<int> { SmallVector<int> { NeedleVT.getVectorNumElements(), I } });
        } else {
            let mut NeedleElt: SDValue = DAG.getExtractVectorElt(DL, NeedleEltVT, Needle, I);
            Splat = DAG.getNode(SPLAT_VECTOR, DL, SourceVT, NeedleElt);
        }
        let mut Cmp: SDValue = DAG.getSetCC(DL, CmpVT, Source, Splat, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
        Ret = DAG.getNode(OR, DL, CmpVT, Ret, Cmp);
    }
    let mut UseVT: EVT = ResVT;
    if N.hasOneUse() && operator(N.user_begin()).getOpcode() == TRUNCATE {
        UseVT = operator(N.user_begin()).getValueType(0);
    }
    Mask = DAG.getBoolExtOrTrunc(Mask, DL, UseVT, Mask.getValueType());
    Ret = DAG.getBoolExtOrTrunc(Ret, DL, UseVT, Ret.getValueType());
    Ret = DAG.getNode(AND, DL, UseVT, Ret, Mask);
    if UseVT != ResVT {
        Ret = DAG.getNode(ANY_EXTEND, DL, ResVT, Ret);
    }
    return Ret;
}

fn TargetLowering::expandPartialReduceMLA(self: *TargetLowering, N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Acc: SDValue = N.getOperand(0);
    let mut MulLHS: SDValue = N.getOperand(1);
    let mut MulRHS: SDValue = N.getOperand(2);
    let mut AccVT: EVT = Acc.getValueType();
    let mut MulOpVT: EVT = MulLHS.getValueType();
    let mut ExtMulOpVT: EVT = getVectorVT(*DAG.getContext(), AccVT.getVectorElementType(), MulOpVT.getVectorElementCount());
    let mut ExtOpcLHS: u32 = 0;
    let mut ExtOpcRHS: u32 = 0;
    match N.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unexpected opcode", "llvm\\lib\\CodeGen\\SelectionDAG\\TargetLowering.cpp", 13962);
        },
        PARTIAL_REDUCE_UMLA => {
            ExtOpcLHS = ExtOpcRHS = ZERO_EXTEND;
        },
        PARTIAL_REDUCE_SMLA => {
            ExtOpcLHS = ExtOpcRHS = SIGN_EXTEND;
        },
        PARTIAL_REDUCE_SUMLA => {
            ExtOpcLHS = SIGN_EXTEND;
        },
        PARTIAL_REDUCE_FMLA => {
            ExtOpcLHS = ExtOpcRHS = FP_EXTEND;
        },
    }
    let mut Opc: u32 = N.getOpcode();
    let mut MulEC: ElementCount = MulOpVT.getVectorElementCount();
    let mut AccEC: ElementCount = AccVT.getVectorElementCount();
    let mut CountRatio: u32 = if MulEC.hasKnownScalarFactor(AccEC) { MulEC.getKnownScalarFactor(AccEC) } else { 0 };
    let mut WidthRatio: u32 = AccVT.getScalarSizeInBits() / MulOpVT.getScalarSizeInBits();
    if Opc != PARTIAL_REDUCE_FMLA && CountRatio > 2 && WidthRatio >= 2 {
        let mut Ctx: *mut LLVMContext = *DAG.getContext();
        let mut ProdVT: EVT = MulOpVT.widenIntegerVectorElementType(Ctx);
        if isOneOrOneSplat(MulRHS, false) {
            let mut RungVT: EVT = ProdVT.getHalfNumVectorElementsVT(Ctx);
            return DAG.getNode(Opc, DL, AccVT, Acc, DAG.getNode(Opc, DL, RungVT, DAG.getConstant(0, DL, RungVT, false, false), MulLHS, MulRHS), DAG.getConstant(1, DL, RungVT, false, false));
        }
        let mut Prod: SDValue = DAG.getNode(MUL, DL, ProdVT, DAG.getNode(ExtOpcLHS, DL, ProdVT, MulLHS), DAG.getNode(ExtOpcRHS, DL, ProdVT, MulRHS));
        let mut One: SDValue = DAG.getConstant(1, DL, Lo.getValueType(), false, false);
        let mut MidVT: EVT = Lo.getValueType().widenIntegerVectorElementType(Ctx).getHalfNumVectorElementsVT(Ctx);
        if isKnownLE(MidVT.getVectorElementCount(), AccEC) {
            return DAG.getNode(Opc, DL, AccVT, DAG.getNode(Opc, DL, AccVT, Acc, Lo, One), Hi, One);
        }
        let mut Mid: SDValue = DAG.getNode(Opc, DL, MidVT, DAG.getConstant(0, DL, MidVT, false, false), Lo, One);
        Mid = DAG.getNode(Opc, DL, MidVT, Mid, Hi, One);
        return DAG.getNode(Opc, DL, AccVT, Acc, Mid, DAG.getConstant(1, DL, MidVT, false, false));
    }
    if ExtMulOpVT != MulOpVT {
        MulLHS = DAG.getNode(ExtOpcLHS, DL, ExtMulOpVT, MulLHS);
        MulRHS = DAG.getNode(ExtOpcRHS, DL, ExtMulOpVT, MulRHS);
    }
    let mut Input: SDValue = MulLHS;
    if N.getOpcode() == PARTIAL_REDUCE_FMLA {
        if !isOneOrOneSplatFP(MulRHS, false) {
            Input = DAG.getNode(FMUL, DL, ExtMulOpVT, MulLHS, MulRHS);
        }
    } else if !isOneOrOneSplat(MulRHS, false) {
        Input = DAG.getNode(MUL, DL, ExtMulOpVT, MulLHS, MulRHS);
    }
    let mut Stride: u32 = AccVT.getVectorMinNumElements();
    let mut ScaleFactor: u32 = MulOpVT.getVectorMinNumElements() / Stride;
    let mut Subvectors: deque<SDValue> = deque<SDValue> { [Acc], allocator_type {} };
    for let mut I: u32 = 0; I < ScaleFactor; I += 1 {
        Subvectors.push(DAG.getExtractSubvector(DL, AccVT, Input, I * Stride));
    }
    let mut FlatNode: u32 = if N.getOpcode() == PARTIAL_REDUCE_FMLA { FADD } else { ADD };
    while Subvectors.len > 1 {
        Subvectors.push(DAG.getNode(FlatNode, DL, AccVT, ArrayRef<SDValue> { [Subvectors[0], Subvectors[1]] }));
        Subvectors.pop_front();
        Subvectors.pop_front();
    }
    assert!(Subvectors.len == 1, "There should only be one subvector after tree flattening");
    return Subvectors[0];
}

fn canFoldStoreIntoLibCallOutputPointers(StoreNode: *mut StoreSDNode, FPNode: *mut SDNode) -> bool {
    let mut Worklist: SmallVector<const SDNode *, 8> = SmallVector<const SDNode *, 8> {};
    let mut DeferredNodes: SmallVector<const SDNode *, 8> = SmallVector<const SDNode *, 8> {};
    let mut Visited: SmallPtrSet<const SDNode *, 16> = SmallPtrSet<const SDNode *, 16> {};
    for Op in StoreNode.ops() {
        if Op.getNode() != FPNode {
            Worklist.push(Op.getNode());
        }
    }
    let mut MaxSteps: u32 = getHasPredecessorMaxSteps();
    while !Worklist.is_empty() {
        let mut Node: *SDNode = Worklist.pop_back_val();
        if !Inserted {
            continue;
        }
        if MaxSteps > 0 && Visited.len >= MaxSteps {
            return false;
        }
        if Node == FPNode || Node.getOpcode() == CALLSEQ_START {
            return false;
        }
        if Node.getOpcode() == CALLSEQ_END {
            DeferredNodes.push(Node);
            continue;
        }
        for Op in Node.ops() {
            Worklist.push(Op.getNode());
        }
    }
    return !hasPredecessorHelper(FPNode, Visited, DeferredNodes, MaxSteps, false);
}

fn TargetLowering::expandMultipleResultFPLibCall(self: *TargetLowering, DAG: *mut SelectionDAG, LC: Libcall, Node: *mut SDNode, Results: *mut SmallVectorImpl<SDValue>, CallRetResNo: optional<unsigned int>) -> bool {
    if LC == UNKNOWN_LIBCALL {
        return false;
    }
    let mut LibcallImpl: LibcallImpl = self.getLibcallImpl(LC);
    if LibcallImpl == Unsupported {
        return false;
    }
    let mut Ctx: *mut LLVMContext = *DAG.getContext();
    let mut VT: EVT = Node.getValueType(0);
    let mut NumResults: u32 = Node.getNumValues();
    let mut StoresInChain: SDValue = SDValue {};
    let mut ResultStores: SmallVector<StoreSDNode *, 2> = SmallVector<StoreSDNode *, 2> { NumResults };
    for User in Node.users() {
        if !isNormalStore(User) {
            continue;
        }
        let mut ST: *mut StoreSDNode = cast(User);
        let mut StoreValue: SDValue = ST.getValue();
        let mut ResNo: u32 = StoreValue.getResNo();
        if CallRetResNo == ResNo {
            continue;
        }
        if !ST.isSimple() || ST.getAddressSpace() != 0 {
            continue;
        }
        if StoresInChain && ST.getChain() != StoresInChain {
            continue;
        }
        let mut StoreType: *mut Type = StoreValue.getValueType().getTypeForEVT(Ctx);
        if ST.getAlign() < DAG.getDataLayout().getABITypeAlign(StoreType.getScalarType()) {
            continue;
        }
        if !canFoldStoreIntoLibCallOutputPointers(ST, Node) {
            continue;
        }
        ResultStores[ResNo] = ST;
        StoresInChain = ST.getChain();
    }
    let mut Args: ArgListTy = ArgListTy {};
    for Op in Node.op_values() {
        let mut ArgVT: EVT = Op.getValueType();
        let mut ArgTy: *mut Type = ArgVT.getTypeForEVT(Ctx);
        Args.emplace_back(Op, ArgTy);
    }
    let mut ResultPtrs: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> { NumResults };
    let mut PointerTy: *mut Type = getUnqual(Ctx);
    for x in enumerate(ResultStores) {
        if ResNo == CallRetResNo {
            continue;
        }
        let mut ResVT: EVT = Node.getValueType(ResNo);
        let mut ResultPtr: SDValue = if ST { ST.getBasePtr() } else { DAG.CreateStackTemporary(ResVT, 1) };
        ResultPtrs[ResNo] = ResultPtr;
        Args.emplace_back(ResultPtr, PointerTy);
    }
    let mut DL: SDLoc = SDLoc { Node };
    if hasVectorMaskArgument(LibcallImpl) {
        let mut MaskVT: EVT = self.getSetCCResultType(DAG.getDataLayout(), Ctx, VT);
        let mut Mask: SDValue = DAG.getBoolConstant(true, DL, MaskVT, VT);
        Args.emplace_back(Mask, MaskVT.getTypeForEVT(Ctx));
    }
    let mut RetType: *mut Type = if CallRetResNo.has_value() { Node.getValueType(operator(CallRetResNo)).getTypeForEVT(Ctx) } else { getVoidTy(Ctx) };
    let mut InChain: SDValue = if StoresInChain {} else { DAG.getEntryNode() };
    let mut Callee: SDValue = DAG.getExternalSymbol(LibcallImpl, EVT { self.getPointerTy(DAG.getDataLayout(), 0) });
    let mut CLI: CallLoweringInfo = CallLoweringInfo { DAG };
    CLI.setDebugLoc(DL).setChain(InChain).setLibCallee(self.getLibcallImplCallingConv(LibcallImpl), RetType, Callee, move(Args));
    for x in enumerate(ResultPtrs) {
        if ResNo == CallRetResNo {
            Results.push(ValueParamT { Call });
            continue;
        }
        let mut PtrInfo: MachinePointerInfo = MachinePointerInfo { 0, 0 };
        let mut LoadResult: SDValue = DAG.getLoad(Node.getValueType(ResNo), DL, CallChain, ResultPtr, PtrInfo, MaybeAlign {}, MONone, MMOMetadata {});
        let mut OutChain: SDValue = LoadResult.getValue(1);
        if ResultStores[ResNo] {
            ST;
        } else {
            DAG.ReplaceAllUsesOfValueWith(SDValue { Node: ST, ResNo: 0 }, OutChain);
            PtrInfo = ST.getPointerInfo();
        }
        Results.push(ValueParamT { LoadResult });
    }
    return true;
}

fn TargetLowering::LegalizeSetCCCondCode(self: *TargetLowering, DAG: *mut SelectionDAG, VT: EVT, LHS: *mut SDValue, RHS: *mut SDValue, CC: *mut SDValue, NeedInvert: *mut bool, dl: *SDLoc, Chain: *mut SDValue, IsSignaling: bool) -> bool {
    let mut OpVT: MVT = LHS.getSimpleValueType();
    let mut CCCode: CondCode = cast(CC).get();
    NeedInvert = false;
    match self.getCondCodeAction(CCCode, OpVT) {
        _ => {
            llvm_unreachable_internal("Unknown condition code action!", "llvm\\lib\\CodeGen\\SelectionDAG\\TargetLowering.cpp", 14230);
        },
        Legal => {
            break;
        },
        Expand => {
            let mut InvCC: CondCode = getSetCCSwappedOperands(CCCode);
            if self.isCondCodeLegalOrCustom(InvCC, OpVT) {
                swap(LHS, RHS);
                CC = DAG.getCondCode(InvCC);
                return true;
            }
            let mut NeedSwap: bool = false;
            InvCC = getSetCCInverse(CCCode, EVT { OpVT });
            if !self.isCondCodeLegalOrCustom(InvCC, OpVT) {
                InvCC = getSetCCSwappedOperands(InvCC);
                NeedSwap = true;
            }
            if self.isCondCodeLegalOrCustom(InvCC, OpVT) {
                CC = DAG.getCondCode(InvCC);
                NeedInvert = true;
                if NeedSwap {
                    swap(LHS, RHS);
                }
                return true;
            }
            if OpVT == i1 {
                let mut Ret: SDValue = SDValue {};
                match CCCode {
                    _ => {
                        llvm_unreachable_internal("Unknown integer setcc!", "llvm\\lib\\CodeGen\\SelectionDAG\\TargetLowering.cpp", 14263);
                    },
                    SETEQ => {
                        Ret = DAG.getNOT(dl, DAG.getNode(XOR, dl, EVT { i1 }, LHS, RHS), EVT { i1 });
                    },
                    SETNE => {
                        Ret = DAG.getNode(XOR, dl, EVT { i1 }, LHS, RHS);
                    },
                    SETGT => {
                        SETULT;
                    },
                    SETLT => {
                        SETUGT;
                    },
                    SETULE => {
                        SETGE;
                    },
                    SETUGE => {
                        SETLE;
                    },
                }
                LHS = DAG.getZExtOrTrunc(Ret, dl, VT);
                RHS = SDValue {};
                CC = SDValue {};
                return true;
            }
            let mut CC1: CondCode = SETCC_INVALID;
            let mut CC2: CondCode = SETCC_INVALID;
            let mut Opc: u32 = 0;
            match CCCode {
                _ => {
                    llvm_unreachable_internal("Don't know how to expand this condition!", "llvm\\lib\\CodeGen\\SelectionDAG\\TargetLowering.cpp", 14303);
                },
                SETUO => {
                    if self.isCondCodeLegal(SETUNE, OpVT) {
                        CC1 = SETUNE;
                        CC2 = SETUNE;
                        Opc = OR;
                        break;
                    }
                },
                SETO => {
                    assert!(self.isCondCodeLegal(SETOEQ, OpVT), "If SETO is expanded, SETOEQ must be legal!");
                },
                SETONE => {
                    SETUEQ;
                },
                SETOEQ => {
                    SETOGT;
                },
                SETLE => {
                    SETGT;
                },
            }
            let mut SetCC1: SDValue = SDValue {};
            let mut SetCC2: SDValue = SDValue {};
            if CCCode != SETO && CCCode != SETUO {
                SetCC1 = DAG.getSetCC(dl, VT, LHS, RHS, CC1, Chain, IsSignaling, SDNodeFlags { Flags: None });
                SetCC2 = DAG.getSetCC(dl, VT, LHS, RHS, CC2, Chain, IsSignaling, SDNodeFlags { Flags: None });
            } else {
                SetCC1 = DAG.getSetCC(dl, VT, LHS, LHS, CC1, Chain, IsSignaling, SDNodeFlags { Flags: None });
                SetCC2 = DAG.getSetCC(dl, VT, RHS, RHS, CC2, Chain, IsSignaling, SDNodeFlags { Flags: None });
            }
            if Chain {
                Chain = DAG.getNode(TokenFactor, dl, EVT { Other }, SetCC1.getValue(1), SetCC2.getValue(1));
            }
            LHS = DAG.getNode(Opc, dl, VT, SetCC1, SetCC2);
            RHS = SDValue {};
            CC = SDValue {};
            return true;
        },
    }
    return false;
}

fn TargetLowering::expandVectorNaryOpBySplitting(self: *TargetLowering, Node: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Node.getValueType(0);
    if !VT.isVector() || !VT.getVectorElementCount().isKnownMultipleOf(2) {
        return SDValue {};
    }
    if LoVT != HiVT || !self.isTypeLegal(LoVT) {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { Node };
    let mut Opcode: u32 = Node.getOpcode();
    if !self.isOperationLegalOrCustomOrPromote(Opcode, LoVT, false) {
        return SDValue {};
    }
    let mut LoOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    let mut HiOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    for V in Node.op_values() {
        if !V.getValueType().isVector() {
            LoOps.push(ValueParamT { V });
            HiOps.push(ValueParamT { V });
            continue;
        }
        LoOps.push(ValueParamT { Lo });
        HiOps.push(ValueParamT { Hi });
    }
    let mut SplitOpLo: SDValue = DAG.getNode(Opcode, DL, LoVT, ArrayRef<SDValue> { LoOps }, Node.getFlags());
    let mut SplitOpHi: SDValue = DAG.getNode(Opcode, DL, HiVT, ArrayRef<SDValue> { HiOps }, Node.getFlags());
    return DAG.getNode(CONCAT_VECTORS, DL, VT, SplitOpLo, SplitOpHi);
}

fn TargetLowering::scalarizeExtractedVectorLoad(self: *TargetLowering, ResultVT: EVT, DL: *SDLoc, InVecVT: EVT, EltNo: SDValue, OriginalLoad: *mut LoadSDNode, DAG: *mut SelectionDAG) -> SDValue {
    assert!(OriginalLoad.isSimple());
    let mut VecEltVT: EVT = InVecVT.getVectorElementType();
    if !VecEltVT.isByteSized() {
        return SDValue {};
    }
    let mut ExtTy: LoadExtType = if ResultVT.bitsGT(VecEltVT) { EXTLOAD } else { NON_EXTLOAD };
    if !self.isOperationLegalOrCustom(LOAD, VecEltVT, false) {
        return SDValue {};
    }
    let mut ByteOffset: optional<unsigned int> = optional<unsigned int> {};
    let mut Alignment: Align = OriginalLoad.getAlign();
    let mut MPI: MachinePointerInfo = MachinePointerInfo { 0, 0 };
    if dyn_cast(EltNo) {
        ConstEltNo;
    } else {
        let mut Elt: i32 = ConstEltNo.getZExtValue();
        ByteOffset = VecEltVT.getSizeInBits() * Elt.operator unsigned long long() / 8;
        MPI = OriginalLoad.getPointerInfo().getWithOffset(operator(ByteOffset));
        Alignment = commonAlignment(Alignment, operator(ByteOffset));
    }
    if !self.shouldReduceLoadWidth(OriginalLoad, ExtTy, VecEltVT, ByteOffset) {
        return SDValue {};
    }
    let mut IsFast: u32 = 0;
    if !self.allowsMemoryAccess(*DAG.getContext(), DAG.getDataLayout(), VecEltVT, OriginalLoad.getAddressSpace(), Alignment, OriginalLoad.getMemOperand().getFlags(), &mut IsFast) || !IsFast {
        return SDValue {};
    }
    let mut NewPtr: SDValue = self.getInboundsVectorElementPointer(DAG, OriginalLoad.getBasePtr(), InVecVT, EltNo);
    let mut Load: SDValue = SDValue {};
    if ResultVT.bitsGT(VecEltVT) {
        let mut ExtType: LoadExtType = if self.isLoadLegal(ResultVT, VecEltVT, Alignment, OriginalLoad.getAddressSpace(), ZEXTLOAD, false) { ZEXTLOAD } else { EXTLOAD };
        Load = DAG.getExtLoad(ExtType, DL, ResultVT, OriginalLoad.getChain(), NewPtr, MPI, VecEltVT, MaybeAlign { Alignment }, OriginalLoad.getMemOperand().getFlags(), MMOMetadata { AAInfo: OriginalLoad.getAAInfo(), Ranges: null, MemCacheHint: null });
        DAG.makeEquivalentMemoryOrdering(OriginalLoad, Load);
    } else {
        Load = DAG.getLoad(VecEltVT, DL, OriginalLoad.getChain(), NewPtr, MPI, MaybeAlign { Alignment }, OriginalLoad.getMemOperand().getFlags(), MMOMetadata { AAInfo: OriginalLoad.getAAInfo(), Ranges: null, MemCacheHint: null });
        DAG.makeEquivalentMemoryOrdering(OriginalLoad, Load);
        if ResultVT.bitsLT(VecEltVT) {
            Load = DAG.getNode(TRUNCATE, DL, ResultVT, Load);
        } else {
            Load = DAG.getBitcast(ResultVT, Load);
        }
    }
    return Load;
}

fn TargetLowering::setTypeIdForCallsiteInfo(self: *TargetLowering, CB: *CallBase, MF: *mut MachineFunction, CSInfo: *mut CallSiteInfo) {
    if CB && CB.isIndirectCall() && (MF.getTarget().Options.EmitCallGraphSection || MF.getTarget().Options.EmitCallSiteInfo) {
        CSInfo = CallSiteInfo { *CB };
    }
}

struct Closure_1 {
    DAG: *mut SelectionDAG,
    OrigCCCode: *mut CondCode,
    VT: *mut EVT,
    NewLHS: *mut SDValue,
    RetVT: *mut EVT,
    NewRHS: *mut SDValue,
    dl: *mut SDLoc,
    CCCode: *mut CondCode,
}

unsafe fn Closure_1::call(self: *mut Closure_1) {
        (*self.DAG).getContext().emitError("no libcall available to soften floating-point " + getCondCodeName((*self.OrigCCCode)) + " compare with type " + (*self.VT).getEVTString());
        (*self.NewLHS) = (*self.DAG).getPOISON((*self.RetVT));
        (*self.NewRHS) = (*self.DAG).getConstant(0, (*self.dl), (*self.RetVT), false, false);
        (*self.CCCode) = SETNE;
    }

struct Closure_2 {
    DemandedElts: *mut APInt,
    ExtOpA: *mut SDValue,
    ExtOpB: *mut SDValue,
    Add2: *mut SDValue,
}

unsafe fn Closure_2::call(self: *mut Closure_2, Op1: SDValue, Op2: SDValue, Op3: SDValue, A: SDValue) -> bool {
        let mut ConstOp: *mut ConstantSDNode = null;
        if (ConstOp = isConstOrConstSplat(Op2, (*self.DemandedElts), false, false)) && ConstOp.isOne() {
            (*self.ExtOpA) = Op1;
            (*self.ExtOpB) = Op3;
            (*self.Add2) = A;
            return true;
        }
        if (ConstOp = isConstOrConstSplat(Op3, (*self.DemandedElts), false, false)) && ConstOp.isOne() {
            (*self.ExtOpA) = Op1;
