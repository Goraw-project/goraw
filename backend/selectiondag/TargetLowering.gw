unsafe fn Closure_32::call(self: *mut Closure_32, Opc: u32, LL: SDValue, LH: SDValue, Const: *APInt, Result: *mut SmallVectorImpl<SDValue>) -> bool {
        let mut LHS: SDValue = (*self.DAG).getNode(BUILD_PAIR, (*self.DL), (*self.VT), LL, LH);
        let mut RHS: SDValue = (*self.DAG).getConstant(Const, (*self.DL), (*self.VT), false, false);
