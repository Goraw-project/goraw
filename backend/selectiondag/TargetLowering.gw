        if (Signed && (*self.HasMULHS)) || (!Signed && (*self.HasMULHU)) {
            Lo = (*self.DAG).getNode(MUL, (*self.dl), (*self.HiLoVT), L, R);
            Hi = (*self.DAG).getNode(if Signed { MULHS } else { MULHU }, (*self.dl), (*self.HiLoVT), L, R);
            return true;
        }
        return false;
