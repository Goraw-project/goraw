struct Closure_36 {
    RoundMode: *mut RoundingMode,
    DAG: *mut SelectionDAG,
    dl: *mut SDLoc,
    IntVT: *mut EVT,
    Zero: *mut SDValue,
    SetCCVT: *mut EVT,
    SignBit: *mut SDValue,
}

unsafe fn Closure_36::call(self: *mut Closure_36, RoundBit: SDValue, StickyBits: SDValue, LSB: SDValue) -> auto {
        match (*self.RoundMode) {
            NearestTiesToEven => {
                let mut StickyOrLSB: SDValue = (*self.DAG).getNode(OR, (*self.dl), (*self.IntVT), StickyBits, LSB);
                return (*self.DAG).getNode(AND, (*self.dl), (*self.IntVT), RoundBit, StickyOrLSB);
            },
            TowardZero => {
                return (*self.Zero);
            },
            TowardPositive => {
                let mut AnyTruncBits: SDValue = (*self.DAG).getNode(OR, (*self.dl), (*self.IntVT), RoundBit, StickyBits);
                let mut HasTruncBits: SDValue = (*self.DAG).getSetCC((*self.dl), (*self.SetCCVT), AnyTruncBits, (*self.Zero), SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
                let mut IsPositive: SDValue = (*self.DAG).getSetCC((*self.dl), (*self.SetCCVT), (*self.SignBit), (*self.Zero), SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
                let mut DoRound: SDValue = (*self.DAG).getNode(AND, (*self.dl), (*self.SetCCVT), HasTruncBits, IsPositive);
                return (*self.DAG).getNode(ZERO_EXTEND, (*self.dl), (*self.IntVT), DoRound);
            },
            TowardNegative => {
                let mut AnyTruncBits: SDValue = (*self.DAG).getNode(OR, (*self.dl), (*self.IntVT), RoundBit, StickyBits);
                let mut HasTruncBits: SDValue = (*self.DAG).getSetCC((*self.dl), (*self.SetCCVT), AnyTruncBits, (*self.Zero), SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
                let mut IsNegative: SDValue = (*self.DAG).getSetCC((*self.dl), (*self.SetCCVT), (*self.SignBit), (*self.Zero), SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
                let mut DoRound: SDValue = (*self.DAG).getNode(AND, (*self.dl), (*self.SetCCVT), HasTruncBits, IsNegative);
                return (*self.DAG).getNode(ZERO_EXTEND, (*self.dl), (*self.IntVT), DoRound);
            },
            NearestTiesToAway => {
                return RoundBit;
            },
            _ => {
                llvm_unreachable_internal("unsupported rounding mode", "llvm\\lib\\CodeGen\\SelectionDAG\\TargetLowering.cpp", 9627);
            },
        }
    }

