                return (*self.DAG).getSelect((*self.DL), (*self.VT), Cond, (*self.Op0), (*self.Op1), SDNodeFlags { Flags: None });
            }
        }
        for CC in [PrefCommuteCC, AltCommuteCC] {
            if (*self.DAG).doesNodeExist(SETCC, BoolVTList, ArrayRef<SDValue> { [(*self.Op0), (*self.Op1), (*self.DAG).getCondCode(CC)] }) {
                let mut Cond: SDValue = (*self.DAG).getSetCC((*self.DL), (*self.BoolVT), (*self.Op0), (*self.Op1), CC, SDValue {}, false, SDNodeFlags { Flags: None });
                return (*self.DAG).getSelect((*self.DL), (*self.VT), Cond, (*self.Op1), (*self.Op0), SDNodeFlags { Flags: None });
            }
        }
        let mut Cond: SDValue = (*self.DAG).getSetCC((*self.DL), (*self.BoolVT), (*self.Op0), (*self.Op1), PrefCC, SDValue {}, false, SDNodeFlags { Flags: None });
        return (*self.DAG).getSelect((*self.DL), (*self.VT), Cond, (*self.Op0), (*self.Op1), SDNodeFlags { Flags: None });
    }

