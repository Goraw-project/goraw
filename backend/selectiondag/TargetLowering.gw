struct Closure_23 {
    ComparingWithAllZeros: *mut bool,
    HadTautologicalInvertedLanes: *mut bool,
    HadTautologicalLanes: *mut bool,
    AllLanesAreTautological: *mut bool,
    AllComparisonsWithNonZerosAreTautological: *mut bool,
    HadEvenDivisor: *mut bool,
    AllDivisorsArePowerOfTwo: *mut bool,
    ShSVT: *mut EVT,
    KAmts: *mut SmallVector<SDValue, 16>,
    DAG: *mut SelectionDAG,
    DL: *mut SDLoc,
    PAmts: *mut SmallVector<SDValue, 16>,
    SVT: *mut EVT,
    QAmts: *mut SmallVector<SDValue, 16>,
}

unsafe fn Closure_23::call(self: *mut Closure_23, CDiv: *mut ConstantSDNode, CCmp: *mut ConstantSDNode) -> bool {
        if CDiv.isZero() {
            return false;
        }
        let mut D: *APInt = CDiv.getAPIntValue();
        let mut Cmp: *APInt = CCmp.getAPIntValue();
        (*self.ComparingWithAllZeros) &= Cmp.isZero();
        let mut TautologicalInvertedLane: bool = D.ule(Cmp);
        (*self.HadTautologicalInvertedLanes) |= TautologicalInvertedLane;
        let mut TautologicalLane: bool = D.isOne() || TautologicalInvertedLane;
        (*self.HadTautologicalLanes) |= TautologicalLane;
        (*self.AllLanesAreTautological) &= TautologicalLane;
        if !Cmp.isZero() {
            (*self.AllComparisonsWithNonZerosAreTautological) &= TautologicalLane;
        }
        let mut K: u32 = D.countr_zero();
        assert!((!D.isOne() || (K == 0)), "For divisor '1' we won't rotate.");
        let mut D0: APInt = D.lshr(K);
        (*self.HadEvenDivisor) |= (K != 0);
        (*self.AllDivisorsArePowerOfTwo) &= D0.isOne();
        let mut W: u32 = D.getBitWidth();
        let mut P: APInt = D0.multiplicativeInverse();
        assert!((D0 * P).isOne(), "Multiplicative inverse basic check failed.");
        let mut Q: APInt = APInt {};
        let mut R: APInt = APInt {};
        udivrem(getAllOnes(W), D, Q, R);
        if Cmp.ugt(R) {
            operator(Q, 1);
        }
        assert!(getAllOnes((*self.ShSVT).getSizeInBits().operator unsigned long long()).ugt(K), "We are expecting that K is always less than all-ones for ShSVT");
        if TautologicalLane {
            P = 0;
            (*self.KAmts).push((*self.DAG).getAllOnesConstant((*self.DL), (*self.ShSVT), false, false));
            Q.setAllBits();
        } else {
            (*self.KAmts).push((*self.DAG).getConstant(K, (*self.DL), (*self.ShSVT), false, false));
        }
        (*self.PAmts).push((*self.DAG).getConstant(P, (*self.DL), (*self.SVT), false, false));
        (*self.QAmts).push((*self.DAG).getConstant(Q, (*self.DL), (*self.SVT), false, false));
        return true;
    }

struct Closure_24 {
    HadOneDivisor: *mut bool,
    AllDivisorsAreOnes: *mut bool,
    HadEvenDivisor: *mut bool,
    AllDivisorsArePowerOfTwo: *mut bool,
    SVT: *mut EVT,
    ShSVT: *mut EVT,
    KAmts: *mut SmallVector<SDValue, 16>,
    DAG: *mut SelectionDAG,
    DL: *mut SDLoc,
    PAmts: *mut SmallVector<SDValue, 16>,
    AAmts: *mut SmallVector<SDValue, 16>,
    QAmts: *mut SmallVector<SDValue, 16>,
}

unsafe fn Closure_24::call(self: *mut Closure_24, C: *mut ConstantSDNode) -> bool {
        if C.isZero() {
            return false;
        }
        let mut D: APInt = C.getAPIntValue().abs();
        (*self.HadOneDivisor) |= D.isOne();
        (*self.AllDivisorsAreOnes) &= D.isOne();
        let mut K: u32 = D.countr_zero();
        assert!((!D.isOne() || (K == 0)), "For divisor '1' we won't rotate.");
        let mut D0: APInt = D.lshr(K);
        (*self.HadEvenDivisor) |= (K != 0);
        (*self.AllDivisorsArePowerOfTwo) &= D0.isOne();
        let mut W: u32 = D.getBitWidth();
        let mut P: APInt = D0.multiplicativeInverse();
        assert!((D0 * P).isOne(), "Multiplicative inverse basic check failed.");
        let mut A: APInt = getSignedMaxValue(W).udiv(D0);
        A.clearLowBits(K);
        let mut Q: APInt = (2 * A).udiv(getOneBitSet(W, K));
        assert!(getAllOnes((*self.SVT).getSizeInBits().operator unsigned long long()).ugt(A), "We are expecting that A is always less than all-ones for SVT");
        assert!(getAllOnes((*self.ShSVT).getSizeInBits().operator unsigned long long()).ugt(K), "We are expecting that K is always less than all-ones for ShSVT");
        if D0.isOne() {
            A = APInt { W, 0, false, false };
            Q = getLowBitsSet(W, W - K);
        }
        if D.isOne() {
            P = 0;
