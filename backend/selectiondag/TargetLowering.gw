fn TargetLowering::~TargetLowering(self) {}

fn TargetLowering::getTargetNodeName(self: *TargetLowering, Opcode: u32) -> *u8 {
    return null;
}

fn TargetLowering::isPositionIndependent(self: *TargetLowering) -> bool {
    return self.getTargetMachine().isPositionIndependent();
}

fn TargetLowering::isInTailCallPosition(self: *TargetLowering, DAG: *mut SelectionDAG, Node: *mut SDNode, Chain: *mut SDValue) -> bool {
    let mut F: *Function = DAG.getMachineFunction().getFunction();
    if F.getFnAttribute("disable-tail-calls").getValueAsBool() {
        return false;
    }
    let mut CallerAttrs: AttrBuilder = AttrBuilder { Ctx: F.getContext(), Attrs: F.getAttributes().getRetAttrs() };
    for Attr in [Alignment, Dereferenceable, DereferenceableOrNull, NoAlias, NonNull, NoUndef, Range, NoFPClass] {
        CallerAttrs.removeAttribute(Attr);
    }
    if CallerAttrs.hasAttributes() {
        return false;
    }
    if CallerAttrs.contains(ZExt) || CallerAttrs.contains(SExt) {
        return false;
    }
    return self.isUsedByReturnOnly(Node, Chain);
}

fn TargetLowering::parametersInCSRMatch(self: *TargetLowering, MRI: *MachineRegisterInfo, CallerPreservedMask: *u32, ArgLocs: *SmallVectorImpl<CCValAssign>, OutVals: *SmallVectorImpl<SDValue>) -> bool {
    for let mut I: u32 = 0;
let mut E: u32 = ArgLocs.len; I != E; I += 1 {
        let mut ArgLoc: *CCValAssign = ArgLocs[I];
        if !ArgLoc.isRegLoc() {
            continue;
        }
        let mut Reg: MCRegister = ArgLoc.getLocReg().operator MCRegister();
        if clobbersPhysReg(CallerPreservedMask, Reg) {
            continue;
        }
        let mut Value: SDValue = OutVals[I];
        if operator(Value).getOpcode() == AssertZext {
            Value = Value.getOperand(0);
        }
        if operator(Value).getOpcode() != CopyFromReg {
            return false;
        }
        let mut ArgReg: Register = cast(operator(Value).getOperand(1)).getReg();
        if MRI.getLiveInPhysReg(ArgReg) != Reg {
            return false;
        }
    }
    return true;
}

fn paramHasAttr(Call: *CallBase, ArgIdx: u32, Kind: AttrKind) -> bool {
    return Call.paramHasAttr(ArgIdx, Kind);
}

fn paramHasAttr(Attrs: *AttributeList, ArgIdx: u32, Kind: AttrKind) -> bool {
    return Attrs.hasParamAttr(ArgIdx, Kind);
}

fn getParamStackAlign(Call: *CallBase, ArgIdx: u32) -> MaybeAlign {
    return Call.getParamStackAlign(ArgIdx);
}

fn getParamStackAlign(Attrs: *AttributeList, ArgIdx: u32) -> MaybeAlign {
    return Attrs.getParamStackAlignment(ArgIdx);
}

fn getParamAlign(Call: *CallBase, ArgIdx: u32) -> MaybeAlign {
    return Call.getParamAlign(ArgIdx);
}

fn getParamAlign(Attrs: *AttributeList, ArgIdx: u32) -> MaybeAlign {
    return Attrs.getParamAlignment(ArgIdx);
}

