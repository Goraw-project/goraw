    ShiftMasks: *mut SmallVector<SDValue, 16>,
}

unsafe fn Closure_18::call(self: *mut Closure_18, C: *mut ConstantSDNode) -> bool {
        if C.isZero() {
            return false;
        }
        let mut Divisor: APInt = C.getAPIntValue().trunc((*self.EltBits));
        let mut magics: SignedDivisionByConstantInfo = get(Divisor);
        let mut NumeratorFactor: i32 = 0;
        let mut ShiftMask: i32 = -1;
        if Divisor.isOne() || Divisor.isAllOnes() {
            NumeratorFactor = Divisor.getSExtValue();
            magics.Magic = 0;
            magics.ShiftAmount = 0;
            ShiftMask = 0;
        } else if Divisor.isStrictlyPositive() && magics.Magic.isNegative() {
            NumeratorFactor = 1;
        } else if Divisor.isNegative() && magics.Magic.isStrictlyPositive() {
            NumeratorFactor = -1;
        }
        (*self.MagicFactors).push((*self.DAG).getConstant(magics.Magic.zext((*self.SVTBits)), (*self.dl), (*self.SVT), false, false));
        (*self.Factors).push((*self.DAG).getSignedConstant(NumeratorFactor, (*self.dl), (*self.SVT), false, false));
        (*self.Shifts).push((*self.DAG).getConstant(magics.ShiftAmount, (*self.dl), (*self.ShSVT), false, false));
        (*self.ShiftMasks).push((*self.DAG).getSignedConstant(ShiftMask, (*self.dl), (*self.SVT), false, false));
        return true;
    }

