unsafe fn Closure_28::call(self: *mut Closure_28, L: SDValue, R: SDValue, Lo: *mut SDValue, Hi: *mut SDValue, Signed: bool) -> auto {
        if (Signed && (*self.HasSMUL_LOHI)) || (!Signed && (*self.HasUMUL_LOHI)) {
            let mut VTs: SDVTList = (*self.DAG).getVTList((*self.HiLoVT), (*self.HiLoVT));
            Lo = (*self.DAG).getNode(if Signed { SMUL_LOHI } else { UMUL_LOHI }, (*self.dl), VTs, L, R);
            Hi = Lo.getValue(1);
