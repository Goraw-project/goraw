fn DAGTypeLegalizer::ScalarizeVecRes_UnaryOpWithExtraInput(self, N: *mut SDNode) -> SDValue {
    let mut Op: SDValue = self.GetScalarizedVector(N.getOperand(0));
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, Op.getValueType(), Op, N.getOperand(1));
}

fn DAGTypeLegalizer::ScalarizeVecRes_FPOp_MultiType(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut LHS: SDValue = self.GetScalarizedVector(N.getOperand(0));
    let mut RHS: SDValue = N.getOperand(1);
    let mut RHSVT: EVT = RHS.getValueType();
    if RHSVT.isVector() {
        if self.getTypeAction(RHSVT) == TypeScalarizeVector {
            RHS = self.GetScalarizedVector(RHS);
        } else {
            RHS = self.DAG.getExtractVectorElt(DL, RHSVT.getVectorElementType(), RHS, 0);
        }
    }
    return self.DAG.getNode(N.getOpcode(), DL, LHS.getValueType(), LHS, RHS, N.getFlags());
}

fn DAGTypeLegalizer::ScalarizeVecRes_INSERT_VECTOR_ELT(self, N: *mut SDNode) -> SDValue {
    let mut Op: SDValue = N.getOperand(1);
    let mut EltVT: EVT = N.getValueType(0).getVectorElementType();
    if Op.getValueType() != EltVT {
        Op = self.DAG.getNode(TRUNCATE, SDLoc { N }, EltVT, Op);
    }
    return Op;
}

fn DAGTypeLegalizer::ScalarizeVecRes_ATOMIC_LOAD(self, N: *mut AtomicSDNode) -> SDValue {
    let mut Result: SDValue = self.DAG.getAtomicLoad(N.getExtensionType(), SDLoc { N }, N.getMemoryVT().getVectorElementType(), N.getValueType(0).getVectorElementType(), N.getChain(), N.getBasePtr(), N.getMemOperand());
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Result.getValue(1));
    return Result;
}

fn DAGTypeLegalizer::ScalarizeVecRes_LOAD(self, N: *mut LoadSDNode) -> SDValue {
    assert!(N.isUnindexed(), "Indexed vector load?");
    let mut Result: SDValue = self.DAG.getLoad(UNINDEXED, N.getExtensionType(), N.getValueType(0).getVectorElementType(), SDLoc { N }, N.getChain(), N.getBasePtr(), self.DAG.getPOISON(N.getBasePtr().getValueType()), N.getPointerInfo(), N.getMemoryVT().getVectorElementType(), N.getBaseAlign(), N.getMemOperand().getFlags(), MMOMetadata { AAInfo: N.getAAInfo(), Ranges: null, MemCacheHint: null });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Result.getValue(1));
    return Result;
}

fn DAGTypeLegalizer::ScalarizeVecRes_UnaryOp(self, N: *mut SDNode) -> SDValue {
    let mut DestVT: EVT = N.getValueType(0).getVectorElementType();
    let mut Op: SDValue = N.getOperand(0);
    let mut OpVT: EVT = Op.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    if self.getTypeAction(OpVT) == TypeScalarizeVector {
        Op = self.GetScalarizedVector(Op);
    } else {
        let mut VT: EVT = OpVT.getVectorElementType();
        Op = self.DAG.getExtractVectorElt(DL, VT, Op, 0);
    }
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, DestVT, Op, N.getFlags());
}

fn DAGTypeLegalizer::ScalarizeVecRes_InregOp(self, N: *mut SDNode) -> SDValue {
    let mut EltVT: EVT = N.getValueType(0).getVectorElementType();
    let mut ExtVT: EVT = cast(N.getOperand(1)).getVT().getVectorElementType();
    let mut LHS: SDValue = self.GetScalarizedVector(N.getOperand(0));
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, EltVT, LHS, self.DAG.getValueType(ExtVT));
}

fn DAGTypeLegalizer::ScalarizeVecRes_VecInregOp(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Op: SDValue = N.getOperand(0);
    let mut OpVT: EVT = Op.getValueType();
    let mut OpEltVT: EVT = OpVT.getVectorElementType();
    let mut EltVT: EVT = N.getValueType(0).getVectorElementType();
    if self.getTypeAction(OpVT) == TypeScalarizeVector {
        Op = self.GetScalarizedVector(Op);
    } else {
        Op = self.DAG.getExtractVectorElt(DL, OpEltVT, Op, 0);
    }
    match N.getOpcode() {
        ANY_EXTEND_VECTOR_INREG => {
            return self.DAG.getNode(ANY_EXTEND, DL, EltVT, Op);
        },
        SIGN_EXTEND_VECTOR_INREG => {
            return self.DAG.getNode(SIGN_EXTEND, DL, EltVT, Op);
        },
        ZERO_EXTEND_VECTOR_INREG => {
            return self.DAG.getNode(ZERO_EXTEND, DL, EltVT, Op);
        },
    }
    llvm_unreachable_internal("Illegal extend_vector_inreg opcode", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeVectorTypes.cpp", 665);
}

fn DAGTypeLegalizer::ScalarizeVecRes_ADDRSPACECAST(self, N: *mut SDNode) -> SDValue {
    let mut DestVT: EVT = N.getValueType(0).getVectorElementType();
    let mut Op: SDValue = N.getOperand(0);
    let mut OpVT: EVT = Op.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    if self.getTypeAction(OpVT) == TypeScalarizeVector {
        Op = self.GetScalarizedVector(Op);
    } else {
        let mut VT: EVT = OpVT.getVectorElementType();
        Op = self.DAG.getExtractVectorElt(DL, VT, Op, 0);
    }
    let mut AddrSpaceCastN: *mut AddrSpaceCastSDNode = cast(N);
    let mut SrcAS: u32 = AddrSpaceCastN.getSrcAddressSpace();
    let mut DestAS: u32 = AddrSpaceCastN.getDestAddressSpace();
    return self.DAG.getAddrSpaceCast(DL, DestVT, Op, SrcAS, DestAS, AddrSpaceCastN.getFlags());
}

fn DAGTypeLegalizer::ScalarizeVecRes_SCALAR_TO_VECTOR(self, N: *mut SDNode) -> SDValue {
    let mut EltVT: EVT = N.getValueType(0).getVectorElementType();
    let mut InOp: SDValue = N.getOperand(0);
    if InOp.getValueType() != EltVT {
        return self.DAG.getNode(TRUNCATE, SDLoc { N }, EltVT, InOp);
    }
    return InOp;
}

fn DAGTypeLegalizer::ScalarizeVecRes_VECTOR_INTERLEAVE_DEINTERLEAVE(self, N: *mut SDNode) -> SDValue {
    assert!(N.getNumValues() == N.getNumOperands(), "Expected one result per operand");
    for let mut I: u32 = 0; I != N.getNumValues(); I += 1 {
        self.SetScalarizedVector(SDValue { Node: N, ResNo: I }, self.GetScalarizedVector(N.getOperand(I)));
    }
    return SDValue {};
}

fn DAGTypeLegalizer::ScalarizeVecRes_VSELECT(self, N: *mut SDNode) -> SDValue {
    let mut Cond: SDValue = N.getOperand(0);
    let mut OpVT: EVT = Cond.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    if self.getTypeAction(OpVT) == TypeScalarizeVector {
        Cond = self.GetScalarizedVector(Cond);
    } else {
        let mut VT: EVT = OpVT.getVectorElementType();
        Cond = self.DAG.getExtractVectorElt(DL, VT, Cond, 0);
    }
    let mut LHS: SDValue = self.GetScalarizedVector(N.getOperand(1));
    let mut ScalarBool: BooleanContent = self.TLI.getBooleanContents(false, false);
    let mut VecBool: BooleanContent = self.TLI.getBooleanContents(true, false);
    if self.TLI.getBooleanContents(false, false) != self.TLI.getBooleanContents(false, true) {
        if operator(Cond).getOpcode() == SETCC {
            let mut OpVT: EVT = operator(Cond).getOperand(0).getValueType();
            ScalarBool = self.TLI.getBooleanContents(OpVT.getScalarType());
            VecBool = self.TLI.getBooleanContents(OpVT);
        } else {
            ScalarBool = UndefinedBooleanContent;
        }
    }
    let mut CondVT: EVT = Cond.getValueType();
    if ScalarBool != VecBool {
        match ScalarBool {
            UndefinedBooleanContent => {
                break;
            },
            ZeroOrOneBooleanContent => {
                assert!(VecBool == UndefinedBooleanContent || VecBool == ZeroOrNegativeOneBooleanContent);
            },
            ZeroOrNegativeOneBooleanContent => {
                assert!(VecBool == UndefinedBooleanContent || VecBool == ZeroOrOneBooleanContent);
            },
        }
    }
    let mut BoolVT: EVT = self.getSetCCResultType(CondVT);
    if BoolVT.bitsLT(CondVT) {
        Cond = self.DAG.getNode(TRUNCATE, SDLoc { N }, BoolVT, Cond);
    }
    return self.DAG.getSelect(SDLoc { N }, LHS.getValueType(), Cond, LHS, self.GetScalarizedVector(N.getOperand(2)), N.getFlags());
}

fn DAGTypeLegalizer::ScalarizeVecRes_SELECT(self, N: *mut SDNode) -> SDValue {
    let mut LHS: SDValue = self.GetScalarizedVector(N.getOperand(1));
    return self.DAG.getSelect(SDLoc { N }, LHS.getValueType(), N.getOperand(0), LHS, self.GetScalarizedVector(N.getOperand(2)), SDNodeFlags { Flags: None });
}

fn DAGTypeLegalizer::ScalarizeVecRes_SELECT_CC(self, N: *mut SDNode) -> SDValue {
    let mut LHS: SDValue = self.GetScalarizedVector(N.getOperand(2));
    return self.DAG.getNode(SELECT_CC, SDLoc { N }, LHS.getValueType(), N.getOperand(0), N.getOperand(1), LHS, self.GetScalarizedVector(N.getOperand(3)), N.getOperand(4));
}

fn DAGTypeLegalizer::ScalarizeVecRes_UNDEF(self, N: *mut SDNode) -> SDValue {
    return self.DAG.getUNDEF(N.getValueType(0).getVectorElementType());
}

fn DAGTypeLegalizer::ScalarizeVecRes_VECTOR_SHUFFLE(self, N: *mut SDNode) -> SDValue {
    let mut Arg: SDValue = N.getOperand(2).getOperand(0);
    if Arg.isUndef() {
        return self.DAG.getUNDEF(N.getValueType(0).getVectorElementType());
    }
    let mut Op: u32 = !cast(Arg).isZero();
    return self.GetScalarizedVector(N.getOperand(Op));
}

fn DAGTypeLegalizer::ScalarizeVecRes_FP_TO_XINT_SAT(self, N: *mut SDNode) -> SDValue {
    let mut Src: SDValue = N.getOperand(0);
    let mut SrcVT: EVT = Src.getValueType();
    let mut dl: SDLoc = SDLoc { N };
    if self.getTypeAction(SrcVT) == TypeScalarizeVector {
        Src = self.GetScalarizedVector(Src);
    } else {
        Src = self.DAG.getNode(EXTRACT_VECTOR_ELT, dl, SrcVT.getVectorElementType(), Src, self.DAG.getConstant(0, dl, EVT { self.TLI.getVectorIdxTy(self.DAG.getDataLayout()) }, false, false));
    }
    let mut DstVT: EVT = N.getValueType(0).getVectorElementType();
    return self.DAG.getNode(N.getOpcode(), dl, DstVT, Src, N.getOperand(1));
}

fn DAGTypeLegalizer::ScalarizeVecRes_SETCC(self, N: *mut SDNode) -> SDValue {
    assert!(N.getValueType(0).isVector() && N.getOperand(0).getValueType().isVector(), "Operand types must be vectors");
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut OpVT: EVT = LHS.getValueType();
    let mut NVT: EVT = N.getValueType(0).getVectorElementType();
    let mut DL: SDLoc = SDLoc { N };
    if self.getTypeAction(OpVT) == TypeScalarizeVector {
        LHS = self.GetScalarizedVector(LHS);
        RHS = self.GetScalarizedVector(RHS);
    } else {
        let mut VT: EVT = OpVT.getVectorElementType();
        LHS = self.DAG.getExtractVectorElt(DL, VT, LHS, 0);
        RHS = self.DAG.getExtractVectorElt(DL, VT, RHS, 0);
    }
    let mut Res: SDValue = self.DAG.getNode(SETCC, DL, EVT { i1 }, LHS, RHS, N.getOperand(2));
    let mut ExtendCode: NodeType = getExtendForContent(self.TLI.getBooleanContents(OpVT));
    return self.DAG.getNode(ExtendCode, DL, NVT, Res);
}

fn DAGTypeLegalizer::ScalarizeVecRes_IS_FPCLASS(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Arg: SDValue = N.getOperand(0);
    let mut Test: SDValue = N.getOperand(1);
    let mut ArgVT: EVT = Arg.getValueType();
    let mut ResultVT: EVT = N.getValueType(0).getVectorElementType();
    if self.getTypeAction(ArgVT) == TypeScalarizeVector {
        Arg = self.GetScalarizedVector(Arg);
    } else {
        let mut VT: EVT = ArgVT.getVectorElementType();
        Arg = self.DAG.getExtractVectorElt(DL, VT, Arg, 0);
    }
    let mut Res: SDValue = self.DAG.getNode(IS_FPCLASS, DL, EVT { i1 }, ArrayRef<SDValue> { [Arg, Test] }, N.getFlags());
    let mut ExtendCode: NodeType = getExtendForContent(self.TLI.getBooleanContents(ArgVT));
    return self.DAG.getNode(ExtendCode, DL, ResultVT, Res);
}

fn DAGTypeLegalizer::ScalarizeVectorOperand(self, N: *mut SDNode, OpNo: u32) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalize-types", 1) {
            dbgs() << "Scalarize node operand " << OpNo << ": ";
            N.dump(&mut self.DAG);
        }
    }
        if !(false) { break; }
    }
    let mut Res: SDValue = SDValue {};
    if self.CustomLowerNode(N, N.getOperand(OpNo).getValueType(), false) {
        return false;
    }
    match N.getOpcode() {
        _ => {
            dbgs() << "ScalarizeVectorOperand Op #" << OpNo << ": ";
        },
        BITCAST => {
            Res = self.ScalarizeVecOp_BITCAST(N);
        },
        FAKE_USE => {
            Res = self.ScalarizeVecOp_FAKE_USE(N);
        },
        ANY_EXTEND => {
            ZERO_EXTEND;
        },
        FP_TO_SINT_SAT => {
            FP_TO_UINT_SAT;
        },
        CONVERT_TO_ARBITRARY_FP => {
            assert!(N.getValueType(0).getVectorNumElements() == 1, "Unexpected vector type!");
            let mut Elt: SDValue = self.GetScalarizedVector(N.getOperand(0));
            let mut Op: SDValue = self.DAG.getNode(N.getOpcode(), SDLoc { N }, N.getValueType(0).getScalarType(), Elt, N.getOperand(1), N.getOperand(2), N.getOperand(3));
            Res = self.DAG.getNode(SCALAR_TO_VECTOR, SDLoc { N }, N.getValueType(0), Op);
            break;
        },
        STRICT_SINT_TO_FP => {
            STRICT_UINT_TO_FP;
        },
        CONCAT_VECTORS => {
            Res = self.ScalarizeVecOp_CONCAT_VECTORS(N);
        },
        INSERT_SUBVECTOR => {
            Res = self.ScalarizeVecOp_INSERT_SUBVECTOR(N, OpNo);
        },
        EXTRACT_VECTOR_ELT => {
            Res = self.ScalarizeVecOp_EXTRACT_VECTOR_ELT(N);
        },
        VSELECT => {
            Res = self.ScalarizeVecOp_VSELECT(N);
        },
        SETCC => {
            Res = self.ScalarizeVecOp_VSETCC(N);
        },
        STRICT_FSETCC => {
            STRICT_FSETCCS;
        },
        STORE => {
            Res = self.ScalarizeVecOp_STORE(cast(N), OpNo);
        },
        ATOMIC_STORE => {
            Res = self.ScalarizeVecOp_ATOMIC_STORE(cast(N));
        },
        STRICT_FP_ROUND => {
            Res = self.ScalarizeVecOp_STRICT_FP_ROUND(N, OpNo);
        },
        FP_ROUND => {
            Res = self.ScalarizeVecOp_FP_ROUND(N, OpNo);
        },
        STRICT_FP_EXTEND => {
            Res = self.ScalarizeVecOp_STRICT_FP_EXTEND(N);
        },
        FP_EXTEND => {
            Res = self.ScalarizeVecOp_FP_EXTEND(N);
        },
        VECREDUCE_FADD => {
            VECREDUCE_FMUL;
        },
        VECREDUCE_SEQ_FADD => {
            VECREDUCE_SEQ_FMUL;
        },
        SCMP => {
            UCMP;
        },
        VECTOR_FIND_LAST_ACTIVE => {
            Res = self.ScalarizeVecOp_VECTOR_FIND_LAST_ACTIVE(N);
        },
        CTTZ_ELTS => {
            CTTZ_ELTS_ZERO_POISON;
        },
        VECTOR_MATCH => {
            Res = self.ScalarizeVecOp_VECTOR_MATCH(N, OpNo);
        },
        MASKED_UDIV => {
            MASKED_SDIV;
        },
    }
    if !Res.getNode() {
        return false;
    }
    if Res.getNode() == N {
        return true;
    }
    assert!(Res.getValueType() == N.getValueType(0) && N.getNumValues() == 1, "Invalid operand expansion");
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Res);
    return false;
}

fn DAGTypeLegalizer::ScalarizeVecOp_BITCAST(self, N: *mut SDNode) -> SDValue {
    let mut Elt: SDValue = self.GetScalarizedVector(N.getOperand(0));
    return self.DAG.getNode(BITCAST, SDLoc { N }, N.getValueType(0), Elt);
}

fn DAGTypeLegalizer::ScalarizeVecOp_FAKE_USE(self, N: *mut SDNode) -> SDValue {
    assert!(N.getOperand(1).getValueType().getVectorNumElements() == 1, "Fake Use: Unexpected vector type!");
    let mut Elt: SDValue = self.GetScalarizedVector(N.getOperand(1));
    return self.DAG.getNode(FAKE_USE, SDLoc {}, EVT { Other }, N.getOperand(0), Elt);
}

fn DAGTypeLegalizer::ScalarizeVecOp_UnaryOp(self, N: *mut SDNode) -> SDValue {
    assert!(N.getValueType(0).getVectorNumElements() == 1, "Unexpected vector type!");
    let mut Elt: SDValue = self.GetScalarizedVector(N.getOperand(0));
    let mut Op: SDValue = self.DAG.getNode(N.getOpcode(), SDLoc { N }, N.getValueType(0).getScalarType(), Elt);
    return self.DAG.getNode(SCALAR_TO_VECTOR, SDLoc { N }, N.getValueType(0), Op);
}

fn DAGTypeLegalizer::ScalarizeVecOp_UnaryOpWithExtraInput(self, N: *mut SDNode) -> SDValue {
    assert!(N.getValueType(0).getVectorNumElements() == 1, "Unexpected vector type!");
    let mut Elt: SDValue = self.GetScalarizedVector(N.getOperand(0));
    let mut Op: SDValue = self.DAG.getNode(N.getOpcode(), SDLoc { N }, N.getValueType(0).getScalarType(), Elt, N.getOperand(1));
    return self.DAG.getNode(SCALAR_TO_VECTOR, SDLoc { N }, N.getValueType(0), Op);
}

fn DAGTypeLegalizer::ScalarizeVecOp_UnaryOp_StrictFP(self, N: *mut SDNode) -> SDValue {
    assert!(N.getValueType(0).getVectorNumElements() == 1, "Unexpected vector type!");
    let mut Elt: SDValue = self.GetScalarizedVector(N.getOperand(1));
    let mut Res: SDValue = self.DAG.getNode(N.getOpcode(), SDLoc { N }, ArrayRef<EVT> { [N.getValueType(0).getScalarType(), EVT { Other }] }, ArrayRef<SDValue> { [N.getOperand(0), Elt] });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
    Res = self.DAG.getNode(SCALAR_TO_VECTOR, SDLoc { N }, N.getValueType(0), Res);
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Res);
    return SDValue {};
}

fn DAGTypeLegalizer::ScalarizeVecOp_CONCAT_VECTORS(self, N: *mut SDNode) -> SDValue {
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { N.getNumOperands() };
    for let mut i: u32 = 0;
let mut e: u32 = N.getNumOperands(); i < e; i += 1 {
        Ops[i] = self.GetScalarizedVector(N.getOperand(i));
    }
    return self.DAG.getBuildVector(N.getValueType(0), SDLoc { N }, ArrayRef<SDValue> { Ops });
}

fn DAGTypeLegalizer::ScalarizeVecOp_INSERT_SUBVECTOR(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 1);
    let mut Elt: SDValue = self.GetScalarizedVector(N.getOperand(1));
    let mut ContainingVec: SDValue = N.getOperand(0);
    return self.DAG.getNode(INSERT_VECTOR_ELT, SDLoc { N }, ContainingVec.getValueType(), ContainingVec, Elt, N.getOperand(2));
}

fn DAGTypeLegalizer::ScalarizeVecOp_EXTRACT_VECTOR_ELT(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut Res: SDValue = self.GetScalarizedVector(N.getOperand(0));
    if Res.getValueType() != VT {
        Res = if VT.isFloatingPoint() { self.DAG.getNode(FP_EXTEND, SDLoc { N }, VT, Res) } else { self.DAG.getNode(ANY_EXTEND, SDLoc { N }, VT, Res) };
    }
    return Res;
}

fn DAGTypeLegalizer::ScalarizeVecOp_VSELECT(self, N: *mut SDNode) -> SDValue {
    let mut ScalarCond: SDValue = self.GetScalarizedVector(N.getOperand(0));
    let mut VT: EVT = N.getValueType(0);
    return self.DAG.getNode(SELECT, SDLoc { N }, VT, ScalarCond, N.getOperand(1), N.getOperand(2));
}

fn DAGTypeLegalizer::ScalarizeVecOp_VSETCC(self, N: *mut SDNode) -> SDValue {
    assert!(N.getValueType(0).isVector() && N.getOperand(0).getValueType().isVector(), "Operand types must be vectors");
    assert!(N.getValueType(0).getVectorNumElements() == 1, "Expected single-element vector type");
    let mut VT: EVT = N.getValueType(0);
    let mut LHS: SDValue = self.GetScalarizedVector(N.getOperand(0));
    let mut RHS: SDValue = self.GetScalarizedVector(N.getOperand(1));
    let mut OpVT: EVT = N.getOperand(0).getValueType();
    let mut NVT: EVT = VT.getVectorElementType();
    let mut DL: SDLoc = SDLoc { N };
    let mut Res: SDValue = self.DAG.getNode(SETCC, DL, EVT { i1 }, LHS, RHS, N.getOperand(2));
    let mut ExtendCode: NodeType = getExtendForContent(self.TLI.getBooleanContents(OpVT));
    Res = self.DAG.getNode(ExtendCode, DL, NVT, Res);
    return self.DAG.getNode(SCALAR_TO_VECTOR, DL, VT, Res);
}

fn DAGTypeLegalizer::ScalarizeVecOp_VSTRICT_FSETCC(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 1, "Wrong operand for scalarization!");
    assert!(N.getValueType(0).isVector() && N.getOperand(1).getValueType().isVector(), "Operand types must be vectors");
    assert!(N.getValueType(0).getVectorNumElements() == 1, "Expected single-element vector type");
    let mut VT: EVT = N.getValueType(0);
    let mut Ch: SDValue = N.getOperand(0);
    let mut LHS: SDValue = self.GetScalarizedVector(N.getOperand(1));
    let mut RHS: SDValue = self.GetScalarizedVector(N.getOperand(2));
    let mut CC: SDValue = N.getOperand(3);
    let mut OpVT: EVT = N.getOperand(1).getValueType();
    let mut NVT: EVT = VT.getVectorElementType();
    let mut DL: SDLoc = SDLoc { N };
    let mut Res: SDValue = self.DAG.getNode(N.getOpcode(), DL, ArrayRef<EVT> { [EVT { i1 }, EVT { Other }] }, ArrayRef<SDValue> { [Ch, LHS, RHS, CC] });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
    let mut ExtendCode: NodeType = getExtendForContent(self.TLI.getBooleanContents(OpVT));
    Res = self.DAG.getNode(ExtendCode, DL, NVT, Res);
    Res = self.DAG.getNode(SCALAR_TO_VECTOR, DL, VT, Res);
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Res);
    return SDValue {};
}

fn DAGTypeLegalizer::ScalarizeVecOp_STORE(self, N: *mut StoreSDNode, OpNo: u32) -> SDValue {
    assert!(N.isUnindexed(), "Indexed store of one-element vector?");
    assert!(OpNo == 1, "Do not know how to scalarize this operand!");
    let mut dl: SDLoc = SDLoc { N };
    if N.isTruncatingStore() {
        return self.DAG.getTruncStore(N.getChain(), dl, self.GetScalarizedVector(N.getOperand(1)), N.getBasePtr(), N.getPointerInfo(), N.getMemoryVT().getVectorElementType(), N.getBaseAlign(), N.getMemOperand().getFlags(), MMOMetadata { AAInfo: N.getAAInfo(), Ranges: null, MemCacheHint: null });
    }
    return self.DAG.getStore(N.getChain(), dl, self.GetScalarizedVector(N.getOperand(1)), N.getBasePtr(), N.getPointerInfo(), N.getBaseAlign(), N.getMemOperand().getFlags(), MMOMetadata { AAInfo: N.getAAInfo(), Ranges: null, MemCacheHint: null });
}

fn DAGTypeLegalizer::ScalarizeVecOp_ATOMIC_STORE(self, N: *mut AtomicSDNode) -> SDValue {
    let mut ScalarVal: SDValue = self.GetScalarizedVector(N.getVal());
    return self.DAG.getAtomic(ATOMIC_STORE, SDLoc { N }, N.getMemoryVT().getVectorElementType(), N.getChain(), ScalarVal, N.getBasePtr(), N.getMemOperand());
}

fn DAGTypeLegalizer::ScalarizeVecOp_FP_ROUND(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 0, "Wrong operand for scalarization!");
    let mut Elt: SDValue = self.GetScalarizedVector(N.getOperand(0));
    let mut Res: SDValue = self.DAG.getNode(FP_ROUND, SDLoc { N }, N.getValueType(0).getVectorElementType(), Elt, N.getOperand(1));
    return self.DAG.getNode(SCALAR_TO_VECTOR, SDLoc { N }, N.getValueType(0), Res);
}

fn DAGTypeLegalizer::ScalarizeVecOp_STRICT_FP_ROUND(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 1, "Wrong operand for scalarization!");
    let mut Elt: SDValue = self.GetScalarizedVector(N.getOperand(1));
    let mut Res: SDValue = self.DAG.getNode(STRICT_FP_ROUND, SDLoc { N }, ArrayRef<EVT> { [N.getValueType(0).getVectorElementType(), EVT { Other }] }, ArrayRef<SDValue> { [N.getOperand(0), Elt, N.getOperand(2)] });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
    Res = self.DAG.getNode(SCALAR_TO_VECTOR, SDLoc { N }, N.getValueType(0), Res);
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Res);
    return SDValue {};
}

fn DAGTypeLegalizer::ScalarizeVecOp_FP_EXTEND(self, N: *mut SDNode) -> SDValue {
    let mut Elt: SDValue = self.GetScalarizedVector(N.getOperand(0));
    let mut Res: SDValue = self.DAG.getNode(FP_EXTEND, SDLoc { N }, N.getValueType(0).getVectorElementType(), Elt);
    return self.DAG.getNode(SCALAR_TO_VECTOR, SDLoc { N }, N.getValueType(0), Res);
}

fn DAGTypeLegalizer::ScalarizeVecOp_STRICT_FP_EXTEND(self, N: *mut SDNode) -> SDValue {
    let mut Elt: SDValue = self.GetScalarizedVector(N.getOperand(1));
    let mut Res: SDValue = self.DAG.getNode(STRICT_FP_EXTEND, SDLoc { N }, ArrayRef<EVT> { [N.getValueType(0).getVectorElementType(), EVT { Other }] }, ArrayRef<SDValue> { [N.getOperand(0), Elt] });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
    Res = self.DAG.getNode(SCALAR_TO_VECTOR, SDLoc { N }, N.getValueType(0), Res);
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Res);
    return SDValue {};
}

fn DAGTypeLegalizer::ScalarizeVecOp_VECREDUCE(self, N: *mut SDNode) -> SDValue {
    let mut Res: SDValue = self.GetScalarizedVector(N.getOperand(0));
    if Res.getValueType() != N.getValueType(0) {
        Res = self.DAG.getNode(ANY_EXTEND, SDLoc { N }, N.getValueType(0), Res);
    }
    return Res;
}

fn DAGTypeLegalizer::ScalarizeVecOp_VECREDUCE_SEQ(self, N: *mut SDNode) -> SDValue {
    let mut AccOp: SDValue = N.getOperand(0);
    let mut VecOp: SDValue = N.getOperand(1);
    let mut BaseOpc: u32 = getVecReduceBaseOpcode(N.getOpcode());
    let mut Op: SDValue = self.GetScalarizedVector(VecOp);
    return self.DAG.getNode(BaseOpc, SDLoc { N }, N.getValueType(0), AccOp, Op, N.getFlags());
}

fn DAGTypeLegalizer::ScalarizeVecOp_CMP(self, N: *mut SDNode) -> SDValue {
    let mut LHS: SDValue = self.GetScalarizedVector(N.getOperand(0));
    let mut RHS: SDValue = self.GetScalarizedVector(N.getOperand(1));
    let mut ResVT: EVT = N.getValueType(0).getVectorElementType();
    let mut Cmp: SDValue = self.DAG.getNode(N.getOpcode(), SDLoc { N }, ResVT, LHS, RHS);
    return self.DAG.getNode(SCALAR_TO_VECTOR, SDLoc { N }, N.getValueType(0), Cmp);
}

fn DAGTypeLegalizer::ScalarizeVecOp_VECTOR_FIND_LAST_ACTIVE(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    return self.DAG.getConstant(0, SDLoc { N }, VT, false, false);
}

fn DAGTypeLegalizer::ScalarizeVecOp_CTTZ_ELTS(self, N: *mut SDNode) -> SDValue {
    if N.getOpcode() == CTTZ_ELTS_ZERO_POISON {
        return self.DAG.getConstant(0, SDLoc { N }, N.getValueType(0), false, false);
    }
    let mut Op: SDValue = self.GetScalarizedVector(N.getOperand(0));
    let mut SetCC: SDValue = self.DAG.getSetCC(SDLoc { N }, EVT { i1 }, Op, self.DAG.getConstant(0, SDLoc { N }, Op.getValueType(), false, false), SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
    return self.DAG.getZExtOrTrunc(SetCC, SDLoc { N }, N.getValueType(0));
}

fn DAGTypeLegalizer::ScalarizeVecRes_VECTOR_MATCH(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Mask: SDValue = self.TLI.expandVectorMatch(N, self.DAG);
    return self.DAG.getNode(EXTRACT_VECTOR_ELT, DL, N.getValueType(0).getScalarType(), Mask, self.DAG.getVectorIdxConstant(0, DL, false));
}

fn DAGTypeLegalizer::ScalarizeVecOp_VECTOR_MATCH(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    return self.TLI.expandVectorMatch(N, self.DAG);
}

fn DAGTypeLegalizer::ScalarizeVecOp_MaskedBinOp(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 2, "Can only scalarize mask operand");
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getOperand(0).getValueType().getVectorElementType();
    let mut LHS: SDValue = self.DAG.getExtractVectorElt(DL, VT, N.getOperand(0), 0);
    let mut RHS: SDValue = self.DAG.getExtractVectorElt(DL, VT, N.getOperand(1), 0);
    let mut Mask: SDValue = self.GetScalarizedVector(N.getOperand(2));
    Mask = self.DAG.getNode(TRUNCATE, DL, EVT { i1 }, Mask);
    let mut BinOp: SDValue = self.DAG.getNode(getUnmaskedBinOpOpcode(N.getOpcode()), DL, VT, LHS, self.DAG.getSelect(DL, VT, Mask, RHS, self.DAG.getConstant(1, DL, VT, false, false), SDNodeFlags { Flags: None }));
    return self.DAG.getNode(SCALAR_TO_VECTOR, DL, N.getValueType(0), BinOp);
}

fn DAGTypeLegalizer::SplitVectorResult(self, N: *mut SDNode, ResNo: u32) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalize-types", 1) {
            dbgs() << "Split node result: ";
            N.dump(&mut self.DAG);
        }
    }
        if !(false) { break; }
    }
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    if self.CustomLowerNode(N, N.getValueType(ResNo), true) {
        return;
    }
    match N.getOpcode() {
        _ => {
            dbgs() << "SplitVectorResult #" << ResNo << ": ";
        },
        LOOP_DEPENDENCE_RAW_MASK => {
            LOOP_DEPENDENCE_WAR_MASK;
        },
        MERGE_VALUES => {
            self.SplitRes_MERGE_VALUES(N, ResNo, Lo, Hi);
        },
        AssertZext => {
            self.SplitVecRes_AssertZext(N, Lo, Hi);
        },
        AssertSext => {
            self.SplitVecRes_AssertSext(N, Lo, Hi);
        },
        VSELECT => {
            SELECT;
        },
        SELECT_CC => {
            self.SplitRes_SELECT_CC(N, Lo, Hi);
        },
        POISON => {
            UNDEF;
        },
        BITCAST => {
            self.SplitVecRes_BITCAST(N, Lo, Hi);
        },
        BUILD_VECTOR => {
            self.SplitVecRes_BUILD_VECTOR(N, Lo, Hi);
        },
        CONCAT_VECTORS => {
            self.SplitVecRes_CONCAT_VECTORS(N, Lo, Hi);
        },
        EXTRACT_SUBVECTOR => {
            self.SplitVecRes_EXTRACT_SUBVECTOR(N, Lo, Hi);
        },
        INSERT_SUBVECTOR => {
            self.SplitVecRes_INSERT_SUBVECTOR(N, Lo, Hi);
        },
        FPOWI => {
            FLDEXP;
        },
        IS_FPCLASS => {
            self.SplitVecRes_IS_FPCLASS(N, Lo, Hi);
        },
        INSERT_VECTOR_ELT => {
            self.SplitVecRes_INSERT_VECTOR_ELT(N, Lo, Hi);
        },
        SPLAT_VECTOR => {
            SCALAR_TO_VECTOR;
        },
        STEP_VECTOR => {
            self.SplitVecRes_STEP_VECTOR(N, Lo, Hi);
        },
        SIGN_EXTEND_INREG => {
            self.SplitVecRes_InregOp(N, Lo, Hi);
        },
        ATOMIC_LOAD => {
            self.SplitVecRes_ATOMIC_LOAD(cast(N), Lo, Hi);
        },
        LOAD => {
            self.SplitVecRes_LOAD(cast(N), Lo, Hi);
        },
        VP_LOAD => {
            self.SplitVecRes_VP_LOAD(cast(N), Lo, Hi);
        },
        VP_LOAD_FF => {
            self.SplitVecRes_VP_LOAD_FF(cast(N), Lo, Hi);
        },
        EXPERIMENTAL_VP_STRIDED_LOAD => {
            self.SplitVecRes_VP_STRIDED_LOAD(cast(N), Lo, Hi);
        },
        MLOAD => {
            self.SplitVecRes_MLOAD(cast(N), Lo, Hi);
        },
        MGATHER => {
            VP_GATHER;
        },
        VECTOR_COMPRESS => {
            self.SplitVecRes_VECTOR_COMPRESS(N, Lo, Hi);
        },
        SETCC => {
            self.SplitVecRes_SETCC(N, Lo, Hi);
        },
        VECTOR_REPEAT => {
            self.SplitVecRes_VECTOR_REPEAT(N, Lo, Hi);
        },
        VECTOR_REVERSE => {
            self.SplitVecRes_VECTOR_REVERSE(N, Lo, Hi);
        },
        VECTOR_SHUFFLE => {
            self.SplitVecRes_VECTOR_SHUFFLE(cast(N), Lo, Hi);
        },
        VECTOR_SPLICE_LEFT => {
            VECTOR_SPLICE_RIGHT;
        },
        VECTOR_DEINTERLEAVE => {
            self.SplitVecRes_VECTOR_DEINTERLEAVE(N);
        },
        VECTOR_INTERLEAVE => {
            self.SplitVecRes_VECTOR_INTERLEAVE(N);
        },
        VAARG => {
            self.SplitVecRes_VAARG(N, Lo, Hi);
        },
        ANY_EXTEND_VECTOR_INREG => {
            SIGN_EXTEND_VECTOR_INREG;
        },
        ABS => {
            ABS_MIN_POISON;
        },
        ADDRSPACECAST => {
            self.SplitVecRes_ADDRSPACECAST(N, Lo, Hi);
        },
        FMODF => {
            FFREXP;
        },
        ANY_EXTEND => {
            SIGN_EXTEND;
        },
        ADD => {
            SUB;
        },
        MASKED_UDIV => {
            MASKED_SDIV;
        },
        FMA => {
            FSHL;
        },
        SCMP => {
            UCMP;
        },
        STRICT_FADD => {
            STRICT_FSUB;
        },
        FP_TO_UINT_SAT => {
            FP_TO_SINT_SAT;
        },
        UADDO => {
            SADDO;
        },
        SMULFIX => {
            SMULFIXSAT;
        },
        EXPERIMENTAL_VP_SPLICE => {
            self.SplitVecRes_VP_SPLICE(N, Lo, Hi);
        },
        EXPERIMENTAL_VP_REVERSE => {
            self.SplitVecRes_VP_REVERSE(N, Lo, Hi);
        },
        PARTIAL_REDUCE_UMLA => {
            PARTIAL_REDUCE_SMLA;
        },
        GET_ACTIVE_LANE_MASK => {
            self.SplitVecRes_GET_ACTIVE_LANE_MASK(N, Lo, Hi);
        },
        VECTOR_MATCH => {
            self.SplitVecRes_VECTOR_MATCH(N, Lo, Hi);
        },
    }
    if Lo.getNode() {
        self.SetSplitVector(SDValue { Node: N, ResNo: ResNo }, Lo, Hi);
    }
}

fn DAGTypeLegalizer::IncrementPointer(self, N: *mut MemSDNode, MemVT: EVT, MPI: *mut MachinePointerInfo, Ptr: *mut SDValue, ScaledOffset: *mut u64) {
    let mut DL: SDLoc = SDLoc { N };
    let mut IncrementSize: u32 = MemVT.getSizeInBits().getKnownMinValue() / 8;
    if MemVT.isScalableVector() {
        let mut BytesIncrement: SDValue = self.DAG.getVScale(DL, Ptr.getValueType(), APInt { Ptr.getValueSizeInBits().getFixedValue(), IncrementSize, false, false });
        MPI = MachinePointerInfo { N.getPointerInfo().getAddrSpace(), 0 };
        if ScaledOffset {
            *ScaledOffset += IncrementSize;
        }
        Ptr = self.DAG.getNode(ADD, DL, Ptr.getValueType(), Ptr, BytesIncrement, SDNodeFlags { Flags: NoUnsignedWrap });
    } else {
        MPI = N.getPointerInfo().getWithOffset(IncrementSize);
        Ptr = self.DAG.getObjectPtrOffset(DL, Ptr, getFixed(IncrementSize));
    }
}

fn DAGTypeLegalizer::SplitMask(self, Mask: SDValue) -> pair<SDValue, SDValue> {
    return self.SplitMask(Mask, SDLoc { Mask });
}

fn DAGTypeLegalizer::SplitMask(self, Mask: SDValue, DL: *SDLoc) -> pair<SDValue, SDValue> {
    let mut MaskLo: SDValue = SDValue {};
    let mut MaskHi: SDValue = SDValue {};
    let mut MaskVT: EVT = Mask.getValueType();
    if self.getTypeAction(MaskVT) == TypeSplitVector {
        self.GetSplitVector(Mask, MaskLo, MaskHi);
    } else {
        tie(MaskLo, MaskHi) = self.DAG.SplitVector(Mask, DL);
    }
    return make_pair(MaskLo, MaskHi);
}

fn DAGTypeLegalizer::SplitVecRes_BinOp(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut LHSLo: SDValue = SDValue {};
    let mut LHSHi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(0), LHSLo, LHSHi);
    let mut RHSLo: SDValue = SDValue {};
    let mut RHSHi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(1), RHSLo, RHSHi);
    let mut dl: SDLoc = SDLoc { N };
    let mut Flags: SDNodeFlags = N.getFlags();
    let mut Opcode: u32 = N.getOpcode();
    if N.getNumOperands() == 2 {
        Lo = self.DAG.getNode(Opcode, dl, LHSLo.getValueType(), LHSLo, RHSLo, Flags);
        Hi = self.DAG.getNode(Opcode, dl, LHSHi.getValueType(), LHSHi, RHSHi, Flags);
        return;
    }
    assert!(N.getNumOperands() == 4, "Unexpected number of operands!");
    assert!((N.getOpcode() == VP_UDIV || N.getOpcode() == VP_SDIV || N.getOpcode() == VP_UREM || N.getOpcode() == VP_SREM), "Expected VP opcode");
    let mut MaskLo: SDValue = SDValue {};
    let mut MaskHi: SDValue = SDValue {};
    tie(MaskLo, MaskHi) = self.SplitMask(N.getOperand(2));
    let mut EVLLo: SDValue = SDValue {};
    let mut EVLHi: SDValue = SDValue {};
    tie(EVLLo, EVLHi) = self.DAG.SplitEVL(N.getOperand(3), N.getValueType(0), dl);
    Lo = self.DAG.getNode(Opcode, dl, LHSLo.getValueType(), ArrayRef<SDValue> { [LHSLo, RHSLo, MaskLo, EVLLo] }, Flags);
    Hi = self.DAG.getNode(Opcode, dl, LHSHi.getValueType(), ArrayRef<SDValue> { [LHSHi, RHSHi, MaskHi, EVLHi] }, Flags);
}

fn DAGTypeLegalizer::SplitVecRes_MaskedBinOp(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut LHSLo: SDValue = SDValue {};
    let mut LHSHi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(0), LHSLo, LHSHi);
    let mut RHSLo: SDValue = SDValue {};
    let mut RHSHi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(1), RHSLo, RHSHi);
    let mut MaskLo: SDValue = SDValue {};
    let mut MaskHi: SDValue = SDValue {};
    let mut Mask: SDValue = N.getOperand(2);
    if Mask.getOpcode() == SETCC {
        self.SplitVecRes_SETCC(Mask.getNode(), MaskLo, MaskHi);
    } else {
        tie(MaskLo, MaskHi) = self.SplitMask(Mask);
    }
    let mut dl: SDLoc = SDLoc { N };
    let mut Flags: SDNodeFlags = N.getFlags();
    let mut Opcode: u32 = N.getOpcode();
    Lo = self.DAG.getNode(Opcode, dl, LHSLo.getValueType(), LHSLo, RHSLo, MaskLo, Flags);
    Hi = self.DAG.getNode(Opcode, dl, LHSHi.getValueType(), LHSHi, RHSHi, MaskHi, Flags);
}

fn DAGTypeLegalizer::SplitVecRes_TernaryOp(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut Op0Lo: SDValue = SDValue {};
    let mut Op0Hi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(0), Op0Lo, Op0Hi);
    let mut Op1Lo: SDValue = SDValue {};
    let mut Op1Hi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(1), Op1Lo, Op1Hi);
    let mut Op2Lo: SDValue = SDValue {};
    let mut Op2Hi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(2), Op2Lo, Op2Hi);
    let mut dl: SDLoc = SDLoc { N };
    let mut Flags: SDNodeFlags = N.getFlags();
    let mut Opcode: u32 = N.getOpcode();
    Lo = self.DAG.getNode(Opcode, dl, Op0Lo.getValueType(), Op0Lo, Op1Lo, Op2Lo, Flags);
    Hi = self.DAG.getNode(Opcode, dl, Op0Hi.getValueType(), Op0Hi, Op1Hi, Op2Hi, Flags);
}

fn DAGTypeLegalizer::SplitVecRes_CMP(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut Ctxt: *mut LLVMContext = *self.DAG.getContext();
    let mut dl: SDLoc = SDLoc { N };
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut LHSLo: SDValue = SDValue {};
    let mut LHSHi: SDValue = SDValue {};
    let mut RHSLo: SDValue = SDValue {};
    let mut RHSHi: SDValue = SDValue {};
    if self.getTypeAction(LHS.getValueType()) == TypeSplitVector {
        self.GetSplitVector(LHS, LHSLo, LHSHi);
        self.GetSplitVector(RHS, RHSLo, RHSHi);
    } else {
        tie(LHSLo, LHSHi) = self.DAG.SplitVector(LHS, dl);
        tie(RHSLo, RHSHi) = self.DAG.SplitVector(RHS, dl);
    }
    let mut SplitResVT: EVT = N.getValueType(0).getHalfNumVectorElementsVT(Ctxt);
    Lo = self.DAG.getNode(N.getOpcode(), dl, SplitResVT, LHSLo, RHSLo);
    Hi = self.DAG.getNode(N.getOpcode(), dl, SplitResVT, LHSHi, RHSHi);
}

fn DAGTypeLegalizer::SplitVecRes_FIX(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut LHSLo: SDValue = SDValue {};
    let mut LHSHi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(0), LHSLo, LHSHi);
    let mut RHSLo: SDValue = SDValue {};
    let mut RHSHi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(1), RHSLo, RHSHi);
    let mut dl: SDLoc = SDLoc { N };
    let mut Op2: SDValue = N.getOperand(2);
    let mut Opcode: u32 = N.getOpcode();
    Lo = self.DAG.getNode(Opcode, dl, LHSLo.getValueType(), LHSLo, RHSLo, Op2, N.getFlags());
    Hi = self.DAG.getNode(Opcode, dl, LHSHi.getValueType(), LHSHi, RHSHi, Op2, N.getFlags());
}

fn DAGTypeLegalizer::SplitVecRes_BITCAST(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(N.getValueType(0));
    let mut dl: SDLoc = SDLoc { N };
    let mut InOp: SDValue = N.getOperand(0);
    let mut InVT: EVT = InOp.getValueType();
    match self.getTypeAction(InVT) {
        TypeLegal => {
            TypePromoteInteger;
        },
        TypeExpandInteger => {
            TypeExpandFloat;
        },
        TypeSplitVector => {
            self.GetSplitVector(InOp, Lo, Hi);
        },
        TypeScalarizeScalableVector => {
            report_fatal_error("Scalarization of scalable vectors is not supported.", true);
        },
    }
    if LoVT.isScalableVector() {
        Lo = self.DAG.getNode(BITCAST, dl, LoVT, InLo);
        Hi = self.DAG.getNode(BITCAST, dl, HiVT, InHi);
        return;
    }
    let mut LoIntVT: EVT = getIntegerVT(*self.DAG.getContext(), LoVT.getSizeInBits().operator unsigned long long());
    let mut HiIntVT: EVT = getIntegerVT(*self.DAG.getContext(), HiVT.getSizeInBits().operator unsigned long long());
    if self.DAG.getDataLayout().isBigEndian() {
        swap(LoIntVT, HiIntVT);
    }
    self.SplitInteger(self.BitConvertToInteger(InOp), LoIntVT, HiIntVT, Lo, Hi);
    if self.DAG.getDataLayout().isBigEndian() {
        swap(Lo, Hi);
    }
    Lo = self.DAG.getNode(BITCAST, dl, LoVT, Lo);
    Hi = self.DAG.getNode(BITCAST, dl, HiVT, Hi);
}

fn DAGTypeLegalizer::SplitVecRes_LOOP_DEPENDENCE_MASK(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut DL: SDLoc = SDLoc { N };
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    let mut PtrA: SDValue = N.getOperand(0);
    let mut PtrB: SDValue = N.getOperand(1);
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(N.getValueType(0));
    Lo = self.DAG.getNode(N.getOpcode(), DL, LoVT, PtrA, PtrB, N.getOperand(2), N.getOperand(3));
    let mut LaneOffset: u32 = N.getConstantOperandVal(3) + LoVT.getVectorMinNumElements();
    Hi = self.DAG.getNode(N.getOpcode(), DL, HiVT, PtrA, PtrB, N.getOperand(2), self.DAG.getConstant(LaneOffset, DL, EVT { i64 }, false, false));
}

fn DAGTypeLegalizer::SplitVecRes_BUILD_VECTOR(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    let mut dl: SDLoc = SDLoc { N };
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(N.getValueType(0));
    let mut LoNumElts: u32 = LoVT.getVectorNumElements();
    let mut LoOps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { N.op_begin(), N.op_begin() + LoNumElts };
    Lo = self.DAG.getBuildVector(LoVT, dl, ArrayRef<SDValue> { LoOps });
    let mut HiOps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { N.op_begin() + LoNumElts, N.op_end() };
    Hi = self.DAG.getBuildVector(HiVT, dl, ArrayRef<SDValue> { HiOps });
}

fn DAGTypeLegalizer::SplitVecRes_CONCAT_VECTORS(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    assert!(!(N.getNumOperands() & 1), "Unsupported CONCAT_VECTORS");
    let mut dl: SDLoc = SDLoc { N };
    let mut NumSubvectors: u32 = N.getNumOperands() / 2;
    if NumSubvectors == 1 {
        Lo = N.getOperand(0);
        Hi = N.getOperand(1);
        return;
    }
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(N.getValueType(0));
    let mut LoOps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { N.op_begin(), N.op_begin() + NumSubvectors };
    Lo = self.DAG.getNode(CONCAT_VECTORS, dl, LoVT, ArrayRef<SDValue> { LoOps });
    let mut HiOps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { N.op_begin() + NumSubvectors, N.op_end() };
    Hi = self.DAG.getNode(CONCAT_VECTORS, dl, HiVT, ArrayRef<SDValue> { HiOps });
}

fn DAGTypeLegalizer::SplitVecRes_EXTRACT_SUBVECTOR(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut Vec: SDValue = N.getOperand(0);
    let mut Idx: SDValue = N.getOperand(1);
    let mut dl: SDLoc = SDLoc { N };
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(N.getValueType(0));
    Lo = self.DAG.getNode(EXTRACT_SUBVECTOR, dl, LoVT, Vec, Idx);
    let mut IdxVal: u64 = operator(Idx).getAsZExtVal();
    Hi = self.DAG.getNode(EXTRACT_SUBVECTOR, dl, HiVT, Vec, self.DAG.getVectorIdxConstant(IdxVal + LoVT.getVectorMinNumElements(), dl, false));
}

fn DAGTypeLegalizer::SplitVecRes_INSERT_SUBVECTOR(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut Vec: SDValue = N.getOperand(0);
    let mut SubVec: SDValue = N.getOperand(1);
    let mut Idx: SDValue = N.getOperand(2);
    let mut dl: SDLoc = SDLoc { N };
    self.GetSplitVector(Vec, Lo, Hi);
    let mut VecVT: EVT = Vec.getValueType();
    let mut LoVT: EVT = Lo.getValueType();
    let mut SubVecVT: EVT = SubVec.getValueType();
    let mut VecElems: u32 = VecVT.getVectorMinNumElements();
    let mut SubElems: u32 = SubVecVT.getVectorMinNumElements();
    let mut LoElems: u32 = LoVT.getVectorMinNumElements();
    let mut IdxVal: u32 = operator(Idx).getAsZExtVal();
    if IdxVal + SubElems <= LoElems {
        Lo = self.DAG.getNode(INSERT_SUBVECTOR, dl, LoVT, Lo, SubVec, Idx);
        return;
    }
    if VecVT.isScalableVector() == SubVecVT.isScalableVector() && IdxVal >= LoElems && IdxVal + SubElems <= VecElems {
        Hi = self.DAG.getNode(INSERT_SUBVECTOR, dl, Hi.getValueType(), Hi, SubVec, self.DAG.getVectorIdxConstant(IdxVal - LoElems, dl, false));
        return;
    }
    if self.getTypeAction(SubVecVT) == TypeWidenVector && Vec.isUndef() && SubVecVT.getVectorElementType() == EVT { i1 } {
        let mut WideSubVec: SDValue = self.GetWidenedVector(SubVec);
        if WideSubVec.getValueType() == VecVT {
            tie(Lo, Hi) = self.DAG.SplitVector(WideSubVec, SDLoc { WideSubVec });
            return;
        }
    }
    let mut SmallestAlign: Align = self.DAG.getReducedAlign(VecVT, false);
    let mut StackPtr: SDValue = self.DAG.CreateStackTemporary(VecVT.getStoreSize(), SmallestAlign);
    let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
    let mut FrameIndex: i32 = cast(StackPtr.getNode()).getIndex();
    let mut PtrInfo: MachinePointerInfo = getFixedStack(MF, FrameIndex, 0);
    let mut Store: SDValue = self.DAG.getStore(self.DAG.getEntryNode(), dl, Vec, StackPtr, PtrInfo, SmallestAlign, MONone, MMOMetadata {});
    let mut SubVecPtr: SDValue = self.TLI.getVectorSubVecPointer(self.DAG, StackPtr, VecVT, SubVecVT, Idx, SDNodeFlags { Flags: None });
    Store = self.DAG.getStore(Store, dl, SubVec, SubVecPtr, getUnknownStack(MF), MaybeAlign {}, MONone, MMOMetadata {});
    Lo = self.DAG.getLoad(Lo.getValueType(), dl, Store, StackPtr, PtrInfo, MaybeAlign { SmallestAlign }, MONone, MMOMetadata {});
    let mut Load: *mut LoadSDNode = cast(Lo);
    let mut MPI: MachinePointerInfo = Load.getPointerInfo();
    self.IncrementPointer(Load, LoVT, MPI, StackPtr, null);
    Hi = self.DAG.getLoad(Hi.getValueType(), dl, Store, StackPtr, MPI, MaybeAlign { SmallestAlign }, MONone, MMOMetadata {});
}

fn DAGTypeLegalizer::SplitVecRes_FPOp_MultiType(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut LHSLo: SDValue = SDValue {};
    let mut LHSHi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(0), LHSLo, LHSHi);
    let mut DL: SDLoc = SDLoc { N };
    let mut RHSLo: SDValue = SDValue {};
    let mut RHSHi: SDValue = SDValue {};
    let mut RHS: SDValue = N.getOperand(1);
    let mut RHSVT: EVT = RHS.getValueType();
    if RHSVT.isVector() {
        if self.getTypeAction(RHSVT) == TypeSplitVector {
            self.GetSplitVector(RHS, RHSLo, RHSHi);
        } else {
            tie(RHSLo, RHSHi) = self.DAG.SplitVector(RHS, SDLoc { RHS });
        }
        Lo = self.DAG.getNode(N.getOpcode(), DL, LHSLo.getValueType(), LHSLo, RHSLo);
        Hi = self.DAG.getNode(N.getOpcode(), DL, LHSHi.getValueType(), LHSHi, RHSHi);
    } else {
        Lo = self.DAG.getNode(N.getOpcode(), DL, LHSLo.getValueType(), LHSLo, RHS);
        Hi = self.DAG.getNode(N.getOpcode(), DL, LHSHi.getValueType(), LHSHi, RHS);
    }
}

fn DAGTypeLegalizer::SplitVecRes_IS_FPCLASS(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut DL: SDLoc = SDLoc { N };
    let mut ArgLo: SDValue = SDValue {};
    let mut ArgHi: SDValue = SDValue {};
    let mut Test: SDValue = N.getOperand(1);
    let mut FpValue: SDValue = N.getOperand(0);
    if self.getTypeAction(FpValue.getValueType()) == TypeSplitVector {
        self.GetSplitVector(FpValue, ArgLo, ArgHi);
    } else {
        tie(ArgLo, ArgHi) = self.DAG.SplitVector(FpValue, SDLoc { FpValue });
    }
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(N.getValueType(0));
    Lo = self.DAG.getNode(IS_FPCLASS, DL, LoVT, ArgLo, Test, N.getFlags());
    Hi = self.DAG.getNode(IS_FPCLASS, DL, HiVT, ArgHi, Test, N.getFlags());
}

fn DAGTypeLegalizer::SplitVecRes_InregOp(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut LHSLo: SDValue = SDValue {};
    let mut LHSHi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(0), LHSLo, LHSHi);
    let mut dl: SDLoc = SDLoc { N };
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(cast(N.getOperand(1)).getVT());
    Lo = self.DAG.getNode(N.getOpcode(), dl, LHSLo.getValueType(), LHSLo, self.DAG.getValueType(LoVT));
    Hi = self.DAG.getNode(N.getOpcode(), dl, LHSHi.getValueType(), LHSHi, self.DAG.getValueType(HiVT));
}

fn DAGTypeLegalizer::SplitVecRes_ExtVecInRegOp(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut Opcode: u32 = N.getOpcode();
    let mut N0: SDValue = N.getOperand(0);
    let mut dl: SDLoc = SDLoc { N };
    let mut InLo: SDValue = SDValue {};
    let mut InHi: SDValue = SDValue {};
    if self.getTypeAction(N0.getValueType()) == TypeSplitVector {
        self.GetSplitVector(N0, InLo, InHi);
    } else {
        tie(InLo, InHi) = self.DAG.SplitVectorOperand(N, 0);
    }
    let mut InLoVT: EVT = InLo.getValueType();
    let mut InNumElements: u32 = InLoVT.getVectorNumElements();
    let mut OutLoVT: EVT = EVT {};
    let mut OutHiVT: EVT = EVT {};
    tie(OutLoVT, OutHiVT) = self.DAG.GetSplitDestVTs(N.getValueType(0));
    let mut OutNumElements: u32 = OutLoVT.getVectorNumElements();
    assert!((2 * OutNumElements) <= InNumElements, "Illegal extend vector in reg split");
    let mut SplitHi: SmallVector<int, 8> = SmallVector<int, 8> { InNumElements, -1 };
    for let mut i: u32 = 0; i != OutNumElements; i += 1 {
        SplitHi[i] = i + OutNumElements;
    }
    InHi = self.DAG.getVectorShuffle(InLoVT, dl, InLo, self.DAG.getPOISON(InLoVT), ArrayRef<int> { SplitHi });
    Lo = self.DAG.getNode(Opcode, dl, OutLoVT, InLo);
    Hi = self.DAG.getNode(Opcode, dl, OutHiVT, InHi);
}

fn DAGTypeLegalizer::SplitVecRes_StrictFPOp(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut NumOps: u32 = N.getNumOperands();
    let mut Chain: SDValue = N.getOperand(0);
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    let mut dl: SDLoc = SDLoc { N };
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(N.getValueType(0));
    let mut OpsLo: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { NumOps };
    let mut OpsHi: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { NumOps };
    OpsLo[0] = Chain;
    OpsHi[0] = Chain;
    for let mut i: u32 = 1; i < NumOps; i += 1 {
        let mut Op: SDValue = N.getOperand(i);
        let mut OpLo: SDValue = Op;
        let mut OpHi: SDValue = Op;
        let mut InVT: EVT = Op.getValueType();
        if InVT.isVector() {
            if self.getTypeAction(InVT) == TypeSplitVector {
                self.GetSplitVector(Op, OpLo, OpHi);
            } else {
                tie(OpLo, OpHi) = self.DAG.SplitVectorOperand(N, i);
            }
        }
        OpsLo[i] = OpLo;
        OpsHi[i] = OpHi;
    }
    let mut LoValueVTs: [2]EVT = [LoVT, EVT { Other }];
    let mut HiValueVTs: [2]EVT = [HiVT, EVT { Other }];
    Lo = self.DAG.getNode(N.getOpcode(), dl, self.DAG.getVTList(ArrayRef<EVT> { LoValueVTs }), ArrayRef<SDValue> { OpsLo }, N.getFlags());
    Hi = self.DAG.getNode(N.getOpcode(), dl, self.DAG.getVTList(ArrayRef<EVT> { HiValueVTs }), ArrayRef<SDValue> { OpsHi }, N.getFlags());
    Chain = self.DAG.getNode(TokenFactor, dl, EVT { Other }, Lo.getValue(1), Hi.getValue(1));
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Chain);
}

fn DAGTypeLegalizer::UnrollVectorOp_StrictFP(self, N: *mut SDNode, ResNE: u32) -> SDValue {
    let mut Chain: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut NE: u32 = VT.getVectorNumElements();
    let mut EltVT: EVT = VT.getVectorElementType();
    let mut dl: SDLoc = SDLoc { N };
    let mut Scalars: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut Operands: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { N.getNumOperands() };
    if ResNE == 0 {
        ResNE = NE;
    } else if NE > ResNE {
        NE = ResNE;
    }
    let mut ChainVTs: SDVTList = self.DAG.getVTList(EltVT, EVT { Other });
    let mut Chains: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut i: u32 = 0;
    for i = 0; i != NE; i += 1 {
        Operands[0] = Chain;
        for let mut j: u32 = 1;
let mut e: u32 = N.getNumOperands(); j != e; j += 1 {
            let mut Operand: SDValue = N.getOperand(j);
            let mut OperandVT: EVT = Operand.getValueType();
            if OperandVT.isVector() {
                let mut OperandEltVT: EVT = OperandVT.getVectorElementType();
                Operands[j] = self.DAG.getExtractVectorElt(dl, OperandEltVT, Operand, i);
            } else {
                Operands[j] = Operand;
            }
        }
        let mut Scalar: SDValue = self.DAG.getNode(N.getOpcode(), dl, ChainVTs, ArrayRef<SDValue> { Operands }, N.getFlags());
        Scalars.push(ValueParamT { Scalar });
        Chains.push(Scalar.getValue(1));
    }
    for ; i < ResNE; i += 1 {
        Scalars.push(self.DAG.getPOISON(EltVT));
    }
    Chain = self.DAG.getNode(TokenFactor, dl, EVT { Other }, ArrayRef<SDValue> { Chains });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Chain);
    let mut VecVT: EVT = getVectorVT(*self.DAG.getContext(), EltVT, ResNE, false);
    return self.DAG.getBuildVector(VecVT, dl, ArrayRef<SDValue> { Scalars });
}

fn DAGTypeLegalizer::SplitVecRes_OverflowOp(self, N: *mut SDNode, ResNo: u32, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    let mut ResVT: EVT = N.getValueType(0);
    let mut OvVT: EVT = N.getValueType(1);
    let mut LoResVT: EVT = EVT {};
    let mut HiResVT: EVT = EVT {};
    let mut LoOvVT: EVT = EVT {};
    let mut HiOvVT: EVT = EVT {};
    tie(LoResVT, HiResVT) = self.DAG.GetSplitDestVTs(ResVT);
    tie(LoOvVT, HiOvVT) = self.DAG.GetSplitDestVTs(OvVT);
    let mut LoLHS: SDValue = SDValue {};
    let mut HiLHS: SDValue = SDValue {};
    let mut LoRHS: SDValue = SDValue {};
    let mut HiRHS: SDValue = SDValue {};
    if self.getTypeAction(ResVT) == TypeSplitVector {
        self.GetSplitVector(N.getOperand(0), LoLHS, HiLHS);
        self.GetSplitVector(N.getOperand(1), LoRHS, HiRHS);
    } else {
        tie(LoLHS, HiLHS) = self.DAG.SplitVectorOperand(N, 0);
        tie(LoRHS, HiRHS) = self.DAG.SplitVectorOperand(N, 1);
    }
    let mut Opcode: u32 = N.getOpcode();
    let mut LoVTs: SDVTList = self.DAG.getVTList(LoResVT, LoOvVT);
    let mut HiVTs: SDVTList = self.DAG.getVTList(HiResVT, HiOvVT);
    let mut LoNode: *mut SDNode = self.DAG.getNode(Opcode, dl, LoVTs, ArrayRef<SDValue> { [LoLHS, LoRHS] }, N.getFlags()).getNode();
    let mut HiNode: *mut SDNode = self.DAG.getNode(Opcode, dl, HiVTs, ArrayRef<SDValue> { [HiLHS, HiRHS] }, N.getFlags()).getNode();
    Lo = SDValue { Node: LoNode, ResNo: ResNo };
    Hi = SDValue { Node: HiNode, ResNo: ResNo };
    let mut OtherNo: u32 = 1 - ResNo;
    let mut OtherVT: EVT = N.getValueType(OtherNo);
    if self.getTypeAction(OtherVT) == TypeSplitVector {
        self.SetSplitVector(SDValue { Node: N, ResNo: OtherNo }, SDValue { Node: LoNode, ResNo: OtherNo }, SDValue { Node: HiNode, ResNo: OtherNo });
    } else {
        let mut OtherVal: SDValue = self.DAG.getNode(CONCAT_VECTORS, dl, OtherVT, SDValue { Node: LoNode, ResNo: OtherNo }, SDValue { Node: HiNode, ResNo: OtherNo });
        self.ReplaceValueWith(SDValue { Node: N, ResNo: OtherNo }, OtherVal);
    }
}

fn DAGTypeLegalizer::SplitVecRes_INSERT_VECTOR_ELT(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut Vec: SDValue = N.getOperand(0);
    let mut Elt: SDValue = N.getOperand(1);
    let mut Idx: SDValue = N.getOperand(2);
    let mut dl: SDLoc = SDLoc { N };
    self.GetSplitVector(Vec, Lo, Hi);
    if dyn_cast(Idx) {
        CIdx;
    } else {
        let mut IdxVal: u32 = CIdx.getZExtValue();
        let mut LoNumElts: u32 = Lo.getValueType().getVectorMinNumElements();
        if IdxVal < LoNumElts {
            Lo = self.DAG.getNode(INSERT_VECTOR_ELT, dl, Lo.getValueType(), Lo, Elt, Idx);
            return;
        } else if !Vec.getValueType().isScalableVector() {
            Hi = self.DAG.getInsertVectorElt(dl, Hi, Elt, IdxVal - LoNumElts);
            return;
        }
    }
    let mut VecVT: EVT = Vec.getValueType();
    let mut EltVT: EVT = VecVT.getVectorElementType();
    if !EltVT.isByteSized() {
        EltVT = EltVT.changeTypeToInteger().getRoundIntegerType(*self.DAG.getContext());
        VecVT = VecVT.changeElementType(*self.DAG.getContext(), EltVT);
        Vec = self.DAG.getNode(ANY_EXTEND, dl, VecVT, Vec);
        if EltVT.bitsGT(Elt.getValueType()) {
            Elt = self.DAG.getNode(ANY_EXTEND, dl, EltVT, Elt);
        }
    }
    let mut SmallestAlign: Align = self.DAG.getReducedAlign(VecVT, false);
    let mut StackPtr: SDValue = self.DAG.CreateStackTemporary(VecVT.getStoreSize(), SmallestAlign);
    let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
    let mut FrameIndex: i32 = cast(StackPtr.getNode()).getIndex();
    let mut PtrInfo: MachinePointerInfo = getFixedStack(MF, FrameIndex, 0);
    let mut Store: SDValue = self.DAG.getStore(self.DAG.getEntryNode(), dl, Vec, StackPtr, PtrInfo, SmallestAlign, MONone, MMOMetadata {});
    let mut EltPtr: SDValue = self.TLI.getVectorElementPointer(self.DAG, StackPtr, VecVT, Idx, SDNodeFlags { Flags: None });
    Store = self.DAG.getTruncStore(Store, dl, Elt, EltPtr, getUnknownStack(MF), EltVT, commonAlignment(SmallestAlign, EltVT.getFixedSizeInBits() / 8), MONone, MMOMetadata {});
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(VecVT);
    Lo = self.DAG.getLoad(LoVT, dl, Store, StackPtr, PtrInfo, MaybeAlign { SmallestAlign }, MONone, MMOMetadata {});
    let mut Load: CastReturnType = cast(Lo);
    let mut MPI: MachinePointerInfo = Load.getPointerInfo();
    self.IncrementPointer(Load, LoVT, MPI, StackPtr, null);
    Hi = self.DAG.getLoad(HiVT, dl, Store, StackPtr, MPI, MaybeAlign { SmallestAlign }, MONone, MMOMetadata {});
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(N.getValueType(0));
    if LoVT != Lo.getValueType() {
        Lo = self.DAG.getNode(TRUNCATE, dl, LoVT, Lo);
    }
    if HiVT != Hi.getValueType() {
        Hi = self.DAG.getNode(TRUNCATE, dl, HiVT, Hi);
    }
}

fn DAGTypeLegalizer::SplitVecRes_STEP_VECTOR(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    let mut dl: SDLoc = SDLoc { N };
    assert!(N.getValueType(0).isScalableVector(), "Only scalable vectors are supported for STEP_VECTOR");
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(N.getValueType(0));
    let mut Step: SDValue = N.getOperand(0);
    Lo = self.DAG.getNode(STEP_VECTOR, dl, LoVT, Step);
    let mut EltVT: EVT = Step.getValueType();
    let mut StepVal: APInt = operator(Step).getAsAPIntVal();
    let mut StartOfHi: SDValue = self.DAG.getVScale(dl, EltVT, StepVal * LoVT.getVectorMinNumElements());
    StartOfHi = self.DAG.getSExtOrTrunc(StartOfHi, dl, HiVT.getVectorElementType());
    StartOfHi = self.DAG.getNode(SPLAT_VECTOR, dl, HiVT, StartOfHi);
    Hi = self.DAG.getNode(STEP_VECTOR, dl, HiVT, Step);
    Hi = self.DAG.getNode(ADD, dl, HiVT, Hi, StartOfHi);
}

fn DAGTypeLegalizer::SplitVecRes_ScalarOp(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    let mut dl: SDLoc = SDLoc { N };
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(N.getValueType(0));
    Lo = self.DAG.getNode(N.getOpcode(), dl, LoVT, N.getOperand(0));
    if N.getOpcode() == SCALAR_TO_VECTOR {
        Hi = self.DAG.getPOISON(HiVT);
    } else {
        assert!(N.getOpcode() == SPLAT_VECTOR, "Unexpected opcode");
        Hi = Lo;
    }
}

fn DAGTypeLegalizer::SplitVecRes_ATOMIC_LOAD(self, LD: *mut AtomicSDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    assert!(LD.getExtensionType() == NON_EXTLOAD, "Extended load during type legalization!");
    let mut dl: SDLoc = SDLoc { LD };
    let mut VT: EVT = LD.getValueType(0);
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(VT);
    let mut Ch: SDValue = LD.getChain();
    let mut Ptr: SDValue = LD.getBasePtr();
    let mut IntVT: EVT = getIntegerVT(*self.DAG.getContext(), VT.getSizeInBits().operator unsigned long long());
    let mut MemIntVT: EVT = getIntegerVT(*self.DAG.getContext(), LD.getMemoryVT().getSizeInBits().operator unsigned long long());
    let mut ALD: SDValue = self.DAG.getAtomicLoad(LD.getExtensionType(), dl, MemIntVT, IntVT, Ch, Ptr, LD.getMemOperand());
    let mut LoIntVT: EVT = getIntegerVT(*self.DAG.getContext(), LoVT.getSizeInBits().operator unsigned long long());
    let mut HiIntVT: EVT = getIntegerVT(*self.DAG.getContext(), HiVT.getSizeInBits().operator unsigned long long());
    let mut ExtractLo: SDValue = SDValue {};
    let mut ExtractHi: SDValue = SDValue {};
    self.SplitInteger(ALD, LoIntVT, HiIntVT, ExtractLo, ExtractHi);
    Lo = self.DAG.getBitcast(LoVT, ExtractLo);
    Hi = self.DAG.getBitcast(HiVT, ExtractHi);
    self.ReplaceValueWith(SDValue { Node: LD, ResNo: 1 }, ALD.getValue(1));
}

fn DAGTypeLegalizer::SplitVecRes_LOAD(self, LD: *mut LoadSDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    assert!(isUNINDEXEDLoad(LD), "Indexed load during type legalization!");
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    let mut dl: SDLoc = SDLoc { LD };
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(LD.getValueType(0));
    let mut ExtType: LoadExtType = LD.getExtensionType();
    let mut Ch: SDValue = LD.getChain();
    let mut Ptr: SDValue = LD.getBasePtr();
    let mut Offset: SDValue = self.DAG.getPOISON(Ptr.getValueType());
    let mut MemoryVT: EVT = LD.getMemoryVT();
    let mut MMOFlags: Flags = LD.getMemOperand().getFlags();
    let mut AAInfo: AAMDNodes = LD.getAAInfo();
    let mut LoMemVT: EVT = EVT {};
    let mut HiMemVT: EVT = EVT {};
    tie(LoMemVT, HiMemVT) = self.DAG.GetSplitDestVTs(MemoryVT);
    if !LoMemVT.isByteSized() || !HiMemVT.isByteSized() {
        let mut Value: SDValue = SDValue {};
        let mut NewChain: SDValue = SDValue {};
        tie(Value, NewChain) = self.TLI.scalarizeVectorLoad(LD, self.DAG);
        tie(Lo, Hi) = self.DAG.SplitVector(Value, dl);
        self.ReplaceValueWith(SDValue { Node: LD, ResNo: 1 }, NewChain);
        return;
    }
    Lo = self.DAG.getLoad(UNINDEXED, ExtType, LoVT, dl, Ch, Ptr, Offset, LD.getPointerInfo(), LoMemVT, LD.getBaseAlign(), MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
    let mut MPI: MachinePointerInfo = MachinePointerInfo { 0, 0 };
    self.IncrementPointer(LD, LoMemVT, MPI, Ptr, null);
    Hi = self.DAG.getLoad(UNINDEXED, ExtType, HiVT, dl, Ch, Ptr, Offset, MPI, HiMemVT, LD.getBaseAlign(), MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
    Ch = self.DAG.getNode(TokenFactor, dl, EVT { Other }, Lo.getValue(1), Hi.getValue(1));
    self.ReplaceValueWith(SDValue { Node: LD, ResNo: 1 }, Ch);
}

fn DAGTypeLegalizer::SplitVecRes_VP_LOAD(self, LD: *mut VPLoadSDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    assert!(LD.isUnindexed(), "Indexed VP load during type legalization!");
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    let mut dl: SDLoc = SDLoc { LD };
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(LD.getValueType(0));
    let mut ExtType: LoadExtType = LD.getExtensionType();
    let mut Ch: SDValue = LD.getChain();
    let mut Ptr: SDValue = LD.getBasePtr();
    let mut Offset: SDValue = LD.getOffset();
    assert!(Offset.isUndef(), "Unexpected indexed variable-length load offset");
    let mut Alignment: Align = LD.getBaseAlign();
    let mut Mask: SDValue = LD.getMask();
    let mut EVL: SDValue = LD.getVectorLength();
    let mut MemoryVT: EVT = LD.getMemoryVT();
    let mut LoMemVT: EVT = EVT {};
    let mut HiMemVT: EVT = EVT {};
    let mut HiIsEmpty: bool = false;
    tie(LoMemVT, HiMemVT) = self.DAG.GetDependentSplitDestVTs(MemoryVT, LoVT, &mut HiIsEmpty);
    let mut MaskLo: SDValue = SDValue {};
    let mut MaskHi: SDValue = SDValue {};
    if Mask.getOpcode() == SETCC {
        self.SplitVecRes_SETCC(Mask.getNode(), MaskLo, MaskHi);
    } else {
        if self.getTypeAction(Mask.getValueType()) == TypeSplitVector {
            self.GetSplitVector(Mask, MaskLo, MaskHi);
        } else {
            tie(MaskLo, MaskHi) = self.DAG.SplitVector(Mask, dl);
        }
    }
    let mut EVLLo: SDValue = SDValue {};
    let mut EVLHi: SDValue = SDValue {};
    tie(EVLLo, EVLHi) = self.DAG.SplitEVL(EVL, LD.getValueType(0), dl);
    let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(LD.getPointerInfo(), MOLoad, beforeOrAfterPointer(), Alignment, MMOMetadata { AAInfo: LD.getAAInfo(), Ranges: LD.getRanges(), MemCacheHint: null }, System, NotAtomic, NotAtomic);
    Lo = self.DAG.getLoadVP(LD.getAddressingMode(), ExtType, LoVT, dl, Ch, Ptr, Offset, MaskLo, EVLLo, LoMemVT, MMO, LD.isExpandingLoad());
    if HiIsEmpty {
        Hi = Lo;
    } else {
        Ptr = self.TLI.IncrementMemoryAddress(Ptr, MaskLo, dl, LoMemVT, self.DAG, LD.isExpandingLoad());
        let mut MPI: MachinePointerInfo = MachinePointerInfo { 0, 0 };
        if LoMemVT.isScalableVector() {
            MPI = MachinePointerInfo { LD.getPointerInfo().getAddrSpace(), 0 };
        } else {
            MPI = LD.getPointerInfo().getWithOffset(LoMemVT.getStoreSize().getFixedValue());
        }
        MMO = self.DAG.getMachineFunction().getMachineMemOperand(MPI, MOLoad, beforeOrAfterPointer(), Alignment, MMOMetadata { AAInfo: LD.getAAInfo(), Ranges: LD.getRanges(), MemCacheHint: null }, System, NotAtomic, NotAtomic);
        Hi = self.DAG.getLoadVP(LD.getAddressingMode(), ExtType, HiVT, dl, Ch, Ptr, Offset, MaskHi, EVLHi, HiMemVT, MMO, LD.isExpandingLoad());
    }
    Ch = self.DAG.getNode(TokenFactor, dl, EVT { Other }, Lo.getValue(1), Hi.getValue(1));
    self.ReplaceValueWith(SDValue { Node: LD, ResNo: 1 }, Ch);
}

fn DAGTypeLegalizer::SplitVecRes_VP_LOAD_FF(self, LD: *mut VPLoadFFSDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { LD };
    let mut Ch: SDValue = LD.getChain();
    let mut Ptr: SDValue = LD.getBasePtr();
    let mut Alignment: Align = LD.getBaseAlign();
    let mut Mask: SDValue = LD.getMask();
    let mut EVL: SDValue = LD.getVectorLength();
    let mut MaskLo: SDValue = SDValue {};
    let mut MaskHi: SDValue = SDValue {};
    if Mask.getOpcode() == SETCC {
        self.SplitVecRes_SETCC(Mask.getNode(), MaskLo, MaskHi);
    } else {
        if self.getTypeAction(Mask.getValueType()) == TypeSplitVector {
            self.GetSplitVector(Mask, MaskLo, MaskHi);
        } else {
            tie(MaskLo, MaskHi) = self.DAG.SplitVector(Mask, dl);
        }
    }
    let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(LD.getPointerInfo(), MOLoad, beforeOrAfterPointer(), Alignment, MMOMetadata { AAInfo: LD.getAAInfo(), Ranges: LD.getRanges(), MemCacheHint: null }, System, NotAtomic, NotAtomic);
    Lo = self.DAG.getLoadFFVP(LoVT, dl, Ch, Ptr, MaskLo, EVLLo, MMO);
    Hi = self.DAG.getPOISON(HiVT);
    self.ReplaceValueWith(SDValue { Node: LD, ResNo: 1 }, Lo.getValue(1));
    self.ReplaceValueWith(SDValue { Node: LD, ResNo: 2 }, Lo.getValue(2));
}

fn DAGTypeLegalizer::SplitVecRes_VP_STRIDED_LOAD(self, SLD: *mut VPStridedLoadSDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    assert!(SLD.isUnindexed(), "Indexed VP strided load during type legalization!");
    assert!(SLD.getOffset().isUndef(), "Unexpected indexed variable-length load offset");
    let mut DL: SDLoc = SDLoc { SLD };
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(SLD.getValueType(0));
    let mut LoMemVT: EVT = EVT {};
    let mut HiMemVT: EVT = EVT {};
    let mut HiIsEmpty: bool = false;
    tie(LoMemVT, HiMemVT) = self.DAG.GetDependentSplitDestVTs(SLD.getMemoryVT(), LoVT, &mut HiIsEmpty);
    let mut Mask: SDValue = SLD.getMask();
    let mut LoMask: SDValue = SDValue {};
    let mut HiMask: SDValue = SDValue {};
    if Mask.getOpcode() == SETCC {
        self.SplitVecRes_SETCC(Mask.getNode(), LoMask, HiMask);
    } else {
        if self.getTypeAction(Mask.getValueType()) == TypeSplitVector {
            self.GetSplitVector(Mask, LoMask, HiMask);
        } else {
            tie(LoMask, HiMask) = self.DAG.SplitVector(Mask, DL);
        }
    }
    let mut LoEVL: SDValue = SDValue {};
    let mut HiEVL: SDValue = SDValue {};
    tie(LoEVL, HiEVL) = self.DAG.SplitEVL(SLD.getVectorLength(), SLD.getValueType(0), DL);
    Lo = self.DAG.getStridedLoadVP(SLD.getAddressingMode(), SLD.getExtensionType(), LoVT, DL, SLD.getChain(), SLD.getBasePtr(), SLD.getOffset(), SLD.getStride(), LoMask, LoEVL, LoMemVT, SLD.getMemOperand(), SLD.isExpandingLoad());
    if HiIsEmpty {
        Hi = Lo;
    } else {
        let mut PtrVT: EVT = SLD.getBasePtr().getValueType();
        let mut Increment: SDValue = self.DAG.getNode(MUL, DL, PtrVT, LoEVL, self.DAG.getSExtOrTrunc(SLD.getStride(), DL, PtrVT));
        let mut Ptr: SDValue = self.DAG.getNode(ADD, DL, PtrVT, SLD.getBasePtr(), Increment);
        let mut Alignment: Align = SLD.getBaseAlign();
        if LoMemVT.isScalableVector() {
            Alignment = commonAlignment(Alignment, LoMemVT.getSizeInBits().getKnownMinValue() / 8);
        }
        let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(MachinePointerInfo { SLD.getPointerInfo().getAddrSpace(), 0 }, MOLoad, beforeOrAfterPointer(), Alignment, MMOMetadata { AAInfo: SLD.getAAInfo(), Ranges: SLD.getRanges(), MemCacheHint: null }, System, NotAtomic, NotAtomic);
        Hi = self.DAG.getStridedLoadVP(SLD.getAddressingMode(), SLD.getExtensionType(), HiVT, DL, SLD.getChain(), Ptr, SLD.getOffset(), SLD.getStride(), HiMask, HiEVL, HiMemVT, MMO, SLD.isExpandingLoad());
    }
    let mut Ch: SDValue = self.DAG.getNode(TokenFactor, DL, EVT { Other }, Lo.getValue(1), Hi.getValue(1));
    self.ReplaceValueWith(SDValue { Node: SLD, ResNo: 1 }, Ch);
}

fn DAGTypeLegalizer::SplitVecRes_MLOAD(self, MLD: *mut MaskedLoadSDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    assert!(MLD.isUnindexed(), "Indexed masked load during type legalization!");
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    let mut dl: SDLoc = SDLoc { MLD };
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(MLD.getValueType(0));
    let mut Ch: SDValue = MLD.getChain();
    let mut Ptr: SDValue = MLD.getBasePtr();
    let mut Offset: SDValue = MLD.getOffset();
    assert!(Offset.isUndef(), "Unexpected indexed masked load offset");
    let mut Mask: SDValue = MLD.getMask();
    let mut PassThru: SDValue = MLD.getPassThru();
    let mut Alignment: Align = MLD.getBaseAlign();
    let mut ExtType: LoadExtType = MLD.getExtensionType();
    let mut MMOFlags: Flags = MLD.getMemOperand().getFlags();
    let mut MaskLo: SDValue = SDValue {};
    let mut MaskHi: SDValue = SDValue {};
    if Mask.getOpcode() == SETCC {
        self.SplitVecRes_SETCC(Mask.getNode(), MaskLo, MaskHi);
    } else {
        if self.getTypeAction(Mask.getValueType()) == TypeSplitVector {
            self.GetSplitVector(Mask, MaskLo, MaskHi);
        } else {
            tie(MaskLo, MaskHi) = self.DAG.SplitVector(Mask, dl);
        }
    }
    let mut MemoryVT: EVT = MLD.getMemoryVT();
    let mut LoMemVT: EVT = EVT {};
    let mut HiMemVT: EVT = EVT {};
    let mut HiIsEmpty: bool = false;
    tie(LoMemVT, HiMemVT) = self.DAG.GetDependentSplitDestVTs(MemoryVT, LoVT, &mut HiIsEmpty);
    let mut PassThruLo: SDValue = SDValue {};
    let mut PassThruHi: SDValue = SDValue {};
    if self.getTypeAction(PassThru.getValueType()) == TypeSplitVector {
        self.GetSplitVector(PassThru, PassThruLo, PassThruHi);
    } else {
        tie(PassThruLo, PassThruHi) = self.DAG.SplitVector(PassThru, dl);
    }
    let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(MLD.getPointerInfo(), MMOFlags, beforeOrAfterPointer(), Alignment, MMOMetadata { AAInfo: MLD.getAAInfo(), Ranges: MLD.getRanges(), MemCacheHint: MLD.getMemCacheHint() }, System, NotAtomic, NotAtomic);
    Lo = self.DAG.getMaskedLoad(LoVT, dl, Ch, Ptr, Offset, MaskLo, PassThruLo, LoMemVT, MMO, MLD.getAddressingMode(), ExtType, MLD.isExpandingLoad());
    if HiIsEmpty {
        Hi = Lo;
    } else {
        Ptr = self.TLI.IncrementMemoryAddress(Ptr, MaskLo, dl, LoMemVT, self.DAG, MLD.isExpandingLoad());
        let mut MPI: MachinePointerInfo = MachinePointerInfo { 0, 0 };
        if LoMemVT.isScalableVector() {
            MPI = MachinePointerInfo { MLD.getPointerInfo().getAddrSpace(), 0 };
        } else {
            MPI = MLD.getPointerInfo().getWithOffset(LoMemVT.getStoreSize().getFixedValue());
        }
        MMO = self.DAG.getMachineFunction().getMachineMemOperand(MPI, MMOFlags, beforeOrAfterPointer(), Alignment, MMOMetadata { AAInfo: MLD.getAAInfo(), Ranges: MLD.getRanges(), MemCacheHint: MLD.getMemCacheHint() }, System, NotAtomic, NotAtomic);
        Hi = self.DAG.getMaskedLoad(HiVT, dl, Ch, Ptr, Offset, MaskHi, PassThruHi, HiMemVT, MMO, MLD.getAddressingMode(), ExtType, MLD.isExpandingLoad());
    }
    Ch = self.DAG.getNode(TokenFactor, dl, EVT { Other }, Lo.getValue(1), Hi.getValue(1));
    self.ReplaceValueWith(SDValue { Node: MLD, ResNo: 1 }, Ch);
}

fn DAGTypeLegalizer::SplitVecRes_Gather(self, N: *mut MemSDNode, Lo: *mut SDValue, Hi: *mut SDValue, SplitSETCC: bool) {
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    let mut dl: SDLoc = SDLoc { N };
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(N.getValueType(0));
    let mut Ch: SDValue = N.getChain();
    let mut Ptr: SDValue = N.getBasePtr();
    let mut Ops: Operands = Closure_1 { N: &mut N }.call();
    let mut MemoryVT: EVT = N.getMemoryVT();
    let mut Alignment: Align = N.getBaseAlign();
    let mut MaskLo: SDValue = SDValue {};
    let mut MaskHi: SDValue = SDValue {};
    if SplitSETCC && Ops.Mask.getOpcode() == SETCC {
        self.SplitVecRes_SETCC(Ops.Mask.getNode(), MaskLo, MaskHi);
    } else {
        tie(MaskLo, MaskHi) = self.SplitMask(Ops.Mask, dl);
    }
    let mut LoMemVT: EVT = EVT {};
    let mut HiMemVT: EVT = EVT {};
    tie(LoMemVT, HiMemVT) = self.DAG.GetSplitDestVTs(MemoryVT);
    let mut IndexHi: SDValue = SDValue {};
    let mut IndexLo: SDValue = SDValue {};
    if self.getTypeAction(Ops.Index.getValueType()) == TypeSplitVector {
        self.GetSplitVector(Ops.Index, IndexLo, IndexHi);
    } else {
        tie(IndexLo, IndexHi) = self.DAG.SplitVector(Ops.Index, dl);
    }
    let mut MMOFlags: Flags = N.getMemOperand().getFlags();
    let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(N.getPointerInfo(), MMOFlags, beforeOrAfterPointer(), Alignment, MMOMetadata { AAInfo: N.getAAInfo(), Ranges: N.getRanges(), MemCacheHint: null }, System, NotAtomic, NotAtomic);
    if dyn_cast(N) {
        MGT;
    } else {
        let mut PassThru: SDValue = MGT.getPassThru();
        let mut PassThruLo: SDValue = SDValue {};
        let mut PassThruHi: SDValue = SDValue {};
        if self.getTypeAction(PassThru.getValueType()) == TypeSplitVector {
            self.GetSplitVector(PassThru, PassThruLo, PassThruHi);
        } else {
            tie(PassThruLo, PassThruHi) = self.DAG.SplitVector(PassThru, dl);
        }
        let mut ExtType: LoadExtType = MGT.getExtensionType();
        let mut IndexTy: MemIndexType = MGT.getIndexType();
        let mut OpsLo: [6]SDValue = [Ch, PassThruLo, MaskLo, Ptr, IndexLo, Ops.Scale];
        Lo = self.DAG.getMaskedGather(self.DAG.getVTList(LoVT, EVT { Other }), LoMemVT, dl, ArrayRef<SDValue> { OpsLo }, MMO, IndexTy, ExtType);
        let mut OpsHi: [6]SDValue = [Ch, PassThruHi, MaskHi, Ptr, IndexHi, Ops.Scale];
        Hi = self.DAG.getMaskedGather(self.DAG.getVTList(HiVT, EVT { Other }), HiMemVT, dl, ArrayRef<SDValue> { OpsHi }, MMO, IndexTy, ExtType);
    }
    Ch = self.DAG.getNode(TokenFactor, dl, EVT { Other }, Lo.getValue(1), Hi.getValue(1));
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Ch);
}

fn DAGTypeLegalizer::SplitVecRes_VECTOR_COMPRESS(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut DL: SDLoc = SDLoc { N };
    let mut VecVT: EVT = N.getValueType(0);
    let mut HasCustomLowering: bool = false;
    let mut CheckVT: EVT = LoVT;
    while CheckVT.getVectorMinNumElements() > 1 {
        if self.TLI.isOperationLegal(VECTOR_COMPRESS, CheckVT) || self.TLI.isOperationCustom(VECTOR_COMPRESS, CheckVT) {
            HasCustomLowering = true;
            break;
        }
        CheckVT = CheckVT.getHalfNumVectorElementsVT(*self.DAG.getContext());
    }
    let mut Passthru: SDValue = N.getOperand(2);
    if !HasCustomLowering {
        let mut Compressed: SDValue = self.TLI.expandVECTOR_COMPRESS(N, self.DAG);
        tie(Lo, Hi) = self.DAG.SplitVector(Compressed, DL, LoVT, HiVT);
        return;
    }
    let mut Mask: SDValue = N.getOperand(1);
    let mut LoMask: SDValue = SDValue {};
    let mut HiMask: SDValue = SDValue {};
    tie(Lo, Hi) = self.DAG.SplitVectorOperand(N, 0);
    tie(LoMask, HiMask) = self.SplitMask(Mask);
    let mut UndefPassthru: SDValue = self.DAG.getPOISON(LoVT);
    Lo = self.DAG.getNode(VECTOR_COMPRESS, DL, LoVT, Lo, LoMask, UndefPassthru);
    Hi = self.DAG.getNode(VECTOR_COMPRESS, DL, HiVT, Hi, HiMask, UndefPassthru);
    let mut StackPtr: SDValue = self.DAG.CreateStackTemporary(VecVT.getStoreSize(), self.DAG.getReducedAlign(VecVT, false));
    let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
    let mut PtrInfo: MachinePointerInfo = getFixedStack(MF, cast(StackPtr.getNode()).getIndex(), 0);
    let mut LoMaskVT: EVT = LoMask.getValueType();
    assert!(LoMaskVT.getScalarType() == EVT { i1 }, "Expected vector of i1s");
    let mut WideLoMaskVT: EVT = getVectorVT(*self.DAG.getContext(), EVT { i32 }, LoMaskVT.getVectorElementCount());
    let mut WideLoMask: SDValue = self.DAG.getNode(ZERO_EXTEND, DL, WideLoMaskVT, LoMask);
    let mut Offset: SDValue = self.DAG.getNode(VECREDUCE_ADD, DL, EVT { i32 }, WideLoMask);
    Offset = self.TLI.getVectorElementPointer(self.DAG, StackPtr, VecVT, Offset, SDNodeFlags { Flags: None });
    let mut Chain: SDValue = self.DAG.getEntryNode();
    Chain = self.DAG.getStore(Chain, DL, Lo, StackPtr, PtrInfo, MaybeAlign {}, MONone, MMOMetadata {});
    Chain = self.DAG.getStore(Chain, DL, Hi, Offset, getUnknownStack(MF), MaybeAlign {}, MONone, MMOMetadata {});
    let mut Compressed: SDValue = self.DAG.getLoad(VecVT, DL, Chain, StackPtr, PtrInfo, MaybeAlign {}, MONone, MMOMetadata {});
    if !Passthru.isUndef() {
        let mut MaskVT: EVT = Mask.getValueType();
        let mut WideMaskVT: EVT = getVectorVT(*self.DAG.getContext(), EVT { i32 }, MaskVT.getVectorElementCount());
        let mut WideMask: SDValue = self.DAG.getNode(ZERO_EXTEND, DL, WideMaskVT, Mask);
        let mut NumActiveElts: SDValue = self.DAG.getNode(VECREDUCE_ADD, DL, EVT { i32 }, WideMask);
        let mut StepVector: SDValue = self.DAG.getStepVector(DL, WideMaskVT);
        let mut SplatNumActiveElts: SDValue = self.DAG.getSplat(WideMaskVT, DL, NumActiveElts);
        let mut CompressedMask: SDValue = self.DAG.getSetCC(DL, MaskVT, StepVector, SplatNumActiveElts, SETULT, SDValue {}, false, SDNodeFlags { Flags: None });
        Compressed = self.DAG.getNode(VSELECT, DL, VecVT, CompressedMask, Compressed, Passthru);
    }
    tie(Lo, Hi) = self.DAG.SplitVector(Compressed, DL);
}

fn DAGTypeLegalizer::SplitVecRes_SETCC(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    assert!(N.getValueType(0).isVector() && N.getOperand(0).getValueType().isVector(), "Operand types must be vectors");
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    let mut DL: SDLoc = SDLoc { N };
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(N.getValueType(0));
    let mut LL: SDValue = SDValue {};
    let mut LH: SDValue = SDValue {};
    let mut RL: SDValue = SDValue {};
    let mut RH: SDValue = SDValue {};
    if self.getTypeAction(N.getOperand(0).getValueType()) == TypeSplitVector {
        self.GetSplitVector(N.getOperand(0), LL, LH);
    } else {
        tie(LL, LH) = self.DAG.SplitVectorOperand(N, 0);
    }
    if self.getTypeAction(N.getOperand(1).getValueType()) == TypeSplitVector {
        self.GetSplitVector(N.getOperand(1), RL, RH);
    } else {
        tie(RL, RH) = self.DAG.SplitVectorOperand(N, 1);
    }
    Lo = self.DAG.getNode(N.getOpcode(), DL, LoVT, LL, RL, N.getOperand(2));
    Hi = self.DAG.getNode(N.getOpcode(), DL, HiVT, LH, RH, N.getOperand(2));
}

fn DAGTypeLegalizer::SplitVecRes_UnaryOp(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    let mut dl: SDLoc = SDLoc { N };
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(N.getValueType(0));
    let mut InVT: EVT = N.getOperand(0).getValueType();
    if self.getTypeAction(InVT) == TypeSplitVector {
        self.GetSplitVector(N.getOperand(0), Lo, Hi);
    } else {
        tie(Lo, Hi) = self.DAG.SplitVectorOperand(N, 0);
    }
    let mut Flags: SDNodeFlags = N.getFlags();
    let mut Opcode: u32 = N.getOpcode();
    if Opcode == CONVERT_TO_ARBITRARY_FP {
        Lo = self.DAG.getNode(Opcode, dl, LoVT, Lo, N.getOperand(1), N.getOperand(2), N.getOperand(3), Flags);
        Hi = self.DAG.getNode(Opcode, dl, HiVT, Hi, N.getOperand(1), N.getOperand(2), N.getOperand(3), Flags);
        return;
    }
    if Opcode == FP_ROUND || Opcode == AssertNoFPClass || Opcode == CONVERT_FROM_ARBITRARY_FP {
        Lo = self.DAG.getNode(Opcode, dl, LoVT, Lo, N.getOperand(1), Flags);
        Hi = self.DAG.getNode(Opcode, dl, HiVT, Hi, N.getOperand(1), Flags);
    } else {
        Lo = self.DAG.getNode(Opcode, dl, LoVT, Lo, Flags);
        Hi = self.DAG.getNode(Opcode, dl, HiVT, Hi, Flags);
    }
}

fn DAGTypeLegalizer::SplitVecRes_ADDRSPACECAST(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    let mut InVT: EVT = N.getOperand(0).getValueType();
    if self.getTypeAction(InVT) == TypeSplitVector {
        self.GetSplitVector(N.getOperand(0), Lo, Hi);
    } else {
        tie(Lo, Hi) = self.DAG.SplitVectorOperand(N, 0);
    }
    let mut AddrSpaceCastN: *mut AddrSpaceCastSDNode = cast(N);
    let mut SrcAS: u32 = AddrSpaceCastN.getSrcAddressSpace();
    let mut DestAS: u32 = AddrSpaceCastN.getDestAddressSpace();
    let mut Flags: SDNodeFlags = AddrSpaceCastN.getFlags();
    Lo = self.DAG.getAddrSpaceCast(dl, LoVT, Lo, SrcAS, DestAS, Flags);
    Hi = self.DAG.getAddrSpaceCast(dl, HiVT, Hi, SrcAS, DestAS, Flags);
}

fn DAGTypeLegalizer::SplitVecRes_UnaryOpWithTwoResults(self, N: *mut SDNode, ResNo: u32, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    let mut InVT: EVT = N.getOperand(0).getValueType();
    if self.getTypeAction(InVT) == TypeSplitVector {
        self.GetSplitVector(N.getOperand(0), Lo, Hi);
    } else {
        tie(Lo, Hi) = self.DAG.SplitVectorOperand(N, 0);
    }
    Lo = self.DAG.getNode(N.getOpcode(), dl, ArrayRef<EVT> { [LoVT, LoVT1] }, ArrayRef<SDValue> { Lo }, N.getFlags());
    Hi = self.DAG.getNode(N.getOpcode(), dl, ArrayRef<EVT> { [HiVT, HiVT1] }, ArrayRef<SDValue> { Hi }, N.getFlags());
    let mut HiNode: *mut SDNode = Hi.getNode();
    let mut LoNode: *mut SDNode = Lo.getNode();
    let mut OtherNo: u32 = 1 - ResNo;
    let mut OtherVT: EVT = N.getValueType(OtherNo);
    if self.getTypeAction(OtherVT) == TypeSplitVector {
        self.SetSplitVector(SDValue { Node: N, ResNo: OtherNo }, SDValue { Node: LoNode, ResNo: OtherNo }, SDValue { Node: HiNode, ResNo: OtherNo });
    } else {
        let mut OtherVal: SDValue = self.DAG.getNode(CONCAT_VECTORS, dl, OtherVT, SDValue { Node: LoNode, ResNo: OtherNo }, SDValue { Node: HiNode, ResNo: OtherNo });
        self.ReplaceValueWith(SDValue { Node: N, ResNo: OtherNo }, OtherVal);
    }
}

fn DAGTypeLegalizer::SplitVecRes_ExtendOp(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    let mut SrcVT: EVT = N.getOperand(0).getValueType();
    let mut DestVT: EVT = N.getValueType(0);
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(DestVT);
    if SrcVT.getVectorElementCount().isKnownEven() && SrcVT.getScalarSizeInBits() * 2 < DestVT.getScalarSizeInBits() {
        let mut Ctx: *mut LLVMContext = *self.DAG.getContext();
        let mut NewSrcVT: EVT = SrcVT.widenIntegerVectorElementType(Ctx);
        let mut SplitSrcVT: EVT = SrcVT.getHalfNumVectorElementsVT(Ctx);
        let mut SplitLoVT: EVT = EVT {};
        let mut SplitHiVT: EVT = EVT {};
        tie(SplitLoVT, SplitHiVT) = self.DAG.GetSplitDestVTs(NewSrcVT);
        if self.TLI.isTypeLegal(SrcVT) && !self.TLI.isTypeLegal(SplitSrcVT) && self.TLI.isTypeLegal(NewSrcVT) && self.TLI.isTypeLegal(SplitLoVT) {
            while true {
                {
                if DebugFlag && isCurrentDebugType("legalize-types", 1) {
                    dbgs() << "Split vector extend via incremental extend:";
                    N.dump(&mut self.DAG);
                    dbgs() << "\n";
                }
            }
                if !(false) { break; }
            }
            let mut NewSrc: SDValue = self.DAG.getNode(N.getOpcode(), dl, NewSrcVT, N.getOperand(0));
            tie(Lo, Hi) = self.DAG.SplitVector(NewSrc, dl);
            Lo = self.DAG.getNode(N.getOpcode(), dl, LoVT, Lo);
            Hi = self.DAG.getNode(N.getOpcode(), dl, HiVT, Hi);
            return;
        }
    }
    self.SplitVecRes_UnaryOp(N, Lo, Hi);
}

fn DAGTypeLegalizer::SplitVecRes_VECTOR_SHUFFLE(self, N: *mut ShuffleVectorSDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut Inputs: [4]SDValue = [4]SDValue {};
    let mut DL: SDLoc = SDLoc { N };
    self.GetSplitVector(N.getOperand(0), Inputs[0], Inputs[1]);
    self.GetSplitVector(N.getOperand(1), Inputs[2], Inputs[3]);
    let mut NewVT: EVT = Inputs[0].getValueType();
    let mut NewElts: u32 = NewVT.getVectorNumElements();
    let mut IsConstant: Closure_2 = Closure_2 {};
    let mut BuildVector: Closure_3 = Closure_3 { NewElts: NewElts, DAG: &mut self.DAG, cap_2: NewVT, DL: &mut DL };
    let mut OrigMask: SmallVector<int> = SmallVector<int> { N.getMask() };
    let mut TryPeekThroughShufflesInputs: Closure_4 = Closure_4 { Inputs: &mut Inputs, NewVT: &mut NewVT, cap_2: self, NewElts: NewElts, DL: &mut DL };
    TryPeekThroughShufflesInputs.call(OrigMask);
    let mut MakeUniqueInputs: Closure_6 = Closure_6 { Inputs: &mut Inputs, IsConstant: &mut IsConstant, NewElts: NewElts };
    MakeUniqueInputs.call(OrigMask);
    let mut OrigInputs: [4]SDValue = [4]SDValue {};
    copy(Inputs, begin(OrigInputs));
    for let mut High: u32 = 0; High < 2; High += 1 {
        let mut Output: *mut SDValue = if High { Hi } else { Lo };
        let mut FirstMaskIdx: u32 = High * NewElts;
        let mut Mask: SmallVector<int> = SmallVector<int> { NewElts * size(Inputs), PoisonMaskElem };
        copy(ArrayRef<int> { OrigMask }.slice(FirstMaskIdx, NewElts), Mask.begin());
        assert!(!Output, "Expected default initialized initial value.");
        TryPeekThroughShufflesInputs.call(Mask);
        MakeUniqueInputs.call(Mask);
        let mut TmpInputs: [4]SDValue = [4]SDValue {};
        copy(Inputs, begin(TmpInputs));
        let mut UsedIdx: i32 = -1;
        let mut SecondIteration: bool = false;
        let mut AccumulateResults: Closure_7 = Closure_7 { UsedIdx: &mut UsedIdx, SecondIteration: &mut SecondIteration };
        processShuffleMasks(ArrayRef<int> { Mask }, size(Inputs), size(Inputs), 1, function_ref<void ()> { Closure_8 { Output: &mut Output, DAG: &mut self.DAG, cap_2: NewVT }, null, null }, function_ref<void (ArrayRef<int>, unsigned int, unsigned int)> { Closure_9 { Output: &mut Output, DAG: &mut self.DAG, cap_2: NewVT, DL: &mut DL, Inputs: &mut Inputs, BuildVector: &mut BuildVector }, null, null }, function_ref<void (ArrayRef<int>, unsigned int, unsigned int, bool)> { Closure_10 { AccumulateResults: &mut AccumulateResults, Output: &mut Output, DAG: &mut self.DAG, cap_3: NewVT, DL: &mut DL, Inputs: &mut Inputs, TmpInputs: &mut TmpInputs, BuildVector: &mut BuildVector }, null, null });
        copy(OrigInputs, begin(Inputs));
    }
}

fn DAGTypeLegalizer::SplitVecRes_VAARG(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut OVT: EVT = N.getValueType(0);
    let mut NVT: EVT = OVT.getHalfNumVectorElementsVT(*self.DAG.getContext());
    let mut Chain: SDValue = N.getOperand(0);
    let mut Ptr: SDValue = N.getOperand(1);
    let mut SV: SDValue = N.getOperand(2);
    let mut dl: SDLoc = SDLoc { N };
    let mut Alignment: Align = self.DAG.getDataLayout().getABITypeAlign(NVT.getTypeForEVT(*self.DAG.getContext()));
    Lo = self.DAG.getVAArg(NVT, dl, Chain, Ptr, SV, Alignment.value());
    Hi = self.DAG.getVAArg(NVT, dl, Lo.getValue(1), Ptr, SV, Alignment.value());
    Chain = Hi.getValue(1);
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Chain);
}

fn DAGTypeLegalizer::SplitVecRes_FP_TO_XINT_SAT(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut DstVTLo: EVT = EVT {};
    let mut DstVTHi: EVT = EVT {};
    tie(DstVTLo, DstVTHi) = self.DAG.GetSplitDestVTs(N.getValueType(0));
    let mut dl: SDLoc = SDLoc { N };
    let mut SrcLo: SDValue = SDValue {};
    let mut SrcHi: SDValue = SDValue {};
    let mut SrcVT: EVT = N.getOperand(0).getValueType();
    if self.getTypeAction(SrcVT) == TypeSplitVector {
        self.GetSplitVector(N.getOperand(0), SrcLo, SrcHi);
    } else {
        tie(SrcLo, SrcHi) = self.DAG.SplitVectorOperand(N, 0);
    }
    Lo = self.DAG.getNode(N.getOpcode(), dl, DstVTLo, SrcLo, N.getOperand(1));
    Hi = self.DAG.getNode(N.getOpcode(), dl, DstVTHi, SrcHi, N.getOperand(1));
}

fn DAGTypeLegalizer::SplitVecRes_VECTOR_REPEAT(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut VT: EVT = N.getValueType(0);
    let mut Src: SDValue = N.getOperand(0);
    assert!(LoVT == HiVT, "Expected equal split types");
    let mut DL: SDLoc = SDLoc { N };
    let mut SplitSrcVT: EVT = SrcLo.getValueType();
    let mut Deinterleaved: SDValue = self.DAG.getNode(VECTOR_DEINTERLEAVE, DL, self.DAG.getVTList(SplitSrcVT, SplitSrcVT), SrcLo, SrcHi);
    let mut Even: SDValue = self.DAG.getNode(VECTOR_REPEAT, DL, LoVT, Deinterleaved.getValue(0));
    let mut Odd: SDValue = self.DAG.getNode(VECTOR_REPEAT, DL, LoVT, Deinterleaved.getValue(1));
    let mut Interleaved: SDValue = self.DAG.getNode(VECTOR_INTERLEAVE, DL, self.DAG.getVTList(LoVT, LoVT), Even, Odd);
    Lo = Interleaved.getValue(0);
    Hi = Interleaved.getValue(1);
}

fn DAGTypeLegalizer::SplitVecRes_VECTOR_REVERSE(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut InLo: SDValue = SDValue {};
    let mut InHi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(0), InLo, InHi);
    let mut DL: SDLoc = SDLoc { N };
    Lo = self.DAG.getNode(VECTOR_REVERSE, DL, InHi.getValueType(), InHi);
    Hi = self.DAG.getNode(VECTOR_REVERSE, DL, InLo.getValueType(), InLo);
}

fn DAGTypeLegalizer::SplitVecRes_VECTOR_SPLICE(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut DL: SDLoc = SDLoc { N };
    let mut Expanded: SDValue = self.TLI.expandVectorSplice(N, self.DAG);
    tie(Lo, Hi) = self.DAG.SplitVector(Expanded, DL);
}

fn DAGTypeLegalizer::SplitVecRes_VP_REVERSE(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut VT: EVT = N.getValueType(0);
    let mut Val: SDValue = N.getOperand(0);
    let mut Mask: SDValue = N.getOperand(1);
    let mut EVL: SDValue = N.getOperand(2);
    let mut DL: SDLoc = SDLoc { N };
    let mut OrigVT: EVT = VT;
    if !VT.getVectorElementType().isByteSized() {
        let mut WideEltVT: EVT = VT.getVectorElementType().changeTypeToInteger();
        WideEltVT = WideEltVT.getRoundIntegerType(*self.DAG.getContext());
        VT = VT.changeVectorElementType(*self.DAG.getContext(), WideEltVT);
        Val = self.DAG.getNode(ANY_EXTEND, DL, VT, Val);
    }
    let mut Alignment: Align = self.DAG.getReducedAlign(VT, false);
    let mut MemVT: EVT = getVectorVT(*self.DAG.getContext(), VT.getVectorElementType(), VT.getVectorElementCount());
    let mut StackPtr: SDValue = self.DAG.CreateStackTemporary(MemVT.getStoreSize(), Alignment);
    let mut PtrVT: EVT = StackPtr.getValueType();
    let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
    let mut FrameIndex: i32 = cast(StackPtr.getNode()).getIndex();
    let mut PtrInfo: MachinePointerInfo = getFixedStack(MF, FrameIndex, 0);
    let mut StoreMMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(PtrInfo, MOStore, beforeOrAfterPointer(), Alignment, MMOMetadata {}, System, NotAtomic, NotAtomic);
    let mut LoadMMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(PtrInfo, MOLoad, beforeOrAfterPointer(), Alignment, MMOMetadata {}, System, NotAtomic, NotAtomic);
    let mut EltWidth: u32 = VT.getScalarSizeInBits() / 8;
    let mut NumElemMinus1: SDValue = self.DAG.getNode(SUB, DL, PtrVT, self.DAG.getZExtOrTrunc(EVL, DL, PtrVT), self.DAG.getConstant(1, DL, PtrVT, false, false));
    let mut StartOffset: SDValue = self.DAG.getNode(MUL, DL, PtrVT, NumElemMinus1, self.DAG.getConstant(EltWidth, DL, PtrVT, false, false));
    let mut StorePtr: SDValue = self.DAG.getNode(ADD, DL, PtrVT, StackPtr, StartOffset);
    let mut Stride: SDValue = self.DAG.getConstant(-EltWidth as i64, DL, PtrVT, false, false);
    let mut TrueMask: SDValue = self.DAG.getBoolConstant(true, DL, Mask.getValueType(), VT);
    let mut Store: SDValue = self.DAG.getStridedStoreVP(self.DAG.getEntryNode(), DL, Val, StorePtr, self.DAG.getPOISON(PtrVT), Stride, TrueMask, EVL, MemVT, StoreMMO, UNINDEXED, false, false);
    let mut Load: SDValue = self.DAG.getLoadVP(VT, DL, Store, StackPtr, Mask, EVL, LoadMMO, false);
    if OrigVT != VT {
        Load = self.DAG.getNode(TRUNCATE, DL, OrigVT, Load);
    }
    tie(Lo, Hi) = self.DAG.SplitVector(Load, DL);
}

fn DAGTypeLegalizer::SplitVecRes_VP_SPLICE(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut VT: EVT = N.getValueType(0);
    let mut V1: SDValue = N.getOperand(0);
    let mut V2: SDValue = N.getOperand(1);
    let mut Imm: i64 = cast(N.getOperand(2)).getSExtValue();
    let mut Mask: SDValue = N.getOperand(3);
    let mut EVL1: SDValue = N.getOperand(4);
    let mut EVL2: SDValue = N.getOperand(5);
    let mut DL: SDLoc = SDLoc { N };
    if self.getTypeAction(EVL1.getValueType()) == TypePromoteInteger {
        EVL1 = self.ZExtPromotedInteger(EVL1);
    }
    let mut OrigVT: EVT = VT;
    if !VT.getVectorElementType().isByteSized() {
        let mut WideEltVT: EVT = VT.getVectorElementType().changeTypeToInteger();
        WideEltVT = WideEltVT.getRoundIntegerType(*self.DAG.getContext());
        VT = VT.changeVectorElementType(*self.DAG.getContext(), WideEltVT);
        V1 = self.DAG.getNode(ANY_EXTEND, DL, VT, V1);
        V2 = self.DAG.getNode(ANY_EXTEND, DL, VT, V2);
    }
    let mut Alignment: Align = self.DAG.getReducedAlign(VT, false);
    let mut MemVT: EVT = getVectorVT(*self.DAG.getContext(), VT.getVectorElementType(), VT.getVectorElementCount() * 2);
    let mut StackPtr: SDValue = self.DAG.CreateStackTemporary(MemVT.getStoreSize(), Alignment);
    let mut PtrVT: EVT = StackPtr.getValueType();
    let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
    let mut FrameIndex: i32 = cast(StackPtr.getNode()).getIndex();
    let mut PtrInfo: MachinePointerInfo = getFixedStack(MF, FrameIndex, 0);
    let mut StoreMMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(PtrInfo, MOStore, beforeOrAfterPointer(), Alignment, MMOMetadata {}, System, NotAtomic, NotAtomic);
    let mut LoadMMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(PtrInfo, MOLoad, beforeOrAfterPointer(), Alignment, MMOMetadata {}, System, NotAtomic, NotAtomic);
    let mut EltByteSize: SDValue = self.DAG.getTypeSize(DL, PtrVT, VT.getVectorElementType().getStoreSize());
    let mut EVL1Ptr: SDValue = self.DAG.getZExtOrTrunc(EVL1, DL, PtrVT);
    let mut EVL1Bytes: SDValue = self.DAG.getNode(MUL, DL, PtrVT, EVL1Ptr, EltByteSize);
    let mut VTBytes: SDValue = self.DAG.getTypeSize(DL, PtrVT, VT.getStoreSize());
    EVL1Bytes = self.DAG.getNode(UMIN, DL, PtrVT, EVL1Bytes, VTBytes);
    let mut StackPtr2: SDValue = self.DAG.getMemBasePlusOffset(StackPtr, EVL1Bytes, DL, SDNodeFlags { Flags: None });
    let mut PoisonPtr: SDValue = self.DAG.getPOISON(PtrVT);
    let mut TrueMask: SDValue = self.DAG.getBoolConstant(true, DL, Mask.getValueType(), VT);
    let mut StoreV1: SDValue = self.DAG.getStoreVP(self.DAG.getEntryNode(), DL, V1, StackPtr, PoisonPtr, TrueMask, EVL1, V1.getValueType(), StoreMMO, UNINDEXED, false, false);
    let mut StoreV2: SDValue = self.DAG.getStoreVP(StoreV1, DL, V2, StackPtr2, PoisonPtr, TrueMask, EVL2, V2.getValueType(), StoreMMO, UNINDEXED, false, false);
    let mut Load: SDValue = SDValue {};
    if Imm >= 0 {
        StackPtr = self.TLI.getVectorElementPointer(self.DAG, StackPtr, VT, N.getOperand(2), SDNodeFlags { Flags: None });
        Load = self.DAG.getLoadVP(VT, DL, StoreV2, StackPtr, Mask, EVL2, LoadMMO, false);
    } else {
        let mut TrailingElts: u64 = -Imm;
        let mut EltWidth: u32 = VT.getScalarSizeInBits() / 8;
        let mut TrailingBytes: SDValue = self.DAG.getConstant(TrailingElts * EltWidth, DL, PtrVT, false, false);
        let mut OffsetToV2: SDValue = self.DAG.getNode(SUB, DL, PtrVT, StackPtr2, StackPtr);
        TrailingBytes = self.DAG.getNode(UMIN, DL, PtrVT, TrailingBytes, OffsetToV2);
        StackPtr2 = self.DAG.getNode(SUB, DL, PtrVT, StackPtr2, TrailingBytes);
        Load = self.DAG.getLoadVP(VT, DL, StoreV2, StackPtr2, Mask, EVL2, LoadMMO, false);
    }
    if OrigVT != VT {
        Load = self.DAG.getNode(TRUNCATE, DL, OrigVT, Load);
    }
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(OrigVT);
    Lo = self.DAG.getNode(EXTRACT_SUBVECTOR, DL, LoVT, Load, self.DAG.getVectorIdxConstant(0, DL, false));
    Hi = self.DAG.getNode(EXTRACT_SUBVECTOR, DL, HiVT, Load, self.DAG.getVectorIdxConstant(LoVT.getVectorMinNumElements(), DL, false));
}

fn DAGTypeLegalizer::SplitVecRes_PARTIAL_REDUCE_MLA(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut DL: SDLoc = SDLoc { N };
    let mut Acc: SDValue = N.getOperand(0);
    let mut Input1: SDValue = N.getOperand(1);
    let mut Input2: SDValue = N.getOperand(2);
    let mut AccLo: SDValue = SDValue {};
    let mut AccHi: SDValue = SDValue {};
    self.GetSplitVector(Acc, AccLo, AccHi);
    let mut Opcode: u32 = N.getOpcode();
    if self.getTypeAction(Input1.getValueType()) != TypeSplitVector {
        Lo = self.DAG.getNode(Opcode, DL, AccLo.getValueType(), AccLo, Input1, Input2);
        Hi = AccHi;
        return;
    }
    let mut Input1Lo: SDValue = SDValue {};
    let mut Input1Hi: SDValue = SDValue {};
    let mut Input2Lo: SDValue = SDValue {};
    let mut Input2Hi: SDValue = SDValue {};
    self.GetSplitVector(Input1, Input1Lo, Input1Hi);
    self.GetSplitVector(Input2, Input2Lo, Input2Hi);
    let mut ResultVT: EVT = AccLo.getValueType();
    Lo = self.DAG.getNode(Opcode, DL, ResultVT, AccLo, Input1Lo, Input2Lo);
    Hi = self.DAG.getNode(Opcode, DL, ResultVT, AccHi, Input1Hi, Input2Hi);
}

fn DAGTypeLegalizer::SplitVecRes_GET_ACTIVE_LANE_MASK(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut DL: SDLoc = SDLoc { N };
    let mut Op0: SDValue = N.getOperand(0);
    let mut Op1: SDValue = N.getOperand(1);
    let mut OpVT: EVT = Op0.getValueType();
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(N.getValueType(0));
    Lo = self.DAG.getNode(GET_ACTIVE_LANE_MASK, DL, LoVT, Op0, Op1);
    let mut LoElts: SDValue = self.DAG.getElementCount(DL, OpVT, LoVT.getVectorElementCount());
    let mut HiStartVal: SDValue = self.DAG.getNode(UADDSAT, DL, OpVT, Op0, LoElts);
    Hi = self.DAG.getNode(GET_ACTIVE_LANE_MASK, DL, HiVT, HiStartVal, Op1);
}

fn DAGTypeLegalizer::SplitVecRes_VECTOR_MATCH(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut SourceLo: SDValue = SDValue {};
    let mut SourceHi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(0), SourceLo, SourceHi);
    let mut MaskLo: SDValue = SDValue {};
    let mut MaskHi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(2), MaskLo, MaskHi);
    let mut DL: SDLoc = SDLoc { N };
    Lo = self.DAG.getNode(VECTOR_MATCH, DL, MaskLo.getValueType(), SourceLo, N.getOperand(1), MaskLo, N.getFlags());
    Hi = self.DAG.getNode(VECTOR_MATCH, DL, MaskHi.getValueType(), SourceHi, N.getOperand(1), MaskHi, N.getFlags());
}

fn DAGTypeLegalizer::SplitVecRes_VECTOR_DEINTERLEAVE(self, N: *mut SDNode) {
    let mut Factor: u32 = N.getNumOperands();
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { Factor * 2 };
    for let mut i: u32 = 0; i != Factor; i += 1 {
        let mut OpLo: SDValue = SDValue {};
        let mut OpHi: SDValue = SDValue {};
        self.GetSplitVector(N.getOperand(i), OpLo, OpHi);
        Ops[i * 2] = OpLo;
        Ops[i * 2 + 1] = OpHi;
    }
    let mut VTs: SmallVector<EVT, 8> = SmallVector<EVT, 8> { Factor, Ops[0].getValueType() };
    let mut DL: SDLoc = SDLoc { N };
    let mut ResLo: SDValue = self.DAG.getNode(VECTOR_DEINTERLEAVE, DL, ArrayRef<EVT> { VTs }, SDValue> { Ops }.slice(0, Factor));
    let mut ResHi: SDValue = self.DAG.getNode(VECTOR_DEINTERLEAVE, DL, ArrayRef<EVT> { VTs }, SDValue> { Ops }.slice(Factor, Factor));
    for let mut i: u32 = 0; i != Factor; i += 1 {
        self.SetSplitVector(SDValue { Node: N, ResNo: i }, ResLo.getValue(i), ResHi.getValue(i));
    }
}

fn DAGTypeLegalizer::SplitVecRes_VECTOR_INTERLEAVE(self, N: *mut SDNode) {
    let mut Factor: u32 = N.getNumOperands();
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { Factor * 2 };
    for let mut i: u32 = 0; i != Factor; i += 1 {
        let mut OpLo: SDValue = SDValue {};
        let mut OpHi: SDValue = SDValue {};
        self.GetSplitVector(N.getOperand(i), OpLo, OpHi);
        Ops[i] = OpLo;
        Ops[i + Factor] = OpHi;
    }
    let mut VTs: SmallVector<EVT, 8> = SmallVector<EVT, 8> { Factor, Ops[0].getValueType() };
    let mut DL: SDLoc = SDLoc { N };
    let mut Res: [2]SDValue = [self.DAG.getNode(VECTOR_INTERLEAVE, DL, ArrayRef<EVT> { VTs }, SDValue> { Ops }.slice(0, Factor)), self.DAG.getNode(VECTOR_INTERLEAVE, DL, ArrayRef<EVT> { VTs }, SDValue> { Ops }.slice(Factor, Factor))];
    for let mut i: u32 = 0; i != Factor; i += 1 {
        let mut IdxLo: u32 = 2 * i;
        let mut IdxHi: u32 = 2 * i + 1;
        self.SetSplitVector(SDValue { Node: N, ResNo: i }, Res[IdxLo / Factor].getValue(IdxLo % Factor), Res[IdxHi / Factor].getValue(IdxHi % Factor));
    }
}

fn DAGTypeLegalizer::SplitVectorOperand(self, N: *mut SDNode, OpNo: u32) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalize-types", 1) {
            dbgs() << "Split node operand: ";
            N.dump(&mut self.DAG);
        }
    }
        if !(false) { break; }
    }
    let mut Res: SDValue = SDValue {};
    if self.CustomLowerNode(N, N.getOperand(OpNo).getValueType(), false) {
        return false;
    }
    match N.getOpcode() {
        _ => {
            dbgs() << "SplitVectorOperand Op #" << OpNo << ": ";
        },
        STRICT_FSETCC => {
            STRICT_FSETCCS;
        },
        BITCAST => {
            Res = self.SplitVecOp_BITCAST(N);
        },
        EXTRACT_SUBVECTOR => {
            Res = self.SplitVecOp_EXTRACT_SUBVECTOR(N);
        },
        INSERT_SUBVECTOR => {
            Res = self.SplitVecOp_INSERT_SUBVECTOR(N, OpNo);
        },
        EXTRACT_VECTOR_ELT => {
            Res = self.SplitVecOp_EXTRACT_VECTOR_ELT(N);
        },
        CONCAT_VECTORS => {
            Res = self.SplitVecOp_CONCAT_VECTORS(N);
        },
        VECTOR_FIND_LAST_ACTIVE => {
            Res = self.SplitVecOp_VECTOR_FIND_LAST_ACTIVE(N);
        },
        TRUNCATE => {
            Res = self.SplitVecOp_TruncateHelper(N);
        },
        STRICT_FP_ROUND => {
            FP_ROUND;
        },
        FCOPYSIGN => {
            Res = self.SplitVecOp_FPOpDifferentTypes(N);
        },
        STORE => {
            Res = self.SplitVecOp_STORE(cast(N), OpNo);
        },
        ATOMIC_STORE => {
            Res = self.SplitVecOp_ATOMIC_STORE(cast(N));
        },
        VP_STORE => {
            Res = self.SplitVecOp_VP_STORE(cast(N), OpNo);
        },
        EXPERIMENTAL_VP_STRIDED_STORE => {
            Res = self.SplitVecOp_VP_STRIDED_STORE(cast(N), OpNo);
        },
        MSTORE => {
            Res = self.SplitVecOp_MSTORE(cast(N), OpNo);
        },
        MSCATTER => {
            VP_SCATTER;
        },
        MGATHER => {
            VP_GATHER;
        },
        VSELECT => {
            Res = self.SplitVecOp_VSELECT(N, OpNo);
        },
        MASKED_UDIV => {
            MASKED_SDIV;
        },
        VECTOR_COMPRESS => {
            Res = self.SplitVecOp_VECTOR_COMPRESS(N, OpNo);
        },
        STRICT_SINT_TO_FP => {
            STRICT_UINT_TO_FP;
        },
        FP_TO_SINT_SAT => {
            FP_TO_UINT_SAT;
        },
        FP_TO_SINT => {
            FP_TO_UINT;
        },
        FLDEXP => {
            Res = self.SplitVecOp_FPOpDifferentTypes(N);
        },
        SCMP => {
            UCMP;
        },
        FAKE_USE => {
            Res = self.SplitVecOp_FAKE_USE(N);
        },
        ANY_EXTEND_VECTOR_INREG => {
            SIGN_EXTEND_VECTOR_INREG;
        },
        VECREDUCE_FADD => {
            VECREDUCE_FMUL;
        },
        VECREDUCE_SEQ_FADD => {
            VECREDUCE_SEQ_FMUL;
        },
        VP_REDUCE_FADD => {
            VP_REDUCE_SEQ_FADD;
        },
        CTTZ_ELTS => {
            CTTZ_ELTS_ZERO_POISON;
        },
        VP_CTTZ_ELTS => {
            VP_CTTZ_ELTS_ZERO_POISON;
        },
        EXPERIMENTAL_VECTOR_HISTOGRAM => {
            Res = self.SplitVecOp_VECTOR_HISTOGRAM(N);
        },
        PARTIAL_REDUCE_UMLA => {
            PARTIAL_REDUCE_SMLA;
        },
        VECTOR_MATCH => {
            Res = self.SplitVecOp_VECTOR_MATCH(N, OpNo);
        },
    }
    if !Res.getNode() {
        return false;
    }
    if Res.getNode() == N {
        return true;
    }
    if N.isStrictFPOpcode() {
        assert!(Res.getValueType() == N.getValueType(0) && N.getNumValues() == 2, "Invalid operand expansion");
    } else {
        assert!(Res.getValueType() == N.getValueType(0) && N.getNumValues() == 1, "Invalid operand expansion");
    }
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Res);
    return false;
}

fn DAGTypeLegalizer::SplitVecOp_VECTOR_FIND_LAST_ACTIVE(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut LoMask: SDValue = SDValue {};
    let mut HiMask: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(0), LoMask, HiMask);
    let mut VT: EVT = N.getValueType(0);
    let mut SplitVT: EVT = LoMask.getValueType();
    let mut SplitEC: ElementCount = SplitVT.getVectorElementCount();
    let mut LoFind: SDValue = self.DAG.getNode(VECTOR_FIND_LAST_ACTIVE, DL, VT, LoMask);
    let mut HiFind: SDValue = self.DAG.getNode(VECTOR_FIND_LAST_ACTIVE, DL, VT, HiMask);
    let mut AnyHiActive: SDValue = self.DAG.getNode(VECREDUCE_OR, DL, EVT { i1 }, HiMask);
    let mut Cond: SDValue = self.DAG.getBoolExtOrTrunc(AnyHiActive, DL, self.getSetCCResultType(EVT { i1 }), EVT { i1 });
    return self.DAG.getNode(SELECT, DL, VT, Cond, self.DAG.getNode(ADD, DL, VT, HiFind, self.DAG.getElementCount(DL, VT, SplitEC)), LoFind);
}

fn DAGTypeLegalizer::SplitVecOp_VSELECT(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 0, "Illegal operand must be mask");
    let mut Mask: SDValue = N.getOperand(0);
    let mut Src0: SDValue = N.getOperand(1);
    let mut Src1: SDValue = N.getOperand(2);
    let mut Src0VT: EVT = Src0.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    assert!(Mask.getValueType().isVector(), "VSELECT without a vector mask?");
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(0), Lo, Hi);
    assert!(Lo.getValueType() == Hi.getValueType(), "Lo and Hi have differing types");
    let mut LoOpVT: EVT = EVT {};
    let mut HiOpVT: EVT = EVT {};
    tie(LoOpVT, HiOpVT) = self.DAG.GetSplitDestVTs(Src0VT);
    assert!(LoOpVT == HiOpVT, "Asymmetric vector split?");
    let mut LoOp0: SDValue = SDValue {};
    let mut HiOp0: SDValue = SDValue {};
    let mut LoOp1: SDValue = SDValue {};
    let mut HiOp1: SDValue = SDValue {};
    let mut LoMask: SDValue = SDValue {};
    let mut HiMask: SDValue = SDValue {};
    tie(LoOp0, HiOp0) = self.DAG.SplitVector(Src0, DL);
    tie(LoOp1, HiOp1) = self.DAG.SplitVector(Src1, DL);
    tie(LoMask, HiMask) = self.DAG.SplitVector(Mask, DL);
    let mut LoSelect: SDValue = self.DAG.getNode(VSELECT, DL, LoOpVT, LoMask, LoOp0, LoOp1);
    let mut HiSelect: SDValue = self.DAG.getNode(VSELECT, DL, HiOpVT, HiMask, HiOp0, HiOp1);
    return self.DAG.getNode(CONCAT_VECTORS, DL, Src0VT, LoSelect, HiSelect);
}

fn DAGTypeLegalizer::SplitVecOp_MaskedBinOp(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 2, "Illegal operand must be mask");
    let mut DL: SDLoc = SDLoc { N };
    let mut MaskLo: SDValue = SDValue {};
    let mut MaskHi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(2), MaskLo, MaskHi);
    let mut Lo: SDValue = self.DAG.getNode(N.getOpcode(), DL, LHSLo.getValueType(), LHSLo, RHSLo, MaskLo, N.getFlags());
    let mut Hi: SDValue = self.DAG.getNode(N.getOpcode(), DL, LHSHi.getValueType(), LHSHi, RHSHi, MaskHi, N.getFlags());
    return self.DAG.getNode(CONCAT_VECTORS, DL, N.getValueType(0), Lo, Hi);
}

fn DAGTypeLegalizer::SplitVecOp_VECTOR_COMPRESS(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 1, "Illegal operand must be mask");
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    self.SplitVecRes_VECTOR_COMPRESS(N, Lo, Hi);
    let mut VecVT: EVT = N.getValueType(0);
    return self.DAG.getNode(CONCAT_VECTORS, SDLoc { N }, VecVT, Lo, Hi);
}

fn DAGTypeLegalizer::SplitVecOp_VECREDUCE(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    let mut ResVT: EVT = N.getValueType(0);
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    let mut dl: SDLoc = SDLoc { N };
    let mut VecOp: SDValue = N.getOperand(OpNo);
    let mut VecVT: EVT = VecOp.getValueType();
    assert!(VecVT.isVector(), "Can only split reduce vector operand");
    self.GetSplitVector(VecOp, Lo, Hi);
    let mut LoOpVT: EVT = EVT {};
    let mut HiOpVT: EVT = EVT {};
    tie(LoOpVT, HiOpVT) = self.DAG.GetSplitDestVTs(VecVT);
    let mut CombineOpc: u32 = getVecReduceBaseOpcode(N.getOpcode());
    let mut Partial: SDValue = self.DAG.getNode(CombineOpc, dl, LoOpVT, Lo, Hi, N.getFlags());
    return self.DAG.getNode(N.getOpcode(), dl, ResVT, Partial, N.getFlags());
}

fn DAGTypeLegalizer::SplitVecOp_VECREDUCE_SEQ(self, N: *mut SDNode) -> SDValue {
    let mut ResVT: EVT = N.getValueType(0);
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    let mut dl: SDLoc = SDLoc { N };
    let mut AccOp: SDValue = N.getOperand(0);
    let mut VecOp: SDValue = N.getOperand(1);
    let mut Flags: SDNodeFlags = N.getFlags();
    let mut VecVT: EVT = VecOp.getValueType();
    assert!(VecVT.isVector(), "Can only split reduce vector operand");
    self.GetSplitVector(VecOp, Lo, Hi);
    let mut LoOpVT: EVT = EVT {};
    let mut HiOpVT: EVT = EVT {};
    tie(LoOpVT, HiOpVT) = self.DAG.GetSplitDestVTs(VecVT);
    let mut Partial: SDValue = self.DAG.getNode(N.getOpcode(), dl, ResVT, AccOp, Lo, Flags);
    return self.DAG.getNode(N.getOpcode(), dl, ResVT, Partial, Hi, Flags);
}

fn DAGTypeLegalizer::SplitVecOp_VP_REDUCE(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(N.isVPOpcode(), "Expected VP opcode");
    assert!(OpNo == 1, "Can only split reduce vector operand");
    let mut Opc: u32 = N.getOpcode();
    let mut ResVT: EVT = N.getValueType(0);
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    let mut dl: SDLoc = SDLoc { N };
    let mut VecOp: SDValue = N.getOperand(OpNo);
    let mut VecVT: EVT = VecOp.getValueType();
    assert!(VecVT.isVector(), "Can only split reduce vector operand");
    self.GetSplitVector(VecOp, Lo, Hi);
    let mut MaskLo: SDValue = SDValue {};
    let mut MaskHi: SDValue = SDValue {};
    tie(MaskLo, MaskHi) = self.SplitMask(N.getOperand(2));
    let mut EVLLo: SDValue = SDValue {};
    let mut EVLHi: SDValue = SDValue {};
    tie(EVLLo, EVLHi) = self.DAG.SplitEVL(N.getOperand(3), VecVT, dl);
    let mut Flags: SDNodeFlags = N.getFlags();
    let mut ResLo: SDValue = self.DAG.getNode(Opc, dl, ResVT, ArrayRef<SDValue> { [N.getOperand(0), Lo, MaskLo, EVLLo] }, Flags);
    return self.DAG.getNode(Opc, dl, ResVT, ArrayRef<SDValue> { [ResLo, Hi, MaskHi, EVLHi] }, Flags);
}

fn DAGTypeLegalizer::SplitVecOp_UnaryOp(self, N: *mut SDNode) -> SDValue {
    let mut ResVT: EVT = N.getValueType(0);
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    let mut dl: SDLoc = SDLoc { N };
    self.GetSplitVector(N.getOperand(if N.isStrictFPOpcode() { 1 } else { 0 }), Lo, Hi);
    let mut InVT: EVT = Lo.getValueType();
    let mut OutVT: EVT = getVectorVT(*self.DAG.getContext(), ResVT.getVectorElementType(), InVT.getVectorElementCount());
    if N.isStrictFPOpcode() {
        Lo = self.DAG.getNode(N.getOpcode(), dl, ArrayRef<EVT> { [OutVT, EVT { Other }] }, ArrayRef<SDValue> { [N.getOperand(0), Lo] });
        Hi = self.DAG.getNode(N.getOpcode(), dl, ArrayRef<EVT> { [OutVT, EVT { Other }] }, ArrayRef<SDValue> { [N.getOperand(0), Hi] });
        let mut Ch: SDValue = self.DAG.getNode(TokenFactor, dl, EVT { Other }, Lo.getValue(1), Hi.getValue(1));
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Ch);
    } else {
        Lo = self.DAG.getNode(N.getOpcode(), dl, OutVT, Lo);
        Hi = self.DAG.getNode(N.getOpcode(), dl, OutVT, Hi);
    }
    return self.DAG.getNode(CONCAT_VECTORS, dl, ResVT, Lo, Hi);
}

fn DAGTypeLegalizer::SplitVecOp_FAKE_USE(self, N: *mut SDNode) -> SDValue {
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(1), Lo, Hi);
    let mut Chain: SDValue = self.DAG.getNode(FAKE_USE, SDLoc {}, EVT { Other }, N.getOperand(0), Lo);
    return self.DAG.getNode(FAKE_USE, SDLoc {}, EVT { Other }, Chain, Hi);
}

fn DAGTypeLegalizer::SplitVecOp_BITCAST(self, N: *mut SDNode) -> SDValue {
    let mut ResVT: EVT = N.getValueType(0);
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(0), Lo, Hi);
    let mut dl: SDLoc = SDLoc { N };
    if ResVT.isScalableVector() {
        Lo = self.DAG.getNode(BITCAST, dl, LoVT, Lo);
        Hi = self.DAG.getNode(BITCAST, dl, HiVT, Hi);
        return self.DAG.getNode(CONCAT_VECTORS, dl, ResVT, Lo, Hi);
    }
    Lo = self.BitConvertToInteger(Lo);
    Hi = self.BitConvertToInteger(Hi);
    if self.DAG.getDataLayout().isBigEndian() {
        swap(Lo, Hi);
    }
    return self.DAG.getNode(BITCAST, dl, ResVT, self.JoinIntegers(Lo, Hi));
}

fn DAGTypeLegalizer::SplitVecOp_INSERT_SUBVECTOR(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 1, "Invalid OpNo; can only split SubVec.");
    let mut ResVT: EVT = N.getValueType(0);
    let mut Vec: SDValue = N.getOperand(0);
    let mut SubVec: SDValue = N.getOperand(1);
    let mut Idx: SDValue = N.getOperand(2);
    let mut dl: SDLoc = SDLoc { N };
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    self.GetSplitVector(SubVec, Lo, Hi);
    let mut IdxVal: u64 = operator(Idx).getAsZExtVal();
    let mut LoElts: u64 = Lo.getValueType().getVectorMinNumElements();
    let mut FirstInsertion: SDValue = self.DAG.getNode(INSERT_SUBVECTOR, dl, ResVT, Vec, Lo, Idx);
    let mut SecondInsertion: SDValue = self.DAG.getNode(INSERT_SUBVECTOR, dl, ResVT, FirstInsertion, Hi, self.DAG.getVectorIdxConstant(IdxVal + LoElts, dl, false));
    return SecondInsertion;
}

fn DAGTypeLegalizer::SplitVecOp_EXTRACT_SUBVECTOR(self, N: *mut SDNode) -> SDValue {
    let mut SubVT: EVT = N.getValueType(0);
    let mut Idx: SDValue = N.getOperand(1);
    let mut dl: SDLoc = SDLoc { N };
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(0), Lo, Hi);
    let mut LoElts: ElementCount = Lo.getValueType().getVectorElementCount();
    let mut IdxVal: ElementCount = get(operator(Idx).getAsZExtVal(), SubVT.isScalableVector());
    let mut IdxValMin: u64 = IdxVal.getKnownMinValue();
    let mut SrcVT: EVT = N.getOperand(0).getValueType();
    let mut NumResultElts: ElementCount = SubVT.getVectorElementCount();
    if isKnownLE(IdxVal + NumResultElts, LoElts) {
        return self.DAG.getNode(EXTRACT_SUBVECTOR, dl, SubVT, Lo, Idx);
    }
    let mut LoEltsMin: u32 = LoElts.getKnownMinValue();
    if IdxValMin < LoEltsMin && SubVT.isFixedLengthVector() && SrcVT.isFixedLengthVector() {
        let mut Elts: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
        Elts.reserve(NumResultElts.getFixedValue());
        self.DAG.ExtractVectorElements(Lo, Elts, IdxValMin, LoEltsMin - IdxValMin, EVT {});
        self.DAG.ExtractVectorElements(Hi, Elts, 0, SubVT.getVectorNumElements() - Elts.len, EVT {});
        return self.DAG.getBuildVector(SubVT, dl, ArrayRef<SDValue> { Elts });
    }
    if SubVT.isScalableVector() == SrcVT.isScalableVector() {
        let mut ExtractIdx: ElementCount = IdxVal - LoElts;
        if ExtractIdx.isKnownMultipleOf(NumResultElts) {
            return self.DAG.getExtractSubvector(dl, SubVT, Hi, ExtractIdx.getKnownMinValue());
        }
        let mut HiVT: EVT = Hi.getValueType();
        assert!(HiVT.isFixedLengthVector(), "Only fixed-vector extracts are supported in this case");
        let mut Mask: SmallVector<int, 8> = SmallVector<int, 8> { HiVT.getVectorNumElements(), -1 };
        for let mut I: i32 = 0; I != NumResultElts.getFixedValue(); I += 1 {
            Mask[I] = ExtractIdx.getFixedValue() + I;
        }
        let mut Shuffle: SDValue = self.DAG.getVectorShuffle(HiVT, dl, Hi, self.DAG.getPOISON(HiVT), ArrayRef<int> { Mask });
        return self.DAG.getExtractSubvector(dl, SubVT, Shuffle, 0);
    }
    assert!(SubVT.isFixedLengthVector(), "Extracting scalable subvector from fixed-width unsupported");
    if SubVT.getScalarType() == EVT { i1 } {
        report_fatal_error("Don't know how to extract fixed-width predicate subvector from a scalable predicate vector", true);
    }
    let mut Vec: SDValue = N.getOperand(0);
    let mut VecVT: EVT = Vec.getValueType();
    let mut SmallestAlign: Align = self.DAG.getReducedAlign(VecVT, false);
    let mut StackPtr: SDValue = self.DAG.CreateStackTemporary(VecVT.getStoreSize(), SmallestAlign);
    let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
    let mut FrameIndex: i32 = cast(StackPtr.getNode()).getIndex();
    let mut PtrInfo: MachinePointerInfo = getFixedStack(MF, FrameIndex, 0);
    let mut Store: SDValue = self.DAG.getStore(self.DAG.getEntryNode(), dl, Vec, StackPtr, PtrInfo, SmallestAlign, MONone, MMOMetadata {});
    StackPtr = self.TLI.getVectorSubVecPointer(self.DAG, StackPtr, VecVT, SubVT, Idx, SDNodeFlags { Flags: None });
    return self.DAG.getLoad(SubVT, dl, Store, StackPtr, getUnknownStack(self.DAG.getMachineFunction()), MaybeAlign {}, MONone, MMOMetadata {});
}

fn DAGTypeLegalizer::SplitVecOp_EXTRACT_VECTOR_ELT(self, N: *mut SDNode) -> SDValue {
    let mut Vec: SDValue = N.getOperand(0);
    let mut Idx: SDValue = N.getOperand(1);
    let mut VecVT: EVT = Vec.getValueType();
    if dyn_cast(Idx) {
        Index;
    } else {
        let mut IdxVal: u64 = Index.getZExtValue();
        let mut Lo: SDValue = SDValue {};
        let mut Hi: SDValue = SDValue {};
        self.GetSplitVector(Vec, Lo, Hi);
        let mut LoElts: u64 = Lo.getValueType().getVectorMinNumElements();
        if IdxVal < LoElts {
            return SDValue { Node: self.DAG.UpdateNodeOperands(N, Lo, Idx), ResNo: 0 };
        } else if !Vec.getValueType().isScalableVector() {
            return SDValue { Node: self.DAG.UpdateNodeOperands(N, Hi, self.DAG.getConstant(IdxVal - LoElts, SDLoc { N }, Idx.getValueType(), false, false)), ResNo: 0 };
        }
    }
    if self.CustomLowerNode(N, N.getValueType(0), true) {
        return SDValue {};
    }
    let mut dl: SDLoc = SDLoc { N };
    let mut EltVT: EVT = VecVT.getVectorElementType();
    if !EltVT.isByteSized() {
        EltVT = EltVT.changeTypeToInteger().getRoundIntegerType(*self.DAG.getContext());
        VecVT = VecVT.changeElementType(*self.DAG.getContext(), EltVT);
        Vec = self.DAG.getNode(ANY_EXTEND, dl, VecVT, Vec);
        let mut NewExtract: SDValue = self.DAG.getNode(EXTRACT_VECTOR_ELT, dl, EltVT, Vec, Idx);
        return self.DAG.getAnyExtOrTrunc(NewExtract, dl, N.getValueType(0));
    }
    let mut SmallestAlign: Align = self.DAG.getReducedAlign(VecVT, false);
    let mut StackPtr: SDValue = self.DAG.CreateStackTemporary(VecVT.getStoreSize(), SmallestAlign);
    let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
    let mut FrameIndex: i32 = cast(StackPtr.getNode()).getIndex();
    let mut PtrInfo: MachinePointerInfo = getFixedStack(MF, FrameIndex, 0);
    let mut Store: SDValue = self.DAG.getStore(self.DAG.getEntryNode(), dl, Vec, StackPtr, PtrInfo, SmallestAlign, MONone, MMOMetadata {});
    StackPtr = self.TLI.getVectorElementPointer(self.DAG, StackPtr, VecVT, Idx, SDNodeFlags { Flags: None });
    assert!(N.getValueType(0).bitsGE(EltVT), "Illegal EXTRACT_VECTOR_ELT.");
    return self.DAG.getExtLoad(EXTLOAD, dl, N.getValueType(0), Store, StackPtr, getUnknownStack(self.DAG.getMachineFunction()), EltVT, MaybeAlign { commonAlignment(SmallestAlign, EltVT.getFixedSizeInBits() / 8) }, MONone, MMOMetadata {});
}

fn DAGTypeLegalizer::SplitVecOp_ExtVecInRegOp(self, N: *mut SDNode) -> SDValue {
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    self.SplitVecRes_ExtVecInRegOp(N, Lo, Hi);
    return self.DAG.getNode(CONCAT_VECTORS, SDLoc { N }, N.getValueType(0), Lo, Hi);
}

fn DAGTypeLegalizer::SplitVecOp_Gather(self, N: *mut MemSDNode, OpNo: u32) -> SDValue {
    OpNo as void;
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    self.SplitVecRes_Gather(N, Lo, Hi, false);
    let mut Res: SDValue = self.DAG.getNode(CONCAT_VECTORS, SDLoc { N }, N.getValueType(0), Lo, Hi);
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Res);
    return SDValue {};
}

fn DAGTypeLegalizer::SplitVecOp_VP_STORE(self, N: *mut VPStoreSDNode, OpNo: u32) -> SDValue {
    assert!(N.isUnindexed(), "Indexed vp_store of vector?");
    let mut Ch: SDValue = N.getChain();
    let mut Ptr: SDValue = N.getBasePtr();
    let mut Offset: SDValue = N.getOffset();
    assert!(Offset.isUndef(), "Unexpected VP store offset");
    let mut Mask: SDValue = N.getMask();
    let mut EVL: SDValue = N.getVectorLength();
    let mut Data: SDValue = N.getValue();
    let mut Alignment: Align = N.getBaseAlign();
    let mut DL: SDLoc = SDLoc { N };
    let mut DataLo: SDValue = SDValue {};
    let mut DataHi: SDValue = SDValue {};
    if self.getTypeAction(Data.getValueType()) == TypeSplitVector {
        self.GetSplitVector(Data, DataLo, DataHi);
    } else {
        tie(DataLo, DataHi) = self.DAG.SplitVector(Data, DL);
    }
    let mut MaskLo: SDValue = SDValue {};
    let mut MaskHi: SDValue = SDValue {};
    if OpNo == 1 && Mask.getOpcode() == SETCC {
        self.SplitVecRes_SETCC(Mask.getNode(), MaskLo, MaskHi);
    } else {
        if self.getTypeAction(Mask.getValueType()) == TypeSplitVector {
            self.GetSplitVector(Mask, MaskLo, MaskHi);
        } else {
            tie(MaskLo, MaskHi) = self.DAG.SplitVector(Mask, DL);
        }
    }
    let mut MemoryVT: EVT = N.getMemoryVT();
    let mut LoMemVT: EVT = EVT {};
    let mut HiMemVT: EVT = EVT {};
    let mut HiIsEmpty: bool = false;
    tie(LoMemVT, HiMemVT) = self.DAG.GetDependentSplitDestVTs(MemoryVT, DataLo.getValueType(), &mut HiIsEmpty);
    let mut EVLLo: SDValue = SDValue {};
    let mut EVLHi: SDValue = SDValue {};
    tie(EVLLo, EVLHi) = self.DAG.SplitEVL(EVL, Data.getValueType(), DL);
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(N.getPointerInfo(), MOStore, beforeOrAfterPointer(), Alignment, MMOMetadata { AAInfo: N.getAAInfo(), Ranges: N.getRanges(), MemCacheHint: null }, System, NotAtomic, NotAtomic);
    Lo = self.DAG.getStoreVP(Ch, DL, DataLo, Ptr, Offset, MaskLo, EVLLo, LoMemVT, MMO, N.getAddressingMode(), N.isTruncatingStore(), N.isCompressingStore());
    if HiIsEmpty {
        return Lo;
    }
    Ptr = self.TLI.IncrementMemoryAddress(Ptr, MaskLo, DL, LoMemVT, self.DAG, N.isCompressingStore());
    let mut MPI: MachinePointerInfo = MachinePointerInfo { 0, 0 };
    if LoMemVT.isScalableVector() {
        Alignment = commonAlignment(Alignment, LoMemVT.getSizeInBits().getKnownMinValue() / 8);
        MPI = MachinePointerInfo { N.getPointerInfo().getAddrSpace(), 0 };
    } else {
        MPI = N.getPointerInfo().getWithOffset(LoMemVT.getStoreSize().getFixedValue());
    }
    MMO = self.DAG.getMachineFunction().getMachineMemOperand(MPI, MOStore, beforeOrAfterPointer(), Alignment, MMOMetadata { AAInfo: N.getAAInfo(), Ranges: N.getRanges(), MemCacheHint: null }, System, NotAtomic, NotAtomic);
    Hi = self.DAG.getStoreVP(Ch, DL, DataHi, Ptr, Offset, MaskHi, EVLHi, HiMemVT, MMO, N.getAddressingMode(), N.isTruncatingStore(), N.isCompressingStore());
    return self.DAG.getNode(TokenFactor, DL, EVT { Other }, Lo, Hi);
}

fn DAGTypeLegalizer::SplitVecOp_VP_STRIDED_STORE(self, N: *mut VPStridedStoreSDNode, OpNo: u32) -> SDValue {
    assert!(N.isUnindexed(), "Indexed vp_strided_store of a vector?");
    assert!(N.getOffset().isUndef(), "Unexpected VP strided store offset");
    let mut DL: SDLoc = SDLoc { N };
    let mut Data: SDValue = N.getValue();
    let mut LoData: SDValue = SDValue {};
    let mut HiData: SDValue = SDValue {};
    if self.getTypeAction(Data.getValueType()) == TypeSplitVector {
        self.GetSplitVector(Data, LoData, HiData);
    } else {
        tie(LoData, HiData) = self.DAG.SplitVector(Data, DL);
    }
    let mut LoMemVT: EVT = EVT {};
    let mut HiMemVT: EVT = EVT {};
    let mut HiIsEmpty: bool = false;
    tie(LoMemVT, HiMemVT) = self.DAG.GetDependentSplitDestVTs(N.getMemoryVT(), LoData.getValueType(), &mut HiIsEmpty);
    let mut Mask: SDValue = N.getMask();
    let mut LoMask: SDValue = SDValue {};
    let mut HiMask: SDValue = SDValue {};
    if OpNo == 1 && Mask.getOpcode() == SETCC {
        self.SplitVecRes_SETCC(Mask.getNode(), LoMask, HiMask);
    } else if self.getTypeAction(Mask.getValueType()) == TypeSplitVector {
        self.GetSplitVector(Mask, LoMask, HiMask);
    } else {
        tie(LoMask, HiMask) = self.DAG.SplitVector(Mask, DL);
    }
    let mut LoEVL: SDValue = SDValue {};
    let mut HiEVL: SDValue = SDValue {};
    tie(LoEVL, HiEVL) = self.DAG.SplitEVL(N.getVectorLength(), Data.getValueType(), DL);
    let mut Lo: SDValue = self.DAG.getStridedStoreVP(N.getChain(), DL, LoData, N.getBasePtr(), N.getOffset(), N.getStride(), LoMask, LoEVL, LoMemVT, N.getMemOperand(), N.getAddressingMode(), N.isTruncatingStore(), N.isCompressingStore());
    if HiIsEmpty {
        return Lo;
    }
    let mut PtrVT: EVT = N.getBasePtr().getValueType();
    let mut Increment: SDValue = self.DAG.getNode(MUL, DL, PtrVT, LoEVL, self.DAG.getSExtOrTrunc(N.getStride(), DL, PtrVT));
    let mut Ptr: SDValue = self.DAG.getNode(ADD, DL, PtrVT, N.getBasePtr(), Increment);
    let mut Alignment: Align = N.getBaseAlign();
    if LoMemVT.isScalableVector() {
        Alignment = commonAlignment(Alignment, LoMemVT.getSizeInBits().getKnownMinValue() / 8);
    }
    let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(MachinePointerInfo { N.getPointerInfo().getAddrSpace(), 0 }, MOStore, beforeOrAfterPointer(), Alignment, MMOMetadata { AAInfo: N.getAAInfo(), Ranges: N.getRanges(), MemCacheHint: null }, System, NotAtomic, NotAtomic);
    let mut Hi: SDValue = self.DAG.getStridedStoreVP(N.getChain(), DL, HiData, Ptr, N.getOffset(), N.getStride(), HiMask, HiEVL, HiMemVT, MMO, N.getAddressingMode(), N.isTruncatingStore(), N.isCompressingStore());
    return self.DAG.getNode(TokenFactor, DL, EVT { Other }, Lo, Hi);
}

fn DAGTypeLegalizer::SplitVecOp_MSTORE(self, N: *mut MaskedStoreSDNode, OpNo: u32) -> SDValue {
    assert!(N.isUnindexed(), "Indexed masked store of vector?");
    let mut Ch: SDValue = N.getChain();
    let mut Ptr: SDValue = N.getBasePtr();
    let mut Offset: SDValue = N.getOffset();
    assert!(Offset.isUndef(), "Unexpected indexed masked store offset");
    let mut Mask: SDValue = N.getMask();
    let mut Data: SDValue = N.getValue();
    let mut Alignment: Align = N.getBaseAlign();
    let mut DL: SDLoc = SDLoc { N };
    let mut DataLo: SDValue = SDValue {};
    let mut DataHi: SDValue = SDValue {};
    if self.getTypeAction(Data.getValueType()) == TypeSplitVector {
        self.GetSplitVector(Data, DataLo, DataHi);
    } else {
        tie(DataLo, DataHi) = self.DAG.SplitVector(Data, DL);
    }
    let mut MaskLo: SDValue = SDValue {};
    let mut MaskHi: SDValue = SDValue {};
    if OpNo == 1 && Mask.getOpcode() == SETCC {
        self.SplitVecRes_SETCC(Mask.getNode(), MaskLo, MaskHi);
    } else {
        if self.getTypeAction(Mask.getValueType()) == TypeSplitVector {
            self.GetSplitVector(Mask, MaskLo, MaskHi);
        } else {
            tie(MaskLo, MaskHi) = self.DAG.SplitVector(Mask, DL);
        }
    }
    let mut MemoryVT: EVT = N.getMemoryVT();
    let mut LoMemVT: EVT = EVT {};
    let mut HiMemVT: EVT = EVT {};
    let mut HiIsEmpty: bool = false;
    tie(LoMemVT, HiMemVT) = self.DAG.GetDependentSplitDestVTs(MemoryVT, DataLo.getValueType(), &mut HiIsEmpty);
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    let mut Res: SDValue = SDValue {};
    let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(N.getPointerInfo(), MOStore, beforeOrAfterPointer(), Alignment, MMOMetadata { AAInfo: N.getAAInfo(), Ranges: N.getRanges(), MemCacheHint: N.getMemCacheHint() }, System, NotAtomic, NotAtomic);
    Lo = self.DAG.getMaskedStore(Ch, DL, DataLo, Ptr, Offset, MaskLo, LoMemVT, MMO, N.getAddressingMode(), N.isTruncatingStore(), N.isCompressingStore());
    if HiIsEmpty {
        Res = Lo;
    } else {
        Ptr = self.TLI.IncrementMemoryAddress(Ptr, MaskLo, DL, LoMemVT, self.DAG, N.isCompressingStore());
        let mut MPI: MachinePointerInfo = MachinePointerInfo { 0, 0 };
        if LoMemVT.isScalableVector() {
            Alignment = commonAlignment(Alignment, LoMemVT.getSizeInBits().getKnownMinValue() / 8);
            MPI = MachinePointerInfo { N.getPointerInfo().getAddrSpace(), 0 };
        } else {
            MPI = N.getPointerInfo().getWithOffset(LoMemVT.getStoreSize().getFixedValue());
        }
        MMO = self.DAG.getMachineFunction().getMachineMemOperand(MPI, MOStore, beforeOrAfterPointer(), Alignment, MMOMetadata { AAInfo: N.getAAInfo(), Ranges: N.getRanges(), MemCacheHint: N.getMemCacheHint() }, System, NotAtomic, NotAtomic);
        Hi = self.DAG.getMaskedStore(Ch, DL, DataHi, Ptr, Offset, MaskHi, HiMemVT, MMO, N.getAddressingMode(), N.isTruncatingStore(), N.isCompressingStore());
        Res = self.DAG.getNode(TokenFactor, DL, EVT { Other }, Lo, Hi);
    }
    return Res;
}

fn DAGTypeLegalizer::SplitVecOp_Scatter(self, N: *mut MemSDNode, OpNo: u32) -> SDValue {
    let mut Ch: SDValue = N.getChain();
    let mut Ptr: SDValue = N.getBasePtr();
    let mut MemoryVT: EVT = N.getMemoryVT();
    let mut Alignment: Align = N.getBaseAlign();
    let mut DL: SDLoc = SDLoc { N };
    let mut Ops: Operands = Closure_11 { N: &mut N }.call();
    let mut LoMemVT: EVT = EVT {};
    let mut HiMemVT: EVT = EVT {};
    tie(LoMemVT, HiMemVT) = self.DAG.GetSplitDestVTs(MemoryVT);
    let mut DataLo: SDValue = SDValue {};
    let mut DataHi: SDValue = SDValue {};
    if self.getTypeAction(Ops.Data.getValueType()) == TypeSplitVector {
        self.GetSplitVector(Ops.Data, DataLo, DataHi);
    } else {
        tie(DataLo, DataHi) = self.DAG.SplitVector(Ops.Data, DL);
    }
    let mut MaskLo: SDValue = SDValue {};
    let mut MaskHi: SDValue = SDValue {};
    if OpNo == 1 && Ops.Mask.getOpcode() == SETCC {
        self.SplitVecRes_SETCC(Ops.Mask.getNode(), MaskLo, MaskHi);
    } else {
        tie(MaskLo, MaskHi) = self.SplitMask(Ops.Mask, DL);
    }
    let mut IndexHi: SDValue = SDValue {};
    let mut IndexLo: SDValue = SDValue {};
    if self.getTypeAction(Ops.Index.getValueType()) == TypeSplitVector {
        self.GetSplitVector(Ops.Index, IndexLo, IndexHi);
    } else {
        tie(IndexLo, IndexHi) = self.DAG.SplitVector(Ops.Index, DL);
    }
    let mut Lo: SDValue = SDValue {};
    let mut MMOFlags: Flags = N.getMemOperand().getFlags();
    let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(N.getPointerInfo(), MMOFlags, beforeOrAfterPointer(), Alignment, MMOMetadata { AAInfo: N.getAAInfo(), Ranges: N.getRanges(), MemCacheHint: null }, System, NotAtomic, NotAtomic);
    if dyn_cast(N) {
        MSC;
    } else {
        let mut OpsLo: [6]SDValue = [Ch, DataLo, MaskLo, Ptr, IndexLo, Ops.Scale];
        Lo = self.DAG.getMaskedScatter(self.DAG.getVTList(EVT { Other }), LoMemVT, DL, ArrayRef<SDValue> { OpsLo }, MMO, MSC.getIndexType(), MSC.isTruncatingStore());
        let mut OpsHi: [6]SDValue = [Lo, DataHi, MaskHi, Ptr, IndexHi, Ops.Scale];
        return self.DAG.getMaskedScatter(self.DAG.getVTList(EVT { Other }), HiMemVT, DL, ArrayRef<SDValue> { OpsHi }, MMO, MSC.getIndexType(), MSC.isTruncatingStore());
    }
    let mut VPSC: *mut VPScatterSDNode = cast(N);
    let mut EVLLo: SDValue = SDValue {};
    let mut EVLHi: SDValue = SDValue {};
    tie(EVLLo, EVLHi) = self.DAG.SplitEVL(VPSC.getVectorLength(), Ops.Data.getValueType(), DL);
    let mut OpsLo: [7]SDValue = [Ch, DataLo, Ptr, IndexLo, Ops.Scale, MaskLo, EVLLo];
    Lo = self.DAG.getScatterVP(self.DAG.getVTList(EVT { Other }), LoMemVT, DL, ArrayRef<SDValue> { OpsLo }, MMO, VPSC.getIndexType());
    let mut OpsHi: [7]SDValue = [Lo, DataHi, Ptr, IndexHi, Ops.Scale, MaskHi, EVLHi];
    return self.DAG.getScatterVP(self.DAG.getVTList(EVT { Other }), HiMemVT, DL, ArrayRef<SDValue> { OpsHi }, MMO, VPSC.getIndexType());
}

fn DAGTypeLegalizer::SplitVecOp_STORE(self, N: *mut StoreSDNode, OpNo: u32) -> SDValue {
    assert!(N.isUnindexed(), "Indexed store of vector?");
    assert!(OpNo == 1, "Can only split the stored value");
    let mut DL: SDLoc = SDLoc { N };
    let mut isTruncating: bool = N.isTruncatingStore();
    let mut Ch: SDValue = N.getChain();
    let mut Ptr: SDValue = N.getBasePtr();
    let mut MemoryVT: EVT = N.getMemoryVT();
    let mut Alignment: Align = N.getBaseAlign();
    let mut MMOFlags: Flags = N.getMemOperand().getFlags();
    let mut AAInfo: AAMDNodes = N.getAAInfo();
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(1), Lo, Hi);
    let mut LoMemVT: EVT = EVT {};
    let mut HiMemVT: EVT = EVT {};
    tie(LoMemVT, HiMemVT) = self.DAG.GetSplitDestVTs(MemoryVT);
    if !LoMemVT.isByteSized() || !HiMemVT.isByteSized() {
        return self.TLI.scalarizeVectorStore(N, self.DAG);
    }
    if isTruncating {
        Lo = self.DAG.getTruncStore(Ch, DL, Lo, Ptr, N.getPointerInfo(), LoMemVT, Alignment, MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
    } else {
        Lo = self.DAG.getStore(Ch, DL, Lo, Ptr, N.getPointerInfo(), Alignment, MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
    }
    let mut MPI: MachinePointerInfo = MachinePointerInfo { 0, 0 };
    self.IncrementPointer(N, LoMemVT, MPI, Ptr, null);
    if isTruncating {
        Hi = self.DAG.getTruncStore(Ch, DL, Hi, Ptr, MPI, HiMemVT, Alignment, MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
    } else {
        Hi = self.DAG.getStore(Ch, DL, Hi, Ptr, MPI, Alignment, MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
    }
    return self.DAG.getNode(TokenFactor, DL, EVT { Other }, Lo, Hi);
}

fn DAGTypeLegalizer::SplitVecOp_ATOMIC_STORE(self, N: *mut AtomicSDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Ctx: *mut LLVMContext = *self.DAG.getContext();
    let mut StVal: SDValue = N.getVal();
    let mut VT: EVT = StVal.getValueType();
    let mut MemIntVT: EVT = getIntegerVT(Ctx, N.getMemoryVT().getSizeInBits().operator unsigned long long());
    let mut IntVecVT: EVT = VT.changeVectorElementTypeToInteger();
    let mut IntEltVT: EVT = IntVecVT.getVectorElementType();
    let mut WideVT: EVT = self.TLI.getLegalTypeToTransformTo(Ctx, IntVecVT);
    if self.DAG.getDataLayout().isLittleEndian() && self.TLI.isTypeLegal(MemIntVT) && WideVT.isVector() && WideVT.getVectorElementType() == IntEltVT && IntEltVT.getSizeInBits().operator unsigned long long() <= MemIntVT.getSizeInBits().operator unsigned long long() && WideVT.getSizeInBits().operator unsigned long long() % MemIntVT.getSizeInBits().operator unsigned long long() == 0 {
        let mut Wide: SDValue = self.ModifyToType(self.DAG.getBitcast(IntVecVT, StVal), WideVT, false);
        let mut NumMemElts: u32 = WideVT.getSizeInBits().operator unsigned long long() / MemIntVT.getSizeInBits().operator unsigned long long();
        let mut MemVecVT: EVT = getVectorVT(Ctx, MemIntVT, NumMemElts, false);
        let mut Elt: SDValue = self.DAG.getExtractVectorElt(DL, MemIntVT, self.DAG.getBitcast(MemVecVT, Wide), 0);
        return self.DAG.getAtomic(ATOMIC_STORE, DL, MemIntVT, N.getChain(), Elt, N.getBasePtr(), N.getMemOperand());
    }
    let mut IntVT: EVT = getIntegerVT(Ctx, VT.getSizeInBits().operator unsigned long long());
    let mut AsInt: SDValue = self.DAG.getBitcast(IntVT, StVal);
    return self.DAG.getAtomic(ATOMIC_STORE, DL, MemIntVT, N.getChain(), AsInt, N.getBasePtr(), N.getMemOperand());
}

fn DAGTypeLegalizer::SplitVecOp_CONCAT_VECTORS(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Elts: SmallVector<SDValue, 32> = SmallVector<SDValue, 32> {};
    let mut EltVT: EVT = N.getValueType(0).getVectorElementType();
    for Op in N.op_values() {
        for let mut i: u32 = 0;
let mut e: u32 = Op.getValueType().getVectorNumElements(); i != e; i += 1 {
            Elts.push(self.DAG.getExtractVectorElt(DL, EltVT, Op, i));
        }
    }
    return self.DAG.getBuildVector(N.getValueType(0), DL, ArrayRef<SDValue> { Elts });
}

fn DAGTypeLegalizer::SplitVecOp_TruncateHelper(self, N: *mut SDNode) -> SDValue {
    let mut OpNo: u32 = if N.isStrictFPOpcode() { 1 } else { 0 };
    let mut InVec: SDValue = N.getOperand(OpNo);
    let mut InVT: EVT = operator(InVec).getValueType(0);
    let mut OutVT: EVT = N.getValueType(0);
    let mut NumElements: ElementCount = OutVT.getVectorElementCount();
    let mut IsFloat: bool = OutVT.isFloatingPoint();
    let mut InElementSize: u32 = InVT.getScalarSizeInBits();
    let mut OutElementSize: u32 = OutVT.getScalarSizeInBits();
    let mut LoOutVT: EVT = EVT {};
    let mut HiOutVT: EVT = EVT {};
    tie(LoOutVT, HiOutVT) = self.DAG.GetSplitDestVTs(OutVT);
    assert!(LoOutVT == HiOutVT, "Unequal split?");
    if self.isTypeLegal(LoOutVT) || InElementSize <= OutElementSize * 2 || (IsFloat && !isPowerOf2_32(InElementSize)) {
        return self.SplitVecOp_UnaryOp(N);
    }
    let mut DL: SDLoc = SDLoc { N };
    let mut FinalVT: EVT = InVT;
    while self.getTypeAction(FinalVT) == TypeSplitVector {
        FinalVT = FinalVT.getHalfNumVectorElementsVT(*self.DAG.getContext());
    }
    if self.getTypeAction(FinalVT) == TypeScalarizeVector {
        return self.SplitVecOp_UnaryOp(N);
    }
    let mut InLoVec: SDValue = SDValue {};
    let mut InHiVec: SDValue = SDValue {};
    self.GetSplitVector(InVec, InLoVec, InHiVec);
    let mut HalfElementVT: EVT = if IsFloat { getFloatingPointVT(InElementSize / 2) } else { getIntegerVT(*self.DAG.getContext(), InElementSize / 2) };
    let mut HalfVT: EVT = getVectorVT(*self.DAG.getContext(), HalfElementVT, NumElements.divideCoefficientBy(2));
    let mut HalfLo: SDValue = SDValue {};
    let mut HalfHi: SDValue = SDValue {};
    let mut Chain: SDValue = SDValue {};
    if N.isStrictFPOpcode() {
        HalfLo = self.DAG.getNode(N.getOpcode(), DL, ArrayRef<EVT> { [HalfVT, EVT { Other }] }, ArrayRef<SDValue> { [N.getOperand(0), InLoVec] });
        HalfHi = self.DAG.getNode(N.getOpcode(), DL, ArrayRef<EVT> { [HalfVT, EVT { Other }] }, ArrayRef<SDValue> { [N.getOperand(0), InHiVec] });
        Chain = self.DAG.getNode(TokenFactor, DL, EVT { Other }, HalfLo.getValue(1), HalfHi.getValue(1));
    } else {
        HalfLo = self.DAG.getNode(N.getOpcode(), DL, HalfVT, InLoVec);
        HalfHi = self.DAG.getNode(N.getOpcode(), DL, HalfVT, InHiVec);
    }
    let mut InterVT: EVT = getVectorVT(*self.DAG.getContext(), HalfElementVT, NumElements);
    let mut InterVec: SDValue = self.DAG.getNode(CONCAT_VECTORS, DL, InterVT, HalfLo, HalfHi);
    if N.isStrictFPOpcode() {
        let mut Res: SDValue = self.DAG.getNode(STRICT_FP_ROUND, DL, ArrayRef<EVT> { [OutVT, EVT { Other }] }, ArrayRef<SDValue> { [Chain, InterVec, self.DAG.getTargetConstant(0, DL, EVT { self.TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, false)] });
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, SDValue { Node: Res.getNode(), ResNo: 1 });
        return Res;
    }
    return if IsFloat { self.DAG.getNode(FP_ROUND, DL, OutVT, InterVec, self.DAG.getTargetConstant(0, DL, EVT { self.TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, false)) } else { self.DAG.getNode(TRUNCATE, DL, OutVT, InterVec) };
}

fn DAGTypeLegalizer::SplitVecOp_VSETCC(self, N: *mut SDNode) -> SDValue {
    let mut Opc: u32 = N.getOpcode();
    let mut isStrict: bool = Opc == STRICT_FSETCC || Opc == STRICT_FSETCCS;
    assert!(N.getValueType(0).isVector() && N.getOperand(if isStrict { 1 } else { 0 }).getValueType().isVector(), "Operand types must be vectors");
    let mut Lo0: SDValue = SDValue {};
    let mut Hi0: SDValue = SDValue {};
    let mut Lo1: SDValue = SDValue {};
    let mut Hi1: SDValue = SDValue {};
    let mut LoRes: SDValue = SDValue {};
    let mut HiRes: SDValue = SDValue {};
    let mut DL: SDLoc = SDLoc { N };
    self.GetSplitVector(N.getOperand(if isStrict { 1 } else { 0 }), Lo0, Hi0);
    self.GetSplitVector(N.getOperand(if isStrict { 2 } else { 1 }), Lo1, Hi1);
    let mut VT: EVT = N.getValueType(0);
    let mut PartResVT: EVT = self.getSetCCResultType(Lo0.getValueType());
    if Opc == SETCC {
        LoRes = self.DAG.getNode(SETCC, DL, PartResVT, Lo0, Lo1, N.getOperand(2));
        HiRes = self.DAG.getNode(SETCC, DL, PartResVT, Hi0, Hi1, N.getOperand(2));
    } else {
        assert!(isStrict, "unexpected node");
        LoRes = self.DAG.getNode(Opc, DL, self.DAG.getVTList(PartResVT, N.getValueType(1)), N.getOperand(0), Lo0, Lo1, N.getOperand(3));
        HiRes = self.DAG.getNode(Opc, DL, self.DAG.getVTList(PartResVT, N.getValueType(1)), N.getOperand(0), Hi0, Hi1, N.getOperand(3));
        let mut NewChain: SDValue = self.DAG.getNode(TokenFactor, DL, EVT { Other }, LoRes.getValue(1), HiRes.getValue(1));
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, NewChain);
    }
    let mut ConcatVT: EVT = PartResVT.getDoubleNumVectorElementsVT(*self.DAG.getContext());
    let mut Con: SDValue = self.DAG.getNode(CONCAT_VECTORS, DL, ConcatVT, LoRes, HiRes);
    if VT == ConcatVT {
        return Con;
    }
    let mut OpVT: EVT = N.getOperand(0).getValueType();
    let mut ExtendCode: NodeType = getExtendForContent(self.TLI.getBooleanContents(OpVT));
    return self.DAG.getExtOrTrunc(Con, DL, VT, ExtendCode);
}

fn DAGTypeLegalizer::SplitVecOp_FP_ROUND(self, N: *mut SDNode) -> SDValue {
    let mut ResVT: EVT = N.getValueType(0);
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    let mut DL: SDLoc = SDLoc { N };
    self.GetSplitVector(N.getOperand(if N.isStrictFPOpcode() { 1 } else { 0 }), Lo, Hi);
    let mut InVT: EVT = Lo.getValueType();
    let mut OutVT: EVT = getVectorVT(*self.DAG.getContext(), ResVT.getVectorElementType(), InVT.getVectorElementCount());
    if N.isStrictFPOpcode() {
        Lo = self.DAG.getNode(N.getOpcode(), DL, ArrayRef<EVT> { [OutVT, EVT { Other }] }, ArrayRef<SDValue> { [N.getOperand(0), Lo, N.getOperand(2)] });
        Hi = self.DAG.getNode(N.getOpcode(), DL, ArrayRef<EVT> { [OutVT, EVT { Other }] }, ArrayRef<SDValue> { [N.getOperand(0), Hi, N.getOperand(2)] });
        let mut NewChain: SDValue = self.DAG.getNode(TokenFactor, DL, EVT { Other }, Lo.getValue(1), Hi.getValue(1));
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, NewChain);
    } else if N.getOpcode() == CONVERT_TO_ARBITRARY_FP {
        Lo = self.DAG.getNode(N.getOpcode(), DL, OutVT, Lo, N.getOperand(1), N.getOperand(2), N.getOperand(3));
        Hi = self.DAG.getNode(N.getOpcode(), DL, OutVT, Hi, N.getOperand(1), N.getOperand(2), N.getOperand(3));
    } else {
        Lo = self.DAG.getNode(N.getOpcode(), DL, OutVT, Lo, N.getOperand(1));
        Hi = self.DAG.getNode(N.getOpcode(), DL, OutVT, Hi, N.getOperand(1));
    }
    return self.DAG.getNode(CONCAT_VECTORS, DL, ResVT, Lo, Hi);
}

fn DAGTypeLegalizer::SplitVecOp_FPOpDifferentTypes(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut LHSLoVT: EVT = EVT {};
    let mut LHSHiVT: EVT = EVT {};
    tie(LHSLoVT, LHSHiVT) = self.DAG.GetSplitDestVTs(N.getValueType(0));
    if !self.isTypeLegal(LHSLoVT) || !self.isTypeLegal(LHSHiVT) {
        return self.DAG.UnrollVectorOp(N, N.getValueType(0).getVectorNumElements());
    }
    let mut LHSLo: SDValue = SDValue {};
    let mut LHSHi: SDValue = SDValue {};
    tie(LHSLo, LHSHi) = self.DAG.SplitVector(N.getOperand(0), DL, LHSLoVT, LHSHiVT);
    let mut RHSLo: SDValue = SDValue {};
    let mut RHSHi: SDValue = SDValue {};
    tie(RHSLo, RHSHi) = self.DAG.SplitVector(N.getOperand(1), DL);
    let mut Lo: SDValue = self.DAG.getNode(N.getOpcode(), DL, LHSLoVT, LHSLo, RHSLo);
    let mut Hi: SDValue = self.DAG.getNode(N.getOpcode(), DL, LHSHiVT, LHSHi, RHSHi);
    return self.DAG.getNode(CONCAT_VECTORS, DL, N.getValueType(0), Lo, Hi);
}

fn DAGTypeLegalizer::SplitVecOp_CMP(self, N: *mut SDNode) -> SDValue {
    let mut Ctxt: *mut LLVMContext = *self.DAG.getContext();
    let mut dl: SDLoc = SDLoc { N };
    let mut LHSLo: SDValue = SDValue {};
    let mut LHSHi: SDValue = SDValue {};
    let mut RHSLo: SDValue = SDValue {};
    let mut RHSHi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(0), LHSLo, LHSHi);
    self.GetSplitVector(N.getOperand(1), RHSLo, RHSHi);
    let mut ResVT: EVT = N.getValueType(0);
    let mut SplitOpEC: ElementCount = LHSLo.getValueType().getVectorElementCount();
    let mut NewResVT: EVT = getVectorVT(Ctxt, ResVT.getVectorElementType(), SplitOpEC);
    let mut Lo: SDValue = self.DAG.getNode(N.getOpcode(), dl, NewResVT, LHSLo, RHSLo);
    let mut Hi: SDValue = self.DAG.getNode(N.getOpcode(), dl, NewResVT, LHSHi, RHSHi);
    return self.DAG.getNode(CONCAT_VECTORS, dl, ResVT, Lo, Hi);
}

fn DAGTypeLegalizer::SplitVecOp_FP_TO_XINT_SAT(self, N: *mut SDNode) -> SDValue {
    let mut ResVT: EVT = N.getValueType(0);
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    let mut dl: SDLoc = SDLoc { N };
    self.GetSplitVector(N.getOperand(0), Lo, Hi);
    let mut InVT: EVT = Lo.getValueType();
    let mut NewResVT: EVT = getVectorVT(*self.DAG.getContext(), ResVT.getVectorElementType(), InVT.getVectorElementCount());
    Lo = self.DAG.getNode(N.getOpcode(), dl, NewResVT, Lo, N.getOperand(1));
    Hi = self.DAG.getNode(N.getOpcode(), dl, NewResVT, Hi, N.getOperand(1));
    return self.DAG.getNode(CONCAT_VECTORS, dl, ResVT, Lo, Hi);
}

fn DAGTypeLegalizer::SplitVecOp_CttzElts(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut ResVT: EVT = N.getValueType(0);
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    let mut VecOp: SDValue = N.getOperand(0);
    self.GetSplitVector(VecOp, Lo, Hi);
    let mut ResLo: SDValue = self.DAG.getNode(CTTZ_ELTS, DL, ResVT, Lo);
    let mut VL: SDValue = self.DAG.getElementCount(DL, ResVT, Lo.getValueType().getVectorElementCount());
    let mut ResLoNotVL: SDValue = self.DAG.getSetCC(DL, self.getSetCCResultType(ResVT), ResLo, VL, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut ResHi: SDValue = self.DAG.getNode(N.getOpcode(), DL, ResVT, Hi);
    return self.DAG.getSelect(DL, ResVT, ResLoNotVL, ResLo, self.DAG.getNode(ADD, DL, ResVT, VL, ResHi), SDNodeFlags { Flags: None });
}

fn DAGTypeLegalizer::SplitVecOp_VP_CttzElements(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut ResVT: EVT = N.getValueType(0);
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    let mut VecOp: SDValue = N.getOperand(0);
    self.GetSplitVector(VecOp, Lo, Hi);
    let mut VLo: SDValue = self.DAG.getZExtOrTrunc(EVLLo, DL, ResVT);
    let mut ResLo: SDValue = self.DAG.getNode(VP_CTTZ_ELTS, DL, ResVT, Lo, MaskLo, EVLLo);
    let mut ResLoNotEVL: SDValue = self.DAG.getSetCC(DL, self.getSetCCResultType(ResVT), ResLo, VLo, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut ResHi: SDValue = self.DAG.getNode(N.getOpcode(), DL, ResVT, Hi, MaskHi, EVLHi);
    return self.DAG.getSelect(DL, ResVT, ResLoNotEVL, ResLo, self.DAG.getNode(ADD, DL, ResVT, VLo, ResHi), SDNodeFlags { Flags: None });
}

fn DAGTypeLegalizer::SplitVecOp_VECTOR_HISTOGRAM(self, N: *mut SDNode) -> SDValue {
    let mut HG: *mut MaskedHistogramSDNode = cast(N);
    let mut DL: SDLoc = SDLoc { HG };
    let mut Inc: SDValue = HG.getInc();
    let mut Ptr: SDValue = HG.getBasePtr();
    let mut Scale: SDValue = HG.getScale();
    let mut IntID: SDValue = HG.getIntID();
    let mut MemVT: EVT = HG.getMemoryVT();
    let mut MMO: *mut MachineMemOperand = HG.getMemOperand();
    let mut IndexType: MemIndexType = HG.getIndexType();
    let mut IndexLo: SDValue = SDValue {};
    let mut IndexHi: SDValue = SDValue {};
    let mut MaskLo: SDValue = SDValue {};
    let mut MaskHi: SDValue = SDValue {};
    tie(IndexLo, IndexHi) = self.DAG.SplitVector(HG.getIndex(), DL);
    tie(MaskLo, MaskHi) = self.DAG.SplitVector(HG.getMask(), DL);
    let mut OpsLo: [7]SDValue = [HG.getChain(), Inc, MaskLo, Ptr, IndexLo, Scale, IntID];
    let mut Lo: SDValue = self.DAG.getMaskedHistogram(self.DAG.getVTList(EVT { Other }), MemVT, DL, ArrayRef<SDValue> { OpsLo }, MMO, IndexType);
    let mut OpsHi: [7]SDValue = [Lo, Inc, MaskHi, Ptr, IndexHi, Scale, IntID];
    return self.DAG.getMaskedHistogram(self.DAG.getVTList(EVT { Other }), MemVT, DL, ArrayRef<SDValue> { OpsHi }, MMO, IndexType);
}

fn DAGTypeLegalizer::SplitVecOp_VECTOR_MATCH(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    if OpNo == 0 {
        let mut LoResVT: EVT = EVT {};
        let mut HiResVT: EVT = EVT {};
        tie(LoResVT, HiResVT) = self.DAG.GetSplitDestVTs(N.getValueType(0));
        let mut SourceLo: SDValue = SDValue {};
        let mut SourceHi: SDValue = SDValue {};
        tie(SourceLo, SourceHi) = self.DAG.SplitVectorOperand(N, 0);
        let mut MaskLo: SDValue = SDValue {};
        let mut MaskHi: SDValue = SDValue {};
        tie(MaskLo, MaskHi) = self.DAG.SplitVectorOperand(N, 2);
        let mut MatchLo: SDValue = self.DAG.getNode(VECTOR_MATCH, DL, LoResVT, SourceLo, N.getOperand(1), MaskLo, N.getFlags());
        let mut MatchHi: SDValue = self.DAG.getNode(VECTOR_MATCH, DL, HiResVT, SourceHi, N.getOperand(1), MaskHi, N.getFlags());
        return self.DAG.getNode(CONCAT_VECTORS, DL, N.getValueType(0), MatchLo, MatchHi);
    }
    assert!(OpNo == 1, "Unexpected VECTOR_MATCH operand");
    let mut NeedleLo: SDValue = SDValue {};
    let mut NeedleHi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(1), NeedleLo, NeedleHi);
    let mut MatchLo: SDValue = self.DAG.getNode(VECTOR_MATCH, DL, N.getValueType(0), N.getOperand(0), NeedleLo, N.getOperand(2), N.getFlags());
    let mut MatchHi: SDValue = self.DAG.getNode(VECTOR_MATCH, DL, N.getValueType(0), N.getOperand(0), NeedleHi, N.getOperand(2), N.getFlags());
    return self.DAG.getNode(OR, DL, N.getValueType(0), MatchLo, MatchHi);
}

fn DAGTypeLegalizer::SplitVecOp_PARTIAL_REDUCE_MLA(self, N: *mut SDNode) -> SDValue {
    let mut Acc: SDValue = N.getOperand(0);
    assert!(self.getTypeAction(Acc.getValueType()) != TypeSplitVector, "Accumulator should already be a legal type, and shouldn't need further splitting");
    let mut DL: SDLoc = SDLoc { N };
    let mut Input1Lo: SDValue = SDValue {};
    let mut Input1Hi: SDValue = SDValue {};
    let mut Input2Lo: SDValue = SDValue {};
    let mut Input2Hi: SDValue = SDValue {};
    self.GetSplitVector(N.getOperand(1), Input1Lo, Input1Hi);
    self.GetSplitVector(N.getOperand(2), Input2Lo, Input2Hi);
    let mut Opcode: u32 = N.getOpcode();
    let mut ResultVT: EVT = Acc.getValueType();
    let mut Lo: SDValue = self.DAG.getNode(Opcode, DL, ResultVT, Acc, Input1Lo, Input2Lo);
    return self.DAG.getNode(Opcode, DL, ResultVT, Lo, Input1Hi, Input2Hi);
}

fn DAGTypeLegalizer::ReplaceOtherWidenResults(self, N: *mut SDNode, WidenNode: *mut SDNode, WidenResNo: u32) {
    let mut NumResults: u32 = N.getNumValues();
    for let mut ResNo: u32 = 0; ResNo < NumResults; ResNo += 1 {
        if ResNo == WidenResNo {
            continue;
        }
        let mut ResVT: EVT = N.getValueType(ResNo);
        if self.getTypeAction(ResVT) == TypeWidenVector {
            self.SetWidenedVector(SDValue { Node: N, ResNo: ResNo }, SDValue { Node: WidenNode, ResNo: ResNo });
        } else {
            let mut DL: SDLoc = SDLoc { N };
            let mut ResVal: SDValue = self.DAG.getExtractSubvector(DL, ResVT, SDValue { Node: WidenNode, ResNo: ResNo }, 0);
            self.ReplaceValueWith(SDValue { Node: N, ResNo: ResNo }, ResVal);
        }
    }
}

fn DAGTypeLegalizer::WidenVectorResult(self, N: *mut SDNode, ResNo: u32) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalize-types", 1) {
            dbgs() << "Widen node result " << ResNo << ": ";
            N.dump(&mut self.DAG);
        }
    }
        if !(false) { break; }
    }
    if self.CustomWidenLowerNode(N, N.getValueType(ResNo)) {
        return;
    }
    let mut Res: SDValue = SDValue {};
    let mut unrollExpandedOp: Closure_12 = Closure_12 { N: &mut N, ResNo: &mut ResNo, cap_2: self, Res: &mut Res };
    match N.getOpcode() {
        _ => {
            dbgs() << "WidenVectorResult #" << ResNo << ": ";
        },
        LOOP_DEPENDENCE_RAW_MASK => {
            LOOP_DEPENDENCE_WAR_MASK;
        },
        MERGE_VALUES => {
            Res = self.WidenVecRes_MERGE_VALUES(N, ResNo);
        },
        ADDRSPACECAST => {
            Res = self.WidenVecRes_ADDRSPACECAST(N);
        },
        AssertZext => {
            Res = self.WidenVecRes_AssertZext(N);
        },
        BITCAST => {
            Res = self.WidenVecRes_BITCAST(N);
        },
        BUILD_VECTOR => {
            Res = self.WidenVecRes_BUILD_VECTOR(N);
        },
        CONCAT_VECTORS => {
            Res = self.WidenVecRes_CONCAT_VECTORS(N);
        },
        INSERT_SUBVECTOR => {
            Res = self.WidenVecRes_INSERT_SUBVECTOR(N);
        },
        EXTRACT_SUBVECTOR => {
            Res = self.WidenVecRes_EXTRACT_SUBVECTOR(N);
        },
        INSERT_VECTOR_ELT => {
            Res = self.WidenVecRes_INSERT_VECTOR_ELT(N);
        },
        ATOMIC_LOAD => {
            Res = self.WidenVecRes_ATOMIC_LOAD(cast(N));
        },
        LOAD => {
            Res = self.WidenVecRes_LOAD(N);
        },
        STEP_VECTOR => {
            SPLAT_VECTOR;
        },
        SIGN_EXTEND_INREG => {
            Res = self.WidenVecRes_InregOp(N);
        },
        VSELECT => {
            SELECT;
        },
        SELECT_CC => {
            Res = self.WidenVecRes_SELECT_CC(N);
        },
        SETCC => {
            Res = self.WidenVecRes_SETCC(N);
        },
        POISON => {
            UNDEF;
        },
        VECTOR_SHUFFLE => {
            Res = self.WidenVecRes_VECTOR_SHUFFLE(cast(N));
        },
        VP_LOAD => {
            Res = self.WidenVecRes_VP_LOAD(cast(N));
        },
        VP_LOAD_FF => {
            Res = self.WidenVecRes_VP_LOAD_FF(cast(N));
        },
        EXPERIMENTAL_VP_STRIDED_LOAD => {
            Res = self.WidenVecRes_VP_STRIDED_LOAD(cast(N));
        },
        VECTOR_COMPRESS => {
            Res = self.WidenVecRes_VECTOR_COMPRESS(N);
        },
        MLOAD => {
            Res = self.WidenVecRes_MLOAD(cast(N));
        },
        MGATHER => {
            Res = self.WidenVecRes_MGATHER(cast(N));
        },
        VP_GATHER => {
            Res = self.WidenVecRes_VP_GATHER(cast(N));
        },
        VECTOR_REVERSE => {
            Res = self.WidenVecRes_VECTOR_REVERSE(N);
        },
        GET_ACTIVE_LANE_MASK => {
            Res = self.WidenVecRes_GET_ACTIVE_LANE_MASK(N);
        },
        VECTOR_INTERLEAVE => {
            self.WidenVecRes_VECTOR_INTERLEAVE(N);
        },
        VECTOR_MATCH => {
            Res = self.WidenVecRes_VECTOR_MATCH(N);
        },
        VECTOR_DEINTERLEAVE => {
            self.WidenVecRes_VECTOR_DEINTERLEAVE(N);
        },
        ADD => {
            AND;
        },
        MASKED_UDIV => {
            MASKED_SDIV;
        },
        SCMP => {
            UCMP;
        },
        FPOW => {
            FATAN2;
        },
        FADD => {
            FMUL;
        },
        SMULFIX => {
            SMULFIXSAT;
        },
        STRICT_FADD => {
            STRICT_FSUB;
        },
        UADDO => {
            SADDO;
        },
        FCOPYSIGN => {
            Res = self.WidenVecRes_FCOPYSIGN(N);
        },
        IS_FPCLASS => {
            FPTRUNC_ROUND;
        },
        FLDEXP => {
            FPOWI;
        },
        ANY_EXTEND_VECTOR_INREG => {
            SIGN_EXTEND_VECTOR_INREG;
        },
        ANY_EXTEND => {
            FP_EXTEND;
        },
        FP_TO_SINT_SAT => {
            FP_TO_UINT_SAT;
        },
        LRINT => {
            LLRINT;
        },
        FACOS => {
            FASIN;
        },
        ABS => {
            ABS_MIN_POISON;
        },
        FMA => {
            FSHL;
        },
        FMODF => {
            FFREXP;
        },
        PARTIAL_REDUCE_UMLA => {
            PARTIAL_REDUCE_SMLA;
        },
    }
    if Res.getNode() {
        self.SetWidenedVector(SDValue { Node: N, ResNo: ResNo }, Res);
    }
}

fn DAGTypeLegalizer::WidenVecRes_Ternary(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut InOp1: SDValue = self.GetWidenedVector(N.getOperand(0));
    let mut InOp2: SDValue = self.GetWidenedVector(N.getOperand(1));
    let mut InOp3: SDValue = self.GetWidenedVector(N.getOperand(2));
    return self.DAG.getNode(N.getOpcode(), dl, WidenVT, InOp1, InOp2, InOp3);
}

fn DAGTypeLegalizer::WidenVecRes_Binary(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut InOp1: SDValue = self.GetWidenedVector(N.getOperand(0));
    let mut InOp2: SDValue = self.GetWidenedVector(N.getOperand(1));
    if N.getNumOperands() == 2 {
        return self.DAG.getNode(N.getOpcode(), dl, WidenVT, InOp1, InOp2, N.getFlags());
    }
    assert!(N.getNumOperands() == 4, "Unexpected number of operands!");
    assert!((N.getOpcode() == VP_UDIV || N.getOpcode() == VP_SDIV || N.getOpcode() == VP_UREM || N.getOpcode() == VP_SREM), "Expected VP opcode");
    let mut Mask: SDValue = self.GetWidenedMask(N.getOperand(2), WidenVT.getVectorElementCount());
    return self.DAG.getNode(N.getOpcode(), dl, WidenVT, ArrayRef<SDValue> { [InOp1, InOp2, Mask, N.getOperand(3)] }, N.getFlags());
}

fn DAGTypeLegalizer::WidenVecRes_MaskedBinary(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut InOp1: SDValue = self.GetWidenedVector(N.getOperand(0));
    let mut InOp2: SDValue = self.GetWidenedVector(N.getOperand(1));
    let mut Mask: SDValue = N.getOperand(2);
    let mut WideMaskVT: EVT = WidenVT.changeVectorElementType(*self.DAG.getContext(), Mask.getValueType().getVectorElementType());
    Mask = self.ModifyToType(Mask, WideMaskVT, true);
    return self.DAG.getNode(N.getOpcode(), dl, WidenVT, InOp1, InOp2, Mask, N.getFlags());
}

fn DAGTypeLegalizer::WidenVecRes_CMP(self, N: *mut SDNode) -> SDValue {
    let mut Ctxt: *mut LLVMContext = *self.DAG.getContext();
    let mut dl: SDLoc = SDLoc { N };
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut OpVT: EVT = LHS.getValueType();
    if self.getTypeAction(OpVT) == TypeWidenVector {
        LHS = self.GetWidenedVector(LHS);
        RHS = self.GetWidenedVector(RHS);
        OpVT = LHS.getValueType();
    }
    let mut WidenResVT: EVT = self.TLI.getTypeToTransformTo(Ctxt, N.getValueType(0));
    let mut WidenResEC: ElementCount = WidenResVT.getVectorElementCount();
    if WidenResEC == OpVT.getVectorElementCount() {
        return self.DAG.getNode(N.getOpcode(), dl, WidenResVT, LHS, RHS);
    }
    return self.DAG.UnrollVectorOp(N, WidenResVT.getVectorNumElements());
}

fn DAGTypeLegalizer::WidenVecRes_BinaryWithExtraScalarOp(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut InOp1: SDValue = self.GetWidenedVector(N.getOperand(0));
    let mut InOp2: SDValue = self.GetWidenedVector(N.getOperand(1));
    let mut InOp3: SDValue = N.getOperand(2);
    return self.DAG.getNode(N.getOpcode(), dl, WidenVT, InOp1, InOp2, InOp3, N.getFlags());
}

fn CollectOpsToWiden(DAG: *mut SelectionDAG, TLI: *TargetLowering, ConcatOps: *mut SmallVectorImpl<SDValue>, ConcatEnd: u32, VT: EVT, MaxVT: EVT, WidenVT: EVT) -> SDValue {
    if ConcatEnd == 1 {
        VT = ConcatOps[0].getValueType();
        if VT == WidenVT {
            return ConcatOps[0];
        }
    }
    let mut dl: SDLoc = SDLoc { ConcatOps[0] };
    let mut WidenEltVT: EVT = WidenVT.getVectorElementType();
    while ConcatOps[ConcatEnd - 1].getValueType() != MaxVT {
        let mut Idx: i32 = ConcatEnd - 1;
        VT = ConcatOps[Idx -= 1].getValueType();
        while Idx >= 0 && ConcatOps[Idx].getValueType() == VT {
            Idx -= 1;
        }
        let mut NextSize: i32 = if VT.isVector() { VT.getVectorNumElements() } else { 1 };
        let mut NextVT: EVT = EVT {};
        while true {
            {
            NextSize *= 2;
            NextVT = getVectorVT(*DAG.getContext(), WidenEltVT, NextSize, false);
        }
            if !(!TLI.isTypeLegal(NextVT)) { break; }
        }
        if !VT.isVector() {
            let mut VecOp: SDValue = DAG.getPOISON(NextVT);
            let mut NumToInsert: u32 = ConcatEnd - Idx - 1;
            for let mut i: u32 = 0;
let mut OpIdx: u32 = Idx + 1; i < NumToInsert; i += 1 , OpIdx += 1 {
                VecOp = DAG.getInsertVectorElt(dl, VecOp, ConcatOps[OpIdx], i);
            }
            ConcatOps[Idx + 1] = VecOp;
            ConcatEnd = Idx + 2;
        } else {
            let mut undefVec: SDValue = DAG.getPOISON(VT);
            let mut OpsToConcat: u32 = NextSize / VT.getVectorNumElements();
            let mut SubConcatOps: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { OpsToConcat };
            let mut RealVals: u32 = ConcatEnd - Idx - 1;
            let mut SubConcatEnd: u32 = 0;
            let mut SubConcatIdx: u32 = Idx + 1;
            while SubConcatEnd < RealVals {
                SubConcatOps[SubConcatEnd += 1] = ConcatOps[Idx += 1];
            }
            while SubConcatEnd < OpsToConcat {
                SubConcatOps[SubConcatEnd += 1] = undefVec;
            }
            ConcatOps[SubConcatIdx] = DAG.getNode(CONCAT_VECTORS, dl, NextVT, ArrayRef<SDValue> { SubConcatOps });
            ConcatEnd = SubConcatIdx + 1;
        }
    }
    if ConcatEnd == 1 {
        VT = ConcatOps[0].getValueType();
        if VT == WidenVT {
            return ConcatOps[0];
        }
    }
    let mut NumOps: u32 = WidenVT.getVectorNumElements() / MaxVT.getVectorNumElements();
    if NumOps != ConcatEnd {
        let mut UndefVal: SDValue = DAG.getPOISON(MaxVT);
        for let mut j: u32 = ConcatEnd; j < NumOps; j += 1 {
            ConcatOps[j] = UndefVal;
        }
    }
    return DAG.getNode(CONCAT_VECTORS, dl, WidenVT, SDValue> { ConcatOps.ptr, NumOps });
}

fn DAGTypeLegalizer::WidenVecRes_BinaryCanTrap(self, N: *mut SDNode) -> SDValue {
    let mut Opcode: u32 = N.getOpcode();
    let mut dl: SDLoc = SDLoc { N };
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut WidenEltVT: EVT = WidenVT.getVectorElementType();
    let mut VT: EVT = WidenVT;
    let mut NumElts: u32 = VT.getVectorMinNumElements();
    let mut Flags: SDNodeFlags = N.getFlags();
    while !self.TLI.isTypeLegal(VT) && NumElts != 1 {
        NumElts = NumElts / 2;
        VT = getVectorVT(*self.DAG.getContext(), WidenEltVT, NumElts, false);
    }
    if NumElts != 1 && !self.TLI.canOpTrap(N.getOpcode(), VT) {
        let mut InOp1: SDValue = self.GetWidenedVector(N.getOperand(0));
        let mut InOp2: SDValue = self.GetWidenedVector(N.getOperand(1));
        return self.DAG.getNode(N.getOpcode(), dl, WidenVT, InOp1, InOp2, Flags);
    }
    let mut VPOpcode: optional<unsigned int> = getVPForBaseOpcode(Opcode);
    if VPOpcode && self.TLI.isOperationLegalOrCustom(operator(VPOpcode), WidenVT, false) {
        let mut WideMaskVT: EVT = getVectorVT(*self.DAG.getContext(), EVT { i1 }, WidenVT.getVectorElementCount());
        if self.TLI.isTypeLegal(WideMaskVT) {
            let mut InOp1: SDValue = self.GetWidenedVector(N.getOperand(0));
            let mut InOp2: SDValue = self.GetWidenedVector(N.getOperand(1));
            let mut Mask: SDValue = self.DAG.getAllOnesConstant(dl, WideMaskVT, false, false);
            let mut EVL: SDValue = self.DAG.getElementCount(dl, EVT { self.TLI.getVPExplicitVectorLengthTy() }, N.getValueType(0).getVectorElementCount());
            return self.DAG.getNode(operator(VPOpcode), dl, WidenVT, InOp1, InOp2, Mask, EVL, Flags);
        }
    }
    assert!(!VT.isScalableVector(), "Scalable vectors not handled yet.");
    if NumElts == 1 {
        return self.DAG.UnrollVectorOp(N, WidenVT.getVectorNumElements());
    }
    let mut MaxVT: EVT = VT;
    let mut InOp1: SDValue = self.GetWidenedVector(N.getOperand(0));
    let mut InOp2: SDValue = self.GetWidenedVector(N.getOperand(1));
    let mut CurNumElts: u32 = N.getValueType(0).getVectorNumElements();
    let mut ConcatOps: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { CurNumElts };
    let mut ConcatEnd: u32 = 0;
    let mut Idx: i32 = 0;
    while CurNumElts != 0 {
        while CurNumElts >= NumElts {
            let mut EOp1: SDValue = self.DAG.getExtractSubvector(dl, VT, InOp1, Idx);
            let mut EOp2: SDValue = self.DAG.getExtractSubvector(dl, VT, InOp2, Idx);
            ConcatOps[ConcatEnd += 1] = self.DAG.getNode(Opcode, dl, VT, EOp1, EOp2, Flags);
            Idx += NumElts;
            CurNumElts -= NumElts;
        }
        while true {
            {
            NumElts = NumElts / 2;
            VT = getVectorVT(*self.DAG.getContext(), WidenEltVT, NumElts, false);
        }
            if !(!self.TLI.isTypeLegal(VT) && NumElts != 1) { break; }
        }
        if NumElts == 1 {
            for let mut i: u32 = 0; i != CurNumElts; i += 1 , Idx += 1 {
                let mut EOp1: SDValue = self.DAG.getExtractVectorElt(dl, WidenEltVT, InOp1, Idx);
                let mut EOp2: SDValue = self.DAG.getExtractVectorElt(dl, WidenEltVT, InOp2, Idx);
                ConcatOps[ConcatEnd += 1] = self.DAG.getNode(Opcode, dl, WidenEltVT, EOp1, EOp2, Flags);
            }
            CurNumElts = 0;
        }
    }
    return CollectOpsToWiden(self.DAG, self.TLI, ConcatOps, ConcatEnd, VT, MaxVT, WidenVT);
}

fn DAGTypeLegalizer::WidenVecRes_StrictFP(self, N: *mut SDNode) -> SDValue {
    match N.getOpcode() {
        STRICT_FSETCC => {
            STRICT_FSETCCS;
        },
        STRICT_FP_EXTEND => {
            STRICT_FP_ROUND;
        },
        _ => {
            break;
        },
    }
    let mut NumOpers: u32 = N.getNumOperands();
    let mut Opcode: u32 = N.getOpcode();
    let mut dl: SDLoc = SDLoc { N };
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut WidenEltVT: EVT = WidenVT.getVectorElementType();
    let mut VT: EVT = WidenVT;
    let mut NumElts: u32 = VT.getVectorNumElements();
    while !self.TLI.isTypeLegal(VT) && NumElts != 1 {
        NumElts = NumElts / 2;
        VT = getVectorVT(*self.DAG.getContext(), WidenEltVT, NumElts, false);
    }
    if NumElts == 1 {
        return self.UnrollVectorOp_StrictFP(N, WidenVT.getVectorNumElements());
    }
    let mut MaxVT: EVT = VT;
    let mut InOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    let mut CurNumElts: u32 = N.getValueType(0).getVectorNumElements();
    let mut ConcatOps: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { CurNumElts };
    let mut Chains: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut ConcatEnd: u32 = 0;
    let mut Idx: i32 = 0;
    InOps.push(ValueParamT { N.getOperand(0) });
    for let mut i: u32 = 1; i < NumOpers; i += 1 {
        let mut Oper: SDValue = N.getOperand(i);
        let mut OpVT: EVT = Oper.getValueType();
        if OpVT.isVector() {
            if self.getTypeAction(OpVT) == TypeWidenVector {
                Oper = self.GetWidenedVector(Oper);
            } else {
                let mut WideOpVT: EVT = getVectorVT(*self.DAG.getContext(), OpVT.getVectorElementType(), WidenVT.getVectorElementCount());
                Oper = self.DAG.getNode(INSERT_SUBVECTOR, dl, WideOpVT, self.DAG.getPOISON(WideOpVT), Oper, self.DAG.getVectorIdxConstant(0, dl, false));
            }
        }
        InOps.push(ValueParamT { Oper });
    }
    while CurNumElts != 0 {
        while CurNumElts >= NumElts {
            let mut EOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
            for let mut i: u32 = 0; i < NumOpers; i += 1 {
                let mut Op: SDValue = InOps[i];
                let mut OpVT: EVT = Op.getValueType();
                if OpVT.isVector() {
                    let mut OpExtractVT: EVT = getVectorVT(*self.DAG.getContext(), OpVT.getVectorElementType(), VT.getVectorElementCount());
                    Op = self.DAG.getExtractSubvector(dl, OpExtractVT, Op, Idx);
                }
                EOps.push(ValueParamT { Op });
            }
            let mut OperVT: [2]EVT = [VT, EVT { Other }];
            let mut Oper: SDValue = self.DAG.getNode(Opcode, dl, ArrayRef<EVT> { OperVT }, ArrayRef<SDValue> { EOps });
            ConcatOps[ConcatEnd += 1] = Oper;
            Chains.push(Oper.getValue(1));
            Idx += NumElts;
            CurNumElts -= NumElts;
        }
        while true {
            {
            NumElts = NumElts / 2;
            VT = getVectorVT(*self.DAG.getContext(), WidenEltVT, NumElts, false);
        }
            if !(!self.TLI.isTypeLegal(VT) && NumElts != 1) { break; }
        }
        if NumElts == 1 {
            for let mut i: u32 = 0; i != CurNumElts; i += 1 , Idx += 1 {
                let mut EOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
                for let mut i: u32 = 0; i < NumOpers; i += 1 {
                    let mut Op: SDValue = InOps[i];
                    let mut OpVT: EVT = Op.getValueType();
                    if OpVT.isVector() {
                        Op = self.DAG.getExtractVectorElt(dl, OpVT.getVectorElementType(), Op, Idx);
                    }
                    EOps.push(ValueParamT { Op });
                }
                let mut WidenVT: [2]EVT = [WidenEltVT, EVT { Other }];
                let mut Oper: SDValue = self.DAG.getNode(Opcode, dl, ArrayRef<EVT> { WidenVT }, ArrayRef<SDValue> { EOps });
                ConcatOps[ConcatEnd += 1] = Oper;
                Chains.push(Oper.getValue(1));
            }
            CurNumElts = 0;
        }
    }
    let mut NewChain: SDValue = SDValue {};
    if Chains.len == 1 {
        NewChain = Chains[0];
    } else {
        NewChain = self.DAG.getNode(TokenFactor, dl, EVT { Other }, ArrayRef<SDValue> { Chains });
    }
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, NewChain);
    return CollectOpsToWiden(self.DAG, self.TLI, ConcatOps, ConcatEnd, VT, MaxVT, WidenVT);
}

fn DAGTypeLegalizer::WidenVecRes_OverflowOp(self, N: *mut SDNode, ResNo: u32) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut ResVT: EVT = N.getValueType(0);
    let mut OvVT: EVT = N.getValueType(1);
    let mut WideResVT: EVT = EVT {};
    let mut WideOvVT: EVT = EVT {};
    let mut WideLHS: SDValue = SDValue {};
    let mut WideRHS: SDValue = SDValue {};
    if ResNo == 0 {
        WideResVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), ResVT);
        WideOvVT = getVectorVT(*self.DAG.getContext(), OvVT.getVectorElementType(), WideResVT.getVectorNumElements(), false);
        WideLHS = self.GetWidenedVector(N.getOperand(0));
        WideRHS = self.GetWidenedVector(N.getOperand(1));
    } else {
        WideOvVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OvVT);
        WideResVT = getVectorVT(*self.DAG.getContext(), ResVT.getVectorElementType(), WideOvVT.getVectorNumElements(), false);
        let mut Zero: SDValue = self.DAG.getVectorIdxConstant(0, DL, false);
        let mut Poison: SDValue = self.DAG.getPOISON(WideResVT);
        WideLHS = self.DAG.getNode(INSERT_SUBVECTOR, DL, WideResVT, Poison, N.getOperand(0), Zero);
        WideRHS = self.DAG.getNode(INSERT_SUBVECTOR, DL, WideResVT, Poison, N.getOperand(1), Zero);
    }
    let mut WideVTs: SDVTList = self.DAG.getVTList(WideResVT, WideOvVT);
    let mut WideNode: *mut SDNode = self.DAG.getNode(N.getOpcode(), DL, WideVTs, WideLHS, WideRHS).getNode();
    let mut OtherNo: u32 = 1 - ResNo;
    let mut OtherVT: EVT = N.getValueType(OtherNo);
    if self.getTypeAction(OtherVT) == TypeWidenVector {
        self.SetWidenedVector(SDValue { Node: N, ResNo: OtherNo }, SDValue { Node: WideNode, ResNo: OtherNo });
    } else {
        let mut Zero: SDValue = self.DAG.getVectorIdxConstant(0, DL, false);
        let mut OtherVal: SDValue = self.DAG.getNode(EXTRACT_SUBVECTOR, DL, OtherVT, SDValue { Node: WideNode, ResNo: OtherNo }, Zero);
        self.ReplaceValueWith(SDValue { Node: N, ResNo: OtherNo }, OtherVal);
    }
    return SDValue { Node: WideNode, ResNo: ResNo };
}

fn DAGTypeLegalizer::WidenVecRes_Convert(self, N: *mut SDNode) -> SDValue {
    let mut Ctx: *mut LLVMContext = *self.DAG.getContext();
    let mut InOp: SDValue = N.getOperand(0);
    let mut DL: SDLoc = SDLoc { N };
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(Ctx, N.getValueType(0));
    let mut WidenEC: ElementCount = WidenVT.getVectorElementCount();
    let mut InVT: EVT = InOp.getValueType();
    let mut Opcode: u32 = N.getOpcode();
    let mut Flags: SDNodeFlags = N.getFlags();
    if N.getOpcode() == ZERO_EXTEND && self.getTypeAction(InVT) == TypePromoteInteger && self.TLI.getTypeToTransformTo(Ctx, InVT).getScalarSizeInBits() != WidenVT.getScalarSizeInBits() {
        InOp = self.ZExtPromotedInteger(InOp);
        InVT = InOp.getValueType();
        if WidenVT.getScalarSizeInBits() < InVT.getScalarSizeInBits() {
            Opcode = TRUNCATE;
        }
    }
    let mut InEltVT: EVT = InVT.getVectorElementType();
    let mut InWidenVT: EVT = getVectorVT(Ctx, InEltVT, WidenEC);
    let mut InVTEC: ElementCount = InVT.getVectorElementCount();
    let mut MakeConvertNode: Closure_13 = Closure_13 { N: &mut N, cap_1: self, Opcode: &mut Opcode, DL: &mut DL, Flags: &mut Flags };
    if self.getTypeAction(InVT) == TypeWidenVector {
        InOp = self.GetWidenedVector(N.getOperand(0));
        InVT = InOp.getValueType();
        InVTEC = InVT.getVectorElementCount();
        if InVTEC == WidenEC {
            return MakeConvertNode.call(WidenVT, InOp);
        }
        if WidenVT.getSizeInBits() == InVT.getSizeInBits() {
            if Opcode == ANY_EXTEND {
                return self.DAG.getNode(ANY_EXTEND_VECTOR_INREG, DL, WidenVT, InOp);
            }
            if Opcode == SIGN_EXTEND {
                return self.DAG.getNode(SIGN_EXTEND_VECTOR_INREG, DL, WidenVT, InOp);
            }
            if Opcode == ZERO_EXTEND {
                return self.DAG.getNode(ZERO_EXTEND_VECTOR_INREG, DL, WidenVT, InOp);
            }
        }
        let mut MidResVT: EVT = getVectorVT(Ctx, WidenVT.getVectorElementType(), InVTEC);
        if N.getOpcode() == TRUNCATE && self.getTypeAction(MidResVT) == TypePromoteInteger {
            let mut MidRes: SDValue = self.DAG.getNode(TRUNCATE, DL, MidResVT, InOp, Flags);
            return self.DAG.getInsertSubvector(DL, self.DAG.getPOISON(WidenVT), MidRes, 0);
        }
    }
    if self.TLI.isTypeLegal(InWidenVT) {
        if WidenEC.isKnownMultipleOf(InVTEC.getKnownMinValue()) {
            let mut NumConcat: u32 = WidenEC.getKnownMinValue() / InVTEC.getKnownMinValue();
            let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { NumConcat, self.DAG.getPOISON(InVT) };
            Ops[0] = InOp;
            let mut InVec: SDValue = self.DAG.getNode(CONCAT_VECTORS, DL, InWidenVT, ArrayRef<SDValue> { Ops });
            return MakeConvertNode.call(WidenVT, InVec);
        }
        if InVTEC.isKnownMultipleOf(WidenEC.getKnownMinValue()) {
            let mut InVal: SDValue = self.DAG.getExtractSubvector(DL, InWidenVT, InOp, 0);
            return MakeConvertNode.call(WidenVT, InVal);
        }
    }
    let mut EltVT: EVT = WidenVT.getVectorElementType();
    let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { WidenEC.getFixedValue(), self.DAG.getPOISON(EltVT) };
    let mut MinElts: u32 = N.getValueType(0).getVectorNumElements();
    for let mut i: u32 = 0; i < MinElts; i += 1 {
        let mut Val: SDValue = self.DAG.getExtractVectorElt(DL, InEltVT, InOp, i);
        Ops[i] = MakeConvertNode.call(EltVT, Val);
    }
    return self.DAG.getBuildVector(WidenVT, DL, ArrayRef<SDValue> { Ops });
}

fn DAGTypeLegalizer::WidenVecRes_FP_TO_XINT_SAT(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut WidenNumElts: ElementCount = WidenVT.getVectorElementCount();
    let mut Src: SDValue = N.getOperand(0);
    let mut SrcVT: EVT = Src.getValueType();
    if self.getTypeAction(SrcVT) == TypeWidenVector {
        Src = self.GetWidenedVector(Src);
        SrcVT = Src.getValueType();
    }
    if WidenNumElts != SrcVT.getVectorElementCount() {
        return self.DAG.UnrollVectorOp(N, WidenNumElts.getKnownMinValue());
    }
    return self.DAG.getNode(N.getOpcode(), dl, WidenVT, Src, N.getOperand(1));
}

fn DAGTypeLegalizer::WidenVecRes_XROUND(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut WidenNumElts: ElementCount = WidenVT.getVectorElementCount();
    let mut Src: SDValue = N.getOperand(0);
    let mut SrcVT: EVT = Src.getValueType();
    if self.getTypeAction(SrcVT) == TypeWidenVector {
        Src = self.GetWidenedVector(Src);
        SrcVT = Src.getValueType();
    }
    if WidenNumElts != SrcVT.getVectorElementCount() {
        return self.DAG.UnrollVectorOp(N, WidenNumElts.getKnownMinValue());
    }
    return self.DAG.getNode(N.getOpcode(), dl, WidenVT, Src);
}

fn DAGTypeLegalizer::WidenVecRes_Convert_StrictFP(self, N: *mut SDNode) -> SDValue {
    let mut InOp: SDValue = N.getOperand(1);
    let mut DL: SDLoc = SDLoc { N };
    let mut NewOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { N.ops() };
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut WidenNumElts: u32 = WidenVT.getVectorNumElements();
    let mut InVT: EVT = InOp.getValueType();
    let mut InEltVT: EVT = InVT.getVectorElementType();
    let mut Opcode: u32 = N.getOpcode();
    let mut EltVT: EVT = WidenVT.getVectorElementType();
    let mut EltVTs: array<EVT, 2> = array<EVT, 2> { [EltVT, EVT { Other }] };
    let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { WidenNumElts, self.DAG.getPOISON(EltVT) };
    let mut OpChains: SmallVector<SDValue, 32> = SmallVector<SDValue, 32> {};
    let mut MinElts: u32 = N.getValueType(0).getVectorNumElements();
    for let mut i: u32 = 0; i < MinElts; i += 1 {
        NewOps[1] = self.DAG.getExtractVectorElt(DL, InEltVT, InOp, i);
        Ops[i] = self.DAG.getNode(Opcode, DL, ArrayRef<EVT> { EltVTs }, ArrayRef<SDValue> { NewOps });
        OpChains.push(Ops[i].getValue(1));
    }
    let mut NewChain: SDValue = self.DAG.getNode(TokenFactor, DL, EVT { Other }, ArrayRef<SDValue> { OpChains });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, NewChain);
    return self.DAG.getBuildVector(WidenVT, DL, ArrayRef<SDValue> { Ops });
}

fn DAGTypeLegalizer::WidenVecRes_EXTEND_VECTOR_INREG(self, N: *mut SDNode) -> SDValue {
    let mut Opcode: u32 = N.getOpcode();
    let mut InOp: SDValue = N.getOperand(0);
    let mut DL: SDLoc = SDLoc { N };
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut WidenSVT: EVT = WidenVT.getVectorElementType();
    let mut WidenNumElts: u32 = WidenVT.getVectorNumElements();
    let mut InVT: EVT = InOp.getValueType();
    let mut InSVT: EVT = InVT.getVectorElementType();
    let mut InVTNumElts: u32 = InVT.getVectorNumElements();
    if self.getTypeAction(InVT) == TypeWidenVector {
        InOp = self.GetWidenedVector(InOp);
        InVT = InOp.getValueType();
        if InVT.getSizeInBits() == WidenVT.getSizeInBits() {
            match Opcode {
                ANY_EXTEND_VECTOR_INREG => {
                    SIGN_EXTEND_VECTOR_INREG;
                },
            }
        }
    }
    let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    for let mut i: u32 = 0;
let mut e: u32 = if InVTNumElts < WidenNumElts { InVTNumElts } else { WidenNumElts }; i != e; i += 1 {
        let mut Val: SDValue = self.DAG.getExtractVectorElt(DL, InSVT, InOp, i);
        match Opcode {
            ANY_EXTEND_VECTOR_INREG => {
                Val = self.DAG.getNode(ANY_EXTEND, DL, WidenSVT, Val);
            },
            SIGN_EXTEND_VECTOR_INREG => {
                Val = self.DAG.getNode(SIGN_EXTEND, DL, WidenSVT, Val);
            },
            ZERO_EXTEND_VECTOR_INREG => {
                Val = self.DAG.getNode(ZERO_EXTEND, DL, WidenSVT, Val);
            },
            _ => {
                llvm_unreachable_internal("A *_EXTEND_VECTOR_INREG node was expected", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeVectorTypes.cpp", 6279);
            },
        }
        Ops.push(ValueParamT { Val });
    }
    while Ops.len != WidenNumElts {
        Ops.push(self.DAG.getPOISON(WidenSVT));
    }
    return self.DAG.getBuildVector(WidenVT, DL, ArrayRef<SDValue> { Ops });
}

fn DAGTypeLegalizer::WidenVecRes_FCOPYSIGN(self, N: *mut SDNode) -> SDValue {
    if N.getOperand(0).getValueType() == N.getOperand(1).getValueType() {
        return self.WidenVecRes_BinaryCanTrap(N);
    }
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    return self.DAG.UnrollVectorOp(N, WidenVT.getVectorNumElements());
}

fn DAGTypeLegalizer::WidenVecRes_UnarySameEltsWithScalarArg(self, N: *mut SDNode) -> SDValue {
    let mut FpValue: SDValue = N.getOperand(0);
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    if self.getTypeAction(FpValue.getValueType()) != TypeWidenVector {
        return self.DAG.UnrollVectorOp(N, WidenVT.getVectorNumElements());
    }
    let mut Arg: SDValue = self.GetWidenedVector(FpValue);
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, WidenVT, ArrayRef<SDValue> { [Arg, N.getOperand(1)] }, N.getFlags());
}

fn DAGTypeLegalizer::WidenVecRes_ExpOp(self, N: *mut SDNode) -> SDValue {
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut InOp: SDValue = self.GetWidenedVector(N.getOperand(0));
    let mut RHS: SDValue = N.getOperand(1);
    let mut ExpVT: EVT = RHS.getValueType();
    let mut ExpOp: SDValue = RHS;
    if ExpVT.isVector() {
        let mut WideExpVT: EVT = WidenVT.changeVectorElementType(*self.DAG.getContext(), ExpVT.getVectorElementType());
        ExpOp = self.ModifyToType(RHS, WideExpVT, false);
    }
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, WidenVT, InOp, ExpOp);
}

fn DAGTypeLegalizer::WidenVecRes_Unary(self, N: *mut SDNode) -> SDValue {
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut InOp: SDValue = self.GetWidenedVector(N.getOperand(0));
    if N.getNumOperands() == 1 {
        return self.DAG.getNode(N.getOpcode(), SDLoc { N }, WidenVT, InOp, N.getFlags());
    }
    assert!(N.getOpcode() == AssertNoFPClass, "unexpected opcode");
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, WidenVT, InOp, N.getOperand(1), N.getFlags());
}

fn DAGTypeLegalizer::WidenVecRes_InregOp(self, N: *mut SDNode) -> SDValue {
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut ExtVT: EVT = getVectorVT(*self.DAG.getContext(), cast(N.getOperand(1)).getVT().getVectorElementType(), WidenVT.getVectorElementCount());
    let mut WidenLHS: SDValue = self.GetWidenedVector(N.getOperand(0));
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, WidenVT, WidenLHS, self.DAG.getValueType(ExtVT));
}

fn DAGTypeLegalizer::WidenVecRes_UnaryOpWithTwoResults(self, N: *mut SDNode, ResNo: u32) -> SDValue {
    let mut VT0: EVT = N.getValueType(0);
    let mut VT1: EVT = N.getValueType(1);
    assert!(VT0.isVector() && VT1.isVector() && VT0.getVectorElementCount() == VT1.getVectorElementCount(), "expected both results to be vectors of matching element count");
    let mut Ctx: *mut LLVMContext = *self.DAG.getContext();
    let mut InOp: SDValue = self.GetWidenedVector(N.getOperand(0));
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(Ctx, N.getValueType(ResNo));
    let mut WidenEC: ElementCount = WidenVT.getVectorElementCount();
    let mut WidenVT0: EVT = getVectorVT(Ctx, VT0.getVectorElementType(), WidenEC);
    let mut WidenVT1: EVT = getVectorVT(Ctx, VT1.getVectorElementType(), WidenEC);
    let mut WidenNode: *mut SDNode = self.DAG.getNode(N.getOpcode(), SDLoc { N }, ArrayRef<EVT> { [WidenVT0, WidenVT1] }, ArrayRef<SDValue> { InOp }).getNode();
    self.ReplaceOtherWidenResults(N, WidenNode, ResNo);
    return SDValue { Node: WidenNode, ResNo: ResNo };
}

fn DAGTypeLegalizer::WidenVecRes_MERGE_VALUES(self, N: *mut SDNode, ResNo: u32) -> SDValue {
    let mut WidenVec: SDValue = self.DisintegrateMERGE_VALUES(N, ResNo);
    return self.GetWidenedVector(WidenVec);
}

fn DAGTypeLegalizer::WidenVecRes_ADDRSPACECAST(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut WidenEC: ElementCount = WidenVT.getVectorElementCount();
    let mut AddrSpaceCastN: *mut AddrSpaceCastSDNode = cast(N);
    let mut InOp: SDValue = N.getOperand(0);
    let mut InVT: EVT = InOp.getValueType();
    let mut InAction: LegalizeTypeAction = self.getTypeAction(InVT);
    if InAction == TypeWidenVector {
        InOp = self.GetWidenedVector(InOp);
    } else if InAction != TypeLegal {
        let mut InWidenVT: EVT = getVectorVT(*self.DAG.getContext(), InVT.getVectorElementType(), WidenEC);
        InOp = self.DAG.getInsertSubvector(DL, self.DAG.getPOISON(InWidenVT), InOp, 0);
    }
    return self.DAG.getAddrSpaceCast(DL, WidenVT, InOp, AddrSpaceCastN.getSrcAddressSpace(), AddrSpaceCastN.getDestAddressSpace(), AddrSpaceCastN.getFlags());
}

fn DAGTypeLegalizer::WidenVecRes_BITCAST(self, N: *mut SDNode) -> SDValue {
    let mut InOp: SDValue = N.getOperand(0);
    let mut InVT: EVT = InOp.getValueType();
    let mut VT: EVT = N.getValueType(0);
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut dl: SDLoc = SDLoc { N };
    match self.getTypeAction(InVT) {
        TypeLegal => {
            break;
        },
        TypeScalarizeScalableVector => {
            report_fatal_error("Scalarization of scalable vectors is not supported.", true);
        },
        TypePromoteInteger => {
            if InVT.isVector() {
                break;
            }
            let mut NInOp: SDValue = self.GetPromotedInteger(InOp);
            let mut NInVT: EVT = NInOp.getValueType();
            if WidenVT.bitsEq(NInVT) {
                if self.DAG.getDataLayout().isBigEndian() {
                    let mut ShiftAmt: u32 = NInVT.getSizeInBits() - InVT.getSizeInBits().operator unsigned long long();
                    NInOp = self.DAG.getNode(SHL, dl, NInVT, NInOp, self.DAG.getShiftAmountConstant(ShiftAmt, NInVT, dl));
                }
                return self.DAG.getNode(BITCAST, dl, WidenVT, NInOp);
            }
            InOp = NInOp;
            InVT = NInVT;
            break;
        },
        TypeSoftenFloat => {
            TypeSoftPromoteHalf;
        },
        TypeWidenVector => {
            InOp = self.GetWidenedVector(InOp);
        },
    }
    let mut WidenSize: u32 = WidenVT.getSizeInBits().operator unsigned long long();
    let mut InSize: u32 = InVT.getSizeInBits().operator unsigned long long();
    let mut InScalarSize: u32 = InVT.getScalarSizeInBits();
    if WidenSize % InScalarSize == 0 && InVT != EVT { x86mmx } {
        let mut NewInVT: EVT = EVT {};
        let mut NewNumParts: u32 = WidenSize / InSize;
        if InVT.isVector() {
            let mut InEltVT: EVT = InVT.getVectorElementType();
            NewInVT = getVectorVT(*self.DAG.getContext(), InEltVT, WidenSize / InEltVT.getSizeInBits().operator unsigned long long(), false);
        } else {
            let mut OrigInVT: EVT = N.getOperand(0).getValueType();
            NewNumParts = WidenSize / OrigInVT.getSizeInBits().operator unsigned long long();
            NewInVT = getVectorVT(*self.DAG.getContext(), OrigInVT, NewNumParts, false);
        }
        if self.TLI.isTypeLegal(NewInVT) {
            let mut NewVec: SDValue = SDValue {};
            if InVT.isVector() {
                if WidenSize % InSize == 0 {
                    let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { NewNumParts, self.DAG.getPOISON(InVT) };
                    Ops[0] = InOp;
                    NewVec = self.DAG.getNode(CONCAT_VECTORS, dl, NewInVT, ArrayRef<SDValue> { Ops });
                } else {
                    let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
                    self.DAG.ExtractVectorElements(InOp, Ops, 0, 0, EVT {});
                    Ops.append(WidenSize / InScalarSize - Ops.len, self.DAG.getPOISON(InVT.getVectorElementType()));
                    NewVec = self.DAG.getNode(BUILD_VECTOR, dl, NewInVT, ArrayRef<SDValue> { Ops });
                }
            } else {
                NewVec = self.DAG.getNode(SCALAR_TO_VECTOR, dl, NewInVT, InOp);
            }
            return self.DAG.getNode(BITCAST, dl, WidenVT, NewVec);
        }
    }
    return self.CreateStackStoreLoad(InOp, WidenVT);
}

fn DAGTypeLegalizer::WidenVecRes_LOOP_DEPENDENCE_MASK(self, N: *mut SDNode) -> SDValue {
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0)), N.getOperand(0), N.getOperand(1), N.getOperand(2), N.getOperand(3));
}

fn DAGTypeLegalizer::WidenVecRes_BUILD_VECTOR(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    let mut EltVT: EVT = N.getOperand(0).getValueType();
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut WidenNumElts: u32 = WidenVT.getVectorNumElements();
    let mut NewOps: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { N.ops() };
    assert!(WidenNumElts >= NumElts, "Shrinking vector instead of widening!");
    NewOps.append(WidenNumElts - NumElts, self.DAG.getPOISON(EltVT));
    return self.DAG.getBuildVector(WidenVT, dl, ArrayRef<SDValue> { NewOps });
}

fn DAGTypeLegalizer::WidenVecRes_CONCAT_VECTORS(self, N: *mut SDNode) -> SDValue {
    let mut InVT: EVT = N.getOperand(0).getValueType();
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut dl: SDLoc = SDLoc { N };
    let mut NumOperands: u32 = N.getNumOperands();
    let mut InputWidened: bool = false;
    if self.getTypeAction(InVT) != TypeWidenVector {
        let mut WidenNumElts: u32 = WidenVT.getVectorMinNumElements();
        let mut NumInElts: u32 = InVT.getVectorMinNumElements();
        if WidenNumElts % NumInElts == 0 {
            let mut NumConcat: u32 = WidenNumElts / NumInElts;
            let mut UndefVal: SDValue = self.DAG.getPOISON(InVT);
            let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { NumConcat };
            for let mut i: u32 = 0; i < NumOperands; i += 1 {
                Ops[i] = N.getOperand(i);
            }
            for let mut i: u32 = NumOperands; i != NumConcat; i += 1 {
                Ops[i] = UndefVal;
            }
            return self.DAG.getNode(CONCAT_VECTORS, dl, WidenVT, ArrayRef<SDValue> { Ops });
        }
    } else {
        InputWidened = true;
        if WidenVT == self.TLI.getTypeToTransformTo(*self.DAG.getContext(), InVT) {
            let mut i: u32 = 0;
            for i = 1; i < NumOperands; i += 1 {
                if !N.getOperand(i).isUndef() {
                    break;
                }
            }
            if i == NumOperands {
                return self.GetWidenedVector(N.getOperand(0));
            }
            if NumOperands == 2 {
                assert!(!WidenVT.isScalableVector(), "Cannot use vector shuffles to widen CONCAT_VECTOR result");
                let mut WidenNumElts: u32 = WidenVT.getVectorNumElements();
                let mut NumInElts: u32 = InVT.getVectorNumElements();
                let mut MaskOps: SmallVector<int, 16> = SmallVector<int, 16> { WidenNumElts, -1 };
                for let mut i: u32 = 0; i < NumInElts; i += 1 {
                    MaskOps[i] = i;
                    MaskOps[i + NumInElts] = i + WidenNumElts;
                }
                return self.DAG.getVectorShuffle(WidenVT, dl, self.GetWidenedVector(N.getOperand(0)), self.GetWidenedVector(N.getOperand(1)), ArrayRef<int> { MaskOps });
            }
        }
    }
    if WidenVT.isScalableVector() {
        let mut WideVec: SDValue = self.DAG.getPOISON(WidenVT);
        let mut NumInElts: u32 = InVT.getVectorMinNumElements();
        for let mut I: u32 = 0; I < NumOperands; I += 1 {
            WideVec = self.DAG.getInsertSubvector(dl, WideVec, N.getOperand(I), I * NumInElts);
        }
        return WideVec;
    }
    let mut WidenNumElts: u32 = WidenVT.getVectorNumElements();
    let mut NumInElts: u32 = InVT.getVectorNumElements();
    let mut EltVT: EVT = WidenVT.getVectorElementType();
    let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { WidenNumElts };
    let mut Idx: u32 = 0;
    for let mut i: u32 = 0; i < NumOperands; i += 1 {
        let mut InOp: SDValue = N.getOperand(i);
        if InputWidened {
            InOp = self.GetWidenedVector(InOp);
        }
        for let mut j: u32 = 0; j < NumInElts; j += 1 {
            Ops[Idx += 1] = self.DAG.getExtractVectorElt(dl, EltVT, InOp, j);
        }
    }
    let mut UndefVal: SDValue = self.DAG.getPOISON(EltVT);
    for ; Idx < WidenNumElts; Idx += 1 {
        Ops[Idx] = UndefVal;
    }
    return self.DAG.getBuildVector(WidenVT, dl, ArrayRef<SDValue> { Ops });
}

fn DAGTypeLegalizer::WidenVecRes_INSERT_SUBVECTOR(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut InOp1: SDValue = self.GetWidenedVector(N.getOperand(0));
    let mut InOp2: SDValue = N.getOperand(1);
    let mut Idx: SDValue = N.getOperand(2);
    let mut dl: SDLoc = SDLoc { N };
    return self.DAG.getNode(INSERT_SUBVECTOR, dl, WidenVT, InOp1, InOp2, Idx);
}

fn DAGTypeLegalizer::WidenVecRes_EXTRACT_SUBVECTOR(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut EltVT: EVT = VT.getVectorElementType();
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut InOp: SDValue = N.getOperand(0);
    let mut Idx: SDValue = N.getOperand(1);
    let mut dl: SDLoc = SDLoc { N };
    let mut InOpTypeAction: LegalizeTypeAction = self.getTypeAction(InOp.getValueType());
    if InOpTypeAction == TypeWidenVector {
        InOp = self.GetWidenedVector(InOp);
    }
    let mut InVT: EVT = InOp.getValueType();
    let mut IdxVal: u64 = operator(Idx).getAsZExtVal();
    if IdxVal == 0 && InVT == WidenVT {
        return InOp;
    }
    let mut WidenNumElts: u32 = WidenVT.getVectorMinNumElements();
    let mut InNumElts: u32 = InVT.getVectorMinNumElements();
    let mut VTNumElts: u32 = VT.getVectorMinNumElements();
    assert!(IdxVal % VTNumElts == 0, "Expected Idx to be a multiple of subvector minimum vector length");
    if IdxVal % WidenNumElts == 0 && IdxVal + WidenNumElts < InNumElts {
        return self.DAG.getNode(EXTRACT_SUBVECTOR, dl, WidenVT, InOp, Idx);
    }
    if VT.isScalableVector() {
        let mut GCD: u32 = gcd(VTNumElts, WidenNumElts);
        assert!((IdxVal % GCD) == 0, "Expected Idx to be a multiple of the broken down type's element count");
        let mut PartVT: EVT = getVectorVT(*self.DAG.getContext(), EltVT, getScalable(GCD));
        if self.getTypeAction(PartVT) != TypeWidenVector {
            let mut Parts: SmallVector<SDValue> = SmallVector<SDValue> {};
            let mut I: u32 = 0;
            for ; I < VTNumElts / GCD; I += 1 {
                Parts.push(self.DAG.getExtractSubvector(dl, PartVT, InOp, IdxVal + I * GCD));
            }
            for ; I < WidenNumElts / GCD; I += 1 {
                Parts.push(self.DAG.getPOISON(PartVT));
            }
            return self.DAG.getNode(CONCAT_VECTORS, dl, WidenVT, ArrayRef<SDValue> { Parts });
        }
        let mut Alignment: Align = self.DAG.getReducedAlign(InVT, false);
        let mut StackPtr: SDValue = self.DAG.CreateStackTemporary(InVT.getStoreSize(), Alignment);
        let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
        let mut FrameIndex: i32 = cast(StackPtr.getNode()).getIndex();
        let mut PtrInfo: MachinePointerInfo = getFixedStack(MF, FrameIndex, 0);
        let mut StoreMMO: *mut MachineMemOperand = MF.getMachineMemOperand(PtrInfo, MOStore, beforeOrAfterPointer(), Alignment, MMOMetadata {}, System, NotAtomic, NotAtomic);
        let mut LoadMMO: *mut MachineMemOperand = MF.getMachineMemOperand(PtrInfo, MOLoad, beforeOrAfterPointer(), Alignment, MMOMetadata {}, System, NotAtomic, NotAtomic);
        let mut Ch: SDValue = self.DAG.getStore(self.DAG.getEntryNode(), dl, InOp, StackPtr, StoreMMO);
        let mut Mask: SDValue = self.DAG.getMaskFromElementCount(dl, WidenVT, VT.getVectorElementCount());
        StackPtr = self.TLI.getVectorSubVecPointer(self.DAG, StackPtr, InVT, VT, Idx, SDNodeFlags { Flags: None });
        return self.DAG.getMaskedLoad(WidenVT, dl, Ch, StackPtr, self.DAG.getPOISON(StackPtr.getValueType()), Mask, self.DAG.getPOISON(WidenVT), VT, LoadMMO, UNINDEXED, NON_EXTLOAD, false);
    }
    let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { WidenNumElts };
    let mut i: u32 = 0;
    for i = 0; i < VTNumElts; i += 1 {
        Ops[i] = self.DAG.getExtractVectorElt(dl, EltVT, InOp, IdxVal + i);
    }
    let mut UndefVal: SDValue = self.DAG.getPOISON(EltVT);
    for ; i < WidenNumElts; i += 1 {
        Ops[i] = UndefVal;
    }
    return self.DAG.getBuildVector(WidenVT, dl, ArrayRef<SDValue> { Ops });
}

fn DAGTypeLegalizer::WidenVecRes_AssertZext(self, N: *mut SDNode) -> SDValue {
    let mut InOp: SDValue = self.ModifyToType(N.getOperand(0), self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0)), true);
    return self.DAG.getNode(AssertZext, SDLoc { N }, InOp.getValueType(), InOp, N.getOperand(1));
}

fn DAGTypeLegalizer::WidenVecRes_INSERT_VECTOR_ELT(self, N: *mut SDNode) -> SDValue {
    let mut InOp: SDValue = self.GetWidenedVector(N.getOperand(0));
    return self.DAG.getNode(INSERT_VECTOR_ELT, SDLoc { N }, InOp.getValueType(), InOp, N.getOperand(1), N.getOperand(2));
}

fn coerceLoadedValue(LdOp: SDValue, FirstVT: EVT, WidenVT: EVT, LdWidth: TypeSize, FirstVTWidth: TypeSize, dl: SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    assert!(isKnownLE(LdWidth, FirstVTWidth), "Load width must be less than or equal to first value type width");
    let mut WidenWidth: TypeSize = WidenVT.getSizeInBits();
    if !FirstVT.isVector() {
        let mut NumElts: u32 = WidenWidth.getFixedValue() / FirstVTWidth.getFixedValue();
        let mut NewVecVT: EVT = getVectorVT(*DAG.getContext(), FirstVT, NumElts, false);
        let mut VecOp: SDValue = DAG.getNode(SCALAR_TO_VECTOR, dl, NewVecVT, LdOp);
        return DAG.getNode(BITCAST, dl, WidenVT, VecOp);
    }
    assert!(FirstVT == WidenVT, "First value type must equal widen value type");
    return LdOp;
}

fn coerceStoredValue(StVal: SDValue, FirstVT: EVT, WidenVT: EVT, FirstVTWidth: TypeSize, dl: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut WidenWidth: TypeSize = WidenVT.getSizeInBits();
    if !FirstVT.isVector() {
        let mut NumElts: u32 = WidenWidth.getFixedValue() / FirstVTWidth.getFixedValue();
        let mut NewVecVT: EVT = getVectorVT(*DAG.getContext(), FirstVT, NumElts, false);
        let mut VecOp: SDValue = DAG.getNode(BITCAST, dl, NewVecVT, StVal);
        return DAG.getExtractVectorElt(dl, FirstVT, VecOp, 0);
    }
    assert!(FirstVT == WidenVT, "First value type must equal widen value type");
    return StVal;
}

fn DAGTypeLegalizer::WidenVecRes_ATOMIC_LOAD(self, LD: *mut AtomicSDNode) -> SDValue {
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), LD.getValueType(0));
    let mut LdVT: EVT = LD.getMemoryVT();
    let mut dl: SDLoc = SDLoc { LD };
    let mut Chain: SDValue = LD.getChain();
    let mut BasePtr: SDValue = LD.getBasePtr();
    let mut LdWidth: TypeSize = LdVT.getSizeInBits();
    let mut WidenWidth: TypeSize = WidenVT.getSizeInBits();
    let mut WidthDiff: TypeSize = WidenWidth - LdWidth;
    let mut FirstVT: optional<EVT> = findMemType(self.DAG, self.TLI, LdWidth.getKnownMinValue(), WidenVT, 0, WidthDiff.getKnownMinValue());
    if !FirstVT {
        return SDValue {};
    }
    let mut MemVTs: SmallVector<EVT, 8> = SmallVector<EVT, 8> {};
    let mut FirstVTWidth: TypeSize = operator(FirstVT).getSizeInBits();
    let mut LdOp: SDValue = self.DAG.getAtomicLoad(NON_EXTLOAD, dl, operator(FirstVT), operator(FirstVT), Chain, BasePtr, LD.getMemOperand());
    let mut Result: SDValue = coerceLoadedValue(LdOp, operator(FirstVT), WidenVT, LdWidth, FirstVTWidth, dl, self.DAG);
    self.ReplaceValueWith(SDValue { Node: LD, ResNo: 1 }, LdOp.getValue(1));
    return Result;
}

fn DAGTypeLegalizer::WidenVecRes_LOAD(self, N: *mut SDNode) -> SDValue {
    let mut LD: *mut LoadSDNode = cast(N);
    let mut ExtType: LoadExtType = LD.getExtensionType();
    if !LD.getMemoryVT().isByteSized() {
        let mut Value: SDValue = SDValue {};
        let mut NewChain: SDValue = SDValue {};
        tie(Value, NewChain) = self.TLI.scalarizeVectorLoad(LD, self.DAG);
        self.ReplaceValueWith(SDValue { Node: LD, ResNo: 0 }, Value);
        self.ReplaceValueWith(SDValue { Node: LD, ResNo: 1 }, NewChain);
        return SDValue {};
    }
    let mut VT: EVT = LD.getValueType(0);
    let mut WideVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut WideMaskVT: EVT = self.getSetCCResultType(WideVT);
    if ExtType == NON_EXTLOAD && self.TLI.isOperationLegalOrCustom(VP_LOAD, WideVT, false) && self.TLI.isTypeLegal(WideMaskVT) {
        let mut DL: SDLoc = SDLoc { N };
        let mut Mask: SDValue = self.DAG.getAllOnesConstant(DL, WideMaskVT, false, false);
        let mut EVL: SDValue = self.DAG.getElementCount(DL, EVT { self.TLI.getVPExplicitVectorLengthTy() }, VT.getVectorElementCount());
        let mut NewLoad: SDValue = self.DAG.getLoadVP(LD.getAddressingMode(), NON_EXTLOAD, WideVT, DL, LD.getChain(), LD.getBasePtr(), LD.getOffset(), Mask, EVL, LD.getMemoryVT(), LD.getMemOperand(), false);
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, NewLoad.getValue(1));
        return NewLoad;
    }
    let mut Result: SDValue = SDValue {};
    let mut LdChain: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    if ExtType != NON_EXTLOAD {
        Result = self.GenWidenVectorExtLoads(LdChain, LD, ExtType);
    } else {
        Result = self.GenWidenVectorLoads(LdChain, LD);
    }
    if Result {
        let mut NewChain: SDValue = SDValue {};
        if LdChain.len == 1 {
            NewChain = LdChain[0];
        } else {
            NewChain = self.DAG.getNode(TokenFactor, SDLoc { LD }, EVT { Other }, ArrayRef<SDValue> { LdChain });
        }
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, NewChain);
        return Result;
    }
    if VT.isVector() {
        let mut DL: SDLoc = SDLoc { N };
        let mut Mask: SDValue = self.DAG.getMaskFromElementCount(DL, WideVT, VT.getVectorElementCount());
        let mut NewLoad: SDValue = self.DAG.getMaskedLoad(WideVT, DL, LD.getChain(), LD.getBasePtr(), LD.getOffset(), Mask, self.DAG.getPOISON(WideVT), LD.getMemoryVT(), LD.getMemOperand(), LD.getAddressingMode(), LD.getExtensionType(), false);
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, NewLoad.getValue(1));
        return NewLoad;
    }
    report_fatal_error("Unable to widen vector load", true);
}

fn DAGTypeLegalizer::WidenVecRes_VP_LOAD(self, N: *mut VPLoadSDNode) -> SDValue {
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut Mask: SDValue = N.getMask();
    let mut EVL: SDValue = N.getVectorLength();
    let mut ExtType: LoadExtType = N.getExtensionType();
    let mut dl: SDLoc = SDLoc { N };
    assert!(self.getTypeAction(Mask.getValueType()) == TypeWidenVector, "Unable to widen binary VP op");
    Mask = self.GetWidenedVector(Mask);
    assert!(Mask.getValueType().getVectorElementCount() == self.TLI.getTypeToTransformTo(*self.DAG.getContext(), Mask.getValueType()).getVectorElementCount(), "Unable to widen vector load");
    let mut Res: SDValue = self.DAG.getLoadVP(N.getAddressingMode(), ExtType, WidenVT, dl, N.getChain(), N.getBasePtr(), N.getOffset(), Mask, EVL, N.getMemoryVT(), N.getMemOperand(), N.isExpandingLoad());
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
    return Res;
}

fn DAGTypeLegalizer::WidenVecRes_VP_LOAD_FF(self, N: *mut VPLoadFFSDNode) -> SDValue {
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut Mask: SDValue = N.getMask();
    let mut EVL: SDValue = N.getVectorLength();
    let mut dl: SDLoc = SDLoc { N };
    assert!(self.getTypeAction(Mask.getValueType()) == TypeWidenVector, "Unable to widen binary VP op");
    Mask = self.GetWidenedVector(Mask);
    assert!(Mask.getValueType().getVectorElementCount() == self.TLI.getTypeToTransformTo(*self.DAG.getContext(), Mask.getValueType()).getVectorElementCount(), "Unable to widen vector load");
    let mut Res: SDValue = self.DAG.getLoadFFVP(WidenVT, dl, N.getChain(), N.getBasePtr(), Mask, EVL, N.getMemOperand());
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 2 }, Res.getValue(2));
    return Res;
}

fn DAGTypeLegalizer::WidenVecRes_VP_STRIDED_LOAD(self, N: *mut VPStridedLoadSDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Mask: SDValue = N.getMask();
    assert!(self.getTypeAction(Mask.getValueType()) == TypeWidenVector, "Unable to widen VP strided load");
    Mask = self.GetWidenedVector(Mask);
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    assert!(Mask.getValueType().getVectorElementCount() == WidenVT.getVectorElementCount(), "Data and mask vectors should have the same number of elements");
    let mut Res: SDValue = self.DAG.getStridedLoadVP(N.getAddressingMode(), N.getExtensionType(), WidenVT, DL, N.getChain(), N.getBasePtr(), N.getOffset(), N.getStride(), Mask, N.getVectorLength(), N.getMemoryVT(), N.getMemOperand(), N.isExpandingLoad());
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
    return Res;
}

fn DAGTypeLegalizer::WidenVecRes_VECTOR_COMPRESS(self, N: *mut SDNode) -> SDValue {
    let mut Vec: SDValue = N.getOperand(0);
    let mut Mask: SDValue = N.getOperand(1);
    let mut Passthru: SDValue = N.getOperand(2);
    let mut WideVecVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), Vec.getValueType());
    let mut WideMaskVT: EVT = getVectorVT(*self.DAG.getContext(), Mask.getValueType().getVectorElementType(), WideVecVT.getVectorElementCount());
    let mut WideVec: SDValue = self.ModifyToType(Vec, WideVecVT, false);
    let mut WideMask: SDValue = self.ModifyToType(Mask, WideMaskVT, true);
    let mut WidePassthru: SDValue = self.ModifyToType(Passthru, WideVecVT, false);
    return self.DAG.getNode(VECTOR_COMPRESS, SDLoc { N }, WideVecVT, WideVec, WideMask, WidePassthru);
}

fn DAGTypeLegalizer::WidenVecRes_MLOAD(self, N: *mut MaskedLoadSDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut Mask: SDValue = N.getMask();
    let mut MaskVT: EVT = Mask.getValueType();
    let mut PassThru: SDValue = self.GetWidenedVector(N.getPassThru());
    let mut ExtType: LoadExtType = N.getExtensionType();
    let mut dl: SDLoc = SDLoc { N };
    let mut WideMaskVT: EVT = getVectorVT(*self.DAG.getContext(), MaskVT.getVectorElementType(), WidenVT.getVectorElementCount());
    if ExtType == NON_EXTLOAD && !N.isExpandingLoad() && self.TLI.isOperationLegalOrCustom(VP_LOAD, WidenVT, false) && self.TLI.isTypeLegal(WideMaskVT) && (operator(N.getPassThru()).isUndef() || VT.isScalableVector()) {
        Mask = self.DAG.getInsertSubvector(dl, self.DAG.getPOISON(WideMaskVT), Mask, 0);
        let mut EVL: SDValue = self.DAG.getElementCount(dl, EVT { self.TLI.getVPExplicitVectorLengthTy() }, VT.getVectorElementCount());
        let mut NewLoad: SDValue = self.DAG.getLoadVP(N.getAddressingMode(), NON_EXTLOAD, WidenVT, dl, N.getChain(), N.getBasePtr(), N.getOffset(), Mask, EVL, N.getMemoryVT(), N.getMemOperand(), false);
        let mut NewVal: SDValue = NewLoad;
        if !operator(N.getPassThru()).isUndef() {
            assert!(WidenVT.isScalableVector());
            NewVal = self.DAG.getNode(VSELECT, dl, WidenVT, Mask, NewVal, PassThru);
            NewVal = self.DAG.getNode(VP_MERGE, dl, WidenVT, self.DAG.getAllOnesConstant(dl, WideMaskVT, false, false), NewVal, self.DAG.getPOISON(WidenVT), EVL);
        }
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, NewLoad.getValue(1));
        return NewVal;
    }
    Mask = self.ModifyToType(Mask, WideMaskVT, true);
    let mut Res: SDValue = self.DAG.getMaskedLoad(WidenVT, dl, N.getChain(), N.getBasePtr(), N.getOffset(), Mask, PassThru, N.getMemoryVT(), N.getMemOperand(), N.getAddressingMode(), ExtType, N.isExpandingLoad());
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
    return Res;
}

fn DAGTypeLegalizer::WidenVecRes_MGATHER(self, N: *mut MaskedGatherSDNode) -> SDValue {
    let mut WideVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut Mask: SDValue = N.getMask();
    let mut MaskVT: EVT = Mask.getValueType();
    let mut PassThru: SDValue = self.GetWidenedVector(N.getPassThru());
    let mut Scale: SDValue = N.getScale();
    let mut WideEC: ElementCount = WideVT.getVectorElementCount();
    let mut dl: SDLoc = SDLoc { N };
    let mut WideMaskVT: EVT = getVectorVT(*self.DAG.getContext(), MaskVT.getVectorElementType(), WideEC);
    Mask = self.ModifyToType(Mask, WideMaskVT, true);
    let mut Index: SDValue = N.getIndex();
    let mut WideIndexVT: EVT = getVectorVT(*self.DAG.getContext(), Index.getValueType().getScalarType(), WideEC);
    Index = self.ModifyToType(Index, WideIndexVT, false);
    let mut Ops: [6]SDValue = [N.getChain(), PassThru, Mask, N.getBasePtr(), Index, Scale];
    let mut WideMemVT: EVT = getVectorVT(*self.DAG.getContext(), N.getMemoryVT().getScalarType(), WideEC);
    let mut Res: SDValue = self.DAG.getMaskedGather(self.DAG.getVTList(WideVT, EVT { Other }), WideMemVT, dl, ArrayRef<SDValue> { Ops }, N.getMemOperand(), N.getIndexType(), N.getExtensionType());
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
    return Res;
}

fn DAGTypeLegalizer::WidenVecRes_VP_GATHER(self, N: *mut VPGatherSDNode) -> SDValue {
    let mut WideVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut Mask: SDValue = N.getMask();
    let mut Scale: SDValue = N.getScale();
    let mut WideEC: ElementCount = WideVT.getVectorElementCount();
    let mut dl: SDLoc = SDLoc { N };
    let mut Index: SDValue = self.GetWidenedVector(N.getIndex());
    let mut WideMemVT: EVT = getVectorVT(*self.DAG.getContext(), N.getMemoryVT().getScalarType(), WideEC);
    Mask = self.GetWidenedMask(Mask, WideEC);
    let mut Ops: [6]SDValue = [N.getChain(), N.getBasePtr(), Index, Scale, Mask, N.getVectorLength()];
    let mut Res: SDValue = self.DAG.getGatherVP(self.DAG.getVTList(WideVT, EVT { Other }), WideMemVT, dl, ArrayRef<SDValue> { Ops }, N.getMemOperand(), N.getIndexType());
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
    return Res;
}

fn DAGTypeLegalizer::WidenVecRes_ScalarOp(self, N: *mut SDNode) -> SDValue {
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, WidenVT, N.getOperand(0));
}

fn isSETCCOp(Opcode: u32) -> bool {
    match Opcode {
        SETCC => {
            STRICT_FSETCC;
        },
    }
    return false;
}

fn isLogicalMaskOp(Opcode: u32) -> bool {
    match Opcode {
        AND => {
            OR;
        },
    }
    return false;
}

fn getSETCCOperandType(N: SDValue) -> EVT {
    let mut OpNo: u32 = if operator(N).isStrictFPOpcode() { 1 } else { 0 };
    return operator(N).getOperand(OpNo).getValueType();
}

fn isSETCCorConvertedSETCC(N: SDValue) -> bool {
    if N.getOpcode() == EXTRACT_SUBVECTOR {
        N = N.getOperand(0);
    } else if N.getOpcode() == CONCAT_VECTORS {
        for let mut i: u32 = 1; i < operator(N).getNumOperands(); i += 1 {
            if !operator(operator(N).getOperand(i)).isUndef() {
                return false;
            }
        }
        N = N.getOperand(0);
    }
    if N.getOpcode() == TRUNCATE {
        N = N.getOperand(0);
    } else if N.getOpcode() == SIGN_EXTEND {
        N = N.getOperand(0);
    }
    if isLogicalMaskOp(N.getOpcode()) {
        return isSETCCorConvertedSETCC(N.getOperand(0)) && isSETCCorConvertedSETCC(N.getOperand(1));
    }
    return (isSETCCOp(N.getOpcode()) || isBuildVectorOfConstantSDNodes(N.getNode()));
}

fn DAGTypeLegalizer::convertMask(self, InMask: SDValue, MaskVT: EVT, ToMaskVT: EVT) -> SDValue {
    assert!(isSETCCorConvertedSETCC(InMask), "Unexpected mask argument.");
    let mut Mask: SDValue = SDValue {};
    let mut Ops: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    for let mut i: u32 = 0;
let mut e: u32 = operator(InMask).getNumOperands(); i < e; i += 1 {
        Ops.push(ValueParamT { operator(InMask).getOperand(i) });
    }
    if operator(InMask).isStrictFPOpcode() {
        Mask = self.DAG.getNode(operator(InMask).getOpcode(), SDLoc { InMask }, ArrayRef<EVT> { [MaskVT, EVT { Other }] }, ArrayRef<SDValue> { Ops });
        self.ReplaceValueWith(InMask.getValue(1), Mask.getValue(1));
    } else {
        Mask = self.DAG.getNode(operator(InMask).getOpcode(), SDLoc { InMask }, MaskVT, ArrayRef<SDValue> { Ops }, operator(InMask).getFlags());
    }
    return self.adjustMaskToType(Mask, ToMaskVT);
}

fn DAGTypeLegalizer::adjustMaskToType(self, Mask: SDValue, ToMaskVT: EVT) -> SDValue {
    let mut Ctx: *mut LLVMContext = *self.DAG.getContext();
    let mut MaskVT: EVT = Mask.getValueType();
    let mut MaskScalarBits: u32 = MaskVT.getScalarSizeInBits();
    let mut ToMaskScalBits: u32 = ToMaskVT.getScalarSizeInBits();
    if MaskScalarBits < ToMaskScalBits {
        let mut ExtVT: EVT = getVectorVT(Ctx, ToMaskVT.getVectorElementType(), MaskVT.getVectorNumElements(), false);
        Mask = self.DAG.getNode(SIGN_EXTEND, SDLoc { Mask }, ExtVT, Mask);
    } else if MaskScalarBits > ToMaskScalBits {
        let mut TruncVT: EVT = getVectorVT(Ctx, ToMaskVT.getVectorElementType(), MaskVT.getVectorNumElements(), false);
        Mask = self.DAG.getNode(TRUNCATE, SDLoc { Mask }, TruncVT, Mask);
    }
    assert!(operator(Mask).getValueType(0).getScalarSizeInBits() == ToMaskVT.getScalarSizeInBits(), "Mask should have the right element size by now.");
    let mut CurrMaskNumEls: u32 = operator(Mask).getValueType(0).getVectorNumElements();
    if CurrMaskNumEls > ToMaskVT.getVectorNumElements() {
        Mask = self.DAG.getExtractSubvector(SDLoc { Mask }, ToMaskVT, Mask, 0);
    } else if CurrMaskNumEls < ToMaskVT.getVectorNumElements() {
        let mut NumSubVecs: u32 = (ToMaskVT.getVectorNumElements() / CurrMaskNumEls);
        let mut SubVT: EVT = operator(Mask).getValueType(0);
        let mut SubOps: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { NumSubVecs, self.DAG.getPOISON(SubVT) };
        SubOps[0] = Mask;
        Mask = self.DAG.getNode(CONCAT_VECTORS, SDLoc { Mask }, ToMaskVT, ArrayRef<SDValue> { SubOps });
    }
    assert!((operator(Mask).getValueType(0) == ToMaskVT), "A mask of ToMaskVT should have been produced by now.");
    return Mask;
}

fn DAGTypeLegalizer::unifyMaskTypes(self, Op0: *mut SDValue, IsOpLenient0: bool, Op1: *mut SDValue, IsOpLenient1: bool, ToVT: EVT) -> EVT {
    assert!(Op0.getValueType().getVectorNumElements() == Op1.getValueType().getVectorNumElements(), "unifyMaskTypes only handles scalar width differences");
    if IsOpLenient0 != IsOpLenient1 {
        let mut LenientOp: *mut SDValue = null;
        let mut NonLenientOp: *mut SDValue = null;
        if IsOpLenient0 {
            LenientOp = &mut Op0;
            NonLenientOp = &mut Op1;
        } else {
            LenientOp = &mut Op1;
            NonLenientOp = &mut Op0;
        }
        let mut OpVT: EVT = NonLenientOp.getValueType();
        *LenientOp = self.adjustMaskToType(*LenientOp, OpVT);
        return OpVT;
    }
    let mut Bits0: u32 = Op0.getScalarValueSizeInBits();
    let mut Bits1: u32 = Op1.getScalarValueSizeInBits();
    let mut NarrowBits: u32 = if Bits0 < Bits1 { Bits0 } else { Bits1 };
    let mut WideBits: u32 = if Bits0 > Bits1 { Bits0 } else { Bits1 };
    let mut ToBits: u32 = ToVT.getScalarSizeInBits();
    let mut IntBits: u32 = if NarrowBits == WideBits { NarrowBits } else { if ToBits >= WideBits {} else { if ToBits <= NarrowBits {} else { ToBits } } };
    let mut OpVT: EVT = Op0.getValueType().changeVectorElementType(*self.DAG.getContext(), getIntegerVT(*self.DAG.getContext(), IntBits));
    Op0 = self.adjustMaskToType(Op0, OpVT);
    Op1 = self.adjustMaskToType(Op1, OpVT);
    return OpVT;
}

fn DAGTypeLegalizer::convertMaskTreeImpl(self, V: SDValue, ToVT: EVT, Depth: u32) -> pair<SDValue, bool> {
    if Depth >= self.DAG.MaxRecursionDepth {
        return pair<SDValue, bool> {};
    }
    if V.getValueType().getVectorNumElements() != ToVT.getVectorNumElements() {
        return pair<SDValue, bool> {};
    }
    let mut Opcode: u32 = V.getOpcode();
    if isSETCCOp(Opcode) {
        let mut MaskVT: EVT = self.getSetCCResultType(getSETCCOperandType(V));
        return pair<SDValue, bool> { self.convertMask(V, MaskVT, MaskVT), false };
    }
    let mut DL: SDLoc = SDLoc { V };
    if isBuildVectorAllZeros(V.getNode()) {
        return pair<SDValue, bool> { self.DAG.getConstant(0, DL, ToVT, false, false), true };
    }
    if isBuildVectorAllOnes(V.getNode()) {
        return pair<SDValue, bool> { self.DAG.getAllOnesConstant(DL, ToVT, false, false), true };
    }
    if isLogicalMaskOp(Opcode) {
        if !Op0 {
            return pair<SDValue, bool> {};
        }
        if !Op1 {
            return pair<SDValue, bool> {};
        }
        let mut OpVT: EVT = self.unifyMaskTypes(Op0, IsLenientOp0, Op1, IsLenientOp1, ToVT);
        return pair<SDValue, bool> { self.DAG.getNode(Opcode, DL, OpVT, Op0, Op1), IsLenientOp0 && IsLenientOp1 };
    }
    if Opcode == FREEZE {
        if !Inner {
            return pair<SDValue, bool> {};
        }
        return pair<SDValue, bool> { self.DAG.getNode(FREEZE, DL, Inner.getValueType(), Inner), IsTypeLenient };
    }
    if Opcode == VECTOR_SHUFFLE {
        let mut Shuf: *mut ShuffleVectorSDNode = cast(V);
        if !Op0 {
            return pair<SDValue, bool> {};
        }
        if V.getOperand(1).isUndef() {
            let mut OpVT: EVT = Op0.getValueType();
            return pair<SDValue, bool> { self.DAG.getVectorShuffle(OpVT, DL, Op0, self.DAG.getUNDEF(OpVT), Shuf.getMask()), IsLenientOp0 };
        }
        if !Op1 {
            return pair<SDValue, bool> {};
        }
        let mut OpVT: EVT = self.unifyMaskTypes(Op0, IsLenientOp0, Op1, IsLenientOp1, ToVT);
        return pair<SDValue, bool> { self.DAG.getVectorShuffle(OpVT, DL, Op0, Op1, Shuf.getMask()), IsLenientOp0 && IsLenientOp1 };
    }
    if Opcode == SELECT || Opcode == VSELECT {
        if !Op1 {
            return pair<SDValue, bool> {};
        }
        if !Op2 {
            return pair<SDValue, bool> {};
        }
        let mut OpVT: EVT = self.unifyMaskTypes(Op1, IsLenientOp1, Op2, IsLenientOp2, ToVT);
        let mut Cond: SDValue = V.getOperand(0);
        return pair<SDValue, bool> { self.DAG.getNode(Opcode, DL, OpVT, Cond, Op1, Op2), IsLenientOp1 && IsLenientOp2 };
    }
    return pair<SDValue, bool> {};
}

fn DAGTypeLegalizer::convertMaskTree(self, V: SDValue, ToVT: EVT) -> SDValue {
    let mut MaskTreeVT: EVT = ToVT.changeVectorElementCount(*self.DAG.getContext(), V.getValueType().getVectorElementCount());
    if !Result {
        return Result;
    }
    return self.adjustMaskToType(Result, ToVT);
}

fn DAGTypeLegalizer::WidenVSELECTMask(self, N: *mut SDNode) -> SDValue {
    let mut Ctx: *mut LLVMContext = *self.DAG.getContext();
    let mut Cond: SDValue = N.getOperand(0);
    if N.getOpcode() != VSELECT {
        return SDValue {};
    }
    let mut CondVT: EVT = operator(Cond).getValueType(0);
    if CondVT.getScalarSizeInBits() != 1 {
        return SDValue {};
    }
    let mut VSelVT: EVT = N.getValueType(0);
    if VSelVT.isScalableVector() {
        return SDValue {};
    }
    if !isPowerOf2_64(VSelVT.getSizeInBits().operator unsigned long long()) {
        return SDValue {};
    }
    let mut FinalVT: EVT = VSelVT;
    while self.getTypeAction(FinalVT) == TypeSplitVector {
        FinalVT = FinalVT.getHalfNumVectorElementsVT(Ctx);
    }
    if FinalVT.getVectorNumElements() == 1 {
        return SDValue {};
    }
    if isSETCCOp(Cond.getOpcode()) {
        let mut SetCCOpVT: EVT = getSETCCOperandType(Cond);
        while self.TLI.getTypeAction(Ctx, SetCCOpVT) != TypeLegal {
            SetCCOpVT = self.TLI.getTypeToTransformTo(Ctx, SetCCOpVT);
        }
        let mut SetCCResVT: EVT = self.getSetCCResultType(SetCCOpVT);
        if SetCCResVT.getScalarSizeInBits() == 1 {
            return SDValue {};
        }
    } else if CondVT.getScalarType() == EVT { i1 } {
        while self.TLI.getTypeAction(Ctx, CondVT) != TypeLegal {
            CondVT = self.TLI.getTypeToTransformTo(Ctx, CondVT);
        }
        if CondVT.getScalarType() == EVT { i1 } {
            return SDValue {};
        }
    }
    if self.getTypeAction(VSelVT) == TypeWidenVector {
        VSelVT = self.TLI.getTypeToTransformTo(Ctx, VSelVT);
    }
    let mut ToMaskVT: EVT = VSelVT;
    if !ToMaskVT.getScalarType().isInteger() {
        ToMaskVT = ToMaskVT.changeVectorElementTypeToInteger();
    }
    return self.convertMaskTree(Cond, ToMaskVT);
}

fn DAGTypeLegalizer::WidenVecRes_Select(self, N: *mut SDNode) -> SDValue {
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut WidenEC: ElementCount = WidenVT.getVectorElementCount();
    let mut Cond1: SDValue = N.getOperand(0);
    let mut CondVT: EVT = Cond1.getValueType();
    let mut Opcode: u32 = N.getOpcode();
    if CondVT.isVector() {
        if self.WidenVSELECTMask(N) {
            WideCond;
        } else {
            let mut InOp1: SDValue = self.GetWidenedVector(N.getOperand(1));
            let mut InOp2: SDValue = self.GetWidenedVector(N.getOperand(2));
            assert!(InOp1.getValueType() == WidenVT && InOp2.getValueType() == WidenVT);
            return self.DAG.getNode(Opcode, SDLoc { N }, WidenVT, WideCond, InOp1, InOp2);
        }
        let mut CondEltVT: EVT = CondVT.getVectorElementType();
        let mut CondWidenVT: EVT = getVectorVT(*self.DAG.getContext(), CondEltVT, WidenEC);
        if self.getTypeAction(CondVT) == TypeWidenVector {
            Cond1 = self.GetWidenedVector(Cond1);
        }
        if self.getTypeAction(CondVT) == TypeSplitVector {
            let mut SplitSelect: SDValue = self.SplitVecOp_VSELECT(N, 0);
            let mut Res: SDValue = self.ModifyToType(SplitSelect, WidenVT, false);
            return Res;
        }
        if Cond1.getValueType() != CondWidenVT {
            Cond1 = self.ModifyToType(Cond1, CondWidenVT, false);
        }
    }
    let mut InOp1: SDValue = self.GetWidenedVector(N.getOperand(1));
    let mut InOp2: SDValue = self.GetWidenedVector(N.getOperand(2));
    assert!(InOp1.getValueType() == WidenVT && InOp2.getValueType() == WidenVT);
    if Opcode == VP_MERGE {
        return self.DAG.getNode(Opcode, SDLoc { N }, WidenVT, Cond1, InOp1, InOp2, N.getOperand(3));
    }
    return self.DAG.getNode(Opcode, SDLoc { N }, WidenVT, Cond1, InOp1, InOp2);
}

fn DAGTypeLegalizer::WidenVecRes_SELECT_CC(self, N: *mut SDNode) -> SDValue {
    let mut InOp1: SDValue = self.GetWidenedVector(N.getOperand(2));
    let mut InOp2: SDValue = self.GetWidenedVector(N.getOperand(3));
    return self.DAG.getNode(SELECT_CC, SDLoc { N }, InOp1.getValueType(), N.getOperand(0), N.getOperand(1), InOp1, InOp2, N.getOperand(4));
}

fn DAGTypeLegalizer::WidenVecRes_UNDEF(self, N: *mut SDNode) -> SDValue {
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    return self.DAG.getUNDEF(WidenVT);
}

fn DAGTypeLegalizer::WidenVecRes_VECTOR_SHUFFLE(self, N: *mut ShuffleVectorSDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut dl: SDLoc = SDLoc { N };
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut WidenNumElts: u32 = WidenVT.getVectorNumElements();
    let mut InOp1: SDValue = self.GetWidenedVector(N.getOperand(0));
    let mut InOp2: SDValue = self.GetWidenedVector(N.getOperand(1));
    let mut NewMask: SmallVector<int, 16> = SmallVector<int, 16> { WidenNumElts, -1 };
    for let mut i: u32 = 0; i != NumElts; i += 1 {
        let mut Idx: i32 = N.getMaskElt(i);
        if Idx < NumElts as i32 {
            NewMask[i] = Idx;
        } else {
            NewMask[i] = Idx - NumElts + WidenNumElts;
        }
    }
    return self.DAG.getVectorShuffle(WidenVT, dl, InOp1, InOp2, ArrayRef<int> { NewMask });
}

fn DAGTypeLegalizer::WidenVecRes_VECTOR_REVERSE(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut EltVT: EVT = VT.getVectorElementType();
    let mut dl: SDLoc = SDLoc { N };
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut OpValue: SDValue = self.GetWidenedVector(N.getOperand(0));
    assert!(WidenVT == OpValue.getValueType(), "Unexpected widened vector type");
    let mut ReverseVal: SDValue = self.DAG.getNode(VECTOR_REVERSE, dl, WidenVT, OpValue);
    let mut WidenNumElts: u32 = WidenVT.getVectorMinNumElements();
    let mut VTNumElts: u32 = VT.getVectorMinNumElements();
    let mut IdxVal: u32 = WidenNumElts - VTNumElts;
    if VT.isScalableVector() {
        let mut GCD: u32 = gcd(VTNumElts, WidenNumElts);
        let mut PartVT: EVT = getVectorVT(*self.DAG.getContext(), EltVT, getScalable(GCD));
        assert!((IdxVal % GCD) == 0, "Expected Idx to be a multiple of the broken down type's element count");
        let mut Parts: SmallVector<SDValue> = SmallVector<SDValue> {};
        let mut i: u32 = 0;
        for ; i < VTNumElts / GCD; i += 1 {
            Parts.push(self.DAG.getExtractSubvector(dl, PartVT, ReverseVal, IdxVal + i * GCD));
        }
        for ; i < WidenNumElts / GCD; i += 1 {
            Parts.push(self.DAG.getPOISON(PartVT));
        }
        return self.DAG.getNode(CONCAT_VECTORS, dl, WidenVT, ArrayRef<SDValue> { Parts });
    }
    let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> { WidenNumElts, -1 };
    iota(Mask.begin(), Mask.begin() + VTNumElts, IdxVal);
    return self.DAG.getVectorShuffle(WidenVT, dl, ReverseVal, self.DAG.getPOISON(WidenVT), ArrayRef<int> { Mask });
}

fn DAGTypeLegalizer::WidenVecRes_GET_ACTIVE_LANE_MASK(self, N: *mut SDNode) -> SDValue {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    return self.DAG.getNode(GET_ACTIVE_LANE_MASK, SDLoc { N }, NVT, N.ops());
}

fn DAGTypeLegalizer::WidenVecRes_VECTOR_INTERLEAVE(self, N: *mut SDNode) {
    let mut VT: EVT = N.getValueType(0);
    let mut EltVT: EVT = VT.getVectorElementType();
    let mut OrigEC: ElementCount = VT.getVectorElementCount();
    let mut Factor: u32 = N.getNumOperands();
    let mut DL: SDLoc = SDLoc { N };
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut WidenEC: ElementCount = WidenVT.getVectorElementCount();
    let mut WidenOps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { Factor };
    for let mut Idx: u32 = 0; Idx < Factor; Idx += 1 {
        WidenOps[Idx] = self.GetWidenedVector(N.getOperand(Idx));
    }
    let mut WidenVTs: SmallVector<EVT, 8> = SmallVector<EVT, 8> { Factor, WidenVT };
    let mut Interleaved: SDValue = self.DAG.getNode(VECTOR_INTERLEAVE, DL, ArrayRef<EVT> { WidenVTs }, ArrayRef<SDValue> { WidenOps });
    let mut PackedWidenVT: EVT = getVectorVT(*self.DAG.getContext(), EltVT, WidenEC * Factor);
    let mut Slices: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { Factor };
    for let mut Idx: u32 = 0; Idx != Factor; Idx += 1 {
        Slices[Idx] = Interleaved.getValue(Idx);
    }
    let mut Packed: SDValue = self.DAG.getNode(CONCAT_VECTORS, DL, PackedWidenVT, ArrayRef<SDValue> { Slices });
    for let mut Idx: u32 = 0; Idx < Factor; Idx += 1 {
        let mut Narrow: SDValue = self.DAG.getExtractSubvector(DL, VT, Packed, OrigEC.getKnownMinValue() * Idx);
        let mut Wide: SDValue = self.DAG.getInsertSubvector(DL, self.DAG.getPOISON(WidenVT), Narrow, 0);
        self.SetWidenedVector(SDValue { Node: N, ResNo: Idx }, Wide);
    }
}

fn DAGTypeLegalizer::WidenVecRes_VECTOR_MATCH(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut SourceVT: EVT = N.getOperand(0).getValueType();
    let mut WideSourceVT: EVT = getVectorVT(*self.DAG.getContext(), SourceVT.getVectorElementType(), WidenVT.getVectorElementCount());
    let mut WideSource: SDValue = self.DAG.getInsertSubvector(DL, self.DAG.getUNDEF(WideSourceVT), N.getOperand(0), 0);
    let mut WideMask: SDValue = self.DAG.getInsertSubvector(DL, self.DAG.getConstant(0, DL, WidenVT, false, false), N.getOperand(2), 0);
    return self.DAG.getNode(VECTOR_MATCH, DL, WidenVT, WideSource, N.getOperand(1), WideMask, N.getFlags());
}

fn DAGTypeLegalizer::WidenVecRes_VECTOR_DEINTERLEAVE(self, N: *mut SDNode) {
    let mut VT: EVT = N.getValueType(0);
    let mut EltVT: EVT = VT.getVectorElementType();
    let mut OrigEC: ElementCount = VT.getVectorElementCount();
    let mut Factor: u32 = N.getNumOperands();
    let mut DL: SDLoc = SDLoc { N };
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut WidenEC: ElementCount = WidenVT.getVectorElementCount();
    let mut PackedWidenVT: EVT = getVectorVT(*self.DAG.getContext(), EltVT, WidenEC * Factor);
    let mut ConcatVT: EVT = getVectorVT(*self.DAG.getContext(), EltVT, OrigEC * Factor);
    let mut ConcatOp: SDValue = self.DAG.getNode(CONCAT_VECTORS, DL, ConcatVT, N.ops());
    let mut PackedWidenVec: SDValue = self.DAG.getInsertSubvector(DL, self.DAG.getUNDEF(PackedWidenVT), ConcatOp, 0);
    let mut NewOps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { Factor, SDValue {} };
    for let mut Idx: u32 = 0; Idx < Factor; Idx += 1 {
        NewOps[Idx] = self.DAG.getExtractSubvector(DL, WidenVT, PackedWidenVec, WidenEC.getKnownMinValue() * Idx);
    }
    let mut NewVTs: SmallVector<EVT, 8> = SmallVector<EVT, 8> { Factor, WidenVT };
    let mut NewRes: SDValue = self.DAG.getNode(VECTOR_DEINTERLEAVE, DL, ArrayRef<EVT> { NewVTs }, ArrayRef<SDValue> { NewOps });
    for let mut Idx: u32 = 0; Idx < Factor; Idx += 1 {
        self.SetWidenedVector(SDValue { Node: N, ResNo: Idx }, NewRes.getValue(Idx));
    }
}

fn DAGTypeLegalizer::WidenVecRes_SETCC(self, N: *mut SDNode) -> SDValue {
    assert!(N.getValueType(0).isVector() && N.getOperand(0).getValueType().isVector(), "Operands must be vectors");
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut WidenEC: ElementCount = WidenVT.getVectorElementCount();
    let mut InOp1: SDValue = N.getOperand(0);
    let mut InVT: EVT = InOp1.getValueType();
    assert!(InVT.isVector(), "can not widen non-vector type");
    let mut WidenInVT: EVT = getVectorVT(*self.DAG.getContext(), InVT.getVectorElementType(), WidenEC);
    if self.getTypeAction(InVT) == TypeSplitVector {
        let mut SplitVSetCC: SDValue = self.SplitVecOp_VSETCC(N);
        let mut Res: SDValue = self.ModifyToType(SplitVSetCC, WidenVT, false);
        return Res;
    }
    let mut InOp2: SDValue = N.getOperand(1);
    if self.getTypeAction(InVT) == TypeWidenVector {
        InOp1 = self.GetWidenedVector(InOp1);
        InOp2 = self.GetWidenedVector(InOp2);
    } else {
        let mut Poison: SDValue = self.DAG.getPOISON(WidenInVT);
        let mut ZeroIdx: SDValue = self.DAG.getVectorIdxConstant(0, SDLoc { N }, false);
        InOp1 = self.DAG.getNode(INSERT_SUBVECTOR, SDLoc { N }, WidenInVT, Poison, InOp1, ZeroIdx);
        InOp2 = self.DAG.getNode(INSERT_SUBVECTOR, SDLoc { N }, WidenInVT, Poison, InOp2, ZeroIdx);
    }
    assert!(InOp1.getValueType() == WidenInVT && InOp2.getValueType() == WidenInVT, "Input not widened to expected type!");
    WidenInVT as void;
    return self.DAG.getNode(SETCC, SDLoc { N }, WidenVT, InOp1, InOp2, N.getOperand(2));
}

fn DAGTypeLegalizer::WidenVecRes_STRICT_FSETCC(self, N: *mut SDNode) -> SDValue {
    assert!(N.getValueType(0).isVector() && N.getOperand(1).getValueType().isVector(), "Operands must be vectors");
    let mut VT: EVT = N.getValueType(0);
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut WidenNumElts: u32 = WidenVT.getVectorNumElements();
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut EltVT: EVT = VT.getVectorElementType();
    let mut dl: SDLoc = SDLoc { N };
    let mut Chain: SDValue = N.getOperand(0);
    let mut LHS: SDValue = N.getOperand(1);
    let mut RHS: SDValue = N.getOperand(2);
    let mut CC: SDValue = N.getOperand(3);
    let mut TmpEltVT: EVT = LHS.getValueType().getVectorElementType();
    let mut Scalars: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { WidenNumElts, self.DAG.getPOISON(EltVT) };
    let mut Chains: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { NumElts };
    for let mut i: u32 = 0; i != NumElts; i += 1 {
        let mut LHSElem: SDValue = self.DAG.getExtractVectorElt(dl, TmpEltVT, LHS, i);
        let mut RHSElem: SDValue = self.DAG.getExtractVectorElt(dl, TmpEltVT, RHS, i);
        Scalars[i] = self.DAG.getNode(N.getOpcode(), dl, ArrayRef<EVT> { [EVT { i1 }, EVT { Other }] }, ArrayRef<SDValue> { [Chain, LHSElem, RHSElem, CC] });
        Chains[i] = Scalars[i].getValue(1);
        Scalars[i] = self.DAG.getSelect(dl, EltVT, Scalars[i], self.DAG.getBoolConstant(true, dl, EltVT, VT), self.DAG.getBoolConstant(false, dl, EltVT, VT), SDNodeFlags { Flags: None });
    }
    let mut NewChain: SDValue = self.DAG.getNode(TokenFactor, dl, EVT { Other }, ArrayRef<SDValue> { Chains });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, NewChain);
    return self.DAG.getBuildVector(WidenVT, dl, ArrayRef<SDValue> { Scalars });
}

fn DAGTypeLegalizer::WidenVecRes_PARTIAL_REDUCE_MLA(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    let mut Expanded: SDValue = self.TLI.expandPartialReduceMLA(N, self.DAG);
    let mut WideVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    return self.DAG.getInsertSubvector(DL, self.DAG.getPOISON(WideVT), Expanded, 0);
}

fn DAGTypeLegalizer::WidenVectorOperand(self, N: *mut SDNode, OpNo: u32) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalize-types", 1) {
            dbgs() << "Widen node operand " << OpNo << ": ";
            N.dump(&mut self.DAG);
        }
    }
        if !(false) { break; }
    }
    let mut Res: SDValue = SDValue {};
    if self.CustomLowerNode(N, N.getOperand(OpNo).getValueType(), false) {
        return false;
    }
    match N.getOpcode() {
        _ => {
            dbgs() << "WidenVectorOperand op #" << OpNo << ": ";
        },
        BITCAST => {
            Res = self.WidenVecOp_BITCAST(N);
        },
        FAKE_USE => {
            Res = self.WidenVecOp_FAKE_USE(N);
        },
        CONCAT_VECTORS => {
            Res = self.WidenVecOp_CONCAT_VECTORS(N);
        },
        VECTOR_REPEAT => {
            Res = self.WidenVecOp_VECTOR_REPEAT(N);
        },
        INSERT_SUBVECTOR => {
            Res = self.WidenVecOp_INSERT_SUBVECTOR(N);
        },
        EXTRACT_SUBVECTOR => {
            Res = self.WidenVecOp_EXTRACT_SUBVECTOR(N);
        },
        EXTRACT_VECTOR_ELT => {
            Res = self.WidenVecOp_EXTRACT_VECTOR_ELT(N);
        },
        STORE => {
            Res = self.WidenVecOp_STORE(N);
        },
        ATOMIC_STORE => {
            Res = self.WidenVecOp_ATOMIC_STORE(cast(N));
        },
        VP_STORE => {
            Res = self.WidenVecOp_VP_STORE(N, OpNo);
        },
        EXPERIMENTAL_VP_STRIDED_STORE => {
            Res = self.WidenVecOp_VP_STRIDED_STORE(N, OpNo);
        },
        ANY_EXTEND_VECTOR_INREG => {
            SIGN_EXTEND_VECTOR_INREG;
        },
        MSTORE => {
            Res = self.WidenVecOp_MSTORE(N, OpNo);
        },
        MGATHER => {
            Res = self.WidenVecOp_MGATHER(N, OpNo);
        },
        MSCATTER => {
            Res = self.WidenVecOp_MSCATTER(N, OpNo);
        },
        VP_SCATTER => {
            Res = self.WidenVecOp_VP_SCATTER(N, OpNo);
        },
        SETCC => {
            Res = self.WidenVecOp_SETCC(N);
        },
        STRICT_FSETCC => {
            STRICT_FSETCCS;
        },
        VSELECT => {
            Res = self.WidenVecOp_VSELECT(N);
        },
        FLDEXP => {
            FCOPYSIGN;
        },
        IS_FPCLASS => {
            Res = self.WidenVecOp_IS_FPCLASS(N);
        },
        ANY_EXTEND => {
            SIGN_EXTEND;
        },
        SCMP => {
            UCMP;
        },
        FP_EXTEND => {
            STRICT_FP_EXTEND;
        },
        FP_TO_SINT_SAT => {
            FP_TO_UINT_SAT;
        },
        VECREDUCE_FADD => {
            VECREDUCE_FMUL;
        },
        VECREDUCE_SEQ_FADD => {
            VECREDUCE_SEQ_FMUL;
        },
        VP_REDUCE_FADD => {
            VP_REDUCE_SEQ_FADD;
        },
        CTTZ_ELTS => {
            CTTZ_ELTS_ZERO_POISON;
        },
        VP_CTTZ_ELTS => {
            VP_CTTZ_ELTS_ZERO_POISON;
        },
        VECTOR_FIND_LAST_ACTIVE => {
            Res = self.WidenVecOp_VECTOR_FIND_LAST_ACTIVE(N);
        },
        VECTOR_MATCH => {
            Res = self.WidenVecOp_VECTOR_MATCH(N, OpNo);
        },
    }
    if !Res.getNode() {
        return false;
    }
    if Res.getNode() == N {
        return true;
    }
    if N.isStrictFPOpcode() {
        assert!(Res.getValueType() == N.getValueType(0) && N.getNumValues() == 2, "Invalid operand expansion");
    } else {
        assert!(Res.getValueType() == N.getValueType(0) && N.getNumValues() == 1, "Invalid operand expansion");
    }
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Res);
    return false;
}

fn DAGTypeLegalizer::WidenVecOp_EXTEND(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    let mut InOp: SDValue = N.getOperand(0);
    assert!(self.getTypeAction(InOp.getValueType()) == TypeWidenVector, "Unexpected type action");
    InOp = self.GetWidenedVector(InOp);
    assert!(VT.getVectorNumElements() < InOp.getValueType().getVectorNumElements(), "Input wasn't widened!");
    let mut InVT: EVT = InOp.getValueType();
    if InVT.getSizeInBits() != VT.getSizeInBits() {
        let mut InEltVT: EVT = InVT.getVectorElementType();
        for FixedVT in vector_valuetypes() {
            let mut FixedEltVT: EVT = FixedVT.getVectorElementType();
            if self.TLI.isTypeLegal(FixedVT) && FixedVT.getSizeInBits() == VT.getSizeInBits() && FixedEltVT == InEltVT {
                assert!(FixedVT.getVectorNumElements() >= VT.getVectorNumElements(), "Not enough elements in the fixed type for the operand!");
                assert!(FixedVT.getVectorNumElements() != InVT.getVectorNumElements(), "We can't have the same type as we started with!");
                if FixedVT.getVectorNumElements() > InVT.getVectorNumElements() {
                    InOp = self.DAG.getInsertSubvector(DL, self.DAG.getPOISON(FixedVT), InOp, 0);
                } else {
                    InOp = self.DAG.getExtractSubvector(DL, FixedVT, InOp, 0);
                }
                break;
            }
        }
        InVT = InOp.getValueType();
        if InVT.getSizeInBits() != VT.getSizeInBits() {
            return self.WidenVecOp_Convert(N);
        }
    }
    match N.getOpcode() {
        _ => {
            llvm_unreachable_internal("Extend legalization on extend operation!", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeVectorTypes.cpp", 8061);
        },
        ANY_EXTEND => {
            return self.DAG.getNode(ANY_EXTEND_VECTOR_INREG, DL, VT, InOp);
        },
        SIGN_EXTEND => {
            return self.DAG.getNode(SIGN_EXTEND_VECTOR_INREG, DL, VT, InOp);
        },
        ZERO_EXTEND => {
            return self.DAG.getNode(ZERO_EXTEND_VECTOR_INREG, DL, VT, InOp);
        },
    }
}

fn DAGTypeLegalizer::WidenVecOp_CMP(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut OpVT: EVT = N.getOperand(0).getValueType();
    let mut ResVT: EVT = N.getValueType(0);
    let mut LHS: SDValue = self.GetWidenedVector(N.getOperand(0));
    let mut RHS: SDValue = self.GetWidenedVector(N.getOperand(1));
    LHS = self.DAG.getExtractSubvector(dl, OpVT, LHS, 0);
    RHS = self.DAG.getExtractSubvector(dl, OpVT, RHS, 0);
    let mut ExtendOpcode: NodeType = if N.getOpcode() == SCMP { SIGN_EXTEND } else { ZERO_EXTEND };
    LHS = self.DAG.getNode(ExtendOpcode, dl, ResVT, LHS);
    RHS = self.DAG.getNode(ExtendOpcode, dl, ResVT, RHS);
    return self.DAG.getNode(N.getOpcode(), dl, ResVT, LHS, RHS);
}

fn DAGTypeLegalizer::WidenVecOp_UnrollVectorOp(self, N: *mut SDNode) -> SDValue {
    return self.DAG.UnrollVectorOp(N, 0);
}

fn DAGTypeLegalizer::WidenVecOp_IS_FPCLASS(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut ResultVT: EVT = N.getValueType(0);
    let mut Test: SDValue = N.getOperand(1);
    let mut WideArg: SDValue = self.GetWidenedVector(N.getOperand(0));
    let mut WideResultVT: EVT = self.getSetCCResultType(WideArg.getValueType());
    if ResultVT.getScalarType() == EVT { i1 } {
        WideResultVT = getVectorVT(*self.DAG.getContext(), EVT { i1 }, WideResultVT.getVectorNumElements(), false);
    }
    let mut WideNode: SDValue = self.DAG.getNode(IS_FPCLASS, DL, WideResultVT, ArrayRef<SDValue> { [WideArg, Test] }, N.getFlags());
    let mut ResVT: EVT = getVectorVT(*self.DAG.getContext(), WideResultVT.getVectorElementType(), ResultVT.getVectorNumElements(), false);
    let mut CC: SDValue = self.DAG.getExtractSubvector(DL, ResVT, WideNode, 0);
    let mut OpVT: EVT = N.getOperand(0).getValueType();
    let mut ExtendCode: NodeType = getExtendForContent(self.TLI.getBooleanContents(OpVT));
    return self.DAG.getNode(ExtendCode, DL, ResultVT, CC);
}

fn DAGTypeLegalizer::WidenVecOp_Convert(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut EltVT: EVT = VT.getVectorElementType();
    let mut dl: SDLoc = SDLoc { N };
    let mut InOp: SDValue = N.getOperand(if N.isStrictFPOpcode() { 1 } else { 0 });
    assert!(self.getTypeAction(InOp.getValueType()) == TypeWidenVector, "Unexpected type action");
    InOp = self.GetWidenedVector(InOp);
    let mut InVT: EVT = InOp.getValueType();
    let mut Opcode: u32 = N.getOpcode();
    let mut MakeConvertNode: Closure_14 = Closure_14 { Opcode: &mut Opcode, cap_1: self, dl: &mut dl, N: &mut N };
    let mut WideVT: EVT = getVectorVT(*self.DAG.getContext(), EltVT, InVT.getVectorElementCount());
    if self.TLI.isTypeLegal(WideVT) && !N.isStrictFPOpcode() {
        let mut Res: SDValue = SDValue {};
        if N.isStrictFPOpcode() {
            if Opcode == STRICT_FP_ROUND {
                Res = self.DAG.getNode(Opcode, dl, ArrayRef<EVT> { [WideVT, EVT { Other }] }, ArrayRef<SDValue> { [N.getOperand(0), InOp, N.getOperand(2)] });
            } else {
                Res = self.DAG.getNode(Opcode, dl, ArrayRef<EVT> { [WideVT, EVT { Other }] }, ArrayRef<SDValue> { [N.getOperand(0), InOp] });
            }
            self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
        } else {
            Res = MakeConvertNode.call(WideVT, InOp);
        }
        return self.DAG.getExtractSubvector(dl, VT, Res, 0);
    }
    let mut InEltVT: EVT = InVT.getVectorElementType();
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { NumElts };
    if N.isStrictFPOpcode() {
        let mut NewOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { N.ops() };
        let mut OpChains: SmallVector<SDValue, 32> = SmallVector<SDValue, 32> {};
        for let mut i: u32 = 0; i < NumElts; i += 1 {
            NewOps[1] = self.DAG.getExtractVectorElt(dl, InEltVT, InOp, i);
            Ops[i] = self.DAG.getNode(Opcode, dl, ArrayRef<EVT> { [EltVT, EVT { Other }] }, ArrayRef<SDValue> { NewOps });
            OpChains.push(Ops[i].getValue(1));
        }
        let mut NewChain: SDValue = self.DAG.getNode(TokenFactor, dl, EVT { Other }, ArrayRef<SDValue> { OpChains });
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, NewChain);
    } else {
        for let mut i: u32 = 0; i < NumElts; i += 1 {
            let mut Elt: SDValue = self.DAG.getExtractVectorElt(dl, InEltVT, InOp, i);
            Ops[i] = MakeConvertNode.call(EltVT, Elt);
        }
    }
    return self.DAG.getBuildVector(VT, dl, ArrayRef<SDValue> { Ops });
}

fn DAGTypeLegalizer::WidenVecOp_FP_TO_XINT_SAT(self, N: *mut SDNode) -> SDValue {
    let mut DstVT: EVT = N.getValueType(0);
    let mut Src: SDValue = self.GetWidenedVector(N.getOperand(0));
    let mut SrcVT: EVT = Src.getValueType();
    let mut WideNumElts: ElementCount = SrcVT.getVectorElementCount();
    let mut dl: SDLoc = SDLoc { N };
    let mut WideDstVT: EVT = getVectorVT(*self.DAG.getContext(), DstVT.getVectorElementType(), WideNumElts);
    if self.TLI.isTypeLegal(WideDstVT) {
        let mut Res: SDValue = self.DAG.getNode(N.getOpcode(), dl, WideDstVT, Src, N.getOperand(1));
        return self.DAG.getNode(EXTRACT_SUBVECTOR, dl, DstVT, Res, self.DAG.getConstant(0, dl, EVT { self.TLI.getVectorIdxTy(self.DAG.getDataLayout()) }, false, false));
    }
    return self.DAG.UnrollVectorOp(N, 0);
}

fn DAGTypeLegalizer::WidenVecOp_BITCAST(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut InOp: SDValue = self.GetWidenedVector(N.getOperand(0));
    let mut InWidenVT: EVT = InOp.getValueType();
    let mut dl: SDLoc = SDLoc { N };
    let mut InWidenSize: TypeSize = InWidenVT.getSizeInBits();
    let mut Size: TypeSize = VT.getSizeInBits();
    if !VT.isVector() && VT != EVT { x86mmx } && InWidenSize.hasKnownScalarFactor(Size) {
        let mut NewNumElts: u32 = InWidenSize.getKnownScalarFactor(Size);
        let mut NewVT: EVT = getVectorVT(*self.DAG.getContext(), VT, NewNumElts, false);
        if self.TLI.isTypeLegal(NewVT) {
            let mut BitOp: SDValue = self.DAG.getNode(BITCAST, dl, NewVT, InOp);
            return self.DAG.getExtractVectorElt(dl, VT, BitOp, 0);
        }
    }
    if VT.isVector() {
        let mut EltVT: EVT = VT.getVectorElementType();
        let mut EltSize: u32 = EltVT.getFixedSizeInBits();
        if InWidenSize.isKnownMultipleOf(EltSize) {
            let mut NewNumElts: ElementCount = (InWidenVT.getVectorElementCount() * InWidenVT.getScalarSizeInBits()).divideCoefficientBy(EltSize);
            let mut NewVT: EVT = getVectorVT(*self.DAG.getContext(), EltVT, NewNumElts);
            if self.TLI.isTypeLegal(NewVT) {
                let mut BitOp: SDValue = self.DAG.getNode(BITCAST, dl, NewVT, InOp);
                return self.DAG.getExtractSubvector(dl, VT, BitOp, 0);
            }
        }
    }
    return self.CreateStackStoreLoad(InOp, VT);
}

fn DAGTypeLegalizer::WidenVecOp_FAKE_USE(self, N: *mut SDNode) -> SDValue {
    let mut WidenedOp: SDValue = self.GetWidenedVector(N.getOperand(1));
    return self.DAG.getNode(FAKE_USE, SDLoc {}, EVT { Other }, N.getOperand(0), WidenedOp);
}

fn DAGTypeLegalizer::WidenVecOp_CONCAT_VECTORS(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut EltVT: EVT = VT.getVectorElementType();
    let mut InVT: EVT = N.getOperand(0).getValueType();
    let mut dl: SDLoc = SDLoc { N };
    let mut NumOperands: u32 = N.getNumOperands();
    if VT == self.TLI.getTypeToTransformTo(*self.DAG.getContext(), InVT) {
        let mut i: u32 = 0;
        for i = 1; i < NumOperands; i += 1 {
            if !N.getOperand(i).isUndef() {
                break;
            }
        }
        if i == NumOperands {
            return self.GetWidenedVector(N.getOperand(0));
        }
    }
    if VT.isScalableVector() {
        let mut Result: SDValue = self.DAG.getPOISON(VT);
        let mut NumInElts: u32 = InVT.getVectorMinNumElements();
        for let mut i: u32 = 0; i < NumOperands; i += 1 {
            let mut InOp: SDValue = self.GetWidenedVector(N.getOperand(i));
            if InOp.getValueType() != InVT {
                InOp = self.DAG.getExtractSubvector(dl, InVT, InOp, 0);
            }
            Result = self.DAG.getInsertSubvector(dl, Result, InOp, i * NumInElts);
        }
        return Result;
    }
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { NumElts };
    let mut NumInElts: u32 = InVT.getVectorNumElements();
    let mut Idx: u32 = 0;
    for let mut i: u32 = 0; i < NumOperands; i += 1 {
        let mut InOp: SDValue = N.getOperand(i);
        assert!(self.getTypeAction(InOp.getValueType()) == TypeWidenVector, "Unexpected type action");
        InOp = self.GetWidenedVector(InOp);
        for let mut j: u32 = 0; j < NumInElts; j += 1 {
            Ops[Idx += 1] = self.DAG.getExtractVectorElt(dl, EltVT, InOp, j);
        }
    }
    return self.DAG.getBuildVector(VT, dl, ArrayRef<SDValue> { Ops });
}

fn DAGTypeLegalizer::WidenVecOp_VECTOR_REPEAT(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    let mut Src: SDValue = N.getOperand(0);
    let mut SrcVT: EVT = Src.getValueType();
    let mut WidenedSrcVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), SrcVT);
    if !WidenedSrcVT.getVectorElementCount().hasKnownScalarFactor(SrcVT.getVectorElementCount()) {
        report_fatal_error("Cannot widen VECTOR_REPEAT operand to an ElementCount that's not a known scalar multiple of the input ElementCount.", true);
    }
    let mut NumConcat: u32 = WidenedSrcVT.getVectorNumElements() / SrcVT.getVectorNumElements();
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { NumConcat, Src };
    let mut WidenedSrc: SDValue = self.DAG.getNode(CONCAT_VECTORS, DL, WidenedSrcVT, ArrayRef<SDValue> { Ops });
    let mut WidenedVT: EVT = VT.changeVectorElementCount(*self.DAG.getContext(), getScalable(WidenedSrcVT.getVectorNumElements()));
    let mut Widened: SDValue = self.DAG.getNode(VECTOR_REPEAT, DL, WidenedVT, WidenedSrc);
    return self.DAG.getExtractSubvector(DL, VT, Widened, 0);
}

fn DAGTypeLegalizer::WidenVecOp_INSERT_SUBVECTOR(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut SubVec: SDValue = N.getOperand(1);
    let mut InVec: SDValue = N.getOperand(0);
    let mut OrigVT: EVT = SubVec.getValueType();
    SubVec = self.GetWidenedVector(SubVec);
    let mut SubVT: EVT = SubVec.getValueType();
    let mut IndicesValid: bool = false;
    if VT.knownBitsGE(SubVT) {
        IndicesValid = true;
    } else if VT.isScalableVector() && SubVT.isFixedLengthVector() {
        let mut Attr: Attribute = self.DAG.getMachineFunction().getFunction().getFnAttribute(VScaleRange);
        if Attr.isValid() {
            let mut VScaleMin: u32 = Attr.getVScaleRangeMin();
            if VT.getSizeInBits().getKnownMinValue() * VScaleMin >= SubVT.getFixedSizeInBits() {
                IndicesValid = true;
            }
        }
    }
    if !IndicesValid {
        report_fatal_error("Don't know how to widen the operands for INSERT_SUBVECTOR", true);
    }
    let mut DL: SDLoc = SDLoc { N };
    if InVec.isUndef() && N.getConstantOperandVal(2) == 0 {
        return self.DAG.getNode(INSERT_SUBVECTOR, DL, VT, InVec, SubVec, N.getOperand(2));
    }
    if OrigVT.isScalableVector() {
        if SubVT == VT && N.getConstantOperandVal(2) == 0 {
            let mut Mask: SDValue = self.DAG.getMaskFromElementCount(DL, VT, OrigVT.getVectorElementCount());
            return self.DAG.getNode(VSELECT, DL, VT, Mask, SubVec, InVec);
        }
        let mut Alignment: Align = self.DAG.getReducedAlign(VT, false);
        let mut StackPtr: SDValue = self.DAG.CreateStackTemporary(VT.getStoreSize(), Alignment);
        let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
        let mut FrameIndex: i32 = cast(StackPtr.getNode()).getIndex();
        let mut PtrInfo: MachinePointerInfo = getFixedStack(MF, FrameIndex, 0);
        let mut StoreMMO: *mut MachineMemOperand = MF.getMachineMemOperand(PtrInfo, MOStore, beforeOrAfterPointer(), Alignment, MMOMetadata {}, System, NotAtomic, NotAtomic);
        let mut LoadMMO: *mut MachineMemOperand = MF.getMachineMemOperand(PtrInfo, MOLoad, beforeOrAfterPointer(), Alignment, MMOMetadata {}, System, NotAtomic, NotAtomic);
        let mut Ch: SDValue = self.DAG.getStore(self.DAG.getEntryNode(), DL, InVec, StackPtr, StoreMMO);
        let mut Mask: SDValue = self.DAG.getMaskFromElementCount(DL, SubVT, OrigVT.getVectorElementCount());
        let mut SubVecPtr: SDValue = self.TLI.getVectorSubVecPointer(self.DAG, StackPtr, VT, OrigVT, N.getOperand(2), SDNodeFlags { Flags: None });
        Ch = self.DAG.getMaskedStore(Ch, DL, SubVec, SubVecPtr, self.DAG.getPOISON(SubVecPtr.getValueType()), Mask, VT, StoreMMO, UNINDEXED, NON_EXTLOAD, false);
        return self.DAG.getLoad(VT, DL, Ch, StackPtr, LoadMMO);
    }
    let mut Idx: u32 = N.getConstantOperandVal(2);
    let mut InsertElt: SDValue = InVec;
    for let mut I: u32 = 0;
let mut E: u32 = OrigVT.getVectorNumElements(); I != E; I += 1 {
        let mut ExtractElt: SDValue = self.DAG.getExtractVectorElt(DL, VT.getVectorElementType(), SubVec, I);
        InsertElt = self.DAG.getInsertVectorElt(DL, InsertElt, ExtractElt, I + Idx);
    }
    return InsertElt;
}

fn DAGTypeLegalizer::WidenVecOp_EXTRACT_SUBVECTOR(self, N: *mut SDNode) -> SDValue {
    let mut InOp: SDValue = self.GetWidenedVector(N.getOperand(0));
    return self.DAG.getNode(EXTRACT_SUBVECTOR, SDLoc { N }, N.getValueType(0), InOp, N.getOperand(1));
}

fn DAGTypeLegalizer::WidenVecOp_EXTRACT_VECTOR_ELT(self, N: *mut SDNode) -> SDValue {
    let mut InOp: SDValue = self.GetWidenedVector(N.getOperand(0));
    return self.DAG.getNode(EXTRACT_VECTOR_ELT, SDLoc { N }, N.getValueType(0), InOp, N.getOperand(1));
}

fn DAGTypeLegalizer::WidenVecOp_EXTEND_VECTOR_INREG(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut ResVT: EVT = N.getValueType(0);
    let mut WideInOp: SDValue = self.GetWidenedVector(N.getOperand(0));
    let mut WideInVT: EVT = WideInOp.getValueType();
    if WideInVT.getSizeInBits().operator unsigned long long() <= ResVT.getSizeInBits().operator unsigned long long() {
        return self.DAG.getNode(N.getOpcode(), DL, ResVT, WideInOp);
    }
    let mut ResEltVT: EVT = ResVT.getVectorElementType();
    let mut EltBits: u32 = ResEltVT.getSizeInBits().operator unsigned long long();
    assert!((WideInVT.getSizeInBits().operator unsigned long long() % EltBits) == 0, "Widened input size must be a multiple of result element size");
    let mut WideNumElts: u32 = WideInVT.getSizeInBits().operator unsigned long long() / EltBits;
    let mut WideResVT: EVT = getVectorVT(*self.DAG.getContext(), ResEltVT, WideNumElts, false);
    let mut WideRes: SDValue = self.DAG.getNode(N.getOpcode(), DL, WideResVT, WideInOp);
    return self.DAG.getExtractSubvector(DL, ResVT, WideRes, 0);
}

fn DAGTypeLegalizer::WidenVecOp_STORE(self, N: *mut SDNode) -> SDValue {
    let mut ST: *mut StoreSDNode = cast(N);
    if !ST.getMemoryVT().getScalarType().isByteSized() {
        return self.TLI.scalarizeVectorStore(ST, self.DAG);
    }
    if ST.isTruncatingStore() {
        return self.TLI.scalarizeVectorStore(ST, self.DAG);
    }
    let mut StVal: SDValue = ST.getValue();
    let mut StVT: EVT = StVal.getValueType();
    let mut WideVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), StVT);
    let mut WideMaskVT: EVT = self.getSetCCResultType(WideVT);
    if self.TLI.isOperationLegalOrCustom(VP_STORE, WideVT, false) && self.TLI.isTypeLegal(WideMaskVT) {
        let mut DL: SDLoc = SDLoc { N };
        StVal = self.GetWidenedVector(StVal);
        let mut Mask: SDValue = self.DAG.getAllOnesConstant(DL, WideMaskVT, false, false);
        let mut EVL: SDValue = self.DAG.getElementCount(DL, EVT { self.TLI.getVPExplicitVectorLengthTy() }, StVT.getVectorElementCount());
        return self.DAG.getStoreVP(ST.getChain(), DL, StVal, ST.getBasePtr(), ST.getOffset(), Mask, EVL, StVT, ST.getMemOperand(), ST.getAddressingMode(), false, false);
    }
    let mut StChain: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    if self.GenWidenVectorStores(StChain, ST) {
        if StChain.len == 1 {
            return StChain[0];
        }
        return self.DAG.getNode(TokenFactor, SDLoc { ST }, EVT { Other }, ArrayRef<SDValue> { StChain });
    }
    if StVT.isVector() {
        let mut DL: SDLoc = SDLoc { N };
        let mut WideStVal: SDValue = self.GetWidenedVector(StVal);
        let mut Mask: SDValue = self.DAG.getMaskFromElementCount(DL, WideVT, StVT.getVectorElementCount());
        return self.DAG.getMaskedStore(ST.getChain(), DL, WideStVal, ST.getBasePtr(), ST.getOffset(), Mask, ST.getMemoryVT(), ST.getMemOperand(), ST.getAddressingMode(), ST.isTruncatingStore(), false);
    }
    report_fatal_error("Unable to widen vector store", true);
}

fn DAGTypeLegalizer::WidenVecOp_ATOMIC_STORE(self, ST: *mut AtomicSDNode) -> SDValue {
    let mut StVT: EVT = ST.getMemoryVT();
    let mut dl: SDLoc = SDLoc { ST };
    let mut StVal: SDValue = self.GetWidenedVector(ST.getVal());
    let mut WidenVT: EVT = StVal.getValueType();
    let mut StWidth: TypeSize = StVT.getSizeInBits();
    let mut WidenWidth: TypeSize = WidenVT.getSizeInBits();
    let mut WidthDiff: TypeSize = WidenWidth - StWidth;
    let mut FirstVT: optional<EVT> = findMemType(self.DAG, self.TLI, StWidth.getKnownMinValue(), WidenVT, 0, WidthDiff.getKnownMinValue());
    if !FirstVT {
        return SDValue {};
    }
    let mut FirstVTWidth: TypeSize = operator(FirstVT).getSizeInBits();
    let mut StOp: SDValue = coerceStoredValue(StVal, operator(FirstVT), WidenVT, FirstVTWidth, dl, self.DAG);
    return self.DAG.getAtomic(ATOMIC_STORE, dl, operator(FirstVT), ST.getChain(), StOp, ST.getBasePtr(), ST.getMemOperand());
}

fn DAGTypeLegalizer::WidenVecOp_VP_STORE(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!((OpNo == 1 || OpNo == 3), "Can widen only data or mask operand of vp_store");
    let mut ST: *mut VPStoreSDNode = cast(N);
    let mut Mask: SDValue = ST.getMask();
    let mut StVal: SDValue = ST.getValue();
    let mut dl: SDLoc = SDLoc { N };
    if OpNo == 1 {
        StVal = self.GetWidenedVector(StVal);
        assert!(self.getTypeAction(Mask.getValueType()) == TypeWidenVector, "Unable to widen VP store");
        Mask = self.GetWidenedVector(Mask);
    } else {
        Mask = self.GetWidenedVector(Mask);
        assert!(self.getTypeAction(StVal.getValueType()) == TypeWidenVector, "Unable to widen VP store");
        StVal = self.GetWidenedVector(StVal);
    }
    assert!(Mask.getValueType().getVectorElementCount() == StVal.getValueType().getVectorElementCount(), "Mask and data vectors should have the same number of elements");
    return self.DAG.getStoreVP(ST.getChain(), dl, StVal, ST.getBasePtr(), ST.getOffset(), Mask, ST.getVectorLength(), ST.getMemoryVT(), ST.getMemOperand(), ST.getAddressingMode(), ST.isTruncatingStore(), ST.isCompressingStore());
}

fn DAGTypeLegalizer::WidenVecOp_VP_STRIDED_STORE(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!((OpNo == 1 || OpNo == 4), "Can widen only data or mask operand of vp_strided_store");
    let mut SST: *mut VPStridedStoreSDNode = cast(N);
    let mut Mask: SDValue = SST.getMask();
    let mut StVal: SDValue = SST.getValue();
    let mut DL: SDLoc = SDLoc { N };
    if OpNo == 1 {
        assert!(self.getTypeAction(Mask.getValueType()) == TypeWidenVector, "Unable to widen VP strided store");
    } else {
        assert!(self.getTypeAction(StVal.getValueType()) == TypeWidenVector, "Unable to widen VP strided store");
    }
    StVal = self.GetWidenedVector(StVal);
    Mask = self.GetWidenedVector(Mask);
    assert!(StVal.getValueType().getVectorElementCount() == Mask.getValueType().getVectorElementCount(), "Data and mask vectors should have the same number of elements");
    return self.DAG.getStridedStoreVP(SST.getChain(), DL, StVal, SST.getBasePtr(), SST.getOffset(), SST.getStride(), Mask, SST.getVectorLength(), SST.getMemoryVT(), SST.getMemOperand(), SST.getAddressingMode(), SST.isTruncatingStore(), SST.isCompressingStore());
}

fn DAGTypeLegalizer::WidenVecOp_MSTORE(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!((OpNo == 1 || OpNo == 4), "Can widen only data or mask operand of mstore");
    let mut MST: *mut MaskedStoreSDNode = cast(N);
    let mut Mask: SDValue = MST.getMask();
    let mut MaskVT: EVT = Mask.getValueType();
    let mut StVal: SDValue = MST.getValue();
    let mut VT: EVT = StVal.getValueType();
    let mut dl: SDLoc = SDLoc { N };
    let mut WideVT: EVT = EVT {};
    let mut WideMaskVT: EVT = EVT {};
    if OpNo == 1 {
        StVal = self.GetWidenedVector(StVal);
        WideVT = StVal.getValueType();
        WideMaskVT = getVectorVT(*self.DAG.getContext(), MaskVT.getVectorElementType(), WideVT.getVectorElementCount());
    } else {
        WideMaskVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), MaskVT);
        let mut ValueVT: EVT = StVal.getValueType();
        WideVT = getVectorVT(*self.DAG.getContext(), ValueVT.getVectorElementType(), WideMaskVT.getVectorElementCount());
    }
    if self.TLI.isOperationLegalOrCustom(VP_STORE, WideVT, false) && self.TLI.isTypeLegal(WideMaskVT) && !MST.isCompressingStore() {
        Mask = self.DAG.getInsertSubvector(dl, self.DAG.getPOISON(WideMaskVT), Mask, 0);
        let mut EVL: SDValue = self.DAG.getElementCount(dl, EVT { self.TLI.getVPExplicitVectorLengthTy() }, VT.getVectorElementCount());
        return self.DAG.getStoreVP(MST.getChain(), dl, StVal, MST.getBasePtr(), MST.getOffset(), Mask, EVL, MST.getMemoryVT(), MST.getMemOperand(), MST.getAddressingMode(), false, false);
    }
    if OpNo == 1 {
        Mask = self.ModifyToType(Mask, WideMaskVT, true);
    } else {
        Mask = self.ModifyToType(Mask, WideMaskVT, true);
        StVal = self.ModifyToType(StVal, WideVT, false);
    }
    assert!(Mask.getValueType().getVectorElementCount() == StVal.getValueType().getVectorElementCount(), "Mask and data vectors should have the same number of elements");
    return self.DAG.getMaskedStore(MST.getChain(), dl, StVal, MST.getBasePtr(), MST.getOffset(), Mask, MST.getMemoryVT(), MST.getMemOperand(), MST.getAddressingMode(), false, MST.isCompressingStore());
}

fn DAGTypeLegalizer::WidenVecOp_MGATHER(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 4, "Can widen only the index of mgather");
    let mut MG: *mut MaskedGatherSDNode = cast(N);
    let mut DataOp: SDValue = MG.getPassThru();
    let mut Mask: SDValue = MG.getMask();
    let mut Scale: SDValue = MG.getScale();
    let mut Index: SDValue = self.GetWidenedVector(MG.getIndex());
    let mut dl: SDLoc = SDLoc { N };
    let mut Ops: [6]SDValue = [MG.getChain(), DataOp, Mask, MG.getBasePtr(), Index, Scale];
    let mut Res: SDValue = self.DAG.getMaskedGather(MG.getVTList(), MG.getMemoryVT(), dl, ArrayRef<SDValue> { Ops }, MG.getMemOperand(), MG.getIndexType(), MG.getExtensionType());
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Res.getValue(0));
    return SDValue {};
}

fn DAGTypeLegalizer::WidenVecOp_MSCATTER(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    let mut MSC: *mut MaskedScatterSDNode = cast(N);
    let mut DataOp: SDValue = MSC.getValue();
    let mut Mask: SDValue = MSC.getMask();
    let mut Index: SDValue = MSC.getIndex();
    let mut Scale: SDValue = MSC.getScale();
    let mut WideMemVT: EVT = MSC.getMemoryVT();
    if OpNo == 1 {
        DataOp = self.GetWidenedVector(DataOp);
        let mut WideEC: ElementCount = DataOp.getValueType().getVectorElementCount();
        let mut IndexVT: EVT = Index.getValueType();
        let mut WideIndexVT: EVT = getVectorVT(*self.DAG.getContext(), IndexVT.getVectorElementType(), WideEC);
        Index = self.ModifyToType(Index, WideIndexVT, false);
        let mut MaskVT: EVT = Mask.getValueType();
        let mut WideMaskVT: EVT = getVectorVT(*self.DAG.getContext(), MaskVT.getVectorElementType(), WideEC);
        Mask = self.ModifyToType(Mask, WideMaskVT, true);
        WideMemVT = getVectorVT(*self.DAG.getContext(), MSC.getMemoryVT().getScalarType(), WideEC);
    } else if OpNo == 4 {
        Index = self.GetWidenedVector(Index);
    } else {
        llvm_unreachable_internal("Can't widen this operand of mscatter", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeVectorTypes.cpp", 8753);
    }
    let mut Ops: [6]SDValue = [MSC.getChain(), DataOp, Mask, MSC.getBasePtr(), Index, Scale];
    return self.DAG.getMaskedScatter(self.DAG.getVTList(EVT { Other }), WideMemVT, SDLoc { N }, ArrayRef<SDValue> { Ops }, MSC.getMemOperand(), MSC.getIndexType(), MSC.isTruncatingStore());
}

fn DAGTypeLegalizer::WidenVecOp_VP_SCATTER(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    let mut VPSC: *mut VPScatterSDNode = cast(N);
    let mut DataOp: SDValue = VPSC.getValue();
    let mut Mask: SDValue = VPSC.getMask();
    let mut Index: SDValue = VPSC.getIndex();
    let mut Scale: SDValue = VPSC.getScale();
    let mut WideMemVT: EVT = VPSC.getMemoryVT();
    if OpNo == 1 {
        DataOp = self.GetWidenedVector(DataOp);
        Index = self.GetWidenedVector(Index);
        let mut WideEC: ElementCount = DataOp.getValueType().getVectorElementCount();
        Mask = self.GetWidenedMask(Mask, WideEC);
        WideMemVT = getVectorVT(*self.DAG.getContext(), VPSC.getMemoryVT().getScalarType(), WideEC);
    } else if OpNo == 3 {
        Index = self.GetWidenedVector(Index);
    } else {
        llvm_unreachable_internal("Can't widen this operand of VP_SCATTER", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeVectorTypes.cpp", 8781);
    }
    let mut Ops: [7]SDValue = [VPSC.getChain(), DataOp, VPSC.getBasePtr(), Index, Scale, Mask, VPSC.getVectorLength()];
    return self.DAG.getScatterVP(self.DAG.getVTList(EVT { Other }), WideMemVT, SDLoc { N }, ArrayRef<SDValue> { Ops }, VPSC.getMemOperand(), VPSC.getIndexType());
}

fn DAGTypeLegalizer::WidenVecOp_SETCC(self, N: *mut SDNode) -> SDValue {
    let mut InOp0: SDValue = self.GetWidenedVector(N.getOperand(0));
    let mut InOp1: SDValue = self.GetWidenedVector(N.getOperand(1));
    let mut dl: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    let mut SVT: EVT = self.getSetCCResultType(InOp0.getValueType());
    if VT.getScalarType() == EVT { i1 } {
        SVT = getVectorVT(*self.DAG.getContext(), EVT { i1 }, SVT.getVectorElementCount());
    }
    let mut WideSETCC: SDValue = self.DAG.getNode(SETCC, SDLoc { N }, SVT, InOp0, InOp1, N.getOperand(2));
    let mut ResVT: EVT = getVectorVT(*self.DAG.getContext(), SVT.getVectorElementType(), VT.getVectorElementCount());
    let mut CC: SDValue = self.DAG.getExtractSubvector(dl, ResVT, WideSETCC, 0);
    let mut OpVT: EVT = N.getOperand(0).getValueType();
    let mut ExtendCode: NodeType = getExtendForContent(self.TLI.getBooleanContents(OpVT));
    return self.DAG.getNode(ExtendCode, dl, VT, CC);
}

fn DAGTypeLegalizer::WidenVecOp_STRICT_FSETCC(self, N: *mut SDNode) -> SDValue {
    let mut Chain: SDValue = N.getOperand(0);
    let mut LHS: SDValue = self.GetWidenedVector(N.getOperand(1));
    let mut RHS: SDValue = self.GetWidenedVector(N.getOperand(2));
    let mut CC: SDValue = N.getOperand(3);
    let mut dl: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    let mut EltVT: EVT = VT.getVectorElementType();
    let mut TmpEltVT: EVT = LHS.getValueType().getVectorElementType();
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut Scalars: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { NumElts };
    let mut Chains: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { NumElts };
    for let mut i: u32 = 0; i != NumElts; i += 1 {
        let mut LHSElem: SDValue = self.DAG.getExtractVectorElt(dl, TmpEltVT, LHS, i);
        let mut RHSElem: SDValue = self.DAG.getExtractVectorElt(dl, TmpEltVT, RHS, i);
        Scalars[i] = self.DAG.getNode(N.getOpcode(), dl, ArrayRef<EVT> { [EVT { i1 }, EVT { Other }] }, ArrayRef<SDValue> { [Chain, LHSElem, RHSElem, CC] });
        Chains[i] = Scalars[i].getValue(1);
        Scalars[i] = self.DAG.getSelect(dl, EltVT, Scalars[i], self.DAG.getBoolConstant(true, dl, EltVT, VT), self.DAG.getBoolConstant(false, dl, EltVT, VT), SDNodeFlags { Flags: None });
    }
    let mut NewChain: SDValue = self.DAG.getNode(TokenFactor, dl, EVT { Other }, ArrayRef<SDValue> { Chains });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, NewChain);
    return self.DAG.getBuildVector(VT, dl, ArrayRef<SDValue> { Scalars });
}

fn getExtendForIntVecReduction(Opc: u32) -> u32 {
    match Opc {
        _ => {
            llvm_unreachable_internal("Expected integer vector reduction", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeVectorTypes.cpp", 8860);
        },
        VECREDUCE_ADD => {
            VECREDUCE_MUL;
        },
        VECREDUCE_SMAX => {
            VECREDUCE_SMIN;
        },
        VECREDUCE_UMAX => {
            VECREDUCE_UMIN;
        },
    }
}

fn DAGTypeLegalizer::WidenVecOp_VECREDUCE(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut Op: SDValue = self.GetWidenedVector(N.getOperand(0));
    let mut VT: EVT = N.getValueType(0);
    let mut OrigVT: EVT = N.getOperand(0).getValueType();
    let mut WideVT: EVT = Op.getValueType();
    let mut ElemVT: EVT = OrigVT.getVectorElementType();
    let mut Flags: SDNodeFlags = N.getFlags();
    let mut Opc: u32 = N.getOpcode();
    let mut BaseOpc: u32 = getVecReduceBaseOpcode(Opc);
    let mut NeutralElem: SDValue = self.DAG.getIdentityElement(BaseOpc, dl, ElemVT, Flags);
    assert!(NeutralElem, "Neutral element must exist");
    let mut OrigElts: u32 = OrigVT.getVectorMinNumElements();
    let mut WideElts: u32 = WideVT.getVectorMinNumElements();
    let mut VPOpcode: optional<unsigned int> = getVPForBaseOpcode(Opc);
    if VPOpcode && self.TLI.isOperationLegalOrCustom(operator(VPOpcode), WideVT, false) {
        let mut Start: SDValue = NeutralElem;
        if VT.isInteger() {
            Start = self.DAG.getNode(getExtendForIntVecReduction(Opc), dl, VT, Start);
        }
        assert!(Start.getValueType() == VT);
        let mut WideMaskVT: EVT = getVectorVT(*self.DAG.getContext(), EVT { i1 }, WideVT.getVectorElementCount());
        let mut Mask: SDValue = self.DAG.getAllOnesConstant(dl, WideMaskVT, false, false);
        let mut EVL: SDValue = self.DAG.getElementCount(dl, EVT { self.TLI.getVPExplicitVectorLengthTy() }, OrigVT.getVectorElementCount());
        return self.DAG.getNode(operator(VPOpcode), dl, VT, ArrayRef<SDValue> { [Start, Op, Mask, EVL] }, Flags);
    }
    if WideVT.isScalableVector() {
        let mut GCD: u32 = gcd(OrigElts, WideElts);
        let mut SplatVT: EVT = getVectorVT(*self.DAG.getContext(), ElemVT, getScalable(GCD));
        let mut SplatNeutral: SDValue = self.DAG.getSplatVector(SplatVT, dl, NeutralElem);
        for let mut Idx: u32 = OrigElts; Idx < WideElts; Idx = Idx + GCD {
            Op = self.DAG.getInsertSubvector(dl, Op, SplatNeutral, Idx);
        }
        return self.DAG.getNode(Opc, dl, VT, Op, Flags);
    }
    for let mut Idx: u32 = OrigElts; Idx < WideElts; Idx += 1 {
        Op = self.DAG.getInsertVectorElt(dl, Op, NeutralElem, Idx);
    }
    return self.DAG.getNode(Opc, dl, VT, Op, Flags);
}

fn DAGTypeLegalizer::WidenVecOp_VECREDUCE_SEQ(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut AccOp: SDValue = N.getOperand(0);
    let mut VecOp: SDValue = N.getOperand(1);
    let mut Op: SDValue = self.GetWidenedVector(VecOp);
    let mut VT: EVT = N.getValueType(0);
    let mut OrigVT: EVT = VecOp.getValueType();
    let mut WideVT: EVT = Op.getValueType();
    let mut ElemVT: EVT = OrigVT.getVectorElementType();
    let mut Flags: SDNodeFlags = N.getFlags();
    let mut Opc: u32 = N.getOpcode();
    let mut BaseOpc: u32 = getVecReduceBaseOpcode(Opc);
    let mut NeutralElem: SDValue = self.DAG.getIdentityElement(BaseOpc, dl, ElemVT, Flags);
    let mut OrigElts: u32 = OrigVT.getVectorMinNumElements();
    let mut WideElts: u32 = WideVT.getVectorMinNumElements();
    let mut VPOpcode: optional<unsigned int> = getVPForBaseOpcode(Opc);
    if VPOpcode && self.TLI.isOperationLegalOrCustom(operator(VPOpcode), WideVT, false) {
        let mut WideMaskVT: EVT = getVectorVT(*self.DAG.getContext(), EVT { i1 }, WideVT.getVectorElementCount());
        let mut Mask: SDValue = self.DAG.getAllOnesConstant(dl, WideMaskVT, false, false);
        let mut EVL: SDValue = self.DAG.getElementCount(dl, EVT { self.TLI.getVPExplicitVectorLengthTy() }, OrigVT.getVectorElementCount());
        return self.DAG.getNode(operator(VPOpcode), dl, VT, ArrayRef<SDValue> { [AccOp, Op, Mask, EVL] }, Flags);
    }
    if WideVT.isScalableVector() {
        let mut GCD: u32 = gcd(OrigElts, WideElts);
        let mut SplatVT: EVT = getVectorVT(*self.DAG.getContext(), ElemVT, getScalable(GCD));
        let mut SplatNeutral: SDValue = self.DAG.getSplatVector(SplatVT, dl, NeutralElem);
        for let mut Idx: u32 = OrigElts; Idx < WideElts; Idx = Idx + GCD {
            Op = self.DAG.getInsertSubvector(dl, Op, SplatNeutral, Idx);
        }
        return self.DAG.getNode(Opc, dl, VT, AccOp, Op, Flags);
    }
    for let mut Idx: u32 = OrigElts; Idx < WideElts; Idx += 1 {
        Op = self.DAG.getInsertVectorElt(dl, Op, NeutralElem, Idx);
    }
    return self.DAG.getNode(Opc, dl, VT, AccOp, Op, Flags);
}

fn DAGTypeLegalizer::WidenVecOp_VP_REDUCE(self, N: *mut SDNode) -> SDValue {
    assert!(N.isVPOpcode(), "Expected VP opcode");
    let mut dl: SDLoc = SDLoc { N };
    let mut Op: SDValue = self.GetWidenedVector(N.getOperand(1));
    let mut Mask: SDValue = self.GetWidenedMask(N.getOperand(2), Op.getValueType().getVectorElementCount());
    return self.DAG.getNode(N.getOpcode(), dl, N.getValueType(0), ArrayRef<SDValue> { [N.getOperand(0), Op, Mask, N.getOperand(3)] }, N.getFlags());
}

fn DAGTypeLegalizer::WidenVecOp_VSELECT(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    assert!(VT.isVector() && !VT.isPow2VectorType() && self.isTypeLegal(VT));
    let mut Cond: SDValue = self.GetWidenedVector(N.getOperand(0));
    let mut LeftIn: SDValue = self.DAG.WidenVector(N.getOperand(1), SDLoc { N });
    let mut RightIn: SDValue = self.DAG.WidenVector(N.getOperand(2), SDLoc { N });
    let mut DL: SDLoc = SDLoc { N };
    let mut Select: SDValue = self.DAG.getNode(N.getOpcode(), DL, LeftIn.getValueType(), Cond, LeftIn, RightIn);
    return self.DAG.getExtractSubvector(DL, VT, Select, 0);
}

fn DAGTypeLegalizer::WidenVecOp_CttzElements(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Source: SDValue = N.getOperand(0);
    let mut SourceVT: EVT = Source.getValueType();
    let mut WideVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), SourceVT);
    let mut WideSource: SDValue = SDValue {};
    if N.getOpcode() == CTTZ_ELTS_ZERO_POISON {
        WideSource = self.GetWidenedVector(Source);
    } else {
        let mut AllOnes: SDValue = self.DAG.getAllOnesConstant(DL, WideVT, false, false);
        if WideVT.isFixedLengthVector() && self.getTypeAction(WideVT) == TypeSplitVector {
            WideSource = self.GetWidenedVector(Source);
            let mut WideElts: u32 = WideVT.getVectorNumElements();
            let mut Mask: SmallVector<int> = SmallVector<int> { WideElts };
            iota(Mask.begin(), Mask.end(), 0);
            for let mut I: u32 = SourceVT.getVectorNumElements(); I != WideElts; I += 1 {
                Mask[I] += WideElts;
            }
            WideSource = self.DAG.getVectorShuffle(WideVT, DL, WideSource, AllOnes, ArrayRef<int> { Mask });
        } else {
            WideSource = self.DAG.getInsertSubvector(DL, AllOnes, Source, 0);
        }
    }
    return self.DAG.getNode(N.getOpcode(), DL, N.getValueType(0), WideSource, N.getFlags());
}

fn DAGTypeLegalizer::WidenVecOp_VP_CttzElements(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Source: SDValue = self.GetWidenedVector(N.getOperand(0));
    let mut SrcVT: EVT = Source.getValueType();
    let mut Mask: SDValue = self.GetWidenedMask(N.getOperand(1), SrcVT.getVectorElementCount());
    return self.DAG.getNode(N.getOpcode(), DL, N.getValueType(0), ArrayRef<SDValue> { [Source, Mask, N.getOperand(2)] }, N.getFlags());
}

fn DAGTypeLegalizer::WidenVecOp_VECTOR_FIND_LAST_ACTIVE(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Mask: SDValue = N.getOperand(0);
    let mut OrigMaskVT: EVT = Mask.getValueType();
    let mut WideMask: SDValue = self.GetWidenedVector(Mask);
    let mut WideMaskVT: EVT = WideMask.getValueType();
    let mut OrigElts: u32 = OrigMaskVT.getVectorNumElements();
    let mut WideElts: u32 = WideMaskVT.getVectorNumElements();
    if OrigElts != WideElts {
        let mut ZeroMask: SDValue = self.DAG.getConstant(0, DL, WideMaskVT, false, false);
        WideMask = self.DAG.getNode(INSERT_SUBVECTOR, DL, WideMaskVT, ZeroMask, Mask, self.DAG.getVectorIdxConstant(0, DL, false));
    }
    return self.DAG.getNode(VECTOR_FIND_LAST_ACTIVE, DL, N.getValueType(0), WideMask);
}

fn DAGTypeLegalizer::WidenVecOp_VECTOR_MATCH(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    if OpNo == 0 {
        let mut DL: SDLoc = SDLoc { N };
        let mut ResVT: EVT = N.getValueType(0);
        let mut SourceVT: EVT = N.getOperand(0).getValueType();
        let mut WideSourceVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), SourceVT);
        let mut WidenVT: EVT = getVectorVT(*self.DAG.getContext(), ResVT.getVectorElementType(), WideSourceVT.getVectorElementCount());
        let mut WideSource: SDValue = self.DAG.getInsertSubvector(DL, self.DAG.getUNDEF(WideSourceVT), N.getOperand(0), 0);
        let mut WideMask: SDValue = self.DAG.getInsertSubvector(DL, self.DAG.getConstant(0, DL, WidenVT, false, false), N.getOperand(2), 0);
        let mut WideMatch: SDValue = self.DAG.getNode(VECTOR_MATCH, DL, WidenVT, WideSource, N.getOperand(1), WideMask, N.getFlags());
        return self.DAG.getExtractSubvector(DL, ResVT, WideMatch, 0);
    }
    assert!(OpNo == 1, "Unexpected VECTOR_MATCH operand");
    let mut DL: SDLoc = SDLoc { N };
    let mut Needle: SDValue = N.getOperand(1);
    let mut NeedleVT: EVT = Needle.getValueType();
    if NeedleVT.getVectorNumElements() == 1 {
        return self.TLI.expandVectorMatch(N, self.DAG);
    }
    let mut WidenNeedleVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), NeedleVT);
    let mut Fill: SDValue = self.DAG.getExtractVectorElt(DL, NeedleVT.getVectorElementType(), Needle, 0);
    let mut WideNeedle: SDValue = self.DAG.getSplatVector(WidenNeedleVT, DL, Fill);
    WideNeedle = self.DAG.getInsertSubvector(DL, WideNeedle, Needle, 0);
    return self.DAG.getNode(VECTOR_MATCH, DL, N.getValueType(0), N.getOperand(0), WideNeedle, N.getOperand(2), N.getFlags());
}

fn findMemType(DAG: *mut SelectionDAG, TLI: *TargetLowering, Width: u32, WidenVT: EVT, Align: u32, WidenEx: u32) -> optional<EVT> {
    let mut WidenEltVT: EVT = WidenVT.getVectorElementType();
    let mut Scalable: bool = WidenVT.isScalableVector();
    let mut WidenWidth: u32 = WidenVT.getSizeInBits().getKnownMinValue();
    let mut WidenEltWidth: u32 = WidenEltVT.getSizeInBits().operator unsigned long long();
    let mut AlignInBits: u32 = Align * 8;
    let mut RetVT: EVT = WidenEltVT;
    if !Scalable {
        if Width == WidenEltWidth {
            return optional<EVT> { RetVT };
        }
        for MemVT in reverse(integer_valuetypes()) {
            let mut MemVTWidth: u32 = MemVT.getSizeInBits().operator unsigned long long();
            if MemVT.getSizeInBits().operator unsigned long long() <= WidenEltWidth {
                break;
            }
            let mut Action: LegalizeTypeAction = TLI.getTypeAction(*DAG.getContext(), MemVT);
            if (Action == TypeLegal || Action == TypePromoteInteger) && (WidenWidth % MemVTWidth) == 0 && isPowerOf2_32(WidenWidth / MemVTWidth) && (MemVTWidth <= Width || (Align != 0 && MemVTWidth <= AlignInBits && MemVTWidth <= Width + WidenEx)) {
                if MemVTWidth == WidenWidth {
                    return optional<EVT> { MemVT };
                }
                RetVT = MemVT;
                break;
            }
        }
    }
    for MemVT in reverse(vector_valuetypes()) {
        if Scalable != MemVT.isScalableVector() {
            continue;
        }
        let mut MemVTWidth: u32 = MemVT.getSizeInBits().getKnownMinValue();
        let mut Action: LegalizeTypeAction = TLI.getTypeAction(*DAG.getContext(), MemVT);
        if (Action == TypeLegal || Action == TypePromoteInteger) && WidenEltVT == MemVT.getVectorElementType() && (WidenWidth % MemVTWidth) == 0 && isPowerOf2_32(WidenWidth / MemVTWidth) && (MemVTWidth <= Width || (Align != 0 && MemVTWidth <= AlignInBits && MemVTWidth <= Width + WidenEx)) {
            if RetVT.getFixedSizeInBits() < MemVTWidth || MemVT == WidenVT {
                return optional<EVT> { MemVT };
            }
        }
    }
    if Scalable {
        return optional<EVT> { nullopt };
    }
    return optional<EVT> { RetVT };
}

fn BuildVectorFromScalar(DAG: *mut SelectionDAG, VecTy: EVT, LdOps: *mut SmallVectorImpl<SDValue>, Start: u32, End: u32) -> SDValue {
    let mut dl: SDLoc = SDLoc { LdOps[Start] };
    let mut LdTy: EVT = LdOps[Start].getValueType();
    let mut Width: u32 = VecTy.getSizeInBits().operator unsigned long long();
    let mut NumElts: u32 = Width / LdTy.getSizeInBits().operator unsigned long long();
    let mut NewVecVT: EVT = getVectorVT(*DAG.getContext(), LdTy, NumElts, false);
    let mut Idx: u32 = 1;
    let mut VecOp: SDValue = DAG.getNode(SCALAR_TO_VECTOR, dl, NewVecVT, LdOps[Start]);
    for let mut i: u32 = Start + 1; i != End; i += 1 {
        let mut NewLdTy: EVT = LdOps[i].getValueType();
        if NewLdTy != LdTy {
            NumElts = Width / NewLdTy.getSizeInBits().operator unsigned long long();
            NewVecVT = getVectorVT(*DAG.getContext(), NewLdTy, NumElts, false);
            VecOp = DAG.getNode(BITCAST, dl, NewVecVT, VecOp);
            Idx = Idx * LdTy.getSizeInBits().operator unsigned long long() / NewLdTy.getSizeInBits().operator unsigned long long();
            LdTy = NewLdTy;
        }
        VecOp = DAG.getInsertVectorElt(dl, VecOp, LdOps[i], Idx += 1);
    }
    return DAG.getNode(BITCAST, dl, VecTy, VecOp);
}

fn DAGTypeLegalizer::GenWidenVectorLoads(self, LdChain: *mut SmallVectorImpl<SDValue>, LD: *mut LoadSDNode) -> SDValue {
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), LD.getValueType(0));
    let mut LdVT: EVT = LD.getMemoryVT();
    let mut dl: SDLoc = SDLoc { LD };
    assert!(LdVT.isVector() && WidenVT.isVector());
    assert!(LdVT.isScalableVector() == WidenVT.isScalableVector());
    assert!(LdVT.getVectorElementType() == WidenVT.getVectorElementType());
    let mut Chain: SDValue = LD.getChain();
    let mut BasePtr: SDValue = LD.getBasePtr();
    let mut MMOFlags: Flags = LD.getMemOperand().getFlags();
    let mut AAInfo: AAMDNodes = LD.getAAInfo();
    let mut LdWidth: TypeSize = LdVT.getSizeInBits();
    let mut WidenWidth: TypeSize = WidenVT.getSizeInBits();
    let mut WidthDiff: TypeSize = WidenWidth - LdWidth;
    let mut LdAlign: u32 = if (!LD.isSimple() || LdVT.isScalableVector()) { 0 } else { LD.getAlign().value() };
    let mut FirstVT: optional<EVT> = findMemType(self.DAG, self.TLI, LdWidth.getKnownMinValue(), WidenVT, LdAlign, WidthDiff.getKnownMinValue());
    if !FirstVT {
        return SDValue {};
    }
    let mut MemVTs: SmallVector<EVT, 8> = SmallVector<EVT, 8> {};
    let mut FirstVTWidth: TypeSize = operator(FirstVT).getSizeInBits();
    if !isKnownLE(LdWidth, FirstVTWidth) {
        let mut NewVT: optional<EVT> = optional<EVT> { FirstVT };
        let mut RemainingWidth: TypeSize = LdWidth;
        let mut NewVTWidth: TypeSize = FirstVTWidth;
        while true {
            {
            operator(RemainingWidth, NewVTWidth);
            if isKnownLT(RemainingWidth, NewVTWidth) {
                NewVT = findMemType(self.DAG, self.TLI, RemainingWidth.getKnownMinValue(), WidenVT, LdAlign, WidthDiff.getKnownMinValue());
                if !NewVT {
                    return SDValue {};
                }
                NewVTWidth = operator(NewVT).getSizeInBits();
            }
            MemVTs.push(ValueParamT { operator(NewVT) });
        }
            if !(isKnownGT(RemainingWidth, NewVTWidth)) { break; }
        }
    }
    let mut LdOp: SDValue = self.DAG.getLoad(operator(FirstVT), dl, Chain, BasePtr, LD.getPointerInfo(), MaybeAlign { LD.getBaseAlign() }, MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
    LdChain.push(LdOp.getValue(1));
    if MemVTs.len == 0 {
        return coerceLoadedValue(LdOp, operator(FirstVT), WidenVT, LdWidth, FirstVTWidth, dl, self.DAG);
    }
    let mut LdOps: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    LdOps.push(ValueParamT { LdOp });
    let mut ScaledOffset: u64 = 0;
    let mut MPI: MachinePointerInfo = LD.getPointerInfo();
    self.IncrementPointer(cast(LdOp), operator(FirstVT), MPI, BasePtr, &mut ScaledOffset);
    for MemVT in MemVTs {
        let mut NewAlign: Align = if ScaledOffset == 0 { LD.getBaseAlign() } else { commonAlignment(LD.getAlign(), ScaledOffset) };
        let mut L: SDValue = self.DAG.getLoad(MemVT, dl, Chain, BasePtr, MPI, MaybeAlign { NewAlign }, MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
        LdOps.push(ValueParamT { L });
        LdChain.push(L.getValue(1));
        self.IncrementPointer(cast(L), MemVT, MPI, BasePtr, &mut ScaledOffset);
    }
    let mut End: u32 = LdOps.len;
    if !LdOps[0].getValueType().isVector() {
        return BuildVectorFromScalar(self.DAG, WidenVT, LdOps, 0, End);
    }
    let mut ConcatOps: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { End };
    let mut i: i32 = End - 1;
    let mut Idx: i32 = End;
    let mut LdTy: EVT = LdOps[i].getValueType();
    if !LdTy.isVector() {
        for i -= 1; i >= 0; i -= 1 {
            LdTy = LdOps[i].getValueType();
            if LdTy.isVector() {
                break;
            }
        }
        ConcatOps[Idx -= 1] = BuildVectorFromScalar(self.DAG, LdTy, LdOps, i + 1, End);
    }
    ConcatOps[Idx -= 1] = LdOps[i];
    for i -= 1; i >= 0; i -= 1 {
        let mut NewLdTy: EVT = LdOps[i].getValueType();
        if NewLdTy != LdTy {
            let mut LdTySize: TypeSize = LdTy.getSizeInBits();
            let mut NewLdTySize: TypeSize = NewLdTy.getSizeInBits();
            assert!(NewLdTySize.isScalable() == LdTySize.isScalable() && NewLdTySize.isKnownMultipleOf(LdTySize.getKnownMinValue()));
            let mut NumOps: u32 = NewLdTySize.getKnownMinValue() / LdTySize.getKnownMinValue();
            let mut WidenOps: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { NumOps };
            let mut j: u32 = 0;
            for ; j != End - Idx; j += 1 {
                WidenOps[j] = ConcatOps[Idx + j];
            }
            for ; j != NumOps; j += 1 {
                WidenOps[j] = self.DAG.getPOISON(LdTy);
            }
            ConcatOps[End - 1] = self.DAG.getNode(CONCAT_VECTORS, dl, NewLdTy, ArrayRef<SDValue> { WidenOps });
            Idx = End - 1;
            LdTy = NewLdTy;
        }
        ConcatOps[Idx -= 1] = LdOps[i];
    }
    if WidenWidth == LdTy.getSizeInBits() * (End - Idx) {
        return self.DAG.getNode(CONCAT_VECTORS, dl, WidenVT, SDValue> { &mut ConcatOps[Idx], End - Idx });
    }
    let mut NumOps: u32 = WidenWidth.getKnownMinValue() / LdTy.getSizeInBits().getKnownMinValue();
    let mut WidenOps: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { NumOps };
    let mut UndefVal: SDValue = self.DAG.getPOISON(LdTy);
    {
        let mut i: u32 = 0;
        for ; i != End - Idx; i += 1 {
            WidenOps[i] = ConcatOps[Idx + i];
        }
        for ; i != NumOps; i += 1 {
            WidenOps[i] = UndefVal;
        }
    }
    return self.DAG.getNode(CONCAT_VECTORS, dl, WidenVT, ArrayRef<SDValue> { WidenOps });
}

fn DAGTypeLegalizer::GenWidenVectorExtLoads(self, LdChain: *mut SmallVectorImpl<SDValue>, LD: *mut LoadSDNode, ExtType: LoadExtType) -> SDValue {
    let mut WidenVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), LD.getValueType(0));
    let mut LdVT: EVT = LD.getMemoryVT();
    let mut dl: SDLoc = SDLoc { LD };
    assert!(LdVT.isVector() && WidenVT.isVector());
    assert!(LdVT.isScalableVector() == WidenVT.isScalableVector());
    let mut Chain: SDValue = LD.getChain();
    let mut BasePtr: SDValue = LD.getBasePtr();
    let mut MMOFlags: Flags = LD.getMemOperand().getFlags();
    let mut AAInfo: AAMDNodes = LD.getAAInfo();
    if LdVT.isScalableVector() {
        return SDValue {};
    }
    let mut EltVT: EVT = WidenVT.getVectorElementType();
    let mut LdEltVT: EVT = LdVT.getVectorElementType();
    let mut NumElts: u32 = LdVT.getVectorNumElements();
    let mut WidenNumElts: u32 = WidenVT.getVectorNumElements();
    let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { WidenNumElts };
    let mut Increment: u32 = LdEltVT.getSizeInBits().operator unsigned long long() / 8;
    Ops[0] = self.DAG.getExtLoad(ExtType, dl, EltVT, Chain, BasePtr, LD.getPointerInfo(), LdEltVT, MaybeAlign { LD.getBaseAlign() }, MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
    LdChain.push(Ops[0].getValue(1));
    let mut i: u32 = 0;
    let mut Offset: u32 = Increment;
    for i = 1; i < NumElts; i += 1 , Offset += Increment {
        let mut NewBasePtr: SDValue = self.DAG.getObjectPtrOffset(dl, BasePtr, getFixed(Offset));
        Ops[i] = self.DAG.getExtLoad(ExtType, dl, EltVT, Chain, NewBasePtr, LD.getPointerInfo().getWithOffset(Offset), LdEltVT, MaybeAlign { LD.getBaseAlign() }, MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
        LdChain.push(Ops[i].getValue(1));
    }
    let mut UndefVal: SDValue = self.DAG.getPOISON(EltVT);
    for ; i != WidenNumElts; i += 1 {
        Ops[i] = UndefVal;
    }
    return self.DAG.getBuildVector(WidenVT, dl, ArrayRef<SDValue> { Ops });
}

fn DAGTypeLegalizer::GenWidenVectorStores(self, StChain: *mut SmallVectorImpl<SDValue>, ST: *mut StoreSDNode) -> bool {
    let mut Chain: SDValue = ST.getChain();
    let mut BasePtr: SDValue = ST.getBasePtr();
    let mut MMOFlags: Flags = ST.getMemOperand().getFlags();
    let mut AAInfo: AAMDNodes = ST.getAAInfo();
    let mut ValOp: SDValue = self.GetWidenedVector(ST.getValue());
    let mut dl: SDLoc = SDLoc { ST };
    let mut StVT: EVT = ST.getMemoryVT();
    let mut StWidth: TypeSize = StVT.getSizeInBits();
    let mut ValVT: EVT = ValOp.getValueType();
    let mut ValWidth: TypeSize = ValVT.getSizeInBits();
    let mut ValEltVT: EVT = ValVT.getVectorElementType();
    let mut ValEltWidth: u32 = ValEltVT.getFixedSizeInBits();
    assert!(StVT.getVectorElementType() == ValEltVT);
    assert!(StVT.isScalableVector() == ValVT.isScalableVector(), "Mismatch between store and value types");
    let mut Idx: i32 = 0;
    let mut MPI: MachinePointerInfo = ST.getPointerInfo();
    let mut ScaledOffset: u64 = 0;
    let mut MemVTs: pair<EVT, unsigned int>, 4> = pair<EVT, unsigned int>, 4> {};
    while StWidth.isNonZero() {
        let mut NewVT: optional<EVT> = findMemType(self.DAG, self.TLI, StWidth.getKnownMinValue(), ValVT, 0, 0);
        if !NewVT {
            return false;
        }
        MemVTs.push(EVT, unsigned int> { operator(NewVT), 0 });
        let mut NewVTWidth: TypeSize = operator(NewVT).getSizeInBits();
        while true {
            {
            operator(StWidth, NewVTWidth);
            MemVTs.back().second += 1;
        }
            if !(StWidth.isNonZero() && isKnownGE(StWidth, NewVTWidth)) { break; }
        }
    }
    for Pair in MemVTs {
        let mut NewVT: EVT = Pair.first;
        let mut Count: u32 = Pair.second;
        let mut NewVTWidth: TypeSize = NewVT.getSizeInBits();
        if NewVT.isVector() {
            let mut NumVTElts: u32 = NewVT.getVectorMinNumElements();
            while true {
                {
                let mut NewAlign: Align = if ScaledOffset == 0 { ST.getBaseAlign() } else { commonAlignment(ST.getAlign(), ScaledOffset) };
                let mut EOp: SDValue = self.DAG.getExtractSubvector(dl, NewVT, ValOp, Idx);
                let mut PartStore: SDValue = self.DAG.getStore(Chain, dl, EOp, BasePtr, MPI, NewAlign, MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
                StChain.push(ValueParamT { PartStore });
                Idx += NumVTElts;
                self.IncrementPointer(cast(PartStore), NewVT, MPI, BasePtr, &mut ScaledOffset);
            }
                if !(Count -= 1) { break; }
            }
        } else {
            let mut NumElts: u32 = ValWidth.getFixedValue() / NewVTWidth.getFixedValue();
            let mut NewVecVT: EVT = getVectorVT(*self.DAG.getContext(), NewVT, NumElts, false);
            let mut VecOp: SDValue = self.DAG.getNode(BITCAST, dl, NewVecVT, ValOp);
            Idx = Idx * ValEltWidth / NewVTWidth.getFixedValue();
            while true {
                {
                let mut EOp: SDValue = self.DAG.getExtractVectorElt(dl, NewVT, VecOp, Idx += 1);
                let mut PartStore: SDValue = self.DAG.getStore(Chain, dl, EOp, BasePtr, MPI, ST.getBaseAlign(), MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
                StChain.push(ValueParamT { PartStore });
                self.IncrementPointer(cast(PartStore), NewVT, MPI, BasePtr, null);
            }
                if !(Count -= 1) { break; }
            }
            Idx = Idx * NewVTWidth.getFixedValue() / ValEltWidth;
        }
    }
    return true;
}

fn DAGTypeLegalizer::ModifyToType(self, InOp: SDValue, NVT: EVT, FillWithZeroes: bool) -> SDValue {
    let mut InVT: EVT = InOp.getValueType();
    assert!(InVT.getVectorElementType() == NVT.getVectorElementType(), "input and widen element type must match");
    assert!(InVT.isScalableVector() == NVT.isScalableVector(), "cannot modify scalable vectors in this way");
    let mut dl: SDLoc = SDLoc { InOp };
    if InVT == NVT {
        return InOp;
    }
    let mut InEC: ElementCount = InVT.getVectorElementCount();
    let mut WidenEC: ElementCount = NVT.getVectorElementCount();
    if WidenEC.hasKnownScalarFactor(InEC) {
        let mut NumConcat: u32 = WidenEC.getKnownScalarFactor(InEC);
        let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { NumConcat };
        let mut FillVal: SDValue = if FillWithZeroes { self.DAG.getConstant(0, dl, InVT, false, false) } else { self.DAG.getPOISON(InVT) };
        Ops[0] = InOp;
        for let mut i: u32 = 1; i != NumConcat; i += 1 {
            Ops[i] = FillVal;
        }
        return self.DAG.getNode(CONCAT_VECTORS, dl, NVT, ArrayRef<SDValue> { Ops });
    }
    if InEC.hasKnownScalarFactor(WidenEC) {
        return self.DAG.getExtractSubvector(dl, NVT, InOp, 0);
    }
    if NVT.isScalableVector() && InVT.isScalableVector() {
        let mut InNumElts: u32 = InVT.getVectorMinNumElements();
        let mut NewNumElts: u32 = NVT.getVectorMinNumElements();
        let mut CommonFactor: u32 = gcd(InNumElts, NewNumElts);
        let mut PartVT: EVT = getVectorVT(*self.DAG.getContext(), NVT.getVectorElementType(), getScalable(CommonFactor));
        let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
        let mut NumCopiedParts: u32 = if InNumElts < NewNumElts { InNumElts } else { NewNumElts } / CommonFactor;
        for let mut I: u32 = 0; I != NumCopiedParts; I += 1 {
            Ops.push(self.DAG.getExtractSubvector(dl, PartVT, InOp, I * CommonFactor));
        }
        let mut NumResultParts: u32 = NewNumElts / CommonFactor;
        if NumResultParts > NumCopiedParts {
            let mut FillVal: SDValue = if FillWithZeroes { self.DAG.getConstant(0, dl, PartVT, false, false) } else { self.DAG.getPOISON(PartVT) };
            Ops.append(NumResultParts - NumCopiedParts, ValueParamT { FillVal });
        }
        return self.DAG.getNode(CONCAT_VECTORS, dl, NVT, ArrayRef<SDValue> { Ops });
    }
    assert!(!InVT.isScalableVector() && !NVT.isScalableVector(), "Scalable vectors should have been handled already.");
    let mut InNumElts: u32 = InEC.getFixedValue();
    let mut WidenNumElts: u32 = WidenEC.getFixedValue();
    let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { WidenNumElts };
    let mut EltVT: EVT = NVT.getVectorElementType();
    let mut MinNumElts: u32 = if WidenNumElts < InNumElts { WidenNumElts } else { InNumElts };
    let mut Idx: u32 = 0;
    for Idx = 0; Idx < MinNumElts; Idx += 1 {
        Ops[Idx] = self.DAG.getExtractVectorElt(dl, EltVT, InOp, Idx);
    }
    let mut UndefVal: SDValue = self.DAG.getPOISON(EltVT);
    for ; Idx < WidenNumElts; Idx += 1 {
        Ops[Idx] = UndefVal;
    }
    let mut Widened: SDValue = self.DAG.getBuildVector(NVT, dl, ArrayRef<SDValue> { Ops });
    if !FillWithZeroes {
        return Widened;
    }
    assert!(NVT.isInteger(), "We expect to never want to FillWithZeroes for non-integral types.");
    let mut MaskOps: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    MaskOps.append(MinNumElts, self.DAG.getAllOnesConstant(dl, EltVT, false, false));
    MaskOps.append(WidenNumElts - MinNumElts, self.DAG.getConstant(0, dl, EltVT, false, false));
    return self.DAG.getNode(AND, dl, NVT, Widened, self.DAG.getBuildVector(NVT, dl, ArrayRef<SDValue> { MaskOps }));
}

struct Closure_1 {
    N: *mut *mut MemSDNode,
}

unsafe fn Closure_1::call(self: *mut Closure_1) -> auto {
        if dyn_cast((*self.N)) {
            MSC;
        } else {
            return Operands { MSC.getMask(), MSC.getIndex(), MSC.getScale() };
        }
        let mut VPSC: *mut VPGatherSDNode = cast((*self.N));
        return Operands { VPSC.getMask(), VPSC.getIndex(), VPSC.getScale() };
    }

struct Closure_2 {}

fn Closure_2::call(self: *Closure_2, N: *SDValue) -> bool {
        let mut SplatValue: APInt = APInt {};
        return N.getResNo() == 0 && (isConstantSplatVector(N.getNode(), SplatValue) || isBuildVectorOfConstantSDNodes(N.getNode()));
    }

struct Closure_3 {
    NewElts: u32,
    DAG: *mut SelectionDAG,
    cap_2: EVT,
    DL: *mut SDLoc,
}

unsafe fn Closure_3::call(self: *mut Closure_3, Input1: *mut SDValue, Input2: *mut SDValue, Mask: ArrayRef<int>) -> SDValue {
        assert!(operator(Input1).getOpcode() == BUILD_VECTOR && operator(Input2).getOpcode() == BUILD_VECTOR, "Expected build vector node.");
        let mut EltVT: EVT = NewVT.getVectorElementType();
        let mut Ops: SmallVector<SDValue> = SmallVector<SDValue> { self.NewElts, (*self.DAG).getPOISON(EltVT) };
        for let mut I: u32 = 0; I < self.NewElts; I += 1 {
            if Mask[I] == PoisonMaskElem {
                continue;
            }
            let mut Idx: u32 = Mask[I];
            if Idx >= self.NewElts {
                Ops[I] = Input2.getOperand(Idx - self.NewElts);
            } else {
                Ops[I] = Input1.getOperand(Idx);
            }
            if Ops[I].getValueType().bitsGT(EltVT) {
                Ops[I] = (*self.DAG).getNode(TRUNCATE, (*self.DL), EltVT, Ops[I]);
            }
        }
        return (*self.DAG).getBuildVector(NewVT, (*self.DL), ArrayRef<SDValue> { Ops });
    }

struct Closure_5 {
    SrcRegIdx: u32,
}

fn Closure_5::call(self: *Closure_5, Idxs: pair<unsigned int, int>>) -> bool {
                        return Idxs.front().first == self.SrcRegIdx || Idxs.back().first == self.SrcRegIdx;
                    }

struct Closure_4 {
    Inputs: *mut [4]SDValue (&),
    NewVT: *mut EVT,
    cap_2: *mut DAGTypeLegalizer,
    NewElts: u32,
    DL: *mut SDLoc,
}

unsafe fn Closure_4::call(self: *mut Closure_4, Mask: *mut SmallVectorImpl<int>) {
        let mut ShufflesIdxs: pair<SDValue, SDValue>, SmallVector<unsigned int>> = pair<SDValue, SDValue>, SmallVector<unsigned int>> {};
        for let mut Idx: u32 = 0; Idx < size((*self.Inputs)); Idx += 1 {
            let mut Input: SDValue = (*self.Inputs)[Idx];
            let mut Shuffle: *mut ShuffleVectorSDNode = dyn_cast(Input.getNode());
            if !Shuffle || Input.getOperand(0).getValueType() != Input.getValueType() {
                continue;
            }
            ShufflesIdxs[make_pair(Input.getOperand(0), Input.getOperand(1))].push(Idx);
            ShufflesIdxs[make_pair(Input.getOperand(1), Input.getOperand(0))].push(Idx);
        }
        for P in ShufflesIdxs {
            if P.second.len < 2 {
                continue;
            }
            for Idx in Mask {
                if Idx == PoisonMaskElem {
                    continue;
                }
                let mut SrcRegIdx: u32 = Idx / self.NewElts;
                if (*self.Inputs)[SrcRegIdx].isUndef() {
                    Idx = PoisonMaskElem;
                    continue;
                }
                let mut Shuffle: *mut ShuffleVectorSDNode = dyn_cast((*self.Inputs)[SrcRegIdx].getNode());
                if !Shuffle || !is_contained(P.second, SrcRegIdx) {
                    continue;
                }
                let mut MaskElt: i32 = Shuffle.getMaskElt(Idx % self.NewElts);
                if MaskElt == PoisonMaskElem {
                    Idx = PoisonMaskElem;
                    continue;
                }
                Idx = MaskElt % self.NewElts + P.second[if Shuffle.getOperand(MaskElt / self.NewElts) == P.first.first { 0 } else { 1 }] * self.NewElts;
            }
            (*self.Inputs)[P.second[0]] = P.first.first;
            (*self.Inputs)[P.second[1]] = P.first.second;
            P.second.clear();
            ShufflesIdxs[make_pair(P.first.second, P.first.first)].clear();
        }
        let mut UsedSubVector: SmallBitVector = SmallBitVector { 2 * size((*self.Inputs)), false };
        for Idx in Mask {
            if Idx == PoisonMaskElem {
                continue;
            }
            let mut SrcRegIdx: u32 = Idx / self.NewElts;
            if (*self.Inputs)[SrcRegIdx].isUndef() {
                Idx = PoisonMaskElem;
                continue;
            }
            let mut TypeAction: LegalizeTypeAction = self.getTypeAction((*self.Inputs)[SrcRegIdx].getValueType());
            if (*self.Inputs)[SrcRegIdx].getOpcode() == CONCAT_VECTORS && (*self.Inputs)[SrcRegIdx].getNumOperands() == 2 && !(*self.Inputs)[SrcRegIdx].getOperand(1).isUndef() && (TypeAction == TypeLegal || TypeAction == TypeWidenVector) {
                UsedSubVector.set(2 * SrcRegIdx + (Idx % self.NewElts) / (self.NewElts / 2));
            }
        }
        if UsedSubVector.count() > 1 {
            let mut Pairs: pair<unsigned int, int>, 2>> = pair<unsigned int, int>, 2>> {};
            for let mut I: u32 = 0; I < size((*self.Inputs)); I += 1 {
                if UsedSubVector.test(2 * I) == UsedSubVector.test(2 * I + 1) {
                    continue;
                }
                if Pairs.len == 0 || Pairs.back().len == 2 {
                    Pairs.emplace_back();
                }
                if UsedSubVector.test(2 * I) {
                    Pairs.back().emplace_back(I, 0);
                } else {
                    assert!(UsedSubVector.test(2 * I + 1), "Expected to be used one of the subvectors.");
                    Pairs.back().emplace_back(I, 1);
                }
            }
            if !Pairs.is_empty() && Pairs.front().len > 1 {
                for Idx in Mask {
                    if Idx == PoisonMaskElem {
                        continue;
                    }
                    let mut SrcRegIdx: u32 = Idx / self.NewElts;
                    let mut It: *mut pair<unsigned int, int>, 2> = find_if(Pairs, Closure_5 { SrcRegIdx: SrcRegIdx });
                    if It == Pairs.end() {
                        continue;
                    }
                    Idx = It.front().first * self.NewElts + (Idx % self.NewElts) % (self.NewElts / 2) + (if SrcRegIdx == It.front().first { 0 } else { (self.NewElts / 2) });
                }
                for Idxs in Pairs {
                    (*self.Inputs)[Idxs.front().first] = self.DAG.getNode(CONCAT_VECTORS, (*self.DL), (*self.Inputs)[Idxs.front().first].getValueType(), (*self.Inputs)[Idxs.front().first].getOperand(Idxs.front().second), (*self.Inputs)[Idxs.back().first].getOperand(Idxs.back().second));
                }
            }
        }
        let mut Changed: bool = false;
        while true {
            {
            Changed = false;
            for let mut I: u32 = 0; I < size((*self.Inputs)); I += 1 {
                let mut Shuffle: *mut ShuffleVectorSDNode = dyn_cast((*self.Inputs)[I].getNode());
                if !Shuffle {
                    continue;
                }
                if Shuffle.getOperand(0).getValueType() != (*self.NewVT) {
                    continue;
                }
                let mut Op: i32 = -1;
                if !(*self.Inputs)[I].hasOneUse() && Shuffle.getOperand(1).isUndef() && !Shuffle.isSplat() {
                    Op = 0;
                } else if !(*self.Inputs)[I].hasOneUse() && !Shuffle.getOperand(1).isUndef() {
                    for Idx in Mask {
                        if Idx == PoisonMaskElem {
                            continue;
                        }
                        let mut SrcRegIdx: u32 = Idx / self.NewElts;
                        if SrcRegIdx != I {
                            continue;
                        }
                        let mut MaskElt: i32 = Shuffle.getMaskElt(Idx % self.NewElts);
                        if MaskElt == PoisonMaskElem {
                            Idx = PoisonMaskElem;
                            continue;
                        }
                        let mut OpIdx: i32 = MaskElt / self.NewElts;
                        if Op == -1 {
                            Op = OpIdx;
                            continue;
                        }
                        if Op != OpIdx {
                            Op = -1;
                            break;
                        }
                    }
                }
                if Op < 0 {
                    for let mut OpIdx: i32 = 0; OpIdx < 2; OpIdx += 1 {
                        if Shuffle.getOperand(OpIdx).isUndef() {
                            continue;
                        }
                        let mut It: *mut SDValue = find((*self.Inputs), Shuffle.getOperand(OpIdx));
                        if It == end((*self.Inputs)) {
                            continue;
                        }
                        let mut FoundOp: i32 = distance(begin((*self.Inputs)), It);
                        for Idx in Mask {
                            if Idx == PoisonMaskElem {
                                continue;
                            }
                            let mut SrcRegIdx: u32 = Idx / self.NewElts;
                            if SrcRegIdx != I {
                                continue;
                            }
                            let mut MaskElt: i32 = Shuffle.getMaskElt(Idx % self.NewElts);
                            if MaskElt == PoisonMaskElem {
                                Idx = PoisonMaskElem;
                                continue;
                            }
                            let mut MaskIdx: i32 = MaskElt / self.NewElts;
                            if OpIdx == MaskIdx {
                                Idx = MaskElt % self.NewElts + FoundOp * self.NewElts;
                            }
                        }
                        Op = (OpIdx + 1) % 2;
                        break;
                    }
                }
                if Op >= 0 {
                    Changed = true;
                    (*self.Inputs)[I] = Shuffle.getOperand(Op);
                    for Idx in Mask {
                        if Idx == PoisonMaskElem {
                            continue;
                        }
                        let mut SrcRegIdx: u32 = Idx / self.NewElts;
                        if SrcRegIdx != I {
                            continue;
                        }
                        let mut MaskElt: i32 = Shuffle.getMaskElt(Idx % self.NewElts);
                        let mut OpIdx: i32 = MaskElt / self.NewElts;
                        if OpIdx != Op {
                            continue;
                        }
                        Idx = MaskElt % self.NewElts + SrcRegIdx * self.NewElts;
                    }
                }
            }
        }
            if !(Changed) { break; }
        }
    }

struct Closure_6 {
    Inputs: *mut [4]SDValue (&),
    IsConstant: *mut (lambda at P:\Goraw\llvm-project\llvm\lib\CodeGen\SelectionDAG\LegalizeVectorTypes.cpp:3134:23),
    NewElts: u32,
}

unsafe fn Closure_6::call(self: *mut Closure_6, Mask: *mut SmallVectorImpl<int>) {
        let mut UniqueInputs: SetVector<SDValue> = SetVector<SDValue> {};
        let mut UniqueConstantInputs: SetVector<SDValue> = SetVector<SDValue> {};
        for I in (*self.Inputs)[..] {
            if (*self.IsConstant).call(I) {
                UniqueConstantInputs.insert(I);
            } else if !I.isUndef() {
                UniqueInputs.insert(I);
            }
        }
        if UniqueInputs.len != size((*self.Inputs)) {
            let mut UniqueVec: *mut *mut SDValue, 0> = UniqueInputs.takeVector();
            let mut UniqueConstantVec: *mut *mut SDValue, 0> = UniqueConstantInputs.takeVector();
            let mut ConstNum: u32 = UniqueConstantVec.len;
            for Idx in Mask {
                if Idx == PoisonMaskElem {
                    continue;
                }
                let mut SrcRegIdx: u32 = Idx / self.NewElts;
                if (*self.Inputs)[SrcRegIdx].isUndef() {
                    Idx = PoisonMaskElem;
                    continue;
                }
                let mut It: *SDValue = find(UniqueConstantVec, (*self.Inputs)[SrcRegIdx]);
                if It != UniqueConstantVec.end() {
                    Idx = (Idx % self.NewElts) + self.NewElts * distance(UniqueConstantVec.begin(), It);
                    assert!(Idx >= 0, "Expected defined mask idx.");
                    continue;
                }
                let mut RegIt: *SDValue = find(UniqueVec, (*self.Inputs)[SrcRegIdx]);
                assert!(RegIt != UniqueVec.end(), "Cannot find non-const value.");
                Idx = (Idx % self.NewElts) + self.NewElts * (distance(UniqueVec.begin(), RegIt) + ConstNum);
                assert!(Idx >= 0, "Expected defined mask idx.");
            }
            copy(UniqueConstantVec, begin((*self.Inputs)));
            copy(UniqueVec, next(begin((*self.Inputs)), ConstNum));
        }
    }

struct Closure_7 {
    UsedIdx: *mut i32,
    SecondIteration: *mut bool,
}

unsafe fn Closure_7::call(self: *mut Closure_7, Idx: u32) -> bool {
            if (*self.UsedIdx) < 0 {
                (*self.UsedIdx) = Idx;
                return false;
            }
            if (*self.UsedIdx) >= 0 && (*self.UsedIdx) as u32 == Idx {
                (*self.SecondIteration) = true;
            }
            return (*self.SecondIteration);
        }

