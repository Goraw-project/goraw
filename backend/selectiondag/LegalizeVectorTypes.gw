fn DAGTypeLegalizer::ScalarizeVectorResult(self, N: *mut SDNode, ResNo: u32) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalize-types", 1) {
            dbgs() << "Scalarize node result " << ResNo << ": ";
            N.dump(&mut self.DAG);
        }
    }
        if !(false) { break; }
    }
    let mut R: SDValue = SDValue {};
    if self.CustomLowerNode(N, N.getValueType(ResNo), true) {
        return;
    }
    match N.getOpcode() {
        _ => {
            dbgs() << "ScalarizeVectorResult #" << ResNo << ": ";
        },
        LOOP_DEPENDENCE_WAR_MASK => {
            LOOP_DEPENDENCE_RAW_MASK;
        },
        MERGE_VALUES => {
            R = self.ScalarizeVecRes_MERGE_VALUES(N, ResNo);
        },
        BITCAST => {
            R = self.ScalarizeVecRes_BITCAST(N);
        },
        SPLAT_VECTOR => {
            BUILD_VECTOR;
        },
        EXTRACT_SUBVECTOR => {
            R = self.ScalarizeVecRes_EXTRACT_SUBVECTOR(N);
        },
        FP_ROUND => {
            R = self.ScalarizeVecRes_FP_ROUND(N);
        },
        CONVERT_FROM_ARBITRARY_FP => {
            R = self.ScalarizeVecRes_CONVERT_FROM_ARBITRARY_FP(N);
        },
        CONVERT_TO_ARBITRARY_FP => {
            R = self.ScalarizeVecRes_CONVERT_TO_ARBITRARY_FP(N);
        },
        AssertZext => {
            AssertSext;
        },
        INSERT_VECTOR_ELT => {
            R = self.ScalarizeVecRes_INSERT_VECTOR_ELT(N);
        },
        ATOMIC_LOAD => {
            R = self.ScalarizeVecRes_ATOMIC_LOAD(cast(N));
        },
        LOAD => {
            R = self.ScalarizeVecRes_LOAD(cast(N));
        },
        SCALAR_TO_VECTOR => {
            R = self.ScalarizeVecRes_SCALAR_TO_VECTOR(N);
        },
        VECTOR_DEINTERLEAVE => {
            VECTOR_INTERLEAVE;
        },
        SIGN_EXTEND_INREG => {
            R = self.ScalarizeVecRes_InregOp(N);
        },
        VSELECT => {
            R = self.ScalarizeVecRes_VSELECT(N);
        },
        SELECT => {
            R = self.ScalarizeVecRes_SELECT(N);
        },
        SELECT_CC => {
            R = self.ScalarizeVecRes_SELECT_CC(N);
        },
        SETCC => {
            R = self.ScalarizeVecRes_SETCC(N);
        },
        VECTOR_MATCH => {
            R = self.ScalarizeVecRes_VECTOR_MATCH(N);
        },
        POISON => {
            UNDEF;
        },
        VECTOR_SHUFFLE => {
            R = self.ScalarizeVecRes_VECTOR_SHUFFLE(N);
        },
        IS_FPCLASS => {
            R = self.ScalarizeVecRes_IS_FPCLASS(N);
        },
        ANY_EXTEND_VECTOR_INREG => {
            SIGN_EXTEND_VECTOR_INREG;
        },
        ABS => {
            ABS_MIN_POISON;
        },
        ADDRSPACECAST => {
            R = self.ScalarizeVecRes_ADDRSPACECAST(N);
        },
        FMODF => {
            FFREXP;
        },
        ADD => {
            AND;
        },
        MASKED_UDIV => {
            MASKED_SDIV;
        },
        FLDEXP => {
            R = self.ScalarizeVecRes_FPOp_MultiType(N);
        },
        SCMP => {
            UCMP;
        },
        FMA => {
            FSHL;
        },
        STRICT_FADD => {
            STRICT_FSUB;
        },
        FP_TO_UINT_SAT => {
            FP_TO_SINT_SAT;
        },
        UADDO => {
            SADDO;
        },
        SMULFIX => {
            SMULFIXSAT;
        },
    }
    if R.getNode() {
        self.SetScalarizedVector(SDValue { Node: N, ResNo: ResNo }, R);
    }
}

fn DAGTypeLegalizer::ScalarizeVecRes_BinOp(self, N: *mut SDNode) -> SDValue {
    let mut LHS: SDValue = self.GetScalarizedVector(N.getOperand(0));
    let mut RHS: SDValue = self.GetScalarizedVector(N.getOperand(1));
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, LHS.getValueType(), LHS, RHS, N.getFlags());
}

fn DAGTypeLegalizer::ScalarizeVecRes_MaskedBinOp(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut LHS: SDValue = self.GetScalarizedVector(N.getOperand(0));
    let mut RHS: SDValue = self.GetScalarizedVector(N.getOperand(1));
    let mut Mask: SDValue = N.getOperand(2);
    let mut MaskVT: EVT = Mask.getValueType();
    if self.getTypeAction(MaskVT) == TypeScalarizeVector {
        Mask = self.GetScalarizedVector(Mask);
    } else {
        Mask = self.DAG.getExtractVectorElt(DL, MaskVT.getVectorElementType(), Mask, 0);
    }
    Mask = self.DAG.getNode(TRUNCATE, DL, EVT { i1 }, Mask);
    let mut Divisor: SDValue = self.DAG.getSelect(DL, LHS.getValueType(), Mask, RHS, self.DAG.getConstant(1, DL, LHS.getValueType(), false, false), SDNodeFlags { Flags: None });
    return self.DAG.getNode(getUnmaskedBinOpOpcode(N.getOpcode()), DL, LHS.getValueType(), LHS, Divisor);
}

fn DAGTypeLegalizer::ScalarizeVecRes_CMP(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    if self.getTypeAction(LHS.getValueType()) == TypeScalarizeVector {
        LHS = self.GetScalarizedVector(LHS);
        RHS = self.GetScalarizedVector(RHS);
    } else {
        let mut VT: EVT = LHS.getValueType().getVectorElementType();
        LHS = self.DAG.getExtractVectorElt(DL, VT, LHS, 0);
        RHS = self.DAG.getExtractVectorElt(DL, VT, RHS, 0);
    }
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, N.getValueType(0).getVectorElementType(), LHS, RHS);
}

fn DAGTypeLegalizer::ScalarizeVecRes_TernaryOp(self, N: *mut SDNode) -> SDValue {
    let mut Op0: SDValue = self.GetScalarizedVector(N.getOperand(0));
    let mut Op1: SDValue = self.GetScalarizedVector(N.getOperand(1));
    let mut Op2: SDValue = self.GetScalarizedVector(N.getOperand(2));
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, Op0.getValueType(), Op0, Op1, Op2, N.getFlags());
}

fn DAGTypeLegalizer::ScalarizeVecRes_FIX(self, N: *mut SDNode) -> SDValue {
    let mut Op0: SDValue = self.GetScalarizedVector(N.getOperand(0));
    let mut Op1: SDValue = self.GetScalarizedVector(N.getOperand(1));
    let mut Op2: SDValue = N.getOperand(2);
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, Op0.getValueType(), Op0, Op1, Op2, N.getFlags());
}

fn DAGTypeLegalizer::ScalarizeVecRes_UnaryOpWithTwoResults(self, N: *mut SDNode, ResNo: u32) -> SDValue {
    assert!(N.getValueType(0).getVectorNumElements() == 1, "Unexpected vector type!");
    let mut Elt: SDValue = self.GetScalarizedVector(N.getOperand(0));
    let mut VT0: EVT = N.getValueType(0);
    let mut VT1: EVT = N.getValueType(1);
    let mut dl: SDLoc = SDLoc { N };
    let mut ScalarNode: *mut SDNode = self.DAG.getNode(N.getOpcode(), dl, ArrayRef<EVT> { [VT0.getScalarType(), VT1.getScalarType()] }, ArrayRef<SDValue> { Elt }).getNode();
    let mut OtherNo: u32 = 1 - ResNo;
    let mut OtherVT: EVT = N.getValueType(OtherNo);
    if self.getTypeAction(OtherVT) == TypeScalarizeVector {
        self.SetScalarizedVector(SDValue { Node: N, ResNo: OtherNo }, SDValue { Node: ScalarNode, ResNo: OtherNo });
    } else {
        let mut OtherVal: SDValue = self.DAG.getNode(SCALAR_TO_VECTOR, dl, OtherVT, SDValue { Node: ScalarNode, ResNo: OtherNo });
        self.ReplaceValueWith(SDValue { Node: N, ResNo: OtherNo }, OtherVal);
    }
    return SDValue { Node: ScalarNode, ResNo: ResNo };
}

fn DAGTypeLegalizer::ScalarizeVecRes_StrictFPOp(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0).getVectorElementType();
    let mut NumOpers: u32 = N.getNumOperands();
    let mut Chain: SDValue = N.getOperand(0);
    let mut ValueVTs: [2]EVT = [VT, EVT { Other }];
    let mut dl: SDLoc = SDLoc { N };
    let mut Opers: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { NumOpers };
    Opers[0] = Chain;
    for let mut i: u32 = 1; i < NumOpers; i += 1 {
        let mut Oper: SDValue = N.getOperand(i);
        let mut OperVT: EVT = Oper.getValueType();
        if OperVT.isVector() {
            if self.getTypeAction(OperVT) == TypeScalarizeVector {
                Oper = self.GetScalarizedVector(Oper);
            } else {
                Oper = self.DAG.getExtractVectorElt(dl, OperVT.getVectorElementType(), Oper, 0);
            }
        }
        Opers[i] = Oper;
    }
    let mut Result: SDValue = self.DAG.getNode(N.getOpcode(), dl, self.DAG.getVTList(ArrayRef<EVT> { ValueVTs }), ArrayRef<SDValue> { Opers }, N.getFlags());
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Result.getValue(1));
    return Result;
}

fn DAGTypeLegalizer::ScalarizeVecRes_OverflowOp(self, N: *mut SDNode, ResNo: u32) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut ResVT: EVT = N.getValueType(0);
    let mut OvVT: EVT = N.getValueType(1);
    let mut ScalarLHS: SDValue = SDValue {};
    let mut ScalarRHS: SDValue = SDValue {};
    if self.getTypeAction(ResVT) == TypeScalarizeVector {
        ScalarLHS = self.GetScalarizedVector(N.getOperand(0));
        ScalarRHS = self.GetScalarizedVector(N.getOperand(1));
    } else {
        let mut ElemsLHS: SmallVector<SDValue, 1> = SmallVector<SDValue, 1> {};
        let mut ElemsRHS: SmallVector<SDValue, 1> = SmallVector<SDValue, 1> {};
        self.DAG.ExtractVectorElements(N.getOperand(0), ElemsLHS, 0, 0, EVT {});
        self.DAG.ExtractVectorElements(N.getOperand(1), ElemsRHS, 0, 0, EVT {});
        ScalarLHS = ElemsLHS[0];
        ScalarRHS = ElemsRHS[0];
    }
    let mut ScalarVTs: SDVTList = self.DAG.getVTList(ResVT.getVectorElementType(), OvVT.getVectorElementType());
    let mut ScalarNode: *mut SDNode = self.DAG.getNode(N.getOpcode(), DL, ScalarVTs, ArrayRef<SDValue> { [ScalarLHS, ScalarRHS] }, N.getFlags()).getNode();
    let mut OtherNo: u32 = 1 - ResNo;
    let mut OtherVT: EVT = N.getValueType(OtherNo);
    if self.getTypeAction(OtherVT) == TypeScalarizeVector {
        self.SetScalarizedVector(SDValue { Node: N, ResNo: OtherNo }, SDValue { Node: ScalarNode, ResNo: OtherNo });
    } else {
        let mut OtherVal: SDValue = self.DAG.getNode(SCALAR_TO_VECTOR, DL, OtherVT, SDValue { Node: ScalarNode, ResNo: OtherNo });
        self.ReplaceValueWith(SDValue { Node: N, ResNo: OtherNo }, OtherVal);
    }
    return SDValue { Node: ScalarNode, ResNo: ResNo };
}

fn DAGTypeLegalizer::ScalarizeVecRes_MERGE_VALUES(self, N: *mut SDNode, ResNo: u32) -> SDValue {
    let mut Op: SDValue = self.DisintegrateMERGE_VALUES(N, ResNo);
    return self.GetScalarizedVector(Op);
}

fn DAGTypeLegalizer::ScalarizeVecRes_LOOP_DEPENDENCE_MASK(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Mask: SDValue = self.TLI.expandLoopDependenceMask(N, self.DAG);
    return self.DAG.getNode(EXTRACT_VECTOR_ELT, SDLoc { N }, N.getValueType(0).getScalarType(), Mask, self.DAG.getVectorIdxConstant(0, DL, false));
}

fn DAGTypeLegalizer::ScalarizeVecRes_BITCAST(self, N: *mut SDNode) -> SDValue {
    let mut Op: SDValue = N.getOperand(0);
    if self.getTypeAction(Op.getValueType()) == TypeScalarizeVector {
        Op = self.GetScalarizedVector(Op);
    }
    let mut NewVT: EVT = N.getValueType(0).getVectorElementType();
    return self.DAG.getNode(BITCAST, SDLoc { N }, NewVT, Op);
}

fn DAGTypeLegalizer::ScalarizeVecRes_BUILD_VECTOR_OR_SPLAT(self, N: *mut SDNode) -> SDValue {
    let mut EltVT: EVT = N.getValueType(0).getVectorElementType();
    let mut InOp: SDValue = N.getOperand(0);
    if EltVT.isInteger() {
        return self.DAG.getNode(TRUNCATE, SDLoc { N }, EltVT, InOp);
    }
    return InOp;
}

fn DAGTypeLegalizer::ScalarizeVecRes_EXTRACT_SUBVECTOR(self, N: *mut SDNode) -> SDValue {
    return self.DAG.getNode(EXTRACT_VECTOR_ELT, SDLoc { N }, N.getValueType(0).getVectorElementType(), N.getOperand(0), N.getOperand(1));
}

fn DAGTypeLegalizer::ScalarizeVecRes_FP_ROUND(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Op: SDValue = N.getOperand(0);
    let mut OpVT: EVT = Op.getValueType();
    if self.getTypeAction(OpVT) == TypeScalarizeVector {
        Op = self.GetScalarizedVector(Op);
    } else {
        let mut VT: EVT = OpVT.getVectorElementType();
        Op = self.DAG.getExtractVectorElt(DL, VT, Op, 0);
    }
    return self.DAG.getNode(FP_ROUND, DL, N.getValueType(0).getVectorElementType(), Op, N.getOperand(1));
}

fn DAGTypeLegalizer::ScalarizeVecRes_CONVERT_FROM_ARBITRARY_FP(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Op: SDValue = N.getOperand(0);
    let mut OpVT: EVT = Op.getValueType();
