struct Closure_12 {
    N: *mut *mut SDNode,
    ResNo: *mut u32,
    cap_2: *mut DAGTypeLegalizer,
    Res: *mut SDValue,
}

unsafe fn Closure_12::call(self: *mut Closure_12) -> bool {
        let mut ResVT: EVT = (*self.N).getValueType((*self.ResNo));
        let mut WideVecVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), ResVT);
        let mut VT0: EVT = (*self.N).getValueType(0);
        if !self.TLI.isOperationLegalOrCustomOrPromote((*self.N).getOpcode(), WideVecVT, false) && self.TLI.isOperationExpandOrLibCall((*self.N).getOpcode(), VT0.getScalarType()) {
            let mut Unrolled: SDValue = self.DAG.UnrollVectorOp((*self.N), WideVecVT.getVectorNumElements());
            (*self.Res) = Unrolled.getValue((*self.ResNo));
            if (*self.N).getNumValues() > 1 {
                self.ReplaceOtherWidenResults((*self.N), Unrolled.getNode(), (*self.ResNo));
            }
            return true;
        }
        return false;
    }

struct Closure_13 {
    N: *mut *mut SDNode,
    cap_1: *mut DAGTypeLegalizer,
