    } else {
        let mut VT: EVT = OpVT.getVectorElementType();
        Op = self.DAG.getExtractVectorElt(DL, VT, Op, 0);
    }
    return self.DAG.getNode(CONVERT_FROM_ARBITRARY_FP, DL, N.getValueType(0).getVectorElementType(), Op, N.getOperand(1));
}

fn DAGTypeLegalizer::ScalarizeVecRes_CONVERT_TO_ARBITRARY_FP(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Op: SDValue = N.getOperand(0);
    let mut OpVT: EVT = Op.getValueType();
    if self.getTypeAction(OpVT) == TypeScalarizeVector {
        Op = self.GetScalarizedVector(Op);
    } else {
        let mut VT: EVT = OpVT.getVectorElementType();
        Op = self.DAG.getExtractVectorElt(DL, VT, Op, 0);
    }
    return self.DAG.getNode(CONVERT_TO_ARBITRARY_FP, DL, N.getValueType(0).getVectorElementType(), Op, N.getOperand(1), N.getOperand(2), N.getOperand(3));
