}

unsafe fn Closure_13::call(self: *mut Closure_13, VT: EVT, Op: SDValue) -> auto {
        if (*self.N).getNumOperands() == 1 {
            return self.DAG.getNode((*self.Opcode), (*self.DL), VT, Op, (*self.Flags));
        }
        if (*self.Opcode) == CONVERT_TO_ARBITRARY_FP {
            return self.DAG.getNode((*self.Opcode), (*self.DL), VT, Op, (*self.N).getOperand(1), (*self.N).getOperand(2), (*self.N).getOperand(3), (*self.Flags));
        }
        return self.DAG.getNode((*self.Opcode), (*self.DL), VT, Op, (*self.N).getOperand(1), (*self.Flags));
    }

struct Closure_14 {
    Opcode: *mut u32,
    cap_1: *mut DAGTypeLegalizer,
    dl: *mut SDLoc,
    N: *mut *mut SDNode,
}

unsafe fn Closure_14::call(self: *mut Closure_14, VT: EVT, Op: SDValue) -> auto {
        if (*self.Opcode) == CONVERT_TO_ARBITRARY_FP {
            return self.DAG.getNode((*self.Opcode), (*self.dl), VT, Op, (*self.N).getOperand(1), (*self.N).getOperand(2), (*self.N).getOperand(3));
        }
        if (*self.Opcode) == FP_ROUND || (*self.Opcode) == CONVERT_FROM_ARBITRARY_FP {
            return self.DAG.getNode((*self.Opcode), (*self.dl), VT, Op, (*self.N).getOperand(1));
        }
        return self.DAG.getNode((*self.Opcode), (*self.dl), VT, Op);
    }
