fn FastISel::fastEmitInst_i(self, MachineInstOpcode: u32, RC: *TargetRegisterClass, Imm: u64) -> Register {
    let mut ResultReg: Register = self.createResultReg(RC);
    let mut II: *MCInstrDesc = self.TII.get(MachineInstOpcode);
    assert!(II.getNumDefs() >= 1, "instruction must define the result");
    operator(BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, self.MIMD, II, ResultReg).addImm(Imm)).setImplicitPhysRegDefsDead();
    return ResultReg;
