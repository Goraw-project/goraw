static mut NumFastIselSuccessIndependent: Statistic = Statistic { "isel", "NumFastIselSuccessIndependent", "Number of insts selected by target-independent selector" };

static mut NumFastIselSuccessTarget: Statistic = Statistic { "isel", "NumFastIselSuccessTarget", "Number of insts selected by target-specific selector" };

static mut NumFastIselDead: Statistic = Statistic { "isel", "NumFastIselDead", "Number of dead insts removed on failure" };

fn FastISel::startNewBlock(self) {
    assert!(self.LocalValueMap.is_empty(), "local values should be cleared after finishing a BB");
    self.EmitStartPt = null;
    if !self.FuncInfo.MBB.is_empty() {
        self.EmitStartPt = &mut self.FuncInfo.MBB.back();
    }
    self.LastLocalValue = self.EmitStartPt;
}

fn FastISel::finishBasicBlock(self) {
    self.flushLocalValueMap();
}

fn FastISel::lowerArguments(self) -> bool {
    if !self.FuncInfo.CanLowerReturn {
        return false;
    }
    if !self.fastLowerArguments() {
        return false;
    }
    for let mut I: const_arg_iterator = self.FuncInfo.Fn.arg_begin();
let mut E: const_arg_iterator = self.FuncInfo.Fn.arg_end(); I != E; I += 1 {
        let mut VI: iterator = self.LocalValueMap.find(&mut *I);
        assert!(VI != self.LocalValueMap.end(), "Missed an argument?");
        self.FuncInfo.ValueMap[&mut *I] = operator(VI).second;
    }
    return true;
}

fn findLocalRegDef(MI: *mut MachineInstr) -> Register {
    let mut RegDef: Register = Register { Reg: 0 };
    for MO in MI.operands() {
        if !MO.isReg() {
            continue;
        }
        if MO.isDef() {
            if RegDef.operator unsigned int() {
                return Register { Reg: 0 };
            }
            RegDef = MO.getReg();
        } else if MO.getReg().isVirtual() {
            return Register { Reg: 0 };
        }
    }
    return RegDef;
}

fn isRegUsedByPhiNodes(DefReg: Register, FuncInfo: *mut FunctionLoweringInfo) -> bool {
    for P in FuncInfo.PHINodesToUpdate {
        if P.second == DefReg {
            return true;
        }
    }
    return false;
}

fn FastISel::flushLocalValueMap(self) {
    if self.LastLocalValue != self.EmitStartPt {
        let mut FirstNonValue: iterator = iterator { self.LastLocalValue };
        operator(FirstNonValue);
        let mut RE: reverse_iterator = if self.EmitStartPt { reverse_iterator { self.EmitStartPt } } else { self.FuncInfo.MBB.rend() };
        let mut RI: reverse_iterator = reverse_iterator { self.LastLocalValue };
        for LocalMI in make_early_inc_range(make_range(RI, RE)) {
            let mut DefReg: Register = findLocalRegDef(LocalMI);
            if !DefReg.operator unsigned int() {
                continue;
            }
            if self.FuncInfo.RegsWithFixups.count(DefReg) {
                continue;
            }
            let mut UsedByPHI: bool = isRegUsedByPhiNodes(DefReg, self.FuncInfo);
            if !UsedByPHI && self.MRI.use_nodbg_empty(DefReg) {
                if self.EmitStartPt == &mut LocalMI {
                    self.EmitStartPt = self.EmitStartPt.getPrevNode();
                }
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("isel", 1) {
                        dbgs() << "removing dead local value materialization" << LocalMI;
                    }
                }
                    if !(false) { break; }
                }
                LocalMI.eraseFromParent();
            }
        }
        let mut FirstLocalValue: iterator = if self.EmitStartPt { operator(iterator { self.EmitStartPt }) } else { self.FuncInfo.MBB.begin() };
        if FirstLocalValue != FirstNonValue && !operator(FirstLocalValue).getDebugLoc() {
            if FirstNonValue != self.FuncInfo.MBB.end() {
                operator(FirstLocalValue).setDebugLoc(operator(FirstNonValue).getDebugLoc());
            } else if self.FuncInfo.MBB.getBasicBlock() {
                BB;
            } else {
                operator(FirstLocalValue).setDebugLoc(BB.getTerminator().getDebugLoc());
            }
        }
    }
    self.LocalValueMap.clear();
    self.LastLocalValue = self.EmitStartPt;
    self.recomputeInsertPt();
    self.SavedInsertPt = self.FuncInfo.InsertPt;
}

fn FastISel::getRegForValue(self, V: *Value) -> Register {
    let mut RealVT: EVT = self.TLI.getValueType(self.DL, V.getType(), true);
    if !RealVT.isSimple() {
        return Register { Reg: 0 };
    }
    let mut VT: MVT = RealVT.getSimpleVT();
    if !self.TLI.isTypeLegal(EVT { VT }) {
        if VT == i1 || VT == i8 || VT == i16 {
            VT = self.TLI.getTypeToTransformTo(V.getContext(), EVT { VT }).getSimpleVT();
        } else {
            return Register { Reg: 0 };
        }
    }
    let mut Reg: Register = self.lookUpRegForValue(V);
    if Reg.operator unsigned int() {
        return Reg;
    }
    if isa(V) && (!isa(V) || !self.FuncInfo.StaticAllocaMap.count(cast(V))) {
        return self.FuncInfo.InitializeRegForValue(V);
    }
    let mut SaveInsertPt: SavePoint = self.enterLocalValueArea();
    Reg = self.materializeRegForValue(V, VT);
    self.leaveLocalValueArea(SavePoint { SaveInsertPt });
    return Reg;
}

fn FastISel::materializeConstant(self, V: *Value, VT: MVT) -> Register {
    let mut Reg: Register = Register { Reg: 0 };
    if dyn_cast(V) {
        CI;
    } else {
        if CI.getValue().getActiveBits() <= 64 {
            Reg = self.fastEmit_i(VT, VT, Constant, CI.getZExtValue());
        }
    }
    return Reg;
}

fn FastISel::materializeRegForValue(self, V: *Value, VT: MVT) -> Register {
    let mut Reg: Register = Register { Reg: 0 };
    if isa(V) {
        Reg = self.fastMaterializeConstant(cast(V));
    }
    if !Reg.operator unsigned int() {
        Reg = self.materializeConstant(V, VT);
    }
    if Reg.operator unsigned int() {
        self.LocalValueMap[V] = Reg;
        self.LastLocalValue = self.MRI.getVRegDef(Reg);
    }
    return Reg;
}

fn FastISel::lookUpRegForValue(self, V: *Value) -> Register {
    let mut I: iterator = self.FuncInfo.ValueMap.find(V);
    if I != self.FuncInfo.ValueMap.end() {
        return operator(I).second;
    }
    return self.LocalValueMap[V];
}

fn FastISel::updateValueMap(self, I: *Value, Reg: Register, NumRegs: u32) {
    if !isa(I) {
        self.LocalValueMap[I] = Reg;
        return;
    }
    let mut AssignedReg: *mut Register = self.FuncInfo.ValueMap[I];
    if !AssignedReg.operator unsigned int() {
        AssignedReg = Reg;
    } else if Reg != AssignedReg {
        for let mut i: u32 = 0; i < NumRegs; i += 1 {
            self.FuncInfo.RegFixups[Register { Reg: AssignedReg.operator unsigned int() + i }] = Register { Reg: Reg.operator unsigned int() + i };
            self.FuncInfo.RegsWithFixups.insert(Register { Reg: Reg.operator unsigned int() + i });
        }
        AssignedReg = Reg;
    }
}

fn FastISel::getRegForGEPIndex(self, PtrVT: MVT, Idx: *Value) -> Register {
    let mut IdxN: Register = self.getRegForValue(Idx);
    if !IdxN.operator unsigned int() {
        return Register { Reg: 0 };
    }
    let mut IdxVT: EVT = getEVT(Idx.getType(), false);
    if IdxVT.bitsLT(EVT { PtrVT }) {
        IdxN = self.fastEmit_r(IdxVT.getSimpleVT(), PtrVT, SIGN_EXTEND, IdxN);
    } else if IdxVT.bitsGT(EVT { PtrVT }) {
        IdxN = self.fastEmit_r(IdxVT.getSimpleVT(), PtrVT, TRUNCATE, IdxN);
    }
    return IdxN;
}

fn FastISel::recomputeInsertPt(self) {
    if self.getLastLocalValue() {
        self.FuncInfo.InsertPt = MachineInstr> { self.getLastLocalValue() };
        self.FuncInfo.MBB = operator(self.FuncInfo.InsertPt).getParent();
        operator(self.FuncInfo.InsertPt);
    } else {
        self.FuncInfo.InsertPt = self.FuncInfo.MBB.getFirstNonPHI();
    }
}

fn FastISel::removeDeadCode(self, I: iterator, E: iterator) {
    assert!(I.isValid() && E.isValid() && distance(I, E) > 0, "Invalid iterator!");
    while I != E {
        if self.SavedInsertPt == I {
            self.SavedInsertPt = E;
        }
        if self.EmitStartPt == I {
            self.EmitStartPt = if E.isValid() { &mut operator(E) } else { null };
        }
        if self.LastLocalValue == I {
            self.LastLocalValue = if E.isValid() { &mut operator(E) } else { null };
        }
        let mut Dead: *mut MachineInstr = &mut operator(I);
        operator(I);
        Dead.eraseFromParent();
        operator(NumFastIselDead);
    }
    self.recomputeInsertPt();
}

fn FastISel::enterLocalValueArea(self) -> SavePoint {
    let mut OldInsertPt: SavePoint = SavePoint { self.FuncInfo.InsertPt };
    self.recomputeInsertPt();
    return OldInsertPt;
}

fn FastISel::leaveLocalValueArea(self, OldInsertPt: SavePoint) {
    if self.FuncInfo.InsertPt != self.FuncInfo.MBB.begin() {
        self.LastLocalValue = &mut operator(prev(self.FuncInfo.InsertPt, 1));
    }
    self.FuncInfo.InsertPt = OldInsertPt;
}

fn FastISel::selectBinaryOp(self, I: *User, ISDOpcode: u32) -> bool {
    let mut VT: EVT = getEVT(I.getType(), true);
    if VT == EVT { Other } || !VT.isSimple() {
        return false;
    }
    if !self.TLI.isTypeLegal(VT) {
        if VT == EVT { i1 } && isBitwiseLogicOp(ISDOpcode) {
            VT = self.TLI.getTypeToTransformTo(I.getContext(), VT);
        } else {
            return false;
        }
    }
    if dyn_cast(I.getOperand(0)) {
        CI;
    } else if isa(I) && cast(I).isCommutative() {
        let mut Op1: Register = self.getRegForValue(I.getOperand(1));
        if !Op1.operator unsigned int() {
            return false;
        }
        let mut ResultReg: Register = self.fastEmit_ri_(VT.getSimpleVT(), ISDOpcode, Op1, CI.getZExtValue(), VT.getSimpleVT());
        if !ResultReg.operator unsigned int() {
            return false;
        }
        self.updateValueMap(I, ResultReg, 1);
        return true;
    }
    let mut Op0: Register = self.getRegForValue(I.getOperand(0));
    if !Op0.operator unsigned int() {
        return false;
    }
    if dyn_cast(I.getOperand(1)) {
        CI;
    } else {
        let mut Imm: u64 = CI.getSExtValue();
        if ISDOpcode == SDIV && isa(I) && cast(I).isExact() && isPowerOf2_64(Imm) {
            Imm = Log2_64(Imm);
            ISDOpcode = SRA;
        }
        if ISDOpcode == UREM && isa(I) && isPowerOf2_64(Imm) {
            Imm -= 1;
            ISDOpcode = AND;
        }
        let mut ResultReg: Register = self.fastEmit_ri_(VT.getSimpleVT(), ISDOpcode, Op0, Imm, VT.getSimpleVT());
        if !ResultReg.operator unsigned int() {
            return false;
        }
        self.updateValueMap(I, ResultReg, 1);
        return true;
    }
    let mut Op1: Register = self.getRegForValue(I.getOperand(1));
    if !Op1.operator unsigned int() {
        return false;
    }
    let mut ResultReg: Register = self.fastEmit_rr(VT.getSimpleVT(), VT.getSimpleVT(), ISDOpcode, Op0, Op1);
    if !ResultReg.operator unsigned int() {
        return false;
    }
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn FastISel::selectGetElementPtr(self, I: *User) -> bool {
    let mut N: Register = self.getRegForValue(I.getOperand(0));
    if !N.operator unsigned int() {
        return false;
    }
    if isa(I.getType()) {
        return false;
    }
    let mut TotalOffs: u64 = 0;
    let mut MaxOffs: u64 = 2048;
    let mut VT: MVT = self.TLI.getValueType(self.DL, I.getType(), false).getSimpleVT();
    for let mut GTI: gep_type_iterator = gep_type_begin(I);
let mut E: gep_type_iterator = gep_type_end(I); GTI != E; operator(GTI) {
        let mut Idx: *Value = GTI.getOperand();
        if GTI.getStructTypeOrNull() {
            StTy;
        } else {
            let mut Field: u64 = cast(Idx).getZExtValue();
            if Field {
                TotalOffs += self.DL.getStructLayout(StTy).getElementOffset(Field).operator unsigned long long();
                if TotalOffs >= MaxOffs {
                    N = self.fastEmit_ri_(VT, ADD, N, TotalOffs, VT);
                    if !N.operator unsigned int() {
                        return false;
                    }
                    TotalOffs = 0;
                }
            }
        }
    }
    if TotalOffs {
        N = self.fastEmit_ri_(VT, ADD, N, TotalOffs, VT);
        if !N.operator unsigned int() {
            return false;
        }
    }
    self.updateValueMap(I, N, 1);
    return true;
}

fn FastISel::addStackMapLiveVars(self, Ops: *mut SmallVectorImpl<MachineOperand>, CI: *CallInst, StartIdx: u32) -> bool {
    for let mut i: u32 = StartIdx;
let mut e: u32 = CI.arg_size(); i != e; i += 1 {
        let mut Val: *mut Value = CI.getArgOperand(i);
        if dyn_cast(Val) {
            C;
        } else {
            Ops.push(CreateImm(ConstantOp));
            Ops.push(CreateImm(C.getSExtValue()));
        }
    }
    return true;
}

fn FastISel::selectStackmap(self, I: *CallInst) -> bool {
    assert!(I.getCalledFunction().getReturnType().isVoidTy(), "Stackmap cannot return a value.");
    let mut Ops: SmallVector<MachineOperand, 32> = SmallVector<MachineOperand, 32> {};
    assert!(isa(I.getOperand(IDPos)), "Expected a constant integer.");
    let mut ID: *ConstantInt const = cast(I.getOperand(IDPos));
    Ops.push(CreateImm(ID.getZExtValue()));
    assert!(isa(I.getOperand(NBytesPos)), "Expected a constant integer.");
    let mut NumBytes: *ConstantInt const = cast(I.getOperand(NBytesPos));
    Ops.push(CreateImm(NumBytes.getZExtValue()));
    if !self.addStackMapLiveVars(Ops, I, 2) {
        return false;
    }
    let mut CC: ID = I.getCallingConv();
    let mut ScratchRegs: *MCPhysReg = self.TLI.getScratchRegisters(CC);
    for let mut i: u32 = 0; ScratchRegs[i]; i += 1 {
        Ops.push(CreateReg(Register { Reg: ScratchRegs[i] }, true, true, false, false, false, true, 0, false, false, false));
    }
    let mut AdjStackDown: u32 = self.TII.getCallFrameSetupOpcode();
    let mut Builder: MachineInstrBuilder = BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, self.MIMD, self.TII.get(AdjStackDown));
    let mut MCID: *MCInstrDesc = Builder.getInstr().getDesc();
    for let mut I: u32 = 0;
let mut E: u32 = MCID.getNumOperands(); I < E; I += 1 {
        Builder.addImm(0);
    }
    let mut MIB: MachineInstrBuilder = BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, self.MIMD, self.TII.get(STACKMAP));
    for MO in Ops {
        MIB.add(MO);
    }
    let mut AdjStackUp: u32 = self.TII.getCallFrameDestroyOpcode();
    BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, self.MIMD, self.TII.get(AdjStackUp)).addImm(0).addImm(0);
    self.FuncInfo.MF.getFrameInfo().setHasStackMap(true);
    return true;
}

fn FastISel::lowerCallOperands(self, CI: *CallInst, ArgIdx: u32, NumArgs: u32, Callee: *Value, ForceRetVoidTy: bool, CLI: *mut CallLoweringInfo) -> bool {
    let mut Args: ArgListTy = ArgListTy {};
    Args.reserve(NumArgs);
    for let mut ArgI: u32 = ArgIdx;
let mut ArgE: u32 = ArgIdx + NumArgs; ArgI != ArgE; ArgI += 1 {
        let mut V: *mut Value = CI.getOperand(ArgI);
        assert!(!V.getType().isEmptyTy(), "Empty type passed to intrinsic.");
        let mut Entry: ArgListEntry = ArgListEntry { V, SDValue {} };
        Entry.setAttributes(CI, ArgI);
        Args.push(Entry);
    }
    let mut RetTy: *mut Type = if ForceRetVoidTy { getVoidTy(CI.getType().getContext()) } else { CI.getType() };
    CLI.setCallee(CI.getCallingConv(), RetTy, Callee, move(Args), NumArgs);
    return self.lowerCallTo(CLI);
}

fn CallLoweringInfo@FastISel@llvm::setCallee(self, DL: *DataLayout, Ctx: *mut MCContext, CC: ID, ResultTy: *mut Type, Target: str, ArgsList: *mut *mut ArgListTy, FixedArgs: u32) -> *mut CallLoweringInfo {
    let mut MangledName: str = "";
    getNameWithPrefix(MangledName, Target, DL);
    let mut Sym: *mut MCSymbol = Ctx.getOrCreateSymbol(MangledName);
    return self.setCallee(CC, ResultTy, Sym, move(ArgsList), FixedArgs);
}

fn FastISel::selectPatchpoint(self, I: *CallInst) -> bool {
    let mut CC: ID = I.getCallingConv();
    let mut IsAnyRegCC: bool = CC == AnyReg;
    let mut HasDef: bool = !I.getType().isVoidTy();
    let mut Callee: *mut Value = I.getOperand(TargetPos).stripPointerCasts();
    let mut ValueType: MVT = MVT {};
    if IsAnyRegCC && HasDef {
        ValueType = self.TLI.getSimpleValueType(self.DL, I.getType(), true);
        if ValueType == Other {
            return false;
        }
    }
    assert!(isa(I.getOperand(NArgPos)), "Expected a constant integer.");
    let mut NumArgsVal: *ConstantInt const = cast(I.getOperand(NArgPos));
    let mut NumArgs: u32 = NumArgsVal.getZExtValue();
    let mut NumMetaOpers: u32 = CCPos;
    assert!(I.arg_size() >= NumMetaOpers + NumArgs, "Not enough arguments provided to the patchpoint intrinsic");
    let mut NumCallArgs: u32 = if IsAnyRegCC { 0 } else { NumArgs };
    let mut CLI: CallLoweringInfo = CallLoweringInfo {};
    CLI.setIsPatchPoint(true);
    if !self.lowerCallOperands(I, NumMetaOpers, NumCallArgs, Callee, IsAnyRegCC, CLI) {
        return false;
    }
    assert!(CLI.Call, "No call instruction specified.");
    let mut Ops: SmallVector<MachineOperand, 32> = SmallVector<MachineOperand, 32> {};
    if IsAnyRegCC && HasDef {
        assert!(CLI.NumResultRegs == 0, "Unexpected result register.");
        assert!(ValueType.isValid());
        CLI.ResultReg = self.createResultReg(self.TLI.getRegClassFor(ValueType, false));
        CLI.NumResultRegs = 1;
        Ops.push(CreateReg(CLI.ResultReg, true, false, false, false, false, false, 0, false, false, false));
    }
    assert!(isa(I.getOperand(IDPos)), "Expected a constant integer.");
    let mut ID: *ConstantInt const = cast(I.getOperand(IDPos));
    Ops.push(CreateImm(ID.getZExtValue()));
    assert!(isa(I.getOperand(NBytesPos)), "Expected a constant integer.");
    let mut NumBytes: *ConstantInt const = cast(I.getOperand(NBytesPos));
    Ops.push(CreateImm(NumBytes.getZExtValue()));
    if dyn_cast(Callee) {
        C;
    } else {
        let mut CalleeConstAddr: u64 = cast(C.getOperand(0)).getZExtValue();
        Ops.push(CreateImm(CalleeConstAddr));
    }
    let mut NumCallRegArgs: u32 = if IsAnyRegCC { NumArgs } else { CLI.OutRegs.len };
    Ops.push(CreateImm(NumCallRegArgs));
    Ops.push(CreateImm(CC as u32));
    if IsAnyRegCC {
        for let mut i: u32 = NumMetaOpers;
let mut e: u32 = NumMetaOpers + NumArgs; i != e; i += 1 {
            let mut Reg: Register = self.getRegForValue(I.getArgOperand(i));
            if !Reg.operator unsigned int() {
                return false;
            }
            Ops.push(CreateReg(Reg, false, false, false, false, false, false, 0, false, false, false));
        }
    }
    for Reg in CLI.OutRegs {
        Ops.push(CreateReg(Reg, false, false, false, false, false, false, 0, false, false, false));
    }
    if !self.addStackMapLiveVars(Ops, I, NumMetaOpers + NumArgs) {
        return false;
    }
    Ops.push(CreateRegMask(self.TRI.getCallPreservedMask(*self.FuncInfo.MF, CC)));
    let mut ScratchRegs: *MCPhysReg = self.TLI.getScratchRegisters(CC);
    for let mut i: u32 = 0; ScratchRegs[i]; i += 1 {
        Ops.push(CreateReg(Register { Reg: ScratchRegs[i] }, true, true, false, false, false, true, 0, false, false, false));
    }
    for Reg in CLI.InRegs {
        Ops.push(CreateReg(Reg, true, true, false, false, false, false, 0, false, false, false));
    }
    let mut MIB: MachineInstrBuilder = BuildMI(*self.FuncInfo.MBB, CLI.Call, self.MIMD, self.TII.get(PATCHPOINT));
    for MO in Ops {
        MIB.add(MO);
    }
    operator(MIB).setPhysRegsDeadExcept(ArrayRef<Register> { CLI.InRegs }, self.TRI);
    CLI.Call.eraseFromParent();
    self.FuncInfo.MF.getFrameInfo().setHasPatchPoint(true);
    if CLI.NumResultRegs {
        self.updateValueMap(I, CLI.ResultReg, CLI.NumResultRegs);
    }
    return true;
}

fn FastISel::selectXRayCustomEvent(self, I: *CallInst) -> bool {
    let mut Triple: *Triple = self.TM.getTargetTriple();
    if Triple.isAArch64(64) && Triple.getArch() != x86_64 {
        return true;
    }
    let mut Ops: SmallVector<MachineOperand, 8> = SmallVector<MachineOperand, 8> {};
    Ops.push(CreateReg(self.getRegForValue(I.getArgOperand(0)), false, false, false, false, false, false, 0, false, false, false));
    Ops.push(CreateReg(self.getRegForValue(I.getArgOperand(1)), false, false, false, false, false, false, 0, false, false, false));
    let mut MIB: MachineInstrBuilder = BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, self.MIMD, self.TII.get(PATCHABLE_EVENT_CALL));
    for MO in Ops {
        MIB.add(MO);
    }
    return true;
}

fn FastISel::selectXRayTypedEvent(self, I: *CallInst) -> bool {
    let mut Triple: *Triple = self.TM.getTargetTriple();
    if Triple.isAArch64(64) && Triple.getArch() != x86_64 {
        return true;
    }
    let mut Ops: SmallVector<MachineOperand, 8> = SmallVector<MachineOperand, 8> {};
    Ops.push(CreateReg(self.getRegForValue(I.getArgOperand(0)), false, false, false, false, false, false, 0, false, false, false));
    Ops.push(CreateReg(self.getRegForValue(I.getArgOperand(1)), false, false, false, false, false, false, 0, false, false, false));
    Ops.push(CreateReg(self.getRegForValue(I.getArgOperand(2)), false, false, false, false, false, false, 0, false, false, false));
    let mut MIB: MachineInstrBuilder = BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, self.MIMD, self.TII.get(PATCHABLE_TYPED_EVENT_CALL));
    for MO in Ops {
        MIB.add(MO);
    }
    return true;
}

fn getReturnAttrs(CLI: *mut CallLoweringInfo) -> AttributeList {
    let mut Attrs: AttrKind, 2> = AttrKind, 2> {};
    if CLI.RetSExt {
        Attrs.push(SExt);
    }
    if CLI.RetZExt {
        Attrs.push(ZExt);
    }
    if CLI.IsInReg {
        Attrs.push(InReg);
    }
    return get(CLI.RetTy.getContext(), ReturnIndex, AttrKind> { Attrs });
}

fn FastISel::lowerCallTo(self, CI: *CallInst, SymName: *u8, NumArgs: u32) -> bool {
    let mut Ctx: *mut MCContext = self.MF.getContext();
    let mut MangledName: str = "";
    getNameWithPrefix(MangledName, SymName, self.DL);
    let mut Sym: *mut MCSymbol = Ctx.getOrCreateSymbol(MangledName);
    return self.lowerCallTo(CI, Sym, NumArgs);
}

fn FastISel::lowerCallTo(self, CI: *CallInst, Symbol: *mut MCSymbol, NumArgs: u32) -> bool {
    let mut FTy: *mut FunctionType = CI.getFunctionType();
    let mut RetTy: *mut Type = CI.getType();
    let mut Args: ArgListTy = ArgListTy {};
    Args.reserve(NumArgs);
    for let mut ArgI: u32 = 0; ArgI != NumArgs; ArgI += 1 {
        let mut V: *mut Value = CI.getOperand(ArgI);
        assert!(!V.getType().isEmptyTy(), "Empty type passed to intrinsic.");
        let mut Entry: ArgListEntry = ArgListEntry { V, SDValue {} };
        Entry.setAttributes(CI, ArgI);
        Args.push(Entry);
    }
    self.TLI.markLibCallAttributes(self.MF, CI.getCallingConv(), Args);
    let mut CLI: CallLoweringInfo = CallLoweringInfo {};
    CLI.setCallee(RetTy, FTy, Symbol, move(Args), *CI, NumArgs);
    return self.lowerCallTo(CLI);
}

fn FastISel::lowerCallTo(self, CLI: *mut CallLoweringInfo) -> bool {
    CLI.clearIns();
    let mut RetTys: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
    ComputeValueVTs(self.TLI, self.DL, CLI.RetTy, RetTys, null, null, getZero());
    let mut Outs: OutputArg, 4> = OutputArg, 4> {};
    GetReturnInfo(CLI.CallConv, CLI.RetTy, getReturnAttrs(CLI), Outs, self.TLI, self.DL);
    let mut CanLowerReturn: bool = self.TLI.CanLowerReturn(CLI.CallConv, *self.FuncInfo.MF, CLI.IsVarArg, Outs, CLI.RetTy.getContext(), CLI.RetTy);
    if !CanLowerReturn {
        return false;
    }
    for VT in RetTys {
        let mut RegisterVT: MVT = self.TLI.getRegisterType(CLI.RetTy.getContext(), VT);
        let mut NumRegs: u32 = self.TLI.getNumRegisters(CLI.RetTy.getContext(), VT, optional<MVT> { nullopt });
        for let mut i: u32 = 0; i != NumRegs; i += 1 {
            let mut Flags: ArgFlagsTy = ArgFlagsTy {};
            if CLI.RetSExt {
                Flags.setSExt();
            }
            if CLI.RetZExt {
                Flags.setZExt();
            }
            if CLI.IsInReg {
                Flags.setInReg();
            }
            let mut Ret: InputArg = InputArg { Flags: Flags, VT: RegisterVT, ArgVT: VT, OrigTy: CLI.RetTy, Used: CLI.IsReturnValueUsed, OrigArgIndex: NoArgIndex, PartOffset: 0 };
            CLI.Ins.push(Ret);
        }
    }
    CLI.clearOuts();
    for Arg in CLI.getArgs() {
        let mut FinalType: *mut Type = Arg.Ty;
        if Arg.IsByVal {
            FinalType = Arg.IndirectType;
        }
        let mut NeedsRegBlock: bool = self.TLI.functionArgumentNeedsConsecutiveRegisters(FinalType, CLI.CallConv, CLI.IsVarArg, self.DL);
        let mut Flags: ArgFlagsTy = ArgFlagsTy {};
        if Arg.IsZExt {
            Flags.setZExt();
        }
        if Arg.IsSExt {
            Flags.setSExt();
        }
        if Arg.IsInReg {
            Flags.setInReg();
        }
        if Arg.IsSRet {
            Flags.setSRet();
        }
        if Arg.IsSwiftSelf {
            Flags.setSwiftSelf();
        }
        if Arg.IsSwiftAsync {
            Flags.setSwiftAsync();
        }
        if Arg.IsSwiftError {
            Flags.setSwiftError();
        }
        if Arg.IsCFGuardTarget {
            Flags.setCFGuardTarget();
        }
        if Arg.IsByVal {
            Flags.setByVal();
        }
        if Arg.IsInAlloca {
            Flags.setInAlloca();
            Flags.setByVal();
        }
        if Arg.IsPreallocated {
            Flags.setPreallocated();
            Flags.setByVal();
        }
        let mut MemAlign: MaybeAlign = Arg.Alignment;
        if Arg.IsByVal || Arg.IsInAlloca || Arg.IsPreallocated {
            let mut FrameSize: u32 = self.DL.getTypeAllocSize(Arg.IndirectType).operator unsigned long long();
            if !MemAlign {
                MemAlign = MaybeAlign { self.TLI.getByValTypeAlignment(Arg.IndirectType, self.DL) };
            }
            Flags.setByValSize(FrameSize);
        } else if !MemAlign {
            MemAlign = MaybeAlign { self.DL.getABITypeAlign(Arg.Ty) };
        }
        Flags.setMemAlign(operator(MemAlign));
        if Arg.IsNest {
            Flags.setNest();
        }
        if NeedsRegBlock {
            Flags.setInConsecutiveRegs(true);
        }
        Flags.setOrigAlign(self.DL.getABITypeAlign(Arg.Ty));
        CLI.OutVals.push(Arg.Val);
        CLI.OutFlags.push(ValueParamT { Flags });
    }
    if !self.fastLowerCall(CLI) {
        return false;
    }
    assert!(CLI.Call, "No call instruction specified.");
    CLI.Call.setPhysRegsDeadExcept(ArrayRef<Register> { CLI.InRegs }, self.TRI);
    if CLI.NumResultRegs && CLI.CB {
        self.updateValueMap(CLI.CB, CLI.ResultReg, CLI.NumResultRegs);
    }
    if CLI.CB {
        if CLI.CB.getMetadata("heapallocsite") {
            MD;
        } else {
            CLI.Call.setHeapAllocMarker(*self.MF, MD);
        }
    }
    return true;
}

fn FastISel::lowerCall(self, CI: *CallInst) -> bool {
    let mut FuncTy: *mut FunctionType = CI.getFunctionType();
    let mut RetTy: *mut Type = CI.getType();
    let mut Args: ArgListTy = ArgListTy {};
    Args.reserve(CI.arg_size());
    for let mut i: const_op_iterator = CI.arg_begin();
let mut e: const_op_iterator = CI.arg_end(); i != e; i += 1 {
        let mut V: *mut Value = *i.operator llvm::Value *();
        if V.getType().isEmptyTy() {
            continue;
        }
        let mut Entry: ArgListEntry = ArgListEntry { V, SDValue {} };
        Entry.setAttributes(CI, i - CI.arg_begin());
        Args.push(Entry);
    }
    let mut IsTailCall: bool = CI.isTailCall();
    if IsTailCall && !isInTailCallPosition(*CI, self.TM, false) {
        IsTailCall = false;
    }
    if IsTailCall && !CI.isMustTailCall() && self.MF.getFunction().getFnAttribute("disable-tail-calls").getValueAsBool() {
        IsTailCall = false;
    }
    let mut CLI: CallLoweringInfo = CallLoweringInfo {};
    CLI.setCallee(RetTy, FuncTy, CI.getCalledOperand(), move(Args), *CI).setTailCall(IsTailCall);
    if self.lowerCallTo(CLI) {
        diagnoseDontCall(*CI);
        return true;
    }
    return false;
}

fn FastISel::selectCall(self, I: *User) -> bool {
    let mut Call: *CallInst = cast(I);
    if dyn_cast(Call.getCalledOperand()) {
        IA;
    } else {
        if !IA.getConstraintString().is_empty() {
            return false;
        }
        let mut ExtraInfo: u32 = 0;
        if IA.hasSideEffects() {
            ExtraInfo |= Extra_HasSideEffects;
        }
        if IA.isAlignStack() {
            ExtraInfo |= Extra_IsAlignStack;
        }
        if IA.canThrow() {
            ExtraInfo |= Extra_MayUnwind;
        }
        if Call.isConvergent() {
            ExtraInfo |= Extra_IsConvergent;
        }
        ExtraInfo |= IA.getDialect() * Extra_AsmDialect;
        let mut MIB: MachineInstrBuilder = BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, self.MIMD, self.TII.get(INLINEASM));
        MIB.addExternalSymbol(IA.getAsmString().ptr, 0);
        MIB.addImm(ExtraInfo);
        let mut SrcLoc: *MDNode = Call.getMetadata("srcloc");
        if SrcLoc {
            MIB.addMetadata(SrcLoc);
        }
        return true;
    }
    if dyn_cast(Call) {
        II;
    } else {
        return self.selectIntrinsicCall(II);
    }
    return self.lowerCall(Call);
}

fn FastISel::handleDbgInfo(self, II: *Instruction) {
    if !II.hasDbgRecords() {
        return;
    }
    self.MIMD = MIMetadata {};
    for DR in reverse(II.getDbgRecordRange()) {
        self.flushLocalValueMap();
        self.recomputeInsertPt();
        if dyn_cast(&mut DR) {
            DLR;
        } else {
            assert!(DLR.getLabel(), "Missing label");
            BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, MIMetadata { DL: DLR.getDebugLoc(), PCSections: null, MMRA: null, DeactivationSymbol: null }, self.TII.get(DBG_LABEL)).addMetadata(DLR.getLabel());
            continue;
        }
        let mut DVR: *mut DbgVariableRecord = cast(DR);
        let mut V: *mut Value = null;
        if !DVR.hasArgList() {
            V = DVR.getVariableLocationOp(0);
        }
        let mut Res: bool = false;
        if DVR.getType() == Value || DVR.getType() == Assign {
            Res = self.lowerDbgValue(V, DVR.getExpression(), DVR.getVariable(), DVR.getDebugLoc());
        } else {
            assert!(DVR.getType() == Declare);
            if self.FuncInfo.PreprocessedDVRDeclares.contains(&mut DVR) {
                continue;
            }
            Res = self.lowerDbgDeclare(V, DVR.getExpression(), DVR.getVariable(), DVR.getDebugLoc());
        }
        if !Res {
            while true {
                {
                if DebugFlag && isCurrentDebugType("isel", 1) {
                    dbgs() << "Dropping debug-info for " << DVR << "\n";
                }
            }
                if !(false) { break; }
            }
        }
    }
}

fn FastISel::lowerDbgValue(self, V: *Value, Expr: *mut DIExpression, Var: *mut DILocalVariable, DL: *DebugLoc) -> bool {
    let mut II: *MCInstrDesc = self.TII.get(DBG_VALUE);
    if !V || isa(V) {
        BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, DL, II, false, Register { Reg: 0 }, Var, Expr);
        return true;
    }
    if dyn_cast(V) {
        CI;
    } else {
        if Expr {
            tie(Expr, CI) = Expr.constantFold(CI);
        }
        if CI.getBitWidth() > 64 {
            BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, II).addCImm(CI).addImm(0).addMetadata(Var).addMetadata(Expr);
        } else {
            BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, II).addImm(CI.getZExtValue()).addImm(0).addMetadata(Var).addMetadata(Expr);
        }
        return true;
    }
    if dyn_cast(V) {
        CF;
    } else {
        BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, MIMetadata { DL: DL, PCSections: null, MMRA: null, DeactivationSymbol: null }, II).addFPImm(CF).addImm(0).addMetadata(Var).addMetadata(Expr);
        return true;
    }
    let mut Arg: *Argument const = dyn_cast(V);
    if Arg && Expr && Expr.isEntryValue() {
        assert!(Arg.hasAttribute(SwiftAsync));
        let mut Reg: Register = self.getRegForValue(Arg);
        for x in self.FuncInfo.RegInfo.liveins() {
            if Reg == VirtReg || Reg == PhysReg {
                BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, DL, II, false, Register { Reg: PhysReg }, Var, Expr);
                return true;
            }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("isel", 1) {
                dbgs() << "Dropping dbg.value: expression is entry_value but couldn't find a physical register\n";
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    let mut SI: iterator = self.FuncInfo.StaticAllocaMap.find(dyn_cast(V));
    if SI != self.FuncInfo.StaticAllocaMap.end() {
        let mut FrameIndexOp: MachineOperand = CreateFI(operator(SI).second);
        let mut IsIndirect: bool = false;
        BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, DL, II, IsIndirect, ArrayRef<MachineOperand> { FrameIndexOp }, Var, Expr);
        return true;
    }
    if self.lookUpRegForValue(V) {
        Reg.operator unsigned int();
    } else {
        if !self.FuncInfo.MF.useDebugInstrRef() {
            let mut IsIndirect: bool = false;
            BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, DL, II, IsIndirect, Reg, Var, Expr);
            return true;
        }
        let mut MOs: SmallVector<MachineOperand, 1> = SmallVector<MachineOperand, 1> { [CreateReg(Reg, false, false, false, false, false, false, 0, true, false, false)] };
        let mut Ops: SmallVector<uint64_t, 2> = SmallVector<uint64_t, 2> { [DW_OP_LLVM_arg, 0] };
        let mut NewExpr: *mut DIExpression = prependOpcodes(Expr, Ops, false, false);
        BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, DL, self.TII.get(DBG_INSTR_REF), false, ArrayRef<MachineOperand> { MOs }, Var, NewExpr);
        return true;
    }
    return false;
}

fn FastISel::lowerDbgDeclare(self, Address: *Value, Expr: *mut DIExpression, Var: *mut DILocalVariable, DL: *DebugLoc) -> bool {
    if !Address || isa(Address) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("isel", 1) {
                dbgs() << "Dropping debug info (bad/undef address)\n";
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    let mut Op: optional<MachineOperand> = optional<MachineOperand> {};
    if self.lookUpRegForValue(Address) {
        Reg.operator unsigned int();
    } else {
        Op = CreateReg(Reg, false, false, false, false, false, false, 0, false, false, false);
    }
    if !Op && !Address.use_empty() && isa(Address) && (!isa(Address) || !self.FuncInfo.StaticAllocaMap.count(cast(Address))) {
        Op = CreateReg(self.FuncInfo.InitializeRegForValue(Address), false, false, false, false, false, false, 0, false, false, false);
    }
    if Op {
        assert!(Var.isValidLocationForIntrinsic(DL.operator llvm::DILocation *()), "Expected inlined-at fields to agree");
        if self.FuncInfo.MF.useDebugInstrRef() && operator(Op).isReg() {
            let mut Ops: SmallVector<uint64_t, 3> = SmallVector<uint64_t, 3> { [DW_OP_LLVM_arg, 0, DW_OP_deref] };
            let mut NewExpr: *mut DIExpression = prependOpcodes(Expr, Ops, false, false);
            BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, DL, self.TII.get(DBG_INSTR_REF), false, ArrayRef<MachineOperand> { operator(Op) }, Var, NewExpr);
            return true;
        }
        BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, DL, self.TII.get(DBG_VALUE), true, ArrayRef<MachineOperand> { operator(Op) }, Var, Expr);
        return true;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("isel", 1) {
            dbgs() << "Dropping debug info (no materialized reg for address)\n";
        }
    }
        if !(false) { break; }
    }
    return false;
}

fn FastISel::selectIntrinsicCall(self, II: *IntrinsicInst) -> bool {
    match II.getIntrinsicID() {
        _ => {
            break;
        },
        lifetime_start => {
            lifetime_end;
        },
        objectsize => {
            llvm_unreachable_internal("llvm.objectsize.* should have been lowered already", "llvm\\lib\\CodeGen\\SelectionDAG\\FastISel.cpp", 1401);
        },
        is_constant => {
            llvm_unreachable_internal("llvm.is.constant.* should have been lowered already", "llvm\\lib\\CodeGen\\SelectionDAG\\FastISel.cpp", 1404);
        },
        allow_runtime_check => {
            allow_ubsan_check;
        },
        launder_invariant_group => {
            expect;
        },
        fake_use => {
            let mut V: *Value = II.getArgOperand(0);
            if self.getRegForValue(V) {
                Reg.operator unsigned int();
            } else {
                BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, self.MIMD, self.TII.get(FAKE_USE)).addReg(Reg, RegState {}, 0);
            }
            return true;
        },
        experimental_stackmap => {
            return self.selectStackmap(II);
        },
        experimental_patchpoint_void => {
            experimental_patchpoint;
        },
        xray_customevent => {
            return self.selectXRayCustomEvent(II);
        },
        xray_typedevent => {
            return self.selectXRayTypedEvent(II);
        },
    }
    return self.fastLowerIntrinsicCall(II);
}

fn FastISel::selectCast(self, I: *User, Opcode: u32) -> bool {
    let mut SrcVT: EVT = self.TLI.getValueType(self.DL, I.getOperand(0).getType(), false);
    let mut DstVT: EVT = self.TLI.getValueType(self.DL, I.getType(), false);
    if SrcVT == EVT { Other } || !SrcVT.isSimple() || DstVT == EVT { Other } || !DstVT.isSimple() {
        return false;
    }
    if !self.TLI.isTypeLegal(DstVT) {
        return false;
    }
    if !self.TLI.isTypeLegal(SrcVT) {
        return false;
    }
    let mut InputReg: Register = self.getRegForValue(I.getOperand(0));
    if !InputReg.operator unsigned int() {
        return false;
    }
    let mut ResultReg: Register = self.fastEmit_r(SrcVT.getSimpleVT(), DstVT.getSimpleVT(), Opcode, InputReg);
    if !ResultReg.operator unsigned int() {
        return false;
    }
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn FastISel::selectBitCast(self, I: *User) -> bool {
    let mut SrcEVT: EVT = self.TLI.getValueType(self.DL, I.getOperand(0).getType(), false);
    let mut DstEVT: EVT = self.TLI.getValueType(self.DL, I.getType(), false);
    if SrcEVT == EVT { Other } || DstEVT == EVT { Other } || !self.TLI.isTypeLegal(SrcEVT) || !self.TLI.isTypeLegal(DstEVT) {
        return false;
    }
    let mut SrcVT: MVT = SrcEVT.getSimpleVT();
    let mut DstVT: MVT = DstEVT.getSimpleVT();
    let mut Op0: Register = self.getRegForValue(I.getOperand(0));
    if !Op0.operator unsigned int() {
        return false;
    }
    if SrcVT == DstVT {
        self.updateValueMap(I, Op0, 1);
        return true;
    }
    let mut ResultReg: Register = self.fastEmit_r(SrcVT, DstVT, BITCAST, Op0);
    if !ResultReg.operator unsigned int() {
        return false;
    }
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn FastISel::selectFreeze(self, I: *User) -> bool {
    let mut Reg: Register = self.getRegForValue(I.getOperand(0));
    if !Reg.operator unsigned int() {
        return false;
    }
    let mut ETy: EVT = self.TLI.getValueType(self.DL, I.getOperand(0).getType(), false);
    if ETy == EVT { Other } || !self.TLI.isTypeLegal(ETy) {
        return false;
    }
    let mut Ty: MVT = ETy.getSimpleVT();
    let mut TyRegClass: *TargetRegisterClass = self.TLI.getRegClassFor(Ty, false);
    let mut ResultReg: Register = self.createResultReg(TyRegClass);
    BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, self.MIMD, self.TII.get(COPY), ResultReg).addReg(Reg, RegState {}, 0);
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn FastISel::removeDeadLocalValueCode(self, SavedLastLocalValue: *mut MachineInstr) {
    let mut CurLastLocalValue: *mut MachineInstr = self.getLastLocalValue();
    if CurLastLocalValue != SavedLastLocalValue {
        let mut FirstDeadInst: iterator = iterator { SavedLastLocalValue };
        if SavedLastLocalValue {
            operator(FirstDeadInst);
        } else {
            FirstDeadInst = self.FuncInfo.MBB.getFirstNonPHI();
        }
        self.setLastLocalValue(SavedLastLocalValue);
        self.removeDeadCode(iterator { FirstDeadInst }, iterator { self.FuncInfo.InsertPt });
    }
}

fn FastISel::selectInstruction(self, I: *Instruction) -> bool {
    self.flushLocalValueMap();
    let mut SavedLastLocalValue: *mut MachineInstr = self.getLastLocalValue();
    if I.isTerminator() {
        if !self.handlePHINodesInSuccessorBlocks(I.getParent()) {
            self.removeDeadLocalValueCode(SavedLastLocalValue);
            return false;
        }
    }
    if dyn_cast(I) {
        Call;
    } else {
        for let mut i: u32 = 0;
let mut e: u32 = Call.getNumOperandBundles(); i != e; i += 1 {
            if Call.getOperandBundleAt(i).getTagID() != OB_funclet {
                return false;
            }
        }
    }
    self.MIMD = MIMetadata { *I };
    self.SavedInsertPt = self.FuncInfo.InsertPt;
    if dyn_cast(I) {
        Call;
    } else {
        let mut F: *Function = Call.getCalledFunction();
        if F && F.getIntrinsicID() == trap && Call.hasFnAttr("trap-func-name") {
            return false;
        }
    }
    if !self.SkipTargetIndependentISel {
        if self.selectOperator(I, I.getOpcode()) {
            operator(NumFastIselSuccessIndependent);
            self.MIMD = MIMetadata {};
            return true;
        }
        self.recomputeInsertPt();
        if self.SavedInsertPt != self.FuncInfo.InsertPt {
            self.removeDeadCode(iterator { self.FuncInfo.InsertPt }, iterator { self.SavedInsertPt });
        }
        self.SavedInsertPt = self.FuncInfo.InsertPt;
    }
    if self.fastSelectInstruction(I) {
        operator(NumFastIselSuccessTarget);
        self.MIMD = MIMetadata {};
        return true;
    }
    self.recomputeInsertPt();
    if self.SavedInsertPt != self.FuncInfo.InsertPt {
        self.removeDeadCode(iterator { self.FuncInfo.InsertPt }, iterator { self.SavedInsertPt });
    }
    self.MIMD = MIMetadata {};
    if I.isTerminator() {
        self.removeDeadLocalValueCode(SavedLastLocalValue);
        self.FuncInfo.PHINodesToUpdate.resize(self.FuncInfo.OrigNumPHINodesToUpdate);
    }
    return false;
}

fn FastISel::fastEmitBranch(self, MSucc: *mut MachineBasicBlock, DbgLoc: *DebugLoc) {
    let mut BB: *BasicBlock = self.FuncInfo.MBB.getBasicBlock();
    let mut BlockHasMultipleInstrs: bool = &mut BB.front() != &mut BB.back();
    if BlockHasMultipleInstrs && self.FuncInfo.MBB.isLayoutSuccessor(MSucc) {} else {
        self.TII.insertBranch(*self.FuncInfo.MBB, MSucc, null, ArrayRef<MachineOperand> { SmallVector<MachineOperand, 0> {} }, DbgLoc, null);
    }
    if self.FuncInfo.BPI {
        let mut BranchProbability: BranchProbability = self.FuncInfo.BPI.getEdgeProbability(self.FuncInfo.MBB.getBasicBlock(), MSucc.getBasicBlock());
        self.FuncInfo.MBB.addSuccessor(MSucc, BranchProbability);
    } else {
        self.FuncInfo.MBB.addSuccessorWithoutProb(MSucc);
    }
}

fn FastISel::finishCondBranch(self, BranchBB: *BasicBlock, TrueMBB: *mut MachineBasicBlock, FalseMBB: *mut MachineBasicBlock) {
    if TrueMBB != FalseMBB {
        if self.FuncInfo.BPI {
            let mut BranchProbability: BranchProbability = self.FuncInfo.BPI.getEdgeProbability(BranchBB, TrueMBB.getBasicBlock());
            self.FuncInfo.MBB.addSuccessor(TrueMBB, BranchProbability);
        } else {
            self.FuncInfo.MBB.addSuccessorWithoutProb(TrueMBB);
        }
    }
    self.fastEmitBranch(FalseMBB, self.MIMD.getDL());
}

fn FastISel::selectFNeg(self, I: *User, In: *Value) -> bool {
    let mut OpReg: Register = self.getRegForValue(In);
    if !OpReg.operator unsigned int() {
        return false;
    }
    let mut VT: EVT = self.TLI.getValueType(self.DL, I.getType(), false);
    let mut ResultReg: Register = self.fastEmit_r(VT.getSimpleVT(), VT.getSimpleVT(), FNEG, OpReg);
    if ResultReg.operator unsigned int() {
        self.updateValueMap(I, ResultReg, 1);
        return true;
    }
    if VT.getSizeInBits().operator unsigned long long() > 64 {
        return false;
    }
    let mut IntVT: EVT = getIntegerVT(I.getContext(), VT.getSizeInBits().operator unsigned long long());
    if !self.TLI.isTypeLegal(IntVT) {
        return false;
    }
    let mut IntReg: Register = self.fastEmit_r(VT.getSimpleVT(), IntVT.getSimpleVT(), BITCAST, OpReg);
    if !IntReg.operator unsigned int() {
        return false;
    }
    let mut IntResultReg: Register = self.fastEmit_ri_(IntVT.getSimpleVT(), XOR, IntReg, (1) << (VT.getSizeInBits().operator unsigned long long() - 1), IntVT.getSimpleVT());
    if !IntResultReg.operator unsigned int() {
        return false;
    }
    ResultReg = self.fastEmit_r(IntVT.getSimpleVT(), VT.getSimpleVT(), BITCAST, IntResultReg);
    if !ResultReg.operator unsigned int() {
        return false;
    }
    self.updateValueMap(I, ResultReg, 1);
    return true;
}

fn FastISel::selectExtractValue(self, U: *User) -> bool {
    let mut EVI: *ExtractValueInst = dyn_cast(U);
    if !EVI {
        return false;
    }
    let mut RealVT: EVT = self.TLI.getValueType(self.DL, EVI.getType(), true);
    if !RealVT.isSimple() {
        return false;
    }
    let mut VT: MVT = RealVT.getSimpleVT();
    if !self.TLI.isTypeLegal(EVT { VT }) && VT != i1 {
        return false;
    }
    let mut Op0: *Value = EVI.getOperand(0);
    let mut AggTy: *mut Type = Op0.getType();
    let mut ResultReg: Register = Register { Reg: 0 };
    let mut I: iterator = self.FuncInfo.ValueMap.find(Op0);
    if I != self.FuncInfo.ValueMap.end() {
        ResultReg = operator(I).second;
    } else if isa(Op0) {
        ResultReg = self.FuncInfo.InitializeRegForValue(Op0);
    } else {
        return false;
    }
    let mut VTIndex: u32 = ComputeLinearIndex(AggTy, EVI.getIndices(), 0);
    let mut AggValueVTs: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
    ComputeValueVTs(self.TLI, self.DL, AggTy, AggValueVTs, null, null, getZero());
    for let mut i: u32 = 0; i < VTIndex; i += 1 {
        ResultReg = Register { Reg: ResultReg.id() + self.TLI.getNumRegisters(self.FuncInfo.Fn.getContext(), AggValueVTs[i], optional<MVT> { nullopt }) };
    }
    self.updateValueMap(EVI, ResultReg, 1);
    return true;
}

fn FastISel::selectOperator(self, I: *User, Opcode: u32) -> bool {
    match Opcode {
        Add => {
            return self.selectBinaryOp(I, ADD);
        },
        FAdd => {
            return self.selectBinaryOp(I, FADD);
        },
        Sub => {
            return self.selectBinaryOp(I, SUB);
        },
        FSub => {
            return self.selectBinaryOp(I, FSUB);
        },
        Mul => {
            return self.selectBinaryOp(I, MUL);
        },
        FMul => {
            return self.selectBinaryOp(I, FMUL);
        },
        SDiv => {
            return self.selectBinaryOp(I, SDIV);
        },
        UDiv => {
            return self.selectBinaryOp(I, UDIV);
        },
        FDiv => {
            return self.selectBinaryOp(I, FDIV);
        },
        SRem => {
            return self.selectBinaryOp(I, SREM);
        },
        URem => {
            return self.selectBinaryOp(I, UREM);
        },
        FRem => {
            return self.selectBinaryOp(I, FREM);
        },
        Shl => {
            return self.selectBinaryOp(I, SHL);
        },
        LShr => {
            return self.selectBinaryOp(I, SRL);
        },
        AShr => {
            return self.selectBinaryOp(I, SRA);
        },
        And => {
            return self.selectBinaryOp(I, AND);
        },
        Or => {
            return self.selectBinaryOp(I, OR);
        },
        Xor => {
            return self.selectBinaryOp(I, XOR);
        },
        FNeg => {
            return self.selectFNeg(I, I.getOperand(0));
        },
        GetElementPtr => {
            return self.selectGetElementPtr(I);
        },
        UncondBr => {
            let mut BI: *UncondBrInst = cast(I);
            let mut LLVMSucc: *BasicBlock = BI.getSuccessor(0);
            let mut MSucc: *mut MachineBasicBlock = self.FuncInfo.getMBB(LLVMSucc);
            self.fastEmitBranch(MSucc, BI.getDebugLoc());
            return true;
        },
        Unreachable => {
            let mut UI: CastReturnType = cast(I);
            if !UI.shouldLowerToTrap(self.TM.Options.TrapUnreachable, self.TM.Options.NoTrapAfterNoreturn) {
                return true;
            }
            return self.fastEmit_(MVT { SimpleTy: Other }, MVT { SimpleTy: Other }, TRAP) != 0;
        },
        Alloca => {
            if self.FuncInfo.StaticAllocaMap.count(cast(I)) {
                return true;
            }
        },
        Call => {
            if self.TM.getTargetTriple().isOSAIX() && !isa(I) {
                return false;
            }
        },
        BitCast => {
            return self.selectBitCast(I);
        },
        FPToSI => {
            return self.selectCast(I, FP_TO_SINT);
        },
        ZExt => {
            return self.selectCast(I, ZERO_EXTEND);
        },
        SExt => {
            return self.selectCast(I, SIGN_EXTEND);
        },
        Trunc => {
            return self.selectCast(I, TRUNCATE);
        },
        SIToFP => {
            return self.selectCast(I, SINT_TO_FP);
        },
        IntToPtr => {
            PtrToInt;
        },
        ExtractValue => {
            return self.selectExtractValue(I);
        },
        Freeze => {
            return self.selectFreeze(I);
        },
        PHI => {
            llvm_unreachable_internal("FastISel shouldn't visit PHI nodes!", "llvm\\lib\\CodeGen\\SelectionDAG\\FastISel.cpp", 1864);
        },
        _ => {
            return false;
        },
    }
}

