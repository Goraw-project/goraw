fn FastISel::fastEmitInst_extractsubreg(self, RetVT: MVT, Op0: Register, Idx: u32) -> Register {
    let mut ResultReg: Register = self.createResultReg(self.TLI.getRegClassFor(RetVT, false));
    assert!(Op0.isVirtual(), "Cannot yet extract from physregs");
    let mut RC: *TargetRegisterClass = self.MRI.getRegClass(Op0);
    self.MRI.constrainRegClass(Op0, self.TRI.getSubClassWithSubReg(RC, Idx), 0);
    BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, self.MIMD, self.TII.get(COPY), ResultReg).addReg(Op0, RegState {}, Idx);
    return ResultReg;
}

fn FastISel::fastEmitZExtFromI1(self, VT: MVT, Op0: Register) -> Register {
    return self.fastEmit_ri(VT, VT, AND, Op0, 1);
}

fn FastISel::handlePHINodesInSuccessorBlocks(self, LLVMBB: *BasicBlock) -> bool {
    let mut SuccsHandled: SmallPtrSet<MachineBasicBlock *, 4> = SmallPtrSet<MachineBasicBlock *, 4> {};
    self.FuncInfo.OrigNumPHINodesToUpdate = self.FuncInfo.PHINodesToUpdate.len;
    for SuccBB in successors(LLVMBB) {
        if !isa(SuccBB.begin()) {
            continue;
        }
        let mut SuccMBB: *mut MachineBasicBlock = self.FuncInfo.getMBB(SuccBB);
        if !SuccsHandled.insert(SuccMBB).second {
            continue;
        }
        let mut MBBI: iterator = SuccMBB.begin();
        for PN in SuccBB.phis() {
            if PN.use_empty() {
                continue;
            }
            let mut VT: EVT = self.TLI.getValueType(self.DL, PN.getType(), true);
            if VT == EVT { Other } || !self.TLI.isTypeLegal(VT) {
                if !(VT == EVT { i1 } || VT == EVT { i8 } || VT == EVT { i16 }) {
                    self.FuncInfo.PHINodesToUpdate.resize(self.FuncInfo.OrigNumPHINodesToUpdate);
                    return false;
                }
            }
            let mut PHIOp: *Value = PN.getIncomingValueForBlock(LLVMBB);
            self.MIMD = MIMetadata {};
            if dyn_cast(PHIOp) {
                Inst;
            } else {
                self.MIMD = MIMetadata { *Inst };
            }
            let mut Reg: Register = self.getRegForValue(PHIOp);
            if !Reg.operator unsigned int() {
                self.FuncInfo.PHINodesToUpdate.resize(self.FuncInfo.OrigNumPHINodesToUpdate);
                return false;
            }
            self.FuncInfo.PHINodesToUpdate.emplace_back(&mut operator(operator(MBBI, 0)), Reg);
            self.MIMD = MIMetadata {};
        }
    }
    return true;
}

fn FastISel::tryToFoldLoad(self, LI: *LoadInst, FoldInst: *Instruction) -> bool {
    assert!(LI.hasOneUse(), "tryToFoldLoad expected a LoadInst with a single use");
    let mut MaxUsers: u32 = 6;
    let mut TheUser: *Instruction = LI.user_back();
    while TheUser != FoldInst && TheUser.getParent() == FoldInst.getParent() && MaxUsers -= 1 {
        if !TheUser.hasOneUse() {
            return false;
        }
        TheUser = TheUser.user_back();
    }
    if TheUser != FoldInst {
        return false;
    }
    if !LI.isUnordered() {
        return false;
    }
    let mut LoadReg: Register = self.getRegForValue(LI);
    if !LoadReg.operator unsigned int() {
        return false;
    }
    if !self.MRI.hasOneUse(LoadReg) {
        return false;
    }
    if self.FuncInfo.RegsWithFixups.contains(LoadReg) {
        return false;
    }
    let mut RI: reg_iterator = self.MRI.reg_begin(LoadReg);
    let mut User: *mut MachineInstr = operator(RI).getParent();
    self.FuncInfo.InsertPt = MachineInstr> { User };
    self.FuncInfo.MBB = User.getParent();
    return self.tryToFoldLoadIntoMI(User, RI.getOperandNo(), LI);
}

fn FastISel::canFoldAddIntoGEP(self, GEP: *User, Add: *Value) -> bool {
    if !isa(Add) {
        return false;
    }
    if self.DL.getTypeSizeInBits(GEP.getType()) != self.DL.getTypeSizeInBits(Add.getType()) {
        return false;
    }
    if isa(Add) && self.FuncInfo.getMBB(cast(Add).getParent()) != self.FuncInfo.MBB {
        return false;
    }
    return isa(cast(Add).getOperand(1));
}

fn FastISel::createMachineMemOperandFor(self: *FastISel, I: *Instruction) -> *mut MachineMemOperand {
    let mut Ptr: *Value = null;
    let mut ValTy: *mut Type = null;
    let mut Alignment: MaybeAlign = MaybeAlign {};
    let mut Flags: Flags = zeroed();
    let mut IsVolatile: bool = false;
    if dyn_cast(I) {
        LI;
    } else {
        Alignment = MaybeAlign { LI.getAlign() };
        IsVolatile = LI.isVolatile();
        Flags = MOLoad;
        Ptr = LI.getPointerOperand();
        ValTy = LI.getType();
    }
    let mut IsNonTemporal: bool = I.hasMetadata(MD_nontemporal);
    let mut IsInvariant: bool = I.hasMetadata(MD_invariant_load);
    let mut Ranges: *MDNode = I.getMetadata(MD_range);
    let mut AAInfo: AAMDNodes = I.getAAMetadata();
    if !Alignment {
        Alignment = MaybeAlign { self.DL.getABITypeAlign(ValTy) };
    }
    let mut Size: u32 = self.DL.getTypeStoreSize(ValTy).operator unsigned long long();
    if IsVolatile {
        operator(Flags, MOVolatile);
    }
    if IsNonTemporal {
        operator(Flags, MONonTemporal);
    }
    if IsInvariant {
        operator(Flags, MOInvariant);
    }
    return self.FuncInfo.MF.getMachineMemOperand(MachinePointerInfo { Ptr, 0, 0 }, Flags, Size, operator(Alignment), MMOMetadata { AAInfo: AAInfo, Ranges: Ranges, MemCacheHint: null }, System, NotAtomic, NotAtomic);
}

fn FastISel::optimizeCmpPredicate(self: *FastISel, CI: *CmpInst) -> Predicate {
    let mut Predicate: Predicate = CI.getPredicate();
    if CI.getOperand(0) != CI.getOperand(1) {
        return Predicate;
    }
    match Predicate {
        _ => {
            llvm_unreachable_internal("Invalid predicate!", "llvm\\lib\\CodeGen\\SelectionDAG\\FastISel.cpp", 2336);
        },
        FCMP_FALSE => {
            Predicate = FCMP_FALSE;
        },
        FCMP_OEQ => {
            Predicate = FCMP_ORD;
        },
        FCMP_OGT => {
            Predicate = FCMP_FALSE;
        },
        FCMP_OGE => {
            Predicate = FCMP_ORD;
        },
        FCMP_OLT => {
            Predicate = FCMP_FALSE;
        },
        FCMP_OLE => {
            Predicate = FCMP_ORD;
        },
        FCMP_ONE => {
            Predicate = FCMP_FALSE;
        },
        FCMP_ORD => {
            Predicate = FCMP_ORD;
        },
        FCMP_UNO => {
            Predicate = FCMP_UNO;
        },
        FCMP_UEQ => {
            Predicate = FCMP_TRUE;
        },
        FCMP_UGT => {
            Predicate = FCMP_UNO;
        },
        FCMP_UGE => {
            Predicate = FCMP_TRUE;
        },
        FCMP_ULT => {
            Predicate = FCMP_UNO;
        },
        FCMP_ULE => {
            Predicate = FCMP_TRUE;
        },
        FCMP_UNE => {
            Predicate = FCMP_UNO;
        },
        FCMP_TRUE => {
            Predicate = FCMP_TRUE;
        },
        ICMP_EQ => {
            Predicate = FCMP_TRUE;
        },
        ICMP_NE => {
            Predicate = FCMP_FALSE;
        },
        ICMP_UGT => {
            Predicate = FCMP_FALSE;
        },
        ICMP_UGE => {
            Predicate = FCMP_TRUE;
        },
        ICMP_ULT => {
            Predicate = FCMP_FALSE;
        },
        ICMP_ULE => {
            Predicate = FCMP_TRUE;
        },
        ICMP_SGT => {
            Predicate = FCMP_FALSE;
        },
        ICMP_SGE => {
            Predicate = FCMP_TRUE;
        },
        ICMP_SLT => {
            Predicate = FCMP_FALSE;
        },
        ICMP_SLE => {
            Predicate = FCMP_TRUE;
        },
    }
    return Predicate;
}
