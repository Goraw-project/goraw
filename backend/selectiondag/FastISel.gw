fn FastISel::fastEmit_(self, arg: MVT, arg: MVT, arg: u32) -> Register {
    return Register { Reg: 0 };
}

fn FastISel::fastEmit_r(self, arg: MVT, arg: MVT, arg: u32, arg: Register) -> Register {
    return Register { Reg: 0 };
}

fn FastISel::fastEmit_rr(self, arg: MVT, arg: MVT, arg: u32, arg: Register, arg: Register) -> Register {
    return Register { Reg: 0 };
}

fn FastISel::fastEmit_i(self, arg: MVT, arg: MVT, arg: u32, arg: u64) -> Register {
    return Register { Reg: 0 };
}

fn FastISel::fastEmit_f(self, arg: MVT, arg: MVT, arg: u32, arg: *ConstantFP) -> Register {
    return Register { Reg: 0 };
}

fn FastISel::fastEmit_ri(self, arg: MVT, arg: MVT, arg: u32, arg: Register, arg: u64) -> Register {
    return Register { Reg: 0 };
}

fn FastISel::fastEmit_ri_(self, VT: MVT, Opcode: u32, Op0: Register, Imm: u64, ImmType: MVT) -> Register {
    if Opcode == MUL && isPowerOf2_64(Imm) {
        Opcode = SHL;
        Imm = Log2_64(Imm);
    } else if Opcode == UDIV && isPowerOf2_64(Imm) {
        Opcode = SRL;
        Imm = Log2_64(Imm);
    }
    if (Opcode == SHL || Opcode == SRA || Opcode == SRL) && Imm >= VT.getSizeInBits().operator unsigned long long() {
        return Register { Reg: 0 };
    }
    let mut ResultReg: Register = self.fastEmit_ri(VT, VT, Opcode, Op0, Imm);
    if ResultReg.operator unsigned int() {
        return ResultReg;
    }
    let mut MaterialReg: Register = self.fastEmit_i(ImmType, ImmType, Constant, Imm);
    if !MaterialReg.operator unsigned int() {
        let mut ITy: *mut IntegerType = get(self.FuncInfo.Fn.getContext(), VT.getSizeInBits().operator unsigned long long());
        MaterialReg = self.getRegForValue(get(ITy, Imm, false, true));
        if !MaterialReg.operator unsigned int() {
            return Register { Reg: 0 };
        }
    }
    return self.fastEmit_rr(VT, VT, Opcode, Op0, MaterialReg);
}

fn FastISel::createResultReg(self, RC: *TargetRegisterClass) -> Register {
    return self.MRI.createVirtualRegister(RC, "");
}

fn FastISel::constrainOperandRegClass(self, II: *MCInstrDesc, Op: Register, OpNum: u32) -> Register {
    if Op.isVirtual() {
        let mut RegClass: *TargetRegisterClass = self.TII.getRegClass(II, OpNum);
        if !self.MRI.constrainRegClass(Op, RegClass, 0) {
            let mut NewOp: Register = self.createResultReg(RegClass);
            BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, self.MIMD, self.TII.get(COPY), NewOp).addReg(Op, RegState {}, 0);
            return NewOp;
        }
    }
    return Op;
}

fn FastISel::fastEmitInst_(self, MachineInstOpcode: u32, RC: *TargetRegisterClass) -> Register {
    let mut ResultReg: Register = self.createResultReg(RC);
    let mut II: *MCInstrDesc = self.TII.get(MachineInstOpcode);
    operator(BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, self.MIMD, II, ResultReg)).setImplicitPhysRegDefsDead();
    return ResultReg;
}

fn FastISel::fastEmitInst_r(self, MachineInstOpcode: u32, RC: *TargetRegisterClass, Op0: Register) -> Register {
    let mut II: *MCInstrDesc = self.TII.get(MachineInstOpcode);
    let mut ResultReg: Register = self.createResultReg(RC);
    Op0 = self.constrainOperandRegClass(II, Op0, II.getNumDefs());
    assert!(II.getNumDefs() >= 1, "instruction must define the result");
    operator(BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, self.MIMD, II, ResultReg).addReg(Op0, RegState {}, 0)).setImplicitPhysRegDefsDead();
    return ResultReg;
}

fn FastISel::fastEmitInst_rr(self, MachineInstOpcode: u32, RC: *TargetRegisterClass, Op0: Register, Op1: Register) -> Register {
    let mut II: *MCInstrDesc = self.TII.get(MachineInstOpcode);
    let mut ResultReg: Register = self.createResultReg(RC);
    Op0 = self.constrainOperandRegClass(II, Op0, II.getNumDefs());
    Op1 = self.constrainOperandRegClass(II, Op1, II.getNumDefs() + 1);
    assert!(II.getNumDefs() >= 1, "instruction must define the result");
    operator(BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, self.MIMD, II, ResultReg).addReg(Op0, RegState {}, 0).addReg(Op1, RegState {}, 0)).setImplicitPhysRegDefsDead();
    return ResultReg;
}

fn FastISel::fastEmitInst_rrr(self, MachineInstOpcode: u32, RC: *TargetRegisterClass, Op0: Register, Op1: Register, Op2: Register) -> Register {
    let mut II: *MCInstrDesc = self.TII.get(MachineInstOpcode);
    let mut ResultReg: Register = self.createResultReg(RC);
    Op0 = self.constrainOperandRegClass(II, Op0, II.getNumDefs());
    Op1 = self.constrainOperandRegClass(II, Op1, II.getNumDefs() + 1);
    Op2 = self.constrainOperandRegClass(II, Op2, II.getNumDefs() + 2);
    assert!(II.getNumDefs() >= 1, "instruction must define the result");
    operator(BuildMI(*self.FuncInfo.MBB, iterator { self.FuncInfo.InsertPt }, self.MIMD, II, ResultReg).addReg(Op0, RegState {}, 0).addReg(Op1, RegState {}, 0).addReg(Op2, RegState {}, 0)).setImplicitPhysRegDefsDead();
    return ResultReg;
}

fn FastISel::fastEmitInst_ri(self, MachineInstOpcode: u32, RC: *TargetRegisterClass, Op0: Register, Imm: u64) -> Register {
    let mut II: *MCInstrDesc = self.TII.get(MachineInstOpcode);
