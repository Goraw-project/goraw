fn SelectionDAGTargetInfo::~SelectionDAGTargetInfo(self) {}

fn SelectionDAGGenTargetInfo::~SelectionDAGGenTargetInfo(self) {}

fn SelectionDAGTargetInfo::mayRaiseFPException(self: *SelectionDAGTargetInfo, Opcode: u32) -> bool {
    return self.isTargetStrictFPOpcode(Opcode) || self.isTargetMemoryOpcode(Opcode);
}
