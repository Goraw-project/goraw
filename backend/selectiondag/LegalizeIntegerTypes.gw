fn DAGTypeLegalizer::PromoteIntRes_UMINUMAX(self, N: *mut SDNode) -> SDValue {
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    self.SExtOrZExtPromotedOperands(LHS, RHS);
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, LHS.getValueType(), LHS, RHS);
}

fn DAGTypeLegalizer::PromoteIntRes_SRA(self, N: *mut SDNode) -> SDValue {
    let mut LHS: SDValue = self.SExtPromotedInteger(N.getOperand(0));
    let mut RHS: SDValue = N.getOperand(1);
    if self.getTypeAction(RHS.getValueType()) == TypePromoteInteger {
        RHS = self.ZExtPromotedInteger(RHS);
    }
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, LHS.getValueType(), LHS, RHS);
}

fn DAGTypeLegalizer::PromoteIntRes_SRL(self, N: *mut SDNode) -> SDValue {
    let mut RHS: SDValue = N.getOperand(1);
    let mut LHS: SDValue = self.ZExtPromotedInteger(N.getOperand(0));
    if self.getTypeAction(RHS.getValueType()) == TypePromoteInteger {
        RHS = self.ZExtPromotedInteger(RHS);
    }
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, LHS.getValueType(), LHS, RHS);
}

fn DAGTypeLegalizer::PromoteIntRes_Rotate(self, N: *mut SDNode) -> SDValue {
    let mut OldVT: EVT = N.getValueType(0);
    let mut VT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OldVT);
    let mut Amt: SDValue = N.getOperand(1);
    let mut Opcode: u32 = N.getOpcode();
    let mut OldBits: u32 = OldVT.getScalarSizeInBits();
    let mut NewBits: u32 = VT.getScalarSizeInBits();
    if NewBits >= (2 * OldBits) && !isa(Amt) && !self.TLI.isOperationLegalOrCustom(Opcode, VT, false) && self.TLI.getOperationAction(SHL, OldVT) != Custom && self.TLI.getOperationAction(SRL, OldVT) != Custom {
        let mut Op0: SDValue = self.GetPromotedInteger(N.getOperand(0));
        if self.getTypeAction(Amt.getValueType()) == TypePromoteInteger {
            Amt = self.ZExtPromotedInteger(Amt);
        }
        let mut AmtVT: EVT = Amt.getValueType();
        let mut DL: SDLoc = SDLoc { N };
        Amt = self.DAG.getNode(UREM, DL, AmtVT, Amt, self.DAG.getConstant(OldBits, DL, AmtVT, false, false));
        let mut HiShift: SDValue = self.DAG.getShiftAmountConstant(OldBits, VT, DL);
        let mut Hi: SDValue = self.DAG.getNode(SHL, DL, VT, Op0, HiShift);
        let mut Lo: SDValue = self.DAG.getZeroExtendInReg(Op0, DL, OldVT);
        let mut Res: SDValue = self.DAG.getNode(OR, DL, VT, Hi, Lo);
        let mut IsROTR: bool = N.getOpcode() == ROTR;
        Res = self.DAG.getNode(if IsROTR { SRL } else { SHL }, DL, VT, Res, Amt);
        if !IsROTR {
            Res = self.DAG.getNode(SRL, DL, VT, Res, HiShift);
        }
        return Res;
    }
    let mut Res: SDValue = self.TLI.expandROT(N, true, self.DAG);
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Res);
    return SDValue {};
}

fn DAGTypeLegalizer::PromoteIntRes_FunnelShift(self, N: *mut SDNode) -> SDValue {
    let mut Hi: SDValue = self.GetPromotedInteger(N.getOperand(0));
    let mut Lo: SDValue = self.GetPromotedInteger(N.getOperand(1));
    let mut Amt: SDValue = N.getOperand(2);
    if self.getTypeAction(Amt.getValueType()) == TypePromoteInteger {
        Amt = self.ZExtPromotedInteger(Amt);
    }
    let mut AmtVT: EVT = Amt.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    let mut OldVT: EVT = N.getOperand(0).getValueType();
    let mut VT: EVT = Lo.getValueType();
    let mut Opcode: u32 = N.getOpcode();
    let mut IsFSHR: bool = Opcode == FSHR;
    let mut OldBits: u32 = OldVT.getScalarSizeInBits();
    let mut NewBits: u32 = VT.getScalarSizeInBits();
    Amt = self.DAG.getNode(UREM, DL, AmtVT, Amt, self.DAG.getConstant(OldBits, DL, AmtVT, false, false));
    if NewBits >= (2 * OldBits) && !isa(Amt) && !self.TLI.isOperationLegalOrCustom(Opcode, VT, false) {
        let mut HiShift: SDValue = self.DAG.getShiftAmountConstant(OldBits, VT, DL);
        Hi = self.DAG.getNode(SHL, DL, VT, Hi, HiShift);
        Lo = self.DAG.getZeroExtendInReg(Lo, DL, OldVT);
        let mut Res: SDValue = self.DAG.getNode(OR, DL, VT, Hi, Lo);
        Res = self.DAG.getNode(if IsFSHR { SRL } else { SHL }, DL, VT, Res, Amt);
        if !IsFSHR {
            Res = self.DAG.getNode(SRL, DL, VT, Res, HiShift);
        }
        return Res;
    }
    Lo = self.DAG.getNode(SHL, DL, VT, Lo, self.DAG.getShiftAmountConstant(NewBits - OldBits, VT, DL));
    if IsFSHR {
        Amt = self.DAG.getNode(ADD, DL, AmtVT, Amt, self.DAG.getConstant(NewBits - OldBits, DL, AmtVT, false, false));
    }
    return self.DAG.getNode(Opcode, DL, VT, Hi, Lo, Amt);
}

fn DAGTypeLegalizer::PromoteIntRes_CLMUL(self, N: *mut SDNode) -> SDValue {
    let mut Opcode: u32 = N.getOpcode();
    let mut DL: SDLoc = SDLoc { N };
    let mut OldVT: EVT = N.getOperand(0).getValueType();
    let mut VT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OldVT);
    if Opcode == CLMUL {
        if !self.TLI.isOperationLegalOrCustomOrPromote(CLMUL, VT, false) && !(self.getTypeAction(VT) == TypeExpandInteger && self.TLI.isOperationLegalOrCustom(CLMUL, EVT { self.TLI.getRegisterType(*self.DAG.getContext(), VT) }, false)) {
            if self.TLI.expandCLMUL(N, self.DAG) {
                Res;
            } else {
                return self.DAG.getNode(ANY_EXTEND, DL, VT, Res);
            }
        }
        let mut X: SDValue = self.GetPromotedInteger(N.getOperand(0));
        let mut Y: SDValue = self.GetPromotedInteger(N.getOperand(1));
        return self.DAG.getNode(CLMUL, DL, VT, X, Y);
    }
    let mut X: SDValue = self.ZExtPromotedInteger(N.getOperand(0));
    let mut Y: SDValue = self.ZExtPromotedInteger(N.getOperand(1));
    let mut OldBits: u32 = OldVT.getScalarSizeInBits();
    let mut NewBits: u32 = VT.getScalarSizeInBits();
    if NewBits < 2 * OldBits {
        let mut Clmul: SDValue = self.DAG.getNode(CLMUL, DL, VT, X, Y);
        let mut ShAmt: u32 = if Opcode == CLMULH { OldBits } else { OldBits - 1 };
        let mut Lo: SDValue = self.DAG.getNode(SRL, DL, VT, Clmul, self.DAG.getShiftAmountConstant(ShAmt, VT, DL));
        let mut Clmulh: SDValue = self.DAG.getNode(CLMULH, DL, VT, X, Y);
        ShAmt = if Opcode == CLMULH { NewBits - OldBits } else { NewBits - OldBits + 1 };
        let mut Hi: SDValue = self.DAG.getNode(SHL, DL, VT, Clmulh, self.DAG.getShiftAmountConstant(ShAmt, VT, DL));
        return self.DAG.getNode(OR, DL, VT, Lo, Hi);
    }
    let mut Clmul: SDValue = self.DAG.getNode(CLMUL, DL, VT, X, Y);
    let mut ShAmt: u32 = if Opcode == CLMULH { OldBits } else { OldBits - 1 };
    return self.DAG.getNode(SRL, DL, VT, Clmul, self.DAG.getShiftAmountConstant(ShAmt, VT, DL));
}

fn DAGTypeLegalizer::PromoteIntRes_PEXT(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    if !self.TLI.isOperationLegalOrCustomOrPromote(PEXT, VT, false) {
        if self.TLI.expandPEXT(N, self.DAG) {
            Res;
        } else {
            return self.DAG.getNode(ANY_EXTEND, DL, VT, Res);
        }
    }
    let mut X: SDValue = self.GetPromotedInteger(N.getOperand(0));
    let mut Y: SDValue = self.ZExtPromotedInteger(N.getOperand(1));
    return self.DAG.getNode(PEXT, DL, VT, X, Y);
}

fn DAGTypeLegalizer::PromoteIntRes_PDEP(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    if !self.TLI.isOperationLegalOrCustomOrPromote(PDEP, VT, false) {
        if self.TLI.expandPDEP(N, self.DAG) {
            Res;
        } else {
            return self.DAG.getNode(ANY_EXTEND, DL, VT, Res);
        }
    }
    let mut X: SDValue = self.GetPromotedInteger(N.getOperand(0));
    let mut Y: SDValue = self.GetPromotedInteger(N.getOperand(1));
    return self.DAG.getNode(PDEP, DL, VT, X, Y);
}

fn DAGTypeLegalizer::PromoteIntRes_MULH(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut IsSigned: bool = N.getOpcode() == MULHS;
    let mut BW: u32 = VT.getScalarSizeInBits();
    let mut NBW: u32 = NVT.getScalarSizeInBits();
    let mut LHS: SDValue = SDValue {};
    let mut RHS: SDValue = SDValue {};
    if IsSigned {
        LHS = self.SExtPromotedInteger(N.getOperand(0));
        RHS = self.SExtPromotedInteger(N.getOperand(1));
    } else {
        LHS = self.ZExtPromotedInteger(N.getOperand(0));
        RHS = self.ZExtPromotedInteger(N.getOperand(1));
    }
    if NBW >= 2 * BW {
        return self.DAG.getNode(if IsSigned { SRA } else { SRL }, dl, NVT, self.DAG.getNode(MUL, dl, NVT, LHS, RHS), self.DAG.getShiftAmountConstant(BW, NVT, dl));
    }
    LHS = self.DAG.getNode(SHL, dl, NVT, LHS, self.DAG.getShiftAmountConstant(NBW - BW, NVT, dl));
    return self.DAG.getNode(N.getOpcode(), dl, NVT, LHS, RHS);
}

fn DAGTypeLegalizer::PromoteIntRes_TRUNCATE(self, N: *mut SDNode) -> SDValue {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut Res: SDValue = SDValue {};
    let mut InOp: SDValue = N.getOperand(0);
    let mut dl: SDLoc = SDLoc { N };
    match self.getTypeAction(InOp.getValueType()) {
        _ => {
            llvm_unreachable_internal("Unknown type action!", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeIntegerTypes.cpp", 1741);
        },
        TypeLegal => {
            TypeExpandInteger;
        },
        TypePromoteInteger => {
            Res = self.GetPromotedInteger(InOp);
        },
        TypeSplitVector => {
            let mut InVT: EVT = InOp.getValueType();
            assert!(InVT.isVector(), "Cannot split scalar types");
            let mut NumElts: ElementCount = InVT.getVectorElementCount();
            assert!(NumElts == NVT.getVectorElementCount(), "Dst and Src must have the same number of elements");
            assert!(isPowerOf2_32(NumElts.getKnownMinValue()), "Promoted vector type must be a power of two");
            let mut EOp1: SDValue = SDValue {};
            let mut EOp2: SDValue = SDValue {};
            self.GetSplitVector(InOp, EOp1, EOp2);
            let mut HalfNVT: EVT = getVectorVT(*self.DAG.getContext(), NVT.getScalarType(), NumElts.divideCoefficientBy(2));
            EOp1 = self.DAG.getNode(TRUNCATE, dl, HalfNVT, EOp1);
            EOp2 = self.DAG.getNode(TRUNCATE, dl, HalfNVT, EOp2);
            return self.DAG.getNode(CONCAT_VECTORS, dl, NVT, EOp1, EOp2);
        },
        TypeWidenVector => {
            let mut WideInOp: SDValue = self.GetWidenedVector(InOp);
            let mut NumElem: u32 = WideInOp.getValueType().getVectorNumElements();
            let mut TruncVT: EVT = getVectorVT(*self.DAG.getContext(), N.getValueType(0).getScalarType(), NumElem, false);
            let mut WideTrunc: SDValue = self.DAG.getNode(TRUNCATE, dl, TruncVT, WideInOp);
            let mut ExtVT: EVT = getVectorVT(*self.DAG.getContext(), NVT.getVectorElementType(), NumElem, false);
            let mut WideExt: SDValue = self.DAG.getNode(ZERO_EXTEND, dl, ExtVT, WideTrunc);
            let mut ZeroIdx: SDValue = self.DAG.getVectorIdxConstant(0, dl, false);
            return self.DAG.getNode(EXTRACT_SUBVECTOR, dl, NVT, WideExt, ZeroIdx);
        },
    }
    return self.DAG.getNode(TRUNCATE, dl, NVT, Res);
}

fn DAGTypeLegalizer::PromoteIntRes_UADDSUBO(self, N: *mut SDNode, ResNo: u32) -> SDValue {
    if ResNo == 1 {
        return self.PromoteIntRes_Overflow(N);
    }
    let mut LHS: SDValue = self.ZExtPromotedInteger(N.getOperand(0));
    let mut RHS: SDValue = self.ZExtPromotedInteger(N.getOperand(1));
    let mut OVT: EVT = N.getOperand(0).getValueType();
    let mut NVT: EVT = LHS.getValueType();
    let mut dl: SDLoc = SDLoc { N };
    let mut Opcode: u32 = if N.getOpcode() == UADDO { ADD } else { SUB };
    let mut Res: SDValue = self.DAG.getNode(Opcode, dl, NVT, LHS, RHS);
    let mut Ofl: SDValue = self.DAG.getZeroExtendInReg(Res, dl, OVT);
    Ofl = self.DAG.getSetCC(dl, N.getValueType(1), Ofl, Res, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Ofl);
    return Res;
}

fn DAGTypeLegalizer::PromoteIntRes_UADDSUBO_CARRY(self, N: *mut SDNode, ResNo: u32) -> SDValue {
    if ResNo == 1 {
        return self.PromoteIntRes_Overflow(N);
    }
    let mut LHS: SDValue = self.SExtPromotedInteger(N.getOperand(0));
    let mut RHS: SDValue = self.SExtPromotedInteger(N.getOperand(1));
    let mut ValueVTs: [2]EVT = [LHS.getValueType(), N.getValueType(1)];
    let mut Res: SDValue = self.DAG.getNode(N.getOpcode(), SDLoc { N }, self.DAG.getVTList(ArrayRef<EVT> { ValueVTs }), LHS, RHS, N.getOperand(2));
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
    return SDValue { Node: Res.getNode(), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntRes_SADDSUBO_CARRY(self, N: *mut SDNode, ResNo: u32) -> SDValue {
    assert!(ResNo == 1, "Don't know how to promote other results yet.");
    return self.PromoteIntRes_Overflow(N);
}

fn DAGTypeLegalizer::PromoteIntRes_ABS(self, N: *mut SDNode) -> SDValue {
    let mut OVT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OVT);
    if !OVT.isVector() && !self.TLI.isOperationLegalOrCustomOrPromote(ABS, NVT, false) && !self.TLI.isOperationLegalOrCustomOrPromote(ABS_MIN_POISON, NVT, false) && !self.TLI.isOperationLegal(SMAX, NVT) {
        if self.TLI.expandABS(N, self.DAG, false) {
            Res;
        } else {
            return self.DAG.getNode(ANY_EXTEND, SDLoc { N }, NVT, Res);
        }
    }
    let mut Op0: SDValue = self.SExtPromotedInteger(N.getOperand(0));
    return self.DAG.getNode(ABS_MIN_POISON, SDLoc { N }, Op0.getValueType(), Op0);
}

fn DAGTypeLegalizer::PromoteIntRes_XMULO(self, N: *mut SDNode, ResNo: u32) -> SDValue {
    if ResNo == 1 {
        return self.PromoteIntRes_Overflow(N);
    }
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut DL: SDLoc = SDLoc { N };
    let mut SmallVT: EVT = LHS.getValueType();
    if N.getOpcode() == SMULO {
        LHS = self.SExtPromotedInteger(LHS);
        RHS = self.SExtPromotedInteger(RHS);
    } else {
        LHS = self.ZExtPromotedInteger(LHS);
        RHS = self.ZExtPromotedInteger(RHS);
    }
    let mut VTs: SDVTList = self.DAG.getVTList(LHS.getValueType(), N.getValueType(1));
    let mut Mul: SDValue = self.DAG.getNode(N.getOpcode(), DL, VTs, LHS, RHS);
    let mut Overflow: SDValue = SDValue {};
    if N.getOpcode() == UMULO {
        let mut Shift: u32 = SmallVT.getScalarSizeInBits();
        let mut Hi: SDValue = self.DAG.getNode(SRL, DL, Mul.getValueType(), Mul, self.DAG.getShiftAmountConstant(Shift, Mul.getValueType(), DL));
        Overflow = self.DAG.getSetCC(DL, N.getValueType(1), Hi, self.DAG.getConstant(0, DL, Hi.getValueType(), false, false), SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
    } else {
        let mut SExt: SDValue = self.DAG.getNode(SIGN_EXTEND_INREG, DL, Mul.getValueType(), Mul, self.DAG.getValueType(SmallVT));
        Overflow = self.DAG.getSetCC(DL, N.getValueType(1), SExt, Mul, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    Overflow = self.DAG.getNode(OR, DL, N.getValueType(1), Overflow, SDValue { Node: Mul.getNode(), ResNo: 1 });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Overflow);
    return Mul;
}

fn DAGTypeLegalizer::PromoteIntRes_UNDEF(self, N: *mut SDNode) -> SDValue {
    return self.DAG.getUNDEF(self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0)));
}

fn DAGTypeLegalizer::PromoteIntRes_VSCALE(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut MulImm: *APInt = N.getConstantOperandAPInt(0);
    return self.DAG.getVScale(SDLoc { N }, VT, MulImm.sext(VT.getSizeInBits().operator unsigned long long()));
}

fn DAGTypeLegalizer::PromoteIntRes_VAARG(self, N: *mut SDNode) -> SDValue {
    let mut Chain: SDValue = N.getOperand(0);
    let mut Ptr: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut dl: SDLoc = SDLoc { N };
    let mut RegVT: MVT = self.TLI.getRegisterType(*self.DAG.getContext(), VT);
    let mut NumRegs: u32 = self.TLI.getNumRegisters(*self.DAG.getContext(), VT, optional<MVT> { nullopt });
    let mut Parts: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { NumRegs };
    for let mut i: u32 = 0; i < NumRegs; i += 1 {
        Parts[i] = self.DAG.getVAArg(EVT { RegVT }, dl, Chain, Ptr, N.getOperand(2), N.getConstantOperandVal(3));
        Chain = Parts[i].getValue(1);
    }
    if self.DAG.getDataLayout().isBigEndian() {
        reverse(Parts.begin(), Parts.end());
    }
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut Res: SDValue = self.DAG.getNode(ZERO_EXTEND, dl, NVT, Parts[0]);
    for let mut i: u32 = 1; i < NumRegs; i += 1 {
        let mut Part: SDValue = self.DAG.getNode(ZERO_EXTEND, dl, NVT, Parts[i]);
        Part = self.DAG.getNode(SHL, dl, NVT, Part, self.DAG.getShiftAmountConstant(i * RegVT.getSizeInBits().operator unsigned long long(), NVT, dl));
        Res = self.DAG.getNode(OR, dl, NVT, Res, Part);
    }
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Chain);
    return Res;
}

fn DAGTypeLegalizer::PromoteIntegerOperand(self, N: *mut SDNode, OpNo: u32) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalize-types", 1) {
            dbgs() << "Promote integer operand: ";
            N.dump(&mut self.DAG);
        }
    }
        if !(false) { break; }
    }
    let mut Res: SDValue = SDValue {};
    if self.CustomLowerNode(N, N.getOperand(OpNo).getValueType(), false) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("legalize-types", 1) {
                dbgs() << "Node has been custom lowered, done\n";
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    match N.getOpcode() {
        _ => {
            dbgs() << "PromoteIntegerOperand Op #" << OpNo << ": ";
        },
        ANY_EXTEND => {
            Res = self.PromoteIntOp_ANY_EXTEND(N);
        },
        ANY_EXTEND_VECTOR_INREG => {
            Res = self.PromoteIntOp_ANY_EXTEND_VECTOR_INREG(N);
        },
        ATOMIC_STORE => {
            Res = self.PromoteIntOp_ATOMIC_STORE(cast(N));
        },
        BITCAST => {
            Res = self.PromoteIntOp_BITCAST(N);
        },
        BR_CC => {
            Res = self.PromoteIntOp_BR_CC(N, OpNo);
        },
        BRCOND => {
            Res = self.PromoteIntOp_BRCOND(N, OpNo);
        },
        BUILD_PAIR => {
            Res = self.PromoteIntOp_BUILD_PAIR(N);
        },
        BUILD_VECTOR => {
            Res = self.PromoteIntOp_BUILD_VECTOR(N);
        },
        CONCAT_VECTORS => {
            Res = self.PromoteIntOp_CONCAT_VECTORS(N);
        },
        COND_LOOP => {
            Res = self.PromoteIntOp_COND_LOOP(N, OpNo);
        },
        EXTRACT_VECTOR_ELT => {
            Res = self.PromoteIntOp_EXTRACT_VECTOR_ELT(N);
        },
        FAKE_USE => {
            Res = self.PromoteIntOp_FAKE_USE(N);
        },
        INSERT_VECTOR_ELT => {
            Res = self.PromoteIntOp_INSERT_VECTOR_ELT(N, OpNo);
        },
        SPLAT_VECTOR => {
            SCALAR_TO_VECTOR;
        },
        VSELECT => {
            SELECT;
        },
        SELECT_CC => {
            Res = self.PromoteIntOp_SELECT_CC(N, OpNo);
        },
        SETCC => {
            Res = self.PromoteIntOp_SETCC(N, OpNo);
        },
        SIGN_EXTEND => {
            Res = self.PromoteIntOp_SIGN_EXTEND(N);
        },
        SINT_TO_FP => {
            Res = self.PromoteIntOp_SINT_TO_FP(N);
        },
        STRICT_SINT_TO_FP => {
            Res = self.PromoteIntOp_STRICT_SINT_TO_FP(N);
        },
        STORE => {
            Res = self.PromoteIntOp_STORE(cast(N), OpNo);
        },
        VP_STORE => {
            Res = self.PromoteIntOp_VP_STORE(cast(N), OpNo);
        },
        MSTORE => {
            Res = self.PromoteIntOp_MSTORE(cast(N), OpNo);
        },
        MLOAD => {
            Res = self.PromoteIntOp_MLOAD(cast(N), OpNo);
        },
        MGATHER => {
            Res = self.PromoteIntOp_MGATHER(cast(N), OpNo);
        },
        MSCATTER => {
            Res = self.PromoteIntOp_MSCATTER(cast(N), OpNo);
        },
        VECTOR_COMPRESS => {
            Res = self.PromoteIntOp_VECTOR_COMPRESS(N, OpNo);
        },
        TRUNCATE => {
            Res = self.PromoteIntOp_TRUNCATE(N);
        },
        BF16_TO_FP => {
            FP16_TO_FP;
        },
        CONVERT_FROM_ARBITRARY_FP => {
            Res = self.PromoteIntOp_CONVERT_FROM_ARBITRARY_FP(N);
        },
        STRICT_FP16_TO_FP => {
            STRICT_UINT_TO_FP;
        },
        ZERO_EXTEND => {
            Res = self.PromoteIntOp_ZERO_EXTEND(N);
        },
        EXTRACT_SUBVECTOR => {
            Res = self.PromoteIntOp_EXTRACT_SUBVECTOR(N);
        },
        INSERT_SUBVECTOR => {
            Res = self.PromoteIntOp_INSERT_SUBVECTOR(N);
        },
        SHL => {
            SRA;
        },
        SCMP => {
            UCMP;
        },
        FSHL => {
            FSHR;
        },
        FRAMEADDR => {
            RETURNADDR;
        },
        SMULFIX => {
            SMULFIXSAT;
        },
        FPOWI => {
            STRICT_FPOWI;
        },
        VECREDUCE_ADD => {
            VECREDUCE_MUL;
        },
        VP_REDUCE_ADD => {
            VP_REDUCE_MUL;
        },
        SET_ROUNDING => {
            Res = self.PromoteIntOp_SET_ROUNDING(N);
        },
        STACKMAP => {
            Res = self.PromoteIntOp_STACKMAP(N, OpNo);
        },
        PATCHPOINT => {
            Res = self.PromoteIntOp_PATCHPOINT(N, OpNo);
        },
        WRITE_REGISTER => {
            Res = self.PromoteIntOp_WRITE_REGISTER(N, OpNo);
        },
        EXPERIMENTAL_VP_STRIDED_LOAD => {
            EXPERIMENTAL_VP_STRIDED_STORE;
        },
        EXPERIMENTAL_VP_SPLICE => {
            Res = self.PromoteIntOp_VP_SPLICE(N, OpNo);
        },
        EXPERIMENTAL_VECTOR_HISTOGRAM => {
            Res = self.PromoteIntOp_VECTOR_HISTOGRAM(N, OpNo);
        },
        VECTOR_FIND_LAST_ACTIVE => {
            CTTZ_ELTS;
        },
        GET_ACTIVE_LANE_MASK => {
            Res = self.PromoteIntOp_GET_ACTIVE_LANE_MASK(N);
        },
        VECTOR_MATCH => {
            Res = self.PromoteIntOp_VECTOR_MATCH(N, OpNo);
        },
        MASKED_UDIV => {
            MASKED_SDIV;
        },
        PARTIAL_REDUCE_UMLA => {
            PARTIAL_REDUCE_SMLA;
        },
        VECTOR_REPEAT => {
            Res = self.PromoteIntOp_VECTOR_REPEAT(N);
        },
        LOOP_DEPENDENCE_RAW_MASK => {
            LOOP_DEPENDENCE_WAR_MASK;
        },
    }
    if !Res.getNode() {
        return false;
    }
    if Res.getNode() == N {
        return true;
    }
    let mut IsStrictFp: bool = N.isStrictFPOpcode();
    assert!(Res.getValueType() == N.getValueType(0) && N.getNumValues() == (if IsStrictFp { 2 } else { 1 }), "Invalid operand expansion");
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalize-types", 1) {
            dbgs() << "Replacing: ";
            N.dump(&mut self.DAG);
            dbgs() << "     with: ";
            Res.dump();
        }
    }
        if !(false) { break; }
    }
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Res);
    if IsStrictFp {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, SDValue { Node: Res.getNode(), ResNo: 1 });
    }
    return false;
}

fn DAGTypeLegalizer::SExtOrZExtPromotedOperands(self, LHS: *mut SDValue, RHS: *mut SDValue) {
    let mut OpL: SDValue = self.GetPromotedInteger(LHS);
    let mut OpR: SDValue = self.GetPromotedInteger(RHS);
    if self.TLI.isSExtCheaperThanZExt(LHS.getValueType(), OpL.getValueType()) {
        let mut OpLEffectiveBits: u32 = self.DAG.computeKnownBits(OpL, 0).countMaxActiveBits();
        let mut OpREffectiveBits: u32 = self.DAG.computeKnownBits(OpR, 0).countMaxActiveBits();
        if OpLEffectiveBits <= LHS.getScalarValueSizeInBits() && OpREffectiveBits <= RHS.getScalarValueSizeInBits() {
            LHS = OpL;
            RHS = OpR;
            return;
        }
        LHS = self.SExtPromotedInteger(LHS);
        RHS = self.SExtPromotedInteger(RHS);
        return;
    }
    let mut OpLEffectiveBits: u32 = self.DAG.ComputeMaxSignificantBits(OpL, 0);
    let mut OpREffectiveBits: u32 = self.DAG.ComputeMaxSignificantBits(OpR, 0);
    if OpLEffectiveBits <= LHS.getScalarValueSizeInBits() && OpREffectiveBits <= RHS.getScalarValueSizeInBits() {
        LHS = OpL;
        RHS = OpR;
        return;
    }
    LHS = self.ZExtPromotedInteger(LHS);
    RHS = self.ZExtPromotedInteger(RHS);
}

fn DAGTypeLegalizer::PromoteSetCCOperands(self, LHS: *mut SDValue, RHS: *mut SDValue, CCCode: CondCode) {
    if isSignedIntSetCC(CCCode) {
        LHS = self.SExtPromotedInteger(LHS);
        RHS = self.SExtPromotedInteger(RHS);
        return;
    }
    assert!((isUnsignedIntSetCC(CCCode) || isIntEqualitySetCC(CCCode)), "Unknown integer comparison!");
    self.SExtOrZExtPromotedOperands(LHS, RHS);
}

fn DAGTypeLegalizer::PromoteIntOp_ANY_EXTEND(self, N: *mut SDNode) -> SDValue {
    let mut Op: SDValue = self.GetPromotedInteger(N.getOperand(0));
    return self.DAG.getNode(ANY_EXTEND, SDLoc { N }, N.getValueType(0), Op);
}

fn DAGTypeLegalizer::PromoteIntOp_ANY_EXTEND_VECTOR_INREG(self, N: *mut SDNode) -> SDValue {
    let mut Op: SDValue = self.GetPromotedInteger(N.getOperand(0));
    let mut ResVT: EVT = N.getValueType(0);
    let mut OpVT: EVT = Op.getValueType();
    let mut NewVT: EVT = getVectorVT(*self.DAG.getContext(), OpVT.getScalarType(), ResVT.getVectorNumElements(), false);
    Op = self.DAG.getExtractSubvector(SDLoc { Op }, NewVT, Op, 0);
    return self.DAG.getNode(ANY_EXTEND, SDLoc { N }, ResVT, Op);
}

fn DAGTypeLegalizer::PromoteIntOp_ATOMIC_STORE(self, N: *mut AtomicSDNode) -> SDValue {
    let mut Op1: SDValue = self.GetPromotedInteger(N.getOperand(1));
    return self.DAG.getAtomic(N.getOpcode(), SDLoc { N }, N.getMemoryVT(), N.getChain(), Op1, N.getBasePtr(), N.getMemOperand());
}

fn DAGTypeLegalizer::PromoteIntOp_BITCAST(self, N: *mut SDNode) -> SDValue {
    let mut OutVT: EVT = N.getValueType(0);
    let mut InOp: SDValue = N.getOperand(0);
    let mut InVT: EVT = InOp.getValueType();
    let mut NInVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), InVT);
    let mut dl: SDLoc = SDLoc { N };
    match self.getTypeAction(InVT) {
        TypePromoteInteger => {
            if OutVT.isVector() && !InVT.isVector() && self.DAG.getDataLayout().isLittleEndian() {
                let mut EltVT: EVT = OutVT.getVectorElementType();
                let mut EltSize: TypeSize = EltVT.getSizeInBits();
                let mut NInSize: TypeSize = NInVT.getSizeInBits();
                if NInSize.hasKnownScalarFactor(EltSize) {
                    let mut NumEltsWithPadding: u32 = NInSize.getKnownScalarFactor(EltSize);
                    let mut WideVecVT: EVT = getVectorVT(*self.DAG.getContext(), EltVT, NumEltsWithPadding, false);
                    if self.isTypeLegal(WideVecVT) {
                        let mut Promoted: SDValue = self.GetPromotedInteger(InOp);
                        let mut Cast: SDValue = self.DAG.getNode(BITCAST, dl, WideVecVT, Promoted);
                        return self.DAG.getNode(EXTRACT_SUBVECTOR, dl, OutVT, Cast, self.DAG.getVectorIdxConstant(0, dl, false));
                    }
                }
            }
            break;
        },
        _ => {
            break;
        },
    }
    return self.CreateStackStoreLoad(InOp, OutVT);
}

fn DAGTypeLegalizer::PromoteIntOp_BR_CC(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 2, "Don't know how to promote this operand!");
    let mut LHS: SDValue = N.getOperand(2);
    let mut RHS: SDValue = N.getOperand(3);
    self.PromoteSetCCOperands(LHS, RHS, cast(N.getOperand(1)).get());
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, N.getOperand(0), N.getOperand(1), LHS, RHS, N.getOperand(4)), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_BRCOND(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 1, "only know how to promote condition");
    let mut Cond: SDValue = self.PromoteTargetBoolean(N.getOperand(1), EVT { Other });
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, N.getOperand(0), Cond, N.getOperand(2)), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_COND_LOOP(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 1, "only know how to promote condition");
    let mut Cond: SDValue = self.PromoteTargetBoolean(N.getOperand(1), EVT { Other });
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, N.getOperand(0), Cond), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_BUILD_PAIR(self, N: *mut SDNode) -> SDValue {
    let mut OVT: EVT = N.getOperand(0).getValueType();
    let mut Lo: SDValue = self.ZExtPromotedInteger(N.getOperand(0));
    let mut Hi: SDValue = self.GetPromotedInteger(N.getOperand(1));
    assert!(Lo.getValueType() == N.getValueType(0), "Operand over promoted?");
    let mut dl: SDLoc = SDLoc { N };
    Hi = self.DAG.getNode(SHL, dl, N.getValueType(0), Hi, self.DAG.getShiftAmountConstant(OVT.getSizeInBits().operator unsigned long long(), N.getValueType(0), dl));
    return self.DAG.getNode(OR, dl, N.getValueType(0), Lo, Hi);
}

fn DAGTypeLegalizer::PromoteIntOp_BUILD_VECTOR(self, N: *mut SDNode) -> SDValue {
    let mut VecVT: EVT = N.getValueType(0);
    let mut NumElts: u32 = VecVT.getVectorNumElements();
    assert!(!((NumElts & 1) && (!self.TLI.isTypeLegal(VecVT))), "Legal vector of one illegal element?");
    assert!(N.getOperand(0).getValueSizeInBits().operator unsigned long long() >= N.getValueType(0).getScalarSizeInBits(), "Type of inserted value narrower than vector element type!");
    let mut NewOps: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    for let mut i: u32 = 0; i < NumElts; i += 1 {
        NewOps.push(self.GetPromotedInteger(N.getOperand(i)));
    }
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, ArrayRef<SDValue> { NewOps }), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_INSERT_VECTOR_ELT(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    if OpNo == 1 {
        assert!(N.getOperand(1).getValueSizeInBits().operator unsigned long long() >= N.getValueType(0).getScalarSizeInBits(), "Type of inserted value narrower than vector element type!");
        return SDValue { Node: self.DAG.UpdateNodeOperands(N, N.getOperand(0), self.GetPromotedInteger(N.getOperand(1)), N.getOperand(2)), ResNo: 0 };
    }
    assert!(OpNo == 2, "Different operand and result vector types?");
    let mut Idx: SDValue = self.DAG.getZExtOrTrunc(N.getOperand(2), SDLoc { N }, EVT { self.TLI.getVectorIdxTy(self.DAG.getDataLayout()) });
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, N.getOperand(0), N.getOperand(1), Idx), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_ScalarOp(self, N: *mut SDNode) -> SDValue {
    let mut Op: SDValue = self.GetPromotedInteger(N.getOperand(0));
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, Op), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_SELECT(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 0, "Only know how to promote the condition!");
    let mut Cond: SDValue = N.getOperand(0);
    let mut OpTy: EVT = N.getOperand(1).getValueType();
    if N.getOpcode() == VSELECT {
        if self.WidenVSELECTMask(N) {
            Res;
        } else {
            return self.DAG.getNode(N.getOpcode(), SDLoc { N }, N.getValueType(0), Res, N.getOperand(1), N.getOperand(2));
        }
    }
    let mut OpVT: EVT = if N.getOpcode() == SELECT { OpTy.getScalarType() } else { OpTy };
    Cond = self.PromoteTargetBoolean(Cond, OpVT);
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, Cond, N.getOperand(1), N.getOperand(2)), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_SELECT_CC(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 0, "Don't know how to promote this operand!");
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    self.PromoteSetCCOperands(LHS, RHS, cast(N.getOperand(4)).get());
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, LHS, RHS, N.getOperand(2), N.getOperand(3), N.getOperand(4)), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_SETCC(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 0, "Don't know how to promote this operand!");
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    self.PromoteSetCCOperands(LHS, RHS, cast(N.getOperand(2)).get());
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, LHS, RHS, N.getOperand(2)), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_Shift(self, N: *mut SDNode) -> SDValue {
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, N.getOperand(0), self.ZExtPromotedInteger(N.getOperand(1))), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_CMP(self, N: *mut SDNode) -> SDValue {
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    if N.getOpcode() == SCMP {
        LHS = self.SExtPromotedInteger(LHS);
        RHS = self.SExtPromotedInteger(RHS);
    } else {
        self.SExtOrZExtPromotedOperands(LHS, RHS);
    }
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, LHS, RHS), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_FunnelShift(self, N: *mut SDNode) -> SDValue {
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, N.getOperand(0), N.getOperand(1), self.ZExtPromotedInteger(N.getOperand(2))), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_SIGN_EXTEND(self, N: *mut SDNode) -> SDValue {
    let mut Op: SDValue = self.GetPromotedInteger(N.getOperand(0));
    let mut dl: SDLoc = SDLoc { N };
    Op = self.DAG.getNode(ANY_EXTEND, dl, N.getValueType(0), Op);
    return self.DAG.getNode(SIGN_EXTEND_INREG, dl, Op.getValueType(), Op, self.DAG.getValueType(N.getOperand(0).getValueType()));
}

fn DAGTypeLegalizer::PromoteIntOp_SINT_TO_FP(self, N: *mut SDNode) -> SDValue {
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, self.SExtPromotedInteger(N.getOperand(0))), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_STRICT_SINT_TO_FP(self, N: *mut SDNode) -> SDValue {
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, N.getOperand(0), self.SExtPromotedInteger(N.getOperand(1))), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_STORE(self, N: *mut StoreSDNode, OpNo: u32) -> SDValue {
    assert!(isUNINDEXEDStore(N), "Indexed store during type legalization!");
    let mut Ch: SDValue = N.getChain();
    let mut Ptr: SDValue = N.getBasePtr();
    let mut dl: SDLoc = SDLoc { N };
    let mut Val: SDValue = self.GetPromotedInteger(N.getValue());
    return self.DAG.getTruncStore(Ch, dl, Val, Ptr, N.getMemoryVT(), N.getMemOperand());
}

fn DAGTypeLegalizer::PromoteIntOp_VP_STORE(self, N: *mut VPStoreSDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 1, "Unexpected operand for promotion");
    assert!(!N.isIndexed(), "expecting unindexed vp_store!");
    let mut DataOp: SDValue = self.GetPromotedInteger(N.getValue());
    return self.DAG.getTruncStoreVP(N.getChain(), SDLoc { N }, DataOp, N.getBasePtr(), N.getMask(), N.getVectorLength(), N.getMemoryVT(), N.getMemOperand(), N.isCompressingStore());
}

fn DAGTypeLegalizer::PromoteIntOp_MSTORE(self, N: *mut MaskedStoreSDNode, OpNo: u32) -> SDValue {
    let mut DataOp: SDValue = N.getValue();
    let mut Mask: SDValue = N.getMask();
    if OpNo == 4 {
        let mut DataVT: EVT = DataOp.getValueType();
        Mask = self.PromoteTargetBoolean(Mask, DataVT);
        let mut NewOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { N.ops() };
        NewOps[4] = Mask;
        return SDValue { Node: self.DAG.UpdateNodeOperands(N, ArrayRef<SDValue> { NewOps }), ResNo: 0 };
    }
    assert!(OpNo == 1, "Unexpected operand for promotion");
    DataOp = self.GetPromotedInteger(DataOp);
    return self.DAG.getMaskedStore(N.getChain(), SDLoc { N }, DataOp, N.getBasePtr(), N.getOffset(), Mask, N.getMemoryVT(), N.getMemOperand(), N.getAddressingMode(), true, N.isCompressingStore());
}

fn DAGTypeLegalizer::PromoteIntOp_MLOAD(self, N: *mut MaskedLoadSDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 3, "Only know how to promote the mask!");
    let mut DataVT: EVT = N.getValueType(0);
    let mut Mask: SDValue = self.PromoteTargetBoolean(N.getOperand(OpNo), DataVT);
    let mut NewOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { N.ops() };
    NewOps[OpNo] = Mask;
    let mut Res: *mut SDNode = self.DAG.UpdateNodeOperands(N, ArrayRef<SDValue> { NewOps });
    if Res == N {
        return SDValue { Node: Res, ResNo: 0 };
    }
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, SDValue { Node: Res, ResNo: 0 });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, SDValue { Node: Res, ResNo: 1 });
    return SDValue {};
}

fn DAGTypeLegalizer::PromoteIntOp_MGATHER(self, N: *mut MaskedGatherSDNode, OpNo: u32) -> SDValue {
    let mut NewOps: SmallVector<SDValue, 5> = SmallVector<SDValue, 5> { N.ops() };
    if OpNo == 2 {
        let mut DataVT: EVT = N.getValueType(0);
        NewOps[OpNo] = self.PromoteTargetBoolean(N.getOperand(OpNo), DataVT);
    } else if OpNo == 4 {
        if N.isIndexSigned() {
            NewOps[OpNo] = self.SExtPromotedInteger(N.getOperand(OpNo));
        } else {
            NewOps[OpNo] = self.ZExtPromotedInteger(N.getOperand(OpNo));
        }
    } else {
        NewOps[OpNo] = self.GetPromotedInteger(N.getOperand(OpNo));
    }
    let mut Res: *mut SDNode = self.DAG.UpdateNodeOperands(N, ArrayRef<SDValue> { NewOps });
    if Res == N {
        return SDValue { Node: Res, ResNo: 0 };
    }
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, SDValue { Node: Res, ResNo: 0 });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, SDValue { Node: Res, ResNo: 1 });
    return SDValue {};
}

fn DAGTypeLegalizer::PromoteIntOp_MSCATTER(self, N: *mut MaskedScatterSDNode, OpNo: u32) -> SDValue {
    let mut TruncateStore: bool = N.isTruncatingStore();
    let mut NewOps: SmallVector<SDValue, 5> = SmallVector<SDValue, 5> { N.ops() };
    if OpNo == 2 {
        let mut DataVT: EVT = N.getValue().getValueType();
        NewOps[OpNo] = self.PromoteTargetBoolean(N.getOperand(OpNo), DataVT);
    } else if OpNo == 4 {
        if N.isIndexSigned() {
            NewOps[OpNo] = self.SExtPromotedInteger(N.getOperand(OpNo));
        } else {
            NewOps[OpNo] = self.ZExtPromotedInteger(N.getOperand(OpNo));
        }
    } else {
        NewOps[OpNo] = self.GetPromotedInteger(N.getOperand(OpNo));
        TruncateStore = true;
    }
    return self.DAG.getMaskedScatter(self.DAG.getVTList(EVT { Other }), N.getMemoryVT(), SDLoc { N }, ArrayRef<SDValue> { NewOps }, N.getMemOperand(), N.getIndexType(), TruncateStore);
}

fn DAGTypeLegalizer::PromoteIntOp_VECTOR_COMPRESS(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 1, "Can only promote VECTOR_COMPRESS mask.");
    let mut Vec: SDValue = N.getOperand(0);
    let mut VT: EVT = Vec.getValueType();
    let mut Passthru: SDValue = N.getOperand(2);
    let mut Mask: SDValue = self.PromoteTargetBoolean(N.getOperand(1), VT);
    return self.DAG.getNode(VECTOR_COMPRESS, SDLoc { N }, VT, Vec, Mask, Passthru);
}

fn DAGTypeLegalizer::PromoteIntOp_TRUNCATE(self, N: *mut SDNode) -> SDValue {
    let mut Op: SDValue = self.GetPromotedInteger(N.getOperand(0));
    return self.DAG.getNode(TRUNCATE, SDLoc { N }, N.getValueType(0), Op);
}

fn DAGTypeLegalizer::PromoteIntOp_UINT_TO_FP(self, N: *mut SDNode) -> SDValue {
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, self.ZExtPromotedInteger(N.getOperand(0))), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_CONVERT_FROM_ARBITRARY_FP(self, N: *mut SDNode) -> SDValue {
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, self.GetPromotedInteger(N.getOperand(0)), N.getOperand(1)), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_STRICT_UINT_TO_FP(self, N: *mut SDNode) -> SDValue {
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, N.getOperand(0), self.ZExtPromotedInteger(N.getOperand(1))), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_ZERO_EXTEND(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut Src: SDValue = N.getOperand(0);
    let mut Op: SDValue = self.GetPromotedInteger(Src);
    let mut VT: EVT = N.getValueType(0);
    if N.getFlags().hasNonNeg() && Op.getValueType() == VT && self.TLI.isSExtCheaperThanZExt(Src.getValueType(), VT) {
        let mut OpEffectiveBits: u32 = self.DAG.ComputeMaxSignificantBits(Op, 0);
        if OpEffectiveBits <= Src.getScalarValueSizeInBits() {
            return Op;
        }
    }
    Op = self.DAG.getNode(ANY_EXTEND, dl, VT, Op);
    return self.DAG.getZeroExtendInReg(Op, dl, Src.getValueType());
}

fn DAGTypeLegalizer::PromoteIntOp_FIX(self, N: *mut SDNode) -> SDValue {
    let mut Op2: SDValue = self.ZExtPromotedInteger(N.getOperand(2));
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, N.getOperand(0), N.getOperand(1), Op2), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_FRAMERETURNADDR(self, N: *mut SDNode) -> SDValue {
    let mut Op: SDValue = self.ZExtPromotedInteger(N.getOperand(0));
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, Op), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_ExpOp(self, N: *mut SDNode) -> SDValue {
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut Chain: SDValue = if IsStrict { N.getOperand(0) } else { SDValue {} };
    let mut IsPowI: bool = N.getOpcode() == FPOWI || N.getOpcode() == STRICT_FPOWI;
    let mut OpOffset: u32 = if IsStrict { 1 } else { 0 };
    let mut LC: Libcall = if IsPowI { getPOWI(N.getValueType(0)) } else { getLDEXP(N.getValueType(0)) };
    let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if LCImpl == Unsupported {
        if IsPowI && N.getValueType(0).isVector() {
            return self.DAG.UnrollVectorOp(N, 0);
        }
        let mut NewOps: SmallVector<SDValue, 3> = SmallVector<SDValue, 3> { N.ops() };
        NewOps[1 + OpOffset] = self.SExtPromotedInteger(N.getOperand(1 + OpOffset));
        return SDValue { Node: self.DAG.UpdateNodeOperands(N, ArrayRef<SDValue> { NewOps }), ResNo: 0 };
    }
    if N.getOperand(1 + OpOffset).getScalarValueSizeInBits() > self.DAG.getLibInfo().getIntSize() {
        let mut Fn: *Function = self.DAG.getMachineFunction().getFunction();
        Fn.getContext().diagnose(DiagnosticInfoLegalizationFailure { if IsPowI { "powi" } else { "ldexp" } + " exponent does not match sizeof(int)", Fn, DiagnosticLocation { N.getDebugLoc() }, DS_Error });
        if IsStrict {
            self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Chain);
        }
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, self.DAG.getPOISON(N.getValueType(0)));
        return SDValue {};
    }
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    CallOptions.setIsSigned(true);
    let mut Ops: [2]SDValue = [N.getOperand(0 + OpOffset), N.getOperand(1 + OpOffset)];
    let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, LCImpl, N.getValueType(0), ArrayRef<SDValue> { Ops }, CallOptions, SDLoc { N }, Chain);
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Tmp.first);
    if IsStrict {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Tmp.second);
    }
    return SDValue {};
}

fn getExtendForIntVecReduction(N: *mut SDNode) -> u32 {
    match N.getOpcode() {
        _ => {
            llvm_unreachable_internal("Expected integer vector reduction", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeIntegerTypes.cpp", 2758);
        },
        VECREDUCE_ADD => {
            VECREDUCE_MUL;
        },
        VECREDUCE_SMAX => {
            VECREDUCE_SMIN;
        },
        VECREDUCE_UMAX => {
            VECREDUCE_UMIN;
        },
    }
}

fn DAGTypeLegalizer::PromoteIntOpVectorReduction(self, N: *mut SDNode, V: SDValue) -> SDValue {
    match getExtendForIntVecReduction(N) {
        _ => {
            llvm_unreachable_internal("Impossible extension kind for integer reduction", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeIntegerTypes.cpp", 2786);
        },
        ANY_EXTEND => {
            return self.GetPromotedInteger(V);
        },
        SIGN_EXTEND => {
            return self.SExtPromotedInteger(V);
        },
        ZERO_EXTEND => {
            return self.ZExtPromotedInteger(V);
        },
    }
}

fn DAGTypeLegalizer::PromoteIntOp_VECREDUCE(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut Op: SDValue = self.PromoteIntOpVectorReduction(N, N.getOperand(0));
    let mut OrigEltVT: EVT = N.getOperand(0).getValueType().getVectorElementType();
    let mut InVT: EVT = Op.getValueType();
    let mut EltVT: EVT = InVT.getVectorElementType();
    let mut ResVT: EVT = N.getValueType(0);
    let mut Opcode: u32 = N.getOpcode();
    if Opcode == VECREDUCE_XOR && OrigEltVT == EVT { i1 } && !self.TLI.isOperationLegalOrCustom(VECREDUCE_XOR, InVT, false) && self.TLI.isOperationLegalOrCustom(VECREDUCE_ADD, InVT, false) {
        Opcode = VECREDUCE_ADD;
    } else if Opcode == VECREDUCE_OR && OrigEltVT == EVT { i1 } && !self.TLI.isOperationLegalOrCustom(VECREDUCE_OR, InVT, false) && self.TLI.isOperationLegalOrCustom(VECREDUCE_UMAX, InVT, false) {
        Opcode = VECREDUCE_UMAX;
        match self.TLI.getBooleanContents(InVT) {
            UndefinedBooleanContent => {
                ZeroOrOneBooleanContent;
            },
            ZeroOrNegativeOneBooleanContent => {
                Op = self.SExtPromotedInteger(N.getOperand(0));
            },
        }
    } else if Opcode == VECREDUCE_AND && OrigEltVT == EVT { i1 } && !self.TLI.isOperationLegalOrCustom(VECREDUCE_AND, InVT, false) && self.TLI.isOperationLegalOrCustom(VECREDUCE_UMIN, InVT, false) {
        Opcode = VECREDUCE_UMIN;
        match self.TLI.getBooleanContents(InVT) {
            UndefinedBooleanContent => {
                ZeroOrOneBooleanContent;
            },
            ZeroOrNegativeOneBooleanContent => {
                Op = self.SExtPromotedInteger(N.getOperand(0));
            },
        }
    }
    if ResVT.bitsGE(EltVT) {
        return self.DAG.getNode(Opcode, SDLoc { N }, ResVT, Op);
    }
    let mut Reduce: SDValue = self.DAG.getNode(Opcode, dl, EltVT, Op);
    return self.DAG.getNode(TRUNCATE, dl, ResVT, Reduce);
}

fn DAGTypeLegalizer::PromoteIntOp_VP_REDUCE(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Op: SDValue = N.getOperand(OpNo);
    let mut NewOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { N.ops() };
    if OpNo == 2 {
        NewOps[2] = self.PromoteTargetBoolean(Op, N.getOperand(1).getValueType());
        return SDValue { Node: self.DAG.UpdateNodeOperands(N, ArrayRef<SDValue> { NewOps }), ResNo: 0 };
    }
    assert!(OpNo == 1, "Unexpected operand for promotion");
    Op = self.PromoteIntOpVectorReduction(N, Op);
    NewOps[OpNo] = Op;
    let mut VT: EVT = N.getValueType(0);
    let mut EltVT: EVT = Op.getValueType().getScalarType();
    if VT.bitsGE(EltVT) {
        return self.DAG.getNode(N.getOpcode(), SDLoc { N }, VT, ArrayRef<SDValue> { NewOps });
    }
    NewOps[0] = self.DAG.getNode(getExtendForIntVecReduction(N), DL, EltVT, N.getOperand(0));
    let mut Reduce: SDValue = self.DAG.getNode(N.getOpcode(), DL, EltVT, ArrayRef<SDValue> { NewOps });
    return self.DAG.getNode(TRUNCATE, DL, VT, Reduce);
}

fn DAGTypeLegalizer::PromoteIntOp_SET_ROUNDING(self, N: *mut SDNode) -> SDValue {
    let mut Op: SDValue = self.ZExtPromotedInteger(N.getOperand(1));
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, N.getOperand(0), Op), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_STACKMAP(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo > 1);
    let mut NewOps: SmallVector<SDValue> = SmallVector<SDValue> { N.ops() };
    NewOps[OpNo] = self.GetPromotedInteger(NewOps[OpNo]);
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, ArrayRef<SDValue> { NewOps }), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_PATCHPOINT(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo >= 7);
    let mut NewOps: SmallVector<SDValue> = SmallVector<SDValue> { N.ops() };
    NewOps[OpNo] = self.GetPromotedInteger(NewOps[OpNo]);
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, ArrayRef<SDValue> { NewOps }), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_WRITE_REGISTER(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    let mut Fn: *Function = self.DAG.getMachineFunction().getFunction();
    Fn.getContext().diagnose(DiagnosticInfoLegalizationFailure { "cannot use llvm.write_register with illegal type", Fn, DiagnosticLocation { N.getDebugLoc() }, DS_Error });
    return N.getOperand(0);
}

fn DAGTypeLegalizer::PromoteIntOp_VP_STRIDED(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!((N.getOpcode() == EXPERIMENTAL_VP_STRIDED_LOAD && OpNo == 3) || (N.getOpcode() == EXPERIMENTAL_VP_STRIDED_STORE && OpNo == 4));
    let mut NewOps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { N.ops() };
    NewOps[OpNo] = self.SExtPromotedInteger(N.getOperand(OpNo));
    let mut Res: *mut SDNode = self.DAG.UpdateNodeOperands(N, ArrayRef<SDValue> { NewOps });
    if Res == N {
        return SDValue { Node: Res, ResNo: 0 };
    }
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, SDValue { Node: Res, ResNo: 0 });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, SDValue { Node: Res, ResNo: 1 });
    return SDValue {};
}

fn DAGTypeLegalizer::PromoteIntOp_VP_SPLICE(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    let mut NewOps: SmallVector<SDValue, 6> = SmallVector<SDValue, 6> { N.ops() };
    if OpNo == 2 {
        NewOps[OpNo] = self.SExtPromotedInteger(N.getOperand(OpNo));
        return SDValue { Node: self.DAG.UpdateNodeOperands(N, ArrayRef<SDValue> { NewOps }), ResNo: 0 };
    }
    assert!((OpNo == 4 || OpNo == 5), "Unexpected operand for promotion");
    NewOps[OpNo] = self.ZExtPromotedInteger(N.getOperand(OpNo));
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, ArrayRef<SDValue> { NewOps }), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_VECTOR_HISTOGRAM(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 1, "Unexpected operand for promotion");
    let mut NewOps: SmallVector<SDValue, 7> = SmallVector<SDValue, 7> { N.ops() };
    NewOps[1] = self.GetPromotedInteger(N.getOperand(1));
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, ArrayRef<SDValue> { NewOps }), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_UnaryBooleanVectorOp(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 0, "Unexpected operand for promotion");
    let mut Op: SDValue = N.getOperand(0);
    let mut NewOp: SDValue = SDValue {};
    if self.TLI.getBooleanContents(Op.getValueType()) == ZeroOrNegativeOneBooleanContent {
        NewOp = self.SExtPromotedInteger(Op);
    } else {
        NewOp = self.ZExtPromotedInteger(Op);
    }
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, NewOp), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_GET_ACTIVE_LANE_MASK(self, N: *mut SDNode) -> SDValue {
    let mut NewOps: SmallVector<SDValue, 1> = SmallVector<SDValue, 1> { N.ops() };
    NewOps[0] = self.ZExtPromotedInteger(N.getOperand(0));
    NewOps[1] = self.ZExtPromotedInteger(N.getOperand(1));
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, ArrayRef<SDValue> { NewOps }), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_VECTOR_MATCH(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo < 3, "Unexpected operand for promotion");
    if OpNo != 2 {
        return self.TLI.expandVectorMatch(N, self.DAG);
    }
    let mut NewOps: SmallVector<SDValue, 3> = SmallVector<SDValue, 3> { N.ops() };
    NewOps[2] = self.PromoteTargetBoolean(N.getOperand(2), N.getValueType(0));
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, ArrayRef<SDValue> { NewOps }), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_MaskedBinOp(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 2);
    let mut NewOps: SmallVector<SDValue, 3> = SmallVector<SDValue, 3> { N.ops() };
    NewOps[2] = self.PromoteTargetBoolean(NewOps[2], N.getValueType(0));
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, ArrayRef<SDValue> { NewOps }), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_PARTIAL_REDUCE_MLA(self, N: *mut SDNode) -> SDValue {
    let mut NewOps: SmallVector<SDValue, 1> = SmallVector<SDValue, 1> { N.ops() };
    match N.getOpcode() {
        PARTIAL_REDUCE_SMLA => {
            NewOps[1] = self.SExtPromotedInteger(N.getOperand(1));
        },
        PARTIAL_REDUCE_UMLA => {
            NewOps[1] = self.ZExtPromotedInteger(N.getOperand(1));
        },
        PARTIAL_REDUCE_SUMLA => {
            NewOps[1] = self.SExtPromotedInteger(N.getOperand(1));
        },
        _ => {
            llvm_unreachable_internal("unexpected opcode", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeIntegerTypes.cpp", 3013);
        },
    }
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, ArrayRef<SDValue> { NewOps }), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_LOOP_DEPENDENCE_MASK(self, N: *mut SDNode) -> SDValue {
    let mut NewOps: [4]SDValue = [4]SDValue {};
    NewOps[0] = self.ZExtPromotedInteger(N.getOperand(0));
    NewOps[1] = self.ZExtPromotedInteger(N.getOperand(1));
    NewOps[2] = self.ZExtPromotedInteger(N.getOperand(2));
    NewOps[3] = N.getOperand(3);
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, ArrayRef<SDValue> { NewOps }), ResNo: 0 };
}

fn DAGTypeLegalizer::PromoteIntOp_VECTOR_REPEAT(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Src: SDValue = self.GetPromotedInteger(N.getOperand(0));
    let mut SrcVT: EVT = Src.getValueType();
    let mut OrigVT: EVT = N.getValueType(0);
    let mut NewVT: EVT = OrigVT.changeVectorElementType(*self.DAG.getContext(), SrcVT.getVectorElementType());
    let mut Res: SDValue = self.DAG.getNode(VECTOR_REPEAT, DL, NewVT, Src);
    return self.DAG.getNode(TRUNCATE, DL, OrigVT, Res);
}

fn DAGTypeLegalizer::ExpandIntegerResult(self, N: *mut SDNode, ResNo: u32) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalize-types", 1) {
            dbgs() << "Expand integer result: ";
            N.dump(&mut self.DAG);
        }
    }
        if !(false) { break; }
    }
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    Lo = Hi = SDValue {};
    if self.CustomLowerNode(N, N.getValueType(ResNo), true) {
        return;
    }
    match N.getOpcode() {
        _ => {
            dbgs() << "ExpandIntegerResult #" << ResNo << ": ";
        },
        ARITH_FENCE => {
            self.SplitRes_ARITH_FENCE(N, Lo, Hi);
        },
        MERGE_VALUES => {
            self.SplitRes_MERGE_VALUES(N, ResNo, Lo, Hi);
        },
        SELECT => {
            self.SplitRes_Select(N, Lo, Hi);
        },
        SELECT_CC => {
            self.SplitRes_SELECT_CC(N, Lo, Hi);
        },
        POISON => {
            UNDEF;
        },
        FREEZE => {
            self.SplitRes_FREEZE(N, Lo, Hi);
        },
        SETCC => {
            self.ExpandIntRes_SETCC(N, Lo, Hi);
        },
        BITCAST => {
            self.ExpandRes_BITCAST(N, Lo, Hi);
        },
        BUILD_PAIR => {
            self.ExpandRes_BUILD_PAIR(N, Lo, Hi);
        },
        EXTRACT_ELEMENT => {
            self.ExpandRes_EXTRACT_ELEMENT(N, Lo, Hi);
        },
        EXTRACT_VECTOR_ELT => {
            self.ExpandRes_EXTRACT_VECTOR_ELT(N, Lo, Hi);
        },
        VAARG => {
            self.ExpandRes_VAARG(N, Lo, Hi);
        },
        ANY_EXTEND => {
            self.ExpandIntRes_ANY_EXTEND(N, Lo, Hi);
        },
        AssertSext => {
            self.ExpandIntRes_AssertSext(N, Lo, Hi);
        },
        AssertZext => {
            self.ExpandIntRes_AssertZext(N, Lo, Hi);
        },
        BITREVERSE => {
            self.ExpandIntRes_BITREVERSE(N, Lo, Hi);
        },
        BSWAP => {
            self.ExpandIntRes_BSWAP(N, Lo, Hi);
        },
        PARITY => {
            self.ExpandIntRes_PARITY(N, Lo, Hi);
        },
        Constant => {
            self.ExpandIntRes_Constant(N, Lo, Hi);
        },
        ABS => {
            ABS_MIN_POISON;
        },
        ABDS => {
            ABDU;
        },
        CTLZ_ZERO_POISON => {
            CTLZ;
        },
        CTLS => {
            self.ExpandIntRes_CTLS(N, Lo, Hi);
        },
        CTPOP => {
            self.ExpandIntRes_CTPOP(N, Lo, Hi);
        },
        CTTZ_ZERO_POISON => {
            CTTZ;
        },
        GET_ROUNDING => {
            self.ExpandIntRes_GET_ROUNDING(N, Lo, Hi);
        },
        STRICT_FP_TO_SINT => {
            FP_TO_SINT;
        },
        FP_TO_SINT_SAT => {
            FP_TO_UINT_SAT;
        },
        STRICT_LROUND => {
            STRICT_LRINT;
        },
        LOAD => {
            self.ExpandIntRes_LOAD(cast(N), Lo, Hi);
        },
        MUL => {
            self.ExpandIntRes_MUL(N, Lo, Hi);
        },
        READCYCLECOUNTER => {
            READSTEADYCOUNTER;
        },
        SDIV => {
            self.ExpandIntRes_SDIV(N, Lo, Hi);
        },
        SIGN_EXTEND => {
            self.ExpandIntRes_SIGN_EXTEND(N, Lo, Hi);
        },
        SIGN_EXTEND_INREG => {
            self.ExpandIntRes_SIGN_EXTEND_INREG(N, Lo, Hi);
        },
        SREM => {
            self.ExpandIntRes_SREM(N, Lo, Hi);
        },
        TRUNCATE => {
            self.ExpandIntRes_TRUNCATE(N, Lo, Hi);
        },
        UDIV => {
            self.ExpandIntRes_UDIV(N, Lo, Hi);
        },
        UREM => {
            self.ExpandIntRes_UREM(N, Lo, Hi);
        },
        ZERO_EXTEND => {
            self.ExpandIntRes_ZERO_EXTEND(N, Lo, Hi);
        },
        ATOMIC_LOAD => {
            self.ExpandIntRes_ATOMIC_LOAD(N, Lo, Hi);
        },
        ATOMIC_LOAD_ADD => {
            ATOMIC_LOAD_SUB;
        },
        ATOMIC_CMP_SWAP_WITH_SUCCESS => {
            let mut AN: *mut AtomicSDNode = cast(N);
            let mut VTs: SDVTList = self.DAG.getVTList(N.getValueType(0), EVT { Other });
            let mut Tmp: SDValue = self.DAG.getAtomicCmpSwap(ATOMIC_CMP_SWAP, SDLoc { N }, AN.getMemoryVT(), VTs, N.getOperand(0), N.getOperand(1), N.getOperand(2), N.getOperand(3), AN.getMemOperand());
            let mut Success: SDValue = self.DAG.getSetCC(SDLoc { N }, N.getValueType(1), Tmp, N.getOperand(2), SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
            self.SplitInteger(Tmp, Lo, Hi);
            self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Success);
            self.ReplaceValueWith(SDValue { Node: N, ResNo: 2 }, Tmp.getValue(1));
            break;
        },
        AND => {
            OR;
        },
        UMAX => {
            SMAX;
        },
        SCMP => {
            UCMP;
        },
        ADD => {
            SUB;
        },
        ADDC => {
            SUBC;
        },
        ADDE => {
            SUBE;
        },
        UADDO_CARRY => {
            USUBO_CARRY;
        },
        SADDO_CARRY => {
            SSUBO_CARRY;
        },
        SHL => {
            SRA;
        },
        SADDO => {
            SSUBO;
        },
        UADDO => {
            USUBO;
        },
        UMULO => {
            SMULO;
        },
        SADDSAT => {
            UADDSAT;
        },
        SSHLSAT => {
            USHLSAT;
        },
        AVGCEILS => {
            AVGCEILU;
        },
        SMULFIX => {
            SMULFIXSAT;
        },
        SDIVFIX => {
            SDIVFIXSAT;
        },
        VECREDUCE_ADD => {
            VECREDUCE_MUL;
        },
        ROTL => {
            ROTR;
        },
        FSHL => {
            FSHR;
        },
        CLMUL => {
            CLMULR;
        },
        PEXT => {
            self.ExpandIntRes_PEXT(N, Lo, Hi);
        },
        PDEP => {
            self.ExpandIntRes_PDEP(N, Lo, Hi);
        },
        MULHS => {
            MULHU;
        },
        VSCALE => {
            self.ExpandIntRes_VSCALE(N, Lo, Hi);
        },
        READ_REGISTER => {
            self.ExpandIntRes_READ_REGISTER(N, Lo, Hi);
        },
        CTTZ_ELTS => {
            CTTZ_ELTS_ZERO_POISON;
        },
    }
    if Lo.getNode() {
        self.SetExpandedInteger(SDValue { Node: N, ResNo: ResNo }, Lo, Hi);
    }
}

fn DAGTypeLegalizer::ExpandAtomic(self, Node: *mut SDNode) -> pair<SDValue, SDValue> {
    let mut Opc: u32 = Node.getOpcode();
    let mut VT: MVT = cast(Node).getMemoryVT().getSimpleVT();
    let mut order: AtomicOrdering = cast(Node).getMergedOrdering();
    let mut LC: Libcall = getOUTLINE_ATOMIC(Opc, order, VT);
    let mut RetVT: EVT = Node.getValueType(0);
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    let mut Ops: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if LCImpl != Unsupported {
        Ops.append(Node.op_begin() + 2, Node.op_end());
        Ops.push(ValueParamT { Node.getOperand(1) });
    } else {
        LC = getSYNC(Opc, VT);
        assert!(LC != UNKNOWN_LIBCALL, "Unexpected atomic op or value type!");
        Ops.append(Node.op_begin() + 1, Node.op_end());
        LCImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    }
    return self.TLI.makeLibCall(self.DAG, LCImpl, RetVT, ArrayRef<SDValue> { Ops }, CallOptions, SDLoc { Node }, Node.getOperand(0));
}

fn DAGTypeLegalizer::ExpandShiftByConstant(self, N: *mut SDNode, Amt: *APInt, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut DL: SDLoc = SDLoc { N };
    let mut InL: SDValue = SDValue {};
    let mut InH: SDValue = SDValue {};
    self.GetExpandedInteger(N.getOperand(0), InL, InH);
    if operator(Amt) {
        Lo = InL;
        Hi = InH;
        return;
    }
    let mut NVT: EVT = InL.getValueType();
    let mut VTBits: u32 = N.getValueType(0).getSizeInBits().operator unsigned long long();
    let mut NVTBits: u32 = NVT.getSizeInBits().operator unsigned long long();
    if N.getOpcode() == SHL {
        if Amt.uge(VTBits) {
            Lo = Hi = self.DAG.getConstant(0, DL, NVT, false, false);
        } else if Amt.ugt(NVTBits) {
            Lo = self.DAG.getConstant(0, DL, NVT, false, false);
            Hi = self.DAG.getNode(SHL, DL, NVT, InL, self.DAG.getShiftAmountConstant(Amt - NVTBits, NVT, DL));
        } else if Amt == NVTBits {
            Lo = self.DAG.getConstant(0, DL, NVT, false, false);
            Hi = InL;
        } else {
            Lo = self.DAG.getNode(SHL, DL, NVT, InL, self.DAG.getShiftAmountConstant(Amt, NVT, DL));
            if self.TLI.isOperationLegal(FSHL, NVT) {
                Hi = self.DAG.getNode(FSHL, DL, NVT, InH, InL, self.DAG.getShiftAmountConstant(Amt, NVT, DL));
            } else {
                Hi = self.DAG.getNode(OR, DL, NVT, self.DAG.getNode(SHL, DL, NVT, InH, self.DAG.getShiftAmountConstant(Amt, NVT, DL)), self.DAG.getNode(SRL, DL, NVT, InL, self.DAG.getShiftAmountConstant(operator(Amt) + NVTBits, NVT, DL)));
            }
        }
        return;
    }
    if N.getOpcode() == SRL {
        if Amt.uge(VTBits) {
            Lo = Hi = self.DAG.getConstant(0, DL, NVT, false, false);
        } else if Amt.ugt(NVTBits) {
            Lo = self.DAG.getNode(SRL, DL, NVT, InH, self.DAG.getShiftAmountConstant(Amt - NVTBits, NVT, DL));
            Hi = self.DAG.getConstant(0, DL, NVT, false, false);
        } else if Amt == NVTBits {
            Lo = InH;
            Hi = self.DAG.getConstant(0, DL, NVT, false, false);
        } else {
            if self.TLI.isOperationLegal(FSHR, NVT) {
                Lo = self.DAG.getNode(FSHR, DL, NVT, InH, InL, self.DAG.getShiftAmountConstant(Amt, NVT, DL));
            } else {
                Lo = self.DAG.getNode(OR, DL, NVT, self.DAG.getNode(SRL, DL, NVT, InL, self.DAG.getShiftAmountConstant(Amt, NVT, DL)), self.DAG.getNode(SHL, DL, NVT, InH, self.DAG.getShiftAmountConstant(operator(Amt) + NVTBits, NVT, DL)));
            }
            Hi = self.DAG.getNode(SRL, DL, NVT, InH, self.DAG.getShiftAmountConstant(Amt, NVT, DL));
        }
        return;
    }
    assert!(N.getOpcode() == SRA, "Unknown shift!");
    if Amt.uge(VTBits) {
        Hi = Lo = self.DAG.getNode(SRA, DL, NVT, InH, self.DAG.getShiftAmountConstant(NVTBits - 1, NVT, DL));
    } else if Amt.ugt(NVTBits) {
        Lo = self.DAG.getNode(SRA, DL, NVT, InH, self.DAG.getShiftAmountConstant(Amt - NVTBits, NVT, DL));
        Hi = self.DAG.getNode(SRA, DL, NVT, InH, self.DAG.getShiftAmountConstant(NVTBits - 1, NVT, DL));
    } else if Amt == NVTBits {
        Lo = InH;
        Hi = self.DAG.getNode(SRA, DL, NVT, InH, self.DAG.getShiftAmountConstant(NVTBits - 1, NVT, DL));
    } else {
        if self.TLI.isOperationLegal(FSHR, NVT) {
            Lo = self.DAG.getNode(FSHR, DL, NVT, InH, InL, self.DAG.getShiftAmountConstant(Amt, NVT, DL));
        } else {
            Lo = self.DAG.getNode(OR, DL, NVT, self.DAG.getNode(SRL, DL, NVT, InL, self.DAG.getShiftAmountConstant(Amt, NVT, DL)), self.DAG.getNode(SHL, DL, NVT, InH, self.DAG.getShiftAmountConstant(operator(Amt) + NVTBits, NVT, DL)));
        }
        Hi = self.DAG.getNode(SRA, DL, NVT, InH, self.DAG.getShiftAmountConstant(Amt, NVT, DL));
    }
}

fn DAGTypeLegalizer::ExpandShiftWithKnownAmountBit(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) -> bool {
    let mut Opc: u32 = N.getOpcode();
    let mut In: SDValue = N.getOperand(0);
    let mut Amt: SDValue = N.getOperand(1);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut ShTy: EVT = Amt.getValueType();
    let mut ShBits: u32 = ShTy.getScalarSizeInBits();
    let mut NVTBits: u32 = NVT.getScalarSizeInBits();
    assert!(isPowerOf2_32(NVTBits), "Expanded integer type size not a power of two!");
    let mut dl: SDLoc = SDLoc { N };
    let mut HighBitMask: APInt = getHighBitsSet(ShBits, ShBits - Log2_32(NVTBits));
    let mut Known: KnownBits = self.DAG.computeKnownBits(Amt, 0);
    if ((Known.Zero | Known.One) & HighBitMask) == 0 {
        return false;
    }
    let mut InL: SDValue = SDValue {};
    let mut InH: SDValue = SDValue {};
    self.GetExpandedInteger(In, InL, InH);
    if Known.One.intersects(HighBitMask) {
        Amt = self.DAG.getNode(AND, dl, ShTy, Amt, self.DAG.getConstant(operator(HighBitMask), dl, ShTy, false, false));
        match Opc {
            _ => {
                llvm_unreachable_internal("Unknown shift", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeIntegerTypes.cpp", 3457);
            },
            SHL => {
                Lo = self.DAG.getConstant(0, dl, NVT, false, false);
            },
            SRL => {
                Hi = self.DAG.getConstant(0, dl, NVT, false, false);
            },
            SRA => {
                Hi = self.DAG.getNode(SRA, dl, NVT, InH, self.DAG.getConstant(NVTBits - 1, dl, ShTy, false, false));
            },
        }
    }
    if HighBitMask.isSubsetOf(Known.Zero) {
        let mut Amt2: SDValue = self.DAG.getNode(XOR, dl, ShTy, Amt, self.DAG.getConstant(NVTBits - 1, dl, ShTy, false, false));
        let mut Op1: u32 = 0;
        let mut Op2: u32 = 0;
        match Opc {
            _ => {
                llvm_unreachable_internal("Unknown shift", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeIntegerTypes.cpp", 3485);
            },
            SHL => {
                Op1 = SHL;
            },
            SRL => {
                SRA;
            },
        }
        if Opc != SHL {
            swap(InL, InH);
        }
        let mut Sh1: SDValue = self.DAG.getNode(Op2, dl, NVT, InL, self.DAG.getConstant(1, dl, ShTy, false, false));
        let mut Sh2: SDValue = self.DAG.getNode(Op2, dl, NVT, Sh1, Amt2);
        Lo = self.DAG.getNode(Opc, dl, NVT, InL, Amt);
        Hi = self.DAG.getNode(OR, dl, NVT, self.DAG.getNode(Op1, dl, NVT, InH, Amt), Sh2);
        if Opc != SHL {
            swap(Hi, Lo);
        }
        return true;
    }
    return false;
}

fn DAGTypeLegalizer::ExpandShiftWithUnknownAmountBit(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) -> bool {
    let mut Amt: SDValue = N.getOperand(1);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut ShTy: EVT = Amt.getValueType();
    let mut NVTBits: u32 = NVT.getSizeInBits().operator unsigned long long();
    assert!(isPowerOf2_32(NVTBits), "Expanded integer type size not a power of two!");
    let mut dl: SDLoc = SDLoc { N };
    let mut InL: SDValue = SDValue {};
    let mut InH: SDValue = SDValue {};
    self.GetExpandedInteger(N.getOperand(0), InL, InH);
    let mut NVBitsNode: SDValue = self.DAG.getConstant(NVTBits, dl, ShTy, false, false);
    let mut AmtExcess: SDValue = self.DAG.getNode(SUB, dl, ShTy, Amt, NVBitsNode);
    let mut AmtLack: SDValue = self.DAG.getNode(SUB, dl, ShTy, NVBitsNode, Amt);
    let mut isShort: SDValue = self.DAG.getSetCC(dl, self.getSetCCResultType(ShTy), Amt, NVBitsNode, SETULT, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut isZero: SDValue = self.DAG.getSetCC(dl, self.getSetCCResultType(ShTy), Amt, self.DAG.getConstant(0, dl, ShTy, false, false), SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut LoS: SDValue = SDValue {};
    let mut HiS: SDValue = SDValue {};
    let mut LoL: SDValue = SDValue {};
    let mut HiL: SDValue = SDValue {};
    match N.getOpcode() {
        _ => {
            llvm_unreachable_internal("Unknown shift", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeIntegerTypes.cpp", 3539);
        },
        SHL => {
            LoS = self.DAG.getNode(SHL, dl, NVT, InL, Amt);
        },
        SRL => {
            HiS = self.DAG.getNode(SRL, dl, NVT, InH, Amt);
        },
        SRA => {
            HiS = self.DAG.getNode(SRA, dl, NVT, InH, Amt);
        },
    }
}

fn getExpandedMinMaxOps(Op: i32) -> NodeType> {
    match Op {
        _ => {
            llvm_unreachable_internal("invalid min/max opcode", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeIntegerTypes.cpp", 3594);
        },
        SMAX => {
            return make_pair(SETGT, UMAX);
        },
        UMAX => {
            return make_pair(SETUGT, UMAX);
        },
        SMIN => {
            return make_pair(SETLT, UMIN);
        },
        UMIN => {
            return make_pair(SETULT, UMIN);
        },
    }
}

fn DAGTypeLegalizer::ExpandIntRes_SETCC(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut DL: SDLoc = SDLoc { N };
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut NewVT: EVT = self.getSetCCResultType(LHS.getValueType());
    let mut Res: SDValue = self.DAG.getNode(SETCC, DL, NewVT, LHS, RHS, N.getOperand(2));
    Res = self.DAG.getBoolExtOrTrunc(Res, DL, N.getValueType(0), NewVT);
    self.SplitInteger(Res, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_MINMAX(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut DL: SDLoc = SDLoc { N };
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut NumBits: u32 = N.getValueType(0).getScalarSizeInBits();
    let mut NumHalfBits: u32 = NumBits / 2;
    if self.DAG.ComputeNumSignBits(LHS, 0) > NumHalfBits && self.DAG.ComputeNumSignBits(RHS, 0) > NumHalfBits {
        let mut LHSL: SDValue = SDValue {};
        let mut LHSH: SDValue = SDValue {};
        let mut RHSL: SDValue = SDValue {};
        let mut RHSH: SDValue = SDValue {};
        self.GetExpandedInteger(LHS, LHSL, LHSH);
        self.GetExpandedInteger(RHS, RHSL, RHSH);
        let mut NVT: EVT = LHSL.getValueType();
        Lo = self.DAG.getNode(N.getOpcode(), DL, NVT, LHSL, RHSL);
        Hi = self.DAG.getNode(SRA, DL, NVT, Lo, self.DAG.getShiftAmountConstant(NumHalfBits - 1, NVT, DL));
        return;
    }
    if (N.getOpcode() == SMAX && isNullConstant(RHS)) || (N.getOpcode() == SMIN && isAllOnesConstant(RHS)) {
        let mut LHSL: SDValue = SDValue {};
        let mut LHSH: SDValue = SDValue {};
        let mut RHSL: SDValue = SDValue {};
        let mut RHSH: SDValue = SDValue {};
        self.GetExpandedInteger(LHS, LHSL, LHSH);
        self.GetExpandedInteger(RHS, RHSL, RHSH);
        let mut NVT: EVT = LHSL.getValueType();
        let mut CCT: EVT = self.getSetCCResultType(NVT);
        let mut HiNeg: SDValue = self.DAG.getSetCC(DL, CCT, LHSH, self.DAG.getConstant(0, DL, NVT, false, false), SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
        if N.getOpcode() == SMIN {
            Lo = self.DAG.getSelect(DL, NVT, HiNeg, LHSL, self.DAG.getAllOnesConstant(DL, NVT, false, false), SDNodeFlags { Flags: None });
        } else {
            Lo = self.DAG.getSelect(DL, NVT, HiNeg, self.DAG.getConstant(0, DL, NVT, false, false), LHSL, SDNodeFlags { Flags: None });
        }
        Hi = self.DAG.getNode(N.getOpcode(), DL, NVT, ArrayRef<SDValue> { [LHSH, RHSH] });
        return;
    }
    let mut RHSVal: *APInt = null;
    if dyn_cast(RHS) {
        RHSConst;
    } else {
        RHSVal = &mut RHSConst.getAPIntValue();
    }
    if RHSVal && (N.getOpcode() == UMIN || N.getOpcode() == UMAX) && (RHSVal.countLeadingOnes() >= NumHalfBits || RHSVal.countLeadingZeros() >= NumHalfBits) {
        let mut LHSL: SDValue = SDValue {};
        let mut LHSH: SDValue = SDValue {};
        let mut RHSL: SDValue = SDValue {};
        let mut RHSH: SDValue = SDValue {};
        self.GetExpandedInteger(LHS, LHSL, LHSH);
        self.GetExpandedInteger(RHS, RHSL, RHSH);
        let mut NVT: EVT = LHSL.getValueType();
        let mut CCT: EVT = self.getSetCCResultType(NVT);
        let mut LoOpc: NodeType = zeroed();
        let mut CondC: CondCode = zeroed();
        tie(CondC, LoOpc) = getExpandedMinMaxOps(N.getOpcode());
        Hi = self.DAG.getNode(N.getOpcode(), DL, NVT, ArrayRef<SDValue> { [LHSH, RHSH] });
        let mut IsHiLeft: SDValue = self.DAG.getSetCC(DL, CCT, LHSH, RHSH, CondC, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut IsHiEq: SDValue = self.DAG.getSetCC(DL, CCT, LHSH, RHSH, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut LoCmp: SDValue = self.DAG.getSelect(DL, NVT, IsHiLeft, LHSL, RHSL, SDNodeFlags { Flags: None });
        let mut LoMinMax: SDValue = self.DAG.getNode(LoOpc, DL, NVT, ArrayRef<SDValue> { [LHSL, RHSL] });
        Lo = self.DAG.getSelect(DL, NVT, IsHiEq, LoMinMax, LoCmp, SDNodeFlags { Flags: None });
        return;
    }
    let mut Pred: CondCode = zeroed();
    match N.getOpcode() {
        _ => {
            llvm_unreachable_internal("How did we get here?", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeIntegerTypes.cpp", 3704);
        },
        SMAX => {
            if RHSVal && RHSVal.countTrailingZeros() >= NumHalfBits {
                Pred = SETGE;
            } else {
                Pred = SETGT;
            }
        },
        SMIN => {
            if RHSVal && RHSVal.countTrailingOnes() >= NumHalfBits {
                Pred = SETLE;
            } else {
                Pred = SETLT;
            }
        },
        UMAX => {
            if RHSVal && RHSVal.countTrailingZeros() >= NumHalfBits {
                Pred = SETUGE;
            } else {
                Pred = SETUGT;
            }
        },
        UMIN => {
            if RHSVal && RHSVal.countTrailingOnes() >= NumHalfBits {
                Pred = SETULE;
            } else {
                Pred = SETULT;
            }
        },
    }
    let mut VT: EVT = N.getValueType(0);
    let mut CCT: EVT = self.getSetCCResultType(VT);
    let mut Cond: SDValue = self.DAG.getSetCC(DL, CCT, LHS, RHS, Pred, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut Result: SDValue = self.DAG.getSelect(DL, VT, Cond, LHS, RHS, SDNodeFlags { Flags: None });
    self.SplitInteger(Result, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_CMP(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut ExpandedCMP: SDValue = self.TLI.expandCMP(N, self.DAG);
    self.SplitInteger(ExpandedCMP, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_ADDSUB(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    let mut LHSL: SDValue = SDValue {};
    let mut LHSH: SDValue = SDValue {};
    let mut RHSL: SDValue = SDValue {};
    let mut RHSH: SDValue = SDValue {};
    self.GetExpandedInteger(N.getOperand(0), LHSL, LHSH);
    self.GetExpandedInteger(N.getOperand(1), RHSL, RHSH);
    let mut NVT: EVT = LHSL.getValueType();
    let mut LoOps: [2]SDValue = [LHSL, RHSL];
    let mut HiOps: [3]SDValue = [3]SDValue {};
    let mut HasOpCarry: bool = self.TLI.isOperationLegalOrCustom(if N.getOpcode() == ADD { UADDO_CARRY } else { USUBO_CARRY }, self.TLI.getTypeToExpandTo(*self.DAG.getContext(), NVT), false);
    if HasOpCarry {
        let mut VTList: SDVTList = self.DAG.getVTList(NVT, self.getSetCCResultType(NVT));
        if N.getOpcode() == ADD {
            Lo = self.DAG.getNode(UADDO, dl, VTList, ArrayRef<SDValue> { LoOps });
            HiOps[2] = Lo.getValue(1);
            Hi = if self.DAG.computeKnownBits(HiOps[2], 0).isZero() { self.DAG.getNode(ADD, dl, NVT, SDValue> { HiOps, 2 }) } else { self.DAG.getNode(UADDO_CARRY, dl, VTList, ArrayRef<SDValue> { HiOps }) };
        } else {
            Lo = self.DAG.getNode(USUBO, dl, VTList, ArrayRef<SDValue> { LoOps });
            HiOps[2] = Lo.getValue(1);
            Hi = if self.DAG.computeKnownBits(HiOps[2], 0).isZero() { self.DAG.getNode(SUB, dl, NVT, SDValue> { HiOps, 2 }) } else { self.DAG.getNode(USUBO_CARRY, dl, VTList, ArrayRef<SDValue> { HiOps }) };
        }
        return;
    }
    let mut hasCarry: bool = self.TLI.isOperationLegalOrCustom(if N.getOpcode() == ADD { ADDC } else { SUBC }, self.TLI.getTypeToExpandTo(*self.DAG.getContext(), NVT), false);
    if hasCarry {
        let mut VTList: SDVTList = self.DAG.getVTList(NVT, EVT { Glue });
        if N.getOpcode() == ADD {
            Lo = self.DAG.getNode(ADDC, dl, VTList, ArrayRef<SDValue> { LoOps });
            HiOps[2] = Lo.getValue(1);
            Hi = self.DAG.getNode(ADDE, dl, VTList, ArrayRef<SDValue> { HiOps });
        } else {
            Lo = self.DAG.getNode(SUBC, dl, VTList, ArrayRef<SDValue> { LoOps });
            HiOps[2] = Lo.getValue(1);
            Hi = self.DAG.getNode(SUBE, dl, VTList, ArrayRef<SDValue> { HiOps });
        }
        return;
    }
    let mut hasOVF: bool = self.TLI.isOperationLegalOrCustom(if N.getOpcode() == ADD { UADDO } else { USUBO }, self.TLI.getTypeToExpandTo(*self.DAG.getContext(), NVT), false);
    let mut BoolType: BooleanContent = self.TLI.getBooleanContents(NVT);
    if hasOVF {
        let mut OvfVT: EVT = self.getSetCCResultType(NVT);
        let mut VTList: SDVTList = self.DAG.getVTList(NVT, OvfVT);
        let mut RevOpc: i32 = 0;
        if N.getOpcode() == ADD {
            RevOpc = SUB;
            Lo = self.DAG.getNode(UADDO, dl, VTList, ArrayRef<SDValue> { LoOps });
            Hi = self.DAG.getNode(ADD, dl, NVT, SDValue> { HiOps, 2 });
        } else {
            RevOpc = ADD;
            Lo = self.DAG.getNode(USUBO, dl, VTList, ArrayRef<SDValue> { LoOps });
            Hi = self.DAG.getNode(SUB, dl, NVT, SDValue> { HiOps, 2 });
        }
        let mut OVF: SDValue = Lo.getValue(1);
        match BoolType {
            UndefinedBooleanContent => {
                OVF = self.DAG.getNode(AND, dl, OvfVT, self.DAG.getConstant(1, dl, OvfVT, false, false), OVF);
            },
            ZeroOrOneBooleanContent => {
                OVF = self.DAG.getZExtOrTrunc(OVF, dl, NVT);
            },
            ZeroOrNegativeOneBooleanContent => {
                OVF = self.DAG.getSExtOrTrunc(OVF, dl, NVT);
            },
        }
        return;
    }
    if N.getOpcode() == ADD {
        Lo = self.DAG.getNode(ADD, dl, NVT, ArrayRef<SDValue> { LoOps });
        let mut Cmp: SDValue = SDValue {};
        if isOneConstant(LoOps[1]) {
            Cmp = self.DAG.getSetCC(dl, self.getSetCCResultType(NVT), Lo, self.DAG.getConstant(0, dl, NVT, false, false), SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
        } else if isAllOnesConstant(LoOps[1]) {
            if isAllOnesConstant(HiOps[1]) {
                Cmp = self.DAG.getSetCC(dl, self.getSetCCResultType(NVT), LoOps[0], self.DAG.getConstant(0, dl, NVT, false, false), SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
            } else {
                Cmp = self.DAG.getSetCC(dl, self.getSetCCResultType(NVT), LoOps[0], self.DAG.getConstant(0, dl, NVT, false, false), SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
            }
        } else {
            Cmp = self.DAG.getSetCC(dl, self.getSetCCResultType(NVT), Lo, LoOps[0], SETULT, SDValue {}, false, SDNodeFlags { Flags: None });
        }
        let mut Carry: SDValue = SDValue {};
        if BoolType == ZeroOrOneBooleanContent {
            Carry = self.DAG.getZExtOrTrunc(Cmp, dl, NVT);
        } else {
            Carry = self.DAG.getSelect(dl, NVT, Cmp, self.DAG.getConstant(1, dl, NVT, false, false), self.DAG.getConstant(0, dl, NVT, false, false), SDNodeFlags { Flags: None });
        }
        if isAllOnesConstant(LoOps[1]) && isAllOnesConstant(HiOps[1]) {
            Hi = self.DAG.getNode(SUB, dl, NVT, HiOps[0], Carry);
        } else {
            Hi = self.DAG.getNode(ADD, dl, NVT, SDValue> { HiOps, 2 });
            Hi = self.DAG.getNode(ADD, dl, NVT, Hi, Carry);
        }
    } else {
        Lo = self.DAG.getNode(SUB, dl, NVT, ArrayRef<SDValue> { LoOps });
        Hi = self.DAG.getNode(SUB, dl, NVT, SDValue> { HiOps, 2 });
        let mut Cmp: SDValue = self.DAG.getSetCC(dl, self.getSetCCResultType(LoOps[0].getValueType()), LoOps[0], LoOps[1], SETULT, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut Borrow: SDValue = SDValue {};
        if BoolType == ZeroOrOneBooleanContent {
            Borrow = self.DAG.getZExtOrTrunc(Cmp, dl, NVT);
        } else {
            Borrow = self.DAG.getSelect(dl, NVT, Cmp, self.DAG.getConstant(1, dl, NVT, false, false), self.DAG.getConstant(0, dl, NVT, false, false), SDNodeFlags { Flags: None });
        }
        Hi = self.DAG.getNode(SUB, dl, NVT, Hi, Borrow);
    }
}

fn DAGTypeLegalizer::ExpandIntRes_ADDSUBC(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut LHSL: SDValue = SDValue {};
    let mut LHSH: SDValue = SDValue {};
    let mut RHSL: SDValue = SDValue {};
    let mut RHSH: SDValue = SDValue {};
    let mut dl: SDLoc = SDLoc { N };
    self.GetExpandedInteger(N.getOperand(0), LHSL, LHSH);
    self.GetExpandedInteger(N.getOperand(1), RHSL, RHSH);
    let mut VTList: SDVTList = self.DAG.getVTList(LHSL.getValueType(), EVT { Glue });
    let mut LoOps: [2]SDValue = [LHSL, RHSL];
    let mut HiOps: [3]SDValue = [3]SDValue {};
    if N.getOpcode() == ADDC {
        Lo = self.DAG.getNode(ADDC, dl, VTList, ArrayRef<SDValue> { LoOps });
        HiOps[2] = Lo.getValue(1);
        Hi = self.DAG.getNode(ADDE, dl, VTList, ArrayRef<SDValue> { HiOps });
    } else {
        Lo = self.DAG.getNode(SUBC, dl, VTList, ArrayRef<SDValue> { LoOps });
        HiOps[2] = Lo.getValue(1);
        Hi = self.DAG.getNode(SUBE, dl, VTList, ArrayRef<SDValue> { HiOps });
    }
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Hi.getValue(1));
}

fn DAGTypeLegalizer::ExpandIntRes_ADDSUBE(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut LHSL: SDValue = SDValue {};
    let mut LHSH: SDValue = SDValue {};
    let mut RHSL: SDValue = SDValue {};
    let mut RHSH: SDValue = SDValue {};
    let mut dl: SDLoc = SDLoc { N };
    self.GetExpandedInteger(N.getOperand(0), LHSL, LHSH);
    self.GetExpandedInteger(N.getOperand(1), RHSL, RHSH);
    let mut VTList: SDVTList = self.DAG.getVTList(LHSL.getValueType(), EVT { Glue });
    let mut LoOps: [3]SDValue = [LHSL, RHSL, N.getOperand(2)];
    let mut HiOps: [3]SDValue = [3]SDValue {};
    Lo = self.DAG.getNode(N.getOpcode(), dl, VTList, ArrayRef<SDValue> { LoOps });
    HiOps[2] = Lo.getValue(1);
    Hi = self.DAG.getNode(N.getOpcode(), dl, VTList, ArrayRef<SDValue> { HiOps });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Hi.getValue(1));
}

fn DAGTypeLegalizer::ExpandIntRes_UADDSUBO(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut dl: SDLoc = SDLoc { N };
    let mut Ovf: SDValue = SDValue {};
    let mut CarryOp: u32 = 0;
    let mut NoCarryOp: u32 = 0;
    let mut Cond: CondCode = zeroed();
    match N.getOpcode() {
        UADDO => {
            CarryOp = UADDO_CARRY;
        },
        USUBO => {
            CarryOp = USUBO_CARRY;
        },
        _ => {
            llvm_unreachable_internal("Node has unexpected Opcode", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeIntegerTypes.cpp", 3953);
        },
    }
    let mut HasCarryOp: bool = self.TLI.isOperationLegalOrCustom(CarryOp, self.TLI.getTypeToExpandTo(*self.DAG.getContext(), LHS.getValueType()), false);
    if HasCarryOp {
        let mut LHSL: SDValue = SDValue {};
        let mut LHSH: SDValue = SDValue {};
        let mut RHSL: SDValue = SDValue {};
        let mut RHSH: SDValue = SDValue {};
        self.GetExpandedInteger(LHS, LHSL, LHSH);
        self.GetExpandedInteger(RHS, RHSL, RHSH);
        let mut VTList: SDVTList = self.DAG.getVTList(LHSL.getValueType(), N.getValueType(1));
        let mut LoOps: [2]SDValue = [LHSL, RHSL];
        let mut HiOps: [3]SDValue = [3]SDValue {};
        Lo = self.DAG.getNode(N.getOpcode(), dl, VTList, ArrayRef<SDValue> { LoOps });
        HiOps[2] = Lo.getValue(1);
        Hi = self.DAG.getNode(CarryOp, dl, VTList, ArrayRef<SDValue> { HiOps });
        Ovf = Hi.getValue(1);
    } else {
        let mut Sum: SDValue = self.DAG.getNode(NoCarryOp, dl, LHS.getValueType(), LHS, RHS);
        self.SplitInteger(Sum, Lo, Hi);
        if N.getOpcode() == UADDO && isOneConstant(RHS) {
            let mut Or: SDValue = self.DAG.getNode(OR, dl, Lo.getValueType(), Lo, Hi);
            Ovf = self.DAG.getSetCC(dl, N.getValueType(1), Or, self.DAG.getConstant(0, dl, Lo.getValueType(), false, false), SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
        } else if N.getOpcode() == UADDO && isAllOnesConstant(RHS) {
            Ovf = self.DAG.getSetCC(dl, N.getValueType(1), LHS, self.DAG.getConstant(0, dl, LHS.getValueType(), false, false), SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
        } else {
            Ovf = self.DAG.getSetCC(dl, N.getValueType(1), Sum, LHS, Cond, SDValue {}, false, SDNodeFlags { Flags: None });
        }
    }
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Ovf);
}

fn DAGTypeLegalizer::ExpandIntRes_UADDSUBO_CARRY(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut LHSL: SDValue = SDValue {};
    let mut LHSH: SDValue = SDValue {};
    let mut RHSL: SDValue = SDValue {};
    let mut RHSH: SDValue = SDValue {};
    let mut dl: SDLoc = SDLoc { N };
    self.GetExpandedInteger(N.getOperand(0), LHSL, LHSH);
    self.GetExpandedInteger(N.getOperand(1), RHSL, RHSH);
    let mut VTList: SDVTList = self.DAG.getVTList(LHSL.getValueType(), N.getValueType(1));
    let mut LoOps: [3]SDValue = [LHSL, RHSL, N.getOperand(2)];
    let mut HiOps: [3]SDValue = [LHSH, RHSH, SDValue {}];
    Lo = self.DAG.getNode(N.getOpcode(), dl, VTList, ArrayRef<SDValue> { LoOps });
    HiOps[2] = Lo.getValue(1);
    Hi = self.DAG.getNode(N.getOpcode(), dl, VTList, ArrayRef<SDValue> { HiOps });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Hi.getValue(1));
}

fn DAGTypeLegalizer::ExpandIntRes_SADDSUBO_CARRY(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut LHSL: SDValue = SDValue {};
    let mut LHSH: SDValue = SDValue {};
    let mut RHSL: SDValue = SDValue {};
    let mut RHSH: SDValue = SDValue {};
    let mut dl: SDLoc = SDLoc { N };
    self.GetExpandedInteger(N.getOperand(0), LHSL, LHSH);
    self.GetExpandedInteger(N.getOperand(1), RHSL, RHSH);
    let mut VTList: SDVTList = self.DAG.getVTList(LHSL.getValueType(), N.getValueType(1));
    let mut CarryOp: u32 = if N.getOpcode() == SADDO_CARRY { UADDO_CARRY } else { USUBO_CARRY };
    Lo = self.DAG.getNode(CarryOp, dl, VTList, ArrayRef<SDValue> { [LHSL, RHSL, N.getOperand(2)] });
    Hi = self.DAG.getNode(N.getOpcode(), dl, VTList, ArrayRef<SDValue> { [LHSH, RHSH, Lo.getValue(1)] });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Hi.getValue(1));
}

fn DAGTypeLegalizer::ExpandIntRes_ANY_EXTEND(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut dl: SDLoc = SDLoc { N };
    let mut Op: SDValue = N.getOperand(0);
    if Op.getValueType().bitsLE(NVT) {
        Lo = self.DAG.getNode(ANY_EXTEND, dl, NVT, Op);
        Hi = self.DAG.getUNDEF(NVT);
    } else {
        assert!(self.getTypeAction(Op.getValueType()) == TypePromoteInteger, "Only know how to promote this result!");
        let mut Res: SDValue = self.GetPromotedInteger(Op);
        assert!(Res.getValueType() == N.getValueType(0), "Operand over promoted?");
        self.SplitInteger(Res, Lo, Hi);
    }
}

fn DAGTypeLegalizer::ExpandIntRes_AssertSext(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    self.GetExpandedInteger(N.getOperand(0), Lo, Hi);
    let mut NVT: EVT = Lo.getValueType();
    let mut EVT: EVT = cast(N.getOperand(1)).getVT();
    let mut NVTBits: u32 = NVT.getSizeInBits().operator unsigned long long();
    let mut EVTBits: u32 = EVT.getSizeInBits().operator unsigned long long();
    if NVTBits < EVTBits {
        Hi = self.DAG.getNode(AssertSext, dl, NVT, Hi, self.DAG.getValueType(getIntegerVT(*self.DAG.getContext(), EVTBits - NVTBits)));
    } else {
        Lo = self.DAG.getNode(AssertSext, dl, NVT, Lo, self.DAG.getValueType(EVT));
        Hi = self.DAG.getNode(SRA, dl, NVT, Lo, self.DAG.getShiftAmountConstant(NVTBits - 1, NVT, dl));
    }
}

fn DAGTypeLegalizer::ExpandIntRes_AssertZext(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    self.GetExpandedInteger(N.getOperand(0), Lo, Hi);
    let mut NVT: EVT = Lo.getValueType();
    let mut EVT: EVT = cast(N.getOperand(1)).getVT();
    let mut NVTBits: u32 = NVT.getSizeInBits().operator unsigned long long();
    let mut EVTBits: u32 = EVT.getSizeInBits().operator unsigned long long();
    if NVTBits < EVTBits {
        Hi = self.DAG.getNode(AssertZext, dl, NVT, Hi, self.DAG.getValueType(getIntegerVT(*self.DAG.getContext(), EVTBits - NVTBits)));
    } else {
        Lo = self.DAG.getNode(AssertZext, dl, NVT, Lo, self.DAG.getValueType(EVT));
        Hi = self.DAG.getConstant(0, dl, NVT, false, false);
    }
}

fn DAGTypeLegalizer::ExpandIntRes_BITREVERSE(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    self.GetExpandedInteger(N.getOperand(0), Hi, Lo);
    Lo = self.DAG.getNode(BITREVERSE, dl, Lo.getValueType(), Lo);
    Hi = self.DAG.getNode(BITREVERSE, dl, Hi.getValueType(), Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_BSWAP(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    self.GetExpandedInteger(N.getOperand(0), Hi, Lo);
    Lo = self.DAG.getNode(BSWAP, dl, Lo.getValueType(), Lo);
    Hi = self.DAG.getNode(BSWAP, dl, Hi.getValueType(), Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_PARITY(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    self.GetExpandedInteger(N.getOperand(0), Lo, Hi);
    let mut NVT: EVT = Lo.getValueType();
    Lo = self.DAG.getNode(PARITY, dl, NVT, self.DAG.getNode(XOR, dl, NVT, Lo, Hi));
    Hi = self.DAG.getConstant(0, dl, NVT, false, false);
}

fn DAGTypeLegalizer::ExpandIntRes_Constant(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut NBitWidth: u32 = NVT.getSizeInBits().operator unsigned long long();
    let mut Constant: CastReturnType = cast(N);
    let mut Cst: *APInt = Constant.getAPIntValue();
    let mut IsTarget: bool = Constant.isTargetOpcode();
    let mut IsOpaque: bool = Constant.isOpaque();
    let mut dl: SDLoc = SDLoc { N };
    Lo = self.DAG.getConstant(Cst.trunc(NBitWidth), dl, NVT, IsTarget, IsOpaque);
    Hi = self.DAG.getConstant(Cst.lshr(NBitWidth).trunc(NBitWidth), dl, NVT, IsTarget, IsOpaque);
}

fn DAGTypeLegalizer::ExpandIntRes_ABS(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    let mut N0: SDValue = N.getOperand(0);
    self.GetExpandedInteger(N0, Lo, Hi);
    let mut NVT: EVT = Lo.getValueType();
    let mut NumSignBits: u32 = self.DAG.ComputeNumSignBits(N0, 0);
    if NumSignBits > NVT.getScalarSizeInBits() {
        let mut AbsOpc: u32 = if NumSignBits > NVT.getScalarSizeInBits() + 1 { ABS_MIN_POISON } else { ABS };
        Lo = self.DAG.getNode(AbsOpc, dl, NVT, Lo);
        Hi = self.DAG.getConstant(0, dl, NVT, false, false);
        return;
    }
    let mut HasSubCarry: bool = self.TLI.isOperationLegalOrCustom(USUBO_CARRY, self.TLI.getTypeToExpandTo(*self.DAG.getContext(), NVT), false);
    if HasSubCarry {
        let mut Sign: SDValue = self.DAG.getNode(SRA, dl, NVT, Hi, self.DAG.getShiftAmountConstant(NVT.getSizeInBits().operator unsigned long long() - 1, NVT, dl));
        let mut VTList: SDVTList = self.DAG.getVTList(NVT, self.getSetCCResultType(NVT));
        Lo = self.DAG.getNode(XOR, dl, NVT, Lo, Sign);
        Hi = self.DAG.getNode(XOR, dl, NVT, Hi, Sign);
        Lo = self.DAG.getNode(USUBO, dl, VTList, Lo, Sign);
        Hi = self.DAG.getNode(USUBO_CARRY, dl, VTList, Hi, Sign, Lo.getValue(1));
        return;
    }
    let mut VT: EVT = N.getValueType(0);
    let mut Neg: SDValue = self.DAG.getNode(SUB, dl, VT, self.DAG.getConstant(0, dl, VT, false, false), N0);
    let mut NegLo: SDValue = SDValue {};
    let mut NegHi: SDValue = SDValue {};
    self.SplitInteger(Neg, NegLo, NegHi);
    let mut HiIsNeg: SDValue = self.DAG.getSetCC(dl, self.getSetCCResultType(NVT), Hi, self.DAG.getConstant(0, dl, NVT, false, false), SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
    Lo = self.DAG.getSelect(dl, NVT, HiIsNeg, NegLo, Lo, SDNodeFlags { Flags: None });
    Hi = self.DAG.getSelect(dl, NVT, HiIsNeg, NegHi, Hi, SDNodeFlags { Flags: None });
}

fn DAGTypeLegalizer::ExpandIntRes_CTLZ(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    self.GetExpandedInteger(N.getOperand(0), Lo, Hi);
    let mut NVT: EVT = Lo.getValueType();
    let mut HiNotZero: SDValue = self.DAG.getSetCC(dl, self.getSetCCResultType(NVT), Hi, self.DAG.getConstant(0, dl, NVT, false, false), SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut LoLZ: SDValue = self.DAG.getNode(N.getOpcode(), dl, NVT, Lo);
    let mut HiLZ: SDValue = self.DAG.getNode(CTLZ_ZERO_POISON, dl, NVT, Hi);
    Lo = self.DAG.getSelect(dl, NVT, HiNotZero, HiLZ, self.DAG.getNode(ADD, dl, NVT, LoLZ, self.DAG.getConstant(NVT.getSizeInBits().operator unsigned long long(), dl, NVT, false, false)), SDNodeFlags { Flags: None });
    Hi = self.DAG.getConstant(0, dl, NVT, false, false);
}

fn DAGTypeLegalizer::ExpandIntRes_CTLS(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    self.GetExpandedInteger(N.getOperand(0), Lo, Hi);
    let mut NVT: EVT = Lo.getValueType();
    let mut NVTBits: u32 = NVT.getScalarSizeInBits();
    let mut Constant0: SDValue = self.DAG.getConstant(0, dl, NVT, false, false);
    let mut ConstantBWM1: SDValue = self.DAG.getConstant(NVTBits - 1, dl, NVT, false, false);
    let mut HiCTLS: SDValue = self.DAG.getNode(CTLS, dl, NVT, Hi);
    let mut IsAllSignBits: SDValue = self.DAG.getSetCC(dl, self.getSetCCResultType(NVT), HiCTLS, ConstantBWM1, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut IsNegative: SDValue = self.DAG.getSetCC(dl, self.getSetCCResultType(NVT), Hi, Constant0, SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut AdjustedLo: SDValue = self.DAG.getSelect(dl, NVT, IsNegative, self.DAG.getNOT(dl, Lo, NVT), Lo, SDNodeFlags { Flags: None });
    let mut LoCLZ: SDValue = self.DAG.getNode(CTLZ, dl, NVT, AdjustedLo);
    Lo = self.DAG.getSelect(dl, NVT, IsAllSignBits, self.DAG.getNode(ADD, dl, NVT, LoCLZ, ConstantBWM1), HiCTLS, SDNodeFlags { Flags: None });
    Hi = self.DAG.getConstant(0, dl, NVT, false, false);
}

fn DAGTypeLegalizer::ExpandIntRes_ABD(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut Result: SDValue = self.TLI.expandABD(N, self.DAG);
    self.SplitInteger(Result, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_CTPOP(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut Op: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if self.TLI.getOperationAction(CTPOP, VT) == LibCall {
        let mut LC: Libcall = getCTPOP(VT);
        assert!(LC != UNKNOWN_LIBCALL, "LibCall explicitly requested, but not available");
        if self.DAG.getLibcalls().getLibcallImpl(LC) {
            LCImpl;
        } else {
            let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
            let mut IntVT: EVT = getIntegerVT(*self.DAG.getContext(), self.DAG.getLibInfo().getIntSize());
            let mut Res: SDValue = self.TLI.makeLibCall(self.DAG, LCImpl, IntVT, ArrayRef<SDValue> { Op }, CallOptions, DL, SDValue {}).first;
            self.SplitInteger(self.DAG.getSExtOrTrunc(Res, DL, VT), Lo, Hi);
            return;
        }
    }
    self.GetExpandedInteger(Op, Lo, Hi);
    let mut NVT: EVT = Lo.getValueType();
    Lo = self.DAG.getNode(ADD, DL, NVT, self.DAG.getNode(CTPOP, DL, NVT, Lo), self.DAG.getNode(CTPOP, DL, NVT, Hi));
    Hi = self.DAG.getConstant(0, DL, NVT, false, false);
}

fn DAGTypeLegalizer::ExpandIntRes_CTTZ(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    self.GetExpandedInteger(N.getOperand(0), Lo, Hi);
    let mut NVT: EVT = Lo.getValueType();
    let mut LoNotZero: SDValue = self.DAG.getSetCC(dl, self.getSetCCResultType(NVT), Lo, self.DAG.getConstant(0, dl, NVT, false, false), SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut LoLZ: SDValue = self.DAG.getNode(CTTZ_ZERO_POISON, dl, NVT, Lo);
    let mut HiLZ: SDValue = self.DAG.getNode(N.getOpcode(), dl, NVT, Hi);
    Lo = self.DAG.getSelect(dl, NVT, LoNotZero, LoLZ, self.DAG.getNode(ADD, dl, NVT, HiLZ, self.DAG.getConstant(NVT.getSizeInBits().operator unsigned long long(), dl, NVT, false, false)), SDNodeFlags { Flags: None });
    Hi = self.DAG.getConstant(0, dl, NVT, false, false);
}

fn DAGTypeLegalizer::ExpandIntRes_GET_ROUNDING(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut NBitWidth: u32 = NVT.getSizeInBits().operator unsigned long long();
    Lo = self.DAG.getNode(GET_ROUNDING, dl, ArrayRef<EVT> { [NVT, EVT { Other }] }, ArrayRef<SDValue> { N.getOperand(0) });
    let mut Chain: SDValue = Lo.getValue(1);
    Hi = self.DAG.getNode(SRA, dl, NVT, Lo, self.DAG.getShiftAmountConstant(NBitWidth - 1, NVT, dl));
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Chain);
}

fn fpExtendHelper(Op: SDValue, Chain: *mut SDValue, IsStrict: bool, VT: EVT, DL: SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    if IsStrict {
        Op = DAG.getNode(STRICT_FP_EXTEND, DL, ArrayRef<EVT> { [VT, EVT { Other }] }, ArrayRef<SDValue> { [Chain, Op] });
        Chain = Op.getValue(1);
        return Op;
    }
    return DAG.getNode(FP_EXTEND, DL, VT, Op);
}

fn DAGTypeLegalizer::ExpandIntRes_FP_TO_XINT(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    let mut IsSigned: bool = N.getOpcode() == FP_TO_SINT || N.getOpcode() == STRICT_FP_TO_SINT;
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut Chain: SDValue = if IsStrict { N.getOperand(0) } else { SDValue {} };
    let mut Op: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    if self.getTypeAction(Op.getValueType()) == TypeSoftPromoteHalf || Op.getValueType() == EVT { bf16 } {
        Op = fpExtendHelper(Op, Chain, IsStrict, EVT { f32 }, dl, self.DAG);
    }
    let mut OpVT: EVT = Op.getValueType();
    let mut LC: Libcall = if IsSigned { getFPTOSINT(OpVT, VT) } else { getFPTOUINT(OpVT, VT) };
    assert!(LC != UNKNOWN_LIBCALL, "Unexpected fp-to-xint conversion!");
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    if self.getTypeAction(Op.getValueType()) == TypeSoftenFloat {
        CallOptions.setTypeListBeforeSoften(ArrayRef<EVT> { OpVT }, VT);
    } else {
        CallOptions.setIsSigned(true);
    }
    let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, LC, VT, ArrayRef<SDValue> { Op }, CallOptions, dl, Chain);
    self.SplitInteger(Tmp.first, Lo, Hi);
    if IsStrict {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Tmp.second);
    }
}

fn DAGTypeLegalizer::ExpandIntRes_FP_TO_XINT_SAT(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut Res: SDValue = self.TLI.expandFP_TO_INT_SAT(N, self.DAG);
    self.SplitInteger(Res, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_XROUND_XRINT(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut Op: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    let mut Chain: SDValue = if IsStrict { N.getOperand(0) } else { SDValue {} };
    let mut VT: EVT = Op.getValueType();
    if VT == EVT { f16 } {
        VT = EVT { f32 };
        Op = fpExtendHelper(Op, Chain, IsStrict, VT, dl, self.DAG);
    }
    let mut LC: Libcall = UNKNOWN_LIBCALL;
    if N.getOpcode() == LROUND || N.getOpcode() == STRICT_LROUND {
        LC = getLROUND(VT);
        assert!(LC != UNKNOWN_LIBCALL, "Unexpected lround input type!");
    } else if N.getOpcode() == LRINT || N.getOpcode() == STRICT_LRINT {
        LC = getLRINT(VT);
        assert!(LC != UNKNOWN_LIBCALL, "Unexpected lrint input type!");
    } else if N.getOpcode() == LLROUND || N.getOpcode() == STRICT_LLROUND {
        LC = getLLROUND(VT);
        assert!(LC != UNKNOWN_LIBCALL, "Unexpected llround input type!");
    } else if N.getOpcode() == LLRINT || N.getOpcode() == STRICT_LLRINT {
        LC = getLLRINT(VT);
        assert!(LC != UNKNOWN_LIBCALL, "Unexpected llrint input type!");
    } else {
        llvm_unreachable_internal("Unexpected opcode!", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeIntegerTypes.cpp", 4406);
    }
    let mut RetVT: EVT = N.getValueType(0);
    let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if LCImpl == Unsupported {
        self.DAG.getContext().emitError("no libcall available for " + N.getOperationName(&mut self.DAG));
        let mut Poison: SDValue = self.DAG.getPOISON(N.getValueType(0));
        self.SplitInteger(Poison, Lo, Hi);
        if N.isStrictFPOpcode() {
            self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, N.getOperand(0));
        }
        return;
    }
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    CallOptions.setIsSigned(true);
    let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, LCImpl, RetVT, ArrayRef<SDValue> { Op }, CallOptions, dl, Chain);
    self.SplitInteger(Tmp.first, Lo, Hi);
    if N.isStrictFPOpcode() {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Tmp.second);
    }
}

fn DAGTypeLegalizer::ExpandIntRes_LOAD(self, N: *mut LoadSDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    assert!(!N.isAtomic(), "Should have been a ATOMIC_LOAD?");
    if isNormalLoad(N) {
        self.ExpandRes_NormalLoad(N, Lo, Hi);
        return;
    }
    assert!(isUNINDEXEDLoad(N), "Indexed load during type legalization!");
    let mut VT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut Ch: SDValue = N.getChain();
    let mut Ptr: SDValue = N.getBasePtr();
    let mut ExtType: LoadExtType = N.getExtensionType();
    let mut MMOFlags: Flags = N.getMemOperand().getFlags();
    let mut AAInfo: AAMDNodes = N.getAAInfo();
    let mut dl: SDLoc = SDLoc { N };
    assert!(NVT.isByteSized(), "Expanded type not byte sized!");
    if N.getMemoryVT().bitsLE(NVT) {
        let mut MemVT: EVT = N.getMemoryVT();
        Lo = self.DAG.getExtLoad(ExtType, dl, NVT, Ch, Ptr, N.getPointerInfo(), MemVT, MaybeAlign { N.getBaseAlign() }, MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
        Ch = Lo.getValue(1);
        if ExtType == SEXTLOAD {
            let mut LoSize: u32 = Lo.getValueSizeInBits().operator unsigned long long();
            Hi = self.DAG.getNode(SRA, dl, NVT, Lo, self.DAG.getShiftAmountConstant(LoSize - 1, NVT, dl));
        } else if ExtType == ZEXTLOAD {
            Hi = self.DAG.getConstant(0, dl, NVT, false, false);
        } else {
            assert!(ExtType == EXTLOAD, "Unknown extload!");
            Hi = self.DAG.getUNDEF(NVT);
        }
    } else if self.DAG.getDataLayout().isLittleEndian() {
        Lo = self.DAG.getLoad(NVT, dl, Ch, Ptr, N.getPointerInfo(), MaybeAlign { N.getBaseAlign() }, MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
        let mut ExcessBits: u32 = N.getMemoryVT().getSizeInBits() - NVT.getSizeInBits().operator unsigned long long();
        let mut NEVT: EVT = getIntegerVT(*self.DAG.getContext(), ExcessBits);
        let mut IncrementSize: u32 = NVT.getSizeInBits().operator unsigned long long() / 8;
        Ptr = self.DAG.getMemBasePlusOffset(Ptr, getFixed(IncrementSize), dl, SDNodeFlags { Flags: None });
        Hi = self.DAG.getExtLoad(ExtType, dl, NVT, Ch, Ptr, N.getPointerInfo().getWithOffset(IncrementSize), NEVT, MaybeAlign { N.getBaseAlign() }, MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
        Ch = self.DAG.getNode(TokenFactor, dl, EVT { Other }, Lo.getValue(1), Hi.getValue(1));
    } else {
        let mut MemVT: EVT = N.getMemoryVT();
        let mut EBytes: u32 = MemVT.getStoreSize().operator unsigned long long();
        let mut IncrementSize: u32 = NVT.getSizeInBits().operator unsigned long long() / 8;
        let mut ExcessBits: u32 = (EBytes - IncrementSize) * 8;
        Hi = self.DAG.getExtLoad(ExtType, dl, NVT, Ch, Ptr, N.getPointerInfo(), getIntegerVT(*self.DAG.getContext(), MemVT.getSizeInBits().operator unsigned long long() - ExcessBits), MaybeAlign { N.getBaseAlign() }, MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
        Ptr = self.DAG.getMemBasePlusOffset(Ptr, getFixed(IncrementSize), dl, SDNodeFlags { Flags: None });
        Lo = self.DAG.getExtLoad(ZEXTLOAD, dl, NVT, Ch, Ptr, N.getPointerInfo().getWithOffset(IncrementSize), getIntegerVT(*self.DAG.getContext(), ExcessBits), MaybeAlign { N.getBaseAlign() }, MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
        Ch = self.DAG.getNode(TokenFactor, dl, EVT { Other }, Lo.getValue(1), Hi.getValue(1));
        if ExcessBits < NVT.getSizeInBits().operator unsigned long long() {
            Lo = self.DAG.getNode(OR, dl, NVT, Lo, self.DAG.getNode(SHL, dl, NVT, Hi, self.DAG.getShiftAmountConstant(ExcessBits, NVT, dl)));
            Hi = self.DAG.getNode(if ExtType == SEXTLOAD { SRA } else { SRL }, dl, NVT, Hi, self.DAG.getShiftAmountConstant(NVT.getSizeInBits().operator unsigned long long() - ExcessBits, NVT, dl));
        }
    }
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Ch);
}

fn DAGTypeLegalizer::ExpandIntRes_Logical(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    let mut LL: SDValue = SDValue {};
    let mut LH: SDValue = SDValue {};
    let mut RL: SDValue = SDValue {};
    let mut RH: SDValue = SDValue {};
    self.GetExpandedInteger(N.getOperand(0), LL, LH);
    self.GetExpandedInteger(N.getOperand(1), RL, RH);
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    if N.getOpcode() == OR {
        Flags.setDisjoint(N.getFlags().hasDisjoint());
    }
    Lo = self.DAG.getNode(N.getOpcode(), dl, LL.getValueType(), LL, RL, Flags);
    Hi = self.DAG.getNode(N.getOpcode(), dl, LL.getValueType(), LH, RH, Flags);
}

fn DAGTypeLegalizer::ExpandIntRes_MUL(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut VT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut dl: SDLoc = SDLoc { N };
    let mut LL: SDValue = SDValue {};
    let mut LH: SDValue = SDValue {};
    let mut RL: SDValue = SDValue {};
    let mut RH: SDValue = SDValue {};
    self.GetExpandedInteger(N.getOperand(0), LL, LH);
    self.GetExpandedInteger(N.getOperand(1), RL, RH);
    if self.TLI.expandMUL(N, Lo, Hi, NVT, self.DAG, OnlyLegalOrCustom, LL, LH, RL, RH) {
        return;
    }
    let mut LC: Libcall = getMUL(VT);
    let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if LCImpl == Unsupported {
        self.TLI.forceExpandMultiply(self.DAG, dl, false, Lo, Hi, LL, RL, LH, RH);
        return;
    }
    let mut Ops: [2]SDValue = [N.getOperand(0), N.getOperand(1)];
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    CallOptions.setIsSigned(true);
    self.SplitInteger(self.TLI.makeLibCall(self.DAG, LCImpl, VT, ArrayRef<SDValue> { Ops }, CallOptions, dl, SDValue {}).first, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_READCOUNTER(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut DL: SDLoc = SDLoc { N };
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut VTs: SDVTList = self.DAG.getVTList(NVT, NVT, EVT { Other });
    let mut R: SDValue = self.DAG.getNode(N.getOpcode(), DL, VTs, N.getOperand(0));
    Lo = R.getValue(0);
    Hi = R.getValue(1);
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, R.getValue(2));
}

fn DAGTypeLegalizer::ExpandIntRes_AVG(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut Result: SDValue = self.TLI.expandAVG(N, self.DAG);
    self.SplitInteger(Result, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_ADDSUBSAT(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut Result: SDValue = self.TLI.expandAddSubSat(N, self.DAG);
    self.SplitInteger(Result, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_SHLSAT(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut Result: SDValue = self.TLI.expandShlSat(N, self.DAG);
    self.SplitInteger(Result, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_MULFIX(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    let mut VTSize: u32 = VT.getScalarSizeInBits();
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut Scale: u64 = N.getConstantOperandVal(2);
    let mut Saturating: bool = (N.getOpcode() == SMULFIXSAT || N.getOpcode() == UMULFIXSAT);
    let mut Signed: bool = (N.getOpcode() == SMULFIX || N.getOpcode() == SMULFIXSAT);
    if !Scale {
        let mut Result: SDValue = SDValue {};
        if !Saturating {
            Result = self.DAG.getNode(MUL, dl, VT, LHS, RHS);
        } else {
            let mut BoolVT: EVT = self.getSetCCResultType(VT);
            let mut MulOp: u32 = if Signed { SMULO } else { UMULO };
            Result = self.DAG.getNode(MulOp, dl, self.DAG.getVTList(VT, BoolVT), LHS, RHS);
            let mut Product: SDValue = Result.getValue(0);
            let mut Overflow: SDValue = Result.getValue(1);
            if Signed {
                let mut MinVal: APInt = getSignedMinValue(VTSize);
                let mut MaxVal: APInt = getSignedMaxValue(VTSize);
                let mut SatMin: SDValue = self.DAG.getConstant(MinVal, dl, VT, false, false);
                let mut SatMax: SDValue = self.DAG.getConstant(MaxVal, dl, VT, false, false);
                let mut Zero: SDValue = self.DAG.getConstant(0, dl, VT, false, false);
                let mut Xor: SDValue = self.DAG.getNode(XOR, dl, VT, LHS, RHS);
                let mut ProdNeg: SDValue = self.DAG.getSetCC(dl, BoolVT, Xor, Zero, SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
                Result = self.DAG.getSelect(dl, VT, ProdNeg, SatMin, SatMax, SDNodeFlags { Flags: None });
                Result = self.DAG.getSelect(dl, VT, Overflow, Result, Product, SDNodeFlags { Flags: None });
            } else {
                let mut MaxVal: APInt = getMaxValue(VTSize);
                let mut SatMax: SDValue = self.DAG.getConstant(MaxVal, dl, VT, false, false);
                Result = self.DAG.getSelect(dl, VT, Overflow, SatMax, Product, SDNodeFlags { Flags: None });
            }
        }
        self.SplitInteger(Result, Lo, Hi);
        return;
    }
    assert!(Scale <= VTSize, "Scale can't be larger than the value type size.");
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut LL: SDValue = SDValue {};
    let mut LH: SDValue = SDValue {};
    let mut RL: SDValue = SDValue {};
    let mut RH: SDValue = SDValue {};
    self.GetExpandedInteger(LHS, LL, LH);
    self.GetExpandedInteger(RHS, RL, RH);
    let mut Result: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    let mut LoHiOp: u32 = if Signed { SMUL_LOHI } else { UMUL_LOHI };
    if !self.TLI.expandMUL_LOHI(LoHiOp, VT, dl, LHS, RHS, Result, NVT, self.DAG, OnlyLegalOrCustom, LL, LH, RL, RH) {
        Result.clear();
        Result.resize(4);
        let mut LoTmp: SDValue = SDValue {};
        let mut HiTmp: SDValue = SDValue {};
        self.TLI.forceExpandWideMUL(self.DAG, dl, Signed, LHS, RHS, LoTmp, HiTmp);
        self.SplitInteger(LoTmp, Result[0], Result[1]);
        self.SplitInteger(HiTmp, Result[2], Result[3]);
    }
    assert!(Result.len == 4, "Unexpected number of partlets in the result");
    let mut NVTSize: u32 = NVT.getScalarSizeInBits();
    assert!((VTSize == NVTSize * 2), "Expected the new value type to be half the size of the current value type");
    let mut Part0: u64 = Scale / NVTSize;
    if Scale % NVTSize {
        let mut ShiftAmount: SDValue = self.DAG.getShiftAmountConstant(Scale % NVTSize, NVT, dl);
        Lo = self.DAG.getNode(FSHR, dl, NVT, Result[Part0 + 1], Result[Part0], ShiftAmount);
        Hi = self.DAG.getNode(FSHR, dl, NVT, Result[Part0 + 2], Result[Part0 + 1], ShiftAmount);
    } else {
        Lo = Result[Part0];
        Hi = Result[Part0 + 1];
    }
    if !Saturating {
        return;
    }
    if Scale == VTSize {
        return;
    }
    let mut ResultHL: SDValue = Result[2];
    let mut ResultHH: SDValue = Result[3];
    let mut SatMax: SDValue = SDValue {};
    let mut SatMin: SDValue = SDValue {};
    let mut NVTZero: SDValue = self.DAG.getConstant(0, dl, NVT, false, false);
    let mut NVTNeg1: SDValue = self.DAG.getAllOnesConstant(dl, NVT, false, false);
    let mut BoolNVT: EVT = self.getSetCCResultType(NVT);
    if !Signed {
        if Scale < NVTSize {
            let mut HLAdjusted: SDValue = self.DAG.getNode(SRL, dl, NVT, ResultHL, self.DAG.getShiftAmountConstant(Scale, NVT, dl));
            let mut Tmp: SDValue = self.DAG.getNode(OR, dl, NVT, HLAdjusted, ResultHH);
            SatMax = self.DAG.getSetCC(dl, BoolNVT, Tmp, NVTZero, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
        } else if Scale == NVTSize {
            SatMax = self.DAG.getSetCC(dl, BoolNVT, ResultHH, NVTZero, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
        } else if Scale < VTSize {
            let mut HLAdjusted: SDValue = self.DAG.getNode(SRL, dl, NVT, ResultHL, self.DAG.getShiftAmountConstant(Scale - NVTSize, NVT, dl));
            SatMax = self.DAG.getSetCC(dl, BoolNVT, HLAdjusted, NVTZero, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
        } else {
            llvm_unreachable_internal("Scale must be less or equal to VTSize for UMULFIXSAT(and saturation can't happen with Scale==VTSize).", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeIntegerTypes.cpp", 4778);
        }
        Hi = self.DAG.getSelect(dl, NVT, SatMax, NVTNeg1, Hi, SDNodeFlags { Flags: None });
        Lo = self.DAG.getSelect(dl, NVT, SatMax, NVTNeg1, Lo, SDNodeFlags { Flags: None });
        return;
    }
    if Scale < NVTSize {
        let mut OverflowBits: u32 = VTSize - Scale + 1;
        assert!(OverflowBits <= VTSize && OverflowBits > NVTSize, "Extent of overflow bits must start within HL");
        let mut HLHiMask: SDValue = self.DAG.getConstant(getHighBitsSet(NVTSize, OverflowBits - NVTSize), dl, NVT, false, false);
        let mut HLLoMask: SDValue = self.DAG.getConstant(getLowBitsSet(NVTSize, VTSize - OverflowBits), dl, NVT, false, false);
        let mut HHGT0: SDValue = self.DAG.getSetCC(dl, BoolNVT, ResultHH, NVTZero, SETGT, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut HHEQ0: SDValue = self.DAG.getSetCC(dl, BoolNVT, ResultHH, NVTZero, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut HLUGT: SDValue = self.DAG.getSetCC(dl, BoolNVT, ResultHL, HLLoMask, SETUGT, SDValue {}, false, SDNodeFlags { Flags: None });
        SatMax = self.DAG.getNode(OR, dl, BoolNVT, HHGT0, self.DAG.getNode(AND, dl, BoolNVT, HHEQ0, HLUGT));
        let mut HHLT: SDValue = self.DAG.getSetCC(dl, BoolNVT, ResultHH, NVTNeg1, SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut HHEQ: SDValue = self.DAG.getSetCC(dl, BoolNVT, ResultHH, NVTNeg1, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut HLULT: SDValue = self.DAG.getSetCC(dl, BoolNVT, ResultHL, HLHiMask, SETULT, SDValue {}, false, SDNodeFlags { Flags: None });
        SatMin = self.DAG.getNode(OR, dl, BoolNVT, HHLT, self.DAG.getNode(AND, dl, BoolNVT, HHEQ, HLULT));
    } else if Scale == NVTSize {
        let mut HHGT0: SDValue = self.DAG.getSetCC(dl, BoolNVT, ResultHH, NVTZero, SETGT, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut HHEQ0: SDValue = self.DAG.getSetCC(dl, BoolNVT, ResultHH, NVTZero, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut HLNeg: SDValue = self.DAG.getSetCC(dl, BoolNVT, ResultHL, NVTZero, SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
        SatMax = self.DAG.getNode(OR, dl, BoolNVT, HHGT0, self.DAG.getNode(AND, dl, BoolNVT, HHEQ0, HLNeg));
        let mut HHLT: SDValue = self.DAG.getSetCC(dl, BoolNVT, ResultHH, NVTNeg1, SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut HHEQ: SDValue = self.DAG.getSetCC(dl, BoolNVT, ResultHH, NVTNeg1, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut HLPos: SDValue = self.DAG.getSetCC(dl, BoolNVT, ResultHL, NVTZero, SETGE, SDValue {}, false, SDNodeFlags { Flags: None });
        SatMin = self.DAG.getNode(OR, dl, BoolNVT, HHLT, self.DAG.getNode(AND, dl, BoolNVT, HHEQ, HLPos));
    } else if Scale < VTSize {
        let mut OverflowBits: u32 = VTSize - Scale + 1;
        let mut HHHiMask: SDValue = self.DAG.getConstant(getHighBitsSet(NVTSize, OverflowBits), dl, NVT, false, false);
        let mut HHLoMask: SDValue = self.DAG.getConstant(getLowBitsSet(NVTSize, NVTSize - OverflowBits), dl, NVT, false, false);
        SatMax = self.DAG.getSetCC(dl, BoolNVT, ResultHH, HHLoMask, SETGT, SDValue {}, false, SDNodeFlags { Flags: None });
        SatMin = self.DAG.getSetCC(dl, BoolNVT, ResultHH, HHHiMask, SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
    } else {
        llvm_unreachable_internal("Illegal scale for signed fixed point mul.", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeIntegerTypes.cpp", 4833);
    }
    let mut MaxHi: APInt = getSignedMaxValue(NVTSize);
    let mut MaxLo: APInt = getAllOnes(NVTSize);
    Hi = self.DAG.getSelect(dl, NVT, SatMax, self.DAG.getConstant(MaxHi, dl, NVT, false, false), Hi, SDNodeFlags { Flags: None });
    Lo = self.DAG.getSelect(dl, NVT, SatMax, self.DAG.getConstant(MaxLo, dl, NVT, false, false), Lo, SDNodeFlags { Flags: None });
    let mut MinHi: APInt = getSignedMinValue(NVTSize);
    Hi = self.DAG.getSelect(dl, NVT, SatMin, self.DAG.getConstant(MinHi, dl, NVT, false, false), Hi, SDNodeFlags { Flags: None });
    Lo = self.DAG.getSelect(dl, NVT, SatMin, NVTZero, Lo, SDNodeFlags { Flags: None });
}

fn DAGTypeLegalizer::ExpandIntRes_DIVFIX(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    let mut Res: SDValue = self.TLI.expandFixedPointDiv(N.getOpcode(), dl, N.getOperand(0), N.getOperand(1), N.getConstantOperandVal(2), self.DAG);
    if !Res {
        Res = earlyExpandDIVFIX(N, N.getOperand(0), N.getOperand(1), N.getConstantOperandVal(2), self.TLI, self.DAG, 0);
    }
    self.SplitInteger(Res, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_SADDSUBO(self, Node: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    assert!((Node.getOpcode() == SADDO || Node.getOpcode() == SSUBO), "Node has unexpected Opcode");
    let mut LHS: SDValue = Node.getOperand(0);
    let mut RHS: SDValue = Node.getOperand(1);
    let mut dl: SDLoc = SDLoc { Node };
    let mut Ovf: SDValue = SDValue {};
    let mut IsAdd: bool = Node.getOpcode() == SADDO;
    let mut CarryOp: u32 = if IsAdd { SADDO_CARRY } else { SSUBO_CARRY };
    let mut HasCarryOp: bool = self.TLI.isOperationLegalOrCustom(CarryOp, self.TLI.getTypeToExpandTo(*self.DAG.getContext(), LHS.getValueType()), false);
    if HasCarryOp {
        let mut LHSL: SDValue = SDValue {};
        let mut LHSH: SDValue = SDValue {};
        let mut RHSL: SDValue = SDValue {};
        let mut RHSH: SDValue = SDValue {};
        self.GetExpandedInteger(LHS, LHSL, LHSH);
        self.GetExpandedInteger(RHS, RHSL, RHSH);
        let mut VTList: SDVTList = self.DAG.getVTList(LHSL.getValueType(), Node.getValueType(1));
        Lo = self.DAG.getNode(if IsAdd { UADDO } else { USUBO }, dl, VTList, ArrayRef<SDValue> { [LHSL, RHSL] });
        Hi = self.DAG.getNode(CarryOp, dl, VTList, ArrayRef<SDValue> { [LHSH, RHSH, Lo.getValue(1)] });
        Ovf = Hi.getValue(1);
    } else {
        let mut Sum: SDValue = self.DAG.getNode(if Node.getOpcode() == SADDO { ADD } else { SUB }, dl, LHS.getValueType(), LHS, RHS);
        self.SplitInteger(Sum, Lo, Hi);
        let mut VT: EVT = LHS.getValueType();
        let mut SignsMatch: SDValue = self.DAG.getNode(XOR, dl, VT, LHS, RHS);
        if IsAdd {
            SignsMatch = self.DAG.getNOT(dl, SignsMatch, VT);
        }
        let mut SumSignNE: SDValue = self.DAG.getNode(XOR, dl, VT, LHS, Sum);
        Ovf = self.DAG.getNode(AND, dl, VT, SignsMatch, SumSignNE);
        let mut OType: EVT = Node.getValueType(1);
        Ovf = self.DAG.getSetCC(dl, OType, Ovf, self.DAG.getConstant(0, dl, VT, false, false), SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    self.ReplaceValueWith(SDValue { Node: Node, ResNo: 1 }, Ovf);
}

fn DAGTypeLegalizer::ExpandIntRes_SDIV(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut VT: EVT = N.getValueType(0);
    let mut dl: SDLoc = SDLoc { N };
    let mut Ops: [2]SDValue = [N.getOperand(0), N.getOperand(1)];
    if self.TLI.getOperationAction(SDIVREM, VT) == Custom {
        let mut Res: SDValue = self.DAG.getNode(SDIVREM, dl, self.DAG.getVTList(VT, VT), ArrayRef<SDValue> { Ops });
        self.SplitInteger(Res.getValue(0), Lo, Hi);
        return;
    }
    let mut LC: Libcall = getSDIV(VT);
    assert!(LC != UNKNOWN_LIBCALL, "Unsupported SDIV!");
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    CallOptions.setIsSigned(true);
    self.SplitInteger(self.TLI.makeLibCall(self.DAG, LC, VT, ArrayRef<SDValue> { Ops }, CallOptions, dl, SDValue {}).first, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_ShiftThroughStack(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    let mut Shiftee: SDValue = N.getOperand(0);
    let mut VT: EVT = Shiftee.getValueType();
    let mut ShAmt: SDValue = N.getOperand(1);
    let mut ShAmtVT: EVT = ShAmt.getValueType();
    let mut LoadVT: EVT = VT;
    while true {
        {
        LoadVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), LoadVT);
    }
        if !(!self.TLI.isTypeLegal(LoadVT)) { break; }
    }
    let mut ShiftUnitInBits: u32 = LoadVT.getStoreSizeInBits().operator unsigned long long();
    assert!(ShiftUnitInBits <= VT.getScalarSizeInBits());
    assert!(isPowerOf2_32(ShiftUnitInBits), "Shifting unit is not a a power of two!");
    let mut IsOneStepShift: bool = self.DAG.computeKnownBits(ShAmt, 0).countMinTrailingZeros() >= Log2_32(ShiftUnitInBits);
    if !IsOneStepShift {
        ShAmt = self.DAG.getFreeze(ShAmt);
    }
    let mut VTBitWidth: u32 = VT.getScalarSizeInBits();
    assert!(VTBitWidth % 8 == 0, "Shifting a not byte multiple value?");
    let mut VTByteWidth: u32 = VTBitWidth / 8;
    assert!(isPowerOf2_32(VTByteWidth), "Shiftee type size is not a power of two!");
    let mut StackSlotByteWidth: u32 = 2 * VTByteWidth;
    let mut StackSlotBitWidth: u32 = 8 * StackSlotByteWidth;
    let mut StackSlotVT: EVT = getIntegerVT(*self.DAG.getContext(), StackSlotBitWidth);
    let mut StackAlign: Align = self.DAG.getReducedAlign(StackSlotVT, false);
    let mut StackPtr: SDValue = self.DAG.CreateStackTemporary(StackSlotVT.getStoreSize(), StackAlign);
    let mut PtrTy: EVT = StackPtr.getValueType();
    let mut Ch: SDValue = self.DAG.getEntryNode();
    let mut StackPtrInfo: MachinePointerInfo = getFixedStack(self.DAG.getMachineFunction(), cast(StackPtr.getNode()).getIndex(), 0);
    let mut Init: SDValue = SDValue {};
    if N.getOpcode() != SHL {
        let mut WideningOpc: u32 = if N.getOpcode() == SRA { SIGN_EXTEND } else { ZERO_EXTEND };
        Init = self.DAG.getNode(WideningOpc, dl, StackSlotVT, Shiftee);
    } else {
        let mut AllZeros: SDValue = self.DAG.getConstant(0, dl, VT, false, false);
        Init = self.DAG.getNode(BUILD_PAIR, dl, StackSlotVT, AllZeros, Shiftee);
    }
    Ch = self.DAG.getStore(Ch, dl, Init, StackPtr, StackPtrInfo, StackAlign, MONone, MMOMetadata {});
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    Flags.setExact(IsOneStepShift);
    let mut SrlTmp: SDValue = self.DAG.getNode(SRL, dl, ShAmtVT, ShAmt, self.DAG.getConstant(Log2_32(ShiftUnitInBits), dl, ShAmtVT, false, false), Flags);
    let mut BitOffset: SDValue = self.DAG.getNode(SHL, dl, ShAmtVT, SrlTmp, self.DAG.getConstant(Log2_32(ShiftUnitInBits), dl, ShAmtVT, false, false));
    let mut ByteOffset: SDValue = self.DAG.getNode(SRL, dl, ShAmtVT, BitOffset, self.DAG.getConstant(3, dl, ShAmtVT, false, false), SDNodeFlags { Flags: Exact });
    ByteOffset = self.DAG.getNode(AND, dl, ShAmtVT, ByteOffset, self.DAG.getConstant(VTByteWidth - 1, dl, ShAmtVT, false, false));
    let mut WillIndexUpwards: bool = N.getOpcode() != SHL;
    if self.DAG.getDataLayout().isBigEndian() {
        WillIndexUpwards = !WillIndexUpwards;
    }
    let mut AdjStackPtr: SDValue = SDValue {};
    if WillIndexUpwards {
        AdjStackPtr = StackPtr;
    } else {
        AdjStackPtr = self.DAG.getMemBasePlusOffset(StackPtr, self.DAG.getConstant(VTByteWidth, dl, PtrTy, false, false), dl, SDNodeFlags { Flags: None });
        ByteOffset = self.DAG.getNegative(ByteOffset, dl, ShAmtVT);
    }
    ByteOffset = self.DAG.getSExtOrTrunc(ByteOffset, dl, PtrTy);
    AdjStackPtr = self.DAG.getMemBasePlusOffset(AdjStackPtr, ByteOffset, dl, SDNodeFlags { Flags: None });
    let mut Res: SDValue = self.DAG.getLoad(VT, dl, Ch, AdjStackPtr, getUnknownStack(self.DAG.getMachineFunction()), MaybeAlign { commonAlignment(StackAlign, LoadVT.getStoreSize().operator unsigned long long()) }, MONone, MMOMetadata {});
    if !IsOneStepShift {
        let mut ShAmtRem: SDValue = self.DAG.getNode(AND, dl, ShAmtVT, ShAmt, self.DAG.getConstant(ShiftUnitInBits - 1, dl, ShAmtVT, false, false));
        Res = self.DAG.getNode(N.getOpcode(), dl, VT, Res, ShAmtRem);
    }
    self.SplitInteger(Res, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_Shift(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut VT: EVT = N.getValueType(0);
    let mut Opc: u32 = N.getOpcode();
    let mut dl: SDLoc = SDLoc { N };
    if dyn_cast(N.getOperand(1)) {
        CN;
    } else {
        return self.ExpandShiftByConstant(N, CN.getAPIntValue(), Lo, Hi);
    }
    if self.ExpandShiftWithKnownAmountBit(N, Lo, Hi) {
        return;
    }
    let mut PartsOpc: u32 = 0;
    if Opc == SHL {
        PartsOpc = SHL_PARTS;
    } else if Opc == SRL {
        PartsOpc = SRL_PARTS;
    } else {
        assert!(Opc == SRA, "Unknown shift!");
        PartsOpc = SRA_PARTS;
    }
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut Action: LegalizeAction = self.TLI.getOperationAction(PartsOpc, NVT);
    let mut LegalOrCustom: bool = (Action == Legal && self.TLI.isTypeLegal(NVT)) || Action == Custom;
    let mut ExpansionFactor: u32 = 1;
    for let mut TmpVT: EVT = NVT; ;  {
        let mut NewTMPVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), TmpVT);
        if NewTMPVT == TmpVT {
            break;
        }
        TmpVT = NewTMPVT;
        ExpansionFactor += 1;
    }
    let mut S: ShiftLegalizationStrategy = self.TLI.preferredShiftLegalizationStrategy(self.DAG, N, ExpansionFactor);
    if S == ExpandThroughStack {
        return self.ExpandIntRes_ShiftThroughStack(N, Lo, Hi);
    }
    if LegalOrCustom && S != LowerToLibcall {
        let mut LHSL: SDValue = SDValue {};
        let mut LHSH: SDValue = SDValue {};
        self.GetExpandedInteger(N.getOperand(0), LHSL, LHSH);
        let mut VT: EVT = LHSL.getValueType();
        let mut ShiftOp: SDValue = N.getOperand(1);
        let mut ShiftTy: EVT = self.TLI.getShiftAmountTy(VT, self.DAG.getDataLayout());
        if ShiftOp.getValueType() != ShiftTy {
            ShiftOp = self.DAG.getZExtOrTrunc(ShiftOp, dl, ShiftTy);
        }
        let mut Ops: [3]SDValue = [LHSL, LHSH, ShiftOp];
        Lo = self.DAG.getNode(PartsOpc, dl, self.DAG.getVTList(VT, VT), ArrayRef<SDValue> { Ops });
        Hi = Lo.getValue(1);
        return;
    }
    let mut LC: Libcall = UNKNOWN_LIBCALL;
    let mut isSigned: bool = false;
    if Opc == SHL {
        isSigned = false;
        LC = getSHL(VT);
    } else if Opc == SRL {
        isSigned = false;
        LC = getSRL(VT);
    } else {
        assert!(Opc == SRA, "Unknown shift!");
        isSigned = true;
        LC = getSRA(VT);
    }
    if self.DAG.getLibcalls().getLibcallImpl(LC) {
        LibcallImpl;
    } else {
        let mut ShAmtTy: EVT = getIntegerVT(*self.DAG.getContext(), self.DAG.getLibInfo().getIntSize());
        let mut ShAmt: SDValue = self.DAG.getZExtOrTrunc(N.getOperand(1), dl, ShAmtTy);
        let mut Ops: [2]SDValue = [N.getOperand(0), ShAmt];
        let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
        CallOptions.setIsSigned(isSigned);
        self.SplitInteger(self.TLI.makeLibCall(self.DAG, LibcallImpl, VT, ArrayRef<SDValue> { Ops }, CallOptions, dl, SDValue {}).first, Lo, Hi);
        return;
    }
    if !self.ExpandShiftWithUnknownAmountBit(N, Lo, Hi) {
        llvm_unreachable_internal("Unsupported shift!", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeIntegerTypes.cpp", 5176);
    }
}

fn DAGTypeLegalizer::ExpandIntRes_SIGN_EXTEND(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut dl: SDLoc = SDLoc { N };
    let mut Op: SDValue = N.getOperand(0);
    if Op.getValueType().bitsLE(NVT) {
        Lo = self.DAG.getNode(SIGN_EXTEND, dl, NVT, N.getOperand(0));
        let mut LoSize: u32 = NVT.getSizeInBits().operator unsigned long long();
        Hi = self.DAG.getNode(SRA, dl, NVT, Lo, self.DAG.getShiftAmountConstant(LoSize - 1, NVT, dl));
    } else {
        assert!(self.getTypeAction(Op.getValueType()) == TypePromoteInteger, "Only know how to promote this result!");
        let mut Res: SDValue = self.GetPromotedInteger(Op);
        assert!(Res.getValueType() == N.getValueType(0), "Operand over promoted?");
        self.SplitInteger(Res, Lo, Hi);
        let mut ExcessBits: u32 = Op.getValueSizeInBits() - NVT.getSizeInBits().operator unsigned long long();
        Hi = self.DAG.getNode(SIGN_EXTEND_INREG, dl, Hi.getValueType(), Hi, self.DAG.getValueType(getIntegerVT(*self.DAG.getContext(), ExcessBits)));
    }
}

fn DAGTypeLegalizer::ExpandIntRes_SIGN_EXTEND_INREG(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    self.GetExpandedInteger(N.getOperand(0), Lo, Hi);
    let mut EVT: EVT = cast(N.getOperand(1)).getVT();
    if EVT.bitsLE(Lo.getValueType()) {
        Lo = self.DAG.getNode(SIGN_EXTEND_INREG, dl, Lo.getValueType(), Lo, N.getOperand(1));
        Hi = self.DAG.getNode(SRA, dl, Hi.getValueType(), Lo, self.DAG.getShiftAmountConstant(Hi.getValueSizeInBits().operator unsigned long long() - 1, Hi.getValueType(), dl));
    } else {
        let mut ExcessBits: u32 = EVT.getSizeInBits() - Lo.getValueSizeInBits().operator unsigned long long();
        Hi = self.DAG.getNode(SIGN_EXTEND_INREG, dl, Hi.getValueType(), Hi, self.DAG.getValueType(getIntegerVT(*self.DAG.getContext(), ExcessBits)));
    }
}

fn DAGTypeLegalizer::ExpandIntRes_SREM(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut VT: EVT = N.getValueType(0);
    let mut dl: SDLoc = SDLoc { N };
    let mut Ops: [2]SDValue = [N.getOperand(0), N.getOperand(1)];
    if self.TLI.getOperationAction(SDIVREM, VT) == Custom {
        let mut Res: SDValue = self.DAG.getNode(SDIVREM, dl, self.DAG.getVTList(VT, VT), ArrayRef<SDValue> { Ops });
        self.SplitInteger(Res.getValue(1), Lo, Hi);
        return;
    }
    let mut LC: Libcall = getSREM(VT);
    assert!(LC != UNKNOWN_LIBCALL, "Unsupported SREM!");
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    CallOptions.setIsSigned(true);
    self.SplitInteger(self.TLI.makeLibCall(self.DAG, LC, VT, ArrayRef<SDValue> { Ops }, CallOptions, dl, SDValue {}).first, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_TRUNCATE(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut InOp: SDValue = N.getOperand(0);
    let mut InVT: EVT = InOp.getValueType();
    let mut dl: SDLoc = SDLoc { N };
    Lo = self.DAG.getNode(TRUNCATE, dl, NVT, InOp);
    Hi = self.DAG.getNode(SRL, dl, InVT, InOp, self.DAG.getShiftAmountConstant(NVT.getSizeInBits().operator unsigned long long(), InVT, dl));
    Hi = self.DAG.getNode(TRUNCATE, dl, NVT, Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_XMULO(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut VT: EVT = N.getValueType(0);
    let mut dl: SDLoc = SDLoc { N };
    if N.getOpcode() == UMULO {
        let mut LHS: SDValue = N.getOperand(0);
        let mut RHS: SDValue = N.getOperand(1);
        let mut LHSHigh: SDValue = SDValue {};
        let mut LHSLow: SDValue = SDValue {};
        let mut RHSHigh: SDValue = SDValue {};
        let mut RHSLow: SDValue = SDValue {};
        self.GetExpandedInteger(LHS, LHSLow, LHSHigh);
        self.GetExpandedInteger(RHS, RHSLow, RHSHigh);
        let mut HalfVT: EVT = LHSLow.getValueType();
        let mut BitVT: EVT = N.getValueType(1);
        let mut VTHalfWithO: SDVTList = self.DAG.getVTList(HalfVT, BitVT);
        let mut HalfZero: SDValue = self.DAG.getConstant(0, dl, HalfVT, false, false);
        let mut Overflow: SDValue = self.DAG.getNode(AND, dl, BitVT, self.DAG.getSetCC(dl, BitVT, LHSHigh, HalfZero, SETNE, SDValue {}, false, SDNodeFlags { Flags: None }), self.DAG.getSetCC(dl, BitVT, RHSHigh, HalfZero, SETNE, SDValue {}, false, SDNodeFlags { Flags: None }));
        let mut One: SDValue = self.DAG.getNode(UMULO, dl, VTHalfWithO, LHSHigh, RHSLow);
        Overflow = self.DAG.getNode(OR, dl, BitVT, Overflow, One.getValue(1));
        let mut Two: SDValue = self.DAG.getNode(UMULO, dl, VTHalfWithO, RHSHigh, LHSLow);
        Overflow = self.DAG.getNode(OR, dl, BitVT, Overflow, Two.getValue(1));
        let mut HighSum: SDValue = self.DAG.getNode(ADD, dl, HalfVT, One, Two);
        let mut Three: SDValue = self.DAG.getNode(MUL, dl, VT, self.DAG.getNode(ZERO_EXTEND, dl, VT, LHSLow), self.DAG.getNode(ZERO_EXTEND, dl, VT, RHSLow));
        self.SplitInteger(Three, Lo, Hi);
        Hi = self.DAG.getNode(UADDO, dl, VTHalfWithO, Hi, HighSum);
        Overflow = self.DAG.getNode(OR, dl, BitVT, Overflow, Hi.getValue(1));
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Overflow);
        return;
    }
    let mut RetTy: *mut Type = VT.getTypeForEVT(*self.DAG.getContext());
    let mut PtrVT: EVT = EVT { self.TLI.getPointerTy(self.DAG.getDataLayout(), 0) };
    let mut PtrTy: *mut Type = PtrVT.getTypeForEVT(*self.DAG.getContext());
    let mut LC: Libcall = getMULO(VT);
    let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if LCImpl == Unsupported || getLibcallImplName(LCImpl) == self.DAG.getMachineFunction().getName() {
        let mut MulLo: SDValue = SDValue {};
        let mut MulHi: SDValue = SDValue {};
        self.TLI.forceExpandWideMUL(self.DAG, dl, true, N.getOperand(0), N.getOperand(1), MulLo, MulHi);
        let mut SRA: SDValue = self.DAG.getNode(SRA, dl, VT, MulLo, self.DAG.getShiftAmountConstant(VT.getScalarSizeInBits() - 1, VT, dl));
        let mut Overflow: SDValue = self.DAG.getSetCC(dl, N.getValueType(1), MulHi, SRA, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
        self.SplitInteger(MulLo, Lo, Hi);
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Overflow);
        return;
    }
    let mut Temp: SDValue = self.DAG.CreateStackTemporary(PtrVT, 1);
    let mut Chain: SDValue = self.DAG.getStore(self.DAG.getEntryNode(), dl, self.DAG.getConstant(0, dl, PtrVT, false, false), Temp, MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    let mut Args: ArgListTy = ArgListTy {};
    for Op in N.op_values() {
        let mut ArgVT: EVT = Op.getValueType();
        let mut ArgTy: *mut Type = ArgVT.getTypeForEVT(*self.DAG.getContext());
        let mut Entry: ArgListEntry = ArgListEntry { Op, ArgTy };
        Entry.IsSExt = true;
        Entry.IsZExt = false;
        Args.push(Entry);
    }
    let mut Entry: ArgListEntry = ArgListEntry { Temp, getUnqual(PtrTy.getContext()) };
    Entry.IsSExt = true;
    Entry.IsZExt = false;
    Args.push(Entry);
    let mut Func: SDValue = self.DAG.getExternalSymbol(LCImpl, PtrVT);
    let mut CLI: CallLoweringInfo = CallLoweringInfo { self.DAG };
    CLI.setDebugLoc(dl).setChain(Chain).setLibCallee(self.DAG.getLibcalls().getLibcallImplCallingConv(LCImpl), RetTy, Func, move(Args)).setSExtResult(true);
    let mut CallInfo: pair<SDValue, SDValue> = self.TLI.LowerCallTo(CLI);
    self.SplitInteger(CallInfo.first, Lo, Hi);
    let mut Temp2: SDValue = self.DAG.getLoad(PtrVT, dl, CallInfo.second, Temp, MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    let mut Ofl: SDValue = self.DAG.getSetCC(dl, N.getValueType(1), Temp2, self.DAG.getConstant(0, dl, PtrVT, false, false), SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Ofl);
}

fn DAGTypeLegalizer::ExpandIntRes_UDIV(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut VT: EVT = N.getValueType(0);
    let mut dl: SDLoc = SDLoc { N };
    let mut Ops: [2]SDValue = [N.getOperand(0), N.getOperand(1)];
    if self.TLI.getOperationAction(UDIVREM, VT) == Custom {
        let mut Res: SDValue = self.DAG.getNode(UDIVREM, dl, self.DAG.getVTList(VT, VT), ArrayRef<SDValue> { Ops });
        self.SplitInteger(Res.getValue(0), Lo, Hi);
        return;
    }
    if isa(N.getOperand(1)) {
        let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
        if self.isTypeLegal(NVT) {
            let mut InL: SDValue = SDValue {};
            let mut InH: SDValue = SDValue {};
            self.GetExpandedInteger(N.getOperand(0), InL, InH);
            let mut Result: SmallVector<SDValue> = SmallVector<SDValue> {};
            if self.TLI.expandDIVREMByConstant(N, Result, NVT, self.DAG, InL, InH) {
                Lo = Result[0];
                Hi = Result[1];
                return;
            }
        }
    }
    let mut LC: Libcall = getUDIV(VT);
    assert!(LC != UNKNOWN_LIBCALL, "Unsupported UDIV!");
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    self.SplitInteger(self.TLI.makeLibCall(self.DAG, LC, VT, ArrayRef<SDValue> { Ops }, CallOptions, dl, SDValue {}).first, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_UREM(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut VT: EVT = N.getValueType(0);
    let mut dl: SDLoc = SDLoc { N };
    let mut Ops: [2]SDValue = [N.getOperand(0), N.getOperand(1)];
    if self.TLI.getOperationAction(UDIVREM, VT) == Custom {
        let mut Res: SDValue = self.DAG.getNode(UDIVREM, dl, self.DAG.getVTList(VT, VT), ArrayRef<SDValue> { Ops });
        self.SplitInteger(Res.getValue(1), Lo, Hi);
        return;
    }
    if isa(N.getOperand(1)) {
        let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
        if self.isTypeLegal(NVT) {
            let mut InL: SDValue = SDValue {};
            let mut InH: SDValue = SDValue {};
            self.GetExpandedInteger(N.getOperand(0), InL, InH);
            let mut Result: SmallVector<SDValue> = SmallVector<SDValue> {};
            if self.TLI.expandDIVREMByConstant(N, Result, NVT, self.DAG, InL, InH) {
                Lo = Result[0];
                Hi = Result[1];
                return;
            }
        }
    }
    let mut LC: Libcall = getUREM(VT);
    assert!(LC != UNKNOWN_LIBCALL, "Unsupported UREM!");
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    self.SplitInteger(self.TLI.makeLibCall(self.DAG, LC, VT, ArrayRef<SDValue> { Ops }, CallOptions, dl, SDValue {}).first, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_ZERO_EXTEND(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut dl: SDLoc = SDLoc { N };
    let mut Op: SDValue = N.getOperand(0);
    if Op.getValueType().bitsLE(NVT) {
        Lo = self.DAG.getNode(ZERO_EXTEND, dl, NVT, N.getOperand(0));
        Hi = self.DAG.getConstant(0, dl, NVT, false, false);
    } else {
        assert!(self.getTypeAction(Op.getValueType()) == TypePromoteInteger, "Only know how to promote this result!");
        let mut Res: SDValue = self.GetPromotedInteger(Op);
        assert!(Res.getValueType() == N.getValueType(0), "Operand over promoted?");
        self.SplitInteger(Res, Lo, Hi);
        let mut ExcessBits: u32 = Op.getValueSizeInBits() - NVT.getSizeInBits().operator unsigned long long();
        Hi = self.DAG.getZeroExtendInReg(Hi, dl, getIntegerVT(*self.DAG.getContext(), ExcessBits));
    }
}

fn DAGTypeLegalizer::ExpandIntRes_ATOMIC_LOAD(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut dl: SDLoc = SDLoc { N };
    let mut VT: EVT = cast(N).getMemoryVT();
    let mut VTs: SDVTList = self.DAG.getVTList(VT, EVT { i1 }, EVT { Other });
    let mut Zero: SDValue = self.DAG.getConstant(0, dl, VT, false, false);
    let mut Swap: SDValue = self.DAG.getAtomicCmpSwap(ATOMIC_CMP_SWAP_WITH_SUCCESS, dl, cast(N).getMemoryVT(), VTs, N.getOperand(0), N.getOperand(1), Zero, Zero, cast(N).getMemOperand());
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Swap.getValue(0));
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Swap.getValue(2));
}

fn DAGTypeLegalizer::ExpandIntRes_VECREDUCE(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut Res: SDValue = self.TLI.expandVecReduce(N, self.DAG);
    self.SplitInteger(Res, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_Rotate(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut DL: SDLoc = SDLoc { N };
    let mut Opcode: u32 = if N.getOpcode() == ROTL { FSHL } else { FSHR };
    let mut Res: SDValue = self.DAG.getNode(Opcode, DL, N.getValueType(0), N.getOperand(0), N.getOperand(0), N.getOperand(1));
    self.SplitInteger(Res, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_FunnelShift(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut In1: SDValue = SDValue {};
    let mut In2: SDValue = SDValue {};
    let mut In3: SDValue = SDValue {};
    let mut In4: SDValue = SDValue {};
    self.GetExpandedInteger(N.getOperand(0), In3, In4);
    self.GetExpandedInteger(N.getOperand(1), In1, In2);
    let mut HalfVT: EVT = In1.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    let mut Opc: u32 = N.getOpcode();
    let mut ShAmt: SDValue = N.getOperand(2);
    let mut ShAmtVT: EVT = ShAmt.getValueType();
    let mut ShAmtCCVT: EVT = self.getSetCCResultType(ShAmtVT);
    let mut HalfVTBits: u32 = HalfVT.getScalarSizeInBits();
    let mut AndNode: SDValue = self.DAG.getNode(AND, DL, ShAmtVT, ShAmt, self.DAG.getConstant(HalfVTBits, DL, ShAmtVT, false, false));
    let mut Cond: SDValue = self.DAG.getSetCC(DL, ShAmtCCVT, AndNode, self.DAG.getConstant(0, DL, ShAmtVT, false, false), if Opc == FSHL { SETNE } else { SETEQ }, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut NewShAmtVT: EVT = self.TLI.getShiftAmountTy(HalfVT, self.DAG.getDataLayout());
    let mut NewShAmt: SDValue = self.DAG.getAnyExtOrTrunc(ShAmt, DL, NewShAmtVT);
    let mut Select1: SDValue = self.DAG.getNode(SELECT, DL, HalfVT, Cond, In1, In2);
    let mut Select2: SDValue = self.DAG.getNode(SELECT, DL, HalfVT, Cond, In2, In3);
    let mut Select3: SDValue = self.DAG.getNode(SELECT, DL, HalfVT, Cond, In3, In4);
    Lo = self.DAG.getNode(Opc, DL, HalfVT, Select2, Select1, NewShAmt);
    Hi = self.DAG.getNode(Opc, DL, HalfVT, Select3, Select2, NewShAmt);
}

fn DAGTypeLegalizer::ExpandIntRes_CLMUL(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    if N.getOpcode() != CLMUL {
        let mut Res: SDValue = self.TLI.expandCLMUL(N, self.DAG);
        return self.SplitInteger(Res, Lo, Hi);
    }
    let mut LL: SDValue = SDValue {};
    let mut LH: SDValue = SDValue {};
    let mut RL: SDValue = SDValue {};
    let mut RH: SDValue = SDValue {};
    self.GetExpandedInteger(N.getOperand(0), LL, LH);
    self.GetExpandedInteger(N.getOperand(1), RL, RH);
    let mut HalfVT: EVT = LL.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    Lo = self.DAG.getNode(CLMUL, DL, HalfVT, LL, RL);
    let mut LoH: SDValue = self.DAG.getNode(CLMULH, DL, HalfVT, LL, RL);
    let mut HiLoCross1: SDValue = self.DAG.getNode(CLMUL, DL, HalfVT, LL, RH);
    let mut HiLoCross2: SDValue = self.DAG.getNode(CLMUL, DL, HalfVT, LH, RL);
    let mut HiLoCross: SDValue = self.DAG.getNode(XOR, DL, HalfVT, HiLoCross1, HiLoCross2);
    Hi = self.DAG.getNode(XOR, DL, HalfVT, LoH, HiLoCross);
}

fn DAGTypeLegalizer::ExpandIntRes_PEXT(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut Res: SDValue = self.TLI.expandPEXT(N, self.DAG);
    self.SplitInteger(Res, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_PDEP(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut Res: SDValue = self.TLI.expandPDEP(N, self.DAG);
    self.SplitInteger(Res, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_MULH(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut Res: SDValue = self.TLI.expandMULH(N, self.DAG);
    self.SplitInteger(Res, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_VSCALE(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut VT: EVT = N.getValueType(0);
    let mut HalfVT: EVT = getIntegerVT(*self.DAG.getContext(), N.getValueSizeInBits(0).operator unsigned long long() / 2);
    let mut dl: SDLoc = SDLoc { N };
    let mut One: APInt = APInt { HalfVT.getSizeInBits().operator unsigned long long(), 1, false, false };
    let mut VScaleBase: SDValue = self.DAG.getVScale(dl, HalfVT, One);
    VScaleBase = self.DAG.getNode(ZERO_EXTEND, dl, VT, VScaleBase);
    let mut Res: SDValue = self.DAG.getNode(MUL, dl, VT, VScaleBase, N.getOperand(0));
    self.SplitInteger(Res, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntRes_READ_REGISTER(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut Fn: *Function = self.DAG.getMachineFunction().getFunction();
    Fn.getContext().diagnose(DiagnosticInfoLegalizationFailure { "cannot use llvm.read_register with illegal type", Fn, DiagnosticLocation { N.getDebugLoc() }, DS_Error });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, N.getOperand(0));
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    tie(LoVT, HiVT) = self.DAG.GetSplitDestVTs(N.getValueType(0));
    Lo = self.DAG.getPOISON(LoVT);
    Hi = self.DAG.getPOISON(HiVT);
}

fn DAGTypeLegalizer::ExpandIntRes_CTTZ_ELTS(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut VT: EVT = EVT { N.getSimpleValueType(0) };
    let mut IdxVT: EVT = EVT { self.TLI.getVectorIdxTy(self.DAG.getDataLayout()) };
    assert!(IdxVT.bitsLT(VT), "VectorIdxTy should be smaller than type to be expanded?");
    let mut Res: SDValue = self.DAG.getNode(N.getOpcode(), SDLoc { N }, IdxVT, N.getOperand(0));
    Res = self.DAG.getNode(ZERO_EXTEND, SDLoc { N }, VT, Res);
    self.SplitInteger(Res, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntegerOperand(self, N: *mut SDNode, OpNo: u32) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalize-types", 1) {
            dbgs() << "Expand integer operand: ";
            N.dump(&mut self.DAG);
        }
    }
        if !(false) { break; }
    }
    let mut Res: SDValue = SDValue {};
    if self.CustomLowerNode(N, N.getOperand(OpNo).getValueType(), false) {
        return false;
    }
    match N.getOpcode() {
        _ => {
            dbgs() << "ExpandIntegerOperand Op #" << OpNo << ": ";
        },
        BITCAST => {
            Res = self.ExpandOp_BITCAST(N);
        },
        BR_CC => {
            Res = self.ExpandIntOp_BR_CC(N);
        },
        BUILD_VECTOR => {
            Res = self.ExpandOp_BUILD_VECTOR(N);
        },
        EXTRACT_ELEMENT => {
            Res = self.ExpandOp_EXTRACT_ELEMENT(N);
        },
        FAKE_USE => {
            Res = self.ExpandOp_FAKE_USE(N);
        },
        LOOP_DEPENDENCE_RAW_MASK => {
            LOOP_DEPENDENCE_WAR_MASK;
        },
        INSERT_VECTOR_ELT => {
            Res = self.ExpandOp_INSERT_VECTOR_ELT(N);
        },
        SCALAR_TO_VECTOR => {
            Res = self.ExpandOp_SCALAR_TO_VECTOR(N);
        },
        SPLAT_VECTOR => {
            Res = self.ExpandIntOp_SPLAT_VECTOR(N);
        },
        SELECT_CC => {
            Res = self.ExpandIntOp_SELECT_CC(N);
        },
        SETCC => {
            Res = self.ExpandIntOp_SETCC(N);
        },
        SETCCCARRY => {
            Res = self.ExpandIntOp_SETCCCARRY(N);
        },
        STRICT_SINT_TO_FP => {
            SINT_TO_FP;
        },
        STORE => {
            Res = self.ExpandIntOp_STORE(cast(N), OpNo);
        },
        TRUNCATE => {
            Res = self.ExpandIntOp_TRUNCATE(N);
        },
        SHL => {
            SRA;
        },
        RETURNADDR => {
            FRAMEADDR;
        },
        SCMP => {
            UCMP;
        },
        ATOMIC_STORE => {
            Res = self.ExpandIntOp_ATOMIC_STORE(N);
        },
        STACKMAP => {
            Res = self.ExpandIntOp_STACKMAP(N, OpNo);
        },
        PATCHPOINT => {
            Res = self.ExpandIntOp_PATCHPOINT(N, OpNo);
        },
        EXPERIMENTAL_VP_STRIDED_LOAD => {
            EXPERIMENTAL_VP_STRIDED_STORE;
        },
        WRITE_REGISTER => {
            Res = self.ExpandIntOp_WRITE_REGISTER(N, OpNo);
        },
    }
    if !Res.getNode() {
        return false;
    }
    if Res.getNode() == N {
        return true;
    }
    assert!(Res.getValueType() == N.getValueType(0) && N.getNumValues() == 1, "Invalid operand expansion");
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Res);
    return false;
}

fn DAGTypeLegalizer::IntegerExpandSetCCOperands(self, NewLHS: *mut SDValue, NewRHS: *mut SDValue, CCCode: *mut CondCode, dl: *SDLoc) {
    let mut LHSLo: SDValue = SDValue {};
    let mut LHSHi: SDValue = SDValue {};
    let mut RHSLo: SDValue = SDValue {};
    let mut RHSHi: SDValue = SDValue {};
    self.GetExpandedInteger(NewLHS, LHSLo, LHSHi);
    self.GetExpandedInteger(NewRHS, RHSLo, RHSHi);
    if CCCode == SETEQ || CCCode == SETNE {
        if RHSLo == RHSHi && isAllOnesConstant(RHSLo) {
            NewLHS = self.DAG.getNode(AND, dl, LHSLo.getValueType(), LHSLo, LHSHi);
            NewRHS = RHSLo;
            return;
        }
        NewLHS = self.DAG.getNode(XOR, dl, LHSLo.getValueType(), LHSLo, RHSLo);
        NewRHS = self.DAG.getNode(XOR, dl, LHSLo.getValueType(), LHSHi, RHSHi);
        NewLHS = self.DAG.getNode(OR, dl, NewLHS.getValueType(), NewLHS, NewRHS);
        NewRHS = self.DAG.getConstant(0, dl, NewLHS.getValueType(), false, false);
        return;
    }
    if dyn_cast(NewRHS) {
        CST;
    } else if (CCCode == SETLT && CST.isZero()) || (CCCode == SETGT && CST.isAllOnes()) {
        NewLHS = LHSHi;
        NewRHS = RHSHi;
        return;
    }
    let mut LowCC: CondCode = zeroed();
    match CCCode {
        _ => {
            llvm_unreachable_internal("Unknown integer setcc!", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeIntegerTypes.cpp", 5767);
        },
        SETLT => {
            SETULT;
        },
        SETGT => {
            SETUGT;
        },
        SETLE => {
            SETULE;
        },
        SETGE => {
            SETUGE;
        },
    }
    let mut DagCombineInfo: DAGCombinerInfo = DAGCombinerInfo { self.DAG, AfterLegalizeTypes, true, null };
    let mut LoCmp: SDValue = SDValue {};
    let mut HiCmp: SDValue = SDValue {};
    if self.TLI.isTypeLegal(LHSLo.getValueType()) {
        LoCmp = self.TLI.SimplifySetCC(self.getSetCCResultType(LHSLo.getValueType()), LHSLo, RHSLo, LowCC, false, DagCombineInfo, dl);
    }
    if !LoCmp.getNode() {
        LoCmp = self.DAG.getSetCC(dl, self.getSetCCResultType(LHSLo.getValueType()), LHSLo, RHSLo, LowCC, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    if self.TLI.isTypeLegal(LHSHi.getValueType()) {
        HiCmp = self.TLI.SimplifySetCC(self.getSetCCResultType(LHSHi.getValueType()), LHSHi, RHSHi, CCCode, false, DagCombineInfo, dl);
    }
    if !HiCmp.getNode() {
        HiCmp = self.DAG.getNode(SETCC, dl, self.getSetCCResultType(LHSHi.getValueType()), LHSHi, RHSHi, self.DAG.getCondCode(CCCode));
    }
    let mut LoCmpC: *mut ConstantSDNode = dyn_cast(LoCmp.getNode());
    let mut HiCmpC: *mut ConstantSDNode = dyn_cast(HiCmp.getNode());
    let mut EqAllowed: bool = isTrueWhenEqual(CCCode);
    if (EqAllowed && (HiCmpC && HiCmpC.isZero())) || (!EqAllowed && ((HiCmpC && HiCmpC.isOne()) || (LoCmpC && LoCmpC.isZero()))) {
        NewLHS = HiCmp;
        NewRHS = SDValue {};
        return;
    }
    if LHSHi == RHSHi {
        NewLHS = LoCmp;
        NewRHS = SDValue {};
        return;
    }
    let mut HiVT: EVT = LHSHi.getValueType();
    let mut ExpandVT: EVT = self.TLI.getTypeToExpandTo(*self.DAG.getContext(), HiVT);
    let mut HasSETCCCARRY: bool = self.TLI.isOperationLegalOrCustom(SETCCCARRY, ExpandVT, false);
    if HasSETCCCARRY {
        let mut FlipOperands: bool = false;
        match CCCode {
            SETGT => {
                CCCode = SETLT;
            },
            SETUGT => {
                CCCode = SETULT;
            },
            SETLE => {
                CCCode = SETGE;
            },
            SETULE => {
                CCCode = SETUGE;
            },
            _ => {
                break;
            },
        }
        if FlipOperands {
            swap(LHSLo, RHSLo);
            swap(LHSHi, RHSHi);
        }
        let mut LoVT: EVT = LHSLo.getValueType();
        let mut VTList: SDVTList = self.DAG.getVTList(LoVT, self.getSetCCResultType(LoVT));
        let mut LowCmp: SDValue = self.DAG.getNode(USUBO, dl, VTList, LHSLo, RHSLo);
        let mut Res: SDValue = self.DAG.getNode(SETCCCARRY, dl, self.getSetCCResultType(HiVT), LHSHi, RHSHi, LowCmp.getValue(1), self.DAG.getCondCode(CCCode));
        NewLHS = Res;
        NewRHS = SDValue {};
        return;
    }
    NewLHS = self.TLI.SimplifySetCC(self.getSetCCResultType(HiVT), LHSHi, RHSHi, SETEQ, false, DagCombineInfo, dl);
    if !NewLHS.getNode() {
        NewLHS = self.DAG.getSetCC(dl, self.getSetCCResultType(HiVT), LHSHi, RHSHi, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    NewLHS = self.DAG.getSelect(dl, LoCmp.getValueType(), NewLHS, LoCmp, HiCmp, SDNodeFlags { Flags: None });
    NewRHS = SDValue {};
}

fn DAGTypeLegalizer::ExpandIntOp_BR_CC(self, N: *mut SDNode) -> SDValue {
    let mut NewLHS: SDValue = N.getOperand(2);
    let mut NewRHS: SDValue = N.getOperand(3);
    let mut CCCode: CondCode = cast(N.getOperand(1)).get();
    self.IntegerExpandSetCCOperands(NewLHS, NewRHS, CCCode, SDLoc { N });
    if !NewRHS.getNode() {
        NewRHS = self.DAG.getConstant(0, SDLoc { N }, NewLHS.getValueType(), false, false);
        CCCode = SETNE;
    }
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, N.getOperand(0), self.DAG.getCondCode(CCCode), NewLHS, NewRHS, N.getOperand(4)), ResNo: 0 };
}

fn DAGTypeLegalizer::ExpandIntOp_SELECT_CC(self, N: *mut SDNode) -> SDValue {
    let mut NewLHS: SDValue = N.getOperand(0);
    let mut NewRHS: SDValue = N.getOperand(1);
    let mut CCCode: CondCode = cast(N.getOperand(4)).get();
    self.IntegerExpandSetCCOperands(NewLHS, NewRHS, CCCode, SDLoc { N });
    if !NewRHS.getNode() {
        NewRHS = self.DAG.getConstant(0, SDLoc { N }, NewLHS.getValueType(), false, false);
        CCCode = SETNE;
    }
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, NewLHS, NewRHS, N.getOperand(2), N.getOperand(3), self.DAG.getCondCode(CCCode)), ResNo: 0 };
}

fn DAGTypeLegalizer::ExpandIntOp_SETCC(self, N: *mut SDNode) -> SDValue {
    let mut NewLHS: SDValue = N.getOperand(0);
    let mut NewRHS: SDValue = N.getOperand(1);
    let mut CCCode: CondCode = cast(N.getOperand(2)).get();
    self.IntegerExpandSetCCOperands(NewLHS, NewRHS, CCCode, SDLoc { N });
    if !NewRHS.getNode() {
        assert!(NewLHS.getValueType() == N.getValueType(0), "Unexpected setcc expansion!");
        return NewLHS;
    }
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, NewLHS, NewRHS, self.DAG.getCondCode(CCCode)), ResNo: 0 };
}

fn DAGTypeLegalizer::ExpandIntOp_SETCCCARRY(self, N: *mut SDNode) -> SDValue {
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut Carry: SDValue = N.getOperand(2);
    let mut Cond: SDValue = N.getOperand(3);
    let mut dl: SDLoc = SDLoc { N };
    let mut LHSLo: SDValue = SDValue {};
    let mut LHSHi: SDValue = SDValue {};
    let mut RHSLo: SDValue = SDValue {};
    let mut RHSHi: SDValue = SDValue {};
    self.GetExpandedInteger(LHS, LHSLo, LHSHi);
    self.GetExpandedInteger(RHS, RHSLo, RHSHi);
    let mut VTList: SDVTList = self.DAG.getVTList(LHSLo.getValueType(), Carry.getValueType());
    let mut LowCmp: SDValue = self.DAG.getNode(USUBO_CARRY, dl, VTList, LHSLo, RHSLo, Carry);
    return self.DAG.getNode(SETCCCARRY, dl, N.getValueType(0), LHSHi, RHSHi, LowCmp.getValue(1), Cond);
}

fn DAGTypeLegalizer::ExpandIntOp_SPLAT_VECTOR(self, N: *mut SDNode) -> SDValue {
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    self.GetExpandedInteger(N.getOperand(0), Lo, Hi);
    return self.DAG.getNode(SPLAT_VECTOR_PARTS, SDLoc { N }, N.getValueType(0), Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntOp_Shift(self, N: *mut SDNode) -> SDValue {
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    self.GetExpandedInteger(N.getOperand(1), Lo, Hi);
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, N.getOperand(0), Lo), ResNo: 0 };
}

fn DAGTypeLegalizer::ExpandIntOp_CMP(self, N: *mut SDNode) -> SDValue {
    return self.TLI.expandCMP(N, self.DAG);
}

fn DAGTypeLegalizer::ExpandIntOp_RETURNADDR(self, N: *mut SDNode) -> SDValue {
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    self.GetExpandedInteger(N.getOperand(0), Lo, Hi);
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, Lo), ResNo: 0 };
}

fn DAGTypeLegalizer::ExpandIntOp_XINT_TO_FP(self, N: *mut SDNode) -> SDValue {
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut IsSigned: bool = N.getOpcode() == SINT_TO_FP || N.getOpcode() == STRICT_SINT_TO_FP;
    let mut Chain: SDValue = if IsStrict { N.getOperand(0) } else { SDValue {} };
    let mut Op: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    let mut DstVT: EVT = N.getValueType(0);
    let mut LC: Libcall = if IsSigned { getSINTTOFP(Op.getValueType(), DstVT) } else { getUINTTOFP(Op.getValueType(), DstVT) };
    assert!(LC != UNKNOWN_LIBCALL, "Don't know how to expand this XINT_TO_FP!");
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    CallOptions.setIsSigned(true);
    let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, LC, DstVT, ArrayRef<SDValue> { Op }, CallOptions, SDLoc { N }, Chain);
    if !IsStrict {
        return Tmp.first;
    }
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Tmp.second);
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Tmp.first);
    return SDValue {};
}

fn DAGTypeLegalizer::ExpandIntOp_STORE(self, N: *mut StoreSDNode, OpNo: u32) -> SDValue {
    assert!(!N.isAtomic(), "Should have been a ATOMIC_STORE?");
    if isNormalStore(N) {
        return self.ExpandOp_NormalStore(N, OpNo);
    }
    assert!(isUNINDEXEDStore(N), "Indexed store during type legalization!");
    assert!(OpNo == 1, "Can only expand the stored value so far");
    let mut VT: EVT = N.getOperand(1).getValueType();
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut Ch: SDValue = N.getChain();
    let mut Ptr: SDValue = N.getBasePtr();
    let mut MMOFlags: Flags = N.getMemOperand().getFlags();
    let mut AAInfo: AAMDNodes = N.getAAInfo();
    let mut dl: SDLoc = SDLoc { N };
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    assert!(NVT.isByteSized(), "Expanded type not byte sized!");
    if N.getMemoryVT().bitsLE(NVT) {
        self.GetExpandedInteger(N.getValue(), Lo, Hi);
        return self.DAG.getTruncStore(Ch, dl, Lo, Ptr, N.getPointerInfo(), N.getMemoryVT(), N.getBaseAlign(), MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
    }
    if self.DAG.getDataLayout().isLittleEndian() {
        self.GetExpandedInteger(N.getValue(), Lo, Hi);
        Lo = self.DAG.getStore(Ch, dl, Lo, Ptr, N.getPointerInfo(), N.getBaseAlign(), MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
        let mut ExcessBits: u32 = N.getMemoryVT().getSizeInBits() - NVT.getSizeInBits().operator unsigned long long();
        let mut NEVT: EVT = getIntegerVT(*self.DAG.getContext(), ExcessBits);
        let mut IncrementSize: u32 = NVT.getSizeInBits().operator unsigned long long() / 8;
        Ptr = self.DAG.getObjectPtrOffset(dl, Ptr, getFixed(IncrementSize));
        Hi = self.DAG.getTruncStore(Ch, dl, Hi, Ptr, N.getPointerInfo().getWithOffset(IncrementSize), NEVT, N.getBaseAlign(), MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
        return self.DAG.getNode(TokenFactor, dl, EVT { Other }, Lo, Hi);
    }
    self.GetExpandedInteger(N.getValue(), Lo, Hi);
    let mut ExtVT: EVT = N.getMemoryVT();
    let mut EBytes: u32 = ExtVT.getStoreSize().operator unsigned long long();
    let mut IncrementSize: u32 = NVT.getSizeInBits().operator unsigned long long() / 8;
    let mut ExcessBits: u32 = (EBytes - IncrementSize) * 8;
    let mut HiVT: EVT = getIntegerVT(*self.DAG.getContext(), ExtVT.getSizeInBits().operator unsigned long long() - ExcessBits);
    if ExcessBits < NVT.getSizeInBits().operator unsigned long long() {
        Hi = self.DAG.getNode(SHL, dl, NVT, Hi, self.DAG.getShiftAmountConstant(NVT.getSizeInBits().operator unsigned long long() - ExcessBits, NVT, dl));
        Hi = self.DAG.getNode(OR, dl, NVT, Hi, self.DAG.getNode(SRL, dl, NVT, Lo, self.DAG.getShiftAmountConstant(ExcessBits, NVT, dl)));
    }
    Hi = self.DAG.getTruncStore(Ch, dl, Hi, Ptr, N.getPointerInfo(), HiVT, N.getBaseAlign(), MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
    Ptr = self.DAG.getObjectPtrOffset(dl, Ptr, getFixed(IncrementSize));
    Lo = self.DAG.getTruncStore(Ch, dl, Lo, Ptr, N.getPointerInfo().getWithOffset(IncrementSize), getIntegerVT(*self.DAG.getContext(), ExcessBits), N.getBaseAlign(), MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
    return self.DAG.getNode(TokenFactor, dl, EVT { Other }, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandIntOp_TRUNCATE(self, N: *mut SDNode) -> SDValue {
    let mut InL: SDValue = SDValue {};
    let mut InH: SDValue = SDValue {};
    self.GetExpandedInteger(N.getOperand(0), InL, InH);
    return self.DAG.getNode(TRUNCATE, SDLoc { N }, N.getValueType(0), InL);
}

fn DAGTypeLegalizer::ExpandIntOp_ATOMIC_STORE(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut Swap: SDValue = self.DAG.getAtomic(ATOMIC_SWAP, dl, cast(N).getMemoryVT(), N.getOperand(0), N.getOperand(2), N.getOperand(1), cast(N).getMemOperand());
    return Swap.getValue(1);
}

fn DAGTypeLegalizer::ExpandIntOp_VP_STRIDED(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!((N.getOpcode() == EXPERIMENTAL_VP_STRIDED_LOAD && OpNo == 3) || (N.getOpcode() == EXPERIMENTAL_VP_STRIDED_STORE && OpNo == 4));
    let mut Hi: SDValue = SDValue {};
    let mut NewOps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { N.ops() };
    self.GetExpandedInteger(NewOps[OpNo], NewOps[OpNo], Hi);
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, ArrayRef<SDValue> { NewOps }), ResNo: 0 };
}

fn DAGTypeLegalizer::ExpandIntOp_WRITE_REGISTER(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    let mut Fn: *Function = self.DAG.getMachineFunction().getFunction();
    Fn.getContext().diagnose(DiagnosticInfoLegalizationFailure { "cannot use llvm.write_register with illegal type", Fn, DiagnosticLocation { N.getDebugLoc() }, DS_Error });
    return N.getOperand(0);
}

fn DAGTypeLegalizer::PromoteIntRes_VECTOR_SPLICE(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut V0: SDValue = self.GetPromotedInteger(N.getOperand(0));
    let mut V1: SDValue = self.GetPromotedInteger(N.getOperand(1));
    let mut OutVT: EVT = V0.getValueType();
    return self.DAG.getNode(N.getOpcode(), dl, OutVT, V0, V1, N.getOperand(2));
}

fn DAGTypeLegalizer::PromoteIntRes_VECTOR_REPEAT(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut OutVT: EVT = N.getValueType(0);
    let mut NOutVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OutVT);
    let mut NInVT: EVT = N.getOperand(0).getValueType().changeVectorElementType(*self.DAG.getContext(), NOutVT.getVectorElementType());
    let mut Op: SDValue = self.DAG.getNode(ANY_EXTEND, DL, NInVT, N.getOperand(0));
    return self.DAG.getNode(N.getOpcode(), DL, NOutVT, Op);
}

fn DAGTypeLegalizer::PromoteIntRes_VECTOR_INTERLEAVE_DEINTERLEAVE(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Factor: u32 = N.getNumOperands();
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { Factor };
    for let mut i: u32 = 0; i != Factor; i += 1 {
        Ops[i] = self.GetPromotedInteger(N.getOperand(i));
    }
    let mut ResVTs: SmallVector<EVT, 8> = SmallVector<EVT, 8> { Factor, Ops[0].getValueType() };
    let mut Res: SDValue = self.DAG.getNode(N.getOpcode(), DL, self.DAG.getVTList(ArrayRef<EVT> { ResVTs }), ArrayRef<SDValue> { Ops });
    for let mut i: u32 = 0; i != Factor; i += 1 {
        self.SetPromotedInteger(SDValue { Node: N, ResNo: i }, Res.getValue(i));
    }
    return SDValue {};
}

fn DAGTypeLegalizer::PromoteIntRes_EXTRACT_SUBVECTOR(self, N: *mut SDNode) -> SDValue {
    let mut OutVT: EVT = N.getValueType(0);
    let mut NOutVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OutVT);
    assert!(NOutVT.isVector(), "This type must be promoted to a vector type");
    let mut NOutVTElem: EVT = NOutVT.getVectorElementType();
    let mut dl: SDLoc = SDLoc { N };
    let mut BaseIdx: SDValue = N.getOperand(1);
    if OutVT.isScalableVector() {
        let mut InOp0: SDValue = N.getOperand(0);
        let mut InVT: EVT = InOp0.getValueType();
        if self.getTypeAction(InVT) == TypeSplitVector || self.getTypeAction(InVT) == TypeLegal {
            let mut NInVT: EVT = InVT.getHalfNumVectorElementsVT(*self.DAG.getContext());
            let mut NElts: u32 = NInVT.getVectorMinNumElements();
            let mut IdxVal: u64 = operator(BaseIdx).getAsZExtVal();
            let mut Step1: SDValue = self.DAG.getNode(EXTRACT_SUBVECTOR, dl, NInVT, InOp0, self.DAG.getConstant(alignDown(IdxVal, NElts, 0), dl, BaseIdx.getValueType(), false, false));
            let mut Step2: SDValue = self.DAG.getNode(EXTRACT_SUBVECTOR, dl, OutVT, Step1, self.DAG.getConstant(IdxVal % NElts, dl, BaseIdx.getValueType(), false, false));
            return self.DAG.getNode(ANY_EXTEND, dl, NOutVT, Step2);
        }
        if self.getTypeAction(InVT) == TypeWidenVector {
            let mut Ops: [2]SDValue = [self.GetWidenedVector(InOp0), BaseIdx];
            let mut Ext: SDValue = self.DAG.getNode(EXTRACT_SUBVECTOR, SDLoc { N }, OutVT, ArrayRef<SDValue> { Ops });
            return self.DAG.getNode(ANY_EXTEND, dl, NOutVT, Ext);
        }
        if self.getTypeAction(InVT) == TypePromoteInteger {
            let mut Ops: [2]SDValue = [self.GetPromotedInteger(InOp0), BaseIdx];
            let mut PromEltVT: EVT = Ops[0].getValueType().getVectorElementType();
            assert!(PromEltVT.bitsLE(NOutVTElem), "Promoted operand has an element type greater than result");
            let mut ExtVT: EVT = NOutVT.changeVectorElementType(*self.DAG.getContext(), PromEltVT);
            let mut Ext: SDValue = self.DAG.getNode(EXTRACT_SUBVECTOR, SDLoc { N }, ExtVT, ArrayRef<SDValue> { Ops });
            return self.DAG.getNode(ANY_EXTEND, dl, NOutVT, Ext);
        }
    }
    if OutVT.isScalableVector() {
        report_fatal_error("Unable to promote scalable types using BUILD_VECTOR", true);
    }
    let mut InOp0: SDValue = N.getOperand(0);
    if self.getTypeAction(InOp0.getValueType()) == TypePromoteInteger {
        InOp0 = self.GetPromotedInteger(InOp0);
    }
    let mut InVT: EVT = InOp0.getValueType();
    let mut InSVT: EVT = InVT.getVectorElementType();
    let mut OutNumElems: u32 = OutVT.getVectorNumElements();
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    Ops.reserve(OutNumElems);
    for let mut i: u32 = 0; i != OutNumElems; i += 1 {
        let mut Index: SDValue = self.DAG.getNode(ADD, dl, BaseIdx.getValueType(), BaseIdx, self.DAG.getConstant(i, dl, BaseIdx.getValueType(), false, false));
        let mut Ext: SDValue = self.DAG.getNode(EXTRACT_VECTOR_ELT, dl, InSVT, N.getOperand(0), Index);
        let mut Op: SDValue = self.DAG.getAnyExtOrTrunc(Ext, dl, NOutVTElem);
        Ops.push(ValueParamT { Op });
    }
    return self.DAG.getBuildVector(NOutVT, dl, ArrayRef<SDValue> { Ops });
}

fn DAGTypeLegalizer::PromoteIntRes_INSERT_SUBVECTOR(self, N: *mut SDNode) -> SDValue {
    let mut OutVT: EVT = N.getValueType(0);
    let mut NOutVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OutVT);
    assert!(NOutVT.isVector(), "This type must be promoted to a vector type");
    let mut dl: SDLoc = SDLoc { N };
    let mut Vec: SDValue = N.getOperand(0);
    let mut SubVec: SDValue = N.getOperand(1);
    let mut Idx: SDValue = N.getOperand(2);
    let mut SubVecVT: EVT = SubVec.getValueType();
    let mut NSubVT: EVT = getVectorVT(*self.DAG.getContext(), NOutVT.getVectorElementType(), SubVecVT.getVectorElementCount());
    Vec = self.GetPromotedInteger(Vec);
    SubVec = self.DAG.getNode(ANY_EXTEND, dl, NSubVT, SubVec);
    return self.DAG.getNode(INSERT_SUBVECTOR, dl, NOutVT, Vec, SubVec, Idx);
}

fn DAGTypeLegalizer::PromoteIntRes_VECTOR_REVERSE(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut V0: SDValue = self.GetPromotedInteger(N.getOperand(0));
    let mut OutVT: EVT = V0.getValueType();
    return self.DAG.getNode(VECTOR_REVERSE, dl, OutVT, V0);
}

fn DAGTypeLegalizer::PromoteIntRes_VECTOR_SHUFFLE(self, N: *mut SDNode) -> SDValue {
    let mut SV: *mut ShuffleVectorSDNode = cast(N);
    let mut VT: EVT = N.getValueType(0);
    let mut dl: SDLoc = SDLoc { N };
    let mut NewMask: ArrayRef<int> = SV.getMask().slice(0, VT.getVectorNumElements());
    let mut V0: SDValue = self.GetPromotedInteger(N.getOperand(0));
    let mut V1: SDValue = self.GetPromotedInteger(N.getOperand(1));
    let mut OutVT: EVT = V0.getValueType();
    return self.DAG.getVectorShuffle(OutVT, dl, V0, V1, NewMask);
}

fn DAGTypeLegalizer::PromoteIntRes_BUILD_VECTOR(self, N: *mut SDNode) -> SDValue {
    let mut OutVT: EVT = N.getValueType(0);
    let mut NOutVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OutVT);
    assert!(NOutVT.isVector(), "This type must be promoted to a vector type");
    let mut NumElems: u32 = N.getNumOperands();
    let mut NOutVTElem: EVT = NOutVT.getVectorElementType();
    let mut NOutBoolType: BooleanContent = self.TLI.getBooleanContents(NOutVT);
    let mut NOutExtOpc: u32 = getExtendForContent(NOutBoolType);
    let mut dl: SDLoc = SDLoc { N };
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    Ops.reserve(NumElems);
    for let mut i: u32 = 0; i != NumElems; i += 1 {
        let mut Op: SDValue = N.getOperand(i);
        let mut OpVT: EVT = Op.getValueType();
        if OpVT.bitsLT(NOutVTElem) {
            let mut ExtOpc: u32 = ANY_EXTEND;
            if OpVT == EVT { i1 } && Op.getOpcode() == Constant {
                ExtOpc = NOutExtOpc;
            }
            Op = self.DAG.getNode(ExtOpc, dl, NOutVTElem, Op);
        }
        Ops.push(ValueParamT { Op });
    }
    return self.DAG.getBuildVector(NOutVT, dl, ArrayRef<SDValue> { Ops });
}

fn DAGTypeLegalizer::PromoteIntRes_ScalarOp(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    assert!(!N.getOperand(0).getValueType().isVector(), "Input must be a scalar");
    let mut OutVT: EVT = N.getValueType(0);
    let mut NOutVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OutVT);
    assert!(NOutVT.isVector(), "This type must be promoted to a vector type");
    let mut NOutElemVT: EVT = NOutVT.getVectorElementType();
    let mut Op: SDValue = self.DAG.getNode(ANY_EXTEND, dl, NOutElemVT, N.getOperand(0));
    return self.DAG.getNode(N.getOpcode(), dl, NOutVT, Op);
}

fn DAGTypeLegalizer::PromoteIntRes_STEP_VECTOR(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut OutVT: EVT = N.getValueType(0);
    let mut NOutVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OutVT);
    assert!(NOutVT.isScalableVector(), "Type must be promoted to a scalable vector type");
    let mut StepVal: *APInt = N.getConstantOperandAPInt(0);
    return self.DAG.getStepVector(dl, NOutVT, StepVal.sext(NOutVT.getScalarSizeInBits()));
}

fn DAGTypeLegalizer::PromoteIntRes_CONCAT_VECTORS(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut OutVT: EVT = N.getValueType(0);
    let mut NOutVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OutVT);
    assert!(NOutVT.isVector(), "This type must be promoted to a vector type");
    let mut NumOperands: u32 = N.getNumOperands();
    let mut NumOutElem: u32 = NOutVT.getVectorMinNumElements();
    let mut OutElemTy: EVT = NOutVT.getVectorElementType();
    if OutVT.isScalableVector() {
        let mut OpVT: EVT = N.getOperand(0).getValueType();
        let mut OpAction: LegalizeTypeAction = self.getTypeAction(OpVT);
        assert!((OpAction == TypeLegal || OpAction == TypePromoteInteger || OpAction == TypeWidenVector), "Unhandled legalization type");
        let mut ExtendedOpVT: EVT = OpVT.changeVectorElementType(*self.DAG.getContext(), OutElemTy);
        let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
        for let mut I: u32 = 0; I < NumOperands; I += 1 {
            let mut Op: SDValue = N.getOperand(I);
            if OpAction == TypePromoteInteger {
                Op = self.GetPromotedInteger(Op);
            } else if OpAction == TypeWidenVector {
                Op = self.DAG.getNode(ANY_EXTEND, dl, ExtendedOpVT, Op);
            }
            Ops.push(ValueParamT { Op });
        }
        let mut ConcatVT: EVT = OutVT.changeVectorElementType(*self.DAG.getContext(), Ops[0].getValueType().getVectorElementType());
        return self.DAG.getAnyExtOrTrunc(self.DAG.getNode(CONCAT_VECTORS, dl, ConcatVT, ArrayRef<SDValue> { Ops }), dl, NOutVT);
    }
    let mut NumElem: u32 = N.getOperand(0).getValueType().getVectorNumElements();
    assert!(NumElem * NumOperands == NumOutElem, "Unexpected number of elements");
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { NumOutElem };
    for let mut i: u32 = 0; i < NumOperands; i += 1 {
        let mut Op: SDValue = N.getOperand(i);
        if self.getTypeAction(Op.getValueType()) == TypePromoteInteger {
            Op = self.GetPromotedInteger(Op);
        }
        let mut SclrTy: EVT = Op.getValueType().getVectorElementType();
        assert!(NumElem == Op.getValueType().getVectorNumElements(), "Unexpected number of elements");
        for let mut j: u32 = 0; j < NumElem; j += 1 {
            let mut Ext: SDValue = self.DAG.getNode(EXTRACT_VECTOR_ELT, dl, SclrTy, Op, self.DAG.getVectorIdxConstant(j, dl, false));
            Ops[i * NumElem + j] = self.DAG.getAnyExtOrTrunc(Ext, dl, OutElemTy);
        }
    }
    return self.DAG.getBuildVector(NOutVT, dl, ArrayRef<SDValue> { Ops });
}

fn DAGTypeLegalizer::PromoteIntRes_EXTEND_VECTOR_INREG(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    assert!(NVT.isVector(), "This type must be promoted to a vector type");
    let mut dl: SDLoc = SDLoc { N };
    if self.getTypeAction(N.getOperand(0).getValueType()) == TypePromoteInteger {
        let mut Promoted: SDValue = SDValue {};
        match N.getOpcode() {
            SIGN_EXTEND_VECTOR_INREG => {
                Promoted = self.SExtPromotedInteger(N.getOperand(0));
            },
            ZERO_EXTEND_VECTOR_INREG => {
                Promoted = self.ZExtPromotedInteger(N.getOperand(0));
            },
            ANY_EXTEND_VECTOR_INREG => {
                Promoted = self.GetPromotedInteger(N.getOperand(0));
            },
            _ => {
                llvm_unreachable_internal("Node has unexpected Opcode", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeIntegerTypes.cpp", 6432);
            },
        }
        let mut NewSize: u32 = NVT.getSizeInBits().operator unsigned long long();
        if Promoted.getValueType().getSizeInBits().operator unsigned long long() > NewSize {
            let mut ExtractVT: EVT = getVectorVT(*self.DAG.getContext(), Promoted.getValueType().getVectorElementType(), NewSize / Promoted.getScalarValueSizeInBits(), false);
            Promoted = self.DAG.getNode(EXTRACT_SUBVECTOR, dl, ExtractVT, Promoted, self.DAG.getVectorIdxConstant(0, dl, false));
        }
        return self.DAG.getNode(N.getOpcode(), dl, NVT, Promoted);
    }
    return self.DAG.getNode(N.getOpcode(), dl, NVT, N.getOperand(0));
}

fn DAGTypeLegalizer::PromoteIntRes_VECTOR_FIND_LAST_ACTIVE(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    return self.DAG.getNode(VECTOR_FIND_LAST_ACTIVE, SDLoc { N }, NVT, N.ops());
}

fn DAGTypeLegalizer::PromoteIntRes_GET_ACTIVE_LANE_MASK(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    return self.DAG.getNode(GET_ACTIVE_LANE_MASK, SDLoc { N }, NVT, N.ops());
}

fn DAGTypeLegalizer::PromoteIntRes_VECTOR_MATCH(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut NewOps: SmallVector<SDValue, 3> = SmallVector<SDValue, 3> { N.ops() };
    NewOps[2] = self.PromoteTargetBoolean(N.getOperand(2), NVT);
    return self.DAG.getNode(VECTOR_MATCH, SDLoc { N }, NVT, ArrayRef<SDValue> { NewOps }, N.getFlags());
}

fn DAGTypeLegalizer::PromoteIntRes_PARTIAL_REDUCE_MLA(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut ExtAcc: SDValue = self.GetPromotedInteger(N.getOperand(0));
    return self.DAG.getNode(N.getOpcode(), DL, NVT, ExtAcc, N.getOperand(1), N.getOperand(2));
}

fn DAGTypeLegalizer::PromoteIntRes_INSERT_VECTOR_ELT(self, N: *mut SDNode) -> SDValue {
    let mut OutVT: EVT = N.getValueType(0);
    let mut NOutVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OutVT);
    assert!(NOutVT.isVector(), "This type must be promoted to a vector type");
    let mut NOutVTElem: EVT = NOutVT.getVectorElementType();
    let mut dl: SDLoc = SDLoc { N };
    let mut V0: SDValue = self.GetPromotedInteger(N.getOperand(0));
    let mut ConvElem: SDValue = self.DAG.getNode(ANY_EXTEND, dl, NOutVTElem, N.getOperand(1));
    return self.DAG.getNode(INSERT_VECTOR_ELT, dl, NOutVT, V0, ConvElem, N.getOperand(2));
}

fn DAGTypeLegalizer::PromoteIntRes_VECREDUCE(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    return self.DAG.getNode(N.getOpcode(), dl, NVT, N.ops());
}

fn DAGTypeLegalizer::PromoteIntRes_VP_REDUCE(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Start: SDValue = self.PromoteIntOpVectorReduction(N, N.getOperand(0));
    return self.DAG.getNode(N.getOpcode(), DL, Start.getValueType(), Start, N.getOperand(1), N.getOperand(2), N.getOperand(3));
}

fn DAGTypeLegalizer::PromoteIntRes_PATCHPOINT(self, N: *mut SDNode) -> SDValue {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut dl: SDLoc = SDLoc { N };
    assert!(N.getNumValues() == 3, "Expected 3 values for PATCHPOINT");
    let mut VTList: SDVTList = self.DAG.getVTList(ArrayRef<EVT> { [NVT, EVT { Other }, EVT { Glue }] });
    let mut Ops: SmallVector<SDValue> = SmallVector<SDValue> { N.ops() };
    let mut Res: SDValue = self.DAG.getNode(PATCHPOINT, dl, VTList, ArrayRef<SDValue> { Ops });
    let mut From: [2]SDValue = [SDValue { Node: N, ResNo: 1 }, SDValue { Node: N, ResNo: 2 }];
    let mut To: [2]SDValue = [Res.getValue(1), Res.getValue(2)];
    self.DAG.ReplaceAllUsesOfValuesWith(From, To, 2);
    return Res.getValue(0);
}

fn DAGTypeLegalizer::PromoteIntRes_READ_REGISTER(self, N: *mut SDNode) -> SDValue {
    let mut Fn: *Function = self.DAG.getMachineFunction().getFunction();
    Fn.getContext().diagnose(DiagnosticInfoLegalizationFailure { "cannot use llvm.read_register with illegal type", Fn, DiagnosticLocation { N.getDebugLoc() }, DS_Error });
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, N.getOperand(0));
    return self.DAG.getPOISON(NVT);
}

fn DAGTypeLegalizer::PromoteIntOp_EXTRACT_VECTOR_ELT(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut V0: SDValue = self.GetPromotedInteger(N.getOperand(0));
    let mut V1: SDValue = self.DAG.getZExtOrTrunc(N.getOperand(1), dl, EVT { self.TLI.getVectorIdxTy(self.DAG.getDataLayout()) });
    let mut Ext: SDValue = self.DAG.getNode(EXTRACT_VECTOR_ELT, dl, operator(V0).getValueType(0).getScalarType(), V0, V1);
    return self.DAG.getAnyExtOrTrunc(Ext, dl, N.getValueType(0));
}

fn DAGTypeLegalizer::PromoteIntOp_INSERT_SUBVECTOR(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut V0: SDValue = N.getOperand(0);
    let mut V1: SDValue = self.GetPromotedInteger(N.getOperand(1));
    let mut Idx: SDValue = N.getOperand(2);
    let mut PromVT: EVT = getVectorVT(*self.DAG.getContext(), V1.getValueType().getVectorElementType(), V0.getValueType().getVectorElementCount());
    V0 = self.DAG.getAnyExtOrTrunc(V0, dl, PromVT);
    let mut Ext: SDValue = self.DAG.getNode(INSERT_SUBVECTOR, dl, PromVT, V0, V1, Idx);
    return self.DAG.getAnyExtOrTrunc(Ext, dl, N.getValueType(0));
}

fn DAGTypeLegalizer::PromoteIntOp_FAKE_USE(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut V0: SDValue = N.getOperand(0);
    let mut V1: SDValue = N.getOperand(1);
    let mut InVT1: EVT = V1.getValueType();
    let mut VPromoted: SDValue = self.DAG.getNode(ANY_EXTEND, dl, self.TLI.getTypeToTransformTo(*self.DAG.getContext(), InVT1), V1);
    return self.DAG.getNode(N.getOpcode(), dl, N.getValueType(0), V0, VPromoted);
}

fn DAGTypeLegalizer::PromoteIntOp_EXTRACT_SUBVECTOR(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut V0: SDValue = self.GetPromotedInteger(N.getOperand(0));
    let mut InVT: MVT = V0.getValueType().getSimpleVT();
    let mut OutVT: MVT = getVectorVT(InVT.getVectorElementType(), N.getValueType(0).getVectorNumElements());
    let mut Ext: SDValue = self.DAG.getNode(EXTRACT_SUBVECTOR, dl, EVT { OutVT }, V0, N.getOperand(1));
    return self.DAG.getNode(TRUNCATE, dl, N.getValueType(0), Ext);
}

fn DAGTypeLegalizer::PromoteIntOp_CONCAT_VECTORS(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut ResVT: EVT = N.getValueType(0);
    let mut NumElems: u32 = N.getNumOperands();
    if ResVT.isScalableVector() {
        let mut ResVec: SDValue = self.DAG.getPOISON(ResVT);
        for let mut OpIdx: u32 = 0; OpIdx < NumElems; OpIdx += 1 {
            let mut Op: SDValue = N.getOperand(OpIdx);
            let mut OpNumElts: u32 = Op.getValueType().getVectorMinNumElements();
            ResVec = self.DAG.getNode(INSERT_SUBVECTOR, dl, ResVT, ResVec, Op, self.DAG.getIntPtrConstant(OpIdx * OpNumElts, dl, false));
        }
        return ResVec;
    }
    let mut RetSclrTy: EVT = N.getValueType(0).getVectorElementType();
    let mut NewOps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    NewOps.reserve(NumElems);
    for let mut VecIdx: u32 = 0; VecIdx != NumElems; VecIdx += 1 {
        let mut Incoming: SDValue = self.GetPromotedInteger(N.getOperand(VecIdx));
        let mut SclrTy: EVT = operator(Incoming).getValueType(0).getVectorElementType();
        let mut NumElem: u32 = operator(Incoming).getValueType(0).getVectorNumElements();
        for let mut i: u32 = 0; i < NumElem; i += 1 {
            let mut Ex: SDValue = self.DAG.getNode(EXTRACT_VECTOR_ELT, dl, SclrTy, Incoming, self.DAG.getVectorIdxConstant(i, dl, false));
            let mut Tr: SDValue = self.DAG.getNode(TRUNCATE, dl, RetSclrTy, Ex);
            NewOps.push(ValueParamT { Tr });
        }
    }
    return self.DAG.getBuildVector(N.getValueType(0), dl, ArrayRef<SDValue> { NewOps });
}

fn DAGTypeLegalizer::ExpandIntOp_STACKMAP(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo > 1);
    let mut Op: SDValue = N.getOperand(OpNo);
    let mut CN: *mut ConstantSDNode = dyn_cast(Op);
    if !CN {
        return SDValue {};
    }
    let mut NewOps: SmallVector<SDValue> = SmallVector<SDValue> {};
    for let mut I: u32 = 0; I < OpNo; I += 1 {
        NewOps.push(ValueParamT { N.getOperand(I) });
    }
    let mut Ty: EVT = Op.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    if CN.getConstantIntValue().getValue().getActiveBits() < 64 {
        NewOps.push(self.DAG.getTargetConstant(ConstantOp, DL, EVT { i64 }, false));
        NewOps.push(self.DAG.getTargetConstant(CN.getZExtValue(), DL, Ty, false));
    } else {
        return SDValue {};
    }
    for let mut I: u32 = OpNo + 1; I < N.getNumOperands(); I += 1 {
        NewOps.push(ValueParamT { N.getOperand(I) });
    }
    let mut NewNode: SDValue = self.DAG.getNode(N.getOpcode(), DL, N.getVTList(), ArrayRef<SDValue> { NewOps });
    for let mut ResNum: u32 = 0; ResNum < N.getNumValues(); ResNum += 1 {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: ResNum }, NewNode.getValue(ResNum));
    }
    return SDValue {};
}

fn DAGTypeLegalizer::ExpandIntOp_PATCHPOINT(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo >= 7);
    let mut Op: SDValue = N.getOperand(OpNo);
    let mut CN: *mut ConstantSDNode = dyn_cast(Op);
    if !CN {
        return SDValue {};
    }
    let mut NewOps: SmallVector<SDValue> = SmallVector<SDValue> {};
    for let mut I: u32 = 0; I < OpNo; I += 1 {
        NewOps.push(ValueParamT { N.getOperand(I) });
    }
    let mut Ty: EVT = Op.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    if CN.getConstantIntValue().getValue().getActiveBits() < 64 {
        NewOps.push(self.DAG.getTargetConstant(ConstantOp, DL, EVT { i64 }, false));
        NewOps.push(self.DAG.getTargetConstant(CN.getZExtValue(), DL, Ty, false));
    } else {
        return SDValue {};
    }
    for let mut I: u32 = OpNo + 1; I < N.getNumOperands(); I += 1 {
        NewOps.push(ValueParamT { N.getOperand(I) });
    }
    let mut NewNode: SDValue = self.DAG.getNode(N.getOpcode(), DL, N.getVTList(), ArrayRef<SDValue> { NewOps });
    for let mut ResNum: u32 = 0; ResNum < N.getNumValues(); ResNum += 1 {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: ResNum }, NewNode.getValue(ResNum));
    }
    return SDValue {};
}
