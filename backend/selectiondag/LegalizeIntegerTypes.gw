fn DAGTypeLegalizer::PromoteIntRes_CONVERT_TO_ARBITRARY_FP(self, N: *mut SDNode) -> SDValue {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut dl: SDLoc = SDLoc { N };
    return self.DAG.getNode(CONVERT_TO_ARBITRARY_FP, dl, NVT, N.getOperand(0), N.getOperand(1), N.getOperand(2), N.getOperand(3));
}

fn DAGTypeLegalizer::PromoteIntRes_STRICT_FP_TO_FP16_BF16(self, N: *mut SDNode) -> SDValue {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut dl: SDLoc = SDLoc { N };
    let mut Res: SDValue = self.DAG.getNode(N.getOpcode(), dl, self.DAG.getVTList(NVT, EVT { Other }), N.getOperand(0), N.getOperand(1));
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
    return Res;
}

fn DAGTypeLegalizer::PromoteIntRes_XRINT(self, N: *mut SDNode) -> SDValue {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut dl: SDLoc = SDLoc { N };
    return self.DAG.getNode(N.getOpcode(), dl, NVT, N.getOperand(0));
}

fn DAGTypeLegalizer::PromoteIntRes_GET_ROUNDING(self, N: *mut SDNode) -> SDValue {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut dl: SDLoc = SDLoc { N };
    let mut Res: SDValue = self.DAG.getNode(N.getOpcode(), dl, ArrayRef<EVT> { [NVT, EVT { Other }] }, ArrayRef<SDValue> { N.getOperand(0) });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
    return Res;
}

fn DAGTypeLegalizer::PromoteIntRes_INT_EXTEND(self, N: *mut SDNode) -> SDValue {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut dl: SDLoc = SDLoc { N };
    if self.getTypeAction(N.getOperand(0).getValueType()) == TypePromoteInteger {
        let mut Res: SDValue = self.GetPromotedInteger(N.getOperand(0));
        assert!(Res.getValueType().bitsLE(NVT), "Extension doesn't make sense!");
        if NVT == Res.getValueType() && N.getNumOperands() == 1 {
            if N.getOpcode() == SIGN_EXTEND {
                return self.DAG.getNode(SIGN_EXTEND_INREG, dl, NVT, Res, self.DAG.getValueType(N.getOperand(0).getValueType()));
            }
            if N.getOpcode() == ZERO_EXTEND {
                return self.DAG.getZeroExtendInReg(Res, dl, N.getOperand(0).getValueType());
            }
            assert!(N.getOpcode() == ANY_EXTEND, "Unknown integer extension!");
            return Res;
        }
    }
    return self.DAG.getNode(N.getOpcode(), dl, NVT, N.getOperand(0));
}

fn DAGTypeLegalizer::PromoteIntRes_LOAD(self, N: *mut LoadSDNode) -> SDValue {
    assert!(isUNINDEXEDLoad(N), "Indexed load during type legalization!");
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut ExtType: LoadExtType = if isNON_EXTLoad(N) { EXTLOAD } else { N.getExtensionType() };
    let mut dl: SDLoc = SDLoc { N };
    let mut Res: SDValue = self.DAG.getExtLoad(ExtType, dl, NVT, N.getChain(), N.getBasePtr(), N.getMemoryVT(), N.getMemOperand());
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
    return Res;
}

fn DAGTypeLegalizer::PromoteIntRes_VP_LOAD(self, N: *mut VPLoadSDNode) -> SDValue {
    assert!(!N.isIndexed(), "Indexed vp_load during type legalization!");
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut ExtType: LoadExtType = if (N.getExtensionType() == NON_EXTLOAD) { EXTLOAD } else { N.getExtensionType() };
    let mut dl: SDLoc = SDLoc { N };
    let mut Res: SDValue = self.DAG.getExtLoadVP(ExtType, dl, NVT, N.getChain(), N.getBasePtr(), N.getMask(), N.getVectorLength(), N.getMemoryVT(), N.getMemOperand(), N.isExpandingLoad());
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
    return Res;
}

fn DAGTypeLegalizer::PromoteIntRes_MLOAD(self, N: *mut MaskedLoadSDNode) -> SDValue {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut ExtPassThru: SDValue = self.GetPromotedInteger(N.getPassThru());
    let mut ExtType: LoadExtType = N.getExtensionType();
    if ExtType == NON_EXTLOAD {
        ExtType = EXTLOAD;
    }
    let mut dl: SDLoc = SDLoc { N };
    let mut Res: SDValue = self.DAG.getMaskedLoad(NVT, dl, N.getChain(), N.getBasePtr(), N.getOffset(), N.getMask(), ExtPassThru, N.getMemoryVT(), N.getMemOperand(), N.getAddressingMode(), ExtType, N.isExpandingLoad());
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
    return Res;
}

fn DAGTypeLegalizer::PromoteIntRes_MGATHER(self, N: *mut MaskedGatherSDNode) -> SDValue {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut ExtPassThru: SDValue = self.GetPromotedInteger(N.getPassThru());
    assert!(NVT == ExtPassThru.getValueType(), "Gather result type and the passThru argument type should be the same");
    let mut ExtType: LoadExtType = N.getExtensionType();
    if ExtType == NON_EXTLOAD {
        ExtType = EXTLOAD;
    }
    let mut dl: SDLoc = SDLoc { N };
    let mut Ops: [6]SDValue = [N.getChain(), ExtPassThru, N.getMask(), N.getBasePtr(), N.getIndex(), N.getScale()];
    let mut Res: SDValue = self.DAG.getMaskedGather(self.DAG.getVTList(NVT, EVT { Other }), N.getMemoryVT(), dl, ArrayRef<SDValue> { Ops }, N.getMemOperand(), N.getIndexType(), ExtType);
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
    return Res;
}

fn DAGTypeLegalizer::PromoteIntRes_VECTOR_COMPRESS(self, N: *mut SDNode) -> SDValue {
    let mut Vec: SDValue = self.GetPromotedInteger(N.getOperand(0));
    let mut Passthru: SDValue = self.GetPromotedInteger(N.getOperand(2));
    return self.DAG.getNode(VECTOR_COMPRESS, SDLoc { N }, Vec.getValueType(), Vec, N.getOperand(1), Passthru);
}

fn DAGTypeLegalizer::PromoteIntRes_Overflow(self, N: *mut SDNode) -> SDValue {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(1));
    let mut VT: EVT = N.getValueType(0);
    let mut SVT: EVT = self.getSetCCResultType(VT);
    let mut Ops: [3]SDValue = [3]SDValue {};
    let mut NumOps: u32 = N.getNumOperands();
    assert!(NumOps <= 3, "Too many operands");
    if NumOps == 3 {
        Ops[2] = self.PromoteTargetBoolean(N.getOperand(2), VT);
    }
    let mut dl: SDLoc = SDLoc { N };
    let mut Res: SDValue = self.DAG.getNode(N.getOpcode(), dl, self.DAG.getVTList(VT, SVT), SDValue> { Ops, NumOps });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Res);
    return self.DAG.getBoolExtOrTrunc(Res.getValue(1), dl, NVT, VT);
}

fn DAGTypeLegalizer::PromoteIntRes_ADDSUBSHLSAT(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut Op1: SDValue = N.getOperand(0);
    let mut Op2: SDValue = N.getOperand(1);
    let mut Opcode: u32 = N.getOpcode();
    let mut OldBits: u32 = Op1.getScalarValueSizeInBits();
    if Opcode == USUBSAT {
        self.SExtOrZExtPromotedOperands(Op1, Op2);
        return self.DAG.getNode(USUBSAT, dl, Op1.getValueType(), Op1, Op2);
    }
    if Opcode == UADDSAT {
        let mut OVT: EVT = Op1.getValueType();
        let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OVT);
        if self.TLI.isSExtCheaperThanZExt(OVT, NVT) {
            Op1 = self.SExtPromotedInteger(Op1);
            Op2 = self.SExtPromotedInteger(Op2);
            return self.DAG.getNode(UADDSAT, dl, NVT, Op1, Op2);
        }
        Op1 = self.ZExtPromotedInteger(Op1);
        Op2 = self.ZExtPromotedInteger(Op2);
        let mut NewBits: u32 = NVT.getScalarSizeInBits();
        let mut MaxVal: APInt = getLowBitsSet(NewBits, OldBits);
        let mut SatMax: SDValue = self.DAG.getConstant(MaxVal, dl, NVT, false, false);
        let mut Add: SDValue = self.DAG.getNode(ADD, dl, NVT, Op1, Op2);
        return self.DAG.getNode(UMIN, dl, NVT, Add, SatMax);
    }
    let mut IsShift: bool = Opcode == USHLSAT || Opcode == SSHLSAT;
    if IsShift {
        Op1 = self.GetPromotedInteger(Op1);
        if self.getTypeAction(Op2.getValueType()) == TypePromoteInteger {
            Op2 = self.ZExtPromotedInteger(Op2);
        }
    } else {
        Op1 = self.SExtPromotedInteger(Op1);
        Op2 = self.SExtPromotedInteger(Op2);
    }
    let mut PromotedType: EVT = Op1.getValueType();
    let mut NewBits: u32 = PromotedType.getScalarSizeInBits();
    if IsShift || self.TLI.isOperationLegal(Opcode, PromotedType) {
        let mut ShiftOp: u32 = 0;
        match Opcode {
            SADDSAT => {
                SSUBSAT;
            },
            USHLSAT => {
                ShiftOp = SRL;
            },
            _ => {
                llvm_unreachable_internal("Expected opcode to be signed or unsigned saturation addition, subtraction or left shift", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeIntegerTypes.cpp", 1140);
            },
        }
        let mut SHLAmount: u32 = NewBits - OldBits;
        let mut ShiftAmount: SDValue = self.DAG.getShiftAmountConstant(SHLAmount, PromotedType, dl);
        Op1 = self.DAG.getNode(SHL, dl, PromotedType, Op1, ShiftAmount);
        if !IsShift {
            Op2 = self.DAG.getNode(SHL, dl, PromotedType, Op2, ShiftAmount);
        }
        let mut Result: SDValue = self.DAG.getNode(Opcode, dl, PromotedType, Op1, Op2);
        return self.DAG.getNode(ShiftOp, dl, PromotedType, Result, ShiftAmount);
    }
    let mut AddOp: u32 = if Opcode == SADDSAT { ADD } else { SUB };
    let mut MinVal: APInt = getSignedMinValue(OldBits).sext(NewBits);
    let mut MaxVal: APInt = getSignedMaxValue(OldBits).sext(NewBits);
    let mut SatMin: SDValue = self.DAG.getConstant(MinVal, dl, PromotedType, false, false);
    let mut SatMax: SDValue = self.DAG.getConstant(MaxVal, dl, PromotedType, false, false);
    let mut Result: SDValue = self.DAG.getNode(AddOp, dl, PromotedType, Op1, Op2);
    Result = self.DAG.getNode(SMIN, dl, PromotedType, Result, SatMax);
    Result = self.DAG.getNode(SMAX, dl, PromotedType, Result, SatMin);
    return Result;
}

fn DAGTypeLegalizer::PromoteIntRes_MULFIX(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut Op1Promoted: SDValue = SDValue {};
    let mut Op2Promoted: SDValue = SDValue {};
    let mut Signed: bool = N.getOpcode() == SMULFIX || N.getOpcode() == SMULFIXSAT;
    let mut Saturating: bool = N.getOpcode() == SMULFIXSAT || N.getOpcode() == UMULFIXSAT;
    if Signed {
        Op1Promoted = self.SExtPromotedInteger(N.getOperand(0));
        Op2Promoted = self.SExtPromotedInteger(N.getOperand(1));
    } else {
        Op1Promoted = self.ZExtPromotedInteger(N.getOperand(0));
        Op2Promoted = self.ZExtPromotedInteger(N.getOperand(1));
    }
    let mut OldType: EVT = N.getOperand(0).getValueType();
    let mut PromotedType: EVT = Op1Promoted.getValueType();
    let mut DiffSize: u32 = PromotedType.getScalarSizeInBits() - OldType.getScalarSizeInBits();
    if Saturating {
        Op1Promoted = self.DAG.getNode(SHL, dl, PromotedType, Op1Promoted, self.DAG.getShiftAmountConstant(DiffSize, PromotedType, dl));
        let mut Result: SDValue = self.DAG.getNode(N.getOpcode(), dl, PromotedType, Op1Promoted, Op2Promoted, N.getOperand(2));
        let mut ShiftOp: u32 = if Signed { SRA } else { SRL };
        return self.DAG.getNode(ShiftOp, dl, PromotedType, Result, self.DAG.getShiftAmountConstant(DiffSize, PromotedType, dl));
    }
    return self.DAG.getNode(N.getOpcode(), dl, PromotedType, Op1Promoted, Op2Promoted, N.getOperand(2));
}

fn SaturateWidenedDIVFIX(V: SDValue, dl: *mut SDLoc, SatW: u32, Signed: bool, TLI: *TargetLowering, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = V.getValueType();
    let mut VTW: u32 = VT.getScalarSizeInBits();
    if !Signed {
        return DAG.getNode(UMIN, dl, VT, V, DAG.getConstant(getLowBitsSet(VTW, SatW), dl, VT, false, false));
    }
    V = DAG.getNode(SMIN, dl, VT, V, DAG.getConstant(getLowBitsSet(VTW, SatW - 1), dl, VT, false, false));
    V = DAG.getNode(SMAX, dl, VT, V, DAG.getConstant(getHighBitsSet(VTW, VTW - SatW + 1), dl, VT, false, false));
    return V;
}

fn earlyExpandDIVFIX(N: *mut SDNode, LHS: SDValue, RHS: SDValue, Scale: u32, TLI: *TargetLowering, DAG: *mut SelectionDAG, SatW: u32) -> SDValue {
    let mut VT: EVT = LHS.getValueType();
    let mut VTSize: u32 = VT.getScalarSizeInBits();
    let mut Signed: bool = N.getOpcode() == SDIVFIX || N.getOpcode() == SDIVFIXSAT;
    let mut Saturating: bool = N.getOpcode() == SDIVFIXSAT || N.getOpcode() == UDIVFIXSAT;
    let mut dl: SDLoc = SDLoc { N };
    let mut WideVT: EVT = VT.changeElementType(*DAG.getContext(), getIntegerVT(*DAG.getContext(), VTSize * 2));
    LHS = DAG.getExtOrTrunc(Signed, LHS, dl, WideVT);
    RHS = DAG.getExtOrTrunc(Signed, RHS, dl, WideVT);
    let mut Res: SDValue = TLI.expandFixedPointDiv(N.getOpcode(), dl, LHS, RHS, Scale, DAG);
    assert!(Res, "Expanding DIVFIX with wide type failed?");
    if Saturating {
        assert!(SatW <= VTSize, "Tried to saturate to more than the original type?");
        Res = SaturateWidenedDIVFIX(Res, dl, if SatW == 0 { VTSize } else { SatW }, Signed, TLI, DAG);
    }
    return DAG.getZExtOrTrunc(Res, dl, VT);
}

fn DAGTypeLegalizer::PromoteIntRes_DIVFIX(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut Op1Promoted: SDValue = SDValue {};
    let mut Op2Promoted: SDValue = SDValue {};
    let mut Signed: bool = N.getOpcode() == SDIVFIX || N.getOpcode() == SDIVFIXSAT;
    let mut Saturating: bool = N.getOpcode() == SDIVFIXSAT || N.getOpcode() == UDIVFIXSAT;
    if Signed {
        Op1Promoted = self.SExtPromotedInteger(N.getOperand(0));
        Op2Promoted = self.SExtPromotedInteger(N.getOperand(1));
    } else {
        Op1Promoted = self.ZExtPromotedInteger(N.getOperand(0));
        Op2Promoted = self.ZExtPromotedInteger(N.getOperand(1));
    }
    let mut PromotedType: EVT = Op1Promoted.getValueType();
    let mut Scale: u32 = N.getConstantOperandVal(2);
    if self.TLI.isTypeLegal(PromotedType) {
        let mut Action: LegalizeAction = self.TLI.getFixedPointOperationAction(N.getOpcode(), PromotedType, Scale);
        if Action == Legal || Action == Custom {
            let mut Diff: u32 = PromotedType.getScalarSizeInBits() - N.getValueType(0).getScalarSizeInBits();
            if Saturating {
                Op1Promoted = self.DAG.getNode(SHL, dl, PromotedType, Op1Promoted, self.DAG.getShiftAmountConstant(Diff, PromotedType, dl));
            }
            let mut Res: SDValue = self.DAG.getNode(N.getOpcode(), dl, PromotedType, Op1Promoted, Op2Promoted, N.getOperand(2));
            if Saturating {
                Res = self.DAG.getNode(if Signed { SRA } else { SRL }, dl, PromotedType, Res, self.DAG.getShiftAmountConstant(Diff, PromotedType, dl));
            }
            return Res;
        }
    }
    if self.TLI.expandFixedPointDiv(N.getOpcode(), dl, Op1Promoted, Op2Promoted, Scale, self.DAG) {
        Res;
    } else {
        if Saturating {
            Res = SaturateWidenedDIVFIX(Res, dl, N.getValueType(0).getScalarSizeInBits(), Signed, self.TLI, self.DAG);
        }
        return Res;
    }
    return earlyExpandDIVFIX(N, Op1Promoted, Op2Promoted, Scale, self.TLI, self.DAG, N.getValueType(0).getScalarSizeInBits());
}

fn DAGTypeLegalizer::PromoteIntRes_SADDSUBO(self, N: *mut SDNode, ResNo: u32) -> SDValue {
    if ResNo == 1 {
        return self.PromoteIntRes_Overflow(N);
    }
    let mut LHS: SDValue = self.SExtPromotedInteger(N.getOperand(0));
    let mut RHS: SDValue = self.SExtPromotedInteger(N.getOperand(1));
    let mut OVT: EVT = N.getOperand(0).getValueType();
    let mut NVT: EVT = LHS.getValueType();
    let mut dl: SDLoc = SDLoc { N };
    let mut Opcode: u32 = if N.getOpcode() == SADDO { ADD } else { SUB };
    let mut Res: SDValue = self.DAG.getNode(Opcode, dl, NVT, LHS, RHS);
    let mut Ofl: SDValue = self.DAG.getNode(SIGN_EXTEND_INREG, dl, NVT, Res, self.DAG.getValueType(OVT));
    Ofl = self.DAG.getSetCC(dl, N.getValueType(1), Ofl, Res, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Ofl);
    return Res;
}

fn DAGTypeLegalizer::PromoteIntRes_CMP(self, N: *mut SDNode) -> SDValue {
    let mut PromotedResultTy: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, PromotedResultTy, N.getOperand(0), N.getOperand(1));
}

fn DAGTypeLegalizer::PromoteIntRes_Select(self, N: *mut SDNode) -> SDValue {
    let mut Mask: SDValue = N.getOperand(0);
    let mut LHS: SDValue = self.GetPromotedInteger(N.getOperand(1));
    let mut RHS: SDValue = self.GetPromotedInteger(N.getOperand(2));
    let mut Opcode: u32 = N.getOpcode();
    if Opcode == VP_MERGE {
        return self.DAG.getNode(Opcode, SDLoc { N }, LHS.getValueType(), Mask, LHS, RHS, N.getOperand(3));
    }
    return self.DAG.getNode(Opcode, SDLoc { N }, LHS.getValueType(), Mask, LHS, RHS);
}

fn DAGTypeLegalizer::PromoteIntRes_SELECT_CC(self, N: *mut SDNode) -> SDValue {
    let mut LHS: SDValue = self.GetPromotedInteger(N.getOperand(2));
    let mut RHS: SDValue = self.GetPromotedInteger(N.getOperand(3));
    return self.DAG.getNode(SELECT_CC, SDLoc { N }, LHS.getValueType(), N.getOperand(0), N.getOperand(1), LHS, RHS, N.getOperand(4));
}

fn DAGTypeLegalizer::PromoteIntRes_SETCC(self, N: *mut SDNode) -> SDValue {
    let mut OpNo: u32 = if N.isStrictFPOpcode() { 1 } else { 0 };
    let mut InVT: EVT = N.getOperand(OpNo).getValueType();
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut SVT: EVT = self.getSetCCResultType(InVT);
    if self.getTypeAction(SVT) == TypePromoteInteger {
        if self.getTypeAction(InVT) == TypePromoteInteger {
            InVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), InVT);
            SVT = self.getSetCCResultType(InVT);
        } else {
            SVT = NVT;
        }
    }
    let mut dl: SDLoc = SDLoc { N };
    assert!(SVT.isVector() == N.getOperand(OpNo).getValueType().isVector(), "Vector compare must return a vector result!");
    let mut SetCC: SDValue = SDValue {};
    if N.isStrictFPOpcode() {
        let mut VTs: SDVTList = self.DAG.getVTList(ArrayRef<EVT> { [SVT, EVT { Other }] });
        let mut Opers: [4]SDValue = [N.getOperand(0), N.getOperand(1), N.getOperand(2), N.getOperand(3)];
        SetCC = self.DAG.getNode(N.getOpcode(), dl, VTs, ArrayRef<SDValue> { Opers }, N.getFlags());
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, SetCC.getValue(1));
    } else {
        SetCC = self.DAG.getNode(N.getOpcode(), dl, SVT, N.getOperand(0), N.getOperand(1), N.getOperand(2), N.getFlags());
    }
    return self.DAG.getSExtOrTrunc(SetCC, dl, NVT);
}

fn DAGTypeLegalizer::PromoteIntRes_IS_FPCLASS(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Arg: SDValue = N.getOperand(0);
    let mut Test: SDValue = N.getOperand(1);
    let mut NResVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    return self.DAG.getNode(IS_FPCLASS, DL, NResVT, Arg, Test);
}

fn DAGTypeLegalizer::PromoteIntRes_FFREXP(self, N: *mut SDNode) -> SDValue {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(1));
    let mut VT: EVT = N.getValueType(0);
    let mut dl: SDLoc = SDLoc { N };
    let mut Res: SDValue = self.DAG.getNode(N.getOpcode(), dl, self.DAG.getVTList(VT, NVT), N.getOperand(0));
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Res);
    return Res.getValue(1);
}

fn DAGTypeLegalizer::PromoteIntRes_SHL(self, N: *mut SDNode) -> SDValue {
    let mut LHS: SDValue = self.GetPromotedInteger(N.getOperand(0));
    let mut RHS: SDValue = N.getOperand(1);
    if self.getTypeAction(RHS.getValueType()) == TypePromoteInteger {
        RHS = self.ZExtPromotedInteger(RHS);
    }
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, LHS.getValueType(), LHS, RHS);
}

fn DAGTypeLegalizer::PromoteIntRes_SIGN_EXTEND_INREG(self, N: *mut SDNode) -> SDValue {
    let mut Op: SDValue = self.GetPromotedInteger(N.getOperand(0));
    return self.DAG.getNode(SIGN_EXTEND_INREG, SDLoc { N }, Op.getValueType(), Op, N.getOperand(1));
}

fn DAGTypeLegalizer::PromoteIntRes_SimpleIntBinOp(self, N: *mut SDNode) -> SDValue {
    let mut LHS: SDValue = self.GetPromotedInteger(N.getOperand(0));
    let mut RHS: SDValue = self.GetPromotedInteger(N.getOperand(1));
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, LHS.getValueType(), LHS, RHS);
}

fn DAGTypeLegalizer::PromoteIntRes_SExtIntBinOp(self, N: *mut SDNode) -> SDValue {
    let mut LHS: SDValue = self.SExtPromotedInteger(N.getOperand(0));
    let mut RHS: SDValue = self.SExtPromotedInteger(N.getOperand(1));
    if N.getNumOperands() == 2 {
        return self.DAG.getNode(N.getOpcode(), SDLoc { N }, LHS.getValueType(), LHS, RHS);
    }
    assert!(N.getNumOperands() == 4, "Unexpected number of operands!");
    assert!((N.getOpcode() == VP_SDIV || N.getOpcode() == VP_SREM), "Expected VP opcode");
    let mut Mask: SDValue = N.getOperand(2);
    let mut EVL: SDValue = N.getOperand(3);
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, LHS.getValueType(), LHS, RHS, Mask, EVL);
}

fn DAGTypeLegalizer::PromoteIntRes_ZExtIntBinOp(self, N: *mut SDNode) -> SDValue {
    let mut LHS: SDValue = self.ZExtPromotedInteger(N.getOperand(0));
    let mut RHS: SDValue = self.ZExtPromotedInteger(N.getOperand(1));
    if N.getNumOperands() == 2 {
        return self.DAG.getNode(N.getOpcode(), SDLoc { N }, LHS.getValueType(), LHS, RHS);
    }
    assert!(N.getNumOperands() == 4, "Unexpected number of operands!");
    assert!((N.getOpcode() == VP_UDIV || N.getOpcode() == VP_UREM), "Expected VP opcode");
    let mut Mask: SDValue = N.getOperand(2);
    let mut EVL: SDValue = N.getOperand(3);
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, LHS.getValueType(), LHS, RHS, Mask, EVL);
}

fn DAGTypeLegalizer::PromoteIntRes_ZExtMaskedIntBinOp(self, N: *mut SDNode) -> SDValue {
    let mut LHS: SDValue = self.ZExtPromotedInteger(N.getOperand(0));
    let mut RHS: SDValue = self.ZExtPromotedInteger(N.getOperand(1));
    let mut Mask: SDValue = N.getOperand(2);
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, LHS.getValueType(), LHS, RHS, Mask);
}

fn DAGTypeLegalizer::PromoteIntRes_SExtMaskedIntBinOp(self, N: *mut SDNode) -> SDValue {
    let mut LHS: SDValue = self.SExtPromotedInteger(N.getOperand(0));
    let mut RHS: SDValue = self.SExtPromotedInteger(N.getOperand(1));
    let mut Mask: SDValue = N.getOperand(2);
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, LHS.getValueType(), LHS, RHS, Mask);
