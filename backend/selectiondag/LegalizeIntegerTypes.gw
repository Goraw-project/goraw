fn DAGTypeLegalizer::PromoteIntegerResult(self, N: *mut SDNode, ResNo: u32) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalize-types", 1) {
            dbgs() << "Promote integer result: ";
            N.dump(&mut self.DAG);
        }
    }
        if !(false) { break; }
    }
    let mut Res: SDValue = SDValue {};
    if self.CustomLowerNode(N, N.getValueType(ResNo), true) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("legalize-types", 1) {
                dbgs() << "Node has been custom expanded, done\n";
            }
        }
            if !(false) { break; }
        }
        return;
    }
    match N.getOpcode() {
        _ => {
            dbgs() << "PromoteIntegerResult #" << ResNo << ": ";
        },
        MERGE_VALUES => {
            Res = self.PromoteIntRes_MERGE_VALUES(N, ResNo);
        },
        AssertSext => {
            Res = self.PromoteIntRes_AssertSext(N);
        },
        AssertZext => {
            Res = self.PromoteIntRes_AssertZext(N);
        },
        BITCAST => {
            Res = self.PromoteIntRes_BITCAST(N);
        },
        BITREVERSE => {
            Res = self.PromoteIntRes_BITREVERSE(N);
        },
        BSWAP => {
            Res = self.PromoteIntRes_BSWAP(N);
        },
        BUILD_PAIR => {
            Res = self.PromoteIntRes_BUILD_PAIR(N);
        },
        Constant => {
            Res = self.PromoteIntRes_Constant(N);
        },
        CTLZ_ZERO_POISON => {
            CTLZ;
        },
        CTLS => {
            Res = self.PromoteIntRes_CTLS(N);
        },
        PARITY => {
            CTPOP;
        },
        CTTZ_ZERO_POISON => {
            CTTZ;
        },
        CTTZ_ELTS_ZERO_POISON => {
            CTTZ_ELTS;
        },
        EXTRACT_VECTOR_ELT => {
            Res = self.PromoteIntRes_EXTRACT_VECTOR_ELT(N);
        },
        LOAD => {
            Res = self.PromoteIntRes_LOAD(cast(N));
        },
        VP_LOAD => {
            Res = self.PromoteIntRes_VP_LOAD(cast(N));
        },
        MLOAD => {
            Res = self.PromoteIntRes_MLOAD(cast(N));
        },
        MGATHER => {
            Res = self.PromoteIntRes_MGATHER(cast(N));
        },
        VECTOR_COMPRESS => {
            Res = self.PromoteIntRes_VECTOR_COMPRESS(N);
        },
        SELECT => {
            VSELECT;
        },
        SELECT_CC => {
            Res = self.PromoteIntRes_SELECT_CC(N);
        },
        STRICT_FSETCC => {
            STRICT_FSETCCS;
        },
        SMIN => {
            SMAX;
        },
        UMIN => {
            UMAX;
        },
        SHL => {
            Res = self.PromoteIntRes_SHL(N);
        },
        SIGN_EXTEND_INREG => {
            Res = self.PromoteIntRes_SIGN_EXTEND_INREG(N);
        },
        SRA => {
            Res = self.PromoteIntRes_SRA(N);
        },
        SRL => {
            Res = self.PromoteIntRes_SRL(N);
        },
        TRUNCATE => {
            Res = self.PromoteIntRes_TRUNCATE(N);
        },
        POISON => {
            UNDEF;
        },
        VAARG => {
            Res = self.PromoteIntRes_VAARG(N);
        },
        VSCALE => {
            Res = self.PromoteIntRes_VSCALE(N);
        },
        EXTRACT_SUBVECTOR => {
            Res = self.PromoteIntRes_EXTRACT_SUBVECTOR(N);
        },
        INSERT_SUBVECTOR => {
            Res = self.PromoteIntRes_INSERT_SUBVECTOR(N);
        },
        VECTOR_REVERSE => {
            Res = self.PromoteIntRes_VECTOR_REVERSE(N);
        },
        VECTOR_SHUFFLE => {
            Res = self.PromoteIntRes_VECTOR_SHUFFLE(N);
        },
        VECTOR_SPLICE_LEFT => {
            VECTOR_SPLICE_RIGHT;
        },
        VECTOR_REPEAT => {
            Res = self.PromoteIntRes_VECTOR_REPEAT(N);
        },
        VECTOR_INTERLEAVE => {
            VECTOR_DEINTERLEAVE;
        },
        INSERT_VECTOR_ELT => {
            Res = self.PromoteIntRes_INSERT_VECTOR_ELT(N);
        },
        BUILD_VECTOR => {
            Res = self.PromoteIntRes_BUILD_VECTOR(N);
        },
        SPLAT_VECTOR => {
            SCALAR_TO_VECTOR;
        },
        STEP_VECTOR => {
            Res = self.PromoteIntRes_STEP_VECTOR(N);
        },
        CONCAT_VECTORS => {
            Res = self.PromoteIntRes_CONCAT_VECTORS(N);
        },
        ANY_EXTEND_VECTOR_INREG => {
            SIGN_EXTEND_VECTOR_INREG;
        },
        VECTOR_FIND_LAST_ACTIVE => {
            Res = self.PromoteIntRes_VECTOR_FIND_LAST_ACTIVE(N);
        },
        GET_ACTIVE_LANE_MASK => {
            Res = self.PromoteIntRes_GET_ACTIVE_LANE_MASK(N);
        },
        VECTOR_MATCH => {
            Res = self.PromoteIntRes_VECTOR_MATCH(N);
        },
        PARTIAL_REDUCE_UMLA => {
            PARTIAL_REDUCE_SMLA;
        },
        SIGN_EXTEND => {
            ZERO_EXTEND;
        },
        STRICT_FP_TO_SINT => {
            STRICT_FP_TO_UINT;
        },
        FP_TO_SINT_SAT => {
            FP_TO_UINT_SAT;
        },
        FP_TO_BF16 => {
            FP_TO_FP16;
        },
        CONVERT_TO_ARBITRARY_FP => {
            Res = self.PromoteIntRes_CONVERT_TO_ARBITRARY_FP(N);
        },
        STRICT_FP_TO_BF16 => {
            STRICT_FP_TO_FP16;
        },
        GET_ROUNDING => {
            Res = self.PromoteIntRes_GET_ROUNDING(N);
        },
        AND => {
            OR;
        },
        ABDS => {
            AVGCEILS;
        },
        ABDU => {
            AVGCEILU;
        },
        MASKED_UDIV => {
            MASKED_UREM;
        },
        MASKED_SDIV => {
            MASKED_SREM;
        },
        SADDO => {
            SSUBO;
        },
        UADDO => {
            USUBO;
        },
        SMULO => {
            UMULO;
        },
        ADDE => {
            SUBE;
        },
        SADDO_CARRY => {
            SSUBO_CARRY;
        },
        SADDSAT => {
            UADDSAT;
        },
        SCMP => {
            UCMP;
        },
        SMULFIX => {
            SMULFIXSAT;
        },
        SDIVFIX => {
            SDIVFIXSAT;
        },
        ABS => {
            ABS_MIN_POISON;
        },
        ATOMIC_LOAD => {
            Res = self.PromoteIntRes_Atomic0(cast(N));
        },
        ATOMIC_LOAD_ADD => {
            ATOMIC_LOAD_SUB;
        },
        ATOMIC_CMP_SWAP => {
            ATOMIC_CMP_SWAP_WITH_SUCCESS;
        },
        VECREDUCE_ADD => {
            VECREDUCE_MUL;
        },
        VP_REDUCE_ADD => {
            VP_REDUCE_MUL;
        },
        LOOP_DEPENDENCE_WAR_MASK => {
            LOOP_DEPENDENCE_RAW_MASK;
        },
        FREEZE => {
            Res = self.PromoteIntRes_FREEZE(N);
        },
        ROTL => {
            ROTR;
        },
        FSHL => {
            FSHR;
        },
        CLMUL => {
            CLMULH;
        },
        PEXT => {
            Res = self.PromoteIntRes_PEXT(N);
        },
        PDEP => {
            Res = self.PromoteIntRes_PDEP(N);
        },
        MULHS => {
            MULHU;
        },
        IS_FPCLASS => {
            Res = self.PromoteIntRes_IS_FPCLASS(N);
        },
        FFREXP => {
            Res = self.PromoteIntRes_FFREXP(N);
        },
        LRINT => {
            LLRINT;
        },
        PATCHPOINT => {
            Res = self.PromoteIntRes_PATCHPOINT(N);
        },
        READ_REGISTER => {
            Res = self.PromoteIntRes_READ_REGISTER(N);
        },
    }
    if Res.getNode() {
        self.SetPromotedInteger(SDValue { Node: N, ResNo: ResNo }, Res);
    }
}

fn DAGTypeLegalizer::PromoteIntRes_MERGE_VALUES(self, N: *mut SDNode, ResNo: u32) -> SDValue {
    let mut Op: SDValue = self.DisintegrateMERGE_VALUES(N, ResNo);
    return self.GetPromotedInteger(Op);
}

fn DAGTypeLegalizer::PromoteIntRes_LOOP_DEPENDENCE_MASK(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut NewVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, NewVT, N.ops());
}

fn DAGTypeLegalizer::PromoteIntRes_AssertSext(self, N: *mut SDNode) -> SDValue {
    let mut Op: SDValue = self.SExtPromotedInteger(N.getOperand(0));
    return self.DAG.getNode(AssertSext, SDLoc { N }, Op.getValueType(), Op, N.getOperand(1));
}

fn DAGTypeLegalizer::PromoteIntRes_AssertZext(self, N: *mut SDNode) -> SDValue {
    let mut Op: SDValue = self.ZExtPromotedInteger(N.getOperand(0));
    return self.DAG.getNode(AssertZext, SDLoc { N }, Op.getValueType(), Op, N.getOperand(1));
}

fn DAGTypeLegalizer::PromoteIntRes_Atomic0(self, N: *mut AtomicSDNode) -> SDValue {
    let mut ResVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut ExtType: LoadExtType = N.getExtensionType();
    if ExtType == NON_EXTLOAD {
        match self.TLI.getExtendForAtomicOps() {
            SIGN_EXTEND => {
                ExtType = SEXTLOAD;
            },
            ZERO_EXTEND => {
                ExtType = ZEXTLOAD;
            },
            ANY_EXTEND => {
                ExtType = EXTLOAD;
            },
            _ => {
                llvm_unreachable_internal("Invalid atomic op extension", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeIntegerTypes.cpp", 424);
            },
        }
    }
    let mut Res: SDValue = self.DAG.getAtomicLoad(ExtType, SDLoc { N }, N.getMemoryVT(), ResVT, N.getChain(), N.getBasePtr(), N.getMemOperand());
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
    return Res;
}

fn DAGTypeLegalizer::PromoteIntRes_Atomic1(self, N: *mut AtomicSDNode) -> SDValue {
    let mut Op2: SDValue = N.getOperand(2);
    match self.TLI.getExtendForAtomicRMWArg(N.getOpcode()) {
        SIGN_EXTEND => {
            Op2 = self.SExtPromotedInteger(Op2);
        },
        ZERO_EXTEND => {
            Op2 = self.ZExtPromotedInteger(Op2);
        },
        ANY_EXTEND => {
            Op2 = self.GetPromotedInteger(Op2);
        },
        _ => {
            llvm_unreachable_internal("Invalid atomic op extension", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeIntegerTypes.cpp", 451);
        },
    }
    let mut Res: SDValue = self.DAG.getAtomic(N.getOpcode(), SDLoc { N }, N.getMemoryVT(), N.getChain(), N.getBasePtr(), Op2, N.getMemOperand());
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
    return Res;
}

fn DAGTypeLegalizer::PromoteIntRes_AtomicCmpSwap(self, N: *mut AtomicSDNode, ResNo: u32) -> SDValue {
    if ResNo == 1 {
        assert!(N.getOpcode() == ATOMIC_CMP_SWAP_WITH_SUCCESS);
        let mut SVT: EVT = self.getSetCCResultType(N.getOperand(2).getValueType());
        let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(1));
        if !self.TLI.isTypeLegal(SVT) {
            SVT = NVT;
        }
        let mut VTs: SDVTList = self.DAG.getVTList(N.getValueType(0), SVT, EVT { Other });
        let mut Res: SDValue = self.DAG.getAtomicCmpSwap(ATOMIC_CMP_SWAP_WITH_SUCCESS, SDLoc { N }, N.getMemoryVT(), VTs, N.getChain(), N.getBasePtr(), N.getOperand(2), N.getOperand(3), N.getMemOperand());
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Res.getValue(0));
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 2 }, Res.getValue(2));
        return self.DAG.getSExtOrTrunc(Res.getValue(1), SDLoc { N }, NVT);
    }
    let mut Op2: SDValue = N.getOperand(2);
    let mut Op3: SDValue = self.GetPromotedInteger(N.getOperand(3));
    match self.TLI.getExtendForAtomicCmpSwapArg() {
        SIGN_EXTEND => {
            Op2 = self.SExtPromotedInteger(Op2);
        },
        ZERO_EXTEND => {
            Op2 = self.ZExtPromotedInteger(Op2);
        },
        ANY_EXTEND => {
            Op2 = self.GetPromotedInteger(Op2);
        },
        _ => {
            llvm_unreachable_internal("Invalid atomic op extension", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeIntegerTypes.cpp", 500);
        },
    }
    let mut VTs: SDVTList = self.DAG.getVTList(Op2.getValueType(), N.getValueType(1), EVT { Other });
    let mut Res: SDValue = self.DAG.getAtomicCmpSwap(N.getOpcode(), SDLoc { N }, N.getMemoryVT(), VTs, N.getChain(), N.getBasePtr(), Op2, Op3, N.getMemOperand());
    for let mut i: u32 = 1;
let mut NumResults: u32 = N.getNumValues(); i < NumResults; i += 1 {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: i }, Res.getValue(i));
    }
    return Res;
}

fn DAGTypeLegalizer::PromoteIntRes_BITCAST(self, N: *mut SDNode) -> SDValue {
    let mut InOp: SDValue = N.getOperand(0);
    let mut InVT: EVT = InOp.getValueType();
    let mut NInVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), InVT);
    let mut OutVT: EVT = N.getValueType(0);
    let mut NOutVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OutVT);
    let mut dl: SDLoc = SDLoc { N };
    match self.getTypeAction(InVT) {
        TypeLegal => {
            break;
        },
        TypePromoteInteger => {
            if NOutVT.bitsEq(NInVT) && !NOutVT.isVector() && !NInVT.isVector() {
                return self.DAG.getNode(BITCAST, dl, NOutVT, self.GetPromotedInteger(InOp));
            }
        },
        TypeSoftenFloat => {
            return self.DAG.getNode(ANY_EXTEND, dl, NOutVT, self.GetSoftenedFloat(InOp));
        },
        TypeSoftPromoteHalf => {
            return self.DAG.getNode(ANY_EXTEND, dl, NOutVT, self.GetSoftPromotedHalf(InOp));
        },
        TypeExpandInteger => {
            TypeExpandFloat;
        },
        TypeScalarizeVector => {
            if !NOutVT.isVector() {
                return self.DAG.getNode(ANY_EXTEND, dl, NOutVT, self.BitConvertToInteger(self.GetScalarizedVector(InOp)));
            }
        },
        TypeScalarizeScalableVector => {
            report_fatal_error("Scalarization of scalable vectors is not supported.", true);
        },
        TypeSplitVector => {
            if !NOutVT.isVector() {
                let mut Lo: SDValue = SDValue {};
                let mut Hi: SDValue = SDValue {};
                self.GetSplitVector(N.getOperand(0), Lo, Hi);
                Lo = self.BitConvertToInteger(Lo);
                Hi = self.BitConvertToInteger(Hi);
                if self.DAG.getDataLayout().isBigEndian() {
                    swap(Lo, Hi);
                }
                InOp = self.DAG.getNode(ANY_EXTEND, dl, getIntegerVT(*self.DAG.getContext(), NOutVT.getSizeInBits().operator unsigned long long()), self.JoinIntegers(Lo, Hi));
                return self.DAG.getNode(BITCAST, dl, NOutVT, InOp);
            }
            break;
        },
        TypeWidenVector => {
            if NOutVT.bitsEq(NInVT) && !NOutVT.isVector() {
                let mut Res: SDValue = self.DAG.getNode(BITCAST, dl, NOutVT, self.GetWidenedVector(InOp));
                if self.DAG.getDataLayout().isBigEndian() {
                    let mut ShiftAmt: u32 = NInVT.getSizeInBits() - InVT.getSizeInBits().operator unsigned long long();
                    assert!(ShiftAmt < NOutVT.getSizeInBits().operator unsigned long long(), "Too large shift amount!");
                    Res = self.DAG.getNode(SRL, dl, NOutVT, Res, self.DAG.getShiftAmountConstant(ShiftAmt, NOutVT, dl));
                }
                return Res;
            }
        },
    }
    if !NOutVT.isVector() && InOp.getValueType().isVector() && self.DAG.getDataLayout().isLittleEndian() {
        let mut EltVT: EVT = InOp.getValueType().getVectorElementType();
        let mut EltSize: TypeSize = EltVT.getSizeInBits();
        let mut OutSize: TypeSize = NOutVT.getSizeInBits();
        if OutSize.hasKnownScalarFactor(EltSize) {
            let mut NumEltsWithPadding: u32 = OutSize.getKnownScalarFactor(EltSize);
            let mut WideVecVT: EVT = getVectorVT(*self.DAG.getContext(), EltVT, NumEltsWithPadding, false);
            if self.isTypeLegal(WideVecVT) {
                let mut Inserted: SDValue = self.DAG.getNode(INSERT_SUBVECTOR, dl, WideVecVT, self.DAG.getUNDEF(WideVecVT), InOp, self.DAG.getVectorIdxConstant(0, dl, false));
                return self.DAG.getNode(BITCAST, dl, NOutVT, Inserted);
            }
        }
    }
    return self.DAG.getNode(ANY_EXTEND, dl, NOutVT, self.CreateStackStoreLoad(InOp, OutVT));
}

fn DAGTypeLegalizer::PromoteIntRes_FREEZE(self, N: *mut SDNode) -> SDValue {
    let mut V: SDValue = self.GetPromotedInteger(N.getOperand(0));
    return self.DAG.getNode(FREEZE, SDLoc { N }, V.getValueType(), V);
}

fn DAGTypeLegalizer::PromoteIntRes_BSWAP(self, N: *mut SDNode) -> SDValue {
    let mut Op: SDValue = self.GetPromotedInteger(N.getOperand(0));
    let mut OVT: EVT = N.getValueType(0);
    let mut NVT: EVT = Op.getValueType();
    let mut dl: SDLoc = SDLoc { N };
    if !OVT.isVector() && !self.TLI.isOperationLegalOrCustomOrPromote(BSWAP, NVT, false) {
        if self.TLI.expandBSWAP(N, self.DAG) {
            Res;
        } else {
            return self.DAG.getNode(ANY_EXTEND, dl, NVT, Res);
        }
    }
    let mut DiffBits: u32 = NVT.getScalarSizeInBits() - OVT.getScalarSizeInBits();
    let mut ShAmt: SDValue = self.DAG.getShiftAmountConstant(DiffBits, NVT, dl);
    return self.DAG.getNode(SRL, dl, NVT, self.DAG.getNode(BSWAP, dl, NVT, Op), ShAmt);
}

fn DAGTypeLegalizer::PromoteIntRes_BITREVERSE(self, N: *mut SDNode) -> SDValue {
    let mut Op: SDValue = self.GetPromotedInteger(N.getOperand(0));
    let mut OVT: EVT = N.getValueType(0);
    let mut NVT: EVT = Op.getValueType();
    let mut dl: SDLoc = SDLoc { N };
    if !OVT.isVector() && OVT.isSimple() && !self.TLI.isOperationLegalOrCustomOrPromote(BITREVERSE, NVT, false) {
        if self.TLI.expandBITREVERSE(N, self.DAG) {
            Res;
        } else {
            return self.DAG.getNode(ANY_EXTEND, dl, NVT, Res);
        }
    }
    let mut DiffBits: u32 = NVT.getScalarSizeInBits() - OVT.getScalarSizeInBits();
    let mut ShAmt: SDValue = self.DAG.getShiftAmountConstant(DiffBits, NVT, dl);
    return self.DAG.getNode(SRL, dl, NVT, self.DAG.getNode(BITREVERSE, dl, NVT, Op), ShAmt);
}

fn DAGTypeLegalizer::PromoteIntRes_BUILD_PAIR(self, N: *mut SDNode) -> SDValue {
    return self.DAG.getNode(ANY_EXTEND, SDLoc { N }, self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0)), self.JoinIntegers(N.getOperand(0), N.getOperand(1)));
}

fn DAGTypeLegalizer::PromoteIntRes_Constant(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut dl: SDLoc = SDLoc { N };
    let mut Opc: u32 = if VT.isByteSized() { SIGN_EXTEND } else { ZERO_EXTEND };
    let mut Result: SDValue = self.DAG.getNode(Opc, dl, self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT), SDValue { Node: N, ResNo: 0 });
    assert!(isa(Result), "Didn't constant fold ext?");
    return Result;
}

fn DAGTypeLegalizer::PromoteIntRes_CTLZ(self, N: *mut SDNode) -> SDValue {
    let mut OVT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OVT);
    let mut dl: SDLoc = SDLoc { N };
    if !OVT.isVector() && self.TLI.isTypeLegal(NVT) && !self.TLI.isOperationLegalOrCustomOrPromote(CTLZ, NVT, false) && !self.TLI.isOperationLegalOrCustomOrPromote(CTLZ_ZERO_POISON, NVT, false) {
        if self.TLI.expandCTLZ(N, self.DAG) {
            Result;
        } else {
            Result = self.DAG.getNode(ANY_EXTEND, dl, NVT, Result);
            return Result;
        }
    }
    let mut CtlzOpcode: u32 = N.getOpcode();
    if CtlzOpcode == CTLZ {
        let mut ExtractLeadingBits: SDValue = self.DAG.getConstant(NVT.getScalarSizeInBits() - OVT.getScalarSizeInBits(), dl, NVT, false, false);
        let mut Op: SDValue = self.ZExtPromotedInteger(N.getOperand(0));
        return self.DAG.getNode(SUB, dl, NVT, self.DAG.getNode(N.getOpcode(), dl, NVT, Op), ExtractLeadingBits, SDNodeFlags { Flags: NoUnsignedWrap });
    }
    if CtlzOpcode == CTLZ_ZERO_POISON {
        let mut Op: SDValue = self.GetPromotedInteger(N.getOperand(0));
        let mut SHLAmount: u32 = NVT.getScalarSizeInBits() - OVT.getScalarSizeInBits();
        let mut ShiftConst: SDValue = self.DAG.getShiftAmountConstant(SHLAmount, Op.getValueType(), dl);
        Op = self.DAG.getNode(SHL, dl, NVT, Op, ShiftConst);
        return self.DAG.getNode(CtlzOpcode, dl, NVT, Op);
    }
    llvm_unreachable_internal("Invalid CTLZ Opcode", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeIntegerTypes.cpp", 747);
}

fn DAGTypeLegalizer::PromoteIntRes_CTLS(self, N: *mut SDNode) -> SDValue {
    let mut OVT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OVT);
    let mut dl: SDLoc = SDLoc { N };
    let mut ExtractLeadingBits: SDValue = self.DAG.getConstant(NVT.getScalarSizeInBits() - OVT.getScalarSizeInBits(), dl, NVT, false, false);
    let mut Op: SDValue = self.SExtPromotedInteger(N.getOperand(0));
    return self.DAG.getNode(SUB, dl, NVT, self.DAG.getNode(CTLS, dl, NVT, Op), ExtractLeadingBits);
}

fn DAGTypeLegalizer::PromoteIntRes_CTPOP_PARITY(self, N: *mut SDNode) -> SDValue {
    let mut OVT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OVT);
    if N.getOpcode() == CTPOP && !OVT.isVector() && self.TLI.isTypeLegal(NVT) && !self.TLI.isOperationLegalOrCustomOrPromote(CTPOP, NVT, false) {
        if self.TLI.expandCTPOP(N, self.DAG) {
            Result;
        } else {
            Result = self.DAG.getNode(ANY_EXTEND, SDLoc { N }, NVT, Result);
            return Result;
        }
    }
    let mut Op: SDValue = self.ZExtPromotedInteger(N.getOperand(0));
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, Op.getValueType(), Op);
}

fn DAGTypeLegalizer::PromoteIntRes_CTTZ(self, N: *mut SDNode) -> SDValue {
    let mut Op: SDValue = self.GetPromotedInteger(N.getOperand(0));
    let mut OVT: EVT = N.getValueType(0);
    let mut NVT: EVT = Op.getValueType();
    let mut dl: SDLoc = SDLoc { N };
    if !OVT.isVector() && self.TLI.isTypeLegal(NVT) && !self.TLI.isOperationLegalOrCustomOrPromote(CTTZ, NVT, false) && !self.TLI.isOperationLegalOrCustomOrPromote(CTTZ_ZERO_POISON, NVT, false) && !self.TLI.isOperationLegal(CTPOP, NVT) && !self.TLI.isOperationLegal(CTLZ, NVT) {
        if self.TLI.expandCTTZ(N, self.DAG) {
            Result;
        } else {
            Result = self.DAG.getNode(ANY_EXTEND, dl, NVT, Result);
            return Result;
        }
    }
    let mut NewOpc: u32 = N.getOpcode();
    if NewOpc == CTTZ {
        let mut TopBit: APInt = getOneBitSet(NVT.getScalarSizeInBits(), OVT.getScalarSizeInBits());
        Op = self.DAG.getNode(OR, dl, NVT, Op, self.DAG.getConstant(TopBit, dl, NVT, false, false));
        NewOpc = CTTZ_ZERO_POISON;
    }
    return self.DAG.getNode(NewOpc, dl, NVT, Op);
}

fn DAGTypeLegalizer::PromoteIntRes_VP_CttzElements(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut NewVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    return self.DAG.getNode(N.getOpcode(), DL, NewVT, N.ops());
}

fn DAGTypeLegalizer::PromoteIntRes_EXTRACT_VECTOR_ELT(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut Op0: SDValue = N.getOperand(0);
    let mut Op1: SDValue = N.getOperand(1);
    if self.TLI.getTypeAction(*self.DAG.getContext(), Op0.getValueType()) == TypePromoteInteger {
        let mut In: SDValue = self.GetPromotedInteger(Op0);
        let mut SVT: EVT = In.getValueType().getScalarType();
        if SVT.bitsGE(NVT) {
            let mut Ext: SDValue = self.DAG.getNode(EXTRACT_VECTOR_ELT, dl, SVT, In, Op1);
            return self.DAG.getAnyExtOrTrunc(Ext, dl, NVT);
        }
    }
    return self.DAG.getNode(EXTRACT_VECTOR_ELT, dl, NVT, Op0, Op1);
}

fn DAGTypeLegalizer::PromoteIntRes_FP_TO_XINT(self, N: *mut SDNode) -> SDValue {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut NewOpc: u32 = self.TLI.getPreferredFPToIntOpcode(N.getOpcode(), N.getValueType(0), NVT);
    let mut dl: SDLoc = SDLoc { N };
    let mut Res: SDValue = SDValue {};
    if N.isStrictFPOpcode() {
        Res = self.DAG.getNode(NewOpc, dl, ArrayRef<EVT> { [NVT, EVT { Other }] }, ArrayRef<SDValue> { [N.getOperand(0), N.getOperand(1)] });
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
    } else {
        Res = self.DAG.getNode(NewOpc, dl, NVT, N.getOperand(0));
    }
    return self.DAG.getNode(if (N.getOpcode() == FP_TO_UINT || N.getOpcode() == STRICT_FP_TO_UINT) { AssertZext } else { AssertSext }, dl, NVT, Res, self.DAG.getValueType(N.getValueType(0).getScalarType()));
}

fn DAGTypeLegalizer::PromoteIntRes_FP_TO_XINT_SAT(self, N: *mut SDNode) -> SDValue {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut dl: SDLoc = SDLoc { N };
    return self.DAG.getNode(N.getOpcode(), dl, NVT, N.getOperand(0), N.getOperand(1));
}

fn DAGTypeLegalizer::PromoteIntRes_FP_TO_FP16_BF16(self, N: *mut SDNode) -> SDValue {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
