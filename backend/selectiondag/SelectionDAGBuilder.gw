        if Small.Low == Small.High && Big.Low == Big.High && Small..MBB == Big..MBB {
            let mut SmallValue: *APInt = Small.Low.getValue();
            let mut BigValue: *APInt = Big.Low.getValue();
            let mut CommonBit: APInt = BigValue ^ SmallValue;
            if CommonBit.isPowerOf2() {
                let mut CondLHS: SDValue = self.getValue(Cond);
                let mut VT: EVT = CondLHS.getValueType();
                let mut DL: SDLoc = self.getCurSDLoc();
                let mut Or: SDValue = self.DAG.getNode(OR, DL, VT, CondLHS, self.DAG.getConstant(CommonBit, DL, VT, false, false));
                let mut Cond: SDValue = self.DAG.getSetCC(DL, EVT { i1 }, Or, self.DAG.getConstant(BigValue | SmallValue, DL, VT, false, false), SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
                self.addSuccessorWithProb(SwitchMBB, Small..MBB, Small.Prob + Big.Prob);
                if BPI {
                    self.addSuccessorWithProb(SwitchMBB, DefaultMBB, BPI.getEdgeProbability(SwitchMBB.getBasicBlock(), 0 as u32));
                } else {
                    self.addSuccessorWithProb(SwitchMBB, DefaultMBB, getUnknown());
                }
                let mut BrCond: SDValue = self.DAG.getNode(BRCOND, DL, EVT { Other }, self.getControlRoot(), Cond, self.DAG.getBasicBlock(Small..MBB));
                BrCond = self.DAG.getNode(BR, DL, EVT { Other }, BrCond, self.DAG.getBasicBlock(DefaultMBB));
                self.DAG.setRoot(BrCond);
                return;
            }
        }
    }
    if self.TM.getOptLevel() != None {
        sort(W.FirstCluster, W.LastCluster + 1, Closure_15 {});
        for let mut I: CaseClusterIt = CaseClusterIt { W.LastCluster }; I(W.FirstCluster);  {
            operator(I);
            if operator(I).Prob > operator(W.LastCluster).Prob {
                break;
            }
            if operator(I).Kind == CC_Range && operator(I)..MBB == NextMBB {
                swap(operator(I), operator(W.LastCluster));
                break;
            }
        }
    }
    let mut DefaultProb: BranchProbability = W.DefaultProb;
    let mut UnhandledProbs: BranchProbability = DefaultProb;
    for let mut I: CaseClusterIt = CaseClusterIt { W.FirstCluster }; I(W.LastCluster); operator(I) {
        operator(UnhandledProbs, operator(I).Prob);
    }
    let mut CurMBB: *mut MachineBasicBlock = W.MBB;
    for let mut I: CaseClusterIt = CaseClusterIt { W.FirstCluster };
let mut E: CaseClusterIt = CaseClusterIt { W.LastCluster }; I(E); operator(I) {
        let mut FallthroughUnreachable: bool = false;
        let mut Fallthrough: *mut MachineBasicBlock = null;
        if I == W.LastCluster {
            Fallthrough = DefaultMBB;
            FallthroughUnreachable = isa(DefaultMBB.getBasicBlock().getFirstNonPHIOrDbg(true));
        } else {
            Fallthrough = CurMF.CreateMachineBasicBlock(CurMBB.getBasicBlock(), optional<UniqueBBID> { nullopt });
            CurMF.insert(iterator { BBI }, Fallthrough);
            self.ExportFromCurrentBlock(Cond);
        }
        operator(UnhandledProbs, operator(I).Prob);
        match operator(I).Kind {
            CC_JumpTable => {
                let mut JTH: *mut JumpTableHeader = &mut operator(self.SL).JTCases[operator(I)..JTCasesIndex].first;
                let mut JT: *mut JumpTable = &mut operator(self.SL).JTCases[operator(I)..JTCasesIndex].second;
                let mut JumpMBB: *mut MachineBasicBlock = JT.MBB;
                CurMF.insert(iterator { BBI }, JumpMBB);
                let mut JumpProb: BranchProbability = operator(I).Prob;
                let mut FallthroughProb: BranchProbability = UnhandledProbs;
                for let mut SI: succ_iterator = JumpMBB.succ_begin();
let mut SE: succ_iterator = JumpMBB.succ_end(); SI != SE; SI += 1 {
                    if *SI == DefaultMBB {
                        operator(JumpProb, DefaultProb / 2);
                        operator(FallthroughProb, DefaultProb / 2);
                        JumpMBB.setSuccProbability(SI, DefaultProb / 2);
                        JumpMBB.normalizeSuccProbs();
                        break;
                    }
                }
                if FallthroughUnreachable {
                    let mut CurFunc: *mut Function = CurMF.getFunction();
                    if !CurFunc.hasFnAttribute("branch-target-enforcement") {
                        JTH.FallthroughUnreachable = true;
                    }
                }
                if !JTH.FallthroughUnreachable {
                    self.addSuccessorWithProb(CurMBB, Fallthrough, FallthroughProb);
                }
                self.addSuccessorWithProb(CurMBB, JumpMBB, JumpProb);
                CurMBB.normalizeSuccProbs();
                JTH.HeaderBB = CurMBB;
                JT.Default = Fallthrough;
                if CurMBB == SwitchMBB {
                    self.visitJumpTableHeader(*JT, *JTH, SwitchMBB);
                    JTH.Emitted = true;
                }
                break;
            },
            CC_BitTests => {
                let mut BTB: *mut BitTestBlock = &mut operator(self.SL).BitTestCases[operator(I)..BTCasesIndex];
                for BTC in BTB.Cases {
                    CurMF.insert(iterator { BBI }, BTC.ThisBB);
                }
                BTB.Parent = CurMBB;
                BTB.Default = Fallthrough;
                BTB.DefaultProb = UnhandledProbs;
                if !BTB.ContiguousRange {
                    operator(BTB.Prob, DefaultProb / 2);
                    operator(BTB.DefaultProb, DefaultProb / 2);
                }
                if FallthroughUnreachable {
                    BTB.FallthroughUnreachable = true;
                }
                if CurMBB == SwitchMBB {
                    self.visitBitTestHeader(*BTB, SwitchMBB);
                    BTB.Emitted = true;
                }
                break;
            },
            CC_Range => {
                let mut RHS: *Value = null;
                let mut LHS: *Value = null;
                let mut MHS: *Value = null;
                let mut CC: CondCode = zeroed();
                if operator(I).Low == operator(I).High {
                    CC = SETEQ;
                    LHS = Cond;
                    RHS = operator(I).Low;
                    MHS = null;
                } else {
                    CC = SETLE;
                    LHS = operator(I).Low;
                    MHS = Cond;
                    RHS = operator(I).High;
                }
                if FallthroughUnreachable {
                    CC = SETTRUE;
                }
                let mut CB: CaseBlock = CaseBlock { CmpLHS: CC, CmpMHS: LHS, CmpRHS: RHS, TrueBB: MHS, FalseBB: operator(I)..MBB, ThisBB: Fallthrough, DL: CurMBB, DbgLoc: self.getCurSDLoc(), TrueProb: operator(I).Prob, FalseProb: UnhandledProbs, IsUnpredictable: false };
                if CurMBB == SwitchMBB {
                    self.visitSwitchCase(CB, SwitchMBB);
                } else {
                    operator(self.SL).SwitchCases.push(CB);
                }
                break;
            },
        }
        CurMBB = Fallthrough;
    }
}

fn SelectionDAGBuilder::splitWorkItem(self, WorkList: *mut SwitchWorkList, W: *SwitchWorkListItem, Cond: *mut Value, SwitchMBB: *mut MachineBasicBlock) {
    assert!(operator(W.FirstCluster).Low.getValue().slt(operator(W.LastCluster).Low.getValue()), "Clusters not sorted?");
    assert!(W.LastCluster - W.FirstCluster + 1 >= 2, "Too small to split!");
    let mut PivotCluster: CaseClusterIt = CaseClusterIt { FirstRight };
    (((operator!(operator!((PivotCluster(W.FirstCluster))))) || (_wassert(L"PivotCluster > W.FirstCluster", L"llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", (12896) as u32) , 0)) as void);
    (((operator!(operator!((PivotCluster(W.LastCluster))))) || (_wassert(L"PivotCluster <= W.LastCluster", L"llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", (12897) as u32) , 0)) as void);
    let mut FirstLeft: CaseClusterIt = W.FirstCluster;
    let mut LastRight: CaseClusterIt = W.LastCluster;
    let mut Pivot: *ConstantInt = operator(PivotCluster).Low;
    let mut BBI: iterator = iterator { W.MBB };
    operator(BBI);
    let mut LeftMBB: *mut MachineBasicBlock = null;
    if FirstLeft == LastLeft && operator(FirstLeft).Kind == CC_Range && operator(FirstLeft).Low == W.GE && (operator(FirstLeft).High.getValue() + 1) == Pivot.getValue() {
        LeftMBB = operator(FirstLeft)..MBB;
    } else {
        LeftMBB = self.FuncInfo.MF.CreateMachineBasicBlock(W.MBB.getBasicBlock(), optional<UniqueBBID> { nullopt });
        self.FuncInfo.MF.insert(iterator { BBI }, LeftMBB);
        WorkList()(void { LeftMBB, FirstLeft, LastLeft, W.GE, Pivot, W.DefaultProb / 2 });
        self.ExportFromCurrentBlock(Cond);
    }
    let mut RightMBB: *mut MachineBasicBlock = null;
    if FirstRight == LastRight && operator(FirstRight).Kind == CC_Range && W.LT && (operator(FirstRight).High.getValue() + 1) == W.LT.getValue() {
        RightMBB = operator(FirstRight)..MBB;
    } else {
        RightMBB = self.FuncInfo.MF.CreateMachineBasicBlock(W.MBB.getBasicBlock(), optional<UniqueBBID> { nullopt });
        self.FuncInfo.MF.insert(iterator { BBI }, RightMBB);
        WorkList()(void { RightMBB, FirstRight, LastRight, Pivot, W.LT, W.DefaultProb / 2 });
        self.ExportFromCurrentBlock(Cond);
    }
    let mut CB: CaseBlock = CaseBlock { CmpLHS: SETLT, CmpMHS: Cond, CmpRHS: Pivot, TrueBB: null, FalseBB: LeftMBB, ThisBB: RightMBB, DL: W.MBB, DbgLoc: self.getCurSDLoc(), TrueProb: LeftProb, FalseProb: RightProb, IsUnpredictable: false };
    if W.MBB == SwitchMBB {
        self.visitSwitchCase(CB, SwitchMBB);
    } else {
        operator(self.SL).SwitchCases.push(CB);
    }
}

fn scaleCaseProbality(CaseProb: BranchProbability, PeeledCaseProb: BranchProbability) -> BranchProbability {
    if PeeledCaseProb == getOne() {
        return getZero();
    }
    let mut SwitchProb: BranchProbability = PeeledCaseProb.getCompl();
    let mut Numerator: u32 = CaseProb.getNumerator();
    let mut Denominator: u32 = SwitchProb.scale(CaseProb.getDenominator());
    return Numerator;
}

fn SelectionDAGBuilder::peelDominantCaseCluster(self, SI: *SwitchInst, Clusters: *mut CaseClusterVector, PeeledCaseProb: *mut BranchProbability) -> *mut MachineBasicBlock {
    let mut SwitchMBB: *mut MachineBasicBlock = self.FuncInfo.MBB;
    if SwitchPeelThreshold() > 100 || !self.FuncInfo.BPI || Clusters.len < 2 || self.TM.getOptLevel() == None || SwitchMBB.getParent().getFunction().hasMinSize() {
        return SwitchMBB;
    }
    let mut TopCaseProb: BranchProbability = ;
    let mut PeeledCaseIndex: u32 = 0;
    let mut SwitchPeeled: bool = false;
    for let mut Index: u32 = 0; Index < Clusters.len; Index += 1 {
        let mut CC: *mut CaseCluster = Clusters[Index];
        if CC.Prob < TopCaseProb {
            continue;
        }
        TopCaseProb = CC.Prob;
        PeeledCaseIndex = Index;
        SwitchPeeled = true;
    }
    if !SwitchPeeled {
        return SwitchMBB;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("isel", 1) {
            dbgs() << "Peeled one top case in switch stmt, prob: " << TopCaseProb << "\n";
        }
    }
        if !(false) { break; }
    }
    let mut BBI: iterator = iterator { SwitchMBB };
    operator(BBI);
    let mut PeeledSwitchMBB: *mut MachineBasicBlock = self.FuncInfo.MF.CreateMachineBasicBlock(SwitchMBB.getBasicBlock(), optional<UniqueBBID> { nullopt });
    self.FuncInfo.MF.insert(iterator { BBI }, PeeledSwitchMBB);
    self.ExportFromCurrentBlock(SI.getCondition());
    let mut PeeledCaseIt: CaseCluster>>> = Clusters.begin() + PeeledCaseIndex;
    let mut W: SwitchWorkListItem = SwitchWorkListItem { MBB: SwitchMBB, FirstCluster: CaseClusterIt { PeeledCaseIt }, LastCluster: CaseClusterIt { PeeledCaseIt }, GE: null, LT: null, DefaultProb: TopCaseProb.getCompl() };
    self.lowerWorkItem(W, SI.getCondition(), SwitchMBB, PeeledSwitchMBB);
    Clusters.erase(const_iterator { PeeledCaseIt });
    for CC in Clusters {
        while true {
            {
            if DebugFlag && isCurrentDebugType("isel", 1) {
                dbgs() << "Scale the probablity for one cluster, before scaling: " << CC.Prob << "\n";
            }
        }
            if !(false) { break; }
        }
        CC.Prob = scaleCaseProbality(CC.Prob, TopCaseProb);
        while true {
            {
            if DebugFlag && isCurrentDebugType("isel", 1) {
                dbgs() << "After scaling: " << CC.Prob << "\n";
            }
        }
            if !(false) { break; }
        }
    }
    PeeledCaseProb = TopCaseProb;
    return PeeledSwitchMBB;
}

fn SelectionDAGBuilder::visitSwitch(self, SI: *SwitchInst) {
    let mut BPI: *mut BranchProbabilityInfo = self.FuncInfo.BPI;
    let mut Clusters: CaseClusterVector = CaseClusterVector {};
    Clusters.reserve(SI.getNumCases());
    for I in SI.cases() {
        let mut Succ: *mut MachineBasicBlock = self.FuncInfo.getMBB(I.getCaseSuccessor());
        let mut CaseVal: *ConstantInt = I.getCaseValue();
        let mut Prob: BranchProbability = if BPI { BPI.getEdgeProbability(SI.getParent(), I.getSuccessorIndex()) } else { BranchProbability { 1, SI.getNumCases() + 1 } };
        Clusters.push(range(CaseVal, CaseVal, Succ, Prob));
    }
    let mut DefaultMBB: *mut MachineBasicBlock = self.FuncInfo.getMBB(SI.getDefaultDest());
    sortAndRangeify(Clusters);
    let mut PeeledCaseProb: BranchProbability = getZero();
    let mut PeeledSwitchMBB: *mut MachineBasicBlock = self.peelDominantCaseCluster(SI, Clusters, PeeledCaseProb);
    let mut SwitchMBB: *mut MachineBasicBlock = self.FuncInfo.MBB;
    if Clusters.len == 0 {
        assert!(PeeledSwitchMBB == SwitchMBB);
        SwitchMBB.addSuccessor(DefaultMBB, getUnknown());
        if DefaultMBB != self.NextBlock(SwitchMBB) {
            self.DAG.setRoot(self.DAG.getNode(BR, self.getCurSDLoc(), EVT { Other }, self.getControlRoot(), self.DAG.getBasicBlock(DefaultMBB)));
        }
        return;
    }
    operator(self.SL).findJumpTables;
    operator(self.SL).findBitTestClusters(Clusters, &mut SI);
    while true {
        {
        if DebugFlag && isCurrentDebugType("isel", 1) {
            {
                dbgs() << "Case clusters: ";
                for C in Clusters {
                    if C.Kind == CC_JumpTable {
                        dbgs() << "JT:";
                    }
                    if C.Kind == CC_BitTests {
                        dbgs() << "BT:";
                    }
                    C.Low.getValue().print(dbgs(), true);
                    if C.Low != C.High {
                        dbgs() << '-';
                        C.High.getValue().print(dbgs(), true);
                    }
                    dbgs() << ' ';
                }
                dbgs() << 10;
            }
        }
    }
        if !(false) { break; }
    }
    assert!(!Clusters.is_empty());
    let mut WorkList: SwitchWorkList = zeroed();
    let mut First: CaseClusterIt = Clusters.begin();
    let mut Last: CaseClusterIt = Clusters.end() - 1;
    let mut DefaultProb: BranchProbability = self.getEdgeProbability(PeeledSwitchMBB, DefaultMBB);
    if PeeledCaseProb != getZero() && DefaultMBB == self.FuncInfo.getMBB(SI.getDefaultDest()) {
        DefaultProb = scaleCaseProbality(DefaultProb, PeeledCaseProb);
    }
    WorkList()(void { PeeledSwitchMBB, First, Last, null, null, DefaultProb });
    while operator!() {
        let mut W: SwitchWorkListItem = ();
        let mut NumClusters: u32 = W.LastCluster - W.FirstCluster + 1;
        if NumClusters > 3 && self.TM.getOptLevel() != None && !DefaultMBB.getParent().getFunction().hasMinSize() {
            self.splitWorkItem(W, SI.getCondition(), SwitchMBB);
            continue;
        }
        self.lowerWorkItem(W, SI.getCondition(), SwitchMBB, DefaultMBB);
    }
}

fn SelectionDAGBuilder::visitStepVector(self, I: *CallInst) {
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut DL: SDLoc = self.getCurSDLoc();
    let mut ResultVT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
    self.setValue(&mut I, self.DAG.getStepVector(DL, ResultVT));
}

fn SelectionDAGBuilder::visitVectorReverse(self, I: *CallInst) {
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut VT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
    let mut DL: SDLoc = self.getCurSDLoc();
    let mut V: SDValue = self.getValue(I.getOperand(0));
    assert!(VT == V.getValueType(), "Malformed vector.reverse!");
    if VT.isScalableVector() {
        self.setValue(&mut I, self.DAG.getNode(VECTOR_REVERSE, DL, VT, V));
        return;
    }
    let mut Mask: SmallVector<int, 8> = zeroed();
    let mut NumElts: u32 = VT.getVectorMinNumElements();
    for let mut i: u32 = 0; i != NumElts; i += 1 {
        Mask()(NumElts - 1 - i);
    }
    self.setValue(&mut I, self.DAG.getVectorShuffle(VT, DL, V, self.DAG.getUNDEF(VT)));
}

fn SelectionDAGBuilder::visitVectorDeinterleave(self, I: *CallInst, Factor: u32) {
    let mut DL: SDLoc = self.getCurSDLoc();
    let mut InVec: SDValue = self.getValue(I.getOperand(0));
    let mut ValueVTs: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
    ComputeValueVTs(self.DAG.getTargetLoweringInfo(), self.DAG.getDataLayout(), I.getType(), ValueVTs, null, null, getZero());
    let mut OutVT: EVT = ValueVTs[0];
    let mut OutNumElts: u32 = OutVT.getVectorMinNumElements();
    let mut SubVecs: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { Factor };
    for let mut i: u32 = 0; i != Factor; i += 1 {
        assert!(ValueVTs[i] == OutVT, "Expected VTs to be the same");
        SubVecs[i] = self.DAG.getNode(EXTRACT_SUBVECTOR, DL, OutVT, InVec, self.DAG.getVectorIdxConstant(OutNumElts * i, DL, false));
    }
    if OutVT.isFixedLengthVector() && Factor == 2 {
        let mut Even: SDValue = self.DAG.getVectorShuffle;
        let mut Odd: SDValue = self.DAG.getVectorShuffle;
        let mut Res: SDValue = self.DAG.getMergeValues(ArrayRef<SDValue> { [Even, Odd] }, self.getCurSDLoc());
        self.setValue(&mut I, Res);
        return;
    }
    let mut Res: SDValue = self.DAG;
    self.setValue(&mut I, Res);
}

fn SelectionDAGBuilder::visitVectorInterleave(self, I: *CallInst, Factor: u32) {
    let mut DL: SDLoc = self.getCurSDLoc();
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut InVT: EVT = self.getValue(I.getOperand(0)).getValueType();
    let mut OutVT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
    let mut InVecs: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { Factor };
    for let mut i: u32 = 0; i < Factor; i += 1 {
        InVecs[i] = self.getValue(I.getOperand(i));
        assert!(InVecs[i].getValueType() == InVecs[0].getValueType(), "Expected VTs to be the same");
    }
    if OutVT.isFixedLengthVector() && Factor == 2 {
        let mut NumElts: u32 = InVT.getVectorMinNumElements();
        let mut V: SDValue = self.DAG;
        self.setValue(&mut I, self.DAG.getVectorShuffle);
        return;
    }
    let mut ValueVTs: SmallVector<EVT, 8> = zeroed();
    let mut Res: SDValue = self.DAG(VECTOR_INTERLEAVE, DL, self.DAG(), InVecs);
    let mut Results: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { Factor };
    for let mut i: u32 = 0; i < Factor; i += 1 {
        Results[i] = Res.getValue(i);
    }
    Res = self.DAG;
    self.setValue(&mut I, Res);
}

fn SelectionDAGBuilder::visitFreeze(self, I: *FreezeInst) {
    let mut ValueVTs: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
    ComputeValueVTs(self.DAG.getTargetLoweringInfo(), self.DAG.getDataLayout(), I.getType(), ValueVTs, null, null, getZero());
    let mut NumValues: u32 = ValueVTs.len;
    if NumValues == 0 {
        return;
    }
    let mut Values: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { NumValues };
    let mut Op: SDValue = self.getValue(I.getOperand(0));
    for let mut i: u32 = 0; i != NumValues; i += 1 {
        Values[i] = self.DAG.getNode(FREEZE, self.getCurSDLoc(), ValueVTs[i], SDValue { Node: Op.getNode(), ResNo: Op.getResNo() + i });
    }
    self.setValue(&mut I, self.DAG);
}

fn SelectionDAGBuilder::visitVectorSplice(self, I: *CallInst) {
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut VT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
    let mut DL: SDLoc = self.getCurSDLoc();
    let mut V1: SDValue = self.getValue(I.getOperand(0));
    let mut V2: SDValue = self.getValue(I.getOperand(1));
    let mut IsLeft: bool = I.getIntrinsicID() == vector_splice_left;
    if VT.isScalableVector() || !isa(I.getOperand(2)) {
        let mut Offset: SDValue = self.DAG.getZExtOrTrunc(self.getValue(I.getOperand(2)), DL, EVT { TLI.getVectorIdxTy(self.DAG.getDataLayout()) });
        self.setValue(&mut I, self.DAG.getNode(if IsLeft { VECTOR_SPLICE_LEFT } else { VECTOR_SPLICE_RIGHT }, DL, VT, V1, V2, Offset));
        return;
    }
    let mut Imm: u64 = cast(I.getOperand(2))();
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut Idx: u64 = if IsLeft { Imm } else { NumElts - Imm };
    let mut Mask: SmallVector<int, 8> = zeroed();
    for let mut i: u32 = 0; i < NumElts; i += 1 {
        Mask()(Idx + i);
    }
    self.setValue(&mut I, self.DAG.getVectorShuffle(VT, DL, V1, V2));
}

fn FollowCopyChain(MRI: *mut MachineRegisterInfo, Reg: Register) -> Register {
    let mut MI: *mut MachineInstr = operator(MRI.def_begin(Reg)).getParent();
    assert!(MI.getOpcode() == COPY, "start of copy chain MUST be COPY");
    Reg = MI.getOperand(1).getReg();
    assert!(Reg.isVirtual(), "expected COPY of virtual register");
    MI = operator(MRI.def_begin(Reg)).getParent();
    if MI.getOpcode() == COPY {
        assert!(Reg.isVirtual(), "expected COPY of virtual register");
        Reg = MI.getOperand(1).getReg();
        assert!(Reg.isPhysical(), "expected COPY of physical register");
    } else {
        assert!(MI.getOpcode() == INLINEASM_BR, "end of copy chain MUST be INLINEASM_BR");
    }
    return Reg;
}

fn SelectionDAGBuilder::visitCallBrLandingPad(self, I: *CallInst) {
    let mut ResultVTs: SmallVector<EVT, 8> = zeroed();
    let mut ResultValues: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut CBR: *auto = cast(I.getParent().getUniquePredecessor().getTerminator());
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut TRI: *TargetRegisterInfo = self.DAG.getSubtarget().getRegisterInfo();
    let mut MRI: *mut MachineRegisterInfo = self.DAG.getMachineFunction().getRegInfo();
    let mut InitialDef: Register = self.FuncInfo.ValueMap[];
    let mut Chain: SDValue = self.DAG.getRoot();
    let mut TargetConstraints: AsmOperandInfoVector = zeroed();
    let mut V: SDValue = self.DAG(MERGE_VALUES, self.getCurSDLoc(), self.DAG(), ResultValues);
    self.setValue(&mut I, V);
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, V: *mut Value) -> auto {}

struct Closure_2 {
    NodeInserted: *mut bool,
}

unsafe fn Closure_2::call(self: *mut Closure_2, arg: *mut SDNode) {
            (*self.NodeInserted) = true;
        }

struct Closure_3 {
    Variable: *mut *DILocalVariable,
    Expr: *mut *DIExpression,
    cap_2: *mut SelectionDAGBuilder,
}

unsafe fn Closure_3::call(self: *mut Closure_3, DDI: *mut DanglingDebugInfo) -> bool {
        let mut DanglingVariable: *mut DIVariable = DDI.getVariable();
        let mut DanglingExpr: *mut DIExpression = DDI.getExpression();
        if DanglingVariable == (*self.Variable) && (*self.Expr).fragmentsOverlap(DanglingExpr) {
            while true {
                {
                if DebugFlag && isCurrentDebugType("isel", 1) {
                    dbgs() << "Dropping dangling debug info for " << self.printDDI(null, DDI) << "\n";
                }
            }
                if !(false) { break; }
            }
            return true;
        }
        return false;
    }

struct Closure_4 {
    Expr: *mut *mut DIExpression,
    V: *mut *Value,
    cap_2: *mut SelectionDAGBuilder,
    Var: *mut *mut DILocalVariable,
    DL: *mut DebugLoc,
    SDOrder: *mut u32,
}

unsafe fn Closure_4::call(self: *mut Closure_4) -> auto {
        let mut GVExpr: *mut DIExpression = (*self.Expr);
        let mut GV: *GlobalValue = getGlobalAddressDbgOperand((*self.V), GVExpr, 0, self.DAG.getMachineFunction());
        if !GV {
