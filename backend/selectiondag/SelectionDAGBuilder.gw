fn handleDanglingVariadicDebugInfo(DAG: *mut SelectionDAG, Variable: *mut DILocalVariable, DL: DebugLoc, Order: u32, Values: *mut SmallVectorImpl<Value *>, Expression: *mut DIExpression) -> bool {
    let mut Locs: SmallVector<SDDbgOperand, 2> = SmallVector<SDDbgOperand, 2> {};
    let mut SDV: *mut SDDbgValue = DAG.getDbgValueList;
    DAG.AddDbgValue(SDV, false);
    return true;
}

fn SelectionDAGBuilder::addDanglingDebugInfo(self, Values: *mut SmallVectorImpl<Value *>, Var: *mut DILocalVariable, Expr: *mut DIExpression, IsVariadic: bool, DL: DebugLoc, Order: u32) {
    if IsVariadic {
        handleDanglingVariadicDebugInfo(self.DAG, Var, DL, Order, Values, Expr);
        return;
    }
    (((operator!(operator!((Values()() == 1)))) || (_wassert(L"Values.size() == 1", L"llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", (1471) as u32) , 0)) as void);
}

fn SelectionDAGBuilder::dropDanglingDebugInfo(self, Variable: *DILocalVariable, Expr: *DIExpression) {
    let mut isMatchingDbgValue: Closure_3 = Closure_3 { Variable: &mut Variable, Expr: &mut Expr, cap_2: self };
    for DDIMI in self.DanglingDebugInfoMap {
        let mut DDIV: *mut DanglingDebugInfoVector = DDIMI.second;
        erase_if(DDIV, isMatchingDbgValue);
    }
}

fn SelectionDAGBuilder::resolveDanglingDebugInfo(self, V: *Value, Val: SDValue) {
    let mut DanglingDbgInfoIt: iterator = self.DanglingDebugInfoMap.find(V);
    if DanglingDbgInfoIt == self.DanglingDebugInfoMap.end() {
        return;
    }
    let mut DDIV: *mut DanglingDebugInfoVector = DanglingDbgInfoIt.second;
    DDIV.clear();
}

fn getGlobalAddressDbgOperand(V: *Value, Expr: *mut *mut DIExpression, OpIdx: u32, MF: *MachineFunction) -> *GlobalValue {
    let mut C: *auto = dyn_cast(V);
    if operator!() {
        return null;
    }
    let mut Offset: i64 = 0;
    let mut GV: *GlobalValue = getDescribableGlobalAddress(Offset, MF);
    if GV && Offset {
        let mut Ops: SmallVector<uint64_t, 3> = zeroed();
        appendOffset(Offset);
        Expr = appendOpsToArg(Expr, OpIdx, false);
    }
    return GV;
}

fn SelectionDAGBuilder::salvageUnresolvedDbgValue(self, V: *Value, DDI: *mut DanglingDebugInfo) {
    let mut OrigV: *Value = V;
    let mut Var: *mut DILocalVariable = DDI.getVariable();
    let mut Expr: *mut DIExpression = DDI.getExpression();
    let mut DL: DebugLoc = DDI.getDebugLoc();
    let mut SDOrder: u32 = DDI.getSDNodeOrder();
    let mut StackValue: bool = true;
    let mut HandleGlobalAddress: Closure_4 = Closure_4 { Expr: &mut Expr, V: &mut V, cap_2: self, Var: &mut Var, DL: &mut DL, SDOrder: &mut SDOrder };
    if self.handleDebugValue(ArrayRef<const Value *> { V }, Var, Expr, DL, SDOrder, false) || HandleGlobalAddress.call() {
        return;
    }
    while isa(V) {
        let mut VAsInst: *Instruction = operator*(cast(V));
        let mut Ops: SmallVector<uint64_t, 16> = zeroed();
        let mut AdditionalValues: SmallVector<Value *, 4> = zeroed();
        V = salvageDebugInfoImpl(VAsInst, Expr.getNumLocationOperands());
        if !V {
            break;
        }
        if operator!() {
            break;
        }
        Expr = appendOpsToArg(Expr, 0, StackValue);
        if self.handleDebugValue(ArrayRef<const Value *> { V }, Var, Expr, DL, SDOrder, false) || HandleGlobalAddress.call() {
            while true {
                {
                if DebugFlag && isCurrentDebugType("isel", 1) {
                    dbgs() << "Salvaged debug location info for:\n  " << *Var << "\n" << *OrigV << "\nBy stripping back to:\n  " << *V << "\n";
                }
            }
                if !(false) { break; }
            }
            return;
        }
    }
    assert!(OrigV, "V shouldn't be null");
    let mut Poison: *mut PoisonValue = get(OrigV.getType());
    let mut SDV: *mut SDDbgValue = self.DAG.getConstantDbgValue(Var, Expr, Poison, DL, self.SDNodeOrder);
    self.DAG.AddDbgValue(SDV, false);
    while true {
        {
        if DebugFlag && isCurrentDebugType("isel", 1) {
            dbgs() << "Dropping debug value info for:\n  " << self.printDDI(OrigV, DDI) << "\n";
        }
    }
        if !(false) { break; }
    }
}

fn SelectionDAGBuilder::handleKillDebugValue(self, Var: *mut DILocalVariable, Expr: *mut DIExpression, DbgLoc: DebugLoc, Order: u32) {
    let mut Poison: *mut Value = get(getInt1Ty(*self.Context));
    let mut NewExpr: *mut DIExpression = convertToUndefExpression(Expr);
    self.handleDebugValue(ArrayRef<const Value *> { Poison }, Var, NewExpr, DbgLoc, Order, false);
}

fn SelectionDAGBuilder::handleDebugValue(self, Values: ArrayRef<const Value *>, Var: *mut DILocalVariable, Expr: *mut DIExpression, DbgLoc: DebugLoc, Order: u32, IsVariadic: bool) -> bool {
    if Values.len == 0 {
        return true;
    }
    if self.visitEntryValueDbgValue(ArrayRef<const Value *> { Values }, Var, Expr, DbgLoc) {
        return true;
    }
    let mut LocationOps: i32 = 0;
    let mut Dependencies: i32 = 0;
    (((operator!(operator!((operator!())))) || (_wassert(L"!LocationOps.empty()", L"llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", (1813) as u32) , 0)) as void);
    let mut SDV: *mut SDDbgValue = self.DAG.getDbgValueList(Var, Expr, false, DbgLoc, Order, IsVariadic);
    self.DAG.AddDbgValue(SDV, false);
    return true;
}

fn SelectionDAGBuilder::resolveOrClearDbgInfo(self) {
    self.clearDanglingDebugInfo();
}

fn SelectionDAGBuilder::getCopyFromRegs(self, V: *Value, Ty: *mut Type) -> SDValue {
    let mut It: iterator = self.FuncInfo.ValueMap.find(V);
    let mut Result: SDValue = SDValue {};
    if It != self.FuncInfo.ValueMap.end() {
        let mut InReg: Register = operator(It).second;
        let mut RFV: RegsForValue = RegsForValue { *self.DAG.getContext(), self.DAG.getTargetLoweringInfo(), self.DAG.getDataLayout(), InReg, Ty, ID> { nullopt } };
        let mut Chain: SDValue = self.DAG.getEntryNode();
        Result = RFV.getCopyFromRegs(self.DAG, self.FuncInfo, self.getCurSDLoc(), Chain, null, V);
        self.resolveDanglingDebugInfo(V, Result);
    }
    return Result;
}

fn SelectionDAGBuilder::getValue(self, V: *Value) -> SDValue {
    let mut N: *mut SDValue = self.NodeMap[V];
    if N.getNode() {
        return N;
    }
    if self.getCopyFromRegs(V, V.getType()) {
        copyFromReg;
    } else {
        return copyFromReg;
    }
    let mut Val: SDValue = self.getValueImpl(V);
    self.NodeMap[V] = Val;
    self.resolveDanglingDebugInfo(V, Val);
    return Val;
}

fn SelectionDAGBuilder::setValueToPoison(self, V: *Value, dl: *SDLoc) {
    if V.getType().isVoidTy() {
        return;
    }
    let mut ValueVTs: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
    ComputeValueVTs(self.DAG.getTargetLoweringInfo(), self.DAG.getDataLayout(), V.getType(), ValueVTs, null, null, getZero());
    if ValueVTs.len == 0 {
        return;
    }
    self.setValue(V, self.DAG.getErrorMergeValues);
}

fn SelectionDAGBuilder::getNonRegisterValue(self, V: *Value) -> SDValue {
    let mut N: *mut SDValue = self.NodeMap[V];
    if N.getNode() {
        if isIntOrFPConstant(N) {
            operator(N).setDebugLoc(DebugLoc { Loc: null });
        }
        return N;
    }
    let mut Val: SDValue = self.getValueImpl(V);
    self.NodeMap[V] = Val;
    self.resolveDanglingDebugInfo(V, Val);
    return Val;
}

fn SelectionDAGBuilder::getValueImpl(self, V: *Value) -> SDValue {
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    if dyn_cast(V) {
        C;
    } else {
        let mut VT: EVT = TLI.getValueType(self.DAG.getDataLayout(), V.getType(), true);
        if dyn_cast(C) {
            CI;
        } else {
            let mut DL: SDLoc = self.getCurSDLoc();
            if VT.isScalableVector() {
                return self.DAG.getNode(SPLAT_VECTOR, DL, VT, self.DAG.getConstant(CI.getValue(), DL, VT.getVectorElementType(), false, false));
            }
            if VT.isFixedLengthVector() {
                return self.DAG.getSplatBuildVector(VT, DL, self.DAG.getConstant(CI.getValue(), DL, VT.getVectorElementType(), false, false));
            }
            return self.DAG.getConstant(*CI, DL, VT, false, false);
        }
        if dyn_cast(C) {
            CB;
        } else {
            return self.DAG.getConstant(CB.getValue(), self.getCurSDLoc(), VT, false, false);
        }
        if dyn_cast(C) {
            GV;
        } else {
            return self.DAG.getGlobalAddress(GV, self.getCurSDLoc(), VT, 0, false, 0);
        }
        if dyn_cast(C) {
            CPA;
        } else {
            return self.DAG.getNode(PtrAuthGlobalAddress, self.getCurSDLoc(), VT, self.getValue(CPA.getPointer()), self.getValue(CPA.getKey()), self.getValue(CPA.getAddrDiscriminator()), self.getValue(CPA.getDiscriminator()));
        }
        if isa(C) {
            return self.DAG.getConstant(0, self.getCurSDLoc(), VT, false, false);
        }
        if match(C) {
            return self.DAG.getVScale(self.getCurSDLoc(), VT, APInt { VT.getSizeInBits().operator unsigned long long(), 1, false, false });
        }
        if dyn_cast(C) {
            CFP;
        } else {
            return self.DAG.getConstantFP(*CFP, self.getCurSDLoc(), VT, false);
        }
        if isa(C) && !V.getType().isAggregateType() {
            return if isa(C) { self.DAG.getPOISON(VT) } else { self.DAG.getUNDEF(VT) };
        }
        if dyn_cast(C) {
            CE;
        } else {
            self.visit(CE.getOpcode(), *CE);
            let mut N1: SDValue = self.NodeMap[V];
            assert!(N1.getNode(), "visit didn't populate the NodeMap!");
            return N1;
        }
        if isa(C) || isa(C) {
            let mut Constants: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
            return self.DAG.getMergeValues;
        }
        if dyn_cast(C) {
            CDS;
        } else {
            let mut Ops: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
            for let mut i: u64 = 0;
let mut e: u64 = CDS.getNumElements(); i != e; i += 1 {
                let mut Val: *mut SDNode = self.getValue(CDS.getElementAsConstant(i)).getNode();
                for let mut i: u32 = 0;
let mut e: u32 = Val.getNumValues(); i != e; i += 1 {
                    Ops.push(SDValue { Node: Val, ResNo: i });
                }
            }
            if isa(CDS.getType()) {
                return self.DAG.getMergeValues;
            }
            return self.DAG;
        }
        if C.getType().isStructTy() || C.getType().isArrayTy() {
            assert!((isa(C) || isa(C)), "Unknown struct or array constant!");
            let mut ValueVTs: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
            ComputeValueVTs(TLI, self.DAG.getDataLayout(), C.getType(), ValueVTs, null, null, getZero());
            let mut NumElts: u32 = ValueVTs.len;
            if NumElts == 0 {
                return SDValue {};
            }
            let mut Constants: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { NumElts };
            for let mut i: u32 = 0; i != NumElts; i += 1 {
                let mut EltVT: EVT = ValueVTs[i];
                if isa(C) {
                    Constants[i] = self.DAG.getUNDEF(EltVT);
                } else if EltVT.isFloatingPoint() {
                    Constants[i] = self.DAG.getConstantFP(0, self.getCurSDLoc(), EltVT, false);
                } else {
                    Constants[i] = self.DAG.getConstant(0, self.getCurSDLoc(), EltVT, false, false);
                }
            }
            return self.DAG.getMergeValues;
        }
        if dyn_cast(C) {
            BA;
        } else {
            return self.DAG.getBlockAddress(BA, VT, 0, false, 0);
        }
        if  {
            return self.getValue();
        }
        if  {
            return self.getValue();
        }
        if VT == EVT { aarch64svcount } {
            assert!(C.isNullValue(), "Can only zero this target type!");
            return self.DAG.getNode(BITCAST, self.getCurSDLoc(), VT, self.DAG.getConstant(0, self.getCurSDLoc(), EVT { nxv16i1 }, false, false));
        }
        if VT.isRISCVVectorTuple() {
            assert!(C.isNullValue(), "Can only zero this target type!");
            return self.DAG.getNode(BITCAST, self.getCurSDLoc(), VT, self.DAG.getNode(SPLAT_VECTOR, self.getCurSDLoc(), getVectorVT(*self.DAG.getContext(), EVT { i8 }, VT.getSizeInBits().getKnownMinValue() / 8, true), self.DAG.getConstant(0, self.getCurSDLoc(), EVT { getIntegerVT(8) }, false, false)));
        }
        if VT == EVT { externref } || VT == EVT { funcref } {
            assert!(C.isNullValue(), "Can only zero this target type!");
            let mut IID: ID = zeroed();
            return self.DAG.getNode(INTRINSIC_WO_CHAIN, self.getCurSDLoc(), VT, self.DAG.getTargetConstant(IID, self.getCurSDLoc(), EVT { i32 }, false));
        }
        let mut VecTy: *mut VectorType = cast(V.getType());
        if dyn_cast(C) {
            CV;
        } else {
            let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
            let mut NumElements: u32 = cast(VecTy)();
            for let mut i: u32 = 0; i != NumElements; i += 1 {
                Ops.push(self.getValue(CV.getOperand(i)));
            }
            return self.DAG;
        }
        if isa(C) {
            let mut EltVT: EVT = TLI.getValueType(self.DAG.getDataLayout(), VecTy.getElementType(), false);
            let mut Op: SDValue = SDValue {};
            if EltVT.isFloatingPoint() {
                Op = self.DAG.getConstantFP(0, self.getCurSDLoc(), EltVT, false);
            } else {
                Op = self.DAG.getConstant(0, self.getCurSDLoc(), EltVT, false, false);
            }
            return self.DAG.getSplat(VT, self.getCurSDLoc(), Op);
        }
        llvm_unreachable_internal("Unknown vector constant", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", 2082);
    }
    if dyn_cast(V) {
        AI;
    } else {
        let mut SI: auto = self.FuncInfo.StaticAllocaMap.find;
        if SI() != self.FuncInfo.StaticAllocaMap.end {
            return self.DAG.getFrameIndex(TLI.getValueType(self.DAG.getDataLayout(), AI.getType(), false));
        }
    }
    if dyn_cast(V) {
        Inst;
    } else {
        let mut InReg: Register = self.FuncInfo.InitializeRegForValue(Inst);
        let mut RFV: RegsForValue = RegsForValue { *self.DAG.getContext(), TLI, self.DAG.getDataLayout(), InReg, Inst.getType(), ID> { nullopt } };
        let mut Chain: SDValue = self.DAG.getEntryNode();
        return RFV.getCopyFromRegs(self.DAG, self.FuncInfo, self.getCurSDLoc(), Chain, null, V);
    }
    if dyn_cast(V) {
        MD;
    } else {
        return self.DAG.getMDNode(cast(MD.getMetadata()));
    }
    if  {
        return self.DAG.getBasicBlock(self.FuncInfo.getMBB());
    }
    llvm_unreachable_internal("Can't get register for value!", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", 2109);
}

fn SelectionDAGBuilder::visitCatchPad(self, I: *CatchPadInst) {
    let mut Pers: EHPersonality = classifyEHPersonality(self.FuncInfo.Fn.getPersonalityFn());
    let mut IsMSVCCXX: bool = Pers == MSVC_CXX;
    let mut IsCoreCLR: bool = Pers == CoreCLR;
    let mut IsSEH: bool = isAsynchronousEHPersonality(Pers);
    let mut CatchPadMBB: *mut MachineBasicBlock = self.FuncInfo.MBB;
    if IsSEH {
        CatchPadMBB.setIsEHContTarget(true);
        self.DAG.getMachineFunction().setHasEHContTarget(true);
    } else {
        CatchPadMBB.setIsEHScopeEntry(true);
    }
    if IsMSVCCXX || IsCoreCLR {
        CatchPadMBB.setIsEHFuncletEntry(true);
    }
}

fn SelectionDAGBuilder::visitCatchRet(self, I: *CatchReturnInst) {
    let mut TargetMBB: *mut MachineBasicBlock = self.FuncInfo.getMBB(I.getSuccessor());
    self.FuncInfo.MBB.addSuccessor(TargetMBB, getUnknown());
    let mut Pers: EHPersonality = classifyEHPersonality(self.FuncInfo.Fn.getPersonalityFn());
    let mut IsSEH: bool = isAsynchronousEHPersonality(Pers);
    if IsSEH {
        if TargetMBB != self.NextBlock(self.FuncInfo.MBB) || self.TM.getOptLevel() == None {
            self.DAG.setRoot(self.DAG.getNode(BR, self.getCurSDLoc(), EVT { Other }, self.getControlRoot(), self.DAG.getBasicBlock(TargetMBB)));
        }
        return;
    }
    TargetMBB.setIsEHContTarget(true);
    self.DAG.getMachineFunction().setHasEHContTarget(true);
    let mut ParentPad: *mut Value = I.getCatchSwitchParentPad();
    let mut SuccessorColor: *BasicBlock = null;
    if isa(ParentPad) {
        SuccessorColor = &mut self.FuncInfo.Fn.getEntryBlock();
    } else {
        SuccessorColor = cast(ParentPad)();
    }
    assert!(SuccessorColor, "No parent funclet for catchret!");
    let mut SuccessorColorMBB: *mut MachineBasicBlock = self.FuncInfo.getMBB(SuccessorColor);
    assert!(SuccessorColorMBB, "No MBB for SuccessorColor!");
    let mut Ret: SDValue = self.DAG.getNode(CATCHRET, self.getCurSDLoc(), EVT { Other }, self.getControlRoot(), self.DAG.getBasicBlock(TargetMBB), self.DAG.getBasicBlock(SuccessorColorMBB));
    self.DAG.setRoot(Ret);
}

fn SelectionDAGBuilder::visitCleanupPad(self, CPI: *CleanupPadInst) {
    self.FuncInfo.MBB.setIsEHScopeEntry(true);
    let mut Pers: EHPersonality = classifyEHPersonality(self.FuncInfo.Fn.getPersonalityFn());
    if Pers != Wasm_CXX && Pers != Wasm_D {
        self.FuncInfo.MBB.setIsEHFuncletEntry(true);
        self.FuncInfo.MBB.setIsCleanupFuncletEntry(true);
    }
}

fn findUnwindDestinations(FuncInfo: *mut FunctionLoweringInfo, EHPadBB: *BasicBlock, Prob: BranchProbability, UnwindDests: *mut pair<MachineBasicBlock *, BranchProbability>>) {
    let mut Personality: EHPersonality = classifyEHPersonality(FuncInfo.Fn.getPersonalityFn());
    let mut IsMSVCCXX: bool = Personality == MSVC_CXX;
    let mut IsCoreCLR: bool = Personality == CoreCLR;
    let mut IsWasmCXX: bool = Personality == Wasm_CXX;
    let mut IsWasmD: bool = Personality == Wasm_D;
    let mut IsSEH: bool = isAsynchronousEHPersonality(Personality);
    while EHPadBB {
        let mut Pad: const_iterator = EHPadBB.getFirstNonPHIIt();
        let mut NewEHPadBB: *mut BasicBlock = null;
        if isa(Pad) {
            UnwindDests()(FuncInfo.getMBB(EHPadBB), Prob);
            break;
        } else if isa(Pad) {
            UnwindDests()(FuncInfo.getMBB(EHPadBB), Prob);
            UnwindDests()()();
            if !IsWasmCXX && !IsWasmD {
                UnwindDests()()();
            }
            break;
        } else if  {
            NewEHPadBB = ();
        } else {
            continue;
        }
        let mut BPI: *mut BranchProbabilityInfo = FuncInfo.BPI;
        if BPI && NewEHPadBB {
            operator(Prob, BPI.getEdgeProbability(EHPadBB, NewEHPadBB));
        }
        EHPadBB = NewEHPadBB;
    }
}

fn SelectionDAGBuilder::visitCleanupRet(self, I: *CleanupReturnInst) {
    let mut UnwindDests: pair<MachineBasicBlock *, BranchProbability>, 1> = zeroed();
    let mut UnwindDest: *mut BasicBlock = I.getUnwindDest();
    let mut BPI: *mut BranchProbabilityInfo = self.FuncInfo.BPI;
    let mut UnwindDestProb: BranchProbability = if (BPI && UnwindDest) { BPI.getEdgeProbability(self.FuncInfo.MBB.getBasicBlock(), UnwindDest) } else { getZero() };
    findUnwindDestinations(self.FuncInfo, UnwindDest, UnwindDestProb);
    self.FuncInfo.MBB.normalizeSuccProbs();
    let mut CleanupPadMBB: *mut MachineBasicBlock = self.FuncInfo.getMBB(I.getCleanupPad().getParent());
    let mut Ret: SDValue = self.DAG.getNode(CLEANUPRET, self.getCurSDLoc(), EVT { Other }, self.getControlRoot(), self.DAG.getBasicBlock(CleanupPadMBB));
    self.DAG.setRoot(Ret);
}

fn SelectionDAGBuilder::visitCatchSwitch(self, CSI: *CatchSwitchInst) {
    report_fatal_error("visitCatchSwitch not yet implemented!", true);
}

fn SelectionDAGBuilder::visitRet(self, I: *ReturnInst) {
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut DL: *DataLayout = self.DAG.getDataLayout();
    let mut Chain: SDValue = self.getControlRoot();
    let mut Outs: OutputArg, 8> = zeroed();
    let mut OutVals: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    if I.getParent().getTerminatingDeoptimizeCall() {
        self.LowerDeoptimizingReturn();
        return;
    }
    if !self.FuncInfo.CanLowerReturn {
        let mut DemoteReg: Register = self.FuncInfo.DemoteRegister;
        let mut PtrValueVT: MVT = TLI.getPointerTy(DL, DL.getAllocaAddrSpace());
        let mut RetPtr: SDValue = self.DAG.getCopyFromReg(Chain, self.getCurSDLoc(), DemoteReg, EVT { PtrValueVT });
        let mut RetTy: *mut Type = I.getOperand(0).getType();
        let mut BaseAlign: Align = DL.getPrefTypeAlign(RetTy);
        RetPtr = TLI.annotateStackObjectPointer(RetPtr, self.DAG, self.getCurSDLoc(), BaseAlign);
        let mut RetOp: SDValue = self.getValue(I.getOperand(0));
        let mut ValueVTs: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
        let mut MemVTs: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
        let mut Offsets: SmallVector<uint64_t, 4> = zeroed();
        ComputeValueVTs(TLI, DL, RetTy, ValueVTs, &mut MemVTs, operator&(), 0);
        let mut NumValues: u32 = ValueVTs.len;
        let mut Chains: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { NumValues };
        for let mut i: u32 = 0; i != NumValues; i += 1 {
            let mut Ptr: SDValue = self.DAG(self.getCurSDLoc(), RetPtr, getFixed([i]));
            let mut Val: SDValue = RetOp.getValue(RetOp.getResNo() + i);
            if MemVTs[i] != ValueVTs[i] {
                Val = self.DAG.getPtrExtOrTrunc(Val, self.getCurSDLoc(), MemVTs[i]);
            }
            Chains[i] = self.DAG(Chain, self.getCurSDLoc(), Val, Ptr, getUnknownStack(self.DAG.getMachineFunction()), commonAlignment(BaseAlign, [i]));
        }
        Chain = self.DAG;
    } else if I.getNumOperands() != 0 {
        let mut Types: SmallVector<Type *, 4> = SmallVector<Type *, 4> {};
        ComputeValueTypes(DL, I.getOperand(0).getType(), Types, null, getZero());
        let mut NumValues: u32 = Types.len;
        if NumValues {
            let mut RetOp: SDValue = self.getValue(I.getOperand(0));
            let mut F: *Function = I.getParent().getParent();
            let mut NeedsRegBlock: bool = TLI.functionArgumentNeedsConsecutiveRegisters(I.getOperand(0).getType(), F.getCallingConv(), false, DL);
            let mut ExtendKind: NodeType = ANY_EXTEND;
            if F.getAttributes().hasRetAttr(SExt) {
                ExtendKind = SIGN_EXTEND;
            } else if F.getAttributes().hasRetAttr(ZExt) {
                ExtendKind = ZERO_EXTEND;
            }
            let mut Context: *mut LLVMContext = F.getContext();
            let mut RetInReg: bool = F.getAttributes().hasRetAttr(InReg);
            for let mut j: u32 = 0; j != NumValues; j += 1 {
                let mut VT: EVT = TLI.getValueType(DL, Types[j], false);
                if ExtendKind != ANY_EXTEND && VT.isInteger() {
                    VT = TLI.getTypeForExtReturn(Context, VT, ExtendKind);
                }
                let mut CC: ID = F.getCallingConv();
                let mut NumParts: u32 = TLI.getNumRegistersForCallingConv(Context, CC, VT);
                let mut PartVT: MVT = TLI.getRegisterTypeForCallingConv(Context, CC, VT);
                let mut Parts: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { NumParts };
                getCopyToParts(self.DAG, self.getCurSDLoc(), SDValue { Node: RetOp.getNode(), ResNo: RetOp.getResNo() + j }, &mut Parts[0], NumParts, PartVT, &mut I, CC, ExtendKind);
                let mut Flags: ArgFlagsTy = ArgFlagsTy {};
                if RetInReg {
                    Flags.setInReg();
                }
                if I.getOperand(0).getType().isPointerTy() {
                    Flags.setPointer();
                    Flags.setPointerAddrSpace(cast(I.getOperand(0).getType())());
                }
                if NeedsRegBlock {
                    Flags.setInConsecutiveRegs(true);
                    if j == NumValues - 1 {
                        Flags.setInConsecutiveRegsLast(true);
                    }
                }
                if ExtendKind == SIGN_EXTEND {
                    Flags.setSExt();
                } else if ExtendKind == ZERO_EXTEND {
                    Flags.setZExt();
                } else if F.getAttributes().hasRetAttr(NoExt) {
                    Flags.setNoExt();
                }
                for let mut i: u32 = 0; i < NumParts; i += 1 {
                    Outs()(OutputArg { Flags: Flags, VT: Parts[i].getValueType().getSimpleVT(), ArgVT: VT, OrigTy: Types[j], OrigArgIndex: 0, PartOffset: 0 });
                    OutVals.push(ValueParamT { Parts[i] });
                }
            }
        }
    }
    let mut F: *Function = I.getParent().getParent();
    if TLI.supportSwiftError() && F.getAttributes().hasAttrSomewhere(SwiftError, null) {
        assert!(self.SwiftError.getFunctionArg(), "Need a swift error argument");
        let mut Flags: ArgFlagsTy = ArgFlagsTy {};
        Flags.setSwiftError();
        Outs()(OutputArg { Flags: Flags, VT: TLI.getPointerTy(DL, 0), ArgVT: EVT { TLI.getPointerTy(DL, 0) }, OrigTy: getUnqual(*self.DAG.getContext()), OrigArgIndex: 1, PartOffset: 0 });
        OutVals.push(self.DAG.getRegister(self.SwiftError.getOrCreateVRegUseAt(&mut I, self.FuncInfo.MBB, self.SwiftError.getFunctionArg()), EVT { TLI.getPointerTy(DL, 0) }));
    }
    let mut isVarArg: bool = self.DAG.getMachineFunction().getFunction().isVarArg();
    let mut CallConv: ID = self.DAG.getMachineFunction().getFunction().getCallingConv();
    Chain = self.DAG.getTargetLoweringInfo().LowerReturn(Chain, CallConv, isVarArg, OutVals, self.getCurSDLoc(), self.DAG);
    assert!(Chain.getNode() && Chain.getValueType() == EVT { Other }, "LowerReturn didn't return a valid chain!");
    self.DAG.setRoot(Chain);
}

fn SelectionDAGBuilder::CopyToExportRegsIfNeeded(self, V: *Value) {
    if V.getType().isEmptyTy() {
        return;
    }
    let mut VMI: iterator = self.FuncInfo.ValueMap.find(V);
    if VMI != self.FuncInfo.ValueMap.end() {
        assert!((!V.use_empty() || isa(V)), "Unused value assigned virtual registers!");
        self.CopyValueToVirtualRegister(V, operator(VMI).second, ANY_EXTEND);
    }
}

fn SelectionDAGBuilder::ExportFromCurrentBlock(self, V: *Value) {
    if !isa(V) && !isa(V) {
        return;
    }
    if self.FuncInfo.isExportedInst(V) {
        return;
    }
    let mut Reg: Register = self.FuncInfo.InitializeRegForValue(V);
    self.CopyValueToVirtualRegister(V, Reg, ANY_EXTEND);
}

fn SelectionDAGBuilder::isExportableFromCurrentBlock(self, V: *Value, FromBB: *BasicBlock) -> bool {
    if dyn_cast(V) {
        VI;
    } else {
        if VI.getParent() == FromBB {
            return true;
        }
        return self.FuncInfo.isExportedInst(V);
    }
    if isa(V) {
        if FromBB.isEntryBlock() {
            return true;
        }
        return self.FuncInfo.isExportedInst(V);
    }
    return true;
}

fn SelectionDAGBuilder::getEdgeProbability(self: *SelectionDAGBuilder, Src: *MachineBasicBlock, Dst: *MachineBasicBlock) -> BranchProbability {
    let mut BPI: *mut BranchProbabilityInfo = self.FuncInfo.BPI;
    let mut SrcBB: *BasicBlock = Src.getBasicBlock();
    let mut DstBB: *BasicBlock = Dst.getBasicBlock();
    if !BPI {
        let mut SuccSize: auto = max(succ_size(SrcBB), 1);
        return 1;
    }
    return BPI.getEdgeProbability(SrcBB, DstBB);
}

fn SelectionDAGBuilder::addSuccessorWithProb(self, Src: *mut MachineBasicBlock, Dst: *mut MachineBasicBlock, Prob: BranchProbability) {
    if !self.FuncInfo.BPI {
        Src.addSuccessorWithoutProb(Dst);
    } else {
        if Prob.isUnknown() {
            Prob = self.getEdgeProbability(Src, Dst);
        }
        Src.addSuccessor(Dst, Prob);
    }
}

fn InBlock(V: *Value, BB: *BasicBlock) -> bool {
    if dyn_cast(V) {
        I;
    } else {
        return I.getParent() == BB;
    }
    return true;
}

fn SelectionDAGBuilder::EmitBranchForMergedCondition(self, Cond: *Value, TBB: *mut MachineBasicBlock, FBB: *mut MachineBasicBlock, CurBB: *mut MachineBasicBlock, SwitchBB: *mut MachineBasicBlock, TProb: BranchProbability, FProb: BranchProbability, InvertCond: bool) {
    let mut BB: *BasicBlock = CurBB.getBasicBlock();
    if dyn_cast(Cond) {
        BOp;
    } else {
        if CurBB == SwitchBB || (self.isExportableFromCurrentBlock(BOp.getOperand(0), BB) && self.isExportableFromCurrentBlock(BOp.getOperand(1), BB)) {
            let mut Condition: CondCode = zeroed();
            if dyn_cast(Cond) {
                IC;
            } else {
                let mut Pred: Predicate = if InvertCond { IC.getInversePredicate() } else { IC.getPredicate() };
                Condition = getICmpCondCode(Pred);
            }
            let mut CB: CaseBlock = CaseBlock { CmpLHS: Condition, CmpMHS: BOp.getOperand(0), CmpRHS: BOp.getOperand(1), TrueBB: null, FalseBB: TBB, ThisBB: FBB, DL: CurBB, DbgLoc: self.getCurSDLoc(), TrueProb: TProb, FalseProb: FProb, IsUnpredictable: false };
            operator(self.SL).SwitchCases.push(CB);
            return;
        }
    }
    let mut Opc: CondCode = if InvertCond { SETNE } else { SETEQ };
    let mut CB: CaseBlock = CaseBlock { CmpLHS: Opc, CmpMHS: Cond, CmpRHS: getTrue(*self.DAG.getContext()), TrueBB: null, FalseBB: TBB, ThisBB: FBB, DL: CurBB, DbgLoc: self.getCurSDLoc(), TrueProb: TProb, FalseProb: FProb, IsUnpredictable: false };
    operator(self.SL).SwitchCases.push(CB);
}

fn collectInstructionDeps(Deps: *SmallMapVector<const Instruction *, bool, 8>, V: *Value, Necessary: *SmallMapVector<const Instruction *, bool, 8>, Depth: u32) -> bool {
    if Depth >= MaxRecursionDepth {
        return false;
    }
    let mut I: *mut auto = dyn_cast(V);
    if I() == null {
        return true;
    }
    if Necessary != null {
        if Necessary()() {
            return true;
        }
    }
    if operator!(Deps()(false)) {
        return true;
    }
    for let mut OpIdx: u32 = 0;
let mut E: u32 = (); OpIdx < E; OpIdx += 1 {
        if operator!(collectInstructionDeps(Deps, (OpIdx), Necessary, Depth + 1)) {
            return false;
        }
    }
    return true;
}

fn SelectionDAGBuilder::shouldKeepJumpConditionsTogether(self: *SelectionDAGBuilder, FuncInfo: *FunctionLoweringInfo, I: *CondBrInst, Opc: BinaryOps, Lhs: *Value, Rhs: *Value, Params: CondMergingParams) -> bool {
    if Params.BaseCost < 0 {
        return false;
    }
    let mut CostThresh: InstructionCost = InstructionCost { Params.BaseCost };
    let mut BPI: *mut BranchProbabilityInfo = null;
    if Params.LikelyBias || Params.UnlikelyBias {
        BPI = FuncInfo.BPI;
    }
    if BPI != null {
        let mut IfFalse: *mut BasicBlock = I.getSuccessor(0);
        let mut IfTrue: *mut BasicBlock = I.getSuccessor(1);
        let mut Likely: optional<bool> = optional<bool> {};
        if BPI.isEdgeHot(I.getParent(), IfTrue) {
            Likely(true);
        } else if BPI.isEdgeHot(I.getParent(), IfFalse) {
            Likely(false);
        }
        if Likely {
            if Opc == (if operator(Likely) { And } else { Or }) {
                operator(CostThresh, Params.LikelyBias);
            } else {
                if Params.UnlikelyBias < 0 {
                    return false;
                }
                operator(CostThresh, Params.UnlikelyBias);
            }
        }
    }
    if CostThresh <= 0 {
        return false;
    }
    let mut LhsDeps: SmallMapVector<const Instruction *, bool, 8> = zeroed();
    let mut RhsDeps: SmallMapVector<const Instruction *, bool, 8> = zeroed();
    collectInstructionDeps(operator&(), Lhs);
    if operator!(collectInstructionDeps(operator&(), Rhs, operator&())) {
        return false;
    }
    if  {
        if operator!() {
            RhsDeps()(false);
        }
    }
    let mut CostOfIncluding: InstructionCost = InstructionCost { 0 };
    let mut BrCond: *mut Value = I.getCondition();
    let mut ShouldCountInsn: Closure_5 = Closure_5 { BrCond: &mut BrCond };
    let mut MaxPruneIters: u32 = MaxRecursionDepth;
    for let mut PruneIters: u32 = 0; PruneIters < MaxPruneIters; PruneIters += 1 {
        let mut ToDrop: *Instruction = null;
        if ToDrop == null {
            break;
        }
        RhsDeps()(ToDrop);
    }
    return true;
}

fn SelectionDAGBuilder::FindMergedConditions(self, Cond: *Value, TBB: *mut MachineBasicBlock, FBB: *mut MachineBasicBlock, CurBB: *mut MachineBasicBlock, SwitchBB: *mut MachineBasicBlock, Opc: BinaryOps, TProb: BranchProbability, FProb: BranchProbability, InvertCond: bool) {
    let mut NotCond: *mut Value = null;
    if match(Cond, m_OneUse(m_Not(m_Value(NotCond)))) && InBlock(NotCond, CurBB.getBasicBlock()) {
        self.FindMergedConditions(NotCond, TBB, FBB, CurBB, SwitchBB, Opc, TProb, FProb, !InvertCond);
        return;
    }
    let mut BOp: *Instruction = dyn_cast(Cond);
    let mut BOpOp0: *Value = null;
    let mut BOpOp1: *Value = null;
    let mut BOpc: BinaryOps = 0 as BinaryOps;
    if BOp {
        BOpc = if match(BOp) { And } else { (if match(BOp) { Or } else { 0 as BinaryOps }) };
        if InvertCond {
            if BOpc == And {
                BOpc = Or;
            } else if BOpc == Or {
                BOpc = And;
            }
        }
    }
    let mut BOpIsInOrAndTree: bool = BOpc && BOpc == Opc && BOp.hasOneUse();
    if !BOpIsInOrAndTree || BOp.getParent() != CurBB.getBasicBlock() || !InBlock(BOpOp0, CurBB.getBasicBlock()) || !InBlock(BOpOp1, CurBB.getBasicBlock()) {
        self.EmitBranchForMergedCondition(Cond, TBB, FBB, CurBB, SwitchBB, TProb, FProb, InvertCond);
        return;
    }
    let mut BBI: iterator = iterator { CurBB };
    let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
    let mut TmpBB: *mut MachineBasicBlock = MF.CreateMachineBasicBlock(CurBB.getBasicBlock(), optional<UniqueBBID> { nullopt });
    CurBB.getParent().insert(iterator { operator(BBI) }, TmpBB);
    if Opc == Or {
        let mut NewTrueProb: BranchProbability = TProb / 2;
        let mut NewFalseProb: BranchProbability = TProb / 2 + FProb;
        self.FindMergedConditions(BOpOp0, TBB, TmpBB, CurBB, SwitchBB, Opc, NewTrueProb, NewFalseProb, InvertCond);
        let mut Probs: SmallVector<BranchProbability, 2> = zeroed();
        normalizeProbabilities();
        self.FindMergedConditions(BOpOp1, TBB, FBB, TmpBB, SwitchBB, Opc, [0], [1], InvertCond);
    } else {
        assert!(Opc == And, "Unknown merge op!");
        let mut NewTrueProb: BranchProbability = TProb + FProb / 2;
        let mut NewFalseProb: BranchProbability = FProb / 2;
        self.FindMergedConditions(BOpOp0, TmpBB, FBB, CurBB, SwitchBB, Opc, NewTrueProb, NewFalseProb, InvertCond);
        let mut Probs: SmallVector<BranchProbability, 2> = zeroed();
        normalizeProbabilities();
        self.FindMergedConditions(BOpOp1, TBB, FBB, TmpBB, SwitchBB, Opc, [0], [1], InvertCond);
    }
}

fn SelectionDAGBuilder::ShouldEmitAsBranches(self, Cases: i32) -> bool {
    if Cases()() != 2 {
        return true;
    }
    if (Cases()[0] == [1] && [0] == [1]) || (Cases()[0] == [1] && [0] == [1]) {
        return false;
    }
    if Cases()[0] == [1] && [0] == [1] && isa([0]) && cast([0])() {
        if Cases()[0] == SETEQ && [0] == [1] {
            return false;
        }
        if Cases()[0] == SETNE && [0] == [1] {
            return false;
        }
    }
    return true;
}

fn SelectionDAGBuilder::visitUncondBr(self, I: *UncondBrInst) {
    let mut BrMBB: *mut MachineBasicBlock = self.FuncInfo.MBB;
    let mut Succ0MBB: *mut MachineBasicBlock = self.FuncInfo.getMBB(I.getSuccessor(0));
    BrMBB.addSuccessor(Succ0MBB, getUnknown());
    if Succ0MBB != self.NextBlock(BrMBB) || self.TM.getOptLevel() == None {
        let mut Br: SDValue = self.DAG.getNode(BR, self.getCurSDLoc(), EVT { Other }, self.getControlRoot(), self.DAG.getBasicBlock(Succ0MBB));
        self.setValue(&mut I, Br);
        self.DAG.setRoot(Br);
    }
}

fn SelectionDAGBuilder::visitCondBr(self, I: *CondBrInst) {
    let mut BrMBB: *mut MachineBasicBlock = self.FuncInfo.MBB;
    let mut Succ0MBB: *mut MachineBasicBlock = self.FuncInfo.getMBB(I.getSuccessor(0));
    let mut CondVal: *Value = I.getCondition();
    let mut Succ1MBB: *mut MachineBasicBlock = self.FuncInfo.getMBB(I.getSuccessor(1));
    let mut IsUnpredictable: bool = I.hasMetadata(MD_unpredictable);
    let mut BOp: *Instruction = dyn_cast(CondVal);
    if !self.DAG.getTargetLoweringInfo().isJumpExpensive() && BOp && BOp.hasOneUse() && !IsUnpredictable {
        let mut Vec: *mut Value = null;
        let mut BOp0: *Value = null;
        let mut BOp1: *Value = null;
        let mut Opcode: BinaryOps = 0 as BinaryOps;
        if match(BOp) {
            Opcode = And;
        } else if match(BOp) {
            Opcode = Or;
        }
        if Opcode && operator!((match(BOp0, m_ExtractElt(m_Value(Vec), m_Value())) && match(BOp1, m_ExtractElt(m_Specific(Vec), m_Value())))) && !self.shouldKeepJumpConditionsTogether(self.FuncInfo, I, Opcode, BOp0, BOp1, self.DAG.getTargetLoweringInfo().getJumpConditionMergingParams(Opcode, BOp0, BOp1, self.FuncInfo.Fn)) {
            self.FindMergedConditions(BOp, Succ0MBB, Succ1MBB, BrMBB, BrMBB, Opcode, self.getEdgeProbability(BrMBB, Succ0MBB), self.getEdgeProbability(BrMBB, Succ1MBB), false);
            assert!(operator(self.SL).SwitchCases[0].ThisBB == BrMBB, "Unexpected lowering!");
            if self.ShouldEmitAsBranches(operator(self.SL).SwitchCases) {
                for let mut i: u32 = 1;
let mut e: u32 = operator(self.SL).SwitchCases.len; i != e; i += 1 {
                    self.ExportFromCurrentBlock(operator(self.SL).SwitchCases[i].CmpLHS);
                    self.ExportFromCurrentBlock(operator(self.SL).SwitchCases[i].CmpRHS);
                }
                self.visitSwitchCase(operator(self.SL).SwitchCases[0], BrMBB);
                operator(self.SL).SwitchCases;
                return;
            }
            for let mut i: u32 = 1;
let mut e: u32 = operator(self.SL).SwitchCases.len; i != e; i += 1 {
                self.FuncInfo.MF.erase(operator(self.SL).SwitchCases[i].ThisBB);
            }
            operator(self.SL).SwitchCases.clear();
        }
    }
    let mut CB: CaseBlock = CaseBlock { CmpLHS: SETEQ, CmpMHS: CondVal, CmpRHS: getTrue(*self.DAG.getContext()), TrueBB: null, FalseBB: Succ0MBB, ThisBB: Succ1MBB, DL: BrMBB, DbgLoc: self.getCurSDLoc(), TrueProb: getUnknown(), FalseProb: getUnknown(), IsUnpredictable: IsUnpredictable };
    self.visitSwitchCase(CB, BrMBB);
}

fn SelectionDAGBuilder::visitSwitchCase(self, CB: *mut CaseBlock, SwitchBB: *mut MachineBasicBlock) {
    let mut Cond: SDValue = SDValue {};
    let mut CondLHS: SDValue = self.getValue(CB.CmpLHS);
    let mut dl: SDLoc = CB.DL;
    if CB..CC == SETTRUE {
        self.addSuccessorWithProb(SwitchBB, CB.TrueBB, CB.TrueProb);
        SwitchBB.normalizeSuccProbs();
        if CB.TrueBB != self.NextBlock(SwitchBB) {
            self.DAG.setRoot(self.DAG.getNode(BR, dl, EVT { Other }, self.getControlRoot(), self.DAG.getBasicBlock(CB.TrueBB)));
        }
        return;
    }
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut MemVT: EVT = TLI.getMemValueType(self.DAG.getDataLayout(), CB.CmpLHS.getType(), false);
    if !CB.CmpMHS {
        if CB.CmpRHS == getTrue(*self.DAG.getContext()) && CB..CC == SETEQ {
            Cond = CondLHS;
        } else if CB.CmpRHS == getFalse(*self.DAG.getContext()) && CB..CC == SETEQ {
            let mut True: SDValue = self.DAG.getConstant(1, dl, CondLHS.getValueType(), false, false);
            Cond = self.DAG.getNode(XOR, dl, CondLHS.getValueType(), CondLHS, True);
        } else {
            let mut CondRHS: SDValue = self.getValue(CB.CmpRHS);
            if CondLHS.getValueType() != MemVT {
                CondLHS = self.DAG.getPtrExtOrTrunc(CondLHS, self.getCurSDLoc(), MemVT);
                CondRHS = self.DAG.getPtrExtOrTrunc(CondRHS, self.getCurSDLoc(), MemVT);
            }
            Cond = self.DAG.getSetCC(dl, EVT { i1 }, CondLHS, CondRHS, CB..CC, SDValue {}, false, SDNodeFlags { Flags: None });
        }
    } else {
        assert!(CB..CC == SETLE, "Can handle only LE ranges now");
        let mut Low: *APInt = cast(CB.CmpLHS)();
        let mut High: *APInt = cast(CB.CmpRHS)();
        let mut CmpOp: SDValue = self.getValue(CB.CmpMHS);
        let mut VT: EVT = CmpOp.getValueType();
        if cast(CB.CmpLHS)(true) {
            Cond = self.DAG.getSetCC(dl, EVT { i1 }, CmpOp, self.DAG.getConstant(High, dl, VT, false, false), SETLE, SDValue {}, false, SDNodeFlags { Flags: None });
        } else {
            let mut SUB: SDValue = self.DAG.getNode(SUB, dl, VT, CmpOp, self.DAG.getConstant(Low, dl, VT, false, false));
            Cond = self.DAG.getSetCC(dl, EVT { i1 }, SUB, self.DAG.getConstant(High - Low, dl, VT, false, false), SETULE, SDValue {}, false, SDNodeFlags { Flags: None });
        }
    }
    self.addSuccessorWithProb(SwitchBB, CB.TrueBB, CB.TrueProb);
    if CB.TrueBB != CB.FalseBB {
        self.addSuccessorWithProb(SwitchBB, CB.FalseBB, CB.FalseProb);
    }
    SwitchBB.normalizeSuccProbs();
    if CB.TrueBB == self.NextBlock(SwitchBB) {
        swap(CB.TrueBB, CB.FalseBB);
        let mut True: SDValue = self.DAG.getConstant(1, dl, Cond.getValueType(), false, false);
        Cond = self.DAG.getNode(XOR, dl, Cond.getValueType(), Cond, True);
    }
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    Flags.setUnpredictable(CB.IsUnpredictable);
    let mut BrCond: SDValue = self.DAG.getNode(BRCOND, dl, EVT { Other }, self.getControlRoot(), Cond, self.DAG.getBasicBlock(CB.TrueBB), Flags);
    self.setValue(self.CurInst, BrCond);
    BrCond = self.DAG.getNode(BR, dl, EVT { Other }, BrCond, self.DAG.getBasicBlock(CB.FalseBB));
    self.DAG.setRoot(BrCond);
}

fn SelectionDAGBuilder::visitJumpTable(self, JT: *mut JumpTable) {
    assert!(JT.SL, "Should set SDLoc for SelectionDAG!");
    assert!(JT.Reg.operator unsigned int(), "Should lower JT Header first!");
    let mut PTy: EVT = EVT { self.DAG.getTargetLoweringInfo().getJumpTableRegTy(self.DAG.getDataLayout()) };
    let mut Index: SDValue = self.DAG.getCopyFromReg(self.getControlRoot(), operator(JT.SL), JT.Reg, PTy);
    let mut Table: SDValue = self.DAG.getJumpTable(JT.JTI, PTy, false, 0);
    let mut BrJumpTable: SDValue = self.DAG.getNode(BR_JT, operator(JT.SL), EVT { Other }, Index.getValue(1), Table, Index);
    self.DAG.setRoot(BrJumpTable);
}

fn SelectionDAGBuilder::visitJumpTableHeader(self, JT: *mut JumpTable, JTH: *mut JumpTableHeader, SwitchBB: *mut MachineBasicBlock) {
    assert!(JT.SL, "Should set SDLoc for SelectionDAG!");
    let mut dl: *SDLoc = operator(JT.SL);
    let mut SwitchOp: SDValue = self.getValue(JTH.SValue);
    let mut VT: EVT = SwitchOp.getValueType();
    let mut Sub: SDValue = self.DAG.getNode(SUB, dl, VT, SwitchOp, self.DAG.getConstant(JTH.First, dl, VT, false, false));
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    SwitchOp = self.DAG.getZExtOrTrunc(Sub, dl, EVT { TLI.getJumpTableRegTy(self.DAG.getDataLayout()) });
    let mut JumpTableReg: Register = self.FuncInfo.CreateReg(TLI.getJumpTableRegTy(self.DAG.getDataLayout()), false);
    let mut CopyTo: SDValue = self.DAG.getCopyToReg(self.getControlRoot(), dl, JumpTableReg, SwitchOp);
    JT.Reg = JumpTableReg;
    if !JTH.FallthroughUnreachable {
        let mut CMP: SDValue = self.DAG.getSetCC(dl, TLI.getSetCCResultType(self.DAG.getDataLayout(), *self.DAG.getContext(), Sub.getValueType()), Sub, self.DAG.getConstant(JTH.Last - JTH.First, dl, VT, false, false), SETUGT, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut BrCond: SDValue = self.DAG.getNode(BRCOND, dl, EVT { Other }, CopyTo, CMP, self.DAG.getBasicBlock(JT.Default));
        if JT.MBB != self.NextBlock(SwitchBB) {
            BrCond = self.DAG.getNode(BR, dl, EVT { Other }, BrCond, self.DAG.getBasicBlock(JT.MBB));
        }
        self.DAG.setRoot(BrCond);
    } else {
        if JT.MBB != self.NextBlock(SwitchBB) {
            self.DAG.setRoot(self.DAG.getNode(BR, dl, EVT { Other }, CopyTo, self.DAG.getBasicBlock(JT.MBB)));
        } else {
            self.DAG.setRoot(CopyTo);
        }
    }
}

fn getLoadStackGuard(DAG: *mut SelectionDAG, DL: *SDLoc, Chain: *mut SDValue) -> SDValue {
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut PtrTy: EVT = EVT { TLI.getPointerTy(DAG.getDataLayout(), 0) };
    let mut PtrMemTy: EVT = EVT { TLI.getPointerMemTy(DAG.getDataLayout(), 0) };
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut Global: *mut Value = TLI.getSDagStackGuard(*MF.getFunction().getParent(), DAG.getLibcalls());
    let mut Node: *mut MachineSDNode = DAG.getMachineNode(LOAD_STACK_GUARD, DL, PtrTy, Chain);
    if Global {
        let mut MPInfo: MachinePointerInfo = MachinePointerInfo { Global, 0, 0 };
        let mut Flags: i32 = MOLoad | MOInvariant | MODereferenceable;
        let mut MemRef: *mut MachineMemOperand = MF;
        DAG.setNodeMemRefs(Node, ArrayRef<MachineMemOperand *> { [MemRef] });
    }
    if PtrTy != PtrMemTy {
        return DAG.getPtrExtOrTrunc(SDValue { Node: Node, ResNo: 0 }, DL, PtrMemTy);
    }
    return SDValue { Node: Node, ResNo: 0 };
}

fn SelectionDAGBuilder::visitSPDescriptorParent(self, SPD: *mut StackProtectorDescriptor, ParentBB: *mut MachineBasicBlock) {
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut DL: *DataLayout = self.DAG.getDataLayout();
    let mut PtrTy: EVT = EVT { TLI.getFrameIndexTy(DL) };
    let mut PtrMemTy: EVT = EVT { TLI.getPointerMemTy(DL, DL.getAllocaAddrSpace()) };
    let mut MFI: *mut MachineFrameInfo = ParentBB.getParent().getFrameInfo();
    let mut FI: i32 = MFI.getStackProtectorIndex();
    let mut Guard: SDValue = SDValue {};
    let mut dl: SDLoc = self.getCurSDLoc();
    let mut StackSlotPtr: SDValue = self.DAG.getFrameIndex(FI, PtrTy, false);
    let mut M: *Module = *ParentBB.getParent().getFunction().getParent();
    let mut Align: Align = DL.getPrefTypeAlign(get(M.getContext(), DL.getAllocaAddrSpace()));
    let mut GuardVal: SDValue = self.DAG.getLoad(PtrMemTy, dl, self.DAG.getEntryNode(), StackSlotPtr, getFixedStack(self.DAG.getMachineFunction(), FI, 0), MaybeAlign { Align }, MOVolatile, MMOMetadata {});
    if TLI.useStackGuardMixFP() {
        GuardVal = TLI.emitStackGuardMixFP(self.DAG, GuardVal, dl);
    }
    if SPD.shouldEmitFunctionBasedCheckStackProtector() {
        let mut GuardCheckFn: *Function = TLI.getSSPStackGuardCheck(M, self.DAG.getLibcalls());
        assert!(GuardCheckFn, "Guard check function is null");
        let mut FnTy: *mut FunctionType = GuardCheckFn.getFunctionType();
        assert!(FnTy.getNumParams() == 1, "Invalid function signature");
        let mut Args: ArgListTy = ArgListTy {};
        let mut Entry: ArgListEntry = ArgListEntry { GuardVal, FnTy.getParamType(0) };
        if GuardCheckFn.hasParamAttribute(0, InReg) {
            Entry.IsInReg = true;
        }
        Args.push(Entry);
        let mut CLI: CallLoweringInfo = CallLoweringInfo { self.DAG };
        CLI.setDebugLoc(self.getCurSDLoc()).setChain(self.DAG.getEntryNode())(GuardCheckFn.getCallingConv(), FnTy.getReturnType(), self.getValue(GuardCheckFn), move(Args));
        let mut Result: pair<SDValue, SDValue> = TLI.LowerCallTo(CLI);
        self.DAG.setRoot(Result.second);
        return;
    }
    let mut Chain: SDValue = self.DAG.getEntryNode();
    if TLI.useStackGuardMixFP() {
        if TLI.getSDagStackGuard(M, self.DAG.getLibcalls()) {
            IRGuard;
        } else {
            let mut GuardPtr: SDValue = self.getValue(IRGuard);
            Guard = self.DAG.getLoad(PtrMemTy, dl, Chain, GuardPtr, MachinePointerInfo { IRGuard, 0, 0 }, MaybeAlign { Align }, MOVolatile, MMOMetadata {});
        }
    } else {
        if TLI.useLoadStackGuardNode(M) {
            Guard = getLoadStackGuard(self.DAG, dl, Chain);
        } else {
            if TLI.getSDagStackGuard(M, self.DAG.getLibcalls()) {
                IRGuard;
            } else {
                let mut GuardPtr: SDValue = self.getValue(IRGuard);
                Guard = self.DAG.getLoad(PtrMemTy, dl, Chain, GuardPtr, MachinePointerInfo { IRGuard, 0, 0 }, MaybeAlign { Align }, MOVolatile, MMOMetadata {});
            }
        }
    }
    let mut Cmp: SDValue = self.DAG.getSetCC(dl, TLI.getSetCCResultType(DL, *self.DAG.getContext(), Guard.getValueType()), Guard, GuardVal, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut BrCond: SDValue = self.DAG.getNode(BRCOND, dl, EVT { Other }, self.getControlRoot(), Cmp, self.DAG.getBasicBlock(SPD.getFailureMBB()));
    let mut Br: SDValue = self.DAG.getNode(BR, dl, EVT { Other }, BrCond, self.DAG.getBasicBlock(SPD.getSuccessMBB()));
    self.DAG.setRoot(Br);
}

fn SelectionDAGBuilder::visitSPDescriptorFailure(self, SPD: *mut StackProtectorDescriptor) {
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut ParentBB: *mut MachineBasicBlock = SPD.getParentMBB();
    let mut M: *Module = *ParentBB.getParent().getFunction().getParent();
    let mut Chain: SDValue = SDValue {};
    let mut GuardCheckFn: *mut Function = TLI.getSSPStackGuardCheck(M, self.DAG.getLibcalls());
    if GuardCheckFn && !SPD.shouldEmitFunctionBasedCheckStackProtector() {
        let mut DL: *DataLayout = self.DAG.getDataLayout();
        let mut PtrTy: EVT = EVT { TLI.getFrameIndexTy(DL) };
        let mut PtrMemTy: EVT = EVT { TLI.getPointerMemTy(DL, DL.getAllocaAddrSpace()) };
        let mut MFI: *mut MachineFrameInfo = ParentBB.getParent().getFrameInfo();
        let mut FI: i32 = MFI.getStackProtectorIndex();
        let mut dl: SDLoc = self.getCurSDLoc();
        let mut StackSlotPtr: SDValue = self.DAG.getFrameIndex(FI, PtrTy, false);
        let mut Align: Align = DL.getPrefTypeAlign(get(M.getContext(), DL.getAllocaAddrSpace()));
        let mut GuardVal: SDValue = self.DAG.getLoad(PtrMemTy, dl, self.DAG.getEntryNode(), StackSlotPtr, getFixedStack(self.DAG.getMachineFunction(), FI, 0), MaybeAlign { Align }, MOVolatile, MMOMetadata {});
        if TLI.useStackGuardMixFP() {
            GuardVal = TLI.emitStackGuardMixFP(self.DAG, GuardVal, dl);
        }
        let mut FnTy: *mut FunctionType = GuardCheckFn.getFunctionType();
        assert!(FnTy.getNumParams() == 1, "Invalid function signature");
        let mut Args: ArgListTy = ArgListTy {};
        let mut Entry: ArgListEntry = ArgListEntry { GuardVal, FnTy.getParamType(0) };
        if GuardCheckFn.hasParamAttribute(0, InReg) {
            Entry.IsInReg = true;
        }
        Args.push(Entry);
        let mut CLI: CallLoweringInfo = CallLoweringInfo { self.DAG };
        CLI.setDebugLoc(self.getCurSDLoc()).setChain(self.DAG.getEntryNode())(GuardCheckFn.getCallingConv(), FnTy.getReturnType(), self.getValue(GuardCheckFn), move(Args));
        Chain = TLI.LowerCallTo(CLI).second;
    } else {
        let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
        CallOptions.setDiscardResult(true);
        Chain = TLI.makeLibCall(self.DAG, STACKPROTECTOR_CHECK_FAIL, EVT { isVoid }, ArrayRef<SDValue> {}, CallOptions, self.getCurSDLoc(), SDValue {}).second;
    }
    let mut TargetOpts: *TargetOptions = self.DAG.getTarget().Options;
    if TargetOpts.TrapUnreachable && !TargetOpts.NoTrapAfterNoreturn {
        Chain = self.DAG.getNode(TRAP, self.getCurSDLoc(), EVT { Other }, Chain);
    }
    self.DAG.setRoot(Chain);
}

fn SelectionDAGBuilder::visitBitTestHeader(self, B: *mut BitTestBlock, SwitchBB: *mut MachineBasicBlock) {
    let mut dl: SDLoc = self.getCurSDLoc();
    let mut SwitchOp: SDValue = self.getValue(B.SValue);
    let mut VT: EVT = SwitchOp.getValueType();
    let mut RangeSub: SDValue = self.DAG.getNode(SUB, dl, VT, SwitchOp, self.DAG.getConstant(B.First, dl, VT, false, false));
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut UsePtrType: bool = false;
    if !TLI.isTypeLegal(VT) {
        UsePtrType = true;
    } else {
        for Case in B.Cases {
            if !isUIntN(VT.getSizeInBits().operator unsigned long long(), Case.Mask) {
                UsePtrType = true;
                break;
            }
        }
    }
    let mut Sub: SDValue = RangeSub;
    if UsePtrType {
        VT = EVT { TLI.getPointerTy(self.DAG.getDataLayout(), 0) };
        Sub = self.DAG.getZExtOrTrunc(Sub, dl, VT);
    }
    B.RegVT = VT.getSimpleVT();
    B.Reg = self.FuncInfo.CreateReg(B.RegVT, false);
    let mut CopyTo: SDValue = self.DAG.getCopyToReg(self.getControlRoot(), dl, B.Reg, Sub);
    let mut MBB: *mut MachineBasicBlock = B.Cases[0].ThisBB;
    if !B.FallthroughUnreachable {
        self.addSuccessorWithProb(SwitchBB, B.Default, B.DefaultProb);
    }
    self.addSuccessorWithProb(SwitchBB, MBB, B.Prob);
    SwitchBB.normalizeSuccProbs();
    let mut Root: SDValue = CopyTo;
    if !B.FallthroughUnreachable {
        let mut RangeCmp: SDValue = self.DAG.getSetCC(dl, TLI.getSetCCResultType(self.DAG.getDataLayout(), *self.DAG.getContext(), RangeSub.getValueType()), RangeSub, self.DAG.getConstant(B.Range, dl, RangeSub.getValueType(), false, false), SETUGT, SDValue {}, false, SDNodeFlags { Flags: None });
        Root = self.DAG.getNode(BRCOND, dl, EVT { Other }, Root, RangeCmp, self.DAG.getBasicBlock(B.Default));
    }
    if MBB != self.NextBlock(SwitchBB) {
        Root = self.DAG.getNode(BR, dl, EVT { Other }, Root, self.DAG.getBasicBlock(MBB));
    }
    self.DAG.setRoot(Root);
}

fn SelectionDAGBuilder::visitBitTestCase(self, BB: *mut BitTestBlock, NextMBB: *mut MachineBasicBlock, BranchProbToNext: BranchProbability, Reg: Register, B: *mut BitTestCase, SwitchBB: *mut MachineBasicBlock) {
    let mut dl: SDLoc = self.getCurSDLoc();
    let mut VT: MVT = BB.RegVT;
    let mut ShiftOp: SDValue = self.DAG.getCopyFromReg(self.getControlRoot(), dl, Reg, EVT { VT });
    let mut Cmp: SDValue = SDValue {};
    let mut PopCount: u32 = popcount(B.Mask);
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    if PopCount == 1 {
        Cmp = self.DAG.getSetCC(dl, TLI.getSetCCResultType(self.DAG.getDataLayout(), *self.DAG.getContext(), EVT { VT }), ShiftOp, self.DAG.getConstant(countr_zero(B.Mask), dl, EVT { VT }, false, false), SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
    } else if PopCount == BB.Range {
        Cmp = self.DAG.getSetCC(dl, TLI.getSetCCResultType(self.DAG.getDataLayout(), *self.DAG.getContext(), EVT { VT }), ShiftOp, self.DAG.getConstant(countr_one(B.Mask), dl, EVT { VT }, false, false), SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
    } else {
        let mut SwitchVal: SDValue = self.DAG.getNode(SHL, dl, EVT { VT }, self.DAG.getConstant(1, dl, EVT { VT }, false, false), ShiftOp);
        let mut AndOp: SDValue = self.DAG.getNode(AND, dl, EVT { VT }, SwitchVal, self.DAG.getConstant(B.Mask, dl, EVT { VT }, false, false));
        Cmp = self.DAG.getSetCC(dl, TLI.getSetCCResultType(self.DAG.getDataLayout(), *self.DAG.getContext(), EVT { VT }), AndOp, self.DAG.getConstant(0, dl, EVT { VT }, false, false), SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    self.addSuccessorWithProb(SwitchBB, B.TargetBB, B.ExtraProb);
    self.addSuccessorWithProb(SwitchBB, NextMBB, BranchProbToNext);
    SwitchBB.normalizeSuccProbs();
    let mut BrAnd: SDValue = self.DAG.getNode(BRCOND, dl, EVT { Other }, self.getControlRoot(), Cmp, self.DAG.getBasicBlock(B.TargetBB));
    if NextMBB != self.NextBlock(SwitchBB) {
        BrAnd = self.DAG.getNode(BR, dl, EVT { Other }, BrAnd, self.DAG.getBasicBlock(NextMBB));
    }
    self.DAG.setRoot(BrAnd);
}

fn SelectionDAGBuilder::visitInvoke(self, I: *InvokeInst) {
    let mut InvokeMBB: *mut MachineBasicBlock = self.FuncInfo.MBB;
    let mut Return: *mut MachineBasicBlock = self.FuncInfo.getMBB(I.getSuccessor(0));
    let mut EHPadBB: *BasicBlock = I.getSuccessor(1);
    let mut EHPadMBB: *mut MachineBasicBlock = self.FuncInfo.getMBB(EHPadBB);
    failForInvalidBundles(I, "invokes", ArrayRef<uint32_t> { [OB_deopt, OB_gc_transition, OB_gc_live, OB_funclet, OB_cfguardtarget, OB_ptrauth, OB_clang_arc_attachedcall, OB_kcfi] });
    let mut Callee: *Value = I.getCalledOperand();
    let mut Fn: *Function = dyn_cast(Callee);
    if isa(Callee) {
        self.visitInlineAsm(I, EHPadBB);
    } else if Fn && Fn.isIntrinsic() {
        match Fn.getIntrinsicID() {
            _ => {
                llvm_unreachable_internal("Cannot invoke this intrinsic", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", 3521);
            },
            donothing => {
                seh_try_begin;
            },
            experimental_patchpoint_void => {
                experimental_patchpoint;
            },
            experimental_gc_statepoint => {
                self.LowerStatepoint(cast(I), EHPadBB);
            },
        }
    } else if I.hasDeoptState() {
        self.LowerCallSiteWithDeoptBundle(&mut I, self.getValue(Callee), EHPadBB);
    } else if I.countOperandBundlesOfType(OB_ptrauth) {
        self.LowerCallSiteWithPtrAuthBundle(cast(I), EHPadBB);
    } else {
        self.LowerCallTo(I, self.getValue(Callee), false, false, EHPadBB, null);
    }
    if !isa(I) {
        self.CopyToExportRegsIfNeeded(&mut I);
    }
    let mut UnwindDests: pair<MachineBasicBlock *, BranchProbability>, 1> = zeroed();
    let mut BPI: *mut BranchProbabilityInfo = self.FuncInfo.BPI;
    let mut EHPadBBProb: BranchProbability = if BPI { BPI.getEdgeProbability(InvokeMBB.getBasicBlock(), EHPadBB) } else { getZero() };
    findUnwindDestinations(self.FuncInfo, EHPadBB, EHPadBBProb);
    self.addSuccessorWithProb(InvokeMBB, Return, getUnknown());
    InvokeMBB.normalizeSuccProbs();
    self.DAG.setRoot(self.DAG.getNode(BR, self.getCurSDLoc(), EVT { Other }, self.getControlRoot(), self.DAG.getBasicBlock(Return)));
}

fn SelectionDAGBuilder::visitCallBrIntrinsic(self, I: *CallBrInst) {
    let mut Infos: IntrinsicInfo, 2> = zeroed();
    self.DAG.getTargetLoweringInfo().getTgtMemIntrinsic(I, self.DAG.getMachineFunction(), I.getIntrinsicID());
    (((operator!(operator!((Infos()() && "Intrinsic touches memory")))) || (_wassert(L"Infos.empty() && \"Intrinsic touches memory\"", L"llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", (3618) as u32) , 0)) as void);
    let mut Ops: SmallVector<SDValue, 8> = self.getTargetIntrinsicOperands(I, HasChain, OnlyLoad, null);
    let mut VTs: SDVTList = self.getTargetIntrinsicVTList(I, HasChain);
    let mut Result: SDValue = self.getTargetNonMemIntrinsicNode;
    Result = self.handleTargetIntrinsicRet(I, HasChain, OnlyLoad, Result);
    self.setValue(&mut I, Result);
}

fn SelectionDAGBuilder::visitCallBr(self, I: *CallBrInst) {
    let mut CallBrMBB: *mut MachineBasicBlock = self.FuncInfo.MBB;
    if I.isInlineAsm() {
        failForInvalidBundles(I, "callbrs", ArrayRef<uint32_t> { [OB_deopt, OB_funclet] });
        self.visitInlineAsm(I, null);
    } else {
        assert!(!I.hasOperandBundles(), "Can't have operand bundles for intrinsics");
        self.visitCallBrIntrinsic(I);
    }
    self.CopyToExportRegsIfNeeded(&mut I);
    let mut Dests: SmallPtrSet<BasicBlock *, 8> = zeroed();
    Dests()(I.getDefaultDest());
    let mut Return: *mut MachineBasicBlock = self.FuncInfo.getMBB(I.getDefaultDest());
    self.addSuccessorWithProb(CallBrMBB, Return, getOne());
    if I.isInlineAsm() {
        for Dest in I.getIndirectDests() {
            let mut Target: *mut MachineBasicBlock = self.FuncInfo.getMBB(Dest);
            Target.setIsInlineAsmBrIndirectTarget(true);
            Target.setLabelMustBeEmitted();
            if Dests()(Dest) {
                self.addSuccessorWithProb(CallBrMBB, Target, getZero());
            }
        }
    }
    CallBrMBB.normalizeSuccProbs();
    self.DAG.setRoot(self.DAG.getNode(BR, self.getCurSDLoc(), EVT { Other }, self.getControlRoot(), self.DAG.getBasicBlock(Return)));
}

fn SelectionDAGBuilder::visitResume(self, RI: *ResumeInst) {
    llvm_unreachable_internal("SelectionDAGBuilder shouldn't visit resume instructions!", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", 3687);
}

fn SelectionDAGBuilder::visitLandingPad(self, LP: *LandingPadInst) {
    assert!(self.FuncInfo.MBB.isEHPad(), "Call to landingpad not in landing pad!");
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut PersonalityFn: *Constant = self.FuncInfo.Fn.getPersonalityFn();
    if TLI.getExceptionPointerRegister(self.FuncInfo.ExceptionModel, PersonalityFn) == 0 && TLI.getExceptionSelectorRegister(self.FuncInfo.ExceptionModel, PersonalityFn) == 0 {
        return;
    }
    if LP.getType().isTokenTy() {
        return;
    }
    let mut dl: SDLoc = self.getCurSDLoc();
    if !isExceptionPointerAndSelectorType(LP.getType()) {
        self.DAG.getContext().diagnose(DiagnosticInfoUnsupported { *LP.getFunction(), "landingpad result type must be a struct of an exception pointer and an integer selector", DiagnosticLocation { dl.getDebugLoc() }, DS_Error });
        self.setValueToPoison(&mut LP, dl);
        return;
    }
    let mut ValueVTs: SmallVector<EVT, 2> = zeroed();
    ComputeValueVTs(TLI, self.DAG.getDataLayout(), LP.getType());
    (((operator!(operator!((ValueVTs()() == 2 && "Only two-valued landingpads are supported")))) || (_wassert(L"ValueVTs.size() == 2 && \"Only two-valued landingpads are supported\"", L"llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", (3726) as u32) , 0)) as void);
    let mut Ops: [2]SDValue = [2]SDValue {};
    if self.FuncInfo.ExceptionPointerVirtReg.operator unsigned int() {
        Ops[0] = self.DAG.getZExtOrTrunc(self.DAG.getCopyFromReg(self.DAG.getEntryNode(), dl, self.FuncInfo.ExceptionPointerVirtReg, EVT { TLI.getPointerTy(self.DAG.getDataLayout(), 0) }), dl, [0]);
    } else {
        Ops[0] = self.DAG.getConstant(0, dl, EVT { TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, false, false);
    }
    Ops[1] = self.DAG.getZExtOrTrunc(self.DAG.getCopyFromReg(self.DAG.getEntryNode(), dl, self.FuncInfo.ExceptionSelectorVirtReg, EVT { TLI.getPointerTy(self.DAG.getDataLayout(), 0) }), dl, [1]);
    let mut Res: SDValue = self.DAG(MERGE_VALUES, dl, self.DAG(), Ops);
    self.setValue(&mut LP, Res);
}

fn SelectionDAGBuilder::UpdateSplitBlock(self, First: *mut MachineBasicBlock, Last: *mut MachineBasicBlock) {}

fn SelectionDAGBuilder::visitIndirectBr(self, I: *IndirectBrInst) {
    let mut IndirectBrMBB: *mut MachineBasicBlock = self.FuncInfo.MBB;
    let mut Done: SmallPtrSet<BasicBlock *, 32> = zeroed();
    for let mut i: u32 = 0;
let mut e: u32 = I.getNumSuccessors(); i != e; i += 1 {
        let mut BB: *mut BasicBlock = I.getSuccessor(i);
        let mut Inserted: bool = (BB);
        if !Inserted {
            continue;
        }
        let mut Succ: *mut MachineBasicBlock = self.FuncInfo.getMBB(BB);
        self.addSuccessorWithProb(IndirectBrMBB, Succ, getUnknown());
    }
    IndirectBrMBB.normalizeSuccProbs();
    self.DAG.setRoot(self.DAG.getNode(BRIND, self.getCurSDLoc(), EVT { Other }, self.getControlRoot(), self.getValue(I.getAddress())));
}

fn SelectionDAGBuilder::visitUnreachable(self, I: *UnreachableInst) {
    if !I.shouldLowerToTrap(self.DAG.getTarget().Options.TrapUnreachable, self.DAG.getTarget().Options.NoTrapAfterNoreturn) {
        return;
    }
    self.DAG.setRoot(self.DAG.getNode(TRAP, self.getCurSDLoc(), EVT { Other }, self.DAG.getRoot()));
}

fn SelectionDAGBuilder::visitUnary(self, I: *User, Opcode: u32) {
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    if  {
        Flags.copyFMF(operator*());
    }
    let mut Op: SDValue = self.getValue(I.getOperand(0));
    let mut UnNodeValue: SDValue = self.DAG.getNode(Opcode, self.getCurSDLoc(), Op.getValueType(), Op, Flags);
    self.setValue(&mut I, UnNodeValue);
}

fn SelectionDAGBuilder::visitBinary(self, I: *User, Opcode: u32) {
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    if  {
        Flags.setNoSignedWrap();
        Flags.setNoUnsignedWrap();
    }
    if  {
        Flags.setExact();
    }
    if  {
        Flags.setDisjoint();
    }
    if  {
        Flags.copyFMF(operator*());
    }
    let mut Op1: SDValue = self.getValue(I.getOperand(0));
    let mut Op2: SDValue = self.getValue(I.getOperand(1));
    let mut BinNodeValue: SDValue = self.DAG.getNode(Opcode, self.getCurSDLoc(), Op1.getValueType(), Op1, Op2, Flags);
    self.setValue(&mut I, BinNodeValue);
}

fn SelectionDAGBuilder::visitShift(self, I: *User, Opcode: u32) {
    let mut Op1: SDValue = self.getValue(I.getOperand(0));
    let mut Op2: SDValue = self.getValue(I.getOperand(1));
    let mut ShiftTy: EVT = self.DAG.getTargetLoweringInfo().getShiftAmountTy(Op1.getValueType(), self.DAG.getDataLayout());
    if !I.getType().isVectorTy() && Op2.getValueType() != ShiftTy {
        assert!(ShiftTy.getSizeInBits().operator unsigned long long() >= Log2_32_Ceil(Op1.getValueSizeInBits().operator unsigned long long()), "Unexpected shift type");
        Op2 = self.DAG.getZExtOrTrunc(Op2, self.getCurSDLoc(), ShiftTy);
    }
    let mut nuw: bool = false;
    let mut nsw: bool = false;
    let mut exact: bool = false;
    if Opcode == SRL || Opcode == SRA || Opcode == SHL {
        if dyn_cast(&mut I) {
            OFBinOp;
        } else {
            nuw = OFBinOp.hasNoUnsignedWrap();
            nsw = OFBinOp.hasNoSignedWrap();
        }
        if dyn_cast(&mut I) {
            ExactOp;
        } else {
            exact = ExactOp.isExact();
        }
    }
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    Flags.setExact(exact);
    Flags.setNoSignedWrap(nsw);
    Flags.setNoUnsignedWrap(nuw);
    let mut Res: SDValue = self.DAG.getNode(Opcode, self.getCurSDLoc(), Op1.getValueType(), Op1, Op2, Flags);
    self.setValue(&mut I, Res);
}

fn SelectionDAGBuilder::visitSDiv(self, I: *User) {
    let mut Op1: SDValue = self.getValue(I.getOperand(0));
    let mut Op2: SDValue = self.getValue(I.getOperand(1));
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    Flags.setExact(isa(&mut I) && cast(&mut I)());
    self.setValue(&mut I, self.DAG.getNode(SDIV, self.getCurSDLoc(), Op1.getValueType(), Op1, Op2, Flags));
}

fn SelectionDAGBuilder::visitICmp(self, I: *ICmpInst) {
    let mut predicate: Predicate = I.getPredicate();
    let mut Op1: SDValue = self.getValue(I.getOperand(0));
    let mut Op2: SDValue = self.getValue(I.getOperand(1));
    let mut Opcode: CondCode = getICmpCondCode(predicate);
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut MemVT: EVT = TLI.getMemValueType(self.DAG.getDataLayout(), I.getOperand(0).getType(), false);
    if Op1.getValueType() != MemVT {
        Op1 = self.DAG.getPtrExtOrTrunc(Op1, self.getCurSDLoc(), MemVT);
        Op2 = self.DAG.getPtrExtOrTrunc(Op2, self.getCurSDLoc(), MemVT);
    }
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    Flags.setSameSign(I.hasSameSign());
    let mut DestVT: EVT = self.DAG.getTargetLoweringInfo().getValueType(self.DAG.getDataLayout(), I.getType(), false);
    self.setValue(&mut I, self.DAG.getSetCC(self.getCurSDLoc(), DestVT, Op1, Op2, Opcode, SDValue {}, false, Flags));
}

fn SelectionDAGBuilder::visitFCmp(self, I: *FCmpInst) {
    let mut predicate: Predicate = I.getPredicate();
    let mut Op1: SDValue = self.getValue(I.getOperand(0));
    let mut Op2: SDValue = self.getValue(I.getOperand(1));
    let mut Condition: CondCode = getFCmpCondCode(predicate);
    let mut FPMO: *mut auto = cast(&mut I);
    if FPMO()() || (self.DAG.isKnownNeverNaN(Op1, false, 0) && self.DAG.isKnownNeverNaN(Op2, false, 0)) {
        Condition = getFCmpCodeWithoutNaN(Condition);
    }
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    Flags.copyFMF(operator*());
    let mut DestVT: EVT = self.DAG.getTargetLoweringInfo().getValueType(self.DAG.getDataLayout(), I.getType(), false);
    self.setValue(&mut I, self.DAG.getSetCC(self.getCurSDLoc(), DestVT, Op1, Op2, Condition, SDValue {}, false, Flags));
}

fn hasOnlySelectUsers(Cond: *Value) -> bool {
    return all_of(Cond.users(), Closure_6 {});
}

fn SelectionDAGBuilder::visitSelect(self, I: *User) {
    let mut ValueVTs: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
    ComputeValueVTs(self.DAG.getTargetLoweringInfo(), self.DAG.getDataLayout(), I.getType(), ValueVTs, null, null, getZero());
    let mut NumValues: u32 = ValueVTs.len;
    if NumValues == 0 {
        return;
    }
    let mut Values: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { NumValues };
    let mut Cond: SDValue = self.getValue(I.getOperand(0));
    let mut LHSVal: SDValue = self.getValue(I.getOperand(1));
    let mut RHSVal: SDValue = self.getValue(I.getOperand(2));
    let mut BaseOps: SmallVector<SDValue, 1> = zeroed();
    let mut OpCode: NodeType = if Cond.getValueType().isVector() { VSELECT } else { SELECT };
    let mut IsUnaryAbs: bool = false;
    let mut Negate: bool = false;
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    if  {
        Flags.copyFMF(operator*());
    }
    Flags.setUnpredictable(cast(I)(MD_unpredictable));
    if all_equal(ValueVTs) {
        let mut VT: EVT = ValueVTs[0];
        let mut Ctx: *mut LLVMContext = *self.DAG.getContext();
        let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
        while TLI.getTypeAction(Ctx, VT) != TypeLegal {
            VT = TLI.getTypeToTransformTo(Ctx, VT);
        }
        let mut UseScalarMinMax: bool = VT.isVector() && !TLI.isOperationLegalOrCustom(VSELECT, VT, false);
        let mut LHS: *Value = null;
        let mut RHS: *Value = null;
        let mut SPR: SelectPatternResult = matchSelectPattern(&mut I, LHS, RHS);
        let mut Opc: NodeType = DELETED_NODE;
        match SPR.Flavor {
            SPF_UMAX => {
                Opc = UMAX;
            },
            SPF_UMIN => {
                Opc = UMIN;
            },
            SPF_SMAX => {
                Opc = SMAX;
            },
            SPF_SMIN => {
                Opc = SMIN;
            },
            SPF_FMINNUM => {
                if !TLI.isProfitableToCombineMinNumMaxNum(VT) {
                    break;
                }
            },
            SPF_FMAXNUM => {
                if !TLI.isProfitableToCombineMinNumMaxNum(VT) {
                    break;
                }
            },
            SPF_NABS => {
                Negate = true;
            },
            SPF_ABS => {
                IsUnaryAbs = true;
            },
            _ => {
                break;
            },
        }
        if !IsUnaryAbs && Opc != DELETED_NODE && (TLI.isOperationLegalOrCustom(Opc, VT, false) || (UseScalarMinMax && TLI.isOperationLegalOrCustom(Opc, VT.getScalarType(), false))) && hasOnlySelectUsers(cast(I)()) {
            OpCode = Opc;
            LHSVal = self.getValue(LHS);
            RHSVal = self.getValue(RHS);
            BaseOps()();
        }
        if IsUnaryAbs {
            OpCode = Opc;
            LHSVal = self.getValue(LHS);
            BaseOps()();
        }
    }
    if IsUnaryAbs {
        for let mut i: u32 = 0; i != NumValues; i += 1 {
            let mut dl: SDLoc = self.getCurSDLoc();
            let mut VT: EVT = LHSVal.getNode().getValueType(LHSVal.getResNo() + i);
            Values[i] = self.DAG.getNode(OpCode, dl, VT, LHSVal.getValue(LHSVal.getResNo() + i));
            if Negate {
                Values[i] = self.DAG.getNegative(Values[i], dl, VT);
            }
        }
    } else {
        for let mut i: u32 = 0; i != NumValues; i += 1 {
            let mut Ops: SmallVector<SDValue, 3> = zeroed();
            Ops()(SDValue { Node: LHSVal.getNode(), ResNo: LHSVal.getResNo() + i });
            Ops()(SDValue { Node: RHSVal.getNode(), ResNo: RHSVal.getResNo() + i });
            Values[i] = self.DAG(OpCode, self.getCurSDLoc(), LHSVal.getNode().getValueType(LHSVal.getResNo() + i), Flags);
        }
    }
    self.setValue(&mut I, self.DAG);
}

fn SelectionDAGBuilder::visitTrunc(self, I: *User) {
    let mut N: SDValue = self.getValue(I.getOperand(0));
    let mut DestVT: EVT = self.DAG.getTargetLoweringInfo().getValueType(self.DAG.getDataLayout(), I.getType(), false);
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    if  {
        Flags.setNoSignedWrap();
        Flags.setNoUnsignedWrap();
    }
    self.setValue(&mut I, self.DAG.getNode(TRUNCATE, self.getCurSDLoc(), DestVT, N, Flags));
}

fn SelectionDAGBuilder::visitZExt(self, I: *User) {
    let mut N: SDValue = self.getValue(I.getOperand(0));
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut DestVT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    if  {
        Flags.setNonNeg();
    }
    if Flags.hasNonNeg() && TLI.isSExtCheaperThanZExt(N.getValueType(), DestVT) {
        self.setValue(&mut I, self.DAG.getNode(SIGN_EXTEND, self.getCurSDLoc(), DestVT, N));
        return;
    }
    self.setValue(&mut I, self.DAG.getNode(ZERO_EXTEND, self.getCurSDLoc(), DestVT, N, Flags));
}

fn SelectionDAGBuilder::visitSExt(self, I: *User) {
    let mut N: SDValue = self.getValue(I.getOperand(0));
    let mut DestVT: EVT = self.DAG.getTargetLoweringInfo().getValueType(self.DAG.getDataLayout(), I.getType(), false);
    self.setValue(&mut I, self.DAG.getNode(SIGN_EXTEND, self.getCurSDLoc(), DestVT, N));
}

fn SelectionDAGBuilder::visitFPTrunc(self, I: *User) {
    let mut N: SDValue = self.getValue(I.getOperand(0));
    let mut dl: SDLoc = self.getCurSDLoc();
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    if  {
        Flags.copyFMF(operator*());
    }
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut DestVT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
    self.setValue(&mut I, self.DAG.getNode(FP_ROUND, dl, DestVT, N, self.DAG.getTargetConstant(0, dl, EVT { TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, false), Flags));
}

fn SelectionDAGBuilder::visitFPExt(self, I: *User) {
    let mut N: SDValue = self.getValue(I.getOperand(0));
    let mut DestVT: EVT = self.DAG.getTargetLoweringInfo().getValueType(self.DAG.getDataLayout(), I.getType(), false);
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    if  {
        Flags.copyFMF(operator*());
    }
    self.setValue(&mut I, self.DAG.getNode(FP_EXTEND, self.getCurSDLoc(), DestVT, N, Flags));
}

fn SelectionDAGBuilder::visitFPToUI(self, I: *User) {
    let mut N: SDValue = self.getValue(I.getOperand(0));
    let mut DestVT: EVT = self.DAG.getTargetLoweringInfo().getValueType(self.DAG.getDataLayout(), I.getType(), false);
    self.setValue(&mut I, self.DAG.getNode(FP_TO_UINT, self.getCurSDLoc(), DestVT, N));
}

fn SelectionDAGBuilder::visitFPToSI(self, I: *User) {
    let mut N: SDValue = self.getValue(I.getOperand(0));
    let mut DestVT: EVT = self.DAG.getTargetLoweringInfo().getValueType(self.DAG.getDataLayout(), I.getType(), false);
    self.setValue(&mut I, self.DAG.getNode(FP_TO_SINT, self.getCurSDLoc(), DestVT, N));
}

fn SelectionDAGBuilder::visitUIToFP(self, I: *User) {
    let mut N: SDValue = self.getValue(I.getOperand(0));
    let mut DestVT: EVT = self.DAG.getTargetLoweringInfo().getValueType(self.DAG.getDataLayout(), I.getType(), false);
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    Flags.setNonNeg(cast(&mut I)());
    Flags.copyFMF(operator*(cast(&mut I)));
    self.setValue(&mut I, self.DAG.getNode(UINT_TO_FP, self.getCurSDLoc(), DestVT, N, Flags));
}

fn SelectionDAGBuilder::visitSIToFP(self, I: *User) {
    let mut N: SDValue = self.getValue(I.getOperand(0));
    let mut DestVT: EVT = self.DAG.getTargetLoweringInfo().getValueType(self.DAG.getDataLayout(), I.getType(), false);
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    Flags.copyFMF(operator*(cast(&mut I)));
    self.setValue(&mut I, self.DAG.getNode(SINT_TO_FP, self.getCurSDLoc(), DestVT, N, Flags));
}

fn SelectionDAGBuilder::visitPtrToAddr(self, I: *User) {
    let mut N: SDValue = self.getValue(I.getOperand(0));
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut AddrVT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
    N = self.DAG.getNode(TRUNCATE, self.getCurSDLoc(), AddrVT, N);
    self.setValue(&mut I, N);
}

fn SelectionDAGBuilder::visitPtrToInt(self, I: *User) {
    let mut N: SDValue = self.getValue(I.getOperand(0));
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut DestVT: EVT = self.DAG.getTargetLoweringInfo().getValueType(self.DAG.getDataLayout(), I.getType(), false);
    let mut PtrMemVT: EVT = TLI.getMemValueType(self.DAG.getDataLayout(), I.getOperand(0).getType(), false);
    N = self.DAG.getPtrExtOrTrunc(N, self.getCurSDLoc(), PtrMemVT);
    N = self.DAG.getZExtOrTrunc(N, self.getCurSDLoc(), DestVT);
    self.setValue(&mut I, N);
}

fn SelectionDAGBuilder::visitIntToPtr(self, I: *User) {
    let mut N: SDValue = self.getValue(I.getOperand(0));
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut DestVT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
    let mut PtrMemVT: EVT = TLI.getMemValueType(self.DAG.getDataLayout(), I.getType(), false);
    N = self.DAG.getZExtOrTrunc(N, self.getCurSDLoc(), PtrMemVT);
    N = self.DAG.getPtrExtOrTrunc(N, self.getCurSDLoc(), DestVT);
    self.setValue(&mut I, N);
}

fn SelectionDAGBuilder::visitBitCast(self, I: *User) {
    let mut N: SDValue = self.getValue(I.getOperand(0));
    let mut dl: SDLoc = self.getCurSDLoc();
    let mut DestVT: EVT = self.DAG.getTargetLoweringInfo().getValueType(self.DAG.getDataLayout(), I.getType(), false);
    if DestVT != N.getValueType() {
        self.setValue(&mut I, self.DAG.getNode(BITCAST, dl, DestVT, N));
    } else if dyn_cast(I.getOperand(0)) {
        C;
    } else {
        self.setValue(&mut I, self.DAG.getConstant(C.getValue(), dl, DestVT, false, true));
    }
}

fn SelectionDAGBuilder::visitAddrSpaceCast(self, I: *User) {
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut SV: *Value = I.getOperand(0);
    let mut N: SDValue = self.getValue(SV);
    let mut DestVT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
    let mut SrcAS: u32 = SV.getType().getPointerAddressSpace();
    let mut DestAS: u32 = I.getType().getPointerAddressSpace();
    if !self.TM.isNoopAddrSpaceCast(self.DAG.getDataLayout(), SrcAS, DestAS) {
        let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
        if  {
            Flags.setNonNull();
        }
        N = self.DAG.getAddrSpaceCast(self.getCurSDLoc(), DestVT, N, SrcAS, DestAS, Flags);
    }
    self.setValue(&mut I, N);
}

fn SelectionDAGBuilder::visitInsertElement(self, I: *User) {
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut InVec: SDValue = self.getValue(I.getOperand(0));
    let mut InVal: SDValue = self.getValue(I.getOperand(1));
    let mut InIdx: SDValue = self.DAG.getZExtOrTrunc(self.getValue(I.getOperand(2)), self.getCurSDLoc(), EVT { TLI.getVectorIdxTy(self.DAG.getDataLayout()) });
    self.setValue(&mut I, self.DAG.getNode(INSERT_VECTOR_ELT, self.getCurSDLoc(), TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false), InVec, InVal, InIdx));
}

fn SelectionDAGBuilder::visitBitInsert(self, I: *User) {
    let mut Base: SDValue = self.getValue(I.getOperand(0));
    let mut Val: SDValue = self.getValue(I.getOperand(1));
    let mut Offset: SDValue = self.getValue(I.getOperand(2));
    let mut BaseVT: EVT = Base.getValueType();
    let mut ValVT: EVT = Val.getValueType();
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut dl: SDLoc = self.getCurSDLoc();
    assert!(BaseVT.getSizeInBits().operator unsigned long long() >= ValVT.getSizeInBits().operator unsigned long long(), "bitinsert val wider than base should be rejected by verifier");
    if !ValVT.isInteger() {
        ValVT = ValVT.changeTypeToInteger();
        Val = self.DAG.getBitcast(ValVT, Val);
    }
    let mut ShiftAmtTy: EVT = TLI.getShiftAmountTy(BaseVT, self.DAG.getDataLayout());
    let mut LegalShiftAmount: SDValue = self.DAG.getZExtOrTrunc(Offset, dl, ShiftAmtTy);
    let mut BaseBitWidth: u32 = BaseVT.getScalarSizeInBits();
    let mut ValBitWidth: u32 = ValVT.getScalarSizeInBits();
    let mut InsertMask: APInt = getLowBitsSet(BaseBitWidth, ValBitWidth);
    let mut ShiftedMask: SDValue = self.DAG.getNode(SHL, dl, BaseVT, self.DAG.getConstant(InsertMask, dl, BaseVT, false, false), LegalShiftAmount);
    let mut ClearMask: SDValue = self.DAG.getNOT(dl, ShiftedMask, BaseVT);
    let mut ClearedBase: SDValue = self.DAG.getNode(AND, dl, BaseVT, Base, ClearMask);
    let mut ExtVal: SDValue = self.DAG.getZExtOrTrunc(Val, dl, BaseVT);
    let mut ShiftedVal: SDValue = self.DAG.getNode(SHL, dl, BaseVT, ExtVal, LegalShiftAmount);
    let mut Result: SDValue = self.DAG.getNode(OR, dl, BaseVT, ClearedBase, ShiftedVal);
    self.setValue(&mut I, Result);
}

fn SelectionDAGBuilder::visitBitExtract(self, I: *User) {
    let mut Src: SDValue = self.getValue(I.getOperand(0));
    let mut Offset: SDValue = self.getValue(I.getOperand(1));
    let mut SrcVT: EVT = Src.getValueType();
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut ResultVT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
    let mut dl: SDLoc = self.getCurSDLoc();
    assert!(ResultVT.getSizeInBits().operator unsigned long long() <= SrcVT.getSizeInBits().operator unsigned long long(), "bitextract result wider than source should be rejected by verifier");
    let mut ShiftAmtTy: EVT = TLI.getShiftAmountTy(SrcVT, self.DAG.getDataLayout());
    let mut LegalShiftAmount: SDValue = self.DAG.getZExtOrTrunc(Offset, dl, ShiftAmtTy);
    let mut Shifted: SDValue = self.DAG.getNode(SRL, dl, SrcVT, Src, LegalShiftAmount);
    let mut Result: SDValue = SDValue {};
    if !ResultVT.isInteger() {
        let mut IntResultVT: EVT = ResultVT.changeTypeToInteger();
        Result = self.DAG.getNode(TRUNCATE, dl, IntResultVT, Shifted);
        Result = self.DAG.getBitcast(ResultVT, Result);
    } else {
        Result = self.DAG.getNode(TRUNCATE, dl, ResultVT, Shifted);
    }
    self.setValue(&mut I, Result);
}

fn SelectionDAGBuilder::visitExtractElement(self, I: *User) {
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut InVec: SDValue = self.getValue(I.getOperand(0));
    let mut InIdx: SDValue = self.DAG.getZExtOrTrunc(self.getValue(I.getOperand(1)), self.getCurSDLoc(), EVT { TLI.getVectorIdxTy(self.DAG.getDataLayout()) });
    self.setValue(&mut I, self.DAG.getNode(EXTRACT_VECTOR_ELT, self.getCurSDLoc(), TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false), InVec, InIdx));
}

fn SelectionDAGBuilder::visitShuffleVector(self, I: *User) {
    let mut Src1: SDValue = self.getValue(I.getOperand(0));
    let mut Src2: SDValue = self.getValue(I.getOperand(1));
    let mut Mask: ArrayRef<int> = ArrayRef<int> {};
    if  {
        Mask = ();
    } else {
        Mask = cast(I)();
    }
    let mut DL: SDLoc = self.getCurSDLoc();
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut VT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
    let mut SrcVT: EVT = Src1.getValueType();
    if all_of(Mask, equal_to(0)) && VT.isScalableVector() {
        let mut FirstElt: SDValue = self.DAG.getNode(EXTRACT_VECTOR_ELT, DL, SrcVT.getScalarType(), Src1, self.DAG.getVectorIdxConstant(0, DL, false));
        self.setValue(&mut I, self.DAG.getNode(SPLAT_VECTOR, DL, VT, FirstElt));
        return;
    }
    assert!(!VT.isScalableVector(), "Unsupported scalable vector shuffle");
    let mut SrcNumElts: u32 = SrcVT.getVectorNumElements();
    let mut MaskNumElts: u32 = Mask.len;
    if SrcNumElts == MaskNumElts {
        self.setValue(&mut I, self.DAG.getVectorShuffle(VT, DL, Src1, Src2, Mask));
        return;
    }
    if SrcNumElts < MaskNumElts {
        if MaskNumElts % SrcNumElts == 0 {
            let mut NumConcat: u32 = MaskNumElts / SrcNumElts;
            let mut IsConcat: bool = true;
            let mut ConcatSrcs: SmallVector<int, 8> = zeroed();
            for let mut i: u32 = 0; i != MaskNumElts; i += 1 {
                let mut Idx: i32 = Mask[i];
                if Idx < 0 {
                    continue;
                }
                if (Idx % SrcNumElts != (i % SrcNumElts)) || (ConcatSrcs()[i / SrcNumElts] >= 0 && [i / SrcNumElts] != (Idx / SrcNumElts) as i32) {
                    IsConcat = false;
                    break;
                }
                ConcatSrcs()[i / SrcNumElts] = Idx / SrcNumElts;
            }
            if IsConcat {
                let mut ConcatOps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
                self.setValue(&mut I, self.DAG);
                return;
            }
        }
        let mut PaddedMaskNumElts: u32 = alignTo(MaskNumElts, SrcNumElts);
        let mut NumConcat: u32 = PaddedMaskNumElts / SrcNumElts;
        let mut PaddedVT: EVT = getVectorVT(*self.DAG.getContext(), VT.getScalarType(), PaddedMaskNumElts, false);
        let mut UndefVal: SDValue = self.DAG.getUNDEF(SrcVT);
        let mut MOps1: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { NumConcat, UndefVal };
        let mut MOps2: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { NumConcat, UndefVal };
        MOps1[0] = Src1;
        MOps2[0] = Src2;
        Src1 = self.DAG;
        Src2 = self.DAG;
        let mut MappedOps: SmallVector<int, 8> = zeroed();
        for let mut i: u32 = 0; i != MaskNumElts; i += 1 {
            let mut Idx: i32 = Mask[i];
            if Idx >= SrcNumElts as i32 {
                Idx -= SrcNumElts - PaddedMaskNumElts;
            }
            MappedOps()[i] = Idx;
        }
        let mut Result: SDValue = self.DAG.getVectorShuffle(PaddedVT, DL, Src1, Src2);
        if MaskNumElts != PaddedMaskNumElts {
            Result = self.DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, Result, self.DAG.getVectorIdxConstant(0, DL, false));
        }
        self.setValue(&mut I, Result);
        return;
    }
    assert!(SrcNumElts > MaskNumElts);
    let mut StartIdx: [2]i32 = [-1, -1];
    let mut CanExtract: bool = true;
    for Idx in Mask {
        let mut Input: u32 = 0;
        if Idx < 0 {
            continue;
        }
        if Idx >= SrcNumElts as i32 {
            Input = 1;
            Idx -= SrcNumElts;
        }
        let mut NewStartIdx: i32 = alignDown(Idx, MaskNumElts);
        if NewStartIdx + MaskNumElts > SrcNumElts || (StartIdx[Input] >= 0 && StartIdx[Input] != NewStartIdx) {
            CanExtract = false;
        }
        StartIdx[Input] = NewStartIdx;
    }
    if StartIdx[0] < 0 && StartIdx[1] < 0 {
        self.setValue(&mut I, self.DAG.getUNDEF(VT));
        return;
    }
    if CanExtract {
        for let mut Input: u32 = 0; Input < 2; Input += 1 {
            let mut Src: *mut SDValue = if Input == 0 { Src1 } else { Src2 };
            if StartIdx[Input] < 0 {
                Src = self.DAG.getUNDEF(VT);
            } else {
                Src = self.DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, Src, self.DAG.getVectorIdxConstant(StartIdx[Input], DL, false));
            }
        }
        let mut MappedOps: SmallVector<int, 8> = zeroed();
        self.setValue(&mut I, self.DAG.getVectorShuffle(VT, DL, Src1, Src2));
        return;
    }
    let mut EltVT: EVT = VT.getVectorElementType();
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    for Idx in Mask {
        let mut Res: SDValue = SDValue {};
        if Idx < 0 {
            Res = self.DAG.getUNDEF(EltVT);
        } else {
            let mut Src: *mut SDValue = if Idx < SrcNumElts as i32 { Src1 } else { Src2 };
            if Idx >= SrcNumElts as i32 {
                Idx -= SrcNumElts;
            }
            Res = self.DAG.getNode(EXTRACT_VECTOR_ELT, DL, EltVT, Src, self.DAG.getVectorIdxConstant(Idx, DL, false));
        }
        Ops.push(ValueParamT { Res });
    }
    self.setValue(&mut I, self.DAG);
}

fn SelectionDAGBuilder::visitInsertValue(self, I: *InsertValueInst) {
    let mut Indices: ArrayRef<unsigned int> = I.getIndices();
    let mut Op0: *Value = I.getOperand(0);
    let mut Op1: *Value = I.getOperand(1);
    let mut AggTy: *mut Type = I.getType();
    let mut ValTy: *mut Type = Op1.getType();
    let mut IntoUndef: bool = isa(Op0);
    let mut FromUndef: bool = isa(Op1);
    let mut LinearIndex: u32 = ComputeLinearIndex(AggTy, Indices, 0);
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut AggValueVTs: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
    ComputeValueVTs(TLI, self.DAG.getDataLayout(), AggTy, AggValueVTs, null, null, getZero());
    let mut ValValueVTs: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
    ComputeValueVTs(TLI, self.DAG.getDataLayout(), ValTy, ValValueVTs, null, null, getZero());
    let mut NumAggValues: u32 = AggValueVTs.len;
    let mut NumValValues: u32 = ValValueVTs.len;
    let mut Values: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { NumAggValues };
    if !NumAggValues {
        self.setValue(&mut I, self.DAG.getUNDEF(EVT { MVT { SimpleTy: Other } }));
        return;
    }
    let mut Agg: SDValue = self.getValue(Op0);
    let mut i: u32 = 0;
    for ; i != LinearIndex; i += 1 {
        Values[i] = if IntoUndef { self.DAG.getUNDEF(AggValueVTs[i]) } else { SDValue { Node: Agg.getNode(), ResNo: Agg.getResNo() + i } };
    }
    if NumValValues {
        let mut Val: SDValue = self.getValue(Op1);
        for ; i != LinearIndex + NumValValues; i += 1 {
            Values[i] = if FromUndef { self.DAG.getUNDEF(AggValueVTs[i]) } else { SDValue { Node: Val.getNode(), ResNo: Val.getResNo() + i - LinearIndex } };
        }
    }
    for ; i != NumAggValues; i += 1 {
        Values[i] = if IntoUndef { self.DAG.getUNDEF(AggValueVTs[i]) } else { SDValue { Node: Agg.getNode(), ResNo: Agg.getResNo() + i } };
    }
    self.setValue(&mut I, self.DAG);
}

fn SelectionDAGBuilder::visitExtractValue(self, I: *ExtractValueInst) {
    let mut Indices: ArrayRef<unsigned int> = I.getIndices();
    let mut Op0: *Value = I.getOperand(0);
    let mut AggTy: *mut Type = Op0.getType();
    let mut ValTy: *mut Type = I.getType();
    let mut OutOfUndef: bool = isa(Op0);
    let mut LinearIndex: u32 = ComputeLinearIndex(AggTy, Indices, 0);
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut ValValueVTs: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
    ComputeValueVTs(TLI, self.DAG.getDataLayout(), ValTy, ValValueVTs, null, null, getZero());
    let mut NumValValues: u32 = ValValueVTs.len;
    if !NumValValues {
        self.setValue(&mut I, self.DAG.getUNDEF(EVT { MVT { SimpleTy: Other } }));
        return;
    }
    let mut Values: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { NumValValues };
    let mut Agg: SDValue = self.getValue(Op0);
    for let mut i: u32 = LinearIndex; i != LinearIndex + NumValValues; i += 1 {
        Values[i - LinearIndex] = if OutOfUndef { self.DAG.getUNDEF(Agg.getNode().getValueType(Agg.getResNo() + i)) } else { SDValue { Node: Agg.getNode(), ResNo: Agg.getResNo() + i } };
    }
    self.setValue(&mut I, self.DAG);
}

fn SelectionDAGBuilder::visitGetElementPtr(self, I: *User) {
    let mut Op0: *mut Value = I.getOperand(0);
    let mut AS: u32 = Op0.getType().getScalarType().getPointerAddressSpace();
    let mut N: SDValue = self.getValue(Op0);
    let mut dl: SDLoc = self.getCurSDLoc();
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut NW: GEPNoWrapFlags = cast(I)();
    let mut IsVectorGEP: bool = I.getType().isVectorTy();
    let mut VectorElementCount: ElementCount = if IsVectorGEP { cast(I.getType())() } else { getFixed(0) };
    for let mut GTI: gep_type_iterator = gep_type_begin(&mut I);
let mut E: gep_type_iterator = gep_type_end(&mut I); GTI != E; operator(GTI) {
        let mut Idx: *Value = GTI.getOperand();
        if GTI.getStructTypeOrNull() {
            StTy;
        } else {
            let mut Field: u32 = cast(Idx)()();
            if Field {
                let mut Offset: u64 = self.DAG.getDataLayout().getStructLayout(StTy).getElementOffset(Field).operator unsigned long long();
                let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
                if NW.hasNoUnsignedWrap() || (Offset >= 0 && NW.hasNoUnsignedSignedWrap()) {
                    operator(Flags, SDNodeFlags { Flags: NoUnsignedWrap });
                }
                Flags.setInBounds(NW.isInBounds());
                N = self.DAG.getMemBasePlusOffset(N, self.DAG.getConstant(Offset, dl, N.getValueType(), false, false), dl, Flags);
            }
        }
    }
    if IsVectorGEP && !N.getValueType().isVector() {
        let mut VT: EVT = getVectorVT(*self.Context, N.getValueType(), VectorElementCount);
        N = self.DAG.getSplat(VT, dl, N);
    }
    let mut PtrTy: MVT = TLI.getPointerTy(self.DAG.getDataLayout(), AS);
    let mut PtrMemTy: MVT = TLI.getPointerMemTy(self.DAG.getDataLayout(), AS);
    if IsVectorGEP {
        PtrTy = getVectorVT(PtrTy, VectorElementCount);
        PtrMemTy = getVectorVT(PtrMemTy, VectorElementCount);
    }
    if PtrMemTy != PtrTy && operator!(cast(I)()) {
        N = self.DAG.getPtrExtendInReg(N, dl, EVT { PtrMemTy });
    }
    self.setValue(&mut I, N);
}

fn SelectionDAGBuilder::visitAlloca(self, I: *AllocaInst) {
    if self.FuncInfo.StaticAllocaMap.count(&mut I) {
        return;
    }
    let mut dl: SDLoc = self.getCurSDLoc();
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut DL: *DataLayout = self.DAG.getDataLayout();
    let mut TySize: TypeSize = I.getAllocationBaseSize(DL);
    let mut Alignment: MaybeAlign = MaybeAlign { I.getAlign() };
    let mut AllocSize: SDValue = self.getValue(I.getArraySize());
    let mut IntPtr: EVT = EVT { TLI.getPointerTy(DL, I.getAddressSpace()) };
    if AllocSize.getValueType() != IntPtr {
        AllocSize = self.DAG.getZExtOrTrunc(AllocSize, dl, IntPtr);
    }
    AllocSize = self.DAG.getNode(MUL, dl, IntPtr, AllocSize, self.DAG.getZExtOrTrunc(self.DAG.getTypeSize(dl, EVT { i64 }, TySize), dl, IntPtr));
    let mut StackAlign: Align = self.DAG.getSubtarget().getFrameLowering().getStackAlign();
    if operator(Alignment) <= StackAlign {
        Alignment = MaybeAlign { nullopt };
    }
    let mut StackAlignMask: u64 = StackAlign.value() - 1;
    AllocSize = self.DAG.getNode(ADD, dl, AllocSize.getValueType(), AllocSize, self.DAG.getConstant(StackAlignMask, dl, IntPtr, false, false), SDNodeFlags { Flags: NoUnsignedWrap });
    AllocSize = self.DAG.getNode(AND, dl, AllocSize.getValueType(), AllocSize, self.DAG.getSignedConstant(~StackAlignMask, dl, IntPtr, false, false));
    let mut Ops: [3]SDValue = [self.getRoot(), AllocSize, self.DAG.getConstant(if Alignment { operator(Alignment).value() } else { 0 }, dl, IntPtr, false, false)];
    let mut VTs: SDVTList = self.DAG.getVTList(AllocSize.getValueType(), EVT { Other });
    let mut DSA: SDValue = self.DAG;
    self.setValue(&mut I, DSA);
    self.DAG.setRoot(DSA.getValue(1));
    assert!(self.FuncInfo.MF.getFrameInfo().hasVarSizedObjects());
}

fn getRangeMetadata(I: *Instruction) -> *MDNode {
    return I.getMetadata(MD_range);
}

fn getRange(I: *Instruction) -> optional<ConstantRange> {
    if  {
        if () {
            CR;
        } else {
            return optional<ConstantRange> { CR };
        }
    }
    if getRangeMetadata(I) {
        Range;
    } else {
        return getConstantRangeFromMetadata(*Range);
    }
    return optional<ConstantRange> { nullopt };
}

fn getNoFPClass(I: *Instruction) -> FPClassTest {
    if  {
        return ();
    }
    return fcNone;
}

fn SelectionDAGBuilder::visitLoad(self, I: *LoadInst) {
    if I.isAtomic() {
        return self.visitAtomicLoad(I);
    }
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut SV: *Value = I.getOperand(0);
    if TLI.supportSwiftError() {
        if dyn_cast(SV) {
            Arg;
        } else {
            if Arg.hasSwiftErrorAttr() {
                return self.visitLoadFromSwiftError(I);
            }
        }
        if dyn_cast(SV) {
            Alloca;
        } else {
            if Alloca.isSwiftError() {
                return self.visitLoadFromSwiftError(I);
            }
        }
    }
    let mut Ptr: SDValue = self.getValue(SV);
    let mut Ty: *mut Type = I.getType();
    let mut ValueVTs: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
    let mut MemVTs: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
    let mut Offsets: SmallVector<TypeSize, 4> = zeroed();
    ComputeValueVTs(TLI, self.DAG.getDataLayout(), Ty, ValueVTs, &mut MemVTs, operator&());
    let mut NumValues: u32 = ValueVTs.len;
    if NumValues == 0 {
        return;
    }
    let mut Alignment: Align = I.getAlign();
    let mut AAInfo: AAMDNodes = I.getAAMetadata();
    let mut Ranges: *MDNode = getRangeMetadata(I);
    let mut MemCacheHint: *MDNode = getMemCacheHintMetadata(I, 0);
    let mut isVolatile: bool = I.isVolatile();
    let mut MMOFlags: Flags = TLI.getLoadMemOperandFlags(I, self.DAG.getDataLayout(), self.AC, self.LibInfo, Default);
    let mut Root: SDValue = SDValue {};
    let mut ConstantMemory: bool = false;
    if isVolatile {
        Root = self.getRoot();
    } else if NumValues > MaxParallelChains {
        Root = self.getMemoryRoot();
    } else if self.BatchAA && self.BatchAA.pointsToConstantMemory(MemoryLocation { Ptr: SV, Size: precise(self.DAG.getDataLayout().getTypeStoreSize(Ty)), AATags: AAInfo }, false) {
        Root = self.DAG.getEntryNode();
        ConstantMemory = true;
        MMOFlags(MOInvariant);
    } else {
        Root = self.DAG.getRoot();
    }
    let mut dl: SDLoc = self.getCurSDLoc();
    if isVolatile {
        Root = TLI.prepareVolatileOrAtomicLoad(Root, dl, self.DAG);
    }
    let mut Values: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { NumValues };
    let mut Chains: SmallVector<SDValue, 4> = min(MaxParallelChains, NumValues);
    let mut ChainI: u32 = 0;
    for let mut i: u32 = 0; i != NumValues; i += 1 , ChainI += 1 {
        if ChainI == MaxParallelChains {
            assert!(self.PendingLoads.is_empty(), "PendingLoads must be serialized first");
            let mut Chain: SDValue = self.DAG(TokenFactor, dl, Other, Chains.ptr);
            Root = Chain;
            ChainI = 0;
        }
        let mut PtrInfo: MachinePointerInfo = if operator!([i]()) || [i]() { SV } else { MachinePointerInfo { 0, 0 } };
        let mut A: SDValue = self.DAG(dl, Ptr, [i]);
        let mut L: SDValue = self.DAG.getLoad(MemVTs[i], dl, Root, A, PtrInfo, MaybeAlign { Alignment }, MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: Ranges, MemCacheHint: MemCacheHint });
        Chains[ChainI] = L.getValue(1);
        if MemVTs[i] != ValueVTs[i] {
            L = self.DAG.getPtrExtOrTrunc(L, dl, ValueVTs[i]);
        }
        if I.getMetadata(MD_nofpclass) {
            NoFPClassMD;
        } else {
            let mut FPTestInt: u64 = cast(cast(NoFPClassMD.getOperand(0))())();
            if FPTestInt != fcNone {
                let mut FPTestConst: SDValue = self.DAG.getTargetConstant(FPTestInt, SDLoc {}, EVT { i32 }, false);
                L = self.DAG.getNode(AssertNoFPClass, dl, L.getValueType(), L, FPTestConst);
            }
        }
        Values[i] = L;
    }
    if !ConstantMemory {
        let mut Chain: SDValue = self.DAG(TokenFactor, dl, Other, Chains.ptr);
        if isVolatile {
            self.DAG.setRoot(Chain);
        } else {
            self.PendingLoads.push(ValueParamT { Chain });
        }
    }
    self.setValue(&mut I, self.DAG);
}

fn SelectionDAGBuilder::visitStoreToSwiftError(self, I: *StoreInst) {
    assert!(self.DAG.getTargetLoweringInfo().supportSwiftError(), "call visitStoreToSwiftError when backend supports swifterror");
    let mut ValueVTs: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
    let mut Offsets: SmallVector<uint64_t, 4> = zeroed();
    let mut SrcV: *Value = I.getOperand(0);
    ComputeValueVTs(self.DAG.getTargetLoweringInfo(), self.DAG.getDataLayout(), SrcV.getType(), ValueVTs, null, operator&(), 0);
    (((operator!(operator!((ValueVTs.len == 1 && [0] == 0 && "expect a single EVT for swifterror")))) || (_wassert(L"ValueVTs.size() == 1 && Offsets[0] == 0 && \"expect a single EVT for swifterror\"", L"llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", (5009) as u32) , 0)) as void);
    let mut Src: SDValue = self.getValue(SrcV);
    let mut VReg: Register = self.SwiftError.getOrCreateVRegDefAt(&mut I, self.FuncInfo.MBB, I.getPointerOperand());
    let mut CopyNode: SDValue = self.DAG.getCopyToReg(self.getRoot(), self.getCurSDLoc(), VReg, SDValue { Node: Src.getNode(), ResNo: Src.getResNo() });
    self.DAG.setRoot(CopyNode);
}

fn SelectionDAGBuilder::visitLoadFromSwiftError(self, I: *LoadInst) {
    assert!(self.DAG.getTargetLoweringInfo().supportSwiftError(), "call visitLoadFromSwiftError when backend supports swifterror");
    assert!(!I.isVolatile() && !I.hasMetadata(MD_nontemporal) && !I.hasMetadata(MD_invariant_load), "Support volatile, non temporal, invariant for load_from_swift_error");
    let mut SV: *Value = I.getOperand(0);
    let mut Ty: *mut Type = I.getType();
    assert!((!self.BatchAA || !self.BatchAA.pointsToConstantMemory(MemoryLocation { Ptr: SV, Size: precise(self.DAG.getDataLayout().getTypeStoreSize(Ty)), AATags: I.getAAMetadata() }, false)), "load_from_swift_error should not be constant memory");
    let mut ValueVTs: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
    let mut Offsets: SmallVector<uint64_t, 4> = zeroed();
    ComputeValueVTs(self.DAG.getTargetLoweringInfo(), self.DAG.getDataLayout(), Ty, ValueVTs, null, operator&(), 0);
    (((operator!(operator!((ValueVTs.len == 1 && [0] == 0 && "expect a single EVT for swifterror")))) || (_wassert(L"ValueVTs.size() == 1 && Offsets[0] == 0 && \"expect a single EVT for swifterror\"", L"llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", (5045) as u32) , 0)) as void);
    let mut L: SDValue = self.DAG.getCopyFromReg(self.getRoot(), self.getCurSDLoc(), self.SwiftError.getOrCreateVRegUseAt(&mut I, self.FuncInfo.MBB, SV), ValueVTs[0]);
    self.setValue(&mut I, L);
}

fn SelectionDAGBuilder::visitStore(self, I: *StoreInst) {
    if I.isAtomic() {
        return self.visitAtomicStore(I);
    }
    let mut SrcV: *Value = I.getOperand(0);
    let mut PtrV: *Value = I.getOperand(1);
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    if TLI.supportSwiftError() {
        if dyn_cast(PtrV) {
            Arg;
        } else {
            if Arg.hasSwiftErrorAttr() {
                return self.visitStoreToSwiftError(I);
            }
        }
        if dyn_cast(PtrV) {
            Alloca;
        } else {
            if Alloca.isSwiftError() {
                return self.visitStoreToSwiftError(I);
            }
        }
    }
    let mut ValueVTs: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
    let mut MemVTs: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
    let mut Offsets: SmallVector<TypeSize, 4> = zeroed();
    ComputeValueVTs(self.DAG.getTargetLoweringInfo(), self.DAG.getDataLayout(), SrcV.getType(), ValueVTs, &mut MemVTs, operator&());
    let mut NumValues: u32 = ValueVTs.len;
    if NumValues == 0 {
        return;
    }
    let mut Src: SDValue = self.getValue(SrcV);
    let mut Ptr: SDValue = self.getValue(PtrV);
    let mut Root: SDValue = if I.isVolatile() { self.getRoot() } else { self.getMemoryRoot() };
    let mut Chains: SmallVector<SDValue, 4> = min(MaxParallelChains, NumValues);
    let mut dl: SDLoc = self.getCurSDLoc();
    let mut Alignment: Align = I.getAlign();
    let mut AAInfo: AAMDNodes = I.getAAMetadata();
    let mut MemCacheHint: *MDNode = getMemCacheHintMetadata(I, I.getPointerOperandIndex());
    let mut MMOFlags: Flags = TLI.getStoreMemOperandFlags(I, self.DAG.getDataLayout());
    let mut ChainI: u32 = 0;
    for let mut i: u32 = 0; i != NumValues; i += 1 , ChainI += 1 {
        if ChainI == MaxParallelChains {
            let mut Chain: SDValue = self.DAG(TokenFactor, dl, Other, Chains.ptr);
            Root = Chain;
            ChainI = 0;
        }
        let mut PtrInfo: MachinePointerInfo = if operator!([i]()) || [i]() { PtrV } else { MachinePointerInfo { 0, 0 } };
        let mut Add: SDValue = self.DAG(dl, Ptr, [i]);
        let mut Val: SDValue = SDValue { Node: Src.getNode(), ResNo: Src.getResNo() + i };
        if MemVTs[i] != ValueVTs[i] {
            Val = self.DAG.getPtrExtOrTrunc(Val, dl, MemVTs[i]);
        }
        let mut St: SDValue = self.DAG.getStore(Root, dl, Val, Add, PtrInfo, Alignment, MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: MemCacheHint });
        Chains[ChainI] = St;
    }
    let mut StoreNode: SDValue = self.DAG(TokenFactor, dl, Other, Chains.ptr);
    self.setValue(&mut I, StoreNode);
    self.DAG.setRoot(StoreNode);
}

fn SelectionDAGBuilder::visitMaskedStore(self, I: *CallInst, IsCompressing: bool) {
    let mut sdl: SDLoc = self.getCurSDLoc();
    let mut Src0Operand: *mut Value = I.getArgOperand(0);
    let mut PtrOperand: *mut Value = I.getArgOperand(1);
    let mut MaskOperand: *mut Value = I.getArgOperand(2);
    let mut Alignment: Align = I.getParamAlign(1).valueOrOne();
    let mut Ptr: SDValue = self.getValue(PtrOperand);
    let mut Src0: SDValue = self.getValue(Src0Operand);
    let mut Mask: SDValue = self.getValue(MaskOperand);
    let mut Offset: SDValue = self.DAG.getPOISON(Ptr.getValueType());
    let mut VT: EVT = Src0.getValueType();
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut MMOFlags: Flags = MOStore;
    MMOFlags(TLI.getTargetMMOFlags(I));
    if I.hasMetadata(MD_nontemporal) {
        MMOFlags(MONonTemporal);
    }
    let mut MemCacheHint: *MDNode = getMemCacheHintMetadata(I, 1);
    let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(MachinePointerInfo { PtrOperand, 0, 0 }, MMOFlags, upperBound(VT.getStoreSize()), Alignment, MMOMetadata { AAInfo: I.getAAMetadata(), Ranges: null, MemCacheHint: MemCacheHint }, System, NotAtomic, NotAtomic);
    let mut StoreNode: SDValue = if !IsCompressing && self.TTI.hasConditionalLoadStoreForType(I.getArgOperand(0).getType(), true) { TLI.visitMaskedStore(self.DAG, sdl, self.getMemoryRoot(), MMO, Ptr, Src0, Mask) } else { self.DAG.getMaskedStore(self.getMemoryRoot(), sdl, Src0, Ptr, Offset, Mask, VT, MMO, UNINDEXED, false, IsCompressing) };
    self.DAG.setRoot(StoreNode);
    self.setValue(&mut I, StoreNode);
}

fn getUniformBase(Ptr: *Value, Base: *mut SDValue, Index: *mut SDValue, Scale: *mut SDValue, SDB: *mut SelectionDAGBuilder, CurBB: *BasicBlock, ElemSize: u64) -> bool {
    let mut DAG: *mut SelectionDAG = SDB.DAG;
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut DL: *DataLayout = DAG.getDataLayout();
    assert!(Ptr.getType().isVectorTy(), "Unexpected pointer type");
    if  {
        C() = ();
        if operator!() {
            return false;
        }
        Base = SDB.getValue();
        let mut NumElts: ElementCount = cast(Ptr.getType())();
        let mut VT: EVT = getVectorVT(*DAG.getContext(), EVT { TLI.getPointerTy(DL, 0) }, NumElts);
        Index = DAG.getConstant(0, SDB.getCurSDLoc(), VT, false, false);
        Scale = DAG.getTargetConstant(1, SDB.getCurSDLoc(), EVT { TLI.getPointerTy(DL, 0) }, false);
        return true;
    }
    let mut GEP: *GetElementPtrInst = dyn_cast(Ptr);
    if !GEP || GEP.getParent() != CurBB {
        return false;
    }
    if GEP.getNumOperands() != 2 {
        return false;
    }
    let mut BasePtr: *Value = GEP.getPointerOperand();
    let mut IndexVal: *Value = GEP.getOperand(GEP.getNumOperands() - 1);
    if BasePtr.getType().isVectorTy() || !IndexVal.getType().isVectorTy() {
        return false;
    }
    let mut ScaleVal: TypeSize = DL.getTypeAllocSize(GEP.getResultElementType());
    if ScaleVal.isScalable() {
        return false;
    }
    if ScaleVal.operator unsigned long long() != 1 && !TLI.isLegalScaleForGatherScatter(ScaleVal.getFixedValue(), ElemSize) {
        return false;
    }
    Base = SDB.getValue(BasePtr);
    Index = SDB.getValue(IndexVal);
    Scale = DAG.getTargetConstant(ScaleVal.operator unsigned long long(), SDB.getCurSDLoc(), EVT { TLI.getPointerTy(DL, 0) }, false);
    return true;
}

fn SelectionDAGBuilder::visitMaskedScatter(self, I: *CallInst) {
    let mut sdl: SDLoc = self.getCurSDLoc();
    let mut Ptr: *Value = I.getArgOperand(1);
    let mut Src0: SDValue = self.getValue(I.getArgOperand(0));
    let mut Mask: SDValue = self.getValue(I.getArgOperand(2));
    let mut VT: EVT = Src0.getValueType();
    let mut Alignment: Align = I.getParamAlign(1).valueOrOne();
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut Base: SDValue = SDValue {};
    let mut Index: SDValue = SDValue {};
    let mut Scale: SDValue = SDValue {};
    let mut UniformBase: bool = getUniformBase(Ptr, Base, Index, Scale, self, I.getParent(), VT.getScalarStoreSize());
    let mut AS: u32 = Ptr.getType().getScalarType().getPointerAddressSpace();
    let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(MachinePointerInfo { AS, 0 }, MOStore, beforeOrAfterPointer(), Alignment, MMOMetadata { AAInfo: I.getAAMetadata(), Ranges: null, MemCacheHint: null }, System, NotAtomic, NotAtomic);
    if !UniformBase {
        Base = self.DAG.getConstant(0, sdl, EVT { TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, false, false);
        Index = self.getValue(Ptr);
        Scale = self.DAG.getTargetConstant(1, sdl, EVT { TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, false);
    }
    let mut IdxVT: EVT = Index.getValueType();
    let mut EltTy: EVT = IdxVT.getVectorElementType();
    if TLI.shouldExtendGSIndex(IdxVT, EltTy) {
        let mut NewIdxVT: EVT = IdxVT.changeVectorElementType(*self.DAG.getContext(), EltTy);
        Index = self.DAG.getNode(SIGN_EXTEND, sdl, NewIdxVT, Index);
    }
    let mut Ops: [6]SDValue = [self.getMemoryRoot(), Src0, Mask, Base, Index, Scale];
    let mut Scatter: SDValue = self.DAG.getMaskedScatter;
    self.DAG.setRoot(Scatter);
    self.setValue(&mut I, Scatter);
}

fn SelectionDAGBuilder::visitMaskedLoad(self, I: *CallInst, IsExpanding: bool) {
    let mut sdl: SDLoc = self.getCurSDLoc();
    let mut PtrOperand: *mut Value = I.getArgOperand(0);
    let mut MaskOperand: *mut Value = I.getArgOperand(1);
    let mut Src0Operand: *mut Value = I.getArgOperand(2);
    let mut Alignment: Align = I.getParamAlign(0).valueOrOne();
    let mut Ptr: SDValue = self.getValue(PtrOperand);
    let mut Src0: SDValue = self.getValue(Src0Operand);
    let mut Mask: SDValue = self.getValue(MaskOperand);
    let mut Offset: SDValue = self.DAG.getPOISON(Ptr.getValueType());
    let mut VT: EVT = Src0.getValueType();
    let mut AAInfo: AAMDNodes = I.getAAMetadata();
    let mut Ranges: *MDNode = getRangeMetadata(I);
    let mut MemCacheHint: *MDNode = getMemCacheHintMetadata(I, 0);
    let mut ML: MemoryLocation = getAfter(PtrOperand, AAInfo);
    let mut AddToChain: bool = !self.BatchAA || !self.BatchAA.pointsToConstantMemory(ML, false);
    let mut InChain: SDValue = if AddToChain { self.DAG.getRoot() } else { self.DAG.getEntryNode() };
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut MMOFlags: Flags = MOLoad;
    MMOFlags(TLI.getTargetMMOFlags(I));
    if I.hasMetadata(MD_nontemporal) {
        MMOFlags(MONonTemporal);
    }
    if I.hasMetadata(MD_invariant_load) {
        MMOFlags(MOInvariant);
    }
    let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(MachinePointerInfo { PtrOperand, 0, 0 }, MMOFlags, upperBound(VT.getStoreSize()), Alignment, MMOMetadata { AAInfo: AAInfo, Ranges: Ranges, MemCacheHint: MemCacheHint }, System, NotAtomic, NotAtomic);
    let mut Load: SDValue = SDValue {};
    let mut Res: SDValue = SDValue {};
    if !IsExpanding && self.TTI.hasConditionalLoadStoreForType(Src0Operand.getType(), false) {
        Res = TLI.visitMaskedLoad(self.DAG, sdl, InChain, MMO, Load, Ptr, Src0, Mask);
    } else {
        Res = Load = self.DAG.getMaskedLoad(VT, sdl, InChain, Ptr, Offset, Mask, Src0, VT, MMO, UNINDEXED, NON_EXTLOAD, IsExpanding);
    }
    if AddToChain {
        self.PendingLoads.push(Load.getValue(1));
    }
    self.setValue(&mut I, Res);
}

fn SelectionDAGBuilder::visitSpeculativeLoad(self, I: *CallInst) {
    let mut sdl: SDLoc = self.getCurSDLoc();
    let mut PtrOperand: *mut Value = I.getArgOperand(0);
    let mut Ptr: SDValue = self.getValue(PtrOperand);
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut VT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
    let mut Alignment: Align = I.getParamAlign(0).valueOrOne();
    let mut AAInfo: AAMDNodes = I.getAAMetadata();
    let mut InChain: SDValue = self.DAG.getRoot();
    let mut MMOFlags: Flags = MOLoad;
    MMOFlags(TLI.getTargetMMOFlags(I));
    if I.hasMetadata(MD_nontemporal) {
        MMOFlags(MONonTemporal);
    }
    if I.hasMetadata(MD_invariant_load) {
        MMOFlags(MOInvariant);
    }
    let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(MachinePointerInfo { PtrOperand, 0, 0 }, MMOFlags, precise(VT.getStoreSize()), Alignment, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null }, System, NotAtomic, NotAtomic);
    let mut Load: SDValue = self.DAG.getLoad(VT, sdl, InChain, Ptr, MMO);
    self.PendingLoads.push(Load.getValue(1));
    self.setValue(&mut I, Load);
}

fn SelectionDAGBuilder::visitMaskedGather(self, I: *CallInst) {
    let mut sdl: SDLoc = self.getCurSDLoc();
    let mut Ptr: *Value = I.getArgOperand(0);
    let mut Src0: SDValue = self.getValue(I.getArgOperand(2));
    let mut Mask: SDValue = self.getValue(I.getArgOperand(1));
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut VT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
    let mut Alignment: Align = I.getParamAlign(0).valueOrOne();
    let mut Ranges: *MDNode = getRangeMetadata(I);
    let mut Root: SDValue = self.DAG.getRoot();
    let mut Base: SDValue = SDValue {};
    let mut Index: SDValue = SDValue {};
    let mut Scale: SDValue = SDValue {};
    let mut UniformBase: bool = getUniformBase(Ptr, Base, Index, Scale, self, I.getParent(), VT.getScalarStoreSize());
    let mut AS: u32 = Ptr.getType().getScalarType().getPointerAddressSpace();
    let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(MachinePointerInfo { AS, 0 }, MOLoad, beforeOrAfterPointer(), Alignment, MMOMetadata { AAInfo: I.getAAMetadata(), Ranges: Ranges, MemCacheHint: null }, System, NotAtomic, NotAtomic);
    if !UniformBase {
        Base = self.DAG.getConstant(0, sdl, EVT { TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, false, false);
        Index = self.getValue(Ptr);
        Scale = self.DAG.getTargetConstant(1, sdl, EVT { TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, false);
    }
    let mut IdxVT: EVT = Index.getValueType();
    let mut EltTy: EVT = IdxVT.getVectorElementType();
    if TLI.shouldExtendGSIndex(IdxVT, EltTy) {
        let mut NewIdxVT: EVT = IdxVT.changeVectorElementType(*self.DAG.getContext(), EltTy);
        Index = self.DAG.getNode(SIGN_EXTEND, sdl, NewIdxVT, Index);
    }
    let mut Ops: [6]SDValue = [Root, Src0, Mask, Base, Index, Scale];
    let mut Gather: SDValue = self.DAG.getMaskedGather;
    self.PendingLoads.push(Gather.getValue(1));
    self.setValue(&mut I, Gather);
}

fn SelectionDAGBuilder::visitAtomicCmpXchg(self, I: *AtomicCmpXchgInst) {
    let mut dl: SDLoc = self.getCurSDLoc();
    let mut SuccessOrdering: AtomicOrdering = I.getSuccessOrdering();
    let mut FailureOrdering: AtomicOrdering = I.getFailureOrdering();
    let mut SSID: ID = I.getSyncScopeID();
    let mut InChain: SDValue = self.getRoot();
    let mut MemVT: MVT = self.getValue(I.getCompareOperand()).getSimpleValueType();
    let mut VTs: SDVTList = self.DAG.getVTList(EVT { MemVT }, EVT { i1 }, EVT { Other });
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut Flags: Flags = TLI.getAtomicMemOperandFlags(I, self.DAG.getDataLayout());
    let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
    let mut MemCacheHint: *MDNode = getMemCacheHintMetadata(I, 0);
    let mut MMO: *mut MachineMemOperand = MF.getMachineMemOperand(MachinePointerInfo { I.getPointerOperand(), 0, 0 }, Flags, MemVT.getStoreSize(), I.getAlign(), MMOMetadata { AAInfo: AAMDNodes {}, Ranges: null, MemCacheHint: MemCacheHint }, SSID, SuccessOrdering, FailureOrdering);
    let mut L: SDValue = self.DAG.getAtomicCmpSwap(ATOMIC_CMP_SWAP_WITH_SUCCESS, dl, EVT { MemVT }, VTs, InChain, self.getValue(I.getPointerOperand()), self.getValue(I.getCompareOperand()), self.getValue(I.getNewValOperand()), MMO);
    let mut OutChain: SDValue = L.getValue(2);
    self.setValue(&mut I, L);
    self.DAG.setRoot(OutChain);
}

fn SelectionDAGBuilder::visitAtomicRMW(self, I: *AtomicRMWInst) {
    let mut dl: SDLoc = self.getCurSDLoc();
    let mut NT: NodeType = zeroed();
    match I.getOperation() {
        _ => {
            llvm_unreachable_internal("Unknown atomicrmw operation", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", 5460);
        },
        Xchg => {
            NT = ATOMIC_SWAP;
        },
        Add => {
            NT = ATOMIC_LOAD_ADD;
        },
        Sub => {
            NT = ATOMIC_LOAD_SUB;
        },
        And => {
            NT = ATOMIC_LOAD_AND;
        },
        Nand => {
            NT = ATOMIC_LOAD_NAND;
        },
        Or => {
            NT = ATOMIC_LOAD_OR;
        },
        Xor => {
            NT = ATOMIC_LOAD_XOR;
        },
        Max => {
            NT = ATOMIC_LOAD_MAX;
        },
        Min => {
            NT = ATOMIC_LOAD_MIN;
        },
        UMax => {
            NT = ATOMIC_LOAD_UMAX;
        },
        UMin => {
            NT = ATOMIC_LOAD_UMIN;
        },
        FAdd => {
            NT = ATOMIC_LOAD_FADD;
        },
        FSub => {
            NT = ATOMIC_LOAD_FSUB;
        },
        FMax => {
            NT = ATOMIC_LOAD_FMAX;
        },
        FMin => {
            NT = ATOMIC_LOAD_FMIN;
        },
        FMaximum => {
            NT = ATOMIC_LOAD_FMAXIMUM;
        },
        FMinimum => {
            NT = ATOMIC_LOAD_FMINIMUM;
        },
        FMaximumNum => {
            NT = ATOMIC_LOAD_FMAXIMUMNUM;
        },
        FMinimumNum => {
            NT = ATOMIC_LOAD_FMINIMUMNUM;
        },
        UIncWrap => {
            NT = ATOMIC_LOAD_UINC_WRAP;
        },
        UDecWrap => {
            NT = ATOMIC_LOAD_UDEC_WRAP;
        },
        USubCond => {
            NT = ATOMIC_LOAD_USUB_COND;
        },
        USubSat => {
            NT = ATOMIC_LOAD_USUB_SAT;
        },
    }
    let mut Ordering: AtomicOrdering = I.getOrdering();
    let mut SSID: ID = I.getSyncScopeID();
    let mut InChain: SDValue = self.getRoot();
    let mut MemVT: MVT = self.getValue(I.getValOperand()).getSimpleValueType();
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut Flags: Flags = TLI.getAtomicMemOperandFlags(I, self.DAG.getDataLayout());
    let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
    let mut MemCacheHint: *MDNode = getMemCacheHintMetadata(I, 0);
    let mut MMO: *mut MachineMemOperand = MF.getMachineMemOperand(MachinePointerInfo { I.getPointerOperand(), 0, 0 }, Flags, MemVT.getStoreSize(), I.getAlign(), MMOMetadata { AAInfo: AAMDNodes {}, Ranges: null, MemCacheHint: MemCacheHint }, SSID, Ordering, NotAtomic);
    let mut L: SDValue = self.DAG.getAtomic(NT, dl, EVT { MemVT }, InChain, self.getValue(I.getPointerOperand()), self.getValue(I.getValOperand()), MMO);
    let mut OutChain: SDValue = L.getValue(1);
    self.setValue(&mut I, L);
    self.DAG.setRoot(OutChain);
}

fn SelectionDAGBuilder::visitFence(self, I: *FenceInst) {
    let mut dl: SDLoc = self.getCurSDLoc();
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut Ops: [3]SDValue = [3]SDValue {};
    Ops[0] = self.getRoot();
    Ops[1] = self.DAG.getTargetConstant(I.getOrdering() as u32, dl, EVT { TLI.getFenceOperandTy(self.DAG.getDataLayout()) }, false);
    Ops[2] = self.DAG.getTargetConstant(I.getSyncScopeID(), dl, EVT { TLI.getFenceOperandTy(self.DAG.getDataLayout()) }, false);
    let mut N: SDValue = self.DAG;
    self.setValue(&mut I, N);
    self.DAG.setRoot(N);
}

fn SelectionDAGBuilder::visitAtomicLoad(self, I: *LoadInst) {
    let mut dl: SDLoc = self.getCurSDLoc();
    let mut Order: AtomicOrdering = I.getOrdering();
    let mut SSID: ID = I.getSyncScopeID();
    let mut InChain: SDValue = self.getRoot();
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut VT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
    let mut MemVT: EVT = TLI.getMemValueType(self.DAG.getDataLayout(), I.getType(), false);
    if !TLI.isAtomicAlignmentSupported(I.getAlign(), MemVT.getSizeInBits().operator unsigned long long() / 8) {
        report_fatal_error("Cannot generate unaligned atomic load", true);
    }
    let mut Flags: Flags = TLI.getLoadMemOperandFlags(I, self.DAG.getDataLayout(), self.AC, self.LibInfo, Default);
    let mut Ranges: *MDNode = getRangeMetadata(I);
    let mut MemCacheHint: *MDNode = getMemCacheHintMetadata(I, 0);
    let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(MachinePointerInfo { I.getPointerOperand(), 0, 0 }, Flags, MemVT.getStoreSize(), I.getAlign(), MMOMetadata { AAInfo: AAMDNodes {}, Ranges: Ranges, MemCacheHint: MemCacheHint }, SSID, Order, NotAtomic);
    InChain = TLI.prepareVolatileOrAtomicLoad(InChain, dl, self.DAG);
    let mut Ptr: SDValue = self.getValue(I.getPointerOperand());
    let mut L: SDValue = self.DAG.getAtomicLoad(NON_EXTLOAD, dl, MemVT, MemVT, InChain, Ptr, MMO);
    let mut OutChain: SDValue = L.getValue(1);
    if MemVT != VT {
        L = self.DAG.getPtrExtOrTrunc(L, dl, VT);
    }
    self.setValue(&mut I, L);
    self.DAG.setRoot(OutChain);
}

fn SelectionDAGBuilder::visitAtomicStore(self, I: *StoreInst) {
    let mut dl: SDLoc = self.getCurSDLoc();
    let mut Ordering: AtomicOrdering = I.getOrdering();
    let mut SSID: ID = I.getSyncScopeID();
    let mut InChain: SDValue = self.getRoot();
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut MemVT: EVT = TLI.getMemValueType(self.DAG.getDataLayout(), I.getValueOperand().getType(), false);
    if !TLI.isAtomicAlignmentSupported(I.getAlign(), MemVT.getSizeInBits().operator unsigned long long() / 8) {
        report_fatal_error("Cannot generate unaligned atomic store", true);
    }
    let mut Flags: Flags = TLI.getStoreMemOperandFlags(I, self.DAG.getDataLayout());
    let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
    let mut MemCacheHint: *MDNode = getMemCacheHintMetadata(I, I.getPointerOperandIndex());
    let mut MMO: *mut MachineMemOperand = MF.getMachineMemOperand(MachinePointerInfo { I.getPointerOperand(), 0, 0 }, Flags, MemVT.getStoreSize(), I.getAlign(), MMOMetadata { AAInfo: AAMDNodes {}, Ranges: null, MemCacheHint: MemCacheHint }, SSID, Ordering, NotAtomic);
    let mut Val: SDValue = self.getValue(I.getValueOperand());
    if Val.getValueType() != MemVT {
        Val = self.DAG.getPtrExtOrTrunc(Val, dl, MemVT);
    }
    let mut Ptr: SDValue = self.getValue(I.getPointerOperand());
    let mut OutChain: SDValue = self.DAG.getAtomic(ATOMIC_STORE, dl, MemVT, InChain, Val, Ptr, MMO);
    self.setValue(&mut I, OutChain);
    self.DAG.setRoot(OutChain);
}

fn SelectionDAGBuilder::getTargetIntrinsicCallProperties(self, I: *CallBase) -> pair<bool, bool> {
    let mut F: *Function = I.getCalledFunction();
    let mut HasChain: bool = !F.doesNotAccessMemory();
    let mut OnlyLoad: bool = HasChain && F.onlyReadsMemory() && F.willReturn() && F.doesNotThrow();
    return void { HasChain, OnlyLoad };
}

fn SelectionDAGBuilder::getTargetIntrinsicOperands(self, I: *CallBase, HasChain: bool, OnlyLoad: bool, TgtMemIntrinsicInfo: *mut IntrinsicInfo) -> SmallVector<SDValue, 8> {
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    if HasChain {
        if OnlyLoad {
            Ops.push(ValueParamT { self.DAG.getRoot() });
        } else {
            Ops.push(self.getRoot());
        }
    }
    if !TgtMemIntrinsicInfo || TgtMemIntrinsicInfo.opc == INTRINSIC_VOID || TgtMemIntrinsicInfo.opc == INTRINSIC_W_CHAIN {
        Ops.push(self.DAG.getTargetConstant(I.getIntrinsicID(), self.getCurSDLoc(), EVT { TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, false));
    }
    for let mut i: u32 = 0;
let mut e: u32 = I.arg_size(); i != e; i += 1 {
        let mut Arg: *Value = I.getArgOperand(i);
        if !I.paramHasAttr(i, ImmArg) {
            Ops.push(self.getValue(Arg));
            continue;
        }
        let mut VT: EVT = TLI.getValueType(self.DAG.getDataLayout(), Arg.getType(), true);
        if dyn_cast(Arg) {
            CI;
        } else {
            assert!(CI.getBitWidth() <= 64, "large intrinsic immediates not handled");
            Ops.push(self.DAG.getTargetConstant(*CI, SDLoc {}, VT, false));
        }
    }
    if I.getOperandBundle(OB_deactivation_symbol) {
        Bundle;
    } else {
        let mut Sym: *mut Value = operator(Bundle).Inputs[0].get();
        let mut SDSym: SDValue = self.getValue(Sym);
        SDSym = self.DAG.getDeactivationSymbol(cast(Sym));
        Ops.push(ValueParamT { SDSym });
    }
    if I.getOperandBundle(OB_convergencectrl) {
        Bundle;
    } else {
        let mut Token: *mut Value = operator(Bundle).Inputs[0].get();
        let mut ConvControlToken: SDValue = self.getValue(Token);
        assert!(Ops.back().getValueType() != EVT { Glue }, "Did not expect another glue node here.");
        ConvControlToken = self.DAG.getNode(CONVERGENCECTRL_GLUE, SDLoc {}, EVT { Glue }, ConvControlToken);
        Ops.push(ValueParamT { ConvControlToken });
    }
    return Ops;
}

fn SelectionDAGBuilder::getTargetIntrinsicVTList(self, I: *CallBase, HasChain: bool) -> SDVTList {
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut ValueVTs: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
    ComputeValueVTs(TLI, self.DAG.getDataLayout(), I.getType(), ValueVTs, null, null, getZero());
    if HasChain {
        ValueVTs.push(ValueParamT { Other });
    }
    return self.DAG;
}

fn SelectionDAGBuilder::getTargetNonMemIntrinsicNode(self, IntrinsicVT: *Type, HasChain: bool, Ops: ArrayRef<SDValue>, VTs: *SDVTList) -> SDValue {
    if !HasChain {
        return self.DAG.getNode(INTRINSIC_WO_CHAIN, self.getCurSDLoc(), VTs, ArrayRef<SDValue> { Ops });
    }
    if !IntrinsicVT.isVoidTy() {
        return self.DAG.getNode(INTRINSIC_W_CHAIN, self.getCurSDLoc(), VTs, ArrayRef<SDValue> { Ops });
    }
    return self.DAG.getNode(INTRINSIC_VOID, self.getCurSDLoc(), VTs, ArrayRef<SDValue> { Ops });
}

fn SelectionDAGBuilder::handleTargetIntrinsicRet(self, I: *CallBase, HasChain: bool, OnlyLoad: bool, Result: SDValue) -> SDValue {
    if HasChain {
        let mut Chain: SDValue = Result.getValue(Result.getNode().getNumValues() - 1);
        if OnlyLoad {
            self.PendingLoads.push(ValueParamT { Chain });
        } else {
            self.DAG.setRoot(Chain);
        }
    }
    if I.getType().isVoidTy() {
        return Result;
    }
    let mut Alignment: MaybeAlign = I.getRetAlign();
    if InsertAssertAlign() && Alignment {
        Result = self.DAG.getAssertAlign(self.getCurSDLoc(), Result, Alignment.valueOrOne());
    } else if !isa(I.getType()) {
        Result = self.lowerRangeToAssertZExt(self.DAG, I, Result);
    }
    return Result;
}

fn SelectionDAGBuilder::visitTargetIntrinsic(self, I: *CallInst, Intrinsic: u32) {
    let mut IntrinsicID: ID = Intrinsic as ID;
    if !self.DAG.getMachineFunction().getSubtarget().isIntrinsicSupported(Intrinsic) {
        let mut DL: SDLoc = self.getCurSDLoc();
        self.DAG.getContext().diagnose(DiagnosticInfoUnsupportedTargetIntrinsic { *I.getFunction(), IntrinsicID, DiagnosticLocation { DL.getDebugLoc() } });
        if HasChain && !OnlyLoad {
            self.DAG.setRoot(self.getRoot());
        }
        self.setValueToPoison(&mut I, DL);
        return;
    }
    let mut Infos: i32 = 0;
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    TLI.getTgtMemIntrinsic(I, self.DAG.getMachineFunction(), Intrinsic);
    let mut Info: *mut IntrinsicInfo = if operator!() { operator&([0]) } else { null };
    let mut Ops: SmallVector<SDValue, 8> = self.getTargetIntrinsicOperands(I, HasChain, OnlyLoad, Info);
    let mut VTs: SDVTList = self.getTargetIntrinsicVTList(I, HasChain);
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    if  {
        Flags.copyFMF(operator*());
    }
    let mut FlagsInserter: FlagInserter = FlagInserter { self.DAG, Flags };
    let mut Result: SDValue = SDValue {};
    TLI.CollectTargetIntrinsicOperands(I, Ops, self.DAG);
    if operator!() {
        let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
        let mut MMOs: i32 = 0;
        Result = self.DAG(Info.opc, self.getCurSDLoc(), VTs, Ops, Info.memVT);
    } else {
        Result = self.getTargetNonMemIntrinsicNode;
    }
    Result = self.handleTargetIntrinsicRet(I, HasChain, OnlyLoad, Result);
    self.setValue(&mut I, Result);
}

fn GetSignificand(DAG: *mut SelectionDAG, Op: SDValue, dl: *SDLoc) -> SDValue {
    let mut t1: SDValue = DAG.getNode(AND, dl, EVT { i32 }, Op, DAG.getConstant(8388607, dl, EVT { i32 }, false, false));
    let mut t2: SDValue = DAG.getNode(OR, dl, EVT { i32 }, t1, DAG.getConstant(1065353216, dl, EVT { i32 }, false, false));
    return DAG.getNode(BITCAST, dl, EVT { f32 }, t2);
}

fn GetExponent(DAG: *mut SelectionDAG, Op: SDValue, TLI: *TargetLowering, dl: *SDLoc) -> SDValue {
    let mut t0: SDValue = DAG.getNode(AND, dl, EVT { i32 }, Op, DAG.getConstant(2139095040, dl, EVT { i32 }, false, false));
    let mut t1: SDValue = DAG.getNode(SRL, dl, EVT { i32 }, t0, DAG.getShiftAmountConstant(23, EVT { i32 }, dl));
    let mut t2: SDValue = DAG.getNode(SUB, dl, EVT { i32 }, t1, DAG.getConstant(127, dl, EVT { i32 }, false, false));
    return DAG.getNode(SINT_TO_FP, dl, EVT { f32 }, t2);
}

fn getF32Constant(DAG: *mut SelectionDAG, Flt: u32, dl: *SDLoc) -> SDValue {
    return DAG.getConstantFP(APFloat { IEEEsingle(), APInt { 32, Flt, false, false } }, dl, EVT { f32 }, false);
}

fn getLimitedPrecisionExp2(t0: SDValue, dl: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut IntegerPartOfX: SDValue = DAG.getNode(FP_TO_SINT, dl, EVT { i32 }, t0);
    let mut t1: SDValue = DAG.getNode(SINT_TO_FP, dl, EVT { f32 }, IntegerPartOfX);
    let mut X: SDValue = DAG.getNode(FSUB, dl, EVT { f32 }, t0, t1);
    IntegerPartOfX = DAG.getNode(SHL, dl, EVT { i32 }, IntegerPartOfX, DAG.getShiftAmountConstant(23, EVT { i32 }, dl));
    let mut TwoToFractionalPartOfX: SDValue = SDValue {};
    if LimitFloatPrecision <= 6 {
        let mut t2: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, X, getF32Constant(DAG, 1048658692, dl));
        let mut t3: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t2, getF32Constant(DAG, 1060917448, dl));
        let mut t4: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t3, X);
        TwoToFractionalPartOfX = DAG.getNode(FADD, dl, EVT { f32 }, t4, getF32Constant(DAG, 1065311870, dl));
    } else if LimitFloatPrecision <= 12 {
        let mut t2: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, X, getF32Constant(DAG, 1034040803, dl));
        let mut t3: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t2, getF32Constant(DAG, 1046853875, dl));
        let mut t4: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t3, X);
        let mut t5: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t4, getF32Constant(DAG, 1060260615, dl));
        let mut t6: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t5, X);
        TwoToFractionalPartOfX = DAG.getNode(FADD, dl, EVT { f32 }, t6, getF32Constant(DAG, 1065351421, dl));
    } else {
        let mut t2: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, X, getF32Constant(DAG, 958705726, dl));
        let mut t3: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t2, getF32Constant(DAG, 984763271, dl));
        let mut t4: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t3, X);
        let mut t5: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t4, getF32Constant(DAG, 1008569367, dl));
        let mut t6: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t5, X);
        let mut t7: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t6, getF32Constant(DAG, 1029917213, dl));
        let mut t8: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t7, X);
        let mut t9: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t8, getF32Constant(DAG, 1047920148, dl));
        let mut t10: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t9, X);
        let mut t11: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t10, getF32Constant(DAG, 1060205108, dl));
        let mut t12: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t11, X);
        TwoToFractionalPartOfX = DAG.getNode(FADD, dl, EVT { f32 }, t12, getF32Constant(DAG, 1065353216, dl));
    }
    let mut t13: SDValue = DAG.getNode(BITCAST, dl, EVT { i32 }, TwoToFractionalPartOfX);
    return DAG.getNode(BITCAST, dl, EVT { f32 }, DAG.getNode(ADD, dl, EVT { i32 }, t13, IntegerPartOfX));
}

fn expandExp(dl: *SDLoc, Op: SDValue, DAG: *mut SelectionDAG, TLI: *TargetLowering, Flags: SDNodeFlags) -> SDValue {
    if Op.getValueType() == EVT { f32 } && LimitFloatPrecision > 0 && LimitFloatPrecision <= 18 {
        let mut t0: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, Op, DAG.getConstantFP(log2ef, dl, EVT { f32 }, false));
        return getLimitedPrecisionExp2(t0, dl, DAG);
    }
    return DAG.getNode(FEXP, dl, Op.getValueType(), Op, Flags);
}

fn expandLog(dl: *SDLoc, Op: SDValue, DAG: *mut SelectionDAG, TLI: *TargetLowering, Flags: SDNodeFlags) -> SDValue {
    if Op.getValueType() == EVT { f32 } && LimitFloatPrecision > 0 && LimitFloatPrecision <= 18 {
        let mut Op1: SDValue = DAG.getNode(BITCAST, dl, EVT { i32 }, Op);
        let mut Exp: SDValue = GetExponent(DAG, Op1, TLI, dl);
        let mut LogOfExponent: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, Exp, DAG.getConstantFP(ln2f, dl, EVT { f32 }, false));
        let mut X: SDValue = GetSignificand(DAG, Op1, dl);
        let mut LogOfMantissa: SDValue = SDValue {};
        if LimitFloatPrecision <= 6 {
            let mut t0: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, X, getF32Constant(DAG, 3195323478, dl));
            let mut t1: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t0, getF32Constant(DAG, 1068737201, dl));
            let mut t2: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t1, X);
            LogOfMantissa = DAG.getNode(FSUB, dl, EVT { f32 }, t2, getF32Constant(DAG, 1066703401, dl));
        } else if LimitFloatPrecision <= 12 {
            let mut t0: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, X, getF32Constant(DAG, 3177690838, dl));
            let mut t1: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t0, getF32Constant(DAG, 1055192248, dl));
            let mut t2: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t1, X);
            let mut t3: SDValue = DAG.getNode(FSUB, dl, EVT { f32 }, t2, getF32Constant(DAG, 1069295499, dl));
            let mut t4: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t3, X);
            let mut t5: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t4, getF32Constant(DAG, 1077186197, dl));
            let mut t6: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t5, X);
            LogOfMantissa = DAG.getNode(FSUB, dl, EVT { f32 }, t6, getF32Constant(DAG, 1071575834, dl));
        } else {
            let mut t0: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, X, getF32Constant(DAG, 3163678124, dl));
            let mut t1: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t0, getF32Constant(DAG, 1044598954, dl));
            let mut t2: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t1, X);
            let mut t3: SDValue = DAG.getNode(FSUB, dl, EVT { f32 }, t2, getF32Constant(DAG, 1063310307, dl));
            let mut t4: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t3, X);
            let mut t5: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t4, getF32Constant(DAG, 1074908656, dl));
            let mut t6: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t5, X);
            let mut t7: SDValue = DAG.getNode(FSUB, dl, EVT { f32 }, t6, getF32Constant(DAG, 1080884508, dl));
            let mut t8: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t7, X);
            let mut t9: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t8, getF32Constant(DAG, 1082628043, dl));
            let mut t10: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t9, X);
            LogOfMantissa = DAG.getNode(FSUB, dl, EVT { f32 }, t10, getF32Constant(DAG, 1074191531, dl));
        }
        return DAG.getNode(FADD, dl, EVT { f32 }, LogOfExponent, LogOfMantissa);
    }
    return DAG.getNode(FLOG, dl, Op.getValueType(), Op, Flags);
}

fn expandLog2(dl: *SDLoc, Op: SDValue, DAG: *mut SelectionDAG, TLI: *TargetLowering, Flags: SDNodeFlags) -> SDValue {
    if Op.getValueType() == EVT { f32 } && LimitFloatPrecision > 0 && LimitFloatPrecision <= 18 {
        let mut Op1: SDValue = DAG.getNode(BITCAST, dl, EVT { i32 }, Op);
        let mut LogOfExponent: SDValue = GetExponent(DAG, Op1, TLI, dl);
        let mut X: SDValue = GetSignificand(DAG, Op1, dl);
        let mut Log2ofMantissa: SDValue = SDValue {};
        if LimitFloatPrecision <= 6 {
            let mut t0: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, X, getF32Constant(DAG, 3199242208, dl));
            let mut t1: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t0, getF32Constant(DAG, 1073845347, dl));
            let mut t2: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t1, X);
            Log2ofMantissa = DAG.getNode(FSUB, dl, EVT { f32 }, t2, getF32Constant(DAG, 1071014717, dl));
        } else if LimitFloatPrecision <= 12 {
            let mut t0: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, X, getF32Constant(DAG, 3181848110, dl));
            let mut t1: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t0, getF32Constant(DAG, 1059399691, dl));
            let mut t2: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t1, X);
            let mut t3: SDValue = DAG.getNode(FSUB, dl, EVT { f32 }, t2, getF32Constant(DAG, 1074247971, dl));
            let mut t4: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t3, X);
            let mut t5: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t4, getF32Constant(DAG, 1082277423, dl));
            let mut t6: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t5, X);
            Log2ofMantissa = DAG.getNode(FSUB, dl, EVT { f32 }, t6, getF32Constant(DAG, 1075892892, dl));
        } else {
            let mut t0: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, X, getF32Constant(DAG, 3167909534, dl));
            let mut t1: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t0, getF32Constant(DAG, 1049419961, dl));
            let mut t2: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t1, X);
            let mut t3: SDValue = DAG.getNode(FSUB, dl, EVT { f32 }, t2, getF32Constant(DAG, 1067592423, dl));
            let mut t4: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t3, X);
            let mut t5: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t4, getF32Constant(DAG, 1079138083, dl));
            let mut t6: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t5, X);
            let mut t7: SDValue = DAG.getNode(FSUB, dl, EVT { f32 }, t6, getF32Constant(DAG, 1084944896, dl));
            let mut t8: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t7, X);
            let mut t9: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t8, getF32Constant(DAG, 1086561709, dl));
            let mut t10: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t9, X);
            Log2ofMantissa = DAG.getNode(FSUB, dl, EVT { f32 }, t10, getF32Constant(DAG, 1078104108, dl));
        }
        return DAG.getNode(FADD, dl, EVT { f32 }, LogOfExponent, Log2ofMantissa);
    }
    return DAG.getNode(FLOG2, dl, Op.getValueType(), Op, Flags);
}

fn expandLog10(dl: *SDLoc, Op: SDValue, DAG: *mut SelectionDAG, TLI: *TargetLowering, Flags: SDNodeFlags) -> SDValue {
    if Op.getValueType() == EVT { f32 } && LimitFloatPrecision > 0 && LimitFloatPrecision <= 18 {
        let mut Op1: SDValue = DAG.getNode(BITCAST, dl, EVT { i32 }, Op);
        let mut Exp: SDValue = GetExponent(DAG, Op1, TLI, dl);
        let mut LogOfExponent: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, Exp, getF32Constant(DAG, 1050288282, dl));
        let mut X: SDValue = GetSignificand(DAG, Op1, dl);
        let mut Log10ofMantissa: SDValue = SDValue {};
        if LimitFloatPrecision <= 6 {
            let mut t0: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, X, getF32Constant(DAG, 3184826899, dl));
            let mut t1: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t0, getF32Constant(DAG, 1058801545, dl));
            let mut t2: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t1, X);
            Log10ofMantissa = DAG.getNode(FSUB, dl, EVT { f32 }, t2, getF32Constant(DAG, 1057035008, dl));
        } else if LimitFloatPrecision <= 12 {
            let mut t0: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, X, getF32Constant(DAG, 1027809073, dl));
            let mut t1: SDValue = DAG.getNode(FSUB, dl, EVT { f32 }, t0, getF32Constant(DAG, 1050812338, dl));
            let mut t2: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t1, X);
            let mut t3: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t2, getF32Constant(DAG, 1063969330, dl));
            let mut t4: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t3, X);
            Log10ofMantissa = DAG.getNode(FSUB, dl, EVT { f32 }, t4, getF32Constant(DAG, 1059452867, dl));
        } else {
            let mut t0: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, X, getF32Constant(DAG, 1012748750, dl));
            let mut t1: SDValue = DAG.getNode(FSUB, dl, EVT { f32 }, t0, getF32Constant(DAG, 1040214106, dl));
            let mut t2: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t1, X);
            let mut t3: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t2, getF32Constant(DAG, 1056663448, dl));
            let mut t4: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t3, X);
            let mut t5: SDValue = DAG.getNode(FSUB, dl, EVT { f32 }, t4, getF32Constant(DAG, 1065931154, dl));
            let mut t6: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t5, X);
            let mut t7: SDValue = DAG.getNode(FADD, dl, EVT { f32 }, t6, getF32Constant(DAG, 1069822316, dl));
            let mut t8: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, t7, X);
            Log10ofMantissa = DAG.getNode(FSUB, dl, EVT { f32 }, t8, getF32Constant(DAG, 1062719088, dl));
        }
        return DAG.getNode(FADD, dl, EVT { f32 }, LogOfExponent, Log10ofMantissa);
    }
    return DAG.getNode(FLOG10, dl, Op.getValueType(), Op, Flags);
}

fn expandExp2(dl: *SDLoc, Op: SDValue, DAG: *mut SelectionDAG, TLI: *TargetLowering, Flags: SDNodeFlags) -> SDValue {
    if Op.getValueType() == EVT { f32 } && LimitFloatPrecision > 0 && LimitFloatPrecision <= 18 {
        return getLimitedPrecisionExp2(Op, dl, DAG);
    }
    return DAG.getNode(FEXP2, dl, Op.getValueType(), Op, Flags);
}

fn expandPow(dl: *SDLoc, LHS: SDValue, RHS: SDValue, DAG: *mut SelectionDAG, TLI: *TargetLowering, Flags: SDNodeFlags) -> SDValue {
    let mut IsExp10: bool = false;
    if LHS.getValueType() == EVT { f32 } && RHS.getValueType() == EVT { f32 } && LimitFloatPrecision > 0 && LimitFloatPrecision <= 18 {
        if dyn_cast(LHS) {
            LHSC;
        } else {
            let mut Ten: APFloat = APFloat { U: 10.0 };
            IsExp10 = LHSC.isExactlyValue(Ten);
        }
    }
    if IsExp10 {
        let mut t0: SDValue = DAG.getNode(FMUL, dl, EVT { f32 }, RHS, getF32Constant(DAG, 1079286392, dl));
        return getLimitedPrecisionExp2(t0, dl, DAG);
    }
    return DAG.getNode(FPOW, dl, LHS.getValueType(), LHS, RHS, Flags);
}

fn ExpandPowI(DL: *SDLoc, LHS: SDValue, RHS: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    if dyn_cast(RHS) {
        RHSC;
    } else {
        let mut Val: u32 = RHSC.getSExtValue();
        if Val == 0 {
            return DAG.getConstantFP(1.0, DL, LHS.getValueType(), false);
        }
        if DAG.getTargetLoweringInfo().isBeneficialToExpandPowI(Val, DAG.shouldOptForSize()) {
            if Val as i32 < 0 {
                Val = -Val;
            }
            let mut Res: SDValue = SDValue {};
            let mut CurSquare: SDValue = LHS;
            while Val {
                if Val & 1 {
                    if Res.getNode() {
                        Res = DAG.getNode(FMUL, DL, Res.getValueType(), Res, CurSquare);
                    } else {
                        Res = CurSquare;
                    }
                }
                CurSquare = DAG.getNode(FMUL, DL, CurSquare.getValueType(), CurSquare, CurSquare);
                Val >>= 1;
            }
            if RHSC.getSExtValue() < 0 {
                Res = DAG.getNode(FDIV, DL, LHS.getValueType(), DAG.getConstantFP(1.0, DL, LHS.getValueType(), false), Res);
            }
            return Res;
        }
    }
    return DAG.getNode(FPOWI, DL, LHS.getValueType(), LHS, RHS);
}

fn expandDivFix(Opcode: u32, DL: *SDLoc, LHS: SDValue, RHS: SDValue, Scale: SDValue, DAG: *mut SelectionDAG, TLI: *TargetLowering) -> SDValue {
    let mut VT: EVT = LHS.getValueType();
    let mut Signed: bool = Opcode == SDIVFIX || Opcode == SDIVFIXSAT;
    let mut Saturating: bool = Opcode == SDIVFIXSAT || Opcode == UDIVFIXSAT;
    let mut Ctx: *mut LLVMContext = *DAG.getContext();
    let mut ScaleInt: u32 = operator(Scale).getAsZExtVal();
    if (ScaleInt > 0 || (Saturating && Signed)) && (TLI.isTypeLegal(VT) || (VT.isVector() && TLI.isTypeLegal(VT.getVectorElementType()))) {
        let mut Action: LegalizeAction = TLI.getFixedPointOperationAction(Opcode, VT, ScaleInt);
        if Action != Legal && Action != Custom {
            let mut PromVT: EVT = EVT {};
            if VT.isScalarInteger() {
                PromVT = getIntegerVT(Ctx, VT.getSizeInBits().operator unsigned long long() + 1);
            } else if VT.isVector() {
                PromVT = VT.getVectorElementType();
                PromVT = getIntegerVT(Ctx, PromVT.getSizeInBits().operator unsigned long long() + 1);
                PromVT = getVectorVT(Ctx, PromVT, VT.getVectorElementCount());
            } else {
                llvm_unreachable_internal("Wrong VT for DIVFIX?", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", 6392);
            }
            LHS = DAG.getExtOrTrunc(Signed, LHS, DL, PromVT);
            RHS = DAG.getExtOrTrunc(Signed, RHS, DL, PromVT);
            let mut ShiftTy: EVT = TLI.getShiftAmountTy(PromVT, DAG.getDataLayout());
            if Saturating {
                LHS = DAG.getNode(SHL, DL, PromVT, LHS, DAG.getConstant(1, DL, ShiftTy, false, false));
            }
            let mut Res: SDValue = DAG.getNode(Opcode, DL, PromVT, LHS, RHS, Scale);
            if Saturating {
                Res = DAG.getNode(if Signed { SRA } else { SRL }, DL, PromVT, Res, DAG.getConstant(1, DL, ShiftTy, false, false));
            }
            return DAG.getZExtOrTrunc(Res, DL, VT);
        }
    }
    return DAG.getNode(Opcode, DL, VT, LHS, RHS, Scale);
}

fn getUnderlyingArgRegs(Regs: *mut pair<Register, TypeSize>>, N: *SDValue) {
    match N.getOpcode() {
        CopyFromReg => {
            let mut Op: SDValue = N.getOperand(1);
            Regs()(cast(Op)(), Op.getValueType().getSizeInBits());
            return;
        },
        BITCAST => {
            AssertZext;
        },
        BUILD_PAIR => {
            BUILD_VECTOR;
        },
        _ => {
            return;
        },
    }
}

fn SelectionDAGBuilder::EmitFuncArgumentDbgValue(self, V: *Value, Variable: *mut DILocalVariable, Expr: *mut DIExpression, DL: *mut DILocation, Kind: FuncArgumentDbgValueKind, N: *SDValue) -> bool {
    let mut Arg: *Argument = dyn_cast(V);
    if !Arg {
        return false;
    }
    let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
    let mut TII: *TargetInstrInfo = self.DAG.getSubtarget().getInstrInfo();
    let mut MakeVRegDbgValue: Closure_7 = Closure_7 { MF: &mut MF, TII: &mut TII, DL: &mut DL, Variable: &mut Variable };
    if Kind == Value {
        let mut IsInEntryBlock: bool = self.FuncInfo.MBB == &mut self.FuncInfo.MF.front();
        if !IsInEntryBlock {
            return false;
        }
        let mut VariableIsFunctionInputArg: bool = Variable.isParameter() && !DL.getInlinedAt();
        let mut IsInPrologue: bool = self.SDNodeOrder == LowestSDNodeOrder;
        if !IsInPrologue && !VariableIsFunctionInputArg {
            return false;
        }
        if VariableIsFunctionInputArg {
            let mut ArgNo: u32 = Arg.getArgNo();
            if ArgNo >= self.FuncInfo.DescribedArgs.len {
                self.FuncInfo.DescribedArgs.resize(ArgNo + 1, false);
            } else if !IsInPrologue && self.FuncInfo.DescribedArgs.test(ArgNo) {
                return !self.NodeMap[V].getNode();
            }
            self.FuncInfo.DescribedArgs.set(ArgNo);
        }
    }
    let mut IsIndirect: bool = false;
    let mut Op: optional<MachineOperand> = zeroed();
    let mut FI: i32 = self.FuncInfo.getArgumentFrameIndex(Arg);
    if FI != max() {
        Op() = CreateFI(FI);
    }
    let mut ArgRegsAndSizes: pair<Register, TypeSize>, 8> = zeroed();
    if operator!() && N.getNode() {
        getUnderlyingArgRegs(N);
        let mut Reg: Register = Register { Reg: 0 };
        if ArgRegsAndSizes()() == 1 {
            Reg = ();
        }
        if Reg.operator unsigned int() && Reg.isVirtual() {
            let mut RegInfo: *mut MachineRegisterInfo = MF.getRegInfo();
            let mut PR: Register = Register { Reg: RegInfo.getLiveInPhysReg(Reg) };
            if PR.operator unsigned int() {
                Reg = PR;
            }
        }
        if Reg.operator unsigned int() {
            Op() = CreateReg(Reg, false, false, false, false, false, false, 0, false, false, false);
            IsIndirect = Kind != Value;
        }
    }
    if operator!() && N.getNode() {
        let mut LCandidate: SDValue = peekThroughBitcasts(N);
        if dyn_cast(LCandidate.getNode()) {
            LNode;
        } else if dyn_cast(LNode.getBasePtr().getNode()) {
            FINode;
        } else {
            Op() = CreateFI(FINode.getIndex());
        }
    }
    if operator!() {
        let mut splitMultiRegDbgValue: Closure_8 = Closure_8 { Expr: &mut Expr, cap_1: self, Variable: &mut Variable, V: &mut V, DL: &mut DL, MakeVRegDbgValue: &mut MakeVRegDbgValue, Kind: &mut Kind };
        let mut VMI: i32 = self.FuncInfo.ValueMap.find(V);
        if VMI() != self.FuncInfo.ValueMap.end() {
            let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
            let mut RFV: RegsForValue = V.getContext();
            if RFV.occupiesMultipleRegs() {
                return splitMultiRegDbgValue(RFV()());
            }
            Op() = CreateReg(false);
            IsIndirect = Kind != Value;
        } else if ArgRegsAndSizes()() > 1 {
            return splitMultiRegDbgValue();
        }
    }
    if operator!() {
        return false;
    }
    assert!(Variable.isValidLocationForIntrinsic(DL), "Expected inlined-at fields to agree");
    let mut NewMI: *mut MachineInstr = null;
    if Op()() {
        NewMI = MakeVRegDbgValue(Expr, IsIndirect);
    } else {
        NewMI = BuildMI(MF, DL, TII.get(DBG_VALUE), true, operator*(), Variable, Expr);
    }
    self.FuncInfo.ArgDbgValues.push(NewMI);
    return true;
}

fn SelectionDAGBuilder::getDbgValue(self, N: SDValue, Variable: *mut DILocalVariable, Expr: *mut DIExpression, dl: *DebugLoc, DbgSDNodeOrder: u32) -> *mut SDDbgValue {
    if  {
        return self.DAG(Variable, Expr, false, dl, DbgSDNodeOrder);
    }
    return self.DAG.getDbgValue(Variable, Expr, N.getNode(), N.getResNo(), false, dl, DbgSDNodeOrder);
}

fn FixedPointIntrinsicToOpcode(Intrinsic: u32) -> u32 {
    match Intrinsic {
        smul_fix => {
            return SMULFIX;
        },
        umul_fix => {
            return UMULFIX;
        },
        smul_fix_sat => {
            return SMULFIXSAT;
        },
        umul_fix_sat => {
            return UMULFIXSAT;
        },
        sdiv_fix => {
            return SDIVFIX;
        },
        udiv_fix => {
            return UDIVFIX;
        },
        sdiv_fix_sat => {
            return SDIVFIXSAT;
        },
        udiv_fix_sat => {
            return UDIVFIXSAT;
        },
        _ => {
            llvm_unreachable_internal("Unhandled fixed point intrinsic", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", 6714);
        },
    }
}

fn FindPreallocatedCall(PreallocatedSetup: *Value) -> *CallBase {
    (((operator!(operator!((cast(PreallocatedSetup)()() == call_preallocated_setup && "expected call_preallocated_setup Value")))) || (_wassert(L"cast<CallBase>(PreallocatedSetup) ->getCalledFunction() ->getIntrinsicID() == Intrinsic::call_preallocated_setup && \"expected call_preallocated_setup Value\"", L"llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", (6724) as u32) , 0)) as void);
    for U in PreallocatedSetup.users() {
        let mut UseCall: *mut auto = cast(U);
        let mut Fn: *Function = ();
        if !Fn || Fn.getIntrinsicID() != call_preallocated_arg {
            return ;
        }
    }
    llvm_unreachable_internal("expected corresponding call to preallocated setup/arg", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", 6732);
}

fn SelectionDAGBuilder::visitEntryValueDbgValue(self, Values: ArrayRef<const Value *>, Variable: *mut DILocalVariable, Expr: *mut DIExpression, DbgLoc: DebugLoc) -> bool {
    if !Expr.isEntryValue() || !hasSingleElement(Values) {
        return false;
    }
    let mut Arg: *Argument = cast(Values[0]);
    assert!(Arg.hasAttribute(SwiftAsync));
    let mut ArgIt: auto = self.FuncInfo.ValueMap.find(Arg);
    if ArgIt() == self.FuncInfo.ValueMap.end() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("isel", 1) {
                dbgs() << "Dropping dbg.value: expression is entry_value but couldn't find an associated register for the Argument\n";
            }
        }
            if !(false) { break; }
        }
        return true;
    }
    let mut ArgVReg: Register = ();
    for x in self.FuncInfo.RegInfo.liveins() {
        if ArgVReg ==  || ArgVReg ==  {
            let mut SDV: *mut SDDbgValue = self.DAG.getVRegDbgValue(Variable, Expr, false, DbgLoc, self.SDNodeOrder);
            self.DAG.AddDbgValue(SDV, false);
            return true;
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("isel", 1) {
            dbgs() << "Dropping dbg.value: expression is entry_value but couldn't find a physical register\n";
        }
    }
        if !(false) { break; }
    }
    return true;
}

fn SelectionDAGBuilder::visitConvergenceControl(self, I: *CallInst, Intrinsic: u32) {
    let mut sdl: SDLoc = self.getCurSDLoc();
    match Intrinsic {
        experimental_convergence_anchor => {
            self.setValue(&mut I, self.DAG.getNode(CONVERGENCECTRL_ANCHOR, sdl, EVT { Untyped }));
        },
        experimental_convergence_entry => {
            self.setValue(&mut I, self.DAG.getNode(CONVERGENCECTRL_ENTRY, sdl, EVT { Untyped }));
        },
        experimental_convergence_loop => {
            let mut Bundle: optional<OperandBundleUse> = I.getOperandBundle(OB_convergencectrl);
            let mut Token: *mut Value = operator(Bundle).Inputs[0].get();
            self.setValue(&mut I, self.DAG.getNode(CONVERGENCECTRL_LOOP, sdl, EVT { Untyped }, self.getValue(Token)));
            break;
        },
    }
}

fn SelectionDAGBuilder::visitVectorHistogram(self, I: *CallInst, IntrinsicID: u32) {
    assert!(IntrinsicID == experimental_vector_histogram_add, "Tried to lower unsupported histogram type");
    let mut sdl: SDLoc = self.getCurSDLoc();
    let mut Ptr: *mut Value = I.getOperand(0);
    let mut Inc: SDValue = self.getValue(I.getOperand(1));
    let mut Mask: SDValue = self.getValue(I.getOperand(2));
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut TargetDL: DataLayout = self.DAG.getDataLayout();
    let mut VT: EVT = Inc.getValueType();
    let mut Alignment: Align = self.DAG.getEVTAlign(VT);
    let mut Ranges: *MDNode = getRangeMetadata(I);
    let mut Root: SDValue = self.DAG.getRoot();
    let mut Base: SDValue = SDValue {};
    let mut Index: SDValue = SDValue {};
    let mut Scale: SDValue = SDValue {};
    let mut UniformBase: bool = getUniformBase(Ptr, Base, Index, Scale, self, I.getParent(), VT.getScalarStoreSize());
    let mut AS: u32 = Ptr.getType().getScalarType().getPointerAddressSpace();
    let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction();
    if !UniformBase {
        Base = self.DAG.getConstant(0, sdl, EVT { TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, false, false);
        Index = self.getValue(Ptr);
        Scale = self.DAG.getTargetConstant(1, sdl, EVT { TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, false);
    }
    let mut IdxVT: EVT = Index.getValueType();
    let mut MustExtendIndex: bool = VT.getScalarSizeInBits() > IdxVT.getScalarSizeInBits();
    let mut EltTy: EVT = if MustExtendIndex { VT } else { IdxVT.getVectorElementType() };
    if MustExtendIndex || TLI.shouldExtendGSIndex(IdxVT, EltTy) {
        let mut NewIdxVT: EVT = IdxVT.changeVectorElementType(*self.DAG.getContext(), EltTy);
        Index = self.DAG.getNode(SIGN_EXTEND, sdl, NewIdxVT, Index);
    }
    let mut ID: SDValue = self.DAG.getTargetConstant(IntrinsicID, sdl, EVT { i32 }, false);
    let mut Ops: [7]SDValue = [Root, Inc, Mask, Base, Index, Scale, ID];
    let mut Histogram: SDValue = self.DAG.getMaskedHistogram;
    self.setValue(&mut I, Histogram);
    self.DAG.setRoot(Histogram);
}

fn SelectionDAGBuilder::visitVectorExtractLastActive(self, I: *CallInst, Intrinsic: u32) {
    assert!(Intrinsic == experimental_vector_extract_last_active, "Tried lowering invalid vector extract last");
    let mut sdl: SDLoc = self.getCurSDLoc();
    let mut Layout: *DataLayout = self.DAG.getDataLayout();
    let mut Data: SDValue = self.getValue(I.getOperand(0));
    let mut Mask: SDValue = self.getValue(I.getOperand(1));
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut ResVT: EVT = TLI.getValueType(Layout, I.getType(), false);
    let mut ExtVT: EVT = EVT { TLI.getVectorIdxTy(Layout) };
    let mut Idx: SDValue = self.DAG.getNode(VECTOR_FIND_LAST_ACTIVE, sdl, ExtVT, Mask);
    let mut Result: SDValue = self.DAG.getNode(EXTRACT_VECTOR_ELT, sdl, ResVT, Data, Idx);
    let mut Default: *mut Value = I.getOperand(2);
    if !isa(Default) && !isa(Default) {
        let mut PassThru: SDValue = self.getValue(Default);
        let mut BoolVT: EVT = Mask.getValueType().getScalarType();
        let mut AnyActive: SDValue = self.DAG.getNode(VECREDUCE_OR, sdl, BoolVT, Mask);
        Result = self.DAG.getSelect(sdl, ResVT, AnyActive, Result, PassThru, SDNodeFlags { Flags: None });
    }
    self.setValue(&mut I, Result);
}

fn SelectionDAGBuilder::visitIntrinsicCall(self, I: *CallInst, Intrinsic: u32) {
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut sdl: SDLoc = self.getCurSDLoc();
    let mut dl: DebugLoc = self.getCurDebugLoc();
    let mut Res: SDValue = SDValue {};
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    if  {
        Flags.copyFMF(operator*());
    }
    match Intrinsic {
        _ => {
            self.visitTargetIntrinsic(I, Intrinsic);
        },
        vscale => {
            let mut VT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
            self.setValue(&mut I, self.DAG.getVScale(sdl, VT, APInt { VT.getSizeInBits().operator unsigned long long(), 1, false, false }));
            return;
        },
        vastart => {
            self.visitVAStart(I);
        },
        vaend => {
            self.visitVAEnd(I);
        },
        vacopy => {
            self.visitVACopy(I);
        },
        returnaddress => {
            self.setValue(&mut I, self.DAG.getNode(RETURNADDR, sdl, TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false), self.getValue(I.getArgOperand(0))));
        },
        addressofreturnaddress => {
            self.setValue(&mut I, self.DAG.getNode(ADDROFRETURNADDR, sdl, TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false)));
        },
        sponentry => {
            self.setValue(&mut I, self.DAG.getNode(SPONENTRY, sdl, TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false)));
        },
        frameaddress => {
            self.setValue(&mut I, self.DAG.getNode(FRAMEADDR, sdl, EVT { TLI.getFrameIndexTy(self.DAG.getDataLayout()) }, self.getValue(I.getArgOperand(0))));
        },
        read_volatile_register => {
            read_register;
        },
        write_register => {
            let mut Reg: *mut Value = I.getArgOperand(0);
            let mut RegValue: *mut Value = I.getArgOperand(1);
            let mut Chain: SDValue = self.getRoot();
            let mut RegName: SDValue = self.DAG.getMDNode(cast(cast(Reg)()));
            self.DAG.setRoot(self.DAG.getNode(WRITE_REGISTER, sdl, EVT { Other }, Chain, RegName, self.getValue(RegValue)));
            return;
        },
        write_volatile_register => {
            let mut Reg: *mut Value = I.getArgOperand(0);
            let mut RegValue: *mut Value = I.getArgOperand(1);
            let mut Chain: SDValue = self.getRoot();
            let mut MD: *MDNode = cast(cast(Reg)());
            let mut RegName: SDValue = self.DAG.getMDNode(MD);
            let mut VT: EVT = TLI.getValueType(self.DAG.getDataLayout(), RegValue.getType(), false);
            let mut WriteChain: SDValue = self.DAG.getNode(WRITE_REGISTER, sdl, EVT { Other }, Chain, RegName, self.getValue(RegValue));
            let mut RegStr: *MDString = cast(MD.getOperand(0));
            let mut Ty: LLT = if VT.isSimple() { getLLTForMVT(VT.getSimpleVT()) } else { LLT {} };
            let mut MF: *MachineFunction = self.DAG.getMachineFunction();
            let mut PhysReg: Register = TLI.getRegisterByName(RegStr.getString().ptr, Ty, MF);
            if PhysReg.isValid() {
                let mut TRI: *TargetRegisterInfo = MF.getSubtarget().getRegisterInfo();
                let mut RC: *TargetRegisterClass = TRI.getMinimalPhysRegClass(PhysReg.operator MCRegister());
                let mut RegVT: MVT = MVT { SimpleTy: *TRI.legalclasstypes_begin(*RC) };
                self.DAG.setRoot(self.DAG.getNode(FAKE_USE, sdl, EVT { Other }, ArrayRef<SDValue> { [WriteChain, self.DAG.getRegister(PhysReg, EVT { RegVT })] }));
            } else {
                self.DAG.setRoot(WriteChain);
            }
            return;
        },
        memcpy => {
            memcpy_inline;
        },
        memset => {
            memset_inline;
        },
        memmove => {
            let mut MMI: *auto = cast(I);
            let mut Op1: SDValue = self.getValue(I.getArgOperand(0));
            let mut Op2: SDValue = self.getValue(I.getArgOperand(1));
            let mut Op3: SDValue = self.getValue(I.getArgOperand(2));
            let mut DstAlign: Align = ()();
            let mut SrcAlign: Align = ()();
            let mut isVol: bool = ();
            let mut Root: SDValue = if isVol { self.getRoot() } else { self.getMemoryRoot() };
            let mut MM: SDValue = self.DAG.getMemmove(Root, sdl, Op1, Op2, Op3, DstAlign, SrcAlign, isVol, &mut I, optional<bool> { nullopt }, MachinePointerInfo { I.getArgOperand(0), 0, 0 }, MachinePointerInfo { I.getArgOperand(1), 0, 0 }, I.getAAMetadata(), self.BatchAA);
            self.updateDAGForMaybeTailCall(MM);
            return;
        },
        memcpy_element_unordered_atomic => {
            let mut MI: *mut auto = cast(I);
            let mut Dst: SDValue = self.getValue();
            let mut Src: SDValue = self.getValue();
            let mut Length: SDValue = self.getValue();
            let mut LengthTy: *mut Type = ()();
            let mut ElemSz: u32 = ();
            let mut isTC: bool = I.isTailCall() && isInTailCallPosition(I, self.DAG.getTarget(), false);
            let mut MC: SDValue = self.DAG.getAtomicMemcpy(self.getRoot(), sdl, Dst, Src, Length, LengthTy, ElemSz, isTC);
            self.updateDAGForMaybeTailCall(MC);
            return;
        },
        memmove_element_unordered_atomic => {
            let mut MI: *mut auto = cast(I);
            let mut Dst: SDValue = self.getValue();
            let mut Src: SDValue = self.getValue();
            let mut Length: SDValue = self.getValue();
            let mut LengthTy: *mut Type = ()();
            let mut ElemSz: u32 = ();
            let mut isTC: bool = I.isTailCall() && isInTailCallPosition(I, self.DAG.getTarget(), false);
            let mut MC: SDValue = self.DAG.getAtomicMemmove(self.getRoot(), sdl, Dst, Src, Length, LengthTy, ElemSz, isTC);
            self.updateDAGForMaybeTailCall(MC);
            return;
        },
        memset_element_unordered_atomic => {
            let mut MI: *mut auto = cast(I);
            let mut Dst: SDValue = self.getValue();
            let mut Val: SDValue = self.getValue();
            let mut Length: SDValue = self.getValue();
            let mut LengthTy: *mut Type = ()();
            let mut ElemSz: u32 = ();
            let mut isTC: bool = I.isTailCall() && isInTailCallPosition(I, self.DAG.getTarget(), false);
            let mut MC: SDValue = self.DAG.getAtomicMemset(self.getRoot(), sdl, Dst, Val, Length, LengthTy, ElemSz, isTC);
            self.updateDAGForMaybeTailCall(MC);
            return;
        },
        call_preallocated_setup => {
            let mut PreallocatedCall: *CallBase = FindPreallocatedCall(&mut I);
            let mut SrcValue: SDValue = self.DAG.getSrcValue(PreallocatedCall);
            let mut Res: SDValue = self.DAG.getNode(PREALLOCATED_SETUP, sdl, EVT { Other }, self.getRoot(), SrcValue);
            self.setValue(&mut I, Res);
            self.DAG.setRoot(Res);
            return;
        },
        call_preallocated_arg => {
            let mut PreallocatedCall: *CallBase = FindPreallocatedCall(I.getOperand(0));
            let mut SrcValue: SDValue = self.DAG.getSrcValue(PreallocatedCall);
            let mut Ops: [3]SDValue = [3]SDValue {};
            Ops[0] = self.getRoot();
            Ops[1] = SrcValue;
            Ops[2] = self.DAG(operator*(cast(I.getArgOperand(1))), sdl, i32);
            let mut Res: SDValue = self.DAG;
            self.setValue(&mut I, Res);
            self.DAG.setRoot(Res.getValue(1));
            return;
        },
        eh_typeid_for => {
            let mut GV: *mut GlobalValue = ExtractTypeInfo(I.getArgOperand(0));
            let mut TypeID: u32 = self.DAG.getMachineFunction().getTypeIDFor(GV);
            Res = self.DAG.getConstant(TypeID, sdl, EVT { i32 }, false, false);
            self.setValue(&mut I, Res);
            return;
        },
        eh_return_i32 => {
            eh_return_i64;
        },
        eh_unwind_init => {
            self.DAG.getMachineFunction().setCallsUnwindInit(true);
        },
        eh_dwarf_cfa => {
            self.setValue(&mut I, self.DAG.getNode(EH_DWARF_CFA, sdl, EVT { TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, self.getValue(I.getArgOperand(0))));
        },
        eh_sjlj_callsite => {
            let mut CI: *mut ConstantInt = cast(I.getArgOperand(0));
            assert!(self.FuncInfo.getCurrentCallSite() == 0, "Overlapping call sites!");
            self.FuncInfo.setCurrentCallSite(CI.getZExtValue());
            return;
        },
        eh_sjlj_functioncontext => {
            let mut MFI: *mut MachineFrameInfo = self.DAG.getMachineFunction().getFrameInfo();
            let mut FnCtx: *mut AllocaInst = cast(I.getArgOperand(0).stripPointerCasts());
            let mut FI: i32 = self.FuncInfo.StaticAllocaMap[FnCtx];
            MFI.setFunctionContextIndex(FI);
            return;
        },
        eh_sjlj_setjmp => {
            let mut Ops: [2]SDValue = [2]SDValue {};
            Ops[0] = self.getRoot();
            Ops[1] = self.getValue(I.getArgOperand(0));
            let mut Op: SDValue = self.DAG;
            self.setValue(&mut I, Op.getValue(0));
            self.DAG.setRoot(Op.getValue(1));
            return;
        },
        eh_sjlj_longjmp => {
            self.DAG.setRoot(self.DAG.getNode(EH_SJLJ_LONGJMP, sdl, EVT { Other }, self.getRoot(), self.getValue(I.getArgOperand(0))));
        },
        eh_sjlj_setup_dispatch => {
            self.DAG.setRoot(self.DAG.getNode(EH_SJLJ_SETUP_DISPATCH, sdl, EVT { Other }, self.getRoot()));
        },
        masked_gather => {
            self.visitMaskedGather(I);
        },
        masked_load => {
            self.visitMaskedLoad(I, false);
        },
        masked_scatter => {
            self.visitMaskedScatter(I);
        },
        masked_store => {
            self.visitMaskedStore(I, false);
        },
        masked_expandload => {
            self.visitMaskedLoad(I, true);
        },
        masked_compressstore => {
            self.visitMaskedStore(I, true);
        },
        speculative_load => {
            self.visitSpeculativeLoad(I);
        },
        powi => {
            self.setValue(&mut I, ExpandPowI(sdl, self.getValue(I.getArgOperand(0)), self.getValue(I.getArgOperand(1)), self.DAG));
        },
        log => {
            self.setValue(&mut I, expandLog(sdl, self.getValue(I.getArgOperand(0)), self.DAG, TLI, Flags));
        },
        log2 => {
            self.setValue(&mut I, expandLog2(sdl, self.getValue(I.getArgOperand(0)), self.DAG, TLI, Flags));
        },
        log10 => {
            self.setValue(&mut I, expandLog10(sdl, self.getValue(I.getArgOperand(0)), self.DAG, TLI, Flags));
        },
        exp => {
            self.setValue(&mut I, expandExp(sdl, self.getValue(I.getArgOperand(0)), self.DAG, TLI, Flags));
        },
        exp2 => {
            self.setValue(&mut I, expandExp2(sdl, self.getValue(I.getArgOperand(0)), self.DAG, TLI, Flags));
        },
        pow => {
            self.setValue(&mut I, expandPow(sdl, self.getValue(I.getArgOperand(0)), self.getValue(I.getArgOperand(1)), self.DAG, TLI, Flags));
        },
        sqrt => {
            fabs;
        },
        atan2 => {
            self.setValue(&mut I, self.DAG.getNode(FATAN2, sdl, self.getValue(I.getArgOperand(0)).getValueType(), self.getValue(I.getArgOperand(0)), self.getValue(I.getArgOperand(1)), Flags));
        },
        lround => {
            llround;
        },
        minnum => {
            self.setValue(&mut I, self.DAG.getNode(FMINNUM, sdl, self.getValue(I.getArgOperand(0)).getValueType(), self.getValue(I.getArgOperand(0)), self.getValue(I.getArgOperand(1)), Flags));
        },
        maxnum => {
            self.setValue(&mut I, self.DAG.getNode(FMAXNUM, sdl, self.getValue(I.getArgOperand(0)).getValueType(), self.getValue(I.getArgOperand(0)), self.getValue(I.getArgOperand(1)), Flags));
        },
        minimum => {
            self.setValue(&mut I, self.DAG.getNode(FMINIMUM, sdl, self.getValue(I.getArgOperand(0)).getValueType(), self.getValue(I.getArgOperand(0)), self.getValue(I.getArgOperand(1)), Flags));
        },
        maximum => {
            self.setValue(&mut I, self.DAG.getNode(FMAXIMUM, sdl, self.getValue(I.getArgOperand(0)).getValueType(), self.getValue(I.getArgOperand(0)), self.getValue(I.getArgOperand(1)), Flags));
        },
        minimumnum => {
            self.setValue(&mut I, self.DAG.getNode(FMINIMUMNUM, sdl, self.getValue(I.getArgOperand(0)).getValueType(), self.getValue(I.getArgOperand(0)), self.getValue(I.getArgOperand(1)), Flags));
        },
        maximumnum => {
            self.setValue(&mut I, self.DAG.getNode(FMAXIMUMNUM, sdl, self.getValue(I.getArgOperand(0)).getValueType(), self.getValue(I.getArgOperand(0)), self.getValue(I.getArgOperand(1)), Flags));
        },
        copysign => {
            self.setValue(&mut I, self.DAG.getNode(FCOPYSIGN, sdl, self.getValue(I.getArgOperand(0)).getValueType(), self.getValue(I.getArgOperand(0)), self.getValue(I.getArgOperand(1)), Flags));
        },
        ldexp => {
            self.setValue(&mut I, self.DAG.getNode(FLDEXP, sdl, self.getValue(I.getArgOperand(0)).getValueType(), self.getValue(I.getArgOperand(0)), self.getValue(I.getArgOperand(1)), Flags));
        },
        modf => {
            sincos;
        },
        arithmetic_fence => {
            self.setValue(&mut I, self.DAG.getNode(ARITH_FENCE, sdl, self.getValue(I.getArgOperand(0)).getValueType(), self.getValue(I.getArgOperand(0)), Flags));
            return;
        },
        fma => {
            self.setValue(&mut I, self.DAG.getNode(FMA, sdl, self.getValue(I.getArgOperand(0)).getValueType(), self.getValue(I.getArgOperand(0)), self.getValue(I.getArgOperand(1)), self.getValue(I.getArgOperand(2)), Flags));
        },
        experimental_constrained_fadd => {
            experimental_constrained_fsub;
        },
        vp_sdiv => {
            vp_srem;
        },
        fptrunc_round => {
            let mut MD: *mut Metadata = cast(I.getArgOperand(1))();
            let mut RoundMode: optional<RoundingMode> = zeroed();
            let mut VT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
            let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
            Flags.copyFMF(operator*(cast(&mut I)));
            let mut FlagsInserter: FlagInserter = FlagInserter { self.DAG, Flags };
            let mut Result: SDValue = SDValue {};
            Result = self.DAG.getNode(FPTRUNC_ROUND, sdl, VT, self.getValue(I.getArgOperand(0)), self.DAG.getTargetConstant(operator*() as i32, sdl, EVT { i32 }, false));
            self.setValue(&mut I, Result);
            return;
        },
        fmuladd => {
            let mut VT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
            if TLI.isFMAFasterThanFMulAndFAdd(self.DAG.getMachineFunction(), VT) {
                self.setValue(&mut I, self.DAG.getNode(FMA, sdl, self.getValue(I.getArgOperand(0)).getValueType(), self.getValue(I.getArgOperand(0)), self.getValue(I.getArgOperand(1)), self.getValue(I.getArgOperand(2)), Flags));
            } else if TLI.isOperationLegalOrCustom(FMULADD, VT, false) {
                self.setValue(&mut I, self.DAG.getNode(FMULADD, sdl, self.getValue(I.getArgOperand(0)).getValueType(), self.getValue(I.getArgOperand(0)), self.getValue(I.getArgOperand(1)), self.getValue(I.getArgOperand(2)), Flags));
            } else {
                let mut Mul: SDValue = self.DAG.getNode(FMUL, sdl, self.getValue(I.getArgOperand(0)).getValueType(), self.getValue(I.getArgOperand(0)), self.getValue(I.getArgOperand(1)), Flags);
                let mut Add: SDValue = self.DAG.getNode(FADD, sdl, self.getValue(I.getArgOperand(0)).getValueType(), Mul, self.getValue(I.getArgOperand(2)), Flags);
                self.setValue(&mut I, Add);
            }
            return;
        },
        fptosi_sat => {
            let mut VT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
            self.setValue(&mut I, self.DAG.getNode(FP_TO_SINT_SAT, sdl, VT, self.getValue(I.getArgOperand(0)), self.DAG.getValueType(VT.getScalarType())));
            return;
        },
        fptoui_sat => {
            let mut VT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
            self.setValue(&mut I, self.DAG.getNode(FP_TO_UINT_SAT, sdl, VT, self.getValue(I.getArgOperand(0)), self.DAG.getValueType(VT.getScalarType())));
            return;
        },
        convert_from_arbitrary_fp => {
            let mut DstVT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
            let mut MD: *mut Metadata = cast(I.getArgOperand(1))();
            let mut FormatStr: str = cast(MD)();
            let mut SrcSem: *fltSemantics = getArbitraryFPSemantics(FormatStr);
            if !SrcSem {
                self.DAG.getContext().emitError("convert_from_arbitrary_fp: not implemented format '" + FormatStr + "'");
                self.setValue(&mut I, self.DAG.getPOISON(DstVT));
                return;
            }
            let mut SemEnum: Semantics = SemanticsToEnum(*SrcSem);
            let mut IntVal: SDValue = self.getValue(I.getArgOperand(0));
            let mut SemConst: SDValue = self.DAG.getTargetConstant(SemEnum as i32, sdl, EVT { i32 }, false);
            self.setValue(&mut I, self.DAG.getNode(CONVERT_FROM_ARBITRARY_FP, sdl, DstVT, IntVal, SemConst));
            return;
        },
        convert_to_arbitrary_fp => {
            let mut DstVT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
            let mut MD: *mut Metadata = cast(I.getArgOperand(1))();
            let mut FormatStr: str = cast(MD)();
            let mut DstSem: *fltSemantics = getArbitraryFPSemantics(FormatStr);
            if !DstSem {
                self.DAG.getContext().emitError("convert_to_arbitrary_fp: not implemented format '" + FormatStr + "'");
                self.setValue(&mut I, self.DAG.getPOISON(DstVT));
                return;
            }
            let mut SemEnum: Semantics = SemanticsToEnum(*DstSem);
            let mut RoundMD: *mut Metadata = cast(I.getArgOperand(2))();
            let mut RoundStr: str = cast(RoundMD)();
            let mut RoundMode: optional<RoundingMode> = zeroed();
            (((operator!(operator!((RoundMode() && operator*() != Dynamic && "Dynamic rounding mode should have been rejected by the verifier")))) || (_wassert(L"RoundMode && *RoundMode != RoundingMode::Dynamic && \"Dynamic rounding mode should have been rejected by the verifier\"", L"llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", (7495) as u32) , 0)) as void);
            let mut Saturate: u64 = if cast(I.getArgOperand(3))() { 1 } else { 0 };
            let mut FloatVal: SDValue = self.getValue(I.getArgOperand(0));
            let mut SemConst: SDValue = self.DAG.getTargetConstant(SemEnum as i32, sdl, EVT { i32 }, false);
            let mut RoundConst: SDValue = self.DAG.getTargetConstant(operator*() as i32, sdl, EVT { i32 }, false);
            let mut SatConst: SDValue = self.DAG.getTargetConstant(Saturate, sdl, EVT { i32 }, false);
            self.setValue(&mut I, self.DAG.getNode(CONVERT_TO_ARBITRARY_FP, sdl, DstVT, FloatVal, SemConst, RoundConst, SatConst));
            return;
        },
        set_rounding => {
            Res = self.DAG.getNode(SET_ROUNDING, sdl, EVT { Other }, ArrayRef<SDValue> { [self.getRoot(), self.getValue(I.getArgOperand(0))] });
        },
        is_fpclass => {
            let mut DLayout: DataLayout = self.DAG.getDataLayout();
            let mut DestVT: EVT = TLI.getValueType(DLayout, I.getType(), false);
            let mut ArgVT: EVT = TLI.getValueType(DLayout, I.getArgOperand(0).getType(), false);
            let mut Test: FPClassTest = cast(I.getArgOperand(1))() as FPClassTest;
            let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
            let mut F: *Function = MF.getFunction();
            let mut Op: SDValue = self.getValue(I.getArgOperand(0));
            let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
            Flags.setNoFPExcept(!F.getAttributes().hasFnAttr(StrictFP));
            if !TLI.isOperationLegal(IS_FPCLASS, ArgVT) && !TLI.isOperationCustom(IS_FPCLASS, ArgVT) {
                let mut Result: SDValue = TLI.expandIS_FPCLASS(DestVT, Op, Test, Flags, sdl, self.DAG);
                self.setValue(&mut I, Result);
                return;
            }
            let mut Check: SDValue = self.DAG.getTargetConstant(Test, sdl, EVT { i32 }, false);
            let mut V: SDValue = self.DAG.getNode(IS_FPCLASS, sdl, DestVT, ArrayRef<SDValue> { [Op, Check] }, Flags);
            self.setValue(&mut I, V);
            return;
        },
        get_fpenv => {
            let mut DLayout: DataLayout = self.DAG.getDataLayout();
            let mut EnvVT: EVT = TLI.getValueType(DLayout, I.getType(), false);
            let mut TempAlign: Align = self.DAG.getEVTAlign(EnvVT);
            let mut Chain: SDValue = self.getRoot();
            if TLI.isOperationLegalOrCustom(GET_FPENV, EnvVT, false) {
                Res = self.DAG.getNode(GET_FPENV, sdl, self.DAG.getVTList(TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false), EVT { Other }), Chain);
            } else {
                let mut Temp: SDValue = self.DAG.CreateStackTemporary(EnvVT, TempAlign.value());
                let mut SPFI: i32 = cast(Temp.getNode())();
                let mut MPI: auto = getFixedStack(self.DAG.getMachineFunction(), SPFI, 0);
                let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction()(MOStore, beforeOrAfterPointer(), TempAlign);
                Chain = self.DAG.getGetFPEnv(Chain, sdl, Temp, EnvVT, MMO);
                Res = self.DAG(EnvVT, sdl, Chain, Temp);
            }
            self.setValue(&mut I, Res);
            self.DAG.setRoot(Res.getValue(1));
            return;
        },
        set_fpenv => {
            let mut DLayout: DataLayout = self.DAG.getDataLayout();
            let mut Env: SDValue = self.getValue(I.getArgOperand(0));
            let mut EnvVT: EVT = Env.getValueType();
            let mut TempAlign: Align = self.DAG.getEVTAlign(EnvVT);
            let mut Chain: SDValue = self.getRoot();
            if TLI.isOperationLegalOrCustom(SET_FPENV, EnvVT, false) {
                Chain = self.DAG.getNode(SET_FPENV, sdl, EVT { Other }, Chain, Env);
            } else {
                let mut Temp: SDValue = self.DAG.CreateStackTemporary(EnvVT, TempAlign.value());
                let mut SPFI: i32 = cast(Temp.getNode())();
                let mut MPI: auto = getFixedStack(self.DAG.getMachineFunction(), SPFI, 0);
                Chain = self.DAG(Chain, sdl, Env, Temp, TempAlign, MOStore);
                let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction()(MOLoad, beforeOrAfterPointer(), TempAlign);
                Chain = self.DAG.getSetFPEnv(Chain, sdl, Temp, EnvVT, MMO);
            }
            self.DAG.setRoot(Chain);
            return;
        },
        reset_fpenv => {
            self.DAG.setRoot(self.DAG.getNode(RESET_FPENV, sdl, EVT { Other }, self.getRoot()));
        },
        get_fpmode => {
            Res = self.DAG.getNode(GET_FPMODE, sdl, self.DAG.getVTList(TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false), EVT { Other }), self.DAG.getRoot());
