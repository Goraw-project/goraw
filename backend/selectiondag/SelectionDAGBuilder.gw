            }
            let mut MemAlign: Align = Align {};
            if Args[i].IsByVal || Args[i].IsInAlloca || Args[i].IsPreallocated {
                let mut FrameSize: u32 = DL.getTypeAllocSize(Args[i].IndirectType).operator unsigned long long();
                Flags.setByValSize(FrameSize);
                if Args[i].Alignment {
                    MA;
                } else {
                    MemAlign = operator(MA);
                }
            } else if Args[i].Alignment {
                MA;
            } else {
