            let mut PtrVT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getOperand(0).getType(), false);
            let mut MemVT: EVT = TLI.getMemValueType(self.DAG.getDataLayout(), I.getOperand(0).getType(), false);
            assert!(PtrVT == Ptr.getValueType());
            if Mask.getValueType().getFixedSizeInBits() < MemVT.getFixedSizeInBits() {
                let mut HighOnes: SDValue = self.DAG.getNode(SHL, sdl, PtrVT, self.DAG.getAllOnesConstant(sdl, PtrVT, false, false), self.DAG.getShiftAmountConstant(Mask.getValueType().getFixedSizeInBits(), PtrVT, sdl));
                Mask = self.DAG.getNode(OR, sdl, PtrVT, self.DAG.getZExtOrTrunc(Mask, sdl, PtrVT), HighOnes);
            } else if Mask.getValueType() != PtrVT {
                Mask = self.DAG.getPtrExtOrTrunc(Mask, sdl, PtrVT);
            }
            assert!(Mask.getValueType() == PtrVT);
            self.setValue(&mut I, self.DAG.getNode(AND, sdl, PtrVT, Ptr, Mask));
            return;
        },
        threadlocal_address => {
            self.setValue(&mut I, self.getValue(I.getOperand(0)));
            return;
        },
        get_active_lane_mask => {
            let mut CCVT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
            let mut Index: SDValue = self.getValue(I.getOperand(0));
            let mut TripCount: SDValue = self.getValue(I.getOperand(1));
            let mut ElementVT: EVT = Index.getValueType();
            if !TLI.shouldExpandGetActiveLaneMask(CCVT, ElementVT) {
                self.setValue(&mut I, self.DAG.getNode(GET_ACTIVE_LANE_MASK, sdl, CCVT, Index, TripCount));
                return;
            }
            let mut VecTy: EVT = getVectorVT(*self.DAG.getContext(), ElementVT, CCVT.getVectorElementCount());
            let mut VectorIndex: SDValue = self.DAG.getSplat(VecTy, sdl, Index);
            let mut VectorTripCount: SDValue = self.DAG.getSplat(VecTy, sdl, TripCount);
            let mut VectorStep: SDValue = self.DAG.getStepVector(sdl, VecTy);
            let mut VectorInduction: SDValue = self.DAG.getNode(UADDSAT, sdl, VecTy, VectorIndex, VectorStep);
            let mut SetCC: SDValue = self.DAG.getSetCC(sdl, CCVT, VectorInduction, VectorTripCount, SETULT, SDValue {}, false, SDNodeFlags { Flags: None });
            self.setValue(&mut I, SetCC);
            return;
        },
        experimental_get_vector_length => {
            (((operator!(operator!((cast(I.getOperand(1))() > 0 && "Expected positive VF")))) || (_wassert(L"cast<ConstantInt>(I.getOperand(1))->getSExtValue() > 0 && \"Expected positive VF\"", L"llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", (8633) as u32) , 0)) as void);
            let mut VF: u32 = cast(I.getOperand(1))();
            let mut IsScalable: bool = cast(I.getOperand(2))();
            let mut Count: SDValue = self.getValue(I.getOperand(0));
            let mut CountVT: EVT = Count.getValueType();
            if !TLI.shouldExpandGetVectorLength(CountVT, VF, IsScalable) {
                self.visitTargetIntrinsic(I, Intrinsic);
                return;
            }
            let mut VT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
            if CountVT.bitsLT(VT) {
                Count = self.DAG.getNode(ZERO_EXTEND, sdl, VT, Count);
                CountVT = VT;
            }
            let mut MaxEVL: SDValue = self.DAG.getElementCount(sdl, CountVT, get(VF, IsScalable));
            let mut UMin: SDValue = self.DAG.getNode(UMIN, sdl, CountVT, Count, MaxEVL);
            let mut Trunc: SDValue = self.DAG.getNode(TRUNCATE, sdl, VT, UMin);
            self.setValue(&mut I, Trunc);
            return;
        },
        vector_partial_reduce_add => {
            let mut Acc: SDValue = self.getValue(I.getOperand(0));
            let mut Input: SDValue = self.getValue(I.getOperand(1));
            self.setValue(&mut I, self.DAG.getNode(PARTIAL_REDUCE_UMLA, sdl, Acc.getValueType(), Acc, Input, self.DAG.getConstant(1, sdl, Input.getValueType(), false, false)));
            return;
        },
        vector_partial_reduce_fadd => {
            let mut Acc: SDValue = self.getValue(I.getOperand(0));
            let mut Input: SDValue = self.getValue(I.getOperand(1));
            self.setValue(&mut I, self.DAG.getNode(PARTIAL_REDUCE_FMLA, sdl, Acc.getValueType(), Acc, Input, self.DAG.getConstantFP(1.0, sdl, Input.getValueType(), false)));
            return;
        },
        experimental_cttz_elts => {
            let mut Op: SDValue = self.getValue(I.getOperand(0));
            let mut OpVT: EVT = Op.getValueType();
            let mut RetTy: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
            let mut ZeroIsPoison: bool = operator!(cast(self.getValue(I.getOperand(1)))());
            if OpVT.getVectorElementType() != EVT { i1 } {
                let mut AllZero: SDValue = self.DAG.getConstant(0, sdl, OpVT, false, false);
                let mut I1OpVT: EVT = OpVT.changeVectorElementType(*self.DAG.getContext(), EVT { i1 });
                Op = self.DAG.getSetCC(sdl, I1OpVT, Op, AllZero, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
            }
            self.setValue(&mut I, self.DAG.getNode(if ZeroIsPoison { CTTZ_ELTS_ZERO_POISON } else { CTTZ_ELTS }, sdl, RetTy, Op));
            return;
        },
        vector_insert => {
            let mut Vec: SDValue = self.getValue(I.getOperand(0));
            let mut SubVec: SDValue = self.getValue(I.getOperand(1));
            let mut Index: SDValue = self.getValue(I.getOperand(2));
            let mut VectorIdxTy: MVT = TLI.getVectorIdxTy(self.DAG.getDataLayout());
            if Index.getValueType() != EVT { VectorIdxTy } {
                Index = self.DAG.getVectorIdxConstant(operator(Index).getAsZExtVal(), sdl, false);
            }
            let mut ResultVT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
            self.setValue(&mut I, self.DAG.getNode(INSERT_SUBVECTOR, sdl, ResultVT, Vec, SubVec, Index));
            return;
        },
        vector_extract => {
            let mut Vec: SDValue = self.getValue(I.getOperand(0));
            let mut Index: SDValue = self.getValue(I.getOperand(1));
            let mut ResultVT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
            let mut VectorIdxTy: MVT = TLI.getVectorIdxTy(self.DAG.getDataLayout());
            if Index.getValueType() != EVT { VectorIdxTy } {
                Index = self.DAG.getVectorIdxConstant(operator(Index).getAsZExtVal(), sdl, false);
            }
            self.setValue(&mut I, self.DAG.getNode(EXTRACT_SUBVECTOR, sdl, ResultVT, Vec, Index));
            return;
        },
        experimental_vector_match => {
            let mut Op1: SDValue = self.getValue(I.getOperand(0));
            let mut Op2: SDValue = self.getValue(I.getOperand(1));
            let mut Mask: SDValue = self.getValue(I.getOperand(2));
            let mut ResVT: EVT = Mask.getValueType();
            self.setValue(&mut I, self.DAG.getNode(VECTOR_MATCH, sdl, ResVT, Op1, Op2, Mask));
            return;
        },
        vector_reverse => {
            self.visitVectorReverse(I);
        },
        vector_splice_left => {
            vector_splice_right;
        },
        callbr_landingpad => {
            self.visitCallBrLandingPad(I);
        },
        vector_repeat => {
            let mut Vec: SDValue = self.getValue(I.getOperand(0));
            let mut ResultVT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
            self.setValue(&mut I, self.DAG.getNode(VECTOR_REPEAT, sdl, ResultVT, Vec));
            return;
        },
        experimental_vector_compress => {
            self.setValue(&mut I, self.DAG.getNode(VECTOR_COMPRESS, sdl, self.getValue(I.getArgOperand(0)).getValueType(), self.getValue(I.getArgOperand(0)), self.getValue(I.getArgOperand(1)), self.getValue(I.getArgOperand(2)), Flags));
        },
        experimental_convergence_anchor => {
            experimental_convergence_entry;
        },
        experimental_vector_histogram_add => {
            self.visitVectorHistogram(I, Intrinsic);
            return;
        },
        experimental_vector_extract_last_active => {
            self.visitVectorExtractLastActive(I, Intrinsic);
            return;
        },
        loop_dependence_war_mask => {
            self.setValue(&mut I, self.DAG.getNode(LOOP_DEPENDENCE_WAR_MASK, sdl, getEVT(I.getType(), false), self.getValue(I.getOperand(0)), self.getValue(I.getOperand(1)), self.getValue(I.getOperand(2)), self.DAG.getConstant(0, sdl, EVT { i64 }, false, false)));
        },
        loop_dependence_raw_mask => {
            self.setValue(&mut I, self.DAG.getNode(LOOP_DEPENDENCE_RAW_MASK, sdl, getEVT(I.getType(), false), self.getValue(I.getOperand(0)), self.getValue(I.getOperand(1)), self.getValue(I.getOperand(2)), self.DAG.getConstant(0, sdl, EVT { i64 }, false, false)));
        },
        masked_udiv => {
            self.setValue(&mut I, self.DAG.getNode(MASKED_UDIV, sdl, getEVT(I.getType(), false), self.getValue(I.getOperand(0)), self.getValue(I.getOperand(1)), self.getValue(I.getOperand(2))));
        },
        masked_sdiv => {
            self.setValue(&mut I, self.DAG.getNode(MASKED_SDIV, sdl, getEVT(I.getType(), false), self.getValue(I.getOperand(0)), self.getValue(I.getOperand(1)), self.getValue(I.getOperand(2))));
        },
        masked_urem => {
            self.setValue(&mut I, self.DAG.getNode(MASKED_UREM, sdl, getEVT(I.getType(), false), self.getValue(I.getOperand(0)), self.getValue(I.getOperand(1)), self.getValue(I.getOperand(2))));
        },
        masked_srem => {
            self.setValue(&mut I, self.DAG.getNode(MASKED_SREM, sdl, getEVT(I.getType(), false), self.getValue(I.getOperand(0)), self.getValue(I.getOperand(1)), self.getValue(I.getOperand(2))));
        },
    }
}

fn SelectionDAGBuilder::pushFPOpOutChain(self, Result: SDValue, EB: ExceptionBehavior) {
    assert!(Result.getNode().getNumValues() == 2);
    let mut OutChain: SDValue = Result.getValue(1);
    assert!(OutChain.getValueType() == EVT { Other });
    match EB {
        ebMayTrap => {
            ebIgnore;
        },
        ebStrict => {
            self.PendingConstrainedFPStrict.push(ValueParamT { OutChain });
        },
    }
}

fn SelectionDAGBuilder::visitConstrainedFPIntrinsic(self, FPI: *ConstrainedFPIntrinsic) {
    let mut sdl: SDLoc = self.getCurSDLoc();
    let mut EB: ExceptionBehavior = FPI.getExceptionBehavior;
    let mut Chain: SDValue = self.getFPOperationRoot(EB);
    let mut Opers: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    Opers.push(ValueParamT { Chain });
    for let mut I: u32 = 0;
let mut E: u32 = FPI.getNonMetadataArgCount(); I != E; I += 1 {
        Opers.push(self.getValue(FPI.getArgOperand(I)));
    }
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut VT: EVT = TLI.getValueType(self.DAG.getDataLayout(), FPI.getType(), false);
    let mut VTs: SDVTList = self.DAG.getVTList(VT, EVT { Other });
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    if EB == ebIgnore {
        Flags.setNoFPExcept(true);
    }
    if  {
        Flags.copyFMF(operator*());
    }
    let mut Opcode: u32 = 0;
    match FPI.getIntrinsicID() {
        _ => {
            llvm_unreachable_internal("Impossible intrinsic", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", 8908);
        },
        experimental_constrained_fadd => {
            Opcode = STRICT_FADD;
        },
        experimental_constrained_fsub => {
            Opcode = STRICT_FSUB;
        },
        experimental_constrained_fmul => {
            Opcode = STRICT_FMUL;
        },
        experimental_constrained_fdiv => {
            Opcode = STRICT_FDIV;
        },
        experimental_constrained_frem => {
            Opcode = STRICT_FREM;
        },
        experimental_constrained_fpext => {
            Opcode = STRICT_FP_EXTEND;
        },
        experimental_constrained_sitofp => {
            Opcode = STRICT_SINT_TO_FP;
        },
        experimental_constrained_uitofp => {
            Opcode = STRICT_UINT_TO_FP;
        },
        experimental_constrained_fptosi => {
            Opcode = STRICT_FP_TO_SINT;
        },
        experimental_constrained_fptoui => {
            Opcode = STRICT_FP_TO_UINT;
        },
        experimental_constrained_fptrunc => {
            Opcode = STRICT_FP_ROUND;
        },
        experimental_constrained_fcmp => {
            Opcode = STRICT_FSETCC;
        },
        experimental_constrained_fcmps => {
            Opcode = STRICT_FSETCCS;
        },
        experimental_constrained_acos => {
            Opcode = STRICT_FACOS;
        },
        experimental_constrained_asin => {
            Opcode = STRICT_FASIN;
        },
        experimental_constrained_atan => {
            Opcode = STRICT_FATAN;
        },
        experimental_constrained_atan2 => {
            Opcode = STRICT_FATAN2;
        },
        experimental_constrained_ceil => {
            Opcode = STRICT_FCEIL;
        },
        experimental_constrained_cos => {
            Opcode = STRICT_FCOS;
        },
        experimental_constrained_cosh => {
            Opcode = STRICT_FCOSH;
        },
        experimental_constrained_exp => {
            Opcode = STRICT_FEXP;
        },
        experimental_constrained_exp2 => {
            Opcode = STRICT_FEXP2;
        },
        experimental_constrained_floor => {
            Opcode = STRICT_FFLOOR;
        },
        experimental_constrained_fma => {
            Opcode = STRICT_FMA;
        },
        experimental_constrained_log => {
            Opcode = STRICT_FLOG;
        },
        experimental_constrained_log10 => {
            Opcode = STRICT_FLOG10;
        },
        experimental_constrained_log2 => {
            Opcode = STRICT_FLOG2;
        },
        experimental_constrained_lrint => {
            Opcode = STRICT_LRINT;
        },
        experimental_constrained_llrint => {
            Opcode = STRICT_LLRINT;
        },
        experimental_constrained_lround => {
            Opcode = STRICT_LROUND;
        },
        experimental_constrained_llround => {
            Opcode = STRICT_LLROUND;
        },
        experimental_constrained_maxnum => {
            Opcode = STRICT_FMAXNUM;
        },
        experimental_constrained_minnum => {
            Opcode = STRICT_FMINNUM;
        },
        experimental_constrained_maximum => {
            Opcode = STRICT_FMAXIMUM;
        },
        experimental_constrained_minimum => {
            Opcode = STRICT_FMINIMUM;
        },
        experimental_constrained_nearbyint => {
            Opcode = STRICT_FNEARBYINT;
        },
        experimental_constrained_pow => {
            Opcode = STRICT_FPOW;
        },
        experimental_constrained_powi => {
            Opcode = STRICT_FPOWI;
        },
        experimental_constrained_ldexp => {
            Opcode = STRICT_FLDEXP;
        },
        experimental_constrained_rint => {
            Opcode = STRICT_FRINT;
        },
        experimental_constrained_round => {
            Opcode = STRICT_FROUND;
        },
        experimental_constrained_roundeven => {
            Opcode = STRICT_FROUNDEVEN;
        },
        experimental_constrained_sin => {
            Opcode = STRICT_FSIN;
        },
        experimental_constrained_sinh => {
            Opcode = STRICT_FSINH;
        },
        experimental_constrained_sqrt => {
            Opcode = STRICT_FSQRT;
        },
        experimental_constrained_tan => {
            Opcode = STRICT_FTAN;
        },
        experimental_constrained_tanh => {
            Opcode = STRICT_FTANH;
        },
        experimental_constrained_trunc => {
            Opcode = STRICT_FTRUNC;
        },
        experimental_constrained_fmuladd => {
            Opcode = STRICT_FMA;
            if !TLI.isFMAFasterThanFMulAndFAdd(self.DAG.getMachineFunction(), VT) {
                Opers.pop();
                let mut Mul: SDValue = self.DAG;
                self.pushFPOpOutChain(Mul, EB);
                Opcode = STRICT_FADD;
                Opers.clear();
                Opers.push(Mul.getValue(1));
                Opers.push(Mul.getValue(0));
                Opers.push(self.getValue(FPI.getArgOperand(2)));
            }
            break;
        },
    }
    match Opcode {
        _ => {
            break;
        },
        STRICT_FP_ROUND => {
            Opers.push(self.DAG.getTargetConstant(0, sdl, EVT { TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, false));
        },
        STRICT_FSETCC => {
            STRICT_FSETCCS;
        },
    }
    let mut Result: SDValue = self.DAG;
    self.pushFPOpOutChain(Result, EB);
    let mut FPResult: SDValue = Result.getValue(0);
    self.setValue(&mut FPI, FPResult);
}

fn getISDForVPIntrinsic(VPIntrin: *VPIntrinsic) -> u32 {
    let mut ResOPC: optional<unsigned int> = optional<unsigned int> {};
    match VPIntrin.getIntrinsicID() {
        vp_cttz_elts => {
            let mut IsZeroPoison: bool = cast(VPIntrin.getArgOperand(1))();
            ResOPC(if IsZeroPoison { VP_CTTZ_ELTS_ZERO_POISON } else { VP_CTTZ_ELTS });
            break;
        },
        vp_sdiv => {
            ResOPC(VP_SDIV);
        },
        vp_srem => {
            ResOPC(VP_SREM);
        },
        vp_udiv => {
            ResOPC(VP_UDIV);
        },
        vp_urem => {
            ResOPC(VP_UREM);
        },
        vp_store => {
            ResOPC(VP_STORE);
        },
        experimental_vp_strided_store => {
            ResOPC(EXPERIMENTAL_VP_STRIDED_STORE);
        },
        vp_scatter => {
            ResOPC(VP_SCATTER);
        },
        vp_load => {
            ResOPC(VP_LOAD);
        },
        vp_load_ff => {
            ResOPC(VP_LOAD_FF);
        },
        experimental_vp_strided_load => {
            ResOPC(EXPERIMENTAL_VP_STRIDED_LOAD);
        },
        vp_gather => {
            ResOPC(VP_GATHER);
        },
        vp_reduce_add => {
            ResOPC(VP_REDUCE_ADD);
        },
        vp_reduce_mul => {
            ResOPC(VP_REDUCE_MUL);
        },
        vp_reduce_and => {
            ResOPC(VP_REDUCE_AND);
        },
        vp_reduce_or => {
            ResOPC(VP_REDUCE_OR);
        },
        vp_reduce_xor => {
            ResOPC(VP_REDUCE_XOR);
        },
        vp_reduce_smax => {
            ResOPC(VP_REDUCE_SMAX);
        },
        vp_reduce_smin => {
            ResOPC(VP_REDUCE_SMIN);
        },
        vp_reduce_umax => {
            ResOPC(VP_REDUCE_UMAX);
        },
        vp_reduce_umin => {
            ResOPC(VP_REDUCE_UMIN);
        },
        vp_reduce_fmax => {
            ResOPC(VP_REDUCE_FMAX);
        },
        vp_reduce_fmin => {
            ResOPC(VP_REDUCE_FMIN);
        },
        vp_reduce_fmaximum => {
            ResOPC(VP_REDUCE_FMAXIMUM);
        },
        vp_reduce_fminimum => {
            ResOPC(VP_REDUCE_FMINIMUM);
        },
        vp_reduce_fadd => {
            ResOPC(VP_REDUCE_SEQ_FADD);
        },
        vp_reduce_fmul => {
            ResOPC(VP_REDUCE_SEQ_FMUL);
        },
        vp_merge => {
            ResOPC(VP_MERGE);
        },
        experimental_vp_splice => {
            ResOPC(EXPERIMENTAL_VP_SPLICE);
        },
        experimental_vp_reverse => {
            ResOPC(EXPERIMENTAL_VP_REVERSE);
        },
    }
    if !ResOPC {
        llvm_unreachable_internal("Inconsistency: no SDNode available for this VPIntrinsic!", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", 8974);
    }
    if operator(ResOPC) == VP_REDUCE_SEQ_FADD || operator(ResOPC) == VP_REDUCE_SEQ_FMUL {
        if VPIntrin.getFastMathFlags().allowReassoc() {
            return if operator(ResOPC) == VP_REDUCE_SEQ_FADD { VP_REDUCE_FADD } else { VP_REDUCE_FMUL };
        }
    }
    return operator(ResOPC);
}

fn SelectionDAGBuilder::visitVPLoad(self, VPIntrin: *VPIntrinsic, VT: EVT, OpValues: *SmallVectorImpl<SDValue>) {
    let mut DL: SDLoc = self.getCurSDLoc();
    let mut PtrOperand: *mut Value = VPIntrin.getArgOperand(0);
    let mut Alignment: MaybeAlign = VPIntrin.getPointerAlignment();
    let mut AAInfo: AAMDNodes = VPIntrin.getAAMetadata();
    let mut Ranges: *MDNode = getRangeMetadata(VPIntrin);
    let mut LD: SDValue = SDValue {};
    if !Alignment {
        Alignment = MaybeAlign { self.DAG.getEVTAlign(VT) };
    }
    let mut ML: MemoryLocation = getAfter(PtrOperand, AAInfo);
    let mut AddToChain: bool = !self.BatchAA || !self.BatchAA.pointsToConstantMemory(ML, false);
    let mut InChain: SDValue = if AddToChain { self.DAG.getRoot() } else { self.DAG.getEntryNode() };
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut MMOFlags: Flags = TLI.getVPIntrinsicMemOperandFlags(VPIntrin);
    let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(MachinePointerInfo { PtrOperand, 0, 0 }, MMOFlags, beforeOrAfterPointer(), operator(Alignment), MMOMetadata { AAInfo: AAInfo, Ranges: Ranges, MemCacheHint: null }, System, NotAtomic, NotAtomic);
    LD = self.DAG.getLoadVP(VT, DL, InChain, OpValues[0], OpValues[1], OpValues[2], MMO, false);
    if AddToChain {
        self.PendingLoads.push(LD.getValue(1));
    }
    self.setValue(&mut VPIntrin, LD);
}

fn SelectionDAGBuilder::visitVPLoadFF(self, VPIntrin: *VPIntrinsic, VT: EVT, EVLVT: EVT, OpValues: *SmallVectorImpl<SDValue>) {
    assert!(OpValues.len == 3, "Unexpected number of operands");
    let mut DL: SDLoc = self.getCurSDLoc();
    let mut PtrOperand: *mut Value = VPIntrin.getArgOperand(0);
    let mut Alignment: MaybeAlign = VPIntrin.getPointerAlignment();
    let mut AAInfo: AAMDNodes = VPIntrin.getAAMetadata();
    let mut Ranges: *MDNode = VPIntrin.getMetadata(MD_range);
    let mut LD: SDValue = SDValue {};
    if !Alignment {
        Alignment = MaybeAlign { self.DAG.getEVTAlign(VT) };
    }
    let mut ML: MemoryLocation = getAfter(PtrOperand, AAInfo);
    let mut AddToChain: bool = !self.BatchAA || !self.BatchAA.pointsToConstantMemory(ML, false);
    let mut InChain: SDValue = if AddToChain { self.DAG.getRoot() } else { self.DAG.getEntryNode() };
    let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(MachinePointerInfo { PtrOperand, 0, 0 }, MOLoad, beforeOrAfterPointer(), operator(Alignment), MMOMetadata { AAInfo: AAInfo, Ranges: Ranges, MemCacheHint: null }, System, NotAtomic, NotAtomic);
    LD = self.DAG.getLoadFFVP(VT, DL, InChain, OpValues[0], OpValues[1], OpValues[2], MMO);
    let mut Trunc: SDValue = self.DAG.getNode(TRUNCATE, DL, EVLVT, LD.getValue(1));
    if AddToChain {
        self.PendingLoads.push(LD.getValue(2));
    }
    self.setValue(&mut VPIntrin, self.DAG.getMergeValues(ArrayRef<SDValue> { [LD.getValue(0), Trunc] }, DL));
}

fn SelectionDAGBuilder::visitVPGather(self, VPIntrin: *VPIntrinsic, VT: EVT, OpValues: *SmallVectorImpl<SDValue>) {
    let mut DL: SDLoc = self.getCurSDLoc();
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut PtrOperand: *mut Value = VPIntrin.getArgOperand(0);
    let mut Alignment: MaybeAlign = VPIntrin.getPointerAlignment();
    let mut AAInfo: AAMDNodes = VPIntrin.getAAMetadata();
    let mut Ranges: *MDNode = getRangeMetadata(VPIntrin);
    let mut LD: SDValue = SDValue {};
    if !Alignment {
        Alignment = MaybeAlign { self.DAG.getEVTAlign(VT.getScalarType()) };
    }
    let mut AS: u32 = PtrOperand.getType().getScalarType().getPointerAddressSpace();
    let mut MMOFlags: Flags = TLI.getVPIntrinsicMemOperandFlags(VPIntrin);
    let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(MachinePointerInfo { AS, 0 }, MMOFlags, beforeOrAfterPointer(), operator(Alignment), MMOMetadata { AAInfo: AAInfo, Ranges: Ranges, MemCacheHint: null }, System, NotAtomic, NotAtomic);
    let mut Base: SDValue = SDValue {};
    let mut Index: SDValue = SDValue {};
    let mut Scale: SDValue = SDValue {};
    let mut UniformBase: bool = getUniformBase(PtrOperand, Base, Index, Scale, self, VPIntrin.getParent(), VT.getScalarStoreSize());
    if !UniformBase {
        Base = self.DAG.getConstant(0, DL, EVT { TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, false, false);
        Index = self.getValue(PtrOperand);
        Scale = self.DAG.getTargetConstant(1, DL, EVT { TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, false);
    }
    let mut IdxVT: EVT = Index.getValueType();
    let mut EltTy: EVT = IdxVT.getVectorElementType();
    if TLI.shouldExtendGSIndex(IdxVT, EltTy) {
        let mut NewIdxVT: EVT = IdxVT.changeVectorElementType(*self.DAG.getContext(), EltTy);
        Index = self.DAG.getNode(SIGN_EXTEND, DL, NewIdxVT, Index);
    }
    LD = self.DAG.getGatherVP(self.DAG.getVTList(VT, EVT { Other }), VT, DL, ArrayRef<SDValue> { [self.DAG.getRoot(), Base, Index, Scale, OpValues[1], OpValues[2]] }, MMO, SIGNED_SCALED);
    self.PendingLoads.push(LD.getValue(1));
    self.setValue(&mut VPIntrin, LD);
}

fn SelectionDAGBuilder::visitVPStore(self, VPIntrin: *VPIntrinsic, OpValues: *SmallVectorImpl<SDValue>) {
    let mut DL: SDLoc = self.getCurSDLoc();
    let mut PtrOperand: *mut Value = VPIntrin.getArgOperand(1);
    let mut VT: EVT = OpValues[0].getValueType();
    let mut Alignment: MaybeAlign = VPIntrin.getPointerAlignment();
    let mut AAInfo: AAMDNodes = VPIntrin.getAAMetadata();
    let mut ST: SDValue = SDValue {};
    if !Alignment {
        Alignment = MaybeAlign { self.DAG.getEVTAlign(VT) };
    }
    let mut Ptr: SDValue = OpValues[1];
    let mut Offset: SDValue = self.DAG.getPOISON(Ptr.getValueType());
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut MMOFlags: Flags = TLI.getVPIntrinsicMemOperandFlags(VPIntrin);
    let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(MachinePointerInfo { PtrOperand, 0, 0 }, MMOFlags, beforeOrAfterPointer(), operator(Alignment), MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null }, System, NotAtomic, NotAtomic);
    ST = self.DAG.getStoreVP(self.getMemoryRoot(), DL, OpValues[0], Ptr, Offset, OpValues[2], OpValues[3], VT, MMO, UNINDEXED, false, false);
    self.DAG.setRoot(ST);
    self.setValue(&mut VPIntrin, ST);
}

fn SelectionDAGBuilder::visitVPScatter(self, VPIntrin: *VPIntrinsic, OpValues: *SmallVectorImpl<SDValue>) {
    let mut DL: SDLoc = self.getCurSDLoc();
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut PtrOperand: *mut Value = VPIntrin.getArgOperand(1);
    let mut VT: EVT = OpValues[0].getValueType();
    let mut Alignment: MaybeAlign = VPIntrin.getPointerAlignment();
    let mut AAInfo: AAMDNodes = VPIntrin.getAAMetadata();
    let mut ST: SDValue = SDValue {};
    if !Alignment {
        Alignment = MaybeAlign { self.DAG.getEVTAlign(VT.getScalarType()) };
    }
    let mut AS: u32 = PtrOperand.getType().getScalarType().getPointerAddressSpace();
    let mut MMOFlags: Flags = TLI.getVPIntrinsicMemOperandFlags(VPIntrin);
    let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(MachinePointerInfo { AS, 0 }, MMOFlags, beforeOrAfterPointer(), operator(Alignment), MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null }, System, NotAtomic, NotAtomic);
    let mut Base: SDValue = SDValue {};
    let mut Index: SDValue = SDValue {};
    let mut Scale: SDValue = SDValue {};
    let mut UniformBase: bool = getUniformBase(PtrOperand, Base, Index, Scale, self, VPIntrin.getParent(), VT.getScalarStoreSize());
    if !UniformBase {
        Base = self.DAG.getConstant(0, DL, EVT { TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, false, false);
        Index = self.getValue(PtrOperand);
        Scale = self.DAG.getTargetConstant(1, DL, EVT { TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, false);
    }
    let mut IdxVT: EVT = Index.getValueType();
    let mut EltTy: EVT = IdxVT.getVectorElementType();
    if TLI.shouldExtendGSIndex(IdxVT, EltTy) {
        let mut NewIdxVT: EVT = IdxVT.changeVectorElementType(*self.DAG.getContext(), EltTy);
        Index = self.DAG.getNode(SIGN_EXTEND, DL, NewIdxVT, Index);
    }
    ST = self.DAG.getScatterVP(self.DAG.getVTList(EVT { Other }), VT, DL, ArrayRef<SDValue> { [self.getMemoryRoot(), OpValues[0], Base, Index, Scale, OpValues[2], OpValues[3]] }, MMO, SIGNED_SCALED);
    self.DAG.setRoot(ST);
    self.setValue(&mut VPIntrin, ST);
}

fn SelectionDAGBuilder::visitVPStridedLoad(self, VPIntrin: *VPIntrinsic, VT: EVT, OpValues: *SmallVectorImpl<SDValue>) {
    let mut DL: SDLoc = self.getCurSDLoc();
    let mut PtrOperand: *mut Value = VPIntrin.getArgOperand(0);
    let mut Alignment: MaybeAlign = VPIntrin.getPointerAlignment();
    if !Alignment {
        Alignment = MaybeAlign { self.DAG.getEVTAlign(VT.getScalarType()) };
    }
    let mut AAInfo: AAMDNodes = VPIntrin.getAAMetadata();
    let mut Ranges: *MDNode = getRangeMetadata(VPIntrin);
    let mut ML: MemoryLocation = getAfter(PtrOperand, AAInfo);
    let mut AddToChain: bool = !self.BatchAA || !self.BatchAA.pointsToConstantMemory(ML, false);
    let mut InChain: SDValue = if AddToChain { self.DAG.getRoot() } else { self.DAG.getEntryNode() };
    let mut AS: u32 = PtrOperand.getType().getPointerAddressSpace();
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut MMOFlags: Flags = TLI.getVPIntrinsicMemOperandFlags(VPIntrin);
    let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(MachinePointerInfo { AS, 0 }, MMOFlags, beforeOrAfterPointer(), operator(Alignment), MMOMetadata { AAInfo: AAInfo, Ranges: Ranges, MemCacheHint: null }, System, NotAtomic, NotAtomic);
    let mut LD: SDValue = self.DAG.getStridedLoadVP(VT, DL, InChain, OpValues[0], OpValues[1], OpValues[2], OpValues[3], MMO, false);
    if AddToChain {
        self.PendingLoads.push(LD.getValue(1));
    }
    self.setValue(&mut VPIntrin, LD);
}

fn SelectionDAGBuilder::visitVPStridedStore(self, VPIntrin: *VPIntrinsic, OpValues: *SmallVectorImpl<SDValue>) {
    let mut DL: SDLoc = self.getCurSDLoc();
    let mut PtrOperand: *mut Value = VPIntrin.getArgOperand(1);
    let mut VT: EVT = OpValues[0].getValueType();
    let mut Alignment: MaybeAlign = VPIntrin.getPointerAlignment();
    if !Alignment {
        Alignment = MaybeAlign { self.DAG.getEVTAlign(VT.getScalarType()) };
    }
    let mut AAInfo: AAMDNodes = VPIntrin.getAAMetadata();
    let mut AS: u32 = PtrOperand.getType().getPointerAddressSpace();
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut MMOFlags: Flags = TLI.getVPIntrinsicMemOperandFlags(VPIntrin);
    let mut MMO: *mut MachineMemOperand = self.DAG.getMachineFunction().getMachineMemOperand(MachinePointerInfo { AS, 0 }, MMOFlags, beforeOrAfterPointer(), operator(Alignment), MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null }, System, NotAtomic, NotAtomic);
    let mut ST: SDValue = self.DAG.getStridedStoreVP(self.getMemoryRoot(), DL, OpValues[0], OpValues[1], self.DAG.getPOISON(OpValues[1].getValueType()), OpValues[2], OpValues[3], OpValues[4], VT, MMO, UNINDEXED, false, false);
    self.DAG.setRoot(ST);
    self.setValue(&mut VPIntrin, ST);
}

fn SelectionDAGBuilder::visitVectorPredicationIntrinsic(self, VPIntrin: *VPIntrinsic) {
    let mut DL: SDLoc = self.getCurSDLoc();
    let mut Opcode: u32 = getISDForVPIntrinsic(VPIntrin);
    let mut IID: ID = VPIntrin.getIntrinsicID();
    let mut ValueVTs: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    ComputeValueVTs(TLI, self.DAG.getDataLayout(), VPIntrin.getType(), ValueVTs, null, null, getZero());
    let mut VTs: SDVTList = self.DAG;
    let mut EVLParamPos: optional<unsigned int> = getVectorLengthParamPos(IID);
    let mut EVLParamVT: MVT = TLI.getVPExplicitVectorLengthTy();
    assert!(EVLParamVT.isScalarInteger() && EVLParamVT.bitsGE(MVT { SimpleTy: i32 }), "Unexpected target EVL type");
    let mut OpValues: SmallVector<SDValue, 7> = zeroed();
    for let mut I: u32 = 0; I < VPIntrin.arg_size(); I += 1 {
        let mut Op: SDValue = self.getValue(VPIntrin.getArgOperand(I));
        if I(EVLParamPos) {
            Op = self.DAG.getNode(ZERO_EXTEND, DL, EVT { EVLParamVT }, Op);
        }
        OpValues()(Op);
    }
    match Opcode {
        _ => {
            let mut SDFlags: SDNodeFlags = SDNodeFlags { Flags: None };
            if  {
                SDFlags.copyFMF(operator*());
            }
            let mut Result: SDValue = self.DAG(Opcode, DL, VTs, SDFlags);
            self.setValue(&mut VPIntrin, Result);
            break;
        },
        VP_LOAD => {
            self.visitVPLoad(VPIntrin, ValueVTs[0]);
        },
        VP_LOAD_FF => {
            self.visitVPLoadFF(VPIntrin, ValueVTs[0], ValueVTs[1]);
        },
        VP_GATHER => {
            self.visitVPGather(VPIntrin, ValueVTs[0]);
        },
        EXPERIMENTAL_VP_STRIDED_LOAD => {
            self.visitVPStridedLoad(VPIntrin, ValueVTs[0]);
        },
        VP_STORE => {
            self.visitVPStore(VPIntrin);
        },
        VP_SCATTER => {
            self.visitVPScatter(VPIntrin);
        },
        EXPERIMENTAL_VP_STRIDED_STORE => {
            self.visitVPStridedStore(VPIntrin);
        },
        VP_CTTZ_ELTS_ZERO_POISON => {
            VP_CTTZ_ELTS;
        },
    }
}

fn SelectionDAGBuilder::lowerStartEH(self, Chain: SDValue, EHPadBB: *BasicBlock, BeginLabel: *mut *mut MCSymbol) -> SDValue {
    let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
    if !MF.getContext().getAsmInfo().usesPerInvokeEHLabels() {
        BeginLabel = null;
        return Chain;
    }
    BeginLabel = MF.getContext().createTempSymbol();
    let mut CallSiteIndex: u32 = self.FuncInfo.getCurrentCallSite();
    if CallSiteIndex {
        MF.setCallSiteBeginLabel(BeginLabel, CallSiteIndex);
        self.LPadToCallSiteMap[self.FuncInfo.getMBB(EHPadBB)].push(CallSiteIndex);
        self.FuncInfo.setCurrentCallSite(0);
    }
    return self.DAG.getEHLabel(self.getCurSDLoc(), Chain, BeginLabel);
}

fn SelectionDAGBuilder::lowerEndEH(self, Chain: SDValue, II: *InvokeInst, EHPadBB: *BasicBlock, BeginLabel: *mut MCSymbol) -> SDValue {
    if !BeginLabel {
        return Chain;
    }
    let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
    let mut EndLabel: *mut MCSymbol = MF.getContext().createTempSymbol();
    Chain = self.DAG.getEHLabel(self.getCurSDLoc(), Chain, EndLabel);
    let mut Pers: EHPersonality = classifyEHPersonality(self.FuncInfo.Fn.getPersonalityFn());
    if MF.hasEHFunclets() && isFuncletEHPersonality(Pers) {
        assert!(II, "II should've been set");
        let mut EHInfo: *mut WinEHFuncInfo = MF.getWinEHFuncInfo();
        EHInfo.addIPToStateRange(II, BeginLabel, EndLabel);
    } else if !isScopedEHPersonality(Pers) {
        assert!(EHPadBB);
        MF.addInvoke(self.FuncInfo.getMBB(EHPadBB), BeginLabel, EndLabel);
    }
    return Chain;
}

fn SelectionDAGBuilder::lowerInvokable(self, CLI: *mut CallLoweringInfo, EHPadBB: *BasicBlock) -> pair<SDValue, SDValue> {
    let mut BeginLabel: *mut MCSymbol = null;
    if EHPadBB {
        self.getRoot() as void;
        self.DAG.setRoot(self.lowerStartEH(self.getControlRoot(), EHPadBB, BeginLabel));
        CLI.setChain(self.getRoot());
    }
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut Result: pair<SDValue, SDValue> = TLI.LowerCallTo(CLI);
    assert!((CLI.IsTailCall || Result.second.getNode()), "Non-null chain expected with non-tail call!");
    assert!((Result.second.getNode() || !Result.first.getNode()), "Null value expected with tail call!");
    if !Result.second.getNode() {
        self.HasTailCall = true;
        self.PendingExports.clear();
    } else {
        self.DAG.setRoot(Result.second);
    }
    if EHPadBB {
        self.DAG.setRoot(self.lowerEndEH(self.getRoot(), cast_or_null(CLI.CB), EHPadBB, BeginLabel));
        Result.second = self.getRoot();
    }
    return Result;
}

fn SelectionDAGBuilder::canTailCall(self: *SelectionDAGBuilder, CB: *CallBase) -> bool {
    let mut isMustTailCall: bool = CB.isMustTailCall();
    let mut Caller: *Function = CB.getParent().getParent();
    if !isMustTailCall && Caller.getFnAttribute("disable-tail-calls").getValueAsBool() {
        return false;
    }
    if self.DAG.hasSwiftErrorArg() {
        return false;
    }
    return isInTailCallPosition(CB, self.DAG.getTarget(), false);
}

fn SelectionDAGBuilder::LowerCallTo(self, CB: *CallBase, Callee: SDValue, isTailCall: bool, isMustTailCall: bool, EHPadBB: *BasicBlock, PAI: *PtrAuthInfo) {
    let mut DL: *DataLayout = self.DAG.getDataLayout();
    let mut FTy: *mut FunctionType = CB.getFunctionType();
    let mut RetTy: *mut Type = CB.getType();
    let mut Args: ArgListTy = ArgListTy {};
    Args.reserve(CB.arg_size());
    let mut SwiftErrorVal: *Value = null;
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    if isTailCall {
        isTailCall = self.canTailCall(CB);
    }
    for let mut I: const_op_iterator = CB.arg_begin();
let mut E: const_op_iterator = CB.arg_end(); I != E; I += 1 {
        let mut V: *Value = *I.operator llvm::Value *();
        if V.getType().isEmptyTy() {
            continue;
        }
        let mut ArgNode: SDValue = self.getValue(V);
        let mut Entry: ArgListEntry = ArgListEntry { ArgNode, V.getType() };
        Entry.setAttributes(&mut CB, I - CB.arg_begin());
        if Entry.IsSwiftError && TLI.supportSwiftError() {
            SwiftErrorVal = V;
            Entry.Node = self.DAG.getRegister(self.SwiftError.getOrCreateVRegUseAt(&mut CB, self.FuncInfo.MBB, V), EVT { TLI.getPointerTy(DL, 0) });
        }
        Args.push(Entry);
        if Entry.IsSRet && isa(V) {
            isTailCall = false;
        }
    }
    if CB.getOperandBundle(OB_cfguardtarget) {
        Bundle;
    } else {
        let mut V: *mut Value = operator(Bundle).Inputs[0].operator llvm::Value *();
        let mut Entry: ArgListEntry = ArgListEntry { V, self.getValue(V) };
        Entry.IsCFGuardTarget = true;
        Args.push(Entry);
    }
    if TLI.supportSwiftError() && SwiftErrorVal {
        isTailCall = false;
    }
    let mut CFIType: *mut ConstantInt = null;
    if CB.isIndirectCall() {
        if CB.getOperandBundle(OB_kcfi) {
            Bundle;
        } else {
            if !TLI.supportKCFIBundles() {
                report_fatal_error("Target doesn't support calls with kcfi operand bundles.", true);
            }
            CFIType = cast(operator(Bundle).Inputs[0]);
            assert!(CFIType.getType().isIntegerTy(32), "Invalid CFI type");
        }
    }
    let mut ConvControlToken: SDValue = SDValue {};
    if CB.getOperandBundle(OB_convergencectrl) {
        Bundle;
    } else {
        let mut Token: *mut Value = operator(Bundle).Inputs[0].get();
        ConvControlToken = self.getValue(Token);
    }
    let mut DeactivationSymbol: *mut GlobalValue = null;
    if CB.getOperandBundle(OB_deactivation_symbol) {
        Bundle;
    } else {
        DeactivationSymbol = cast(operator(Bundle).Inputs[0].get());
    }
    let mut CLI: CallLoweringInfo = CallLoweringInfo { self.DAG };
    CLI.setDebugLoc(self.getCurSDLoc()).setChain(self.getRoot())(RetTy, FTy, Callee, move(Args), CB)(isTailCall)(CB.isConvergent())(CB.countOperandBundlesOfType(OB_preallocated) != 0)(CFIType)(ConvControlToken)(DeactivationSymbol);
    if PAI {
        if !TLI.supportPtrAuthBundles() {
            report_fatal_error("This target doesn't support calls with ptrauth operand bundles.", true);
        }
        CLI.setPtrAuth(*PAI);
    }
    let mut Result: pair<SDValue, SDValue> = self.lowerInvokable(CLI, EHPadBB);
    if Result.first.getNode() {
        Result.first = self.lowerRangeToAssertZExt(self.DAG, CB, Result.first);
        Result.first = self.lowerNoFPClassToAssertNoFPClass(self.DAG, CB, Result.first);
        self.setValue(&mut CB, Result.first);
    }
    if SwiftErrorVal && TLI.supportSwiftError() {
        let mut Src: SDValue = CLI.InVals.back();
        let mut VReg: Register = self.SwiftError.getOrCreateVRegDefAt(&mut CB, self.FuncInfo.MBB, SwiftErrorVal);
        let mut CopyNode: SDValue = CLI.DAG.getCopyToReg(Result.second, CLI.DL, VReg, Src);
        self.DAG.setRoot(CopyNode);
    }
}

fn getMemCmpLoad(PtrVal: *Value, LoadVT: MVT, Builder: *mut SelectionDAGBuilder) -> SDValue {
    if dyn_cast(PtrVal) {
        LoadInput;
    } else {
        let mut LoadTy: *mut Type = getIntNTy(PtrVal.getContext(), LoadVT.getScalarSizeInBits());
        if LoadVT.isVector() {
            LoadTy = get(LoadTy, LoadVT.getVectorNumElements());
        }
        if ConstantFoldLoadFromConstPtr(LoadInput, LoadTy, Builder.DAG.getDataLayout()) {
            LoadCst;
        } else {
            return Builder.getValue(LoadCst);
        }
    }
    let mut Root: SDValue = SDValue {};
    let mut ConstantMemory: bool = false;
    if Builder.BatchAA && Builder.BatchAA.pointsToConstantMemory(PtrVal, false) {
        Root = Builder.DAG.getEntryNode();
        ConstantMemory = true;
    } else {
        Root = Builder.DAG.getRoot();
    }
    let mut Ptr: SDValue = Builder.getValue(PtrVal);
    let mut LoadVal: SDValue = Builder.DAG.getLoad(EVT { LoadVT }, Builder.getCurSDLoc(), Root, Ptr, MachinePointerInfo { PtrVal, 0, 0 }, MaybeAlign { Align { ShiftValue: 1 } }, MONone, MMOMetadata {});
    if !ConstantMemory {
        Builder.PendingLoads.push(LoadVal.getValue(1));
    }
    return LoadVal;
}

fn SelectionDAGBuilder::processIntegerCallValue(self, I: *Instruction, Value: SDValue, IsSigned: bool) {
    let mut VT: EVT = self.DAG.getTargetLoweringInfo().getValueType(self.DAG.getDataLayout(), I.getType(), true);
    Value = self.DAG.getExtOrTrunc(IsSigned, Value, self.getCurSDLoc(), VT);
    self.setValue(&mut I, Value);
}

fn SelectionDAGBuilder::visitMemCmpBCmpCall(self, I: *CallInst) -> bool {
    let mut LHS: *Value = I.getArgOperand(0);
    let mut RHS: *Value = I.getArgOperand(1);
    let mut Size: *Value = I.getArgOperand(2);
    let mut CSize: *ConstantSDNode = dyn_cast(self.getValue(Size));
    if CSize && CSize.getZExtValue() == 0 {
        let mut CallVT: EVT = self.DAG.getTargetLoweringInfo().getValueType(self.DAG.getDataLayout(), I.getType(), true);
        self.setValue(&mut I, self.DAG.getConstant(0, self.getCurSDLoc(), CallVT, false, false));
        return true;
    }
    let mut TSI: *SelectionDAGTargetInfo = self.DAG.getSelectionDAGInfo();
    let mut Res: pair<SDValue, SDValue> = TSI.EmitTargetCodeForMemcmp(self.DAG, self.getCurSDLoc(), self.DAG.getRoot(), self.getValue(LHS), self.getValue(RHS), self.getValue(Size), &mut I);
    if Res.first.getNode() {
        self.processIntegerCallValue(I, Res.first, true);
        self.PendingLoads.push(ValueParamT { Res.second });
        return true;
    }
    if !CSize || !isOnlyUsedInZeroEqualityComparison(&mut I) {
        return false;
    }
    let mut hasFastLoadsAndCompare: Closure_11 = Closure_11 { cap_0: self, LHS: &mut LHS, RHS: &mut RHS };
    let mut LoadVT: MVT = MVT {};
    let mut NumBitsToCompare: u32 = CSize.getZExtValue() * 8;
    match NumBitsToCompare {
        _ => {
            return false;
        },
        16 => {
            LoadVT = MVT { SimpleTy: i16 };
        },
        32 => {
            LoadVT = MVT { SimpleTy: i32 };
        },
        64 => {
            128;
        },
    }
    if LoadVT == INVALID_SIMPLE_VALUE_TYPE {
        return false;
    }
    let mut LoadL: SDValue = getMemCmpLoad(LHS, LoadVT, *self);
    let mut LoadR: SDValue = getMemCmpLoad(RHS, LoadVT, *self);
    if LoadVT.isVector() {
        let mut CmpVT: EVT = getIntegerVT(LHS.getContext(), LoadVT.getSizeInBits().operator unsigned long long());
        LoadL = self.DAG.getBitcast(CmpVT, LoadL);
        LoadR = self.DAG.getBitcast(CmpVT, LoadR);
    }
    let mut Cmp: SDValue = self.DAG.getSetCC(self.getCurSDLoc(), EVT { i1 }, LoadL, LoadR, SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
    self.processIntegerCallValue(I, Cmp, false);
    return true;
}

fn SelectionDAGBuilder::visitMemChrCall(self, I: *CallInst) -> bool {
    let mut Src: *Value = I.getArgOperand(0);
    let mut Char: *Value = I.getArgOperand(1);
    let mut Length: *Value = I.getArgOperand(2);
    let mut TSI: *SelectionDAGTargetInfo = self.DAG.getSelectionDAGInfo();
    let mut Res: pair<SDValue, SDValue> = TSI.EmitTargetCodeForMemchr(self.DAG, self.getCurSDLoc(), self.DAG.getRoot(), self.getValue(Src), self.getValue(Char), self.getValue(Length), MachinePointerInfo { Src, 0, 0 });
    if Res.first.getNode() {
        self.setValue(&mut I, Res.first);
        self.PendingLoads.push(ValueParamT { Res.second });
        return true;
    }
    return false;
}

fn SelectionDAGBuilder::visitMemCCpyCall(self, I: *CallInst) -> bool {
    let mut TSI: *SelectionDAGTargetInfo = self.DAG.getSelectionDAGInfo();
    let mut Res: pair<SDValue, SDValue> = TSI.EmitTargetCodeForMemccpy(self.DAG, self.getCurSDLoc(), self.DAG.getRoot(), self.getValue(I.getArgOperand(0)), self.getValue(I.getArgOperand(1)), self.getValue(I.getArgOperand(2)), self.getValue(I.getArgOperand(3)), &mut I);
    if Res.first {
        self.processIntegerCallValue(I, Res.first, true);
        self.PendingLoads.push(ValueParamT { Res.second });
        return true;
    }
    return false;
}

fn SelectionDAGBuilder::visitMemPCpyCall(self, I: *CallInst) -> bool {
    let mut Dst: SDValue = self.getValue(I.getArgOperand(0));
    let mut Src: SDValue = self.getValue(I.getArgOperand(1));
    let mut Size: SDValue = self.getValue(I.getArgOperand(2));
    let mut DstAlign: Align = self.DAG.InferPtrAlign(Dst).valueOrOne();
    let mut SrcAlign: Align = self.DAG.InferPtrAlign(Src).valueOrOne();
    let mut sdl: SDLoc = self.getCurSDLoc();
    let mut Root: SDValue = self.getMemoryRoot();
    let mut MC: SDValue = self.DAG.getMemcpy(Root, sdl, Dst, Src, Size, DstAlign, SrcAlign, false, false, null, optional<bool> { nullopt }, MachinePointerInfo { I.getArgOperand(0), 0, 0 }, MachinePointerInfo { I.getArgOperand(1), 0, 0 }, I.getAAMetadata(), null);
    assert!(MC.getNode() != null, "** memcpy should not be lowered as TailCall in mempcpy context **");
    self.DAG.setRoot(MC);
    Size = self.DAG.getSExtOrTrunc(Size, sdl, Dst.getValueType());
    let mut DstPlusSize: SDValue = self.DAG.getMemBasePlusOffset(Dst, Size, sdl, SDNodeFlags { Flags: None });
    self.setValue(&mut I, DstPlusSize);
    return true;
}

fn SelectionDAGBuilder::visitStrCpyCall(self, I: *CallInst, isStpcpy: bool) -> bool {
    let mut Arg0: *Value = I.getArgOperand(0);
    let mut Arg1: *Value = I.getArgOperand(1);
    let mut TSI: *SelectionDAGTargetInfo = self.DAG.getSelectionDAGInfo();
    let mut Res: pair<SDValue, SDValue> = TSI.EmitTargetCodeForStrcpy(self.DAG, self.getCurSDLoc(), self.getRoot(), self.getValue(Arg0), self.getValue(Arg1), MachinePointerInfo { Arg0, 0, 0 }, MachinePointerInfo { Arg1, 0, 0 }, isStpcpy, &mut I);
    if Res.first.getNode() {
        self.setValue(&mut I, Res.first);
        self.DAG.setRoot(Res.second);
        return true;
    }
    return false;
}

fn SelectionDAGBuilder::visitStrCmpCall(self, I: *CallInst) -> bool {
    let mut Arg0: *Value = I.getArgOperand(0);
    let mut Arg1: *Value = I.getArgOperand(1);
    let mut TSI: *SelectionDAGTargetInfo = self.DAG.getSelectionDAGInfo();
    let mut Res: pair<SDValue, SDValue> = TSI.EmitTargetCodeForStrcmp(self.DAG, self.getCurSDLoc(), self.DAG.getRoot(), self.getValue(Arg0), self.getValue(Arg1), MachinePointerInfo { Arg0, 0, 0 }, MachinePointerInfo { Arg1, 0, 0 }, &mut I);
    if Res.first.getNode() {
        self.processIntegerCallValue(I, Res.first, true);
        self.PendingLoads.push(ValueParamT { Res.second });
        return true;
    }
    return false;
}

fn SelectionDAGBuilder::visitStrLenCall(self, I: *CallInst) -> bool {
    let mut Arg0: *Value = I.getArgOperand(0);
    let mut TSI: *SelectionDAGTargetInfo = self.DAG.getSelectionDAGInfo();
    let mut Res: pair<SDValue, SDValue> = TSI.EmitTargetCodeForStrlen(self.DAG, self.getCurSDLoc(), self.DAG.getRoot(), self.getValue(Arg0), &mut I);
    if Res.first.getNode() {
        self.processIntegerCallValue(I, Res.first, false);
        self.PendingLoads.push(ValueParamT { Res.second });
        return true;
    }
    return false;
}

fn SelectionDAGBuilder::visitStrNLenCall(self, I: *CallInst) -> bool {
    let mut Arg0: *Value = I.getArgOperand(0);
    let mut Arg1: *Value = I.getArgOperand(1);
    let mut TSI: *SelectionDAGTargetInfo = self.DAG.getSelectionDAGInfo();
    let mut Res: pair<SDValue, SDValue> = TSI.EmitTargetCodeForStrnlen(self.DAG, self.getCurSDLoc(), self.DAG.getRoot(), self.getValue(Arg0), self.getValue(Arg1), MachinePointerInfo { Arg0, 0, 0 });
    if Res.first.getNode() {
        self.processIntegerCallValue(I, Res.first, false);
        self.PendingLoads.push(ValueParamT { Res.second });
        return true;
    }
    return false;
}

fn SelectionDAGBuilder::visitStrstrCall(self, I: *CallInst) -> bool {
    let mut TSI: *SelectionDAGTargetInfo = self.DAG.getSelectionDAGInfo();
    let mut Arg0: *Value = I.getArgOperand(0);
    let mut Arg1: *Value = I.getArgOperand(1);
    let mut Res: pair<SDValue, SDValue> = TSI.EmitTargetCodeForStrstr(self.DAG, self.getCurSDLoc(), self.DAG.getRoot(), self.getValue(Arg0), self.getValue(Arg1), &mut I);
    if Res.first {
        self.processIntegerCallValue(I, Res.first, false);
        self.PendingLoads.push(ValueParamT { Res.second });
        return true;
    }
    return false;
}

fn SelectionDAGBuilder::visitUnaryFloatCall(self, I: *CallInst, Opcode: u32) -> bool {
    if !I.onlyReadsMemory() || I.isStrictFP() {
        return false;
    }
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    Flags.copyFMF(cast(I));
    let mut Tmp: SDValue = self.getValue(I.getArgOperand(0));
    self.setValue(&mut I, self.DAG.getNode(Opcode, self.getCurSDLoc(), Tmp.getValueType(), Tmp, Flags));
    return true;
}

fn SelectionDAGBuilder::visitBinaryFloatCall(self, I: *CallInst, Opcode: u32) -> bool {
    if !I.onlyReadsMemory() || I.isStrictFP() {
        return false;
    }
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    Flags.copyFMF(cast(I));
    let mut Tmp0: SDValue = self.getValue(I.getArgOperand(0));
    let mut Tmp1: SDValue = self.getValue(I.getArgOperand(1));
    let mut VT: EVT = Tmp0.getValueType();
    self.setValue(&mut I, self.DAG.getNode(Opcode, self.getCurSDLoc(), VT, Tmp0, Tmp1, Flags));
    return true;
}

fn SelectionDAGBuilder::visitCall(self, I: *CallInst) {
    if I.isInlineAsm() {
        self.visitInlineAsm(I, null);
        return;
    }
    diagnoseDontCall(I);
    if I.getCalledFunction() {
        F;
    } else {
        if F.isDeclaration() {
            if F.getIntrinsicID() {
                IID;
            } else {
                self.visitIntrinsicCall(I, IID);
                return;
            }
        }
        let mut Func: LibFunc = if !I.isNoBuiltin() && !F.hasLocalLinkage() && F.hasName() { self.LibInfo.getLibFunc(*F) } else { NotLibFunc };
        if self.LibInfo.hasOptimizedCodeGen(Func) {
            match Func {
                _ => {
                    break;
                },
                LibFunc_bcmp => {
                    if self.visitMemCmpBCmpCall(I) {
                        return;
                    }
                },
                LibFunc_copysign => {
                    LibFunc_copysignf;
                },
                LibFunc_sin => {
                    LibFunc_sinf;
                },
                LibFunc_cos => {
                    LibFunc_cosf;
                },
                LibFunc_tan => {
                    LibFunc_tanf;
                },
                LibFunc_asin => {
                    LibFunc_asinf;
                },
                LibFunc_acos => {
                    LibFunc_acosf;
                },
                LibFunc_atan => {
                    LibFunc_atanf;
                },
                LibFunc_atan2 => {
                    LibFunc_atan2f;
                },
                LibFunc_sinh => {
                    LibFunc_sinhf;
                },
                LibFunc_cosh => {
                    LibFunc_coshf;
                },
                LibFunc_tanh => {
                    LibFunc_tanhf;
                },
                LibFunc_sqrt => {
                    LibFunc_sqrtf;
                },
                LibFunc_log2 => {
                    LibFunc_log2f;
                },
                LibFunc_exp2 => {
                    LibFunc_exp2f;
                },
                LibFunc_exp10 => {
                    LibFunc_exp10f;
                },
                LibFunc_ldexp => {
                    LibFunc_ldexpf;
                },
                LibFunc_strstr => {
                    if self.visitStrstrCall(I) {
                        return;
                    }
                },
                LibFunc_memcmp => {
                    if self.visitMemCmpBCmpCall(I) {
                        return;
                    }
                },
                LibFunc_memccpy => {
                    if self.visitMemCCpyCall(I) {
                        return;
                    }
                },
                LibFunc_mempcpy => {
                    if self.visitMemPCpyCall(I) {
                        return;
                    }
                },
                LibFunc_memchr => {
                    if self.visitMemChrCall(I) {
                        return;
                    }
                },
                LibFunc_strcpy => {
                    if self.visitStrCpyCall(I, false) {
                        return;
                    }
                },
                LibFunc_stpcpy => {
                    if self.visitStrCpyCall(I, true) {
                        return;
                    }
                },
                LibFunc_strcmp => {
                    if self.visitStrCmpCall(I) {
                        return;
                    }
                },
                LibFunc_strlen => {
                    if self.visitStrLenCall(I) {
                        return;
                    }
                },
                LibFunc_strnlen => {
                    if self.visitStrNLenCall(I) {
                        return;
                    }
                },
            }
        }
    }
    if I.countOperandBundlesOfType(OB_ptrauth) {
        self.LowerCallSiteWithPtrAuthBundle(cast(I), null);
        return;
    }
    failForInvalidBundles(I, "calls", ArrayRef<uint32_t> { [OB_deopt, OB_funclet, OB_cfguardtarget, OB_preallocated, OB_clang_arc_attachedcall, OB_kcfi, OB_convergencectrl, OB_deactivation_symbol] });
    let mut Callee: SDValue = self.getValue(I.getCalledOperand());
    if I.hasDeoptState() {
        self.LowerCallSiteWithDeoptBundle(&mut I, Callee, null);
    } else {
        self.LowerCallTo(I, Callee, I.isTailCall(), I.isMustTailCall(), null, null);
    }
}

fn SelectionDAGBuilder::LowerCallSiteWithPtrAuthBundle(self, CB: *CallBase, EHPadBB: *BasicBlock) {
    let mut PAB: optional<OperandBundleUse> = CB.getOperandBundle("ptrauth");
    let mut CalleeV: *Value = CB.getCalledOperand();
    let mut Key: *auto = cast(operator(PAB).Inputs[0]);
    let mut Discriminator: *Value = operator(PAB).Inputs[1].operator llvm::Value *();
    (((operator!(operator!((Key()()(32) && "Invalid ptrauth key")))) || (_wassert(L"Key->getType()->isIntegerTy(32) && \"Invalid ptrauth key\"", L"llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", (10112) as u32) , 0)) as void);
    assert!(Discriminator.getType().isIntegerTy(64), "Invalid ptrauth discriminator");
    if  {
        if CalleeCPA()(Discriminator, self.DAG.getDataLayout()) {
            return self.LowerCallTo(CB, self.getValue(), CB.isTailCall(), CB.isMustTailCall(), EHPadBB);
        }
    }
    assert!(!isa(CalleeV), "invalid direct ptrauth call");
    let mut PAI: PtrAuthInfo = void { (), self.getValue(Discriminator) };
    self.LowerCallTo(CB, self.getValue(CalleeV), CB.isTailCall(), CB.isMustTailCall(), EHPadBB, &mut PAI);
}

struct SDISelAsmOperandInfo {
    CallOperand: SDValue,
    AssignedRegs: RegsForValue,
}

fn SDISelAsmOperandInfo::hasMemory(self: *SDISelAsmOperandInfo, TLI: *TargetLowering) -> bool {
    if self.isIndirect {
        return true;
    }
    return false;
}

fn patchMatchingInput(OpInfo: *SDISelAsmOperandInfo, MatchingOpInfo: *mut SDISelAsmOperandInfo, DAG: *mut SelectionDAG) {
    if OpInfo.ConstraintVT == MatchingOpInfo.ConstraintVT {
        return;
    }
    let mut TRI: *TargetRegisterInfo = DAG.getSubtarget().getRegisterInfo();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut MatchRC: pair<unsigned int, const TargetRegisterClass *> = zeroed();
    let mut InputRC: pair<unsigned int, const TargetRegisterClass *> = zeroed();
    let mut OutOpIsIntOrFP: bool = OpInfo.ConstraintVT.isInteger() || OpInfo.ConstraintVT.isFloatingPoint();
    let mut InOpIsIntOrFP: bool = MatchingOpInfo.ConstraintVT.isInteger() || MatchingOpInfo.ConstraintVT.isFloatingPoint();
    if (OutOpIsIntOrFP != InOpIsIntOrFP) || (MatchRC() != ) {
        report_fatal_error("Unsupported asm: input constraint with a matching output constraint of incompatible type!", true);
    }
    MatchingOpInfo.ConstraintVT = OpInfo.ConstraintVT;
}

fn getAddressForMemoryInput(Chain: SDValue, Location: *SDLoc, OpInfo: *mut SDISelAsmOperandInfo, DAG: *mut SelectionDAG) -> SDValue {
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut OpVal: *Value = OpInfo.CallOperandVal;
    if isa(OpVal) || isa(OpVal) || isa(OpVal) || isa(OpVal) {
        OpInfo.CallOperand = DAG(cast(OpVal), TLI.getPointerTy(DAG.getDataLayout(), 0));
        return Chain;
    }
    let mut Ty: *mut Type = OpVal.getType();
    let mut DL: *DataLayout = DAG.getDataLayout();
    let mut TySize: TypeSize = DL.getTypeAllocSize(Ty);
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut TFI: *TargetFrameLowering = MF.getSubtarget().getFrameLowering();
    let mut StackID: i32 = 0;
    if TySize.isScalable() {
        StackID = TFI.getStackIDForScalableVectors();
    }
    let mut SSFI: i32 = MF.getFrameInfo().CreateStackObject(TySize.getKnownMinValue(), DL.getPrefTypeAlign(Ty), false, null, StackID);
    let mut StackSlot: SDValue = DAG.getFrameIndex(SSFI, EVT { TLI.getFrameIndexTy(DL) }, false);
    Chain = DAG.getTruncStore(Chain, Location, OpInfo.CallOperand, StackSlot, getFixedStack(MF, SSFI, 0), TLI.getMemValueType(DL, Ty, false), MaybeAlign {}, MONone, MMOMetadata {});
    OpInfo.CallOperand = StackSlot;
    return Chain;
}

fn getRegistersForValue(DAG: *mut SelectionDAG, DL: *SDLoc, OpInfo: *mut SDISelAsmOperandInfo, RefOpInfo: *mut SDISelAsmOperandInfo) -> optional<unsigned int> {
    let mut Context: *mut LLVMContext = *DAG.getContext();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut Regs: SmallVector<Register, 4> = SmallVector<Register, 4> {};
    let mut TRI: *TargetRegisterInfo = *MF.getSubtarget().getRegisterInfo();
    if OpInfo.ConstraintType == C_Memory || OpInfo.ConstraintType == C_Address {
        return optional<unsigned int> { nullopt };
    }
    let mut AssignedReg: u32 = 0;
    let mut RC: *TargetRegisterClass = null;
    tie(AssignedReg, RC) = TLI.getRegForInlineAsmConstraint;
    if !RC {
        return optional<unsigned int> { nullopt };
    }
    let mut RegVT: MVT = MVT { SimpleTy: *TRI.legalclasstypes_begin(*RC) };
    if OpInfo.ConstraintVT != Other && RegVT != Untyped {
        if (OpInfo.Type == isOutput || OpInfo.Type == isInput) && !TRI.isTypeLegalForClass(*RC, OpInfo.ConstraintVT) {
            if RegVT.getSizeInBits() == OpInfo.ConstraintVT.getSizeInBits() {
                if OpInfo.Type == isInput && !OpInfo.isIndirect {
                    OpInfo.CallOperand = DAG.getNode(BITCAST, DL, EVT { RegVT }, OpInfo.CallOperand);
                }
                OpInfo.ConstraintVT = RegVT;
            } else if RegVT.isInteger() && OpInfo.ConstraintVT.isFloatingPoint() {
                let mut VT: MVT = getIntegerVT(OpInfo.ConstraintVT.getSizeInBits().operator unsigned long long());
                if OpInfo.Type == isInput {
                    OpInfo.CallOperand = DAG.getNode(BITCAST, DL, EVT { VT }, OpInfo.CallOperand);
                }
                OpInfo.ConstraintVT = VT;
            }
        }
    }
    if OpInfo.isMatchingInputConstraint() {
        return optional<unsigned int> { nullopt };
    }
    let mut ValueVT: EVT = EVT { OpInfo.ConstraintVT };
    if OpInfo.ConstraintVT == Other {
        ValueVT = EVT { RegVT };
    }
    let mut NumRegs: u32 = 1;
    if OpInfo.ConstraintVT != Other {
        NumRegs = TLI.getNumRegisters;
    }
    let mut I: iterator = RC.begin();
    let mut RegInfo: *mut MachineRegisterInfo = MF.getRegInfo();
    if AssignedReg {
        I = find(I, RC.end(), AssignedReg);
        if I == RC.end() {
            return void { AssignedReg };
        }
    }
    for ; NumRegs; NumRegs -= 1 , I += 1 {
        assert!(I != RC.end(), "Ran out of registers to allocate!");
        let mut R: Register = if AssignedReg { Register { Reg: *I } } else { RegInfo.createVirtualRegister(RC, "") };
        Regs.push(ValueParamT { R });
    }
    OpInfo.AssignedRegs = RegsForValue { Regs, RegVT, ValueVT, ID> { nullopt } };
    return optional<unsigned int> { nullopt };
}

fn findMatchingInlineAsmOperand(OperandNo: u32, AsmNodeOperands: i32) -> u32 {
    let mut CurOp: u32 = Op_FirstOperand;
    for ; OperandNo; OperandNo -= 1 {
        let mut OpFlag: u32 = [CurOp]();
        let mut F: Flag = Flag { OpFlag };
        assert!((F.isRegDefKind() || F.isRegDefEarlyClobberKind() || F.isMemKind()), "Skipped past definitions?");
        CurOp += F.getNumOperandRegisters() + 1;
    }
    return CurOp;
}

struct ExtraFlags {
    Flags: u32,
}

fn ExtraFlags::ExtraFlags(self, Call: *CallBase) {
    let mut IA: *InlineAsm = cast(Call.getCalledOperand());
    if IA.hasSideEffects() {
        self.Flags |= Extra_HasSideEffects;
    }
    if IA.isAlignStack() {
        self.Flags |= Extra_IsAlignStack;
    }
    if IA.canThrow() {
        self.Flags |= Extra_MayUnwind;
    }
    if Call.isConvergent() {
        self.Flags |= Extra_IsConvergent;
    }
    self.Flags |= IA.getDialect() * Extra_AsmDialect;
}

fn ExtraFlags::update(self, OpInfo: *AsmOperandInfo) {
    if OpInfo.ConstraintType == C_Memory || OpInfo.ConstraintType == C_Other {
        if OpInfo.Type == isInput {
            self.Flags |= Extra_MayLoad;
        } else if OpInfo.Type == isOutput {
            self.Flags |= Extra_MayStore;
        } else if OpInfo.Type == isClobber {
            self.Flags |= (Extra_MayLoad | Extra_MayStore);
        }
    }
}

fn ExtraFlags::get(self: *ExtraFlags) -> u32 {
    return self.Flags;
}

fn isFunction(Op: SDValue) -> bool {
    if Op && Op.getOpcode() == GlobalAddress {
        if  {
            let mut Fn: auto = dyn_cast_or_null();
            if Fn() && operator!() {
                return true;
            }
        }
    }
    return false;
}

struct ConstraintDecisionInfo {
    ConstraintOperands: SmallVector<SDISelAsmOperandInfo, 16>,
    AsmNodeOperands: i32,
    Glue: SDValue,
    Chain: SDValue,
    HasSideEffect: bool,
    BeginLabel: *mut MCSymbol,
    Buffer: i32,
    ErrorMsg: raw_svector_ostream,
}

fn constructOperandInfo(Info: *mut ConstraintDecisionInfo, TargetConstraints: *mut AsmOperandInfoVector, Builder: *mut SelectionDAGBuilder, TLI: *TargetLowering, ExtraInfo: *mut ExtraFlags) -> bool {
    return false;
}

fn computeConstraintToUse(Info: *mut ConstraintDecisionInfo, Call: *CallBase, TargetConstraints: *mut AsmOperandInfoVector, Builder: *mut SelectionDAGBuilder, TLI: *TargetLowering, TM: *TargetMachine, DAG: *mut SelectionDAG) {
    let mut IA: *auto = cast(Call.getCalledOperand());
    let mut AsmStrs: SmallVector<StringRef, 4> = zeroed();
    IA()();
    let mut OpNo: i32 = -1;
}

fn prepareDAGLevelOperands(Info: *mut ConstraintDecisionInfo, Call: *CallBase, Builder: *mut SelectionDAGBuilder, TLI: *TargetLowering, DAG: *mut SelectionDAG) -> bool {
    let mut DL: SDLoc = Builder.getCurSDLoc();
    return false;
}

fn determineConstraints(Info: *mut ConstraintDecisionInfo, TargetConstraints: *mut AsmOperandInfoVector, Call: *CallBase, Builder: *mut SelectionDAGBuilder, TLI: *TargetLowering, TM: *TargetMachine, DAG: *mut SelectionDAG, EHPadBB: *BasicBlock) -> bool {
    let mut IA: *auto = cast(Call.getCalledOperand());
    let mut ExtraInfo: ExtraFlags = ExtraFlags { Flags: Call };
    Info.HasSideEffect = ();
    if constructOperandInfo(Info, TargetConstraints, Builder, TLI, ExtraInfo) {
        return true;
    }
    Info.Chain = if Info.HasSideEffect { Builder.getRoot() } else { DAG.getRoot() };
    let mut IsCallBr: bool = isa(Call);
    let mut EmitEHLabels: bool = isa(Call);
    if IsCallBr || EmitEHLabels {
        Info.Chain = Builder.getControlRoot();
    }
    if EmitEHLabels {
        Info.Chain = Builder.lowerStartEH(Info.Chain, EHPadBB, Info.BeginLabel);
    }
    computeConstraintToUse(Info, Call, TargetConstraints, Builder, TLI, TM, DAG);
    Info()(SDValue {});
    Info()(DAG(()(), TLI.getProgramPointerTy(DAG.getDataLayout())));
    let mut SrcLoc: *MDNode = Call.getMetadata("srcloc");
    Info()(DAG.getMDNode(SrcLoc));
    Info()(DAG.getTargetConstant(ExtraInfo.get(), Builder.getCurSDLoc(), EVT { TLI.getPointerTy(DAG.getDataLayout(), 0) }, false));
    return prepareDAGLevelOperands(Info, Call, Builder, TLI, DAG);
}

fn SelectionDAGBuilder::visitInlineAsm(self, Call: *CallBase, EHPadBB: *BasicBlock) {
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut TargetConstraints: AsmOperandInfoVector = zeroed();
    assert!((!isa(Call) || EHPadBB), "InvokeInst must have an EHPadBB");
    let mut Info: ConstraintDecisionInfo = ConstraintDecisionInfo {};
    if determineConstraints(Info, Call, *self, TLI, self.TM, self.DAG, EHPadBB) {
        return self.emitInlineAsmError(Call, Info.ErrorMsg);
    }
    let mut Glue: SDValue = Info.Glue;
    let mut Chain: SDValue = Info.Chain;
    Info()[Op_InputChain] = Chain;
    if Glue.getNode() {
        Info()(Glue);
    }
    let mut IsCallBr: bool = isa(Call);
    let mut ISDOpc: u32 = if IsCallBr { INLINEASM_BR } else { INLINEASM };
    Chain = self.DAG(ISDOpc, self.getCurSDLoc(), self.DAG.getVTList(EVT { Other }, EVT { Glue }), Info());
    Glue = Chain.getValue(1);
    let mut ResultVTs: SmallVector<EVT, 1> = zeroed();
    let mut ResultValues: SmallVector<SDValue, 1> = zeroed();
    let mut OutChains: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut CallResultType: *mut Type = Call.getType();
    let mut ResultTypes: ArrayRef<Type *> = ArrayRef<Type *> {};
    if dyn_cast(CallResultType) {
        StructResult;
    } else {
        ResultTypes = StructResult.elements();
    }
    let mut CurResultType: iterator = ResultTypes.begin();
    let mut handleRegAssign: Closure_12 = Closure_12 { CurResultType: &mut CurResultType, ResultTypes: &mut ResultTypes, TLI: &mut TLI, cap_3: self };
    if operator!() {
        assert!(CurResultType == ResultTypes.end(), "Mismatch in number of ResultTypes");
        (((operator!(operator!((ResultValues()() == ResultTypes.len && "Mismatch in number of output operands in asm result")))) || (_wassert(L"ResultValues.size() == ResultTypes.size() && \"Mismatch in number of output operands in asm result\"", L"llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", (11013) as u32) , 0)) as void);
        let mut V: SDValue = self.DAG(MERGE_VALUES, self.getCurSDLoc(), self.DAG());
        self.setValue(&mut Call, V);
    }
    if !OutChains.is_empty() {
        Chain = self.DAG;
    }
    if  {
        Chain = self.lowerEndEH(Chain, EHPadBB, Info.BeginLabel);
    }
    if ResultValues()() || Info.HasSideEffect || !OutChains.is_empty() || IsCallBr || isa(Call) {
        self.DAG.setRoot(Chain);
    }
}

fn SelectionDAGBuilder::emitInlineAsmError(self, Call: *CallBase, Message: str) {
    let mut Ctx: *mut LLVMContext = *self.DAG.getContext();
    Ctx.diagnose(DiagnosticInfoInlineAsm { Call, Message, DS_Error });
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut ValueVTs: SmallVector<EVT, 1> = zeroed();
    ComputeValueVTs(TLI, self.DAG.getDataLayout(), Call.getType());
    if ValueVTs()() {
        return;
    }
    let mut Ops: SmallVector<SDValue, 1> = zeroed();
    self.setValue(&mut Call, self.DAG.getMergeValues(self.getCurSDLoc()));
}

fn SelectionDAGBuilder::visitVAStart(self, I: *CallInst) {
    self.DAG.setRoot(self.DAG.getNode(VASTART, self.getCurSDLoc(), EVT { Other }, self.getRoot(), self.getValue(I.getArgOperand(0)), self.DAG.getSrcValue(I.getArgOperand(0))));
}

fn SelectionDAGBuilder::visitVAArg(self, I: *VAArgInst) {
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut DL: *DataLayout = self.DAG.getDataLayout();
    let mut V: SDValue = self.DAG.getVAArg(TLI.getMemValueType(self.DAG.getDataLayout(), I.getType(), false), self.getCurSDLoc(), self.getRoot(), self.getValue(I.getOperand(0)), self.DAG.getSrcValue(I.getOperand(0)), DL.getABITypeAlign(I.getType()).value());
    self.DAG.setRoot(V.getValue(1));
    if I.getType().isPointerTy() {
        V = self.DAG.getPtrExtOrTrunc(V, self.getCurSDLoc(), TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false));
    }
    self.setValue(&mut I, V);
}

fn SelectionDAGBuilder::visitVAEnd(self, I: *CallInst) {
    self.DAG.setRoot(self.DAG.getNode(VAEND, self.getCurSDLoc(), EVT { Other }, self.getRoot(), self.getValue(I.getArgOperand(0)), self.DAG.getSrcValue(I.getArgOperand(0))));
}

fn SelectionDAGBuilder::visitVACopy(self, I: *CallInst) {
    self.DAG.setRoot(self.DAG.getNode(VACOPY, self.getCurSDLoc(), EVT { Other }, self.getRoot(), self.getValue(I.getArgOperand(0)), self.getValue(I.getArgOperand(1)), self.DAG.getSrcValue(I.getArgOperand(0)), self.DAG.getSrcValue(I.getArgOperand(1))));
}

fn SelectionDAGBuilder::lowerRangeToAssertZExt(self, DAG: *mut SelectionDAG, I: *Instruction, Op: SDValue) -> SDValue {
    let mut CR: optional<ConstantRange> = getRange(I);
    if !CR || operator(CR).isFullSet() || operator(CR).isEmptySet() || operator(CR).isUpperWrapped() {
        return Op;
    }
    let mut Hi: APInt = operator(CR).getUnsignedMax();
    let mut Bits: u32 = max(Hi.getActiveBits(), MIN_INT_BITS as u32);
    let mut SmallVT: EVT = getIntegerVT(*DAG.getContext(), Bits);
    let mut SL: SDLoc = self.getCurSDLoc();
    let mut ZExt: SDValue = DAG.getNode(AssertZext, SL, Op.getValueType(), Op, DAG.getValueType(SmallVT));
    let mut NumVals: u32 = Op.getNode().getNumValues();
    if NumVals == 1 {
        return ZExt;
    }
    let mut Ops: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    Ops.push(ValueParamT { ZExt });
    for let mut I: u32 = 1; I != NumVals; I += 1 {
        Ops.push(Op.getValue(I));
    }
    return DAG.getMergeValues;
}

fn SelectionDAGBuilder::lowerNoFPClassToAssertNoFPClass(self, DAG: *mut SelectionDAG, I: *Instruction, Op: SDValue) -> SDValue {
    let mut Classes: FPClassTest = getNoFPClass(I);
    if Classes == fcNone {
        return Op;
    }
    let mut SL: SDLoc = self.getCurSDLoc();
    let mut TestConst: SDValue = DAG.getTargetConstant(Classes, SDLoc {}, EVT { i32 }, false);
    if Op.getOpcode() != MERGE_VALUES {
        return DAG.getNode(AssertNoFPClass, SL, Op.getValueType(), Op, TestConst);
    }
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { Op.getNumOperands() };
    for let mut I: u32 = 0;
let mut E: u32 = Ops.len; I != E; I += 1 {
        let mut MergeOp: SDValue = Op.getOperand(I);
        Ops[I] = DAG.getNode(AssertNoFPClass, SL, MergeOp.getValueType(), MergeOp, TestConst);
    }
    return DAG.getMergeValues;
}

fn SelectionDAGBuilder::populateCallLoweringInfo(self, CLI: *mut CallLoweringInfo, Call: *CallBase, ArgIdx: u32, NumArgs: u32, Callee: SDValue, ReturnTy: *mut Type, RetAttrs: AttributeSet, IsPatchPoint: bool) {
    let mut Args: ArgListTy = ArgListTy {};
    Args.reserve(NumArgs);
    for let mut ArgI: u32 = ArgIdx;
let mut ArgE: u32 = ArgIdx + NumArgs; ArgI != ArgE; ArgI += 1 {
        let mut V: *Value = Call.getOperand(ArgI);
        assert!(!V.getType().isEmptyTy(), "Empty type passed to intrinsic.");
        let mut Entry: ArgListEntry = ArgListEntry { self.getValue(V), V.getType() };
        Entry.setAttributes(Call, ArgI);
        Args.push(Entry);
    }
    CLI.setDebugLoc(self.getCurSDLoc()).setChain(self.getRoot())(Call.getCallingConv(), ReturnTy, Callee, move(Args), RetAttrs)(Call.use_empty())(IsPatchPoint)(Call.countOperandBundlesOfType(OB_preallocated) != 0);
}

fn addStackMapLiveVars(Call: *CallBase, StartIdx: u32, DL: *SDLoc, Ops: *mut SmallVectorImpl<SDValue>, Builder: *mut SelectionDAGBuilder) {
    let mut DAG: *mut SelectionDAG = Builder.DAG;
    for let mut I: u32 = StartIdx; I < Call.arg_size(); I += 1 {
        let mut Op: SDValue = Builder.getValue(Call.getArgOperand(I));
        if dyn_cast(Op) {
            FI;
        } else {
            Ops.push(DAG.getTargetFrameIndex(FI.getIndex(), Op.getValueType()));
        }
    }
}

fn SelectionDAGBuilder::visitStackmap(self, CI: *CallInst) {
    assert!(CI.getType().isVoidTy(), "Stackmap cannot return a value.");
    let mut Chain: SDValue = SDValue {};
    let mut InGlue: SDValue = SDValue {};
    let mut Callee: SDValue = SDValue {};
    let mut Ops: SmallVector<SDValue, 32> = SmallVector<SDValue, 32> {};
    let mut DL: SDLoc = self.getCurSDLoc();
    Callee = self.getValue(CI.getCalledOperand());
    Chain = self.DAG.getCALLSEQ_START(self.getRoot(), 0, 0, DL);
    InGlue = Chain.getValue(1);
    Ops.push(ValueParamT { Chain });
    Ops.push(ValueParamT { InGlue });
    let mut ID: SDValue = self.getValue(CI.getArgOperand(0));
    assert!(ID.getValueType() == EVT { i64 });
    let mut IDConst: SDValue = self.DAG.getTargetConstant(operator(ID).getAsZExtVal(), DL, ID.getValueType(), false);
    Ops.push(ValueParamT { IDConst });
    let mut Shad: SDValue = self.getValue(CI.getArgOperand(1));
    assert!(Shad.getValueType() == EVT { i32 });
    let mut ShadConst: SDValue = self.DAG.getTargetConstant(operator(Shad).getAsZExtVal(), DL, Shad.getValueType(), false);
    Ops.push(ValueParamT { ShadConst });
    addStackMapLiveVars(CI, 2, DL, Ops, *self);
    let mut NodeTys: SDVTList = self.DAG.getVTList(EVT { Other }, EVT { Glue });
    Chain = self.DAG;
    InGlue = Chain.getValue(1);
    Chain = self.DAG.getCALLSEQ_END(Chain, 0, 0, InGlue, DL);
    self.DAG.setRoot(Chain);
    self.FuncInfo.MF.getFrameInfo().setHasStackMap(true);
}

fn SelectionDAGBuilder::visitPatchpoint(self, CB: *CallBase, EHPadBB: *BasicBlock) {
    let mut CC: ID = CB.getCallingConv();
    let mut IsAnyRegCC: bool = CC == AnyReg;
    let mut HasDef: bool = !CB.getType().isVoidTy();
    let mut dl: SDLoc = self.getCurSDLoc();
    let mut Callee: SDValue = self.getValue(CB.getArgOperand(TargetPos));
    if  {
        Callee = self.DAG.getIntPtrConstant(dl, true);
    } else if  {
        Callee = self.DAG.getTargetGlobalAddress((0));
    }
    let mut NArgVal: SDValue = self.getValue(CB.getArgOperand(NArgPos));
    let mut NumArgs: u32 = operator(NArgVal).getAsZExtVal();
    let mut NumMetaOpers: u32 = CCPos;
    assert!(CB.arg_size() >= NumMetaOpers + NumArgs, "Not enough arguments provided to the patchpoint intrinsic");
    let mut NumCallArgs: u32 = if IsAnyRegCC { 0 } else { NumArgs };
    let mut ReturnTy: *mut Type = if IsAnyRegCC { getVoidTy(*self.DAG.getContext()) } else { CB.getType() };
    let mut CLI: CallLoweringInfo = CallLoweringInfo { self.DAG };
    self.populateCallLoweringInfo(CLI, &mut CB, NumMetaOpers, NumCallArgs, Callee, ReturnTy, CB.getAttributes().getRetAttrs(), true);
    let mut Result: pair<SDValue, SDValue> = self.lowerInvokable(CLI, EHPadBB);
    let mut CallEnd: *mut SDNode = Result.second.getNode();
    if CallEnd.getOpcode() == EH_LABEL {
        CallEnd = CallEnd.getOperand(0).getNode();
    }
    if HasDef && (CallEnd.getOpcode() == CopyFromReg) {
        CallEnd = CallEnd.getOperand(0).getNode();
    }
    assert!(CallEnd.getOpcode() == CALLSEQ_END, "Expected a callseq node.");
    let mut Call: *mut SDNode = CallEnd.getOperand(0).getNode();
    let mut HasGlue: bool = Call.getGluedNode();
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    Ops.push(ValueParamT { *(Call.op_begin()).operator const llvm::SDValue &() });
    if HasGlue {
        Ops.push(ValueParamT { *(Call.op_end() - 1).operator const llvm::SDValue &() });
    }
    if HasGlue {
        Ops.push(ValueParamT { *(Call.op_end() - 2).operator const llvm::SDValue &() });
    } else {
        Ops.push(ValueParamT { *(Call.op_end() - 1).operator const llvm::SDValue &() });
    }
    let mut IDVal: SDValue = self.getValue(CB.getArgOperand(IDPos));
    Ops.push(self.DAG.getTargetConstant(operator(IDVal).getAsZExtVal(), dl, EVT { i64 }, false));
    let mut NBytesVal: SDValue = self.getValue(CB.getArgOperand(NBytesPos));
    Ops.push(self.DAG.getTargetConstant(operator(NBytesVal).getAsZExtVal(), dl, EVT { i32 }, false));
    Ops.push(ValueParamT { Callee });
    let mut NumCallRegArgs: u32 = Call.getNumOperands() - (if HasGlue { 4 } else { 3 });
    NumCallRegArgs = if IsAnyRegCC { NumArgs } else { NumCallRegArgs };
    Ops.push(self.DAG.getTargetConstant(NumCallRegArgs, dl, EVT { i32 }, false));
    Ops.push(self.DAG.getTargetConstant(CC as u32, dl, EVT { i32 }, false));
    if IsAnyRegCC {
        for let mut i: u32 = NumMetaOpers;
let mut e: u32 = NumMetaOpers + NumArgs; i != e; i += 1 {
            Ops.push(self.getValue(CB.getArgOperand(i)));
        }
    }
    let mut e: op_iterator = if HasGlue { Call.op_end() - 2 } else { Call.op_end() - 1 };
    Ops;
    addStackMapLiveVars(CB, NumMetaOpers + NumArgs, dl, Ops, *self);
    let mut NodeTys: SDVTList = SDVTList {};
    if IsAnyRegCC && HasDef {
        let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
        let mut ValueVTs: SmallVector<EVT, 3> = zeroed();
        ComputeValueVTs(TLI, self.DAG.getDataLayout(), CB.getType());
        (((operator!(operator!((ValueVTs()() == 1 && "Expected only one return value type.")))) || (_wassert(L"ValueVTs.size() == 1 && \"Expected only one return value type.\"", L"llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", (11394) as u32) , 0)) as void);
        ValueVTs()(Other);
        ValueVTs()(Glue);
        NodeTys = self.DAG();
    } else {
        NodeTys = self.DAG.getVTList(EVT { Other }, EVT { Glue });
    }
    let mut PPV: SDValue = self.DAG;
    if HasDef {
        if IsAnyRegCC {
            self.setValue(&mut CB, SDValue { Node: PPV.getNode(), ResNo: 0 });
        } else {
            self.setValue(&mut CB, Result.first);
        }
    }
    if IsAnyRegCC && HasDef {
        let mut From: [2]SDValue = [SDValue { Node: Call, ResNo: 0 }, SDValue { Node: Call, ResNo: 1 }];
        let mut To: [2]SDValue = [PPV.getValue(1), PPV.getValue(2)];
        self.DAG.ReplaceAllUsesOfValuesWith(From, To, 2);
    } else {
        self.DAG.ReplaceAllUsesWith(Call, PPV.getNode());
    }
    self.DAG.DeleteNode(Call);
    self.FuncInfo.MF.getFrameInfo().setHasPatchPoint(true);
}

fn SelectionDAGBuilder::visitVectorReduce(self, I: *CallInst, Intrinsic: u32) {
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut Op1: SDValue = self.getValue(I.getArgOperand(0));
    let mut Op2: SDValue = SDValue {};
    if I.arg_size() > 1 {
        Op2 = self.getValue(I.getArgOperand(1));
    }
    let mut dl: SDLoc = self.getCurSDLoc();
    let mut VT: EVT = TLI.getValueType(self.DAG.getDataLayout(), I.getType(), false);
    let mut Res: SDValue = SDValue {};
    let mut SDFlags: SDNodeFlags = SDNodeFlags { Flags: None };
    if  {
        SDFlags.copyFMF(operator*());
    }
    match Intrinsic {
        vector_reduce_fadd => {
            if SDFlags.hasAllowReassociation() {
                Res = self.DAG.getNode(FADD, dl, VT, Op1, self.DAG.getNode(VECREDUCE_FADD, dl, VT, Op2, SDFlags), SDFlags);
            } else {
                Res = self.DAG.getNode(VECREDUCE_SEQ_FADD, dl, VT, Op1, Op2, SDFlags);
            }
        },
        vector_reduce_fmul => {
            if SDFlags.hasAllowReassociation() {
                Res = self.DAG.getNode(FMUL, dl, VT, Op1, self.DAG.getNode(VECREDUCE_FMUL, dl, VT, Op2, SDFlags), SDFlags);
            } else {
                Res = self.DAG.getNode(VECREDUCE_SEQ_FMUL, dl, VT, Op1, Op2, SDFlags);
            }
        },
        vector_reduce_add => {
            Res = self.DAG.getNode(VECREDUCE_ADD, dl, VT, Op1);
        },
        vector_reduce_mul => {
            Res = self.DAG.getNode(VECREDUCE_MUL, dl, VT, Op1);
        },
        vector_reduce_and => {
            Res = self.DAG.getNode(VECREDUCE_AND, dl, VT, Op1);
        },
        vector_reduce_or => {
            Res = self.DAG.getNode(VECREDUCE_OR, dl, VT, Op1);
        },
        vector_reduce_xor => {
            Res = self.DAG.getNode(VECREDUCE_XOR, dl, VT, Op1);
        },
        vector_reduce_smax => {
            Res = self.DAG.getNode(VECREDUCE_SMAX, dl, VT, Op1);
        },
        vector_reduce_smin => {
            Res = self.DAG.getNode(VECREDUCE_SMIN, dl, VT, Op1);
        },
        vector_reduce_umax => {
            Res = self.DAG.getNode(VECREDUCE_UMAX, dl, VT, Op1);
        },
        vector_reduce_umin => {
            Res = self.DAG.getNode(VECREDUCE_UMIN, dl, VT, Op1);
        },
        vector_reduce_fmax => {
            Res = self.DAG.getNode(VECREDUCE_FMAX, dl, VT, Op1, SDFlags);
        },
        vector_reduce_fmin => {
            Res = self.DAG.getNode(VECREDUCE_FMIN, dl, VT, Op1, SDFlags);
        },
        vector_reduce_fmaximum => {
            Res = self.DAG.getNode(VECREDUCE_FMAXIMUM, dl, VT, Op1, SDFlags);
        },
        vector_reduce_fminimum => {
            Res = self.DAG.getNode(VECREDUCE_FMINIMUM, dl, VT, Op1, SDFlags);
        },
        vector_reduce_fmaximumnum => {
            Res = self.DAG.getNode(VECREDUCE_FMAXIMUMNUM, dl, VT, Op1, SDFlags);
        },
        vector_reduce_fminimumnum => {
            Res = self.DAG.getNode(VECREDUCE_FMINIMUMNUM, dl, VT, Op1, SDFlags);
        },
        _ => {
            llvm_unreachable_internal("Unhandled vector reduce intrinsic", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", 11507);
        },
    }
    self.setValue(&mut I, Res);
}

fn getReturnAttrs(CLI: *mut CallLoweringInfo) -> AttributeList {
    let mut Attrs: AttrKind, 2> = zeroed();
    if CLI.RetSExt {
        Attrs()(SExt);
    }
    if CLI.RetZExt {
        Attrs()(ZExt);
    }
    if CLI.IsInReg {
        Attrs()(InReg);
    }
    return get(CLI.RetTy.getContext(), ReturnIndex);
}

fn TargetLowering::LowerCallTo(self: *TargetLowering, CLI: *mut CallLoweringInfo) -> pair<SDValue, SDValue> {
    let mut Context: *mut LLVMContext = CLI.RetTy.getContext();
    CLI.Ins.clear();
    let mut RetOrigTys: SmallVector<Type *, 4> = SmallVector<Type *, 4> {};
    let mut Offsets: SmallVector<TypeSize, 4> = zeroed();
    let mut DL: *DataLayout = CLI.DAG.getDataLayout();
    ComputeValueTypes(DL, CLI.OrigRetTy, RetOrigTys, operator&());
    let mut RetVTs: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
    if CLI.RetTy != CLI.OrigRetTy {
        assert!(RetOrigTys.len == 1, "Only supported for non-aggregate returns");
        RetVTs.push(self.getValueType(DL, CLI.RetTy, false));
    } else {
        for Ty in RetOrigTys {
            RetVTs.push(self.getValueType(DL, Ty, false));
        }
    }
    if CLI.IsPostTypeLegalization {
        let mut OldRetOrigTys: SmallVector<Type *, 4> = SmallVector<Type *, 4> {};
        let mut OldRetVTs: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
        let mut OldOffsets: SmallVector<TypeSize, 4> = zeroed();
        RetOrigTys.swap(OldRetOrigTys);
        RetVTs.swap(OldRetVTs);
        Offsets()();
        for let mut i: u64 = 0;
let mut e: u64 = OldRetVTs.len; i != e; i += 1 {
            let mut RetVT: EVT = OldRetVTs[i];
            let mut Offset: u64 = [i];
            let mut RegisterVT: MVT = self.getRegisterType(Context, RetVT);
            let mut NumRegs: u32 = self.getNumRegisters(Context, RetVT, optional<MVT> { nullopt });
            let mut RegisterVTByteSZ: u32 = RegisterVT.getSizeInBits().operator unsigned long long() / 8;
            RetOrigTys.append(NumRegs, OldRetOrigTys[i]);
            RetVTs.append(NumRegs, ValueParamT { RegisterVT });
            for let mut j: u32 = 0; j != NumRegs; j += 1 {
                Offsets()(getFixed(Offset + j * RegisterVTByteSZ));
            }
        }
    }
    let mut Outs: OutputArg, 4> = zeroed();
    GetReturnInfo(CLI.CallConv, CLI.RetTy, getReturnAttrs(CLI), *self, DL);
    let mut CanLowerReturn: bool = self.CanLowerReturn(CLI.CallConv, CLI.DAG.getMachineFunction(), CLI.IsVarArg, Context, CLI.RetTy);
    let mut DemoteStackSlot: SDValue = SDValue {};
    let mut DemoteStackIdx: i32 = -100;
    if !CanLowerReturn {
        let mut TySize: u64 = DL.getTypeAllocSize(CLI.RetTy).operator unsigned long long();
        let mut Alignment: Align = DL.getPrefTypeAlign(CLI.RetTy);
        let mut MF: *mut MachineFunction = CLI.DAG.getMachineFunction();
        DemoteStackIdx = MF.getFrameInfo().CreateStackObject(TySize, Alignment, false, null, 0);
        let mut StackSlotPtrType: *mut Type = get(Context, DL.getAllocaAddrSpace());
        DemoteStackSlot = CLI.DAG.getFrameIndex(DemoteStackIdx, EVT { self.getFrameIndexTy(DL) }, false);
        let mut Entry: ArgListEntry = ArgListEntry { DemoteStackSlot, StackSlotPtrType };
        Entry.IsSRet = true;
        Entry.Alignment = MaybeAlign { Alignment };
        CLI.getArgs();
        CLI.NumFixedArgs += 1;
        CLI.getArgs()[0].IndirectType = CLI.RetTy;
        CLI.RetTy = CLI.OrigRetTy = getVoidTy(Context);
        CLI.IsTailCall = false;
    } else {
        let mut NeedsRegBlock: bool = self.functionArgumentNeedsConsecutiveRegisters(CLI.RetTy, CLI.CallConv, CLI.IsVarArg, DL);
        for let mut I: u32 = 0;
let mut E: u32 = RetVTs.len; I != E; I += 1 {
            let mut Flags: ArgFlagsTy = ArgFlagsTy {};
            if NeedsRegBlock {
                Flags.setInConsecutiveRegs(true);
                if I == RetVTs.len - 1 {
                    Flags.setInConsecutiveRegsLast(true);
                }
            }
            let mut VT: EVT = RetVTs[I];
            let mut RegisterVT: MVT = self.getRegisterTypeForCallingConv(Context, CLI.CallConv, VT);
            let mut NumRegs: u32 = self.getNumRegistersForCallingConv(Context, CLI.CallConv, VT);
            for let mut i: u32 = 0; i != NumRegs; i += 1 {
                let mut Ret: InputArg = InputArg { Flags: Flags, VT: RegisterVT, ArgVT: VT, OrigTy: RetOrigTys[I], Used: CLI.IsReturnValueUsed, OrigArgIndex: NoArgIndex, PartOffset: 0 };
                if CLI.RetTy.isPointerTy() {
                    Ret.Flags.setPointer();
                    Ret.Flags.setPointerAddrSpace(cast(CLI.RetTy)());
                }
                if CLI.RetSExt {
                    Ret.Flags.setSExt();
                }
                if CLI.RetZExt {
                    Ret.Flags.setZExt();
