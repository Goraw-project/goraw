static mut LimitFloatPrecision: u32 = ;

static mut InsertAssertAlign: i32 = "insert-assert-align";

static mut LimitFPPrecision: i32 = "limit-float-precision";

static mut SwitchPeelThreshold: i32 = "switch-peel-threshold";

const MaxParallelChains: u32 = 64;

fn getCopyFromParts(DAG: *mut SelectionDAG, DL: *SDLoc, Parts: *SDValue, NumParts: u32, PartVT: MVT, ValueVT: EVT, V: *Value, InChain: SDValue, CC: ID>, AssertOp: NodeType>) -> SDValue {
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if TLI.joinRegisterPartsIntoValue(DAG, DL, Parts, NumParts, PartVT, ValueVT, ID> { CC }) {
        Val;
    } else {
        return Val;
    }
    if ValueVT.isVector() {
        return getCopyFromPartsVector(DAG, DL, Parts, NumParts, PartVT, ValueVT, V, InChain, ID> { CC });
    }
    assert!(NumParts > 0, "No parts to assemble!");
    let mut Val: SDValue = Parts[0];
    if NumParts > 1 {
        if ValueVT.isInteger() {
            let mut PartBits: u32 = PartVT.getSizeInBits().operator unsigned long long();
            let mut ValueBits: u32 = ValueVT.getSizeInBits().operator unsigned long long();
            let mut RoundParts: u32 = bit_floor(NumParts);
            let mut RoundBits: u32 = PartBits * RoundParts;
            let mut RoundVT: EVT = if RoundBits == ValueBits { ValueVT } else { getIntegerVT(*DAG.getContext(), RoundBits) };
            let mut Lo: SDValue = SDValue {};
            let mut Hi: SDValue = SDValue {};
            let mut HalfVT: EVT = getIntegerVT(*DAG.getContext(), RoundBits / 2);
            if RoundParts > 2 {} else {
                Lo = DAG.getNode(BITCAST, DL, HalfVT, Parts[0]);
                Hi = DAG.getNode(BITCAST, DL, HalfVT, Parts[1]);
            }
            if DAG.getDataLayout().isBigEndian() {
                swap(Lo, Hi);
            }
            Val = DAG.getNode(BUILD_PAIR, DL, RoundVT, Lo, Hi);
            if RoundParts < NumParts {
                let mut OddParts: u32 = NumParts - RoundParts;
                let mut OddVT: EVT = getIntegerVT(*DAG.getContext(), OddParts * PartBits);
                Lo = Val;
                if DAG.getDataLayout().isBigEndian() {
                    swap(Lo, Hi);
                }
                let mut TotalVT: EVT = getIntegerVT(*DAG.getContext(), NumParts * PartBits);
                Hi = DAG.getNode(ANY_EXTEND, DL, TotalVT, Hi);
                Hi = DAG.getNode(SHL, DL, TotalVT, Hi, DAG.getShiftAmountConstant(Lo.getValueSizeInBits().operator unsigned long long(), TotalVT, DL));
                Lo = DAG.getNode(ZERO_EXTEND, DL, TotalVT, Lo);
                Val = DAG.getNode(OR, DL, TotalVT, Lo, Hi);
            }
        } else if PartVT.isFloatingPoint() {
            assert!(ValueVT == EVT { ppcf128 } && PartVT == f64, "Unexpected split");
            let mut Lo: SDValue = SDValue {};
            let mut Hi: SDValue = SDValue {};
            Lo = DAG.getNode(BITCAST, DL, EVT { f64 }, Parts[0]);
            Hi = DAG.getNode(BITCAST, DL, EVT { f64 }, Parts[1]);
            if TLI.hasBigEndianPartOrdering(ValueVT, DAG.getDataLayout()) {
                swap(Lo, Hi);
            }
            Val = DAG.getNode(BUILD_PAIR, DL, ValueVT, Lo, Hi);
        } else {
            assert!(ValueVT.isFloatingPoint() && PartVT.isInteger() && !PartVT.isVector(), "Unexpected split");
            let mut IntVT: EVT = getIntegerVT(*DAG.getContext(), ValueVT.getSizeInBits().operator unsigned long long());
        }
    }
    let mut PartEVT: EVT = Val.getValueType();
    if PartEVT == ValueVT {
        return Val;
    }
    if PartEVT.isInteger() && ValueVT.isFloatingPoint() && ValueVT.bitsLT(PartEVT) {
        PartEVT = getIntegerVT(*DAG.getContext(), ValueVT.getSizeInBits().operator unsigned long long());
        Val = DAG.getNode(TRUNCATE, DL, PartEVT, Val);
    }
    if PartEVT.getSizeInBits() == ValueVT.getSizeInBits() {
        return DAG.getNode(BITCAST, DL, ValueVT, Val);
    }
    if PartEVT.isInteger() && ValueVT.isInteger() {
        if ValueVT.bitsLT(PartEVT) {
            if AssertOp() {
                Val = DAG(operator*(), DL, PartEVT, Val, DAG.getValueType(ValueVT));
            }
            return DAG.getNode(TRUNCATE, DL, ValueVT, Val);
        }
        return DAG.getNode(ANY_EXTEND, DL, ValueVT, Val);
    }
    if PartEVT.isFloatingPoint() && ValueVT.isFloatingPoint() {
        if ValueVT.bitsLT(Val.getValueType()) {
            let mut NoChange: SDValue = DAG.getTargetConstant(1, DL, EVT { TLI.getPointerTy(DAG.getDataLayout(), 0) }, false);
            if DAG.getMachineFunction().getFunction().getAttributes().hasFnAttr(StrictFP) {
                return DAG.getNode(STRICT_FP_ROUND, DL, DAG.getVTList(ValueVT, EVT { Other }), InChain, Val, NoChange);
            }
            return DAG.getNode(FP_ROUND, DL, ValueVT, Val, NoChange);
        }
        return DAG.getNode(FP_EXTEND, DL, ValueVT, Val);
    }
    if PartEVT == EVT { x86mmx } && ValueVT.isInteger() && ValueVT.bitsLT(PartEVT) {
        Val = DAG.getNode(BITCAST, DL, EVT { i64 }, Val);
        return DAG.getNode(TRUNCATE, DL, ValueVT, Val);
    }
    report_fatal_error("Unknown mismatch in getCopyFromParts!", true);
}

fn diagnosePossiblyInvalidConstraint(Ctx: *mut LLVMContext, V: *Value, ErrMsg: str) {
    let mut I: *Instruction = dyn_cast_or_null(V);
    if !I {
        return Ctx.emitError(ErrMsg);
    }
    if dyn_cast(I) {
        CI;
    } else if CI.isInlineAsm() {
        return Ctx.diagnose(DiagnosticInfoInlineAsm { *CI, ErrMsg + ", possible invalid constraint for vector type", DS_Error });
    }
    return Ctx.emitError(I, ErrMsg);
}

fn getCopyFromPartsVector(DAG: *mut SelectionDAG, DL: *SDLoc, Parts: *SDValue, NumParts: u32, PartVT: MVT, ValueVT: EVT, V: *Value, InChain: SDValue, CallConv: ID>) -> SDValue {
    assert!(ValueVT.isVector(), "Not a vector value");
    assert!(NumParts > 0, "No parts to assemble!");
    let mut IsABIRegCopy: bool = CallConv.has_value();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut Val: SDValue = Parts[0];
    if NumParts > 1 {
        let mut IntermediateVT: EVT = EVT {};
        let mut RegisterVT: MVT = MVT {};
        let mut NumIntermediates: u32 = 0;
        let mut NumRegs: u32 = 0;
        if IsABIRegCopy {
            NumRegs = TLI.getVectorTypeBreakdownForCallingConv(*DAG.getContext(), operator(CallConv), ValueVT, IntermediateVT, NumIntermediates, RegisterVT);
        } else {
            NumRegs = TLI.getVectorTypeBreakdown(*DAG.getContext(), ValueVT, IntermediateVT, NumIntermediates, RegisterVT);
        }
        assert!(NumRegs == NumParts, "Part count doesn't match vector breakdown!");
        NumParts = NumRegs;
        assert!(RegisterVT == PartVT, "Part type doesn't match vector breakdown!");
        assert!(RegisterVT.getSizeInBits() == Parts[0].getSimpleValueType().getSizeInBits(), "Part type sizes don't match!");
        let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { NumIntermediates };
        if NumIntermediates == NumParts {} else if NumParts > 0 {
            assert!(NumParts % NumIntermediates == 0, "Must expand into a divisible number of parts!");
            let mut Factor: u32 = NumParts / NumIntermediates;
        }
        let mut BuiltVectorTy: EVT = if IntermediateVT.isVector() { getVectorVT(*DAG.getContext(), IntermediateVT.getScalarType(), IntermediateVT.getVectorElementCount() * NumParts) } else { getVectorVT(*DAG.getContext(), IntermediateVT.getScalarType(), NumIntermediates, false) };
        Val = DAG;
    }
    let mut PartEVT: EVT = Val.getValueType();
    if PartEVT == ValueVT {
        return Val;
    }
    if PartEVT.isVector() {
        if ValueVT.getSizeInBits() == PartEVT.getSizeInBits() {
            return DAG.getNode(BITCAST, DL, ValueVT, Val);
        }
        if PartEVT.getVectorElementCount() != ValueVT.getVectorElementCount() {
            assert!((PartEVT.getVectorElementCount().getKnownMinValue() > ValueVT.getVectorElementCount().getKnownMinValue()) && (PartEVT.getVectorElementCount().isScalable() == ValueVT.getVectorElementCount().isScalable()), "Cannot narrow, it would be a lossy transformation");
            PartEVT = getVectorVT(*DAG.getContext(), PartEVT.getVectorElementType(), ValueVT.getVectorElementCount());
            Val = DAG.getNode(EXTRACT_SUBVECTOR, DL, PartEVT, Val, DAG.getVectorIdxConstant(0, DL, false));
            if PartEVT == ValueVT {
                return Val;
            }
            if PartEVT.isInteger() && ValueVT.isFloatingPoint() {
                return DAG.getNode(BITCAST, DL, ValueVT, Val);
            }
            if ValueVT.getSizeInBits() == PartEVT.getSizeInBits() {
                return DAG.getNode(BITCAST, DL, ValueVT, Val);
            }
        }
        return DAG.getAnyExtOrTrunc(Val, DL, ValueVT);
    }
    if PartEVT.getSizeInBits() == ValueVT.getSizeInBits() && TLI.isTypeLegal(ValueVT) {
        return DAG.getNode(BITCAST, DL, ValueVT, Val);
    }
    if ValueVT.getVectorNumElements() != 1 {
        if ValueVT.getSizeInBits() == PartEVT.getSizeInBits() {
            return DAG.getNode(BITCAST, DL, ValueVT, Val);
        } else if ValueVT.bitsLT(PartEVT) {
            let mut ValueSize: u64 = ValueVT.getFixedSizeInBits();
            let mut IntermediateType: EVT = getIntegerVT(*DAG.getContext(), ValueSize);
            Val = DAG.getNode(TRUNCATE, DL, IntermediateType, Val);
            return DAG.getBitcast(ValueVT, Val);
        }
        diagnosePossiblyInvalidConstraint(*DAG.getContext(), V, "non-trivial scalar-to-vector conversion");
        return DAG.getUNDEF(ValueVT);
    }
    let mut ValueSVT: EVT = ValueVT.getVectorElementType();
    if ValueVT.getVectorNumElements() == 1 && ValueSVT != PartEVT {
        let mut ValueSize: u32 = ValueSVT.getSizeInBits().operator unsigned long long();
        if ValueSize == PartEVT.getSizeInBits().operator unsigned long long() {
            Val = DAG.getNode(BITCAST, DL, ValueSVT, Val);
        } else if ValueSVT.isFloatingPoint() && PartEVT.isInteger() {
            assert!(ValueSVT.bitsLT(PartEVT), "Unexpected types");
            let mut IntermediateType: EVT = getIntegerVT(*DAG.getContext(), ValueSize);
            Val = DAG.getNode(TRUNCATE, DL, IntermediateType, Val);
            Val = DAG.getBitcast(ValueSVT, Val);
        } else {
            Val = if ValueVT.isFloatingPoint() { DAG.getFPExtendOrRound(Val, DL, ValueSVT) } else { DAG.getAnyExtOrTrunc(Val, DL, ValueSVT) };
        }
    }
    return DAG.getBuildVector(ValueVT, DL, ArrayRef<SDValue> { Val });
}

fn getCopyToParts(DAG: *mut SelectionDAG, DL: *SDLoc, Val: SDValue, Parts: *mut SDValue, NumParts: u32, PartVT: MVT, V: *Value, CallConv: ID>, ExtendKind: NodeType) {
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if TLI.splitValueIntoRegisterParts(DAG, DL, Val, Parts, NumParts, PartVT, ID> { CallConv }) {
        return;
    }
    let mut ValueVT: EVT = Val.getValueType();
    if ValueVT.isVector() {
        return getCopyToPartsVector(DAG, DL, Val, Parts, NumParts, PartVT, V, ID> { CallConv });
    }
    let mut OrigNumParts: u32 = NumParts;
    assert!(DAG.getTargetLoweringInfo().isTypeLegal(EVT { PartVT }), "Copying to an illegal type!");
    if NumParts == 0 {
        return;
    }
    assert!(!ValueVT.isVector(), "Vector case handled elsewhere");
    let mut PartEVT: EVT = EVT { PartVT };
    if PartEVT == ValueVT {
        assert!(NumParts == 1, "No-op copy with multiple parts!");
        Parts[0] = Val;
        return;
    }
    let mut PartBits: u32 = PartVT.getSizeInBits().operator unsigned long long();
    if NumParts * PartBits > ValueVT.getSizeInBits().operator unsigned long long() {
        if PartVT.isFloatingPoint() && ValueVT.isFloatingPoint() {
            assert!(NumParts == 1, "Do not know what to promote to!");
            Val = DAG.getNode(FP_EXTEND, DL, EVT { PartVT }, Val);
        } else {
            if ValueVT.isFloatingPoint() {
                ValueVT = getIntegerVT(*DAG.getContext(), ValueVT.getSizeInBits().operator unsigned long long());
                Val = DAG.getNode(BITCAST, DL, ValueVT, Val);
            }
            assert!((PartVT.isInteger() || PartVT == x86mmx) && ValueVT.isInteger(), "Unknown mismatch!");
            ValueVT = getIntegerVT(*DAG.getContext(), NumParts * PartBits);
            Val = DAG.getNode(ExtendKind, DL, ValueVT, Val);
            if PartVT == x86mmx {
                Val = DAG.getNode(BITCAST, DL, EVT { PartVT }, Val);
            }
        }
    } else if PartBits == ValueVT.getSizeInBits().operator unsigned long long() {
        assert!(NumParts == 1 && PartEVT != ValueVT);
        Val = DAG.getNode(BITCAST, DL, EVT { PartVT }, Val);
    } else if NumParts * PartBits < ValueVT.getSizeInBits().operator unsigned long long() {
        assert!((PartVT.isInteger() || PartVT == x86mmx) && ValueVT.isInteger(), "Unknown mismatch!");
        ValueVT = getIntegerVT(*DAG.getContext(), NumParts * PartBits);
        Val = DAG.getNode(TRUNCATE, DL, ValueVT, Val);
        if PartVT == x86mmx {
            Val = DAG.getNode(BITCAST, DL, EVT { PartVT }, Val);
        }
    }
    ValueVT = Val.getValueType();
    assert!(NumParts * PartBits == ValueVT.getSizeInBits().operator unsigned long long(), "Failed to tile the value with PartVT!");
    if NumParts == 1 {
        if PartEVT != ValueVT {
            diagnosePossiblyInvalidConstraint(*DAG.getContext(), V, "scalar-to-vector conversion failed");
            Val = DAG.getNode(BITCAST, DL, EVT { PartVT }, Val);
        }
        Parts[0] = Val;
        return;
    }
    if NumParts & (NumParts - 1) {
        assert!(PartVT.isInteger() && ValueVT.isInteger(), "Do not know what to expand to!");
        let mut RoundParts: u32 = bit_floor(NumParts);
        let mut RoundBits: u32 = RoundParts * PartBits;
        let mut OddParts: u32 = NumParts - RoundParts;
        let mut OddVal: SDValue = DAG.getNode(SRL, DL, ValueVT, Val, DAG.getShiftAmountConstant(RoundBits, ValueVT, DL));
        getCopyToParts(DAG, DL, OddVal, Parts + RoundParts, OddParts, PartVT, V, ID> { CallConv }, ANY_EXTEND);
        if DAG.getDataLayout().isBigEndian() {
            reverse(Parts + RoundParts, Parts + NumParts);
        }
        NumParts = RoundParts;
        ValueVT = getIntegerVT(*DAG.getContext(), NumParts * PartBits);
        Val = DAG.getNode(TRUNCATE, DL, ValueVT, Val);
    }
    Parts[0] = DAG.getNode(BITCAST, DL, getIntegerVT(*DAG.getContext(), ValueVT.getSizeInBits().operator unsigned long long()), Val);
    for let mut StepSize: u32 = NumParts; StepSize > 1; StepSize /= 2 {
        for let mut i: u32 = 0; i < NumParts; i += StepSize {
            let mut ThisBits: u32 = StepSize * PartBits / 2;
            let mut ThisVT: EVT = getIntegerVT(*DAG.getContext(), ThisBits);
            let mut Part0: *mut SDValue = Parts[i];
            let mut Part1: *mut SDValue = Parts[i + StepSize / 2];
            Part1 = DAG.getNode(EXTRACT_ELEMENT, DL, ThisVT, Part0, DAG.getIntPtrConstant(1, DL, false));
            Part0 = DAG.getNode(EXTRACT_ELEMENT, DL, ThisVT, Part0, DAG.getIntPtrConstant(0, DL, false));
            if ThisBits == PartBits && ThisVT != EVT { PartVT } {
                Part0 = DAG.getNode(BITCAST, DL, EVT { PartVT }, Part0);
                Part1 = DAG.getNode(BITCAST, DL, EVT { PartVT }, Part1);
            }
        }
    }
    if DAG.getDataLayout().isBigEndian() {
        reverse(Parts, Parts + OrigNumParts);
    }
}

fn widenVectorToPartType(DAG: *mut SelectionDAG, Val: SDValue, DL: *SDLoc, PartVT: EVT) -> SDValue {
    if !PartVT.isVector() {
        return SDValue {};
    }
    let mut ValueVT: EVT = Val.getValueType();
    let mut PartEVT: EVT = PartVT.getVectorElementType();
    let mut ValueEVT: EVT = ValueVT.getVectorElementType();
    let mut PartNumElts: ElementCount = PartVT.getVectorElementCount();
    let mut ValueNumElts: ElementCount = ValueVT.getVectorElementCount();
    if isKnownLE(PartNumElts, ValueNumElts) || PartNumElts.isScalable() != ValueNumElts.isScalable() {
        return SDValue {};
    }
    if ValueEVT == EVT { bf16 } && PartEVT == EVT { f16 } {
        assert!(DAG.getTargetLoweringInfo().isTypeLegal(PartVT), "Cannot widen to illegal type");
        Val = DAG.getNode(BITCAST, DL, ValueVT.changeVectorElementType(*DAG.getContext(), EVT { f16 }), Val);
    } else if PartEVT != ValueEVT {
        return SDValue {};
    }
    if PartNumElts.isScalable() {
        return DAG.getNode(INSERT_SUBVECTOR, DL, PartVT, DAG.getUNDEF(PartVT), Val, DAG.getVectorIdxConstant(0, DL, false));
    }
    let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    DAG.ExtractVectorElements(Val, Ops, 0, 0, EVT {});
    let mut EltUndef: SDValue = DAG.getUNDEF(PartEVT);
    Ops.append((PartNumElts - ValueNumElts).getFixedValue(), ValueParamT { EltUndef });
    return DAG;
}

fn getCopyToPartsVector(DAG: *mut SelectionDAG, DL: *SDLoc, Val: SDValue, Parts: *mut SDValue, NumParts: u32, PartVT: MVT, V: *Value, CallConv: ID>) {
    let mut ValueVT: EVT = Val.getValueType();
    assert!(ValueVT.isVector(), "Not a vector");
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut IsABIRegCopy: bool = CallConv.has_value();
    if NumParts == 1 {
        let mut PartEVT: EVT = EVT { PartVT };
        if PartEVT == ValueVT {} else if PartVT.getSizeInBits() == ValueVT.getSizeInBits() {
            Val = DAG.getNode(BITCAST, DL, EVT { PartVT }, Val);
        } else if widenVectorToPartType(DAG, Val, DL, EVT { PartVT }) {
            Widened;
        } else {
            Val = Widened;
        }
        assert!(Val.getValueType() == EVT { PartVT }, "Unexpected vector part value type");
        Parts[0] = Val;
        return;
    }
    let mut IntermediateVT: EVT = EVT {};
    let mut RegisterVT: MVT = MVT {};
    let mut NumIntermediates: u32 = 0;
    let mut NumRegs: u32 = 0;
    if IsABIRegCopy {
        NumRegs = TLI.getVectorTypeBreakdownForCallingConv(*DAG.getContext(), operator(CallConv), ValueVT, IntermediateVT, NumIntermediates, RegisterVT);
    } else {
        NumRegs = TLI.getVectorTypeBreakdown(*DAG.getContext(), ValueVT, IntermediateVT, NumIntermediates, RegisterVT);
    }
    assert!(NumRegs == NumParts, "Part count doesn't match vector breakdown!");
    NumParts = NumRegs;
    assert!(RegisterVT == PartVT, "Part type doesn't match vector breakdown!");
    assert!(IntermediateVT.isScalableVector() == ValueVT.isScalableVector(), "Mixing scalable and fixed vectors when copying in parts");
    let mut DestEltCnt: optional<ElementCount> = optional<ElementCount> {};
    if IntermediateVT.isVector() {
        DestEltCnt(IntermediateVT.getVectorElementCount() * NumIntermediates);
    } else {
        DestEltCnt(getFixed(NumIntermediates));
    }
    let mut BuiltVectorTy: EVT = getVectorVT(*DAG.getContext(), IntermediateVT.getScalarType(), operator(DestEltCnt));
    if ValueVT == BuiltVectorTy {} else if ValueVT.getSizeInBits() == BuiltVectorTy.getSizeInBits() {
        Val = DAG.getNode(BITCAST, DL, BuiltVectorTy, Val);
    } else {
        if BuiltVectorTy.getVectorElementType().bitsGT(ValueVT.getVectorElementType()) {
            ValueVT = getVectorVT(*DAG.getContext(), BuiltVectorTy.getVectorElementType(), ValueVT.getVectorElementCount());
            Val = DAG.getNode(ANY_EXTEND, DL, ValueVT, Val);
        }
        if widenVectorToPartType(DAG, Val, DL, BuiltVectorTy) {
            Widened;
        } else {
            Val = Widened;
        }
    }
    assert!(Val.getValueType() == BuiltVectorTy, "Unexpected vector value type");
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { NumIntermediates };
    for let mut i: u32 = 0; i != NumIntermediates; i += 1 {
        if IntermediateVT.isVector() {
            let mut IntermediateNumElts: u32 = IntermediateVT.getVectorMinNumElements();
            Ops[i] = DAG.getNode(EXTRACT_SUBVECTOR, DL, IntermediateVT, Val, DAG.getVectorIdxConstant(i * IntermediateNumElts, DL, false));
        } else {
            Ops[i] = DAG.getNode(EXTRACT_VECTOR_ELT, DL, IntermediateVT, Val, DAG.getVectorIdxConstant(i, DL, false));
        }
    }
    if NumParts == NumIntermediates {
        for let mut i: u32 = 0; i != NumParts; i += 1 {
            getCopyToParts(DAG, DL, Ops[i], &mut Parts[i], 1, PartVT, V, ID> { CallConv }, ANY_EXTEND);
        }
    } else if NumParts > 0 {
        assert!(NumIntermediates != 0, "division by zero");
        assert!(NumParts % NumIntermediates == 0, "Must expand into a divisible number of parts!");
        let mut Factor: u32 = NumParts / NumIntermediates;
        for let mut i: u32 = 0; i != NumIntermediates; i += 1 {
            getCopyToParts(DAG, DL, Ops[i], &mut Parts[i * Factor], Factor, PartVT, V, ID> { CallConv }, ANY_EXTEND);
        }
    }
}

fn failForInvalidBundles(I: *CallBase, Name: str, AllowedBundles: ArrayRef<uint32_t>) {
    if I.hasOperandBundlesOtherThan(ArrayRef<uint32_t> { AllowedBundles }) {
        let mut LS: ListSeparator = ListSeparator { ", ", "" };
        let mut Error: str = "";
        let mut OS: raw_string_ostream = raw_string_ostream { Error };
        for let mut i: u32 = 0;
let mut e: u32 = I.getNumOperandBundles(); i != e; i += 1 {
            let mut U: OperandBundleUse = I.getOperandBundleAt(i);
            if !is_contained(AllowedBundles, U.getTagID()) {
                OS << LS.operator StringRef() << U.getTagName();
            }
        }
        reportFatalUsageError("cannot lower "[0..Name].concat(" with arbitrary operand bundles: "[0..Error]));
    }
}

fn RegsForValue::RegsForValue(self, Context: *mut LLVMContext, TLI: *TargetLowering, DL: *DataLayout, Reg: Register, Ty: *mut Type, CC: ID>) {
    ComputeValueVTs(TLI, DL, Ty, self.ValueVTs, null, null, getZero());
    self.CallConv = CC;
    for ValueVT in self.ValueVTs {
        let mut NumRegs: u32 = if self.isABIMangled() { TLI.getNumRegistersForCallingConv(Context, operator(CC), ValueVT) } else { TLI.getNumRegisters(Context, ValueVT, optional<MVT> { nullopt }) };
        let mut RegisterVT: MVT = if self.isABIMangled() { TLI.getRegisterTypeForCallingConv(Context, operator(CC), ValueVT) } else { TLI.getRegisterType(Context, ValueVT) };
        for let mut i: u32 = 0; i != NumRegs; i += 1 {
            self.Regs.push(ValueParamT { Reg.operator unsigned int() + i });
        }
        self.RegVTs.push(ValueParamT { RegisterVT });
        self.RegCount.push(NumRegs);
        Reg = Register { Reg: Reg.id() + NumRegs };
    }
}

fn RegsForValue::getCopyFromRegs(self: *RegsForValue, DAG: *mut SelectionDAG, FuncInfo: *mut FunctionLoweringInfo, dl: *SDLoc, Chain: *mut SDValue, Glue: *mut SDValue, V: *Value) -> SDValue {
    if self.ValueVTs.len == 0 {
        return SDValue {};
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut Values: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { self.ValueVTs.len };
    let mut Parts: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    for let mut Value: u32 = 0;
let mut Part: u32 = 0;
let mut e: u32 = self.ValueVTs.len; Value != e; Value += 1 {
        let mut ValueVT: EVT = self.ValueVTs[Value];
        let mut NumRegs: u32 = self.RegCount[Value];
        let mut RegisterVT: MVT = if self.isABIMangled() { TLI.getRegisterTypeForCallingConv(*DAG.getContext(), operator(self.CallConv), EVT { self.RegVTs[Value] }) } else { self.RegVTs[Value] };
        Parts.resize(NumRegs);
        for let mut i: u32 = 0; i != NumRegs; i += 1 {
            let mut P: SDValue = SDValue {};
            if !Glue {
                P = DAG.getCopyFromReg(Chain, dl, self.Regs[Part + i], EVT { RegisterVT });
            } else {
                P = DAG.getCopyFromReg(Chain, dl, self.Regs[Part + i], EVT { RegisterVT }, *Glue);
                *Glue = P.getValue(2);
            }
            Chain = P.getValue(1);
            Parts[i] = P;
            if !self.Regs[Part + i].isVirtual() || !RegisterVT.isInteger() {
                continue;
            }
            let mut LOI: *LiveOutInfo = FuncInfo.GetLiveOutRegInfo(self.Regs[Part + i]);
            if !LOI {
                continue;
            }
            let mut RegSize: u32 = RegisterVT.getScalarSizeInBits();
            let mut NumSignBits: u32 = LOI.NumSignBits;
            let mut NumZeroBits: u32 = LOI.Known.countMinLeadingZeros();
            if NumZeroBits == RegSize {
                Parts[i] = DAG.getConstant(0, dl, EVT { RegisterVT }, false, false);
                continue;
            }
            let mut isSExt: bool = false;
            let mut FromVT: EVT = EVT { Other };
            if NumZeroBits {
                FromVT = getIntegerVT(*DAG.getContext(), RegSize - NumZeroBits);
                isSExt = false;
            } else if NumSignBits > 1 {
                FromVT = getIntegerVT(*DAG.getContext(), RegSize - NumSignBits + 1);
                isSExt = true;
            } else {
                continue;
            }
            assert!(FromVT != EVT { Other });
            Parts[i] = DAG.getNode(if isSExt { AssertSext } else { AssertZext }, dl, EVT { RegisterVT }, P, DAG.getValueType(FromVT));
        }
        Part += NumRegs;
        Parts.clear();
    }
    return DAG;
}

fn RegsForValue::getCopyToRegs(self: *RegsForValue, Val: SDValue, DAG: *mut SelectionDAG, dl: *SDLoc, Chain: *mut SDValue, Glue: *mut SDValue, V: *Value, PreferredExtendType: NodeType) {
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut ExtendKind: NodeType = PreferredExtendType;
    let mut NumRegs: u32 = self.Regs.len;
    let mut Parts: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { NumRegs };
    for let mut Value: u32 = 0;
let mut Part: u32 = 0;
let mut e: u32 = self.ValueVTs.len; Value != e; Value += 1 {
        let mut NumParts: u32 = self.RegCount[Value];
        let mut RegisterVT: MVT = if self.isABIMangled() { TLI.getRegisterTypeForCallingConv(*DAG.getContext(), operator(self.CallConv), EVT { self.RegVTs[Value] }) } else { self.RegVTs[Value] };
        if ExtendKind == ANY_EXTEND {
            if TLI.isZExtFree(peekThroughFreeze(Val), EVT { RegisterVT }) {
                ExtendKind = ZERO_EXTEND;
            }
        }
        getCopyToParts(DAG, dl, Val.getValue(Val.getResNo() + Value), &mut Parts[Part], NumParts, RegisterVT, V, self.CallConv, ExtendKind);
        Part += NumParts;
    }
    let mut Chains: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { NumRegs };
    for let mut i: u32 = 0; i != NumRegs; i += 1 {
        let mut Part: SDValue = SDValue {};
        if !Glue {
            Part = DAG.getCopyToReg(Chain, dl, self.Regs[i], Parts[i]);
        } else {
            Part = DAG.getCopyToReg(Chain, dl, self.Regs[i], Parts[i], *Glue);
            *Glue = Part.getValue(1);
        }
        Chains[i] = Part.getValue(0);
    }
    if NumRegs == 1 || Glue {
        Chain = Chains[NumRegs - 1];
    } else {
        Chain = DAG;
    }
}

fn RegsForValue::AddInlineAsmOperands(self: *RegsForValue, Code: Kind, HasMatching: bool, MatchingIdx: u32, dl: *SDLoc, DAG: *mut SelectionDAG, Ops: *mut i32) {
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut Flag: Flag = Flag { Code, self.Regs.len };
    if HasMatching {
        Flag.setMatchingOp(MatchingIdx);
    } else if !self.Regs.is_empty() && self.Regs.front().isVirtual() {
        let mut MRI: *MachineRegisterInfo = DAG.getMachineFunction().getRegInfo();
        let mut RC: *TargetRegisterClass = MRI.getRegClass(self.Regs.front());
        Flag.setRegClass(RC.getID());
    }
    let mut Res: SDValue = DAG.getTargetConstant(Flag.operator unsigned int(), dl, EVT { i32 }, false);
    Ops()(Res);
    if Code == Clobber {
        assert!(self.Regs.len == self.RegVTs.len && self.Regs.len == self.ValueVTs.len, "No 1:1 mapping from clobbers to regs?");
        let mut SP: Register = TLI.getStackPointerRegisterToSaveRestore();
        SP as void;
        for let mut I: u32 = 0;
let mut E: u32 = self.ValueVTs.len; I != E; I += 1 {
            Ops()(DAG.getRegister(self.Regs[I], EVT { self.RegVTs[I] }));
            assert!((self.Regs[I] != SP || DAG.getMachineFunction().getFrameInfo().hasOpaqueSPAdjustment()), "If we clobbered the stack pointer, MFI should know about it.");
        }
        return;
    }
    for let mut Value: u32 = 0;
let mut Reg: u32 = 0;
let mut e: u32 = self.ValueVTs.len; Value != e; Value += 1 {
        let mut RegisterVT: MVT = self.RegVTs[Value];
        let mut NumRegs: u32 = TLI.getNumRegisters;
        for let mut i: u32 = 0; i != NumRegs; i += 1 {
            assert!(Reg < self.Regs.len, "Mismatch in # registers expected");
            let mut TheReg: Register = self.Regs[Reg += 1];
            Ops()(DAG.getRegister(TheReg, EVT { RegisterVT }));
        }
    }
}

fn RegsForValue::getRegsAndSizes(self: *RegsForValue) -> pair<Register, TypeSize>, 4> {
    let mut OutVec: pair<Register, TypeSize>, 4> = zeroed();
    let mut I: u32 = 0;
    return ;
}

fn SelectionDAGBuilder::init(self, gfi: *mut GCFunctionInfo, aa: *mut BatchAAResults, ac: *mut AssumptionCache, li: *TargetLibraryInfo, TTI: *TargetTransformInfo) {
    self.BatchAA = aa;
    self.AC = ac;
    self.GFI = gfi;
    self.LibInfo = li;
    self.Context = self.DAG.getContext();
    self.LPadToCallSiteMap.clear();
    self.TTI = &mut TTI;
    operator(self.SL).init(self.DAG.getTargetLoweringInfo(), self.TM, self.DAG.getDataLayout());
    self.AssignmentTrackingEnabled = isAssignmentTrackingEnabled(*self.DAG.getMachineFunction().getFunction().getParent());
    self.CanDescribeGlobalAddressInLocationList = canDescribeGlobalAddressInLocationList(self.DAG.getMachineFunction());
}

fn SelectionDAGBuilder::clear(self) {
    self.NodeMap.clear();
    self.UnusedArgNodeMap.clear();
    self.PendingLoads.clear();
    self.PendingExports.clear();
    self.PendingConstrainedFP.clear();
    self.PendingConstrainedFPStrict.clear();
    self.CurInst = null;
    self.HasTailCall = false;
    self.SDNodeOrder = LowestSDNodeOrder;
    self.StatepointLowering.clear();
}

fn SelectionDAGBuilder::clearDanglingDebugInfo(self) {
    self.DanglingDebugInfoMap.clear();
}

fn SelectionDAGBuilder::updateRoot(self, Pending: *mut SmallVectorImpl<SDValue>) -> SDValue {
    let mut Root: SDValue = self.DAG.getRoot();
    if Pending.len == 0 {
        return Root;
    }
    if Root.getOpcode() != EntryToken {
        let mut i: u32 = 0;
        let mut e: u32 = Pending.len;
        for ; i != e; i += 1 {
            assert!(Pending[i].getNode().getNumOperands() > 1);
            if Pending[i].getNode().getOperand(0) == Root {
                break;
            }
        }
        if i == e {
            Pending.push(ValueParamT { Root });
        }
    }
    if Pending.len == 1 {
        Root = Pending[0];
    } else {
        Root = self.DAG.getTokenFactor(self.getCurSDLoc(), Pending);
    }
    self.DAG.setRoot(Root);
    Pending.clear();
    return Root;
}

fn SelectionDAGBuilder::getMemoryRoot(self) -> SDValue {
    return self.updateRoot(self.PendingLoads);
}

fn SelectionDAGBuilder::getFPOperationRoot(self, EB: ExceptionBehavior) -> SDValue {
    match EB {
        ebMayTrap => {
            ebIgnore;
        },
        ebStrict => {
            if !self.PendingConstrainedFP.is_empty() {
                assert!(self.PendingConstrainedFPStrict.is_empty());
                self.updateRoot(self.PendingConstrainedFP);
            }
        },
    }
    return self.DAG.getRoot();
}

fn SelectionDAGBuilder::getRoot(self) -> SDValue {
    self.PendingLoads.reserve(self.PendingLoads.len + self.PendingConstrainedFP.len + self.PendingConstrainedFPStrict.len);
    self.PendingLoads;
    self.PendingLoads;
    self.PendingConstrainedFP.clear();
    self.PendingConstrainedFPStrict.clear();
    return self.getMemoryRoot();
}

fn SelectionDAGBuilder::getControlRoot(self) -> SDValue {
    self.PendingExports;
    self.PendingConstrainedFPStrict.clear();
    return self.updateRoot(self.PendingExports);
}

fn SelectionDAGBuilder::handleDebugDeclare(self, Address: *mut Value, Variable: *mut DILocalVariable, Expression: *mut DIExpression, DL: DebugLoc) {
    assert!(Variable, "Missing variable");
    if !Address || isa(Address) || (Address.use_empty() && !isa(Address)) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("isel", 1) {
                dbgs() << "dbg_declare: Dropping debug info (bad/undef/unused-arg address)\n";
            }
        }
            if !(false) { break; }
        }
        return;
    }
    let mut IsParameter: bool = Variable.isParameter() || isa(Address);
    let mut N: *mut SDValue = self.NodeMap[Address];
    if !N.getNode() && isa(Address) {
        N = self.UnusedArgNodeMap[Address];
    }
    let mut SDV: *mut SDDbgValue = null;
    if N.getNode() {
        if dyn_cast(Address) {
            BCI;
        } else {
            Address = BCI.getOperand(0);
        }
        let mut FINode: *mut auto = dyn_cast(N.getNode());
        if IsParameter &&  {
            SDV = self.DAG(Variable, Expression, true, DL, self.SDNodeOrder);
        } else if isa(Address) {
            self.EmitFuncArgumentDbgValue(Address, Variable, Expression, DL.operator llvm::DILocation *(), Declare, N);
            return;
        } else {
            SDV = self.DAG.getDbgValue(Variable, Expression, N.getNode(), N.getResNo(), true, DL, self.SDNodeOrder);
        }
        self.DAG.AddDbgValue(SDV, IsParameter);
    } else {
        if !self.EmitFuncArgumentDbgValue(Address, Variable, Expression, DL.operator llvm::DILocation *(), Declare, N) {
            while true {
                {
                if DebugFlag && isCurrentDebugType("isel", 1) {
                    dbgs() << "dbg_declare: Dropping debug info" << " (could not emit func-arg dbg_value)\n";
                }
            }
                if !(false) { break; }
            }
        }
    }
}

fn SelectionDAGBuilder::visitDbgInfo(self, I: *Instruction) {
    if self.DAG.getFunctionVarLocs() {
        FnVarLocs;
    } else {
        for let mut It: *VarLocInfo = FnVarLocs.locs_begin(&mut I);
let mut End: *VarLocInfo = FnVarLocs.locs_end(&mut I); It != End; It += 1 {
            let mut Var: *mut DILocalVariable = FnVarLocs.getDILocalVariable(It.VariableID);
            self.dropDanglingDebugInfo(Var, It.Expr);
            if It.Values.isKillLocation(It.Expr) {
                self.handleKillDebugValue(Var, It.Expr, It.DL, self.SDNodeOrder);
                continue;
            }
            let mut Values: i32 = It.Values.location_ops();
            if operator!(self.handleDebugValue(Var, It.Expr, It.DL, self.SDNodeOrder, It.Values.hasArgList())) {
                let mut Vals: SmallVector<Value *, 4> = zeroed();
                self.addDanglingDebugInfo(FnVarLocs.getDILocalVariable(It.VariableID), It.Expr, () > 1, It.DL, self.SDNodeOrder);
            }
        }
    }
    let mut SkipDbgVariableRecords: bool = self.DAG.getFunctionVarLocs();
    for DR in I.getDbgRecordRange() {
        if dyn_cast(&mut DR) {
            DLR;
        } else {
            assert!(DLR.getLabel(), "Missing label");
            let mut SDV: *mut SDDbgLabel = self.DAG.getDbgLabel(DLR.getLabel(), DLR.getDebugLoc(), self.SDNodeOrder);
            self.DAG.AddDbgLabel(SDV);
            continue;
        }
        if SkipDbgVariableRecords {
            continue;
        }
        let mut DVR: *mut DbgVariableRecord = cast(DR);
        let mut Variable: *mut DILocalVariable = DVR.getVariable();
        let mut Expression: *mut DIExpression = DVR.getExpression();
        self.dropDanglingDebugInfo(Variable, Expression);
        if DVR.getType() == Declare {
            if self.FuncInfo.PreprocessedDVRDeclares.contains(&mut DVR) {
                continue;
            }
            while true {
                {
                if DebugFlag && isCurrentDebugType("isel", 1) {
                    dbgs() << "SelectionDAG visiting dbg_declare: " << DVR << "\n";
                }
            }
                if !(false) { break; }
            }
            self.handleDebugDeclare(DVR.getVariableLocationOp(0), Variable, Expression, DVR.getDebugLoc());
            continue;
        }
        let mut Values: SmallVector<Value *, 4> = zeroed();
        if Values()() {
            self.handleKillDebugValue(Variable, Expression, DVR.getDebugLoc(), self.SDNodeOrder);
            continue;
        }
        if any_of(Closure_1 {}) {
            self.handleKillDebugValue(Variable, Expression, DVR.getDebugLoc(), self.SDNodeOrder);
            continue;
        }
        let mut IsVariadic: bool = DVR.hasArgList();
        if operator!(self.handleDebugValue(Variable, Expression, DVR.getDebugLoc(), self.SDNodeOrder, IsVariadic)) {
            self.addDanglingDebugInfo(Variable, Expression, IsVariadic, DVR.getDebugLoc(), self.SDNodeOrder);
        }
    }
}

fn SelectionDAGBuilder::visit(self, I: *Instruction) {
    self.visitDbgInfo(I);
    if I.isTerminator() {
        self.HandlePHINodesInSuccessorBlocks(I.getParent());
    }
    self.SDNodeOrder += 1;
    self.CurInst = &mut I;
    let mut NodeInserted: bool = false;
    let mut InsertedListener: i32 = 0;
    let mut PCSectionsMD: *mut MDNode = I.getMetadata(MD_pcsections);
    let mut MMRA: *mut MDNode = I.getMetadata(MD_mmra);
    if PCSectionsMD || MMRA {
        InsertedListener() = make_unique(self.DAG, Closure_2 { NodeInserted: &mut NodeInserted });
    }
    self.visit(I.getOpcode(), I);
    if !I.isTerminator() && !self.HasTailCall && !isa(I) {
        self.CopyToExportRegsIfNeeded(&mut I);
    }
    if PCSectionsMD || MMRA {
        let mut It: auto = self.NodeMap.find;
        if It() != self.NodeMap.end {
            if PCSectionsMD {
                self.DAG.addPCSections(PCSectionsMD);
            }
            if MMRA {
                self.DAG.addMMRAMetadata(MMRA);
            }
        } else if NodeInserted {
            errs() << "warning: loosing !pcsections and/or !mmra metadata [" << I.getModule().getName() << "]\n";
            while true {
                {
                if DebugFlag && isCurrentDebugType("isel", 1) {
                    I.dump();
                }
            }
                if !(false) { break; }
            }
            assert!(false);
        }
    }
    self.CurInst = null;
}

fn SelectionDAGBuilder::visitPHI(self, arg: *PHINode) {
    llvm_unreachable_internal("SelectionDAGBuilder shouldn't visit PHI nodes!", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", 1424);
}

fn SelectionDAGBuilder::visit(self, Opcode: u32, I: *User) {
    match Opcode {
        _ => {
            llvm_unreachable_internal("Unknown instruction type encountered!", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGBuilder.cpp", 1431);
        },
        Ret => {
            self.visitRet(I as ReturnInst);
        },
        UncondBr => {
            self.visitUncondBr(I as UncondBrInst);
        },
        CondBr => {
            self.visitCondBr(I as CondBrInst);
