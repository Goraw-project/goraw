static mut NumBacktracks: Statistic = Statistic { "pre-RA-sched", "NumBacktracks", "Number of times scheduler backtracked" };

static mut NumUnfolds: Statistic = Statistic { "pre-RA-sched", "NumUnfolds", "Number of nodes unfolded" };

static mut NumDups: Statistic = Statistic { "pre-RA-sched", "NumDups", "Number of duplicated nodes" };

static mut NumPRCopies: Statistic = Statistic { "pre-RA-sched", "NumPRCopies", "Number of physical register copies" };

static mut burrListDAGScheduler: RegisterScheduler = RegisterScheduler { "list-burr", "Bottom-up register reduction list scheduling", createBURRListDAGScheduler };

static mut sourceListDAGScheduler: RegisterScheduler = RegisterScheduler { "source", "Similar to list-burr but schedules in source order when possible", createSourceListDAGScheduler };

static mut hybridListDAGScheduler: RegisterScheduler = RegisterScheduler { "list-hybrid", "Bottom-up register pressure aware list scheduling which tries to balance latency and register pressure", createHybridListDAGScheduler };

static mut ILPListDAGScheduler: RegisterScheduler = RegisterScheduler { "list-ilp", "Bottom-up register pressure aware list scheduling which tries to balance ILP and register pressure", createILPListDAGScheduler };

static mut DisableSchedCycles: opt<bool> = opt<bool> { "disable-sched-cycles", Hidden, init(false), desc { Desc: "Disable cycle-level precision during preRA scheduling" } };

static mut DisableSchedRegPressure: opt<bool> = opt<bool> { "disable-sched-reg-pressure", Hidden, init(false), desc { Desc: "Disable regpressure priority in sched=list-ilp" } };

static mut DisableSchedLiveUses: opt<bool> = opt<bool> { "disable-sched-live-uses", Hidden, init(true), desc { Desc: "Disable live use priority in sched=list-ilp" } };

static mut DisableSchedVRegCycle: opt<bool> = opt<bool> { "disable-sched-vrcycle", Hidden, init(false), desc { Desc: "Disable virtual register cycle interference checks" } };

static mut DisableSchedPhysRegJoin: opt<bool> = opt<bool> { "disable-sched-physreg-join", Hidden, init(false), desc { Desc: "Disable physreg def-use affinity" } };

static mut DisableSchedStalls: opt<bool> = opt<bool> { "disable-sched-stalls", Hidden, init(true), desc { Desc: "Disable no-stall priority in sched=list-ilp" } };

static mut DisableSchedCriticalPath: opt<bool> = opt<bool> { "disable-sched-critical-path", Hidden, init(false), desc { Desc: "Disable critical path priority in sched=list-ilp" } };

static mut DisableSchedHeight: opt<bool> = opt<bool> { "disable-sched-height", Hidden, init(false), desc { Desc: "Disable scheduled-height priority in sched=list-ilp" } };

static mut Disable2AddrHack: opt<bool> = opt<bool> { "disable-2addr-hack", Hidden, init(true), desc { Desc: "Disable scheduler's two-address hack" } };

static mut MaxReorderWindow: opt<int> = opt<int> { "max-sched-reorder", Hidden, init(6), desc { Desc: "Number of instructions to allow ahead of the critical path in sched=list-ilp" } };

static mut AvgIPC: opt<unsigned int> = opt<unsigned int> { "sched-avg-ipc", Hidden, init(1), desc { Desc: "Average inst/cycle when no target itinerary exists." } };

struct ScheduleDAGRRList {
    TM: *TargetMachine,
    TII: *TargetInstrInfo,
    TRI: *TargetRegisterInfo,
    MF: *mut MachineFunction,
    MRI: *mut MachineRegisterInfo,
    SUnits: []SUnit,
    EntrySU: SUnit,
    ExitSU: SUnit,
    StressSched: bool,
    BB: *mut MachineBasicBlock,
    DAG: *mut SelectionDAG,
    InstrItins: *InstrItineraryData,
    Sequence: []*mut SUnit,
    NeedLatency: bool,
    AvailableQueue: *mut SchedulingPriorityQueue,
    PendingQueue: []*mut SUnit,
    HazardRec: *mut ScheduleHazardRecognizer,
    CurCycle: u32,
    MinAvailableCycle: u32,
    IssueCount: u32,
    NumLiveRegs: u32,
    LiveRegDefs: []*mut unique_ptr<SUnit,
    LiveRegGens: []*mut unique_ptr<SUnit,
    Interferences: SmallVector<SUnit *, 4>,
    LRegsMap: LRegsMapT,
    Topo: ScheduleDAGTopologicalSort,
    CallSeqEndForStart: SmallDenseMap<SUnit *, SUnit *, 16>,
}

fn ScheduleDAGRRList::ScheduleDAGRRList(self, mf: *mut MachineFunction, needlatency: bool, availqueue: *mut SchedulingPriorityQueue, OptLevel: CodeGenOptLevel) {
    let mut STI: *TargetSubtargetInfo = mf.getSubtarget();
    if DisableSchedCycles || !self.NeedLatency {
        self.HazardRec = ScheduleHazardRecognizer {};
    } else {
        self.HazardRec = STI.getInstrInfo().CreateTargetHazardRecognizer(&mut STI, self);
    }
}

fn ScheduleDAGRRList::~ScheduleDAGRRList(self) {
    self.HazardRec;
    self.AvailableQueue;
}

fn ScheduleDAGRRList::getHazardRec(self) -> *mut ScheduleHazardRecognizer {
    return self.HazardRec;
}

fn ScheduleDAGRRList::IsReachable(self, SU: *SUnit, TargetSU: *SUnit) -> bool {
    return self.Topo.IsReachable(SU, TargetSU);
}

fn ScheduleDAGRRList::WillCreateCycle(self, SU: *mut SUnit, TargetSU: *mut SUnit) -> bool {
    return self.Topo.WillCreateCycle(SU, TargetSU);
}

fn ScheduleDAGRRList::AddPredQueued(self, SU: *mut SUnit, D: *SDep) {
    self.Topo.AddPredQueued(SU, D.getSUnit());
    SU.addPred(D, true);
}

fn ScheduleDAGRRList::RemovePred(self, SU: *mut SUnit, D: *SDep) {
    self.Topo.RemovePred(SU, D.getSUnit());
    SU.removePred(D);
}

fn ScheduleDAGRRList::isReady(self, SU: *mut SUnit) -> bool {
    return DisableSchedCycles || !self.AvailableQueue.hasReadyFilter() || self.AvailableQueue.isReady(SU);
}

fn ScheduleDAGRRList::CreateNewSUnit(self, N: *mut SDNode) -> *mut SUnit {
    let mut NumSUnits: u32 = self.SUnits.len;
    let mut NewNode: *mut SUnit = self.newSUnit(N);
    if NewNode.NodeNum >= NumSUnits {
        self.Topo.AddSUnitWithoutPredecessors(NewNode);
    }
    return NewNode;
}

fn ScheduleDAGRRList::CreateClone(self, N: *mut SUnit) -> *mut SUnit {
    let mut NumSUnits: u32 = self.SUnits.len;
    let mut NewNode: *mut SUnit = self.Clone(N);
    if NewNode.NodeNum >= NumSUnits {
        self.Topo.AddSUnitWithoutPredecessors(NewNode);
    }
    return NewNode;
}

fn ScheduleDAGRRList::forceUnitLatencies(self: *ScheduleDAGRRList) -> bool {
    return !self.NeedLatency;
}

fn ScheduleDAGRRList::getInstrDesc(self: *ScheduleDAGRRList, SU: *SUnit) -> *MCInstrDesc {
    if SU.isInstr() {
        return &mut SU.getInstr().getDesc();
    }
    return self.getNodeDesc(SU.getNode());
}

fn ScheduleDAGRRList::addCustomGraphFeatures(self: *ScheduleDAGRRList, arg: *mut GraphWriter<ScheduleDAG *>) {}

fn ScheduleDAGRRList::isPassiveNode(self, Node: *mut SDNode) -> bool {
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if Node.getOpcode() == EntryToken || isa(Node) {
        return true;
    }
    return false;
}

const RegSequenceCost: u32 = 1;

fn GetCostForDef(RegDefPos: *RegDefIter, TLI: *TargetLowering, TII: *TargetInstrInfo, TRI: *TargetRegisterInfo, RegClass: *mut u32, Cost: *mut u32, MF: *MachineFunction) {
    let mut VT: MVT = RegDefPos.GetValue();
    if VT == Untyped {
        let mut Node: *SDNode = RegDefPos.GetNode();
        if !Node.isMachineOpcode() && Node.getOpcode() == CopyFromReg {
            let mut Reg: Register = cast(Node.getOperand(1)).getReg();
            let mut RC: *TargetRegisterClass = MF.getRegInfo().getRegClass(Reg);
            RegClass = RC.getID();
            Cost = 1;
            return;
        }
        let mut Opcode: u32 = Node.getMachineOpcode();
        if Opcode == REG_SEQUENCE {
            let mut DstRCIdx: u32 = Node.getConstantOperandVal(0);
            let mut RC: *TargetRegisterClass = TRI.getRegClass(DstRCIdx);
            RegClass = RC.getID();
            Cost = RegSequenceCost;
            return;
        }
        let mut Idx: u32 = RegDefPos.GetIdx();
        let mut Desc: *MCInstrDesc = TII.get(Opcode);
        let mut RC: *TargetRegisterClass = TII.getRegClass(Desc, Idx);
        assert!(RC, "Not a valid register class");
        RegClass = RC.getID();
        Cost = 1;
    } else {
        RegClass = TLI.getRepRegClassFor(VT).getID();
        Cost = TLI.getRepRegClassCostFor(VT);
    }
}

fn ScheduleDAGRRList::Schedule(self) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
            dbgs() << "********** List Scheduling " << printMBBReference(*self.BB) << " '" << self.BB.getName() << "' **********\n";
        }
    }
        if !(false) { break; }
    }
    self.CurCycle = 0;
    self.IssueCount = 0;
    self.MinAvailableCycle = if DisableSchedCycles { 0 } else { max() };
    self.NumLiveRegs = 0;
    self.LiveRegDefs.reset(self.TRI.getNumRegs() + 1);
    self.LiveRegGens.reset(self.TRI.getNumRegs() + 1);
    self.CallSeqEndForStart.clear();
    assert!(self.Interferences.is_empty() && self.LRegsMap.is_empty(), "stale Interferences");
    self.BuildSchedGraph();
    while true {
        {
        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
            self.dump();
        }
    }
        if !(false) { break; }
    }
    self.Topo.MarkDirty();
    self.AvailableQueue.initNodes(self.SUnits);
    self.HazardRec.Reset();
    self.ListScheduleBottomUp();
    self.AvailableQueue.releaseState();
    while true {
        {
        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
            {
                dbgs() << "*** Final schedule ***\n";
                self.dumpSchedule();
                dbgs() << 10;
            }
        }
    }
        if !(false) { break; }
    }
}

fn ScheduleDAGRRList::ReleasePred(self, SU: *mut SUnit, PredEdge: *SDep) {
    let mut PredSU: *mut SUnit = PredEdge.getSUnit();
    if PredSU.NumSuccsLeft == 0 {
        dbgs() << "*** Scheduling failed! ***\n";
        self.dumpNode(*PredSU);
        dbgs() << " has been released too many times!\n";
        llvm_unreachable_internal(null, "llvm\\lib\\CodeGen\\SelectionDAG\\ScheduleDAGRRList.cpp", 400);
    }
    PredSU.NumSuccsLeft -= 1;
    if !self.forceUnitLatencies() {
        PredSU.setHeightToAtLeast(SU.getHeight() + PredEdge.getLatency());
    }
    if PredSU.NumSuccsLeft == 0 && PredSU != &mut self.EntrySU {
        PredSU.isAvailable = true;
        let mut Height: u32 = PredSU.getHeight();
        if Height < self.MinAvailableCycle {
            self.MinAvailableCycle = Height;
        }
        if self.isReady(PredSU) {
            self.AvailableQueue.push(PredSU);
        } else if !PredSU.isPending {
            PredSU.isPending = true;
            self.PendingQueue.push(PredSU);
        }
    }
}

fn IsChainDependent(Outer: *mut SDNode, Inner: *mut SDNode, NestLevel: u32, TII: *TargetInstrInfo) -> bool {
    let mut N: *mut SDNode = Outer;
    while true {
        if N == Inner {
            return true;
        }
        if N.getOpcode() == TokenFactor {
            for Op in N.op_values() {
                if IsChainDependent(Op.getNode(), Inner, NestLevel, TII) {
                    return true;
                }
            }
            return false;
        }
        if N.isMachineOpcode() {
            if N.getMachineOpcode() == TII.getCallFrameDestroyOpcode() {
                NestLevel += 1;
            } else if N.getMachineOpcode() == TII.getCallFrameSetupOpcode() {
                if NestLevel == 0 {
                    return false;
                }
                NestLevel -= 1;
            }
        }
        for Op in N.op_values() {
            if Op.getValueType() == EVT { Other } {
                N = Op.getNode();
            }
        }
        return false;
        if N.getOpcode() == EntryToken {
            return false;
        }
    }
}

fn FindCallSeqStart(N: *mut SDNode, NestLevel: *mut u32, MaxNest: *mut u32, TII: *TargetInstrInfo) -> *mut SDNode {
    while true {
        if N.getOpcode() == TokenFactor {
            let mut Best: *mut SDNode = null;
            let mut BestMaxNest: u32 = MaxNest;
            for Op in N.op_values() {
                let mut MyNestLevel: u32 = NestLevel;
                let mut MyMaxNest: u32 = MaxNest;
                if FindCallSeqStart(Op.getNode(), MyNestLevel, MyMaxNest, TII) {
                    New;
                } else if !Best || (MyMaxNest > BestMaxNest) {
                    Best = New;
                    BestMaxNest = MyMaxNest;
                }
            }
            assert!(Best);
            MaxNest = BestMaxNest;
            return Best;
        }
        if N.isMachineOpcode() {
            if N.getMachineOpcode() == TII.getCallFrameDestroyOpcode() {
                NestLevel += 1;
                MaxNest = if MaxNest > NestLevel { MaxNest } else { NestLevel };
            } else if N.getMachineOpcode() == TII.getCallFrameSetupOpcode() {
                assert!(NestLevel != 0);
                NestLevel -= 1;
                if NestLevel == 0 {
                    return N;
                }
            }
        }
        for Op in N.op_values() {
            if Op.getValueType() == EVT { Other } {
                N = Op.getNode();
            }
        }
        return null;
        if N.getOpcode() == EntryToken {
            return null;
        }
    }
}

fn ScheduleDAGRRList::ReleasePredecessors(self, SU: *mut SUnit) {
    for Pred in SU.Preds {
        self.ReleasePred(SU, &mut Pred);
        if Pred.isAssignedRegDep() {
            let mut RegDef: *mut SUnit = self.LiveRegDefs[Pred.getReg().operator unsigned int()];
            RegDef as void;
            assert!((!RegDef || RegDef == SU || RegDef == Pred.getSUnit()), "interference on register dependence");
            self.LiveRegDefs[Pred.getReg().operator unsigned int()] = Pred.getSUnit();
            if !self.LiveRegGens[Pred.getReg().operator unsigned int()] {
                self.NumLiveRegs += 1;
                self.LiveRegGens[Pred.getReg().operator unsigned int()] = SU;
            }
        }
    }
    let mut CallResource: u32 = self.TRI.getNumRegs();
    if !self.LiveRegDefs[CallResource] {
        for let mut Node: *mut SDNode = SU.getNode(); Node; Node = Node.getGluedNode() {
            if Node.isMachineOpcode() && Node.getMachineOpcode() == self.TII.getCallFrameDestroyOpcode() {
                let mut NestLevel: u32 = 0;
                let mut MaxNest: u32 = 0;
                let mut N: *mut SDNode = FindCallSeqStart(Node, NestLevel, MaxNest, self.TII);
                assert!(N, "Must find call sequence start");
                let mut Def: *mut SUnit = &mut self.SUnits[N.getNodeId()];
                self.CallSeqEndForStart[Def] = SU;
                self.NumLiveRegs += 1;
                self.LiveRegDefs[CallResource] = Def;
                self.LiveRegGens[CallResource] = SU;
                break;
            }
        }
    }
}

fn ScheduleDAGRRList::ReleasePending(self) {
    if DisableSchedCycles {
        assert!(self.PendingQueue.is_empty(), "pending instrs not allowed in this mode");
        return;
    }
    if self.AvailableQueue.len == 0 {
        self.MinAvailableCycle = max();
    }
    for let mut i: u32 = 0;
let mut e: u32 = self.PendingQueue.len; i != e; i += 1 {
        let mut ReadyCycle: u32 = self.PendingQueue[i].getHeight();
        if ReadyCycle < self.MinAvailableCycle {
            self.MinAvailableCycle = ReadyCycle;
        }
        if self.PendingQueue[i].isAvailable {
            if !self.isReady(self.PendingQueue[i]) {
                continue;
            }
            self.AvailableQueue.push(self.PendingQueue[i]);
        }
        self.PendingQueue[i].isPending = false;
        self.PendingQueue[i] = self.PendingQueue.back();
        self.PendingQueue.pop();
        i -= 1;
        e -= 1;
    }
}

fn ScheduleDAGRRList::AdvanceToCycle(self, NextCycle: u32) {
    if NextCycle <= self.CurCycle {
        return;
    }
    self.IssueCount = 0;
    self.AvailableQueue.setCurCycle(NextCycle);
    if !self.HazardRec.isEnabled() {
        self.CurCycle = NextCycle;
    } else {
        for ; self.CurCycle != NextCycle; self.CurCycle += 1 {
            self.HazardRec.RecedeCycle();
        }
    }
    self.ReleasePending();
}

fn ScheduleDAGRRList::AdvancePastStalls(self, SU: *mut SUnit) {
    if DisableSchedCycles {
        return;
    }
    let mut ReadyCycle: u32 = SU.getHeight();
    self.AdvanceToCycle(ReadyCycle);
    if SU.isCall {
        return;
    }
    let mut Stalls: i32 = 0;
    while true {
        let mut HT: HazardType = self.HazardRec.getHazardType(SU, -Stalls);
        if HT == NoHazard {
            break;
        }
        Stalls += 1;
    }
    self.AdvanceToCycle(self.CurCycle + Stalls);
}

fn ScheduleDAGRRList::EmitNode(self, SU: *mut SUnit) {
    if !self.HazardRec.isEnabled() {
        return;
    }
    if !SU.getNode() {
        return;
    }
    match SU.getNode().getOpcode() {
        _ => {
            assert!(SU.getNode().isMachineOpcode(), "This target-independent node should not be scheduled.");
        },
        MERGE_VALUES => {
            TokenFactor;
        },
        INLINEASM => {
            INLINEASM_BR;
        },
    }
    if SU.isCall {
        self.HazardRec.Reset();
    }
    self.HazardRec.EmitInstruction(SU);
}

fn ScheduleDAGRRList::ScheduleNodeBottomUp(self, SU: *mut SUnit) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
            dbgs() << "\n*** Scheduling [" << self.CurCycle << "]: ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
            self.dumpNode(*SU);
        }
    }
        if !(false) { break; }
    }
    if self.CurCycle < SU.getHeight() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                dbgs() << "   Height [" << SU.getHeight() << "] pipeline stall!\n";
            }
        }
            if !(false) { break; }
        }
    }
    SU.setHeightToAtLeast(self.CurCycle);
    self.EmitNode(SU);
    self.Sequence.push(SU);
    self.AvailableQueue.scheduledNode(SU);
    if !self.HazardRec.isEnabled() && AvgIPC.operator unsigned int() < 2 {
        self.AdvanceToCycle(self.CurCycle + 1);
    }
    self.ReleasePredecessors(SU);
    for Succ in SU.Succs {
        if Succ.isAssignedRegDep() && self.LiveRegDefs[Succ.getReg().operator unsigned int()] == SU {
            assert!(self.NumLiveRegs > 0, "NumLiveRegs is already zero!");
            self.NumLiveRegs -= 1;
            self.LiveRegDefs[Succ.getReg().operator unsigned int()] = null;
            self.LiveRegGens[Succ.getReg().operator unsigned int()] = null;
            self.releaseInterferences(Succ.getReg().operator unsigned int());
        }
    }
    let mut CallResource: u32 = self.TRI.getNumRegs();
    if self.LiveRegDefs[CallResource] == SU {
        for let mut SUNode: *SDNode = SU.getNode(); SUNode; SUNode = SUNode.getGluedNode() {
            if SUNode.isMachineOpcode() && SUNode.getMachineOpcode() == self.TII.getCallFrameSetupOpcode() {
                assert!(self.NumLiveRegs > 0, "NumLiveRegs is already zero!");
                self.NumLiveRegs -= 1;
                self.LiveRegDefs[CallResource] = null;
                self.LiveRegGens[CallResource] = null;
                self.releaseInterferences(CallResource);
            }
        }
    }
    resetVRegCycle(SU);
    SU.isScheduled = true;
    if self.HazardRec.isEnabled() || AvgIPC.operator unsigned int() > 1 {
        if SU.getNode() && SU.getNode().isMachineOpcode() {
            self.IssueCount += 1;
        }
        if (self.HazardRec.isEnabled() && self.HazardRec.atIssueLimit()) || (!self.HazardRec.isEnabled() && self.IssueCount == AvgIPC.operator unsigned int()) {
            self.AdvanceToCycle(self.CurCycle + 1);
        }
    }
}

fn ScheduleDAGRRList::CapturePred(self, PredEdge: *mut SDep) {
    let mut PredSU: *mut SUnit = PredEdge.getSUnit();
    if PredSU.isAvailable {
        PredSU.isAvailable = false;
        if !PredSU.isPending {
            self.AvailableQueue.remove(PredSU);
        }
    }
    assert!(PredSU.NumSuccsLeft < max(), "NumSuccsLeft will overflow!");
    PredSU.NumSuccsLeft += 1;
}

fn ScheduleDAGRRList::UnscheduleNodeBottomUp(self, SU: *mut SUnit) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
            dbgs() << "*** Unscheduling [" << SU.getHeight() << "]: ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
            self.dumpNode(*SU);
        }
    }
        if !(false) { break; }
    }
    for Pred in SU.Preds {
        self.CapturePred(&mut Pred);
        if Pred.isAssignedRegDep() && SU == self.LiveRegGens[Pred.getReg().operator unsigned int()] {
            assert!(self.NumLiveRegs > 0, "NumLiveRegs is already zero!");
            assert!(self.LiveRegDefs[Pred.getReg().operator unsigned int()] == Pred.getSUnit(), "Physical register dependency violated?");
            self.NumLiveRegs -= 1;
            self.LiveRegDefs[Pred.getReg().operator unsigned int()] = null;
            self.LiveRegGens[Pred.getReg().operator unsigned int()] = null;
            self.releaseInterferences(Pred.getReg().operator unsigned int());
        }
    }
    let mut CallResource: u32 = self.TRI.getNumRegs();
    for let mut SUNode: *SDNode = SU.getNode(); SUNode; SUNode = SUNode.getGluedNode() {
        if SUNode.isMachineOpcode() && SUNode.getMachineOpcode() == self.TII.getCallFrameSetupOpcode() {
            let mut SeqEnd: *mut SUnit = self.CallSeqEndForStart[SU];
            assert!(SeqEnd, "Call sequence start/end must be known");
            assert!(!self.LiveRegDefs[CallResource]);
            assert!(!self.LiveRegGens[CallResource]);
            self.NumLiveRegs += 1;
            self.LiveRegDefs[CallResource] = SU;
            self.LiveRegGens[CallResource] = SeqEnd;
        }
    }
    if self.LiveRegGens[CallResource] == SU {
        for let mut SUNode: *SDNode = SU.getNode(); SUNode; SUNode = SUNode.getGluedNode() {
            if SUNode.isMachineOpcode() && SUNode.getMachineOpcode() == self.TII.getCallFrameDestroyOpcode() {
                assert!(self.NumLiveRegs > 0, "NumLiveRegs is already zero!");
                assert!(self.LiveRegDefs[CallResource]);
                assert!(self.LiveRegGens[CallResource]);
                self.NumLiveRegs -= 1;
                self.LiveRegDefs[CallResource] = null;
                self.LiveRegGens[CallResource] = null;
                self.releaseInterferences(CallResource);
            }
        }
    }
    for Succ in SU.Succs {
        if Succ.isAssignedRegDep() {
            let mut Reg: Register = Succ.getReg();
            if !self.LiveRegDefs[Reg.operator unsigned int()] {
                self.NumLiveRegs += 1;
            }
            self.LiveRegDefs[Reg.operator unsigned int()] = SU;
            if !self.LiveRegGens[Reg.operator unsigned int()] {
                self.LiveRegGens[Reg.operator unsigned int()] = Succ.getSUnit();
                for Succ2 in SU.Succs {
                    if Succ2.isAssignedRegDep() && Succ2.getReg() == Reg && Succ2.getSUnit().getHeight() < self.LiveRegGens[Reg.operator unsigned int()].getHeight() {
                        self.LiveRegGens[Reg.operator unsigned int()] = Succ2.getSUnit();
                    }
                }
            }
        }
    }
    if SU.getHeight() < self.MinAvailableCycle {
        self.MinAvailableCycle = SU.getHeight();
    }
    SU.setHeightDirty();
    SU.isScheduled = false;
    SU.isAvailable = true;
    if !DisableSchedCycles && self.AvailableQueue.hasReadyFilter() {
        SU.isPending = true;
        self.PendingQueue.push(SU);
    } else {
        self.AvailableQueue.push(SU);
    }
    self.AvailableQueue.unscheduledNode(SU);
}

fn ScheduleDAGRRList::RestoreHazardCheckerBottomUp(self) {
    self.HazardRec.Reset();
    let mut LookAhead: u32 = if self.Sequence.len as u32 < self.HazardRec.getMaxLookAhead() { self.Sequence.len as u32 } else { self.HazardRec.getMaxLookAhead() };
    if LookAhead == 0 {
        return;
    }
    let mut I: []*mut SUnit = []*mut SUnit { (self.Sequence.end() - LookAhead) };
    let mut HazardCycle: u32 = (operator(I)).getHeight();
    for let mut E: iterator = self.Sequence.end(); !I == E; operator(I) {
        let mut SU: *mut SUnit = operator(I);
        for ; SU.getHeight() > HazardCycle; HazardCycle += 1 {
            self.HazardRec.RecedeCycle();
        }
        self.EmitNode(SU);
    }
}

fn ScheduleDAGRRList::BacktrackBottomUp(self, SU: *mut SUnit, BtSU: *mut SUnit) {
    let mut OldSU: *mut SUnit = self.Sequence.back();
    while true {
        self.Sequence.pop();
        self.CurCycle = OldSU.getHeight();
        self.UnscheduleNodeBottomUp(OldSU);
        self.AvailableQueue.setCurCycle(self.CurCycle);
        if OldSU == BtSU {
            break;
        }
        OldSU = self.Sequence.back();
    }
    assert!(!SU.isSucc(OldSU), "Something is wrong!");
    self.RestoreHazardCheckerBottomUp();
    self.ReleasePending();
    operator(NumBacktracks);
}

fn isOperandOf(SU: *SUnit, N: *mut SDNode) -> bool {
    for let mut SUNode: *SDNode = SU.getNode(); SUNode; SUNode = SUNode.getGluedNode() {
        if SUNode.isOperandOf(N) {
            return true;
        }
    }
    return false;
}

fn ScheduleDAGRRList::TryUnfoldSU(self, SU: *mut SUnit) -> *mut SUnit {
    let mut N: *mut SDNode = SU.getNode();
    let mut NewNodes: SmallVector<SDNode *, 2> = SmallVector<SDNode *, 2> {};
    if !self.TII.unfoldMemoryOperand(*self.DAG, N, NewNodes) {
        return null;
    }
    assert!(NewNodes.len == 2, "Expected a load folding node!");
    N = NewNodes[1];
    let mut LoadNode: *mut SDNode = NewNodes[0];
    let mut NumVals: u32 = N.getNumValues();
    let mut OldNumVals: u32 = SU.getNode().getNumValues();
    let mut isNewLoad: bool = true;
    let mut LoadSU: *mut SUnit = null;
    if LoadNode.getNodeId() != -1 {
        LoadSU = &mut self.SUnits[LoadNode.getNodeId()];
        if LoadSU.isScheduled {
            return SU;
        }
        isNewLoad = false;
    } else {
        LoadSU = self.CreateNewSUnit(LoadNode);
        LoadNode.setNodeId(LoadSU.NodeNum);
        self.InitNumRegDefsLeft(LoadSU);
        self.computeLatency(LoadSU);
    }
    let mut isNewN: bool = true;
    let mut NewSU: *mut SUnit = null;
    if N.getNodeId() != -1 {
        NewSU = &mut self.SUnits[N.getNodeId()];
        if NewSU.isScheduled {
            return SU;
        }
        isNewN = false;
    } else {
        NewSU = self.CreateNewSUnit(N);
        N.setNodeId(NewSU.NodeNum);
        let mut MCID: *MCInstrDesc = self.TII.get(N.getMachineOpcode());
        for let mut i: u32 = 0; i != MCID.getNumOperands(); i += 1 {
            if MCID.getOperandConstraint(i, TIED_TO) != -1 {
                NewSU.isTwoAddress = true;
                break;
            }
        }
        if MCID.isCommutable() {
            NewSU.isCommutable = true;
        }
        self.InitNumRegDefsLeft(NewSU);
        self.computeLatency(NewSU);
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
            dbgs() << "Unfolding SU #" << SU.NodeNum << "\n";
        }
    }
        if !(false) { break; }
    }
    for let mut i: u32 = 0; i != NumVals; i += 1 {
        self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: SU.getNode(), ResNo: i }, SDValue { Node: N, ResNo: i });
    }
    self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: SU.getNode(), ResNo: OldNumVals - 1 }, SDValue { Node: LoadNode, ResNo: 1 });
    let mut ChainPreds: SmallVector<SDep, 4> = SmallVector<SDep, 4> {};
    let mut ChainSuccs: SmallVector<SDep, 4> = SmallVector<SDep, 4> {};
    let mut LoadPreds: SmallVector<SDep, 4> = SmallVector<SDep, 4> {};
    let mut NodePreds: SmallVector<SDep, 4> = SmallVector<SDep, 4> {};
    let mut NodeSuccs: SmallVector<SDep, 4> = SmallVector<SDep, 4> {};
    for Pred in SU.Preds {
        if Pred.isCtrl() {
            ChainPreds.push(ValueParamT { Pred });
        } else if isOperandOf(Pred.getSUnit(), LoadNode) {
            LoadPreds.push(ValueParamT { Pred });
        } else {
            NodePreds.push(ValueParamT { Pred });
        }
    }
    for Succ in SU.Succs {
        if Succ.isCtrl() {
            ChainSuccs.push(ValueParamT { Succ });
        } else {
            NodeSuccs.push(ValueParamT { Succ });
        }
    }
    for Pred in ChainPreds {
        self.RemovePred(SU, Pred);
        if isNewLoad {
            self.AddPredQueued(LoadSU, Pred);
        }
    }
    for Pred in LoadPreds {
        self.RemovePred(SU, Pred);
        if isNewLoad {
            self.AddPredQueued(LoadSU, Pred);
        }
    }
    for Pred in NodePreds {
        self.RemovePred(SU, Pred);
        self.AddPredQueued(NewSU, Pred);
    }
    for D in NodeSuccs {
        let mut SuccDep: *mut SUnit = D.getSUnit();
        D.setSUnit(SU);
        self.RemovePred(SuccDep, D);
        D.setSUnit(NewSU);
        self.AddPredQueued(SuccDep, D);
        if self.AvailableQueue.tracksRegPressure() && SuccDep.isScheduled && !D.isCtrl() && NewSU.NumRegDefsLeft > 0 {
            NewSU.NumRegDefsLeft -= 1;
        }
    }
    for D in ChainSuccs {
        let mut SuccDep: *mut SUnit = D.getSUnit();
        D.setSUnit(SU);
        self.RemovePred(SuccDep, D);
        if isNewLoad {
            D.setSUnit(LoadSU);
            self.AddPredQueued(SuccDep, D);
        }
    }
    let mut D: SDep = SDep { Dep: LoadSU, Contents: Data, Latency: Register { Reg: 0 } };
    D.setLatency(LoadSU.Latency);
    self.AddPredQueued(NewSU, D);
    if isNewLoad {
        self.AvailableQueue.addNode(LoadSU);
    }
    if isNewN {
        self.AvailableQueue.addNode(NewSU);
    }
    operator(NumUnfolds);
    if NewSU.NumSuccsLeft == 0 {
        NewSU.isAvailable = true;
    }
    return NewSU;
}

fn ScheduleDAGRRList::CopyAndMoveSuccessors(self, SU: *mut SUnit) -> *mut SUnit {
    let mut N: *mut SDNode = SU.getNode();
    if !N {
        return null;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
            dbgs() << "Considering duplicating the SU\n";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
            self.dumpNode(*SU);
        }
    }
        if !(false) { break; }
    }
    if N.getGluedNode() && !self.TII.canCopyGluedNodeDuringSchedule(N) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                dbgs() << "Giving up because it has incoming glue and the target does not want to copy it\n";
            }
        }
            if !(false) { break; }
        }
        return null;
    }
    let mut NewSU: *mut SUnit = null;
    let mut TryUnfold: bool = false;
    for let mut i: u32 = 0;
let mut e: u32 = N.getNumValues(); i != e; i += 1 {
        let mut VT: MVT = N.getSimpleValueType(i);
        if VT == Glue {
            while true {
                {
                if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                    dbgs() << "Giving up because it has outgoing glue\n";
                }
            }
                if !(false) { break; }
            }
            return null;
        } else if VT == Other {
            TryUnfold = true;
        }
    }
    for Op in N.op_values() {
        let mut VT: MVT = Op.getNode().getSimpleValueType(Op.getResNo());
        if VT == Glue && !self.TII.canCopyGluedNodeDuringSchedule(N) {
            while true {
                {
                if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                    dbgs() << "Giving up because it one of the operands is glue and the target does not want to copy it\n";
                }
            }
                if !(false) { break; }
            }
            return null;
        }
    }
    if TryUnfold {
        let mut UnfoldSU: *mut SUnit = self.TryUnfoldSU(SU);
        if !UnfoldSU {
            return null;
        }
        SU = UnfoldSU;
        N = SU.getNode();
        if SU.NumSuccsLeft == 0 {
            return SU;
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
            dbgs() << "    Duplicating SU #" << SU.NodeNum << "\n";
        }
    }
        if !(false) { break; }
    }
    NewSU = self.CreateClone(SU);
    for Pred in SU.Preds {
        if !Pred.isArtificial() {
            self.AddPredQueued(NewSU, Pred);
        }
    }
    self.AddPredQueued(NewSU, SDep { SU, Artificial });
    let mut DelDeps: pair<SUnit *, SDep>, 4> = pair<SUnit *, SDep>, 4> {};
    for Succ in SU.Succs {
        if Succ.isArtificial() {
            continue;
        }
        let mut SuccSU: *mut SUnit = Succ.getSUnit();
        if SuccSU.isScheduled {
            let mut D: SDep = Succ;
            D.setSUnit(NewSU);
            self.AddPredQueued(SuccSU, D);
            D.setSUnit(SU);
            DelDeps.emplace_back(SuccSU, D);
        }
    }
    for x in DelDeps {
        self.RemovePred(DelSU, DelD);
    }
    self.AvailableQueue.updateNode(SU);
    self.AvailableQueue.addNode(NewSU);
    operator(NumDups);
    return NewSU;
}

fn ScheduleDAGRRList::InsertCopiesAndMoveSuccs(self, SU: *mut SUnit, Reg: u32, DestRC: *TargetRegisterClass, SrcRC: *TargetRegisterClass, Copies: *mut SmallVectorImpl<SUnit *>) {
    let mut CopyFromSU: *mut SUnit = self.CreateNewSUnit(null);
    CopyFromSU.CopySrcRC = SrcRC;
    CopyFromSU.CopyDstRC = DestRC;
    let mut CopyToSU: *mut SUnit = self.CreateNewSUnit(null);
    CopyToSU.CopySrcRC = DestRC;
    CopyToSU.CopyDstRC = SrcRC;
    let mut DelDeps: pair<SUnit *, SDep>, 4> = pair<SUnit *, SDep>, 4> {};
    for Succ in SU.Succs {
        if Succ.isArtificial() {
            continue;
        }
        let mut SuccSU: *mut SUnit = Succ.getSUnit();
        if SuccSU.isScheduled {
            let mut D: SDep = Succ;
            D.setSUnit(CopyToSU);
            self.AddPredQueued(SuccSU, D);
            DelDeps.emplace_back(SuccSU, Succ);
        } else {
            self.AddPredQueued(SuccSU, SDep { CopyFromSU, Artificial });
        }
    }
    for x in DelDeps {
        self.RemovePred(DelSU, DelD);
    }
    let mut FromDep: SDep = SDep { Dep: SU, Contents: Data, Latency: Register { Reg: Reg } };
    FromDep.setLatency(SU.Latency);
    self.AddPredQueued(CopyFromSU, FromDep);
    let mut ToDep: SDep = SDep { Dep: CopyFromSU, Contents: Data, Latency: Register { Reg: 0 } };
    ToDep.setLatency(CopyFromSU.Latency);
    self.AddPredQueued(CopyToSU, ToDep);
    self.AvailableQueue.updateNode(SU);
    self.AvailableQueue.addNode(CopyFromSU);
    self.AvailableQueue.addNode(CopyToSU);
    Copies.push(CopyFromSU);
    Copies.push(CopyToSU);
    operator(NumPRCopies);
}

fn CheckForLiveRegDef(SU: *mut SUnit, Reg: MCRegister, LiveRegDefs: *mut *mut SUnit, RegAdded: *mut SmallSet<unsigned int, 4>, LRegs: *mut SmallVectorImpl<unsigned int>, TRI: *TargetRegisterInfo, Node: *SDNode) {
    for let mut AliasI: MCRegAliasIterator = MCRegAliasIterator { Reg, TRI, true }; AliasI.isValid(); operator(AliasI) {
        if !LiveRegDefs[operator(AliasI).operator unsigned int()] {
            continue;
        }
        if LiveRegDefs[operator(AliasI).operator unsigned int()] == SU {
            continue;
        }
        if Node && LiveRegDefs[operator(AliasI).operator unsigned int()].getNode() == Node {
            continue;
        }
        if RegAdded.insert(operator(AliasI).operator unsigned int()).second {
            LRegs.push(operator(AliasI).operator unsigned int());
        }
    }
}

fn CheckForLiveRegDefMasked(SU: *mut SUnit, RegMask: *u32, LiveRegDefs: ArrayRef<SUnit *>, RegAdded: *mut SmallSet<unsigned int, 4>, LRegs: *mut SmallVectorImpl<unsigned int>) {
    for let mut i: u32 = 1;
let mut e: u32 = LiveRegDefs.len - 1; i != e; i += 1 {
        if !LiveRegDefs[i] {
            continue;
        }
        if LiveRegDefs[i] == SU {
            continue;
        }
        if !clobbersPhysReg(RegMask, MCRegister { Reg: i }) {
            continue;
        }
        if RegAdded.insert(i).second {
            LRegs.push(i);
        }
    }
}

fn getNodeRegMask(N: *SDNode) -> *u32 {
    for Op in N.op_values() {
        if dyn_cast(Op.getNode()) {
            RegOp;
        } else {
            return RegOp.getRegMask();
        }
    }
    return null;
}

fn ScheduleDAGRRList::DelayForLiveRegsBottomUp(self, SU: *mut SUnit, LRegs: *mut SmallVectorImpl<unsigned int>) -> bool {
    if self.NumLiveRegs == 0 {
        return false;
    }
    let mut RegAdded: SmallSet<unsigned int, 4> = SmallSet<unsigned int, 4> {};
    for Pred in SU.Preds {
        if Pred.isAssignedRegDep() && self.LiveRegDefs[Pred.getReg().operator unsigned int()] != SU {
            CheckForLiveRegDef(Pred.getSUnit(), Pred.getReg().operator MCRegister(), self.LiveRegDefs.get(), RegAdded, LRegs, self.TRI, null);
        }
    }
    for let mut Node: *mut SDNode = SU.getNode(); Node; Node = Node.getGluedNode() {
        if Node.getOpcode() == INLINEASM || Node.getOpcode() == INLINEASM_BR {
            let mut NumOps: u32 = Node.getNumOperands();
            if Node.getOperand(NumOps - 1).getValueType() == EVT { Glue } {
                NumOps -= 1;
            }
            for let mut i: u32 = Op_FirstOperand; i != NumOps;  {
                let mut Flags: u32 = Node.getConstantOperandVal(i);
                let mut F: Flag = Flag { Flags };
                let mut NumVals: u32 = F.getNumOperandRegisters();
                i += 1;
                if F.isRegDefKind() || F.isRegDefEarlyClobberKind() || F.isClobberKind() {
                    for ; NumVals; NumVals -= 1 , i += 1 {
                        let mut Reg: Register = cast(Node.getOperand(i)).getReg();
                        if Reg.isPhysical() {
                            CheckForLiveRegDef(SU, Reg.operator MCRegister(), self.LiveRegDefs.get(), RegAdded, LRegs, self.TRI, null);
                        }
                    }
                } else {
                    i += NumVals;
                }
            }
            continue;
        }
        if Node.getOpcode() == CopyToReg {
            let mut Reg: Register = cast(Node.getOperand(1)).getReg();
            if Reg.isPhysical() {
                let mut SrcNode: *mut SDNode = Node.getOperand(2).getNode();
                CheckForLiveRegDef(SU, Reg.operator MCRegister(), self.LiveRegDefs.get(), RegAdded, LRegs, self.TRI, SrcNode);
            }
        }
        if !Node.isMachineOpcode() {
            continue;
        }
        if Node.getMachineOpcode() == self.TII.getCallFrameDestroyOpcode() {
            let mut CallResource: u32 = self.TRI.getNumRegs();
            if self.LiveRegDefs[CallResource] {
                let mut Gen: *mut SDNode = self.LiveRegGens[CallResource].getNode();
                while Gen.getGluedNode() {
                    Glued;
                }
                if !IsChainDependent(Gen, Node, 0, self.TII) && RegAdded.insert(CallResource).second {
                    LRegs.push(CallResource);
                }
            }
        }
        if getNodeRegMask(Node) {
            RegMask;
        } else {
            CheckForLiveRegDefMasked(SU, RegMask, SUnit *> { self.LiveRegDefs.get(), self.TRI.getNumRegs() }, RegAdded, LRegs);
        }
        let mut MCID: *MCInstrDesc = self.TII.get(Node.getMachineOpcode());
        if MCID.hasOptionalDef() {
            for let mut i: u32 = 0; i < MCID.getNumDefs(); i += 1 {
                if MCID.operands()[i].isOptionalDef() {
                    let mut OptionalDef: *SDValue = Node.getOperand(i - Node.getNumValues());
                    let mut Reg: Register = cast(OptionalDef).getReg();
                    CheckForLiveRegDef(SU, Reg.operator MCRegister(), self.LiveRegDefs.get(), RegAdded, LRegs, self.TRI, null);
                }
            }
        }
        for Reg in MCID.implicit_defs() {
            CheckForLiveRegDef(SU, MCRegister { Reg: Reg }, self.LiveRegDefs.get(), RegAdded, LRegs, self.TRI, null);
        }
    }
    return !LRegs.is_empty();
}

fn ScheduleDAGRRList::releaseInterferences(self, Reg: u32) {
    for let mut i: u32 = self.Interferences.len; i > 0; i -= 1 {
        let mut SU: *mut SUnit = self.Interferences[i - 1];
        let mut LRegsPos: iterator = self.LRegsMap.find(SU);
        if Reg {
            let mut LRegs: *mut SmallVectorImpl<unsigned int> = operator(LRegsPos).second;
            if !is_contained(LRegs, Reg) {
                continue;
            }
        }
        SU.isPending = false;
        if SU.isAvailable && !SU.NodeQueueId {
            while true {
                {
                if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                    dbgs() << "    Repushing SU #" << SU.NodeNum << 10;
                }
            }
                if !(false) { break; }
            }
            self.AvailableQueue.push(SU);
        }
        if i < self.Interferences.len {
            self.Interferences[i - 1] = self.Interferences.back();
        }
        self.Interferences.pop();
        self.LRegsMap.erase(iterator { LRegsPos });
    }
}

fn ScheduleDAGRRList::PickNodeToScheduleBottomUp(self) -> *mut SUnit {
    let mut CurSU: *mut SUnit = if self.AvailableQueue.len == 0 { null } else { self.AvailableQueue.pop() };
    let mut FindAvailableNode: Closure_1 = Closure_1 { CurSU: &mut CurSU, cap_1: self };
    FindAvailableNode.call();
    if CurSU {
        return CurSU;
    }
    for TrySU in self.Interferences {
        let mut LRegs: *mut SmallVectorImpl<unsigned int> = self.LRegsMap[TrySU];
        let mut BtSU: *mut SUnit = null;
        let mut LiveCycle: u32 = max();
        for Reg in LRegs {
            if self.LiveRegGens[Reg].getHeight() < LiveCycle {
                BtSU = self.LiveRegGens[Reg];
                LiveCycle = BtSU.getHeight();
            }
        }
        if !self.WillCreateCycle(TrySU, BtSU) {
            self.BacktrackBottomUp(TrySU, BtSU);
            if BtSU.isAvailable {
                BtSU.isAvailable = false;
                if !BtSU.isPending {
                    self.AvailableQueue.remove(BtSU);
                }
            }
            while true {
                {
                if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                    dbgs() << "ARTIFICIAL edge from " << *BtSU << " to " << *TrySU << "\n";
                }
            }
                if !(false) { break; }
            }
            self.AddPredQueued(TrySU, SDep { BtSU, Artificial });
            if !TrySU.isAvailable || !TrySU.NodeQueueId {
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                        dbgs() << "TrySU not available; choosing node from queue\n";
                    }
                }
                    if !(false) { break; }
                }
                CurSU = self.AvailableQueue.pop();
            } else {
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                        dbgs() << "TrySU available\n";
                    }
                }
                    if !(false) { break; }
                }
                self.AvailableQueue.remove(TrySU);
                CurSU = TrySU;
            }
            FindAvailableNode.call();
            break;
        }
    }
    if !CurSU {
        let mut TrySU: *mut SUnit = self.Interferences[0];
        let mut LRegs: *mut SmallVectorImpl<unsigned int> = self.LRegsMap[TrySU];
        assert!(LRegs.len == 1, "Can't handle this yet!");
        let mut Reg: u32 = LRegs[0];
        let mut LRDef: *mut SUnit = self.LiveRegDefs[Reg];
        let mut RC: *TargetRegisterClass = self.TRI.getMinimalPhysRegClass(MCRegister { Reg: Reg });
        let mut DestRC: *TargetRegisterClass = self.TRI.getCrossCopyRegClass(RC);
        let mut NewDef: *mut SUnit = null;
        if DestRC != RC {
            NewDef = self.CopyAndMoveSuccessors(LRDef);
            if !DestRC && !NewDef {
                report_fatal_error("Can't handle live physical register dependency!", true);
            }
        }
        if !NewDef {
            let mut Copies: SmallVector<SUnit *, 2> = SmallVector<SUnit *, 2> {};
            self.InsertCopiesAndMoveSuccs(LRDef, Reg, DestRC, RC, Copies);
            while true {
                {
                if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                    dbgs() << "    Adding an edge from SU #" << TrySU.NodeNum << " to SU #" << Copies.front().NodeNum << "\n";
                }
            }
                if !(false) { break; }
            }
            self.AddPredQueued(TrySU, SDep { Copies.front(), Artificial });
            NewDef = Copies.back();
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                dbgs() << "    Adding an edge from SU #" << NewDef.NodeNum << " to SU #" << TrySU.NodeNum << "\n";
            }
        }
            if !(false) { break; }
        }
        self.LiveRegDefs[Reg] = NewDef;
        self.AddPredQueued(NewDef, SDep { TrySU, Artificial });
        TrySU.isAvailable = false;
        CurSU = NewDef;
    }
    assert!(CurSU, "Unable to resolve live physical register dependencies!");
    return CurSU;
}

fn ScheduleDAGRRList::ListScheduleBottomUp(self) {
    self.ReleasePredecessors(&mut self.ExitSU);
    if !self.SUnits.is_empty() {
        let mut RootSU: *mut SUnit = &mut self.SUnits[self.DAG.getRoot().getNode().getNodeId()];
        assert!(RootSU.Succs.is_empty(), "Graph root shouldn't have successors!");
        RootSU.isAvailable = true;
        self.AvailableQueue.push(RootSU);
    }
    self.Sequence.reserve(self.SUnits.len);
    while !self.AvailableQueue.is_empty() || !self.Interferences.is_empty() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                dbgs() << "\nExamining Available:\n";
                self.AvailableQueue.dump(self);
            }
        }
            if !(false) { break; }
        }
        let mut SU: *mut SUnit = self.PickNodeToScheduleBottomUp();
        self.AdvancePastStalls(SU);
        self.ScheduleNodeBottomUp(SU);
        while self.AvailableQueue.len == 0 && !self.PendingQueue.is_empty() {
            assert!(self.MinAvailableCycle < max(), "MinAvailableCycle uninitialized");
            self.AdvanceToCycle(if self.CurCycle + 1 > self.MinAvailableCycle { self.CurCycle + 1 } else { self.MinAvailableCycle });
        }
    }
    reverse(self.Sequence.begin(), self.Sequence.end());
    self.VerifyScheduledSequence(true);
}

struct queue_sort {
}

fn queue_sort::isReady(self: *queue_sort, SU: *mut SUnit, CurCycle: u32) -> bool {
    return true;
}

// ========================================================
// [C++ Template - Неинстанциированный класс-шаблон: reverse_sort]
