struct bu_ls_rr_sort {
    SPQ: *mut RegReductionPQBase,
}

fn bu_ls_rr_sort::isReady(self: *bu_ls_rr_sort, SU: *mut SUnit, CurCycle: u32) -> bool {
    return true;
}

struct src_ls_rr_sort {
    SPQ: *mut RegReductionPQBase,
}

fn src_ls_rr_sort::isReady(self: *src_ls_rr_sort, SU: *mut SUnit, CurCycle: u32) -> bool {
    return true;
}

struct hybrid_ls_rr_sort {
    SPQ: *mut RegReductionPQBase,
}

struct ilp_ls_rr_sort {
    SPQ: *mut RegReductionPQBase,
}

struct RegReductionPQBase {
    CurCycle: u32,
    HasReadyFilter: bool,
    Queue: []*mut SUnit,
    CurQueueId: u32,
    TracksRegPressure: bool,
    SrcOrder: bool,
    SUnits: *mut []SUnit,
    MF: *mut MachineFunction,
    TII: *TargetInstrInfo,
    TRI: *TargetRegisterInfo,
    TLI: *TargetLowering,
    scheduleDAG: *mut ScheduleDAGRRList,
    SethiUllmanNumbers: []u32,
    RegPressure: []u32,
    RegLimit: []u32,
}

fn RegReductionPQBase::RegReductionPQBase(self, mf: *mut MachineFunction, hasReadyFilter: bool, tracksrp: bool, srcorder: bool, tii: *TargetInstrInfo, tri: *TargetRegisterInfo, tli: *TargetLowering) {
    if self.TracksRegPressure {
        let mut NumRC: u32 = self.TRI.getNumRegClasses();
        self.RegLimit.resize(NumRC);
        self.RegPressure.resize(NumRC);
        fill(self.RegLimit, 0);
        fill(self.RegPressure, 0);
        for RC in self.TRI.regclasses() {
            self.RegLimit[RC.getID()] = tri.getRegPressureLimit(&mut RC, self.MF);
        }
    }
}

fn RegReductionPQBase::setScheduleDAG(self, scheduleDag: *mut ScheduleDAGRRList) {
    self.scheduleDAG = scheduleDag;
}

fn RegReductionPQBase::getHazardRec(self) -> *mut ScheduleHazardRecognizer {
    return self.scheduleDAG.getHazardRec();
}

fn RegReductionPQBase::releaseState(self) {
    self.SUnits = null;
    self.SethiUllmanNumbers.clear();
    fill(self.RegPressure, 0);
}

fn RegReductionPQBase::getNodeOrdering(self: *RegReductionPQBase, SU: *SUnit) -> u32 {
    if !SU.getNode() {
        return 0;
    }
    return SU.getNode().getIROrder();
}

fn RegReductionPQBase::empty(self: *RegReductionPQBase) -> bool {
    return self.Queue.len == 0;
}

fn RegReductionPQBase::push(self, U: *mut SUnit) {
    assert!(!U.NodeQueueId, "Node in the queue already");
    U.NodeQueueId = self.CurQueueId += 1;
    self.Queue.push(U);
}

fn RegReductionPQBase::remove(self, SU: *mut SUnit) {
    assert!(!self.Queue.is_empty(), "Queue is empty!");
    assert!(SU.NodeQueueId != 0, "Not in queue!");
    let mut I: []*mut SUnit = find(self.Queue, SU);
    if !I == prev(self.Queue.end(), 1) {
        swap(operator(I), self.Queue.back());
    }
    self.Queue.pop();
    SU.NodeQueueId = 0;
}

fn RegReductionPQBase::tracksRegPressure(self: *RegReductionPQBase) -> bool {
    return self.TracksRegPressure;
}

fn RegReductionPQBase::hasReadyFilter(self: *RegReductionPQBase) -> bool {
    return self.HasReadyFilter;
}

fn RegReductionPQBase::isReady(self: *RegReductionPQBase, arg: *mut SUnit) -> bool {
    assert!(!self.HasReadyFilter, "The ready filter must override isReady()");
    return true;
}

fn RegReductionPQBase::push_all(self, Nodes: *[]*mut SUnit) {
    for SU in Nodes {
        self.push(SU);
    }
}

fn RegReductionPQBase::dump(self: *RegReductionPQBase, arg: *mut ScheduleDAG) {}

fn RegReductionPQBase::setCurCycle(self, Cycle: u32) {
    self.CurCycle = Cycle;
}

fn RegReductionPQBase::getCurCycle(self: *RegReductionPQBase) -> u32 {
    return self.CurCycle;
}

