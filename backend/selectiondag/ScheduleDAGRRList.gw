fn checkSpecialNodes(left: *SUnit, right: *SUnit) -> i32 {
    let mut LSchedLow: bool = left.isScheduleLow;
    let mut RSchedLow: bool = right.isScheduleLow;
    if LSchedLow != RSchedLow {
        return if LSchedLow < RSchedLow { 1 } else { -1 };
    }
    return 0;
}

fn CalcNodeSethiUllmanNumber(SU: *SUnit, SUNumbers: *mut []u32) -> u32 {
    if SUNumbers[SU.NodeNum] != 0 {
        return SUNumbers[SU.NodeNum];
    }
    let mut WorkList: SmallVector<WorkState, 16> = SmallVector<WorkState, 16> {};
    WorkList.push(ValueParamT { SU });
    while !WorkList.is_empty() {
        let mut Temp: *mut WorkState = WorkList.back();
        let mut TempSU: *SUnit = Temp.SU;
        let mut AllPredsKnown: bool = true;
        for let mut P: u32 = Temp.PredsProcessed; P < TempSU.Preds.len; P += 1 {
            let mut Pred: *SDep = TempSU.Preds[P];
            if Pred.isCtrl() {
                continue;
            }
            let mut PredSU: *mut SUnit = Pred.getSUnit();
            if SUNumbers[PredSU.NodeNum] == 0 {
                for It in WorkList {
                    assert!(It.SU != PredSU, "Trying to push an element twice?");
                }
                Temp.PredsProcessed = P + 1;
                WorkList.push(ValueParamT { PredSU });
                AllPredsKnown = false;
                break;
            }
        }
        if !AllPredsKnown {
            continue;
        }
        let mut SethiUllmanNumber: u32 = 0;
        let mut Extra: u32 = 0;
        for Pred in TempSU.Preds {
            if Pred.isCtrl() {
                continue;
            }
            let mut PredSU: *mut SUnit = Pred.getSUnit();
            let mut PredSethiUllman: u32 = SUNumbers[PredSU.NodeNum];
            assert!(PredSethiUllman > 0, "We should have evaluated this pred!");
            if PredSethiUllman > SethiUllmanNumber {
                SethiUllmanNumber = PredSethiUllman;
                Extra = 0;
            } else if PredSethiUllman == SethiUllmanNumber {
                Extra += 1;
            }
        }
        SethiUllmanNumber += Extra;
        if SethiUllmanNumber == 0 {
            SethiUllmanNumber = 1;
        }
        SUNumbers[TempSU.NodeNum] = SethiUllmanNumber;
        WorkList.pop();
    }
    assert!(SUNumbers[SU.NodeNum] > 0, "SethiUllman should never be zero!");
    return SUNumbers[SU.NodeNum];
}

fn RegReductionPQBase::CalculateSethiUllmanNumbers(self) {
    self.SethiUllmanNumbers.assign(self.SUnits.len, 0);
    for SU in *self.SUnits {
        CalcNodeSethiUllmanNumber(&mut SU, self.SethiUllmanNumbers);
    }
}

fn RegReductionPQBase::addNode(self, SU: *SUnit) {
    let mut SUSize: u32 = self.SethiUllmanNumbers.len;
    if self.SUnits.len > SUSize {
        self.SethiUllmanNumbers.resize(SUSize * 2, 0);
    }
    CalcNodeSethiUllmanNumber(SU, self.SethiUllmanNumbers);
}

fn RegReductionPQBase::updateNode(self, SU: *SUnit) {
    self.SethiUllmanNumbers[SU.NodeNum] = 0;
    CalcNodeSethiUllmanNumber(SU, self.SethiUllmanNumbers);
}

fn RegReductionPQBase::getNodePriority(self: *RegReductionPQBase, SU: *SUnit) -> u32 {
    assert!(SU.NodeNum < self.SethiUllmanNumbers.len);
    let mut Opc: u32 = if SU.getNode() { SU.getNode().getOpcode() } else { 0 };
    if Opc == TokenFactor || Opc == CopyToReg {
        return 0;
    }
    if Opc == EXTRACT_SUBREG || Opc == SUBREG_TO_REG || Opc == INSERT_SUBREG {
        return 0;
    }
    if SU.NumSuccs == 0 && SU.NumPreds != 0 {
        return 65535;
    }
    if SU.NumPreds == 0 && SU.NumSuccs != 0 {
        return 0;
    }
    return self.SethiUllmanNumbers[SU.NodeNum];
}

fn RegReductionPQBase::dumpRegPressure(self: *RegReductionPQBase) {
    for RC in self.TRI.regclasses() {
        let mut Id: u32 = RC.getID();
        let mut RP: u32 = self.RegPressure[Id];
        if !RP {
            continue;
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                dbgs() << self.TRI.getRegClassName(&mut RC) << ": " << RP << " / " << self.RegLimit[Id] << 10;
            }
        }
            if !(false) { break; }
        }
    }
}

fn RegReductionPQBase::HighRegPressure(self: *RegReductionPQBase, SU: *SUnit) -> bool {
    if !self.TLI {
        return false;
    }
    for Pred in SU.Preds {
        if Pred.isCtrl() {
            continue;
        }
        let mut PredSU: *mut SUnit = Pred.getSUnit();
        if PredSU.NumRegDefsLeft == 0 {
            continue;
        }
        for let mut RegDefPos: RegDefIter = RegDefIter { PredSU, self.scheduleDAG }; RegDefPos.IsValid(); RegDefPos.Advance() {
            let mut RCId: u32 = 0;
            let mut Cost: u32 = 0;
            GetCostForDef(RegDefPos, self.TLI, self.TII, self.TRI, RCId, Cost, self.MF);
            if (self.RegPressure[RCId] + Cost) >= self.RegLimit[RCId] {
                return true;
            }
        }
    }
    return false;
}

fn RegReductionPQBase::MayReduceRegPressure(self: *RegReductionPQBase, SU: *mut SUnit) -> bool {
    let mut N: *SDNode = SU.getNode();
    if !N.isMachineOpcode() || !SU.NumSuccs {
        return false;
    }
    let mut NumDefs: u32 = self.TII.get(N.getMachineOpcode()).getNumDefs();
    for let mut i: u32 = 0; i != NumDefs; i += 1 {
        let mut VT: MVT = N.getSimpleValueType(i);
        if !N.hasAnyUseOfValue(i) {
            continue;
        }
        let mut RCId: u32 = self.TLI.getRepRegClassFor(VT).getID();
        if self.RegPressure[RCId] >= self.RegLimit[RCId] {
            return true;
        }
    }
    return false;
}

fn RegReductionPQBase::RegPressureDiff(self: *RegReductionPQBase, SU: *mut SUnit, LiveUses: *mut u32) -> i32 {
    LiveUses = 0;
    let mut PDiff: i32 = 0;
    for Pred in SU.Preds {
        if Pred.isCtrl() {
            continue;
        }
        let mut PredSU: *mut SUnit = Pred.getSUnit();
        if PredSU.NumRegDefsLeft == 0 {
            if PredSU.getNode().isMachineOpcode() {
                LiveUses += 1;
            }
            continue;
        }
        for let mut RegDefPos: RegDefIter = RegDefIter { PredSU, self.scheduleDAG }; RegDefPos.IsValid(); RegDefPos.Advance() {
            let mut VT: MVT = RegDefPos.GetValue();
            let mut RCId: u32 = self.TLI.getRepRegClassFor(VT).getID();
            if self.RegPressure[RCId] >= self.RegLimit[RCId] {
                PDiff += 1;
            }
        }
    }
    let mut N: *SDNode = SU.getNode();
    if !N || !N.isMachineOpcode() || !SU.NumSuccs {
        return PDiff;
    }
    let mut NumDefs: u32 = self.TII.get(N.getMachineOpcode()).getNumDefs();
    for let mut i: u32 = 0; i != NumDefs; i += 1 {
        let mut VT: MVT = N.getSimpleValueType(i);
        if !N.hasAnyUseOfValue(i) {
            continue;
        }
        let mut RCId: u32 = self.TLI.getRepRegClassFor(VT).getID();
        if self.RegPressure[RCId] >= self.RegLimit[RCId] {
            PDiff -= 1;
        }
    }
    return PDiff;
}

fn RegReductionPQBase::scheduledNode(self, SU: *mut SUnit) {
    if !self.TracksRegPressure {
        return;
    }
    if !SU.getNode() {
        return;
    }
    for Pred in SU.Preds {
        if Pred.isCtrl() {
            continue;
        }
        let mut PredSU: *mut SUnit = Pred.getSUnit();
        if PredSU.NumRegDefsLeft == 0 {
            continue;
        }
        PredSU.NumRegDefsLeft -= 1;
        let mut SkipRegDefs: u32 = PredSU.NumRegDefsLeft;
        for let mut RegDefPos: RegDefIter = RegDefIter { PredSU, self.scheduleDAG }; RegDefPos.IsValid(); RegDefPos.Advance() , SkipRegDefs -= 1 {
            if SkipRegDefs {
                continue;
            }
            let mut RCId: u32 = 0;
            let mut Cost: u32 = 0;
            GetCostForDef(RegDefPos, self.TLI, self.TII, self.TRI, RCId, Cost, self.MF);
            self.RegPressure[RCId] += Cost;
            break;
        }
    }
    let mut SkipRegDefs: i32 = SU.NumRegDefsLeft as i32;
    for let mut RegDefPos: RegDefIter = RegDefIter { SU, self.scheduleDAG }; RegDefPos.IsValid(); RegDefPos.Advance() , SkipRegDefs -= 1 {
        if SkipRegDefs > 0 {
            continue;
        }
        let mut RCId: u32 = 0;
        let mut Cost: u32 = 0;
        GetCostForDef(RegDefPos, self.TLI, self.TII, self.TRI, RCId, Cost, self.MF);
        if self.RegPressure[RCId] < Cost {
            while true {
                {
                if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                    dbgs() << "  " << *SU << " has too many regdefs\n";
                }
            }
                if !(false) { break; }
            }
            self.RegPressure[RCId] = 0;
        } else {
            self.RegPressure[RCId] -= Cost;
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
            self.dumpRegPressure();
        }
    }
        if !(false) { break; }
    }
}

fn RegReductionPQBase::unscheduledNode(self, SU: *mut SUnit) {
    if !self.TracksRegPressure {
        return;
    }
    let mut N: *SDNode = SU.getNode();
    if !N {
        return;
    }
    if !N.isMachineOpcode() {
        if N.getOpcode() != CopyToReg {
            return;
        }
    } else {
        let mut Opc: u32 = N.getMachineOpcode();
        if Opc == EXTRACT_SUBREG || Opc == INSERT_SUBREG || Opc == SUBREG_TO_REG || Opc == REG_SEQUENCE || Opc == IMPLICIT_DEF {
            return;
        }
    }
    for Pred in SU.Preds {
        if Pred.isCtrl() {
            continue;
        }
        let mut PredSU: *mut SUnit = Pred.getSUnit();
        if PredSU.NumSuccsLeft != PredSU.Succs.len {
            continue;
        }
        let mut PN: *SDNode = PredSU.getNode();
        if !PN.isMachineOpcode() {
            if PN.getOpcode() == CopyFromReg {
                let mut VT: MVT = PN.getSimpleValueType(0);
                let mut RCId: u32 = self.TLI.getRepRegClassFor(VT).getID();
                self.RegPressure[RCId] += self.TLI.getRepRegClassCostFor(VT);
            }
            continue;
        }
        let mut POpc: u32 = PN.getMachineOpcode();
        if POpc == IMPLICIT_DEF {
            continue;
        }
        if POpc == EXTRACT_SUBREG || POpc == INSERT_SUBREG || POpc == SUBREG_TO_REG {
            let mut VT: MVT = PN.getSimpleValueType(0);
            let mut RCId: u32 = self.TLI.getRepRegClassFor(VT).getID();
            self.RegPressure[RCId] += self.TLI.getRepRegClassCostFor(VT);
            continue;
        }
        if POpc == REG_SEQUENCE {
            let mut DstRCIdx: u32 = PN.getConstantOperandVal(0);
            let mut RC: *TargetRegisterClass = self.TRI.getRegClass(DstRCIdx);
            let mut RCId: u32 = RC.getID();
            self.RegPressure[RCId] += RegSequenceCost;
            continue;
        }
        let mut NumDefs: u32 = self.TII.get(PN.getMachineOpcode()).getNumDefs();
        for let mut i: u32 = 0; i != NumDefs; i += 1 {
            let mut VT: MVT = PN.getSimpleValueType(i);
            if !PN.hasAnyUseOfValue(i) {
                continue;
            }
            let mut RCId: u32 = self.TLI.getRepRegClassFor(VT).getID();
            if self.RegPressure[RCId] < self.TLI.getRepRegClassCostFor(VT) {
                self.RegPressure[RCId] = 0;
            } else {
                self.RegPressure[RCId] -= self.TLI.getRepRegClassCostFor(VT);
            }
        }
    }
    if SU.NumSuccs && N.isMachineOpcode() {
        let mut NumDefs: u32 = self.TII.get(N.getMachineOpcode()).getNumDefs();
        for let mut i: u32 = NumDefs;
let mut e: u32 = N.getNumValues(); i != e; i += 1 {
            let mut VT: MVT = N.getSimpleValueType(i);
            if VT == Glue || VT == Other {
                continue;
            }
            if !N.hasAnyUseOfValue(i) {
                continue;
            }
            let mut RCId: u32 = self.TLI.getRepRegClassFor(VT).getID();
            self.RegPressure[RCId] += self.TLI.getRepRegClassCostFor(VT);
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
            self.dumpRegPressure();
        }
    }
        if !(false) { break; }
    }
}

fn closestSucc(SU: *SUnit) -> u32 {
    let mut MaxHeight: u32 = 0;
    for Succ in SU.Succs {
        if Succ.isCtrl() {
            continue;
        }
        let mut Height: u32 = Succ.getSUnit().getHeight();
        if Succ.getSUnit().getNode() && Succ.getSUnit().getNode().getOpcode() == CopyToReg {
            Height = closestSucc(Succ.getSUnit()) + 1;
        }
        if Height > MaxHeight {
            MaxHeight = Height;
        }
    }
    return MaxHeight;
}

fn calcMaxScratches(SU: *SUnit) -> u32 {
    let mut Scratches: u32 = 0;
    for Pred in SU.Preds {
        if Pred.isCtrl() {
            continue;
        }
        Scratches += 1;
    }
    return Scratches;
}

fn hasOnlyLiveInOpers(SU: *SUnit) -> bool {
    let mut RetVal: bool = false;
    for Pred in SU.Preds {
        if Pred.isCtrl() {
            continue;
        }
        let mut PredSU: *SUnit = Pred.getSUnit();
        if PredSU.getNode() && PredSU.getNode().getOpcode() == CopyFromReg {
            let mut Reg: Register = cast(PredSU.getNode().getOperand(1)).getReg();
            if Reg.isVirtual() {
                RetVal = true;
                continue;
            }
        }
        return false;
    }
    return RetVal;
}

fn hasOnlyLiveOutUses(SU: *SUnit) -> bool {
    let mut RetVal: bool = false;
    for Succ in SU.Succs {
        if Succ.isCtrl() {
            continue;
        }
        let mut SuccSU: *SUnit = Succ.getSUnit();
        if SuccSU.getNode() && SuccSU.getNode().getOpcode() == CopyToReg {
            let mut Reg: Register = cast(SuccSU.getNode().getOperand(1)).getReg();
            if Reg.isVirtual() {
                RetVal = true;
                continue;
            }
        }
        return false;
    }
    return RetVal;
}

fn initVRegCycle(SU: *mut SUnit) {
    if DisableSchedVRegCycle {
        return;
    }
    if !hasOnlyLiveInOpers(SU) || !hasOnlyLiveOutUses(SU) {
        return;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
            dbgs() << "VRegCycle: " << *SU << "\n";
        }
    }
        if !(false) { break; }
    }
    SU.isVRegCycle = true;
    for Pred in SU.Preds {
        if Pred.isCtrl() {
            continue;
        }
        Pred.getSUnit().isVRegCycle = true;
    }
}

fn resetVRegCycle(SU: *mut SUnit) {
    if !SU.isVRegCycle {
        return;
    }
    for Pred in SU.Preds {
        if Pred.isCtrl() {
            continue;
        }
        let mut PredSU: *mut SUnit = Pred.getSUnit();
        if PredSU.isVRegCycle {
            assert!(PredSU.getNode().getOpcode() == CopyFromReg, "VRegCycle def must be CopyFromReg");
            Pred.getSUnit().isVRegCycle = false;
        }
    }
}

fn hasVRegCycleUse(SU: *SUnit) -> bool {
    if SU.isVRegCycle {
        return false;
    }
    for Pred in SU.Preds {
        if Pred.isCtrl() {
            continue;
        }
        if Pred.getSUnit().isVRegCycle && Pred.getSUnit().getNode().getOpcode() == CopyFromReg {
            while true {
                {
                if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                    dbgs() << "  VReg cycle use: SU (" << SU.NodeNum << ")\n";
                }
            }
                if !(false) { break; }
            }
            return true;
        }
    }
    return false;
}

fn BUHasStall(SU: *mut SUnit, Height: i32, SPQ: *mut RegReductionPQBase) -> bool {
    if SPQ.getCurCycle() as i32 < Height {
        return true;
    }
    if SPQ.getHazardRec().getHazardType(SU, 0) != NoHazard {
        return true;
    }
    return false;
}

fn BUCompareLatency(left: *mut SUnit, right: *mut SUnit, checkPref: bool, SPQ: *mut RegReductionPQBase) -> i32 {
    let mut LPenalty: i32 = if hasVRegCycleUse(left) { 1 } else { 0 };
    let mut RPenalty: i32 = if hasVRegCycleUse(right) { 1 } else { 0 };
    let mut LHeight: i32 = left.getHeight() as i32 + LPenalty;
    let mut RHeight: i32 = right.getHeight() as i32 + RPenalty;
    let mut LStall: bool = (!checkPref || left.SchedulingPref == ILP) && BUHasStall(left, LHeight, SPQ);
    let mut RStall: bool = (!checkPref || right.SchedulingPref == ILP) && BUHasStall(right, RHeight, SPQ);
    if LStall {
        if !RStall {
            return 1;
        }
        if LHeight != RHeight {
            return if LHeight > RHeight { 1 } else { -1 };
        }
    } else if RStall {
        return -1;
    }
    if !checkPref || (left.SchedulingPref == ILP || right.SchedulingPref == ILP) {
        if !SPQ.getHazardRec().isEnabled() {
            if LHeight != RHeight {
                return if LHeight > RHeight { 1 } else { -1 };
            }
        }
        let mut LDepth: i32 = left.getDepth() - LPenalty;
        let mut RDepth: i32 = right.getDepth() - RPenalty;
        if LDepth != RDepth {
            while true {
                {
                if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                    dbgs() << "  Comparing latency of SU (" << left.NodeNum << ") depth " << LDepth << " vs SU (" << right.NodeNum << ") depth " << RDepth << "\n";
                }
            }
                if !(false) { break; }
            }
            return if LDepth < RDepth { 1 } else { -1 };
        }
        if left.Latency != right.Latency {
            return if left.Latency > right.Latency { 1 } else { -1 };
        }
    }
    return 0;
}

fn BURRSort(left: *mut SUnit, right: *mut SUnit, SPQ: *mut RegReductionPQBase) -> bool {
    if !DisableSchedPhysRegJoin {
        let mut LHasPhysReg: bool = left.hasPhysRegDefs;
        let mut RHasPhysReg: bool = right.hasPhysRegDefs;
        if LHasPhysReg != RHasPhysReg {
            let mut PhysRegMsg: [2]char *const = [" has no physreg", " defines a physreg"];
            while true {
                {
                if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                    dbgs() << "  SU (" << left.NodeNum << ") " << PhysRegMsg[LHasPhysReg] << " " << *right << " " << PhysRegMsg[RHasPhysReg] << "\n";
                }
            }
                if !(false) { break; }
            }
            return LHasPhysReg < RHasPhysReg;
        }
    }
    let mut LPriority: u32 = SPQ.getNodePriority(left);
    let mut RPriority: u32 = SPQ.getNodePriority(right);
    if left.isCall && right.isCallOp {
        let mut RNumVals: u32 = right.getNode().getNumValues();
        RPriority = if (RPriority > RNumVals) { (RPriority - RNumVals) } else { 0 };
    }
    if right.isCall && left.isCallOp {
        let mut LNumVals: u32 = left.getNode().getNumValues();
        LPriority = if (LPriority > LNumVals) { (LPriority - LNumVals) } else { 0 };
    }
    if LPriority != RPriority {
        return LPriority > RPriority;
    }
    if left.isCall || right.isCall {
        let mut LOrder: u32 = SPQ.getNodeOrdering(left);
        let mut ROrder: u32 = SPQ.getNodeOrdering(right);
        if (LOrder || ROrder) && LOrder != ROrder {
            return LOrder != 0 && (LOrder < ROrder || ROrder == 0);
        }
    }
    let mut LDist: u32 = closestSucc(left);
    let mut RDist: u32 = closestSucc(right);
    if LDist != RDist {
        return LDist < RDist;
    }
    let mut LScratch: u32 = calcMaxScratches(left);
    let mut RScratch: u32 = calcMaxScratches(right);
    if LScratch != RScratch {
        return LScratch > RScratch;
    }
    if (left.isCall && RPriority > 0) || (right.isCall && LPriority > 0) {
        return (left.NodeQueueId > right.NodeQueueId);
    }
    if !DisableSchedCycles && !(left.isCall || right.isCall) {
        let mut result: i32 = BUCompareLatency(left, right, false, SPQ);
        if result != 0 {
            return result > 0;
        }
    } else {
        if left.getHeight() != right.getHeight() {
            return left.getHeight() > right.getHeight();
        }
        if left.getDepth() != right.getDepth() {
            return left.getDepth() < right.getDepth();
        }
    }
    assert!(left.NodeQueueId && right.NodeQueueId, "NodeQueueId cannot be zero");
    return (left.NodeQueueId > right.NodeQueueId);
}

fn bu_ls_rr_sort::operator()(self: *bu_ls_rr_sort, left: *mut SUnit, right: *mut SUnit) -> bool {
    if checkSpecialNodes(left, right) {
        res;
    } else {
        return res > 0;
    }
    return BURRSort(left, right, self.SPQ);
}

fn src_ls_rr_sort::operator()(self: *src_ls_rr_sort, left: *mut SUnit, right: *mut SUnit) -> bool {
    if checkSpecialNodes(left, right) {
        res;
    } else {
        return res > 0;
    }
    let mut LOrder: u32 = self.SPQ.getNodeOrdering(left);
    let mut ROrder: u32 = self.SPQ.getNodeOrdering(right);
    if (LOrder || ROrder) && LOrder != ROrder {
        return LOrder != 0 && (LOrder < ROrder || ROrder == 0);
    }
    return BURRSort(left, right, self.SPQ);
}

fn hybrid_ls_rr_sort::isReady(self: *hybrid_ls_rr_sort, SU: *mut SUnit, CurCycle: u32) -> bool {
    let mut ReadyDelay: u32 = 3;
    if self.SPQ.MayReduceRegPressure(SU) {
        return true;
    }
    if SU.getHeight() > (CurCycle + ReadyDelay) {
        return false;
    }
    if self.SPQ.getHazardRec().getHazardType(SU, -ReadyDelay) != NoHazard {
        return false;
    }
    return true;
}

fn hybrid_ls_rr_sort::operator()(self: *hybrid_ls_rr_sort, left: *mut SUnit, right: *mut SUnit) -> bool {
    if checkSpecialNodes(left, right) {
        res;
    } else {
        return res > 0;
    }
    if left.isCall || right.isCall {
        return BURRSort(left, right, self.SPQ);
    }
    let mut LHigh: bool = self.SPQ.HighRegPressure(left);
    let mut RHigh: bool = self.SPQ.HighRegPressure(right);
    if LHigh && !RHigh {
        while true {
            {
            if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                dbgs() << "  pressure " << *left << " > " << *right << "\n";
            }
        }
            if !(false) { break; }
        }
        return true;
    } else if !LHigh && RHigh {
        while true {
            {
            if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                dbgs() << "  pressure " << *right << " > " << *left << "\n";
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    if !LHigh && !RHigh {
        let mut result: i32 = BUCompareLatency(left, right, true, self.SPQ);
        if result != 0 {
            return result > 0;
        }
    }
    return BURRSort(left, right, self.SPQ);
}

fn ilp_ls_rr_sort::isReady(self: *ilp_ls_rr_sort, SU: *mut SUnit, CurCycle: u32) -> bool {
    if SU.getHeight() > CurCycle {
        return false;
    }
    if self.SPQ.getHazardRec().getHazardType(SU, 0) != NoHazard {
        return false;
    }
    return true;
}

fn canEnableCoalescing(SU: *mut SUnit) -> bool {
    let mut Opc: u32 = if SU.getNode() { SU.getNode().getOpcode() } else { 0 };
    if Opc == TokenFactor || Opc == CopyToReg {
        return true;
    }
    if Opc == EXTRACT_SUBREG || Opc == SUBREG_TO_REG || Opc == INSERT_SUBREG {
        return true;
    }
    if SU.NumPreds == 0 && SU.NumSuccs != 0 {
        return true;
    }
    return false;
}

fn ilp_ls_rr_sort::operator()(self: *ilp_ls_rr_sort, left: *mut SUnit, right: *mut SUnit) -> bool {
    if checkSpecialNodes(left, right) {
        res;
    } else {
        return res > 0;
    }
    if left.isCall || right.isCall {
        return BURRSort(left, right, self.SPQ);
    }
    let mut LLiveUses: u32 = 0;
    let mut RLiveUses: u32 = 0;
    let mut LPDiff: i32 = 0;
    let mut RPDiff: i32 = 0;
    if !DisableSchedRegPressure || !DisableSchedLiveUses {
        LPDiff = self.SPQ.RegPressureDiff(left, LLiveUses);
        RPDiff = self.SPQ.RegPressureDiff(right, RLiveUses);
    }
    if !DisableSchedRegPressure && LPDiff != RPDiff {
        while true {
            {
            if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                dbgs() << "RegPressureDiff " << *left << ": " << LPDiff << " != " << *right << ": " << RPDiff << "\n";
            }
        }
            if !(false) { break; }
        }
        return LPDiff > RPDiff;
    }
    if !DisableSchedRegPressure && (LPDiff > 0 || RPDiff > 0) {
        let mut LReduce: bool = canEnableCoalescing(left);
        let mut RReduce: bool = canEnableCoalescing(right);
        if LReduce && !RReduce {
            return false;
        }
        if RReduce && !LReduce {
            return true;
        }
    }
    if !DisableSchedLiveUses && (LLiveUses != RLiveUses) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                dbgs() << "Live uses " << *left << ": " << LLiveUses << " != " << *right << ": " << RLiveUses << "\n";
            }
        }
            if !(false) { break; }
        }
        return LLiveUses < RLiveUses;
    }
    if !DisableSchedStalls {
        let mut LStall: bool = BUHasStall(left, left.getHeight(), self.SPQ);
        let mut RStall: bool = BUHasStall(right, right.getHeight(), self.SPQ);
        if LStall != RStall {
            return left.getHeight() > right.getHeight();
        }
    }
    if !DisableSchedCriticalPath {
        let mut spread: i32 = left.getDepth() as i32 - right.getDepth() as i32;
        if if spread < 0 { -spread } else { spread } > MaxReorderWindow.operator int() {
            while true {
                {
                if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                    dbgs() << "Depth of " << *left << ": " << left.getDepth() << " != " << *right << ": " << right.getDepth() << "\n";
                }
            }
                if !(false) { break; }
            }
            return left.getDepth() < right.getDepth();
        }
    }
    if !DisableSchedHeight && left.getHeight() != right.getHeight() {
        let mut spread: i32 = left.getHeight() as i32 - right.getHeight() as i32;
        if if spread < 0 { -spread } else { spread } > MaxReorderWindow.operator int() {
            return left.getHeight() > right.getHeight();
        }
    }
    return BURRSort(left, right, self.SPQ);
}

fn RegReductionPQBase::initNodes(self, sunits: *mut []SUnit) {
    self.SUnits = &mut sunits;
    if !Disable2AddrHack {
        self.AddPseudoTwoAddrDeps();
    }
    if !self.TracksRegPressure && !self.SrcOrder {
        self.PrescheduleNodesWithMultipleUses();
    }
    self.CalculateSethiUllmanNumbers();
    if self.scheduleDAG.BB.isSuccessor(self.scheduleDAG.BB) {
        for SU in sunits {
            initVRegCycle(&mut SU);
        }
    }
}

fn RegReductionPQBase::canClobber(self, SU: *SUnit, Op: *SUnit) -> bool {
    if SU.isTwoAddress {
        let mut Opc: u32 = SU.getNode().getMachineOpcode();
        let mut MCID: *MCInstrDesc = self.TII.get(Opc);
        let mut NumRes: u32 = MCID.getNumDefs();
        let mut NumOps: u32 = MCID.getNumOperands() - NumRes;
        for let mut i: u32 = 0; i != NumOps; i += 1 {
            if MCID.getOperandConstraint(i + NumRes, TIED_TO) != -1 {
                let mut DU: *mut SDNode = SU.getNode().getOperand(i).getNode();
                if DU.getNodeId() != -1 && Op.OrigNode == &mut (*self.SUnits)[DU.getNodeId()] {
                    return true;
                }
            }
        }
    }
    return false;
}

fn canClobberReachingPhysRegUse(DepSU: *SUnit, SU: *SUnit, scheduleDAG: *mut ScheduleDAGRRList, TII: *TargetInstrInfo, TRI: *TargetRegisterInfo) -> bool {
    let mut ImpDefs: ArrayRef<MCPhysReg> = TII.get(SU.getNode().getMachineOpcode()).implicit_defs();
    let mut RegMask: *u32 = getNodeRegMask(SU.getNode());
    if ImpDefs.len == 0 && !RegMask {
        return false;
    }
    for Succ in SU.Succs {
        let mut SuccSU: *mut SUnit = Succ.getSUnit();
        for SuccPred in SuccSU.Preds {
            if !SuccPred.isAssignedRegDep() {
                continue;
            }
            if RegMask && clobbersPhysReg(RegMask, SuccPred.getReg().operator MCRegister()) && scheduleDAG.IsReachable(DepSU, SuccPred.getSUnit()) {
                return true;
            }
            for ImpDef in ImpDefs {
                if TRI.regsOverlap(Register { Reg: ImpDef }, SuccPred.getReg()) && scheduleDAG.IsReachable(DepSU, SuccPred.getSUnit()) {
                    return true;
                }
            }
        }
    }
    return false;
}

fn canClobberPhysRegDefs(SuccSU: *SUnit, SU: *SUnit, TII: *TargetInstrInfo, TRI: *TargetRegisterInfo) -> bool {
    let mut N: *mut SDNode = SuccSU.getNode();
    let mut NumDefs: u32 = TII.get(N.getMachineOpcode()).getNumDefs();
    let mut ImpDefs: ArrayRef<MCPhysReg> = TII.get(N.getMachineOpcode()).implicit_defs();
    assert!(!ImpDefs.is_empty(), "Caller should check hasPhysRegDefs");
    for let mut SUNode: *SDNode = SU.getNode(); SUNode; SUNode = SUNode.getGluedNode() {
        if !SUNode.isMachineOpcode() {
            continue;
        }
        let mut SUImpDefs: ArrayRef<MCPhysReg> = TII.get(SUNode.getMachineOpcode()).implicit_defs();
        let mut SURegMask: *u32 = getNodeRegMask(SUNode);
        if SUImpDefs.len == 0 && !SURegMask {
            continue;
        }
        for let mut i: u32 = NumDefs;
let mut e: u32 = N.getNumValues(); i != e; i += 1 {
            let mut VT: MVT = N.getSimpleValueType(i);
            if VT == Glue || VT == Other {
                continue;
            }
            if !N.hasAnyUseOfValue(i) {
                continue;
            }
            let mut Reg: MCPhysReg = ImpDefs[i - NumDefs];
            if SURegMask && clobbersPhysReg(SURegMask, MCRegister { Reg: Reg }) {
                return true;
            }
            for SUReg in SUImpDefs {
                if TRI.regsOverlap(Register { Reg: Reg }, Register { Reg: SUReg }) {
                    return true;
                }
            }
        }
    }
    return false;
}

fn RegReductionPQBase::PrescheduleNodesWithMultipleUses(self) {
    for SU in *self.SUnits {
        if SU.NumSuccs != 0 {
            continue;
        }
        if SU.NumPreds != 1 {
            continue;
        }
        if SU.getNode() {
            N;
        } else if N.getOpcode() == CopyToReg && cast(N.getOperand(1)).getReg().isVirtual() {
            continue;
        }
        let mut PredFrameSetup: *mut SDNode = null;
        for Pred in SU.Preds {
            if Pred.isCtrl() && Pred.getSUnit() {
                let mut PredND: *mut SDNode = Pred.getSUnit().getNode();
                if PredND && PredND.isMachineOpcode() && (PredND.getMachineOpcode() == self.TII.getCallFrameSetupOpcode()) {
                    PredFrameSetup = PredND;
                    break;
                }
            }
        }
        if PredFrameSetup != null {
            continue;
        }
        let mut PredSU: *mut SUnit = null;
        for Pred in SU.Preds {
            if !Pred.isCtrl() {
                PredSU = Pred.getSUnit();
                break;
            }
        }
        assert!(PredSU);
        if PredSU.hasPhysRegDefs {
            continue;
        }
        if PredSU.NumSuccs == 1 {
            continue;
        }
        if SU.getNode() {
            N;
        } else if N.getOpcode() == CopyFromReg && cast(N.getOperand(1)).getReg().isVirtual() {
            continue;
        }
        for PredSucc in PredSU.Succs {
            let mut PredSuccSU: *mut SUnit = PredSucc.getSUnit();
            if PredSuccSU == &mut SU {
                continue;
            }
            if PredSuccSU.NumSuccs == 0 {
                
            }
            if SU.hasPhysRegClobbers && PredSuccSU.hasPhysRegDefs {
                if canClobberPhysRegDefs(PredSuccSU, &mut SU, self.TII, self.TRI) {
                    
                }
            }
            if self.scheduleDAG.IsReachable(&mut SU, PredSuccSU) {
                
            }
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                dbgs() << "    Prescheduling SU #" << SU.NodeNum << " next to PredSU #" << PredSU.NodeNum << " to guide scheduling in the presence of multiple uses\n";
            }
        }
            if !(false) { break; }
        }
        for let mut i: u32 = 0; i != PredSU.Succs.len; i += 1 {
            let mut Edge: SDep = PredSU.Succs[i];
            assert!(!Edge.isAssignedRegDep());
            let mut SuccSU: *mut SUnit = Edge.getSUnit();
            if SuccSU != &mut SU {
                Edge.setSUnit(PredSU);
                self.scheduleDAG.RemovePred(SuccSU, Edge);
                self.scheduleDAG.AddPredQueued(&mut SU, Edge);
                Edge.setSUnit(&mut SU);
                self.scheduleDAG.AddPredQueued(SuccSU, Edge);
                i -= 1;
            }
        }
    }
}

fn RegReductionPQBase::AddPseudoTwoAddrDeps(self) {
    for SU in *self.SUnits {
        if !SU.isTwoAddress {
            continue;
        }
        let mut Node: *mut SDNode = SU.getNode();
        if !Node || !Node.isMachineOpcode() || SU.getNode().getGluedNode() {
            continue;
        }
        let mut isLiveOut: bool = hasOnlyLiveOutUses(&mut SU);
        let mut Opc: u32 = Node.getMachineOpcode();
        let mut MCID: *MCInstrDesc = self.TII.get(Opc);
        let mut NumRes: u32 = MCID.getNumDefs();
        let mut NumOps: u32 = MCID.getNumOperands() - NumRes;
        for let mut j: u32 = 0; j != NumOps; j += 1 {
            if MCID.getOperandConstraint(j + NumRes, TIED_TO) == -1 {
                continue;
            }
            let mut DU: *mut SDNode = SU.getNode().getOperand(j).getNode();
            if DU.getNodeId() == -1 {
                continue;
            }
            let mut DUSU: *SUnit = &mut (*self.SUnits)[DU.getNodeId()];
            if !DUSU {
                continue;
            }
            for Succ in DUSU.Succs {
                if Succ.isCtrl() {
                    continue;
                }
                let mut SuccSU: *mut SUnit = Succ.getSUnit();
                if SuccSU == &mut SU {
                    continue;
                }
                if SuccSU.getHeight() < SU.getHeight() && (SU.getHeight() - SuccSU.getHeight()) > 1 {
                    continue;
                }
                while SuccSU.Succs.len == 1 && SuccSU.getNode().isMachineOpcode() && SuccSU.getNode().getMachineOpcode() == COPY_TO_REGCLASS {
                    SuccSU = SuccSU.Succs.front().getSUnit();
                }
                if !SuccSU.getNode() || !SuccSU.getNode().isMachineOpcode() {
                    continue;
                }
                if SuccSU.hasPhysRegDefs && SU.hasPhysRegClobbers {
                    if canClobberPhysRegDefs(SuccSU, &mut SU, self.TII, self.TRI) {
                        continue;
                    }
                }
                let mut SuccOpc: u32 = SuccSU.getNode().getMachineOpcode();
                if SuccOpc == EXTRACT_SUBREG || SuccOpc == INSERT_SUBREG || SuccOpc == SUBREG_TO_REG {
                    continue;
                }
                if !canClobberReachingPhysRegUse(SuccSU, &mut SU, self.scheduleDAG, self.TII, self.TRI) && (!self.canClobber(SuccSU, DUSU) || (isLiveOut && !hasOnlyLiveOutUses(SuccSU)) || (!SU.isCommutable && SuccSU.isCommutable)) && !self.scheduleDAG.IsReachable(SuccSU, &mut SU) {
                    while true {
                        {
                        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                            dbgs() << "    Adding a pseudo-two-addr edge from SU #" << SU.NodeNum << " to SU #" << SuccSU.NodeNum << "\n";
                        }
                    }
                        if !(false) { break; }
                    }
                    self.scheduleDAG.AddPredQueued(&mut SU, SDep { SuccSU, Artificial });
                }
            }
        }
    }
}

fn createBURRListDAGScheduler(IS: *mut SelectionDAGISel, OptLevel: CodeGenOptLevel) -> *mut ScheduleDAGSDNodes {
    let mut STI: *TargetSubtargetInfo = IS.MF.getSubtarget();
    let mut TII: *TargetInstrInfo = STI.getInstrInfo();
    let mut TRI: *TargetRegisterInfo = STI.getRegisterInfo();
    let mut PQ: *mut BURegReductionPriorityQueue = BURegReductionPriorityQueue { *IS.MF, false, false, TII, TRI, null };
    let mut SD: *mut ScheduleDAGRRList = ScheduleDAGRRList { *IS.MF, false, PQ, OptLevel };
    PQ.setScheduleDAG(SD);
    return SD;
}

fn createSourceListDAGScheduler(IS: *mut SelectionDAGISel, OptLevel: CodeGenOptLevel) -> *mut ScheduleDAGSDNodes {
    let mut STI: *TargetSubtargetInfo = IS.MF.getSubtarget();
    let mut TII: *TargetInstrInfo = STI.getInstrInfo();
    let mut TRI: *TargetRegisterInfo = STI.getRegisterInfo();
    let mut PQ: *mut SrcRegReductionPriorityQueue = SrcRegReductionPriorityQueue { *IS.MF, false, true, TII, TRI, null };
    let mut SD: *mut ScheduleDAGRRList = ScheduleDAGRRList { *IS.MF, false, PQ, OptLevel };
    PQ.setScheduleDAG(SD);
    return SD;
}

fn createHybridListDAGScheduler(IS: *mut SelectionDAGISel, OptLevel: CodeGenOptLevel) -> *mut ScheduleDAGSDNodes {
    let mut STI: *TargetSubtargetInfo = IS.MF.getSubtarget();
    let mut TII: *TargetInstrInfo = STI.getInstrInfo();
    let mut TRI: *TargetRegisterInfo = STI.getRegisterInfo();
    let mut TLI: *TargetLowering = IS.TLI;
    let mut PQ: *mut HybridBURRPriorityQueue = HybridBURRPriorityQueue { *IS.MF, true, false, TII, TRI, TLI };
    let mut SD: *mut ScheduleDAGRRList = ScheduleDAGRRList { *IS.MF, true, PQ, OptLevel };
    PQ.setScheduleDAG(SD);
    return SD;
}

fn createILPListDAGScheduler(IS: *mut SelectionDAGISel, OptLevel: CodeGenOptLevel) -> *mut ScheduleDAGSDNodes {
    let mut STI: *TargetSubtargetInfo = IS.MF.getSubtarget();
    let mut TII: *TargetInstrInfo = STI.getInstrInfo();
    let mut TRI: *TargetRegisterInfo = STI.getRegisterInfo();
    let mut TLI: *TargetLowering = IS.TLI;
    let mut PQ: *mut ILPBURRPriorityQueue = ILPBURRPriorityQueue { *IS.MF, true, false, TII, TRI, TLI };
    let mut SD: *mut ScheduleDAGRRList = ScheduleDAGRRList { *IS.MF, true, PQ, OptLevel };
    PQ.setScheduleDAG(SD);
    return SD;
}

struct Closure_1 {
    CurSU: *mut *mut SUnit,
    cap_1: *mut ScheduleDAGRRList,
}

unsafe fn Closure_1::call(self: *mut Closure_1) {
        while (*self.CurSU) {
            let mut LRegs: SmallVector<unsigned int, 4> = SmallVector<unsigned int, 4> {};
            if !self.DelayForLiveRegsBottomUp((*self.CurSU), LRegs) {
                break;
            }
            while true {
                {
                if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                    dbgs() << "    Interfering reg ";
                    if LRegs[0] == self.TRI.getNumRegs() {
                        dbgs() << "CallResource";
                    } else {
                        dbgs() << printReg(Register { Reg: LRegs[0] }, self.TRI, 0, null);
                    }
                    dbgs() << " SU #" << (*self.CurSU).NodeNum << 10;
                }
            }
                if !(false) { break; }
            }
            if LRegsInserted {
                (*self.CurSU).isPending = true;
                self.Interferences.push((*self.CurSU));
            } else {
                assert!((*self.CurSU).isPending, "Interferences are pending");
                operator(LRegsIter).second = LRegs;
            }
            (*self.CurSU) = self.AvailableQueue.pop();
        }
    }
