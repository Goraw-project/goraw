fn SelectionDAG::transferDbgValues(self, From: SDValue, To: SDValue, OffsetInBits: u32, SizeInBits: u32, InvalidateDbg: bool) {
    let mut FromNode: *mut SDNode = From.getNode();
    let mut ToNode: *mut SDNode = To.getNode();
    assert!(FromNode && ToNode, "Can't modify dbg values");
    if From == To || FromNode == ToNode {
        return;
    }
    if !FromNode.getHasDebugValue() {
        return;
    }
    let mut FromLocOp: SDDbgOperand = fromNode(From.getNode(), From.getResNo());
    let mut ToLocOp: SDDbgOperand = fromNode(To.getNode(), To.getResNo());
    let mut ClonedDVs: SmallVector<SDDbgValue *, 2> = SmallVector<SDDbgValue *, 2> {};
    for Dbg in self.GetDbgValues(FromNode) {
        if Dbg.isInvalidated() {
            continue;
        }
        let mut Changed: bool = false;
        let mut NewLocOps: SmallVector<SDDbgOperand> = Dbg.copyLocationOps();
        replace_if(NewLocOps.begin(), NewLocOps.end(), Closure_20 { Changed: &mut Changed, cap_1: FromLocOp }, ToLocOp);
        if !Changed {
            continue;
        }
        let mut Var: *mut DIVariable = Dbg.getVariable();
        let mut Expr: *mut DIExpression = Dbg.getExpression();
        if SizeInBits {
            if Expr.getFragmentInfo() {
                FI;
            } else if OffsetInBits + SizeInBits > operator(FI).SizeInBits {
                continue;
            }
            let mut Fragment: optional<DIExpression *> = createFragmentExpression(Expr, OffsetInBits, SizeInBits);
            if !Fragment {
                continue;
            }
            Expr = operator(Fragment);
        }
        let mut AdditionalDependencies: ArrayRef<SDNode *> = Dbg.getAdditionalDependencies();
        let mut Clone: *mut SDDbgValue = self.getDbgValueList(Var, Expr, ArrayRef<SDDbgOperand> { NewLocOps }, ArrayRef<SDNode *> { AdditionalDependencies }, Dbg.isIndirect(), Dbg.getDebugLoc(), if ToNode.getIROrder() > Dbg.getOrder() { ToNode.getIROrder() } else { Dbg.getOrder() }, Dbg.isVariadic());
        ClonedDVs.push(Clone);
        if InvalidateDbg {
            Dbg.setIsInvalidated();
            Dbg.setIsEmitted();
        }
    }
    for Dbg in ClonedDVs {
        assert!(is_contained(Dbg.getSDNodes(), ToNode), "Transferred DbgValues should depend on the new SDNode");
        self.AddDbgValue(Dbg, false);
    }
}

fn SelectionDAG::salvageDebugInfo(self, N: *mut SDNode) {
    if !N.getHasDebugValue() {
        return;
    }
    let mut GetLocationOperand: Closure_21 = Closure_21 {};
    let mut ClonedDVs: SmallVector<SDDbgValue *, 2> = SmallVector<SDDbgValue *, 2> {};
    for DV in self.GetDbgValues(&mut N) {
        if DV.isInvalidated() {
            continue;
        }
        match N.getOpcode() {
            _ => {
                break;
            },
            ADD => {
                let mut N0: SDValue = N.getOperand(0);
                let mut N1: SDValue = N.getOperand(1);
                if !isa(N0) {
                    let mut RHSConstant: bool = isa(N1);
                    let mut Offset: u64 = 0;
                    if RHSConstant {
                        Offset = N.getConstantOperandVal(1);
                    }
                    if !RHSConstant && DV.isIndirect() {
                        continue;
                    }
                    let mut DIExpr: *mut DIExpression = DV.getExpression();
                    let mut NewLocOps: SmallVector<SDDbgOperand> = DV.copyLocationOps();
                    let mut Changed: bool = false;
                    let mut OrigLocOpsSize: u64 = NewLocOps.len;
                    for let mut i: u64 = 0; i < OrigLocOpsSize; i += 1 {
                        if NewLocOps[i].getKind() != SDNODE || NewLocOps[i].getSDNode() != &mut N {
                            continue;
                        }
                        NewLocOps[i] = GetLocationOperand.call(N0.getNode(), N0.getResNo());
                        if RHSConstant {
                            let mut ExprOps: SmallVector<uint64_t, 3> = SmallVector<uint64_t, 3> {};
                            appendOffset(ExprOps, Offset);
                            DIExpr = appendOpsToArg(DIExpr, ArrayRef<uint64_t> { ExprOps }, i, true);
                        } else {
                            let mut TmpDIExpr: *DIExpression = convertToVariadicExpression(DIExpr);
                            let mut ExprOps: SmallVector<uint64_t, 3> = SmallVector<uint64_t, 3> {};
                            ExprOps.push(DW_OP_LLVM_arg);
                            ExprOps.push(NewLocOps.len);
                            ExprOps.push(DW_OP_plus);
                            let mut RHS: SDDbgOperand = fromNode(N1.getNode(), N1.getResNo());
                            NewLocOps.push(RHS);
                            DIExpr = appendOpsToArg(TmpDIExpr, ArrayRef<uint64_t> { ExprOps }, i, true);
                        }
                        Changed = true;
                    }
                    Changed as void;
                    assert!(Changed, "Salvage target doesn't use N");
                    let mut IsVariadic: bool = DV.isVariadic() || OrigLocOpsSize != NewLocOps.len;
                    let mut AdditionalDependencies: ArrayRef<SDNode *> = DV.getAdditionalDependencies();
                    let mut Clone: *mut SDDbgValue = self.getDbgValueList(DV.getVariable(), DIExpr, ArrayRef<SDDbgOperand> { NewLocOps }, ArrayRef<SDNode *> { AdditionalDependencies }, DV.isIndirect(), DV.getDebugLoc(), DV.getOrder(), IsVariadic);
                    ClonedDVs.push(Clone);
                    DV.setIsInvalidated();
                    DV.setIsEmitted();
                    while true {
                        {
                        if DebugFlag && isCurrentDebugType("selectiondag", 1) {
                            dbgs() << "SALVAGE: Rewriting";
                            N0.getNode().dumprFull(self);
                            dbgs() << " into " << *DIExpr << 10;
                        }
                    }
                        if !(false) { break; }
                    }
                }
                break;
            },
            TRUNCATE => {
                let mut N0: SDValue = N.getOperand(0);
                let mut FromSize: TypeSize = N0.getValueSizeInBits();
                let mut ToSize: TypeSize = N.getValueSizeInBits(0);
                let mut DbgExpression: *mut DIExpression = DV.getExpression();
                let mut ExtOps: ExtOps = getExtOps(FromSize.operator unsigned long long(), ToSize.operator unsigned long long(), false);
                let mut NewLocOps: SmallVector<SDDbgOperand> = DV.copyLocationOps();
                let mut Changed: bool = false;
                for let mut i: u64 = 0; i < NewLocOps.len; i += 1 {
                    if NewLocOps[i].getKind() != SDNODE || NewLocOps[i].getSDNode() != &mut N {
                        continue;
                    }
                    NewLocOps[i] = GetLocationOperand.call(N0.getNode(), N0.getResNo());
                    DbgExpression = appendOpsToArg(DbgExpression, ArrayRef<uint64_t> { ExtOps }, i, false);
                    Changed = true;
                }
                assert!(Changed, "Salvage target doesn't use N");
                Changed as void;
                let mut Clone: *mut SDDbgValue = self.getDbgValueList(DV.getVariable(), DbgExpression, ArrayRef<SDDbgOperand> { NewLocOps }, DV.getAdditionalDependencies(), DV.isIndirect(), DV.getDebugLoc(), DV.getOrder(), DV.isVariadic());
                ClonedDVs.push(Clone);
                DV.setIsInvalidated();
                DV.setIsEmitted();
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("selectiondag", 1) {
                        dbgs() << "SALVAGE: Rewriting";
                        N0.getNode().dumprFull(self);
                        dbgs() << " into " << *DbgExpression << 10;
                    }
                }
                    if !(false) { break; }
                }
                break;
            },
        }
    }
    for Dbg in ClonedDVs {
        assert!((!Dbg.getSDNodes().is_empty() || any_of(Dbg.getLocationOps(), Closure_22 {})), "Salvaged DbgValue should depend on a new SDNode");
        self.AddDbgValue(Dbg, false);
    }
}

fn SelectionDAG::getDbgLabel(self, Label: *mut DILabel, DL: *DebugLoc, O: u32) -> *mut SDDbgLabel {
    assert!(cast(Label).isValidLocationForIntrinsic(DL.operator llvm::DILocation *()), "Expected inlined-at fields to agree");
    return SDDbgLabel { Label: Label, DL: DL, Order: O };
}

struct RAUWUpdateListener {
    UI: *mut use_iterator,
    UE: *mut use_iterator,
}

fn RAUWUpdateListener::NodeDeleted(self, N: *mut SDNode, E: *mut SDNode) {
    while self.UI != self.UE && N == operator(self.UI).getUser() {
        operator(self.UI);
    }
}

fn SelectionDAG::ReplaceAllUsesWith(self, FromN: SDValue, To: SDValue) {
    let mut From: *mut SDNode = FromN.getNode();
    assert!(From.getNumValues() == 1 && FromN.getResNo() == 0, "Cannot replace with this method!");
    assert!(From != To.getNode(), "Cannot replace uses of with self");
    self.transferDbgValues(FromN, To, 0, 0, true);
    self.copyExtraInfo(From, To.getNode());
    let mut UI: use_iterator = From.use_begin();
    let mut UE: use_iterator = From.use_end();
    let mut Listener: RAUWUpdateListener = RAUWUpdateListener { *self, UI, UE };
    while UI != UE {
        let mut User: *mut SDNode = operator(UI).getUser();
        self.RemoveNodeFromCSEMaps(User);
        while true {
            {
            let mut Use: *mut SDUse = operator(UI);
            operator(UI);
            Use.set(To);
            if operator(To).isDivergent() != From.isDivergent() {
                self.updateDivergence(User);
            }
        }
            if !(UI != UE && operator(UI).getUser() == User) { break; }
        }
        self.AddModifiedNodeToCSEMaps(User);
    }
    if FromN == self.getRoot() {
        self.setRoot(To);
    }
}

fn SelectionDAG::ReplaceAllUsesWith(self, From: *mut SDNode, To: *mut SDNode) {
    for let mut i: u32 = 0;
let mut e: u32 = From.getNumValues(); i != e; i += 1 {
        assert!((!From.hasAnyUseOfValue(i) || From.getValueType(i) == To.getValueType(i)), "Cannot use this version of ReplaceAllUsesWith!");
    }
    if From == To {
        return;
    }
    for let mut i: u32 = 0;
let mut e: u32 = From.getNumValues(); i != e; i += 1 {
        if From.hasAnyUseOfValue(i) {
            assert!((i < To.getNumValues()), "Invalid To location");
            self.transferDbgValues(SDValue { Node: From, ResNo: i }, SDValue { Node: To, ResNo: i }, 0, 0, true);
        }
    }
    self.copyExtraInfo(From, To);
    let mut UI: use_iterator = From.use_begin();
    let mut UE: use_iterator = From.use_end();
    let mut Listener: RAUWUpdateListener = RAUWUpdateListener { *self, UI, UE };
    while UI != UE {
        let mut User: *mut SDNode = operator(UI).getUser();
        self.RemoveNodeFromCSEMaps(User);
        while true {
            {
            let mut Use: *mut SDUse = operator(UI);
            operator(UI);
            Use.setNode(To);
            if To.isDivergent() != From.isDivergent() {
                self.updateDivergence(User);
            }
        }
            if !(UI != UE && operator(UI).getUser() == User) { break; }
        }
        self.AddModifiedNodeToCSEMaps(User);
    }
    if From == self.getRoot().getNode() {
        self.setRoot(SDValue { Node: To, ResNo: self.getRoot().getResNo() });
    }
}

fn SelectionDAG::ReplaceAllUsesWith(self, From: *mut SDNode, To: *SDValue) {
    if From.getNumValues() == 1 {
        return self.ReplaceAllUsesWith(SDValue { Node: From, ResNo: 0 }, To[0]);
    }
    for let mut i: u32 = 0;
let mut e: u32 = From.getNumValues(); i != e; i += 1 {
        self.transferDbgValues(SDValue { Node: From, ResNo: i }, To[i], 0, 0, true);
        self.copyExtraInfo(From, To[i].getNode());
    }
    let mut UI: use_iterator = From.use_begin();
    let mut UE: use_iterator = From.use_end();
    let mut Listener: RAUWUpdateListener = RAUWUpdateListener { *self, UI, UE };
    while UI != UE {
        let mut User: *mut SDNode = operator(UI).getUser();
        self.RemoveNodeFromCSEMaps(User);
        let mut To_IsDivergent: bool = false;
        while true {
            {
            let mut Use: *mut SDUse = operator(UI);
            let mut ToOp: *SDValue = To[Use.getResNo()];
            operator(UI);
            Use.set(ToOp);
            if ToOp.getValueType() != EVT { Other } {
                To_IsDivergent |= operator(ToOp).isDivergent();
            }
        }
            if !(UI != UE && operator(UI).getUser() == User) { break; }
        }
        if To_IsDivergent != From.isDivergent() {
            self.updateDivergence(User);
        }
        self.AddModifiedNodeToCSEMaps(User);
    }
    if From == self.getRoot().getNode() {
        self.setRoot(To[self.getRoot().getResNo()]);
    }
}

fn SelectionDAG::ReplaceAllUsesOfValueWith(self, From: SDValue, To: SDValue) {
    if From == To {
        return;
    }
    if From.getNode().getNumValues() == 1 {
        self.ReplaceAllUsesWith(From, To);
        return;
    }
    self.transferDbgValues(From, To, 0, 0, true);
    self.copyExtraInfo(From.getNode(), To.getNode());
    let mut UI: use_iterator = From.getNode().use_begin();
    let mut UE: use_iterator = From.getNode().use_end();
    let mut Listener: RAUWUpdateListener = RAUWUpdateListener { *self, UI, UE };
    while UI != UE {
        let mut User: *mut SDNode = operator(UI).getUser();
        let mut UserRemovedFromCSEMaps: bool = false;
        while true {
            {
            let mut Use: *mut SDUse = operator(UI);
            if Use.getResNo() != From.getResNo() {
                operator(UI);
                continue;
            }
            if !UserRemovedFromCSEMaps {
                self.RemoveNodeFromCSEMaps(User);
                UserRemovedFromCSEMaps = true;
            }
            operator(UI);
            Use.set(To);
            if operator(To).isDivergent() != operator(From).isDivergent() {
                self.updateDivergence(User);
            }
        }
            if !(UI != UE && operator(UI).getUser() == User) { break; }
        }
        if !UserRemovedFromCSEMaps {
            continue;
        }
        self.AddModifiedNodeToCSEMaps(User);
    }
    if From == self.getRoot() {
        self.setRoot(To);
    }
}

struct UseMemo {
    User: *mut SDNode,
    Index: u32,
    Use: *mut SDUse,
}

fn op_lt(L: *UseMemo, R: *UseMemo) -> bool {
    return L.User as i64 < R.User as i64;
}

struct RAUOVWUpdateListener {
    Uses: *mut SmallVectorImpl<UseMemo>,
}

fn RAUOVWUpdateListener::NodeDeleted(self, N: *mut SDNode, E: *mut SDNode) {
    for Memo in self.Uses {
        if Memo.User == N {
            Memo.User = null;
        }
    }
}

fn gluePropagatesDivergence(Node: *SDNode) -> bool {
    match Node.getOpcode() {
        CopyFromReg => {
            CopyToReg;
        },
        _ => {
            return true;
        },
    }
    llvm_unreachable_internal("covered opcode switch", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAG.cpp", 13416);
}

fn SelectionDAG::calculateDivergence(self, N: *mut SDNode) -> bool {
    if self.TLI.isSDNodeAlwaysUniform(N) {
        assert!(!self.TLI.isSDNodeSourceOfDivergence(N, self.FLI, self.UA), "Conflicting divergence information!");
        return false;
    }
    if self.TLI.isSDNodeSourceOfDivergence(N, self.FLI, self.UA) {
        return true;
    }
    for Op in N.ops() {
        let mut VT: EVT = Op.getValueType();
        if VT != EVT { Other } && Op.getNode().isDivergent() && (VT != EVT { Glue } || gluePropagatesDivergence(Op.getNode())) {
            return true;
        }
    }
    return false;
}

fn SelectionDAG::updateDivergence(self, N: *mut SDNode) {
    let mut Worklist: SmallVector<SDNode *, 16> = SmallVector<SDNode *, 16> { 1, N };
    while true {
        {
        N = Worklist.pop_back_val();
        let mut IsDivergent: bool = self.calculateDivergence(N);
        if N..SDNodeBits.IsDivergent != IsDivergent {
            N..SDNodeBits.IsDivergent = IsDivergent;
            append_range(Worklist, N.users());
        }
    }
        if !(!Worklist.is_empty()) { break; }
    }
}

fn SelectionDAG::CreateTopologicalOrder(self, Order: *mut []*mut SDNode) {
    let mut Degree: DenseMap<SDNode *, unsigned int> = DenseMap<SDNode *, unsigned int> {};
    Order.reserve(self.AllNodes.len);
    for N in self.allnodes() {
        let mut NOps: u32 = N.getNumOperands();
        Degree[&mut N] = NOps;
        if 0 == NOps {
            Order.push(&mut N);
        }
    }
    for let mut I: u64 = 0; I != Order.len; I += 1 {
        let mut N: *mut SDNode = Order[I];
        for U in N.users() {
            let mut UnsortedOps: *mut u32 = Degree[U];
            if 0 == UnsortedOps -= 1 {
                Order.push(U);
            }
        }
    }
}

fn SelectionDAG::ReplaceAllUsesOfValuesWith(self, From: *SDValue, To: *SDValue, Num: u32) {
    if Num == 1 {
        return self.ReplaceAllUsesOfValueWith(*From, *To);
    }
    self.transferDbgValues(*From, *To, 0, 0, true);
    self.copyExtraInfo(From.getNode(), To.getNode());
    let mut Uses: SmallVector<UseMemo, 4> = SmallVector<UseMemo, 4> {};
    for let mut i: u32 = 0; i != Num; i += 1 {
        let mut FromResNo: u32 = From[i].getResNo();
        let mut FromNode: *mut SDNode = From[i].getNode();
        for Use in FromNode.uses() {
            if Use.getResNo() == FromResNo {
                let mut Memo: UseMemo = UseMemo { User: Use.getUser(), Index: i, Use: &mut Use };
                Uses.push(Memo);
            }
        }
    }
    sort(Uses);
    let mut Listener: RAUOVWUpdateListener = RAUOVWUpdateListener { *self, Uses };
    for let mut UseIndex: u32 = 0;
let mut UseIndexEnd: u32 = Uses.len; UseIndex != UseIndexEnd;  {
        let mut User: *mut SDNode = Uses[UseIndex].User;
        if User == null {
            UseIndex += 1;
            continue;
        }
        self.RemoveNodeFromCSEMaps(User);
        while true {
            {
            let mut i: u32 = Uses[UseIndex].Index;
            let mut Use: *mut SDUse = *Uses[UseIndex].Use;
            UseIndex += 1;
            Use.set(To[i]);
        }
            if !(UseIndex != UseIndexEnd && Uses[UseIndex].User == User) { break; }
        }
        self.AddModifiedNodeToCSEMaps(User);
    }
}

fn SelectionDAG::AssignTopologicalOrder(self) -> u32 {
    let mut DAGSize: u32 = 0;
    let mut SortedPos: allnodes_iterator = self.allnodes_begin();
    for N in make_early_inc_range(self.allnodes()) {
        checkForCycles(&mut N, self, false);
        let mut Degree: u32 = N.getNumOperands();
        if Degree == 0 {
            N.setNodeId(DAGSize += 1);
            let mut Q: allnodes_iterator = allnodes_iterator { &mut N };
            if Q != SortedPos {
                SortedPos = self.AllNodes.insert(iterator { SortedPos }, self.AllNodes.remove(Q));
            }
            assert!(SortedPos != self.AllNodes.end(), "Overran node list");
            operator(SortedPos);
        } else {
            N.setNodeId(Degree);
        }
    }
    for Node in self.allnodes() {
        let mut N: *mut SDNode = &mut Node;
        checkForCycles(N, self, false);
        for P in N.users() {
            let mut Degree: u32 = P.getNodeId();
            assert!(Degree != 0, "Invalid node degree");
            Degree -= 1;
            if Degree == 0 {
                P.setNodeId(DAGSize += 1);
                if P.getIterator() != SortedPos {
                    SortedPos = self.AllNodes.insert(iterator { SortedPos }, self.AllNodes.remove(P));
                }
                assert!(SortedPos != self.AllNodes.end(), "Overran node list");
                operator(SortedPos);
            } else {
                P.setNodeId(Degree);
            }
        }
        if Node.getIterator() == SortedPos {
            let mut I: allnodes_iterator = allnodes_iterator { N };
            let mut S: *mut SDNode = &mut operator(operator(I));
            dbgs() << "Overran sorted position:\n";
            S.dumprFull(self);
            dbgs() << "\n";
            dbgs() << "Checking if this is due to cycles\n";
            checkForCycles(self, true);
            llvm_unreachable_internal(null, "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAG.cpp", 13613);
        }
    }
    assert!(SortedPos == self.AllNodes.end(), "Topological sort incomplete!");
    assert!(self.AllNodes.front().getOpcode() == EntryToken, "First node in topological sort is not the entry token!");
    assert!(self.AllNodes.front().getNodeId() == 0, "First node in topological sort has non-zero id!");
    assert!(self.AllNodes.front().getNumOperands() == 0, "First node in topological sort has operands!");
    assert!(self.AllNodes.back().getNodeId() == DAGSize as i32 - 1, "Last node in topologic sort has unexpected id!");
    assert!(self.AllNodes.back().use_empty(), "Last node in topologic sort has users!");
    assert!(DAGSize == self.allnodes_size(), "Node count mismatch!");
    return DAGSize;
}

fn SelectionDAG::getTopologicallyOrderedNodes(self: *SelectionDAG, SortedNodes: *SmallVectorImpl<const SDNode *>) {
    SortedNodes.clear();
    let mut RemainingOperands: DenseMap<const SDNode *, unsigned int> = DenseMap<const SDNode *, unsigned int> {};
    for N in self.allnodes() {
        checkForCycles(&mut N, self, false);
        let mut NumOperands: u32 = N.getNumOperands();
        if NumOperands == 0 {
            SortedNodes.push(&mut N);
        } else {
            RemainingOperands[&mut N] = NumOperands;
        }
    }
    for let mut i: u32 = 0; i < SortedNodes.len; i += 1 {
        let mut N: *SDNode = SortedNodes[i];
        for U in N.users() {
            if U.getOpcode() == HANDLENODE {
                continue;
            }
            let mut NumRemOperands: *mut u32 = RemainingOperands[U];
            assert!(NumRemOperands, "Invalid number of remaining operands");
            NumRemOperands -= 1;
            if !NumRemOperands {
                SortedNodes.push(U);
            }
        }
    }
    assert!(SortedNodes.len == self.AllNodes.len, "Node count mismatch");
    assert!(SortedNodes.front().getOpcode() == EntryToken, "First node in topological sort is not the entry token");
    assert!(SortedNodes.front().getNumOperands() == 0, "First node in topological sort has operands");
}

fn SelectionDAG::AddDbgValue(self, DB: *mut SDDbgValue, isParameter: bool) {
    for SD in DB.getSDNodes() {
        if !SD {
            continue;
        }
        assert!(self.DbgInfo.getSDDbgValues(SD).is_empty() || SD.getHasDebugValue());
        SD.setHasDebugValue(true);
    }
    self.DbgInfo.add(DB, isParameter);
}

fn SelectionDAG::AddDbgLabel(self, DB: *mut SDDbgLabel) {
    self.DbgInfo.add(DB);
}

fn SelectionDAG::makeEquivalentMemoryOrdering(self, OldChain: SDValue, NewMemOpChain: SDValue) -> SDValue {
    assert!(isa(NewMemOpChain), "Expected a memop node");
    assert!(NewMemOpChain.getValueType() == EVT { Other }, "Expected a token VT");
    if OldChain == NewMemOpChain || OldChain.use_empty() {
        return NewMemOpChain;
    }
    let mut TokenFactor: SDValue = self.getNode(TokenFactor, SDLoc { OldChain }, EVT { Other }, OldChain, NewMemOpChain);
    self.ReplaceAllUsesOfValueWith(OldChain, TokenFactor);
    self.UpdateNodeOperands(TokenFactor.getNode(), OldChain, NewMemOpChain);
    return TokenFactor;
}

fn SelectionDAG::makeEquivalentMemoryOrdering(self, OldLoad: *mut LoadSDNode, NewMemOp: SDValue) -> SDValue {
    assert!(isa(NewMemOp.getNode()), "Expected a memop node");
    let mut OldChain: SDValue = SDValue { Node: OldLoad, ResNo: 1 };
    let mut NewMemOpChain: SDValue = NewMemOp.getValue(1);
    return self.makeEquivalentMemoryOrdering(OldChain, NewMemOpChain);
}

fn SelectionDAG::getSymbolFunctionGlobalAddress(self, Op: SDValue, OutFunction: *mut *mut Function) -> SDValue {
    assert!(isa(Op), "Node should be an ExternalSymbol");
    let mut Symbol: *u8 = cast(Op).getSymbol();
    let mut Module: *mut Module = self.MF.getFunction().getParent();
    let mut Function: *mut Function = Module.getFunction(Symbol);
    if OutFunction != null {
        *OutFunction = Function;
    }
    if Function != null {
        let mut PtrTy: MVT = self.TLI.getPointerTy(self.getDataLayout(), Function.getAddressSpace());
        return self.getGlobalAddress(Function, SDLoc { Op }, EVT { PtrTy }, 0, false, 0);
    }
    let mut ErrorStr: str = "";
    let mut ErrorFormatter: raw_string_ostream = raw_string_ostream { ErrorStr };
    ErrorFormatter << "Undefined external symbol ";
    ErrorFormatter << '\"' << Symbol << '\"';
    report_fatal_error(ErrorStr, true);
}

fn isNullConstant(V: SDValue) -> bool {
    let mut Const: *mut ConstantSDNode = dyn_cast(V);
    return Const != null && Const.isZero();
}

fn isNullConstantOrUndef(V: SDValue) -> bool {
    return V.isUndef() || isNullConstant(V);
}

fn isNullFPConstant(V: SDValue) -> bool {
    let mut Const: *mut ConstantFPSDNode = dyn_cast(V);
    return Const != null && Const.isZero() && !Const.isNegative();
}

fn isAllOnesConstant(V: SDValue) -> bool {
    let mut Const: *mut ConstantSDNode = dyn_cast(V);
    return Const != null && Const.isAllOnes();
}

fn isOneConstant(V: SDValue) -> bool {
    let mut Const: *mut ConstantSDNode = dyn_cast(V);
    return Const != null && Const.isOne();
}

fn isMinSignedConstant(V: SDValue) -> bool {
    let mut Const: *mut ConstantSDNode = dyn_cast(V);
    return Const != null && Const.isMinSignedValue();
}

fn SelectionDAG::isIdentityElement(self: *SelectionDAG, Opcode: u32, Flags: SDNodeFlags, V: SDValue, OperandNo: u32, Depth: u32) -> bool {
    let mut DemandedElts: APInt = getDemandAllEltsMask(V);
    return self.isIdentityElement(Opcode, Flags, V, DemandedElts, OperandNo, Depth);
}

fn SelectionDAG::isIdentityElement(self: *SelectionDAG, Opcode: u32, Flags: SDNodeFlags, V: SDValue, DemandedElts: *APInt, OperandNo: u32, Depth: u32) -> bool {
    if V.getValueType().isInteger() {
        let mut Known: KnownBits = self.computeKnownBits(V, DemandedElts, Depth);
        if Known.isConstant() {
            let mut Const: *APInt = Known.getConstant();
            match Opcode {
                ADD => {
                    OR;
                },
                MUL => {
                    return Const.isOne();
                },
                AND => {
                    UMIN;
                },
                SMAX => {
                    return Const.isMinSignedValue();
                },
                SMIN => {
                    return Const.isMaxSignedValue();
                },
                SUB => {
                    SHL;
                },
                UDIV => {
                    SDIV;
                },
            }
        }
    } else if isConstOrConstSplatFP(V, DemandedElts, false) {
        ConstFP;
    } else {
        match Opcode {
            FADD => {
                return ConstFP.isZero() && (Flags.hasNoSignedZeros() || ConstFP.isNegative());
            },
            FSUB => {
                return OperandNo == 1 && ConstFP.isZero() && (Flags.hasNoSignedZeros() || !ConstFP.isNegative());
            },
            FMUL => {
                return ConstFP.isOne();
            },
            FDIV => {
                return OperandNo == 1 && ConstFP.isOne();
            },
            FMINNUM => {
                FMAXNUM;
            },
            FMINIMUM => {
                FMAXIMUM;
            },
        }
    }
    return false;
}

fn peekThroughBitcasts(V: SDValue) -> SDValue {
    while V.getOpcode() == BITCAST {
        V = V.getOperand(0);
    }
    return V;
}

fn peekThroughOneUseBitcasts(V: SDValue) -> SDValue {
    while V.getOpcode() == BITCAST && V.getOperand(0).hasOneUse() {
        V = V.getOperand(0);
    }
    return V;
}

fn peekThroughExtractSubvectors(V: SDValue) -> SDValue {
    while V.getOpcode() == EXTRACT_SUBVECTOR {
        V = V.getOperand(0);
    }
    return V;
}

fn peekThroughInsertVectorElt(V: SDValue, DemandedElts: *APInt) -> SDValue {
    while V.getOpcode() == INSERT_VECTOR_ELT {
        let mut InVec: SDValue = V.getOperand(0);
        let mut EltNo: SDValue = V.getOperand(2);
        let mut VT: EVT = InVec.getValueType();
        let mut IndexC: *mut ConstantSDNode = dyn_cast(EltNo);
        if IndexC && VT.isFixedLengthVector() && IndexC.getAPIntValue().ult(VT.getVectorNumElements()) && !DemandedElts[IndexC.getZExtValue()] {
            V = InVec;
            continue;
        }
        break;
    }
    return V;
}

fn peekThroughTruncates(V: SDValue) -> SDValue {
    while V.getOpcode() == TRUNCATE {
        V = V.getOperand(0);
    }
    return V;
}

fn isBitwiseNot(V: SDValue, AllowUndefs: bool) -> bool {
    if V.getOpcode() != XOR {
        return false;
    }
    V = peekThroughBitcasts(V.getOperand(1));
    let mut NumBits: u32 = V.getScalarValueSizeInBits();
    let mut C: *mut ConstantSDNode = isConstOrConstSplat(V, AllowUndefs, true);
    return C && (C.getAPIntValue().countr_one() >= NumBits);
}

fn isConstOrConstSplat(N: SDValue, AllowUndefs: bool, AllowTruncation: bool) -> *mut ConstantSDNode {
    let mut DemandedElts: APInt = getDemandAllEltsMask(N);
    return isConstOrConstSplat(N, DemandedElts, AllowUndefs, AllowTruncation);
}

fn isConstOrConstSplat(N: SDValue, DemandedElts: *APInt, AllowUndefs: bool, AllowTruncation: bool) -> *mut ConstantSDNode {
    if dyn_cast(N) {
        CN;
    } else {
        return CN;
    }
    if operator(N).getOpcode() == SPLAT_VECTOR {
        let mut VecEltVT: EVT = operator(N).getValueType(0).getVectorElementType();
        if dyn_cast(operator(N).getOperand(0)) {
            CN;
        } else {
            let mut CVT: EVT = CN.getValueType(0);
            assert!(CVT.bitsGE(VecEltVT), "Illegal splat_vector element extension");
            if AllowTruncation || CVT == VecEltVT {
                return CN;
            }
        }
    }
    if dyn_cast(N) {
        BV;
    } else {
        let mut UndefElements: BitVector = BitVector {};
        let mut CN: *mut ConstantSDNode = BV.getConstantSplatNode(DemandedElts, &mut UndefElements);
        if CN && (UndefElements.none() || AllowUndefs) {
            let mut CVT: EVT = CN.getValueType(0);
            let mut NSVT: EVT = N.getValueType().getScalarType();
            assert!(CVT.bitsGE(NSVT), "Illegal build vector element extension");
            if AllowTruncation || (CVT == NSVT) {
                return CN;
            }
        }
    }
    return null;
}

fn isConstOrConstSplatFP(N: SDValue, AllowUndefs: bool) -> *mut ConstantFPSDNode {
    let mut DemandedElts: APInt = getDemandAllEltsMask(N);
    return isConstOrConstSplatFP(N, DemandedElts, AllowUndefs);
}

fn isConstOrConstSplatFP(N: SDValue, DemandedElts: *APInt, AllowUndefs: bool) -> *mut ConstantFPSDNode {
    if dyn_cast(N) {
        CN;
    } else {
        return CN;
    }
    if dyn_cast(N) {
        BV;
    } else {
        let mut UndefElements: BitVector = BitVector {};
        let mut CN: *mut ConstantFPSDNode = BV.getConstantFPSplatNode(DemandedElts, &mut UndefElements);
        if CN && (UndefElements.none() || AllowUndefs) {
            return CN;
        }
    }
    if N.getOpcode() == SPLAT_VECTOR {
        if dyn_cast(N.getOperand(0)) {
            CN;
        } else {
            return CN;
        }
    }
    return null;
}

fn isNullOrNullSplat(N: SDValue, AllowUndefs: bool) -> bool {
    let mut C: *mut ConstantSDNode = isConstOrConstSplat(N, AllowUndefs, true);
    return C && C.isZero();
}

fn isOneOrOneSplat(N: SDValue, AllowUndefs: bool) -> bool {
    let mut C: *mut ConstantSDNode = isConstOrConstSplat(N, AllowUndefs, true);
    return C && C.isOne();
}

fn isOneOrOneSplatFP(N: SDValue, AllowUndefs: bool) -> bool {
    let mut C: *mut ConstantFPSDNode = isConstOrConstSplatFP(N, AllowUndefs);
    return C && C.isOne();
}

fn isAllOnesOrAllOnesSplat(N: SDValue, AllowUndefs: bool) -> bool {
    N = peekThroughBitcasts(N);
    let mut BitWidth: u32 = N.getScalarValueSizeInBits();
    let mut C: *mut ConstantSDNode = isConstOrConstSplat(N, AllowUndefs, true);
    return C && C.getAPIntValue().countTrailingOnes() >= BitWidth;
}

fn isOnesOrOnesSplat(N: SDValue, AllowUndefs: bool) -> bool {
    let mut C: *mut ConstantSDNode = isConstOrConstSplat(N, AllowUndefs, false);
    return C && isSameValue(C.getAPIntValue(), APInt { C.getAPIntValue().getBitWidth(), 1, false, false }, false);
}

fn isZeroOrZeroSplat(N: SDValue, AllowUndefs: bool) -> bool {
    N = peekThroughBitcasts(N);
    let mut C: *mut ConstantSDNode = isConstOrConstSplat(N, AllowUndefs, true);
    return C && C.isZero();
}

fn isZeroOrZeroSplatFP(N: SDValue, AllowUndefs: bool) -> bool {
    let mut C: *mut ConstantFPSDNode = isConstOrConstSplatFP(N, AllowUndefs);
    return C && C.isZero();
}

fn HandleSDNode::~HandleSDNode(self) {
    self.DropOperands();
}

fn MemSDNode::MemSDNode(self, Opc: u32, Order: u32, dl: *DebugLoc, VTs: SDVTList, memvt: EVT, memrefs: PointerUnion<MachineMemOperand *, MachineMemOperand **>) {
    let mut IsVolatile: bool = false;
    let mut IsNonTemporal: bool = false;
    let mut IsDereferenceable: bool = true;
    let mut IsInvariant: bool = true;
    for MMO in self.memoperands() {
        IsVolatile |= MMO.isVolatile();
        IsNonTemporal |= MMO.isNonTemporal();
        IsDereferenceable &= MMO.isDereferenceable();
        IsInvariant &= MMO.isInvariant();
    }
    self..MemSDNodeBits.IsVolatile = IsVolatile;
    self..MemSDNodeBits.IsNonTemporal = IsNonTemporal;
    self..MemSDNodeBits.IsDereferenceable = IsDereferenceable;
    self..MemSDNodeBits.IsInvariant = IsInvariant;
    assert!((self.getNumMemOperands() != 1 || !self.getMemOperand().getType().isValid() || isKnownLE(memvt.getStoreSize(), self.getMemOperand().getSize().getValue())), "Size mismatch!");
}

struct EVTArray {
    VTs: []EVT,
}

fn EVTArray::EVTArray(self) {
    self.VTs.reserve(VALUETYPE_SIZE);
    for let mut i: u32 = 0; i < VALUETYPE_SIZE; i += 1 {
        self.VTs.push(EVT { MVT { SimpleTy: i as SimpleValueType } });
    }
}

fn SDNode::getValueTypeList(self, VT: MVT) -> *EVT {
    let mut SimpleVTArray: EVTArray = EVTArray {};
    assert!(VT < MVT { SimpleTy: VALUETYPE_SIZE }, "Value type out of range!");
    return &mut SimpleVTArray.VTs[VT.SimpleTy];
}

fn SDNode::hasAnyUseOfValue(self: *SDNode, Value: u32) -> bool {
    assert!(Value < self.getNumValues(), "Bad value!");
    for U in self.uses() {
        if U.getResNo() == Value {
            return true;
        }
    }
    return false;
}

fn SDNode::isOnlyUserOf(self: *SDNode, N: *SDNode) -> bool {
    let mut Seen: bool = false;
    for User in N.users() {
        if User == self {
            Seen = true;
        } else {
            return false;
        }
    }
    return Seen;
}

fn SDNode::areOnlyUsersOf(self, Nodes: ArrayRef<const SDNode *>, N: *SDNode) -> bool {
    let mut Seen: bool = false;
    for User in N.users() {
        if is_contained(Nodes, User) {
            Seen = true;
        } else {
            return false;
        }
    }
    return Seen;
}

fn SDValue::isOperandOf(self: *SDValue, N: *SDNode) -> bool {
    return is_contained(N.op_values(), *self);
}

fn SDNode::isOperandOf(self: *SDNode, N: *SDNode) -> bool {
    return any_of(N.op_values(), Closure_23 { cap_0: self });
}

fn SDValue::reachesChainWithoutSideEffects(self: *SDValue, Dest: SDValue, Depth: u32) -> bool {
    if *self == Dest {
        return true;
    }
    if Depth == 0 {
        return false;
    }
    if self.getOpcode() == TokenFactor {
        if is_contained(operator((*self)).ops(), Dest) {
            if Dest.hasOneUse() {
                return true;
            }
        }
        return all_of(operator((*self)).ops(), Closure_24 { cap_0: Dest, Depth: Depth });
    }
    if dyn_cast(*self) {
        Ld;
    } else {
        if Ld.isUnordered() {
            return Ld.getChain().reachesChainWithoutSideEffects(Dest, Depth - 1);
        }
    }
    return false;
}

fn SDNode::hasPredecessor(self: *SDNode, N: *SDNode) -> bool {
    let mut Visited: SmallPtrSet<const SDNode *, 32> = SmallPtrSet<const SDNode *, 32> {};
    let mut Worklist: SmallVector<const SDNode *, 16> = SmallVector<const SDNode *, 16> {};
    Worklist.push(self);
    return hasPredecessorHelper(N, Visited, Worklist, 0, false);
}

fn SDNode::intersectFlagsWith(self, Flags: SDNodeFlags) {
    operator(self.Flags, Flags);
}

fn SelectionDAG::matchBinOpReduction(self, Extract: *mut SDNode, BinOp: *mut NodeType, CandidateBinOps: NodeType>, AllowPartials: bool) -> SDValue {
    if Extract.getOpcode() != EXTRACT_VECTOR_ELT || !isNullConstant(Extract.getOperand(1)) {
        return SDValue {};
    }
    let mut Op: SDValue = Extract.getOperand(0);
    if none_of(CandidateBinOps, Closure_25 { cap_0: Op }) {
        return SDValue {};
    }
    let mut CandidateBinOp: u32 = Op.getOpcode();
    if Op.getValueType().isFloatingPoint() {
        let mut Flags: SDNodeFlags = operator(Op).getFlags();
        match CandidateBinOp {
            FADD => {
                if !Flags.hasNoSignedZeros() || !Flags.hasAllowReassociation() {
                    return SDValue {};
                }
            },
            _ => {
                llvm_unreachable_internal("Unhandled FP opcode for binop reduction", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAG.cpp", 14207);
            },
        }
    }
    let mut PartialReduction: Closure_26 = Closure_26 { AllowPartials: &mut AllowPartials, cap_1: self, BinOp: &mut BinOp, CandidateBinOp: &mut CandidateBinOp };
    let mut Stages: u32 = Log2_32(Op.getValueType().getVectorNumElements());
    let mut PrevOp: SDValue = SDValue {};
    for let mut i: u32 = 0; i < Stages; i += 1 {
        let mut MaskEnd: u32 = (1 << i);
        if Op.getOpcode() != CandidateBinOp {
            return PartialReduction.call(PrevOp, MaskEnd);
        }
        let mut Op0: SDValue = Op.getOperand(0);
        let mut Op1: SDValue = Op.getOperand(1);
        let mut Shuffle: *mut ShuffleVectorSDNode = dyn_cast(Op0);
        if Shuffle {
            Op = Op1;
        } else {
            Shuffle = dyn_cast(Op1);
            Op = Op0;
        }
        if !Shuffle || Shuffle.getOperand(0) != Op {
            return PartialReduction.call(PrevOp, MaskEnd);
        }
        for let mut Index: i32 = 0; Index < MaskEnd as i32; Index += 1 {
            if Shuffle.getMaskElt(Index) != (MaskEnd + Index) as i32 {
                return PartialReduction.call(PrevOp, MaskEnd);
            }
        }
        PrevOp = Op;
    }
    while Op.getOpcode() == CandidateBinOp {
        let mut NumElts: u32 = Op.getValueType().getVectorNumElements();
        let mut Op0: SDValue = Op.getOperand(0);
        let mut Op1: SDValue = Op.getOperand(1);
        if Op0.getOpcode() != EXTRACT_SUBVECTOR || Op1.getOpcode() != EXTRACT_SUBVECTOR || Op0.getOperand(0) != Op1.getOperand(0) {
            break;
        }
        let mut Src: SDValue = Op0.getOperand(0);
        let mut NumSrcElts: u32 = Src.getValueType().getVectorNumElements();
        if NumSrcElts != (2 * NumElts) {
            break;
        }
        if !(Op0.getConstantOperandAPInt(1) == 0 && Op1.getConstantOperandAPInt(1) == NumElts) && !(Op1.getConstantOperandAPInt(1) == 0 && Op0.getConstantOperandAPInt(1) == NumElts) {
            break;
        }
        Op = Src;
    }
    BinOp = CandidateBinOp as NodeType;
    return Op;
}

fn SelectionDAG::UnrollVectorOp(self, N: *mut SDNode, ResNE: u32) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut EltVT: EVT = VT.getVectorElementType();
    let mut NE: u32 = self.getMaxRuntimeNumElements(VT);
    if VT.isScalableVector() && (NE == 0 || ResNE != 0) {
        reportFatalUsageError("Cannot unroll scalable vector!");
    }
    assert!(NE, "Nothing to unroll!");
    let mut dl: SDLoc = SDLoc { N };
    if ResNE == 0 {
        ResNE = NE;
    } else if NE > ResNE {
        NE = ResNE;
    }
    if N.getNumValues() == 2 {
        let mut Scalars0: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
        let mut Scalars1: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
        let mut Operands: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { N.getNumOperands() };
        let mut VT1: EVT = N.getValueType(1);
        let mut EltVT1: EVT = VT1.getVectorElementType();
        let mut i: u32 = 0;
        for i = 0; i != NE; i += 1 {
            for let mut j: u32 = 0;
let mut e: u32 = N.getNumOperands(); j != e; j += 1 {
                let mut Operand: SDValue = N.getOperand(j);
                let mut OperandVT: EVT = Operand.getValueType();
                let mut OperandEltVT: EVT = OperandVT.getVectorElementType();
                Operands[j] = self.getExtractVectorElt(dl, OperandEltVT, Operand, i);
            }
            let mut EltOp: SDValue = self.getNode(N.getOpcode(), dl, ArrayRef<EVT> { [EltVT, EltVT1] }, ArrayRef<SDValue> { Operands });
            Scalars0.push(ValueParamT { EltOp });
            Scalars1.push(EltOp.getValue(1));
        }
        for ; i < ResNE; i += 1 {
            Scalars0.push(self.getUNDEF(EltVT));
            Scalars1.push(self.getUNDEF(EltVT1));
        }
        let mut ResEC: ElementCount = if VT.isScalableVector() { VT.getVectorElementCount() } else { getFixed(ResNE) };
        let mut VecVT: EVT = getVectorVT(*self.getContext(), EltVT, ResEC);
        let mut VecVT1: EVT = getVectorVT(*self.getContext(), EltVT1, ResEC);
        let mut Vec0: SDValue = self.buildVectorFromUnrolledParts(VecVT, dl, ArrayRef<SDValue> { Scalars0 });
        let mut Vec1: SDValue = self.buildVectorFromUnrolledParts(VecVT1, dl, ArrayRef<SDValue> { Scalars1 });
        return self.getMergeValues(ArrayRef<SDValue> { [Vec0, Vec1] }, dl);
    }
    assert!(N.getNumValues() == 1, "Can't unroll a vector with multiple results!");
    let mut Scalars: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut Operands: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { N.getNumOperands() };
    let mut i: u32 = 0;
    for i = 0; i != NE; i += 1 {
        for let mut j: u32 = 0;
let mut e: u32 = N.getNumOperands(); j != e; j += 1 {
            let mut Operand: SDValue = N.getOperand(j);
            let mut OperandVT: EVT = Operand.getValueType();
            if OperandVT.isVector() {
                let mut OperandEltVT: EVT = OperandVT.getVectorElementType();
                Operands[j] = self.getExtractVectorElt(dl, OperandEltVT, Operand, i);
            } else {
                Operands[j] = Operand;
            }
        }
        match N.getOpcode() {
            _ => {
                Scalars.push(self.getNode(N.getOpcode(), dl, EltVT, ArrayRef<SDValue> { Operands }, N.getFlags()));
                break;
            },
            VSELECT => {
                Scalars.push(self.getNode(SELECT, dl, EltVT, ArrayRef<SDValue> { Operands }, N.getFlags()));
            },
            SHL => {
                SRA;
            },
            SIGN_EXTEND_INREG => {
                let mut ExtVT: EVT = cast(Operands[1]).getVT().getVectorElementType();
                Scalars.push(self.getNode(N.getOpcode(), dl, EltVT, Operands[0], self.getValueType(ExtVT)));
                break;
            },
            ADDRSPACECAST => {
                let mut ASC: *AddrSpaceCastSDNode const = cast(N);
                Scalars.push(self.getAddrSpaceCast(dl, EltVT, Operands[0], ASC.getSrcAddressSpace(), ASC.getDestAddressSpace(), ASC.getFlags()));
                break;
            },
        }
    }
    for ; i < ResNE; i += 1 {
        Scalars.push(self.getUNDEF(EltVT));
    }
    let mut VecVT: EVT = if VT.isScalableVector() { VT } else { getVectorVT(*self.getContext(), EltVT, ResNE, false) };
    return self.buildVectorFromUnrolledParts(VecVT, dl, ArrayRef<SDValue> { Scalars });
}

fn SelectionDAG::UnrollVectorOverflowOp(self, N: *mut SDNode, ResNE: u32) -> pair<SDValue, SDValue> {
    let mut Opcode: u32 = N.getOpcode();
    assert!((Opcode == UADDO || Opcode == SADDO || Opcode == USUBO || Opcode == SSUBO || Opcode == UMULO || Opcode == SMULO), "Expected an overflow opcode");
    let mut ResVT: EVT = N.getValueType(0);
    let mut OvVT: EVT = N.getValueType(1);
    let mut ResEltVT: EVT = ResVT.getVectorElementType();
    let mut OvEltVT: EVT = OvVT.getVectorElementType();
    let mut dl: SDLoc = SDLoc { N };
    let mut NE: u32 = ResVT.getVectorNumElements();
    if ResNE == 0 {
        ResNE = NE;
    } else if NE > ResNE {
        NE = ResNE;
    }
    let mut LHSScalars: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut RHSScalars: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    self.ExtractVectorElements(N.getOperand(0), LHSScalars, 0, NE, EVT {});
    self.ExtractVectorElements(N.getOperand(1), RHSScalars, 0, NE, EVT {});
    let mut SVT: EVT = self.TLI.getSetCCResultType(self.getDataLayout(), *self.getContext(), ResEltVT);
    let mut VTs: SDVTList = self.getVTList(ResEltVT, SVT);
    let mut ResScalars: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut OvScalars: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    for let mut i: u32 = 0; i < NE; i += 1 {
        let mut Res: SDValue = self.getNode(Opcode, dl, VTs, LHSScalars[i], RHSScalars[i]);
        let mut Ov: SDValue = self.getSelect(dl, OvEltVT, Res.getValue(1), self.getBoolConstant(true, dl, OvEltVT, ResVT), self.getConstant(0, dl, OvEltVT, false, false), SDNodeFlags { Flags: None });
        ResScalars.push(ValueParamT { Res });
        OvScalars.push(ValueParamT { Ov });
    }
    ResScalars.append(ResNE - NE, self.getUNDEF(ResEltVT));
    OvScalars.append(ResNE - NE, self.getUNDEF(OvEltVT));
    let mut NewResVT: EVT = getVectorVT(*self.getContext(), ResEltVT, ResNE, false);
    let mut NewOvVT: EVT = getVectorVT(*self.getContext(), OvEltVT, ResNE, false);
    return make_pair(self.getBuildVector(NewResVT, dl, ArrayRef<SDValue> { ResScalars }), self.getBuildVector(NewOvVT, dl, ArrayRef<SDValue> { OvScalars }));
}

fn areNonVolatileConsecutiveLoadsOrStores(LS: *mut LSBaseSDNode, Base: *mut LSBaseSDNode, Bytes: u32, Dist: i32, DAG: *SelectionDAG) -> bool {
    if LS.isVolatile() || Base.isVolatile() {
        return false;
    }
    if !LS.isSimple() {
        return false;
    }
    if LS.isIndexed() || Base.isIndexed() {
        return false;
    }
    if LS.getChain() != Base.getChain() {
        return false;
    }
    let mut VT: EVT = LS.getMemoryVT();
    if VT.getSizeInBits().operator unsigned long long() / 8 != Bytes {
        return false;
    }
    let mut BaseLocDecomp: BaseIndexOffset = match(Base, DAG);
    let mut LocDecomp: BaseIndexOffset = match(LS, DAG);
    let mut Offset: i64 = 0;
    if BaseLocDecomp.equalBaseIndex(LocDecomp, DAG, Offset) {
        return (Dist * Bytes as i64 == Offset);
    }
    return false;
}

fn SelectionDAG::areNonVolatileConsecutiveLoads(self: *SelectionDAG, LD: *mut LoadSDNode, Base: *mut LoadSDNode, Bytes: u32, Dist: i32) -> bool {
    return areNonVolatileConsecutiveLoadsOrStores(LD, Base, Bytes, Dist, *self);
}

fn SelectionDAG::areNonVolatileConsecutiveStores(self: *SelectionDAG, ST: *mut StoreSDNode, Base: *mut StoreSDNode, Bytes: u32, Dist: i32) -> bool {
    return areNonVolatileConsecutiveLoadsOrStores(ST, Base, Bytes, Dist, *self);
}

fn SelectionDAG::InferPtrAlign(self: *SelectionDAG, Ptr: SDValue) -> MaybeAlign {
    let mut GV: *GlobalValue = null;
    let mut GVOffset: i64 = 0;
    if self.TLI.isGAPlusOffset(Ptr.getNode(), GV, GVOffset) {
        let mut PtrWidth: u32 = self.getDataLayout().getPointerTypeSizeInBits(GV.getType());
        let mut Known: KnownBits = KnownBits { PtrWidth };
        computeKnownBits(GV, Known, self.getDataLayout(), null, null, null, true, 0);
        let mut AlignBits: u32 = Known.countMinTrailingZeros();
        if AlignBits {
            return MaybeAlign { commonAlignment(Align { ShiftValue: 1 << if 31 < AlignBits { 31 } else { AlignBits } }, GVOffset) };
        }
    }
    let mut FrameIdx: i32 = (-2147483647 - 1);
    let mut FrameOffset: i64 = 0;
    if dyn_cast(Ptr) {
        FI;
    } else {
        FrameIdx = FI.getIndex();
    }
    if FrameIdx != (-2147483647 - 1) {
        let mut MFI: *MachineFrameInfo = self.getMachineFunction().getFrameInfo();
        return MaybeAlign { commonAlignment(MFI.getObjectAlign(FrameIdx), FrameOffset) };
    }
    return MaybeAlign { nullopt };
}

fn SelectionDAG::SplitScalar(self, N: *SDValue, DL: *SDLoc, LoVT: *EVT, HiVT: *EVT) -> pair<SDValue, SDValue> {
    assert!(!LoVT.isVector() && !HiVT.isVector() && !N.getValueType().isVector(), "Split node must be a scalar type");
    let mut Lo: SDValue = self.getNode(EXTRACT_ELEMENT, DL, LoVT, N, self.getIntPtrConstant(0, DL, false));
    let mut Hi: SDValue = self.getNode(EXTRACT_ELEMENT, DL, HiVT, N, self.getIntPtrConstant(1, DL, false));
    return make_pair(Lo, Hi);
}

fn SelectionDAG::GetSplitDestVTs(self: *SelectionDAG, VT: *EVT) -> pair<EVT, EVT> {
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    if !VT.isVector() {
        LoVT = HiVT = self.TLI.getTypeToTransformTo(*self.getContext(), VT);
    } else {
        LoVT = HiVT = VT.getHalfNumVectorElementsVT(*self.getContext());
    }
    return make_pair(LoVT, HiVT);
}

fn SelectionDAG::GetDependentSplitDestVTs(self: *SelectionDAG, VT: *EVT, EnvVT: *EVT, HiIsEmpty: *mut bool) -> pair<EVT, EVT> {
    let mut EltTp: EVT = VT.getVectorElementType();
    let mut VTNumElts: ElementCount = VT.getVectorElementCount();
    let mut EnvNumElts: ElementCount = EnvVT.getVectorElementCount();
    assert!(VTNumElts.isScalable() == EnvNumElts.isScalable(), "Mixing fixed width and scalable vectors when enveloping a type");
    let mut LoVT: EVT = EVT {};
    let mut HiVT: EVT = EVT {};
    if VTNumElts.getKnownMinValue() > EnvNumElts.getKnownMinValue() {
        LoVT = getVectorVT(*self.getContext(), EltTp, EnvNumElts);
        HiVT = getVectorVT(*self.getContext(), EltTp, VTNumElts - EnvNumElts);
        *HiIsEmpty = false;
    } else {
        LoVT = getVectorVT(*self.getContext(), EltTp, VTNumElts);
        HiVT = getVectorVT(*self.getContext(), EltTp, EnvNumElts);
        *HiIsEmpty = true;
    }
    return make_pair(LoVT, HiVT);
}

fn SelectionDAG::SplitVector(self, N: *SDValue, DL: *SDLoc, LoVT: *EVT, HiVT: *EVT) -> pair<SDValue, SDValue> {
    assert!(LoVT.isScalableVector() == HiVT.isScalableVector() && LoVT.isScalableVector() == N.getValueType().isScalableVector(), "Splitting vector with an invalid mixture of fixed and scalable vector types");
    assert!(LoVT.getVectorMinNumElements() + HiVT.getVectorMinNumElements() <= N.getValueType().getVectorMinNumElements(), "More vector elements requested than available!");
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    Lo = self.getExtractSubvector(DL, LoVT, N, 0);
    Hi = self.getExtractSubvector(DL, HiVT, N, LoVT.getVectorMinNumElements());
    return make_pair(Lo, Hi);
}

fn SelectionDAG::SplitEVL(self, N: SDValue, VecVT: EVT, DL: *SDLoc) -> pair<SDValue, SDValue> {
    let mut VT: EVT = N.getValueType();
    assert!(VecVT.getVectorElementCount().isKnownEven(), "Expecting the mask to be an evenly-sized vector");
    let mut HalfNumElts: SDValue = self.getElementCount(DL, VT, VecVT.getVectorElementCount().divideCoefficientBy(2));
    let mut Lo: SDValue = self.getNode(UMIN, DL, VT, N, HalfNumElts);
    let mut Hi: SDValue = self.getNode(USUBSAT, DL, VT, N, HalfNumElts);
    return make_pair(Lo, Hi);
}

fn SelectionDAG::WidenVector(self, N: *SDValue, DL: *SDLoc) -> SDValue {
    let mut VT: EVT = N.getValueType();
    let mut WideVT: EVT = getVectorVT(*self.getContext(), VT.getVectorElementType(), NextPowerOf2(VT.getVectorNumElements()), false);
    return self.getInsertSubvector(DL, self.getPOISON(WideVT), N, 0);
}

fn SelectionDAG::ExtractVectorElements(self, Op: SDValue, Args: *mut SmallVectorImpl<SDValue>, Start: u32, Count: u32, EltVT: EVT) {
    let mut VT: EVT = Op.getValueType();
    if Count == 0 {
        Count = VT.getVectorNumElements();
    }
    if EltVT == EVT {} {
        EltVT = VT.getVectorElementType();
    }
    let mut SL: SDLoc = SDLoc { Op };
    for let mut i: u32 = Start;
let mut e: u32 = Start + Count; i != e; i += 1 {
        Args.push(self.getExtractVectorElt(SL, EltVT, Op, i));
    }
}

fn GlobalAddressSDNode::getAddressSpace(self: *GlobalAddressSDNode) -> u32 {
    return self.getGlobal().getType().getAddressSpace();
}

fn ConstantPoolSDNode::getType(self: *ConstantPoolSDNode) -> *mut Type {
    if self.isMachineConstantPoolEntry() {
        return self.Val.MachineCPVal.getType();
    }
    return self.Val.ConstVal.getType();
}

fn BuildVectorSDNode::isConstantSplat(self: *BuildVectorSDNode, SplatValue: *mut APInt, SplatUndef: *mut APInt, SplatBitSize: *mut u32, HasAnyUndefs: *mut bool, MinSplatBits: u32, IsBigEndian: bool) -> bool {
    let mut VT: EVT = self.getValueType(0);
    assert!(VT.isVector(), "Expected a vector type");
    let mut VecWidth: u32 = VT.getSizeInBits().operator unsigned long long();
    if MinSplatBits > VecWidth {
        return false;
    }
    SplatValue = APInt { VecWidth, 0, false, false };
    SplatUndef = APInt { VecWidth, 0, false, false };
    let mut NumOps: u32 = self.getNumOperands();
    assert!(NumOps > 0, "isConstantSplat has 0-size build vector");
    let mut EltWidth: u32 = VT.getScalarSizeInBits();
    for let mut j: u32 = 0; j < NumOps; j += 1 {
        let mut i: u32 = if IsBigEndian { NumOps - 1 - j } else { j };
        let mut OpVal: SDValue = self.getOperand(i);
        let mut BitPos: u32 = j * EltWidth;
        if OpVal.isUndef() {
            SplatUndef.setBits(BitPos, BitPos + EltWidth);
        } else if dyn_cast(OpVal) {
            CN;
        } else {
            SplatValue.insertBits(CN.getAPIntValue().zextOrTrunc(EltWidth), BitPos);
        }
    }
    HasAnyUndefs = (SplatUndef != 0);
    while VecWidth > 8 {
        if VecWidth & 1 {
            break;
        }
        let mut HalfSize: u32 = VecWidth / 2;
        let mut HighValue: APInt = SplatValue.extractBits(HalfSize, HalfSize);
        let mut LowValue: APInt = SplatValue.extractBits(HalfSize, 0);
        let mut HighUndef: APInt = SplatUndef.extractBits(HalfSize, HalfSize);
        let mut LowUndef: APInt = SplatUndef.extractBits(HalfSize, 0);
        if (HighValue & operator(LowUndef)) != (LowValue & operator(HighUndef)) || MinSplatBits > HalfSize {
            break;
        }
        SplatValue = HighValue | LowValue;
        SplatUndef = HighUndef & LowUndef;
        VecWidth = HalfSize;
    }
    SplatBitSize = VecWidth;
    return true;
}

fn BuildVectorSDNode::getSplatValue(self: *BuildVectorSDNode, DemandedElts: *APInt, UndefElements: *mut BitVector) -> SDValue {
    let mut NumOps: u32 = self.getNumOperands();
    if UndefElements {
        UndefElements.clear();
        UndefElements.resize(NumOps, false);
    }
    assert!(NumOps == DemandedElts.getBitWidth(), "Unexpected vector size");
    if operator(DemandedElts) {
        return SDValue {};
    }
    let mut Splatted: SDValue = SDValue {};
    for let mut i: u32 = 0; i != NumOps; i += 1 {
        if !DemandedElts[i] {
            continue;
        }
        let mut Op: SDValue = self.getOperand(i);
        if Op.isUndef() {
            if UndefElements {
                (*UndefElements)[i] = true;
            }
        } else if !Splatted {
            Splatted = Op;
        } else if Splatted != Op {
            return SDValue {};
        }
    }
    if !Splatted {
        let mut FirstDemandedIdx: u32 = DemandedElts.countr_zero();
        assert!(self.getOperand(FirstDemandedIdx).isUndef(), "Can only have a splat without a constant for all undefs.");
        return self.getOperand(FirstDemandedIdx);
    }
    return Splatted;
}

fn BuildVectorSDNode::getSplatValue(self: *BuildVectorSDNode, UndefElements: *mut BitVector) -> SDValue {
    let mut DemandedElts: APInt = getAllOnes(self.getNumOperands());
    return self.getSplatValue(DemandedElts, UndefElements);
}

fn BuildVectorSDNode::getRepeatedSequence(self: *BuildVectorSDNode, DemandedElts: *APInt, Sequence: *mut SmallVectorImpl<SDValue>, UndefElements: *mut BitVector) -> bool {
    let mut NumOps: u32 = self.getNumOperands();
    Sequence.clear();
    if UndefElements {
        UndefElements.clear();
        UndefElements.resize(NumOps, false);
    }
    assert!(NumOps == DemandedElts.getBitWidth(), "Unexpected vector size");
    if operator(DemandedElts) || NumOps < 2 || !isPowerOf2_32(NumOps) {
        return false;
    }
    if UndefElements {
        for let mut I: u32 = 0; I != NumOps; I += 1 {
            if DemandedElts[I] && self.getOperand(I).isUndef() {
                (*UndefElements)[I] = true;
            }
        }
    }
    for let mut SeqLen: u32 = 1; SeqLen < NumOps; SeqLen *= 2 {
        Sequence.append(SeqLen, SDValue {});
        for let mut I: u32 = 0; I != NumOps; I += 1 {
            if !DemandedElts[I] {
                continue;
            }
            let mut SeqOp: *mut SDValue = Sequence[I % SeqLen];
            let mut Op: SDValue = self.getOperand(I);
            if Op.isUndef() {
                if !SeqOp {
                    SeqOp = Op;
                }
                continue;
            }
            if SeqOp && !SeqOp.isUndef() && SeqOp != Op {
                Sequence.clear();
                break;
            }
            SeqOp = Op;
        }
        if !Sequence.is_empty() {
            return true;
        }
    }
    assert!(Sequence.is_empty(), "Failed to empty non-repeating sequence pattern");
    return false;
}

fn BuildVectorSDNode::getRepeatedSequence(self: *BuildVectorSDNode, Sequence: *mut SmallVectorImpl<SDValue>, UndefElements: *mut BitVector) -> bool {
    let mut DemandedElts: APInt = getAllOnes(self.getNumOperands());
    return self.getRepeatedSequence(DemandedElts, Sequence, UndefElements);
}

fn BuildVectorSDNode::getConstantSplatNode(self: *BuildVectorSDNode, DemandedElts: *APInt, UndefElements: *mut BitVector) -> *mut ConstantSDNode {
    return dyn_cast_or_null(self.getSplatValue(DemandedElts, UndefElements));
}

fn BuildVectorSDNode::getConstantSplatNode(self: *BuildVectorSDNode, UndefElements: *mut BitVector) -> *mut ConstantSDNode {
    return dyn_cast_or_null(self.getSplatValue(UndefElements));
}

fn BuildVectorSDNode::getConstantFPSplatNode(self: *BuildVectorSDNode, DemandedElts: *APInt, UndefElements: *mut BitVector) -> *mut ConstantFPSDNode {
    return dyn_cast_or_null(self.getSplatValue(DemandedElts, UndefElements));
}

fn BuildVectorSDNode::getConstantFPSplatNode(self: *BuildVectorSDNode, UndefElements: *mut BitVector) -> *mut ConstantFPSDNode {
    return dyn_cast_or_null(self.getSplatValue(UndefElements));
}

fn BuildVectorSDNode::getConstantFPSplatPow2ToLog2Int(self: *BuildVectorSDNode, UndefElements: *mut BitVector, BitWidth: u32) -> i32 {
    if dyn_cast_or_null(self.getSplatValue(UndefElements)) {
        CN;
    } else {
        let mut IsExact: bool = false;
        let mut IntVal: APSInt = APSInt { BitWidth, true };
        let mut APF: *APFloat = CN.getValueAPF();
        if APF.convertToInteger(IntVal, rmTowardZero, &mut IsExact) != opOK || !IsExact {
            return -1;
        }
        return IntVal.exactLogBase2();
    }
    return -1;
}

fn BuildVectorSDNode::getConstantRawBits(self: *BuildVectorSDNode, IsLittleEndian: bool, DstEltSizeInBits: u32, RawBitElements: *mut SmallVectorImpl<APInt>, UndefElements: *mut BitVector) -> bool {
    if !self.isConstant() {
        return false;
    }
    let mut NumSrcOps: u32 = self.getNumOperands();
    let mut SrcEltSizeInBits: u32 = self.getValueType(0).getScalarSizeInBits();
    assert!(((NumSrcOps * SrcEltSizeInBits) % DstEltSizeInBits) == 0, "Invalid bitcast scale");
    let mut SrcBitElements: SmallVector<APInt> = SmallVector<APInt> { NumSrcOps, getZero(SrcEltSizeInBits) };
    let mut SrcUndeElements: BitVector = BitVector { Bits: NumSrcOps, Size: false };
    for let mut I: u32 = 0; I != NumSrcOps; I += 1 {
        let mut Op: SDValue = self.getOperand(I);
        if Op.isUndef() {
            SrcUndeElements.set(I);
            continue;
        }
        let mut CInt: *mut ConstantSDNode = dyn_cast(Op);
        let mut CFP: *mut ConstantFPSDNode = dyn_cast(Op);
        assert!((CInt || CFP), "Unknown constant");
        SrcBitElements[I] = if CInt { CInt.getAPIntValue().trunc(SrcEltSizeInBits) } else { CFP.getValueAPF().bitcastToAPInt() };
    }
    recastRawBits(IsLittleEndian, DstEltSizeInBits, RawBitElements, ArrayRef<APInt> { SrcBitElements }, UndefElements, SrcUndeElements);
    return true;
}

fn BuildVectorSDNode::recastRawBits(self, IsLittleEndian: bool, DstEltSizeInBits: u32, DstBitElements: *mut SmallVectorImpl<APInt>, SrcBitElements: ArrayRef<APInt>, DstUndefElements: *mut BitVector, SrcUndefElements: *BitVector) {
    let mut NumSrcOps: u32 = SrcBitElements.len;
    let mut SrcEltSizeInBits: u32 = SrcBitElements[0].getBitWidth();
    assert!(((NumSrcOps * SrcEltSizeInBits) % DstEltSizeInBits) == 0, "Invalid bitcast scale");
    assert!(NumSrcOps == SrcUndefElements.len, "Vector size mismatch");
    let mut NumDstOps: u32 = (NumSrcOps * SrcEltSizeInBits) / DstEltSizeInBits;
    DstUndefElements.clear();
    DstUndefElements.resize(NumDstOps, false);
    DstBitElements.assign(NumDstOps, getZero(DstEltSizeInBits));
    if SrcEltSizeInBits <= DstEltSizeInBits {
        let mut Scale: u32 = DstEltSizeInBits / SrcEltSizeInBits;
        for let mut I: u32 = 0; I != NumDstOps; I += 1 {
            DstUndefElements.set(I);
            let mut DstBits: *mut APInt = DstBitElements[I];
            for let mut J: u32 = 0; J != Scale; J += 1 {
                let mut Idx: u32 = (I * Scale) + (if IsLittleEndian { J } else { (Scale - J - 1) });
                if SrcUndefElements[Idx] {
                    continue;
                }
                DstUndefElements.reset(I);
                let mut SrcBits: *APInt = SrcBitElements[Idx];
                assert!(SrcBits.getBitWidth() == SrcEltSizeInBits, "Illegal constant bitwidths");
                DstBits.insertBits(SrcBits, J * SrcEltSizeInBits);
            }
        }
        return;
    }
    let mut Scale: u32 = SrcEltSizeInBits / DstEltSizeInBits;
    for let mut I: u32 = 0; I != NumSrcOps; I += 1 {
        if SrcUndefElements[I] {
            DstUndefElements.set(I * Scale, (I + 1) * Scale);
            continue;
        }
        let mut SrcBits: *APInt = SrcBitElements[I];
        for let mut J: u32 = 0; J != Scale; J += 1 {
            let mut Idx: u32 = (I * Scale) + (if IsLittleEndian { J } else { (Scale - J - 1) });
            let mut DstBits: *mut APInt = DstBitElements[Idx];
            DstBits = SrcBits.extractBits(DstEltSizeInBits, J * DstEltSizeInBits);
        }
    }
}

fn BuildVectorSDNode::isConstant(self: *BuildVectorSDNode) -> bool {
    for Op in self.op_values() {
        let mut Opc: u32 = Op.getOpcode();
        if !Op.isUndef() && Opc != Constant && Opc != ConstantFP {
            return false;
        }
    }
    return true;
}

fn BuildVectorSDNode::isArithmeticSequence(self: *BuildVectorSDNode) -> pair<APInt, APInt>> {
    let mut NumOps: u32 = self.getNumOperands();
    if NumOps < 2 {
        return pair<APInt, APInt>> { nullopt };
    }
    let mut EltSize: u32 = self.getValueType(0).getScalarSizeInBits();
    let mut Start: APInt = APInt {};
    let mut Stride: APInt = APInt {};
    let mut FirstIdx: i32 = -1;
    let mut SecondIdx: i32 = -1;
    for let mut I: u32 = 0; I < NumOps; I += 1 {
        let mut Op: SDValue = self.getOperand(I);
        if operator(Op).isUndef() {
            continue;
        }
        if !isa(Op) {
            return pair<APInt, APInt>> { nullopt };
        }
        let mut Val: APInt = self.getConstantOperandAPInt(I).trunc(EltSize);
        if FirstIdx < 0 {
            FirstIdx = I;
            Start = Val;
        } else if SecondIdx < 0 {
            SecondIdx = I;
            let mut IdxDiff: u32 = I - FirstIdx;
            let mut ValDiff: APInt = Val - Start;
            let mut CommonPow2Bits: u32 = countr_zero(IdxDiff);
            if ValDiff.countr_zero() < CommonPow2Bits {
                return pair<APInt, APInt>> { nullopt };
            }
            IdxDiff >>= CommonPow2Bits;
            ValDiff.lshrInPlace(CommonPow2Bits);
            Stride = ValDiff * APInt { EltSize, IdxDiff, false, false }.multiplicativeInverse();
            if Stride.isZero() {
                return pair<APInt, APInt>> { nullopt };
            }
            operator(Start, Stride * FirstIdx);
        } else {
            if Val != Start + Stride * I {
                return pair<APInt, APInt>> { nullopt };
            }
        }
    }
    if SecondIdx < 0 {
        return pair<APInt, APInt>> { nullopt };
    }
    return pair<APInt, APInt>> { make_pair(Start, Stride) };
}

fn ShuffleVectorSDNode::isSplatMask(self, Mask: ArrayRef<int>) -> bool {
    let mut i: u32 = 0;
    let mut e: u32 = 0;
    for i = 0 , e = Mask.len; i != e && Mask[i] < 0; i += 1 {
        
    }
    if i == e {
        return true;
    }
    for let mut Idx: i32 = Mask[i]; i != e; i += 1 {
        if Mask[i] >= 0 && Mask[i] != Idx {
            return false;
        }
    }
    return true;
}

fn SelectionDAG::isConstantIntBuildVectorOrConstantInt(self: *SelectionDAG, N: SDValue, AllowOpaques: bool) -> bool {
    N = peekThroughBitcasts(N);
    if dyn_cast(N) {
        C;
    } else {
        return AllowOpaques || !C.isOpaque();
    }
    if isBuildVectorOfConstantSDNodes(N.getNode()) {
        return true;
    }
    if dyn_cast(N) {
        GA;
    } else if GA.getOpcode() == GlobalAddress && self.TLI.isOffsetFoldingLegal(GA) {
        return true;
    }
    if (N.getOpcode() == SPLAT_VECTOR) && isa(N.getOperand(0)) {
        return true;
    }
    return false;
}

fn SelectionDAG::isConstantFPBuildVectorOrConstantFP(self: *SelectionDAG, N: SDValue) -> bool {
    if isa(N) {
        return true;
    }
    if isBuildVectorOfConstantFPSDNodes(N.getNode()) {
        return true;
    }
    if (N.getOpcode() == SPLAT_VECTOR) && isa(N.getOperand(0)) {
        return true;
    }
    return false;
}

fn SelectionDAG::isBoolConstant(self: *SelectionDAG, N: SDValue) -> optional<bool> {
    let mut Const: *mut ConstantSDNode = isConstOrConstSplat(N, false, true);
    if !Const {
        return optional<bool> { nullopt };
    }
    let mut VT: EVT = operator(N).getValueType(0);
    let mut CVal: APInt = Const.getAPIntValue().trunc(VT.getScalarSizeInBits());
    match self.TLI.getBooleanContents(N.getValueType()) {
        ZeroOrOneBooleanContent => {
            if CVal.isOne() {
                return optional<bool> { true };
            }
        },
        ZeroOrNegativeOneBooleanContent => {
            if CVal.isAllOnes() {
                return optional<bool> { true };
            }
        },
        UndefinedBooleanContent => {
            return optional<bool> { CVal[0] };
        },
    }
    llvm_unreachable_internal("Unknown BooleanContent enum", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAG.cpp", 15125);
}

fn SelectionDAG::createOperands(self, Node: *mut SDNode, Vals: ArrayRef<SDValue>) {
    assert!(!Node.OperandList, "Node already has operands");
    assert!(getMaxNumOperands() >= Vals.len, "too many operands to fit into SDNode");
    let mut Ops: *mut SDUse = self.OperandRecycler.allocate(get(Vals.len), self.OperandAllocator);
    let mut IsDivergent: bool = false;
    for let mut I: u32 = 0; I != Vals.len; I += 1 {
        Ops[I].setUser(Node);
        Ops[I].setInitial(Vals[I]);
        let mut VT: EVT = Ops[I].getValueType();
        if VT != EVT { Other } && (VT != EVT { Glue } || gluePropagatesDivergence(Ops[I].getNode())) && Ops[I].getNode().isDivergent() {
            IsDivergent = true;
        }
    }
    Node.NumOperands = Vals.len;
    Node.OperandList = Ops;
    if !self.TLI.isSDNodeAlwaysUniform(Node) {
        IsDivergent |= self.TLI.isSDNodeSourceOfDivergence(Node, self.FLI, self.UA);
        Node..SDNodeBits.IsDivergent = IsDivergent;
    }
    checkForCycles(Node, null, false);
}

fn SelectionDAG::getTokenFactor(self, DL: *SDLoc, Vals: *mut SmallVectorImpl<SDValue>) -> SDValue {
    let mut Limit: u64 = getMaxNumOperands();
    while Vals.len > Limit {
        let mut SliceIdx: u32 = Vals.len - Limit;
        let mut ExtractedTFs: SDValue> = ArrayRef<SDValue> { Vals }.slice(SliceIdx, Limit);
        let mut NewTF: SDValue = self.getNode(TokenFactor, DL, EVT { Other }, ArrayRef<SDValue> { ExtractedTFs });
        Vals.erase(Vals.begin() + SliceIdx, Vals.end());
        Vals.emplace_back(NewTF);
    }
    return self.getNode(TokenFactor, DL, EVT { Other }, ArrayRef<SDValue> { Vals });
}

fn SelectionDAG::getIdentityElement(self, Opcode: u32, DL: *SDLoc, VT: EVT, Flags: SDNodeFlags) -> SDValue {
    match Opcode {
        _ => {
            return SDValue {};
        },
        ADD => {
            OR;
        },
        FADD => {
            return self.getConstantFP(if Flags.hasNoSignedZeros() { 0.0 } else { -0.0 }, DL, VT, false);
        },
        FMUL => {
            return self.getConstantFP(1.0, DL, VT, false);
        },
        FMINNUM => {
            FMAXNUM;
        },
        FMINIMUM => {
            FMAXIMUM;
        },
    }
}

fn SelectionDAG::getPartialReduceMLS(self, Opc: u32, DL: *SDLoc, Acc: SDValue, LHS: SDValue, RHS: SDValue) -> SDValue {
    let mut AccVT: EVT = Acc.getValueType();
    if AccVT.isFloatingPoint() {
        assert!(Opc == PARTIAL_REDUCE_FMLA, "Unexpected opcode");
        let mut NegRHS: SDValue = self.getNode(FNEG, DL, RHS.getValueType(), RHS);
        return self.getNode(Opc, DL, AccVT, Acc, LHS, NegRHS);
    }
    assert!((Opc == PARTIAL_REDUCE_UMLA || Opc == PARTIAL_REDUCE_SMLA || Opc == PARTIAL_REDUCE_SUMLA), "Unexpected opcode");
    let mut NegAcc: SDValue = self.getNegative(Acc, DL, AccVT);
    let mut MLA: SDValue = self.getNode(Opc, DL, AccVT, NegAcc, LHS, RHS);
    return self.getNegative(MLA, DL, AccVT);
}

fn SelectionDAG::makeStateFunctionCall(self, LibFunc: u32, Ptr: SDValue, InChain: SDValue, Node: *mut SDNode) -> SDValue {
    assert!(InChain.getValueType() == EVT { Other }, "Expected token chain");
    let mut LibcallImpl: LibcallImpl = self.Libcalls.getLibcallImpl(LibFunc as Libcall);
    if LibcallImpl == Unsupported {
        self.getContext().emitError("no libcall available for " + Node.getOperationName(self));
        return InChain;
    }
    let mut Args: ArgListTy = ArgListTy {};
    Args.emplace_back(Ptr, Ptr.getValueType().getTypeForEVT(*self.getContext()));
    let mut Callee: SDValue = self.getExternalSymbol(LibcallImpl, EVT { self.TLI.getPointerTy(self.getDataLayout(), 0) });
    let mut CLI: CallLoweringInfo = CallLoweringInfo { *self };
    CLI.setDebugLoc(SDLoc { Node }).setChain(InChain).setLibCallee(self.Libcalls.getLibcallImplCallingConv(LibcallImpl), getVoidTy(*self.getContext()), Callee, move(Args));
    return self.TLI.LowerCallTo(CLI).second;
}

fn SelectionDAG::copyExtraInfo(self, From: *mut SDNode, To: *mut SDNode) {
    assert!(From && To, "Invalid SDNode; empty source SDValue?");
    let mut I: iterator = self.SDEI.find(From);
    if I == self.SDEI.end() {
        return;
    }
    let mut NEI: NodeExtraInfo = operator(I).second;
    if __builtin_expect((!NEI.PCSections) as bool, true) {
        self.SDEI[To] = move(NEI);
        return;
    }
    let mut EntrySDN: *SDNode = self.getEntryNode().getNode();
    let mut Leafs: SmallVector<const SDNode *> = SmallVector<const SDNode *> { [From] };
    let mut FromReach: DenseSet<const SDNode *> = DenseSet<const SDNode *> {};
    let mut VisitFrom: Closure_27 = Closure_27 { Leafs: &mut Leafs, FromReach: &mut FromReach };
    let mut Visited: SmallPtrSet<const SDNode *, 8> = SmallPtrSet<const SDNode *, 8> {};
    let mut DeepCopyTo: Closure_28 = Closure_28 { FromReach: &mut FromReach, Visited: &mut Visited, EntrySDN: &mut EntrySDN, To: &mut To, cap_4: self, NEI: &mut NEI };
    for let mut PrevDepth: i32 = 0;
let mut MaxDepth: i32 = 16; MaxDepth <= 1024; PrevDepth = MaxDepth , MaxDepth *= 2 , Visited.clear() {
        let mut StartFrom: SmallVector<const SDNode *> = SmallVector<const SDNode *> {};
        swap(StartFrom, Leafs);
        for N in StartFrom {
            VisitFrom.call(VisitFrom, N, MaxDepth - PrevDepth);
        }
        if __builtin_expect((DeepCopyTo.call(DeepCopyTo, To)) as bool, true) {
            return;
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("selectiondag", 1) {
                dbgs() << "copyExtraInfo" << ": MaxDepth=" << MaxDepth << " too low\n";
            }
        }
            if !(false) { break; }
        }
        assert!(!Leafs.is_empty());
    }
    errs() << "warning: incomplete propagation of SelectionDAG::NodeExtraInfo\n";
    assert!(false, "From subgraph too complex - increase max. MaxDepth?");
    self.SDEI[To] = move(NEI);
}

fn SelectionDAG::getMaxRuntimeNumElements(self: *SelectionDAG, VT: EVT) -> u32 {
    assert!(VT.isVector(), "Can only unroll vector types!");
    if VT.isFixedLengthVector() {
        return VT.getVectorNumElements();
    }
    let mut MF: *MachineFunction = self.getMachineFunction();
    let mut F: *Function = MF.getFunction();
    let mut MaxVScale: APInt = getVScaleRange(&mut F,  * 8).getUnsignedMax();
    if MaxVScale.ugt(VScaleUnrollLimit.operator int()) {
        return 0;
    }
    let mut Overflow: bool = false;
    let mut MinNElts: APInt = APInt {  * 8, VT.getVectorMinNumElements(), false, false };
    let mut MaxNElts: APInt = MinNElts.umul_ov(MaxVScale, Overflow);
    if Overflow {
        return 0;
    }
    return MaxNElts.getZExtValue();
}

fn SelectionDAG::buildVectorFromUnrolledParts(self, VT: EVT, DL: *SDLoc, Scalars: ArrayRef<SDValue>) -> SDValue {
    assert!(Scalars.len == self.getMaxRuntimeNumElements(VT), "Element count mismatch!");
    if VT.isFixedLengthVector() {
        return self.getBuildVector(VT, DL, ArrayRef<SDValue> { Scalars });
    }
    let mut Vec: SDValue = self.getPOISON(VT);
    for IdxVal in reverse(seq(Scalars.len)) {
        Vec = self.getInsertVectorElt(DL, Vec, Scalars[IdxVal], IdxVal);
    }
    return Vec;
}

fn checkForCyclesHelper(N: *SDNode, Visited: *SmallPtrSetImpl<const SDNode *>, Checked: *SmallPtrSetImpl<const SDNode *>, DAG: *SelectionDAG) {
    if Checked.count(N) {
        return;
    }
    if !Visited.insert(N).second {
        errs() << "Detected cycle in SelectionDAG\n";
        dbgs() << "Offending node:\n";
        N.dumprFull(DAG);
        dbgs() << "\n";
        abort();
    }
    for Op in N.op_values() {
        checkForCyclesHelper(Op.getNode(), Visited, Checked, DAG);
    }
    Checked.insert(N);
    Visited.erase(N);
}

fn checkForCycles(N: *SDNode, DAG: *SelectionDAG, force: bool) {
    let mut check: bool = force;
    if check {
        assert!(N, "Checking nonexistent SDNode");
        let mut visited: SmallPtrSet<const SDNode *, 32> = SmallPtrSet<const SDNode *, 32> {};
        let mut checked: SmallPtrSet<const SDNode *, 32> = SmallPtrSet<const SDNode *, 32> {};
        checkForCyclesHelper(N, visited, checked, DAG);
    }
}

fn checkForCycles(DAG: *SelectionDAG, force: bool) {
    checkForCycles(DAG.getRoot().getNode(), DAG, force);
}

struct Closure_1 {}

fn Closure_1::call(self: *Closure_1, Op: SDValue) -> bool {
        return Op.isUndef();
    }

struct Closure_2 {
    NElts: *mut i32,
}

unsafe fn Closure_2::call(self: *mut Closure_2, M: i32) -> bool {
        return M < ((*self.NElts) * 2) && M >= -1;
    }

struct Closure_3 {
    NElts: *mut i32,
    MaskVec: *mut SmallVector<int, 8>,
}

unsafe fn Closure_3::call(self: *mut Closure_3, BV: *mut BuildVectorSDNode, Offset: i32) {
            let mut UndefElements: BitVector = BitVector {};
            let mut Splat: SDValue = BV.getSplatValue(&mut UndefElements);
            if !Splat {
                return;
            }
            for let mut i: i32 = 0; i < (*self.NElts); i += 1 {
                if (*self.MaskVec)[i] < Offset || (*self.MaskVec)[i] >= (Offset + (*self.NElts)) {
                    continue;
                }
                if UndefElements[(*self.MaskVec)[i] - Offset] {
                    (*self.MaskVec)[i] = -1;
                    continue;
                }
                if !UndefElements[i] {
                    (*self.MaskVec)[i] = i + Offset;
                }
            }
        }

