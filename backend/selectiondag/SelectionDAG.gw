fn SelectionDAG::getMachineNode(self, Opcode: u32, dl: *SDLoc, ResultTys: ArrayRef<EVT>, Ops: ArrayRef<SDValue>) -> *mut MachineSDNode {
    let mut VTs: SDVTList = self.getVTList(ArrayRef<EVT> { ResultTys });
    return self.getMachineNode(Opcode, dl, VTs, ArrayRef<SDValue> { Ops });
}

fn SelectionDAG::getMachineNode(self, Opcode: u32, DL: *SDLoc, VTs: SDVTList, Ops: ArrayRef<SDValue>) -> *mut MachineSDNode {
    let mut DoCSE: bool = VTs.VTs[VTs.NumVTs - 1] != EVT { Glue };
    let mut N: *mut MachineSDNode = null;
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if DoCSE {
        let mut ID: SDNodeKey = SDNodeKey { ~Opcode, VTs, ArrayRef<SDValue> { Ops } };
        if self.lookupNode(ID, DL, InsertToken) {
            E;
        } else {
            return cast(self.UpdateSDLocOnMergeSDNode(E, DL));
        }
    }
    N = self.newSDNode(~Opcode, DL.getIROrder(), DL.getDebugLoc(), VTs);
    self.createOperands(N, ArrayRef<SDValue> { Ops });
    if DoCSE {
        self.CSEMap.insert(N, InsertToken);
    }
    self.InsertNode(N);
    NewSDValueDbgMsg(SDValue { Node: N, ResNo: 0 }, "Creating new machine node: ", self);
    return N;
}

fn SelectionDAG::getTargetExtractSubreg(self, SRIdx: i32, DL: *SDLoc, VT: EVT, Operand: SDValue) -> SDValue {
    let mut SRIdxVal: SDValue = self.getTargetConstant(SRIdx, DL, EVT { i32 }, false);
    let mut Subreg: *mut SDNode = self.getMachineNode(EXTRACT_SUBREG, DL, VT, Operand, SRIdxVal);
    return SDValue { Node: Subreg, ResNo: 0 };
}

fn SelectionDAG::getTargetInsertSubreg(self, SRIdx: i32, DL: *SDLoc, VT: EVT, Operand: SDValue, Subreg: SDValue) -> SDValue {
    let mut SRIdxVal: SDValue = self.getTargetConstant(SRIdx, DL, EVT { i32 }, false);
    let mut Result: *mut SDNode = self.getMachineNode(INSERT_SUBREG, DL, VT, Operand, Subreg, SRIdxVal);
    return SDValue { Node: Result, ResNo: 0 };
}

fn SelectionDAG::getNodeIfExists(self, Opcode: u32, VTList: SDVTList, Ops: ArrayRef<SDValue>, AllowCommute: bool) -> *mut SDNode {
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    if self.Inserter {
        Flags = self.Inserter.getFlags();
    }
    return self.getNodeIfExists(Opcode, VTList, ArrayRef<SDValue> { Ops }, Flags, AllowCommute);
}

fn SelectionDAG::getNodeIfExists(self, Opcode: u32, VTList: SDVTList, Ops: ArrayRef<SDValue>, Flags: SDNodeFlags, AllowCommute: bool) -> *mut SDNode {
    if VTList.VTs[VTList.NumVTs - 1] == EVT { Glue } {
        return null;
    }
    let mut Lookup: Closure_19 = Closure_19 { Opcode: &mut Opcode, VTList: &mut VTList, cap_2: self, Flags: &mut Flags };
    if Lookup.call(ArrayRef<SDValue> { Ops }) {
        Existing;
    } else {
        return Existing;
    }
    if AllowCommute && self.TLI.isCommutativeBinOp(Opcode) {
        return Lookup.call(ArrayRef<SDValue> { [Ops[1], Ops[0]] });
    }
    return null;
}

fn SelectionDAG::doesNodeExist(self, Opcode: u32, VTList: SDVTList, Ops: ArrayRef<SDValue>) -> bool {
    if VTList.VTs[VTList.NumVTs - 1] != EVT { Glue } {
        let mut ID: SDNodeKey = SDNodeKey { Opcode, VTList, ArrayRef<SDValue> { Ops } };
        let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
        if self.lookupNode(ID, SDLoc {}, InsertToken) {
            return true;
        }
    }
    return false;
}

fn SelectionDAG::getDbgValue(self, Var: *mut DIVariable, Expr: *mut DIExpression, N: *mut SDNode, R: u32, IsIndirect: bool, DL: *DebugLoc, O: u32) -> *mut SDDbgValue {
    assert!(cast(Var).isValidLocationForIntrinsic(DL.operator llvm::DILocation *()), "Expected inlined-at fields to agree");
    return SDDbgValue { self.DbgInfo.getAlloc(), Var, Expr, ArrayRef<SDDbgOperand> { fromNode(N, R) }, ArrayRef<SDNode *> {}, IsIndirect, DL, O, false };
}

