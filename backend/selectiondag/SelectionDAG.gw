fn SelectionDAG::getBitcast(self, VT: EVT, V: SDValue) -> SDValue {
    if VT == V.getValueType() {
        return V;
    }
    return self.getNode(BITCAST, SDLoc { V }, VT, V);
}

fn SelectionDAG::getAddrSpaceCast(self, dl: *SDLoc, VT: EVT, Ptr: SDValue, SrcAS: u32, DestAS: u32, Flags: SDNodeFlags) -> SDValue {
    let mut VTs: SDVTList = self.getVTList(VT);
    let mut Ops: [1]SDValue = [Ptr];
    let mut ID: SDNodeKey = SDNodeKey { ADDRSPACECAST, VTs, ArrayRef<SDValue> { Ops } };
    ID.AddInteger(SrcAS);
    ID.AddInteger(DestAS);
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, dl, InsertToken) {
        E;
    } else {
        E.intersectFlagsWith(Flags);
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut AddrSpaceCastSDNode = self.newSDNode(dl.getIROrder(), dl.getDebugLoc(), VTs, SrcAS, DestAS);
    N.setFlags(Flags);
    self.createOperands(N, ArrayRef<SDValue> { Ops });
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    return SDValue { Node: N, ResNo: 0 };
}

fn SelectionDAG::getFreeze(self, V: SDValue) -> SDValue {
    return self.getNode(FREEZE, SDLoc { V }, V.getValueType(), V);
}

fn SelectionDAG::getFreeze(self, V: SDValue, DemandedElts: *APInt, Kind: UndefPoisonKind) -> SDValue {
    if self.isGuaranteedNotToBeUndefOrPoison(V, DemandedElts, Kind, 0) {
        return V;
    }
    return self.getFreeze(V);
}

fn SelectionDAG::getShiftAmountOperand(self, LHSTy: EVT, Op: SDValue) -> SDValue {
    let mut OpTy: EVT = Op.getValueType();
    let mut ShTy: EVT = self.TLI.getShiftAmountTy(LHSTy, self.getDataLayout());
    if OpTy == ShTy || OpTy.isVector() {
        return Op;
    }
    return self.getZExtOrTrunc(Op, SDLoc { Op }, ShTy);
}

fn SelectionDAG::expandVAArg(self, Node: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { Node };
    let mut TLI: *TargetLowering = self.getTargetLoweringInfo();
    let mut V: *Value = cast(Node.getOperand(2)).getValue();
    let mut VT: EVT = Node.getValueType(0);
    let mut Tmp1: SDValue = Node.getOperand(0);
    let mut Tmp2: SDValue = Node.getOperand(1);
    let mut MA: MaybeAlign = MaybeAlign { Node.getConstantOperandVal(3) };
    let mut VAListLoad: SDValue = self.getLoad(EVT { TLI.getPointerTy(self.getDataLayout(), 0) }, dl, Tmp1, Tmp2, MachinePointerInfo { V, 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    let mut VAList: SDValue = VAListLoad;
    if MA && operator(MA) > TLI.getMinStackArgumentAlignment() {
        VAList = self.getNode(ADD, dl, VAList.getValueType(), VAList, self.getConstant(operator(MA).value() - 1, dl, VAList.getValueType(), false, false));
        VAList = self.getNode(AND, dl, VAList.getValueType(), VAList, self.getSignedConstant(-operator(MA).value() as i64, dl, VAList.getValueType(), false, false));
    }
    Tmp1 = self.getNode(ADD, dl, VAList.getValueType(), VAList, self.getConstant(self.getDataLayout().getTypeAllocSize(VT.getTypeForEVT(*self.getContext())).operator unsigned long long(), dl, VAList.getValueType(), false, false));
    Tmp1 = self.getStore(VAListLoad.getValue(1), dl, Tmp1, Tmp2, MachinePointerInfo { V, 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    return self.getLoad(VT, dl, Tmp1, VAList, MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
}

fn SelectionDAG::expandVACopy(self, Node: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { Node };
    let mut TLI: *TargetLowering = self.getTargetLoweringInfo();
    let mut VD: *Value = cast(Node.getOperand(3)).getValue();
    let mut VS: *Value = cast(Node.getOperand(4)).getValue();
    let mut Tmp1: SDValue = self.getLoad(EVT { TLI.getPointerTy(self.getDataLayout(), 0) }, dl, Node.getOperand(0), Node.getOperand(2), MachinePointerInfo { VS, 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
    return self.getStore(Tmp1.getValue(1), dl, Tmp1, Node.getOperand(1), MachinePointerInfo { VD, 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
}

fn SelectionDAG::getReducedAlign(self, VT: EVT, UseABI: bool) -> Align {
    let mut DL: *DataLayout = self.getDataLayout();
    let mut Ty: *mut Type = VT.getTypeForEVT(*self.getContext());
    let mut RedAlign: Align = if UseABI { DL.getABITypeAlign(Ty) } else { DL.getPrefTypeAlign(Ty) };
    if self.TLI.isTypeLegal(VT) || !VT.isVector() {
        return RedAlign;
    }
    let mut TFI: *TargetFrameLowering = self.MF.getSubtarget().getFrameLowering();
    let mut StackAlign: Align = TFI.getStackAlign();
    if RedAlign > StackAlign {
        let mut IntermediateVT: EVT = EVT {};
        let mut RegisterVT: MVT = MVT {};
        let mut NumIntermediates: u32 = 0;
        self.TLI.getVectorTypeBreakdown(*self.getContext(), VT, IntermediateVT, NumIntermediates, RegisterVT);
        Ty = IntermediateVT.getTypeForEVT(*self.getContext());
        let mut RedAlign2: Align = if UseABI { DL.getABITypeAlign(Ty) } else { DL.getPrefTypeAlign(Ty) };
        if RedAlign2 < RedAlign {
            RedAlign = RedAlign2;
        }
        if !self.getMachineFunction().getFrameInfo().isStackRealignable() {
            RedAlign = if RedAlign < StackAlign { RedAlign } else { StackAlign };
        }
    }
    return RedAlign;
}

fn SelectionDAG::CreateStackTemporary(self, Bytes: TypeSize, Alignment: Align) -> SDValue {
    let mut MFI: *mut MachineFrameInfo = self.MF.getFrameInfo();
    let mut TFI: *TargetFrameLowering = self.MF.getSubtarget().getFrameLowering();
    let mut StackID: i32 = 0;
    if Bytes.isScalable() {
        StackID = TFI.getStackIDForScalableVectors();
    }
    let mut FrameIdx: i32 = MFI.CreateStackObject(Bytes.getKnownMinValue(), Alignment, false, null, StackID);
    return self.getFrameIndex(FrameIdx, EVT { self.TLI.getFrameIndexTy(self.getDataLayout()) }, false);
}

fn SelectionDAG::CreateStackTemporary(self, VT: EVT, minAlign: u32) -> SDValue {
    let mut Ty: *mut Type = VT.getTypeForEVT(*self.getContext());
    let mut StackAlign: Align = if self.getDataLayout().getPrefTypeAlign(Ty) > Align { ShiftValue: minAlign } { self.getDataLayout().getPrefTypeAlign(Ty) } else { Align { ShiftValue: minAlign } };
    return self.CreateStackTemporary(VT.getStoreSize(), StackAlign);
}

fn SelectionDAG::CreateStackTemporary(self, VT1: EVT, VT2: EVT) -> SDValue {
    let mut VT1Size: TypeSize = VT1.getStoreSize();
    let mut VT2Size: TypeSize = VT2.getStoreSize();
    assert!(VT1Size.isScalable() == VT2Size.isScalable(), "Don't know how to choose the maximum size when creating a stack temporary");
    let mut Bytes: TypeSize = if VT1Size.getKnownMinValue() > VT2Size.getKnownMinValue() { VT1Size } else { VT2Size };
    let mut Ty1: *mut Type = VT1.getTypeForEVT(*self.getContext());
    let mut Ty2: *mut Type = VT2.getTypeForEVT(*self.getContext());
    let mut DL: *DataLayout = self.getDataLayout();
    let mut Align: Align = if DL.getPrefTypeAlign(Ty1) > DL.getPrefTypeAlign(Ty2) { DL.getPrefTypeAlign(Ty1) } else { DL.getPrefTypeAlign(Ty2) };
    return self.CreateStackTemporary(Bytes, Align);
}

fn SelectionDAG::emitStackConvert(self, SrcOp: SDValue, SlotVT: EVT, DestVT: EVT, DL: *SDLoc, Chain: SDValue) -> SDValue {
    let mut SrcVT: EVT = SrcOp.getValueType();
    let mut DestType: *mut Type = DestVT.getTypeForEVT(*self.getContext());
    let mut DestAlign: Align = self.getDataLayout().getPrefTypeAlign(DestType);
    let mut SrcAlign: Align = self.getDataLayout().getPrefTypeAlign(SrcVT.getTypeForEVT(*self.getContext()));
    let mut FIPtr: SDValue = self.CreateStackTemporary(SlotVT.getStoreSize(), SrcAlign);
    let mut StackPtrFI: *mut FrameIndexSDNode = cast(FIPtr);
    let mut SPFI: i32 = StackPtrFI.getIndex();
    let mut PtrInfo: MachinePointerInfo = getFixedStack(self.getMachineFunction(), SPFI, 0);
    let mut Store: SDValue = SDValue {};
    if SrcVT.bitsGT(SlotVT) {
        Store = self.getTruncStore(Chain, DL, SrcOp, FIPtr, PtrInfo, SlotVT, SrcAlign, MONone, MMOMetadata {});
    } else {
        assert!(SrcVT.bitsEq(SlotVT), "Invalid store");
        Store = self.getStore(Chain, DL, SrcOp, FIPtr, PtrInfo, SrcAlign, MONone, MMOMetadata {});
    }
    if SlotVT.bitsEq(DestVT) {
        return self.getLoad(DestVT, DL, Store, FIPtr, PtrInfo, MaybeAlign { DestAlign }, MONone, MMOMetadata {});
    }
    assert!(SlotVT.bitsLT(DestVT), "Unknown extension!");
    return self.getExtLoad(EXTLOAD, DL, DestVT, Store, FIPtr, PtrInfo, SlotVT, MaybeAlign { DestAlign }, MONone, MMOMetadata {});
}

fn SelectionDAG::FoldSetCC(self, VT: EVT, N1: SDValue, N2: SDValue, Cond: CondCode, dl: *SDLoc, Flags: SDNodeFlags) -> SDValue {
    let mut OpVT: EVT = N1.getValueType();
    let mut GetUndefBooleanConstant: Closure_4 = Closure_4 { VT: &mut VT, cap_1: self, OpVT: &mut OpVT, dl: &mut dl };
    match Cond {
        _ => {
            break;
        },
        SETFALSE => {
            SETFALSE2;
        },
        SETTRUE => {
            SETTRUE2;
        },
        SETOEQ => {
            SETOGT;
        },
    }
    if OpVT.isInteger() {
        if (N1.isUndef() || N2.isUndef()) && (Cond == SETEQ || Cond == SETNE) {
            return GetUndefBooleanConstant.call();
        }
        if N1.isUndef() && N2.isUndef() {
            return GetUndefBooleanConstant.call();
        }
        if N1.isUndef() || N2.isUndef() || N1 == N2 {
            return self.getBoolConstant(isTrueWhenEqual(Cond), dl, VT, OpVT);
        }
    }
    if dyn_cast(N2) {
        N2C;
    } else {
        let mut C2: *APInt = N2C.getAPIntValue();
        if dyn_cast(N1) {
            N1C;
        } else {
            let mut C1: *APInt = N1C.getAPIntValue();
            return self.getBoolConstant(compare(C1, C2, getICmpCondCode(Cond)), dl, VT, OpVT);
        }
    }
    let mut N1CFP: *mut ConstantFPSDNode = dyn_cast(N1);
    let mut N2CFP: *mut ConstantFPSDNode = dyn_cast(N2);
    if N1CFP && N2CFP {
        let mut R: cmpResult = N1CFP.getValueAPF().compare(N2CFP.getValueAPF());
        match Cond {
            _ => {
                break;
            },
            SETEQ => {
                if R == cmpUnordered {
                    return GetUndefBooleanConstant.call();
                }
            },
            SETOEQ => {
                return self.getBoolConstant(R == cmpEqual, dl, VT, OpVT);
            },
            SETNE => {
                if R == cmpUnordered {
                    return GetUndefBooleanConstant.call();
                }
            },
            SETONE => {
                return self.getBoolConstant(R == cmpGreaterThan || R == cmpLessThan, dl, VT, OpVT);
            },
            SETLT => {
                if R == cmpUnordered {
                    return GetUndefBooleanConstant.call();
                }
            },
            SETOLT => {
                return self.getBoolConstant(R == cmpLessThan, dl, VT, OpVT);
            },
            SETGT => {
                if R == cmpUnordered {
                    return GetUndefBooleanConstant.call();
                }
            },
            SETOGT => {
                return self.getBoolConstant(R == cmpGreaterThan, dl, VT, OpVT);
            },
            SETLE => {
                if R == cmpUnordered {
                    return GetUndefBooleanConstant.call();
                }
            },
            SETOLE => {
                return self.getBoolConstant(R == cmpLessThan || R == cmpEqual, dl, VT, OpVT);
            },
            SETGE => {
                if R == cmpUnordered {
                    return GetUndefBooleanConstant.call();
                }
            },
            SETOGE => {
                return self.getBoolConstant(R == cmpGreaterThan || R == cmpEqual, dl, VT, OpVT);
            },
            SETO => {
                return self.getBoolConstant(R != cmpUnordered, dl, VT, OpVT);
            },
            SETUO => {
                return self.getBoolConstant(R == cmpUnordered, dl, VT, OpVT);
            },
            SETUEQ => {
                return self.getBoolConstant(R == cmpUnordered || R == cmpEqual, dl, VT, OpVT);
            },
            SETUNE => {
                return self.getBoolConstant(R != cmpEqual, dl, VT, OpVT);
            },
            SETULT => {
                return self.getBoolConstant(R == cmpUnordered || R == cmpLessThan, dl, VT, OpVT);
            },
            SETUGT => {
                return self.getBoolConstant(R == cmpGreaterThan || R == cmpUnordered, dl, VT, OpVT);
            },
            SETULE => {
                return self.getBoolConstant(R != cmpGreaterThan, dl, VT, OpVT);
            },
            SETUGE => {
                return self.getBoolConstant(R != cmpLessThan, dl, VT, OpVT);
            },
        }
    } else if N1CFP && OpVT.isSimple() && !N2.isUndef() {
        let mut SwappedCond: CondCode = getSetCCSwappedOperands(Cond);
        if !self.TLI.isCondCodeLegal(SwappedCond, OpVT.getSimpleVT()) {
            return SDValue {};
        }
        return self.getSetCC(dl, VT, N2, N1, SwappedCond, SDValue {}, false, Flags);
    } else if (N2CFP && N2CFP.getValueAPF().isNaN()) || (OpVT.isFloatingPoint() && (N1.isUndef() || N2.isUndef())) {
        match getUnorderedFlavor(Cond) {
            _ => {
                llvm_unreachable_internal("Unknown flavor!", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAG.cpp", 2840);
            },
            0 => {
                return self.getBoolConstant(false, dl, VT, OpVT);
            },
            1 => {
                return self.getBoolConstant(true, dl, VT, OpVT);
            },
            2 => {
                return GetUndefBooleanConstant.call();
            },
        }
    }
    return SDValue {};
}

fn SelectionDAG::SignBitIsZero(self: *SelectionDAG, Op: SDValue, Depth: u32) -> bool {
    let mut BitWidth: u32 = Op.getScalarValueSizeInBits();
    return self.MaskedValueIsZero(Op, getSignMask(BitWidth), Depth);
}

fn SelectionDAG::SignBitIsZeroFP(self: *SelectionDAG, Op: SDValue, Depth: u32) -> bool {
    if Depth >= MaxRecursionDepth {
        return false;
    }
    let mut Opc: u32 = Op.getOpcode();
    match Opc {
        FABS => {
            return true;
        },
        AssertNoFPClass => {
            let mut NoFPClass: FPClassTest = Op.getConstantOperandVal(1) as FPClassTest;
            let mut TestMask: FPClassTest = fcNan | fcNegative;
            return (NoFPClass & TestMask) == TestMask;
        },
        ARITH_FENCE => {
            return self.SignBitIsZeroFP(Op.getOperand(0), Depth + 1);
        },
        FEXP => {
            FEXP2;
        },
        FMINNUM => {
            FMINNUM_IEEE;
        },
        FMAXNUM => {
            FMAXNUM_IEEE;
        },
        _ => {
            return false;
        },
    }
    llvm_unreachable_internal("covered opcode switch", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAG.cpp", 2901);
}

fn SelectionDAG::MaskedValueIsZero(self: *SelectionDAG, V: SDValue, Mask: *APInt, Depth: u32) -> bool {
    return Mask.isSubsetOf(self.computeKnownBits(V, Depth).Zero);
}

fn SelectionDAG::MaskedValueIsZero(self: *SelectionDAG, V: SDValue, Mask: *APInt, DemandedElts: *APInt, Depth: u32) -> bool {
    return Mask.isSubsetOf(self.computeKnownBits(V, DemandedElts, Depth).Zero);
}

fn SelectionDAG::MaskedVectorIsZero(self: *SelectionDAG, V: SDValue, DemandedElts: *APInt, Depth: u32) -> bool {
    return self.computeKnownBits(V, DemandedElts, Depth).isZero();
}

fn SelectionDAG::MaskedValueIsAllOnes(self: *SelectionDAG, V: SDValue, Mask: *APInt, Depth: u32) -> bool {
    return Mask.isSubsetOf(self.computeKnownBits(V, Depth).One);
}

fn SelectionDAG::computeVectorKnownZeroElements(self: *SelectionDAG, Op: SDValue, DemandedElts: *APInt, Depth: u32) -> APInt {
    let mut VT: EVT = Op.getValueType();
    assert!(VT.isVector() && !VT.isScalableVector(), "Only for fixed vectors!");
    let mut NumElts: u32 = VT.getVectorNumElements();
    assert!(DemandedElts.getBitWidth() == NumElts, "Unexpected demanded mask.");
    let mut KnownZeroElements: APInt = getZero(NumElts);
    for let mut EltIdx: u32 = 0; EltIdx != NumElts; EltIdx += 1 {
        if !DemandedElts[EltIdx] {
            continue;
        }
        let mut Mask: APInt = getOneBitSet(NumElts, EltIdx);
        if self.MaskedVectorIsZero(Op, Mask, Depth) {
            KnownZeroElements.setBit(EltIdx);
        }
    }
    return KnownZeroElements;
}

fn SelectionDAG::isSplatValue(self: *SelectionDAG, V: SDValue, DemandedElts: *APInt, UndefElts: *mut APInt, Depth: u32) -> bool {
    let mut Opcode: u32 = V.getOpcode();
    let mut VT: EVT = V.getValueType();
    assert!(VT.isVector(), "Vector type expected");
    assert!((!VT.isScalableVector() || DemandedElts.getBitWidth() == 1), "scalable demanded bits are ignored");
    if operator(DemandedElts) {
        return false;
    }
    if Depth >= MaxRecursionDepth {
        return false;
    }
    match Opcode {
        SPLAT_VECTOR => {
            UndefElts = if V.getOperand(0).isUndef() { getAllOnes(DemandedElts.getBitWidth()) } else { APInt { DemandedElts.getBitWidth(), 0, false, false } };
        },
        ADD => {
            SUB;
        },
        ABS => {
            ABS_MIN_POISON;
        },
        _ => {
            if Opcode >= BUILTIN_OP_END || Opcode == INTRINSIC_WO_CHAIN || Opcode == INTRINSIC_W_CHAIN || Opcode == INTRINSIC_VOID {
                return self.TLI.isSplatValueForTargetNode(V, DemandedElts, UndefElts, *self, Depth);
            }
        },
    }
    if VT.isScalableVector() {
        return false;
    }
    let mut NumElts: u32 = VT.getVectorNumElements();
    assert!(NumElts == DemandedElts.getBitWidth(), "Vector size mismatch");
    UndefElts = getZero(NumElts);
    match Opcode {
        BUILD_VECTOR => {
            let mut Scl: SDValue = SDValue {};
            for let mut i: u32 = 0; i != NumElts; i += 1 {
                let mut Op: SDValue = V.getOperand(i);
                if Op.isUndef() {
                    UndefElts.setBit(i);
                    continue;
                }
                if !DemandedElts[i] {
                    continue;
                }
                if Scl && Scl != Op {
                    return false;
                }
                Scl = Op;
            }
            return true;
        },
        VECTOR_SHUFFLE => {
            let mut DemandedLHS: APInt = getZero(NumElts);
            let mut DemandedRHS: APInt = getZero(NumElts);
            let mut Mask: ArrayRef<int> = cast(V).getMask();
            for let mut i: i32 = 0; i != NumElts as i32; i += 1 {
                let mut M: i32 = Mask[i];
                if M < 0 {
                    UndefElts.setBit(i);
                    continue;
                }
                if !DemandedElts[i] {
                    continue;
                }
                if M < NumElts as i32 {
                    DemandedLHS.setBit(M);
                } else {
                    DemandedRHS.setBit(M - NumElts);
                }
            }
            if (DemandedLHS.isZero() && DemandedRHS.isZero()) || (!DemandedLHS.isZero() && !DemandedRHS.isZero()) {
                return false;
            }
            let mut CheckSplatSrc: Closure_5 = Closure_5 { cap_0: self, Depth: &mut Depth };
            if !DemandedLHS.isZero() {
                return CheckSplatSrc.call(V.getOperand(0), DemandedLHS);
            }
            return CheckSplatSrc.call(V.getOperand(1), DemandedRHS);
        },
        EXTRACT_SUBVECTOR => {
            let mut Src: SDValue = V.getOperand(0);
            if Src.getValueType().isScalableVector() {
                return false;
            }
            let mut Idx: u64 = V.getConstantOperandVal(1);
            let mut NumSrcElts: u32 = Src.getValueType().getVectorNumElements();
            let mut UndefSrcElts: APInt = APInt {};
            let mut DemandedSrcElts: APInt = DemandedElts.zext(NumSrcElts).shl(Idx);
            if self.isSplatValue(Src, DemandedSrcElts, UndefSrcElts, Depth + 1) {
                UndefElts = UndefSrcElts.extractBits(NumElts, Idx);
                return true;
            }
            break;
        },
        ANY_EXTEND_VECTOR_INREG => {
            SIGN_EXTEND_VECTOR_INREG;
        },
        BITCAST => {
            let mut Src: SDValue = V.getOperand(0);
            let mut SrcVT: EVT = Src.getValueType();
            let mut SrcBitWidth: u32 = SrcVT.getScalarSizeInBits();
            let mut BitWidth: u32 = VT.getScalarSizeInBits();
            if !SrcVT.isVector() || !SrcVT.isInteger() || !VT.isInteger() {
                break;
            }
            if (BitWidth % SrcBitWidth) == 0 {
                let mut Scale: u32 = BitWidth / SrcBitWidth;
                let mut NumSrcElts: u32 = SrcVT.getVectorNumElements();
                let mut ScaledDemandedElts: APInt = ScaleBitMask(DemandedElts, NumSrcElts, false);
                for let mut I: u32 = 0; I != Scale; I += 1 {
                    let mut SubUndefElts: APInt = APInt {};
                    let mut SubDemandedElt: APInt = getOneBitSet(Scale, I);
                    let mut SubDemandedElts: APInt = getSplat(NumSrcElts, SubDemandedElt);
                    operator(SubDemandedElts, ScaledDemandedElts);
                    if !self.isSplatValue(Src, SubDemandedElts, SubUndefElts, Depth + 1) {
                        return false;
                    }
                    if !SubUndefElts.isZero() {
                        return false;
                    }
                }
                return true;
            }
            break;
        },
    }
    return false;
}

fn SelectionDAG::isSplatValue(self: *SelectionDAG, V: SDValue, AllowUndefs: bool) -> bool {
    let mut VT: EVT = V.getValueType();
    assert!(VT.isVector(), "Vector type expected");
    let mut UndefElts: APInt = APInt {};
    let mut DemandedElts: APInt = getAllOnes(if VT.isScalableVector() { 1 } else { VT.getVectorNumElements() });
    return self.isSplatValue(V, DemandedElts, UndefElts, 0) && (AllowUndefs || operator(UndefElts));
}

fn SelectionDAG::getSplatSourceVector(self, V: SDValue, SplatIdx: *mut i32) -> SDValue {
    V = peekThroughExtractSubvectors(V);
    let mut VT: EVT = V.getValueType();
    let mut Opcode: u32 = V.getOpcode();
    match Opcode {
        _ => {
            let mut UndefElts: APInt = APInt {};
            let mut DemandedElts: APInt = getAllOnes(if VT.isScalableVector() { 1 } else { VT.getVectorNumElements() });
            if self.isSplatValue(V, DemandedElts, UndefElts, 0) {
                if VT.isScalableVector() {
                    SplatIdx = 0;
                } else {
                    if DemandedElts.isSubsetOf(UndefElts) {
                        SplatIdx = 0;
                        return self.getUNDEF(VT);
                    }
                    SplatIdx = (UndefElts & DemandedElts).countr_one();
                }
                return V;
            }
            break;
        },
        SPLAT_VECTOR => {
            SplatIdx = 0;
        },
        VECTOR_SHUFFLE => {
            assert!(!VT.isScalableVector());
            let mut SVN: *mut ShuffleVectorSDNode = cast(V);
            if !SVN.isSplat() {
                break;
            }
            let mut Idx: i32 = SVN.getSplatIndex();
            let mut NumElts: i32 = V.getValueType().getVectorNumElements();
            SplatIdx = Idx % NumElts;
            return V.getOperand(Idx / NumElts);
        },
    }
    return SDValue {};
}

fn SelectionDAG::getSplatValue(self, V: SDValue, LegalTypes: bool) -> SDValue {
    let mut SplatIdx: i32 = 0;
    if self.getSplatSourceVector(V, SplatIdx) {
        SrcVector;
    } else {
        let mut SVT: EVT = SrcVector.getValueType().getScalarType();
        let mut LegalSVT: EVT = SVT;
        if LegalTypes && !self.TLI.isTypeLegal(SVT) {
            if !SVT.isInteger() {
                return SDValue {};
            }
            LegalSVT = self.TLI.getTypeToTransformTo(*self.getContext(), LegalSVT);
            if LegalSVT.bitsLT(SVT) {
                return SDValue {};
            }
        }
        return self.getExtractVectorElt(SDLoc { V }, LegalSVT, SrcVector, SplatIdx);
    }
    return SDValue {};
}

fn SelectionDAG::getValidShiftAmountRange(self: *SelectionDAG, V: SDValue, DemandedElts: *APInt, Depth: u32) -> optional<ConstantRange> {
    assert!((V.getOpcode() == SHL || V.getOpcode() == SRL || V.getOpcode() == SRA), "Unknown shift node");
    let mut BitWidth: u32 = V.getScalarValueSizeInBits();
    if dyn_cast(V.getOperand(1)) {
        Cst;
    } else {
        let mut ShAmt: *APInt = Cst.getAPIntValue();
        if ShAmt.uge(BitWidth) {
            return optional<ConstantRange> { nullopt };
        }
        return optional<ConstantRange> { ConstantRange { ShAmt } };
    }
    if dyn_cast(V.getOperand(1)) {
        BV;
    } else {
        let mut MinAmt: *APInt = null;
        let mut MaxAmt: *APInt = null;
        for let mut i: u32 = 0;
let mut e: u32 = BV.getNumOperands(); i != e; i += 1 {
            if !DemandedElts[i] {
                continue;
            }
            let mut SA: *mut ConstantSDNode = dyn_cast(BV.getOperand(i));
            if !SA {
                MinAmt = MaxAmt = null;
                break;
            }
            let mut ShAmt: *APInt = SA.getAPIntValue();
            if ShAmt.uge(BitWidth) {
                return optional<ConstantRange> { nullopt };
            }
            if !MinAmt || MinAmt.ugt(ShAmt) {
                MinAmt = &mut ShAmt;
            }
            if !MaxAmt || MaxAmt.ult(ShAmt) {
                MaxAmt = &mut ShAmt;
            }
        }
        assert!(((!MinAmt && !MaxAmt) || (MinAmt && MaxAmt)), "Failed to find matching min/max shift amounts");
        if MinAmt && MaxAmt {
            return optional<ConstantRange> { ConstantRange { Lower: *MinAmt, Upper: *MaxAmt + 1 } };
        }
    }
    let mut KnownAmt: KnownBits = self.computeKnownBits(V.getOperand(1), DemandedElts, Depth);
    if KnownAmt.getMaxValue().ult(BitWidth) {
        return optional<ConstantRange> { fromKnownBits(KnownAmt, false) };
    }
    return optional<ConstantRange> { nullopt };
}

fn SelectionDAG::getValidShiftAmount(self: *SelectionDAG, V: SDValue, DemandedElts: *APInt, Depth: u32) -> optional<unsigned int> {
    assert!((V.getOpcode() == SHL || V.getOpcode() == SRL || V.getOpcode() == SRA), "Unknown shift node");
    if self.getValidShiftAmountRange(V, DemandedElts, Depth) {
        AmtRange;
    } else if operator(AmtRange).getSingleElement() {
        ShAmt;
    } else {
        return optional<unsigned int> { ShAmt.getZExtValue() };
    }
    return optional<unsigned int> { nullopt };
}

fn SelectionDAG::getValidShiftAmount(self: *SelectionDAG, V: SDValue, Depth: u32) -> optional<unsigned int> {
    let mut DemandedElts: APInt = getDemandAllEltsMask(V);
    return self.getValidShiftAmount(V, DemandedElts, Depth);
}

fn SelectionDAG::getValidMinimumShiftAmount(self: *SelectionDAG, V: SDValue, DemandedElts: *APInt, Depth: u32) -> optional<unsigned int> {
    assert!((V.getOpcode() == SHL || V.getOpcode() == SRL || V.getOpcode() == SRA), "Unknown shift node");
    if self.getValidShiftAmountRange(V, DemandedElts, Depth) {
        AmtRange;
    } else {
        return optional<unsigned int> { operator(AmtRange).getUnsignedMin().getZExtValue() };
    }
    return optional<unsigned int> { nullopt };
}

fn SelectionDAG::getValidMinimumShiftAmount(self: *SelectionDAG, V: SDValue, Depth: u32) -> optional<unsigned int> {
    let mut DemandedElts: APInt = getDemandAllEltsMask(V);
    return self.getValidMinimumShiftAmount(V, DemandedElts, Depth);
}

fn SelectionDAG::getValidMaximumShiftAmount(self: *SelectionDAG, V: SDValue, DemandedElts: *APInt, Depth: u32) -> optional<unsigned int> {
    assert!((V.getOpcode() == SHL || V.getOpcode() == SRL || V.getOpcode() == SRA), "Unknown shift node");
    if self.getValidShiftAmountRange(V, DemandedElts, Depth) {
        AmtRange;
    } else {
        return optional<unsigned int> { operator(AmtRange).getUnsignedMax().getZExtValue() };
    }
    return optional<unsigned int> { nullopt };
}

fn SelectionDAG::getValidMaximumShiftAmount(self: *SelectionDAG, V: SDValue, Depth: u32) -> optional<unsigned int> {
    let mut DemandedElts: APInt = getDemandAllEltsMask(V);
    return self.getValidMaximumShiftAmount(V, DemandedElts, Depth);
}

fn SelectionDAG::computeKnownBits(self: *SelectionDAG, Op: SDValue, Depth: u32) -> KnownBits {
    let mut DemandedElts: APInt = getDemandAllEltsMask(Op);
    return self.computeKnownBits(Op, DemandedElts, Depth);
}

fn SelectionDAG::computeKnownBits(self: *SelectionDAG, Op: SDValue, DemandedElts: *APInt, Depth: u32) -> KnownBits {
    let mut BitWidth: u32 = Op.getScalarValueSizeInBits();
    let mut Known: KnownBits = KnownBits { BitWidth };
    if operator(Op).bitcastToAPInt() {
        OptAPInt;
    } else {
        let mut V: APInt = operator(move(OptAPInt));
        if self.getDataLayout().isBigEndian() && Op.getValueType() == EVT { ppcf128 } {
            V = V.rotl(64);
        }
        return makeConstant(V);
    }
    if Depth >= MaxRecursionDepth {
        return Known;
    }
    let mut Known2: KnownBits = KnownBits {};
    let mut NumElts: u32 = DemandedElts.getBitWidth();
    assert!((!Op.getValueType().isScalableVector() || NumElts == 1), "DemandedElts for scalable vectors must be 1 to represent all lanes");
    assert!((!Op.getValueType().isFixedLengthVector() || NumElts == Op.getValueType().getVectorNumElements()), "Unexpected vector size");
    if operator(DemandedElts) {
        return Known;
    }
    let mut Opcode: u32 = Op.getOpcode();
    match Opcode {
        FREEZE => {
            if self.isGuaranteedNotToBeUndefOrPoison(Op.getOperand(0), DemandedElts, UndefOrPoison, 0) {
                Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            }
            break;
        },
        MERGE_VALUES => {
            return self.computeKnownBits(Op.getOperand(Op.getResNo()), DemandedElts, Depth + 1);
        },
        SPLAT_VECTOR => {
            let mut SrcOp: SDValue = Op.getOperand(0);
            assert!(SrcOp.getValueSizeInBits().operator unsigned long long() >= BitWidth, "Expected SPLAT_VECTOR implicit truncation");
            Known = self.computeKnownBits(SrcOp, Depth + 1).trunc(BitWidth);
            break;
        },
        SPLAT_VECTOR_PARTS => {
            let mut ScalarSize: u32 = Op.getOperand(0).getScalarValueSizeInBits();
            assert!(ScalarSize * Op.getNumOperands() == BitWidth, "Expected SPLAT_VECTOR_PARTS scalars to cover element width");
            for x in enumerate(operator(Op).ops()) {
                Known.insertBits(self.computeKnownBits(SrcOp.operator const llvm::SDValue &(), Depth + 1), ScalarSize * I);
            }
            break;
        },
        STEP_VECTOR => {
            let mut Step: *APInt = Op.getConstantOperandAPInt(0);
            if Step.isPowerOf2() {
                Known.Zero.setLowBits(Step.logBase2());
            }
            let mut F: *Function = self.getMachineFunction().getFunction();
            if !isUIntN(BitWidth, Op.getValueType().getVectorMinNumElements()) {
                break;
            }
            let mut MinNumElts: APInt = APInt { BitWidth, Op.getValueType().getVectorMinNumElements(), false, false };
            let mut Overflow: bool = false;
            let mut MaxNumElts: APInt = getVScaleRange(&mut F, BitWidth).getUnsignedMax().umul_ov(MinNumElts, Overflow);
            if Overflow {
                break;
            }
            let mut MaxValue: APInt = (MaxNumElts - 1).umul_ov(Step, Overflow);
            if Overflow {
                break;
            }
            Known.Zero.setHighBits(MaxValue.countl_zero());
            break;
        },
        BUILD_VECTOR => {
            assert!(!Op.getValueType().isScalableVector());
        },
        VECTOR_COMPRESS => {
            let mut Vec: SDValue = Op.getOperand(0);
            let mut PassThru: SDValue = Op.getOperand(2);
            Known = self.computeKnownBits(PassThru, DemandedElts, Depth + 1);
            if Known.isUnknown() {
                break;
            }
            Known2 = self.computeKnownBits(Vec, Depth + 1);
            Known = Known.intersectWith(Known2);
            break;
        },
        VECTOR_SHUFFLE => {
            assert!(!Op.getValueType().isScalableVector());
            let mut DemandedLHS: APInt = APInt {};
            let mut DemandedRHS: APInt = APInt {};
            let mut SVN: *ShuffleVectorSDNode = cast(Op);
            assert!(NumElts == SVN.getMask().len, "Unexpected vector size");
            if !getShuffleDemandedElts(NumElts, SVN.getMask(), DemandedElts, DemandedLHS, DemandedRHS, false) {
                break;
            }
            Known.setAllConflict();
            if !operator(DemandedLHS) {
                let mut LHS: SDValue = Op.getOperand(0);
                Known2 = self.computeKnownBits(LHS, DemandedLHS, Depth + 1);
                Known = Known.intersectWith(Known2);
            }
            if Known.isUnknown() {
                break;
            }
            if !operator(DemandedRHS) {
                let mut RHS: SDValue = Op.getOperand(1);
                Known2 = self.computeKnownBits(RHS, DemandedRHS, Depth + 1);
                Known = Known.intersectWith(Known2);
            }
            break;
        },
        VSCALE => {
            let mut F: *Function = self.getMachineFunction().getFunction();
            let mut Multiplier: *APInt = Op.getConstantOperandAPInt(0);
            Known = getVScaleRange(&mut F, BitWidth).multiply(ConstantRange { Multiplier }, 0).toKnownBits();
            break;
        },
        CONCAT_VECTORS => {
            if Op.getValueType().isScalableVector() {
                break;
            }
            Known.setAllConflict();
            let mut SubVectorVT: EVT = Op.getOperand(0).getValueType();
            let mut NumSubVectorElts: u32 = SubVectorVT.getVectorNumElements();
            let mut NumSubVectors: u32 = Op.getNumOperands();
            for let mut i: u32 = 0; i != NumSubVectors; i += 1 {
                let mut DemandedSub: APInt = DemandedElts.extractBits(NumSubVectorElts, i * NumSubVectorElts);
                if !operator(DemandedSub) {
                    let mut Sub: SDValue = Op.getOperand(i);
                    Known2 = self.computeKnownBits(Sub, DemandedSub, Depth + 1);
                    Known = Known.intersectWith(Known2);
                }
                if Known.isUnknown() {
                    break;
                }
            }
            break;
        },
        INSERT_SUBVECTOR => {
            if Op.getValueType().isScalableVector() {
                break;
            }
            let mut Src: SDValue = Op.getOperand(0);
            let mut Sub: SDValue = Op.getOperand(1);
            let mut Idx: u64 = Op.getConstantOperandVal(2);
            let mut NumSubElts: u32 = Sub.getValueType().getVectorNumElements();
            let mut DemandedSubElts: APInt = DemandedElts.extractBits(NumSubElts, Idx);
            let mut DemandedSrcElts: APInt = DemandedElts;
            DemandedSrcElts.clearBits(Idx, Idx + NumSubElts);
            Known.setAllConflict();
            if !operator(DemandedSubElts) {
                Known = self.computeKnownBits(Sub, DemandedSubElts, Depth + 1);
                if Known.isUnknown() {
                    break;
                }
            }
            if !operator(DemandedSrcElts) {
                Known2 = self.computeKnownBits(Src, DemandedSrcElts, Depth + 1);
                Known = Known.intersectWith(Known2);
            }
            break;
        },
        EXTRACT_SUBVECTOR => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut DemandedSrcElts: APInt = APInt {};
            if Src.getValueType().isScalableVector() {
                DemandedSrcElts = APInt { 1, 1, false, false };
            } else {
                let mut Idx: u64 = Op.getConstantOperandVal(1);
                let mut NumSrcElts: u32 = Src.getValueType().getVectorNumElements();
                DemandedSrcElts = DemandedElts.zext(NumSrcElts).shl(Idx);
            }
            Known = self.computeKnownBits(Src, DemandedSrcElts, Depth + 1);
            break;
        },
        SCALAR_TO_VECTOR => {
            if Op.getValueType().isScalableVector() {
                break;
            }
            if DemandedElts != 1 {
                break;
            }
            let mut N0: SDValue = Op.getOperand(0);
            Known = self.computeKnownBits(N0, Depth + 1);
            if N0.getValueSizeInBits().operator unsigned long long() != BitWidth {
                Known = Known.trunc(BitWidth);
            }
            break;
        },
        BITCAST => {
            if Op.getValueType().isScalableVector() {
                break;
            }
            let mut N0: SDValue = Op.getOperand(0);
            let mut SubVT: EVT = N0.getValueType();
            let mut SubBitWidth: u32 = SubVT.getScalarSizeInBits();
            if !(SubVT.isInteger() || SubVT.isFloatingPoint()) {
                break;
            }
            if BitWidth == SubBitWidth {
                Known = self.computeKnownBits(N0, DemandedElts, Depth + 1);
                break;
            }
            let mut IsLE: bool = self.getDataLayout().isLittleEndian();
            if (BitWidth % SubBitWidth) == 0 {
                assert!(N0.getValueType().isVector(), "Expected bitcast from vector");
                let mut SubScale: u32 = BitWidth / SubBitWidth;
                let mut SubDemandedElts: APInt = APInt { NumElts * SubScale, 0, false, false };
                for let mut i: u32 = 0; i != NumElts; i += 1 {
                    if DemandedElts[i] {
                        SubDemandedElts.setBit(i * SubScale);
                    }
                }
                for let mut i: u32 = 0; i != SubScale; i += 1 {
                    Known2 = self.computeKnownBits(N0, SubDemandedElts.shl(i), Depth + 1);
                    let mut Shifts: u32 = if IsLE { i } else { SubScale - 1 - i };
                    Known.insertBits(Known2, SubBitWidth * Shifts);
                }
            }
            if (SubBitWidth % BitWidth) == 0 {
                assert!(Op.getValueType().isVector(), "Expected bitcast to vector");
                let mut SubScale: u32 = SubBitWidth / BitWidth;
                let mut SubDemandedElts: APInt = ScaleBitMask(DemandedElts, NumElts / SubScale, false);
                Known2 = self.computeKnownBits(N0, SubDemandedElts, Depth + 1);
                Known.setAllConflict();
                for let mut i: u32 = 0; i != NumElts; i += 1 {
                    if DemandedElts[i] {
                        let mut Shifts: u32 = if IsLE { i } else { NumElts - 1 - i };
                        let mut Offset: u32 = (Shifts % SubScale) * BitWidth;
                        Known = Known.intersectWith(Known2.extractBits(BitWidth, Offset));
                        if Known.isUnknown() {
                            break;
                        }
                    }
                }
            }
            break;
        },
        AND => {
            Known = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
        },
        OR => {
            Known = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
        },
        XOR => {
            Known = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
        },
        MUL => {
            Known = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            let mut SelfMultiply: bool = Op.getOperand(0) == Op.getOperand(1);
            if SelfMultiply {
                SelfMultiply &= self.isGuaranteedNotToBeUndefOrPoison(Op.getOperand(0), DemandedElts, UndefOrPoison, Depth + 1);
            }
            Known = mul(Known, Known2, SelfMultiply);
            if operator(Op).getFlags().hasNoSignedWrap() && Op.getOperand(0) == Op.getOperand(1) && !Known.isNegative() {
                Known.makeNonNegative();
            }
            break;
        },
        MULHU => {
            Known = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known = mulhu(Known, Known2);
            break;
        },
        MULHS => {
            Known = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known = mulhs(Known, Known2);
            break;
        },
        ABDU => {
            Known = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known = abdu(Known, Known2);
            break;
        },
        ABDS => {
            Known = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known = abds(Known, Known2);
            let mut SignBits1: u32 = self.ComputeNumSignBits(Op.getOperand(1), DemandedElts, Depth + 1);
            if SignBits1 == 1 {
                break;
            }
            let mut SignBits0: u32 = self.ComputeNumSignBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known.Zero.setHighBits(if SignBits0 < SignBits1 { SignBits0 } else { SignBits1 } - 1);
            break;
        },
        UMUL_LOHI => {
            assert!((Op.getResNo() == 0 || Op.getResNo() == 1), "Unknown result");
            Known = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            let mut SelfMultiply: bool = Op.getOperand(0) == Op.getOperand(1);
            if Op.getResNo() == 0 {
                Known = mul(Known, Known2, SelfMultiply);
            } else {
                Known = mulhu(Known, Known2);
            }
            break;
        },
        SMUL_LOHI => {
            assert!((Op.getResNo() == 0 || Op.getResNo() == 1), "Unknown result");
            Known = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            let mut SelfMultiply: bool = Op.getOperand(0) == Op.getOperand(1);
            if Op.getResNo() == 0 {
                Known = mul(Known, Known2, SelfMultiply);
            } else {
                Known = mulhs(Known, Known2);
            }
            break;
        },
        AVGFLOORU => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known = avgFloorU(Known, Known2);
            break;
        },
        AVGCEILU => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known = avgCeilU(Known, Known2);
            break;
        },
        AVGFLOORS => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known = avgFloorS(Known, Known2);
            break;
        },
        AVGCEILS => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known = avgCeilS(Known, Known2);
            break;
        },
        SELECT => {
            VSELECT;
        },
        SELECT_CC => {
            Known = self.computeKnownBits(Op.getOperand(3), DemandedElts, Depth + 1);
        },
        SMULO => {
            UMULO;
        },
        SETCC => {
            SETCCCARRY;
        },
        SHL => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            let mut NUW: bool = operator(Op).getFlags().hasNoUnsignedWrap();
            let mut NSW: bool = operator(Op).getFlags().hasNoSignedWrap();
            let mut ShAmtNonZero: bool = Known2.isNonZero();
            Known = shl(Known, Known2, NUW, NSW, ShAmtNonZero);
            if self.getValidMinimumShiftAmount(Op, DemandedElts, Depth + 1) {
                ShMinAmt;
            } else {
                Known.Zero.setLowBits(operator(ShMinAmt));
            }
            break;
        },
        SRL => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
        },
        SRA => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
        },
        ROTL => {
            ROTR;
        },
        FSHL => {
            FSHR;
        },
        SHL_PARTS => {
            SRA_PARTS;
        },
        SIGN_EXTEND_INREG => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            let mut EVT: EVT = cast(Op.getOperand(1)).getVT();
            Known = Known.sextInReg(EVT.getScalarSizeInBits());
            break;
        },
        CTTZ => {
            CTTZ_ZERO_POISON;
        },
        CTLZ => {
            CTLZ_ZERO_POISON;
        },
        CTLS => {
            let mut MinRedundantSignBits: u32 = self.ComputeNumSignBits(Op.getOperand(0), DemandedElts, Depth + 1) - 1;
            let mut Range: ConstantRange = ConstantRange { Lower: APInt { BitWidth, MinRedundantSignBits, false, false }, Upper: APInt { BitWidth, BitWidth, false, false } };
            Known = Range.toKnownBits();
            break;
        },
        CTPOP => {
            Known2 = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            let mut PossibleOnes: u32 = Known2.countMaxPopulation();
            Known.Zero.setBitsFrom(bit_width(PossibleOnes));
            break;
        },
        PARITY => {
            Known.Zero.setBitsFrom(1);
            break;
        },
        PDEP => {
            Known = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known = pdep(Known2, Known);
            break;
        },
        PEXT => {
            Known = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known = pext(Known2, Known);
            break;
        },
        CLMUL => {
            Known = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known = clmul(Known, Known2);
            break;
        },
        MGATHER => {
            MLOAD;
        },
        LOAD => {
            let mut LD: *mut LoadSDNode = cast(Op);
            let mut Cst: *Constant = self.TLI.getTargetConstantFromLoad(LD);
            if isNON_EXTLoad(LD) && Cst {
                let mut CstTy: *mut Type = Cst.getType();
                if (NumElts * BitWidth) == CstTy.getPrimitiveSizeInBits().operator unsigned long long() && !Op.getValueType().isScalableVector() {
                    if CstTy.isVectorTy() {
                        if Cst.getSplatValue(false) {
                            Splat;
                        } else {
                            Cst = Splat;
                            CstTy = Cst.getType();
                        }
                    }
                    if CstTy.isVectorTy() && BitWidth == CstTy.getScalarSizeInBits() {
                        Known.setAllConflict();
                        for let mut i: u32 = 0; i != NumElts; i += 1 {
                            if !DemandedElts[i] {
                                continue;
                            }
                            if Cst.getAggregateElement(i) {
                                Elt;
                            } else {
                                if dyn_cast(Elt) {
                                    CInt;
                                } else {
                                    let mut Value: *APInt = CInt.getValue();
                                    operator(Known.One, Value);
                                    operator(Known.Zero, operator(Value));
                                    continue;
                                }
                                if dyn_cast(Elt) {
                                    CFP;
                                } else {
                                    let mut Value: APInt = CFP.getValueAPF().bitcastToAPInt();
                                    operator(Known.One, Value);
                                    operator(Known.Zero, operator(Value));
                                    continue;
                                }
                            }
                            Known.One.clearAllBits();
                            Known.Zero.clearAllBits();
                            break;
                        }
                    } else if BitWidth == CstTy.getPrimitiveSizeInBits().operator unsigned long long() {
                        if dyn_cast(Cst) {
                            CInt;
                        } else {
                            Known = makeConstant(CInt.getValue());
                        }
                    }
                }
            } else if Op.getResNo() == 0 {
                let mut ScalarMemorySize: u32 = LD.getMemoryVT().getScalarSizeInBits();
                let mut KnownScalarMemory: KnownBits = KnownBits { ScalarMemorySize };
                if LD.getRanges() {
                    MD;
                } else {
                    computeKnownBitsFromRangeMetadata(*MD, KnownScalarMemory);
                }
                if isZEXTLoad(Op.getNode()) {
                    Known = KnownScalarMemory.zext(BitWidth);
                } else if isSEXTLoad(Op.getNode()) {
                    Known = KnownScalarMemory.sext(BitWidth);
                } else if isEXTLoad(Op.getNode()) {
                    Known = KnownScalarMemory.anyext(BitWidth);
                } else {
                    Known = KnownScalarMemory;
                }
                assert!(Known.getBitWidth() == BitWidth);
                return Known;
            }
            break;
        },
        ZERO_EXTEND_VECTOR_INREG => {
            if Op.getValueType().isScalableVector() {
                break;
            }
            let mut InVT: EVT = Op.getOperand(0).getValueType();
            let mut InDemandedElts: APInt = DemandedElts.zext(InVT.getVectorNumElements());
            Known = self.computeKnownBits(Op.getOperand(0), InDemandedElts, Depth + 1);
            Known = Known.zext(BitWidth);
            break;
        },
        ZERO_EXTEND => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known = Known.zext(BitWidth);
            break;
        },
        SIGN_EXTEND_VECTOR_INREG => {
            if Op.getValueType().isScalableVector() {
                break;
            }
            let mut InVT: EVT = Op.getOperand(0).getValueType();
            let mut InDemandedElts: APInt = DemandedElts.zext(InVT.getVectorNumElements());
            Known = self.computeKnownBits(Op.getOperand(0), InDemandedElts, Depth + 1);
            Known = Known.sext(BitWidth);
            break;
        },
        SIGN_EXTEND => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known = Known.sext(BitWidth);
            break;
        },
        ANY_EXTEND_VECTOR_INREG => {
            if Op.getValueType().isScalableVector() {
                break;
            }
            let mut InVT: EVT = Op.getOperand(0).getValueType();
            let mut InDemandedElts: APInt = DemandedElts.zext(InVT.getVectorNumElements());
            Known = self.computeKnownBits(Op.getOperand(0), InDemandedElts, Depth + 1);
            Known = Known.anyext(BitWidth);
            break;
        },
        ANY_EXTEND => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known = Known.anyext(BitWidth);
            break;
        },
        TRUNCATE => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known = Known.trunc(BitWidth);
            break;
        },
        TRUNCATE_SSAT_S => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known = Known.truncSSat(BitWidth);
            break;
        },
        TRUNCATE_SSAT_U => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known = Known.truncSSatU(BitWidth);
            break;
        },
        TRUNCATE_USAT_U => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known = Known.truncUSat(BitWidth);
            break;
        },
        AssertZext => {
            let mut VT: EVT = cast(Op.getOperand(1)).getVT();
            let mut InMask: APInt = getLowBitsSet(BitWidth, VT.getSizeInBits().operator unsigned long long());
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            operator(Known.Zero, (operator(InMask)));
            operator(Known.One, (operator(Known.Zero)));
            break;
        },
        AssertAlign => {
            let mut LogOfAlign: u32 = Log2(cast(Op).getAlign());
            assert!(LogOfAlign != 0);
            Known.Zero.setLowBits(LogOfAlign);
            Known.One.clearLowBits(LogOfAlign);
            break;
        },
        AssertNoFPClass => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            let mut NoFPClass: FPClassTest = Op.getConstantOperandVal(1) as FPClassTest;
            let mut NegativeTestMask: FPClassTest = fcNan | fcNegative;
            if (NoFPClass & NegativeTestMask) == NegativeTestMask {
                Known.makeNonNegative();
            }
            let mut PositiveTestMask: FPClassTest = fcNan | fcPositive;
            if (NoFPClass & PositiveTestMask) == PositiveTestMask {
                Known.makeNegative();
            }
            break;
        },
        FABS => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
        },
        FGETSIGN => {
            Known.Zero.setBitsFrom(1);
        },
        ADD => {
            let mut Flags: SDNodeFlags = Op.getNode().getFlags();
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            let mut SelfAdd: bool = Op.getOperand(0) == Op.getOperand(1) && self.isGuaranteedNotToBeUndefOrPoison(Op.getOperand(0), DemandedElts, UndefOrPoison, Depth + 1);
            Known = add(Known, Known2, Flags.hasNoSignedWrap(), Flags.hasNoUnsignedWrap(), SelfAdd);
            break;
        },
        SUB => {
            let mut Flags: SDNodeFlags = Op.getNode().getFlags();
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known = sub(Known, Known2, Flags.hasNoSignedWrap(), Flags.hasNoUnsignedWrap());
            break;
        },
        USUBO => {
            SSUBO;
        },
        SUBC => {
            assert!(Op.getResNo() == 0, "We only compute knownbits for the difference here.");
            let mut Borrow: KnownBits = KnownBits { 1 };
            if Opcode == USUBO_CARRY || Opcode == SSUBO_CARRY {
                Borrow = self.computeKnownBits(Op.getOperand(2), DemandedElts, Depth + 1);
                Borrow = Borrow.trunc(1);
            } else {
                Borrow.setAllZero();
            }
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known = computeForSubBorrow(Known, Known2, Borrow);
            break;
        },
        UADDO => {
            SADDO;
        },
        ADDC => {
            ADDE;
        },
        UDIV => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known = udiv(Known, Known2, operator(Op).getFlags().hasExact());
            break;
        },
        SDIV => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known = sdiv(Known, Known2, operator(Op).getFlags().hasExact());
            break;
        },
        SREM => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known = srem(Known, Known2);
            break;
        },
        UREM => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known = urem(Known, Known2);
            break;
        },
        EXTRACT_ELEMENT => {
            Known = self.computeKnownBits(Op.getOperand(0), Depth + 1);
            let mut Index: u32 = Op.getConstantOperandVal(1);
            let mut EltBitWidth: u32 = Op.getValueSizeInBits().operator unsigned long long();
            Known = Known.extractBits(EltBitWidth, Index * EltBitWidth);
            break;
        },
        EXTRACT_VECTOR_ELT => {
            let mut InVec: SDValue = Op.getOperand(0);
            let mut EltNo: SDValue = Op.getOperand(1);
            let mut VecVT: EVT = InVec.getValueType();
            if VecVT.isScalableVector() {
                break;
            }
            let mut EltBitWidth: u32 = VecVT.getScalarSizeInBits();
            let mut NumSrcElts: u32 = VecVT.getVectorNumElements();
            if BitWidth > EltBitWidth {
                Known = Known.trunc(EltBitWidth);
            }
            let mut DemandedSrcElts: APInt = getAllOnes(NumSrcElts);
            let mut ConstEltNo: *mut ConstantSDNode = dyn_cast(EltNo);
            if ConstEltNo && ConstEltNo.getAPIntValue().ult(NumSrcElts) {
                DemandedSrcElts = getOneBitSet(NumSrcElts, ConstEltNo.getZExtValue());
            }
            Known = self.computeKnownBits(InVec, DemandedSrcElts, Depth + 1);
            if BitWidth > EltBitWidth {
                Known = Known.anyext(BitWidth);
            }
            break;
        },
        BUILD_PAIR => {
            Known = self.computeKnownBits(Op.getOperand(0), Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(1), Depth + 1);
            Known = Known2.concat(Known);
            break;
        },
        INSERT_VECTOR_ELT => {
            if Op.getValueType().isScalableVector() {
                break;
            }
            let mut InVec: SDValue = Op.getOperand(0);
            let mut InVal: SDValue = Op.getOperand(1);
            let mut EltNo: SDValue = Op.getOperand(2);
            let mut DemandedVal: bool = true;
            let mut DemandedVecElts: APInt = DemandedElts;
            let mut CEltNo: *mut ConstantSDNode = dyn_cast(EltNo);
            if CEltNo && CEltNo.getAPIntValue().ult(NumElts) {
                let mut EltIdx: u32 = CEltNo.getZExtValue();
                DemandedVal = !!DemandedElts[EltIdx];
                DemandedVecElts.clearBit(EltIdx);
            }
            Known.setAllConflict();
            if DemandedVal {
                Known2 = self.computeKnownBits(InVal, Depth + 1);
                Known = Known.intersectWith(Known2.zextOrTrunc(BitWidth));
            }
            if !operator(DemandedVecElts) {
                Known2 = self.computeKnownBits(InVec, DemandedVecElts, Depth + 1);
                Known = Known.intersectWith(Known2);
            }
            break;
        },
        BITREVERSE => {
            Known2 = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known = Known2.reverseBits();
            break;
        },
        BSWAP => {
            Known2 = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known = Known2.byteSwap();
            break;
        },
        ABS => {
            ABS_MIN_POISON;
        },
        USUBSAT => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known = usub_sat(Known, Known2);
            break;
        },
        UMIN => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known = umin(Known, Known2);
            break;
        },
        UMAX => {
            Known = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            Known2 = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            Known = umax(Known, Known2);
            break;
        },
        SMIN => {
            SMAX;
        },
        UINT_TO_FP => {
            Known.makeNonNegative();
            break;
        },
        SINT_TO_FP => {
            Known2 = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            if Known2.isNonNegative() {
                Known.makeNonNegative();
            } else if Known2.isNegative() {
                Known.makeNegative();
            }
            break;
        },
        FP_TO_UINT_SAT => {
            let mut VT: EVT = cast(Op.getOperand(1)).getVT();
            operator(Known.Zero, getBitsSetFrom(BitWidth, VT.getScalarSizeInBits()));
            break;
        },
        ATOMIC_LOAD => {
            if Op.getResNo() == 0 {
                let mut AT: *mut AtomicSDNode = cast(Op);
                let mut ScalarMemorySize: u32 = AT.getMemoryVT().getScalarSizeInBits();
                let mut KnownScalarMemory: KnownBits = KnownBits { ScalarMemorySize };
                if AT.getRanges() {
                    MD;
                } else {
                    computeKnownBitsFromRangeMetadata(*MD, KnownScalarMemory);
                }
                match AT.getExtensionType() {
                    ZEXTLOAD => {
                        Known = KnownScalarMemory.zext(BitWidth);
                    },
                    SEXTLOAD => {
                        Known = KnownScalarMemory.sext(BitWidth);
                    },
                    EXTLOAD => {
                        match self.TLI.getExtendForAtomicOps() {
                            ZERO_EXTEND => {
                                Known = KnownScalarMemory.zext(BitWidth);
                            },
                            SIGN_EXTEND => {
                                Known = KnownScalarMemory.sext(BitWidth);
                            },
                            _ => {
                                Known = KnownScalarMemory.anyext(BitWidth);
                            },
                        }
                    },
                    NON_EXTLOAD => {
                        Known = KnownScalarMemory;
                    },
                }
                assert!(Known.getBitWidth() == BitWidth);
            }
            break;
        },
        ATOMIC_CMP_SWAP_WITH_SUCCESS => {
            if Op.getResNo() == 1 {
                if self.TLI.getBooleanContents(Op.getValueType().isVector(), false) == ZeroOrOneBooleanContent && BitWidth > 1 {
                    Known.Zero.setBitsFrom(1);
                }
                break;
            }
        },
        ATOMIC_CMP_SWAP => {
            ATOMIC_SWAP;
        },
        FrameIndex => {
            TargetFrameIndex;
        },
        VP_LOAD_FF => {
            if Op.getResNo() != 1 {
                break;
            }
            let mut VLKB: KnownBits = self.computeKnownBits(Op.getOperand(3), DemandedElts, Depth + 1);
            let mut ResVT: EVT = operator(Op).getValueType(0);
            let mut ResKB: KnownBits = makeConstant(APInt { BitWidth, ResVT.getVectorMinNumElements(), false, false });
            if ResVT.isScalableVector() {
                let mut F: *Function = self.getMachineFunction().getFunction();
                ResKB = mul(getVScaleRange(&mut F, BitWidth).toKnownBits(), ResKB, false);
            }
            Known.Zero.setHighBits(umin(VLKB, ResKB).countMinLeadingZeros());
            break;
        },
        _ => {
            if Opcode < BUILTIN_OP_END {
                break;
            }
        },
        INTRINSIC_WO_CHAIN => {
            INTRINSIC_W_CHAIN;
        },
    }
    return Known;
}

fn mapOverflowResult(OR: OverflowResult) -> OverflowKind {
    match OR {
        MayOverflow => {
            return OFK_Sometime;
        },
        AlwaysOverflowsLow => {
            AlwaysOverflowsHigh;
        },
        NeverOverflows => {
            return OFK_Never;
        },
    }
    llvm_unreachable_internal("Unknown OverflowResult", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAG.cpp", 4606);
}

fn SelectionDAG::computeOverflowForSignedAdd(self: *SelectionDAG, N0: SDValue, N1: SDValue) -> OverflowKind {
    if isNullConstant(N1) {
        return OFK_Never;
    }
    if self.ComputeNumSignBits(N0, 0) > 1 && self.ComputeNumSignBits(N1, 0) > 1 {
        return OFK_Never;
    }
    return OFK_Sometime;
}

fn SelectionDAG::computeOverflowForUnsignedAdd(self: *SelectionDAG, N0: SDValue, N1: SDValue) -> OverflowKind {
    if isNullConstant(N1) {
        return OFK_Never;
    }
    let mut N1Known: KnownBits = self.computeKnownBits(N1, 0);
    if N0.getOpcode() == UMUL_LOHI && N0.getResNo() == 1 && N1Known.getMaxValue().ult(2) {
        return OFK_Never;
    }
    let mut N0Known: KnownBits = self.computeKnownBits(N0, 0);
    if N1.getOpcode() == UMUL_LOHI && N1.getResNo() == 1 && N0Known.getMaxValue().ult(2) {
        return OFK_Never;
    }
    let mut N0Range: ConstantRange = fromKnownBits(N0Known, false);
    let mut N1Range: ConstantRange = fromKnownBits(N1Known, false);
    return mapOverflowResult(N0Range.unsignedAddMayOverflow(N1Range));
}

fn SelectionDAG::computeOverflowForSignedSub(self: *SelectionDAG, N0: SDValue, N1: SDValue) -> OverflowKind {
    if isNullConstant(N1) {
        return OFK_Never;
    }
    if self.ComputeNumSignBits(N0, 0) > 1 && self.ComputeNumSignBits(N1, 0) > 1 {
        return OFK_Never;
    }
    let mut N0Known: KnownBits = self.computeKnownBits(N0, 0);
    let mut N1Known: KnownBits = self.computeKnownBits(N1, 0);
    let mut N0Range: ConstantRange = fromKnownBits(N0Known, true);
    let mut N1Range: ConstantRange = fromKnownBits(N1Known, true);
    return mapOverflowResult(N0Range.signedSubMayOverflow(N1Range));
}

fn SelectionDAG::computeOverflowForUnsignedSub(self: *SelectionDAG, N0: SDValue, N1: SDValue) -> OverflowKind {
    if isNullConstant(N1) {
        return OFK_Never;
    }
    let mut N0Range: ConstantRange = self.computeConstantRangeIncludingKnownBits(N0, false, 0);
    let mut N1Range: ConstantRange = self.computeConstantRangeIncludingKnownBits(N1, false, 0);
    return mapOverflowResult(N0Range.unsignedSubMayOverflow(N1Range));
}

fn SelectionDAG::computeOverflowForUnsignedMul(self: *SelectionDAG, N0: SDValue, N1: SDValue) -> OverflowKind {
    if isNullConstant(N1) || isOneConstant(N1) {
        return OFK_Never;
    }
    let mut N0Range: ConstantRange = self.computeConstantRangeIncludingKnownBits(N0, false, 0);
    let mut N1Range: ConstantRange = self.computeConstantRangeIncludingKnownBits(N1, false, 0);
    return mapOverflowResult(N0Range.unsignedMulMayOverflow(N1Range));
}

fn SelectionDAG::computeOverflowForSignedMul(self: *SelectionDAG, N0: SDValue, N1: SDValue) -> OverflowKind {
    if isNullConstant(N1) || isOneConstant(N1) {
        return OFK_Never;
    }
    let mut BitWidth: u32 = N0.getScalarValueSizeInBits();
    let mut SignBits: u32 = self.ComputeNumSignBits(N0, 0) + self.ComputeNumSignBits(N1, 0);
    if SignBits > BitWidth + 1 {
        return OFK_Never;
    }
    if SignBits == BitWidth + 1 {
        let mut N0Known: KnownBits = self.computeKnownBits(N0, 0);
        let mut N1Known: KnownBits = self.computeKnownBits(N1, 0);
        if N0Known.isNonNegative() || N1Known.isNonNegative() {
            return OFK_Never;
        }
    }
    return OFK_Sometime;
}

fn SelectionDAG::computeConstantRange(self: *SelectionDAG, Op: SDValue, ForSigned: bool, Depth: u32) -> ConstantRange {
    let mut DemandedElts: APInt = getDemandAllEltsMask(Op);
    return self.computeConstantRange(Op, DemandedElts, ForSigned, Depth);
}

fn SelectionDAG::computeConstantRange(self: *SelectionDAG, Op: SDValue, DemandedElts: *APInt, ForSigned: bool, Depth: u32) -> ConstantRange {
    let mut VT: EVT = Op.getValueType();
    let mut BitWidth: u32 = VT.getScalarSizeInBits();
    if Depth >= MaxRecursionDepth {
        return getFull(BitWidth);
    }
    if isConstOrConstSplat(Op, DemandedElts, false, false) {
        C;
    } else {
        return ConstantRange { C.getAPIntValue() };
    }
    let mut Opcode: u32 = Op.getOpcode();
    match Opcode {
        VSCALE => {
            let mut F: *Function = self.getMachineFunction().getFunction();
            let mut Multiplier: *APInt = Op.getConstantOperandAPInt(0);
            return getVScaleRange(&mut F, BitWidth).multiply(ConstantRange { Multiplier }, 0);
        },
        _ => {
            break;
        },
    }
    return getFull(BitWidth);
}

fn SelectionDAG::computeConstantRangeIncludingKnownBits(self: *SelectionDAG, Op: SDValue, ForSigned: bool, Depth: u32) -> ConstantRange {
    let mut DemandedElts: APInt = getDemandAllEltsMask(Op);
    return self.computeConstantRangeIncludingKnownBits(Op, DemandedElts, ForSigned, Depth);
}

fn SelectionDAG::computeConstantRangeIncludingKnownBits(self: *SelectionDAG, Op: SDValue, DemandedElts: *APInt, ForSigned: bool, Depth: u32) -> ConstantRange {
    let mut Known: KnownBits = self.computeKnownBits(Op, DemandedElts, Depth);
    let mut CR1: ConstantRange = fromKnownBits(Known, ForSigned);
    let mut CR2: ConstantRange = self.computeConstantRange(Op, DemandedElts, ForSigned, Depth);
    let mut RangeType: PreferredRangeType = if ForSigned { Signed } else { Unsigned };
    return CR1.intersectWith(CR2, RangeType);
}

fn SelectionDAG::isKnownToBeAPowerOfTwo(self: *SelectionDAG, Val: SDValue, OrZero: bool, Depth: u32) -> bool {
    let mut DemandedElts: APInt = getDemandAllEltsMask(Val);
    return self.isKnownToBeAPowerOfTwo(Val, DemandedElts, OrZero, Depth);
}

fn SelectionDAG::isKnownToBeAPowerOfTwo(self: *SelectionDAG, Val: SDValue, DemandedElts: *APInt, OrZero: bool, Depth: u32) -> bool {
    if Depth >= MaxRecursionDepth {
        return false;
    }
    let mut OpVT: EVT = Val.getValueType();
    let mut BitWidth: u32 = OpVT.getScalarSizeInBits();
    let mut NumElts: u32 = DemandedElts.getBitWidth();
    assert!((!OpVT.isScalableVector() || NumElts == 1), "DemandedElts for scalable vectors must be 1 to represent all lanes");
    assert!((!OpVT.isFixedLengthVector() || NumElts == OpVT.getVectorNumElements()), "Unexpected vector size");
    let mut IsPowerOfTwoOrZero: Closure_6 = Closure_6 { BitWidth: BitWidth, OrZero: OrZero };
    if matchUnaryPredicate(Val, DemandedElts, function<bool (ConstantSDNode *)> { IsPowerOfTwoOrZero }, false, true) {
        return true;
    }
    match Val.getOpcode() {
        EXTRACT_VECTOR_ELT => {
            let mut InVec: SDValue = Val.getOperand(0);
            let mut EltNo: SDValue = Val.getOperand(1);
            let mut VecVT: EVT = InVec.getValueType();
            if VecVT.isScalableVector() || OpVT.getScalarSizeInBits() != VecVT.getScalarSizeInBits() {
                break;
            }
            let mut NumSrcElts: u32 = VecVT.getVectorNumElements();
            let mut ConstEltNo: *mut ConstantSDNode = dyn_cast(EltNo);
            let mut DemandedSrcElts: APInt = if ConstEltNo && ConstEltNo.getAPIntValue().ult(NumSrcElts) { getOneBitSet(NumSrcElts, ConstEltNo.getZExtValue()) } else { getAllOnes(NumSrcElts) };
            return self.isKnownToBeAPowerOfTwo(InVec, DemandedSrcElts, OrZero, Depth + 1);
        },
        AND => {
            let mut X: SDValue = SDValue {};
            let mut Z: SDValue = SDValue {};
            if sd_match(Val, m_And(m_Value(X), m_Neg(m_Deferred(X)))) || (sd_match(Val, m_And(m_Value(X), m_Sub(m_Value(Z), m_Deferred(X)))) && self.MaskedVectorIsZero(Z, DemandedElts, Depth + 1)) {
                return OrZero || self.isKnownNeverZero(X, DemandedElts, Depth);
            }
            break;
        },
        SHL => {
            let mut C: *mut ConstantSDNode = isConstOrConstSplat(Val.getOperand(0), DemandedElts, false, false);
            if C && C.getAPIntValue() == 1 {
                return true;
            }
            return (OrZero || self.isKnownNeverZero(Val, DemandedElts, Depth)) && self.isKnownToBeAPowerOfTwo(Val.getOperand(0), DemandedElts, OrZero, Depth + 1);
        },
        SRL => {
            let mut C: *mut ConstantSDNode = isConstOrConstSplat(Val.getOperand(0), DemandedElts, false, false);
            if C && C.getAPIntValue().isSignMask() {
                return true;
            }
            return (OrZero || self.isKnownNeverZero(Val, DemandedElts, Depth)) && self.isKnownToBeAPowerOfTwo(Val.getOperand(0), DemandedElts, OrZero, Depth + 1);
        },
        TRUNCATE => {
            return (OrZero || self.isKnownNeverZero(Val, DemandedElts, Depth)) && self.isKnownToBeAPowerOfTwo(Val.getOperand(0), DemandedElts, OrZero, Depth + 1);
        },
        ROTL => {
            ROTR;
        },
        BSWAP => {
            BITREVERSE;
        },
        SMIN => {
            SMAX;
        },
        SELECT => {
            VSELECT;
        },
        ZERO_EXTEND => {
            return self.isKnownToBeAPowerOfTwo(Val.getOperand(0), DemandedElts, OrZero, Depth + 1);
        },
        VSCALE => {
            return self.isKnownToBeAPowerOfTwo(Val.getOperand(0), false, Depth + 1);
        },
        VECTOR_SHUFFLE => {
            assert!(!Val.getValueType().isScalableVector());
            let mut DemandedLHS: APInt = APInt {};
            let mut DemandedRHS: APInt = APInt {};
            let mut SVN: *ShuffleVectorSDNode = cast(Val);
            assert!(NumElts == SVN.getMask().len, "Unexpected vector size");
            if !getShuffleDemandedElts(NumElts, SVN.getMask(), DemandedElts, DemandedLHS, DemandedRHS, false) {
                return false;
            }
            if !operator(DemandedLHS) && !self.isKnownToBeAPowerOfTwo(Val.getOperand(0), DemandedLHS, OrZero, Depth + 1) {
                return false;
            }
            if !operator(DemandedRHS) && !self.isKnownToBeAPowerOfTwo(Val.getOperand(1), DemandedRHS, OrZero, Depth + 1) {
                return false;
            }
            return true;
        },
    }
    return false;
}

fn SelectionDAG::isKnownToBeAPowerOfTwoFP(self: *SelectionDAG, Val: SDValue, Depth: u32) -> bool {
    if isConstOrConstSplatFP(Val, true) {
        C1;
    } else {
        return C1.getValueAPF().getExactLog2Abs() >= 0;
    }
    if Val.getOpcode() == UINT_TO_FP || Val.getOpcode() == SINT_TO_FP {
        return self.isKnownToBeAPowerOfTwo(Val.getOperand(0), Depth + 1, 0);
    }
    return false;
}

fn SelectionDAG::ComputeNumSignBits(self: *SelectionDAG, Op: SDValue, Depth: u32) -> u32 {
    let mut DemandedElts: APInt = getDemandAllEltsMask(Op);
    return self.ComputeNumSignBits(Op, DemandedElts, Depth);
}

fn SelectionDAG::ComputeNumSignBits(self: *SelectionDAG, Op: SDValue, DemandedElts: *APInt, Depth: u32) -> u32 {
    let mut VT: EVT = Op.getValueType();
    assert!((VT.isInteger() || VT.isFloatingPoint()), "Invalid VT!");
    let mut VTBits: u32 = VT.getScalarSizeInBits();
    let mut NumElts: u32 = DemandedElts.getBitWidth();
    let mut Tmp: u32 = 0;
    let mut Tmp2: u32 = 0;
    let mut FirstAnswer: u32 = 1;
    assert!((!VT.isScalableVector() || NumElts == 1), "DemandedElts for scalable vectors must be 1 to represent all lanes");
    if dyn_cast(Op) {
        C;
    } else {
        let mut Val: *APInt = C.getAPIntValue();
        return Val.getNumSignBits();
    }
    if Depth >= MaxRecursionDepth {
        return 1;
    }
    if operator(DemandedElts) {
        return 1;
    }
    let mut Opcode: u32 = Op.getOpcode();
    match Opcode {
        _ => {
            break;
        },
        AssertSext => {
            Tmp = cast(Op.getOperand(1)).getVT().getSizeInBits().operator unsigned long long();
        },
        AssertZext => {
            Tmp = cast(Op.getOperand(1)).getVT().getSizeInBits().operator unsigned long long();
        },
        FREEZE => {
            if self.isGuaranteedNotToBeUndefOrPoison(Op.getOperand(0), DemandedElts, UndefOrPoison, 0) {
                return self.ComputeNumSignBits(Op.getOperand(0), DemandedElts, Depth + 1);
            }
        },
        MERGE_VALUES => {
            return self.ComputeNumSignBits(Op.getOperand(Op.getResNo()), DemandedElts, Depth + 1);
        },
        SPLAT_VECTOR => {
            let mut NumSrcBits: u32 = Op.getOperand(0).getValueSizeInBits().operator unsigned long long();
            let mut NumSrcSignBits: u32 = self.ComputeNumSignBits(Op.getOperand(0), Depth + 1);
            if NumSrcSignBits > (NumSrcBits - VTBits) {
                return NumSrcSignBits - (NumSrcBits - VTBits);
            }
            break;
        },
        BUILD_VECTOR => {
            assert!(!VT.isScalableVector());
        },
        VECTOR_COMPRESS => {
            let mut Vec: SDValue = Op.getOperand(0);
            let mut PassThru: SDValue = Op.getOperand(2);
            Tmp = self.ComputeNumSignBits(PassThru, DemandedElts, Depth + 1);
            if Tmp == 1 {
                return 1;
            }
            Tmp2 = self.ComputeNumSignBits(Vec, Depth + 1);
            Tmp = if Tmp < Tmp2 { Tmp } else { Tmp2 };
            return Tmp;
        },
        VECTOR_SHUFFLE => {
            let mut DemandedLHS: APInt = APInt {};
            let mut DemandedRHS: APInt = APInt {};
            let mut SVN: *ShuffleVectorSDNode = cast(Op);
            assert!(NumElts == SVN.getMask().len, "Unexpected vector size");
            if !getShuffleDemandedElts(NumElts, SVN.getMask(), DemandedElts, DemandedLHS, DemandedRHS, false) {
                return 1;
            }
            Tmp = max();
            if !operator(DemandedLHS) {
                Tmp = self.ComputeNumSignBits(Op.getOperand(0), DemandedLHS, Depth + 1);
            }
            if !operator(DemandedRHS) {
                Tmp2 = self.ComputeNumSignBits(Op.getOperand(1), DemandedRHS, Depth + 1);
                Tmp = if Tmp < Tmp2 { Tmp } else { Tmp2 };
            }
            if Tmp == 1 {
                break;
            }
            assert!(Tmp <= VTBits, "Failed to determine minimum sign bits");
            return Tmp;
        },
        BITCAST => {
            if VT.isScalableVector() {
                break;
            }
            let mut N0: SDValue = Op.getOperand(0);
            let mut SrcVT: EVT = N0.getValueType();
            let mut SrcBits: u32 = SrcVT.getScalarSizeInBits();
            if !(SrcVT.isInteger() || SrcVT.isFloatingPoint()) {
                break;
            }
            if VTBits == SrcBits {
                return self.ComputeNumSignBits(N0, DemandedElts, Depth + 1);
            }
            let mut IsLE: bool = self.getDataLayout().isLittleEndian();
            if (SrcBits % VTBits) == 0 {
                assert!(VT.isVector(), "Expected bitcast to vector");
                let mut Scale: u32 = SrcBits / VTBits;
                let mut SrcDemandedElts: APInt = ScaleBitMask(DemandedElts, NumElts / Scale, false);
                Tmp = self.ComputeNumSignBits(N0, SrcDemandedElts, Depth + 1);
                if Tmp == SrcBits {
                    return VTBits;
                }
                Tmp2 = VTBits;
                for let mut i: u32 = 0; i != NumElts; i += 1 {
                    if DemandedElts[i] {
                        let mut SubOffset: u32 = i % Scale;
                        SubOffset = (if IsLE { ((Scale - 1) - SubOffset) } else { SubOffset });
                        SubOffset = SubOffset * VTBits;
                        if Tmp <= SubOffset {
                            return 1;
                        }
                        Tmp2 = if Tmp2 < Tmp - SubOffset { Tmp2 } else { Tmp - SubOffset };
                    }
                }
                return Tmp2;
            }
            break;
        },
        FP_TO_SINT_SAT => {
            Tmp = cast(Op.getOperand(1)).getVT().getScalarSizeInBits();
        },
        SIGN_EXTEND => {
            Tmp = VTBits - Op.getOperand(0).getScalarValueSizeInBits();
        },
        SIGN_EXTEND_INREG => {
            Tmp = cast(Op.getOperand(1)).getVT().getScalarSizeInBits();
        },
        SIGN_EXTEND_VECTOR_INREG => {
            if VT.isScalableVector() {
                break;
            }
            let mut Src: SDValue = Op.getOperand(0);
            let mut SrcVT: EVT = Src.getValueType();
            let mut DemandedSrcElts: APInt = DemandedElts.zext(SrcVT.getVectorNumElements());
            Tmp = VTBits - SrcVT.getScalarSizeInBits();
            return self.ComputeNumSignBits(Src, DemandedSrcElts, Depth + 1) + Tmp;
        },
        SRA => {
            Tmp = self.ComputeNumSignBits(Op.getOperand(0), DemandedElts, Depth + 1);
        },
        SHL => {
            if self.getValidShiftAmountRange(Op, DemandedElts, Depth + 1) {
                ShAmtRange;
            } else {
                let mut MaxShAmt: u32 = operator(ShAmtRange).getUnsignedMax().getZExtValue();
                let mut MinShAmt: u32 = operator(ShAmtRange).getUnsignedMin().getZExtValue();
                if isExtOpcode(Op.getOperand(0).getOpcode()) {
                    let mut Ext: SDValue = Op.getOperand(0);
                    let mut ExtVT: EVT = Ext.getValueType();
                    let mut Extendee: SDValue = Ext.getOperand(0);
                    let mut ExtendeeVT: EVT = Extendee.getValueType();
                    let mut SizeDifference: u32 = ExtVT.getScalarSizeInBits() - ExtendeeVT.getScalarSizeInBits();
                    if SizeDifference <= MinShAmt {
                        Tmp = SizeDifference + self.ComputeNumSignBits(Extendee, DemandedElts, Depth + 1);
                        if MaxShAmt < Tmp {
                            return Tmp - MaxShAmt;
                        }
                    }
                }
                Tmp = self.ComputeNumSignBits(Op.getOperand(0), DemandedElts, Depth + 1);
                if MaxShAmt < Tmp {
                    return Tmp - MaxShAmt;
                }
            }
        },
        AND => {
            OR;
        },
        SELECT => {
            VSELECT;
        },
        SELECT_CC => {
            Tmp = self.ComputeNumSignBits(Op.getOperand(2), DemandedElts, Depth + 1);
        },
        SMIN => {
            SMAX;
        },
        UMIN => {
            UMAX;
        },
        SSUBO_CARRY => {
            USUBO_CARRY;
        },
        SADDO => {
            UADDO;
        },
        SETCC => {
            SETCCCARRY;
        },
        GET_ACTIVE_LANE_MASK => {
            if self.TLI.getBooleanContents(VT.isVector(), false) == ZeroOrNegativeOneBooleanContent {
                return VTBits;
            }
        },
        ROTL => {
            ROTR;
        },
        ADD => {
            ADDC;
        },
        SUB => {
            Tmp2 = self.ComputeNumSignBits(Op.getOperand(1), DemandedElts, Depth + 1);
        },
        MUL => {
            let mut SignBitsOp0: u32 = self.ComputeNumSignBits(Op.getOperand(0), Depth + 1);
            if SignBitsOp0 == 1 {
                break;
            }
            let mut SignBitsOp1: u32 = self.ComputeNumSignBits(Op.getOperand(1), Depth + 1);
            if SignBitsOp1 == 1 {
                break;
            }
            let mut OutValidBits: u32 = (VTBits - SignBitsOp0 + 1) + (VTBits - SignBitsOp1 + 1);
            return if OutValidBits > VTBits { 1 } else { VTBits - OutValidBits + 1 };
        },
        AVGCEILS => {
            AVGFLOORS;
        },
        SREM => {
            return self.ComputeNumSignBits(Op.getOperand(0), DemandedElts, Depth + 1);
        },
        TRUNCATE => {
            let mut NumSrcBits: u32 = Op.getOperand(0).getScalarValueSizeInBits();
            let mut NumSrcSignBits: u32 = self.ComputeNumSignBits(Op.getOperand(0), Depth + 1);
            if NumSrcSignBits > (NumSrcBits - VTBits) {
                return NumSrcSignBits - (NumSrcBits - VTBits);
            }
            break;
        },
        EXTRACT_ELEMENT => {
            if VT.isScalableVector() {
                break;
            }
            let mut KnownSign: i32 = self.ComputeNumSignBits(Op.getOperand(0), Depth + 1);
            let mut BitWidth: i32 = Op.getValueSizeInBits().operator unsigned long long();
            let mut Items: i32 = Op.getOperand(0).getValueSizeInBits().operator unsigned long long() / BitWidth;
            let mut rIndex: i32 = Items - 1 - Op.getConstantOperandVal(1);
            return clamp(KnownSign - rIndex * BitWidth, 1, BitWidth);
        },
        INSERT_VECTOR_ELT => {
            if VT.isScalableVector() {
                break;
            }
            let mut InVec: SDValue = Op.getOperand(0);
            let mut InVal: SDValue = Op.getOperand(1);
            let mut EltNo: SDValue = Op.getOperand(2);
            let mut DemandedVal: bool = true;
            let mut DemandedVecElts: APInt = DemandedElts;
            let mut CEltNo: *mut ConstantSDNode = dyn_cast(EltNo);
            if CEltNo && CEltNo.getAPIntValue().ult(NumElts) {
                let mut EltIdx: u32 = CEltNo.getZExtValue();
                DemandedVal = !!DemandedElts[EltIdx];
                DemandedVecElts.clearBit(EltIdx);
            }
            Tmp = max();
            if DemandedVal {
                if InVal.getScalarValueSizeInBits() != VTBits {
                    break;
                }
                Tmp2 = self.ComputeNumSignBits(InVal, Depth + 1);
                Tmp = if Tmp < Tmp2 { Tmp } else { Tmp2 };
            }
            if !operator(DemandedVecElts) {
                Tmp2 = self.ComputeNumSignBits(InVec, DemandedVecElts, Depth + 1);
                Tmp = if Tmp < Tmp2 { Tmp } else { Tmp2 };
            }
            assert!(Tmp <= VTBits, "Failed to determine minimum sign bits");
            return Tmp;
        },
        EXTRACT_VECTOR_ELT => {
            let mut InVec: SDValue = Op.getOperand(0);
            let mut EltNo: SDValue = Op.getOperand(1);
            let mut VecVT: EVT = InVec.getValueType();
            if VecVT.isScalableVector() {
                break;
            }
            let mut BitWidth: u32 = Op.getValueSizeInBits().operator unsigned long long();
            let mut EltBitWidth: u32 = Op.getOperand(0).getScalarValueSizeInBits();
            let mut NumSrcElts: u32 = VecVT.getVectorNumElements();
            if BitWidth != EltBitWidth {
                break;
            }
            let mut DemandedSrcElts: APInt = getAllOnes(NumSrcElts);
            let mut ConstEltNo: *mut ConstantSDNode = dyn_cast(EltNo);
            if ConstEltNo && ConstEltNo.getAPIntValue().ult(NumSrcElts) {
                DemandedSrcElts = getOneBitSet(NumSrcElts, ConstEltNo.getZExtValue());
            }
            return self.ComputeNumSignBits(InVec, DemandedSrcElts, Depth + 1);
        },
        EXTRACT_SUBVECTOR => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut DemandedSrcElts: APInt = APInt {};
            if Src.getValueType().isScalableVector() {
                DemandedSrcElts = APInt { 1, 1, false, false };
            } else {
                let mut Idx: u64 = Op.getConstantOperandVal(1);
                let mut NumSrcElts: u32 = Src.getValueType().getVectorNumElements();
                DemandedSrcElts = DemandedElts.zext(NumSrcElts).shl(Idx);
            }
            return self.ComputeNumSignBits(Src, DemandedSrcElts, Depth + 1);
        },
        CONCAT_VECTORS => {
            if VT.isScalableVector() {
                break;
            }
            Tmp = max();
            let mut SubVectorVT: EVT = Op.getOperand(0).getValueType();
            let mut NumSubVectorElts: u32 = SubVectorVT.getVectorNumElements();
            let mut NumSubVectors: u32 = Op.getNumOperands();
            for let mut i: u32 = 0; (i < NumSubVectors) && (Tmp > 1); i += 1 {
                let mut DemandedSub: APInt = DemandedElts.extractBits(NumSubVectorElts, i * NumSubVectorElts);
                if operator(DemandedSub) {
                    continue;
                }
                Tmp2 = self.ComputeNumSignBits(Op.getOperand(i), DemandedSub, Depth + 1);
                Tmp = if Tmp < Tmp2 { Tmp } else { Tmp2 };
            }
            assert!(Tmp <= VTBits, "Failed to determine minimum sign bits");
            return Tmp;
        },
        INSERT_SUBVECTOR => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut Sub: SDValue = Op.getOperand(1);
            if VT.isScalableVector() {
                Tmp = self.ComputeNumSignBits(Sub, Depth + 1);
                Tmp = if Tmp < self.ComputeNumSignBits(Src, Depth + 1) { Tmp } else { self.ComputeNumSignBits(Src, Depth + 1) };
                return Tmp;
            }
            let mut Idx: u64 = Op.getConstantOperandVal(2);
            let mut NumSubElts: u32 = Sub.getValueType().getVectorNumElements();
            let mut DemandedSubElts: APInt = DemandedElts.extractBits(NumSubElts, Idx);
            let mut DemandedSrcElts: APInt = DemandedElts;
            DemandedSrcElts.clearBits(Idx, Idx + NumSubElts);
            Tmp = max();
            if !operator(DemandedSubElts) {
                Tmp = self.ComputeNumSignBits(Sub, DemandedSubElts, Depth + 1);
                if Tmp == 1 {
                    return 1;
                }
            }
            if !operator(DemandedSrcElts) {
                Tmp2 = self.ComputeNumSignBits(Src, DemandedSrcElts, Depth + 1);
                Tmp = if Tmp < Tmp2 { Tmp } else { Tmp2 };
            }
            assert!(Tmp <= VTBits, "Failed to determine minimum sign bits");
            return Tmp;
        },
        LOAD => {
            if Op.getResNo() != 0 {
                break;
            }
            let mut LD: *mut LoadSDNode = cast(Op);
            if LD.getRanges() {
                Ranges;
            } else {
                if DemandedElts != 1 {
                    break;
                }
                let mut CR: ConstantRange = getConstantRangeFromMetadata(*Ranges);
                if VTBits > CR.getBitWidth() {
                    match LD.getExtensionType() {
                        SEXTLOAD => {
                            CR = CR.signExtend(VTBits);
                        },
                        ZEXTLOAD => {
                            CR = CR.zeroExtend(VTBits);
                        },
                        _ => {
                            break;
                        },
                    }
                }
                if VTBits != CR.getBitWidth() {
                    break;
                }
                return if CR.getSignedMin().getNumSignBits() < CR.getSignedMax().getNumSignBits() { CR.getSignedMin().getNumSignBits() } else { CR.getSignedMax().getNumSignBits() };
            }
            let mut ExtType: u32 = LD.getExtensionType();
            match ExtType {
                _ => {
                    break;
                },
                SEXTLOAD => {
                    Tmp = LD.getMemoryVT().getScalarSizeInBits();
                },
                ZEXTLOAD => {
                    Tmp = LD.getMemoryVT().getScalarSizeInBits();
                },
                NON_EXTLOAD => {
                    if self.TLI.getTargetConstantFromLoad(LD) {
                        Cst;
                    } else {
                        let mut CstTy: *mut Type = Cst.getType();
                        if CstTy.isVectorTy() && !VT.isScalableVector() && (NumElts * VTBits) == CstTy.getPrimitiveSizeInBits().operator unsigned long long() && VTBits == CstTy.getScalarSizeInBits() {
                            Tmp = VTBits;
                            for let mut i: u32 = 0; i != NumElts; i += 1 {
                                if !DemandedElts[i] {
                                    continue;
                                }
                                if Cst.getAggregateElement(i) {
                                    Elt;
                                } else {
                                    if dyn_cast(Elt) {
                                        CInt;
                                    } else {
                                        let mut Value: *APInt = CInt.getValue();
                                        Tmp = if Tmp < Value.getNumSignBits() { Tmp } else { Value.getNumSignBits() };
                                        continue;
                                    }
                                    if dyn_cast(Elt) {
                                        CFP;
                                    } else {
                                        let mut Value: APInt = CFP.getValueAPF().bitcastToAPInt();
                                        Tmp = if Tmp < Value.getNumSignBits() { Tmp } else { Value.getNumSignBits() };
                                        continue;
                                    }
                                }
                                return 1;
                            }
                            return Tmp;
                        }
                    }
                },
            }
            break;
        },
        ATOMIC_CMP_SWAP => {
            ATOMIC_CMP_SWAP_WITH_SUCCESS;
        },
    }
    if Opcode >= BUILTIN_OP_END || Opcode == INTRINSIC_WO_CHAIN || Opcode == INTRINSIC_W_CHAIN || Opcode == INTRINSIC_VOID {
        if !VT.isScalableVector() {
            let mut NumBits: u32 = self.TLI.ComputeNumSignBitsForTargetNode(Op, DemandedElts, *self, Depth);
            if NumBits > 1 {
                FirstAnswer = if FirstAnswer > NumBits { FirstAnswer } else { NumBits };
            }
        }
    }
    let mut Known: KnownBits = self.computeKnownBits(Op, DemandedElts, Depth);
    return if FirstAnswer > Known.countMinSignBits() { FirstAnswer } else { Known.countMinSignBits() };
}

fn SelectionDAG::ComputeMaxSignificantBits(self: *SelectionDAG, Op: SDValue, Depth: u32) -> u32 {
    let mut SignBits: u32 = self.ComputeNumSignBits(Op, Depth);
    return Op.getScalarValueSizeInBits() - SignBits + 1;
}

fn SelectionDAG::ComputeMaxSignificantBits(self: *SelectionDAG, Op: SDValue, DemandedElts: *APInt, Depth: u32) -> u32 {
    let mut SignBits: u32 = self.ComputeNumSignBits(Op, DemandedElts, Depth);
    return Op.getScalarValueSizeInBits() - SignBits + 1;
}

fn SelectionDAG::isGuaranteedNotToBeUndefOrPoison(self: *SelectionDAG, Op: SDValue, Kind: UndefPoisonKind, Depth: u32) -> bool {
    if Op.getOpcode() == FREEZE {
        return true;
    }
    let mut DemandedElts: APInt = getDemandAllEltsMask(Op);
    return self.isGuaranteedNotToBeUndefOrPoison(Op, DemandedElts, Kind, Depth);
}

fn SelectionDAG::isGuaranteedNotToBeUndefOrPoison(self: *SelectionDAG, Op: SDValue, DemandedElts: *APInt, Kind: UndefPoisonKind, Depth: u32) -> bool {
    let mut Opcode: u32 = Op.getOpcode();
    if Opcode == FREEZE {
        return true;
    }
    if Depth >= MaxRecursionDepth {
        return false;
    }
    if isIntOrFPConstant(Op) {
        return true;
    }
    match Opcode {
        CONDCODE => {
            VALUETYPE;
        },
        POISON => {
            return !includesPoison(Kind);
        },
        UNDEF => {
            return !includesUndef(Kind);
        },
        BITCAST => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut SrcVT: EVT = Src.getValueType();
            let mut DstVT: EVT = Op.getValueType();
            if !SrcVT.isVector() || !DstVT.isVector() {
                return self.isGuaranteedNotToBeUndefOrPoison(Src, Kind, Depth + 1);
            }
            let mut SrcEltBits: u32 = SrcVT.getScalarSizeInBits();
            let mut DstEltBits: u32 = DstVT.getScalarSizeInBits();
            let mut NumSrcElts: ElementCount = SrcVT.getVectorElementCount();
            let mut NumDstElts: ElementCount = DstVT.getVectorElementCount();
            if SrcEltBits == DstEltBits {
                return self.isGuaranteedNotToBeUndefOrPoison(Src, DemandedElts, Kind, Depth + 1);
            }
            if SrcEltBits < DstEltBits {
                if DstEltBits % SrcEltBits != 0 {
                    return self.isGuaranteedNotToBeUndefOrPoison(Src, Kind, Depth + 1);
                }
                assert!(NumSrcElts == NumDstElts * (DstEltBits / SrcEltBits), "Unexpected vector bitcast");
                let mut DemandedSrcElts: APInt = ScaleBitMask(DemandedElts, NumSrcElts.getKnownMinValue(), false);
                return self.isGuaranteedNotToBeUndefOrPoison(Src, DemandedSrcElts, Kind, Depth + 1);
            }
            if SrcEltBits % DstEltBits != 0 {
                return self.isGuaranteedNotToBeUndefOrPoison(Src, Kind, Depth + 1);
            }
            assert!(NumDstElts == NumSrcElts * (SrcEltBits / DstEltBits), "Unexpected vector bitcast");
            let mut DemandedSrcElts: APInt = ScaleBitMask(DemandedElts, NumSrcElts.getKnownMinValue(), false);
            return self.isGuaranteedNotToBeUndefOrPoison(Src, DemandedSrcElts, Kind, Depth + 1);
        },
        BUILD_VECTOR => {
            for let mut i: u32 = 0;
let mut e: u32 = Op.getNumOperands(); i < e; i += 1 {
                if !DemandedElts[i] {
                    continue;
                }
                if !self.isGuaranteedNotToBeUndefOrPoison(Op.getOperand(i), Kind, Depth + 1) {
                    return false;
                }
            }
        },
        CONCAT_VECTORS => {
            let mut VT: EVT = Op.getValueType();
            if !VT.isFixedLengthVector() {
                break;
            }
            let mut SubVT: EVT = Op.getOperand(0).getValueType();
            let mut NumSubElts: u32 = SubVT.getVectorNumElements();
            for let mut I: u32 = 0;
let mut E: u32 = Op.getNumOperands(); I != E; I += 1 {
                let mut DemandedSubElts: APInt = DemandedElts.extractBits(NumSubElts, I * NumSubElts);
                if !operator(DemandedSubElts) && !self.isGuaranteedNotToBeUndefOrPoison(Op.getOperand(I), DemandedSubElts, Kind, Depth + 1) {
                    return false;
                }
            }
            return true;
        },
        EXTRACT_SUBVECTOR => {
            let mut Src: SDValue = Op.getOperand(0);
            if Src.getValueType().isScalableVector() {
                break;
            }
            let mut Idx: u64 = Op.getConstantOperandVal(1);
            let mut NumSrcElts: u32 = Src.getValueType().getVectorNumElements();
            let mut DemandedSrcElts: APInt = DemandedElts.zext(NumSrcElts).shl(Idx);
            return self.isGuaranteedNotToBeUndefOrPoison(Src, DemandedSrcElts, Kind, Depth + 1);
        },
        INSERT_SUBVECTOR => {
            if Op.getValueType().isScalableVector() {
                break;
            }
            let mut Src: SDValue = Op.getOperand(0);
            let mut Sub: SDValue = Op.getOperand(1);
            let mut Idx: u64 = Op.getConstantOperandVal(2);
            let mut NumSubElts: u32 = Sub.getValueType().getVectorNumElements();
            let mut DemandedSubElts: APInt = DemandedElts.extractBits(NumSubElts, Idx);
            let mut DemandedSrcElts: APInt = DemandedElts;
            DemandedSrcElts.clearBits(Idx, Idx + NumSubElts);
            if !operator(DemandedSubElts) && !self.isGuaranteedNotToBeUndefOrPoison(Sub, DemandedSubElts, Kind, Depth + 1) {
                return false;
            }
            if !operator(DemandedSrcElts) && !self.isGuaranteedNotToBeUndefOrPoison(Src, DemandedSrcElts, Kind, Depth + 1) {
                return false;
            }
            return true;
        },
        EXTRACT_VECTOR_ELT => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut IndexC: *mut ConstantSDNode = dyn_cast(Op.getOperand(1));
            let mut SrcVT: EVT = Src.getValueType();
            if SrcVT.isFixedLengthVector() && IndexC && IndexC.getAPIntValue().ult(SrcVT.getVectorNumElements()) {
                let mut DemandedSrcElts: APInt = getOneBitSet(SrcVT.getVectorNumElements(), IndexC.getZExtValue());
                return self.isGuaranteedNotToBeUndefOrPoison(Src, DemandedSrcElts, Kind, Depth + 1);
            }
            break;
        },
        INSERT_VECTOR_ELT => {
            let mut InVec: SDValue = Op.getOperand(0);
            let mut InVal: SDValue = Op.getOperand(1);
            let mut EltNo: SDValue = Op.getOperand(2);
            let mut VT: EVT = InVec.getValueType();
            let mut IndexC: *mut ConstantSDNode = dyn_cast(EltNo);
            if IndexC && VT.isFixedLengthVector() && IndexC.getAPIntValue().ult(VT.getVectorNumElements()) {
                if DemandedElts[IndexC.getZExtValue()] && !self.isGuaranteedNotToBeUndefOrPoison(InVal, Kind, Depth + 1) {
                    return false;
                }
                let mut InVecDemandedElts: APInt = DemandedElts;
                InVecDemandedElts.clearBit(IndexC.getZExtValue());
                if !operator(InVecDemandedElts) && !self.isGuaranteedNotToBeUndefOrPoison(peekThroughInsertVectorElt(InVec, InVecDemandedElts), InVecDemandedElts, Kind, Depth + 1) {
                    return false;
                }
                return true;
            }
            break;
        },
        SCALAR_TO_VECTOR => {
            if DemandedElts.ugt(1) && includesPoison(Kind) {
                return false;
            }
        },
        SPLAT_VECTOR => {
            return self.isGuaranteedNotToBeUndefOrPoison(Op.getOperand(0), Kind, Depth + 1);
        },
        SELECT => {
            return !self.canCreateUndefOrPoison(Op, DemandedElts, Kind, true, Depth) && self.isGuaranteedNotToBeUndefOrPoison(Op.getOperand(0), Kind, Depth + 1) && self.isGuaranteedNotToBeUndefOrPoison(Op.getOperand(1), DemandedElts, Kind, Depth + 1) && self.isGuaranteedNotToBeUndefOrPoison(Op.getOperand(2), DemandedElts, Kind, Depth + 1);
        },
        VECTOR_SHUFFLE => {
            let mut DemandedLHS: APInt = APInt {};
            let mut DemandedRHS: APInt = APInt {};
            let mut SVN: *mut ShuffleVectorSDNode = cast(Op);
            if !getShuffleDemandedElts(DemandedElts.getBitWidth(), SVN.getMask(), DemandedElts, DemandedLHS, DemandedRHS, false) {
                return false;
            }
            if !DemandedLHS.isZero() && !self.isGuaranteedNotToBeUndefOrPoison(Op.getOperand(0), DemandedLHS, Kind, Depth + 1) {
                return false;
            }
            if !DemandedRHS.isZero() && !self.isGuaranteedNotToBeUndefOrPoison(Op.getOperand(1), DemandedRHS, Kind, Depth + 1) {
                return false;
            }
            return true;
        },
        SHL => {
            SRL;
        },
        BSWAP => {
            CTPOP;
        },
        _ => {
            if Opcode >= BUILTIN_OP_END || Opcode == INTRINSIC_WO_CHAIN || Opcode == INTRINSIC_W_CHAIN || Opcode == INTRINSIC_VOID {
                return self.TLI.isGuaranteedNotToBeUndefOrPoisonForTargetNode(Op, DemandedElts, *self, Kind, Depth);
            }
        },
    }
    return !self.canCreateUndefOrPoison(Op, Kind, true, Depth) && all_of(operator(Op).ops(), Closure_7 { cap_0: self, Kind: &mut Kind, Depth: &mut Depth });
}

fn SelectionDAG::canCreateUndefOrPoison(self: *SelectionDAG, Op: SDValue, Kind: UndefPoisonKind, ConsiderFlags: bool, Depth: u32) -> bool {
    let mut DemandedElts: APInt = getDemandAllEltsMask(Op);
    return self.canCreateUndefOrPoison(Op, DemandedElts, Kind, ConsiderFlags, Depth);
}

fn SelectionDAG::canCreateUndefOrPoison(self: *SelectionDAG, Op: SDValue, DemandedElts: *APInt, Kind: UndefPoisonKind, ConsiderFlags: bool, Depth: u32) -> bool {
    if ConsiderFlags && includesPoison(Kind) && operator(Op).hasPoisonGeneratingFlags() {
        return true;
    }
    let mut Opcode: u32 = Op.getOpcode();
    match Opcode {
        AssertSext => {
            AssertZext;
        },
        FREEZE => {
            CONCAT_VECTORS;
        },
        ABS => {
            return false;
        },
        ABS_MIN_POISON => {
            return self.ComputeNumSignBits(Op.getOperand(0), DemandedElts, Depth + 1) <= 1;
        },
        ADDC => {
            SUBC;
        },
        SELECT_CC => {
            SETCC;
        },
        OR => {
            ZERO_EXTEND;
        },
        SHL => {
            SRL;
        },
        CTTZ_ZERO_POISON => {
            CTLZ_ZERO_POISON;
        },
        SCALAR_TO_VECTOR => {
            return includesPoison(Kind) && DemandedElts.ugt(1);
        },
        INSERT_VECTOR_ELT => {
            EXTRACT_VECTOR_ELT;
        },
        VECTOR_SHUFFLE => {
            let mut SVN: *mut ShuffleVectorSDNode = cast(Op);
            for x in enumerate(SVN.getMask()) {
                if Elt < 0 && DemandedElts[Idx] {
                    return true;
                }
            }
            return false;
        },
        VECTOR_COMPRESS => {
            return false;
        },
        _ => {
            if Opcode >= BUILTIN_OP_END || Opcode == INTRINSIC_WO_CHAIN || Opcode == INTRINSIC_W_CHAIN || Opcode == INTRINSIC_VOID {
                return self.TLI.canCreateUndefOrPoisonForTargetNode(Op, DemandedElts, *self, Kind, ConsiderFlags, Depth);
            }
        },
    }
    return true;
}

fn SelectionDAG::isADDLike(self: *SelectionDAG, Op: SDValue, NoWrap: bool) -> bool {
    let mut Opcode: u32 = Op.getOpcode();
    if Opcode == OR {
        return operator(Op).getFlags().hasDisjoint() || self.haveNoCommonBitsSet(Op.getOperand(0), Op.getOperand(1));
    }
    if Opcode == XOR {
        return !NoWrap && isMinSignedConstant(Op.getOperand(1));
    }
    return false;
}

fn SelectionDAG::isBaseWithConstantOffset(self: *SelectionDAG, Op: SDValue) -> bool {
    return Op.getNumOperands() == 2 && isa(Op.getOperand(1)) && (Op.isAnyAdd() || self.isADDLike(Op, false));
}

fn SelectionDAG::computeKnownFPClass(self: *SelectionDAG, Op: SDValue, InterestedClasses: FPClassTest, Depth: u32) -> KnownFPClass {
    let mut DemandedElts: APInt = getDemandAllEltsMask(Op);
    return self.computeKnownFPClass(Op, DemandedElts, InterestedClasses, Depth);
}

fn SelectionDAG::computeKnownFPClass(self: *SelectionDAG, Op: SDValue, DemandedElts: *APInt, InterestedClasses: FPClassTest, Depth: u32) -> KnownFPClass {
    let mut Known: KnownFPClass = KnownFPClass { KnownFPClassesValue: fcAllFlags, SignBitValue: optional<bool> {} };
    if dyn_cast(Op) {
        CFP;
    } else {
        return KnownFPClass { CFP.getValueAPF() };
    }
    if Depth >= MaxRecursionDepth {
        return Known;
    }
    if Op.getOpcode() == UNDEF {
        return Known;
    }
    let mut VT: EVT = Op.getValueType();
    assert!(VT.isFloatingPoint(), "Computing KnownFPClass on non-FP op!");
    assert!((!VT.isFixedLengthVector() || DemandedElts.getBitWidth() == VT.getVectorNumElements()), "Unexpected vector size");
    if operator(DemandedElts) {
        return Known;
    }
    let mut Opcode: u32 = Op.getOpcode();
    match Opcode {
        POISON => {
            Known.setKnownFPClasses(fcNone);
            Known.setSignBit(optional<bool> { false });
            break;
        },
        FNEG => {
            Known = self.computeKnownFPClass(Op.getOperand(0), DemandedElts, InterestedClasses, Depth + 1);
            Known.fneg();
            break;
        },
        BUILD_VECTOR => {
            assert!(!VT.isScalableVector());
            let mut First: bool = true;
            for let mut I: u32 = 0;
let mut E: u32 = Op.getNumOperands(); I != E; I += 1 {
                if !DemandedElts[I] {
                    continue;
                }
                if First {
                    Known = self.computeKnownFPClass(Op.getOperand(I), InterestedClasses, Depth + 1);
                    First = false;
                } else {
                    operator(Known, self.computeKnownFPClass(Op.getOperand(I), InterestedClasses, Depth + 1));
                }
                if Known.isUnknown() {
                    break;
                }
            }
            break;
        },
        EXTRACT_VECTOR_ELT => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut CIdx: *mut ConstantSDNode = dyn_cast(Op.getOperand(1));
            let mut SrcVT: EVT = Src.getValueType();
            if SrcVT.isFixedLengthVector() && CIdx {
                if CIdx.getAPIntValue().ult(SrcVT.getVectorNumElements()) {
                    let mut DemandedSrcElts: APInt = getOneBitSet(SrcVT.getVectorNumElements(), CIdx.getZExtValue());
                    Known = self.computeKnownFPClass(Src, DemandedSrcElts, InterestedClasses, Depth + 1);
                } else {
                    Known.setKnownFPClasses(fcNone);
                }
            } else {
                Known = self.computeKnownFPClass(Src, InterestedClasses, Depth + 1);
            }
            break;
        },
        SPLAT_VECTOR => {
            Known = self.computeKnownFPClass(Op.getOperand(0), InterestedClasses, Depth + 1);
            break;
        },
        BITCAST => {
            let mut SrcVT: EVT = Op.getOperand(0).getValueType();
            if VT.isScalableVector() || SrcVT.isScalableVector() {
                break;
            }
            let mut VTNumElts: u32 = if VT.isVector() { VT.getVectorNumElements() } else { 1 };
            let mut SrcVTNumElts: u32 = if SrcVT.isVector() { SrcVT.getVectorNumElements() } else { 1 };
            if VTNumElts != SrcVTNumElts {
                break;
            }
            let mut Bits: KnownBits = self.computeKnownBits(Op, DemandedElts, Depth + 1);
            Known = bitcast(VT.getFltSemantics(), Bits);
            break;
        },
        FABS => {
            Known = self.computeKnownFPClass(Op.getOperand(0), DemandedElts, InterestedClasses, Depth + 1);
            Known.fabs();
            break;
        },
        FCOPYSIGN => {
            Known = self.computeKnownFPClass(Op.getOperand(0), DemandedElts, InterestedClasses, Depth + 1);
            let mut KnownSign: KnownFPClass = self.computeKnownFPClass(Op.getOperand(1), DemandedElts, InterestedClasses, Depth + 1);
            Known.copysign(KnownSign);
            break;
        },
        AssertNoFPClass => {
            Known = self.computeKnownFPClass(Op.getOperand(0), DemandedElts, InterestedClasses, Depth + 1);
            let mut AssertedClasses: FPClassTest = operator(Op).getConstantOperandVal(1) as FPClassTest;
            Known.setKnownFPClasses(Known.getKnownFPClasses() & operator(AssertedClasses));
            break;
        },
        EXTRACT_SUBVECTOR => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut SrcVT: EVT = Src.getValueType();
            if SrcVT.isFixedLengthVector() {
                let mut Idx: u32 = Op.getConstantOperandVal(1);
                let mut NumSrcElts: u32 = SrcVT.getVectorNumElements();
                let mut DemandedSrcElts: APInt = DemandedElts.zextOrTrunc(NumSrcElts).shl(Idx);
                Known = self.computeKnownFPClass(Src, DemandedSrcElts, InterestedClasses, Depth + 1);
            } else {
                Known = self.computeKnownFPClass(Src, InterestedClasses, Depth + 1);
            }
            break;
        },
        INSERT_SUBVECTOR => {
            let mut BaseVector: SDValue = Op.getOperand(0);
            let mut SubVector: SDValue = Op.getOperand(1);
            let mut BaseVT: EVT = BaseVector.getValueType();
            if BaseVT.isFixedLengthVector() {
                let mut Idx: u32 = Op.getConstantOperandVal(2);
                let mut NumBaseElts: u32 = BaseVT.getVectorNumElements();
                let mut NumSubElts: u32 = SubVector.getValueType().getVectorNumElements();
                let mut DemandedMask: APInt = getBitsSet(NumBaseElts, Idx, Idx + NumSubElts);
                let mut DemandedSrcElts: APInt = DemandedElts & operator(DemandedMask);
                let mut DemandedSubElts: APInt = DemandedElts.extractBits(NumSubElts, Idx);
                if !DemandedSrcElts.isZero() {
                    Known = self.computeKnownFPClass(BaseVector, DemandedSrcElts, InterestedClasses, Depth + 1);
                }
                if !DemandedSubElts.isZero() {
                    let mut SubKnown: KnownFPClass = self.computeKnownFPClass(SubVector, DemandedSubElts, InterestedClasses, Depth + 1);
                    Known = if DemandedSrcElts.isZero() { SubKnown } else { (Known | SubKnown) };
                }
            } else {
                Known = self.computeKnownFPClass(SubVector, InterestedClasses, Depth + 1);
                if !Known.isUnknown() {
                    operator(Known, self.computeKnownFPClass(BaseVector, InterestedClasses, Depth + 1));
                }
            }
            break;
        },
        SELECT => {
            VSELECT;
        },
        _ => {
            if Opcode >= BUILTIN_OP_END || Opcode == INTRINSIC_WO_CHAIN || Opcode == INTRINSIC_W_CHAIN || Opcode == INTRINSIC_VOID {
                self.TLI.computeKnownFPClassForTargetNode(Op, Known, DemandedElts, *self, Depth);
            }
        },
    }
    return Known;
}

fn SelectionDAG::isKnownNeverNaN(self: *SelectionDAG, Op: SDValue, SNaN: bool, Depth: u32) -> bool {
    let mut DemandedElts: APInt = getDemandAllEltsMask(Op);
    return self.isKnownNeverNaN(Op, DemandedElts, SNaN, Depth);
}

fn SelectionDAG::isKnownNeverNaN(self: *SelectionDAG, Op: SDValue, DemandedElts: *APInt, SNaN: bool, Depth: u32) -> bool {
    assert!(!DemandedElts.isZero(), "No demanded elements");
    if operator(Op).getFlags().hasNoNaNs() {
        return true;
    }
    if Depth >= MaxRecursionDepth {
        return false;
    }
    let mut Opcode: u32 = Op.getOpcode();
    match Opcode {
        FADD => {
            FSUB;
        },
        FCANONICALIZE => {
            FEXP;
        },
        FABS => {
            FNEG;
        },
        SELECT => {
            return self.isKnownNeverNaN(Op.getOperand(1), DemandedElts, SNaN, Depth + 1) && self.isKnownNeverNaN(Op.getOperand(2), DemandedElts, SNaN, Depth + 1);
        },
        FP_EXTEND => {
            FP_ROUND;
        },
        SINT_TO_FP => {
            UINT_TO_FP;
        },
        FSQRT => {
            FLOG;
        },
        FMINNUM => {
            FMAXNUM;
        },
        FMINNUM_IEEE => {
            FMAXNUM_IEEE;
        },
        FMINIMUM => {
            FMAXIMUM;
        },
        EXTRACT_VECTOR_ELT => {
            let mut Src: SDValue = Op.getOperand(0);
            let mut Idx: *mut ConstantSDNode = dyn_cast(Op.getOperand(1));
            let mut SrcVT: EVT = Src.getValueType();
            if SrcVT.isFixedLengthVector() && Idx && Idx.getAPIntValue().ult(SrcVT.getVectorNumElements()) {
                let mut DemandedSrcElts: APInt = getOneBitSet(SrcVT.getVectorNumElements(), Idx.getZExtValue());
                return self.isKnownNeverNaN(Src, DemandedSrcElts, SNaN, Depth + 1);
            }
            return self.isKnownNeverNaN(Src, SNaN, Depth + 1);
        },
        EXTRACT_SUBVECTOR => {
            let mut Src: SDValue = Op.getOperand(0);
            if Src.getValueType().isFixedLengthVector() {
                let mut Idx: u32 = Op.getConstantOperandVal(1);
                let mut NumSrcElts: u32 = Src.getValueType().getVectorNumElements();
                let mut DemandedSrcElts: APInt = DemandedElts.zext(NumSrcElts).shl(Idx);
                return self.isKnownNeverNaN(Src, DemandedSrcElts, SNaN, Depth + 1);
            }
            return self.isKnownNeverNaN(Src, SNaN, Depth + 1);
        },
        INSERT_SUBVECTOR => {
            let mut BaseVector: SDValue = Op.getOperand(0);
            let mut SubVector: SDValue = Op.getOperand(1);
            let mut BaseVectorVT: EVT = BaseVector.getValueType();
            if BaseVectorVT.isFixedLengthVector() {
                let mut Idx: u32 = Op.getConstantOperandVal(2);
                let mut NumBaseElts: u32 = BaseVectorVT.getVectorNumElements();
                let mut NumSubElts: u32 = SubVector.getValueType().getVectorNumElements();
                let mut DemandedMask: APInt = getBitsSet(NumBaseElts, Idx, Idx + NumSubElts);
                let mut DemandedSrcElts: APInt = DemandedElts & operator(DemandedMask);
                let mut DemandedSubElts: APInt = DemandedElts.extractBits(NumSubElts, Idx);
                let mut NeverNaN: bool = true;
                if !DemandedSrcElts.isZero() {
                    NeverNaN &= self.isKnownNeverNaN(BaseVector, DemandedSrcElts, SNaN, Depth + 1);
                }
                if NeverNaN && !DemandedSubElts.isZero() {
                    NeverNaN &= self.isKnownNeverNaN(SubVector, DemandedSubElts, SNaN, Depth + 1);
                }
                return NeverNaN;
            }
            return self.isKnownNeverNaN(BaseVector, SNaN, Depth + 1) && self.isKnownNeverNaN(SubVector, SNaN, Depth + 1);
        },
        BUILD_VECTOR => {
            let mut NumElts: u32 = Op.getNumOperands();
            for let mut I: u32 = 0; I != NumElts; I += 1 {
                if DemandedElts[I] && !self.isKnownNeverNaN(Op.getOperand(I), SNaN, Depth + 1) {
                    return false;
                }
            }
            return true;
        },
        SPLAT_VECTOR => {
            return self.isKnownNeverNaN(Op.getOperand(0), SNaN, Depth + 1);
        },
        AssertNoFPClass => {
            let mut NoFPClass: FPClassTest = Op.getConstantOperandVal(1) as FPClassTest;
            if (NoFPClass & fcNan) == fcNan {
                return true;
            }
            if SNaN && (NoFPClass & fcSNan) == fcSNan {
                return true;
            }
            return self.isKnownNeverNaN(Op.getOperand(0), DemandedElts, SNaN, Depth + 1);
        },
        _ => {
            if Opcode >= BUILTIN_OP_END || Opcode == INTRINSIC_WO_CHAIN || Opcode == INTRINSIC_W_CHAIN || Opcode == INTRINSIC_VOID {
                return self.TLI.isKnownNeverNaNForTargetNode(Op, DemandedElts, *self, SNaN, Depth);
            }
        },
    }
    let mut NanMask: FPClassTest = if SNaN { fcSNan } else { fcNan };
    let mut Known: KnownFPClass = self.computeKnownFPClass(Op, DemandedElts, NanMask, Depth);
    return Known.isKnownNever(NanMask);
}

fn SelectionDAG::isKnownNeverLogicalZero(self: *SelectionDAG, Op: SDValue, Depth: u32) -> bool {
    let mut DemandedElts: APInt = getDemandAllEltsMask(Op);
    return self.isKnownNeverLogicalZero(Op, DemandedElts, Depth);
}

fn SelectionDAG::isKnownNeverLogicalZero(self: *SelectionDAG, Op: SDValue, DemandedElts: *APInt, Depth: u32) -> bool {
    assert!(!DemandedElts.isZero(), "No demanded elements");
    let mut VT: EVT = Op.getValueType();
    let mut Known: KnownFPClass = self.computeKnownFPClass(Op, DemandedElts, fcZero | fcSubnormal, Depth);
    return Known.isKnownNeverLogicalZero(self.getDenormalMode(VT));
}

fn SelectionDAG::isKnownNeverZero(self: *SelectionDAG, Op: SDValue, Depth: u32) -> bool {
    let mut DemandedElts: APInt = getDemandAllEltsMask(Op);
    return self.isKnownNeverZero(Op, DemandedElts, Depth);
}

fn SelectionDAG::isKnownNeverZero(self: *SelectionDAG, Op: SDValue, DemandedElts: *APInt, Depth: u32) -> bool {
    if Depth >= MaxRecursionDepth {
        return false;
    }
    let mut OpVT: EVT = Op.getValueType();
    let mut BitWidth: u32 = OpVT.getScalarSizeInBits();
    assert!(!Op.getValueType().isFloatingPoint(), "Floating point types unsupported - use isKnownNeverLogicalZero");
    let mut IsNeverZero: Closure_8 = Closure_8 { BitWidth: BitWidth };
    if matchUnaryPredicate(Op, DemandedElts, function<bool (ConstantSDNode *)> { IsNeverZero }, false, true) {
        return true;
    }
    match Op.getOpcode() {
        _ => {
            break;
        },
        EXTRACT_VECTOR_ELT => {
            let mut InVec: SDValue = Op.getOperand(0);
            let mut EltNo: SDValue = Op.getOperand(1);
            let mut VecVT: EVT = InVec.getValueType();
            if VecVT.isScalableVector() || OpVT.getScalarSizeInBits() != VecVT.getScalarSizeInBits() {
                break;
            }
            let mut NumSrcElts: u32 = VecVT.getVectorNumElements();
            let mut DemandedSrcElts: APInt = getAllOnes(NumSrcElts);
            let mut ConstEltNo: *mut ConstantSDNode = dyn_cast(EltNo);
            if ConstEltNo && ConstEltNo.getAPIntValue().ult(NumSrcElts) {
                DemandedSrcElts = getOneBitSet(NumSrcElts, ConstEltNo.getZExtValue());
            }
            return self.isKnownNeverZero(InVec, DemandedSrcElts, Depth + 1);
        },
        OR => {
            return self.isKnownNeverZero(Op.getOperand(1), DemandedElts, Depth + 1) || self.isKnownNeverZero(Op.getOperand(0), DemandedElts, Depth + 1);
        },
        VSELECT => {
            SELECT;
        },
        SHL => {
            if operator(Op).getFlags().hasNoSignedWrap() || operator(Op).getFlags().hasNoUnsignedWrap() {
                return self.isKnownNeverZero(Op.getOperand(0), DemandedElts, Depth + 1);
            }
            let mut ValKnown: KnownBits = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            if ValKnown.One[0] {
                return true;
            }
            let mut MaxCnt: APInt = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1).getMaxValue();
            if MaxCnt.ult(ValKnown.getBitWidth()) && !ValKnown.One.shl(MaxCnt).isZero() {
                return true;
            }
            break;
        },
        VECTOR_SHUFFLE => {
            if Op.getValueType().isScalableVector() {
                return false;
            }
            let mut NumElts: u32 = DemandedElts.getBitWidth();
            let mut DemandedLHS: APInt = APInt {};
            let mut DemandedRHS: APInt = APInt {};
            let mut SVN: *mut ShuffleVectorSDNode = cast(Op);
            assert!(NumElts == SVN.getMask().len, "Unexpected vector size");
            if !getShuffleDemandedElts(NumElts, SVN.getMask(), DemandedElts, DemandedLHS, DemandedRHS, false) {
                return false;
            }
            return (operator(DemandedLHS) || self.isKnownNeverZero(Op.getOperand(0), DemandedLHS, Depth + 1)) && (operator(DemandedRHS) || self.isKnownNeverZero(Op.getOperand(1), DemandedRHS, Depth + 1));
        },
        UADDSAT => {
            UMAX;
        },
        UMIN => {
            return self.isKnownNeverZero(Op.getOperand(1), DemandedElts, Depth + 1) && self.isKnownNeverZero(Op.getOperand(0), DemandedElts, Depth + 1);
        },
        SMAX => {
            let mut Op1: KnownBits = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            if Op1.isStrictlyPositive() {
                return true;
            }
            let mut Op0: KnownBits = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            if Op0.isStrictlyPositive() {
                return true;
            }
            if Op1.isNonZero() && Op0.isNonZero() {
                return true;
            }
            return self.isKnownNeverZero(Op.getOperand(1), DemandedElts, Depth + 1) && self.isKnownNeverZero(Op.getOperand(0), DemandedElts, Depth + 1);
        },
        SMIN => {
            let mut Op1: KnownBits = self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1);
            if Op1.isNegative() {
                return true;
            }
            let mut Op0: KnownBits = self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1);
            if Op0.isNegative() {
                return true;
            }
            if Op1.isNonZero() && Op0.isNonZero() {
                return true;
            }
            return self.isKnownNeverZero(Op.getOperand(1), DemandedElts, Depth + 1) && self.isKnownNeverZero(Op.getOperand(0), DemandedElts, Depth + 1);
        },
        ROTL => {
            ROTR;
        },
        SRA => {
            SRL;
        },
        UDIV => {
            SDIV;
        },
        ADD => {
            if operator(Op).getFlags().hasNoUnsignedWrap() {
                if self.isKnownNeverZero(Op.getOperand(1), DemandedElts, Depth + 1) || self.isKnownNeverZero(Op.getOperand(0), DemandedElts, Depth + 1) {
                    return true;
                }
            }
        },
        SUB => {
            if isNullConstant(Op.getOperand(0)) {
                return self.isKnownNeverZero(Op.getOperand(1), DemandedElts, Depth + 1);
            }
            let mut ne: optional<bool> = ne(self.computeKnownBits(Op.getOperand(0), DemandedElts, Depth + 1), self.computeKnownBits(Op.getOperand(1), DemandedElts, Depth + 1));
            return ne && operator(ne);
        },
        MUL => {
            if operator(Op).getFlags().hasNoSignedWrap() || operator(Op).getFlags().hasNoUnsignedWrap() {
                if self.isKnownNeverZero(Op.getOperand(1), Depth + 1) && self.isKnownNeverZero(Op.getOperand(0), Depth + 1) {
                    return true;
                }
            }
        },
        ZERO_EXTEND => {
            SIGN_EXTEND;
        },
        VSCALE => {
            let mut F: *Function = self.getMachineFunction().getFunction();
            let mut Multiplier: *APInt = Op.getConstantOperandAPInt(0);
            let mut CR: ConstantRange = getVScaleRange(&mut F, Op.getScalarValueSizeInBits()).multiply(ConstantRange { Multiplier }, 0);
            if !CR.contains(APInt { CR.getBitWidth(), 0, false, false }) {
                return true;
            }
            break;
        },
    }
    return self.computeKnownBits(Op, DemandedElts, Depth).isNonZero();
}

fn SelectionDAG::cannotBeOrderedNegativeFP(self: *SelectionDAG, Op: SDValue) -> bool {
    if isConstOrConstSplatFP(Op, true) {
        C1;
    } else {
        return !C1.isNegative();
    }
    match Op.getOpcode() {
        FABS => {
            FEXP;
        },
        _ => {
            return false;
        },
    }
    llvm_unreachable_internal("covered opcode switch", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAG.cpp", 6832);
}

fn SelectionDAG::canIgnoreSignBitOfZero(self: *SelectionDAG, Use: *SDUse) -> bool {
    assert!(Use.getValueType().isFloatingPoint());
    let mut User: *SDNode = Use.getUser();
    if User.getFlags().hasNoSignedZeros() {
        return true;
    }
    let mut OperandNo: u32 = Use.getOperandNo();
    match User.getOpcode() {
        SETCC => {
            FABS;
        },
        FCOPYSIGN => {
            return OperandNo == 0;
        },
        FADD => {
            FSUB;
        },
        FP_TO_SINT => {
            FP_TO_UINT;
        },
        _ => {
            return false;
        },
    }
}

fn SelectionDAG::canIgnoreSignBitOfZero(self: *SelectionDAG, Op: SDValue) -> bool {
    if operator(Op).getFlags().hasNoSignedZeros() {
        return true;
    }
    if operator(Op).use_size() > 2 {
        return false;
    }
    return all_of(operator(Op).uses(), Closure_9 { cap_0: self });
}

fn SelectionDAG::isEqualTo(self: *SelectionDAG, A: SDValue, B: SDValue) -> bool {
    if A == B {
        return true;
    }
    if dyn_cast(A) {
        CA;
    } else if dyn_cast(B) {
        CB;
    } else if CA.isZero() && CB.isZero() {
        return true;
    }
    return false;
}

fn getBitwiseNotOperand(V: SDValue, Mask: SDValue, AllowUndefs: bool) -> SDValue {
    if isBitwiseNot(V, AllowUndefs) {
        return V.getOperand(0);
    }
    let mut MaskC: *mut ConstantSDNode = isConstOrConstSplat(Mask, false, false);
    if !MaskC || V.getOpcode() != ANY_EXTEND {
        return SDValue {};
    }
    let mut ExtArg: SDValue = V.getOperand(0);
    if ExtArg.getScalarValueSizeInBits() >= MaskC.getAPIntValue().getActiveBits() && isBitwiseNot(ExtArg, AllowUndefs) && ExtArg.getOperand(0).getOpcode() == TRUNCATE && ExtArg.getOperand(0).getOperand(0).getValueType() == V.getValueType() {
        return ExtArg.getOperand(0).getOperand(0);
    }
    return SDValue {};
}

fn haveNoCommonBitsSetCommutative(A: SDValue, B: SDValue) -> bool {
    let mut MatchNoCommonBitsPattern: Closure_10 = Closure_10 {};
    if operator(A).getOpcode() == ZERO_EXTEND || operator(A).getOpcode() == TRUNCATE {
        A = operator(A).getOperand(0);
    }
    if operator(B).getOpcode() == ZERO_EXTEND || operator(B).getOpcode() == TRUNCATE {
        B = operator(B).getOperand(0);
    }
    if operator(A).getOpcode() == AND {
        return MatchNoCommonBitsPattern.call(operator(A).getOperand(0), operator(A).getOperand(1), B) || MatchNoCommonBitsPattern.call(operator(A).getOperand(1), operator(A).getOperand(0), B);
    }
    return false;
}

fn SelectionDAG::haveNoCommonBitsSet(self: *SelectionDAG, A: SDValue, B: SDValue) -> bool {
    assert!(A.getValueType() == B.getValueType(), "Values must have the same type");
    if haveNoCommonBitsSetCommutative(A, B) || haveNoCommonBitsSetCommutative(B, A) {
        return true;
    }
    return haveNoCommonBitsSet(self.computeKnownBits(A, 0), self.computeKnownBits(B, 0));
}

fn FoldSTEP_VECTOR(DL: *SDLoc, VT: EVT, Step: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    if cast(Step).isZero() {
        return DAG.getConstant(0, DL, VT, false, false);
    }
    return SDValue {};
}

fn FoldBUILD_VECTOR(DL: *SDLoc, VT: EVT, Ops: ArrayRef<SDValue>, DAG: *mut SelectionDAG) -> SDValue {
    let mut NumOps: i32 = Ops.len;
    assert!(NumOps != 0, "Can't build an empty vector!");
    assert!(!VT.isScalableVector(), "BUILD_VECTOR cannot be used with scalable types");
    assert!(VT.getVectorNumElements() == NumOps as u32, "Incorrect element count in BUILD_VECTOR!");
    let mut AllPoison: bool = true;
    if all_of(Ops, Closure_11 { AllPoison: &mut AllPoison }) {
        return if AllPoison { DAG.getPOISON(VT) } else { DAG.getUNDEF(VT) };
    }
    let mut IdentitySrc: SDValue = SDValue {};
    let mut IsIdentity: bool = true;
    for let mut i: i32 = 0; i != NumOps; i += 1 {
        if Ops[i].getOpcode() != EXTRACT_VECTOR_ELT || Ops[i].getOperand(0).getValueType() != VT || (IdentitySrc && Ops[i].getOperand(0) != IdentitySrc) || !isa(Ops[i].getOperand(1)) || Ops[i].getConstantOperandAPInt(1) != i {
            IsIdentity = false;
            break;
        }
        IdentitySrc = Ops[i].getOperand(0);
    }
    if IsIdentity {
        return IdentitySrc;
    }
    return SDValue {};
}

fn foldCONCAT_VECTORS(DL: *SDLoc, VT: EVT, Ops: ArrayRef<SDValue>, DAG: *mut SelectionDAG) -> SDValue {
    assert!(!Ops.is_empty(), "Can't concatenate an empty list of vectors!");
    assert!(all_of(Ops, Closure_12 { cap_0: ArrayRef<SDValue> { Ops } }), "Concatenation of vectors with inconsistent value types!");
    assert!((Ops[0].getValueType().getVectorElementCount() * Ops.len) == VT.getVectorElementCount(), "Incorrect element count in vector concatenation!");
    if Ops.len == 1 {
        return Ops[0];
    }
    let mut AllPoison: bool = true;
    if all_of(Ops, Closure_13 { AllPoison: &mut AllPoison }) {
        return if AllPoison { DAG.getPOISON(VT) } else { DAG.getUNDEF(VT) };
    }
    let mut IdentitySrc: SDValue = SDValue {};
    let mut IsIdentity: bool = true;
    for let mut i: u32 = 0;
let mut e: u32 = Ops.len; i != e; i += 1 {
        let mut Op: SDValue = Ops[i];
        let mut IdentityIndex: u32 = i * Op.getValueType().getVectorMinNumElements();
        if Op.getOpcode() != EXTRACT_SUBVECTOR || Op.getOperand(0).getValueType() != VT || (IdentitySrc && Op.getOperand(0) != IdentitySrc) || Op.getConstantOperandVal(1) != IdentityIndex {
            IsIdentity = false;
            break;
        }
        assert!((!IdentitySrc || IdentitySrc == Op.getOperand(0)), "Unexpected identity source vector for concat of extracts");
        IdentitySrc = Op.getOperand(0);
    }
    if IsIdentity {
        assert!(IdentitySrc, "Failed to set source vector of extracts");
        return IdentitySrc;
    }
    if VT.isScalableVector() {
        return SDValue {};
    }
    let mut SVT: EVT = VT.getScalarType();
    let mut Elts: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    for Op in Ops {
        let mut OpVT: EVT = Op.getValueType();
        if Op.getOpcode() == POISON {
            Elts.append(OpVT.getVectorNumElements(), DAG.getPOISON(SVT));
        } else if Op.getOpcode() == UNDEF {
            Elts.append(OpVT.getVectorNumElements(), DAG.getUNDEF(SVT));
        } else if Op.getOpcode() == BUILD_VECTOR {
            Elts.append(operator(Op).op_begin(), operator(Op).op_end());
        } else if Op.getOpcode() == INSERT_VECTOR_ELT && OpVT.getVectorNumElements() == 1 && isNullConstant(Op.getOperand(2)) {
            Elts.push(ValueParamT { Op.getOperand(1) });
        } else {
            return SDValue {};
        }
    }
    for Op in Elts {
        SVT = (if SVT.bitsLT(Op.getValueType()) { Op.getValueType() } else { SVT });
    }
    if SVT.bitsGT(VT.getScalarType()) {
        for Op in Elts {
            if Op.getOpcode() == POISON {
                Op = DAG.getPOISON(SVT);
            } else if Op.getOpcode() == UNDEF {
                Op = DAG.getUNDEF(SVT);
            } else {
                Op = if DAG.getTargetLoweringInfo().isZExtFree(Op.getValueType(), SVT) { DAG.getZExtOrTrunc(Op, DL, SVT) } else { DAG.getSExtOrTrunc(Op, DL, SVT) };
            }
        }
    }
    let mut V: SDValue = DAG.getBuildVector(VT, DL, ArrayRef<SDValue> { Elts });
    NewSDValueDbgMsg(V, "New node fold concat vectors: ", &mut DAG);
    return V;
}

fn SelectionDAG::getNode(self, Opcode: u32, DL: *SDLoc, VT: EVT) -> SDValue {
    let mut VTs: SDVTList = self.getVTList(VT);
    let mut ID: SDNodeKey = SDNodeKey { Opcode, VTs, ArrayRef<SDValue> {} };
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, DL, InsertToken) {
        E;
    } else {
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut SDNode = self.newSDNode(Opcode, DL.getIROrder(), DL.getDebugLoc(), VTs);
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    let mut V: SDValue = SDValue { Node: N, ResNo: 0 };
    NewSDValueDbgMsg(V, "Creating new node: ", self);
    return V;
}

fn SelectionDAG::getNode(self, Opcode: u32, DL: *SDLoc, VT: EVT, N1: SDValue) -> SDValue {
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    if self.Inserter {
        Flags = self.Inserter.getFlags();
    }
    return self.getNode(Opcode, DL, VT, N1, Flags);
}

fn SelectionDAG::getNode(self, Opcode: u32, DL: *SDLoc, VT: EVT, N1: SDValue, Flags: SDNodeFlags) -> SDValue {
    assert!(N1.getOpcode() != DELETED_NODE, "Operand is DELETED_NODE!");
    match Opcode {
        _ => {
            break;
        },
        FNEG => {
            FABS;
        },
    }
    let mut OpOpcode: u32 = N1.getNode().getOpcode();
    match Opcode {
        STEP_VECTOR => {
            assert!(VT.isScalableVector(), "STEP_VECTOR can only be used with scalable types");
        },
        FREEZE => {
            assert!(VT == N1.getValueType(), "Unexpected VT!");
        },
        TokenFactor => {
            MERGE_VALUES;
        },
        BUILD_VECTOR => {
            let mut Ops: [1]SDValue = [N1];
            if FoldBUILD_VECTOR(DL, VT, ArrayRef<SDValue> { Ops }, *self) {
                V;
            } else {
                return V;
            }
            break;
        },
        FP_ROUND => {
            llvm_unreachable_internal("Invalid method to make FP_ROUND node", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAG.cpp", 7208);
        },
        FP_EXTEND => {
            assert!(VT.isFloatingPoint() && N1.getValueType().isFloatingPoint(), "Invalid FP cast!");
        },
        FP_TO_SINT => {
            FP_TO_UINT;
        },
        SINT_TO_FP => {
            UINT_TO_FP;
        },
        SIGN_EXTEND => {
            assert!(VT.isInteger() && N1.getValueType().isInteger(), "Invalid SIGN_EXTEND!");
        },
        ZERO_EXTEND => {
            assert!(VT.isInteger() && N1.getValueType().isInteger(), "Invalid ZERO_EXTEND!");
        },
        ANY_EXTEND => {
            assert!(VT.isInteger() && N1.getValueType().isInteger(), "Invalid ANY_EXTEND!");
        },
        TRUNCATE => {
            assert!(VT.isInteger() && N1.getValueType().isInteger(), "Invalid TRUNCATE!");
        },
        ANY_EXTEND_VECTOR_INREG => {
            ZERO_EXTEND_VECTOR_INREG;
        },
        ABS => {
            assert!(VT.isInteger() && VT == N1.getValueType(), "Invalid ABS!");
        },
        ABS_MIN_POISON => {
            assert!(VT.isInteger() && VT == N1.getValueType(), "Invalid ABS_MIN_POISON!");
        },
        BSWAP => {
            assert!(VT.isInteger() && VT == N1.getValueType(), "Invalid BSWAP!");
        },
        BITREVERSE => {
            assert!(VT.isInteger() && VT == N1.getValueType(), "Invalid BITREVERSE!");
        },
        BITCAST => {
            assert!(VT.getSizeInBits() == N1.getValueSizeInBits(), "Cannot BITCAST between types of different sizes!");
        },
        SCALAR_TO_VECTOR => {
            assert!(VT.isVector() && !N1.getValueType().isVector() && (VT.getVectorElementType() == N1.getValueType() || (VT.getVectorElementType().isInteger() && N1.getValueType().isInteger() && VT.getVectorElementType().bitsLE(N1.getValueType()))), "Illegal SCALAR_TO_VECTOR node!");
        },
        FNEG => {
            if N1.isUndef() {
                return self.getUNDEF(VT);
            }
        },
        FABS => {
            if OpOpcode == FNEG {
                return self.getNode(FABS, DL, VT, N1.getOperand(0));
            }
        },
        VSCALE => {
            assert!(VT == N1.getValueType(), "Unexpected VT!");
        },
        CTPOP => {
            if N1.getValueType().getScalarType() == EVT { i1 } {
                return N1;
            }
        },
        CTLZ => {
            CTTZ;
        },
        CTLS => {
            if N1.getValueType().getScalarType() == EVT { i1 } {
                return self.getConstant(0, DL, VT, false, false);
            }
        },
        VECREDUCE_ADD => {
            if N1.getValueType().getScalarType() == EVT { i1 } {
                return self.getNode(VECREDUCE_XOR, DL, VT, N1);
            }
        },
        VECREDUCE_SMIN => {
            VECREDUCE_UMAX;
        },
        VECREDUCE_SMAX => {
            VECREDUCE_UMIN;
        },
        VECTOR_REPEAT => {
            assert!(N1.getValueType().isFixedLengthVector(), "VECTOR_REPEAT requires a fixed-length vector operand");
        },
        SPLAT_VECTOR => {
            assert!(VT.isVector(), "Wrong return type!");
        },
    }
    let mut N: *mut SDNode = null;
    let mut VTs: SDVTList = self.getVTList(VT);
    let mut Ops: [1]SDValue = [N1];
    if VT != EVT { Glue } {
        let mut ID: SDNodeKey = SDNodeKey { Opcode, VTs, ArrayRef<SDValue> { Ops } };
        let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
        if self.lookupNode(ID, DL, InsertToken) {
            E;
        } else {
            E.intersectFlagsWith(Flags);
            return SDValue { Node: E, ResNo: 0 };
        }
        N = self.newSDNode(Opcode, DL.getIROrder(), DL.getDebugLoc(), VTs);
        N.setFlags(Flags);
        self.createOperands(N, ArrayRef<SDValue> { Ops });
        self.CSEMap.insert(N, InsertToken);
    } else {
        N = self.newSDNode(Opcode, DL.getIROrder(), DL.getDebugLoc(), VTs);
        self.createOperands(N, ArrayRef<SDValue> { Ops });
    }
    self.InsertNode(N);
    let mut V: SDValue = SDValue { Node: N, ResNo: 0 };
    NewSDValueDbgMsg(V, "Creating new node: ", self);
    return V;
}

fn getIntegerIdentity(Opcode: u32, BitWidth: u32) -> APInt {
    match Opcode {
        _ => {
            llvm_unreachable_internal("Unexpected integer identity opcode", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAG.cpp", 7539);
        },
        ADD => {
            OR;
        },
        MUL => {
            return APInt { BitWidth, 1, false, false };
        },
        AND => {
            UMIN;
        },
        SMAX => {
            return getSignedMinValue(BitWidth);
        },
        SMIN => {
            return getSignedMaxValue(BitWidth);
        },
    }
}

fn FoldValue(Opcode: u32, C1: *APInt, C2: *APInt) -> optional<APInt> {
    match Opcode {
        ADD => {
            return optional<APInt> { C1 + C2 };
        },
        SUB => {
            return optional<APInt> { C1 - C2 };
        },
        MUL => {
            return optional<APInt> { C1 * C2 };
        },
        AND => {
            return optional<APInt> { C1 & C2 };
        },
        OR => {
            return optional<APInt> { C1 | C2 };
        },
        XOR => {
            return optional<APInt> { C1 ^ C2 };
        },
        SHL => {
            return optional<APInt> { C1 << C2 };
        },
        SRL => {
            return optional<APInt> { C1.lshr(C2) };
        },
        SRA => {
            return optional<APInt> { C1.ashr(C2) };
        },
        ROTL => {
            return optional<APInt> { C1.rotl(C2) };
        },
        ROTR => {
            return optional<APInt> { C1.rotr(C2) };
        },
        SMIN => {
            return optional<APInt> { if C1.sle(C2) { C1 } else { C2 } };
        },
        SMAX => {
            return optional<APInt> { if C1.sge(C2) { C1 } else { C2 } };
        },
        UMIN => {
            return optional<APInt> { if C1.ule(C2) { C1 } else { C2 } };
        },
        UMAX => {
            return optional<APInt> { if C1.uge(C2) { C1 } else { C2 } };
        },
        SADDSAT => {
            return optional<APInt> { C1.sadd_sat(C2) };
        },
        UADDSAT => {
            return optional<APInt> { C1.uadd_sat(C2) };
        },
        SSUBSAT => {
            return optional<APInt> { C1.ssub_sat(C2) };
        },
        USUBSAT => {
            return optional<APInt> { C1.usub_sat(C2) };
        },
        SSHLSAT => {
            return optional<APInt> { C1.sshl_sat(C2) };
        },
        USHLSAT => {
            return optional<APInt> { C1.ushl_sat(C2) };
        },
        UDIV => {
            if !C2.getBoolValue() {
                break;
            }
        },
        UREM => {
            if !C2.getBoolValue() {
                break;
            }
        },
        SDIV => {
            if !C2.getBoolValue() {
                break;
            }
        },
        SREM => {
            if !C2.getBoolValue() {
                break;
            }
        },
        AVGFLOORS => {
            return optional<APInt> { avgFloorS(C1, C2) };
        },
        AVGFLOORU => {
            return optional<APInt> { avgFloorU(C1, C2) };
        },
        AVGCEILS => {
            return optional<APInt> { avgCeilS(C1, C2) };
        },
        AVGCEILU => {
            return optional<APInt> { avgCeilU(C1, C2) };
        },
        ABDS => {
            return optional<APInt> { abds(C1, C2) };
        },
        ABDU => {
            return optional<APInt> { abdu(C1, C2) };
        },
        MULHS => {
            return optional<APInt> { mulhs(C1, C2) };
        },
        MULHU => {
            return optional<APInt> { mulhu(C1, C2) };
        },
        CLMUL => {
            return optional<APInt> { clmul(C1, C2) };
        },
        CLMULR => {
            return optional<APInt> { clmulr(C1, C2) };
        },
        CLMULH => {
            return optional<APInt> { clmulh(C1, C2) };
        },
        PEXT => {
            return optional<APInt> { pext(C1, C2) };
        },
        PDEP => {
            return optional<APInt> { pdep(C1, C2) };
        },
    }
    return optional<APInt> { nullopt };
}

fn FoldValueWithUndef(Opcode: u32, C1: *APInt, IsUndef1: bool, C2: *APInt, IsUndef2: bool) -> optional<APInt> {
    if !(IsUndef1 || IsUndef2) {
        return FoldValue(Opcode, C1, C2);
    }
    if Opcode == AND || Opcode == MUL {
        return optional<APInt> { getZero(C1.getBitWidth()) };
    }
    return optional<APInt> { nullopt };
}

fn SelectionDAG::FoldSymbolOffset(self, Opcode: u32, VT: EVT, GA: *GlobalAddressSDNode, N2: *SDNode) -> SDValue {
    if GA.getOpcode() != GlobalAddress {
        return SDValue {};
    }
    if !self.TLI.isOffsetFoldingLegal(GA) {
        return SDValue {};
    }
    let mut C2: *ConstantSDNode = dyn_cast(N2);
    if !C2 {
        return SDValue {};
    }
    let mut Offset: i64 = C2.getSExtValue();
    match Opcode {
        ADD => {
            PTRADD;
        },
        SUB => {
            Offset = -Offset;
        },
        _ => {
            return SDValue {};
        },
    }
    return self.getGlobalAddress(GA.getGlobal(), SDLoc { C2 }, VT, GA.getOffset() + Offset, false, 0);
}

fn SelectionDAG::isUndef(self, Opcode: u32, Ops: ArrayRef<SDValue>) -> bool {
    match Opcode {
        SDIV => {
            UDIV;
        },
        _ => {
            return false;
        },
    }
}

fn SelectionDAG::FoldConstantArithmetic(self, Opcode: u32, DL: *SDLoc, VT: EVT, Ops: ArrayRef<SDValue>, Flags: SDNodeFlags) -> SDValue {
    if Opcode >= BUILTIN_OP_END || Opcode == CONCAT_VECTORS {
        return SDValue {};
    }
    let mut NumOps: u32 = Ops.len;
    if NumOps == 0 {
        return SDValue {};
    }
    if self.isUndef(Opcode, ArrayRef<SDValue> { Ops }) {
        return self.getUNDEF(VT);
    }
    if NumOps == 1 {
        let mut N1: SDValue = Ops[0];
        if dyn_cast(N1) {
            C;
        } else {
            let mut Val: *APInt = C.getAPIntValue();
            match Opcode {
                SIGN_EXTEND => {
                    return self.getConstant(Val.sextOrTrunc(VT.getSizeInBits().operator unsigned long long()), DL, VT, C.isTargetOpcode(), C.isOpaque());
                },
                TRUNCATE => {
                    if C.isOpaque() {
                        break;
                    }
                },
                ZERO_EXTEND => {
                    return self.getConstant(Val.zextOrTrunc(VT.getSizeInBits().operator unsigned long long()), DL, VT, C.isTargetOpcode(), C.isOpaque());
                },
                ANY_EXTEND => {
                    if self.TLI.isSExtCheaperThanZExt(N1.getValueType(), VT) {
                        return self.getConstant(Val.sextOrTrunc(VT.getSizeInBits().operator unsigned long long()), DL, VT, C.isTargetOpcode(), C.isOpaque());
                    }
                },
                ABS => {
                    return self.getConstant(Val.abs(), DL, VT, C.isTargetOpcode(), C.isOpaque());
                },
                ABS_MIN_POISON => {
                    if Val.isMinSignedValue() {
                        return self.getPOISON(VT);
                    }
                },
                BITREVERSE => {
                    return self.getConstant(Val.reverseBits(), DL, VT, C.isTargetOpcode(), C.isOpaque());
                },
                BSWAP => {
                    return self.getConstant(Val.byteSwap(), DL, VT, C.isTargetOpcode(), C.isOpaque());
                },
                CTPOP => {
                    return self.getConstant(Val.popcount(), DL, VT, C.isTargetOpcode(), C.isOpaque());
                },
                PARITY => {
                    return self.getConstant(Val.popcount() & 1, DL, VT, C.isTargetOpcode(), C.isOpaque());
                },
                CTLZ => {
                    CTLZ_ZERO_POISON;
                },
                CTTZ => {
                    CTTZ_ZERO_POISON;
                },
                CTLS => {
                    return self.getConstant(Val.getNumSignBits() - 1, DL, VT, C.isTargetOpcode(), C.isOpaque());
                },
                UINT_TO_FP => {
                    SINT_TO_FP;
                },
                FP16_TO_FP => {
                    BF16_TO_FP;
                },
                STEP_VECTOR => {
                    if FoldSTEP_VECTOR(DL, VT, N1, *self) {
                        V;
                    } else {
                        return V;
                    }
                },
                BITCAST => {
                    if VT == EVT { f16 } && C.getValueType(0) == EVT { i16 } {
                        return self.getConstantFP(APFloat { IEEEhalf(), Val }, DL, VT, false);
                    }
                },
            }
        }
        if dyn_cast(N1) {
            C;
        } else {
            let mut V: APFloat = C.getValueAPF();
            match Opcode {
                FNEG => {
                    V.changeSign();
                },
                FABS => {
                    V.clearSign();
                },
                FCEIL => {
                    let mut fs: opStatus = V.roundToIntegral(rmTowardPositive);
                    if fs == opOK || fs == opInexact {
                        return self.getConstantFP(V, DL, VT, false);
                    }
                    return SDValue {};
                },
                FTRUNC => {
                    let mut fs: opStatus = V.roundToIntegral(rmTowardZero);
                    if fs == opOK || fs == opInexact {
                        return self.getConstantFP(V, DL, VT, false);
                    }
                    return SDValue {};
                },
                FFLOOR => {
                    let mut fs: opStatus = V.roundToIntegral(rmTowardNegative);
                    if fs == opOK || fs == opInexact {
                        return self.getConstantFP(V, DL, VT, false);
                    }
                    return SDValue {};
                },
                FP_EXTEND => {
                    let mut ignored: bool = false;
                    V.convert(VT.getFltSemantics(), rmNearestTiesToEven, &mut ignored) as void;
                    return self.getConstantFP(V, DL, VT, false);
                },
                FP_TO_SINT => {
                    FP_TO_UINT;
                },
                FP_TO_FP16 => {
                    FP_TO_BF16;
                },
                BITCAST => {
                    if VT == EVT { i16 } && C.getValueType(0) == EVT { f16 } {
                        return self.getConstant(V.bitcastToAPInt().getZExtValue() as u16, DL, VT, false, false);
                    }
                },
            }
        }
        if Opcode == BITCAST {
            return SDValue {};
        }
        if (Opcode == VECREDUCE_ADD || Opcode == VECREDUCE_SMAX || Opcode == VECREDUCE_SMIN || Opcode == VECREDUCE_UMAX || Opcode == VECREDUCE_UMIN || Opcode == VECREDUCE_MUL || Opcode == VECREDUCE_OR || Opcode == VECREDUCE_XOR || Opcode == VECREDUCE_AND) && isBuildVectorOfConstantSDNodes(N1.getNode()) {
            let mut EltBits: u32 = N1.getValueType().getScalarSizeInBits();
            let mut BaseOpcode: u32 = getVecReduceBaseOpcode(Opcode);
            let mut Acc: APInt = getIntegerIdentity(BaseOpcode, EltBits);
            for Elt in operator(N1).op_values() {
                if Elt.getOpcode() == POISON {
                    return self.getPOISON(VT);
                }
                if Elt.isUndef() || cast(Elt).isOpaque() {
                    return SDValue {};
                }
                let mut Value: APInt = cast(Elt).getAPIntValue().trunc(EltBits);
                let mut Folded: optional<APInt> = FoldValue(BaseOpcode, Acc, Value);
                assert!(Folded, "Expected vector reduction base opcode to be foldable");
                Acc = operator(Folded);
            }
            let mut EltVT: EVT = N1.getValueType().getScalarType();
            return self.getAnyExtOrTrunc(self.getConstant(Acc, DL, EltVT, false, false), DL, VT);
        }
    }
    if NumOps == 2 {
        if self.foldConstantFPMath(Opcode, DL, VT, ArrayRef<SDValue> { Ops }) {
            CFP;
        } else {
            return CFP;
        }
        if dyn_cast(Ops[0]) {
            C1;
        } else {
            if dyn_cast(Ops[1]) {
                C2;
            } else {
                if C1.isOpaque() || C2.isOpaque() {
                    return SDValue {};
                }
                let mut FoldAttempt: optional<APInt> = FoldValue(Opcode, C1.getAPIntValue(), C2.getAPIntValue());
                if !FoldAttempt {
                    return SDValue {};
                }
                let mut Folded: SDValue = self.getConstant(operator(FoldAttempt), DL, VT, false, false);
                assert!((!Folded || !VT.isVector()), "Can't fold vectors ops with scalar operands");
                return Folded;
            }
        }
        if dyn_cast(Ops[0]) {
            GA;
        } else {
            return self.FoldSymbolOffset(Opcode, VT, GA, Ops[1].getNode());
        }
        if self.TLI.isCommutativeBinOp(Opcode) {
            if dyn_cast(Ops[1]) {
                GA;
            } else {
                return self.FoldSymbolOffset(Opcode, VT, GA, Ops[0].getNode());
            }
        }
        if Opcode == SIGN_EXTEND_INREG {
            let mut EVT: EVT = cast(Ops[1]).getVT();
            let mut SignExtendInReg: Closure_14 = Closure_14 { EVT: &mut EVT, cap_1: self, DL: &mut DL };
            if dyn_cast(Ops[0]) {
                C1;
            } else {
                let mut Val: *APInt = C1.getAPIntValue();
                return SignExtendInReg.call(Val, VT);
            }
            if isBuildVectorOfConstantSDNodes(Ops[0].getNode()) {
                let mut ScalarOps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
                let mut OpVT: EVT = Ops[0].getOperand(0).getValueType();
                for let mut I: i32 = 0;
let mut E: i32 = VT.getVectorNumElements(); I != E; I += 1 {
                    let mut Op: SDValue = Ops[0].getOperand(I);
                    if Op.isUndef() {
                        ScalarOps.push(self.getUNDEF(OpVT));
                        continue;
                    }
                    let mut Val: *APInt = cast(Op).getAPIntValue();
                    ScalarOps.push(SignExtendInReg.call(Val, OpVT));
                }
                return self.getBuildVector(VT, DL, ArrayRef<SDValue> { ScalarOps });
            }
            if Ops[0].getOpcode() == SPLAT_VECTOR && isa(Ops[0].getOperand(0)) {
                return self.getNode(SPLAT_VECTOR, DL, VT, SignExtendInReg.call(Ops[0].getConstantOperandAPInt(0), Ops[0].getOperand(0).getValueType()));
            }
        }
    }
    if Opcode == FSHL || Opcode == FSHR {
        let mut C1: *mut ConstantSDNode = dyn_cast(Ops[0]);
        let mut C2: *mut ConstantSDNode = dyn_cast(Ops[1]);
        let mut C3: *mut ConstantSDNode = dyn_cast(Ops[2]);
        if C1 && C2 && C3 {
            if C1.isOpaque() || C2.isOpaque() || C3.isOpaque() {
                return SDValue {};
            }
            let mut V1: *APInt = C1.getAPIntValue();
            let mut V2: *APInt = C2.getAPIntValue();
            let mut V3: *APInt = C3.getAPIntValue();
            let mut FoldedVal: APInt = if Opcode == FSHL { fshl(V1, V2, V3) } else { fshr(V1, V2, V3) };
            return self.getConstant(FoldedVal, DL, VT, false, false);
        }
    }
    if Opcode == FMA || Opcode == FMAD || Opcode == FMULADD {
        assert!(VT.isFloatingPoint(), "This operator only applies to FP types!");
        assert!(Ops[0].getValueType() == VT && Ops[1].getValueType() == VT && Ops[2].getValueType() == VT, "FMA types must match!");
        let mut C1: *mut ConstantFPSDNode = dyn_cast(Ops[0]);
        let mut C2: *mut ConstantFPSDNode = dyn_cast(Ops[1]);
        let mut C3: *mut ConstantFPSDNode = dyn_cast(Ops[2]);
        if C1 && C2 && C3 {
            let mut V1: APFloat = C1.getValueAPF();
            let mut V2: *APFloat = C2.getValueAPF();
            let mut V3: *APFloat = C3.getValueAPF();
            if Opcode == FMAD || Opcode == FMULADD {
                V1.multiply(V2, rmNearestTiesToEven);
                V1.add(V3, rmNearestTiesToEven);
            } else {
                V1.fusedMultiplyAdd(V2, V3, rmNearestTiesToEven);
            }
            return self.getConstantFP(V1, DL, VT, false);
        }
    }
    if !VT.isVector() {
        return SDValue {};
    }
    if Opcode == PARTIAL_REDUCE_SMLA || Opcode == PARTIAL_REDUCE_UMLA || Opcode == PARTIAL_REDUCE_SUMLA {
        if !all_of(Ops, Closure_15 {}) {
            return SDValue {};
        }
        let mut AccEltBits: u32 = VT.getScalarSizeInBits();
        let mut InputEltBits: u32 = Ops[1].getScalarValueSizeInBits();
        let mut NumAccElts: u32 = VT.getVectorNumElements();
        let mut NumInputElts: u32 = Ops[1].getValueType().getVectorNumElements();
        let mut Results: SmallVector<APInt, 8> = SmallVector<APInt, 8> { NumAccElts, getZero(AccEltBits) };
        let mut PoisonElts: BitVector = BitVector { Bits: NumAccElts, Size: false };
        for let mut I: u32 = 0; I != NumAccElts; I += 1 {
            let mut Elt: SDValue = Ops[0].getOperand(I);
            if Elt.getOpcode() == POISON {
                PoisonElts.set(I);
                continue;
            }
            let mut C: *mut ConstantSDNode = dyn_cast(Elt);
            if !C || C.isOpaque() {
                return SDValue {};
            }
            Results[I] = C.getAPIntValue().trunc(AccEltBits);
        }
        let mut IsLHSSigned: bool = Opcode != PARTIAL_REDUCE_UMLA;
        let mut IsRHSSigned: bool = Opcode == PARTIAL_REDUCE_SMLA;
        for let mut I: u32 = 0; I != NumInputElts; I += 1 {
            let mut AccIdx: u32 = I % NumAccElts;
            let mut LHSElt: SDValue = Ops[1].getOperand(I);
            let mut RHSElt: SDValue = Ops[2].getOperand(I);
            if LHSElt.getOpcode() == POISON || RHSElt.getOpcode() == POISON {
                PoisonElts.set(AccIdx);
                continue;
            }
            let mut LHS: *mut ConstantSDNode = dyn_cast(LHSElt);
            let mut RHS: *mut ConstantSDNode = dyn_cast(RHSElt);
            if !LHS || !RHS || LHS.isOpaque() || RHS.isOpaque() {
                return SDValue {};
            }
            let mut LHSVal: APInt = LHS.getAPIntValue().trunc(InputEltBits);
            let mut RHSVal: APInt = RHS.getAPIntValue().trunc(InputEltBits);
            LHSVal = if IsLHSSigned { LHSVal.sext(AccEltBits) } else { LHSVal.zext(AccEltBits) };
            RHSVal = if IsRHSSigned { RHSVal.sext(AccEltBits) } else { RHSVal.zext(AccEltBits) };
            operator(Results[AccIdx], LHSVal * RHSVal);
        }
        let mut AccEltVT: EVT = VT.getVectorElementType();
        let mut LegalSVT: EVT = AccEltVT;
        if self.NewNodesMustHaveLegalTypes && LegalSVT.isInteger() {
            LegalSVT = self.TLI.getTypeToTransformTo(*self.getContext(), LegalSVT);
            if LegalSVT.bitsLT(AccEltVT) {
                return SDValue {};
            }
        }
        let mut ResultOps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
        for let mut I: u32 = 0; I != NumAccElts; I += 1 {
            ResultOps.push(if PoisonElts[I] { self.getPOISON(LegalSVT) } else { self.getConstant(Results[I].sext(LegalSVT.getSizeInBits().operator unsigned long long()), DL, LegalSVT, false, false) });
        }
        return self.getBuildVector(VT, DL, ArrayRef<SDValue> { ResultOps });
    }
    let mut NumElts: ElementCount = VT.getVectorElementCount();
    if NumOps == 2 && VT.isFixedLengthVector() && VT.isInteger() && Ops[0].getValueType() == VT && Ops[1].getValueType() == VT && (Ops[0].getOpcode() == BITCAST || Ops[1].getOpcode() == BITCAST) {
        let mut N1: SDValue = peekThroughBitcasts(Ops[0]);
        let mut N2: SDValue = peekThroughBitcasts(Ops[1]);
        let mut BV1: *mut BuildVectorSDNode = dyn_cast(N1);
        let mut BV2: *mut BuildVectorSDNode = dyn_cast(N2);
        if BV1 && BV2 && N1.getValueType().isInteger() && N2.getValueType().isInteger() {
            let mut IsLE: bool = self.getDataLayout().isLittleEndian();
            let mut EltBits: u32 = VT.getScalarSizeInBits();
            let mut RawBits1: SmallVector<APInt> = SmallVector<APInt> {};
            let mut RawBits2: SmallVector<APInt> = SmallVector<APInt> {};
            let mut UndefElts1: BitVector = BitVector {};
            let mut UndefElts2: BitVector = BitVector {};
            if BV1.getConstantRawBits(IsLE, EltBits, RawBits1, UndefElts1) && BV2.getConstantRawBits(IsLE, EltBits, RawBits2, UndefElts2) {
                let mut RawBits: SmallVector<APInt> = SmallVector<APInt> {};
                for let mut I: u32 = 0;
let mut E: u32 = NumElts.getFixedValue(); I != E; I += 1 {
                    let mut Fold: optional<APInt> = FoldValueWithUndef(Opcode, RawBits1[I], UndefElts1[I], RawBits2[I], UndefElts2[I]);
                    if !Fold {
                        break;
                    }
                    RawBits.push(operator(Fold));
                }
                if RawBits.len == NumElts.getFixedValue() {
                    let mut BVVT: EVT = EVT {};
                    let mut BVEltVT: EVT = EVT {};
                    if N1.getValueType() == VT {
                        BVVT = N1.getValueType();
                        BVEltVT = BV1.getOperand(0).getValueType();
                    } else {
                        BVVT = N2.getValueType();
                        BVEltVT = BV2.getOperand(0).getValueType();
                    }
                    let mut BVEltBits: u32 = BVEltVT.getSizeInBits().operator unsigned long long();
                    let mut DstBits: SmallVector<APInt> = SmallVector<APInt> {};
                    let mut DstUndefs: BitVector = BitVector {};
                    recastRawBits(IsLE, BVVT.getScalarSizeInBits(), DstBits, ArrayRef<APInt> { RawBits }, DstUndefs, BitVector { Bits: RawBits.len, Size: false });
                    let mut Ops: SmallVector<SDValue> = SmallVector<SDValue> { DstBits.len, self.getUNDEF(BVEltVT) };
                    for let mut I: u32 = 0;
let mut E: u32 = DstBits.len; I != E; I += 1 {
                        if DstUndefs[I] {
                            continue;
                        }
                        Ops[I] = self.getConstant(DstBits[I].sext(BVEltBits), DL, BVEltVT, false, false);
                    }
                    return self.getBitcast(VT, self.getBuildVector(BVVT, DL, ArrayRef<SDValue> { Ops }));
                }
            }
        }
        if isBitwiseLogicOp(Opcode) && isa(N1) && isa(N2) {
            if self.FoldConstantArithmetic(Opcode, DL, N1.getValueType(), ArrayRef<SDValue> { [N1, N2] }, Flags) {
                Res;
            } else {
                return self.getBitcast(VT, Res);
            }
        }
    }
    if (Opcode == MUL || Opcode == SHL) && Ops[0].getOpcode() == STEP_VECTOR {
        let mut RHSVal: APInt = APInt {};
        if isConstantSplatVector(Ops[1].getNode(), RHSVal) {
            let mut NewStep: APInt = if Opcode == MUL { Ops[0].getConstantOperandAPInt(0) * RHSVal } else { Ops[0].getConstantOperandAPInt(0) << RHSVal };
            return self.getStepVector(DL, VT, NewStep);
        }
    }
    let mut IsScalarOrSameVectorSize: Closure_16 = Closure_16 { cap_0: NumElts };
    let mut IsBuildVectorSplatVectorOrUndef: Closure_17 = Closure_17 {};
    if !all_of(Ops, IsBuildVectorSplatVectorOrUndef) || !all_of(Ops, IsScalarOrSameVectorSize) {
        return SDValue {};
    }
    let mut SVT: EVT = (if Opcode == SETCC { EVT { i1 } } else { VT.getScalarType() });
    let mut ExtendCode: NodeType = if (Opcode == SETCC && SVT != VT.getScalarType()) { getExtendForContent(self.TLI.getBooleanContents(VT)) } else { SIGN_EXTEND };
    let mut LegalSVT: EVT = VT.getScalarType();
    if self.NewNodesMustHaveLegalTypes && LegalSVT.isInteger() {
        LegalSVT = self.TLI.getTypeToTransformTo(*self.getContext(), LegalSVT);
        if LegalSVT.bitsLT(VT.getScalarType()) {
            return SDValue {};
        }
    }
    let mut NumVectorElts: u32 = if NumElts.isScalable() { 1 } else { NumElts.getFixedValue() };
    let mut ScalarResults: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    for let mut I: u32 = 0; I != NumVectorElts; I += 1 {
        let mut ScalarOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
        for Op in Ops {
            let mut InSVT: EVT = Op.getValueType().getScalarType();
            if Op.getOpcode() != BUILD_VECTOR && Op.getOpcode() != SPLAT_VECTOR {
                if Op.isUndef() {
                    ScalarOps.push(self.getUNDEF(InSVT));
                } else {
                    ScalarOps.push(ValueParamT { Op });
                }
                continue;
            }
            let mut ScalarOp: SDValue = Op.getOperand(if Op.getOpcode() == SPLAT_VECTOR { 0 } else { I });
            let mut ScalarVT: EVT = ScalarOp.getValueType();
            if ScalarVT.isInteger() && ScalarVT.bitsGT(InSVT) {
                if self.NewNodesMustHaveLegalTypes && !ScalarOp.isUndef() && !isa(ScalarOp) && self.TLI.getTypeAction(*self.getContext(), InSVT) != TypeLegal {
                    return SDValue {};
                }
                ScalarOp = self.getNode(TRUNCATE, DL, InSVT, ScalarOp);
            }
            ScalarOps.push(ValueParamT { ScalarOp });
        }
        let mut ScalarResult: SDValue = self.getNode(Opcode, DL, SVT, ArrayRef<SDValue> { ScalarOps }, Flags);
        if !ScalarResult.isUndef() && ScalarResult.getOpcode() != Constant && ScalarResult.getOpcode() != ConstantFP {
            return SDValue {};
        }
        if LegalSVT != SVT {
            ScalarResult = self.getNode(ExtendCode, DL, LegalSVT, ScalarResult);
        }
        ScalarResults.push(ValueParamT { ScalarResult });
    }
    let mut V: SDValue = if NumElts.isScalable() { self.getSplatVector(VT, DL, ScalarResults[0]) } else { self.getBuildVector(VT, DL, ArrayRef<SDValue> { ScalarResults }) };
    NewSDValueDbgMsg(V, "New node fold constant vector: ", self);
    return V;
}

fn SelectionDAG::foldConstantFPMath(self, Opcode: u32, DL: *SDLoc, VT: EVT, Ops: ArrayRef<SDValue>) -> SDValue {
    if Ops.len != 2 {
        return SDValue {};
    }
    let mut N1: SDValue = Ops[0];
    let mut N2: SDValue = Ops[1];
    let mut N1CFP: *mut ConstantFPSDNode = isConstOrConstSplatFP(N1, false);
    let mut N2CFP: *mut ConstantFPSDNode = isConstOrConstSplatFP(N2, false);
    if N1CFP && N2CFP {
        let mut C1: APFloat = N1CFP.getValueAPF();
        let mut C2: *APFloat = N2CFP.getValueAPF();
        match Opcode {
            FADD => {
                C1.add(C2, rmNearestTiesToEven);
            },
            FSUB => {
                C1.subtract(C2, rmNearestTiesToEven);
            },
            FMUL => {
                C1.multiply(C2, rmNearestTiesToEven);
            },
            FDIV => {
                C1.divide(C2, rmNearestTiesToEven);
            },
            FREM => {
                C1.mod(C2);
            },
            FCOPYSIGN => {
                C1.copySign(C2);
            },
            FMINNUM => {
                return self.getConstantFP(minnum(C1, C2), DL, VT, false);
            },
            FMAXNUM => {
                return self.getConstantFP(maxnum(C1, C2), DL, VT, false);
            },
            FMINIMUM => {
                return self.getConstantFP(minimum(C1, C2), DL, VT, false);
            },
            FMAXIMUM => {
                return self.getConstantFP(maximum(C1, C2), DL, VT, false);
            },
            FMINIMUMNUM => {
                return self.getConstantFP(minimumnum(C1, C2), DL, VT, false);
            },
            FMAXIMUMNUM => {
                return self.getConstantFP(maximumnum(C1, C2), DL, VT, false);
            },
            _ => {
                break;
            },
        }
    }
    if N1CFP && Opcode == FP_ROUND {
        let mut C1: APFloat = N1CFP.getValueAPF();
        let mut Unused: bool = false;
        C1.convert(VT.getFltSemantics(), rmNearestTiesToEven, &mut Unused) as void;
        return self.getConstantFP(C1, DL, VT, false);
    }
    match Opcode {
        FSUB => {
            if isConstOrConstSplatFP(N1, true) {
                N1C;
            } else if N1C && N1C.getValueAPF().isNegZero() && N2.isUndef() {
                return self.getUNDEF(VT);
            }
        },
        FADD => {
            FMUL;
        },
    }
    return SDValue {};
}

fn SelectionDAG::FoldConstantBuildVector(self, BV: *mut BuildVectorSDNode, DL: *SDLoc, DstEltVT: EVT) -> SDValue {
    let mut SrcEltVT: EVT = BV.getValueType(0).getVectorElementType();
    if SrcEltVT == DstEltVT {
        return SDValue { Node: BV, ResNo: 0 };
    }
    let mut SrcBitSize: u32 = SrcEltVT.getSizeInBits().operator unsigned long long();
    let mut DstBitSize: u32 = DstEltVT.getSizeInBits().operator unsigned long long();
    if SrcBitSize == DstBitSize {
        let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
        for Op in BV.op_values() {
            if Op.getValueType() != SrcEltVT {
                Op = self.getNode(TRUNCATE, DL, SrcEltVT, Op);
            }
            Ops.push(self.getBitcast(DstEltVT, Op));
        }
        let mut VT: EVT = getVectorVT(*self.getContext(), DstEltVT, BV.getValueType(0).getVectorNumElements(), false);
        return self.getBuildVector(VT, DL, ArrayRef<SDValue> { Ops });
    }
    if SrcEltVT.isFloatingPoint() {
        let mut IntEltVT: EVT = getIntegerVT(*self.getContext(), SrcEltVT.getSizeInBits().operator unsigned long long());
        if self.FoldConstantBuildVector(BV, DL, IntEltVT) {
            Tmp;
        } else {
            return self.FoldConstantBuildVector(cast(Tmp), DL, DstEltVT);
        }
        return SDValue {};
    }
    if DstEltVT.isFloatingPoint() {
        let mut IntEltVT: EVT = getIntegerVT(*self.getContext(), DstEltVT.getSizeInBits().operator unsigned long long());
        if self.FoldConstantBuildVector(BV, DL, IntEltVT) {
            Tmp;
        } else {
            return self.FoldConstantBuildVector(cast(Tmp), DL, DstEltVT);
        }
        return SDValue {};
    }
    assert!(SrcEltVT.isInteger() && DstEltVT.isInteger());
    let mut UndefElements: BitVector = BitVector {};
    let mut RawBits: SmallVector<APInt> = SmallVector<APInt> {};
    let mut IsLE: bool = self.getDataLayout().isLittleEndian();
    if !BV.getConstantRawBits(IsLE, DstBitSize, RawBits, UndefElements) {
        return SDValue {};
    }
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    for let mut I: u32 = 0;
let mut E: u32 = RawBits.len; I != E; I += 1 {
        if UndefElements[I] {
            Ops.push(self.getUNDEF(DstEltVT));
        } else {
            Ops.push(self.getConstant(RawBits[I], DL, DstEltVT, false, false));
        }
    }
    let mut VT: EVT = getVectorVT(*self.getContext(), DstEltVT, Ops.len, false);
    return self.getBuildVector(VT, DL, ArrayRef<SDValue> { Ops });
}

fn SelectionDAG::getAssertAlign(self, DL: *SDLoc, Val: SDValue, A: Align) -> SDValue {
    assert!(Val.getValueType().isInteger(), "Invalid AssertAlign!");
    if A == Align { ShiftValue: 1 } {
        return Val;
    }
    let mut VTs: SDVTList = self.getVTList(Val.getValueType());
    let mut Ops: [1]SDValue = [Val];
    let mut ID: SDNodeKey = SDNodeKey { AssertAlign, VTs, ArrayRef<SDValue> { Ops } };
    ID.AddInteger(A.value());
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, DL, InsertToken) {
        E;
    } else {
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut AssertAlignSDNode = self.newSDNode(DL.getIROrder(), DL.getDebugLoc(), VTs, A);
    self.createOperands(N, ArrayRef<SDValue> { [Val] });
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    let mut V: SDValue = SDValue { Node: N, ResNo: 0 };
    NewSDValueDbgMsg(V, "Creating new node: ", self);
    return V;
}

fn SelectionDAG::getNode(self, Opcode: u32, DL: *SDLoc, VT: EVT, N1: SDValue, N2: SDValue) -> SDValue {
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    if self.Inserter {
        Flags = self.Inserter.getFlags();
    }
    return self.getNode(Opcode, DL, VT, N1, N2, Flags);
}

fn SelectionDAG::canonicalizeCommutativeBinop(self: *SelectionDAG, Opcode: u32, N1: *mut SDValue, N2: *mut SDValue) {
    if !self.TLI.isCommutativeBinOp(Opcode) {
        return;
    }
    let mut N1C: bool = self.isConstantIntBuildVectorOrConstantInt(N1, true);
    let mut N2C: bool = self.isConstantIntBuildVectorOrConstantInt(N2, true);
    let mut N1CFP: bool = self.isConstantFPBuildVectorOrConstantFP(N1);
    let mut N2CFP: bool = self.isConstantFPBuildVectorOrConstantFP(N2);
    if (N1C && !N2C) || (N1CFP && !N2CFP) {
        swap(N1, N2);
    } else if N1.getOpcode() == SPLAT_VECTOR && N2.getOpcode() == STEP_VECTOR {
        swap(N1, N2);
    }
}

fn SelectionDAG::getNode(self, Opcode: u32, DL: *SDLoc, VT: EVT, N1: SDValue, N2: SDValue, Flags: SDNodeFlags) -> SDValue {
    assert!(N1.getOpcode() != DELETED_NODE && N2.getOpcode() != DELETED_NODE, "Operand is DELETED_NODE!");
    self.canonicalizeCommutativeBinop(Opcode, N1, N2);
    let mut N1C: *mut ConstantSDNode = dyn_cast(N1);
    let mut N2C: *mut ConstantSDNode = dyn_cast(N2);
    let mut N2CV: *mut ConstantSDNode = isConstOrConstSplat(N2, false, true);
    match Opcode {
        _ => {
            break;
        },
        TokenFactor => {
            assert!(VT == EVT { Other } && N1.getValueType() == EVT { Other } && N2.getValueType() == EVT { Other }, "Invalid token factor!");
        },
        BUILD_VECTOR => {
            let mut Ops: [2]SDValue = [N1, N2];
            if FoldBUILD_VECTOR(DL, VT, ArrayRef<SDValue> { Ops }, *self) {
                V;
            } else {
                return V;
            }
            break;
        },
        CONCAT_VECTORS => {
            let mut Ops: [2]SDValue = [N1, N2];
            if foldCONCAT_VECTORS(DL, VT, ArrayRef<SDValue> { Ops }, *self) {
                V;
            } else {
                return V;
            }
            break;
        },
        AND => {
            assert!(VT.isInteger(), "This operator does not apply to FP types!");
        },
        OR => {
            XOR;
        },
        MUL => {
            assert!(VT.isInteger(), "This operator does not apply to FP types!");
        },
        UDIV => {
            UREM;
        },
        SCMP => {
            UCMP;
        },
        AVGFLOORS => {
            AVGFLOORU;
        },
        ABDS => {
            ABDU;
        },
        SMIN => {
            UMAX;
        },
        SMAX => {
            UMIN;
        },
        FADD => {
            FSUB;
        },
        FCOPYSIGN => {
            assert!(N1.getValueType() == VT && N1.getValueType().isFloatingPoint() && N2.getValueType().isFloatingPoint(), "Invalid FCOPYSIGN!");
        },
        SHL => {
            if N2C && (N1.getOpcode() == VSCALE) && Flags.hasNoSignedWrap() {
                let mut MulImm: *APInt = operator(N1).getConstantOperandAPInt(0);
                let mut ShiftImm: *APInt = N2C.getAPIntValue();
                return self.getVScale(DL, VT, MulImm << ShiftImm);
            }
        },
        SRA => {
            SRL;
        },
        ROTL => {
            ROTR;
        },
        FP_ROUND => {
            assert!(VT.isFloatingPoint() && N1.getValueType().isFloatingPoint() && VT.bitsLE(N1.getValueType()) && N2C && (N2C.getZExtValue() == 0 || N2C.getZExtValue() == 1) && N2.getOpcode() == TargetConstant, "Invalid FP_ROUND!");
        },
        IS_FPCLASS => {
            assert!(N1.getValueType().isFloatingPoint(), "IS_FPCLASS is used for a non-floating type");
            assert!(isa(N2), "FPClassTest is not Constant");
            if N1.getOpcode() == POISON {
                return self.getPOISON(VT);
            }
            let mut Mask: FPClassTest = operator(N2).getAsZExtVal() as FPClassTest;
            if (Mask & fcAllFlags) == fcAllFlags {
                return self.getBoolConstant(true, DL, VT, N1.getValueType());
            }
            if (Mask & fcAllFlags) == 0 {
                return self.getBoolConstant(false, DL, VT, N1.getValueType());
            }
            break;
        },
        AssertNoFPClass => {
            assert!(N1.getValueType().isFloatingPoint(), "AssertNoFPClass is used for a non-floating type");
            assert!(isa(N2), "NoFPClass is not Constant");
            let mut NoFPClass: FPClassTest = operator(N2).getAsZExtVal() as FPClassTest;
            assert!(to_underlying(NoFPClass) <= Mask(), "FPClassTest value too large");
            NoFPClass as void;
            break;
        },
        AssertSext => {
            AssertZext;
        },
        SIGN_EXTEND_INREG => {
            let mut EVT: EVT = cast(N2).getVT();
            assert!(VT == N1.getValueType(), "Not an inreg extend!");
            assert!(VT.isInteger() && EVT.isInteger(), "Cannot *_EXTEND_INREG FP types");
            assert!(EVT.isVector() == VT.isVector(), "SIGN_EXTEND_INREG type should be vector iff the operand type is vector!");
            assert!((!EVT.isVector() || EVT.getVectorElementCount() == VT.getVectorElementCount()), "Vector element counts must match in SIGN_EXTEND_INREG");
            assert!(EVT.getScalarType().bitsLE(VT.getScalarType()), "Not extending!");
            if EVT == VT {
                return N1;
            }
            break;
        },
        FP_TO_SINT_SAT => {
            FP_TO_UINT_SAT;
        },
        EXTRACT_VECTOR_ELT => {
            assert!(VT.getSizeInBits().operator unsigned long long() >= N1.getValueType().getScalarSizeInBits(), "The result of EXTRACT_VECTOR_ELT must be at least as wide as the              element type of the vector.");
        },
        EXTRACT_ELEMENT => {
            assert!(N2C && N2C.getZExtValue() as u32 < 2, "Bad EXTRACT_ELEMENT!");
        },
        EXTRACT_SUBVECTOR => {
            let mut N1VT: EVT = N1.getValueType();
            assert!(VT.isVector() && N1VT.isVector(), "Extract subvector VTs must be vectors!");
            assert!(VT.getVectorElementType() == N1VT.getVectorElementType(), "Extract subvector VTs must have the same element type!");
            assert!((VT.isFixedLengthVector() || N1VT.isScalableVector()), "Cannot extract a scalable vector from a fixed length vector!");
            assert!((VT.isScalableVector() != N1VT.isScalableVector() || VT.getVectorMinNumElements() <= N1VT.getVectorMinNumElements()), "Extract subvector must be from larger vector to smaller vector!");
            assert!(N2C, "Extract subvector index must be a constant");
            assert!((VT.isScalableVector() != N1VT.isScalableVector() || (VT.getVectorMinNumElements() + N2C.getZExtValue()) <= N1VT.getVectorMinNumElements()), "Extract subvector overflow!");
            assert!(N2C.getAPIntValue().getBitWidth() == self.TLI.getVectorIdxWidth(self.getDataLayout()), "Constant index for EXTRACT_SUBVECTOR has an invalid size");
            assert!(N2C.getZExtValue() % VT.getVectorMinNumElements() == 0, "Extract index is not a multiple of the output vector length");
            if VT == N1VT {
                return N1;
            }
            if N1.isUndef() {
                return self.getUNDEF(VT);
            }
            if N1.getOpcode() == CONCAT_VECTORS && VT == N1.getOperand(0).getValueType() {
                let mut Factor: u32 = VT.getVectorMinNumElements();
                return N1.getOperand(N2C.getZExtValue() / Factor);
            }
            if N1.getOpcode() == INSERT_SUBVECTOR && N2 == N1.getOperand(2) && VT == N1.getOperand(1).getValueType() {
                return N1.getOperand(1);
            }
            break;
        },
    }
    if N1.getOpcode() == POISON || N2.getOpcode() == POISON {
        match Opcode {
            XOR => {
                ADD;
            },
        }
    }
    if N1.getOpcode() == UNDEF && N2.getOpcode() != UNDEF {
        if self.TLI.isCommutativeBinOp(Opcode) {
            swap(N1, N2);
        } else {
            match Opcode {
                PTRADD => {
                    SUB;
                },
                SIGN_EXTEND_INREG => {
                    UDIV;
                },
            }
        }
    }
    if N2.getOpcode() == UNDEF {
        match Opcode {
            XOR => {
                if N1.getOpcode() == UNDEF {
                    return self.getConstant(0, DL, VT, false, false);
                }
            },
            ADD => {
                PTRADD;
            },
            UDIV => {
                SDIV;
            },
            MUL => {
                AND;
            },
            OR => {
                SADDSAT;
            },
            SMAX => {
                return if N1.getOpcode() == UNDEF { N2 } else { self.getConstant(getSignedMaxValue(VT.getScalarSizeInBits()), DL, VT, false, false) };
            },
            SMIN => {
                return if N1.getOpcode() == UNDEF { N2 } else { self.getConstant(getSignedMinValue(VT.getScalarSizeInBits()), DL, VT, false, false) };
            },
        }
    }
    if self.FoldConstantArithmetic(Opcode, DL, VT, ArrayRef<SDValue> { [N1, N2] }, Flags) {
        SV;
    } else {
        return SV;
    }
    let mut N: *mut SDNode = null;
    let mut VTs: SDVTList = self.getVTList(VT);
    let mut Ops: [2]SDValue = [N1, N2];
    if VT != EVT { Glue } {
        let mut ID: SDNodeKey = SDNodeKey { Opcode, VTs, ArrayRef<SDValue> { Ops } };
        let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
        if self.lookupNode(ID, DL, InsertToken) {
            E;
        } else {
            E.intersectFlagsWith(Flags);
            return SDValue { Node: E, ResNo: 0 };
        }
        N = self.newSDNode(Opcode, DL.getIROrder(), DL.getDebugLoc(), VTs);
        N.setFlags(Flags);
        self.createOperands(N, ArrayRef<SDValue> { Ops });
        self.CSEMap.insert(N, InsertToken);
    } else {
        N = self.newSDNode(Opcode, DL.getIROrder(), DL.getDebugLoc(), VTs);
        self.createOperands(N, ArrayRef<SDValue> { Ops });
    }
    self.InsertNode(N);
    let mut V: SDValue = SDValue { Node: N, ResNo: 0 };
    NewSDValueDbgMsg(V, "Creating new node: ", self);
    return V;
}

fn SelectionDAG::getNode(self, Opcode: u32, DL: *SDLoc, VT: EVT, N1: SDValue, N2: SDValue, N3: SDValue) -> SDValue {
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    if self.Inserter {
        Flags = self.Inserter.getFlags();
    }
    return self.getNode(Opcode, DL, VT, N1, N2, N3, Flags);
}

fn SelectionDAG::getNode(self, Opcode: u32, DL: *SDLoc, VT: EVT, N1: SDValue, N2: SDValue, N3: SDValue, Flags: SDNodeFlags) -> SDValue {
    assert!(N1.getOpcode() != DELETED_NODE && N2.getOpcode() != DELETED_NODE && N3.getOpcode() != DELETED_NODE, "Operand is DELETED_NODE!");
    match Opcode {
        BUILD_VECTOR => {
            let mut Ops: [3]SDValue = [N1, N2, N3];
            if FoldBUILD_VECTOR(DL, VT, ArrayRef<SDValue> { Ops }, *self) {
                V;
            } else {
                return V;
            }
            break;
        },
        CONCAT_VECTORS => {
            let mut Ops: [3]SDValue = [N1, N2, N3];
            if foldCONCAT_VECTORS(DL, VT, ArrayRef<SDValue> { Ops }, *self) {
                V;
            } else {
                return V;
            }
            break;
        },
        SETCC => {
            assert!(VT.isInteger(), "SETCC result type must be an integer!");
            assert!(N1.getValueType() == N2.getValueType(), "SETCC operands must have the same type!");
            assert!(VT.isVector() == N1.getValueType().isVector(), "SETCC type should be vector iff the operand type is vector!");
            assert!((!VT.isVector() || VT.getVectorElementCount() == N1.getValueType().getVectorElementCount()), "SETCC vector element counts must match!");
            if self.FoldSetCC(VT, N1, N2, cast(N3).get(), DL, Flags) {
                V;
            } else {
                return V;
            }
            break;
        },
        SELECT => {
            VSELECT;
        },
        VECTOR_SHUFFLE => {
            llvm_unreachable_internal("should use getVectorShuffle constructor!", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAG.cpp", 9116);
        },
        VECTOR_SPLICE_LEFT => {
            if isNullConstant(N3) {
                return N1;
            }
        },
        VECTOR_SPLICE_RIGHT => {
            if isNullConstant(N3) {
                return N2;
            }
        },
        INSERT_VECTOR_ELT => {
            assert!(VT.isVector() && VT == N1.getValueType(), "INSERT_VECTOR_ELT vector type mismatch");
            assert!(VT.isFloatingPoint() == N2.getValueType().isFloatingPoint(), "INSERT_VECTOR_ELT scalar fp/int mismatch");
            assert!((!VT.isFloatingPoint() || VT.getVectorElementType() == N2.getValueType()), "INSERT_VECTOR_ELT fp scalar type mismatch");
            assert!((!VT.isInteger() || VT.getScalarSizeInBits() <= N2.getScalarValueSizeInBits()), "INSERT_VECTOR_ELT int scalar size mismatch");
            let mut N3C: *mut ConstantSDNode = dyn_cast(N3);
            if N3C && VT.isFixedLengthVector() && N3C.getZExtValue() >= VT.getVectorNumElements() {
                return self.getUNDEF(VT);
            }
            if N3.isUndef() {
                return self.getUNDEF(VT);
            }
            if N2.getOpcode() == POISON {
                return N1;
            }
            if N2.getOpcode() == UNDEF && N1.isUndef() {
                return self.getUNDEF(VT);
            }
            if N2.isUndef() {
                if N3C && VT.isFixedLengthVector() {
                    let mut EltMask: APInt = getOneBitSet(VT.getVectorNumElements(), N3C.getZExtValue());
                    if self.isGuaranteedNotToBePoison(N1, EltMask, 0) {
                        return N1;
                    }
                } else if self.isGuaranteedNotToBePoison(N1, 0) {
                    return N1;
                }
            }
            break;
        },
        INSERT_SUBVECTOR => {
            if N2.getOpcode() == POISON {
                return N1;
            }
            if N2.getOpcode() == UNDEF && N1.isUndef() {
                return self.getUNDEF(VT);
            }
            let mut N2VT: EVT = N2.getValueType();
            assert!(VT == N1.getValueType(), "Dest and insert subvector source types must match!");
            assert!(VT.isVector() && N2VT.isVector(), "Insert subvector VTs must be vectors!");
            assert!(VT.getVectorElementType() == N2VT.getVectorElementType(), "Insert subvector VTs must have the same element type!");
            assert!((VT.isScalableVector() || N2VT.isFixedLengthVector()), "Cannot insert a scalable vector into a fixed length vector!");
            assert!((VT.isScalableVector() != N2VT.isScalableVector() || VT.getVectorMinNumElements() >= N2VT.getVectorMinNumElements()), "Insert subvector must be from smaller vector to larger vector!");
            assert!(isa(N3), "Insert subvector index must be constant");
            assert!((VT.isScalableVector() != N2VT.isScalableVector() || (N2VT.getVectorMinNumElements() + operator(N3).getAsZExtVal()) <= VT.getVectorMinNumElements()), "Insert subvector overflow!");
            assert!(operator(N3).getAsAPIntVal().getBitWidth() == self.TLI.getVectorIdxWidth(self.getDataLayout()), "Constant index for INSERT_SUBVECTOR has an invalid size");
            if VT == N2VT {
                return N2;
            }
            if N1.isUndef() && N2.getOpcode() == EXTRACT_SUBVECTOR && N2.getOperand(1) == N3 && N2.getOperand(0).getValueType() == VT {
                if N1.getOpcode() == POISON {
                    return N2.getOperand(0);
                }
                if VT.isFixedLengthVector() && N2VT.isFixedLengthVector() {
                    let mut LoBit: u32 = operator(N3).getAsZExtVal();
                    let mut HiBit: u32 = LoBit + N2VT.getVectorNumElements();
                    let mut EltMask: APInt = getBitsSet(VT.getVectorNumElements(), LoBit, HiBit);
                    if self.isGuaranteedNotToBePoison(N2.getOperand(0), operator(EltMask), 0) {
                        return N2.getOperand(0);
                    }
                } else if self.isGuaranteedNotToBePoison(N2.getOperand(0), 0) {
                    return N2.getOperand(0);
                }
            }
            if N2.isUndef() {
                if VT.isFixedLengthVector() {
                    let mut LoBit: u32 = operator(N3).getAsZExtVal();
                    let mut HiBit: u32 = LoBit + N2VT.getVectorNumElements();
                    let mut EltMask: APInt = getBitsSet(VT.getVectorNumElements(), LoBit, HiBit);
                    if self.isGuaranteedNotToBePoison(N1, EltMask, 0) {
                        return N1;
                    }
                } else if self.isGuaranteedNotToBePoison(N1, 0) {
                    return N1;
                }
            }
            break;
        },
        BITCAST => {
            if N1.getValueType() == VT {
                return N1;
            }
        },
        VECTOR_COMPRESS => {
            let mut VecVT: EVT = N1.getValueType();
            let mut MaskVT: EVT = N2.getValueType();
            let mut PassthruVT: EVT = N3.getValueType();
            assert!(VT == VecVT, "Vector and result type don't match.");
            assert!(VecVT.isVector() && MaskVT.isVector() && PassthruVT.isVector(), "All inputs must be vectors.");
            assert!(VecVT == PassthruVT, "Vector and passthru types don't match.");
            assert!(VecVT.getVectorElementCount() == MaskVT.getVectorElementCount(), "Vector and mask must have same number of elements.");
            if N1.isUndef() || N2.isUndef() {
                return N3;
            }
            break;
        },
        PARTIAL_REDUCE_UMLA => {
            PARTIAL_REDUCE_SMLA;
        },
    }
    match Opcode {
        PARTIAL_REDUCE_SMLA => {
            PARTIAL_REDUCE_UMLA;
        },
    }
    let mut N: *mut SDNode = null;
    let mut VTs: SDVTList = self.getVTList(VT);
    let mut Ops: [3]SDValue = [N1, N2, N3];
    if VT != EVT { Glue } {
        let mut ID: SDNodeKey = SDNodeKey { Opcode, VTs, ArrayRef<SDValue> { Ops } };
        let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
        if self.lookupNode(ID, DL, InsertToken) {
            E;
        } else {
            E.intersectFlagsWith(Flags);
            return SDValue { Node: E, ResNo: 0 };
        }
        N = self.newSDNode(Opcode, DL.getIROrder(), DL.getDebugLoc(), VTs);
        N.setFlags(Flags);
        self.createOperands(N, ArrayRef<SDValue> { Ops });
        self.CSEMap.insert(N, InsertToken);
    } else {
        N = self.newSDNode(Opcode, DL.getIROrder(), DL.getDebugLoc(), VTs);
        self.createOperands(N, ArrayRef<SDValue> { Ops });
    }
    self.InsertNode(N);
    let mut V: SDValue = SDValue { Node: N, ResNo: 0 };
    NewSDValueDbgMsg(V, "Creating new node: ", self);
    return V;
}

fn SelectionDAG::getNode(self, Opcode: u32, DL: *SDLoc, VT: EVT, N1: SDValue, N2: SDValue, N3: SDValue, N4: SDValue, Flags: SDNodeFlags) -> SDValue {
    let mut Ops: [4]SDValue = [N1, N2, N3, N4];
    return self.getNode(Opcode, DL, VT, ArrayRef<SDValue> { Ops }, Flags);
}

fn SelectionDAG::getNode(self, Opcode: u32, DL: *SDLoc, VT: EVT, N1: SDValue, N2: SDValue, N3: SDValue, N4: SDValue) -> SDValue {
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    if self.Inserter {
        Flags = self.Inserter.getFlags();
    }
    return self.getNode(Opcode, DL, VT, N1, N2, N3, N4, Flags);
}

fn SelectionDAG::getNode(self, Opcode: u32, DL: *SDLoc, VT: EVT, N1: SDValue, N2: SDValue, N3: SDValue, N4: SDValue, N5: SDValue, Flags: SDNodeFlags) -> SDValue {
    let mut Ops: [5]SDValue = [N1, N2, N3, N4, N5];
    return self.getNode(Opcode, DL, VT, ArrayRef<SDValue> { Ops }, Flags);
}

fn SelectionDAG::getNode(self, Opcode: u32, DL: *SDLoc, VT: EVT, N1: SDValue, N2: SDValue, N3: SDValue, N4: SDValue, N5: SDValue) -> SDValue {
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    if self.Inserter {
        Flags = self.Inserter.getFlags();
    }
    return self.getNode(Opcode, DL, VT, N1, N2, N3, N4, N5, Flags);
}

fn SelectionDAG::getStackArgumentTokenFactor(self, Chain: SDValue) -> SDValue {
    let mut ArgChains: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    ArgChains.push(ValueParamT { Chain });
    for U in self.getEntryNode().getNode().users() {
        if dyn_cast(U) {
            L;
        } else if dyn_cast(L.getBasePtr()) {
            FI;
        } else if FI.getIndex() < 0 {
            ArgChains.push(SDValue { Node: L, ResNo: 1 });
        }
    }
    return self.getNode(TokenFactor, SDLoc { Chain }, EVT { Other }, ArrayRef<SDValue> { ArgChains });
}

fn getMemsetValue(Value: SDValue, VT: EVT, DAG: *mut SelectionDAG, dl: *SDLoc) -> SDValue {
    assert!(!Value.isUndef());
    let mut NumBits: u32 = VT.getScalarSizeInBits();
    if dyn_cast(Value) {
        C;
    } else {
        assert!(C.getAPIntValue().getBitWidth() == 8);
        let mut Val: APInt = getSplat(NumBits, C.getAPIntValue());
        if VT.isInteger() {
            let mut IsOpaque: bool = VT.getSizeInBits().operator unsigned long long() > 64 || !DAG.getTargetLoweringInfo().isLegalStoreImmediate(C.getSExtValue());
            return DAG.getConstant(Val, dl, VT, false, IsOpaque);
        }
        return DAG.getConstantFP(APFloat { VT.getFltSemantics(), Val }, dl, VT, false);
    }
    assert!(Value.getValueType() == EVT { i8 }, "memset with non-byte fill value?");
    let mut IntVT: EVT = VT.getScalarType();
    if !IntVT.isInteger() {
        IntVT = getIntegerVT(*DAG.getContext(), IntVT.getSizeInBits().operator unsigned long long());
    }
    Value = DAG.getNode(ZERO_EXTEND, dl, IntVT, Value);
    if NumBits > 8 {
        let mut Magic: APInt = getSplat(NumBits, APInt { 8, 1, false, false });
        Value = DAG.getNode(MUL, dl, IntVT, Value, DAG.getConstant(Magic, dl, IntVT, false, false));
    }
    if VT != Value.getValueType() && !VT.isInteger() {
        Value = DAG.getBitcast(VT.getScalarType(), Value);
    }
    if VT != Value.getValueType() {
        Value = DAG.getSplatBuildVector(VT, dl, Value);
    }
    return Value;
}

fn getMemsetStringVal(VT: EVT, dl: *SDLoc, DAG: *mut SelectionDAG, TLI: *TargetLowering, Slice: *ConstantDataArraySlice) -> SDValue {
    if Slice.Array == null {
        if VT.isInteger() {
            return DAG.getConstant(0, dl, VT, false, false);
        }
        return DAG.getNode(BITCAST, dl, VT, DAG.getConstant(0, dl, VT.changeTypeToInteger(), false, false));
    }
    assert!(!VT.isVector(), "Can't handle vector type here!");
    let mut NumVTBits: u32 = VT.getSizeInBits().operator unsigned long long();
    let mut NumVTBytes: u32 = NumVTBits / 8;
    let mut NumBytes: u32 = if NumVTBytes < Slice.Length { NumVTBytes } else { Slice.Length };
    let mut Val: APInt = APInt { NumVTBits, 0, false, false };
    if DAG.getDataLayout().isLittleEndian() {
        for let mut i: u32 = 0; i != NumBytes; i += 1 {
            operator(Val, Slice[i] as u8 as u64 << i * 8);
        }
    } else {
        for let mut i: u32 = 0; i != NumBytes; i += 1 {
            operator(Val, Slice[i] as u8 as u64 << (NumVTBytes - i - 1) * 8);
        }
    }
    let mut Ty: *mut Type = VT.getTypeForEVT(*DAG.getContext());
    if TLI.shouldConvertConstantLoadToIntImm(Val, Ty) {
        return DAG.getConstant(Val, dl, VT, false, false);
    }
    return SDValue {};
}

fn SelectionDAG::getMemBasePlusOffset(self, Base: SDValue, Offset: TypeSize, DL: *SDLoc, Flags: SDNodeFlags) -> SDValue {
    let mut Index: SDValue = self.getTypeSize(DL, Base.getValueType(), Offset);
    return self.getMemBasePlusOffset(Base, Index, DL, Flags);
}

fn SelectionDAG::getMemBasePlusOffset(self, Ptr: SDValue, Offset: SDValue, DL: *SDLoc, Flags: SDNodeFlags) -> SDValue {
    assert!(Offset.getValueType().isInteger());
    let mut BasePtrVT: EVT = Ptr.getValueType();
    if self.TLI.shouldPreservePtrArith(self.getMachineFunction().getFunction(), BasePtrVT) {
        return self.getNode(PTRADD, DL, BasePtrVT, Ptr, Offset, Flags);
    }
    let mut AddFlags: SDNodeFlags = Flags;
    AddFlags.setInBounds(false);
    return self.getNode(ADD, DL, BasePtrVT, Ptr, Offset, AddFlags);
}

fn isMemSrcFromConstant(Src: SDValue, Slice: *mut ConstantDataArraySlice) -> bool {
    let mut SrcDelta: u64 = 0;
    let mut G: *mut GlobalAddressSDNode = null;
    if Src.getOpcode() == GlobalAddress {
        G = cast(Src);
    } else if operator(Src).isAnyAdd() && Src.getOperand(0).getOpcode() == GlobalAddress && Src.getOperand(1).getOpcode() == Constant {
        G = cast(Src.getOperand(0));
        SrcDelta = Src.getConstantOperandVal(1);
    }
    if !G {
        return false;
    }
    return getConstantDataArrayInfo(G.getGlobal(), Slice, 8, SrcDelta + G.getOffset());
}

fn shouldLowerMemFuncForSize(MF: *MachineFunction, DAG: *mut SelectionDAG) -> bool {
    if MF.getTarget().getTargetTriple().isOSDarwin() {
        return MF.getFunction().hasMinSize();
    }
    return DAG.shouldOptForSize();
}

fn chainLoadsAndStoresForMemcpy(DAG: *mut SelectionDAG, dl: *SDLoc, OutChains: *mut SmallVector<SDValue, 32>, From: u32, To: u32, OutLoadChains: *mut SmallVector<SDValue, 16>, OutStoreChains: *mut SmallVector<SDValue, 16>) {
    assert!(OutLoadChains.len, "Missing loads in memcpy inlining");
    assert!(OutStoreChains.len, "Missing stores in memcpy inlining");
    let mut GluedLoadChains: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    for let mut i: u32 = From; i < To; i += 1 {
        OutChains.push(ValueParamT { OutLoadChains[i] });
        GluedLoadChains.push(ValueParamT { OutLoadChains[i] });
    }
    let mut LoadToken: SDValue = DAG.getNode(TokenFactor, dl, EVT { Other }, ArrayRef<SDValue> { GluedLoadChains });
    for let mut i: u32 = From; i < To; i += 1 {
        let mut ST: *mut StoreSDNode = dyn_cast(OutStoreChains[i]);
        let mut NewStore: SDValue = DAG.getTruncStore(LoadToken, dl, ST.getValue(), ST.getBasePtr(), ST.getMemoryVT(), ST.getMemOperand());
        OutChains.push(ValueParamT { NewStore });
    }
}

fn getMemcpyLoadsAndStores(DAG: *mut SelectionDAG, dl: *SDLoc, Chain: SDValue, Dst: SDValue, Src: SDValue, Size: u64, DstAlign: Align, SrcAlign: Align, isVol: bool, AlwaysInline: bool, DstPtrInfo: MachinePointerInfo, SrcPtrInfo: MachinePointerInfo, AAInfo: *AAMDNodes, BatchAA: *mut BatchAAResults, DstMemCacheHint: *MDNode, SrcMemCacheHint: *MDNode) -> SDValue {
    if Src.isUndef() {
        return Chain;
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut DL: *DataLayout = DAG.getDataLayout();
    let mut C: *mut LLVMContext = *DAG.getContext();
    let mut MemOps: []EVT = []EVT {};
    let mut DstAlignCanChange: bool = false;
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    let mut OptSize: bool = shouldLowerMemFuncForSize(MF, DAG);
    let mut FI: *mut FrameIndexSDNode = dyn_cast(Dst);
    if FI && !MFI.isFixedObjectIndex(FI.getIndex()) {
        DstAlignCanChange = true;
    }
    SrcAlign = if SrcAlign > DAG.InferPtrAlign(Src).valueOrOne() { SrcAlign } else { DAG.InferPtrAlign(Src).valueOrOne() };
    let mut Slice: ConstantDataArraySlice = ConstantDataArraySlice {};
    let mut CopyFromConstant: bool = !isVol && isMemSrcFromConstant(Src, Slice);
    let mut isZeroConstant: bool = CopyFromConstant && Slice.Array == null;
    let mut Limit: u32 = if AlwaysInline { ~0 } else { TLI.getMaxStoresPerMemcpy(OptSize) };
    let mut Op: MemOp = if isZeroConstant { Set(Size, DstAlignCanChange, DstAlign, true, isVol) } else { Copy(Size, DstAlignCanChange, DstAlign, SrcAlign, isVol, CopyFromConstant) };
    if !TLI.findOptimalMemOpLowering(C, MemOps, Limit, Op, DstPtrInfo.getAddrSpace(), SrcPtrInfo.getAddrSpace(), MF.getFunction().getAttributes(), null) {
        return SDValue {};
    }
    if DstAlignCanChange {
        let mut Ty: *mut Type = MemOps[0].getTypeForEVT(C);
        let mut NewDstAlign: Align = DL.getABITypeAlign(Ty);
        let mut TRI: *TargetRegisterInfo = MF.getSubtarget().getRegisterInfo();
        if !TRI.hasStackRealignment(MF) {
            if DL.getStackAlignment() {
                StackAlign;
            } else {
                NewDstAlign = if NewDstAlign < operator(StackAlign) { NewDstAlign } else { operator(StackAlign) };
            }
        }
        if NewDstAlign > DstAlign {
            if MFI.getObjectAlign(FI.getIndex()) < NewDstAlign {
                MFI.setObjectAlignment(FI.getIndex(), NewDstAlign);
            }
            DstAlign = NewDstAlign;
        }
    }
    let mut NewAAInfo: AAMDNodes = AAInfo;
    NewAAInfo.TBAA = NewAAInfo.TBAAStruct = null;
    let mut SrcVal: *Value = dyn_cast_if_present(SrcPtrInfo.V);
    let mut isConstant: bool = BatchAA && SrcVal && BatchAA.pointsToConstantMemory(MemoryLocation { Ptr: SrcVal, Size: Size, AATags: AAInfo }, false);
    let mut MMOFlags: Flags = if isVol { MOVolatile } else { MONone };
    let mut OutLoadChains: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut OutStoreChains: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut OutChains: SmallVector<SDValue, 32> = SmallVector<SDValue, 32> {};
    let mut NumMemOps: u32 = MemOps.len;
    let mut SrcOff: u64 = 0;
    let mut DstOff: u64 = 0;
    for let mut i: u32 = 0; i != NumMemOps; i += 1 {
        let mut VT: EVT = MemOps[i];
        let mut VTSize: u32 = VT.getSizeInBits().operator unsigned long long() / 8;
        let mut Value: SDValue = SDValue {};
        let mut Store: SDValue = SDValue {};
        if VTSize > Size {
            assert!(i == NumMemOps - 1 && i != 0);
            SrcOff -= VTSize - Size;
            DstOff -= VTSize - Size;
        }
        if CopyFromConstant && (isZeroConstant || (VT.isInteger() && !VT.isVector())) {
            let mut SubSlice: ConstantDataArraySlice = ConstantDataArraySlice {};
            if SrcOff < Slice.Length {
                SubSlice = Slice;
                SubSlice.move(SrcOff);
            } else {
                SubSlice.Array = null;
                SubSlice.Offset = 0;
                SubSlice.Length = VTSize;
            }
            Value = getMemsetStringVal(VT, dl, DAG, TLI, SubSlice);
            if Value.getNode() {
                Store = DAG.getStore(Chain, dl, Value, DAG.getObjectPtrOffset(dl, Dst, getFixed(DstOff)), DstPtrInfo.getWithOffset(DstOff), DstAlign, MMOFlags, MMOMetadata { AAInfo: NewAAInfo, Ranges: null, MemCacheHint: DstMemCacheHint });
                OutChains.push(ValueParamT { Store });
            }
        }
        if !Store.getNode() {
            let mut NVT: EVT = TLI.getTypeToTransformTo(C, VT);
            assert!(NVT.bitsGE(VT));
            let mut isDereferenceable: bool = SrcPtrInfo.getWithOffset(SrcOff).isDereferenceable(VTSize, C, DL);
            let mut SrcMMOFlags: Flags = MMOFlags;
            if isDereferenceable {
                operator(SrcMMOFlags, MODereferenceable);
            }
            if isConstant {
                operator(SrcMMOFlags, MOInvariant);
            }
            Value = DAG.getExtLoad(EXTLOAD, dl, NVT, Chain, DAG.getObjectPtrOffset(dl, Src, getFixed(SrcOff)), SrcPtrInfo.getWithOffset(SrcOff), VT, MaybeAlign { commonAlignment(SrcAlign, SrcOff) }, SrcMMOFlags, MMOMetadata { AAInfo: NewAAInfo, Ranges: null, MemCacheHint: SrcMemCacheHint });
            OutLoadChains.push(Value.getValue(1));
            Store = DAG.getTruncStore(Chain, dl, Value, DAG.getObjectPtrOffset(dl, Dst, getFixed(DstOff)), DstPtrInfo.getWithOffset(DstOff), VT, DstAlign, MMOFlags, MMOMetadata { AAInfo: NewAAInfo, Ranges: null, MemCacheHint: DstMemCacheHint });
            OutStoreChains.push(ValueParamT { Store });
        }
        SrcOff += VTSize;
        DstOff += VTSize;
        Size -= VTSize;
    }
    let mut GluedLdStLimit: u32 = if MaxLdStGlue.operator int() == 0 { TLI.getMaxGluedStoresPerMemcpy() } else { MaxLdStGlue.operator int() };
    let mut NumLdStInMemcpy: u32 = OutStoreChains.len;
    if NumLdStInMemcpy {
        if (GluedLdStLimit <= 1) || !EnableMemCpyDAGOpt {
            for let mut i: u32 = 0; i < NumLdStInMemcpy; i += 1 {
                OutChains.push(ValueParamT { OutLoadChains[i] });
                OutChains.push(ValueParamT { OutStoreChains[i] });
            }
        } else {
            if NumLdStInMemcpy <= GluedLdStLimit {
                chainLoadsAndStoresForMemcpy(DAG, dl, OutChains, 0, NumLdStInMemcpy, OutLoadChains, OutStoreChains);
            } else {
                let mut NumberLdChain: u32 = NumLdStInMemcpy / GluedLdStLimit;
                let mut RemainingLdStInMemcpy: u32 = NumLdStInMemcpy % GluedLdStLimit;
                let mut GlueIter: u32 = 0;
                if RemainingLdStInMemcpy {
                    chainLoadsAndStoresForMemcpy(DAG, dl, OutChains, NumLdStInMemcpy - RemainingLdStInMemcpy, NumLdStInMemcpy, OutLoadChains, OutStoreChains);
                }
                for let mut cnt: u32 = 0; cnt < NumberLdChain; cnt += 1 {
                    let mut IndexFrom: u32 = NumLdStInMemcpy - RemainingLdStInMemcpy - GlueIter - GluedLdStLimit;
                    let mut IndexTo: u32 = NumLdStInMemcpy - RemainingLdStInMemcpy - GlueIter;
                    chainLoadsAndStoresForMemcpy(DAG, dl, OutChains, IndexFrom, IndexTo, OutLoadChains, OutStoreChains);
                    GlueIter += GluedLdStLimit;
                }
            }
        }
    }
    return DAG.getTokenFactor(dl, OutChains);
}

fn getMemmoveLoadsAndStores(DAG: *mut SelectionDAG, dl: *SDLoc, Chain: SDValue, Dst: SDValue, Src: SDValue, Size: u64, DstAlign: Align, SrcAlign: Align, isVol: bool, AlwaysInline: bool, DstPtrInfo: MachinePointerInfo, SrcPtrInfo: MachinePointerInfo, AAInfo: *AAMDNodes) -> SDValue {
    if Src.isUndef() {
        return Chain;
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut DL: *DataLayout = DAG.getDataLayout();
    let mut C: *mut LLVMContext = *DAG.getContext();
    let mut MemOps: []EVT = []EVT {};
    let mut DstAlignCanChange: bool = false;
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    let mut OptSize: bool = shouldLowerMemFuncForSize(MF, DAG);
    let mut FI: *mut FrameIndexSDNode = dyn_cast(Dst);
    if FI && !MFI.isFixedObjectIndex(FI.getIndex()) {
        DstAlignCanChange = true;
    }
    SrcAlign = if SrcAlign > DAG.InferPtrAlign(Src).valueOrOne() { SrcAlign } else { DAG.InferPtrAlign(Src).valueOrOne() };
    let mut Limit: u32 = if AlwaysInline { ~0 } else { TLI.getMaxStoresPerMemmove(OptSize) };
    if !TLI.findOptimalMemOpLowering(C, MemOps, Limit, Move(Size, DstAlignCanChange, DstAlign, SrcAlign, isVol), DstPtrInfo.getAddrSpace(), SrcPtrInfo.getAddrSpace(), MF.getFunction().getAttributes(), null) {
        return SDValue {};
    }
    if DstAlignCanChange {
        let mut Ty: *mut Type = MemOps[0].getTypeForEVT(C);
        let mut NewDstAlign: Align = DL.getABITypeAlign(Ty);
        let mut TRI: *TargetRegisterInfo = MF.getSubtarget().getRegisterInfo();
        if !TRI.hasStackRealignment(MF) {
            if DL.getStackAlignment() {
                StackAlign;
            } else {
                NewDstAlign = if NewDstAlign < operator(StackAlign) { NewDstAlign } else { operator(StackAlign) };
            }
        }
        if NewDstAlign > DstAlign {
            if MFI.getObjectAlign(FI.getIndex()) < NewDstAlign {
                MFI.setObjectAlignment(FI.getIndex(), NewDstAlign);
            }
            DstAlign = NewDstAlign;
        }
    }
    let mut NewAAInfo: AAMDNodes = AAInfo;
    NewAAInfo.TBAA = NewAAInfo.TBAAStruct = null;
    let mut MMOFlags: Flags = if isVol { MOVolatile } else { MONone };
    let mut SrcOff: u64 = 0;
    let mut LoadValues: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut LoadChains: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut OutChains: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut NumMemOps: u32 = MemOps.len;
    for let mut i: u32 = 0; i < NumMemOps; i += 1 {
        let mut VT: EVT = MemOps[i];
        let mut VTSize: u32 = VT.getSizeInBits().operator unsigned long long() / 8;
        let mut Value: SDValue = SDValue {};
        let mut IsOverlapping: bool = false;
        if i == NumMemOps - 1 && i != 0 && VTSize > Size - SrcOff {
            SrcOff = Size - VTSize;
            IsOverlapping = true;
        }
        let mut SrcAlignAtOffset: Align = commonAlignment(SrcAlign, SrcOff);
        if IsOverlapping {
            let mut Fast: u32 = 0;
            if !TLI.allowsMisalignedMemoryAccesses(VT, SrcPtrInfo.getAddrSpace(), SrcAlignAtOffset, MMOFlags, &mut Fast) || !Fast {
                return SDValue {};
            }
        }
        let mut isDereferenceable: bool = SrcPtrInfo.getWithOffset(SrcOff).isDereferenceable(VTSize, C, DL);
        let mut SrcMMOFlags: Flags = MMOFlags;
        if isDereferenceable {
            operator(SrcMMOFlags, MODereferenceable);
        }
        Value = DAG.getLoad(VT, dl, Chain, DAG.getObjectPtrOffset(dl, Src, getFixed(SrcOff)), SrcPtrInfo.getWithOffset(SrcOff), MaybeAlign { SrcAlignAtOffset }, SrcMMOFlags, MMOMetadata { AAInfo: NewAAInfo, Ranges: null, MemCacheHint: null });
        LoadValues.push(ValueParamT { Value });
        LoadChains.push(Value.getValue(1));
        SrcOff += VTSize;
    }
    Chain = DAG.getTokenFactor(dl, LoadChains);
    OutChains.clear();
    let mut DstOff: u64 = 0;
    for let mut i: u32 = 0; i < NumMemOps; i += 1 {
        let mut VT: EVT = MemOps[i];
        let mut VTSize: u32 = VT.getSizeInBits().operator unsigned long long() / 8;
        let mut Store: SDValue = SDValue {};
        let mut IsOverlapping: bool = false;
        if i == NumMemOps - 1 && i != 0 && VTSize > Size - DstOff {
            DstOff = Size - VTSize;
            IsOverlapping = true;
        }
        let mut DstAlignAtOffset: Align = commonAlignment(DstAlign, DstOff);
        if IsOverlapping {
            let mut Fast: u32 = 0;
            if !TLI.allowsMisalignedMemoryAccesses(VT, DstPtrInfo.getAddrSpace(), DstAlignAtOffset, MMOFlags, &mut Fast) || !Fast {
                return SDValue {};
            }
        }
        Store = DAG.getStore(Chain, dl, LoadValues[i], DAG.getObjectPtrOffset(dl, Dst, getFixed(DstOff)), DstPtrInfo.getWithOffset(DstOff), DstAlignAtOffset, MMOFlags, MMOMetadata { AAInfo: NewAAInfo, Ranges: null, MemCacheHint: null });
        OutChains.push(ValueParamT { Store });
        DstOff += VTSize;
    }
    return DAG.getTokenFactor(dl, OutChains);
}

fn getMemsetStores(DAG: *mut SelectionDAG, dl: *SDLoc, Chain: SDValue, Dst: SDValue, Src: SDValue, Size: u64, Alignment: Align, isVol: bool, AlwaysInline: bool, DstPtrInfo: MachinePointerInfo, AAInfo: *AAMDNodes) -> SDValue {
    if Src.isUndef() {
        return Chain;
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut MemOps: []EVT = []EVT {};
    let mut DstAlignCanChange: bool = false;
    let mut C: *mut LLVMContext = *DAG.getContext();
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    let mut OptSize: bool = shouldLowerMemFuncForSize(MF, DAG);
    let mut FI: *mut FrameIndexSDNode = dyn_cast(Dst);
    if FI && !MFI.isFixedObjectIndex(FI.getIndex()) {
        DstAlignCanChange = true;
    }
    let mut IsZeroVal: bool = isNullConstant(Src);
    let mut Limit: u32 = if AlwaysInline { ~0 } else { TLI.getMaxStoresPerMemset(OptSize) };
    let mut LargestVT: EVT = EVT {};
    if !TLI.findOptimalMemOpLowering(C, MemOps, Limit, Set(Size, DstAlignCanChange, Alignment, IsZeroVal, isVol), DstPtrInfo.getAddrSpace(), ~0, MF.getFunction().getAttributes(), &mut LargestVT) {
        return SDValue {};
    }
    if DstAlignCanChange {
        let mut Ty: *mut Type = MemOps[0].getTypeForEVT(*DAG.getContext());
        let mut DL: *DataLayout = DAG.getDataLayout();
        let mut NewAlign: Align = DL.getABITypeAlign(Ty);
        let mut TRI: *TargetRegisterInfo = MF.getSubtarget().getRegisterInfo();
        if !TRI.hasStackRealignment(MF) {
            if DL.getStackAlignment() {
                StackAlign;
            } else {
                NewAlign = if NewAlign < operator(StackAlign) { NewAlign } else { operator(StackAlign) };
            }
        }
        if NewAlign > Alignment {
            if MFI.getObjectAlign(FI.getIndex()) < NewAlign {
                MFI.setObjectAlignment(FI.getIndex(), NewAlign);
            }
            Alignment = NewAlign;
        }
    }
    let mut OutChains: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut DstOff: u64 = 0;
    let mut NumMemOps: u32 = MemOps.len;
    if !LargestVT.isSimple() {
        LargestVT = MemOps[0];
        for let mut i: u32 = 1; i < NumMemOps; i += 1 {
            if MemOps[i].bitsGT(LargestVT) {
                LargestVT = MemOps[i];
            }
        }
    }
    let mut MemSetValue: SDValue = getMemsetValue(Src, LargestVT, DAG, dl);
    let mut NewAAInfo: AAMDNodes = AAInfo;
    NewAAInfo.TBAA = NewAAInfo.TBAAStruct = null;
    for let mut i: u32 = 0; i < NumMemOps; i += 1 {
        let mut VT: EVT = MemOps[i];
        let mut VTSize: u32 = VT.getSizeInBits().operator unsigned long long() / 8;
        assert!(Size > 0, "Target specified more stores than needed in findOptimalMemOpLowering");
        if VTSize > Size {
            assert!(i == NumMemOps - 1 && i != 0);
            DstOff -= VTSize - Size;
        }
        let mut Value: SDValue = MemSetValue;
        if VT.bitsLT(LargestVT) {
            let mut Index: u32 = 0;
            let mut NElts: u32 = LargestVT.getSizeInBits().operator unsigned long long() / VT.getSizeInBits().operator unsigned long long();
            let mut SVT: EVT = getVectorVT(*DAG.getContext(), VT.getScalarType(), NElts, false);
            if !LargestVT.isVector() && !VT.isVector() && TLI.isTruncateFree(LargestVT, VT) {
                Value = DAG.getNode(TRUNCATE, dl, VT, MemSetValue);
            } else if LargestVT.isVector() && !VT.isVector() && TLI.shallExtractConstSplatVectorElementToStore(LargestVT.getTypeForEVT(*DAG.getContext()), VT.getSizeInBits().operator unsigned long long(), Index) && TLI.isTypeLegal(SVT) && LargestVT.getSizeInBits() == SVT.getSizeInBits() {
                let mut TailValue: SDValue = DAG.getNode(BITCAST, dl, SVT, MemSetValue);
                Value = DAG.getExtractVectorElt(dl, VT, TailValue, Index);
            } else {
                Value = getMemsetValue(Src, VT, DAG, dl);
            }
        }
        assert!(Value.getValueType() == VT, "Value with wrong type.");
        let mut Store: SDValue = DAG.getStore(Chain, dl, Value, DAG.getObjectPtrOffset(dl, Dst, getFixed(DstOff)), DstPtrInfo.getWithOffset(DstOff), Alignment, if isVol { MOVolatile } else { MONone }, MMOMetadata { AAInfo: NewAAInfo, Ranges: null, MemCacheHint: null });
        OutChains.push(ValueParamT { Store });
        DstOff += VT.getSizeInBits().operator unsigned long long() / 8;
        if VTSize > Size {
            Size = 0;
        } else {
            Size -= VTSize;
        }
    }
    assert!(Size == 0, "Target's findOptimalMemOpLowering did not specify stores that exactly cover the memset size");
    return DAG.getTokenFactor(dl, OutChains);
}

fn checkAddrSpaceIsValidForLibcall(TLI: *TargetLowering, DL: *DataLayout, AS: u32) {
    if AS != 0 && !TLI.getTargetMachine().isNoopAddrSpaceCast(DL, AS, 0) {
        report_fatal_error("cannot lower memory intrinsic in address space " + AS, true);
    }
}

fn getMemIntrinsicSize(DAG: *mut SelectionDAG, dl: *SDLoc, Size: SDValue, DstAS: u32, SrcAS: u32) -> SDValue {
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut DstVT: MVT = TLI.getPointerTy(DAG.getDataLayout(), DstAS);
    let mut SrcVT: MVT = TLI.getPointerTy(DAG.getDataLayout(), SrcAS);
    return DAG.getZExtOrTrunc(Size, dl, EVT { if DstVT.bitsLT(SrcVT) { DstVT } else { SrcVT } });
}

fn isInTailCallPositionWrapper(CI: *CallInst, SelDAG: *SelectionDAG, AllowReturnsFirstArg: bool) -> bool {
    if !CI || !CI.isTailCall() {
        return false;
    }
    return isInTailCallPosition(*CI, SelDAG.getTarget(), AllowReturnsFirstArg && funcReturnsFirstArgOfCall(*CI));
}

fn getRuntimeCallSDValueHelper(Chain: SDValue, dl: *SDLoc, Args: *mut *mut ArgListTy, CI: *CallInst, Call: Libcall, DAG: *mut SelectionDAG, TLI: *TargetLowering) -> pair<SDValue, SDValue> {
    let mut LCImpl: LibcallImpl = DAG.getLibcalls().getLibcallImpl(Call);
    if LCImpl == Unsupported {
        return pair<SDValue, SDValue> {};
    }
    let mut CLI: CallLoweringInfo = CallLoweringInfo { *DAG };
    let mut IsTailCall: bool = isInTailCallPositionWrapper(CI, DAG, true) && !DAG.hasSwiftErrorArg();
    let mut Callee: SDValue = DAG.getExternalSymbol(LCImpl, EVT { TLI.getPointerTy(DAG.getDataLayout(), 0) });
    CLI.setDebugLoc(dl).setChain(Chain).setLibCallee(DAG.getLibcalls().getLibcallImplCallingConv(LCImpl), CI.getType(), Callee, move(Args)).setTailCall(IsTailCall);
    return TLI.LowerCallTo(CLI);
}

fn SelectionDAG::getStrcmp(self, Chain: SDValue, dl: *SDLoc, S1: SDValue, S2: SDValue, CI: *CallInst) -> pair<SDValue, SDValue> {
    let mut PT: *mut PointerType = getUnqual(*self.getContext());
    let mut Args: ArgListTy = ArgListTy { [ArgListEntry { S1, PT }, ArgListEntry { S2, PT }], ArgListEntry> {} };
    return getRuntimeCallSDValueHelper(Chain, dl, move(Args), CI, STRCMP, self, self.TLI);
}

fn SelectionDAG::getStrstr(self, Chain: SDValue, dl: *SDLoc, S1: SDValue, S2: SDValue, CI: *CallInst) -> pair<SDValue, SDValue> {
    let mut PT: *mut PointerType = getUnqual(*self.getContext());
    let mut Args: ArgListTy = ArgListTy { [ArgListEntry { S1, PT }, ArgListEntry { S2, PT }], ArgListEntry> {} };
    return getRuntimeCallSDValueHelper(Chain, dl, move(Args), CI, STRSTR, self, self.TLI);
}

fn SelectionDAG::getMemccpy(self, Chain: SDValue, dl: *SDLoc, Dst: SDValue, Src: SDValue, C: SDValue, Size: SDValue, CI: *CallInst) -> pair<SDValue, SDValue> {
    let mut PT: *mut PointerType = getUnqual(*self.getContext());
    let mut Args: ArgListTy = ArgListTy { [ArgListEntry { Dst, PT }, ArgListEntry { Src, PT }, ArgListEntry { C, getInt32Ty(*self.getContext()) }, ArgListEntry { Size, self.getDataLayout().getIntPtrType(*self.getContext(), 0) }], ArgListEntry> {} };
    return getRuntimeCallSDValueHelper(Chain, dl, move(Args), CI, MEMCCPY, self, self.TLI);
}

fn SelectionDAG::getMemcmp(self, Chain: SDValue, dl: *SDLoc, Mem0: SDValue, Mem1: SDValue, Size: SDValue, CI: *CallInst) -> pair<SDValue, SDValue> {
    let mut PT: *mut PointerType = getUnqual(*self.getContext());
    let mut Args: ArgListTy = ArgListTy { [ArgListEntry { Mem0, PT }, ArgListEntry { Mem1, PT }, ArgListEntry { Size, self.getDataLayout().getIntPtrType(*self.getContext(), 0) }], ArgListEntry> {} };
    return getRuntimeCallSDValueHelper(Chain, dl, move(Args), CI, MEMCMP, self, self.TLI);
}

fn SelectionDAG::getStrcpy(self, Chain: SDValue, dl: *SDLoc, Dst: SDValue, Src: SDValue, CI: *CallInst) -> pair<SDValue, SDValue> {
    let mut PT: *mut PointerType = getUnqual(*self.getContext());
    let mut Args: ArgListTy = ArgListTy { [ArgListEntry { Dst, PT }, ArgListEntry { Src, PT }], ArgListEntry> {} };
    return getRuntimeCallSDValueHelper(Chain, dl, move(Args), CI, STRCPY, self, self.TLI);
}

fn SelectionDAG::getStrlen(self, Chain: SDValue, dl: *SDLoc, Src: SDValue, CI: *CallInst) -> pair<SDValue, SDValue> {
    let mut Args: ArgListTy = ArgListTy { [ArgListEntry { Src, getUnqual(*self.getContext()) }], ArgListEntry> {} };
    return getRuntimeCallSDValueHelper(Chain, dl, move(Args), CI, STRLEN, self, self.TLI);
}

fn SelectionDAG::hasSwiftErrorArg(self: *SelectionDAG) -> bool {
    return self.TLI.supportSwiftError() && self.MF.getFunction().getAttributes().hasAttrSomewhere(SwiftError, null);
}

fn SelectionDAG::getMemcpy(self, Chain: SDValue, dl: *SDLoc, Dst: SDValue, Src: SDValue, Size: SDValue, DstAlign: Align, SrcAlign: Align, isVol: bool, AlwaysInline: bool, CI: *CallInst, OverrideTailCall: optional<bool>, DstPtrInfo: MachinePointerInfo, SrcPtrInfo: MachinePointerInfo, AAInfo: *AAMDNodes, BatchAA: *mut BatchAAResults) -> SDValue {
    Size = getMemIntrinsicSize(*self, dl, Size, DstPtrInfo.getAddrSpace(), SrcPtrInfo.getAddrSpace());
    let mut DstMemCacheHint: *MDNode = if CI { getMemCacheHintMetadata(*CI, 0) } else { null };
    let mut SrcMemCacheHint: *MDNode = if CI { getMemCacheHintMetadata(*CI, 1) } else { null };
    let mut ConstantSize: *mut ConstantSDNode = dyn_cast(Size);
    if ConstantSize {
        if ConstantSize.isZero() {
            return Chain;
        }
        let mut Result: SDValue = getMemcpyLoadsAndStores(*self, dl, Chain, Dst, Src, ConstantSize.getZExtValue(), DstAlign, SrcAlign, isVol, false, DstPtrInfo, SrcPtrInfo, AAInfo, BatchAA, DstMemCacheHint, SrcMemCacheHint);
        if Result.getNode() {
            return Result;
        }
    }
    if self.TSI {
        let mut Result: SDValue = self.TSI.EmitTargetCodeForMemcpy(*self, dl, Chain, Dst, Src, Size, DstAlign, SrcAlign, isVol, AlwaysInline, DstPtrInfo, SrcPtrInfo);
        if Result.getNode() {
            return Result;
        }
    }
    if AlwaysInline {
        assert!(ConstantSize, "AlwaysInline requires a constant size!");
        return getMemcpyLoadsAndStores(*self, dl, Chain, Dst, Src, ConstantSize.getZExtValue(), DstAlign, SrcAlign, isVol, true, DstPtrInfo, SrcPtrInfo, AAInfo, BatchAA, DstMemCacheHint, SrcMemCacheHint);
    }
    checkAddrSpaceIsValidForLibcall(self.TLI, self.getDataLayout(), DstPtrInfo.getAddrSpace());
    checkAddrSpaceIsValidForLibcall(self.TLI, self.getDataLayout(), SrcPtrInfo.getAddrSpace());
    let mut Args: ArgListTy = ArgListTy {};
    let mut PtrTy: *mut Type = getUnqual(*self.getContext());
    Args.emplace_back(Dst, PtrTy);
    Args.emplace_back(Src, PtrTy);
    Args.emplace_back(Size, self.getDataLayout().getIntPtrType(*self.getContext(), 0));
    let mut CLI: CallLoweringInfo = CallLoweringInfo { *self };
    let mut IsTailCall: bool = false;
    let mut MemCpyImpl: LibcallImpl = self.TLI.getMemcpyImpl();
    if OverrideTailCall.has_value() {
        IsTailCall = operator(OverrideTailCall);
    } else {
        let mut LowersToMemcpy: bool = MemCpyImpl == impl_memcpy;
        IsTailCall = isInTailCallPositionWrapper(CI, self, LowersToMemcpy);
    }
    IsTailCall &= !self.hasSwiftErrorArg();
    CLI.setDebugLoc(dl).setChain(Chain).setLibCallee(self.Libcalls.getLibcallImplCallingConv(MemCpyImpl), Dst.getValueType().getTypeForEVT(*self.getContext()), self.getExternalSymbol(MemCpyImpl, EVT { self.TLI.getPointerTy(self.getDataLayout(), 0) }), move(Args)).setDiscardResult(true).setTailCall(IsTailCall);
    let mut CallResult: pair<SDValue, SDValue> = self.TLI.LowerCallTo(CLI);
    return CallResult.second;
}

fn SelectionDAG::getAtomicMemcpy(self, Chain: SDValue, dl: *SDLoc, Dst: SDValue, Src: SDValue, Size: SDValue, SizeTy: *mut Type, ElemSz: u32, isTailCall: bool, DstPtrInfo: MachinePointerInfo, SrcPtrInfo: MachinePointerInfo) -> SDValue {
    isTailCall &= !self.hasSwiftErrorArg();
    let mut Args: ArgListTy = ArgListTy {};
    let mut ArgTy: *mut Type = self.getDataLayout().getIntPtrType(*self.getContext(), 0);
    Args.emplace_back(Dst, ArgTy);
    Args.emplace_back(Src, ArgTy);
    Args.emplace_back(Size, SizeTy);
    let mut LibraryCall: Libcall = getMEMCPY_ELEMENT_UNORDERED_ATOMIC(ElemSz);
    let mut LibcallImpl: LibcallImpl = self.Libcalls.getLibcallImpl(LibraryCall);
    if LibcallImpl == Unsupported {
        report_fatal_error("Unsupported element size", true);
    }
    let mut CLI: CallLoweringInfo = CallLoweringInfo { *self };
    CLI.setDebugLoc(dl).setChain(Chain).setLibCallee(self.Libcalls.getLibcallImplCallingConv(LibcallImpl), getVoidTy(*self.getContext()), self.getExternalSymbol(LibcallImpl, EVT { self.TLI.getPointerTy(self.getDataLayout(), 0) }), move(Args)).setDiscardResult(true).setTailCall(isTailCall);
    let mut CallResult: pair<SDValue, SDValue> = self.TLI.LowerCallTo(CLI);
    return CallResult.second;
}

fn SelectionDAG::getMemmove(self, Chain: SDValue, dl: *SDLoc, Dst: SDValue, Src: SDValue, Size: SDValue, DstAlign: Align, SrcAlign: Align, isVol: bool, CI: *CallInst, OverrideTailCall: optional<bool>, DstPtrInfo: MachinePointerInfo, SrcPtrInfo: MachinePointerInfo, AAInfo: *AAMDNodes, BatchAA: *mut BatchAAResults) -> SDValue {
    Size = getMemIntrinsicSize(*self, dl, Size, DstPtrInfo.getAddrSpace(), SrcPtrInfo.getAddrSpace());
    let mut ConstantSize: *mut ConstantSDNode = dyn_cast(Size);
    if ConstantSize {
        if ConstantSize.isZero() {
            return Chain;
        }
        let mut Result: SDValue = getMemmoveLoadsAndStores(*self, dl, Chain, Dst, Src, ConstantSize.getZExtValue(), DstAlign, SrcAlign, isVol, false, DstPtrInfo, SrcPtrInfo, AAInfo);
        if Result.getNode() {
            return Result;
        }
    }
    if self.TSI {
        let mut Result: SDValue = self.TSI.EmitTargetCodeForMemmove(*self, dl, Chain, Dst, Src, Size, DstAlign, SrcAlign, isVol, DstPtrInfo, SrcPtrInfo);
        if Result.getNode() {
            return Result;
        }
    }
    checkAddrSpaceIsValidForLibcall(self.TLI, self.getDataLayout(), DstPtrInfo.getAddrSpace());
    checkAddrSpaceIsValidForLibcall(self.TLI, self.getDataLayout(), SrcPtrInfo.getAddrSpace());
    let mut Args: ArgListTy = ArgListTy {};
    let mut PtrTy: *mut Type = getUnqual(*self.getContext());
    Args.emplace_back(Dst, PtrTy);
    Args.emplace_back(Src, PtrTy);
    Args.emplace_back(Size, self.getDataLayout().getIntPtrType(*self.getContext(), 0));
    let mut CLI: CallLoweringInfo = CallLoweringInfo { *self };
    let mut MemmoveImpl: LibcallImpl = self.Libcalls.getLibcallImpl(MEMMOVE);
    let mut IsTailCall: bool = false;
    if OverrideTailCall.has_value() {
        IsTailCall = operator(OverrideTailCall);
    } else {
        let mut LowersToMemmove: bool = MemmoveImpl == impl_memmove;
        IsTailCall = isInTailCallPositionWrapper(CI, self, LowersToMemmove);
    }
    IsTailCall &= !self.hasSwiftErrorArg();
    CLI.setDebugLoc(dl).setChain(Chain).setLibCallee(self.Libcalls.getLibcallImplCallingConv(MemmoveImpl), Dst.getValueType().getTypeForEVT(*self.getContext()), self.getExternalSymbol(MemmoveImpl, EVT { self.TLI.getPointerTy(self.getDataLayout(), 0) }), move(Args)).setDiscardResult(true).setTailCall(IsTailCall);
    let mut CallResult: pair<SDValue, SDValue> = self.TLI.LowerCallTo(CLI);
    return CallResult.second;
}

fn SelectionDAG::getAtomicMemmove(self, Chain: SDValue, dl: *SDLoc, Dst: SDValue, Src: SDValue, Size: SDValue, SizeTy: *mut Type, ElemSz: u32, isTailCall: bool, DstPtrInfo: MachinePointerInfo, SrcPtrInfo: MachinePointerInfo) -> SDValue {
    isTailCall &= !self.hasSwiftErrorArg();
    let mut Args: ArgListTy = ArgListTy {};
    let mut IntPtrTy: *mut Type = self.getDataLayout().getIntPtrType(*self.getContext(), 0);
    Args.emplace_back(Dst, IntPtrTy);
    Args.emplace_back(Src, IntPtrTy);
    Args.emplace_back(Size, SizeTy);
    let mut LibraryCall: Libcall = getMEMMOVE_ELEMENT_UNORDERED_ATOMIC(ElemSz);
    let mut LibcallImpl: LibcallImpl = self.Libcalls.getLibcallImpl(LibraryCall);
    if LibcallImpl == Unsupported {
        report_fatal_error("Unsupported element size", true);
    }
    let mut CLI: CallLoweringInfo = CallLoweringInfo { *self };
    CLI.setDebugLoc(dl).setChain(Chain).setLibCallee(self.Libcalls.getLibcallImplCallingConv(LibcallImpl), getVoidTy(*self.getContext()), self.getExternalSymbol(LibcallImpl, EVT { self.TLI.getPointerTy(self.getDataLayout(), 0) }), move(Args)).setDiscardResult(true).setTailCall(isTailCall);
    let mut CallResult: pair<SDValue, SDValue> = self.TLI.LowerCallTo(CLI);
    return CallResult.second;
}

fn SelectionDAG::getMemset(self, Chain: SDValue, dl: *SDLoc, Dst: SDValue, Src: SDValue, Size: SDValue, Alignment: Align, isVol: bool, AlwaysInline: bool, CI: *CallInst, DstPtrInfo: MachinePointerInfo, AAInfo: *AAMDNodes) -> SDValue {
    Size = getMemIntrinsicSize(*self, dl, Size, DstPtrInfo.getAddrSpace(), DstPtrInfo.getAddrSpace());
    let mut ConstantSize: *mut ConstantSDNode = dyn_cast(Size);
    if ConstantSize {
        if ConstantSize.isZero() {
            return Chain;
        }
        let mut Result: SDValue = getMemsetStores(*self, dl, Chain, Dst, Src, ConstantSize.getZExtValue(), Alignment, isVol, false, DstPtrInfo, AAInfo);
        if Result.getNode() {
            return Result;
        }
    }
    if self.TSI {
        let mut Result: SDValue = self.TSI.EmitTargetCodeForMemset(*self, dl, Chain, Dst, Src, Size, Alignment, isVol, AlwaysInline, DstPtrInfo);
        if Result.getNode() {
            return Result;
        }
    }
    if AlwaysInline {
        assert!(ConstantSize, "AlwaysInline requires a constant size!");
        let mut Result: SDValue = getMemsetStores(*self, dl, Chain, Dst, Src, ConstantSize.getZExtValue(), Alignment, isVol, true, DstPtrInfo, AAInfo);
        assert!(Result, "getMemsetStores must return a valid sequence when AlwaysInline");
        return Result;
    }
    checkAddrSpaceIsValidForLibcall(self.TLI, self.getDataLayout(), DstPtrInfo.getAddrSpace());
    let mut Ctx: *mut LLVMContext = *self.getContext();
    let mut DL: *DataLayout = self.getDataLayout();
    let mut CLI: CallLoweringInfo = CallLoweringInfo { *self };
    CLI.setDebugLoc(dl).setChain(Chain);
    let mut BzeroImpl: LibcallImpl = self.Libcalls.getLibcallImpl(BZERO);
    let mut UseBZero: bool = BzeroImpl != Unsupported && isNullConstant(Src);
    if UseBZero {
        let mut Args: ArgListTy = ArgListTy {};
        Args.emplace_back(Dst, getUnqual(Ctx));
        Args.emplace_back(Size, DL.getIntPtrType(Ctx, 0));
        CLI.setLibCallee(self.Libcalls.getLibcallImplCallingConv(BzeroImpl), getVoidTy(Ctx), self.getExternalSymbol(BzeroImpl, EVT { self.TLI.getPointerTy(DL, 0) }), move(Args));
    } else {
        let mut MemsetImpl: LibcallImpl = self.Libcalls.getLibcallImpl(MEMSET);
        let mut Args: ArgListTy = ArgListTy {};
        Args.emplace_back(Dst, getUnqual(Ctx));
        Args.emplace_back(Src, Src.getValueType().getTypeForEVT(Ctx));
        Args.emplace_back(Size, DL.getIntPtrType(Ctx, 0));
        CLI.setLibCallee(self.Libcalls.getLibcallImplCallingConv(MemsetImpl), Dst.getValueType().getTypeForEVT(Ctx), self.getExternalSymbol(MemsetImpl, EVT { self.TLI.getPointerTy(DL, 0) }), move(Args));
    }
    let mut MemsetImpl: LibcallImpl = self.Libcalls.getLibcallImpl(MEMSET);
    let mut LowersToMemset: bool = MemsetImpl == impl_memset;
    let mut ReturnsFirstArg: bool = CI && funcReturnsFirstArgOfCall(*CI) && !UseBZero;
    let mut IsTailCall: bool = CI && CI.isTailCall() && isInTailCallPosition(*CI, self.getTarget(), ReturnsFirstArg && LowersToMemset) && !self.hasSwiftErrorArg();
    CLI.setDiscardResult(true).setTailCall(IsTailCall);
    let mut CallResult: pair<SDValue, SDValue> = self.TLI.LowerCallTo(CLI);
    return CallResult.second;
}

fn SelectionDAG::getAtomicMemset(self, Chain: SDValue, dl: *SDLoc, Dst: SDValue, Value: SDValue, Size: SDValue, SizeTy: *mut Type, ElemSz: u32, isTailCall: bool, DstPtrInfo: MachinePointerInfo) -> SDValue {
    isTailCall &= !self.hasSwiftErrorArg();
    let mut Args: ArgListTy = ArgListTy {};
    Args.emplace_back(Dst, self.getDataLayout().getIntPtrType(*self.getContext(), 0));
    Args.emplace_back(Value, getInt8Ty(*self.getContext()));
    Args.emplace_back(Size, SizeTy);
    let mut LibraryCall: Libcall = getMEMSET_ELEMENT_UNORDERED_ATOMIC(ElemSz);
    let mut LibcallImpl: LibcallImpl = self.Libcalls.getLibcallImpl(LibraryCall);
    if LibcallImpl == Unsupported {
        report_fatal_error("Unsupported element size", true);
    }
    let mut CLI: CallLoweringInfo = CallLoweringInfo { *self };
    CLI.setDebugLoc(dl).setChain(Chain).setLibCallee(self.Libcalls.getLibcallImplCallingConv(LibcallImpl), getVoidTy(*self.getContext()), self.getExternalSymbol(LibcallImpl, EVT { self.TLI.getPointerTy(self.getDataLayout(), 0) }), move(Args)).setDiscardResult(true).setTailCall(isTailCall);
    let mut CallResult: pair<SDValue, SDValue> = self.TLI.LowerCallTo(CLI);
    return CallResult.second;
}

fn SelectionDAG::getAtomic(self, Opcode: u32, dl: *SDLoc, MemVT: EVT, VTList: SDVTList, Ops: ArrayRef<SDValue>, MMO: *mut MachineMemOperand, ExtType: LoadExtType) -> SDValue {
    let mut ID: SDNodeKey = SDNodeKey { Opcode, VTList, ArrayRef<SDValue> { Ops } };
    ID.AddInteger(MemVT.getRawBits());
    ID.AddInteger(getSyntheticNodeSubclassData(dl.getIROrder(), Opcode, VTList, MemVT, MMO, ExtType));
    ID.AddInteger(MMO.getPointerInfo().getAddrSpace());
    ID.AddInteger(MMO.getFlags());
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if cast_or_null(self.lookupNode(ID, dl, InsertToken)) {
        E;
    } else {
        E.refineAlignment(MMO);
        E.refineMMOMetadata(MMO);
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut AtomicSDNode = self.newSDNode(dl.getIROrder(), dl.getDebugLoc(), Opcode, VTList, MemVT, MMO, ExtType);
    self.createOperands(N, ArrayRef<SDValue> { Ops });
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    let mut V: SDValue = SDValue { Node: N, ResNo: 0 };
    NewSDValueDbgMsg(V, "Creating new node: ", self);
    return V;
}

fn SelectionDAG::getAtomicCmpSwap(self, Opcode: u32, dl: *SDLoc, MemVT: EVT, VTs: SDVTList, Chain: SDValue, Ptr: SDValue, Cmp: SDValue, Swp: SDValue, MMO: *mut MachineMemOperand) -> SDValue {
    assert!(Opcode == ATOMIC_CMP_SWAP || Opcode == ATOMIC_CMP_SWAP_WITH_SUCCESS);
    assert!(Cmp.getValueType() == Swp.getValueType(), "Invalid Atomic Op Types");
    let mut Ops: [4]SDValue = [Chain, Ptr, Cmp, Swp];
    return self.getAtomic(Opcode, dl, MemVT, VTs, ArrayRef<SDValue> { Ops }, MMO, NON_EXTLOAD);
}

fn SelectionDAG::getAtomic(self, Opcode: u32, dl: *SDLoc, MemVT: EVT, Chain: SDValue, Ptr: SDValue, Val: SDValue, MMO: *mut MachineMemOperand) -> SDValue {
    assert!((Opcode == ATOMIC_LOAD_ADD || Opcode == ATOMIC_LOAD_SUB || Opcode == ATOMIC_LOAD_AND || Opcode == ATOMIC_LOAD_CLR || Opcode == ATOMIC_LOAD_OR || Opcode == ATOMIC_LOAD_XOR || Opcode == ATOMIC_LOAD_NAND || Opcode == ATOMIC_LOAD_MIN || Opcode == ATOMIC_LOAD_MAX || Opcode == ATOMIC_LOAD_UMIN || Opcode == ATOMIC_LOAD_UMAX || Opcode == ATOMIC_LOAD_FADD || Opcode == ATOMIC_LOAD_FSUB || Opcode == ATOMIC_LOAD_FMAX || Opcode == ATOMIC_LOAD_FMIN || Opcode == ATOMIC_LOAD_FMINIMUM || Opcode == ATOMIC_LOAD_FMAXIMUM || Opcode == ATOMIC_LOAD_UINC_WRAP || Opcode == ATOMIC_LOAD_UDEC_WRAP || Opcode == ATOMIC_LOAD_USUB_COND || Opcode == ATOMIC_LOAD_USUB_SAT || Opcode == ATOMIC_SWAP || Opcode == ATOMIC_STORE), "Invalid Atomic Op");
    let mut VT: EVT = Val.getValueType();
    let mut VTs: SDVTList = if Opcode == ATOMIC_STORE { self.getVTList(EVT { Other }) } else { self.getVTList(VT, EVT { Other }) };
    let mut Ops: [3]SDValue = [Chain, Ptr, Val];
    return self.getAtomic(Opcode, dl, MemVT, VTs, ArrayRef<SDValue> { Ops }, MMO, NON_EXTLOAD);
}

fn SelectionDAG::getAtomicLoad(self, ExtType: LoadExtType, dl: *SDLoc, MemVT: EVT, VT: EVT, Chain: SDValue, Ptr: SDValue, MMO: *mut MachineMemOperand) -> SDValue {
    let mut VTs: SDVTList = self.getVTList(VT, EVT { Other });
    let mut Ops: [2]SDValue = [Chain, Ptr];
    return self.getAtomic(ATOMIC_LOAD, dl, MemVT, VTs, ArrayRef<SDValue> { Ops }, MMO, ExtType);
}

fn SelectionDAG::getMergeValues(self, Ops: ArrayRef<SDValue>, dl: *SDLoc) -> SDValue {
    if Ops.len == 1 {
        return Ops[0];
    }
    let mut VTs: SmallVector<EVT, 4> = SmallVector<EVT, 4> {};
    VTs.reserve(Ops.len);
    for Op in Ops {
        VTs.push(Op.getValueType());
    }
    return self.getNode(MERGE_VALUES, dl, self.getVTList(ArrayRef<EVT> { VTs }), ArrayRef<SDValue> { Ops });
}

fn SelectionDAG::getErrorMergeValues(self, ResultTypes: ArrayRef<EVT>, Chain: SDValue, dl: *SDLoc) -> SDValue {
    let mut RetValues: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    RetValues.reserve(ResultTypes.len);
    for VT in ResultTypes {
        RetValues.push(if VT == EVT { Other } { Chain } else { self.getPOISON(VT) });
    }
    return self.getMergeValues(ArrayRef<SDValue> { RetValues }, dl);
}

fn SelectionDAG::getMemIntrinsicNode(self, Opcode: u32, dl: *SDLoc, VTList: SDVTList, Ops: ArrayRef<SDValue>, MemVT: EVT, PtrInfo: MachinePointerInfo, Alignment: Align, Flags: Flags, Size: LocationSize, AAInfo: *AAMDNodes) -> SDValue {
    if Size.hasValue() && !Size.getValue() {
        Size = precise(MemVT.getStoreSize());
    }
    let mut MF: *mut MachineFunction = self.getMachineFunction();
    let mut MMO: *mut MachineMemOperand = MF.getMachineMemOperand(PtrInfo, Flags, Size, Alignment, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null }, System, NotAtomic, NotAtomic);
    return self.getMemIntrinsicNode(Opcode, dl, VTList, ArrayRef<SDValue> { Ops }, MemVT, MMO);
}

fn SelectionDAG::getMemIntrinsicNode(self, Opcode: u32, dl: *SDLoc, VTList: SDVTList, Ops: ArrayRef<SDValue>, MemVT: EVT, MMO: *mut MachineMemOperand) -> SDValue {
    return self.getMemIntrinsicNode(Opcode, dl, VTList, ArrayRef<SDValue> { Ops }, MemVT, MachineMemOperand *> { MMO });
}

fn SelectionDAG::getMemIntrinsicNode(self, Opcode: u32, dl: *SDLoc, VTList: SDVTList, Ops: ArrayRef<SDValue>, MemVT: EVT, MMOs: ArrayRef<MachineMemOperand *>) -> SDValue {
    assert!(!MMOs.is_empty(), "Must have at least one MMO");
    assert!((Opcode == INTRINSIC_VOID || Opcode == INTRINSIC_W_CHAIN || Opcode == PREFETCH || (Opcode <= max() as u32 && Opcode >= BUILTIN_OP_END && self.TSI.isTargetMemoryOpcode(Opcode))), "Opcode is not a memory-accessing opcode!");
    let mut MemRefs: PointerUnion<MachineMemOperand *, MachineMemOperand **> = PointerUnion<MachineMemOperand *, MachineMemOperand **> {};
    if MMOs.len == 1 {
        MemRefs = MMOs[0];
    } else {
        let mut AllocSize: u64 =  + MMOs.len * ;
        let mut Buffer: *mut void = self.Allocator.Allocate(AllocSize);
        let mut CountPtr: *mut u64 = Buffer as *mut u64;
        *CountPtr = MMOs.len;
        let mut Array: *mut *mut MachineMemOperand = CountPtr + 1 as *mut *mut MachineMemOperand;
        copy(MMOs, Array);
        MemRefs = Array;
    }
    let mut N: *mut MemIntrinsicSDNode = null;
    if VTList.VTs[VTList.NumVTs - 1] != EVT { Glue } {
        let mut ID: SDNodeKey = SDNodeKey { Opcode, VTList, ArrayRef<SDValue> { Ops } };
        ID.AddInteger(getSyntheticNodeSubclassData(Opcode, dl.getIROrder(), VTList, MemVT, PointerUnion<MachineMemOperand *, MachineMemOperand **> { MemRefs }));
        ID.AddInteger(MemVT.getRawBits());
        for MMO in MMOs {
            ID.AddInteger(MMO.getPointerInfo().getAddrSpace());
            ID.AddInteger(MMO.getFlags());
        }
        let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
        if self.lookupNode(ID, dl, InsertToken) {
            E;
        } else {
            cast(E).refineAlignment(ArrayRef<MachineMemOperand *> { MMOs });
            return SDValue { Node: E, ResNo: 0 };
        }
        N = self.newSDNode(Opcode, dl.getIROrder(), dl.getDebugLoc(), VTList, MemVT, MemRefs);
        self.createOperands(N, ArrayRef<SDValue> { Ops });
        self.CSEMap.insert(N, InsertToken);
    } else {
        N = self.newSDNode(Opcode, dl.getIROrder(), dl.getDebugLoc(), VTList, MemVT, MemRefs);
        self.createOperands(N, ArrayRef<SDValue> { Ops });
    }
    self.InsertNode(N);
    let mut V: SDValue = SDValue { Node: N, ResNo: 0 };
    NewSDValueDbgMsg(V, "Creating new node: ", self);
    return V;
}

fn SelectionDAG::getLifetimeNode(self, IsStart: bool, dl: *SDLoc, Chain: SDValue, FrameIndex: i32) -> SDValue {
    let mut Opcode: u32 = if IsStart { LIFETIME_START } else { LIFETIME_END };
    let mut VTs: SDVTList = self.getVTList(EVT { Other });
    let mut Ops: [2]SDValue = [Chain, self.getFrameIndex(FrameIndex, EVT { self.getTargetLoweringInfo().getFrameIndexTy(self.getDataLayout()) }, true)];
    let mut ID: SDNodeKey = SDNodeKey { Opcode, VTs, ArrayRef<SDValue> { Ops } };
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, dl, InsertToken) {
        E;
    } else {
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut LifetimeSDNode = self.newSDNode(Opcode, dl.getIROrder(), dl.getDebugLoc(), VTs);
    self.createOperands(N, ArrayRef<SDValue> { Ops });
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    let mut V: SDValue = SDValue { Node: N, ResNo: 0 };
    NewSDValueDbgMsg(V, "Creating new node: ", self);
    return V;
}

fn SelectionDAG::getPseudoProbeNode(self, Dl: *SDLoc, Chain: SDValue, Guid: u64, Index: u64, Attr: u32) -> SDValue {
    let mut Opcode: u32 = PSEUDO_PROBE;
    let mut VTs: SDVTList = self.getVTList(EVT { Other });
    let mut Ops: [1]SDValue = [Chain];
    let mut ID: SDNodeKey = SDNodeKey { Opcode, VTs, ArrayRef<SDValue> { Ops } };
    ID.AddInteger(Guid);
    ID.AddInteger(Index);
    ID.AddInteger(Attr);
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, Dl, InsertToken) {
        E;
    } else {
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut PseudoProbeSDNode = self.newSDNode(Opcode, Dl.getIROrder(), Dl.getDebugLoc(), VTs, Guid, Index, Attr);
    self.createOperands(N, ArrayRef<SDValue> { Ops });
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    let mut V: SDValue = SDValue { Node: N, ResNo: 0 };
    NewSDValueDbgMsg(V, "Creating new node: ", self);
    return V;
}

fn InferPointerInfo(Info: *MachinePointerInfo, DAG: *mut SelectionDAG, Ptr: SDValue, Offset: i64) -> MachinePointerInfo {
    if dyn_cast(Ptr) {
        FI;
    } else {
        return getFixedStack(DAG.getMachineFunction(), FI.getIndex(), Offset);
    }
    if Ptr.getOpcode() != ADD || !isa(Ptr.getOperand(1)) || !isa(Ptr.getOperand(0)) {
        return Info;
    }
    let mut FI: i32 = cast(Ptr.getOperand(0)).getIndex();
    return getFixedStack(DAG.getMachineFunction(), FI, Offset + cast(Ptr.getOperand(1)).getSExtValue());
}

fn InferPointerInfo(Info: *MachinePointerInfo, DAG: *mut SelectionDAG, Ptr: SDValue, OffsetOp: SDValue) -> MachinePointerInfo {
    if dyn_cast(OffsetOp) {
        OffsetNode;
    } else {
        return InferPointerInfo(Info, DAG, Ptr, OffsetNode.getSExtValue());
    }
    if OffsetOp.isUndef() {
        return InferPointerInfo(Info, DAG, Ptr, 0);
    }
    return Info;
}

fn SelectionDAG::getLoad(self, AM: MemIndexedMode, ExtType: LoadExtType, VT: EVT, dl: *SDLoc, Chain: SDValue, Ptr: SDValue, Offset: SDValue, PtrInfo: MachinePointerInfo, MemVT: EVT, Alignment: Align, MMOFlags: Flags, Metadata: *MMOMetadata) -> SDValue {
    assert!(Chain.getValueType() == EVT { Other }, "Invalid chain type");
    operator(MMOFlags, MOLoad);
    assert!((MMOFlags & MOStore) == 0);
    if PtrInfo.V.isNull() {
        PtrInfo = InferPointerInfo(PtrInfo, *self, Ptr, Offset);
    }
    let mut Size: TypeSize = MemVT.getStoreSize();
    let mut MF: *mut MachineFunction = self.getMachineFunction();
    let mut MMO: *mut MachineMemOperand = MF.getMachineMemOperand(PtrInfo, MMOFlags, Size, Alignment, Metadata, System, NotAtomic, NotAtomic);
    return self.getLoad(AM, ExtType, VT, dl, Chain, Ptr, Offset, MemVT, MMO);
}

fn SelectionDAG::getLoad(self, AM: MemIndexedMode, ExtType: LoadExtType, VT: EVT, dl: *SDLoc, Chain: SDValue, Ptr: SDValue, Offset: SDValue, MemVT: EVT, MMO: *mut MachineMemOperand) -> SDValue {
    if VT == MemVT {
        ExtType = NON_EXTLOAD;
    } else if ExtType == NON_EXTLOAD {
        assert!(VT == MemVT, "Non-extending load from different memory type!");
    } else {
        assert!(MemVT.getScalarType().bitsLT(VT.getScalarType()), "Should only be an extending load, not truncating!");
        assert!(VT.isInteger() == MemVT.isInteger(), "Cannot convert from FP to Int or Int -> FP!");
        assert!(VT.isVector() == MemVT.isVector(), "Cannot use an ext load to convert to or from a vector!");
        assert!((!VT.isVector() || VT.getVectorElementCount() == MemVT.getVectorElementCount()), "Cannot use an ext load to change the number of vector elements!");
    }
    assert!((!MMO.getRanges() || (extract(MMO.getRanges().getOperand(0)).getBitWidth() == MemVT.getScalarSizeInBits() && MemVT.isInteger())), "Range metadata and load type must match!");
    let mut Indexed: bool = AM != UNINDEXED;
    assert!((Indexed || Offset.getOpcode() == POISON), "Unindexed load with an offset!");
    let mut VTs: SDVTList = if Indexed { self.getVTList(VT, Ptr.getValueType(), EVT { Other }) } else { self.getVTList(VT, EVT { Other }) };
    let mut Ops: [3]SDValue = [Chain, Ptr, Offset];
    let mut ID: SDNodeKey = SDNodeKey { LOAD, VTs, ArrayRef<SDValue> { Ops } };
    ID.AddInteger(MemVT.getRawBits());
    ID.AddInteger(getSyntheticNodeSubclassData(dl.getIROrder(), VTs, AM, ExtType, MemVT, MMO));
    ID.AddInteger(MMO.getPointerInfo().getAddrSpace());
    ID.AddInteger(MMO.getFlags());
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if cast_or_null(self.lookupNode(ID, dl, InsertToken)) {
        E;
    } else {
        E.refineAlignment(MMO);
        E.refineMMOMetadata(MMO);
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut LoadSDNode = self.newSDNode(dl.getIROrder(), dl.getDebugLoc(), VTs, AM, ExtType, MemVT, MMO);
    self.createOperands(N, ArrayRef<SDValue> { Ops });
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    let mut V: SDValue = SDValue { Node: N, ResNo: 0 };
    NewSDValueDbgMsg(V, "Creating new node: ", self);
    return V;
}

fn SelectionDAG::getLoad(self, VT: EVT, dl: *SDLoc, Chain: SDValue, Ptr: SDValue, PtrInfo: MachinePointerInfo, Alignment: MaybeAlign, MMOFlags: Flags, Metadata: *MMOMetadata) -> SDValue {
    let mut Undef: SDValue = self.getPOISON(Ptr.getValueType());
    return self.getLoad(UNINDEXED, NON_EXTLOAD, VT, dl, Chain, Ptr, Undef, PtrInfo, VT, Alignment, MMOFlags, Metadata);
}

fn SelectionDAG::getLoad(self, VT: EVT, dl: *SDLoc, Chain: SDValue, Ptr: SDValue, MMO: *mut MachineMemOperand) -> SDValue {
    let mut Undef: SDValue = self.getPOISON(Ptr.getValueType());
    return self.getLoad(UNINDEXED, NON_EXTLOAD, VT, dl, Chain, Ptr, Undef, VT, MMO);
}

fn SelectionDAG::getExtLoad(self, ExtType: LoadExtType, dl: *SDLoc, VT: EVT, Chain: SDValue, Ptr: SDValue, PtrInfo: MachinePointerInfo, MemVT: EVT, Alignment: MaybeAlign, MMOFlags: Flags, Metadata: *MMOMetadata) -> SDValue {
    let mut Undef: SDValue = self.getPOISON(Ptr.getValueType());
    return self.getLoad(UNINDEXED, ExtType, VT, dl, Chain, Ptr, Undef, PtrInfo, MemVT, Alignment, MMOFlags, Metadata);
}

fn SelectionDAG::getExtLoad(self, ExtType: LoadExtType, dl: *SDLoc, VT: EVT, Chain: SDValue, Ptr: SDValue, MemVT: EVT, MMO: *mut MachineMemOperand) -> SDValue {
    let mut Undef: SDValue = self.getPOISON(Ptr.getValueType());
    return self.getLoad(UNINDEXED, ExtType, VT, dl, Chain, Ptr, Undef, MemVT, MMO);
}

fn SelectionDAG::getIndexedLoad(self, OrigLoad: SDValue, dl: *SDLoc, Base: SDValue, Offset: SDValue, AM: MemIndexedMode) -> SDValue {
    let mut LD: *mut LoadSDNode = cast(OrigLoad);
    assert!(LD.getOffset().getOpcode() == POISON, "Load is already a indexed load!");
    let mut MMOFlags: Flags = LD.getMemOperand().getFlags() & operator((MOInvariant | MODereferenceable));
    return self.getLoad(AM, LD.getExtensionType(), OrigLoad.getValueType(), dl, LD.getChain(), Base, Offset, LD.getPointerInfo(), LD.getMemoryVT(), LD.getAlign(), MMOFlags, MMOMetadata { AAInfo: LD.getAAInfo(), Ranges: LD.getRanges(), MemCacheHint: LD.getMemCacheHint() });
}

fn SelectionDAG::getStore(self, Chain: SDValue, dl: *SDLoc, Val: SDValue, Ptr: SDValue, PtrInfo: MachinePointerInfo, Alignment: Align, MMOFlags: Flags, Metadata: *MMOMetadata) -> SDValue {
    assert!(Chain.getValueType() == EVT { Other }, "Invalid chain type");
    operator(MMOFlags, MOStore);
    assert!((MMOFlags & MOLoad) == 0);
    assert!(!Metadata.Ranges, "range metadata is invalid for stores");
    if PtrInfo.V.isNull() {
        PtrInfo = InferPointerInfo(PtrInfo, *self, Ptr, 0);
    }
    let mut MF: *mut MachineFunction = self.getMachineFunction();
    let mut Size: TypeSize = Val.getValueType().getStoreSize();
    let mut MMO: *mut MachineMemOperand = MF.getMachineMemOperand(PtrInfo, MMOFlags, Size, Alignment, Metadata, System, NotAtomic, NotAtomic);
    return self.getStore(Chain, dl, Val, Ptr, MMO);
}

fn SelectionDAG::getStore(self, Chain: SDValue, dl: *SDLoc, Val: SDValue, Ptr: SDValue, MMO: *mut MachineMemOperand) -> SDValue {
    let mut Undef: SDValue = self.getPOISON(Ptr.getValueType());
    return self.getStore(Chain, dl, Val, Ptr, Undef, Val.getValueType(), MMO, UNINDEXED, false);
}

fn SelectionDAG::getStore(self, Chain: SDValue, dl: *SDLoc, Val: SDValue, Ptr: SDValue, Offset: SDValue, SVT: EVT, MMO: *mut MachineMemOperand, AM: MemIndexedMode, IsTruncating: bool) -> SDValue {
    assert!(Chain.getValueType() == EVT { Other }, "Invalid chain type");
    let mut VT: EVT = Val.getValueType();
    if VT == SVT {
        IsTruncating = false;
    } else if !IsTruncating {
        assert!(VT == SVT, "No-truncating store from different memory type!");
    } else {
        assert!(SVT.getScalarType().bitsLT(VT.getScalarType()), "Should only be a truncating store, not extending!");
        assert!(VT.isInteger() == SVT.isInteger(), "Can't do FP-INT conversion!");
        assert!(VT.isVector() == SVT.isVector(), "Cannot use trunc store to convert to or from a vector!");
        assert!((!VT.isVector() || VT.getVectorElementCount() == SVT.getVectorElementCount()), "Cannot use trunc store to change the number of vector elements!");
    }
    let mut Indexed: bool = AM != UNINDEXED;
    assert!((Indexed || Offset.getOpcode() == POISON), "Unindexed store with an offset!");
    let mut VTs: SDVTList = if Indexed { self.getVTList(Ptr.getValueType(), EVT { Other }) } else { self.getVTList(EVT { Other }) };
    let mut Ops: [4]SDValue = [Chain, Val, Ptr, Offset];
    let mut ID: SDNodeKey = SDNodeKey { STORE, VTs, ArrayRef<SDValue> { Ops } };
    ID.AddInteger(SVT.getRawBits());
    ID.AddInteger(getSyntheticNodeSubclassData(dl.getIROrder(), VTs, AM, IsTruncating, SVT, MMO));
    ID.AddInteger(MMO.getPointerInfo().getAddrSpace());
    ID.AddInteger(MMO.getFlags());
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, dl, InsertToken) {
        E;
    } else {
        cast(E).refineAlignment(MMO);
        cast(E).refineMMOMetadata(MMO);
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut StoreSDNode = self.newSDNode(dl.getIROrder(), dl.getDebugLoc(), VTs, AM, IsTruncating, SVT, MMO);
    self.createOperands(N, ArrayRef<SDValue> { Ops });
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    let mut V: SDValue = SDValue { Node: N, ResNo: 0 };
    NewSDValueDbgMsg(V, "Creating new node: ", self);
    return V;
}

fn SelectionDAG::getTruncStore(self, Chain: SDValue, dl: *SDLoc, Val: SDValue, Ptr: SDValue, Offset: SDValue, PtrInfo: MachinePointerInfo, SVT: EVT, Alignment: Align, MMOFlags: Flags, Metadata: *MMOMetadata) -> SDValue {
    assert!(Chain.getValueType() == EVT { Other }, "Invalid chain type");
    operator(MMOFlags, MOStore);
    assert!((MMOFlags & MOLoad) == 0);
    assert!(!Metadata.Ranges, "range metadata is invalid for stores");
    if PtrInfo.V.isNull() {
        PtrInfo = InferPointerInfo(PtrInfo, *self, Ptr, 0);
    }
    let mut MF: *mut MachineFunction = self.getMachineFunction();
    let mut MMO: *mut MachineMemOperand = MF.getMachineMemOperand(PtrInfo, MMOFlags, SVT.getStoreSize(), Alignment, Metadata, System, NotAtomic, NotAtomic);
    return self.getTruncStore(Chain, dl, Val, Ptr, Offset, SVT, MMO);
}

fn SelectionDAG::getTruncStore(self, Chain: SDValue, dl: *SDLoc, Val: SDValue, Ptr: SDValue, PtrInfo: MachinePointerInfo, SVT: EVT, Alignment: Align, MMOFlags: Flags, Metadata: *MMOMetadata) -> SDValue {
    return self.getTruncStore(Chain, dl, Val, Ptr, self.getPOISON(Ptr.getValueType()), PtrInfo, SVT, Alignment, MMOFlags, Metadata);
}

fn SelectionDAG::getTruncStore(self, Chain: SDValue, dl: *SDLoc, Val: SDValue, Ptr: SDValue, Offset: SDValue, SVT: EVT, MMO: *mut MachineMemOperand) -> SDValue {
    return self.getStore(Chain, dl, Val, Ptr, Offset, SVT, MMO, UNINDEXED, true);
}

fn SelectionDAG::getTruncStore(self, Chain: SDValue, dl: *SDLoc, Val: SDValue, Ptr: SDValue, SVT: EVT, MMO: *mut MachineMemOperand) -> SDValue {
    return self.getStore(Chain, dl, Val, Ptr, self.getPOISON(Ptr.getValueType()), SVT, MMO, UNINDEXED, true);
}

fn SelectionDAG::getIndexedStore(self, OrigStore: SDValue, dl: *SDLoc, Base: SDValue, Offset: SDValue, AM: MemIndexedMode) -> SDValue {
    let mut ST: *mut StoreSDNode = cast(OrigStore);
    assert!(ST.getOffset().getOpcode() == POISON, "Store is already a indexed store!");
    return self.getStore(ST.getChain(), dl, ST.getValue(), Base, Offset, ST.getMemoryVT(), ST.getMemOperand(), AM, ST.isTruncatingStore());
}

fn SelectionDAG::getLoadVP(self, AM: MemIndexedMode, ExtType: LoadExtType, VT: EVT, dl: *SDLoc, Chain: SDValue, Ptr: SDValue, Offset: SDValue, Mask: SDValue, EVL: SDValue, PtrInfo: MachinePointerInfo, MemVT: EVT, Alignment: Align, MMOFlags: Flags, AAInfo: *AAMDNodes, Ranges: *MDNode, IsExpanding: bool) -> SDValue {
    operator(MMOFlags, MOLoad);
    assert!((MMOFlags & MOStore) == 0);
    if PtrInfo.V.isNull() {
        PtrInfo = InferPointerInfo(PtrInfo, *self, Ptr, Offset);
    }
    let mut Size: TypeSize = MemVT.getStoreSize();
    let mut MF: *mut MachineFunction = self.getMachineFunction();
    let mut MMO: *mut MachineMemOperand = MF.getMachineMemOperand(PtrInfo, MMOFlags, Size, Alignment, MMOMetadata { AAInfo: AAInfo, Ranges: Ranges, MemCacheHint: null }, System, NotAtomic, NotAtomic);
    return self.getLoadVP(AM, ExtType, VT, dl, Chain, Ptr, Offset, Mask, EVL, MemVT, MMO, IsExpanding);
}

fn SelectionDAG::getLoadVP(self, AM: MemIndexedMode, ExtType: LoadExtType, VT: EVT, dl: *SDLoc, Chain: SDValue, Ptr: SDValue, Offset: SDValue, Mask: SDValue, EVL: SDValue, MemVT: EVT, MMO: *mut MachineMemOperand, IsExpanding: bool) -> SDValue {
    assert!(Chain.getValueType() == EVT { Other }, "Invalid chain type");
    assert!(Mask.getValueType().getVectorElementCount() == VT.getVectorElementCount(), "Vector width mismatch between mask and data");
    let mut Indexed: bool = AM != UNINDEXED;
    assert!((Indexed || Offset.getOpcode() == POISON), "Unindexed load with an offset!");
    let mut VTs: SDVTList = if Indexed { self.getVTList(VT, Ptr.getValueType(), EVT { Other }) } else { self.getVTList(VT, EVT { Other }) };
    let mut Ops: [5]SDValue = [Chain, Ptr, Offset, Mask, EVL];
    let mut ID: SDNodeKey = SDNodeKey { VP_LOAD, VTs, ArrayRef<SDValue> { Ops } };
    ID.AddInteger(MemVT.getRawBits());
    ID.AddInteger(getSyntheticNodeSubclassData(dl.getIROrder(), VTs, AM, ExtType, IsExpanding, MemVT, MMO));
    ID.AddInteger(MMO.getPointerInfo().getAddrSpace());
    ID.AddInteger(MMO.getFlags());
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if cast_or_null(self.lookupNode(ID, dl, InsertToken)) {
        E;
    } else {
        E.refineAlignment(MMO);
        E.refineMMOMetadata(MMO);
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut VPLoadSDNode = self.newSDNode(dl.getIROrder(), dl.getDebugLoc(), VTs, AM, ExtType, IsExpanding, MemVT, MMO);
    self.createOperands(N, ArrayRef<SDValue> { Ops });
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    let mut V: SDValue = SDValue { Node: N, ResNo: 0 };
    NewSDValueDbgMsg(V, "Creating new node: ", self);
    return V;
}

fn SelectionDAG::getLoadVP(self, VT: EVT, dl: *SDLoc, Chain: SDValue, Ptr: SDValue, Mask: SDValue, EVL: SDValue, PtrInfo: MachinePointerInfo, Alignment: MaybeAlign, MMOFlags: Flags, AAInfo: *AAMDNodes, Ranges: *MDNode, IsExpanding: bool) -> SDValue {
    let mut Undef: SDValue = self.getPOISON(Ptr.getValueType());
    return self.getLoadVP(UNINDEXED, NON_EXTLOAD, VT, dl, Chain, Ptr, Undef, Mask, EVL, PtrInfo, VT, Alignment, MMOFlags, AAInfo, Ranges, IsExpanding);
}

fn SelectionDAG::getLoadVP(self, VT: EVT, dl: *SDLoc, Chain: SDValue, Ptr: SDValue, Mask: SDValue, EVL: SDValue, MMO: *mut MachineMemOperand, IsExpanding: bool) -> SDValue {
    let mut Undef: SDValue = self.getPOISON(Ptr.getValueType());
    return self.getLoadVP(UNINDEXED, NON_EXTLOAD, VT, dl, Chain, Ptr, Undef, Mask, EVL, VT, MMO, IsExpanding);
}

fn SelectionDAG::getExtLoadVP(self, ExtType: LoadExtType, dl: *SDLoc, VT: EVT, Chain: SDValue, Ptr: SDValue, Mask: SDValue, EVL: SDValue, PtrInfo: MachinePointerInfo, MemVT: EVT, Alignment: MaybeAlign, MMOFlags: Flags, AAInfo: *AAMDNodes, IsExpanding: bool) -> SDValue {
    let mut Undef: SDValue = self.getPOISON(Ptr.getValueType());
    return self.getLoadVP(UNINDEXED, ExtType, VT, dl, Chain, Ptr, Undef, Mask, EVL, PtrInfo, MemVT, Alignment, MMOFlags, AAInfo, null, IsExpanding);
}

fn SelectionDAG::getExtLoadVP(self, ExtType: LoadExtType, dl: *SDLoc, VT: EVT, Chain: SDValue, Ptr: SDValue, Mask: SDValue, EVL: SDValue, MemVT: EVT, MMO: *mut MachineMemOperand, IsExpanding: bool) -> SDValue {
    let mut Undef: SDValue = self.getPOISON(Ptr.getValueType());
    return self.getLoadVP(UNINDEXED, ExtType, VT, dl, Chain, Ptr, Undef, Mask, EVL, MemVT, MMO, IsExpanding);
}

fn SelectionDAG::getStoreVP(self, Chain: SDValue, dl: *SDLoc, Val: SDValue, Ptr: SDValue, Offset: SDValue, Mask: SDValue, EVL: SDValue, MemVT: EVT, MMO: *mut MachineMemOperand, AM: MemIndexedMode, IsTruncating: bool, IsCompressing: bool) -> SDValue {
    assert!(Chain.getValueType() == EVT { Other }, "Invalid chain type");
    assert!(Mask.getValueType().getVectorElementCount() == Val.getValueType().getVectorElementCount(), "Vector width mismatch between mask and data");
    let mut Indexed: bool = AM != UNINDEXED;
    assert!((Indexed || Offset.getOpcode() == POISON), "Unindexed vp_store with an offset!");
    let mut VTs: SDVTList = if Indexed { self.getVTList(Ptr.getValueType(), EVT { Other }) } else { self.getVTList(EVT { Other }) };
    let mut Ops: [6]SDValue = [Chain, Val, Ptr, Offset, Mask, EVL];
    let mut ID: SDNodeKey = SDNodeKey { VP_STORE, VTs, ArrayRef<SDValue> { Ops } };
    ID.AddInteger(MemVT.getRawBits());
    ID.AddInteger(getSyntheticNodeSubclassData(dl.getIROrder(), VTs, AM, IsTruncating, IsCompressing, MemVT, MMO));
    ID.AddInteger(MMO.getPointerInfo().getAddrSpace());
    ID.AddInteger(MMO.getFlags());
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, dl, InsertToken) {
        E;
    } else {
        cast(E).refineAlignment(MMO);
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut VPStoreSDNode = self.newSDNode(dl.getIROrder(), dl.getDebugLoc(), VTs, AM, IsTruncating, IsCompressing, MemVT, MMO);
    self.createOperands(N, ArrayRef<SDValue> { Ops });
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    let mut V: SDValue = SDValue { Node: N, ResNo: 0 };
    NewSDValueDbgMsg(V, "Creating new node: ", self);
    return V;
}

fn SelectionDAG::getTruncStoreVP(self, Chain: SDValue, dl: *SDLoc, Val: SDValue, Ptr: SDValue, Mask: SDValue, EVL: SDValue, PtrInfo: MachinePointerInfo, SVT: EVT, Alignment: Align, MMOFlags: Flags, AAInfo: *AAMDNodes, IsCompressing: bool) -> SDValue {
    assert!(Chain.getValueType() == EVT { Other }, "Invalid chain type");
    operator(MMOFlags, MOStore);
    assert!((MMOFlags & MOLoad) == 0);
    if PtrInfo.V.isNull() {
        PtrInfo = InferPointerInfo(PtrInfo, *self, Ptr, 0);
    }
    let mut MF: *mut MachineFunction = self.getMachineFunction();
    let mut MMO: *mut MachineMemOperand = MF.getMachineMemOperand(PtrInfo, MMOFlags, SVT.getStoreSize(), Alignment, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null }, System, NotAtomic, NotAtomic);
    return self.getTruncStoreVP(Chain, dl, Val, Ptr, Mask, EVL, SVT, MMO, IsCompressing);
}

fn SelectionDAG::getTruncStoreVP(self, Chain: SDValue, dl: *SDLoc, Val: SDValue, Ptr: SDValue, Mask: SDValue, EVL: SDValue, SVT: EVT, MMO: *mut MachineMemOperand, IsCompressing: bool) -> SDValue {
    let mut VT: EVT = Val.getValueType();
    assert!(Chain.getValueType() == EVT { Other }, "Invalid chain type");
    if VT == SVT {
        return self.getStoreVP(Chain, dl, Val, Ptr, self.getPOISON(Ptr.getValueType()), Mask, EVL, VT, MMO, UNINDEXED, false, IsCompressing);
    }
    assert!(SVT.getScalarType().bitsLT(VT.getScalarType()), "Should only be a truncating store, not extending!");
    assert!(VT.isInteger() == SVT.isInteger(), "Can't do FP-INT conversion!");
    assert!(VT.isVector() == SVT.isVector(), "Cannot use trunc store to convert to or from a vector!");
    assert!((!VT.isVector() || VT.getVectorElementCount() == SVT.getVectorElementCount()), "Cannot use trunc store to change the number of vector elements!");
    let mut VTs: SDVTList = self.getVTList(EVT { Other });
    let mut Undef: SDValue = self.getPOISON(Ptr.getValueType());
    let mut Ops: [6]SDValue = [Chain, Val, Ptr, Undef, Mask, EVL];
    let mut ID: SDNodeKey = SDNodeKey { VP_STORE, VTs, ArrayRef<SDValue> { Ops } };
    ID.AddInteger(SVT.getRawBits());
    ID.AddInteger(getSyntheticNodeSubclassData(dl.getIROrder(), VTs, UNINDEXED, true, IsCompressing, SVT, MMO));
    ID.AddInteger(MMO.getPointerInfo().getAddrSpace());
    ID.AddInteger(MMO.getFlags());
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, dl, InsertToken) {
        E;
    } else {
        cast(E).refineAlignment(MMO);
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut VPStoreSDNode = self.newSDNode(dl.getIROrder(), dl.getDebugLoc(), VTs, UNINDEXED, true, IsCompressing, SVT, MMO);
    self.createOperands(N, ArrayRef<SDValue> { Ops });
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    let mut V: SDValue = SDValue { Node: N, ResNo: 0 };
    NewSDValueDbgMsg(V, "Creating new node: ", self);
    return V;
}

fn SelectionDAG::getStridedLoadVP(self, AM: MemIndexedMode, ExtType: LoadExtType, VT: EVT, DL: *SDLoc, Chain: SDValue, Ptr: SDValue, Offset: SDValue, Stride: SDValue, Mask: SDValue, EVL: SDValue, MemVT: EVT, MMO: *mut MachineMemOperand, IsExpanding: bool) -> SDValue {
    let mut Indexed: bool = AM != UNINDEXED;
    assert!((Indexed || Offset.getOpcode() == POISON), "Unindexed load with an offset!");
    let mut Ops: [6]SDValue = [Chain, Ptr, Offset, Stride, Mask, EVL];
    let mut VTs: SDVTList = if Indexed { self.getVTList(VT, Ptr.getValueType(), EVT { Other }) } else { self.getVTList(VT, EVT { Other }) };
    let mut ID: SDNodeKey = SDNodeKey { EXPERIMENTAL_VP_STRIDED_LOAD, VTs, ArrayRef<SDValue> { Ops } };
    ID.AddInteger(MemVT.getRawBits());
    ID.AddInteger(getSyntheticNodeSubclassData(DL.getIROrder(), VTs, AM, ExtType, IsExpanding, MemVT, MMO));
    ID.AddInteger(MMO.getPointerInfo().getAddrSpace());
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, DL, InsertToken) {
        E;
    } else {
        cast(E).refineAlignment(MMO);
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut VPStridedLoadSDNode = self.newSDNode(DL.getIROrder(), DL.getDebugLoc(), VTs, AM, ExtType, IsExpanding, MemVT, MMO);
    self.createOperands(N, ArrayRef<SDValue> { Ops });
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    let mut V: SDValue = SDValue { Node: N, ResNo: 0 };
    NewSDValueDbgMsg(V, "Creating new node: ", self);
    return V;
}

fn SelectionDAG::getStridedLoadVP(self, VT: EVT, DL: *SDLoc, Chain: SDValue, Ptr: SDValue, Stride: SDValue, Mask: SDValue, EVL: SDValue, MMO: *mut MachineMemOperand, IsExpanding: bool) -> SDValue {
    let mut Undef: SDValue = self.getPOISON(Ptr.getValueType());
    return self.getStridedLoadVP(UNINDEXED, NON_EXTLOAD, VT, DL, Chain, Ptr, Undef, Stride, Mask, EVL, VT, MMO, IsExpanding);
}

fn SelectionDAG::getExtStridedLoadVP(self, ExtType: LoadExtType, DL: *SDLoc, VT: EVT, Chain: SDValue, Ptr: SDValue, Stride: SDValue, Mask: SDValue, EVL: SDValue, MemVT: EVT, MMO: *mut MachineMemOperand, IsExpanding: bool) -> SDValue {
    let mut Undef: SDValue = self.getPOISON(Ptr.getValueType());
    return self.getStridedLoadVP(UNINDEXED, ExtType, VT, DL, Chain, Ptr, Undef, Stride, Mask, EVL, MemVT, MMO, IsExpanding);
}

fn SelectionDAG::getStridedStoreVP(self, Chain: SDValue, DL: *SDLoc, Val: SDValue, Ptr: SDValue, Offset: SDValue, Stride: SDValue, Mask: SDValue, EVL: SDValue, MemVT: EVT, MMO: *mut MachineMemOperand, AM: MemIndexedMode, IsTruncating: bool, IsCompressing: bool) -> SDValue {
    assert!(Chain.getValueType() == EVT { Other }, "Invalid chain type");
    let mut Indexed: bool = AM != UNINDEXED;
    assert!((Indexed || Offset.getOpcode() == POISON), "Unindexed vp_store with an offset!");
    let mut VTs: SDVTList = if Indexed { self.getVTList(Ptr.getValueType(), EVT { Other }) } else { self.getVTList(EVT { Other }) };
    let mut Ops: [7]SDValue = [Chain, Val, Ptr, Offset, Stride, Mask, EVL];
    let mut ID: SDNodeKey = SDNodeKey { EXPERIMENTAL_VP_STRIDED_STORE, VTs, ArrayRef<SDValue> { Ops } };
    ID.AddInteger(MemVT.getRawBits());
    ID.AddInteger(getSyntheticNodeSubclassData(DL.getIROrder(), VTs, AM, IsTruncating, IsCompressing, MemVT, MMO));
    ID.AddInteger(MMO.getPointerInfo().getAddrSpace());
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, DL, InsertToken) {
        E;
    } else {
        cast(E).refineAlignment(MMO);
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut VPStridedStoreSDNode = self.newSDNode(DL.getIROrder(), DL.getDebugLoc(), VTs, AM, IsTruncating, IsCompressing, MemVT, MMO);
    self.createOperands(N, ArrayRef<SDValue> { Ops });
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    let mut V: SDValue = SDValue { Node: N, ResNo: 0 };
    NewSDValueDbgMsg(V, "Creating new node: ", self);
    return V;
}

fn SelectionDAG::getGatherVP(self, VTs: SDVTList, VT: EVT, dl: *SDLoc, Ops: ArrayRef<SDValue>, MMO: *mut MachineMemOperand, IndexType: MemIndexType) -> SDValue {
    assert!(Ops.len == 6, "Incompatible number of operands");
    let mut ID: SDNodeKey = SDNodeKey { VP_GATHER, VTs, ArrayRef<SDValue> { Ops } };
    ID.AddInteger(VT.getRawBits());
    ID.AddInteger(getSyntheticNodeSubclassData(dl.getIROrder(), VTs, VT, MMO, IndexType));
    ID.AddInteger(MMO.getPointerInfo().getAddrSpace());
    ID.AddInteger(MMO.getFlags());
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, dl, InsertToken) {
        E;
    } else {
        cast(E).refineAlignment(MMO);
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut VPGatherSDNode = self.newSDNode(dl.getIROrder(), dl.getDebugLoc(), VTs, VT, MMO, IndexType);
    self.createOperands(N, ArrayRef<SDValue> { Ops });
    assert!(N.getMask().getValueType().getVectorElementCount() == N.getValueType(0).getVectorElementCount(), "Vector width mismatch between mask and data");
    assert!(N.getIndex().getValueType().getVectorElementCount().isScalable() == N.getValueType(0).getVectorElementCount().isScalable(), "Scalable flags of index and data do not match");
    assert!(isKnownGE(N.getIndex().getValueType().getVectorElementCount(), N.getValueType(0).getVectorElementCount()), "Vector width mismatch between index and data");
    assert!(isa(N.getScale()) && operator(N.getScale()).getAsAPIntVal().isPowerOf2(), "Scale should be a constant power of 2");
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    let mut V: SDValue = SDValue { Node: N, ResNo: 0 };
    NewSDValueDbgMsg(V, "Creating new node: ", self);
    return V;
}

