fn SelectionDAG::simplifySelect(self, Cond: SDValue, T: SDValue, F: SDValue) -> SDValue {
    if Cond.isUndef() {
        return if self.isConstantValueOfAnyType(T) { T } else { F };
    }
    if T.isUndef() {
        return if self.isGuaranteedNotToBePoison(F, 0) { F } else { self.getFreeze(F) };
    }
    if F.isUndef() {
        return if self.isGuaranteedNotToBePoison(T, 0) { T } else { self.getFreeze(T) };
    }
    if self.isBoolConstant(Cond) {
        C;
    } else {
        return if operator(C) { T } else { F };
    }
    if T == F {
        return T;
    }
    return SDValue {};
}

fn SelectionDAG::simplifyShift(self, X: SDValue, Y: SDValue) -> SDValue {
    if X.isUndef() {
        return self.getConstant(0, SDLoc { X.getNode() }, X.getValueType(), false, false);
    }
    if Y.isUndef() {
        return self.getUNDEF(X.getValueType());
    }
    if isNullOrNullSplat(X, false) || isNullOrNullSplat(Y, false) {
        return X;
    }
    let mut isShiftTooBig: Closure_18 = Closure_18 { cap_0: X };
    if matchUnaryPredicate(Y, function<bool (ConstantSDNode *)> { isShiftTooBig }, true, false) {
        return self.getUNDEF(X.getValueType());
    }
    if X.getValueType().getScalarType() == EVT { i1 } {
        return X;
    }
    return SDValue {};
}

fn SelectionDAG::simplifyFPBinop(self, Opcode: u32, X: SDValue, Y: SDValue, Flags: SDNodeFlags) -> SDValue {
    let mut XC: *mut ConstantFPSDNode = isConstOrConstSplatFP(X, true);
    let mut YC: *mut ConstantFPSDNode = isConstOrConstSplatFP(Y, true);
    let mut HasNan: bool = (XC && XC.getValueAPF().isNaN()) || (YC && YC.getValueAPF().isNaN());
    let mut HasInf: bool = (XC && XC.getValueAPF().isInfinity()) || (YC && YC.getValueAPF().isInfinity());
    if Flags.hasNoNaNs() && (HasNan || X.isUndef() || Y.isUndef()) {
        return self.getUNDEF(X.getValueType());
    }
    if Flags.hasNoInfs() && (HasInf || X.isUndef() || Y.isUndef()) {
        return self.getUNDEF(X.getValueType());
    }
    if !YC {
        return SDValue {};
    }
    if Opcode == FADD {
        if YC.getValueAPF().isNegZero() {
            return X;
        }
    }
    if Opcode == FSUB {
        if YC.getValueAPF().isPosZero() {
            return X;
        }
    }
    if Opcode == FMUL || Opcode == FDIV {
        if YC.getValueAPF().isOne() {
            return X;
        }
    }
    if Opcode == FMUL && Flags.hasNoNaNs() && Flags.hasNoSignedZeros() {
        if YC.getValueAPF().isZero() {
            return self.getConstantFP(0.0, SDLoc { Y }, Y.getValueType(), false);
        }
    }
    return SDValue {};
}

fn SelectionDAG::getVAArg(self, VT: EVT, dl: *SDLoc, Chain: SDValue, Ptr: SDValue, SV: SDValue, Align: u32) -> SDValue {
    let mut Ops: [4]SDValue = [Chain, Ptr, SV, self.getTargetConstant(Align, dl, EVT { i32 }, false)];
    return self.getNode(VAARG, dl, self.getVTList(VT, EVT { Other }), ArrayRef<SDValue> { Ops });
}

fn SelectionDAG::getNode(self, Opcode: u32, DL: *SDLoc, VT: EVT, Ops: ArrayRef<SDUse>) -> SDValue {
    match Ops.len {
        0 => {
            return self.getNode(Opcode, DL, VT);
        },
        1 => {
            return self.getNode(Opcode, DL, VT, Ops[0].get());
        },
        2 => {
            return self.getNode(Opcode, DL, VT, Ops[0].operator const llvm::SDValue &(), Ops[1].operator const llvm::SDValue &());
        },
        3 => {
            return self.getNode(Opcode, DL, VT, Ops[0].operator const llvm::SDValue &(), Ops[1].operator const llvm::SDValue &(), Ops[2].operator const llvm::SDValue &());
        },
        _ => {
            break;
        },
    }
    let mut NewOps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { Ops };
    return self.getNode(Opcode, DL, VT, ArrayRef<SDValue> { NewOps });
}

fn SelectionDAG::getNode(self, Opcode: u32, DL: *SDLoc, VT: EVT, Ops: ArrayRef<SDValue>) -> SDValue {
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    if self.Inserter {
        Flags = self.Inserter.getFlags();
    }
    return self.getNode(Opcode, DL, VT, ArrayRef<SDValue> { Ops }, Flags);
}

fn SelectionDAG::getNode(self, Opcode: u32, DL: *SDLoc, VT: EVT, Ops: ArrayRef<SDValue>, Flags: SDNodeFlags) -> SDValue {
    let mut NumOps: u32 = Ops.len;
    match NumOps {
        0 => {
            return self.getNode(Opcode, DL, VT);
        },
        1 => {
            return self.getNode(Opcode, DL, VT, Ops[0], Flags);
        },
        2 => {
            return self.getNode(Opcode, DL, VT, Ops[0], Ops[1], Flags);
        },
        3 => {
            return self.getNode(Opcode, DL, VT, Ops[0], Ops[1], Ops[2], Flags);
        },
        _ => {
            break;
        },
    }
    for Op in Ops {
        assert!(Op.getOpcode() != DELETED_NODE, "Operand is DELETED_NODE!");
    }
    match Opcode {
        _ => {
            break;
        },
        BUILD_VECTOR => {
            if FoldBUILD_VECTOR(DL, VT, ArrayRef<SDValue> { Ops }, *self) {
                V;
            } else {
                return V;
            }
        },
        CONCAT_VECTORS => {
            if foldCONCAT_VECTORS(DL, VT, ArrayRef<SDValue> { Ops }, *self) {
                V;
            } else {
                return V;
            }
        },
        SELECT_CC => {
            assert!(NumOps == 5, "SELECT_CC takes 5 operands!");
        },
        BR_CC => {
            assert!(NumOps == 5, "BR_CC takes 5 operands!");
        },
        VP_REDUCE_MUL => {
            if VT == EVT { i1 } {
                Opcode = VP_REDUCE_AND;
            }
        },
        VP_REDUCE_ADD => {
            if VT == EVT { i1 } {
                Opcode = VP_REDUCE_XOR;
            }
        },
        VP_REDUCE_SMAX => {
            VP_REDUCE_UMIN;
        },
        VP_REDUCE_SMIN => {
            VP_REDUCE_UMAX;
        },
    }
    let mut N: *mut SDNode = null;
    let mut VTs: SDVTList = self.getVTList(VT);
    if VT != EVT { Glue } {
        let mut ID: SDNodeKey = SDNodeKey { Opcode, VTs, ArrayRef<SDValue> { Ops } };
        let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
        if self.lookupNode(ID, DL, InsertToken) {
            E;
        } else {
            E.intersectFlagsWith(Flags);
            return SDValue { Node: E, ResNo: 0 };
        }
        N = self.newSDNode(Opcode, DL.getIROrder(), DL.getDebugLoc(), VTs);
        self.createOperands(N, ArrayRef<SDValue> { Ops });
        self.CSEMap.insert(N, InsertToken);
    } else {
        N = self.newSDNode(Opcode, DL.getIROrder(), DL.getDebugLoc(), VTs);
        self.createOperands(N, ArrayRef<SDValue> { Ops });
    }
    N.setFlags(Flags);
    self.InsertNode(N);
    let mut V: SDValue = SDValue { Node: N, ResNo: 0 };
    NewSDValueDbgMsg(V, "Creating new node: ", self);
    return V;
}

fn SelectionDAG::getNode(self, Opcode: u32, DL: *SDLoc, ResultTys: ArrayRef<EVT>, Ops: ArrayRef<SDValue>) -> SDValue {
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    if self.Inserter {
        Flags = self.Inserter.getFlags();
    }
    return self.getNode(Opcode, DL, self.getVTList(ArrayRef<EVT> { ResultTys }), ArrayRef<SDValue> { Ops }, Flags);
}

fn SelectionDAG::getNode(self, Opcode: u32, DL: *SDLoc, ResultTys: ArrayRef<EVT>, Ops: ArrayRef<SDValue>, Flags: SDNodeFlags) -> SDValue {
    return self.getNode(Opcode, DL, self.getVTList(ArrayRef<EVT> { ResultTys }), ArrayRef<SDValue> { Ops }, Flags);
}

fn SelectionDAG::getNode(self, Opcode: u32, DL: *SDLoc, VTList: SDVTList, Ops: ArrayRef<SDValue>) -> SDValue {
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    if self.Inserter {
        Flags = self.Inserter.getFlags();
    }
    return self.getNode(Opcode, DL, VTList, ArrayRef<SDValue> { Ops }, Flags);
}

fn SelectionDAG::getNode(self, Opcode: u32, DL: *SDLoc, VTList: SDVTList, Ops: ArrayRef<SDValue>, Flags: SDNodeFlags) -> SDValue {
    if VTList.NumVTs == 1 {
        return self.getNode(Opcode, DL, VTList.VTs[0], ArrayRef<SDValue> { Ops }, Flags);
    }
    for Op in Ops {
        assert!(Op.getOpcode() != DELETED_NODE, "Operand is DELETED_NODE!");
    }
    match Opcode {
        SADDO => {
            UADDO;
        },
        SADDO_CARRY => {
            UADDO_CARRY;
        },
        SMUL_LOHI => {
            UMUL_LOHI;
        },
        FFREXP => {
            assert!(VTList.NumVTs == 2 && Ops.len == 1, "Invalid ffrexp op!");
            assert!(VTList.VTs[0].isFloatingPoint() && VTList.VTs[1].isInteger() && VTList.VTs[0] == Ops[0].getValueType(), "frexp type mismatch");
            if dyn_cast(Ops[0]) {
                C;
            } else {
                let mut FrexpExp: i32 = 0;
                let mut FrexpMant: APFloat = frexp(C.getValueAPF(), FrexpExp, rmNearestTiesToEven);
                let mut Result0: SDValue = self.getConstantFP(FrexpMant, DL, VTList.VTs[0], false);
                let mut Result1: SDValue = self.getSignedConstant(if FrexpMant.isFinite() { FrexpExp } else { 0 }, DL, VTList.VTs[1], false, false);
                return self.getNode(MERGE_VALUES, DL, VTList, ArrayRef<SDValue> { [Result0, Result1] }, Flags);
            }
            break;
        },
        STRICT_FP_EXTEND => {
            assert!(VTList.NumVTs == 2 && Ops.len == 2, "Invalid STRICT_FP_EXTEND!");
        },
        STRICT_FP_ROUND => {
            assert!(VTList.NumVTs == 2 && Ops.len == 3, "Invalid STRICT_FP_ROUND!");
        },
    }
    let mut N: *mut SDNode = null;
    if VTList.VTs[VTList.NumVTs - 1] != EVT { Glue } {
        let mut ID: SDNodeKey = SDNodeKey { Opcode, VTList, ArrayRef<SDValue> { Ops } };
        let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
        if self.lookupNode(ID, DL, InsertToken) {
            E;
        } else {
            E.intersectFlagsWith(Flags);
            return SDValue { Node: E, ResNo: 0 };
        }
        N = self.newSDNode(Opcode, DL.getIROrder(), DL.getDebugLoc(), VTList);
        self.createOperands(N, ArrayRef<SDValue> { Ops });
        self.CSEMap.insert(N, InsertToken);
    } else {
        N = self.newSDNode(Opcode, DL.getIROrder(), DL.getDebugLoc(), VTList);
        self.createOperands(N, ArrayRef<SDValue> { Ops });
    }
    N.setFlags(Flags);
    self.InsertNode(N);
    let mut V: SDValue = SDValue { Node: N, ResNo: 0 };
    NewSDValueDbgMsg(V, "Creating new node: ", self);
    return V;
}

fn SelectionDAG::getNode(self, Opcode: u32, DL: *SDLoc, VTList: SDVTList) -> SDValue {
    return self.getNode(Opcode, DL, VTList, ArrayRef<SDValue> {});
}

