fn getBaseOpcodeForVP(VPOpcode: u32, hasFPExcept: bool) -> optional<unsigned int> {
    match VPOpcode {
        _ => {
            return optional<unsigned int> { nullopt };
        },
        VP_SDIV => {
            return optional<unsigned int> { SDIV };
        },
        VP_SREM => {
