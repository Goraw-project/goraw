fn SelectionDAG::getMaskedLoad(self, VT: EVT, dl: *SDLoc, Chain: SDValue, Base: SDValue, Offset: SDValue, Mask: SDValue, PassThru: SDValue, MemVT: EVT, MMO: *mut MachineMemOperand, AM: MemIndexedMode, ExtTy: LoadExtType, isExpanding: bool) -> SDValue {
    let mut Indexed: bool = AM != UNINDEXED;
    assert!((Indexed || Offset.getOpcode() == POISON), "Unindexed masked load with an offset!");
    let mut VTs: SDVTList = if Indexed { self.getVTList(VT, Base.getValueType(), EVT { Other }) } else { self.getVTList(VT, EVT { Other }) };
    let mut Ops: [5]SDValue = [Chain, Base, Offset, Mask, PassThru];
    let mut ID: SDNodeKey = SDNodeKey { MLOAD, VTs, ArrayRef<SDValue> { Ops } };
    ID.AddInteger(MemVT.getRawBits());
    ID.AddInteger(getSyntheticNodeSubclassData(dl.getIROrder(), VTs, AM, ExtTy, isExpanding, MemVT, MMO));
    ID.AddInteger(MMO.getPointerInfo().getAddrSpace());
    ID.AddInteger(MMO.getFlags());
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, dl, InsertToken) {
        E;
    } else {
        cast(E).refineAlignment(MMO);
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut MaskedLoadSDNode = self.newSDNode(dl.getIROrder(), dl.getDebugLoc(), VTs, AM, ExtTy, isExpanding, MemVT, MMO);
    self.createOperands(N, ArrayRef<SDValue> { Ops });
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    let mut V: SDValue = SDValue { Node: N, ResNo: 0 };
    NewSDValueDbgMsg(V, "Creating new node: ", self);
    return V;
}

fn SelectionDAG::getIndexedMaskedLoad(self, OrigLoad: SDValue, dl: *SDLoc, Base: SDValue, Offset: SDValue, AM: MemIndexedMode) -> SDValue {
    let mut LD: *mut MaskedLoadSDNode = cast(OrigLoad);
    assert!(LD.getOffset().getOpcode() == POISON, "Masked load is already a indexed load!");
    return self.getMaskedLoad(OrigLoad.getValueType(), dl, LD.getChain(), Base, Offset, LD.getMask(), LD.getPassThru(), LD.getMemoryVT(), LD.getMemOperand(), AM, LD.getExtensionType(), LD.isExpandingLoad());
}

fn SelectionDAG::getMaskedStore(self, Chain: SDValue, dl: *SDLoc, Val: SDValue, Base: SDValue, Offset: SDValue, Mask: SDValue, MemVT: EVT, MMO: *mut MachineMemOperand, AM: MemIndexedMode, IsTruncating: bool, IsCompressing: bool) -> SDValue {
