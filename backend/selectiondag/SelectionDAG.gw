unsafe fn Closure_4::call(self: *mut Closure_4) -> SDValue {
        if (*self.VT).getScalarType() == EVT { i1 } || self.TLI.getBooleanContents((*self.OpVT)) == UndefinedBooleanContent {
            return self.getUNDEF((*self.VT));
        }
        return self.getConstant(0, (*self.dl), (*self.VT), false, false);
    }

