    let mut Ops: [5]SDValue = [N1, N2, N3, N4, N5];
    return self.getNode(Opcode, DL, VTList, ArrayRef<SDValue> { Ops });
}

fn SelectionDAG::getVTList(self, VT: EVT) -> SDVTList {
    if !VT.isExtended() {
        return makeVTList(getValueTypeList(VT.getSimpleVT()), 1);
    }
    let mut VTs: [1]EVT = [VT];
    return self.getVTList(ArrayRef<EVT> { VTs });
}

fn SelectionDAG::getVTList(self, VT1: EVT, VT2: EVT) -> SDVTList {
    let mut VTs: [2]EVT = [VT1, VT2];
    return self.getVTList(ArrayRef<EVT> { VTs });
}

fn SelectionDAG::getVTList(self, VT1: EVT, VT2: EVT, VT3: EVT) -> SDVTList {
    let mut VTs: [3]EVT = [VT1, VT2, VT3];
    return self.getVTList(ArrayRef<EVT> { VTs });
}

fn SelectionDAG::getVTList(self, VT1: EVT, VT2: EVT, VT3: EVT, VT4: EVT) -> SDVTList {
    let mut VTs: [4]EVT = [VT1, VT2, VT3, VT4];
    return self.getVTList(ArrayRef<EVT> { VTs });
}

fn SelectionDAG::getVTList(self, VTs: ArrayRef<EVT>) -> SDVTList {
    let mut It: iterator = self.VTLists.find(VTs);
    if It == self.VTLists.end() {
        let mut Array: *mut EVT = self.Allocator.Allocate(VTs.len);
        copy(VTs, Array);
        It = self.VTLists.insert(EVT> { Array, VTs.len }).first;
    }
    return makeVTList(operator(It).ptr, operator(It).len);
}

fn SelectionDAG::UpdateNodeOperands(self, N: *mut SDNode, Op: SDValue) -> *mut SDNode {
    assert!(N.getNumOperands() == 1, "Update with wrong number of operands");
    if Op == N.getOperand(0) {
        return N;
    }
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.FindModifiedNodeSlot(N, Op, InsertToken) {
        Existing;
    } else {
        return Existing;
    }
    if InsertToken {
        if !self.RemoveNodeFromCSEMaps(N) {
            InsertToken = FoldingSetInsertToken {};
        }
    }
    N.OperandList[0].set(Op);
    self.updateDivergence(N);
    if InsertToken {
        self.CSEMap.insert(N, InsertToken);
    }
    return N;
}

fn SelectionDAG::UpdateNodeOperands(self, N: *mut SDNode, Op1: SDValue, Op2: SDValue) -> *mut SDNode {
    assert!(N.getNumOperands() == 2, "Update with wrong number of operands");
    if Op1 == N.getOperand(0) && Op2 == N.getOperand(1) {
        return N;
    }
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.FindModifiedNodeSlot(N, Op1, Op2, InsertToken) {
        Existing;
    } else {
        return Existing;
    }
    if InsertToken {
        if !self.RemoveNodeFromCSEMaps(N) {
            InsertToken = FoldingSetInsertToken {};
        }
    }
    if N.OperandList[0] != Op1 {
        N.OperandList[0].set(Op1);
    }
    if N.OperandList[1] != Op2 {
        N.OperandList[1].set(Op2);
    }
    self.updateDivergence(N);
    if InsertToken {
        self.CSEMap.insert(N, InsertToken);
    }
    return N;
}

fn SelectionDAG::UpdateNodeOperands(self, N: *mut SDNode, Op1: SDValue, Op2: SDValue, Op3: SDValue) -> *mut SDNode {
    let mut Ops: [3]SDValue = [Op1, Op2, Op3];
    return self.UpdateNodeOperands(N, ArrayRef<SDValue> { Ops });
}

fn SelectionDAG::UpdateNodeOperands(self, N: *mut SDNode, Op1: SDValue, Op2: SDValue, Op3: SDValue, Op4: SDValue) -> *mut SDNode {
    let mut Ops: [4]SDValue = [Op1, Op2, Op3, Op4];
    return self.UpdateNodeOperands(N, ArrayRef<SDValue> { Ops });
}

fn SelectionDAG::UpdateNodeOperands(self, N: *mut SDNode, Op1: SDValue, Op2: SDValue, Op3: SDValue, Op4: SDValue, Op5: SDValue) -> *mut SDNode {
    let mut Ops: [5]SDValue = [Op1, Op2, Op3, Op4, Op5];
    return self.UpdateNodeOperands(N, ArrayRef<SDValue> { Ops });
}

fn SelectionDAG::UpdateNodeOperands(self, N: *mut SDNode, Ops: ArrayRef<SDValue>) -> *mut SDNode {
    let mut NumOps: u32 = Ops.len;
    assert!(N.getNumOperands() == NumOps, "Update with wrong number of operands");
    if equal(Ops.begin(), Ops.end(), N.op_begin()) {
        return N;
    }
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.FindModifiedNodeSlot(N, ArrayRef<SDValue> { Ops }, InsertToken) {
        Existing;
    } else {
        return Existing;
    }
    if InsertToken {
        if !self.RemoveNodeFromCSEMaps(N) {
            InsertToken = FoldingSetInsertToken {};
        }
    }
    for let mut i: u32 = 0; i != NumOps; i += 1 {
        if N.OperandList[i] != Ops[i] {
            N.OperandList[i].set(Ops[i]);
        }
    }
    self.updateDivergence(N);
    if InsertToken {
        self.CSEMap.insert(N, InsertToken);
    }
    return N;
}

fn SDNode::DropOperands(self) {
    for let mut I: op_iterator = self.op_begin();
let mut E: op_iterator = self.op_end(); I != E;  {
        let mut Use: *mut SDUse = *I += 1;
        Use.set(SDValue {});
    }
}

fn SelectionDAG::setNodeMemRefs(self, N: *mut MachineSDNode, NewMemRefs: ArrayRef<MachineMemOperand *>) {
    if NewMemRefs.len == 0 {
        N.clearMemRefs();
        return;
    }
    if NewMemRefs.len == 1 {
        N.MemRefs = NewMemRefs[0];
        N.NumMemRefs = 1;
        return;
    }
    let mut MemRefsBuffer: *mut *mut MachineMemOperand = self.Allocator.Allocate(NewMemRefs.len);
    copy(NewMemRefs, MemRefsBuffer);
    N.MemRefs = MemRefsBuffer;
    N.NumMemRefs = NewMemRefs.len as i32;
}

