fn SelectionDAG::getDbgValueList(self, Var: *mut DIVariable, Expr: *mut DIExpression, Locs: ArrayRef<SDDbgOperand>, Dependencies: ArrayRef<SDNode *>, IsIndirect: bool, DL: *DebugLoc, O: u32, IsVariadic: bool) -> *mut SDDbgValue {
    assert!(cast(Var).isValidLocationForIntrinsic(DL.operator llvm::DILocation *()), "Expected inlined-at fields to agree");
