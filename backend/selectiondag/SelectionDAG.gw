fn SelectionDAG::SelectNodeTo(self, N: *mut SDNode, MachineOpc: u32, VT1: EVT, VT2: EVT, Op1: SDValue, Op2: SDValue) -> *mut SDNode {
    let mut VTs: SDVTList = self.getVTList(VT1, VT2);
    let mut Ops: [2]SDValue = [Op1, Op2];
    return self.SelectNodeTo(N, MachineOpc, VTs, ArrayRef<SDValue> { Ops });
}

fn SelectionDAG::SelectNodeTo(self, N: *mut SDNode, MachineOpc: u32, VTs: SDVTList, Ops: ArrayRef<SDValue>) -> *mut SDNode {
    let mut New: *mut SDNode = self.MorphNodeTo(N, ~MachineOpc, VTs, ArrayRef<SDValue> { Ops });
    New.setNodeId(-1);
    if New != N {
        self.ReplaceAllUsesWith(N, New);
        self.RemoveDeadNode(N);
    }
    return New;
}

fn SelectionDAG::UpdateSDLocOnMergeSDNode(self, N: *mut SDNode, OLoc: *SDLoc) -> *mut SDNode {
    let mut NLoc: DebugLoc = N.getDebugLoc();
    if NLoc && self.OptLevel == None && OLoc.getDebugLoc() != NLoc {
        N.setDebugLoc(DebugLoc { Loc: null });
    }
    let mut Order: u32 = if N.getIROrder() < OLoc.getIROrder() { N.getIROrder() } else { OLoc.getIROrder() };
    N.setIROrder(Order);
    return N;
}

fn SelectionDAG::MorphNodeTo(self, N: *mut SDNode, Opc: u32, VTs: SDVTList, Ops: ArrayRef<SDValue>) -> *mut SDNode {
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if VTs.VTs[VTs.NumVTs - 1] != EVT { Glue } {
        let mut ID: SDNodeKey = SDNodeKey { Opc, VTs, ArrayRef<SDValue> { Ops } };
        AddNodeIDCustom(ID.Tail, N, Opc);
        if self.lookupNode(ID, SDLoc { N }, InsertToken) {
            ON;
        } else {
            return self.UpdateSDLocOnMergeSDNode(ON, SDLoc { N });
        }
    }
    if !self.RemoveNodeFromCSEMaps(N) {
        InsertToken = FoldingSetInsertToken {};
    }
    N.NodeType = Opc;
    N.ValueList = VTs.VTs;
    N.NumValues = VTs.NumVTs;
    let mut DeadNodeSet: SmallPtrSet<SDNode *, 16> = SmallPtrSet<SDNode *, 16> {};
    for let mut I: op_iterator = N.op_begin();
let mut E: op_iterator = N.op_end(); I != E;  {
        let mut Use: *mut SDUse = *I += 1;
        let mut Used: *mut SDNode = Use.getNode();
        Use.set(SDValue {});
        if Used.use_empty() {
            DeadNodeSet.insert(Used);
        }
    }
    if dyn_cast(N) {
        MN;
    } else {
        MN.clearMemRefs();
    }
    self.removeOperands(N);
    self.createOperands(N, ArrayRef<SDValue> { Ops });
    if !DeadNodeSet.is_empty() {
        let mut DeadNodes: SmallVector<SDNode *, 16> = SmallVector<SDNode *, 16> {};
        for N in DeadNodeSet {
            if N.use_empty() {
                DeadNodes.push(N);
            }
        }
        self.RemoveDeadNodes(DeadNodes);
    }
    if InsertToken {
        self.CSEMap.insert(N, InsertToken);
    }
    return N;
}

fn SelectionDAG::mutateStrictFPToFP(self, Node: *mut SDNode) -> *mut SDNode {
    let mut OrigOpc: u32 = Node.getOpcode();
    let mut NewOpc: u32 = 0;
    match OrigOpc {
        _ => {
            llvm_unreachable_internal("mutateStrictFPToFP called with unexpected opcode!", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAG.cpp", 12591);
        },
        STRICT_FADD => {
            NewOpc = FADD;
        },
        STRICT_FSUB => {
            NewOpc = FSUB;
        },
        STRICT_FMUL => {
            NewOpc = FMUL;
        },
        STRICT_FDIV => {
            NewOpc = FDIV;
        },
        STRICT_FREM => {
            NewOpc = FREM;
        },
        STRICT_FP_EXTEND => {
            NewOpc = FP_EXTEND;
        },
        STRICT_SINT_TO_FP => {
            NewOpc = SINT_TO_FP;
        },
        STRICT_UINT_TO_FP => {
            NewOpc = UINT_TO_FP;
        },
        STRICT_FP_TO_SINT => {
            NewOpc = FP_TO_SINT;
        },
        STRICT_FP_TO_UINT => {
            NewOpc = FP_TO_UINT;
        },
        STRICT_FP_ROUND => {
            NewOpc = FP_ROUND;
        },
        STRICT_FSETCC => {
            NewOpc = SETCC;
        },
        STRICT_FSETCCS => {
            NewOpc = SETCC;
        },
        STRICT_FACOS => {
            NewOpc = FACOS;
        },
        STRICT_FASIN => {
            NewOpc = FASIN;
        },
        STRICT_FATAN => {
            NewOpc = FATAN;
        },
        STRICT_FATAN2 => {
            NewOpc = FATAN2;
        },
        STRICT_FCEIL => {
            NewOpc = FCEIL;
        },
        STRICT_FCOS => {
            NewOpc = FCOS;
        },
        STRICT_FCOSH => {
            NewOpc = FCOSH;
        },
        STRICT_FEXP => {
            NewOpc = FEXP;
        },
        STRICT_FEXP2 => {
            NewOpc = FEXP2;
        },
        STRICT_FFLOOR => {
            NewOpc = FFLOOR;
        },
        STRICT_FMA => {
            NewOpc = FMA;
        },
        STRICT_FLOG => {
            NewOpc = FLOG;
        },
        STRICT_FLOG10 => {
            NewOpc = FLOG10;
        },
        STRICT_FLOG2 => {
            NewOpc = FLOG2;
        },
        STRICT_LRINT => {
            NewOpc = LRINT;
        },
        STRICT_LLRINT => {
            NewOpc = LLRINT;
        },
        STRICT_LROUND => {
            NewOpc = LROUND;
        },
        STRICT_LLROUND => {
            NewOpc = LLROUND;
        },
        STRICT_FMAXNUM => {
            NewOpc = FMAXNUM;
        },
        STRICT_FMINNUM => {
            NewOpc = FMINNUM;
        },
        STRICT_FMAXIMUM => {
            NewOpc = FMAXIMUM;
        },
        STRICT_FMINIMUM => {
            NewOpc = FMINIMUM;
        },
        STRICT_FNEARBYINT => {
            NewOpc = FNEARBYINT;
        },
        STRICT_FPOW => {
            NewOpc = FPOW;
        },
        STRICT_FPOWI => {
            NewOpc = FPOWI;
        },
        STRICT_FLDEXP => {
            NewOpc = FLDEXP;
        },
        STRICT_FRINT => {
            NewOpc = FRINT;
        },
        STRICT_FROUND => {
            NewOpc = FROUND;
        },
        STRICT_FROUNDEVEN => {
            NewOpc = FROUNDEVEN;
        },
        STRICT_FSIN => {
            NewOpc = FSIN;
        },
        STRICT_FSINH => {
            NewOpc = FSINH;
        },
        STRICT_FSQRT => {
            NewOpc = FSQRT;
        },
        STRICT_FTAN => {
            NewOpc = FTAN;
        },
        STRICT_FTANH => {
            NewOpc = FTANH;
        },
        STRICT_FTRUNC => {
            NewOpc = FTRUNC;
        },
    }
    assert!(Node.getNumValues() == 2, "Unexpected number of results!");
    let mut InputChain: SDValue = Node.getOperand(0);
    let mut OutputChain: SDValue = SDValue { Node: Node, ResNo: 1 };
    self.ReplaceAllUsesOfValueWith(OutputChain, InputChain);
    let mut Ops: SmallVector<SDValue, 3> = SmallVector<SDValue, 3> {};
    for let mut i: u32 = 1;
let mut e: u32 = Node.getNumOperands(); i != e; i += 1 {
        Ops.push(ValueParamT { Node.getOperand(i) });
    }
    let mut VTs: SDVTList = self.getVTList(Node.getValueType(0));
    let mut Res: *mut SDNode = self.MorphNodeTo(Node, NewOpc, VTs, ArrayRef<SDValue> { Ops });
    if Res == Node {
        Res.setNodeId(-1);
    } else {
        self.ReplaceAllUsesWith(Node, Res);
        self.RemoveDeadNode(Node);
    }
    return Res;
}

fn SelectionDAG::getMachineNode(self, Opcode: u32, dl: *SDLoc, VT: EVT) -> *mut MachineSDNode {
    let mut VTs: SDVTList = self.getVTList(VT);
    return self.getMachineNode(Opcode, dl, VTs, ArrayRef<SDValue> {});
}

fn SelectionDAG::getMachineNode(self, Opcode: u32, dl: *SDLoc, VT: EVT, Op1: SDValue) -> *mut MachineSDNode {
    let mut VTs: SDVTList = self.getVTList(VT);
    let mut Ops: [1]SDValue = [Op1];
    return self.getMachineNode(Opcode, dl, VTs, ArrayRef<SDValue> { Ops });
}

