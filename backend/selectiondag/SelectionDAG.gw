struct Closure_10 {}

fn Closure_10::call(self: *Closure_10, Not: SDValue, Mask: SDValue, Other: SDValue) -> bool {
        if getBitwiseNotOperand(Not, Mask, true) {
            NotOperand;
        } else {
            if operator(NotOperand).getOpcode() == ZERO_EXTEND || operator(NotOperand).getOpcode() == TRUNCATE {
                NotOperand = operator(NotOperand).getOperand(0);
            }
            if Other == NotOperand {
                return true;
            }
            if operator(Other).getOpcode() == AND {
                return NotOperand == operator(Other).getOperand(0) || NotOperand == operator(Other).getOperand(1);
            }
        }
        return false;
    }

