    let mut ID: SDNodeKey = SDNodeKey { MDNODE_SDNODE, self.getVTList(EVT { Other }), ArrayRef<SDValue> {} };
    ID.AddPointer(MD);
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
