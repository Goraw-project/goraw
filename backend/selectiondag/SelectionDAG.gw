    assert!(cast(Var).isValidLocationForIntrinsic(DL.operator llvm::DILocation *()), "Expected inlined-at fields to agree");
    return SDDbgValue { self.DbgInfo.getAlloc(), Var, Expr, ArrayRef<SDDbgOperand> { fromConst(C) }, ArrayRef<SDNode *> {}, false, DL, O, false };
}

