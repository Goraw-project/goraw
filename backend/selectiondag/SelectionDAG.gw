// Внешние системные функции libc
extern fn abort();

fn makeVTList(VTs: *EVT, NumVTs: u32) -> SDVTList {
    let mut Res: SDVTList = SDVTList { VTs: VTs, NumVTs: NumVTs };
    return Res;
}

fn DAGUpdateListener@SelectionDAG@llvm::NodeDeleted(self, arg: *mut SDNode, arg: *mut SDNode) {}

fn DAGUpdateListener@SelectionDAG@llvm::NodeUpdated(self, arg: *mut SDNode) {}

fn DAGUpdateListener@SelectionDAG@llvm::NodeInserted(self, arg: *mut SDNode) {}

fn DAGNodeDeletedListener@SelectionDAG@llvm::anchor(self) {}

fn DAGNodeInsertedListener@SelectionDAG@llvm::anchor(self) {}

static mut EnableMemCpyDAGOpt: opt<bool> = opt<bool> { "enable-memcpy-dag-opt", Hidden, init(true), desc { Desc: "Gang up loads and stores generated by inlining of memcpy" } };

static mut MaxLdStGlue: opt<int> = opt<int> { "ldstmemcpy-glue-max", desc { Desc: "Number limit for gluing ld/st of memcpy." }, Hidden, init(0) };

static mut MaxSteps: opt<unsigned int> = opt<unsigned int> { "has-predecessor-max-steps", Hidden, init(8192), desc { Desc: "DAG combiner limit number of steps when searching DAG for predecessor nodes" } };

static mut VScaleUnrollLimit: opt<int> = opt<int> { "vscale-unroll-limit", desc { Desc: "Maximum vscale for which vector unrolling is allowed." }, Hidden, init(64) };

fn NewSDValueDbgMsg(V: SDValue, Msg: str, G: *mut SelectionDAG) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("selectiondag", 1) {
            dbgs() << Msg;
            V.getNode().dump(G);
        }
    }
        if !(false) { break; }
    }
}

fn SelectionDAG::getHasPredecessorMaxSteps(self) -> u32 {
    return MaxSteps.operator unsigned int();
}

fn ConstantFPSDNode::isExactlyValue(self: *ConstantFPSDNode, V: *APFloat) -> bool {
    return self.getValueAPF().bitwiseIsEqual(V);
}

fn ConstantFPSDNode::isValueValidForType(self, VT: EVT, Val: *APFloat) -> bool {
    assert!(VT.isFloatingPoint(), "Can only convert between FP types");
    let mut Val2: APFloat = Val;
    let mut losesInfo: bool = false;
    Val2.convert(VT.getFltSemantics(), rmNearestTiesToEven, &mut losesInfo) as void;
    return !losesInfo;
}

fn isConstantSplatVector(N: *SDNode, SplatVal: *mut APInt) -> bool {
    if N.getOpcode() == SPLAT_VECTOR {
        if operator(N.getOperand(0)).bitcastToAPInt() {
            OptAPInt;
        } else {
            let mut EltSize: u32 = N.getValueType(0).getVectorElementType().getSizeInBits().operator unsigned long long();
            SplatVal = operator(OptAPInt).trunc(EltSize);
            return true;
        }
    }
    let mut BV: *BuildVectorSDNode = dyn_cast(N);
    if !BV {
        return false;
    }
    let mut SplatUndef: APInt = APInt {};
    let mut SplatBitSize: u32 = 0;
    let mut HasUndefs: bool = false;
    let mut EltSize: u32 = N.getValueType(0).getVectorElementType().getSizeInBits().operator unsigned long long();
    let mut IsBigEndian: bool = false;
    return BV.isConstantSplat(SplatVal, SplatUndef, SplatBitSize, HasUndefs, EltSize, IsBigEndian) && EltSize == SplatBitSize;
}

fn isConstantSplatVectorAllOnes(N: *SDNode, BuildVectorOnly: bool) -> bool {
    while N.getOpcode() == BITCAST {
        N = N.getOperand(0).getNode();
    }
    if !BuildVectorOnly && N.getOpcode() == SPLAT_VECTOR {
        let mut SplatVal: APInt = APInt {};
        return isConstantSplatVector(N, SplatVal) && SplatVal.isAllOnes();
    }
    if N.getOpcode() != BUILD_VECTOR {
        return false;
    }
    let mut i: u32 = 0;
    let mut e: u32 = N.getNumOperands();
    while i != e && N.getOperand(i).isUndef() {
        i += 1;
    }
    if i == e {
        return false;
    }
    let mut NotZero: SDValue = N.getOperand(i);
    if operator(NotZero).bitcastToAPInt() {
        OptAPInt;
    } else {
        let mut EltSize: u32 = N.getValueType(0).getScalarSizeInBits();
        if operator(OptAPInt).countr_one() < EltSize {
            return false;
        }
    }
    for i += 1; i != e; i += 1 {
        if N.getOperand(i) != NotZero && !N.getOperand(i).isUndef() {
            return false;
        }
    }
    return true;
}

fn isConstantSplatVectorAllZeros(N: *SDNode, BuildVectorOnly: bool) -> bool {
    while N.getOpcode() == BITCAST {
        N = N.getOperand(0).getNode();
    }
    if !BuildVectorOnly && N.getOpcode() == SPLAT_VECTOR {
        let mut SplatVal: APInt = APInt {};
        return isConstantSplatVector(N, SplatVal) && SplatVal.isZero();
    }
    if N.getOpcode() != BUILD_VECTOR {
        return false;
    }
    let mut IsAllUndef: bool = true;
    for Op in N.op_values() {
        if Op.isUndef() {
            continue;
        }
        IsAllUndef = false;
        if operator(Op).bitcastToAPInt() {
            OptAPInt;
        } else {
            let mut EltSize: u32 = N.getValueType(0).getScalarSizeInBits();
            if operator(OptAPInt).countr_zero() < EltSize {
                return false;
            }
        }
    }
    if IsAllUndef {
        return false;
    }
    return true;
}

fn isBuildVectorAllOnes(N: *SDNode) -> bool {
    return isConstantSplatVectorAllOnes(N, true);
}

fn isBuildVectorAllZeros(N: *SDNode) -> bool {
    return isConstantSplatVectorAllZeros(N, true);
}

fn isBuildVectorOfConstantSDNodes(N: *SDNode) -> bool {
    if N.getOpcode() != BUILD_VECTOR {
        return false;
    }
    for Op in N.op_values() {
        if Op.isUndef() {
            continue;
        }
        if !isa(Op) {
            return false;
        }
    }
    return true;
}

fn isBuildVectorOfConstantFPSDNodes(N: *SDNode) -> bool {
    if N.getOpcode() != BUILD_VECTOR {
        return false;
    }
    for Op in N.op_values() {
        if Op.isUndef() {
            continue;
        }
        if !isa(Op) {
            return false;
        }
    }
    return true;
}

fn isVectorShrinkable(N: *SDNode, NewEltSize: u32, Signed: bool) -> bool {
    assert!(N.getValueType(0).isVector(), "Expected a vector!");
    let mut EltSize: u32 = N.getValueType(0).getScalarSizeInBits();
    if EltSize <= NewEltSize {
        return false;
    }
    if N.getOpcode() == ZERO_EXTEND {
        return (N.getOperand(0).getValueType().getScalarSizeInBits() <= NewEltSize) && !Signed;
    }
    if N.getOpcode() == SIGN_EXTEND {
        return (N.getOperand(0).getValueType().getScalarSizeInBits() <= NewEltSize) && Signed;
    }
    if N.getOpcode() != BUILD_VECTOR {
        return false;
    }
    for Op in N.op_values() {
        if Op.isUndef() {
            continue;
        }
        if !isa(Op) {
            return false;
        }
        let mut C: APInt = operator(Op).getAsAPIntVal().trunc(EltSize);
        if Signed && C.trunc(NewEltSize).sext(EltSize) != C {
            return false;
        }
        if !Signed && C.trunc(NewEltSize).zext(EltSize) != C {
            return false;
        }
    }
    return true;
}

fn allOperandsUndef(N: *SDNode) -> bool {
    if N.getNumOperands() == 0 {
        return false;
    }
    return all_of(N.op_values(), Closure_1 {});
}

fn isFreezeUndef(N: *SDNode) -> bool {
    return N.getOpcode() == FREEZE && N.getOperand(0).isUndef();
}

// ========================================================
// [C++ Template - Неинстанциированный шаблон функции: matchUnaryPredicateImpl]
// template <typename ConstNodeType>
// fn matchUnaryPredicateImpl(...);
// ========================================================

fn matchBinaryPredicate(LHS: SDValue, RHS: SDValue, DemandedElts: *APInt, Match: function<bool (ConstantSDNode *, ConstantSDNode *)>, AllowUndefs: bool, AllowTypeMismatch: bool) -> bool {
    if !AllowTypeMismatch && LHS.getValueType() != RHS.getValueType() {
        return false;
    }
    if dyn_cast(LHS) {
        LHSCst;
    } else if dyn_cast(RHS) {
        RHSCst;
    } else {
        return Match.call(LHSCst, RHSCst);
    }
    if LHS.getOpcode() != RHS.getOpcode() || (LHS.getOpcode() != BUILD_VECTOR && LHS.getOpcode() != SPLAT_VECTOR) {
        return false;
    }
    if SPLAT_VECTOR == LHS.getOpcode() && operator(DemandedElts) {
        return true;
    }
    let mut SVT: EVT = LHS.getValueType().getScalarType();
    for let mut i: u32 = 0;
let mut e: u32 = LHS.getNumOperands(); i != e; i += 1 {
        if SPLAT_VECTOR != LHS.getOpcode() && !DemandedElts[i] {
            continue;
        }
        let mut LHSOp: SDValue = LHS.getOperand(i);
        let mut RHSOp: SDValue = RHS.getOperand(i);
        let mut LHSUndef: bool = AllowUndefs && LHSOp.isUndef();
        let mut RHSUndef: bool = AllowUndefs && RHSOp.isUndef();
        let mut LHSCst: *mut ConstantSDNode = dyn_cast(LHSOp);
        let mut RHSCst: *mut ConstantSDNode = dyn_cast(RHSOp);
        if (!LHSCst && !LHSUndef) || (!RHSCst && !RHSUndef) {
            return false;
        }
        if !AllowTypeMismatch && (LHSOp.getValueType() != SVT || LHSOp.getValueType() != RHSOp.getValueType()) {
            return false;
        }
        if !Match.call(LHSCst, RHSCst) {
            return false;
        }
    }
    return true;
}

fn getInverseMinMaxOpcode(MinMaxOpc: u32) -> NodeType {
    match MinMaxOpc {
        _ => {
            llvm_unreachable_internal("unrecognized opcode", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAG.cpp", 443);
        },
        UMIN => {
            return UMAX;
        },
        UMAX => {
            return UMIN;
        },
        SMIN => {
            return SMAX;
        },
        SMAX => {
            return SMIN;
        },
    }
}

fn getOppositeSignednessMinMaxOpcode(MinMaxOpc: u32) -> NodeType {
    match MinMaxOpc {
        _ => {
            llvm_unreachable_internal("unrecognized min/max opcode", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAG.cpp", 458);
        },
        SMIN => {
            return UMIN;
        },
        SMAX => {
            return UMAX;
        },
        UMIN => {
            return SMIN;
        },
        UMAX => {
            return SMAX;
        },
    }
}

fn getVecReduceBaseOpcode(VecReduceOpcode: u32) -> NodeType {
    match VecReduceOpcode {
        _ => {
            llvm_unreachable_internal("Expected VECREDUCE opcode", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAG.cpp", 473);
        },
        VECREDUCE_FADD => {
            VECREDUCE_SEQ_FADD;
        },
        VECREDUCE_FMUL => {
            VECREDUCE_SEQ_FMUL;
        },
        VECREDUCE_ADD => {
            VP_REDUCE_ADD;
        },
        VECREDUCE_MUL => {
            VP_REDUCE_MUL;
        },
        VECREDUCE_AND => {
            VP_REDUCE_AND;
        },
        VECREDUCE_OR => {
            VP_REDUCE_OR;
        },
        VECREDUCE_XOR => {
            VP_REDUCE_XOR;
        },
        VECREDUCE_SMAX => {
            VP_REDUCE_SMAX;
        },
        VECREDUCE_SMIN => {
            VP_REDUCE_SMIN;
        },
        VECREDUCE_UMAX => {
            VP_REDUCE_UMAX;
        },
        VECREDUCE_UMIN => {
            VP_REDUCE_UMIN;
        },
        VECREDUCE_FMAX => {
            VP_REDUCE_FMAX;
        },
        VECREDUCE_FMIN => {
            VP_REDUCE_FMIN;
        },
        VECREDUCE_FMAXIMUM => {
            VP_REDUCE_FMAXIMUM;
        },
        VECREDUCE_FMINIMUM => {
            VP_REDUCE_FMINIMUM;
        },
        VECREDUCE_FMAXIMUMNUM => {
            return FMAXIMUMNUM;
        },
        VECREDUCE_FMINIMUMNUM => {
            return FMINIMUMNUM;
        },
    }
}

fn getUnmaskedBinOpOpcode(MaskedOpc: u32) -> NodeType {
    match MaskedOpc {
        MASKED_UDIV => {
            return UDIV;
        },
        MASKED_SDIV => {
            return SDIV;
        },
        MASKED_UREM => {
            return UREM;
        },
        MASKED_SREM => {
            return SREM;
        },
        _ => {
            llvm_unreachable_internal("Expected masked binop opcode", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAG.cpp", 541);
        },
    }
}

