    return V;
}

fn SelectionDAG::getIndexedMaskedStore(self, OrigStore: SDValue, dl: *SDLoc, Base: SDValue, Offset: SDValue, AM: MemIndexedMode) -> SDValue {
    let mut ST: *mut MaskedStoreSDNode = cast(OrigStore);
    assert!(ST.getOffset().getOpcode() == POISON, "Masked store is already a indexed store!");
    return self.getMaskedStore(ST.getChain(), dl, ST.getValue(), Base, Offset, ST.getMask(), ST.getMemoryVT(), ST.getMemOperand(), AM, ST.isTruncatingStore(), ST.isCompressingStore());
}

