unsafe fn Closure_26::call(self: *mut Closure_26, Op: SDValue, NumSubElts: u32) -> SDValue {
        if !(*self.AllowPartials) || !Op {
            return SDValue {};
        }
        let mut OpVT: EVT = Op.getValueType();
        let mut OpSVT: EVT = OpVT.getScalarType();
        let mut SubVT: EVT = getVectorVT(*self.getContext(), OpSVT, NumSubElts, false);
        if self.TLI.getExtractSubvectorCost(SubVT, OpVT, 0) > Cheap {
            return SDValue {};
        }
        (*self.BinOp) = (*self.CandidateBinOp) as NodeType;
        return self.getExtractSubvector(SDLoc { Op }, SubVT, Op, 0);
    }

struct Closure_27 {
    Leafs: *mut SmallVector<const SDNode *>,
    FromReach: *mut DenseSet<const SDNode *>,
}

unsafe fn Closure_27::call(self: *mut Closure_27) {
        if MaxDepth == 0 {
            (*self.Leafs).emplace_back(N);
            return;
        }
        if !(*self.FromReach).insert(N).second {
            return;
        }
        for Op in N.op_values() {
            Self(Self, Op.getNode(), MaxDepth - 1);
        }
    }

struct Closure_28 {
    FromReach: *mut DenseSet<const SDNode *>,
    Visited: *mut SmallPtrSet<const SDNode *, 8>,
    EntrySDN: *mut *SDNode,
    To: *mut *mut SDNode,
    cap_4: *mut SelectionDAG,
    NEI: *mut NodeExtraInfo,
}

unsafe fn Closure_28::call(self: *mut Closure_28) {
        if (*self.FromReach).contains(N) {
            return true;
        }
        if !(*self.Visited).insert(N).second {
            return true;
        }
        if (*self.EntrySDN) == N {
            return false;
        }
        for Op in N.op_values() {
            if N == (*self.To) && Op.getNode() == (*self.EntrySDN) {
                break;
            }
            if operator!(Self(Self, Op.getNode())) {
                return false;
            }
        }
        self.SDEI[N] = move((*self.NEI));
        return true;
    }
