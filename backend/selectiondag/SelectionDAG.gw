fn getExtForLoadExtType(IsFP: bool, ExtType: LoadExtType) -> NodeType {
    match ExtType {
        EXTLOAD => {
            return if IsFP { FP_EXTEND } else { ANY_EXTEND };
        },
        SEXTLOAD => {
            return SIGN_EXTEND;
        },
        ZEXTLOAD => {
            return ZERO_EXTEND;
        },
        _ => {
            break;
        },
    }
    llvm_unreachable_internal("Invalid LoadExtType", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAG.cpp", 654);
}

fn getSetCCSwappedOperands(Operation: CondCode) -> CondCode {
    let mut OldL: u32 = (Operation >> 2) & 1;
    let mut OldG: u32 = (Operation >> 1) & 1;
    return (Operation & ~6) | (OldL << 1) | (OldG << 2);
}

fn getSetCCInverseImpl(Op: CondCode, isIntegerLike: bool) -> CondCode {
    let mut Operation: u32 = Op;
    if isIntegerLike {
        Operation ^= 7;
    } else {
        Operation ^= 15;
    }
    if Operation > SETTRUE2 {
        Operation &= ~8;
    }
    return Operation;
}

fn getSetCCInverse(Op: CondCode, Type: EVT) -> CondCode {
    return getSetCCInverseImpl(Op, Type.isInteger());
}

fn getSetCCInverse(Op: CondCode, isIntegerLike: bool) -> CondCode {
    return getSetCCInverseImpl(Op, isIntegerLike);
}

fn isSignedOp(Opcode: CondCode) -> i32 {
    match Opcode {
        _ => {
            llvm_unreachable_internal("Illegal integer setcc operation!", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAG.cpp", 694);
        },
        SETEQ => {
            SETNE;
        },
        SETLT => {
            SETLE;
        },
        SETULT => {
            SETULE;
        },
    }
}

fn getSetCCOrOperation(Op1: CondCode, Op2: CondCode, Type: EVT) -> CondCode {
    let mut IsInteger: bool = Type.isInteger();
    if IsInteger && (isSignedOp(Op1) | isSignedOp(Op2)) == 3 {
        return SETCC_INVALID;
    }
    let mut Op: u32 = Op1 | Op2;
    if Op > SETTRUE2 {
        Op &= ~16;
    }
    if IsInteger && Op == SETUNE {
        Op = SETNE;
    }
    return Op;
}

fn getSetCCAndOperation(Op1: CondCode, Op2: CondCode, Type: EVT) -> CondCode {
    let mut IsInteger: bool = Type.isInteger();
    if IsInteger && (isSignedOp(Op1) | isSignedOp(Op2)) == 3 {
        return SETCC_INVALID;
    }
    let mut Result: CondCode = Op1 & Op2;
    if IsInteger {
        match Result {
            _ => {
                break;
            },
            SETUO => {
                Result = SETFALSE;
            },
            SETOEQ => {
                SETUEQ;
            },
            SETOLT => {
                Result = SETULT;
            },
            SETOGT => {
                Result = SETUGT;
            },
        }
    }
    return Result;
}

fn AddNodeIDCustom(ID: *mut FoldingSetNodeID, N: *SDNode, Opc: u32) {
    if isMachineOpcode(Opc) {
        return;
    }
    match Opc {
        TargetExternalSymbol => {
            ExternalSymbol;
        },
        _ => {
            break;
        },
        TargetConstant => {
            Constant;
        },
        TargetConstantFP => {
            ConstantFP;
        },
        TargetGlobalAddress => {
            GlobalAddress;
        },
        BasicBlock => {
            ID.AddPointer(cast(N).getBasicBlock());
        },
        EH_LABEL => {
            ANNOTATION_LABEL;
        },
        DEACTIVATION_SYMBOL => {
            ID.AddPointer(cast(N).getGlobal());
        },
        Register => {
            ID.AddInteger(cast(N).getReg().id());
        },
        RegisterMask => {
            ID.AddPointer(cast(N).getRegMask());
        },
        SRCVALUE => {
            ID.AddPointer(cast(N).getValue());
        },
        FrameIndex => {
            TargetFrameIndex;
        },
        PSEUDO_PROBE => {
            ID.AddInteger(cast(N).getGuid());
        },
        JumpTable => {
            TargetJumpTable;
        },
        ConstantPool => {
            TargetConstantPool;
        },
        TargetIndex => {
            let mut TI: *TargetIndexSDNode = cast(N);
            ID.AddInteger(TI.getIndex());
            ID.AddInteger(TI.getOffset());
            ID.AddInteger(TI.getTargetFlags());
            break;
        },
        LOAD => {
            let mut LD: *LoadSDNode = cast(N);
            ID.AddInteger(LD.getMemoryVT().getRawBits());
            ID.AddInteger(LD.getRawSubclassData());
            ID.AddInteger(LD.getPointerInfo().getAddrSpace());
            ID.AddInteger(LD.getMemOperand().getFlags());
            break;
        },
        STORE => {
            let mut ST: *StoreSDNode = cast(N);
            ID.AddInteger(ST.getMemoryVT().getRawBits());
            ID.AddInteger(ST.getRawSubclassData());
            ID.AddInteger(ST.getPointerInfo().getAddrSpace());
            ID.AddInteger(ST.getMemOperand().getFlags());
            break;
        },
        VP_LOAD => {
            let mut ELD: *VPLoadSDNode = cast(N);
            ID.AddInteger(ELD.getMemoryVT().getRawBits());
            ID.AddInteger(ELD.getRawSubclassData());
            ID.AddInteger(ELD.getPointerInfo().getAddrSpace());
            ID.AddInteger(ELD.getMemOperand().getFlags());
            break;
        },
        VP_LOAD_FF => {
            let mut LD: *VPLoadFFSDNode const = cast(N);
            ID.AddInteger(LD.getMemoryVT().getRawBits());
            ID.AddInteger(LD.getRawSubclassData());
            ID.AddInteger(LD.getPointerInfo().getAddrSpace());
            ID.AddInteger(LD.getMemOperand().getFlags());
            break;
        },
        VP_STORE => {
            let mut EST: *VPStoreSDNode = cast(N);
            ID.AddInteger(EST.getMemoryVT().getRawBits());
            ID.AddInteger(EST.getRawSubclassData());
            ID.AddInteger(EST.getPointerInfo().getAddrSpace());
            ID.AddInteger(EST.getMemOperand().getFlags());
            break;
        },
        EXPERIMENTAL_VP_STRIDED_LOAD => {
            let mut SLD: *VPStridedLoadSDNode = cast(N);
            ID.AddInteger(SLD.getMemoryVT().getRawBits());
            ID.AddInteger(SLD.getRawSubclassData());
            ID.AddInteger(SLD.getPointerInfo().getAddrSpace());
            break;
        },
        EXPERIMENTAL_VP_STRIDED_STORE => {
            let mut SST: *VPStridedStoreSDNode = cast(N);
            ID.AddInteger(SST.getMemoryVT().getRawBits());
            ID.AddInteger(SST.getRawSubclassData());
            ID.AddInteger(SST.getPointerInfo().getAddrSpace());
            break;
        },
        VP_GATHER => {
            let mut EG: *VPGatherSDNode = cast(N);
            ID.AddInteger(EG.getMemoryVT().getRawBits());
            ID.AddInteger(EG.getRawSubclassData());
            ID.AddInteger(EG.getPointerInfo().getAddrSpace());
            ID.AddInteger(EG.getMemOperand().getFlags());
            break;
        },
        VP_SCATTER => {
            let mut ES: *VPScatterSDNode = cast(N);
            ID.AddInteger(ES.getMemoryVT().getRawBits());
            ID.AddInteger(ES.getRawSubclassData());
            ID.AddInteger(ES.getPointerInfo().getAddrSpace());
            ID.AddInteger(ES.getMemOperand().getFlags());
            break;
        },
        MLOAD => {
            let mut MLD: *MaskedLoadSDNode = cast(N);
            ID.AddInteger(MLD.getMemoryVT().getRawBits());
            ID.AddInteger(MLD.getRawSubclassData());
            ID.AddInteger(MLD.getPointerInfo().getAddrSpace());
            ID.AddInteger(MLD.getMemOperand().getFlags());
            break;
        },
        MSTORE => {
            let mut MST: *MaskedStoreSDNode = cast(N);
            ID.AddInteger(MST.getMemoryVT().getRawBits());
            ID.AddInteger(MST.getRawSubclassData());
            ID.AddInteger(MST.getPointerInfo().getAddrSpace());
            ID.AddInteger(MST.getMemOperand().getFlags());
            break;
        },
        MGATHER => {
            let mut MG: *MaskedGatherSDNode = cast(N);
            ID.AddInteger(MG.getMemoryVT().getRawBits());
            ID.AddInteger(MG.getRawSubclassData());
            ID.AddInteger(MG.getPointerInfo().getAddrSpace());
            ID.AddInteger(MG.getMemOperand().getFlags());
            break;
        },
        MSCATTER => {
            GET_FPENV_MEM;
        },
        VECTOR_SHUFFLE => {
            let mut Mask: ArrayRef<int> = cast(N).getMask();
            for M in Mask {
                ID.AddInteger(M);
            }
            break;
        },
        ADDRSPACECAST => {
            let mut ASC: *AddrSpaceCastSDNode = cast(N);
            ID.AddInteger(ASC.getSrcAddressSpace());
            ID.AddInteger(ASC.getDestAddressSpace());
            break;
        },
        TargetBlockAddress => {
            BlockAddress;
        },
        AssertAlign => {
            ID.AddInteger(cast(N).getAlign().value());
        },
        PREFETCH => {
            INTRINSIC_VOID;
        },
        MDNODE_SDNODE => {
            ID.AddPointer(cast(N).getMD());
        },
    }
    if dyn_cast(N) {
        AT;
    } else {
        ID.AddInteger(AT.getMemoryVT().getRawBits());
        ID.AddInteger(AT.getRawSubclassData());
        ID.AddInteger(AT.getPointerInfo().getAddrSpace());
        ID.AddInteger(AT.getMemOperand().getFlags());
    }
    if dyn_cast(N) {
        MN;
    } else {
        ID.AddInteger(MN.getRawSubclassData());
        ID.AddInteger(MN.getMemoryVT().getRawBits());
        for MMO in MN.memoperands() {
            ID.AddInteger(MMO.getPointerInfo().getAddrSpace());
            ID.AddInteger(MMO.getFlags());
        }
    }
}

fn SDNodeKey::SDNodeKey(self, N: *SDNode) {
    self.Ops = SDValue> { self.OpStorage };
    AddNodeIDCustom(self.Tail, &mut N, N.getOpcode());
}

fn AddNodeIDNode(ID: *mut FoldingSetNodeID, N: *SDNode) {
    ID.AddInteger(N.getOpcode());
    ID.AddPointer(N.getVTList().VTs);
    for Op in N.ops() {
        ID.AddPointer(Op.getNode());
        ID.AddInteger(Op.getResNo());
    }
    AddNodeIDCustom(ID, N, N.getOpcode());
}

fn AddNodeIDNode(ID: *mut FoldingSetNodeID, Key: *SDNodeKey) {
    ID.AddInteger(Key.Opcode);
    ID.AddPointer(Key.VTs);
    for Op in Key.Ops {
        ID.AddPointer(Op.getNode());
        ID.AddInteger(Op.getResNo());
    }
    ID.AddNodeID(Key.Tail);
}

fn keyMatches(Key: *SDNodeKey, N: *SDNode) -> bool {
    if N.getOpcode() != Key.Opcode || N.getVTList().VTs != Key.VTs {
        return false;
    }
    if !equal(N.ops(), Key.Ops) {
        return false;
    }
    let mut Tail: FoldingSetNodeID = FoldingSetNodeID {};
    AddNodeIDCustom(Tail, &mut N, N.getOpcode());
    return Tail.operator FoldingSetNodeIDRef() == Key.Tail.operator FoldingSetNodeIDRef();
}

fn SDNodeKeyInfo::isEqual(self, Key: *SDNodeKey, N: *SDNode) -> bool {
    let mut Result: bool = keyMatches(Key, N);
    let mut NodeProfile: FoldingSetNodeID = FoldingSetNodeID {};
    let mut KeyProfile: FoldingSetNodeID = FoldingSetNodeID {};
    AddNodeIDNode(NodeProfile, &mut N);
    AddNodeIDNode(KeyProfile, Key);
    assert!((NodeProfile.operator FoldingSetNodeIDRef() == KeyProfile.operator FoldingSetNodeIDRef()) == Result, "SDNodeKey equality disagrees with profile");
    return Result;
}

fn doNotCSE(N: *mut SDNode) -> bool {
    if N.getValueType(0) == EVT { Glue } {
        return true;
    }
    match N.getOpcode() {
        _ => {
            break;
        },
        HANDLENODE => {
            EH_LABEL;
        },
    }
    for let mut i: u32 = 1;
let mut e: u32 = N.getNumValues(); i != e; i += 1 {
        if N.getValueType(i) == EVT { Glue } {
            return true;
        }
    }
    return false;
}

fn getDemandAllEltsMask(V: SDValue) -> APInt {
    let mut VT: EVT = V.getValueType();
    return if VT.isFixedLengthVector() { getAllOnes(VT.getVectorNumElements()) } else { APInt { 1, 1, false, false } };
}

fn SelectionDAG::RemoveDeadNodes(self) {
    let mut Dummy: HandleSDNode = HandleSDNode { self.getRoot() };
    let mut DeadNodes: SmallVector<SDNode *, 128> = SmallVector<SDNode *, 128> {};
    for Node in self.allnodes() {
        if Node.use_empty() {
            DeadNodes.push(&mut Node);
        }
    }
    self.RemoveDeadNodes(DeadNodes);
    self.setRoot(Dummy.getValue());
}

fn SelectionDAG::RemoveDeadNodes(self, DeadNodes: *mut SmallVectorImpl<SDNode *>) {
    while !DeadNodes.is_empty() {
        let mut N: *mut SDNode = DeadNodes.pop_back_val();
        if N.getOpcode() == DELETED_NODE {
            continue;
        }
        for let mut DUL: *mut DAGUpdateListener = self.UpdateListeners; DUL; DUL = DUL.Next {
            DUL.NodeDeleted(N, null);
        }
        self.RemoveNodeFromCSEMaps(N);
        for let mut I: op_iterator = N.op_begin();
let mut E: op_iterator = N.op_end(); I != E;  {
            let mut Use: *mut SDUse = *I += 1;
            let mut Operand: *mut SDNode = Use.getNode();
            Use.set(SDValue {});
            if Operand.use_empty() {
                DeadNodes.push(Operand);
            }
        }
        self.DeallocateNode(N);
    }
}

fn SelectionDAG::RemoveDeadNode(self, N: *mut SDNode) {
    let mut DeadNodes: SmallVector<SDNode *, 16> = SmallVector<SDNode *, 16> { 1, N };
    let mut Dummy: HandleSDNode = HandleSDNode { self.getRoot() };
    self.RemoveDeadNodes(DeadNodes);
}

fn SelectionDAG::DeleteNode(self, N: *mut SDNode) {
    self.RemoveNodeFromCSEMaps(N);
    self.DeleteNodeNotInCSEMaps(N);
}

fn SelectionDAG::DeleteNodeNotInCSEMaps(self, N: *mut SDNode) {
    assert!(N.getIterator() != self.AllNodes.begin(), "Cannot delete the entry node!");
    assert!(N.use_empty(), "Cannot delete a node that is not dead!");
    N.DropOperands();
    self.DeallocateNode(N);
}

fn SDDbgInfo::add(self, V: *mut SDDbgValue, isParameter: bool) {
    assert!(!(V.isVariadic() && isParameter));
    if isParameter {
        self.ByvalParmDbgValues.push(V);
    } else {
        self.DbgValues.push(V);
    }
    for Node in V.getSDNodes() {
        if Node {
            self.DbgValMap[Node].push(V);
        }
    }
}

fn SDDbgInfo::erase(self, Node: *SDNode) {
    let mut I: iterator = self.DbgValMap.find(Node);
    if I == self.DbgValMap.end() {
        return;
    }
    for Val in operator(I).second {
        Val.setIsInvalidated();
    }
    self.DbgValMap.erase(iterator { I });
}

fn SelectionDAG::DeallocateNode(self, N: *mut SDNode) {
    self.removeOperands(N);
    self.NodeAllocator.Deallocate(self.AllNodes.remove(N));
    N.NodeType = DELETED_NODE;
    self.DbgInfo.erase(N);
    self.SDEI.erase(N);
}

fn SelectionDAG::verifyNode(self: *SelectionDAG, N: *mut SDNode) {
    match N.getOpcode() {
        _ => {
            if N.isTargetOpcode() {
                self.getSelectionDAGInfo().verifyTargetNode(*self, N);
            }
        },
        BUILD_PAIR => {
            let mut VT: EVT = N.getValueType(0);
            assert!(N.getNumValues() == 1, "Too many results!");
            assert!(!VT.isVector() && (VT.isInteger() || VT.isFloatingPoint()), "Wrong return type!");
            assert!(N.getNumOperands() == 2, "Wrong number of operands!");
            assert!(N.getOperand(0).getValueType() == N.getOperand(1).getValueType(), "Mismatched operand types!");
            assert!(N.getOperand(0).getValueType().isInteger() == VT.isInteger(), "Wrong operand type!");
            assert!(VT.getSizeInBits() == 2 * N.getOperand(0).getValueSizeInBits(), "Wrong return type size");
            break;
        },
        BUILD_VECTOR => {
            assert!(N.getNumValues() == 1, "Too many results!");
            assert!(N.getValueType(0).isVector(), "Wrong return type!");
            assert!(N.getNumOperands() == N.getValueType(0).getVectorNumElements(), "Wrong number of operands!");
            let mut EltVT: EVT = N.getValueType(0).getVectorElementType();
            for Op in N.ops() {
                assert!((Op.getValueType() == EltVT || (EltVT.isInteger() && Op.getValueType().isInteger() && EltVT.bitsLE(Op.getValueType()))), "Wrong operand type!");
                assert!(Op.getValueType() == N.getOperand(0).getValueType(), "Operands must all have the same type");
            }
            break;
        },
        SADDO => {
            UADDO;
        },
    }
}

fn SelectionDAG::InsertNode(self, N: *mut SDNode) {
    self.AllNodes.push(N);
    N.PersistentId = self.NextPersistentId += 1;
    self.verifyNode(N);
    for let mut DUL: *mut DAGUpdateListener = self.UpdateListeners; DUL; DUL = DUL.Next {
        DUL.NodeInserted(N);
    }
}

fn SelectionDAG::RemoveNodeFromCSEMaps(self, N: *mut SDNode) -> bool {
    let mut Erased: bool = false;
    match N.getOpcode() {
        HANDLENODE => {
            return false;
        },
        CONDCODE => {
            assert!(self.CondCodeNodes[cast(N).get()], "Cond code doesn't exist!");
        },
        ExternalSymbol => {
            Erased = self.ExternalSymbols.erase(cast(N).getSymbol());
        },
        TargetExternalSymbol => {
            let mut ESN: *mut ExternalSymbolSDNode = cast(N);
            Erased = self.TargetExternalSymbols.erase(string, unsigned int> { ESN.getSymbol(), ESN.getTargetFlags() });
            break;
        },
        MCSymbol => {
            let mut MCSN: *mut MCSymbolSDNode = cast(N);
            Erased = self.MCSymbols.erase(MCSN.getMCSymbol());
            break;
        },
        VALUETYPE => {
            let mut VT: EVT = cast(N).getVT();
            if VT.isExtended() {
                Erased = self.ExtendedValueTypeNodes.erase(VT);
            } else {
                Erased = self.ValueTypeNodes[VT.getSimpleVT().SimpleTy] != null;
                self.ValueTypeNodes[VT.getSimpleVT().SimpleTy] = null;
            }
            break;
        },
        _ => {
            assert!(N.getOpcode() != DELETED_NODE, "DELETED_NODE in CSEMap!");
        },
    }
    if !Erased && N.getValueType(N.getNumValues() - 1) != EVT { Glue } && !N.isMachineOpcode() && !doNotCSE(N) {
        N.dump(self);
        dbgs() << "\n";
        llvm_unreachable_internal("Node is not in map!", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAG.cpp", 1347);
    }
    return Erased;
}

fn SelectionDAG::AddModifiedNodeToCSEMaps(self, N: *mut SDNode) {
    if !doNotCSE(N) {
        let mut Existing: *mut SDNode = self.CSEMap.getOrInsert(N);
        if Existing != N {
            Existing.intersectFlagsWith(N.getFlags());
            if dyn_cast(Existing) {
                MemNode;
            } else {
                let mut NewMMOs: ArrayRef<MachineMemOperand *> = cast(N).memoperands();
                MemNode.refineMMOMetadata(ArrayRef<MachineMemOperand *> { NewMMOs });
            }
            self.ReplaceAllUsesWith(N, Existing);
            for let mut DUL: *mut DAGUpdateListener = self.UpdateListeners; DUL; DUL = DUL.Next {
                DUL.NodeDeleted(N, Existing);
            }
            self.DeleteNodeNotInCSEMaps(N);
            return;
        }
    }
    for let mut DUL: *mut DAGUpdateListener = self.UpdateListeners; DUL; DUL = DUL.Next {
        DUL.NodeUpdated(N);
    }
}

fn SelectionDAG::FindModifiedNodeSlot(self, N: *mut SDNode, Op: SDValue, InsertToken: *mut FoldingSetInsertToken) -> *mut SDNode {
    if doNotCSE(N) {
        return null;
    }
    let mut Ops: [1]SDValue = [Op];
    let mut ID: SDNodeKey = SDNodeKey { N.getOpcode(), N.getVTList(), ArrayRef<SDValue> { Ops } };
    AddNodeIDCustom(ID.Tail, N, N.getOpcode());
    let mut Node: *mut SDNode = self.lookupNode(ID, SDLoc { N }, InsertToken);
    if Node {
        Node.intersectFlagsWith(N.getFlags());
    }
    return Node;
}

fn SelectionDAG::FindModifiedNodeSlot(self, N: *mut SDNode, Op1: SDValue, Op2: SDValue, InsertToken: *mut FoldingSetInsertToken) -> *mut SDNode {
    if doNotCSE(N) {
        return null;
    }
    let mut Ops: [2]SDValue = [Op1, Op2];
    let mut ID: SDNodeKey = SDNodeKey { N.getOpcode(), N.getVTList(), ArrayRef<SDValue> { Ops } };
    AddNodeIDCustom(ID.Tail, N, N.getOpcode());
    let mut Node: *mut SDNode = self.lookupNode(ID, SDLoc { N }, InsertToken);
    if Node {
        Node.intersectFlagsWith(N.getFlags());
    }
    return Node;
}

fn SelectionDAG::FindModifiedNodeSlot(self, N: *mut SDNode, Ops: ArrayRef<SDValue>, InsertToken: *mut FoldingSetInsertToken) -> *mut SDNode {
    if doNotCSE(N) {
        return null;
    }
    let mut ID: SDNodeKey = SDNodeKey { N.getOpcode(), N.getVTList(), ArrayRef<SDValue> { Ops } };
    AddNodeIDCustom(ID.Tail, N, N.getOpcode());
    let mut Node: *mut SDNode = self.lookupNode(ID, SDLoc { N }, InsertToken);
    if Node {
        Node.intersectFlagsWith(N.getFlags());
    }
    return Node;
}

fn SelectionDAG::getEVTAlign(self: *SelectionDAG, VT: EVT) -> Align {
    let mut Ty: *mut Type = if VT == EVT { iPTR } { get(*self.getContext(), 0) } else { VT.getTypeForEVT(*self.getContext()) };
    return self.getDataLayout().getABITypeAlign(Ty);
}

fn SelectionDAG::SelectionDAG(self, tm: *TargetMachine, OL: CodeGenOptLevel) {
    self.InsertNode(&mut self.EntryNode);
    self.DbgInfo = SDDbgInfo {};
}

fn SelectionDAG::init(self, NewMF: *mut MachineFunction, LibraryInfo: *TargetLibraryInfo, LibcallsInfo: *LibcallLoweringInfo, NewUA: *mut UniformityInfo, PSIin: *mut ProfileSummaryInfo, BFIin: *mut BlockFrequencyInfo, VarLocs: *FunctionVarLocs) {
    self.MF = &mut NewMF;
    self.TLI = self.getSubtarget().getTargetLowering();
    self.TSI = self.getSubtarget().getSelectionDAGInfo();
    self.LibInfo = LibraryInfo;
    self.Libcalls = LibcallsInfo;
    self.Context = &mut self.MF.getFunction().getContext();
    self.UA = NewUA;
    self.PSI = PSIin;
    self.BFI = BFIin;
    self.FnVarLocs = VarLocs;
}

fn SelectionDAG::~SelectionDAG(self) {
    assert!(!self.UpdateListeners, "Dangling registered DAGUpdateListeners");
    self.allnodes_clear();
    self.OperandRecycler.clear(self.OperandAllocator);
    self.DbgInfo;
}

fn SelectionDAG::shouldOptForSize(self: *SelectionDAG) -> bool {
    return shouldOptimizeForSize(self.FLI.MBB.getBasicBlock(), self.PSI, self.BFI, Other);
}

fn SelectionDAG::allnodes_clear(self) {
    assert!(&mut operator(self.AllNodes.begin()) == &mut self.EntryNode);
    self.AllNodes.remove(self.AllNodes.begin());
    while !self.AllNodes.is_empty() {
        self.DeallocateNode(&mut self.AllNodes.front());
    }
    self.NextPersistentId = 0;
}

fn SelectionDAG::lookupNode(self, Key: *SDNodeKey, InsertToken: *mut FoldingSetInsertToken) -> *mut SDNode {
    let mut N: *mut SDNode = self.CSEMap.lookup(Key, InsertToken);
    if N {
        match N.getOpcode() {
            _ => {
                break;
            },
            Constant => {
                ConstantFP;
            },
        }
    }
    return N;
}

fn SelectionDAG::lookupNode(self, Key: *SDNodeKey, DL: *SDLoc, InsertToken: *mut FoldingSetInsertToken) -> *mut SDNode {
    let mut N: *mut SDNode = self.CSEMap.lookup(Key, InsertToken);
    if N {
        match N.getOpcode() {
            Constant => {
                ConstantFP;
            },
            _ => {
                if DL.getIROrder() && DL.getIROrder() < N.getIROrder() {
                    N.setDebugLoc(DL.getDebugLoc());
                }
            },
        }
    }
    return N;
}

fn SelectionDAG::clear(self) {
    self.allnodes_clear();
    self.OperandRecycler.clear(self.OperandAllocator);
    self.OperandAllocator.Reset();
    self.CSEMap.clear();
    self.ExtendedValueTypeNodes.clear();
    self.ExternalSymbols.clear();
    self.TargetExternalSymbols.clear();
    self.MCSymbols.clear();
    self.SDEI.clear();
    fill(self.CondCodeNodes, null);
    fill(self.ValueTypeNodes, null);
    self.EntryNode.UseList = null;
    self.InsertNode(&mut self.EntryNode);
    self.Root = self.getEntryNode();
    self.DbgInfo.clear();
}

fn SelectionDAG::getFPExtendOrRound(self, Op: SDValue, DL: *SDLoc, VT: EVT) -> SDValue {
    return if VT.bitsGT(Op.getValueType()) { self.getNode(FP_EXTEND, DL, VT, Op) } else { self.getNode(FP_ROUND, DL, VT, Op, self.getIntPtrConstant(0, DL, true)) };
}

fn SelectionDAG::getStrictFPExtendOrRound(self, Op: SDValue, Chain: SDValue, DL: *SDLoc, VT: EVT) -> pair<SDValue, SDValue> {
    assert!(!VT.bitsEq(Op.getValueType()), "Strict no-op FP extend/round not allowed.");
    let mut Res: SDValue = if VT.bitsGT(Op.getValueType()) { self.getNode(STRICT_FP_EXTEND, DL, ArrayRef<EVT> { [VT, EVT { Other }] }, ArrayRef<SDValue> { [Chain, Op] }) } else { self.getNode(STRICT_FP_ROUND, DL, ArrayRef<EVT> { [VT, EVT { Other }] }, ArrayRef<SDValue> { [Chain, Op, self.getIntPtrConstant(0, DL, true)] }) };
    return pair<SDValue, SDValue> { Res, SDValue { Node: Res.getNode(), ResNo: 1 } };
}

fn SelectionDAG::getAnyExtOrTrunc(self, Op: SDValue, DL: *SDLoc, VT: EVT) -> SDValue {
    return if VT.bitsGT(Op.getValueType()) { self.getNode(ANY_EXTEND, DL, VT, Op) } else { self.getNode(TRUNCATE, DL, VT, Op) };
}

fn SelectionDAG::getSExtOrTrunc(self, Op: SDValue, DL: *SDLoc, VT: EVT) -> SDValue {
    return if VT.bitsGT(Op.getValueType()) { self.getNode(SIGN_EXTEND, DL, VT, Op) } else { self.getNode(TRUNCATE, DL, VT, Op) };
}

fn SelectionDAG::getZExtOrTrunc(self, Op: SDValue, DL: *SDLoc, VT: EVT) -> SDValue {
    return if VT.bitsGT(Op.getValueType()) { self.getNode(ZERO_EXTEND, DL, VT, Op) } else { self.getNode(TRUNCATE, DL, VT, Op) };
}

fn SelectionDAG::getBitcastedAnyExtOrTrunc(self, Op: SDValue, DL: *SDLoc, VT: EVT) -> SDValue {
    assert!(!VT.isVector());
    let mut Type: EVT = Op.getValueType();
    let mut DestOp: SDValue = SDValue {};
    if Type == VT {
        return Op;
    }
    let mut Size: TypeSize = Op.getValueSizeInBits();
    DestOp = self.getBitcast(getIntegerVT(*self.Context, Size.operator unsigned long long()), Op);
    if DestOp.getValueType() == VT {
        return DestOp;
    }
    return self.getAnyExtOrTrunc(DestOp, DL, VT);
}

fn SelectionDAG::getBoolExtOrTrunc(self, Op: SDValue, SL: *SDLoc, VT: EVT, OpVT: EVT) -> SDValue {
    if VT.bitsLE(Op.getValueType()) {
        return self.getNode(TRUNCATE, SL, VT, Op);
    }
    let mut BType: BooleanContent = self.TLI.getBooleanContents(OpVT);
    return self.getNode(self.TLI.getExtendForContent(BType), SL, VT, Op);
}

fn SelectionDAG::getZeroExtendInReg(self, Op: SDValue, DL: *SDLoc, VT: EVT) -> SDValue {
    let mut OpVT: EVT = Op.getValueType();
    assert!(VT.isInteger() && OpVT.isInteger(), "Cannot getZeroExtendInReg FP types");
    assert!(VT.isVector() == OpVT.isVector(), "getZeroExtendInReg type should be vector iff the operand type is vector!");
    assert!((!VT.isVector() || VT.getVectorElementCount() == OpVT.getVectorElementCount()), "Vector element counts must match in getZeroExtendInReg");
    assert!(VT.getScalarType().bitsLE(OpVT.getScalarType()), "Not extending!");
    if OpVT == VT {
        return Op;
    }
    if Op.getOpcode() == AssertZext && cast(Op.getOperand(1)).getVT().getScalarType().bitsLE(VT.getScalarType()) {
        return Op;
    }
    let mut Imm: APInt = getLowBitsSet(OpVT.getScalarSizeInBits(), VT.getScalarSizeInBits());
    return self.getNode(AND, DL, OpVT, Op, self.getConstant(Imm, DL, OpVT, false, false));
}

fn SelectionDAG::getPtrExtOrTrunc(self, Op: SDValue, DL: *SDLoc, VT: EVT) -> SDValue {
    return self.getZExtOrTrunc(Op, DL, VT);
}

fn SelectionDAG::getPtrExtendInReg(self, Op: SDValue, DL: *SDLoc, VT: EVT) -> SDValue {
    return self.getZeroExtendInReg(Op, DL, VT);
}

fn SelectionDAG::getNegative(self, Val: SDValue, DL: *SDLoc, VT: EVT) -> SDValue {
    return self.getNode(SUB, DL, VT, self.getConstant(0, DL, VT, false, false), Val);
}

fn SelectionDAG::getNOT(self, DL: *SDLoc, Val: SDValue, VT: EVT) -> SDValue {
    return self.getNode(XOR, DL, VT, Val, self.getAllOnesConstant(DL, VT, false, false));
}

fn SelectionDAG::getLogicalNOT(self, DL: *SDLoc, Val: SDValue, VT: EVT) -> SDValue {
    let mut TrueValue: SDValue = self.getBoolConstant(true, DL, VT, VT);
    return self.getNode(XOR, DL, VT, Val, TrueValue);
}

fn SelectionDAG::getBoolConstant(self, V: bool, DL: *SDLoc, VT: EVT, OpVT: EVT) -> SDValue {
    if !V {
        return self.getConstant(0, DL, VT, false, false);
    }
    match self.TLI.getBooleanContents(OpVT) {
        ZeroOrOneBooleanContent => {
            UndefinedBooleanContent;
        },
        ZeroOrNegativeOneBooleanContent => {
            return self.getAllOnesConstant(DL, VT, false, false);
        },
    }
    llvm_unreachable_internal("Unexpected boolean content enum!", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAG.cpp", 1684);
}

fn SelectionDAG::getConstant(self, Val: u64, DL: *SDLoc, VT: EVT, isT: bool, isO: bool) -> SDValue {
    return self.getConstant(APInt { VT.getScalarSizeInBits(), Val, false, false }, DL, VT, isT, isO);
}

fn SelectionDAG::getConstant(self, Val: *APInt, DL: *SDLoc, VT: EVT, isT: bool, isO: bool) -> SDValue {
    return self.getConstant(*get(*self.Context, Val), DL, VT, isT, isO);
}

fn SelectionDAG::getConstant(self, Val: *ConstantInt, DL: *SDLoc, VT: EVT, isT: bool, isO: bool) -> SDValue {
    assert!(VT.isInteger(), "Cannot create FP integer constant!");
    let mut EltVT: EVT = VT.getScalarType();
    let mut Elt: *ConstantInt = &mut Val;
    if isa(Elt.getType()) {
        Elt = get(*self.getContext(), Elt.getValue());
    }
    if VT.isVector() && self.TLI.getTypeAction(*self.getContext(), EltVT) == TypePromoteInteger {
        EltVT = self.TLI.getTypeToTransformTo(*self.getContext(), EltVT);
        let mut NewVal: APInt = APInt {};
        if self.TLI.isSExtCheaperThanZExt(VT.getScalarType(), EltVT) {
            NewVal = Elt.getValue().sextOrTrunc(EltVT.getSizeInBits().operator unsigned long long());
        } else {
            NewVal = Elt.getValue().zextOrTrunc(EltVT.getSizeInBits().operator unsigned long long());
        }
        Elt = get(*self.getContext(), NewVal);
    } else if self.NewNodesMustHaveLegalTypes && VT.isVector() && self.TLI.getTypeAction(*self.getContext(), EltVT) == TypeExpandInteger {
        let mut NewVal: *APInt = Elt.getValue();
        let mut ViaEltVT: EVT = self.TLI.getTypeToTransformTo(*self.getContext(), EltVT);
        let mut ViaEltSizeInBits: u32 = ViaEltVT.getSizeInBits().operator unsigned long long();
        if VT.isScalableVector() || self.TLI.isOperationLegal(SPLAT_VECTOR, VT) {
            assert!(EltVT.getSizeInBits().operator unsigned long long() % ViaEltSizeInBits == 0, "Can only handle an even split!");
            let mut Parts: u32 = EltVT.getSizeInBits().operator unsigned long long() / ViaEltSizeInBits;
            let mut ScalarParts: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
            for let mut i: u32 = 0; i != Parts; i += 1 {
                ScalarParts.push(self.getConstant(NewVal.extractBits(ViaEltSizeInBits, i * ViaEltSizeInBits), DL, ViaEltVT, isT, isO));
            }
            return self.getNode(SPLAT_VECTOR_PARTS, DL, VT, ArrayRef<SDValue> { ScalarParts });
        }
        let mut ViaVecNumElts: u32 = VT.getSizeInBits().operator unsigned long long() / ViaEltSizeInBits;
        let mut ViaVecVT: EVT = getVectorVT(*self.getContext(), ViaEltVT, ViaVecNumElts, false);
        assert!(ViaVecVT.getSizeInBits() == VT.getSizeInBits());
        let mut EltParts: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
        for let mut i: u32 = 0; i < ViaVecNumElts / VT.getVectorNumElements(); i += 1 {
            EltParts.push(self.getConstant(NewVal.extractBits(ViaEltSizeInBits, i * ViaEltSizeInBits), DL, ViaEltVT, isT, isO));
        }
        if self.getDataLayout().isBigEndian() {
            reverse(EltParts.begin(), EltParts.end());
        }
        let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
        for let mut i: u32 = 0;
let mut e: u32 = VT.getVectorNumElements(); i != e; i += 1 {
            append_range(Ops, EltParts);
        }
        let mut V: SDValue = self.getNode(BITCAST, DL, VT, self.getBuildVector(ViaVecVT, DL, ArrayRef<SDValue> { Ops }));
        return V;
    }
    assert!(Elt.getBitWidth() == EltVT.getSizeInBits().operator unsigned long long(), "APInt size does not match type size!");
    let mut Opc: u32 = if isT { TargetConstant } else { Constant };
    let mut VTs: SDVTList = self.getVTList(EltVT);
    let mut ID: SDNodeKey = SDNodeKey { Opc, VTs, ArrayRef<SDValue> {} };
    ID.AddPointer(Elt);
    ID.AddBoolean(isO);
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    let mut N: *mut SDNode = null;
    if (N = self.lookupNode(ID, DL, InsertToken)) {
        if !VT.isVector() {
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    if !N {
        N = self.newSDNode(isT, isO, Elt, VTs);
        if !isT {
            N.setDebugLoc(DL.getDebugLoc());
        }
        self.CSEMap.insert(N, InsertToken);
        self.InsertNode(N);
        NewSDValueDbgMsg(SDValue { Node: N, ResNo: 0 }, "Creating constant: ", self);
    }
    let mut Result: SDValue = SDValue { Node: N, ResNo: 0 };
    if VT.isVector() {
        Result = self.getSplat(VT, DL, Result);
    }
    return Result;
}

fn SelectionDAG::getSignedConstant(self, Val: i64, DL: *SDLoc, VT: EVT, isT: bool, isO: bool) -> SDValue {
    let mut Size: u32 = VT.getScalarSizeInBits();
    return self.getConstant(APInt { Size, Val, true, false }, DL, VT, isT, isO);
}

fn SelectionDAG::getAllOnesConstant(self, DL: *SDLoc, VT: EVT, IsTarget: bool, IsOpaque: bool) -> SDValue {
    return self.getConstant(getAllOnes(VT.getScalarSizeInBits()), DL, VT, IsTarget, IsOpaque);
}

fn SelectionDAG::getIntPtrConstant(self, Val: u64, DL: *SDLoc, isTarget: bool) -> SDValue {
    return self.getConstant(Val, DL, EVT { self.TLI.getPointerTy(self.getDataLayout(), 0) }, isTarget, false);
}

fn SelectionDAG::getShiftAmountConstant(self, Val: u64, VT: EVT, DL: *SDLoc) -> SDValue {
    assert!(VT.isInteger(), "Shift amount is not an integer type!");
    let mut ShiftVT: EVT = self.TLI.getShiftAmountTy(VT, self.getDataLayout());
    return self.getConstant(Val, DL, ShiftVT, false, false);
}

fn SelectionDAG::getShiftAmountConstant(self, Val: *APInt, VT: EVT, DL: *SDLoc) -> SDValue {
    assert!(Val.ult(VT.getScalarSizeInBits()), "Out of range shift");
    return self.getShiftAmountConstant(Val.getZExtValue(), VT, DL);
}

fn SelectionDAG::getVectorIdxConstant(self, Val: u64, DL: *SDLoc, isTarget: bool) -> SDValue {
    return self.getConstant(Val, DL, EVT { self.TLI.getVectorIdxTy(self.getDataLayout()) }, isTarget, false);
}

fn SelectionDAG::getConstantFP(self, V: *APFloat, DL: *SDLoc, VT: EVT, isTarget: bool) -> SDValue {
    return self.getConstantFP(*get(*self.getContext(), V), DL, VT, isTarget);
}

fn SelectionDAG::getConstantFP(self, V: *ConstantFP, DL: *SDLoc, VT: EVT, isTarget: bool) -> SDValue {
    assert!(VT.isFloatingPoint(), "Cannot create integer FP constant!");
    let mut EltVT: EVT = VT.getScalarType();
    let mut Elt: *ConstantFP = &mut V;
    if isa(Elt.getType()) {
        Elt = get(*self.getContext(), Elt.getValue());
    }
    let mut Opc: u32 = if isTarget { TargetConstantFP } else { ConstantFP };
    let mut VTs: SDVTList = self.getVTList(EltVT);
    let mut ID: SDNodeKey = SDNodeKey { Opc, VTs, ArrayRef<SDValue> {} };
    ID.AddPointer(Elt);
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    let mut N: *mut SDNode = null;
    if (N = self.lookupNode(ID, DL, InsertToken)) {
        if !VT.isVector() {
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    if !N {
        N = self.newSDNode(isTarget, Elt, VTs);
        self.CSEMap.insert(N, InsertToken);
        self.InsertNode(N);
    }
    let mut Result: SDValue = SDValue { Node: N, ResNo: 0 };
    if VT.isVector() {
        Result = self.getSplat(VT, DL, Result);
    }
    NewSDValueDbgMsg(Result, "Creating fp constant: ", self);
    return Result;
}

fn SelectionDAG::getConstantFP(self, Val: f64, DL: *SDLoc, VT: EVT, isTarget: bool) -> SDValue {
    let mut EltVT: EVT = VT.getScalarType();
    if EltVT == EVT { f32 } {
        return self.getConstantFP(APFloat { U: Val as f32 }, DL, VT, isTarget);
    }
    if EltVT == EVT { f64 } {
        return self.getConstantFP(APFloat { U: Val }, DL, VT, isTarget);
    }
    if EltVT == EVT { f80 } || EltVT == EVT { f128 } || EltVT == EVT { ppcf128 } || EltVT == EVT { f16 } || EltVT == EVT { bf16 } {
        let mut Ignored: bool = false;
        let mut APF: APFloat = APFloat { U: Val };
        APF.convert(EltVT.getFltSemantics(), rmNearestTiesToEven, &mut Ignored);
        return self.getConstantFP(APF, DL, VT, isTarget);
    }
    llvm_unreachable_internal("Unsupported type in getConstantFP", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAG.cpp", 1909);
}

fn SelectionDAG::getGlobalAddress(self, GV: *GlobalValue, DL: *SDLoc, VT: EVT, Offset: i64, isTargetGA: bool, TargetFlags: u32) -> SDValue {
    assert!((TargetFlags == 0 || isTargetGA), "Cannot set target flags on target-independent globals");
    let mut BitWidth: u32 = self.getDataLayout().getPointerTypeSizeInBits(GV.getType());
    if BitWidth < 64 {
        Offset = SignExtend64(Offset, BitWidth);
    }
    let mut Opc: u32 = 0;
    if GV.isThreadLocal() {
        Opc = if isTargetGA { TargetGlobalTLSAddress } else { GlobalTLSAddress };
    } else {
        Opc = if isTargetGA { TargetGlobalAddress } else { GlobalAddress };
    }
    let mut VTs: SDVTList = self.getVTList(VT);
    let mut ID: SDNodeKey = SDNodeKey { Opc, VTs, ArrayRef<SDValue> {} };
    ID.AddPointer(GV);
    ID.AddInteger(Offset);
    ID.AddInteger(TargetFlags);
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, DL, InsertToken) {
        E;
    } else {
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut GlobalAddressSDNode = self.newSDNode(Opc, DL.getIROrder(), DL.getDebugLoc(), GV, VTs, Offset, TargetFlags);
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    return SDValue { Node: N, ResNo: 0 };
}

fn SelectionDAG::getDeactivationSymbol(self, GV: *GlobalValue) -> SDValue {
    let mut VTs: SDVTList = self.getVTList(EVT { Untyped });
    let mut ID: SDNodeKey = SDNodeKey { DEACTIVATION_SYMBOL, VTs, ArrayRef<SDValue> {} };
    ID.AddPointer(GV);
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, SDLoc {}, InsertToken) {
        E;
    } else {
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut DeactivationSymbolSDNode = self.newSDNode(GV, VTs);
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    return SDValue { Node: N, ResNo: 0 };
}

fn SelectionDAG::getFrameIndex(self, FI: i32, VT: EVT, isTarget: bool) -> SDValue {
    let mut Opc: u32 = if isTarget { TargetFrameIndex } else { FrameIndex };
    let mut VTs: SDVTList = self.getVTList(VT);
    let mut ID: SDNodeKey = SDNodeKey { Opc, VTs, ArrayRef<SDValue> {} };
    ID.AddInteger(FI);
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, InsertToken) {
        E;
    } else {
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut FrameIndexSDNode = self.newSDNode(FI, VTs, isTarget);
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    return SDValue { Node: N, ResNo: 0 };
}

fn SelectionDAG::getJumpTable(self, JTI: i32, VT: EVT, isTarget: bool, TargetFlags: u32) -> SDValue {
    assert!((TargetFlags == 0 || isTarget), "Cannot set target flags on target-independent jump tables");
    let mut Opc: u32 = if isTarget { TargetJumpTable } else { JumpTable };
    let mut VTs: SDVTList = self.getVTList(VT);
    let mut ID: SDNodeKey = SDNodeKey { Opc, VTs, ArrayRef<SDValue> {} };
    ID.AddInteger(JTI);
    ID.AddInteger(TargetFlags);
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, InsertToken) {
        E;
    } else {
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut JumpTableSDNode = self.newSDNode(JTI, VTs, isTarget, TargetFlags);
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    return SDValue { Node: N, ResNo: 0 };
}

fn SelectionDAG::getJumpTableDebugInfo(self, JTI: i32, Chain: SDValue, DL: *SDLoc) -> SDValue {
    let mut PTy: EVT = EVT { self.getTargetLoweringInfo().getPointerTy(self.getDataLayout(), 0) };
    return self.getNode(JUMP_TABLE_DEBUG_INFO, DL, EVT { Other }, Chain, self.getTargetConstant(JTI as u64, DL, PTy, true));
}

fn SelectionDAG::getConstantPool(self, C: *Constant, VT: EVT, Alignment: MaybeAlign, Offset: i32, isTarget: bool, TargetFlags: u32) -> SDValue {
    assert!((TargetFlags == 0 || isTarget), "Cannot set target flags on target-independent globals");
    if !Alignment {
        Alignment = MaybeAlign { if self.shouldOptForSize() { self.getDataLayout().getABITypeAlign(C.getType()) } else { self.getDataLayout().getPrefTypeAlign(C.getType()) } };
    }
    let mut Opc: u32 = if isTarget { TargetConstantPool } else { ConstantPool };
    let mut VTs: SDVTList = self.getVTList(VT);
    let mut ID: SDNodeKey = SDNodeKey { Opc, VTs, ArrayRef<SDValue> {} };
    ID.AddInteger(operator(Alignment).value());
    ID.AddInteger(Offset);
    ID.AddPointer(C);
    ID.AddInteger(TargetFlags);
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, InsertToken) {
        E;
    } else {
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut ConstantPoolSDNode = self.newSDNode(isTarget, C, VTs, Offset, operator(Alignment), TargetFlags);
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    let mut V: SDValue = SDValue { Node: N, ResNo: 0 };
    NewSDValueDbgMsg(V, "Creating new constant pool: ", self);
    return V;
}

fn SelectionDAG::getConstantPool(self, C: *mut MachineConstantPoolValue, VT: EVT, Alignment: MaybeAlign, Offset: i32, isTarget: bool, TargetFlags: u32) -> SDValue {
    assert!((TargetFlags == 0 || isTarget), "Cannot set target flags on target-independent globals");
    if !Alignment {
        Alignment = MaybeAlign { self.getDataLayout().getPrefTypeAlign(C.getType()) };
    }
    let mut Opc: u32 = if isTarget { TargetConstantPool } else { ConstantPool };
    let mut VTs: SDVTList = self.getVTList(VT);
    let mut ID: SDNodeKey = SDNodeKey { Opc, VTs, ArrayRef<SDValue> {} };
    ID.AddInteger(operator(Alignment).value());
    ID.AddInteger(Offset);
    C.addSelectionDAGCSEId(ID.Tail);
    ID.AddInteger(TargetFlags);
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, InsertToken) {
        E;
    } else {
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut ConstantPoolSDNode = self.newSDNode(isTarget, C, VTs, Offset, operator(Alignment), TargetFlags);
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    return SDValue { Node: N, ResNo: 0 };
}

fn SelectionDAG::getBasicBlock(self, MBB: *mut MachineBasicBlock) -> SDValue {
    let mut ID: SDNodeKey = SDNodeKey { BasicBlock, self.getVTList(EVT { Other }), ArrayRef<SDValue> {} };
    ID.AddPointer(MBB);
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, InsertToken) {
        E;
    } else {
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut BasicBlockSDNode = self.newSDNode(MBB);
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    return SDValue { Node: N, ResNo: 0 };
}

fn SelectionDAG::getValueType(self, VT: EVT) -> SDValue {
    if VT.isSimple() && VT.getSimpleVT().SimpleTy as u32 >= self.ValueTypeNodes.len {
        self.ValueTypeNodes.resize(VT.getSimpleVT().SimpleTy + 1);
    }
    let mut N: *mut *mut SDNode = if VT.isExtended() { self.ExtendedValueTypeNodes[VT] } else { self.ValueTypeNodes[VT.getSimpleVT().SimpleTy] };
    if N {
        return SDValue { Node: N, ResNo: 0 };
    }
    N = self.newSDNode(VT);
    self.InsertNode(N);
    return SDValue { Node: N, ResNo: 0 };
}

fn SelectionDAG::getExternalSymbol(self, Sym: *u8, VT: EVT) -> SDValue {
    let mut N: *mut *mut SDNode = self.ExternalSymbols[Sym];
    if N {
        return SDValue { Node: N, ResNo: 0 };
    }
    N = self.newSDNode(false, Sym, 0, self.getVTList(VT));
    self.InsertNode(N);
    return SDValue { Node: N, ResNo: 0 };
}

fn SelectionDAG::getExternalSymbol(self, Libcall: LibcallImpl, VT: EVT) -> SDValue {
    let mut SymName: str = getLibcallImplName(Libcall);
    return self.getExternalSymbol(SymName.ptr, VT);
}

fn SelectionDAG::getMCSymbol(self, Sym: *mut MCSymbol, VT: EVT) -> SDValue {
    let mut N: *mut *mut SDNode = self.MCSymbols[Sym];
    if N {
        return SDValue { Node: N, ResNo: 0 };
    }
    N = self.newSDNode(Sym, self.getVTList(VT));
    self.InsertNode(N);
    return SDValue { Node: N, ResNo: 0 };
}

fn SelectionDAG::getTargetExternalSymbol(self, Sym: *u8, VT: EVT, TargetFlags: u32) -> SDValue {
    let mut N: *mut *mut SDNode = self.TargetExternalSymbols[string, unsigned int> { Sym, TargetFlags }];
    if N {
        return SDValue { Node: N, ResNo: 0 };
    }
    N = self.newSDNode(true, Sym, TargetFlags, self.getVTList(VT));
    self.InsertNode(N);
    return SDValue { Node: N, ResNo: 0 };
}

fn SelectionDAG::getTargetExternalSymbol(self, Libcall: LibcallImpl, VT: EVT, TargetFlags: u32) -> SDValue {
    let mut SymName: str = getLibcallImplName(Libcall);
    return self.getTargetExternalSymbol(SymName.ptr, VT, TargetFlags);
}

fn SelectionDAG::getCondCode(self, Cond: CondCode) -> SDValue {
    if Cond as u32 >= self.CondCodeNodes.len {
        self.CondCodeNodes.resize(Cond + 1);
    }
    if !self.CondCodeNodes[Cond] {
        let mut N: *mut CondCodeSDNode = self.newSDNode(Cond);
        self.CondCodeNodes[Cond] = N;
        self.InsertNode(N);
    }
    return SDValue { Node: self.CondCodeNodes[Cond], ResNo: 0 };
}

fn SelectionDAG::getVScale(self, DL: *SDLoc, VT: EVT, MulImm: APInt) -> SDValue {
    assert!(MulImm.getBitWidth() == VT.getSizeInBits().operator unsigned long long(), "APInt size does not match type size!");
    if MulImm == 0 {
        return self.getConstant(0, DL, VT, false, false);
    }
    let mut MF: *MachineFunction = self.getMachineFunction();
    let mut F: *Function = MF.getFunction();
    let mut CR: ConstantRange = getVScaleRange(&mut F, 64);
    if CR.getSingleElement() {
        C;
    } else {
        return self.getConstant(MulImm * C.getZExtValue(), DL, VT, false, false);
    }
    return self.getNode(VSCALE, DL, VT, self.getConstant(MulImm, DL, VT, false, false));
}

