fn SelectionDAG::getElementCount(self, DL: *SDLoc, VT: EVT, EC: ElementCount) -> SDValue {
    return getFixedOrScalableQuantity(*self, DL, VT, EC);
}

fn SelectionDAG::getTypeSize(self, DL: *SDLoc, VT: EVT, TS: TypeSize) -> SDValue {
    return getFixedOrScalableQuantity(*self, DL, VT, TS);
}

fn SelectionDAG::getMaskFromElementCount(self, DL: *SDLoc, DataVT: EVT, EC: ElementCount) -> SDValue {
    let mut IdxVT: EVT = EVT { self.TLI.getVectorIdxTy(self.getDataLayout()) };
    let mut MaskVT: EVT = self.TLI.getSetCCResultType(self.getDataLayout(), *self.getContext(), DataVT);
    return self.getNode(GET_ACTIVE_LANE_MASK, DL, MaskVT, self.getConstant(0, DL, IdxVT, false, false), self.getElementCount(DL, IdxVT, EC));
}

fn SelectionDAG::getStepVector(self, DL: *SDLoc, ResVT: EVT) -> SDValue {
    let mut One: APInt = APInt { ResVT.getScalarSizeInBits(), 1, false, false };
    return self.getStepVector(DL, ResVT, One);
}

fn SelectionDAG::getStepVector(self, DL: *SDLoc, ResVT: EVT, StepVal: *APInt) -> SDValue {
    assert!(ResVT.getScalarSizeInBits() == StepVal.getBitWidth());
    if ResVT.isScalableVector() {
        return self.getNode(STEP_VECTOR, DL, ResVT, self.getTargetConstant(StepVal, DL, ResVT.getVectorElementType(), false));
    }
    let mut OpsStepConstants: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    for let mut i: u64 = 0; i < ResVT.getVectorNumElements(); i += 1 {
        OpsStepConstants.push(self.getConstant(StepVal * i, DL, ResVT.getVectorElementType(), false, false));
    }
    return self.getBuildVector(ResVT, DL, ArrayRef<SDValue> { OpsStepConstants });
}

fn commuteShuffle(N1: *mut SDValue, N2: *mut SDValue, M: MutableArrayRef<int>) {
    swap(N1, N2);
    commuteMask(M);
}

fn SelectionDAG::getVectorShuffle(self, VT: EVT, dl: *SDLoc, N1: SDValue, N2: SDValue, Mask: ArrayRef<int>) -> SDValue {
    assert!(VT.getVectorNumElements() == Mask.len, "Must have the same number of vector elements as mask elements!");
    assert!(VT == N1.getValueType() && VT == N2.getValueType(), "Invalid VECTOR_SHUFFLE");
    if N1.isUndef() && N2.isUndef() {
        if N1.getOpcode() == POISON && N2.getOpcode() == POISON {
            return self.getPOISON(VT);
        }
        return self.getUNDEF(VT);
    }
    let mut NElts: i32 = Mask.len;
    assert!(all_of(Mask, Closure_2 { NElts: &mut NElts }), "Index out of range");
    let mut MaskVec: SmallVector<int, 8> = SmallVector<int, 8> { Mask };
    if N1 == N2 {
        N2 = self.getPOISON(VT);
        for let mut i: i32 = 0; i != NElts; i += 1 {
            if MaskVec[i] >= NElts {
                MaskVec[i] -= NElts;
            }
        }
    }
    if N1.isUndef() {
        commuteShuffle(N1, N2, MutableArrayRef<int> { MaskVec });
    }
    if self.TLI.hasVectorBlend() {
        let mut BlendSplat: Closure_3 = Closure_3 { NElts: &mut NElts, MaskVec: &mut MaskVec };
        if dyn_cast(N1) {
            N1BV;
        } else {
            BlendSplat.call(N1BV, 0);
        }
        if dyn_cast(N2) {
            N2BV;
        } else {
            BlendSplat.call(N2BV, NElts);
        }
    }
    let mut AllLHS: bool = true;
    let mut AllRHS: bool = true;
    let mut N2Undef: bool = N2.isUndef();
    for let mut i: i32 = 0; i != NElts; i += 1 {
        if MaskVec[i] >= NElts {
            if N2Undef {
                MaskVec[i] = -1;
            } else {
                AllLHS = false;
            }
        } else if MaskVec[i] >= 0 {
            AllRHS = false;
        }
    }
    if AllLHS && AllRHS {
        return self.getPOISON(VT);
    }
    if AllLHS && !N2Undef {
        N2 = self.getPOISON(VT);
    }
    if AllRHS {
        N1 = self.getPOISON(VT);
        commuteShuffle(N1, N2, MutableArrayRef<int> { MaskVec });
    }
    N2Undef = N2.isUndef();
    if N1.isUndef() && N2Undef {
        if N1.getOpcode() == POISON && N2.getOpcode() == POISON {
            return self.getPOISON(VT);
        }
        return self.getUNDEF(VT);
    }
    let mut Identity: bool = true;
    let mut AllSame: bool = true;
    for let mut i: i32 = 0; i != NElts; i += 1 {
        if MaskVec[i] >= 0 && MaskVec[i] != i {
            Identity = false;
        }
        if MaskVec[i] != MaskVec[0] {
            AllSame = false;
        }
    }
    if Identity && NElts {
        return N1;
    }
    if N2Undef {
        let mut V: SDValue = N1;
        while V.getOpcode() == BITCAST {
            V = operator(V).getOperand(0);
        }
        if dyn_cast(V) {
            BV;
        } else {
            let mut UndefElements: BitVector = BitVector {};
            let mut Splat: SDValue = BV.getSplatValue(&mut UndefElements);
            if Splat && Splat.isUndef() {
                return if Splat.getOpcode() == POISON { self.getPOISON(VT) } else { self.getUNDEF(VT) };
            }
            let mut SameNumElts: bool = V.getValueType().getVectorNumElements() == VT.getVectorNumElements();
            if Splat && UndefElements.none() {
                if SameNumElts || isNullConstant(Splat) {
                    return N1;
                }
            }
            if AllSame && SameNumElts {
                let mut BuildVT: EVT = BV.getValueType(0);
                let mut Splatted: *SDValue = BV.getOperand(MaskVec[0]);
                let mut NewBV: SDValue = self.getSplatBuildVector(BuildVT, dl, Splatted);
                if BuildVT != VT {
                    NewBV = self.getNode(BITCAST, dl, VT, NewBV);
                }
                return NewBV;
            }
        }
    }
    let mut VTs: SDVTList = self.getVTList(VT);
    let mut Ops: [2]SDValue = [N1, N2];
    let mut ID: SDNodeKey = SDNodeKey { VECTOR_SHUFFLE, VTs, ArrayRef<SDValue> { Ops } };
    for let mut i: i32 = 0; i != NElts; i += 1 {
        ID.AddInteger(MaskVec[i]);
    }
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, dl, InsertToken) {
        E;
    } else {
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut MaskAlloc: *mut i32 = self.OperandAllocator.Allocate(NElts);
    copy(MaskVec, MaskAlloc);
    let mut N: *mut ShuffleVectorSDNode = self.newSDNode(VTs, dl.getIROrder(), dl.getDebugLoc(), MaskAlloc);
    self.createOperands(N, ArrayRef<SDValue> { Ops });
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    let mut V: SDValue = SDValue { Node: N, ResNo: 0 };
    NewSDValueDbgMsg(V, "Creating new node: ", self);
    return V;
}

fn SelectionDAG::getCommutedVectorShuffle(self, SV: *ShuffleVectorSDNode) -> SDValue {
    let mut VT: EVT = SV.getValueType(0);
    let mut MaskVec: SmallVector<int, 8> = SmallVector<int, 8> { SV.getMask() };
    commuteMask(MutableArrayRef<int> { MaskVec });
    let mut Op0: SDValue = SV.getOperand(0);
    let mut Op1: SDValue = SV.getOperand(1);
    return self.getVectorShuffle(VT, SDLoc { &mut SV }, Op1, Op0, ArrayRef<int> { MaskVec });
}

fn SelectionDAG::getRegister(self, Reg: Register, VT: EVT) -> SDValue {
    let mut VTs: SDVTList = self.getVTList(VT);
    let mut ID: SDNodeKey = SDNodeKey { Register, VTs, ArrayRef<SDValue> {} };
    ID.AddInteger(Reg.id());
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, InsertToken) {
        E;
    } else {
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut RegisterSDNode = self.newSDNode(Reg, VTs);
    N..SDNodeBits.IsDivergent = self.TLI.isSDNodeSourceOfDivergence(N, self.FLI, self.UA);
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    return SDValue { Node: N, ResNo: 0 };
}

fn SelectionDAG::getRegisterMask(self, RegMask: *u32) -> SDValue {
    let mut ID: SDNodeKey = SDNodeKey { RegisterMask, self.getVTList(EVT { Untyped }), ArrayRef<SDValue> {} };
    ID.AddPointer(RegMask);
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, InsertToken) {
        E;
    } else {
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut RegisterMaskSDNode = self.newSDNode(RegMask);
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    return SDValue { Node: N, ResNo: 0 };
}

fn SelectionDAG::getEHLabel(self, dl: *SDLoc, Root: SDValue, Label: *mut MCSymbol) -> SDValue {
    return self.getLabelNode(EH_LABEL, dl, Root, Label);
}

fn SelectionDAG::getLabelNode(self, Opcode: u32, dl: *SDLoc, Root: SDValue, Label: *mut MCSymbol) -> SDValue {
    let mut Ops: [1]SDValue = [Root];
    let mut ID: SDNodeKey = SDNodeKey { Opcode, self.getVTList(EVT { Other }), ArrayRef<SDValue> { Ops } };
    ID.AddPointer(Label);
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, InsertToken) {
        E;
    } else {
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut LabelSDNode = self.newSDNode(Opcode, dl.getIROrder(), dl.getDebugLoc(), Label);
    self.createOperands(N, ArrayRef<SDValue> { Ops });
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    return SDValue { Node: N, ResNo: 0 };
}

fn SelectionDAG::getBlockAddress(self, BA: *BlockAddress, VT: EVT, Offset: i64, isTarget: bool, TargetFlags: u32) -> SDValue {
    let mut Opc: u32 = if isTarget { TargetBlockAddress } else { BlockAddress };
    let mut VTs: SDVTList = self.getVTList(VT);
    let mut ID: SDNodeKey = SDNodeKey { Opc, VTs, ArrayRef<SDValue> {} };
    ID.AddPointer(BA);
    ID.AddInteger(Offset);
    ID.AddInteger(TargetFlags);
    let mut InsertToken: FoldingSetInsertToken = FoldingSetInsertToken {};
    if self.lookupNode(ID, InsertToken) {
        E;
    } else {
        return SDValue { Node: E, ResNo: 0 };
    }
    let mut N: *mut BlockAddressSDNode = self.newSDNode(Opc, VTs, BA, Offset, TargetFlags);
    self.CSEMap.insert(N, InsertToken);
    self.InsertNode(N);
    return SDValue { Node: N, ResNo: 0 };
}

