struct VectorLegalizer {
    DAG: *mut SelectionDAG,
    TLI: *TargetLowering,
    Changed: bool,
    LegalizedNodes: SmallDenseMap<SDValue, SDValue, 64>,
}

fn VectorLegalizer::AddLegalizedOperand(self, From: SDValue, To: SDValue) {
    self.LegalizedNodes.insert(make_pair(From, To));
    if From != To {
        self.LegalizedNodes.insert(make_pair(To, To));
    }
}

fn VectorLegalizer::Run(self) -> bool {
    let mut HasVectors: bool = false;
    for let mut I: allnodes_iterator = self.DAG.allnodes_begin();
let mut E: allnodes_iterator = prev(self.DAG.allnodes_end(), 1); I != next(E, 1); operator(I) {
        HasVectors = any_of(operator(I).values(), Closure_1 {});
        if HasVectors {
            break;
        }
    }
    if !HasVectors {
        return false;
    }
    self.DAG.AssignTopologicalOrder();
    for let mut I: allnodes_iterator = self.DAG.allnodes_begin();
let mut E: allnodes_iterator = prev(self.DAG.allnodes_end(), 1); I != next(E, 1); operator(I) {
        self.LegalizeOp(SDValue { Node: &mut operator(I), ResNo: 0 });
    }
    let mut OldRoot: SDValue = self.DAG.getRoot();
    assert!(self.LegalizedNodes.count(OldRoot), "Root didn't get legalized?");
    self.DAG.setRoot(self.LegalizedNodes[OldRoot]);
    self.LegalizedNodes.clear();
    self.DAG.RemoveDeadNodes();
    return self.Changed;
}

fn VectorLegalizer::TranslateLegalizeResults(self, Op: SDValue, Result: *mut SDNode) -> SDValue {
    assert!(operator(Op).getNumValues() == Result.getNumValues(), "Unexpected number of results");
    for let mut i: u32 = 0;
let mut e: u32 = operator(Op).getNumValues(); i != e; i += 1 {
        self.AddLegalizedOperand(Op.getValue(i), SDValue { Node: Result, ResNo: i });
    }
    return SDValue { Node: Result, ResNo: Op.getResNo() };
}

fn VectorLegalizer::RecursivelyLegalizeResults(self, Op: SDValue, Results: MutableArrayRef<SDValue>) -> SDValue {
    assert!(Results.len == operator(Op).getNumValues(), "Unexpected number of results");
    for let mut i: u32 = 0;
let mut e: u32 = Results.len; i != e; i += 1 {
        Results[i] = self.LegalizeOp(Results[i]);
        self.AddLegalizedOperand(Op.getValue(i), Results[i]);
    }
    return Results[Op.getResNo()];
}

fn VectorLegalizer::LegalizeOp(self, Op: SDValue) -> SDValue {
    let mut I: iterator = self.LegalizedNodes.find(Op);
    if I != self.LegalizedNodes.end() {
        return operator(I).second;
    }
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    for Oper in operator(Op).op_values() {
        Ops.push(self.LegalizeOp(Oper));
    }
    let mut Node: *mut SDNode = self.DAG.UpdateNodeOperands(Op.getNode(), ArrayRef<SDValue> { Ops });
    let mut HasVectorValueOrOp: bool = any_of(Node.values(), Closure_2 {}) || any_of(Node.op_values(), Closure_3 {});
    if !HasVectorValueOrOp {
        return self.TranslateLegalizeResults(Op, Node);
    }
    let mut Action: LegalizeAction = Legal;
    let mut ValVT: EVT = EVT {};
    match Op.getOpcode() {
        _ => {
            return self.TranslateLegalizeResults(Op, Node);
        },
        LOAD => {
            let mut LD: *mut LoadSDNode = cast(Node);
            let mut ExtType: LoadExtType = LD.getExtensionType();
            let mut LoadedVT: EVT = LD.getMemoryVT();
            if LoadedVT.isVector() && ExtType != NON_EXTLOAD {
                Action = self.TLI.getLoadAction(LD.getValueType(0), LoadedVT, LD.getAlign(), LD.getAddressSpace(), ExtType, false);
            }
            break;
        },
        STORE => {
            let mut ST: *mut StoreSDNode = cast(Node);
            let mut StVT: EVT = ST.getMemoryVT();
            let mut ValVT: MVT = ST.getValue().getSimpleValueType();
            if StVT.isVector() && ST.isTruncatingStore() {
                Action = self.TLI.getTruncStoreAction(EVT { ValVT }, StVT, ST.getAlign(), ST.getAddressSpace());
            }
            break;
        },
        MERGE_VALUES => {
            Action = self.TLI.getOperationAction(Node.getOpcode(), Node.getValueType(0));
        },
        STRICT_FADD => {
            STRICT_FSUB;
        },
        ADD => {
            SUB;
        },
        SMULFIX => {
            SMULFIXSAT;
        },
        LROUND => {
            LLROUND;
        },
        VECREDUCE_SEQ_FADD => {
            VECREDUCE_SEQ_FMUL;
        },
        SETCC => {
            let mut OpVT: MVT = Node.getOperand(0).getSimpleValueType();
            let mut CCCode: CondCode = cast(Node.getOperand(2)).get();
            Action = self.TLI.getCondCodeAction(CCCode, OpVT);
            if Action == Legal {
                Action = self.TLI.getOperationAction(Node.getOpcode(), EVT { OpVT });
            }
            break;
        },
        PARTIAL_REDUCE_UMLA => {
            PARTIAL_REDUCE_SMLA;
        },
        VP_SDIV => {
            let mut LegalizeVT: EVT = if -1 < 0 { Node.getValueType(-(1 + -1)) } else { Node.getOperand(-1).getValueType() };
            if !Node.getValueType(0).isVector() && Node.getValueType(0) != EVT { Other } {
                Action = Legal;
                break;
            }
            Action = self.TLI.getOperationAction(Node.getOpcode(), LegalizeVT);
        },
        VP_SREM => {
            let mut LegalizeVT: EVT = if -1 < 0 { Node.getValueType(-(1 + -1)) } else { Node.getOperand(-1).getValueType() };
            if !Node.getValueType(0).isVector() && Node.getValueType(0) != EVT { Other } {
                Action = Legal;
                break;
            }
            Action = self.TLI.getOperationAction(Node.getOpcode(), LegalizeVT);
        },
        VP_UDIV => {
            let mut LegalizeVT: EVT = if -1 < 0 { Node.getValueType(-(1 + -1)) } else { Node.getOperand(-1).getValueType() };
            if !Node.getValueType(0).isVector() && Node.getValueType(0) != EVT { Other } {
                Action = Legal;
                break;
            }
            Action = self.TLI.getOperationAction(Node.getOpcode(), LegalizeVT);
        },
        VP_UREM => {
            let mut LegalizeVT: EVT = if -1 < 0 { Node.getValueType(-(1 + -1)) } else { Node.getOperand(-1).getValueType() };
            if !Node.getValueType(0).isVector() && Node.getValueType(0) != EVT { Other } {
                Action = Legal;
                break;
            }
            Action = self.TLI.getOperationAction(Node.getOpcode(), LegalizeVT);
        },
        VP_CTTZ_ELTS => {
            let mut LegalizeVT: EVT = if 0 < 0 { Node.getValueType(-(1 + 0)) } else { Node.getOperand(0).getValueType() };
            if !Node.getValueType(0).isVector() && Node.getValueType(0) != EVT { Other } {
                Action = Legal;
                break;
            }
            Action = self.TLI.getOperationAction(Node.getOpcode(), LegalizeVT);
        },
        VP_CTTZ_ELTS_ZERO_POISON => {
            let mut LegalizeVT: EVT = if 0 < 0 { Node.getValueType(-(1 + 0)) } else { Node.getOperand(0).getValueType() };
            if !Node.getValueType(0).isVector() && Node.getValueType(0) != EVT { Other } {
                Action = Legal;
                break;
            }
            Action = self.TLI.getOperationAction(Node.getOpcode(), LegalizeVT);
        },
        VP_STORE => {
            let mut LegalizeVT: EVT = if 1 < 0 { Node.getValueType(-(1 + 1)) } else { Node.getOperand(1).getValueType() };
            if !Node.getValueType(0).isVector() && Node.getValueType(0) != EVT { Other } {
                Action = Legal;
