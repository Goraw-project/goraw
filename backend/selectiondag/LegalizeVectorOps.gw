        },
        VP_GATHER => {
            let mut LegalizeVT: EVT = if -1 < 0 { Node.getValueType(-(1 + -1)) } else { Node.getOperand(-1).getValueType() };
            if !Node.getValueType(0).isVector() && Node.getValueType(0) != EVT { Other } {
