struct Closure_42 {}

fn Closure_42::call(self: *Closure_42, V: SDValue) -> bool {
        return V.isUndef() || isNullOrNullSplat(V, true);
    }

struct Closure_43 {
    cap_0: EVT,
}

fn Closure_43::call(self: *Closure_43, C: *mut ConstantSDNode) -> bool {
            if C == null {
                return true;
            }
            return !C.getAPIntValue().trunc(VT.getScalarSizeInBits()).isMinSignedValue();
        }

struct Closure_44 {
    IsAdd: *mut bool,
    Op1: *mut SDValue,
    cap_2: *mut DAGCombiner,
    VT: *mut EVT,
    DL: *mut SDLoc,
    Op0: *mut SDValue,
    SrcVT: *mut EVT,
}

unsafe fn Closure_44::call(self: *mut Closure_44, AbdOpc: u32) -> SDValue {
            if (*self.IsAdd) {
                (*self.Op1) = self.DAG.getNegative((*self.Op1), SDLoc { (*self.Op1) }, (*self.VT));
            }
            let mut ABD: SDValue = self.DAG.getNode(AbdOpc, (*self.DL), (*self.VT), (*self.Op0), (*self.Op1));
            return self.DAG.getZExtOrTrunc(ABD, (*self.DL), (*self.SrcVT));
        }

struct Closure_45 {}

fn Closure_45::call(self: *Closure_45, Opcode: u32) -> bool {
        return (isExtOpcode(Opcode) || Opcode == FP_EXTEND);
    }

struct Closure_46 {
    Pred: *mut SDValue,
    cap_1: *mut DAGCombiner,
    DL: *mut SDLoc,
    OrigOp1: *mut SDValue,
}

unsafe fn Closure_46::call(self: *mut Closure_46, Op: *mut SDValue, OtherOp: *mut SDValue) {
        if (*self.Pred) {
            let mut OpVT: EVT = Op.getValueType();
            let mut Zero: SDValue = if OpVT.isFloatingPoint() { self.DAG.getConstantFP(0.0, (*self.DL), OpVT, false) } else { self.DAG.getConstant(0, (*self.DL), OpVT, false, false) };
            if (*self.OrigOp1).getOpcode() == VP_MERGE {
                Op = self.DAG.getNode(VP_MERGE, (*self.DL), OpVT, (*self.Pred), Op, Zero, (*self.OrigOp1).getOperand(3));
            } else {
                Op = self.DAG.getSelect((*self.DL), OpVT, (*self.Pred), Op, Zero, SDNodeFlags { Flags: None });
            }
            OtherOp = self.DAG.getFreeze(OtherOp);
        }
