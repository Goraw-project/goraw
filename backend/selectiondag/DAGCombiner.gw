static mut NodesCombined: Statistic = Statistic { "dagcombine", "NodesCombined", "Number of dag nodes combined" };

static mut PreIndexedNodes: Statistic = Statistic { "dagcombine", "PreIndexedNodes", "Number of pre-indexed nodes created" };

static mut PostIndexedNodes: Statistic = Statistic { "dagcombine", "PostIndexedNodes", "Number of post-indexed nodes created" };

static mut OpsNarrowed: Statistic = Statistic { "dagcombine", "OpsNarrowed", "Number of load/op/store narrowed" };

static mut LdStFP2Int: Statistic = Statistic { "dagcombine", "LdStFP2Int", "Number of fp load/store pairs transformed to int" };

static mut SlicedLoads: Statistic = Statistic { "dagcombine", "SlicedLoads", "Number of load sliced" };

static mut NumFPLogicOpsConv: Statistic = Statistic { "dagcombine", "NumFPLogicOpsConv", "Number of logic ops converted to fp ops" };

static mut DAGCombineCounter: CounterInfo = CounterInfo { "dagcombine", "Controls whether a DAG combine is performed for a node" };

static mut CombinerGlobalAA: opt<bool> = opt<bool> { "combiner-global-alias-analysis", Hidden, desc { Desc: "Enable DAG combiner's use of IR alias analysis" } };

static mut UseTBAA: opt<bool> = opt<bool> { "combiner-use-tbaa", Hidden, init(true), desc { Desc: "Enable DAG combiner's use of TBAA" } };

static mut CombinerAAOnlyFunc: string> = string> { "combiner-aa-only-func", Hidden, desc { Desc: "Only use DAG-combiner alias analysis in this function" } };

static mut StressLoadSlicing: opt<bool> = opt<bool> { "combiner-stress-load-slicing", Hidden, desc { Desc: "Bypass the profitability model of load slicing" }, init(false) };

static mut MaySplitLoadIndex: opt<bool> = opt<bool> { "combiner-split-load-index", Hidden, init(true), desc { Desc: "DAG combiner may split indexing from loads" } };

static mut EnableStoreMerging: opt<bool> = opt<bool> { "combiner-store-merging", Hidden, init(true), desc { Desc: "DAG combiner enable merging multiple stores into a wider store" } };

static mut TokenFactorInlineLimit: opt<unsigned int> = opt<unsigned int> { "combiner-tokenfactor-inline-limit", Hidden, init(2048), desc { Desc: "Limit the number of operands to inline for Token Factors" } };

static mut StoreMergeDependenceLimit: opt<unsigned int> = opt<unsigned int> { "combiner-store-merge-dependence-limit", Hidden, init(10), desc { Desc: "Limit the number of times for the same StoreNode and RootNode to bail out in store merging dependence check" } };

static mut EnableReduceLoadOpStoreWidth: opt<bool> = opt<bool> { "combiner-reduce-load-op-store-width", Hidden, init(true), desc { Desc: "DAG combiner enable reducing the width of load/op/store sequence" } };

static mut ReduceLoadOpStoreWidthForceNarrowingProfitable: opt<bool> = opt<bool> { "combiner-reduce-load-op-store-width-force-narrowing-profitable", Hidden, init(false), desc { Desc: "DAG combiner force override the narrowing profitable check when reducing the width of load/op/store sequences" } };

static mut EnableShrinkLoadReplaceStoreWithStore: opt<bool> = opt<bool> { "combiner-shrink-load-replace-store-with-store", Hidden, init(true), desc { Desc: "DAG combiner enable load/<replace bytes>/store with a narrower store" } };

static mut EnableTopologicalSorting: opt<bool> = opt<bool> { "combiner-topological-sorting", Hidden, init(false), desc { Desc: "DAG combiner nodes consistently processed in topological order" } };

static mut DisableCombines: opt<bool> = opt<bool> { "combiner-disabled", Hidden, init(false), desc { Desc: "Disable the DAG combiner" } };

struct DAGCombiner {
    DAG: *mut SelectionDAG,
    TLI: *TargetLowering,
    STI: *SelectionDAGTargetInfo,
    Level: CombineLevel,
    OptLevel: CodeGenOptLevel,
    LegalDAG: bool,
    LegalOperations: bool,
    LegalTypes: bool,
    ForCodeSize: bool,
    DisableGenericCombines: bool,
    Worklist: SmallVector<SDNode *, 64>,
    PruningList: SmallSetVector<SDNode *, 32>,
    StoreRootCountMap: pair<SDNode *, unsigned int>>,
    BatchAA: *mut BatchAAResults,
    ChainsWithoutMergeableStores: SmallPtrSet<SDNode *, 4>,
}

fn DAGCombiner::AddUsersToWorklist(self, N: *mut SDNode) {
    for Node in N.users() {
        self.AddToWorklist(Node, true, false);
    }
}

fn DAGCombiner::AddToWorklistWithUsers(self, N: *mut SDNode) {
    self.AddUsersToWorklist(N);
    self.AddToWorklist(N, true, false);
}

fn DAGCombiner::clearAddedDanglingWorklistEntries(self) {
    while !self.PruningList.is_empty() {
        let mut N: *mut SDNode = self.PruningList.pop_back_val();
        if N.use_empty() {
            self.recursivelyDeleteUnusedNodes(N);
        }
    }
}

fn DAGCombiner::getNextWorklistEntry(self) -> *mut SDNode {
    self.clearAddedDanglingWorklistEntries();
    let mut N: *mut SDNode = null;
    while !N && !self.Worklist.is_empty() {
        N = self.Worklist.pop_back_val();
    }
    if N {
        assert!(N.getCombinerWorklistIndex() >= 0, "Found a worklist entry without a corresponding map entry!");
        N.setCombinerWorklistIndex(-2);
    }
    return N;
}

fn DAGCombiner::DAGCombiner(self, D: *mut SelectionDAG, BatchAA: *mut BatchAAResults, OL: CodeGenOptLevel) {
    self.ForCodeSize = self.DAG.shouldOptForSize();
    self.DisableGenericCombines = DisableCombines || (self.STI && self.STI.disableGenericCombines(self.OptLevel));
}

fn DAGCombiner::ConsiderForPruning(self, N: *mut SDNode) {
    self.PruningList.insert(N);
}

fn DAGCombiner::AddToWorklist(self, N: *mut SDNode, IsCandidateForPruning: bool, SkipIfCombinedBefore: bool) {
    assert!(N.getOpcode() != DELETED_NODE, "Deleted Node added to Worklist");
    if N.getOpcode() == HANDLENODE {
        return;
    }
    if SkipIfCombinedBefore && N.getCombinerWorklistIndex() == -2 {
        return;
    }
    if IsCandidateForPruning {
        self.ConsiderForPruning(N);
    }
    if N.getCombinerWorklistIndex() < 0 {
        N.setCombinerWorklistIndex(self.Worklist.len);
        self.Worklist.push(N);
    }
}

fn DAGCombiner::removeFromWorklist(self, N: *mut SDNode) {
    self.PruningList.remove(N);
    self.StoreRootCountMap.erase(N);
    let mut WorklistIndex: i32 = N.getCombinerWorklistIndex();
    if WorklistIndex < 0 {
        return;
    }
    self.Worklist[WorklistIndex] = null;
    N.setCombinerWorklistIndex(-1);
}

fn DAGCombiner::CombineTo(self, N: *mut SDNode, Res: SDValue, AddTo: bool) -> SDValue {
    return self.CombineTo(N, &mut Res, 1, AddTo);
}

fn DAGCombiner::CombineTo(self, N: *mut SDNode, Res0: SDValue, Res1: SDValue, AddTo: bool) -> SDValue {
    let mut To: [2]SDValue = [Res0, Res1];
    return self.CombineTo(N, To, 2, AddTo);
}

fn DAGCombiner::CombineTo(self, N: *mut SDNode, To: *mut SmallVectorImpl<SDValue>, AddTo: bool) -> SDValue {
    return self.CombineTo(N, To.ptr, To.len, AddTo);
}

fn DAGCombiner::SimplifyDemandedBits(self, Op: SDValue) -> bool {
    let mut BitWidth: u32 = Op.getScalarValueSizeInBits();
    let mut DemandedBits: APInt = getAllOnes(BitWidth);
    return self.SimplifyDemandedBits(Op, DemandedBits);
}

fn DAGCombiner::SimplifyDemandedBits(self, Op: SDValue, DemandedBits: *APInt) -> bool {
    let mut VT: EVT = Op.getValueType();
    let mut DemandedElts: APInt = if VT.isFixedLengthVector() { getAllOnes(VT.getVectorNumElements()) } else { APInt { 1, 1, false, false } };
    return self.SimplifyDemandedBits(Op, DemandedBits, DemandedElts, false);
}

fn DAGCombiner::SimplifyDemandedVectorElts(self, Op: SDValue) -> bool {
    if Op.getValueType().isScalableVector() {
        return false;
    }
    let mut NumElts: u32 = Op.getValueType().getVectorNumElements();
    let mut DemandedElts: APInt = getAllOnes(NumElts);
    return self.SimplifyDemandedVectorElts(Op, DemandedElts, false);
}

fn DAGCombiner::getStoreSource(self, StoreVal: SDValue) -> StoreSource {
    match StoreVal.getOpcode() {
        Constant => {
            ConstantFP;
        },
        BUILD_VECTOR => {
            if isBuildVectorOfConstantSDNodes(StoreVal.getNode()) || isBuildVectorOfConstantFPSDNodes(StoreVal.getNode()) {
                return Constant;
            }
        },
        EXTRACT_VECTOR_ELT => {
            EXTRACT_SUBVECTOR;
        },
        LOAD => {
            return Load;
        },
        _ => {
            return Unknown;
        },
    }
}

fn DAGCombiner::hasOperation(self, Opcode: u32, VT: EVT) -> bool {
    return self.TLI.isOperationLegalOrCustom(Opcode, VT, self.LegalOperations);
}

fn DAGCombiner::hasUMin(self: *DAGCombiner, VT: EVT) -> bool {
    let mut LK: LegalizeKind = self.TLI.getTypeConversion(*self.DAG.getContext(), VT);
    return (LK.first == TypeLegal || LK.first == TypePromoteInteger) && self.TLI.isOperationLegalOrCustom(UMIN, LK.second, false);
}

fn DAGCombiner::getDAG(self: *DAGCombiner) -> *mut SelectionDAG {
    return self.DAG;
}

fn DAGCombiner::getShiftAmountTy(self, LHSTy: EVT) -> EVT {
    return self.TLI.getShiftAmountTy(LHSTy, self.DAG.getDataLayout());
}

fn DAGCombiner::isTypeLegal(self, VT: *EVT) -> bool {
    if !self.LegalTypes {
        return true;
    }
    return self.TLI.isTypeLegal(VT);
}

fn DAGCombiner::getSetCCResultType(self: *DAGCombiner, VT: EVT) -> EVT {
    return self.TLI.getSetCCResultType(self.DAG.getDataLayout(), *self.DAG.getContext(), VT);
}

struct WorklistRemover {
    DC: *mut DAGCombiner,
}

fn WorklistRemover::NodeDeleted(self, N: *mut SDNode, E: *mut SDNode) {
    self.DC.removeFromWorklist(N);
}

struct WorklistInserter {
    DC: *mut DAGCombiner,
}

fn WorklistInserter::NodeInserted(self, N: *mut SDNode) {
    self.DC.ConsiderForPruning(N);
}

fn DAGCombinerInfo@TargetLowering@llvm::AddToWorklist(self, N: *mut SDNode) {
    (self.DC as *mut DAGCombiner).AddToWorklist(N, true, false);
}

fn DAGCombinerInfo@TargetLowering@llvm::CombineTo(self, N: *mut SDNode, To: ArrayRef<SDValue>, AddTo: bool) -> SDValue {
    return (self.DC as *mut DAGCombiner).CombineTo(N, &mut To[0], To.len, AddTo);
}

fn DAGCombinerInfo@TargetLowering@llvm::CombineTo(self, N: *mut SDNode, Res: SDValue, AddTo: bool) -> SDValue {
    return (self.DC as *mut DAGCombiner).CombineTo(N, Res, AddTo);
}

fn DAGCombinerInfo@TargetLowering@llvm::CombineTo(self, N: *mut SDNode, Res0: SDValue, Res1: SDValue, AddTo: bool) -> SDValue {
    return (self.DC as *mut DAGCombiner).CombineTo(N, Res0, Res1, AddTo);
}

fn DAGCombinerInfo@TargetLowering@llvm::recursivelyDeleteUnusedNodes(self, N: *mut SDNode) -> bool {
    return (self.DC as *mut DAGCombiner).recursivelyDeleteUnusedNodes(N);
}

fn DAGCombinerInfo@TargetLowering@llvm::CommitTargetLoweringOpt(self, TLO: *TargetLoweringOpt) {
    return (self.DC as *mut DAGCombiner).CommitTargetLoweringOpt(TLO);
}

fn DAGCombiner::deleteAndRecombine(self, N: *mut SDNode) {
    self.removeFromWorklist(N);
    for Op in N.ops() {
        if operator(Op).hasOneUse() || operator(Op).getNumValues() > 1 {
            self.AddToWorklist(Op.getNode(), true, false);
        }
    }
    self.DAG.DeleteNode(N);
}

fn zeroExtendToMatch(LHS: *mut APInt, RHS: *mut APInt, Offset: u32) {
    let mut Bits: u32 = Offset + if LHS.getBitWidth() > RHS.getBitWidth() { LHS.getBitWidth() } else { RHS.getBitWidth() };
    LHS = LHS.zext(Bits);
    RHS = RHS.zext(Bits);
}

fn DAGCombiner::isSetCCEquivalent(self: *DAGCombiner, N: SDValue, LHS: *mut SDValue, RHS: *mut SDValue, CC: *mut SDValue, MatchStrict: bool) -> bool {
    if N.getOpcode() == SETCC {
        LHS = N.getOperand(0);
        RHS = N.getOperand(1);
        CC = N.getOperand(2);
        return true;
    }
    if MatchStrict && (N.getOpcode() == STRICT_FSETCC || N.getOpcode() == STRICT_FSETCCS) {
        LHS = N.getOperand(1);
        RHS = N.getOperand(2);
        CC = N.getOperand(3);
        return true;
    }
    if N.getOpcode() != SELECT_CC || !self.TLI.isConstTrueVal(N.getOperand(2)) || !self.TLI.isConstFalseVal(N.getOperand(3)) {
        return false;
    }
    if self.TLI.getBooleanContents(N.getValueType()) == UndefinedBooleanContent {
        return false;
    }
    LHS = N.getOperand(0);
    RHS = N.getOperand(1);
    CC = N.getOperand(4);
    return true;
}

fn DAGCombiner::isOneUseSetCC(self: *DAGCombiner, N: SDValue) -> bool {
    let mut N0: SDValue = SDValue {};
    let mut N1: SDValue = SDValue {};
    let mut N2: SDValue = SDValue {};
    if self.isSetCCEquivalent(N, N0, N1, N2, false) && operator(N).hasOneUse() {
        return true;
    }
    return false;
}

fn isConstantSplatVectorMaskForType(N: *mut SDNode, ScalarTy: EVT) -> bool {
    if !ScalarTy.isSimple() {
        return false;
    }
    let mut MaskForTy: u64 = 0;
    match ScalarTy.getSimpleVT().SimpleTy {
        i8 => {
            MaskForTy = 255;
        },
        i16 => {
            MaskForTy = 65535;
        },
        i32 => {
            MaskForTy = 4294967295;
        },
        _ => {
            return false;
        },
    }
    let mut Val: APInt = APInt {};
    if isConstantSplatVector(N, Val) {
        return Val.getLimitedValue(18446744073709551615) == MaskForTy;
    }
    return false;
}

fn isConstantOrConstantVector(N: SDValue, NoOpaques: bool, AllowTruncation: bool) -> bool {
    if dyn_cast(N) {
        Const;
    } else {
        return !(Const.isOpaque() && NoOpaques);
    }
    if N.getOpcode() != BUILD_VECTOR && N.getOpcode() != SPLAT_VECTOR {
        return false;
    }
    let mut BitWidth: u32 = N.getScalarValueSizeInBits();
    for Op in operator(N).op_values() {
        if Op.isUndef() {
            continue;
        }
        let mut Const: *mut ConstantSDNode = dyn_cast(Op);
        if !Const || (Const.isOpaque() && NoOpaques) {
            return false;
        }
        if (AllowTruncation && Const.getAPIntValue().getActiveBits() > BitWidth) || (!AllowTruncation && Const.getAPIntValue().getBitWidth() != BitWidth) {
            return false;
        }
    }
    return true;
}

fn isAnyConstantBuildVector(V: SDValue, NoOpaques: bool) -> bool {
    if V.getOpcode() != BUILD_VECTOR {
        return false;
    }
    return isConstantOrConstantVector(V, NoOpaques, false) || isBuildVectorOfConstantFPSDNodes(V.getNode());
}

fn canSplitIdx(LD: *mut LoadSDNode) -> bool {
    return MaySplitLoadIndex && (LD.getOperand(2).getOpcode() != TargetConstant || !cast(LD.getOperand(2)).isOpaque());
}

fn DAGCombiner::reassociationCanBreakAddressingModePattern(self, Opc: u32, DL: *SDLoc, N: *mut SDNode, N0: SDValue, N1: SDValue) -> bool {
    if !N0.isAnyAdd() {
        return false;
    }
    if (N1.getOpcode() == VSCALE || ((N1.getOpcode() == SHL || N1.getOpcode() == MUL) && N1.getOperand(0).getOpcode() == VSCALE && isa(N1.getOperand(1)))) && N1.getValueType().getFixedSizeInBits() <= 64 {
        let mut ScalableOffset: i64 = if N1.getOpcode() == VSCALE { N1.getConstantOperandVal(0) } else { (N1.getOperand(0).getConstantOperandVal(0) * (if N1.getOpcode() == SHL { (1 << N1.getConstantOperandVal(1)) } else { N1.getConstantOperandVal(1) })) };
        if Opc == SUB {
            ScalableOffset = -ScalableOffset;
        }
        if all_of(N.users(), Closure_1 { N: &mut N, ScalableOffset: &mut ScalableOffset, cap_2: self }) {
            return true;
        }
    }
    if Opc != ADD && Opc != PTRADD {
        return false;
    }
    let mut C2: *mut ConstantSDNode = dyn_cast(N1);
    if !C2 {
        return false;
    }
    let mut C2APIntVal: *APInt = C2.getAPIntValue();
    if C2APIntVal.getSignificantBits() > 64 {
        return false;
    }
    if dyn_cast(N0.getOperand(1)) {
        C1;
    } else {
        if N0.hasOneUse() {
            return false;
        }
        let mut C1APIntVal: *APInt = C1.getAPIntValue();
        let mut CombinedValueIntVal: APInt = C1APIntVal + C2APIntVal;
        if CombinedValueIntVal.getSignificantBits() > 64 {
            return false;
        }
        let mut CombinedValue: i64 = CombinedValueIntVal.getSExtValue();
        for Node in N.users() {
            if dyn_cast(Node) {
                LoadStore;
            } else {
                if !LoadStore.hasUniqueMemOperand() {
                    continue;
                }
                let mut AM: AddrMode = AddrMode {};
                AM.HasBaseReg = true;
                AM.BaseOffs = C2APIntVal.getSExtValue();
                let mut VT: EVT = LoadStore.getMemoryVT();
                let mut AS: u32 = LoadStore.getAddressSpace();
                let mut AccessTy: *mut Type = VT.getTypeForEVT(*self.DAG.getContext());
                if !self.TLI.isLegalAddressingMode(self.DAG.getDataLayout(), AM, AccessTy, AS, null) {
                    continue;
                }
                AM.BaseOffs = CombinedValue;
                if !self.TLI.isLegalAddressingMode(self.DAG.getDataLayout(), AM, AccessTy, AS, null) {
                    return true;
                }
            }
        }
    }
    return false;
}

fn DAGCombiner::reassociateOpsCommutative(self, Opc: u32, DL: *SDLoc, N0: SDValue, N1: SDValue, Flags: SDNodeFlags) -> SDValue {
    let mut VT: EVT = N0.getValueType();
    if N0.getOpcode() != Opc {
        return SDValue {};
    }
    let mut N00: SDValue = N0.getOperand(0);
    let mut N01: SDValue = N0.getOperand(1);
    if self.DAG.isConstantIntBuildVectorOrConstantInt(N01, true) {
        let mut NewFlags: SDNodeFlags = SDNodeFlags { Flags: None };
        if N0.getOpcode() == ADD && operator(N0).getFlags().hasNoUnsignedWrap() && Flags.hasNoUnsignedWrap() {
            operator(NewFlags, SDNodeFlags { Flags: NoUnsignedWrap });
        }
        if self.DAG.isConstantIntBuildVectorOrConstantInt(N1, true) {
            if self.DAG.FoldConstantArithmetic(Opc, DL, VT, ArrayRef<SDValue> { [N01, N1] }, SDNodeFlags { Flags: None }) {
                OpNode;
            } else {
                NewFlags.setDisjoint(Flags.hasDisjoint() && operator(N0).getFlags().hasDisjoint());
                return self.DAG.getNode(Opc, DL, VT, N00, OpNode, NewFlags);
            }
            return SDValue {};
        }
        if self.TLI.isReassocProfitable(self.DAG, N0, N1) {
            let mut OpNode: SDValue = self.DAG.getNode(Opc, SDLoc { N0 }, VT, N00, N1, NewFlags);
            return self.DAG.getNode(Opc, DL, VT, OpNode, N01, NewFlags);
        }
    }
    if Opc == AND || Opc == OR {
        if N1 == N00 || N1 == N01 {
            return N0;
        }
    }
    if Opc == XOR {
        if N1 == N00 {
            return N01;
        }
        if N1 == N01 {
            return N00;
        }
    }
    if self.TLI.isReassocProfitable(self.DAG, N0, N1) {
        if N1 != N01 {
            if self.DAG.getNodeIfExists(Opc, self.DAG.getVTList(VT), ArrayRef<SDValue> { [N00, N1] }, false) {
                NE;
            } else {
                if !self.DAG.doesNodeExist(Opc, self.DAG.getVTList(VT), ArrayRef<SDValue> { [SDValue { Node: NE, ResNo: 0 }, N01] }) {
                    return self.DAG.getNode(Opc, DL, VT, SDValue { Node: NE, ResNo: 0 }, N01);
                }
            }
        }
        if N1 != N00 {
            if self.DAG.getNodeIfExists(Opc, self.DAG.getVTList(VT), ArrayRef<SDValue> { [N01, N1] }, false) {
                NE;
            } else {
                if !self.DAG.doesNodeExist(Opc, self.DAG.getVTList(VT), ArrayRef<SDValue> { [SDValue { Node: NE, ResNo: 0 }, N00] }) {
                    return self.DAG.getNode(Opc, DL, VT, SDValue { Node: NE, ResNo: 0 }, N00);
                }
            }
        }
        if Opc == AND || Opc == OR {
            if operator(N1).getOpcode() == SETCC && operator(N00).getOpcode() == SETCC && operator(N01).getOpcode() == SETCC {
                let mut CC1: CondCode = cast(N1.getOperand(2)).get();
                let mut CC00: CondCode = cast(N00.getOperand(2)).get();
                let mut CC01: CondCode = cast(N01.getOperand(2)).get();
                if CC1 == CC00 && CC1 != CC01 {
                    let mut OpNode: SDValue = self.DAG.getNode(Opc, SDLoc { N0 }, VT, N00, N1, Flags);
                    return self.DAG.getNode(Opc, DL, VT, OpNode, N01, Flags);
                }
                if CC1 == CC01 && CC1 != CC00 {
                    let mut OpNode: SDValue = self.DAG.getNode(Opc, SDLoc { N0 }, VT, N01, N1, Flags);
                    return self.DAG.getNode(Opc, DL, VT, OpNode, N00, Flags);
                }
            }
        }
    }
    return SDValue {};
}

fn DAGCombiner::reassociateOps(self, Opc: u32, DL: *SDLoc, N0: SDValue, N1: SDValue, Flags: SDNodeFlags) -> SDValue {
    assert!(self.TLI.isCommutativeBinOp(Opc), "Operation not commutative.");
    if N0.getValueType().isFloatingPoint() || N1.getValueType().isFloatingPoint() {
        if !Flags.hasAllowReassociation() || !Flags.hasNoSignedZeros() {
            return SDValue {};
        }
    }
    if self.reassociateOpsCommutative(Opc, DL, N0, N1, Flags) {
        Combined;
    } else {
        return Combined;
    }
    if self.reassociateOpsCommutative(Opc, DL, N1, N0, Flags) {
        Combined;
    } else {
        return Combined;
    }
    return SDValue {};
}

fn DAGCombiner::reassociateReduction(self, RedOpc: u32, Opc: u32, DL: *SDLoc, VT: EVT, N0: SDValue, N1: SDValue, Flags: SDNodeFlags) -> SDValue {
    if N0.getOpcode() == RedOpc && N1.getOpcode() == RedOpc && N0.getOperand(0).getValueType() == N1.getOperand(0).getValueType() && operator(N0).hasOneUse() && operator(N1).hasOneUse() && self.TLI.isOperationLegalOrCustom(Opc, N0.getOperand(0).getValueType(), false) && self.TLI.shouldReassociateReduction(RedOpc, N0.getOperand(0).getValueType()) {
        let mut FlagsInserter: FlagInserter = FlagInserter { self.DAG, Flags };
        return self.DAG.getNode(RedOpc, DL, VT, self.DAG.getNode(Opc, DL, N0.getOperand(0).getValueType(), N0.getOperand(0), N1.getOperand(0)));
    }
    let mut A: SDValue = SDValue {};
    let mut B: SDValue = SDValue {};
    let mut C: SDValue = SDValue {};
    let mut D: SDValue = SDValue {};
    let mut RedA: SDValue = SDValue {};
    let mut RedB: SDValue = SDValue {};
    if sd_match(N0, m_OneUse(m_c_BinOp(Opc, m_Value(RedA, m_OneUse(m_UnaryOp(RedOpc, m_Value(A)))), m_Value(B, m_Unless(m_UnaryOp(RedOpc, m_Value()))), SDNodeFlags { Flags: None }))) && sd_match(N1, m_OneUse(m_c_BinOp(Opc, m_Value(RedB, m_OneUse(m_UnaryOp(RedOpc, m_Value(C)))), m_Value(D, m_Unless(m_UnaryOp(RedOpc, m_Value()))), SDNodeFlags { Flags: None }))) && A.getValueType() == C.getValueType() && self.hasOperation(Opc, A.getValueType()) && self.TLI.shouldReassociateReduction(RedOpc, VT) {
        if (Opc == FADD || Opc == FMUL) && (!operator(N0).getFlags().hasAllowReassociation() || !operator(N1).getFlags().hasAllowReassociation() || !operator(RedA).getFlags().hasAllowReassociation() || !operator(RedB).getFlags().hasAllowReassociation()) {
            return SDValue {};
        }
        let mut FlagsInserter: FlagInserter = FlagInserter { self.DAG, Flags & operator(N0).getFlags() & operator(N1).getFlags() & operator(RedA).getFlags() & operator(RedB).getFlags() };
        let mut Op: SDValue = self.DAG.getNode(Opc, DL, A.getValueType(), A, C);
        let mut Red: SDValue = self.DAG.getNode(RedOpc, DL, VT, Op);
        let mut Op2: SDValue = self.DAG.getNode(Opc, DL, VT, B, D);
        return self.DAG.getNode(Opc, DL, VT, Red, Op2);
    }
    let mut FoldReductionChain: Closure_2 = Closure_2 { RedOpc: &mut RedOpc, Opc: &mut Opc, cap_2: self, VT: &mut VT, Flags: &mut Flags, DL: &mut DL };
    if FoldReductionChain.call(N0, N1) {
        V;
    } else {
        return V;
    }
    if FoldReductionChain.call(N1, N0) {
        V;
    } else {
        return V;
    }
    return SDValue {};
}

fn DAGCombiner::CombineTo(self, N: *mut SDNode, To: *SDValue, NumTo: u32, AddTo: bool) -> SDValue {
    assert!(N.getNumValues() == NumTo, "Broken CombineTo call!");
    operator(NodesCombined);
    while true {
        {
        if DebugFlag && isCurrentDebugType("dagcombine", 1) {
            dbgs() << "\nReplacing.1 ";
            N.dump(&mut self.DAG);
            dbgs() << "\nWith: ";
            To[0].dump(&mut self.DAG);
            dbgs() << " and " << NumTo - 1 << " other values\n";
        }
    }
        if !(false) { break; }
    }
    for let mut i: u32 = 0;
let mut e: u32 = NumTo; i != e; i += 1 {
        assert!((!To[i].getNode() || N.getValueType(i) == To[i].getValueType()), "Cannot combine value to value of different type!");
    }
    let mut DeadNodes: WorklistRemover = WorklistRemover { DC: *self };
    self.DAG.ReplaceAllUsesWith(N, To);
    if AddTo {
        for let mut i: u32 = 0;
let mut e: u32 = NumTo; i != e; i += 1 {
            if To[i].getNode() {
                self.AddToWorklistWithUsers(To[i].getNode());
            }
        }
    }
    if N.use_empty() {
        self.deleteAndRecombine(N);
    }
    return SDValue { Node: N, ResNo: 0 };
}

fn DAGCombiner::CommitTargetLoweringOpt(self, TLO: *TargetLoweringOpt) {
    operator(NodesCombined);
    while true {
        {
        if DebugFlag && isCurrentDebugType("dagcombine", 1) {
            dbgs() << "\nReplacing.2 ";
            TLO.Old.dump(&mut self.DAG);
            dbgs() << "\nWith: ";
            TLO.New.dump(&mut self.DAG);
            dbgs() << 10;
        }
    }
        if !(false) { break; }
    }
    self.DAG.ReplaceAllUsesOfValueWith(TLO.Old, TLO.New);
    self.AddToWorklistWithUsers(TLO.New.getNode());
    self.recursivelyDeleteUnusedNodes(TLO.Old.getNode());
}

fn DAGCombiner::SimplifyDemandedBits(self, Op: SDValue, DemandedBits: *APInt, DemandedElts: *APInt, AssumeSingleUse: bool) -> bool {
    let mut TLO: TargetLoweringOpt = TargetLoweringOpt { self.DAG, self.LegalTypes, self.LegalOperations };
    let mut Known: KnownBits = KnownBits {};
    if !self.TLI.SimplifyDemandedBits(Op, DemandedBits, DemandedElts, Known, TLO, 0, AssumeSingleUse) {
        return false;
    }
    self.AddToWorklist(Op.getNode(), true, false);
    self.CommitTargetLoweringOpt(TLO);
    return true;
}

fn DAGCombiner::SimplifyDemandedVectorElts(self, Op: SDValue, DemandedElts: *APInt, AssumeSingleUse: bool) -> bool {
    let mut TLO: TargetLoweringOpt = TargetLoweringOpt { self.DAG, self.LegalTypes, self.LegalOperations };
    let mut KnownUndef: APInt = APInt {};
    let mut KnownZero: APInt = APInt {};
    if !self.TLI.SimplifyDemandedVectorElts(Op, DemandedElts, KnownUndef, KnownZero, TLO, 0, AssumeSingleUse) {
        return false;
    }
    self.AddToWorklist(Op.getNode(), true, false);
    self.CommitTargetLoweringOpt(TLO);
    return true;
}

fn DAGCombiner::ReplaceLoadWithPromotedLoad(self, Load: *mut SDNode, ExtLoad: *mut SDNode) {
    let mut DL: SDLoc = SDLoc { Load };
    let mut VT: EVT = Load.getValueType(0);
    let mut Trunc: SDValue = self.DAG.getNode(TRUNCATE, DL, VT, SDValue { Node: ExtLoad, ResNo: 0 });
    while true {
        {
        if DebugFlag && isCurrentDebugType("dagcombine", 1) {
            dbgs() << "\nReplacing.9 ";
            Load.dump(&mut self.DAG);
            dbgs() << "\nWith: ";
            Trunc.dump(&mut self.DAG);
            dbgs() << 10;
        }
    }
        if !(false) { break; }
    }
    self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: Load, ResNo: 0 }, Trunc);
    self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: Load, ResNo: 1 }, SDValue { Node: ExtLoad, ResNo: 1 });
    self.AddToWorklist(Trunc.getNode(), true, false);
    self.recursivelyDeleteUnusedNodes(Load);
}

fn DAGCombiner::PromoteOperand(self, Op: SDValue, PVT: EVT, Replace: *mut bool) -> SDValue {
    Replace = false;
    let mut DL: SDLoc = SDLoc { Op };
    if isUNINDEXEDLoad(Op.getNode()) {
        let mut LD: *mut LoadSDNode = cast(Op);
        let mut MemVT: EVT = LD.getMemoryVT();
        let mut ExtType: LoadExtType = if isNON_EXTLoad(LD) { EXTLOAD } else { LD.getExtensionType() };
        Replace = true;
        return self.DAG.getExtLoad(ExtType, DL, PVT, LD.getChain(), LD.getBasePtr(), MemVT, LD.getMemOperand());
    }
    let mut Opc: u32 = Op.getOpcode();
    match Opc {
        _ => {
            break;
        },
        AssertSext => {
            if self.SExtPromoteOperand(Op.getOperand(0), PVT) {
                Op0;
            } else {
                return self.DAG.getNode(AssertSext, DL, PVT, Op0, Op.getOperand(1));
            }
        },
        AssertZext => {
            if self.ZExtPromoteOperand(Op.getOperand(0), PVT) {
                Op0;
            } else {
                return self.DAG.getNode(AssertZext, DL, PVT, Op0, Op.getOperand(1));
            }
        },
        Constant => {
            let mut ExtOpc: u32 = if Op.getValueType().isByteSized() { SIGN_EXTEND } else { ZERO_EXTEND };
            return self.DAG.getNode(ExtOpc, DL, PVT, Op);
        },
    }
    if !self.TLI.isOperationLegal(ANY_EXTEND, PVT) {
        return SDValue {};
    }
    return self.DAG.getNode(ANY_EXTEND, DL, PVT, Op);
}

fn DAGCombiner::SExtPromoteOperand(self, Op: SDValue, PVT: EVT) -> SDValue {
    if !self.TLI.isOperationLegal(SIGN_EXTEND_INREG, PVT) {
        return SDValue {};
    }
    let mut OldVT: EVT = Op.getValueType();
    let mut DL: SDLoc = SDLoc { Op };
    let mut Replace: bool = false;
    let mut NewOp: SDValue = self.PromoteOperand(Op, PVT, Replace);
    if !NewOp.getNode() {
        return SDValue {};
    }
    self.AddToWorklist(NewOp.getNode(), true, false);
    if Replace {
        self.ReplaceLoadWithPromotedLoad(Op.getNode(), NewOp.getNode());
    }
    return self.DAG.getNode(SIGN_EXTEND_INREG, DL, NewOp.getValueType(), NewOp, self.DAG.getValueType(OldVT));
}

fn DAGCombiner::ZExtPromoteOperand(self, Op: SDValue, PVT: EVT) -> SDValue {
    let mut OldVT: EVT = Op.getValueType();
    let mut DL: SDLoc = SDLoc { Op };
    let mut Replace: bool = false;
    let mut NewOp: SDValue = self.PromoteOperand(Op, PVT, Replace);
    if !NewOp.getNode() {
        return SDValue {};
    }
    self.AddToWorklist(NewOp.getNode(), true, false);
    if Replace {
        self.ReplaceLoadWithPromotedLoad(Op.getNode(), NewOp.getNode());
    }
    return self.DAG.getZeroExtendInReg(NewOp, DL, OldVT);
}

fn DAGCombiner::PromoteIntBinOp(self, Op: SDValue) -> SDValue {
    if !self.LegalOperations {
        return SDValue {};
    }
    let mut VT: EVT = Op.getValueType();
    if VT.isVector() || !VT.isInteger() {
        return SDValue {};
    }
    let mut Opc: u32 = Op.getOpcode();
    if self.TLI.isTypeDesirableForOp(Opc, VT) {
        return SDValue {};
    }
    let mut PVT: EVT = VT;
    if self.TLI.IsDesirableToPromoteOp(Op, PVT) {
        assert!(PVT != VT, "Don't know what type to promote to!");
        while true {
            {
            if DebugFlag && isCurrentDebugType("dagcombine", 1) {
                dbgs() << "\nPromoting ";
                Op.dump(&mut self.DAG);
            }
        }
            if !(false) { break; }
        }
        let mut Replace0: bool = false;
        let mut N0: SDValue = Op.getOperand(0);
        let mut NN0: SDValue = self.PromoteOperand(N0, PVT, Replace0);
        let mut Replace1: bool = false;
        let mut N1: SDValue = Op.getOperand(1);
        let mut NN1: SDValue = self.PromoteOperand(N1, PVT, Replace1);
        let mut DL: SDLoc = SDLoc { Op };
        let mut RV: SDValue = self.DAG.getNode(TRUNCATE, DL, VT, self.DAG.getNode(Opc, DL, PVT, NN0, NN1));
        Replace0 &= !operator(N0).hasOneUse();
        Replace1 &= (N0 != N1) && !operator(N1).hasOneUse();
        self.CombineTo(Op.getNode(), RV, true);
        if Replace0 && Replace1 && operator(N0).isPredecessorOf(N1.getNode()) {
            swap(N0, N1);
            swap(NN0, NN1);
        }
        if Replace0 {
            self.AddToWorklist(NN0.getNode(), true, false);
            self.ReplaceLoadWithPromotedLoad(N0.getNode(), NN0.getNode());
        }
        if Replace1 {
            self.AddToWorklist(NN1.getNode(), true, false);
            self.ReplaceLoadWithPromotedLoad(N1.getNode(), NN1.getNode());
        }
        return Op;
    }
    return SDValue {};
}

fn DAGCombiner::PromoteIntShiftOp(self, Op: SDValue) -> SDValue {
    if !self.LegalOperations {
        return SDValue {};
    }
    let mut VT: EVT = Op.getValueType();
    if VT.isVector() || !VT.isInteger() {
        return SDValue {};
    }
    let mut Opc: u32 = Op.getOpcode();
    if self.TLI.isTypeDesirableForOp(Opc, VT) {
        return SDValue {};
    }
    let mut PVT: EVT = VT;
    if self.TLI.IsDesirableToPromoteOp(Op, PVT) {
        assert!(PVT != VT, "Don't know what type to promote to!");
        while true {
            {
            if DebugFlag && isCurrentDebugType("dagcombine", 1) {
                dbgs() << "\nPromoting ";
                Op.dump(&mut self.DAG);
            }
        }
            if !(false) { break; }
        }
        let mut TruncFlags: SDNodeFlags = SDNodeFlags { Flags: None };
        let mut Replace: bool = false;
        let mut N0: SDValue = Op.getOperand(0);
        if Opc == SRA {
            N0 = self.SExtPromoteOperand(N0, PVT);
        } else if Opc == SRL {
            N0 = self.ZExtPromoteOperand(N0, PVT);
        } else {
            if operator(Op).getFlags().hasNoUnsignedWrap() {
                N0 = self.ZExtPromoteOperand(N0, PVT);
                TruncFlags = SDNodeFlags { Flags: NoUnsignedWrap };
            } else if operator(Op).getFlags().hasNoSignedWrap() {
                N0 = self.SExtPromoteOperand(N0, PVT);
                TruncFlags = SDNodeFlags { Flags: NoSignedWrap };
            } else {
                N0 = self.PromoteOperand(N0, PVT, Replace);
            }
        }
        if !N0.getNode() {
            return SDValue {};
        }
        let mut DL: SDLoc = SDLoc { Op };
        let mut N1: SDValue = Op.getOperand(1);
        let mut RV: SDValue = self.DAG.getNode(TRUNCATE, DL, VT, self.DAG.getNode(Opc, DL, PVT, N0, N1), TruncFlags);
        if Replace {
            self.ReplaceLoadWithPromotedLoad(Op.getOperand(0).getNode(), N0.getNode());
        }
        if Op && Op.getOpcode() != DELETED_NODE {
            return RV;
        }
    }
    return SDValue {};
}

fn DAGCombiner::PromoteExtend(self, Op: SDValue) -> SDValue {
    if !self.LegalOperations {
        return SDValue {};
    }
    let mut VT: EVT = Op.getValueType();
    if VT.isVector() || !VT.isInteger() {
        return SDValue {};
    }
    let mut Opc: u32 = Op.getOpcode();
    if self.TLI.isTypeDesirableForOp(Opc, VT) {
        return SDValue {};
    }
    let mut PVT: EVT = VT;
    if self.TLI.IsDesirableToPromoteOp(Op, PVT) {
        assert!(PVT != VT, "Don't know what type to promote to!");
        while true {
            {
            if DebugFlag && isCurrentDebugType("dagcombine", 1) {
                dbgs() << "\nPromoting ";
                Op.dump(&mut self.DAG);
            }
        }
            if !(false) { break; }
        }
        return self.DAG.getNode(Op.getOpcode(), SDLoc { Op }, VT, Op.getOperand(0));
    }
    return SDValue {};
}

fn DAGCombiner::PromoteLoad(self, Op: SDValue) -> bool {
    if !self.LegalOperations {
        return false;
    }
    if !isUNINDEXEDLoad(Op.getNode()) {
        return false;
    }
    let mut VT: EVT = Op.getValueType();
    if VT.isVector() || !VT.isInteger() {
        return false;
    }
    let mut Opc: u32 = Op.getOpcode();
    if self.TLI.isTypeDesirableForOp(Opc, VT) {
        return false;
    }
    let mut PVT: EVT = VT;
    if self.TLI.IsDesirableToPromoteOp(Op, PVT) {
        assert!(PVT != VT, "Don't know what type to promote to!");
        let mut DL: SDLoc = SDLoc { Op };
        let mut N: *mut SDNode = Op.getNode();
        let mut LD: *mut LoadSDNode = cast(N);
        let mut MemVT: EVT = LD.getMemoryVT();
        let mut ExtType: LoadExtType = if isNON_EXTLoad(LD) { EXTLOAD } else { LD.getExtensionType() };
        let mut NewLD: SDValue = self.DAG.getExtLoad(ExtType, DL, PVT, LD.getChain(), LD.getBasePtr(), MemVT, LD.getMemOperand());
        let mut Result: SDValue = self.DAG.getNode(TRUNCATE, DL, VT, NewLD);
        while true {
            {
            if DebugFlag && isCurrentDebugType("dagcombine", 1) {
                dbgs() << "\nPromoting ";
                N.dump(&mut self.DAG);
                dbgs() << "\nTo: ";
                Result.dump(&mut self.DAG);
                dbgs() << 10;
            }
        }
            if !(false) { break; }
        }
        self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: N, ResNo: 0 }, Result);
        self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: N, ResNo: 1 }, NewLD.getValue(1));
        self.AddToWorklist(Result.getNode(), true, false);
        self.recursivelyDeleteUnusedNodes(N);
        return true;
    }
    return false;
}

fn DAGCombiner::recursivelyDeleteUnusedNodes(self, N: *mut SDNode) -> bool {
    if !N.use_empty() {
        return false;
    }
    let mut Nodes: SmallSetVector<SDNode *, 16> = SmallSetVector<SDNode *, 16> {};
    Nodes.insert(N);
    while true {
        {
        N = Nodes.pop_back_val();
        if !N {
            continue;
        }
        if N.use_empty() {
            for ChildN in N.op_values() {
                Nodes.insert(ChildN.getNode());
            }
            self.removeFromWorklist(N);
            self.DAG.DeleteNode(N);
        } else {
            self.AddToWorklist(N, true, false);
        }
    }
        if !(!Nodes.is_empty()) { break; }
    }
    return true;
}

fn DAGCombiner::Run(self, AtLevel: CombineLevel) {
    self.Level = AtLevel;
    self.LegalDAG = self.Level >= AfterLegalizeDAG;
    self.LegalOperations = self.Level >= AfterLegalizeVectorOps;
    self.LegalTypes = self.Level >= AfterLegalizeTypes;
    let mut UseTopologicalSorting: bool = if EnableTopologicalSorting.getNumOccurrences() > 0 { EnableTopologicalSorting } else { self.TLI.useTopologicalSorting() };
    let mut AddNodes: WorklistInserter = WorklistInserter { DC: *self };
    if UseTopologicalSorting {
        self.DAG.AssignTopologicalOrder();
    }
    if UseTopologicalSorting {
        for Node in reverse(self.DAG.allnodes()) {
            self.AddToWorklist(&mut Node, Node.use_empty(), false);
        }
    } else {
        for Node in self.DAG.allnodes() {
            self.AddToWorklist(&mut Node, Node.use_empty(), false);
        }
    }
    let mut Dummy: HandleSDNode = HandleSDNode { self.DAG.getRoot() };
    while self.getNextWorklistEntry() {
        N;
    }
    self.DAG.setRoot(Dummy.getValue());
    self.DAG.RemoveDeadNodes();
}

fn DAGCombiner::visit(self, N: *mut SDNode) -> SDValue {
    match N.getOpcode() {
        _ => {
            break;
        },
        TokenFactor => {
            return self.visitTokenFactor(N);
        },
        MERGE_VALUES => {
            return self.visitMERGE_VALUES(N);
        },
        ADD => {
            return self.visitADD(N);
        },
        PTRADD => {
            return self.visitPTRADD(N);
        },
        SUB => {
            return self.visitSUB(N);
        },
        SADDSAT => {
            UADDSAT;
        },
        SSUBSAT => {
            USUBSAT;
        },
        ADDC => {
            return self.visitADDC(N);
        },
        SADDO => {
            UADDO;
        },
        SUBC => {
            return self.visitSUBC(N);
        },
        SSUBO => {
            USUBO;
        },
        ADDE => {
            return self.visitADDE(N);
        },
        UADDO_CARRY => {
            return self.visitUADDO_CARRY(N);
        },
        SADDO_CARRY => {
            return self.visitSADDO_CARRY(N);
        },
        SUBE => {
            return self.visitSUBE(N);
        },
        USUBO_CARRY => {
            return self.visitUSUBO_CARRY(N);
        },
        SSUBO_CARRY => {
            return self.visitSSUBO_CARRY(N);
        },
        SMULFIX => {
            SMULFIXSAT;
        },
        MUL => {
            return self.visitMUL(N);
        },
        SDIV => {
            return self.visitSDIV(N);
        },
        UDIV => {
            return self.visitUDIV(N);
        },
        SREM => {
            UREM;
        },
        MULHU => {
            return self.visitMULHU(N);
        },
        MULHS => {
            return self.visitMULHS(N);
        },
        AVGFLOORS => {
            AVGFLOORU;
        },
        ABDS => {
            ABDU;
        },
        SMUL_LOHI => {
            return self.visitSMUL_LOHI(N);
        },
        UMUL_LOHI => {
            return self.visitUMUL_LOHI(N);
        },
        SMULO => {
            UMULO;
        },
        SMIN => {
            SMAX;
        },
        AND => {
            return self.visitAND(N);
        },
        OR => {
            return self.visitOR(N);
        },
        XOR => {
            return self.visitXOR(N);
        },
        SHL => {
            return self.visitSHL(N);
        },
        SRA => {
            return self.visitSRA(N);
        },
        SRL => {
            return self.visitSRL(N);
        },
        ROTR => {
            ROTL;
        },
        FSHL => {
            FSHR;
        },
        SSHLSAT => {
            USHLSAT;
        },
        ABS => {
            return self.visitABS(N);
        },
        ABS_MIN_POISON => {
            return self.visitABS_MIN_POISON(N);
        },
        CLMUL => {
            CLMULR;
        },
        PEXT => {
            return self.visitPEXT(N);
        },
        PDEP => {
            return self.visitPDEP(N);
        },
        BSWAP => {
            return self.visitBSWAP(N);
        },
        BITREVERSE => {
            return self.visitBITREVERSE(N);
        },
        CTLZ => {
            return self.visitCTLZ(N);
        },
        CTLZ_ZERO_POISON => {
            return self.visitCTLZ_ZERO_POISON(N);
        },
        CTTZ => {
            return self.visitCTTZ(N);
        },
        CTTZ_ZERO_POISON => {
            return self.visitCTTZ_ZERO_POISON(N);
        },
        CTPOP => {
            return self.visitCTPOP(N);
        },
        PARITY => {
            return self.visitPARITY(N);
        },
        SELECT => {
            return self.visitSELECT(N);
        },
        VSELECT => {
            return self.visitVSELECT(N);
        },
        SELECT_CC => {
            return self.visitSELECT_CC(N);
        },
        SETCC => {
            return self.visitSETCC(N);
        },
        SETCCCARRY => {
            return self.visitSETCCCARRY(N);
        },
        SIGN_EXTEND => {
            return self.visitSIGN_EXTEND(N);
        },
        ZERO_EXTEND => {
            return self.visitZERO_EXTEND(N);
        },
        ANY_EXTEND => {
            return self.visitANY_EXTEND(N);
        },
        AssertSext => {
            AssertZext;
        },
        AssertAlign => {
            return self.visitAssertAlign(N);
        },
        IS_FPCLASS => {
            return self.visitIS_FPCLASS(N);
        },
        SIGN_EXTEND_INREG => {
            return self.visitSIGN_EXTEND_INREG(N);
        },
        SIGN_EXTEND_VECTOR_INREG => {
            ZERO_EXTEND_VECTOR_INREG;
        },
        TRUNCATE => {
            return self.visitTRUNCATE(N);
        },
        TRUNCATE_USAT_U => {
            return self.visitTRUNCATE_USAT_U(N);
        },
        BITCAST => {
            return self.visitBITCAST(N);
        },
        BUILD_PAIR => {
            return self.visitBUILD_PAIR(N);
        },
        FADD => {
            return self.visitFADD(N);
        },
        STRICT_FADD => {
            return self.visitSTRICT_FADD(N);
        },
        FSUB => {
            return self.visitFSUB(N);
        },
        FMUL => {
            return self.visitFMUL(N);
        },
        FMA => {
            return self.visitFMA(N);
        },
        FMAD => {
            return self.visitFMAD(N);
        },
        FMULADD => {
            return self.visitFMULADD(N);
        },
        FDIV => {
            return self.visitFDIV(N);
        },
        FREM => {
            return self.visitFREM(N);
        },
        FSQRT => {
            return self.visitFSQRT(N);
        },
        FCOPYSIGN => {
            return self.visitFCOPYSIGN(N);
        },
        FPOW => {
            return self.visitFPOW(N);
        },
        SINT_TO_FP => {
            return self.visitSINT_TO_FP(N);
        },
        UINT_TO_FP => {
            return self.visitUINT_TO_FP(N);
        },
        FP_TO_SINT => {
            return self.visitFP_TO_SINT(N);
        },
        FP_TO_UINT => {
            return self.visitFP_TO_UINT(N);
        },
        LROUND => {
            LLROUND;
        },
        FP_ROUND => {
            return self.visitFP_ROUND(N);
        },
        FP_EXTEND => {
            return self.visitFP_EXTEND(N);
        },
        FNEG => {
            return self.visitFNEG(N);
        },
        FABS => {
            return self.visitFABS(N);
        },
        FFLOOR => {
            return self.visitFFLOOR(N);
        },
        FMINNUM => {
            FMAXNUM;
        },
        FCEIL => {
            return self.visitFCEIL(N);
        },
        FTRUNC => {
            return self.visitFTRUNC(N);
        },
        FFREXP => {
            return self.visitFFREXP(N);
        },
        BRCOND => {
            return self.visitBRCOND(N);
        },
        BR_CC => {
            return self.visitBR_CC(N);
        },
        LOAD => {
            return self.visitLOAD(N);
        },
        STORE => {
            return self.visitSTORE(N);
        },
        ATOMIC_STORE => {
            return self.visitATOMIC_STORE(N);
        },
        INSERT_VECTOR_ELT => {
            return self.visitINSERT_VECTOR_ELT(N);
        },
        EXTRACT_VECTOR_ELT => {
            return self.visitEXTRACT_VECTOR_ELT(N);
        },
        BUILD_VECTOR => {
            return self.visitBUILD_VECTOR(N);
        },
        CONCAT_VECTORS => {
            return self.visitCONCAT_VECTORS(N);
        },
        VECTOR_INTERLEAVE => {
            return self.visitVECTOR_INTERLEAVE(N);
        },
        EXTRACT_SUBVECTOR => {
            return self.visitEXTRACT_SUBVECTOR(N);
        },
        VECTOR_SHUFFLE => {
            return self.visitVECTOR_SHUFFLE(N);
        },
        SCALAR_TO_VECTOR => {
            return self.visitSCALAR_TO_VECTOR(N);
        },
        INSERT_SUBVECTOR => {
            return self.visitINSERT_SUBVECTOR(N);
        },
        MGATHER => {
            return self.visitMGATHER(N);
        },
        MLOAD => {
            return self.visitMLOAD(N);
        },
        MSCATTER => {
            return self.visitMSCATTER(N);
        },
        MSTORE => {
            return self.visitMSTORE(N);
        },
        EXPERIMENTAL_VECTOR_HISTOGRAM => {
            return self.visitMHISTOGRAM(N);
        },
        PARTIAL_REDUCE_SMLA => {
            PARTIAL_REDUCE_UMLA;
        },
        LOOP_DEPENDENCE_RAW_MASK => {
            LOOP_DEPENDENCE_WAR_MASK;
        },
        VECTOR_COMPRESS => {
            return self.visitVECTOR_COMPRESS(N);
        },
        LIFETIME_END => {
            return self.visitLIFETIME_END(N);
        },
        FP_TO_FP16 => {
            return self.visitFP_TO_FP16(N);
        },
        FP16_TO_FP => {
            return self.visitFP16_TO_FP(N);
        },
        FP_TO_BF16 => {
            return self.visitFP_TO_BF16(N);
        },
        BF16_TO_FP => {
            return self.visitBF16_TO_FP(N);
        },
        FREEZE => {
            return self.visitFREEZE(N);
        },
        GET_FPENV_MEM => {
            return self.visitGET_FPENV_MEM(N);
        },
        SET_FPENV_MEM => {
            return self.visitSET_FPENV_MEM(N);
        },
        FCANONICALIZE => {
            return self.visitFCANONICALIZE(N);
        },
        VECREDUCE_FADD => {
            VECREDUCE_FMUL;
        },
        VP_SDIV => {
            VP_SREM;
        },
    }
    return SDValue {};
}

fn DAGCombiner::combine(self, N: *mut SDNode) -> SDValue {
    if !shouldExecute(DAGCombineCounter) {
        return SDValue {};
    }
    let mut RV: SDValue = SDValue {};
    if !self.DisableGenericCombines {
        RV = self.visit(N);
    }
    if !RV.getNode() {
        assert!(N.getOpcode() != DELETED_NODE, "Node was deleted but visit returned NULL!");
        if N.getOpcode() >= BUILTIN_OP_END || self.TLI.hasTargetDAGCombine(N.getOpcode() as NodeType) {
            let mut DagCombineInfo: DAGCombinerInfo = DAGCombinerInfo { self.DAG, self.Level, false, self };
            RV = self.TLI.PerformDAGCombine(N, DagCombineInfo);
        }
    }
    if !RV.getNode() {
        match N.getOpcode() {
            _ => {
                break;
            },
            ADD => {
                SUB;
            },
            SHL => {
                SRA;
            },
            SIGN_EXTEND => {
                ZERO_EXTEND;
            },
            LOAD => {
                if self.PromoteLoad(SDValue { Node: N, ResNo: 0 }) {
                    RV = SDValue { Node: N, ResNo: 0 };
                }
            },
        }
    }
    if !RV.getNode() && self.TLI.isCommutativeBinOp(N.getOpcode()) {
        let mut N0: SDValue = N.getOperand(0);
        let mut N1: SDValue = N.getOperand(1);
        if N0 != N1 && (isa(N0) || !isa(N1)) {
            let mut Ops: [2]SDValue = [N1, N0];
            let mut CSENode: *mut SDNode = self.DAG.getNodeIfExists(N.getOpcode(), N.getVTList(), ArrayRef<SDValue> { Ops }, N.getFlags(), false);
            if CSENode {
                return SDValue { Node: CSENode, ResNo: 0 };
            }
        }
    }
    return RV;
}

fn getInputChainForNode(N: *mut SDNode) -> SDValue {
    if N.getNumOperands() {
        NumOps;
    } else {
        if N.getOperand(0).getValueType() == EVT { Other } {
            return N.getOperand(0);
        }
        if N.getOperand(NumOps - 1).getValueType() == EVT { Other } {
            return N.getOperand(NumOps - 1);
        }
        for let mut i: u32 = 1; i < NumOps - 1; i += 1 {
            if N.getOperand(i).getValueType() == EVT { Other } {
                return N.getOperand(i);
            }
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitFCANONICALIZE(self, N: *mut SDNode) -> SDValue {
    let mut Operand: SDValue = N.getOperand(0);
    let mut VT: EVT = Operand.getValueType();
    let mut dl: SDLoc = SDLoc { N };
    if Operand.isUndef() {
        let mut CanonicalQNaN: APFloat = getQNaN(VT.getFltSemantics(), false, null);
        return self.DAG.getConstantFP(CanonicalQNaN, dl, VT, false);
    }
    return SDValue {};
}

fn DAGCombiner::visitTokenFactor(self, N: *mut SDNode) -> SDValue {
    if N.getNumOperands() == 2 {
        if getInputChainForNode(N.getOperand(0).getNode()) == N.getOperand(1) {
            return N.getOperand(0);
        }
        if getInputChainForNode(N.getOperand(1).getNode()) == N.getOperand(0) {
            return N.getOperand(1);
        }
    }
    if self.OptLevel == None {
        return SDValue {};
    }
    if N.getNumOperands() > TokenFactorInlineLimit.operator unsigned int() {
        return SDValue {};
    }
    if N.hasOneUse() && operator(N.user_begin()).getOpcode() == TokenFactor {
        self.AddToWorklist(operator((N.user_begin())), true, false);
    }
    let mut TFs: SmallVector<SDNode *, 8> = SmallVector<SDNode *, 8> {};
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut SeenOps: SmallPtrSet<SDNode *, 16> = SmallPtrSet<SDNode *, 16> {};
    let mut Changed: bool = false;
    TFs.push(N);
    for let mut i: u32 = 0; i < TFs.len; i += 1 {
        if Ops.len > TokenFactorInlineLimit.operator unsigned int() {
            for let mut j: u32 = i; j < TFs.len; j += 1 {
                Ops.emplace_back(TFs[j], 0);
            }
            TFs.resize(i);
            break;
        }
        let mut TF: *mut SDNode = TFs[i];
        for Op in TF.op_values() {
            match Op.getOpcode() {
                EntryToken => {
                    Changed = true;
                },
                TokenFactor => {
                    if Op.hasOneUse() && !is_contained(TFs, Op.getNode()) {
                        TFs.push(Op.getNode());
                        Changed = true;
                        break;
                    }
                },
                _ => {
                    if SeenOps.insert(Op.getNode()).second {
                        Ops.push(ValueParamT { Op });
                    } else {
                        Changed = true;
                    }
                },
            }
        }
    }
    for let mut i: u32 = 1;
let mut e: u32 = TFs.len; i < e; i += 1 {
        self.AddToWorklist(TFs[i], true, false);
    }
    let mut Worklist: pair<SDNode *, unsigned int>, 8> = pair<SDNode *, unsigned int>, 8> {};
    let mut OpWorkCount: SmallVector<unsigned int, 8> = SmallVector<unsigned int, 8> {};
    let mut SeenChains: SmallPtrSet<SDNode *, 16> = SmallPtrSet<SDNode *, 16> {};
    let mut DidPruneOps: bool = false;
    let mut NumLeftToConsider: u32 = 0;
    for Op in Ops {
        Worklist.push(make_pair(Op.getNode(), NumLeftToConsider += 1));
        OpWorkCount.push(1);
    }
    let mut AddToWorklist: Closure_3 = Closure_3 { SeenOps: &mut SeenOps, Changed: &mut Changed, DidPruneOps: &mut DidPruneOps, Ops: &mut Ops, Worklist: &mut Worklist, OpWorkCount: &mut OpWorkCount, NumLeftToConsider: &mut NumLeftToConsider, SeenChains: &mut SeenChains };
    for let mut i: u32 = 0; i < Worklist.len && i < 1024; i += 1 {
        if NumLeftToConsider <= 1 {
            break;
        }
        let mut CurNode: *mut SDNode = Worklist[i].first;
        let mut CurOpNumber: u32 = Worklist[i].second;
        assert!((OpWorkCount[CurOpNumber] > 0), "Node should not appear in worklist");
        match CurNode.getOpcode() {
            EntryToken => {
                NumLeftToConsider += 1;
            },
            TokenFactor => {
                for Op in CurNode.op_values() {
                    AddToWorklist.call(i, Op.getNode(), CurOpNumber);
                }
            },
            LIFETIME_START => {
                LIFETIME_END;
            },
            _ => {
                if dyn_cast(CurNode) {
                    MemNode;
                } else {
                    AddToWorklist.call(i, MemNode.getChain().getNode(), CurOpNumber);
                }
            },
        }
        OpWorkCount[CurOpNumber] -= 1;
        if OpWorkCount[CurOpNumber] == 0 {
            NumLeftToConsider -= 1;
        }
    }
    if Changed {
        let mut Result: SDValue = SDValue {};
        if Ops.len == 0 {
            Result = self.DAG.getEntryNode();
        } else {
            if DidPruneOps {
                let mut PrunedOps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
                for Op in Ops {
                    if SeenChains.count(Op.getNode()) == 0 {
                        PrunedOps.push(ValueParamT { Op });
                    }
                }
                Result = self.DAG.getTokenFactor(SDLoc { N }, PrunedOps);
            } else {
                Result = self.DAG.getTokenFactor(SDLoc { N }, Ops);
            }
        }
        return Result;
    }
    return SDValue {};
}

fn DAGCombiner::visitMERGE_VALUES(self, N: *mut SDNode) -> SDValue {
    let mut DeadNodes: WorklistRemover = WorklistRemover { DC: *self };
    self.AddUsersToWorklist(N);
    while true {
        {
        let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { N.ops() };
        self.DAG.ReplaceAllUsesWith(N, Ops.ptr);
    }
        if !(!N.use_empty()) { break; }
    }
    self.deleteAndRecombine(N);
    return SDValue { Node: N, ResNo: 0 };
}

fn getAsNonOpaqueConstant(N: SDValue) -> *mut ConstantSDNode {
    let mut Const: *mut ConstantSDNode = dyn_cast(N);
    return if Const != null && !Const.isOpaque() { Const } else { null };
}

fn isTruncateOf(DAG: *mut SelectionDAG, N: SDValue, Op: *mut SDValue, Known: *mut KnownBits) -> bool {
    if operator(N).getOpcode() == TRUNCATE {
        Op = operator(N).getOperand(0);
        Known = DAG.computeKnownBits(Op, 0);
        if operator(N).getFlags().hasNoUnsignedWrap() {
            Known.Zero.setBitsFrom(N.getScalarValueSizeInBits());
        }
        return true;
    }
    if N.getValueType().getScalarType() != EVT { i1 } || !sd_match(N, m_c_SpecificSetCC(SETNE, m_Value(Op), m_Zero(false))) {
        return false;
    }
    Known = DAG.computeKnownBits(Op, 0);
    return (Known.Zero | 1).isAllOnes();
}

fn canFoldInAddressingMode(N: *mut SDNode, Use: *mut SDNode, DAG: *mut SelectionDAG, TLI: *TargetLowering) -> bool {
    let mut VT: EVT = EVT {};
    let mut AS: u32 = 0;
    if dyn_cast(Use) {
        LD;
    } else {
        if LD.isIndexed() || LD.getBasePtr().getNode() != N {
            return false;
        }
        VT = LD.getMemoryVT();
        AS = LD.getAddressSpace();
    }
    let mut AM: AddrMode = AddrMode {};
    if N.isAnyAdd() {
        AM.HasBaseReg = true;
        let mut Offset: *mut ConstantSDNode = dyn_cast(N.getOperand(1));
        if Offset {
            AM.BaseOffs = Offset.getSExtValue();
        } else {
            AM.Scale = 1;
        }
    } else if N.getOpcode() == SUB {
        AM.HasBaseReg = true;
        let mut Offset: *mut ConstantSDNode = dyn_cast(N.getOperand(1));
        if Offset {
            AM.BaseOffs = -Offset.getSExtValue();
        } else {
            AM.Scale = 1;
        }
    } else {
        return false;
    }
    return TLI.isLegalAddressingMode(DAG.getDataLayout(), AM, VT.getTypeForEVT(*DAG.getContext()), AS, null);
}

fn foldSelectWithIdentityConstant(N: *mut SDNode, DAG: *mut SelectionDAG, ShouldCommuteOperands: bool) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    if ShouldCommuteOperands {
        swap(N0, N1);
    }
    let mut Cond: SDValue = SDValue {};
    let mut TVal: SDValue = SDValue {};
    let mut FVal: SDValue = SDValue {};
    if !sd_match(N1, m_OneUse(m_SelectLike(m_Value(Cond), m_Value(TVal), m_Value(FVal)))) {
        return SDValue {};
    }
    if !DAG.isSafeToSpeculativelyExecuteNode(N) {
        return SDValue {};
    }
    let mut SelOpcode: u32 = N1.getOpcode();
    let mut Opcode: u32 = N.getOpcode();
    let mut VT: EVT = N.getValueType(0);
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut OpNo: u32 = if ShouldCommuteOperands { 0 } else { 1 };
    if DAG.isIdentityElement(Opcode, N.getFlags(), TVal, OpNo, 0) && TLI.shouldFoldSelectWithIdentityConstant(Opcode, VT, SelOpcode, N0, FVal) {
        let mut F0: SDValue = DAG.getFreeze(N0);
        let mut NewBO: SDValue = DAG.getNode(Opcode, SDLoc { N }, VT, F0, FVal, N.getFlags());
        return DAG.getSelect(SDLoc { N }, VT, Cond, F0, NewBO, SDNodeFlags { Flags: None });
    }
    if DAG.isIdentityElement(Opcode, N.getFlags(), FVal, OpNo, 0) && TLI.shouldFoldSelectWithIdentityConstant(Opcode, VT, SelOpcode, N0, TVal) {
        let mut F0: SDValue = DAG.getFreeze(N0);
        let mut NewBO: SDValue = DAG.getNode(Opcode, SDLoc { N }, VT, F0, TVal, N.getFlags());
        return DAG.getSelect(SDLoc { N }, VT, Cond, NewBO, F0, SDNodeFlags { Flags: None });
    }
    return SDValue {};
}

fn DAGCombiner::foldBinOpIntoSelect(self, BO: *mut SDNode) -> SDValue {
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    assert!(TLI.isBinOp(BO.getOpcode()) && BO.getNumValues() == 1, "Unexpected binary operator");
    if foldSelectWithIdentityConstant(BO, self.DAG, false) {
        Sel;
    } else {
        return Sel;
    }
    if TLI.isCommutativeBinOp(BO.getOpcode()) {
        if foldSelectWithIdentityConstant(BO, self.DAG, true) {
            Sel;
        } else {
            return Sel;
        }
    }
    let mut SelOpNo: u32 = 0;
    let mut Sel: SDValue = BO.getOperand(0);
    let mut BinOpcode: u32 = BO.getOpcode();
    if Sel.getOpcode() != SELECT || !Sel.hasOneUse() {
        SelOpNo = 1;
        Sel = BO.getOperand(1);
        if (BinOpcode == SHL || BinOpcode == SRA || BinOpcode == SRL) && Sel.hasOneUse() {
            let mut Op: SDValue = SDValue {};
            let mut Known: KnownBits = KnownBits {};
            if isTruncateOf(self.DAG, Sel, Op, Known) && Known.countMaxActiveBits() < Sel.getScalarValueSizeInBits() {
                Sel = Op;
            }
        }
    }
    if Sel.getOpcode() != SELECT || !Sel.hasOneUse() {
        return SDValue {};
    }
    let mut CT: SDValue = Sel.getOperand(1);
    if !isConstantOrConstantVector(CT, true, false) && !self.DAG.isConstantFPBuildVectorOrConstantFP(CT) {
        return SDValue {};
    }
    let mut CF: SDValue = Sel.getOperand(2);
    if !isConstantOrConstantVector(CF, true, false) && !self.DAG.isConstantFPBuildVectorOrConstantFP(CF) {
        return SDValue {};
    }
    let mut CanFoldNonConst: bool = (BinOpcode == AND || BinOpcode == OR) && ((isNullOrNullSplat(CT, false) && isAllOnesOrAllOnesSplat(CF, false)) || (isNullOrNullSplat(CF, false) && isAllOnesOrAllOnesSplat(CT, false)));
    let mut CBO: SDValue = BO.getOperand(SelOpNo ^ 1);
    if !CanFoldNonConst && !isConstantOrConstantVector(CBO, true, false) && !self.DAG.isConstantFPBuildVectorOrConstantFP(CBO) {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { Sel };
    let mut NewCT: SDValue = SDValue {};
    let mut NewCF: SDValue = SDValue {};
    let mut VT: EVT = BO.getValueType(0);
    if CanFoldNonConst {
        if (BinOpcode == AND && isNullOrNullSplat(CT, false)) || (BinOpcode == OR && isAllOnesOrAllOnesSplat(CT, false)) {
            NewCT = CT;
        } else {
            NewCT = CBO;
        }
        if (BinOpcode == AND && isNullOrNullSplat(CF, false)) || (BinOpcode == OR && isAllOnesOrAllOnesSplat(CF, false)) {
            NewCF = CF;
        } else {
            NewCF = CBO;
        }
    } else {
        NewCT = if SelOpNo { self.DAG.FoldConstantArithmetic(BinOpcode, DL, VT, ArrayRef<SDValue> { [CBO, CT] }, SDNodeFlags { Flags: None }) } else { self.DAG.FoldConstantArithmetic(BinOpcode, DL, VT, ArrayRef<SDValue> { [CT, CBO] }, SDNodeFlags { Flags: None }) };
        if !NewCT {
            return SDValue {};
        }
        NewCF = if SelOpNo { self.DAG.FoldConstantArithmetic(BinOpcode, DL, VT, ArrayRef<SDValue> { [CBO, CF] }, SDNodeFlags { Flags: None }) } else { self.DAG.FoldConstantArithmetic(BinOpcode, DL, VT, ArrayRef<SDValue> { [CF, CBO] }, SDNodeFlags { Flags: None }) };
        if !NewCF {
            return SDValue {};
        }
    }
    return self.DAG.getSelect(DL, VT, Sel.getOperand(0), NewCT, NewCF, BO.getFlags());
}

fn foldAddSubBoolOfMaskedVal(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    assert!((N.getOpcode() == ADD || N.getOpcode() == SUB), "Expecting add or sub");
    let mut IsAdd: bool = N.getOpcode() == ADD;
    let mut C: SDValue = if IsAdd { N.getOperand(1) } else { N.getOperand(0) };
    let mut Z: SDValue = if IsAdd { N.getOperand(0) } else { N.getOperand(1) };
    let mut CN: *mut ConstantSDNode = dyn_cast(C);
    if !CN || Z.getOpcode() != ZERO_EXTEND {
        return SDValue {};
    }
    if Z.getOperand(0).getValueType() != EVT { i1 } {
        return SDValue {};
    }
    if !sd_match(Z.getOperand(0), m_SpecificSetCC(SETEQ, m_And(m_Value(), m_One(false)), m_Zero(false))) {
        return SDValue {};
    }
    let mut VT: EVT = C.getValueType();
    let mut LowBit: SDValue = DAG.getZExtOrTrunc(Z.getOperand(0).getOperand(0), DL, VT);
    let mut C1: SDValue = if IsAdd { DAG.getConstant(CN.getAPIntValue() + 1, DL, VT, false, false) } else { DAG.getConstant(CN.getAPIntValue() - 1, DL, VT, false, false) };
    return DAG.getNode(if IsAdd { SUB } else { ADD }, DL, VT, C1, LowBit);
}

fn DAGCombiner::foldSubToAvg(self, N: *mut SDNode, DL: *SDLoc) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N0.getValueType();
    let mut A: SDValue = SDValue {};
    let mut B: SDValue = SDValue {};
    if (!self.LegalOperations || self.hasOperation(AVGCEILU, VT)) && sd_match(N, m_Sub(m_Or(m_Value(A), m_Value(B)), m_Srl(m_Xor(m_Deferred(A), m_Deferred(B)), m_One(false)))) {
        return self.DAG.getNode(AVGCEILU, DL, VT, A, B);
    }
    if (!self.LegalOperations || self.hasOperation(AVGCEILS, VT)) && sd_match(N, m_Sub(m_Or(m_Value(A), m_Value(B)), m_Sra(m_Xor(m_Deferred(A), m_Deferred(B)), m_One(false)))) {
        return self.DAG.getNode(AVGCEILS, DL, VT, A, B);
    }
    return SDValue {};
}

fn DAGCombiner::visitPTRADD(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut PtrVT: EVT = N0.getValueType();
    let mut IntVT: EVT = N1.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    assert!(PtrVT == IntVT, "PTRADD with different operand types is not supported");
    if isNullConstant(N1) {
        return N0;
    }
    if PtrVT == IntVT && isNullConstant(N0) {
        return N1;
    }
    if N0.getOpcode() == PTRADD && !self.reassociationCanBreakAddressingModePattern(PTRADD, DL, N, N0, N1) {
        let mut X: SDValue = N0.getOperand(0);
        let mut Y: SDValue = N0.getOperand(1);
        let mut Z: SDValue = N1;
        let mut N0OneUse: bool = N0.hasOneUse();
        let mut YIsConstant: bool = self.DAG.isConstantIntBuildVectorOrConstantInt(Y, true);
        let mut ZIsConstant: bool = self.DAG.isConstantIntBuildVectorOrConstantInt(Z, true);
        if (YIsConstant && N0OneUse) || (YIsConstant && ZIsConstant) {
            let mut Flags: SDNodeFlags = (N.getFlags() & operator(N0).getFlags()) & SDNodeFlags { Flags: NoUnsignedWrap };
            let mut Add: SDValue = self.DAG.getNode(ADD, DL, IntVT, ArrayRef<SDValue> { [Y, Z] }, Flags);
            self.AddToWorklist(Add.getNode(), true, false);
            return self.DAG.getMemBasePlusOffset(X, Add, DL, Flags);
        }
    }
    if !self.TLI.canTransformPtrArithOutOfBounds(self.DAG.getMachineFunction().getFunction(), PtrVT) {
        return SDValue {};
    }
    if N0.getOpcode() == PTRADD && isa(N1) {
        let mut GAValue: SDValue = N0.getOperand(0);
        if dyn_cast(GAValue) {
            GA;
        } else {
            let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
            if !self.LegalOperations && TLI.isOffsetFoldingLegal(GA) {
                let mut Flags: SDNodeFlags = (N.getFlags() & operator(N0).getFlags()) & SDNodeFlags { Flags: NoUnsignedWrap };
                let mut Inner: SDValue = self.DAG.getMemBasePlusOffset(GAValue, N1, DL, Flags);
                self.AddToWorklist(Inner.getNode(), true, false);
                return self.DAG.getMemBasePlusOffset(Inner, N0.getOperand(1), DL, Flags);
            }
        }
    }
    if N1.getOpcode() == ADD && N1.hasOneUse() {
        let mut X: SDValue = N0;
        let mut Y: SDValue = N1.getOperand(0);
        let mut Z: SDValue = N1.getOperand(1);
        let mut YIsConstant: bool = self.DAG.isConstantIntBuildVectorOrConstantInt(Y, true);
        let mut ZIsConstant: bool = self.DAG.isConstantIntBuildVectorOrConstantInt(Z, true);
        let mut CommonFlags: SDNodeFlags = N.getFlags() & operator(N1).getFlags();
        let mut ReassocFlags: SDNodeFlags = CommonFlags & SDNodeFlags { Flags: NoUnsignedWrap };
        if CommonFlags.hasNoUnsignedWrap() {
            operator(ReassocFlags, N.getFlags() & SDNodeFlags { Flags: InBounds });
        }
        if ZIsConstant != YIsConstant {
            if YIsConstant {
                swap(Y, Z);
            }
            let mut Inner: SDValue = self.DAG.getMemBasePlusOffset(X, Y, DL, ReassocFlags);
            self.AddToWorklist(Inner.getNode(), true, false);
            return self.DAG.getMemBasePlusOffset(Inner, Z, DL, ReassocFlags);
        }
    }
    if self.LegalOperations && self.DAG.haveNoCommonBitsSet(N0, N1) {
        let mut TransformCannotBreakAddrMode: bool = none_of(N.users(), Closure_4 { N: &mut N, cap_1: self });
        if TransformCannotBreakAddrMode {
            return self.DAG.getNode(OR, DL, PtrVT, N0, N1, SDNodeFlags { Flags: Disjoint });
        }
    }
    return SDValue {};
}

fn foldAddSubOfSignBit(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    assert!((N.getOpcode() == ADD || N.getOpcode() == SUB), "Expecting add or sub");
    let mut IsAdd: bool = N.getOpcode() == ADD;
    let mut ConstantOp: SDValue = if IsAdd { N.getOperand(1) } else { N.getOperand(0) };
    let mut ShiftOp: SDValue = if IsAdd { N.getOperand(0) } else { N.getOperand(1) };
    if !DAG.isConstantIntBuildVectorOrConstantInt(ConstantOp, true) || ShiftOp.getOpcode() != SRL {
        return SDValue {};
    }
    let mut Not: SDValue = ShiftOp.getOperand(0);
    if !Not.hasOneUse() || !isBitwiseNot(Not, false) {
        return SDValue {};
    }
    let mut VT: EVT = ShiftOp.getValueType();
    let mut ShAmt: SDValue = ShiftOp.getOperand(1);
    let mut ShAmtC: *mut ConstantSDNode = isConstOrConstSplat(ShAmt, false, false);
    if !ShAmtC || ShAmtC.getAPIntValue() != (VT.getScalarSizeInBits() - 1) {
        return SDValue {};
    }
    if DAG.FoldConstantArithmetic(if IsAdd { ADD } else { SUB }, DL, VT, ArrayRef<SDValue> { [ConstantOp, DAG.getConstant(1, DL, VT, false, false)] }, SDNodeFlags { Flags: None }) {
        NewC;
    } else {
        let mut NewShift: SDValue = DAG.getNode(if IsAdd { SRA } else { SRL }, DL, VT, Not.getOperand(0), ShAmt);
        return DAG.getNode(ADD, DL, VT, NewShift, NewC);
    }
    return SDValue {};
}

fn areBitwiseNotOfEachother(Op0: SDValue, Op1: SDValue) -> bool {
    return (isBitwiseNot(Op0, false) && Op0.getOperand(0) == Op1) || (isBitwiseNot(Op1, false) && Op1.getOperand(0) == Op0);
}

fn DAGCombiner::visitADDLike(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N0.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    if N0.isUndef() {
        return N0;
    }
    if N1.isUndef() {
        return N1;
    }
    if self.DAG.FoldConstantArithmetic(ADD, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if self.DAG.isConstantIntBuildVectorOrConstantInt(N0, true) && !self.DAG.isConstantIntBuildVectorOrConstantInt(N1, true) {
        return self.DAG.getNode(ADD, DL, VT, N1, N0);
    }
    if areBitwiseNotOfEachother(N0, N1) {
        return self.DAG.getConstant(getAllOnes(VT.getScalarSizeInBits()), DL, VT, false, false);
    }
    if VT.isVector() {
        if self.SimplifyVBinOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
        if isConstantSplatVectorAllZeros(N1.getNode(), false) {
            return N0;
        }
    }
    if isNullConstant(N1) {
        return N0;
    }
    if N0.getOpcode() == SUB {
        let mut N00: SDValue = N0.getOperand(0);
        let mut N01: SDValue = N0.getOperand(1);
        if self.DAG.FoldConstantArithmetic(SUB, DL, VT, ArrayRef<SDValue> { [N1, N01] }, SDNodeFlags { Flags: None }) {
            Sub;
        } else {
            return self.DAG.getNode(ADD, DL, VT, N0.getOperand(0), Sub);
        }
        if self.DAG.FoldConstantArithmetic(ADD, DL, VT, ArrayRef<SDValue> { [N1, N00] }, SDNodeFlags { Flags: None }) {
            Add;
        } else {
            return self.DAG.getNode(SUB, DL, VT, Add, N0.getOperand(1));
        }
    }
    if N0.getOpcode() == SIGN_EXTEND && N0.hasOneUse() && isOneOrOneSplat(N1, false) {
        let mut X: SDValue = N0.getOperand(0);
        if (!self.LegalOperations || (self.TLI.isOperationLegal(XOR, X.getValueType()) && self.TLI.isOperationLegal(ZERO_EXTEND, VT))) && X.getScalarValueSizeInBits() == 1 {
            let mut Not: SDValue = self.DAG.getNOT(DL, X, X.getValueType());
            return self.DAG.getNode(ZERO_EXTEND, DL, VT, Not);
        }
    }
    if self.DAG.isADDLike(N0, false) {
        let mut N01: SDValue = N0.getOperand(1);
        if self.DAG.FoldConstantArithmetic(ADD, DL, VT, ArrayRef<SDValue> { [N1, N01] }, SDNodeFlags { Flags: None }) {
            Add;
        } else {
            return self.DAG.getNode(ADD, DL, VT, N0.getOperand(0), Add);
        }
    }
    if self.foldBinOpIntoSelect(N) {
        NewSel;
    } else {
        return NewSel;
    }
    if !self.reassociationCanBreakAddressingModePattern(ADD, DL, N, N0, N1) {
        if self.reassociateOps(ADD, DL, N0, N1, N.getFlags()) {
            RADD;
        } else {
            return RADD;
        }
        let mut X: SDValue = SDValue {};
        let mut Y: SDValue = SDValue {};
        let mut InnerAdd: SDValue = SDValue {};
        if sd_match(N, m_Add(m_OneUse(m_Value(InnerAdd, m_Add(m_Value(X), m_Value(Y)))), m_Deferred(X))) {
            if X != Y {
                let mut NewFlags: SDNodeFlags = N.getFlags() & operator(InnerAdd).getFlags() & SDNodeFlags { Flags: NoUnsignedWrap };
                let mut X2: SDValue = self.DAG.getNode(ADD, DL, VT, X, X, NewFlags);
                return self.DAG.getNode(ADD, DL, VT, Y, X2, NewFlags);
            }
        }
        let mut ReassociateAddOr: Closure_5 = Closure_5 { cap_0: self, DL: &mut DL, VT: &mut VT };
        if ReassociateAddOr.call(N0, N1) {
            Add;
        } else {
            return Add;
        }
        if ReassociateAddOr.call(N1, N0) {
            Add;
        } else {
            return Add;
        }
        if self.reassociateReduction(VECREDUCE_ADD, ADD, DL, VT, N0, N1, SDNodeFlags { Flags: None }) {
            SD;
        } else {
            return SD;
        }
    }
    let mut A: SDValue = SDValue {};
    let mut B: SDValue = SDValue {};
    let mut C: SDValue = SDValue {};
    let mut D: SDValue = SDValue {};
    if sd_match(N0, m_Neg(m_Value(A))) {
        return self.DAG.getNode(SUB, DL, VT, N1, A);
    }
    if sd_match(N1, m_Neg(m_Value(B))) {
        return self.DAG.getNode(SUB, DL, VT, N0, B);
    }
    if sd_match(N1, m_Sub(m_Value(B), m_Specific(N0))) {
        return B;
    }
    if sd_match(N0, m_Sub(m_Value(B), m_Specific(N1))) {
        return B;
    }
    if sd_match(N0, m_Sub(m_Value(A), m_Value(B))) && sd_match(N1, m_Sub(m_Value(C), m_Specific(A))) {
        return self.DAG.getNode(SUB, DL, VT, C, B);
    }
    if sd_match(N0, m_Sub(m_Value(A), m_Value(B))) && sd_match(N1, m_Sub(m_Specific(B), m_Value(C))) {
        return self.DAG.getNode(SUB, DL, VT, A, C);
    }
    if sd_match(N1, m_Sub(m_Value(B), m_Add(m_Specific(N0), m_Value(C)))) {
        return self.DAG.getNode(SUB, DL, VT, B, C);
    }
    if sd_match(N1, m_AnyOf(m_Add(m_Sub(m_Value(B), m_Specific(N0)), m_Value(C)), m_Sub(m_Sub(m_Value(B), m_Specific(N0)), m_Value(C)))) {
        return self.DAG.getNode(N1.getOpcode(), DL, VT, B, C);
    }
    if sd_match(N0, m_OneUse(m_Sub(m_Value(A), m_Value(B)))) && sd_match(N1, m_OneUse(m_Sub(m_Value(C), m_Value(D)))) && (isConstantOrConstantVector(A, false, false) || isConstantOrConstantVector(C, false, false)) {
        return self.DAG.getNode(SUB, DL, VT, self.DAG.getNode(ADD, SDLoc { N0 }, VT, A, C), self.DAG.getNode(ADD, SDLoc { N1 }, VT, B, D));
    }
    if N0.getOpcode() == UMAX && self.hasOperation(USUBSAT, VT) {
        let mut MatchUSUBSAT: Closure_6 = Closure_6 {};
        if matchBinaryPredicate(N0.getOperand(1), N1, function<bool (ConstantSDNode *, ConstantSDNode *)> { MatchUSUBSAT }, true, false) {
            return self.DAG.getNode(USUBSAT, DL, VT, N0.getOperand(0), N0.getOperand(1));
        }
    }
    if self.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if isOneOrOneSplat(N1, false) {
        if isBitwiseNot(N0, false) {
            return self.DAG.getNode(SUB, DL, VT, self.DAG.getConstant(0, DL, VT, false, false), N0.getOperand(0));
        }
        if N0.getOpcode() == ADD {
            let mut A: SDValue = SDValue {};
            let mut Xor: SDValue = SDValue {};
            if isBitwiseNot(N0.getOperand(0), false) {
                A = N0.getOperand(1);
                Xor = N0.getOperand(0);
            } else if isBitwiseNot(N0.getOperand(1), false) {
                A = N0.getOperand(0);
                Xor = N0.getOperand(1);
            }
            if Xor {
                return self.DAG.getNode(SUB, DL, VT, A, Xor.getOperand(0));
            }
        }
        if !self.TLI.preferIncOfAddToSubOfNot(VT) && N0.getOpcode() == ADD && N0.hasOneUse() && (self.Level >= AfterLegalizeDAG || (!N.getFlags().hasNoUnsignedWrap() && !N.getFlags().hasNoSignedWrap())) {
            let mut Not: SDValue = self.DAG.getNOT(DL, N0.getOperand(0), VT);
            return self.DAG.getNode(SUB, DL, VT, N0.getOperand(1), Not);
        }
    }
    if N0.getOpcode() == SUB && N0.hasOneUse() && isAllOnesOrAllOnesSplat(N1, true) {
        let mut Not: SDValue = self.DAG.getNOT(DL, N0.getOperand(1), VT);
        return self.DAG.getNode(ADD, DL, VT, Not, N0.getOperand(0));
    }
    let mut CM: APInt = APInt {};
    let mut CA: APInt = APInt {};
    if dyn_cast(N1) {
        CB;
    } else {
        if VT.getScalarSizeInBits() <= 64 {
            if sd_match(N0, m_OneUse(m_Mul(m_Add(m_Value(A), m_ConstInt(CA)), m_ConstInt(CM)))) && self.TLI.isLegalAddImmediate((CA * CM + CB.getAPIntValue()).getSExtValue()) {
                let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
                if N.getFlags().hasNoUnsignedWrap() && operator(N0).getFlags().hasNoUnsignedWrap() && operator(N0.getOperand(0)).getFlags().hasNoUnsignedWrap() {
                    operator(Flags, SDNodeFlags { Flags: NoUnsignedWrap });
                    if N.getFlags().hasNoSignedWrap() && operator(N0).getFlags().hasNoSignedWrap() && operator(N0.getOperand(0)).getFlags().hasNoSignedWrap() {
                        operator(Flags, SDNodeFlags { Flags: NoSignedWrap });
                    }
                }
                let mut Mul: SDValue = self.DAG.getNode(MUL, SDLoc { N1 }, VT, A, self.DAG.getConstant(CM, DL, VT, false, false), Flags);
                return self.DAG.getNode(ADD, DL, VT, Mul, self.DAG.getConstant(CA * CM + CB.getAPIntValue(), DL, VT, false, false), Flags);
            }
            if sd_match(N0, m_OneUse(m_Add(m_OneUse(m_Mul(m_Add(m_Value(A), m_ConstInt(CA)), m_ConstInt(CM))), m_Value(B)))) && self.TLI.isLegalAddImmediate((CA * CM + CB.getAPIntValue()).getSExtValue()) {
                let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
                let mut OMul: SDValue = if N0.getOperand(0) == B { N0.getOperand(1) } else { N0.getOperand(0) };
                if N.getFlags().hasNoUnsignedWrap() && operator(N0).getFlags().hasNoUnsignedWrap() && operator(OMul).getFlags().hasNoUnsignedWrap() && operator(OMul.getOperand(0)).getFlags().hasNoUnsignedWrap() {
                    operator(Flags, SDNodeFlags { Flags: NoUnsignedWrap });
                    if N.getFlags().hasNoSignedWrap() && operator(N0).getFlags().hasNoSignedWrap() && operator(OMul).getFlags().hasNoSignedWrap() && operator(OMul.getOperand(0)).getFlags().hasNoSignedWrap() {
                        operator(Flags, SDNodeFlags { Flags: NoSignedWrap });
                    }
                }
                let mut Mul: SDValue = self.DAG.getNode(MUL, SDLoc { N1 }, VT, A, self.DAG.getConstant(CM, DL, VT, false, false), Flags);
                let mut Add: SDValue = self.DAG.getNode(ADD, SDLoc { N1 }, VT, Mul, B, Flags);
                return self.DAG.getNode(ADD, DL, VT, Add, self.DAG.getConstant(CA * CM + CB.getAPIntValue(), DL, VT, false, false), Flags);
            }
        }
    }
    if self.visitADDLikeCommutative(N0, N1, DL) {
        Combined;
    } else {
        return Combined;
    }
    if self.visitADDLikeCommutative(N1, N0, DL) {
        Combined;
    } else {
        return Combined;
    }
    return SDValue {};
}

fn DAGCombiner::foldAddToAvg(self, N: *mut SDNode, DL: *SDLoc) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N0.getValueType();
    let mut A: SDValue = SDValue {};
    let mut B: SDValue = SDValue {};
    if (!self.LegalOperations || self.hasOperation(AVGFLOORU, VT)) && (sd_match(N, m_Add(m_And(m_Value(A), m_Value(B)), m_Srl(m_Xor(m_Deferred(A), m_Deferred(B)), m_One(false)))) || sd_match(N, m_ReassociatableAdd(m_ReassociatableAnd(m_Value(A), m_Value(B), m_One(false)), m_Srl(m_Deferred(A), m_One(false)), m_Srl(m_Deferred(B), m_One(false))))) {
        return self.DAG.getNode(AVGFLOORU, DL, VT, A, B);
    }
    if (!self.LegalOperations || self.hasOperation(AVGFLOORS, VT)) && (sd_match(N, m_Add(m_And(m_Value(A), m_Value(B)), m_Sra(m_Xor(m_Deferred(A), m_Deferred(B)), m_One(false)))) || sd_match(N, m_ReassociatableAdd(m_ReassociatableAnd(m_Value(A), m_Value(B), m_One(false)), m_Sra(m_Deferred(A), m_One(false)), m_Sra(m_Deferred(B), m_One(false))))) {
        return self.DAG.getNode(AVGFLOORS, DL, VT, A, B);
    }
    if (!self.LegalOperations || self.hasOperation(AVGCEILU, VT)) && sd_match(N, m_ReassociatableAdd(m_And(m_Or(m_Value(A), m_Value(B)), m_One(false)), m_Srl(m_Deferred(A), m_One(false)), m_Srl(m_Deferred(B), m_One(false)))) {
        return self.DAG.getNode(AVGCEILU, DL, VT, A, B);
    }
    if (!self.LegalOperations || self.hasOperation(AVGCEILS, VT)) && sd_match(N, m_ReassociatableAdd(m_And(m_Or(m_Value(A), m_Value(B)), m_One(false)), m_Sra(m_Deferred(A), m_One(false)), m_Sra(m_Deferred(B), m_One(false)))) {
        return self.DAG.getNode(AVGCEILS, DL, VT, A, B);
    }
    return SDValue {};
}

fn DAGCombiner::visitADD(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N0.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    if self.visitADDLike(N) {
        Combined;
    } else {
        return Combined;
    }
    if foldAddSubBoolOfMaskedVal(N, DL, self.DAG) {
        V;
    } else {
        return V;
    }
    if foldAddSubOfSignBit(N, DL, self.DAG) {
        V;
    } else {
        return V;
    }
    if self.MatchRotate(N0, N1, SDLoc { N }, true) {
        V;
    } else {
        return V;
    }
    if self.foldAddToAvg(N, DL) {
        V;
    } else {
        return V;
    }
    if (!self.LegalOperations || self.TLI.isOperationLegal(OR, VT)) && self.DAG.haveNoCommonBitsSet(N0, N1) {
        return self.DAG.getNode(OR, DL, VT, N0, N1, SDNodeFlags { Flags: Disjoint });
    }
    if N0.getOpcode() == VSCALE && N1.getOpcode() == VSCALE {
        let mut C0: *APInt = operator(N0).getConstantOperandAPInt(0);
        let mut C1: *APInt = operator(N1).getConstantOperandAPInt(0);
        return self.DAG.getVScale(DL, VT, C0 + C1);
    }
    if N0.getOpcode() == ADD && N0.getOperand(1).getOpcode() == VSCALE && N1.getOpcode() == VSCALE {
        let mut VS0: *APInt = operator(N0.getOperand(1)).getConstantOperandAPInt(0);
        let mut VS1: *APInt = operator(N1).getConstantOperandAPInt(0);
        let mut VS: SDValue = self.DAG.getVScale(DL, VT, VS0 + VS1);
        return self.DAG.getNode(ADD, DL, VT, N0.getOperand(0), VS);
    }
    if N0.getOpcode() == STEP_VECTOR && N1.getOpcode() == STEP_VECTOR {
        let mut C0: *APInt = operator(N0).getConstantOperandAPInt(0);
        let mut C1: *APInt = operator(N1).getConstantOperandAPInt(0);
        let mut NewStep: APInt = C0 + C1;
        return self.DAG.getStepVector(DL, VT, NewStep);
    }
    if N0.getOpcode() == ADD && N0.getOperand(1).getOpcode() == STEP_VECTOR && N1.getOpcode() == STEP_VECTOR {
        let mut SV0: *APInt = operator(N0.getOperand(1)).getConstantOperandAPInt(0);
        let mut SV1: *APInt = operator(N1).getConstantOperandAPInt(0);
        let mut NewStep: APInt = SV0 + SV1;
        let mut SV: SDValue = self.DAG.getStepVector(DL, VT, NewStep);
        return self.DAG.getNode(ADD, DL, VT, N0.getOperand(0), SV);
    }
    return SDValue {};
}

fn DAGCombiner::visitADDSAT(self, N: *mut SDNode) -> SDValue {
    let mut Opcode: u32 = N.getOpcode();
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N0.getValueType();
    let mut IsSigned: bool = Opcode == SADDSAT;
    let mut DL: SDLoc = SDLoc { N };
    if N0.isUndef() || N1.isUndef() {
        return self.DAG.getAllOnesConstant(DL, VT, false, false);
    }
    if self.DAG.FoldConstantArithmetic(Opcode, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if self.DAG.isConstantIntBuildVectorOrConstantInt(N0, true) && !self.DAG.isConstantIntBuildVectorOrConstantInt(N1, true) {
        return self.DAG.getNode(Opcode, DL, VT, N1, N0);
    }
    if VT.isVector() {
        if self.SimplifyVBinOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
        if isConstantSplatVectorAllZeros(N1.getNode(), false) {
            return N0;
        }
    }
    if isNullConstant(N1) {
        return N0;
    }
    if self.DAG.willNotOverflowAdd(IsSigned, N0, N1) {
        return self.DAG.getNode(ADD, DL, VT, N0, N1);
    }
    return SDValue {};
}

fn getAsCarry(TLI: *TargetLowering, V: SDValue, ForceCarryReconstruction: bool) -> SDValue {
    let mut Masked: bool = false;
    while true {
        if ForceCarryReconstruction && V.getValueType() == EVT { i1 } {
            return V;
        }
        if V.getOpcode() == TRUNCATE || V.getOpcode() == ZERO_EXTEND {
            V = V.getOperand(0);
            continue;
        }
        if V.getOpcode() == AND && isOneConstant(V.getOperand(1)) {
            if ForceCarryReconstruction {
                return V;
            }
            Masked = true;
            V = V.getOperand(0);
            continue;
        }
        break;
    }
    if V.getResNo() != 1 {
        return SDValue {};
    }
    if V.getOpcode() != UADDO_CARRY && V.getOpcode() != USUBO_CARRY && V.getOpcode() != UADDO && V.getOpcode() != USUBO {
        return SDValue {};
    }
    let mut VT: EVT = operator(V).getValueType(0);
    if !TLI.isOperationLegalOrCustom(V.getOpcode(), VT, false) {
        return SDValue {};
    }
    if Masked || TLI.getBooleanContents(V.getValueType()) == ZeroOrOneBooleanContent {
        return V;
    }
    return SDValue {};
}

fn foldAddSubMasked1(IsAdd: bool, N0: SDValue, N1: SDValue, DAG: *mut SelectionDAG, DL: *SDLoc) -> SDValue {
    if N1.getOpcode() == ZERO_EXTEND {
        N1 = N1.getOperand(0);
    }
    if N1.getOpcode() != AND || !isOneOrOneSplat(operator(N1).getOperand(1), false) {
        return SDValue {};
    }
    let mut VT: EVT = N0.getValueType();
    let mut N10: SDValue = N1.getOperand(0);
    if N10.getValueType() != VT && N10.getOpcode() == TRUNCATE {
        N10 = N10.getOperand(0);
    }
    if N10.getValueType() != VT {
        return SDValue {};
    }
    if DAG.ComputeNumSignBits(N10, 0) != VT.getScalarSizeInBits() {
        return SDValue {};
    }
    return DAG.getNode(if IsAdd { SUB } else { ADD }, DL, VT, N0, N10);
}

fn DAGCombiner::visitADDLikeCommutative(self, N0: SDValue, N1: SDValue, DL: *SDLoc) -> SDValue {
    let mut VT: EVT = N0.getValueType();
    let mut Y: SDValue = SDValue {};
    let mut N: SDValue = SDValue {};
    if sd_match(N1, m_Shl(m_Neg(m_Value(Y)), m_Value(N))) {
        return self.DAG.getNode(SUB, DL, VT, N0, self.DAG.getNode(SHL, DL, VT, Y, N));
    }
    if foldAddSubMasked1(true, N0, N1, self.DAG, DL) {
        V;
    } else {
        return V;
    }
    if !self.TLI.preferIncOfAddToSubOfNot(VT) && N0.getOpcode() == ADD && N0.hasOneUse() && isOneOrOneSplat(N0.getOperand(1), false) && (self.Level >= AfterLegalizeDAG || (!operator(N0).getFlags().hasNoUnsignedWrap() && !operator(N0).getFlags().hasNoSignedWrap())) {
        let mut Not: SDValue = self.DAG.getNOT(DL, N0.getOperand(0), VT);
        return self.DAG.getNode(SUB, DL, VT, N1, Not);
    }
    if N0.getOpcode() == SUB && N0.hasOneUse() {
        if isConstantOrConstantVector(N0.getOperand(1), true, false) {
            let mut Add: SDValue = self.DAG.getNode(ADD, DL, VT, N0.getOperand(0), N1);
            return self.DAG.getNode(SUB, DL, VT, Add, N0.getOperand(1));
        }
        if isConstantOrConstantVector(N0.getOperand(0), true, false) {
            let mut Sub: SDValue = self.DAG.getNode(SUB, DL, VT, N1, N0.getOperand(1));
            return self.DAG.getNode(ADD, DL, VT, Sub, N0.getOperand(0));
        }
    }
    if N0.getOpcode() == MUL && N0.getOperand(0) == N1 && isConstantOrConstantVector(N0.getOperand(1), true, false) && N0.hasOneUse() {
        let mut NewC: SDValue = self.DAG.getNode(ADD, DL, VT, N0.getOperand(1), self.DAG.getConstant(1, DL, VT, false, false));
        return self.DAG.getNode(MUL, DL, VT, N0.getOperand(0), NewC);
    }
    if N0.getOpcode() == SIGN_EXTEND && N0.getOperand(0).getScalarValueSizeInBits() == 1 && self.TLI.getBooleanContents(VT) == ZeroOrOneBooleanContent {
        let mut ZExt: SDValue = self.DAG.getNode(ZERO_EXTEND, DL, VT, N0.getOperand(0));
        return self.DAG.getNode(SUB, DL, VT, N1, ZExt);
    }
    if N1.getOpcode() == SIGN_EXTEND_INREG {
        let mut TN: *mut VTSDNode = cast(N1.getOperand(1));
        if TN.getVT() == EVT { i1 } {
            let mut ZExt: SDValue = self.DAG.getNode(AND, DL, VT, N1.getOperand(0), self.DAG.getConstant(1, DL, VT, false, false));
            return self.DAG.getNode(SUB, DL, VT, N0, ZExt);
        }
    }
    if N1.getOpcode() == UADDO_CARRY && isNullConstant(N1.getOperand(1)) && N1.getResNo() == 0 {
        return self.DAG.getNode(UADDO_CARRY, DL, operator(N1).getVTList(), N0, N1.getOperand(0), N1.getOperand(2));
    }
    if self.TLI.isOperationLegalOrCustom(UADDO_CARRY, VT, false) {
        if getAsCarry(self.TLI, N1, false) {
            Carry;
        } else {
            return self.DAG.getNode(UADDO_CARRY, DL, self.DAG.getVTList(VT, Carry.getValueType()), N0, self.DAG.getConstant(0, DL, VT, false, false), Carry);
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitADDC(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N0.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    if !N.hasAnyUseOfValue(1) {
        return self.CombineTo(N, self.DAG.getNode(ADD, DL, VT, N0, N1), self.DAG.getNode(CARRY_FALSE, DL, EVT { Glue }), true);
    }
    let mut N0C: *mut ConstantSDNode = dyn_cast(N0);
    let mut N1C: *mut ConstantSDNode = dyn_cast(N1);
    if N0C && !N1C {
        return self.DAG.getNode(ADDC, DL, N.getVTList(), N1, N0);
    }
    if isNullConstant(N1) {
        return self.CombineTo(N, N0, self.DAG.getNode(CARRY_FALSE, DL, EVT { Glue }), true);
    }
    if self.DAG.computeOverflowForUnsignedAdd(N0, N1) == OFK_Never {
        return self.CombineTo(N, self.DAG.getNode(ADD, DL, VT, N0, N1), self.DAG.getNode(CARRY_FALSE, DL, EVT { Glue }), true);
    }
    return SDValue {};
}

fn extractBooleanFlip(V: SDValue, DAG: *mut SelectionDAG, TLI: *TargetLowering, Force: bool) -> SDValue {
    if Force && isa(V) {
        return DAG.getLogicalNOT(SDLoc { V }, V, V.getValueType());
    }
    if V.getOpcode() != XOR {
        return SDValue {};
    }
    if DAG.isBoolConstant(V.getOperand(1)) == true {
        return V.getOperand(0);
    }
    if Force && isConstOrConstSplat(V.getOperand(1), false, false) {
        return DAG.getLogicalNOT(SDLoc { V }, V, V.getValueType());
    }
    return SDValue {};
}

fn DAGCombiner::visitADDO(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N0.getValueType();
    let mut IsSigned: bool = (SADDO == N.getOpcode());
    let mut CarryVT: EVT = N.getValueType(1);
    let mut DL: SDLoc = SDLoc { N };
    if !N.hasAnyUseOfValue(1) {
        return self.CombineTo(N, self.DAG.getNode(ADD, DL, VT, N0, N1), self.DAG.getUNDEF(CarryVT), true);
    }
    if self.DAG.isConstantIntBuildVectorOrConstantInt(N0, true) && !self.DAG.isConstantIntBuildVectorOrConstantInt(N1, true) {
        return self.DAG.getNode(N.getOpcode(), DL, N.getVTList(), N1, N0);
    }
    if isNullOrNullSplat(N1, false) {
        return self.CombineTo(N, N0, self.DAG.getConstant(0, DL, CarryVT, false, false), true);
    }
    if self.DAG.willNotOverflowAdd(IsSigned, N0, N1) {
        return self.CombineTo(N, self.DAG.getNode(ADD, DL, VT, N0, N1), self.DAG.getConstant(0, DL, CarryVT, false, false), true);
    }
    if IsSigned {
        if isBitwiseNot(N0, false) && isOneOrOneSplat(N1, false) {
            return self.DAG.getNode(SSUBO, DL, N.getVTList(), self.DAG.getConstant(0, DL, VT, false, false), N0.getOperand(0));
        }
    } else {
        if isBitwiseNot(N0, false) && isOneOrOneSplat(N1, false) {
            let mut Sub: SDValue = self.DAG.getNode(USUBO, DL, N.getVTList(), self.DAG.getConstant(0, DL, VT, false, false), N0.getOperand(0));
            return self.CombineTo(N, Sub, self.DAG.getLogicalNOT(DL, Sub.getValue(1), operator(Sub).getValueType(1)), true);
        }
        if self.visitUADDOLike(N0, N1, N) {
            Combined;
        } else {
            return Combined;
        }
        if self.visitUADDOLike(N1, N0, N) {
            Combined;
        } else {
            return Combined;
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitUADDOLike(self, N0: SDValue, N1: SDValue, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N0.getValueType();
    if VT.isVector() {
        return SDValue {};
    }
    if N1.getOpcode() == UADDO_CARRY && isNullConstant(N1.getOperand(1)) {
        let mut Y: SDValue = N1.getOperand(0);
        let mut One: SDValue = self.DAG.getConstant(1, SDLoc { N }, Y.getValueType(), false, false);
        if self.DAG.computeOverflowForUnsignedAdd(Y, One) == OFK_Never {
            return self.DAG.getNode(UADDO_CARRY, SDLoc { N }, N.getVTList(), N0, Y, N1.getOperand(2));
        }
    }
    if self.TLI.isOperationLegalOrCustom(UADDO_CARRY, VT, false) {
        if getAsCarry(self.TLI, N1, false) {
            Carry;
        } else {
            return self.DAG.getNode(UADDO_CARRY, SDLoc { N }, N.getVTList(), N0, self.DAG.getConstant(0, SDLoc { N }, VT, false, false), Carry);
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitADDE(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut CarryIn: SDValue = N.getOperand(2);
    let mut N0C: *mut ConstantSDNode = dyn_cast(N0);
    let mut N1C: *mut ConstantSDNode = dyn_cast(N1);
    if N0C && !N1C {
        return self.DAG.getNode(ADDE, SDLoc { N }, N.getVTList(), N1, N0, CarryIn);
    }
    if CarryIn.getOpcode() == CARRY_FALSE {
        return self.DAG.getNode(ADDC, SDLoc { N }, N.getVTList(), N0, N1);
    }
    return SDValue {};
}

fn DAGCombiner::visitUADDO_CARRY(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut CarryIn: SDValue = N.getOperand(2);
    let mut DL: SDLoc = SDLoc { N };
    let mut N0C: *mut ConstantSDNode = dyn_cast(N0);
    let mut N1C: *mut ConstantSDNode = dyn_cast(N1);
    if N0C && !N1C {
        return self.DAG.getNode(UADDO_CARRY, DL, N.getVTList(), N1, N0, CarryIn);
    }
    if isNullConstant(CarryIn) {
        if !self.LegalOperations || self.TLI.isOperationLegalOrCustom(UADDO, N.getValueType(0), false) {
            return self.DAG.getNode(UADDO, DL, N.getVTList(), N0, N1);
        }
    }
    if isNullConstant(N0) && isNullConstant(N1) {
        let mut VT: EVT = N0.getValueType();
        let mut CarryVT: EVT = CarryIn.getValueType();
        let mut CarryExt: SDValue = self.DAG.getBoolExtOrTrunc(CarryIn, DL, VT, CarryVT);
        self.AddToWorklist(CarryExt.getNode(), true, false);
        return self.CombineTo(N, self.DAG.getNode(AND, DL, VT, CarryExt, self.DAG.getConstant(1, DL, VT, false, false)), self.DAG.getConstant(0, DL, CarryVT, false, false), true);
    }
    if self.visitUADDO_CARRYLike(N0, N1, CarryIn, N) {
        Combined;
    } else {
        return Combined;
    }
    if self.visitUADDO_CARRYLike(N1, N0, CarryIn, N) {
        Combined;
    } else {
        return Combined;
    }
    let mut Ops: [3]SDValue = [N1, N0, CarryIn];
    let mut CSENode: *mut SDNode = self.DAG.getNodeIfExists(UADDO_CARRY, N.getVTList(), ArrayRef<SDValue> { Ops }, N.getFlags(), false);
    if CSENode {
        return SDValue { Node: CSENode, ResNo: 0 };
    }
    return SDValue {};
}

fn combineUADDO_CARRYDiamond(Combiner: *mut DAGCombiner, DAG: *mut SelectionDAG, X: SDValue, Carry0: SDValue, Carry1: SDValue, N: *mut SDNode) -> SDValue {
    if Carry1.getResNo() != 1 || Carry0.getResNo() != 1 {
        return SDValue {};
    }
    if Carry1.getOpcode() != UADDO {
        return SDValue {};
    }
    let mut Z: SDValue = SDValue {};
    if Carry0.getOpcode() == UADDO_CARRY && isNullConstant(Carry0.getOperand(1)) {
        Z = Carry0.getOperand(2);
    } else if Carry0.getOpcode() == UADDO && isOneConstant(Carry0.getOperand(1)) {
        let mut VT: EVT = operator(Carry0).getValueType(1);
        Z = DAG.getConstant(1, SDLoc { Carry0.getOperand(1) }, VT, false, false);
    } else {
        return SDValue {};
    }
    let mut cancelDiamond: Closure_7 = Closure_7 { N: &mut N, DAG: &mut DAG, Carry0: &mut Carry0, Z: &mut Z, Combiner: &mut Combiner, X: &mut X };
    if Carry0.getOperand(0) == Carry1.getValue(0) {
        return cancelDiamond.call(Carry1.getOperand(0), Carry1.getOperand(1));
    }
    if Carry1.getOperand(0) == Carry0.getValue(0) {
        return cancelDiamond.call(Carry0.getOperand(0), Carry1.getOperand(1));
    }
    if Carry1.getOperand(1) == Carry0.getValue(0) {
        return cancelDiamond.call(Carry1.getOperand(0), Carry0.getOperand(0));
    }
    return SDValue {};
}

fn combineCarryDiamond(DAG: *mut SelectionDAG, TLI: *TargetLowering, N0: SDValue, N1: SDValue, N: *mut SDNode) -> SDValue {
    let mut Carry0: SDValue = getAsCarry(TLI, N0, false);
    if !Carry0 {
        return SDValue {};
    }
    let mut Carry1: SDValue = getAsCarry(TLI, N1, false);
    if !Carry1 {
        return SDValue {};
    }
    let mut Opcode: u32 = Carry0.getOpcode();
    if Opcode != Carry1.getOpcode() {
        return SDValue {};
    }
    if Opcode != UADDO && Opcode != USUBO {
        return SDValue {};
    }
    let mut CarryOutType: EVT = N.getValueType(0);
    if CarryOutType != Carry0.getValue(1).getValueType() || CarryOutType != Carry1.getValue(1).getValueType() {
        return SDValue {};
    }
    if Carry1.getNode().isOperandOf(Carry0.getNode()) {
        swap(Carry0, Carry1);
    }
    if Carry1.getOperand(0) != Carry0.getValue(0) && Carry1.getOperand(1) != Carry0.getValue(0) {
        return SDValue {};
    }
    let mut CarryInOperandNum: u32 = if Carry1.getOperand(0) == Carry0.getValue(0) { 1 } else { 0 };
    if Opcode == USUBO && CarryInOperandNum != 1 {
        return SDValue {};
    }
    let mut CarryIn: SDValue = Carry1.getOperand(CarryInOperandNum);
    let mut NewOp: u32 = if Opcode == UADDO { UADDO_CARRY } else { USUBO_CARRY };
    if !TLI.isOperationLegalOrCustom(NewOp, Carry0.getValue(0).getValueType(), false) {
        return SDValue {};
    }
    CarryIn = getAsCarry(TLI, CarryIn, true);
    if !CarryIn {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { N };
    CarryIn = DAG.getBoolExtOrTrunc(CarryIn, DL, operator(Carry1).getValueType(1), operator(Carry1).getValueType(0));
    let mut Merged: SDValue = DAG.getNode(NewOp, DL, operator(Carry1).getVTList(), Carry0.getOperand(0), Carry0.getOperand(1), CarryIn);
    DAG.ReplaceAllUsesOfValueWith(Carry1.getValue(0), Merged.getValue(0));
    if N.getOpcode() == AND {
        return DAG.getConstant(0, DL, CarryOutType, false, false);
    }
    return Merged.getValue(1);
}

fn combineOrOfSetCCToUSUBOCarry(N: *mut SDNode, DAG: *mut SelectionDAG, TLI: *TargetLowering) -> SDValue {
    let mut A: SDValue = SDValue {};
    let mut B: SDValue = SDValue {};
    let mut CarryIn: SDValue = SDValue {};
    if !sd_match(N, m_Or(m_SpecificSetCC(SETULT, m_Value(A), m_Value(B)), m_And(m_c_SpecificSetCC(SETEQ, m_Deferred(A), m_Deferred(B)), m_Value(CarryIn)))) {
        return SDValue {};
    }
    let mut IntVT: EVT = A.getValueType();
    if IntVT.isVector() || !TLI.isOperationLegalOrCustom(USUBO_CARRY, TLI.getLegalTypeToTransformTo(*DAG.getContext(), IntVT), false) {
        return SDValue {};
    }
    if TLI.getBooleanContents(IntVT) != ZeroOrOneBooleanContent || !DAG.MaskedValueIsZero(CarryIn, getBitsSetFrom(CarryIn.getScalarValueSizeInBits(), 1), 0) {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { N };
    let mut VTs: SDVTList = DAG.getVTList(IntVT, N.getValueType(0));
    return DAG.getNode(USUBO_CARRY, DL, VTs, A, B, CarryIn).getValue(1);
}

fn DAGCombiner::visitUADDO_CARRYLike(self, N0: SDValue, N1: SDValue, CarryIn: SDValue, N: *mut SDNode) -> SDValue {
    if isBitwiseNot(N0, false) {
        if extractBooleanFlip(CarryIn, self.DAG, self.TLI, true) {
            NotC;
        } else {
            let mut DL: SDLoc = SDLoc { N };
            let mut Sub: SDValue = self.DAG.getNode(USUBO_CARRY, DL, N.getVTList(), N1, N0.getOperand(0), NotC);
            return self.CombineTo(N, Sub, self.DAG.getLogicalNOT(DL, Sub.getValue(1), operator(Sub).getValueType(1)), true);
        }
    }
    if (N0.getOpcode() == ADD || (N0.getOpcode() == UADDO && N0.getResNo() == 0 && N0.getValue(1) != CarryIn)) && isNullConstant(N1) && !N.hasAnyUseOfValue(1) {
        return self.DAG.getNode(UADDO_CARRY, SDLoc { N }, N.getVTList(), N0.getOperand(0), N0.getOperand(1), CarryIn);
    }
    if getAsCarry(self.TLI, N1, false) {
        Y;
    } else {
        if combineUADDO_CARRYDiamond(*self, self.DAG, N0, Y, CarryIn, N) {
            R;
        } else {
            return R;
        }
        if combineUADDO_CARRYDiamond(*self, self.DAG, N0, CarryIn, Y, N) {
            R;
        } else {
            return R;
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitSADDO_CARRYLike(self, N0: SDValue, N1: SDValue, CarryIn: SDValue, N: *mut SDNode) -> SDValue {
    if isBitwiseNot(N0, false) {
        if extractBooleanFlip(CarryIn, self.DAG, self.TLI, true) {
            NotC;
        } else {
            return self.DAG.getNode(SSUBO_CARRY, SDLoc { N }, N.getVTList(), N1, N0.getOperand(0), NotC);
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitSADDO_CARRY(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut CarryIn: SDValue = N.getOperand(2);
    let mut DL: SDLoc = SDLoc { N };
    let mut N0C: *mut ConstantSDNode = dyn_cast(N0);
    let mut N1C: *mut ConstantSDNode = dyn_cast(N1);
    if N0C && !N1C {
        return self.DAG.getNode(SADDO_CARRY, DL, N.getVTList(), N1, N0, CarryIn);
    }
    if isNullConstant(CarryIn) {
        if !self.LegalOperations || self.TLI.isOperationLegalOrCustom(SADDO, N.getValueType(0), false) {
            return self.DAG.getNode(SADDO, DL, N.getVTList(), N0, N1);
        }
    }
    if self.visitSADDO_CARRYLike(N0, N1, CarryIn, N) {
        Combined;
    } else {
        return Combined;
    }
    if self.visitSADDO_CARRYLike(N1, N0, CarryIn, N) {
        Combined;
    } else {
        return Combined;
    }
    return SDValue {};
}

fn getTruncatedUSUBSAT(DstVT: EVT, SrcVT: EVT, LHS: SDValue, RHS: SDValue, DAG: *mut SelectionDAG, DL: *SDLoc) -> SDValue {
    assert!(DstVT.getScalarSizeInBits() <= SrcVT.getScalarSizeInBits(), "Illegal truncation");
    if DstVT == SrcVT {
        return DAG.getNode(USUBSAT, DL, DstVT, LHS, RHS);
    }
    let mut UpperBits: APInt = getBitsSetFrom(SrcVT.getScalarSizeInBits(), DstVT.getScalarSizeInBits());
    if !DAG.MaskedValueIsZero(LHS, UpperBits, 0) {
        return SDValue {};
    }
    let mut SatLimit: SDValue = DAG.getConstant(getLowBitsSet(SrcVT.getScalarSizeInBits(), DstVT.getScalarSizeInBits()), DL, SrcVT, false, false);
    RHS = DAG.getNode(UMIN, DL, SrcVT, RHS, SatLimit);
    RHS = DAG.getNode(TRUNCATE, DL, DstVT, RHS);
    LHS = DAG.getNode(TRUNCATE, DL, DstVT, LHS);
    return DAG.getNode(USUBSAT, DL, DstVT, LHS, RHS);
}

fn DAGCombiner::foldSubToUSubSat(self, DstVT: EVT, N: *mut SDNode, DL: *SDLoc) -> SDValue {
    if N.getOpcode() != SUB || !(!self.LegalOperations || self.hasOperation(USUBSAT, DstVT)) {
        return SDValue {};
    }
    let mut SubVT: EVT = N.getValueType(0);
    let mut Op0: SDValue = N.getOperand(0);
    let mut Op1: SDValue = N.getOperand(1);
    if Op0.getOpcode() == UMAX && Op0.hasOneUse() {
        let mut MaxLHS: SDValue = Op0.getOperand(0);
        let mut MaxRHS: SDValue = Op0.getOperand(1);
        if MaxLHS == Op1 {
            return getTruncatedUSUBSAT(DstVT, SubVT, MaxRHS, Op1, self.DAG, DL);
        }
        if MaxRHS == Op1 {
            return getTruncatedUSUBSAT(DstVT, SubVT, MaxLHS, Op1, self.DAG, DL);
        }
    }
    if Op1.getOpcode() == UMIN && Op1.hasOneUse() {
        let mut MinLHS: SDValue = Op1.getOperand(0);
        let mut MinRHS: SDValue = Op1.getOperand(1);
        if MinLHS == Op0 {
            return getTruncatedUSUBSAT(DstVT, SubVT, Op0, MinRHS, self.DAG, DL);
        }
        if MinRHS == Op0 {
            return getTruncatedUSUBSAT(DstVT, SubVT, Op0, MinLHS, self.DAG, DL);
        }
    }
    if Op1.getOpcode() == TRUNCATE && Op1.getOperand(0).getOpcode() == UMIN && Op1.getOperand(0).hasOneUse() {
        let mut MinLHS: SDValue = Op1.getOperand(0).getOperand(0);
        let mut MinRHS: SDValue = Op1.getOperand(0).getOperand(1);
        if MinLHS.getOpcode() == ZERO_EXTEND && MinLHS.getOperand(0) == Op0 {
            return getTruncatedUSUBSAT(DstVT, MinLHS.getValueType(), MinLHS, MinRHS, self.DAG, DL);
        }
        if MinRHS.getOpcode() == ZERO_EXTEND && MinRHS.getOperand(0) == Op0 {
            return getTruncatedUSUBSAT(DstVT, MinLHS.getValueType(), MinRHS, MinLHS, self.DAG, DL);
        }
    }
    return SDValue {};
}

fn foldSubCtlzNot(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N0.getValueType();
    let mut BitWidth: u32 = VT.getScalarSizeInBits();
    let mut AndMask: APInt = APInt {};
    let mut XorMask: APInt = APInt {};
    let mut BitWidthDiff: u64 = 0;
    let mut CtlzOp: SDValue = SDValue {};
    let mut Src: SDValue = SDValue {};
    if !sd_match(N, m_Sub(m_Ctlz(m_Value(CtlzOp)), m_ConstInt(BitWidthDiff))) {
        return SDValue {};
    }
    if sd_match(CtlzOp, m_ZExt(m_Not(m_Value(Src)))) {
        if (BitWidth - Src.getValueType().getScalarSizeInBits()) != BitWidthDiff {
            return SDValue {};
        }
        Src = DAG.getNode(ANY_EXTEND, DL, VT, Src);
    } else if sd_match(CtlzOp, m_And(m_Xor(m_Value(Src), m_ConstInt(XorMask)), m_ConstInt(AndMask))) {
        if BitWidthDiff >= BitWidth {
            return SDValue {};
        }
        let mut AndMaskWidth: u32 = BitWidth - BitWidthDiff;
        if !(AndMask.isMask(AndMaskWidth) && XorMask.countr_one() >= AndMaskWidth) {
            return SDValue {};
        }
    } else {
        return SDValue {};
    }
    let mut ShiftConst: SDValue = DAG.getShiftAmountConstant(BitWidthDiff, VT, DL);
    let mut LShift: SDValue = DAG.getNode(SHL, DL, VT, Src, ShiftConst);
    let mut Not: SDValue = DAG.getNode(XOR, DL, VT, LShift, DAG.getAllOnesConstant(DL, VT, false, false));
    return DAG.getNode(CTLZ_ZERO_POISON, DL, VT, Not);
}

fn foldRemainderIdiom(N: *mut SDNode, DAG: *mut SelectionDAG, DL: *SDLoc) -> SDValue {
    assert!(N.getOpcode() == SUB, "Node must be a SUB");
    let mut Sub0: SDValue = N.getOperand(0);
    let mut Sub1: SDValue = N.getOperand(1);
    let mut CheckAndFoldMulCase: Closure_8 = Closure_8 { Sub0: &mut Sub0 };
    if Sub1.getOpcode() == MUL {
        let mut Mul0: SDValue = Sub1.getOperand(0);
        let mut Mul1: SDValue = Sub1.getOperand(1);
        if CheckAndFoldMulCase.call(Mul0, Mul1) {
            Res;
        } else {
            return Res;
        }
        if CheckAndFoldMulCase.call(Mul1, Mul0) {
            Res;
        } else {
            return Res;
        }
    } else if Sub1.getOpcode() == SHL {
        let mut Shl0: SDValue = Sub1.getOperand(0);
        let mut Shl1: SDValue = Sub1.getOperand(1);
        if (Shl0.getOpcode() == SDIVREM || Shl0.getOpcode() == UDIVREM) && Shl0.getResNo() == 0 && Shl0.getOperand(0) == Sub0 {
            let mut Divisor: SDValue = Shl0.getOperand(1);
            let mut DivC: *mut ConstantSDNode = isConstOrConstSplat(Divisor, false, false);
            let mut ShC: *mut ConstantSDNode = isConstOrConstSplat(Shl1, false, false);
            if !DivC || !ShC {
                return SDValue {};
            }
            if DivC.getAPIntValue().isPowerOf2() && DivC.getAPIntValue().logBase2() == ShC.getAPIntValue() {
                return SDValue { Node: Shl0.getNode(), ResNo: 1 };
            }
        }
    }
    return SDValue {};
}

fn tryFoldToZero(DL: *SDLoc, TLI: *TargetLowering, VT: EVT, DAG: *mut SelectionDAG, LegalOperations: bool) -> SDValue {
    if !VT.isVector() {
        return DAG.getConstant(0, DL, VT, false, false);
    }
    if !LegalOperations || TLI.isOperationLegal(BUILD_VECTOR, VT) {
        return DAG.getConstant(0, DL, VT, false, false);
    }
    return SDValue {};
}

fn DAGCombiner::visitSUB(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N0.getValueType();
    let mut BitWidth: u32 = VT.getScalarSizeInBits();
    let mut DL: SDLoc = SDLoc { N };
    if foldSubCtlzNot(N, self.DAG) {
        V;
    } else {
        return V;
    }
    if N0 == N1 {
        return tryFoldToZero(DL, self.TLI, VT, self.DAG, self.LegalOperations);
    }
    if self.DAG.FoldConstantArithmetic(SUB, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if VT.isVector() {
        if self.SimplifyVBinOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
        if isConstantSplatVectorAllZeros(N1.getNode(), false) {
            return N0;
        }
    }
    if N1.hasOneUse() && self.hasUMin(VT) {
        let mut Y: SDValue = SDValue {};
        let mut MS0: Value_match = m_Specific(N0);
        let mut MVY: Value_bind = m_Value(Y);
        let mut MZ: Zero_match = m_Zero(false);
        if sd_match(N1, m_SpecificSelectCCLike(SETULT, MS0, MVY, MZ, m_Deferred(Y))) || sd_match(N1, m_SpecificSelectCCLike(SETUGE, MS0, MVY, m_Deferred(Y), MZ)) || sd_match(N1, m_VSelect(m_SpecificSetCC(SETULT, MS0, MVY), MZ, m_Deferred(Y))) || sd_match(N1, m_VSelect(m_SpecificSetCC(SETUGE, MS0, MVY), m_Deferred(Y), MZ)) {
            return self.DAG.getNode(UMIN, DL, VT, N0, self.DAG.getNode(SUB, DL, VT, N0, Y));
        }
    }
    if self.foldBinOpIntoSelect(N) {
        NewSel;
    } else {
        return NewSel;
    }
    if getAsNonOpaqueConstant(N1) {
        N1C;
    } else {
        return self.DAG.getNode(ADD, DL, VT, N0, self.DAG.getConstant(operator(N1C.getAPIntValue()), DL, VT, false, false));
    }
    if isNullOrNullSplat(N0, false) {
        if operator(N1).getOpcode() == SRA || operator(N1).getOpcode() == SRL {
            let mut ShiftAmt: *mut ConstantSDNode = isConstOrConstSplat(N1.getOperand(1), false, false);
            if ShiftAmt && ShiftAmt.getAPIntValue() == (BitWidth - 1) {
                let mut NewSh: NodeType = if operator(N1).getOpcode() == SRA { SRL } else { SRA };
                if !self.LegalOperations || self.TLI.isOperationLegal(NewSh, VT) {
                    return self.DAG.getNode(NewSh, DL, VT, N1.getOperand(0), N1.getOperand(1));
                }
            }
        }
        if N.getFlags().hasNoUnsignedWrap() {
            return N0;
        }
        if self.DAG.MaskedValueIsZero(N1, operator(getSignMask(BitWidth)), 0) {
            if N.getFlags().hasNoSignedWrap() {
                return N0;
            }
            return N1;
        }
        if isAbsOpcode(N1.getOpcode()) && N1.hasOneUse() && !self.TLI.isOperationLegalOrCustom(N1.getOpcode(), VT, false) {
            if self.TLI.expandABS(N1.getNode(), self.DAG, true) {
                Result;
            } else {
                return Result;
            }
        }
        let mut X: SDValue = SDValue {};
        let mut S0: SDValue = SDValue {};
        let mut NegPat: Value_bind> = m_Value(S0, m_Neg(m_Deferred(X)));
        if sd_match(N1, m_OneUse(m_AnyOf(m_SMax(m_Value(X), NegPat), m_UMax(m_Value(X), NegPat), m_SMin(m_Value(X), NegPat), m_UMin(m_Value(X), NegPat)))) {
            let mut NewOpc: u32 = getInverseMinMaxOpcode(operator(N1).getOpcode());
            if self.hasOperation(NewOpc, VT) {
                return self.DAG.getNode(NewOpc, DL, VT, X, S0);
            }
        }
        if VT.isVector() {
            let mut N1S: SDValue = self.DAG.getSplatValue(N1, true);
            if N1S && N1S.getOpcode() == SUB && isNullConstant(N1S.getOperand(0)) {
                return self.DAG.getSplat(VT, DL, N1S.getOperand(1));
            }
        }
        if N1.getOpcode() == AND && N1.hasOneUse() && isOneOrOneSplat(operator(N1).getOperand(1), false) {
            let mut ExtVT: EVT = VT.changeElementType(*self.DAG.getContext(), EVT { i1 });
            if self.TLI.getOperationAction(SIGN_EXTEND_INREG, ExtVT) == Legal {
                return self.DAG.getNode(SIGN_EXTEND_INREG, DL, VT, operator(N1).getOperand(0), self.DAG.getValueType(ExtVT));
            }
        }
    }
    if isAllOnesOrAllOnesSplat(N0, false) {
        return self.DAG.getNode(XOR, DL, VT, N1, N0);
    }
    if N1.getOpcode() == SUB && isNullOrNullSplat(N1.getOperand(0), false) {
        return self.DAG.getNode(ADD, DL, VT, N0, N1.getOperand(1));
    }
    if N1.getOpcode() == SUB && N0 == N1.getOperand(0) {
        return N1.getOperand(1);
    }
    if N0.getOpcode() == ADD && N0.getOperand(0) == N1 {
        return N0.getOperand(1);
    }
    if N0.getOpcode() == ADD && N0.getOperand(1) == N1 {
        return N0.getOperand(0);
    }
    if N0.getOpcode() == ADD {
        let mut N01: SDValue = N0.getOperand(1);
        if self.DAG.FoldConstantArithmetic(SUB, DL, VT, ArrayRef<SDValue> { [N01, N1] }, SDNodeFlags { Flags: None }) {
            NewC;
        } else {
            return self.DAG.getNode(ADD, DL, VT, N0.getOperand(0), NewC);
        }
    }
    if N1.getOpcode() == ADD {
        let mut N11: SDValue = N1.getOperand(1);
        if self.DAG.FoldConstantArithmetic(SUB, DL, VT, ArrayRef<SDValue> { [N0, N11] }, SDNodeFlags { Flags: None }) {
            NewC;
        } else {
            return self.DAG.getNode(SUB, DL, VT, NewC, N1.getOperand(0));
        }
    }
    if N0.getOpcode() == SUB {
        let mut N01: SDValue = N0.getOperand(1);
        if self.DAG.FoldConstantArithmetic(ADD, DL, VT, ArrayRef<SDValue> { [N01, N1] }, SDNodeFlags { Flags: None }) {
            NewC;
        } else {
            return self.DAG.getNode(SUB, DL, VT, N0.getOperand(0), NewC);
        }
    }
    if N0.getOpcode() == SUB {
        let mut N00: SDValue = N0.getOperand(0);
        if self.DAG.FoldConstantArithmetic(SUB, DL, VT, ArrayRef<SDValue> { [N00, N1] }, SDNodeFlags { Flags: None }) {
            NewC;
        } else {
            return self.DAG.getNode(SUB, DL, VT, NewC, N0.getOperand(1));
        }
    }
    let mut A: SDValue = SDValue {};
    let mut B: SDValue = SDValue {};
    let mut C: SDValue = SDValue {};
    if sd_match(N0, m_Add(m_Value(A), m_Add(m_Specific(N1), m_Value(C)))) {
        return self.DAG.getNode(ADD, DL, VT, A, C);
    }
    if sd_match(N0, m_Add(m_Value(A), m_Sub(m_Specific(N1), m_Value(C)))) {
        return self.DAG.getNode(SUB, DL, VT, A, C);
    }
    if sd_match(N0, m_Sub(m_Value(A), m_Sub(m_Value(B), m_Specific(N1)))) {
        return self.DAG.getNode(SUB, DL, VT, A, B);
    }
    if sd_match(N1, m_OneUse(m_Sub(m_Value(B), m_Value(C)))) {
        return self.DAG.getNode(ADD, DL, VT, N0, self.DAG.getNode(SUB, DL, VT, C, B));
    }
    if sd_match(N1, m_And(m_Specific(N0), m_Value(B))) && (N1.hasOneUse() || isConstantOrConstantVector(B, true, false)) {
        return self.DAG.getNode(AND, DL, VT, N0, self.DAG.getNOT(DL, B, VT));
    }
    if sd_match(N1, m_OneUse(m_Mul(m_Neg(m_Value(B)), m_Value(C)))) {
        return self.DAG.getNode(ADD, DL, VT, N0, self.DAG.getNode(MUL, DL, VT, B, C));
    }
    if N0.isUndef() {
        return N0;
    }
    if N1.isUndef() {
        return N1;
    }
    if foldAddSubBoolOfMaskedVal(N, DL, self.DAG) {
        V;
    } else {
        return V;
    }
    if foldAddSubOfSignBit(N, DL, self.DAG) {
        V;
    } else {
        return V;
    }
    if self.foldSubToAvg(N, DL) {
        V;
    } else {
        return V;
    }
    if foldAddSubMasked1(false, N0, N1, self.DAG, DL) {
        V;
    } else {
        return V;
    }
    if self.foldSubToUSubSat(VT, N, DL) {
        V;
    } else {
        return V;
    }
    if foldRemainderIdiom(N, self.DAG, DL) {
        V;
    } else {
        return V;
    }
    if sd_match(N, m_Sub(m_OneUse(m_Sub(m_Value(A), m_Value(B))), m_One(true))) {
        return self.DAG.getNode(ADD, DL, VT, A, self.DAG.getNOT(DL, B, VT));
    }
    if self.TLI.preferIncOfAddToSubOfNot(VT) && N1.hasOneUse() && isBitwiseNot(N1, false) {
        let mut Add: SDValue = self.DAG.getNode(ADD, DL, VT, N0, N1.getOperand(0));
        return self.DAG.getNode(ADD, DL, VT, Add, self.DAG.getConstant(1, DL, VT, false, false));
    }
    if !self.reassociationCanBreakAddressingModePattern(SUB, DL, N, N0, N1) && N0.getOpcode() == ADD && N0.hasOneUse() && isConstantOrConstantVector(N0.getOperand(1), true, false) {
        let mut Sub: SDValue = self.DAG.getNode(SUB, DL, VT, N0.getOperand(0), N1);
        return self.DAG.getNode(ADD, DL, VT, Sub, N0.getOperand(1));
    }
    if N1.getOpcode() == ADD && N1.hasOneUse() && isConstantOrConstantVector(N1.getOperand(1), true, false) {
        let mut Sub: SDValue = self.DAG.getNode(SUB, DL, VT, N0, N1.getOperand(0));
        return self.DAG.getNode(SUB, DL, VT, Sub, N1.getOperand(1));
    }
    if N0.getOpcode() == SUB && N0.hasOneUse() && isConstantOrConstantVector(N0.getOperand(1), true, false) {
        let mut Sub: SDValue = self.DAG.getNode(SUB, DL, VT, N0.getOperand(0), N1);
        return self.DAG.getNode(SUB, DL, VT, Sub, N0.getOperand(1));
    }
    if N0.getOpcode() == SUB && N0.hasOneUse() && isConstantOrConstantVector(N0.getOperand(0), true, false) {
        let mut Add: SDValue = self.DAG.getNode(ADD, DL, VT, N0.getOperand(1), N1);
        return self.DAG.getNode(SUB, DL, VT, N0.getOperand(0), Add);
    }
    if N1.getOpcode() == ZERO_EXTEND && N1.getOperand(0).getScalarValueSizeInBits() == 1 && self.TLI.getBooleanContents(VT) == ZeroOrNegativeOneBooleanContent {
        let mut SExt: SDValue = self.DAG.getNode(SIGN_EXTEND, DL, VT, N1.getOperand(0));
        return self.DAG.getNode(ADD, DL, VT, N0, SExt);
    }
    if (!self.LegalOperations || self.hasOperation(ABS, VT)) && sd_match(N1, m_Sra(m_Value(A), m_SpecificInt(BitWidth - 1))) && sd_match(N0, m_Xor(m_Specific(A), m_Specific(N1))) {
        return self.DAG.getNode(ABS, DL, VT, A);
    }
    if dyn_cast(N0) {
        GA;
    } else if !self.LegalOperations && self.TLI.isOffsetFoldingLegal(GA) {
        if dyn_cast(N1) {
            GB;
        } else if GA.getGlobal() == GB.getGlobal() {
            return self.DAG.getConstant(APInt { VT.getScalarSizeInBits(), GA.getOffset() - GB.getOffset(), false, true }, DL, VT, false, false);
        }
    }
    if N1.getOpcode() == SIGN_EXTEND_INREG {
        let mut TN: *mut VTSDNode = cast(N1.getOperand(1));
        if TN.getVT() == EVT { i1 } {
            let mut ZExt: SDValue = self.DAG.getNode(AND, DL, VT, N1.getOperand(0), self.DAG.getConstant(1, DL, VT, false, false));
            return self.DAG.getNode(ADD, DL, VT, N0, ZExt);
        }
    }
    if N1.getOpcode() == VSCALE {
        let mut IntVal: *APInt = N1.getConstantOperandAPInt(0);
        if (N1.hasOneUse() || self.TLI.isLegalAddScalableImmediate(-IntVal.getSExtValue())) && (!IntVal.isPowerOf2() || self.hasOperation(MUL, N1.getOperand(0).getValueType())) {
            return self.DAG.getNode(ADD, DL, VT, N0, self.DAG.getVScale(DL, VT, operator(IntVal)));
        }
    }
    if N1.getOpcode() == STEP_VECTOR && N1.hasOneUse() {
        let mut NewStep: APInt = operator(N1.getConstantOperandAPInt(0));
        return self.DAG.getNode(ADD, DL, VT, N0, self.DAG.getStepVector(DL, VT, NewStep));
    }
    if !self.LegalOperations && N1.getOpcode() == SRL && N1.hasOneUse() {
        let mut ShAmt: SDValue = N1.getOperand(1);
        let mut ShAmtC: *mut ConstantSDNode = isConstOrConstSplat(ShAmt, false, false);
        if ShAmtC && ShAmtC.getAPIntValue() == (BitWidth - 1) {
            let mut SRA: SDValue = self.DAG.getNode(SRA, DL, VT, N1.getOperand(0), ShAmt);
            return self.DAG.getNode(ADD, DL, VT, N0, SRA);
        }
    }
    if N1.getOpcode() == SHL {
        let mut ShlC: *mut ConstantSDNode = isConstOrConstSplat(N1.getOperand(1), false, false);
        if ShlC && ShlC.getAPIntValue() == (BitWidth - 1) {
            return self.DAG.getNode(ADD, DL, VT, N1, N0);
        }
    }
    if N0.getOpcode() == USUBO_CARRY && isNullConstant(N0.getOperand(1)) && N0.getResNo() == 0 && N0.hasOneUse() {
        return self.DAG.getNode(USUBO_CARRY, DL, operator(N0).getVTList(), N0.getOperand(0), N1, N0.getOperand(2));
    }
    if self.TLI.isOperationLegalOrCustom(UADDO_CARRY, VT, false) {
        if getAsCarry(self.TLI, N0, false) {
            Carry;
        } else {
            let mut X: SDValue = N1;
            let mut Zero: SDValue = self.DAG.getConstant(0, DL, VT, false, false);
            let mut NegX: SDValue = self.DAG.getNode(SUB, DL, VT, Zero, X);
            return self.DAG.getNode(UADDO_CARRY, DL, self.DAG.getVTList(VT, Carry.getValueType()), NegX, Zero, Carry);
        }
    }
    if isConstOrConstSplat(N0, false, false) {
        C0;
    } else {
        let mut C0Val: *APInt = C0.getAPIntValue();
        if N.getFlags().hasNoUnsignedWrap() && C0Val.isMask() {
            return self.DAG.getNode(XOR, DL, VT, N1, N0);
        }
        if !C0.isOpaque() {
            let mut MaybeOnes: *APInt = operator(self.DAG.computeKnownBits(N1, 0).Zero);
            if (C0Val - MaybeOnes) == (C0Val ^ MaybeOnes) {
                return self.DAG.getNode(XOR, DL, VT, N1, N0);
            }
        }
    }
    if (!self.LegalOperations || self.hasOperation(ABDS, VT)) && sd_match(N0, m_SMaxLike(m_Value(A), m_Value(B))) && sd_match(N1, m_SMinLike(m_Specific(A), m_Specific(B))) {
        return self.DAG.getNode(ABDS, DL, VT, A, B);
    }
    if (!self.LegalOperations || self.hasOperation(ABDS, VT)) && sd_match(N0, m_SMinLike(m_Value(A), m_Value(B))) && sd_match(N1, m_SMaxLike(m_Specific(A), m_Specific(B))) {
        return self.DAG.getNegative(self.DAG.getNode(ABDS, DL, VT, A, B), DL, VT);
    }
    if (!self.LegalOperations || self.hasOperation(ABDU, VT)) && sd_match(N0, m_UMaxLike(m_Value(A), m_Value(B))) && sd_match(N1, m_UMinLike(m_Specific(A), m_Specific(B))) {
        return self.DAG.getNode(ABDU, DL, VT, A, B);
    }
    if (!self.LegalOperations || self.hasOperation(ABDU, VT)) && sd_match(N0, m_UMinLike(m_Value(A), m_Value(B))) && sd_match(N1, m_UMaxLike(m_Specific(A), m_Specific(B))) {
        return self.DAG.getNegative(self.DAG.getNode(ABDU, DL, VT, A, B), DL, VT);
    }
    return SDValue {};
}

fn DAGCombiner::visitSUBSAT(self, N: *mut SDNode) -> SDValue {
    let mut Opcode: u32 = N.getOpcode();
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N0.getValueType();
    let mut IsSigned: bool = Opcode == SSUBSAT;
    let mut DL: SDLoc = SDLoc { N };
    if N0.isUndef() || N1.isUndef() {
        return self.DAG.getConstant(0, DL, VT, false, false);
    }
    if N0 == N1 {
        return self.DAG.getConstant(0, DL, VT, false, false);
    }
    if self.DAG.FoldConstantArithmetic(Opcode, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if VT.isVector() {
        if self.SimplifyVBinOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
        if isConstantSplatVectorAllZeros(N1.getNode(), false) {
            return N0;
        }
    }
    if isNullConstant(N1) {
        return N0;
    }
    if self.DAG.willNotOverflowSub(IsSigned, N0, N1) {
        return self.DAG.getNode(SUB, DL, VT, N0, N1);
    }
    if !IsSigned && VT.isVector() && VT.isSimple() {
        let mut ScalarBits: u32 = VT.getScalarSizeInBits();
        if ScalarBits > 8 && isPowerOf2_32(ScalarBits) && !self.TLI.isOperationLegal(USUBSAT, VT) {
            let mut Known0: KnownBits = self.DAG.computeKnownBits(N0, 0);
            let mut ActiveBits: u32 = Known0.countMaxActiveBits();
            for let mut NarrowBits: u32 = PowerOf2Ceil(ActiveBits); NarrowBits != 0 && NarrowBits < ScalarBits; NarrowBits *= 2 {
                let mut Scale: u32 = ScalarBits / NarrowBits;
                let mut ScaledEC: ElementCount = VT.getVectorElementCount() * Scale;
                let mut NarrowSVT: MVT = getIntegerVT(NarrowBits);
                let mut NarrowVT: EVT = getVectorVT(*self.DAG.getContext(), EVT { NarrowSVT }, ScaledEC);
                if !self.TLI.isOperationLegalOrCustom(USUBSAT, NarrowVT, false) {
                    continue;
                }
                let mut Known1: KnownBits = self.DAG.computeKnownBits(N1, 0);
                if Known1.countMaxActiveBits() <= NarrowBits {
                    let mut NarrowN0: SDValue = self.DAG.getBitcast(NarrowVT, N0);
                    let mut NarrowN1: SDValue = self.DAG.getBitcast(NarrowVT, N1);
                    let mut NarrowSub: SDValue = self.DAG.getNode(USUBSAT, DL, NarrowVT, NarrowN0, NarrowN1);
                    return self.DAG.getBitcast(VT, NarrowSub);
                }
                break;
            }
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitSUBC(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N0.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    if !N.hasAnyUseOfValue(1) {
        return self.CombineTo(N, self.DAG.getNode(SUB, DL, VT, N0, N1), self.DAG.getNode(CARRY_FALSE, DL, EVT { Glue }), true);
    }
    if N0 == N1 {
        return self.CombineTo(N, self.DAG.getConstant(0, DL, VT, false, false), self.DAG.getNode(CARRY_FALSE, DL, EVT { Glue }), true);
    }
    if isNullConstant(N1) {
        return self.CombineTo(N, N0, self.DAG.getNode(CARRY_FALSE, DL, EVT { Glue }), true);
    }
    if isAllOnesConstant(N0) {
        return self.CombineTo(N, self.DAG.getNode(XOR, DL, VT, N1, N0), self.DAG.getNode(CARRY_FALSE, DL, EVT { Glue }), true);
    }
    return SDValue {};
}

fn DAGCombiner::visitSUBO(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N0.getValueType();
    let mut IsSigned: bool = (SSUBO == N.getOpcode());
    let mut CarryVT: EVT = N.getValueType(1);
    let mut DL: SDLoc = SDLoc { N };
    if !N.hasAnyUseOfValue(1) {
        return self.CombineTo(N, self.DAG.getNode(SUB, DL, VT, N0, N1), self.DAG.getUNDEF(CarryVT), true);
    }
    if N0 == N1 {
        return self.CombineTo(N, self.DAG.getConstant(0, DL, VT, false, false), self.DAG.getConstant(0, DL, CarryVT, false, false), true);
    }
    if getAsNonOpaqueConstant(N1) {
        N1C;
    } else if IsSigned && !N1C.isMinSignedValue() {
        return self.DAG.getNode(SADDO, DL, N.getVTList(), N0, self.DAG.getConstant(operator(N1C.getAPIntValue()), DL, VT, false, false));
    }
    if isNullOrNullSplat(N1, false) {
        return self.CombineTo(N, N0, self.DAG.getConstant(0, DL, CarryVT, false, false), true);
    }
    if self.DAG.willNotOverflowSub(IsSigned, N0, N1) {
        return self.CombineTo(N, self.DAG.getNode(SUB, DL, VT, N0, N1), self.DAG.getConstant(0, DL, CarryVT, false, false), true);
    }
    if !IsSigned && isAllOnesOrAllOnesSplat(N0, false) {
        return self.CombineTo(N, self.DAG.getNode(XOR, DL, VT, N1, N0), self.DAG.getConstant(0, DL, CarryVT, false, false), true);
    }
    return SDValue {};
}

fn DAGCombiner::visitSUBE(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut CarryIn: SDValue = N.getOperand(2);
    if CarryIn.getOpcode() == CARRY_FALSE {
        return self.DAG.getNode(SUBC, SDLoc { N }, N.getVTList(), N0, N1);
    }
    return SDValue {};
}

fn DAGCombiner::visitUSUBO_CARRY(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut CarryIn: SDValue = N.getOperand(2);
    if isNullConstant(CarryIn) {
        if !self.LegalOperations || self.TLI.isOperationLegalOrCustom(USUBO, N.getValueType(0), false) {
            return self.DAG.getNode(USUBO, SDLoc { N }, N.getVTList(), N0, N1);
        }
    }
    if N0.getOpcode() == SUB && isNullConstant(N1) && !N.hasAnyUseOfValue(1) {
        return self.DAG.getNode(USUBO_CARRY, SDLoc { N }, N.getVTList(), N0.getOperand(0), N0.getOperand(1), CarryIn);
    }
    return SDValue {};
}

fn DAGCombiner::visitSSUBO_CARRY(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut CarryIn: SDValue = N.getOperand(2);
    if isNullConstant(CarryIn) {
        if !self.LegalOperations || self.TLI.isOperationLegalOrCustom(SSUBO, N.getValueType(0), false) {
            return self.DAG.getNode(SSUBO, SDLoc { N }, N.getVTList(), N0, N1);
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitMULFIX(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut Scale: SDValue = N.getOperand(2);
    let mut VT: EVT = N0.getValueType();
    if N0.isUndef() || N1.isUndef() {
        return self.DAG.getConstant(0, SDLoc { N }, VT, false, false);
    }
    if self.DAG.isConstantIntBuildVectorOrConstantInt(N0, true) && !self.DAG.isConstantIntBuildVectorOrConstantInt(N1, true) {
        return self.DAG.getNode(N.getOpcode(), SDLoc { N }, VT, N1, N0, Scale);
    }
    if isNullConstant(N1) {
        return self.DAG.getConstant(0, SDLoc { N }, VT, false, false);
    }
    return SDValue {};
}

fn DAGCombiner::visitMUL(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N0.getValueType();
    let mut BitWidth: u32 = VT.getScalarSizeInBits();
    let mut DL: SDLoc = SDLoc { N };
    if N0.isUndef() || N1.isUndef() {
        return self.DAG.getConstant(0, DL, VT, false, false);
    }
    if self.DAG.FoldConstantArithmetic(MUL, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if self.DAG.isConstantIntBuildVectorOrConstantInt(N0, false) && !self.DAG.isConstantIntBuildVectorOrConstantInt(N1, false) {
        return self.DAG.getNode(MUL, DL, VT, N1, N0);
    }
    let mut N1IsConst: bool = false;
    let mut N1IsOpaqueConst: bool = false;
    let mut ConstValue1: APInt = APInt {};
    if VT.isVector() {
        if self.SimplifyVBinOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
        N1IsConst = isConstantSplatVector(N1.getNode(), ConstValue1);
        assert!((!N1IsConst || ConstValue1.getBitWidth() == BitWidth), "Splat APInt should be element width");
    } else {
        N1IsConst = isa(N1);
        if N1IsConst {
            ConstValue1 = operator(N1).getAsAPIntVal();
            N1IsOpaqueConst = cast(N1).isOpaque();
        }
    }
    if N1IsConst && ConstValue1.isZero() {
        return N1;
    }
    if N1IsConst && ConstValue1.isOne() {
        return N0;
    }
    if self.foldBinOpIntoSelect(N) {
        NewSel;
    } else {
        return NewSel;
    }
    if N1IsConst && ConstValue1.isAllOnes() {
        return self.DAG.getNegative(N0, DL, VT);
    }
    if isConstantOrConstantVector(N1, true, false) && (!VT.isVector() || self.Level <= AfterLegalizeVectorOps) {
        if self.BuildLogBase2(N1, DL, false, false, optional<EVT> { nullopt }) {
            LogBase2;
        } else {
            let mut ShiftVT: EVT = self.getShiftAmountTy(N0.getValueType());
            let mut Trunc: SDValue = self.DAG.getZExtOrTrunc(LogBase2, DL, ShiftVT);
            let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
            Flags.setNoUnsignedWrap(N.getFlags().hasNoUnsignedWrap());
            if N.getFlags().hasNoSignedWrap() && N1IsConst && ConstValue1.logBase2() < BitWidth - 1 {
                Flags.setNoSignedWrap(true);
            }
            return self.DAG.getNode(SHL, DL, VT, N0, Trunc, Flags);
        }
    }
    if N1IsConst && !N1IsOpaqueConst && ConstValue1.isNegatedPowerOf2() {
        let mut Log2Val: u32 = (operator(ConstValue1)).logBase2();
        return self.DAG.getNode(SUB, DL, VT, self.DAG.getConstant(0, DL, VT, false, false), self.DAG.getNode(SHL, DL, VT, N0, self.DAG.getShiftAmountConstant(Log2Val, VT, DL)));
    }
    for LoHiOpc in [UMUL_LOHI, SMUL_LOHI] {
        if !self.LegalOperations || self.TLI.isOperationLegalOrCustom(LoHiOpc, VT, false) {
            let mut LoHiVT: SDVTList = self.DAG.getVTList(VT, VT);
            if self.DAG.getNodeIfExists(LoHiOpc, LoHiVT, ArrayRef<SDValue> { [N0, N1] }, false) {
                LoHi;
            } else if LoHi.hasAnyUseOfValue(1) {
                return SDValue { Node: LoHi, ResNo: 0 };
            }
            if self.DAG.getNodeIfExists(LoHiOpc, LoHiVT, ArrayRef<SDValue> { [N1, N0] }, false) {
                LoHi;
            } else if LoHi.hasAnyUseOfValue(1) {
                return SDValue { Node: LoHi, ResNo: 0 };
            }
        }
    }
    if N1IsConst && self.TLI.decomposeMulByConstant(*self.DAG.getContext(), VT, N1) {
        let mut MathOp: u32 = DELETED_NODE;
        let mut MulC: APInt = ConstValue1.abs();
        let mut TZeros: u32 = if MulC == 2 { 0 } else { MulC.countr_zero() };
        MulC.lshrInPlace(TZeros);
        if (MulC - 1).isPowerOf2() {
            MathOp = ADD;
        } else if (MulC + 1).isPowerOf2() {
            MathOp = SUB;
        }
        if MathOp != DELETED_NODE {
            let mut ShAmt: u32 = if MathOp == ADD { (MulC - 1).logBase2() } else { (MulC + 1).logBase2() };
            ShAmt += TZeros;
            assert!(ShAmt < BitWidth, "multiply-by-constant generated out of bounds shift");
            let mut Shl: SDValue = self.DAG.getNode(SHL, DL, VT, N0, self.DAG.getShiftAmountConstant(ShAmt, VT, DL));
            let mut R: SDValue = N0;
            if TZeros {
                R = self.DAG.getNode(SHL, DL, VT, N0, self.DAG.getShiftAmountConstant(TZeros, VT, DL));
            }
            R = self.DAG.getNode(MathOp, DL, VT, Shl, R);
            if ConstValue1.isNegative() {
                R = self.DAG.getNegative(R, DL, VT);
            }
            return R;
        }
    }
    {
        let mut X: SDValue = SDValue {};
        let mut C1: SDValue = SDValue {};
        if sd_match(N0, m_Shl(m_Value(X), m_Value(C1))) {
            if self.DAG.FoldConstantArithmetic(SHL, DL, VT, ArrayRef<SDValue> { [N1, C1] }, SDNodeFlags { Flags: None }) {
                C3;
            } else {
                return self.DAG.getNode(MUL, DL, VT, X, C3);
            }
        }
    }
    {
        let mut X: SDValue = SDValue {};
        let mut C: SDValue = SDValue {};
        let mut Y: SDValue = SDValue {};
        if sd_match(N, m_Mul(m_OneUse(m_Shl(m_Value(X), m_Value(C))), m_Value(Y))) && isConstantOrConstantVector(C, false, false) {
            let mut Mul: SDValue = self.DAG.getNode(MUL, DL, VT, X, Y);
            return self.DAG.getNode(SHL, DL, VT, Mul, C);
        }
    }
    if sd_match(N0, m_SpecificOpc(ADD)) && isConstantOrConstantVector(N1, false, false) && isConstantOrConstantVector(N0.getOperand(1), false, false) && self.isMulAddWithConstProfitable(N, N0, N1) {
        return self.DAG.getNode(ADD, DL, VT, self.DAG.getNode(MUL, SDLoc { N0 }, VT, N0.getOperand(0), N1), self.DAG.getNode(MUL, SDLoc { N1 }, VT, N0.getOperand(1), N1));
    }
    let mut NC1: *mut ConstantSDNode = isConstOrConstSplat(N1, false, false);
    if N0.getOpcode() == VSCALE && NC1 {
        let mut C0: *APInt = N0.getConstantOperandAPInt(0);
        let mut C1: *APInt = NC1.getAPIntValue();
        if !C0.isPowerOf2() || C1.isPowerOf2() || self.hasOperation(MUL, NC1.getValueType(0)) {
            return self.DAG.getVScale(DL, VT, C0 * C1);
        }
    }
    let mut MulVal: APInt = APInt {};
    if N0.getOpcode() == STEP_VECTOR && isConstantSplatVector(N1.getNode(), MulVal) {
        let mut C0: *APInt = N0.getConstantOperandAPInt(0);
        let mut NewStep: APInt = C0 * MulVal;
        return self.DAG.getStepVector(DL, VT, NewStep);
    }
    let mut X: SDValue = SDValue {};
    if (!self.LegalOperations || self.hasOperation(ABS, VT)) && sd_match(N, m_Mul(m_Or(m_Sra(m_Value(X), m_SpecificInt(BitWidth - 1)), m_One(false)), m_Deferred(X))) {
        return self.DAG.getNode(ABS, DL, VT, X);
    }
    if VT.isFixedLengthVector() {
        let mut NumElts: u32 = VT.getVectorNumElements();
        let mut ClearMask: SmallBitVector = SmallBitVector {};
        ClearMask.reserve(NumElts);
        let mut IsClearMask: Closure_9 = Closure_9 { ClearMask: &mut ClearMask };
        if (!self.LegalOperations || self.TLI.isOperationLegalOrCustom(AND, VT, false)) && matchUnaryPredicate(N1, function<bool (ConstantSDNode *)> { IsClearMask }, true, false) {
            assert!(N1.getOpcode() == BUILD_VECTOR, "Unknown constant vector");
            let mut LegalSVT: EVT = N1.getOperand(0).getValueType();
            let mut Zero: SDValue = self.DAG.getConstant(0, DL, LegalSVT, false, false);
            let mut AllOnes: SDValue = self.DAG.getAllOnesConstant(DL, LegalSVT, false, false);
            let mut Mask: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { NumElts, AllOnes };
            for let mut I: u32 = 0; I != NumElts; I += 1 {
                if ClearMask[I] {
                    Mask[I] = Zero;
                }
            }
            return self.DAG.getNode(AND, DL, VT, N0, self.DAG.getBuildVector(VT, DL, ArrayRef<SDValue> { Mask }));
        }
    }
    if self.reassociateOps(MUL, DL, N0, N1, N.getFlags()) {
        RMUL;
    } else {
        return RMUL;
    }
    if self.reassociateReduction(VECREDUCE_MUL, MUL, DL, VT, N0, N1, SDNodeFlags { Flags: None }) {
        SD;
    } else {
        return SD;
    }
    if self.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn isDivRemLibcallAvailable(Node: *mut SDNode, isSigned: bool, DAG: *SelectionDAG) -> bool {
    let mut LC: Libcall = zeroed();
    let mut NodeType: EVT = Node.getValueType(0);
    if !NodeType.isSimple() {
        return false;
    }
    match NodeType.getSimpleVT().SimpleTy {
        _ => {
            return false;
        },
        i8 => {
            LC = if isSigned { SDIVREM_I8 } else { UDIVREM_I8 };
        },
        i16 => {
            LC = if isSigned { SDIVREM_I16 } else { UDIVREM_I16 };
        },
        i32 => {
            LC = if isSigned { SDIVREM_I32 } else { UDIVREM_I32 };
        },
        i64 => {
            LC = if isSigned { SDIVREM_I64 } else { UDIVREM_I64 };
        },
        i128 => {
            LC = if isSigned { SDIVREM_I128 } else { UDIVREM_I128 };
        },
    }
    return DAG.getLibcalls().getLibcallImpl(LC) != Unsupported;
}

fn DAGCombiner::useDivRem(self, Node: *mut SDNode) -> SDValue {
    if Node.use_empty() {
        return SDValue {};
    }
    let mut Opcode: u32 = Node.getOpcode();
    let mut isSigned: bool = (Opcode == SDIV) || (Opcode == SREM);
    let mut DivRemOpc: u32 = if isSigned { SDIVREM } else { UDIVREM };
    let mut VT: EVT = Node.getValueType(0);
    if VT.isVector() || !VT.isInteger() {
        return SDValue {};
    }
    if !self.TLI.isTypeLegal(VT) && !self.TLI.isOperationCustom(DivRemOpc, VT) {
        return SDValue {};
    }
    if !self.TLI.isOperationLegalOrCustom(DivRemOpc, VT, false) && !isDivRemLibcallAvailable(Node, isSigned, self.DAG) {
        return SDValue {};
    }
    let mut OtherOpcode: u32 = 0;
    if (Opcode == SDIV) || (Opcode == UDIV) {
        OtherOpcode = if isSigned { SREM } else { UREM };
        if self.TLI.isOperationLegalOrCustom(Opcode, VT, false) {
            return SDValue {};
        }
    } else {
        OtherOpcode = if isSigned { SDIV } else { UDIV };
        if self.TLI.isOperationLegalOrCustom(OtherOpcode, VT, false) {
            return SDValue {};
        }
    }
    let mut Op0: SDValue = Node.getOperand(0);
    let mut Op1: SDValue = Node.getOperand(1);
    let mut combined: SDValue = SDValue {};
    for User in operator(Op0).users() {
        if User == Node || User.getOpcode() == DELETED_NODE || User.use_empty() {
            continue;
        }
        let mut UserOpc: u32 = User.getOpcode();
        if (UserOpc == Opcode || UserOpc == OtherOpcode || UserOpc == DivRemOpc) && User.getOperand(0) == Op0 && User.getOperand(1) == Op1 {
            if !combined {
                if UserOpc == OtherOpcode {
                    let mut VTs: SDVTList = self.DAG.getVTList(VT, VT);
                    combined = self.DAG.getNode(DivRemOpc, SDLoc { Node }, VTs, Op0, Op1);
                } else if UserOpc == DivRemOpc {
                    combined = SDValue { Node: User, ResNo: 0 };
                } else {
                    assert!(UserOpc == Opcode);
                    continue;
                }
            }
            if UserOpc == SDIV || UserOpc == UDIV {
                self.CombineTo(User, combined, true);
            } else if UserOpc == SREM || UserOpc == UREM {
                self.CombineTo(User, combined.getValue(1), true);
            }
        }
    }
    return combined;
}

fn simplifyDivRem(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    let mut Opc: u32 = N.getOpcode();
    let mut IsDiv: bool = (SDIV == Opc) || (UDIV == Opc);
    if DAG.isUndef(Opc, ArrayRef<SDValue> { [N0, N1] }) {
        return DAG.getUNDEF(VT);
    }
    if N0.isUndef() {
        return DAG.getConstant(0, DL, VT, false, false);
    }
    let mut N0C: *mut ConstantSDNode = isConstOrConstSplat(N0, false, false);
    if N0C && N0C.isZero() {
        return N0;
    }
    if N0 == N1 {
        return DAG.getConstant(if IsDiv { 1 } else { 0 }, DL, VT, false, false);
    }
    if isOneOrOneSplat(N1, false) || (VT.getScalarType() == EVT { i1 }) {
        return if IsDiv { N0 } else { DAG.getConstant(0, DL, VT, false, false) };
    }
    return SDValue {};
}

fn DAGCombiner::visitSDIV(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut CCVT: EVT = self.getSetCCResultType(VT);
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(SDIV, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if VT.isVector() {
        if self.SimplifyVBinOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
    }
    let mut N1C: *mut ConstantSDNode = isConstOrConstSplat(N1, false, false);
    if N1C && N1C.isAllOnes() {
        return self.DAG.getNegative(N0, DL, VT);
    }
    if N1C && N1C.isMinSignedValue() {
        return self.DAG.getSelect(DL, VT, self.DAG.getSetCC(DL, CCVT, N0, N1, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None }), self.DAG.getConstant(1, DL, VT, false, false), self.DAG.getConstant(0, DL, VT, false, false), SDNodeFlags { Flags: None });
    }
    if simplifyDivRem(N, self.DAG) {
        V;
    } else {
        return V;
    }
    if self.foldBinOpIntoSelect(N) {
        NewSel;
    } else {
        return NewSel;
    }
    if self.DAG.SignBitIsZero(N1, 0) && self.DAG.SignBitIsZero(N0, 0) {
        return self.DAG.getNode(UDIV, DL, N1.getValueType(), N0, N1);
    }
    if self.visitSDIVLike(N0, N1, N) {
        V;
    } else {
        if self.DAG.getNodeIfExists(SREM, N.getVTList(), ArrayRef<SDValue> { [N0, N1] }, false) {
            RemNode;
        } else {
            if !N.getFlags().hasExact() {
                let mut Mul: SDValue = self.DAG.getNode(MUL, DL, VT, V, N1);
                let mut Sub: SDValue = self.DAG.getNode(SUB, DL, VT, N0, Mul);
                self.AddToWorklist(Mul.getNode(), true, false);
                self.AddToWorklist(Sub.getNode(), true, false);
                self.CombineTo(RemNode, Sub, true);
            }
        }
        return V;
    }
    let mut Attr: AttributeList = self.DAG.getMachineFunction().getFunction().getAttributes();
    if !N1C || self.TLI.isIntDivCheap(N.getValueType(0), Attr) {
        if self.useDivRem(N) {
            DivRem;
        } else {
            return DivRem;
        }
    }
    return SDValue {};
}

fn isDivisorPowerOfTwo(Divisor: SDValue) -> bool {
    let mut IsPowerOfTwo: Closure_10 = Closure_10 {};
    return matchUnaryPredicate(Divisor, function<bool (ConstantSDNode *)> { IsPowerOfTwo }, false, true);
}

fn DAGCombiner::visitSDIVLike(self, N0: SDValue, N1: SDValue, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    let mut CCVT: EVT = self.getSetCCResultType(VT);
    let mut BitWidth: u32 = VT.getScalarSizeInBits();
    let mut MaxLegalDivRemBitWidth: u32 = self.TLI.getMaxDivRemBitWidthSupported();
    if (!N.getFlags().hasExact() || BitWidth > MaxLegalDivRemBitWidth) && isDivisorPowerOfTwo(N1) {
        if self.BuildSDIVPow2(N) {
            Res;
        } else {
            return Res;
        }
        let mut ShiftAmtTy: EVT = self.getShiftAmountTy(N0.getValueType());
        let mut Bits: SDValue = self.DAG.getConstant(BitWidth, DL, ShiftAmtTy, false, false);
        let mut C1: SDValue = self.DAG.getNode(CTTZ, DL, VT, N1);
        C1 = self.DAG.getZExtOrTrunc(C1, DL, ShiftAmtTy);
        let mut Inexact: SDValue = self.DAG.getNode(SUB, DL, ShiftAmtTy, Bits, C1);
        if !isConstantOrConstantVector(Inexact, false, false) {
            return SDValue {};
        }
        let mut Sign: SDValue = self.DAG.getNode(SRA, DL, VT, N0, self.DAG.getConstant(BitWidth - 1, DL, ShiftAmtTy, false, false));
        self.AddToWorklist(Sign.getNode(), true, false);
        let mut Srl: SDValue = self.DAG.getNode(SRL, DL, VT, Sign, Inexact);
        self.AddToWorklist(Srl.getNode(), true, false);
        let mut Add: SDValue = self.DAG.getNode(ADD, DL, VT, N0, Srl);
        self.AddToWorklist(Add.getNode(), true, false);
        let mut Sra: SDValue = self.DAG.getNode(SRA, DL, VT, Add, C1);
        self.AddToWorklist(Sra.getNode(), true, false);
        let mut One: SDValue = self.DAG.getConstant(1, DL, VT, false, false);
        let mut AllOnes: SDValue = self.DAG.getAllOnesConstant(DL, VT, false, false);
        let mut IsOne: SDValue = self.DAG.getSetCC(DL, CCVT, N1, One, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut IsAllOnes: SDValue = self.DAG.getSetCC(DL, CCVT, N1, AllOnes, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut IsOneOrAllOnes: SDValue = self.DAG.getNode(OR, DL, CCVT, IsOne, IsAllOnes);
        Sra = self.DAG.getSelect(DL, VT, IsOneOrAllOnes, N0, Sra, SDNodeFlags { Flags: None });
        let mut Zero: SDValue = self.DAG.getConstant(0, DL, VT, false, false);
        let mut Sub: SDValue = self.DAG.getNode(SUB, DL, VT, Zero, Sra);
        let mut IsNeg: SDValue = self.DAG.getSetCC(DL, CCVT, N1, Zero, SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut Res: SDValue = self.DAG.getSelect(DL, VT, IsNeg, Sub, Sra, SDNodeFlags { Flags: None });
        return Res;
    }
    let mut Attr: AttributeList = self.DAG.getMachineFunction().getFunction().getAttributes();
    if isConstantOrConstantVector(N1, false, true) && !self.TLI.isIntDivCheap(N.getValueType(0), Attr) {
        if self.BuildSDIV(N) {
            Op;
        } else {
            return Op;
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitUDIV(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut CCVT: EVT = self.getSetCCResultType(VT);
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(UDIV, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if VT.isVector() {
        if self.SimplifyVBinOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
    }
    let mut N1C: *mut ConstantSDNode = isConstOrConstSplat(N1, false, false);
    if N1C && N1C.isAllOnes() && CCVT.isVector() == VT.isVector() {
        return self.DAG.getSelect(DL, VT, self.DAG.getSetCC(DL, CCVT, N0, N1, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None }), self.DAG.getConstant(1, DL, VT, false, false), self.DAG.getConstant(0, DL, VT, false, false), SDNodeFlags { Flags: None });
    }
    if simplifyDivRem(N, self.DAG) {
        V;
    } else {
        return V;
    }
    if self.foldBinOpIntoSelect(N) {
        NewSel;
    } else {
        return NewSel;
    }
    if self.visitUDIVLike(N0, N1, N) {
        V;
    } else {
        if self.DAG.getNodeIfExists(UREM, N.getVTList(), ArrayRef<SDValue> { [N0, N1] }, false) {
            RemNode;
        } else {
            if !N.getFlags().hasExact() {
                let mut Mul: SDValue = self.DAG.getNode(MUL, DL, VT, V, N1);
                let mut Sub: SDValue = self.DAG.getNode(SUB, DL, VT, N0, Mul);
                self.AddToWorklist(Mul.getNode(), true, false);
                self.AddToWorklist(Sub.getNode(), true, false);
                self.CombineTo(RemNode, Sub, true);
            }
        }
        return V;
    }
    let mut Attr: AttributeList = self.DAG.getMachineFunction().getFunction().getAttributes();
    if !N1C || self.TLI.isIntDivCheap(N.getValueType(0), Attr) {
        if self.useDivRem(N) {
            DivRem;
        } else {
            return DivRem;
        }
    }
    if self.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn DAGCombiner::visitUDIVLike(self, N0: SDValue, N1: SDValue, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    if isConstantOrConstantVector(N1, true, true) {
        if self.BuildLogBase2(N1, DL, false, false, optional<EVT> { nullopt }) {
            LogBase2;
        } else {
            self.AddToWorklist(LogBase2.getNode(), true, false);
            let mut ShiftVT: EVT = self.getShiftAmountTy(N0.getValueType());
            let mut Trunc: SDValue = self.DAG.getZExtOrTrunc(LogBase2, DL, ShiftVT);
            self.AddToWorklist(Trunc.getNode(), true, false);
            return self.DAG.getNode(SRL, DL, VT, N0, Trunc);
        }
    }
    if N1.getOpcode() == SHL {
        let mut N10: SDValue = N1.getOperand(0);
        if isConstantOrConstantVector(N10, true, true) {
            if self.BuildLogBase2(N10, DL, false, false, optional<EVT> { nullopt }) {
                LogBase2;
            } else {
                self.AddToWorklist(LogBase2.getNode(), true, false);
                let mut ADDVT: EVT = N1.getOperand(1).getValueType();
                let mut Trunc: SDValue = self.DAG.getZExtOrTrunc(LogBase2, DL, ADDVT);
                self.AddToWorklist(Trunc.getNode(), true, false);
                let mut Add: SDValue = self.DAG.getNode(ADD, DL, ADDVT, N1.getOperand(1), Trunc);
                self.AddToWorklist(Add.getNode(), true, false);
                return self.DAG.getNode(SRL, DL, VT, N0, Add);
            }
        }
    }
    let mut Attr: AttributeList = self.DAG.getMachineFunction().getFunction().getAttributes();
    if isConstantOrConstantVector(N1, false, true) && !self.TLI.isIntDivCheap(N.getValueType(0), Attr) {
        if self.BuildUDIV(N) {
            Op;
        } else {
            return Op;
        }
    }
    return SDValue {};
}

fn DAGCombiner::buildOptimizedSREM(self, N0: SDValue, N1: SDValue, N: *mut SDNode) -> SDValue {
    if !N.getFlags().hasExact() && isDivisorPowerOfTwo(N1) && !self.DAG.doesNodeExist(SDIV, N.getVTList(), ArrayRef<SDValue> { [N0, N1] }) {
        if self.BuildSREMPow2(N) {
            Res;
        } else {
            return Res;
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitREM(self, N: *mut SDNode) -> SDValue {
    let mut Opcode: u32 = N.getOpcode();
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut CCVT: EVT = self.getSetCCResultType(VT);
    let mut isSigned: bool = (Opcode == SREM);
    let mut DivOpcode: u32 = if isSigned { SDIV } else { UDIV };
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(Opcode, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if !isSigned && isAllOnesOrAllOnesSplat(N1, false) && CCVT.isVector() == VT.isVector() {
        let mut F0: SDValue = self.DAG.getFreeze(N0);
        let mut EqualsNeg1: SDValue = self.DAG.getSetCC(DL, CCVT, F0, N1, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
        return self.DAG.getSelect(DL, VT, EqualsNeg1, self.DAG.getConstant(0, DL, VT, false, false), F0, SDNodeFlags { Flags: None });
    }
    if simplifyDivRem(N, self.DAG) {
        V;
    } else {
        return V;
    }
    if self.foldBinOpIntoSelect(N) {
        NewSel;
    } else {
        return NewSel;
    }
    if isSigned {
        if self.DAG.SignBitIsZero(N1, 0) && self.DAG.SignBitIsZero(N0, 0) {
            return self.DAG.getNode(UREM, DL, VT, N0, N1);
        }
    } else {
        if self.DAG.isKnownToBeAPowerOfTwo(N1, true, 0) {
            let mut NegOne: SDValue = self.DAG.getAllOnesConstant(DL, VT, false, false);
            let mut Add: SDValue = self.DAG.getNode(ADD, DL, VT, N1, NegOne);
            self.AddToWorklist(Add.getNode(), true, false);
            return self.DAG.getNode(AND, DL, VT, N0, Add);
        }
    }
    let mut Attr: AttributeList = self.DAG.getMachineFunction().getFunction().getAttributes();
    if self.DAG.isKnownNeverZero(N1, 0) && !self.TLI.isIntDivCheap(VT, Attr) {
        if isSigned {
            if self.buildOptimizedSREM(N0, N1, N) {
                OptimizedRem;
            } else {
                return OptimizedRem;
            }
        }
        let mut OptimizedDiv: SDValue = if isSigned { self.visitSDIVLike(N0, N1, N) } else { self.visitUDIVLike(N0, N1, N) };
        if OptimizedDiv.getNode() && OptimizedDiv.getNode() != N {
            if self.DAG.getNodeIfExists(DivOpcode, N.getVTList(), ArrayRef<SDValue> { [N0, N1] }, false) {
                DivNode;
            } else {
                self.CombineTo(DivNode, OptimizedDiv, true);
            }
            let mut Mul: SDValue = self.DAG.getNode(MUL, DL, VT, OptimizedDiv, N1);
            let mut Sub: SDValue = self.DAG.getNode(SUB, DL, VT, N0, Mul);
            self.AddToWorklist(OptimizedDiv.getNode(), true, false);
            self.AddToWorklist(Mul.getNode(), true, false);
            return Sub;
        }
    }
    let mut DivRemOpc: u32 = if isSigned { SDIVREM } else { UDIVREM };
    if !self.ForCodeSize && !self.TLI.isOperationLegalOrCustom(DivRemOpc, VT.getScalarType(), false) && !isDivRemLibcallAvailable(N, isSigned, self.DAG) && self.TLI.getTypeAction(*self.DAG.getContext(), VT) != TypePromoteInteger {
        if self.DAG.getNodeIfExists(DivOpcode, N.getVTList(), ArrayRef<SDValue> { [N0, N1] }, false) {
            Div;
        } else {
            let mut Mul: SDValue = self.DAG.getNode(MUL, DL, VT, SDValue { Node: Div, ResNo: 0 }, N1);
            return self.DAG.getNode(SUB, DL, VT, N0, Mul);
        }
    }
    if self.useDivRem(N) {
        DivRem;
    } else {
        return DivRem.getValue(1);
    }
    let mut A: SDValue = SDValue {};
    let mut Op1Cst: APInt = APInt {};
    let mut BCst: APInt = APInt {};
    if sd_match(N, m_URem(m_URem(m_Value(A), m_ConstInt(BCst)), m_ConstInt(Op1Cst))) && BCst.urem(Op1Cst).isZero() {
        return self.DAG.getNode(UREM, DL, VT, A, self.DAG.getConstant(Op1Cst, DL, VT, false, false));
    }
    if sd_match(N, m_SRem(m_SRem(m_Value(A), m_ConstInt(BCst)), m_ConstInt(Op1Cst))) && BCst.srem(Op1Cst).isZero() && !Op1Cst.isAllOnes() {
        return self.DAG.getNode(SREM, DL, VT, A, self.DAG.getConstant(Op1Cst, DL, VT, false, false));
    }
    return SDValue {};
}

fn DAGCombiner::visitMULHS(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(MULHS, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if self.DAG.isConstantIntBuildVectorOrConstantInt(N0, true) && !self.DAG.isConstantIntBuildVectorOrConstantInt(N1, true) {
        return self.DAG.getNode(MULHS, DL, N.getVTList(), N1, N0);
    }
    if VT.isVector() {
        if self.SimplifyVBinOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
        if isConstantSplatVectorAllZeros(N1.getNode(), false) {
            return self.DAG.getConstant(0, DL, VT, false, false);
        }
    }
    if isNullConstant(N1) {
        return N1;
    }
    if isOneConstant(N1) {
        return self.DAG.getNode(SRA, DL, VT, N0, self.DAG.getShiftAmountConstant(N0.getScalarValueSizeInBits() - 1, VT, DL));
    }
    if N0.isUndef() || N1.isUndef() {
        return self.DAG.getConstant(0, DL, VT, false, false);
    }
    if !self.TLI.isOperationLegalOrCustom(MULHS, VT, false) && VT.isSimple() && !VT.isVector() {
        let mut Simple: MVT = VT.getSimpleVT();
        let mut SimpleSize: u32 = Simple.getSizeInBits().operator unsigned long long();
        let mut NewVT: EVT = getIntegerVT(*self.DAG.getContext(), SimpleSize * 2);
        if self.TLI.isOperationLegal(MUL, NewVT) {
            N0 = self.DAG.getNode(SIGN_EXTEND, DL, NewVT, N0);
            N1 = self.DAG.getNode(SIGN_EXTEND, DL, NewVT, N1);
            N1 = self.DAG.getNode(MUL, DL, NewVT, N0, N1);
            N1 = self.DAG.getNode(SRL, DL, NewVT, N1, self.DAG.getShiftAmountConstant(SimpleSize, NewVT, DL));
            return self.DAG.getNode(TRUNCATE, DL, VT, N1);
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitMULHU(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(MULHU, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if self.DAG.isConstantIntBuildVectorOrConstantInt(N0, true) && !self.DAG.isConstantIntBuildVectorOrConstantInt(N1, true) {
        return self.DAG.getNode(MULHU, DL, N.getVTList(), N1, N0);
    }
    if VT.isVector() {
        if self.SimplifyVBinOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
        if isConstantSplatVectorAllZeros(N1.getNode(), false) {
            return self.DAG.getConstant(0, DL, VT, false, false);
        }
    }
    if isNullConstant(N1) {
        return N1;
    }
    if isOneConstant(N1) {
        return self.DAG.getConstant(0, DL, VT, false, false);
    }
    if N0.isUndef() || N1.isUndef() {
        return self.DAG.getConstant(0, DL, VT, false, false);
    }
    if isConstantOrConstantVector(N1, true, true) && (!self.LegalOperations || self.hasOperation(SRL, VT)) {
        if self.BuildLogBase2(N1, DL, false, false, optional<EVT> { nullopt }) {
            LogBase2;
        } else {
            let mut NumEltBits: u32 = VT.getScalarSizeInBits();
            let mut SRLAmt: SDValue = self.DAG.getNode(SUB, DL, VT, self.DAG.getConstant(NumEltBits, DL, VT, false, false), LogBase2);
            let mut ShiftVT: EVT = self.getShiftAmountTy(N0.getValueType());
            let mut Trunc: SDValue = self.DAG.getZExtOrTrunc(SRLAmt, DL, ShiftVT);
            return self.DAG.getNode(SRL, DL, VT, N0, Trunc);
        }
    }
    if !self.TLI.isOperationLegalOrCustom(MULHU, VT, false) && VT.isSimple() && !VT.isVector() {
        let mut Simple: MVT = VT.getSimpleVT();
        let mut SimpleSize: u32 = Simple.getSizeInBits().operator unsigned long long();
        let mut NewVT: EVT = getIntegerVT(*self.DAG.getContext(), SimpleSize * 2);
        if self.TLI.isOperationLegal(MUL, NewVT) {
            N0 = self.DAG.getNode(ZERO_EXTEND, DL, NewVT, N0);
            N1 = self.DAG.getNode(ZERO_EXTEND, DL, NewVT, N1);
            N1 = self.DAG.getNode(MUL, DL, NewVT, N0, N1);
            N1 = self.DAG.getNode(SRL, DL, NewVT, N1, self.DAG.getShiftAmountConstant(SimpleSize, NewVT, DL));
            return self.DAG.getNode(TRUNCATE, DL, VT, N1);
        }
    }
    if self.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn DAGCombiner::visitAVG(self, N: *mut SDNode) -> SDValue {
    let mut Opcode: u32 = N.getOpcode();
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    let mut IsSigned: bool = Opcode == AVGCEILS || Opcode == AVGFLOORS;
    if self.DAG.FoldConstantArithmetic(Opcode, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if self.DAG.isConstantIntBuildVectorOrConstantInt(N0, true) && !self.DAG.isConstantIntBuildVectorOrConstantInt(N1, true) {
        return self.DAG.getNode(Opcode, DL, N.getVTList(), N1, N0);
    }
    if VT.isVector() {
        if self.SimplifyVBinOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
    }
    if N0.isUndef() {
        return N1;
    }
    if N1.isUndef() {
        return N0;
    }
    if N0 == N1 && self.Level >= AfterLegalizeTypes {
        return N0;
    }
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    if sd_match(N, m_c_BinOp(AVGFLOORS, m_Value(X), m_Zero(false), SDNodeFlags { Flags: None })) {
        return self.DAG.getNode(SRA, DL, VT, X, self.DAG.getShiftAmountConstant(1, VT, DL));
    }
    if sd_match(N, m_c_BinOp(AVGFLOORU, m_Value(X), m_Zero(false), SDNodeFlags { Flags: None })) {
        return self.DAG.getNode(SRL, DL, VT, X, self.DAG.getShiftAmountConstant(1, VT, DL));
    }
    if !IsSigned && sd_match(N, m_BinOp(Opcode, m_ZExt(m_Value(X)), m_ZExt(m_Value(Y)), SDNodeFlags { Flags: None })) && X.getValueType() == Y.getValueType() && self.hasOperation(Opcode, X.getValueType()) {
        let mut AvgU: SDValue = self.DAG.getNode(Opcode, DL, X.getValueType(), X, Y);
        return self.DAG.getNode(ZERO_EXTEND, DL, VT, AvgU);
    }
    if IsSigned && sd_match(N, m_BinOp(Opcode, m_SExt(m_Value(X)), m_SExt(m_Value(Y)), SDNodeFlags { Flags: None })) && X.getValueType() == Y.getValueType() && self.hasOperation(Opcode, X.getValueType()) {
        let mut AvgS: SDValue = self.DAG.getNode(Opcode, DL, X.getValueType(), X, Y);
        return self.DAG.getNode(SIGN_EXTEND, DL, VT, AvgS);
    }
    if Opcode == AVGFLOORU && !self.hasOperation(AVGFLOORU, VT) && (!self.LegalOperations || self.hasOperation(AVGCEILU, VT)) {
        if self.DAG.isKnownNeverZero(N1, 0) {
            return self.DAG.getNode(AVGCEILU, DL, VT, N0, self.DAG.getNode(ADD, DL, VT, N1, self.DAG.getAllOnesConstant(DL, VT, false, false)));
        }
        if self.DAG.isKnownNeverZero(N0, 0) {
            return self.DAG.getNode(AVGCEILU, DL, VT, N1, self.DAG.getNode(ADD, DL, VT, N0, self.DAG.getAllOnesConstant(DL, VT, false, false)));
        }
    }
    if (Opcode == AVGFLOORU && self.hasOperation(AVGCEILU, VT)) || (Opcode == AVGFLOORS && self.hasOperation(AVGCEILS, VT)) {
        let mut Add: SDValue = SDValue {};
        if sd_match(N, m_c_BinOp(Opcode, m_Value(Add, m_Add(m_Value(X), m_Value(Y))), m_One(false), SDNodeFlags { Flags: None })) || sd_match(N, m_c_BinOp(Opcode, m_Value(Add, m_Add(m_Value(X), m_One(false))), m_Value(Y), SDNodeFlags { Flags: None })) {
            if IsSigned && operator(Add).getFlags().hasNoSignedWrap() {
                return self.DAG.getNode(AVGCEILS, DL, VT, X, Y);
            }
            if !IsSigned && operator(Add).getFlags().hasNoUnsignedWrap() {
                return self.DAG.getNode(AVGCEILU, DL, VT, X, Y);
            }
        }
    }
    if Opcode == AVGFLOORS && self.hasOperation(AVGFLOORU, VT) {
        if self.DAG.SignBitIsZero(N0, 0) && self.DAG.SignBitIsZero(N1, 0) {
            return self.DAG.getNode(AVGFLOORU, DL, VT, N0, N1);
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitABD(self, N: *mut SDNode) -> SDValue {
    let mut Opcode: u32 = N.getOpcode();
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(Opcode, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if self.DAG.isConstantIntBuildVectorOrConstantInt(N0, true) && !self.DAG.isConstantIntBuildVectorOrConstantInt(N1, true) {
        return self.DAG.getNode(Opcode, DL, N.getVTList(), N1, N0);
    }
    if VT.isVector() {
        if self.SimplifyVBinOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
    }
    if N0.isUndef() || N1.isUndef() {
        return self.DAG.getConstant(0, DL, VT, false, false);
    }
    if N0 == N1 {
        return self.DAG.getConstant(0, DL, VT, false, false);
    }
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    if sd_match(N, m_c_BinOp(ABDS, m_Value(X), m_Zero(false), SDNodeFlags { Flags: None })) && (!self.LegalOperations || self.hasOperation(ABS, VT)) {
        return self.DAG.getNode(ABS, DL, VT, X);
    }
    if sd_match(N, m_c_BinOp(ABDU, m_Value(X), m_Zero(false), SDNodeFlags { Flags: None })) {
        return X;
    }
    if Opcode == ABDS && self.hasOperation(ABDU, VT) && self.DAG.SignBitIsZero(N0, 0) && self.DAG.SignBitIsZero(N1, 0) {
        return self.DAG.getNode(ABDU, DL, VT, N1, N0);
    }
    if sd_match(N, m_BinOp(ABDU, m_ZExt(m_Value(X)), m_ZExt(m_Value(Y)), SDNodeFlags { Flags: None })) || sd_match(N, m_BinOp(ABDS, m_SExt(m_Value(X)), m_SExt(m_Value(Y)), SDNodeFlags { Flags: None })) {
        let mut SmallVT: EVT = if X.getScalarValueSizeInBits() > Y.getScalarValueSizeInBits() { X.getValueType() } else { Y.getValueType() };
        if !self.LegalOperations || self.hasOperation(Opcode, SmallVT) {
            let mut ExtedX: SDValue = self.DAG.getExtOrTrunc(X, SDLoc { X }, SmallVT, operator(N0).getOpcode());
            let mut ExtedY: SDValue = self.DAG.getExtOrTrunc(Y, SDLoc { Y }, SmallVT, operator(N0).getOpcode());
            let mut SmallABD: SDValue = self.DAG.getNode(Opcode, DL, SmallVT, ArrayRef<SDValue> { [ExtedX, ExtedY] });
            let mut ZExted: SDValue = self.DAG.getZExtOrTrunc(SmallABD, DL, VT);
            return ZExted;
        }
    }
    if sd_match(N, m_c_BinOp(ABDU, m_ZExt(m_Value(X)), m_Value(Y), SDNodeFlags { Flags: None })) || sd_match(N, m_c_BinOp(ABDS, m_SExt(m_Value(X)), m_Value(Y), SDNodeFlags { Flags: None })) {
        let mut SmallVT: EVT = X.getValueType();
        if !self.LegalOperations || self.hasOperation(Opcode, SmallVT) {
            let mut Bits: u64 = SmallVT.getScalarSizeInBits();
            let mut RelevantBits: u32 = if (Opcode == ABDS) { self.DAG.ComputeMaxSignificantBits(Y, 0) } else { self.DAG.computeKnownBits(Y, 0).countMaxActiveBits() };
            let mut TruncatingYIsCheap: bool = self.TLI.isTruncateFree(Y, SmallVT) || matchUnaryPredicate(Y, function<bool (ConstantSDNode *)> { Closure_11 { Opcode: &mut Opcode, Bits: &mut Bits } }, true, false);
            if RelevantBits <= Bits && TruncatingYIsCheap {
                let mut NewY: SDValue = self.DAG.getNode(TRUNCATE, SDLoc { Y }, SmallVT, Y);
                let mut SmallABD: SDValue = self.DAG.getNode(Opcode, DL, SmallVT, ArrayRef<SDValue> { [X, NewY] });
                return self.DAG.getZExtOrTrunc(SmallABD, DL, VT);
            }
        }
    }
    return SDValue {};
}

fn DAGCombiner::SimplifyNodeWithTwoResults(self, N: *mut SDNode, LoOp: u32, HiOp: u32) -> SDValue {
    let mut HiExists: bool = N.hasAnyUseOfValue(1);
    if !HiExists && (!self.LegalOperations || self.TLI.isOperationLegalOrCustom(LoOp, N.getValueType(0), false)) {
        let mut Res: SDValue = self.DAG.getNode(LoOp, SDLoc { N }, N.getValueType(0), N.ops());
        return self.CombineTo(N, Res, Res, true);
    }
    let mut LoExists: bool = N.hasAnyUseOfValue(0);
    if !LoExists && (!self.LegalOperations || self.TLI.isOperationLegalOrCustom(HiOp, N.getValueType(1), false)) {
        let mut Res: SDValue = self.DAG.getNode(HiOp, SDLoc { N }, N.getValueType(1), N.ops());
        return self.CombineTo(N, Res, Res, true);
    }
    if LoExists && HiExists {
        return SDValue {};
    }
    if LoExists {
        let mut Lo: SDValue = self.DAG.getNode(LoOp, SDLoc { N }, N.getValueType(0), N.ops());
        self.AddToWorklist(Lo.getNode(), true, false);
        let mut LoOpt: SDValue = self.combine(Lo.getNode());
        if LoOpt.getNode() && LoOpt.getNode() != Lo.getNode() && (!self.LegalOperations || self.TLI.isOperationLegalOrCustom(LoOpt.getOpcode(), LoOpt.getValueType(), false)) {
            return self.CombineTo(N, LoOpt, LoOpt, true);
        }
    }
    if HiExists {
        let mut Hi: SDValue = self.DAG.getNode(HiOp, SDLoc { N }, N.getValueType(1), N.ops());
        self.AddToWorklist(Hi.getNode(), true, false);
        let mut HiOpt: SDValue = self.combine(Hi.getNode());
        if HiOpt.getNode() && HiOpt != Hi && (!self.LegalOperations || self.TLI.isOperationLegalOrCustom(HiOpt.getOpcode(), HiOpt.getValueType(), false)) {
            return self.CombineTo(N, HiOpt, HiOpt, true);
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitSMUL_LOHI(self, N: *mut SDNode) -> SDValue {
    if self.SimplifyNodeWithTwoResults(N, MUL, MULHS) {
        Res;
    } else {
        return Res;
    }
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if isa(N0) && isa(N1) {
        return self.DAG.getNode(SMUL_LOHI, DL, N.getVTList(), N0, N1);
    }
    if self.DAG.isConstantIntBuildVectorOrConstantInt(N0, true) && !self.DAG.isConstantIntBuildVectorOrConstantInt(N1, true) {
        return self.DAG.getNode(SMUL_LOHI, DL, N.getVTList(), N1, N0);
    }
    if VT.isSimple() && !VT.isVector() {
        let mut Simple: MVT = VT.getSimpleVT();
        let mut SimpleSize: u32 = Simple.getSizeInBits().operator unsigned long long();
        let mut NewVT: EVT = getIntegerVT(*self.DAG.getContext(), SimpleSize * 2);
        if self.TLI.isOperationLegal(MUL, NewVT) {
            let mut Lo: SDValue = self.DAG.getNode(SIGN_EXTEND, DL, NewVT, N0);
            let mut Hi: SDValue = self.DAG.getNode(SIGN_EXTEND, DL, NewVT, N1);
            Lo = self.DAG.getNode(MUL, DL, NewVT, Lo, Hi);
            Hi = self.DAG.getNode(SRL, DL, NewVT, Lo, self.DAG.getShiftAmountConstant(SimpleSize, NewVT, DL));
            Hi = self.DAG.getNode(TRUNCATE, DL, VT, Hi);
            Lo = self.DAG.getNode(TRUNCATE, DL, VT, Lo);
            return self.CombineTo(N, Lo, Hi, true);
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitUMUL_LOHI(self, N: *mut SDNode) -> SDValue {
    if self.SimplifyNodeWithTwoResults(N, MUL, MULHU) {
        Res;
    } else {
        return Res;
    }
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if isa(N0) && isa(N1) {
        return self.DAG.getNode(UMUL_LOHI, DL, N.getVTList(), N0, N1);
    }
    if self.DAG.isConstantIntBuildVectorOrConstantInt(N0, true) && !self.DAG.isConstantIntBuildVectorOrConstantInt(N1, true) {
        return self.DAG.getNode(UMUL_LOHI, DL, N.getVTList(), N1, N0);
    }
    if isNullConstant(N1) {
        let mut Zero: SDValue = self.DAG.getConstant(0, DL, VT, false, false);
        return self.CombineTo(N, Zero, Zero, true);
    }
    if isOneConstant(N1) {
        let mut Zero: SDValue = self.DAG.getConstant(0, DL, VT, false, false);
        return self.CombineTo(N, N0, Zero, true);
    }
    if VT.isSimple() && !VT.isVector() {
        let mut Simple: MVT = VT.getSimpleVT();
        let mut SimpleSize: u32 = Simple.getSizeInBits().operator unsigned long long();
        let mut NewVT: EVT = getIntegerVT(*self.DAG.getContext(), SimpleSize * 2);
        if self.TLI.isOperationLegal(MUL, NewVT) {
            let mut Lo: SDValue = self.DAG.getNode(ZERO_EXTEND, DL, NewVT, N0);
            let mut Hi: SDValue = self.DAG.getNode(ZERO_EXTEND, DL, NewVT, N1);
            Lo = self.DAG.getNode(MUL, DL, NewVT, Lo, Hi);
            Hi = self.DAG.getNode(SRL, DL, NewVT, Lo, self.DAG.getShiftAmountConstant(SimpleSize, NewVT, DL));
            Hi = self.DAG.getNode(TRUNCATE, DL, VT, Hi);
            Lo = self.DAG.getNode(TRUNCATE, DL, VT, Lo);
            return self.CombineTo(N, Lo, Hi, true);
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitMULO(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N0.getValueType();
    let mut IsSigned: bool = (SMULO == N.getOpcode());
    let mut CarryVT: EVT = N.getValueType(1);
    let mut DL: SDLoc = SDLoc { N };
    let mut N0C: *mut ConstantSDNode = isConstOrConstSplat(N0, false, false);
    let mut N1C: *mut ConstantSDNode = isConstOrConstSplat(N1, false, false);
    if N0C && N1C && !N0C.isOpaque() && !N1C.isOpaque() {
        let mut Overflow: bool = false;
        let mut Result: APInt = if IsSigned { N0C.getAPIntValue().smul_ov(N1C.getAPIntValue(), Overflow) } else { N0C.getAPIntValue().umul_ov(N1C.getAPIntValue(), Overflow) };
        return self.CombineTo(N, self.DAG.getConstant(Result, DL, VT, false, false), self.DAG.getBoolConstant(Overflow, DL, CarryVT, CarryVT), true);
    }
    if self.DAG.isConstantIntBuildVectorOrConstantInt(N0, true) && !self.DAG.isConstantIntBuildVectorOrConstantInt(N1, true) {
        return self.DAG.getNode(N.getOpcode(), DL, N.getVTList(), N1, N0);
    }
    if isNullOrNullSplat(N1, false) {
        return self.CombineTo(N, self.DAG.getConstant(0, DL, VT, false, false), self.DAG.getConstant(0, DL, CarryVT, false, false), true);
    }
    if N1C && N1C.getAPIntValue() == 2 && (!IsSigned || VT.getScalarSizeInBits() > 2) {
        return self.DAG.getNode(if IsSigned { SADDO } else { UADDO }, DL, N.getVTList(), N0, N0);
    }
    if IsSigned && VT.getScalarSizeInBits() == 1 {
        let mut And: SDValue = self.DAG.getNode(AND, DL, VT, N0, N1);
        let mut Cmp: SDValue = self.DAG.getSetCC(DL, CarryVT, And, self.DAG.getConstant(0, DL, VT, false, false), SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
        return self.CombineTo(N, And, Cmp, true);
    }
    if self.DAG.willNotOverflowMul(IsSigned, N0, N1) {
        return self.CombineTo(N, self.DAG.getNode(MUL, DL, VT, N0, N1), self.DAG.getConstant(0, DL, CarryVT, false, false), true);
    }
    return SDValue {};
}

fn isSaturatingMinMax(N0: SDValue, N1: SDValue, N2: SDValue, N3: SDValue, CC: CondCode, BW: *mut u32, Unsigned: *mut bool, DAG: *mut SelectionDAG) -> SDValue {
    let mut isSignedMinMax: Closure_12 = Closure_12 {};
    let mut Opcode0: u32 = isSignedMinMax.call(N0, N1, N2, N3, CC);
    if !Opcode0 {
        return SDValue {};
    }
    if N0.getOpcode() == FP_TO_SINT && Opcode0 == SMAX {
        if isNullOrNullSplat(N3, false) {
            let mut IntVT: EVT = N0.getValueType().getScalarType();
            let mut FPVT: EVT = N0.getOperand(0).getValueType().getScalarType();
            if FPVT.isSimple() {
                let mut InputTy: *mut Type = FPVT.getTypeForEVT(*DAG.getContext());
                let mut Semantics: *fltSemantics = InputTy.getFltSemantics();
                let mut MinBitWidth: u32 = semanticsIntSizeInBits(Semantics, true);
                if IntVT.getSizeInBits().operator unsigned long long() >= MinBitWidth {
                    Unsigned = true;
                    BW = PowerOf2Ceil(MinBitWidth);
                    return N0;
                }
            }
        }
    }
    let mut N00: SDValue = SDValue {};
    let mut N01: SDValue = SDValue {};
    let mut N02: SDValue = SDValue {};
    let mut N03: SDValue = SDValue {};
    let mut N0CC: CondCode = zeroed();
    match N0.getOpcode() {
        SMIN => {
            SMAX;
        },
        SELECT_CC => {
            N00 = N0.getOperand(0);
        },
        SELECT => {
            VSELECT;
        },
        _ => {
            return SDValue {};
        },
    }
    let mut Opcode1: u32 = isSignedMinMax.call(N00, N01, N02, N03, N0CC);
    if !Opcode1 || Opcode0 == Opcode1 {
        return SDValue {};
    }
    let mut MinCOp: *mut ConstantSDNode = isConstOrConstSplat(if Opcode0 == SMIN { N1 } else { N01 }, false, false);
    let mut MaxCOp: *mut ConstantSDNode = isConstOrConstSplat(if Opcode0 == SMIN { N01 } else { N1 }, false, false);
    if !MinCOp || !MaxCOp || MinCOp.getValueType(0) != MaxCOp.getValueType(0) {
        return SDValue {};
    }
    let mut MinC: *APInt = MinCOp.getAPIntValue();
    let mut MaxC: *APInt = MaxCOp.getAPIntValue();
    let mut MinCPlus1: APInt = MinC + 1;
    if operator(MaxC) == MinCPlus1 && MinCPlus1.isPowerOf2() {
        BW = MinCPlus1.exactLogBase2() + 1;
        Unsigned = false;
        return N02;
    }
    if MaxC == 0 && MinC != 0 && MinCPlus1.isPowerOf2() {
        BW = MinCPlus1.exactLogBase2();
        Unsigned = true;
        return N02;
    }
    return SDValue {};
}

fn PerformMinMaxFpToSatCombine(N0: SDValue, N1: SDValue, N2: SDValue, N3: SDValue, CC: CondCode, DAG: *mut SelectionDAG) -> SDValue {
    let mut BW: u32 = 0;
    let mut Unsigned: bool = false;
    let mut Fp: SDValue = isSaturatingMinMax(N0, N1, N2, N3, CC, BW, Unsigned, DAG);
    if !Fp || Fp.getOpcode() != FP_TO_SINT {
        return SDValue {};
    }
    let mut FPVT: EVT = Fp.getOperand(0).getValueType();
    let mut NewVT: EVT = FPVT.changeElementType(*DAG.getContext(), getIntegerVT(*DAG.getContext(), BW));
    let mut NewOpc: u32 = if Unsigned { FP_TO_UINT_SAT } else { FP_TO_SINT_SAT };
    if !DAG.getTargetLoweringInfo().shouldConvertFpToSat(NewOpc, FPVT, NewVT) {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { Fp };
    let mut Sat: SDValue = DAG.getNode(NewOpc, DL, NewVT, Fp.getOperand(0), DAG.getValueType(NewVT.getScalarType()));
    return DAG.getExtOrTrunc(!Unsigned, Sat, DL, operator(N2).getValueType(0));
}

fn PerformUMinFpToSatCombine(N0: SDValue, N1: SDValue, N2: SDValue, N3: SDValue, CC: CondCode, DAG: *mut SelectionDAG) -> SDValue {
    if (N0 != N2 && (N2.getOpcode() != TRUNCATE || N0 != N2.getOperand(0))) || N0.getOpcode() != FP_TO_UINT || CC != SETULT {
        return SDValue {};
    }
    let mut N1C: *mut ConstantSDNode = isConstOrConstSplat(N1, false, false);
    let mut N3C: *mut ConstantSDNode = isConstOrConstSplat(N3, false, false);
    if !N1C || !N3C {
        return SDValue {};
    }
    let mut C1: *APInt = N1C.getAPIntValue();
    let mut C3: *APInt = N3C.getAPIntValue();
    if !(C1 + 1).isPowerOf2() || C1.getBitWidth() < C3.getBitWidth() || C1 != C3.zext(C1.getBitWidth()) {
        return SDValue {};
    }
    let mut BW: u32 = (C1 + 1).exactLogBase2();
    let mut FPVT: EVT = N0.getOperand(0).getValueType();
    let mut NewVT: EVT = FPVT.changeElementType(*DAG.getContext(), getIntegerVT(*DAG.getContext(), BW));
    if !DAG.getTargetLoweringInfo().shouldConvertFpToSat(FP_TO_UINT_SAT, FPVT, NewVT) {
        return SDValue {};
    }
    let mut Sat: SDValue = DAG.getNode(FP_TO_UINT_SAT, SDLoc { N0 }, NewVT, N0.getOperand(0), DAG.getValueType(NewVT.getScalarType()));
    return DAG.getZExtOrTrunc(Sat, SDLoc { N0 }, N3.getValueType());
}

fn performNanGuardFpToSatCombine(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    let mut X: SDValue = SDValue {};
    let mut GuardedVal: SDValue = SDValue {};
    if !sd_match(N, m_SelectLike(m_OneUse(m_SpecificSetCC(SETUO, m_Value(X), m_AnyZeroFP())), m_Zero(false), m_Value(GuardedVal))) && !sd_match(N, m_SelectLike(m_OneUse(m_SpecificSetCC(SETO, m_Value(X), m_AnyZeroFP())), m_Value(GuardedVal), m_Zero(false))) {
        return SDValue {};
    }
    let mut Mask: SDValue = SDValue {};
    let mut NewOpc: u32 = 0;
    if sd_match(GuardedVal, m_FPToSI(m_Specific(X))) || sd_match(GuardedVal, m_And(m_FPToSI(m_Specific(X)), m_Value(Mask))) {
        NewOpc = FP_TO_SINT_SAT;
    } else if sd_match(GuardedVal, m_FPToUI(m_Specific(X))) || sd_match(GuardedVal, m_And(m_FPToUI(m_Specific(X)), m_Value(Mask))) {
        NewOpc = FP_TO_UINT_SAT;
    } else {
        return SDValue {};
    }
    if !DAG.getTargetLoweringInfo().shouldConvertFpToSat(NewOpc, X.getValueType(), VT) {
        return SDValue {};
    }
    let mut Sat: SDValue = DAG.getNode(NewOpc, DL, VT, X, DAG.getValueType(VT.getScalarType()));
    if Mask {
        Sat = DAG.getNode(AND, DL, VT, Sat, DAG.getFreeze(Mask));
    }
    return Sat;
}

fn DAGCombiner::visitIMINMAX(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N0.getValueType();
    let mut Opcode: u32 = N.getOpcode();
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(Opcode, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if N0 == N1 {
        return N0;
    }
    if self.DAG.isConstantIntBuildVectorOrConstantInt(N0, true) && !self.DAG.isConstantIntBuildVectorOrConstantInt(N1, true) {
        return self.DAG.getNode(Opcode, DL, VT, N1, N0);
    }
    if VT.isVector() {
        if self.SimplifyVBinOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
    }
    if self.reassociateOps(Opcode, DL, N0, N1, N.getFlags()) {
        RMINMAX;
    } else {
        return RMINMAX;
    }
    let mut C: APInt = APInt {};
    if self.TLI.isTypeLegal(VT) && !self.TLI.shouldAvoidTransformToShift(VT, VT.getScalarSizeInBits() - 1) && sd_match(N1, m_ConstInt(C)) {
        if Opcode == SMAX && self.TLI.isOperationExpand(SMAX, VT) && N0.getOpcode() != SMIN && N0.getOpcode() != SIGN_EXTEND && C.isAllOnes() {
            let mut ShiftAmt: SDValue = self.DAG.getShiftAmountConstant(VT.getScalarSizeInBits() - 1, VT, DL);
            let mut Shift: SDValue = self.DAG.getNode(SRA, DL, VT, N0, ShiftAmt);
            return self.DAG.getNode(OR, DL, VT, N0, Shift);
        }
        if Opcode == SMIN && self.TLI.isOperationExpand(SMIN, VT) && N0.getOpcode() != SMAX && C.isZero() {
            let mut ShiftAmt: SDValue = self.DAG.getShiftAmountConstant(VT.getScalarSizeInBits() - 1, VT, DL);
            let mut Shift: SDValue = self.DAG.getNode(SRA, DL, VT, N0, ShiftAmt);
            return self.DAG.getNode(AND, DL, VT, N0, Shift);
        }
    }
    let mut IsOpIllegal: bool = !self.TLI.isOperationLegal(Opcode, VT);
    let mut IsSatBroken: bool = Opcode == UMIN && N0.getOpcode() == SMAX;
    if IsSatBroken || IsOpIllegal {
        let mut HasKnownSameSign: Closure_13 = Closure_13 { cap_0: self };
        if HasKnownSameSign.call(N0, N1) {
            let mut AltOpcode: u32 = getOppositeSignednessMinMaxOpcode(Opcode);
            if (IsSatBroken && IsOpIllegal) || self.TLI.isOperationLegal(AltOpcode, VT) {
                return self.DAG.getNode(AltOpcode, DL, VT, N0, N1);
            }
        }
    }
    if Opcode == SMIN || Opcode == SMAX {
        if PerformMinMaxFpToSatCombine(N0, N1, N0, N1, if Opcode == SMIN { SETLT } else { SETGT }, self.DAG) {
            S;
        } else {
            return S;
        }
    }
    if Opcode == UMIN {
        if PerformUMinFpToSatCombine(N0, N1, N0, N1, SETULT, self.DAG) {
            S;
        } else {
            return S;
        }
    }
    let mut ReductionOpcode: Closure_14 = Closure_14 {};
    if self.reassociateReduction(ReductionOpcode.call(Opcode), Opcode, SDLoc { N }, VT, N0, N1, SDNodeFlags { Flags: None }) {
        SD;
    } else {
        return SD;
    }
    if N0.getOpcode() == VSCALE && N1.getOpcode() == VSCALE {
        let mut C0: u64 = operator(N0).getConstantOperandVal(0);
        let mut C1: u64 = operator(N1).getConstantOperandVal(0);
        if Opcode == UMAX {
            return if C0 > C1 { N0 } else { N1 };
        } else if Opcode == UMIN {
            return if C0 > C1 { N1 } else { N0 };
        }
    }
    if N0.getOpcode() == VSCALE {
        if dyn_cast(N1) {
            C1;
        } else {
            let mut ForSigned: bool = (Opcode == SMAX || Opcode == SMIN);
            let mut Range: ConstantRange = self.DAG.computeConstantRange(N0, ForSigned, 0);
            let mut C1V: *APInt = C1.getAPIntValue();
            if (Opcode == UMAX && Range.getUnsignedMax().ule(C1V)) || (Opcode == UMIN && Range.getUnsignedMin().uge(C1V)) || (Opcode == SMAX && Range.getSignedMax().sle(C1V)) || (Opcode == SMIN && Range.getSignedMin().sge(C1V)) {
                return N1;
            }
        }
    }
    if self.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn DAGCombiner::hoistLogicOpWithSameOpcodeHands(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N0.getValueType();
    let mut LogicOpcode: u32 = N.getOpcode();
    let mut HandOpcode: u32 = N0.getOpcode();
    assert!(isBitwiseLogicOp(LogicOpcode), "Expected logic opcode");
    assert!(HandOpcode == N1.getOpcode(), "Bad input!");
    if N0.getNumOperands() == 0 {
        return SDValue {};
    }
    let mut X: SDValue = N0.getOperand(0);
    let mut Y: SDValue = N1.getOperand(0);
    let mut XVT: EVT = X.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    if isExtOpcode(HandOpcode) || isExtVecInRegOpcode(HandOpcode) || (HandOpcode == SIGN_EXTEND_INREG && N0.getOperand(1) == N1.getOperand(1)) {
        if !N0.hasOneUse() && !N1.hasOneUse() {
            return SDValue {};
        }
        if XVT != Y.getValueType() {
            return SDValue {};
        }
        if (VT.isVector() || self.LegalOperations) && !self.TLI.isOperationLegalOrCustom(LogicOpcode, XVT, false) {
            return SDValue {};
        }
        if (HandOpcode == ANY_EXTEND || HandOpcode == ANY_EXTEND_VECTOR_INREG) && self.LegalTypes && !self.TLI.isTypeDesirableForOp(LogicOpcode, XVT) {
            return SDValue {};
        }
        let mut LogicFlags: SDNodeFlags = SDNodeFlags { Flags: None };
        LogicFlags.setDisjoint(N.getFlags().hasDisjoint() && isExtOpcode(HandOpcode));
        let mut Logic: SDValue = self.DAG.getNode(LogicOpcode, DL, XVT, X, Y, LogicFlags);
        if HandOpcode == SIGN_EXTEND_INREG {
            return self.DAG.getNode(HandOpcode, DL, VT, Logic, N0.getOperand(1));
        }
        return self.DAG.getNode(HandOpcode, DL, VT, Logic);
    }
    if HandOpcode == TRUNCATE {
        if !N0.hasOneUse() && !N1.hasOneUse() {
            return SDValue {};
        }
        if XVT != Y.getValueType() {
            return SDValue {};
        }
        if self.LegalOperations && !self.TLI.isOperationLegal(LogicOpcode, XVT) {
            return SDValue {};
        }
        if self.TLI.isZExtFree(VT, XVT) && self.TLI.isTruncateFree(XVT, VT) {
            return SDValue {};
        }
        if !self.TLI.isTypeLegal(XVT) {
            return SDValue {};
        }
        let mut Logic: SDValue = self.DAG.getNode(LogicOpcode, DL, XVT, X, Y);
        return self.DAG.getNode(HandOpcode, DL, VT, Logic);
    }
    if (HandOpcode == SHL || HandOpcode == SRL || HandOpcode == SRA || HandOpcode == AND) && N0.getOperand(1) == N1.getOperand(1) {
        if !N0.hasOneUse() || !N1.hasOneUse() {
            return SDValue {};
        }
        let mut Logic: SDValue = self.DAG.getNode(LogicOpcode, DL, XVT, X, Y);
        return self.DAG.getNode(HandOpcode, DL, VT, Logic, N0.getOperand(1));
    }
    if HandOpcode == BSWAP {
        if !N0.hasOneUse() || !N1.hasOneUse() {
            return SDValue {};
        }
        let mut Logic: SDValue = self.DAG.getNode(LogicOpcode, DL, XVT, X, Y);
        return self.DAG.getNode(HandOpcode, DL, VT, Logic);
    }
    if (HandOpcode == FSHL || HandOpcode == FSHR) && N0.getOperand(2) == N1.getOperand(2) {
        if !N0.hasOneUse() || !N1.hasOneUse() {
            return SDValue {};
        }
        let mut X1: SDValue = N0.getOperand(1);
        let mut Y1: SDValue = N1.getOperand(1);
        let mut S: SDValue = N0.getOperand(2);
        let mut Logic0: SDValue = self.DAG.getNode(LogicOpcode, DL, VT, X, Y);
        let mut Logic1: SDValue = self.DAG.getNode(LogicOpcode, DL, VT, X1, Y1);
        return self.DAG.getNode(HandOpcode, DL, VT, Logic0, Logic1, S);
    }
    if (HandOpcode == BITCAST || HandOpcode == SCALAR_TO_VECTOR) && self.Level <= AfterLegalizeTypes {
        if XVT.isInteger() && XVT == Y.getValueType() && !(VT.isVector() && self.TLI.isTypeLegal(VT) && !XVT.isVector() && !self.TLI.isTypeLegal(XVT)) {
            let mut Logic: SDValue = self.DAG.getNode(LogicOpcode, DL, XVT, X, Y);
            return self.DAG.getNode(HandOpcode, DL, VT, Logic);
        }
    }
    if HandOpcode == VECTOR_SHUFFLE && self.Level < AfterLegalizeDAG {
        let mut SVN0: *mut ShuffleVectorSDNode = cast(N0);
        let mut SVN1: *mut ShuffleVectorSDNode = cast(N1);
        assert!(X.getValueType() == Y.getValueType(), "Inputs to shuffles are not the same type");
        if !SVN0.hasOneUse() || !SVN1.hasOneUse() || !SVN0.getMask().equals(SVN1.getMask()) {
            return SDValue {};
        }
        let mut ShOp: SDValue = N0.getOperand(1);
        if LogicOpcode == XOR && !ShOp.isUndef() {
            ShOp = tryFoldToZero(DL, self.TLI, VT, self.DAG, self.LegalOperations);
        }
        if N0.getOperand(1) == N1.getOperand(1) && ShOp.getNode() {
            let mut Logic: SDValue = self.DAG.getNode(LogicOpcode, DL, VT, N0.getOperand(0), N1.getOperand(0));
            return self.DAG.getVectorShuffle(VT, DL, Logic, ShOp, SVN0.getMask());
        }
        ShOp = N0.getOperand(0);
        if LogicOpcode == XOR && !ShOp.isUndef() {
            ShOp = tryFoldToZero(DL, self.TLI, VT, self.DAG, self.LegalOperations);
        }
        if N0.getOperand(0) == N1.getOperand(0) && ShOp.getNode() {
            let mut Logic: SDValue = self.DAG.getNode(LogicOpcode, DL, VT, N0.getOperand(1), N1.getOperand(1));
            return self.DAG.getVectorShuffle(VT, DL, ShOp, Logic, SVN0.getMask());
        }
    }
    return SDValue {};
}

fn DAGCombiner::foldLogicOfSetCCs(self, IsAnd: bool, N0: SDValue, N1: SDValue, DL: *SDLoc) -> SDValue {
    let mut LL: SDValue = SDValue {};
    let mut LR: SDValue = SDValue {};
    let mut RL: SDValue = SDValue {};
    let mut RR: SDValue = SDValue {};
    let mut N0CC: SDValue = SDValue {};
    let mut N1CC: SDValue = SDValue {};
    if !self.isSetCCEquivalent(N0, LL, LR, N0CC, false) || !self.isSetCCEquivalent(N1, RL, RR, N1CC, false) {
        return SDValue {};
    }
    assert!(N0.getValueType() == N1.getValueType(), "Unexpected operand types for bitwise logic op");
    assert!(LL.getValueType() == LR.getValueType() && RL.getValueType() == RR.getValueType(), "Unexpected operand types for setcc");
    let mut VT: EVT = N0.getValueType();
    let mut OpVT: EVT = LL.getValueType();
    if self.LegalOperations || VT.getScalarType() != EVT { i1 } {
        if VT != self.getSetCCResultType(OpVT) {
            return SDValue {};
        }
    }
    if OpVT != RL.getValueType() {
        return SDValue {};
    }
    let mut CC0: CondCode = cast(N0CC).get();
    let mut CC1: CondCode = cast(N1CC).get();
    let mut IsInteger: bool = OpVT.isInteger();
    if LR == RR && CC0 == CC1 && IsInteger {
        let mut IsZero: bool = isNullOrNullSplat(LR, false);
        let mut IsNeg1: bool = isAllOnesOrAllOnesSplat(LR, false);
        let mut AndEqZero: bool = IsAnd && CC1 == SETEQ && IsZero;
        let mut AndGtNeg1: bool = IsAnd && CC1 == SETGT && IsNeg1;
        let mut OrNeZero: bool = !IsAnd && CC1 == SETNE && IsZero;
        let mut OrLtZero: bool = !IsAnd && CC1 == SETLT && IsZero;
        if AndEqZero || AndGtNeg1 || OrNeZero || OrLtZero {
            let mut Or: SDValue = self.DAG.getNode(OR, SDLoc { N0 }, OpVT, LL, RL);
            self.AddToWorklist(Or.getNode(), true, false);
            return self.DAG.getSetCC(DL, VT, Or, LR, CC1, SDValue {}, false, SDNodeFlags { Flags: None });
        }
        let mut AndEqNeg1: bool = IsAnd && CC1 == SETEQ && IsNeg1;
        let mut AndLtZero: bool = IsAnd && CC1 == SETLT && IsZero;
        let mut OrNeNeg1: bool = !IsAnd && CC1 == SETNE && IsNeg1;
        let mut OrGtNeg1: bool = !IsAnd && CC1 == SETGT && IsNeg1;
        if AndEqNeg1 || AndLtZero || OrNeNeg1 || OrGtNeg1 {
            let mut And: SDValue = self.DAG.getNode(AND, SDLoc { N0 }, OpVT, LL, RL);
            self.AddToWorklist(And.getNode(), true, false);
            return self.DAG.getSetCC(DL, VT, And, LR, CC1, SDValue {}, false, SDNodeFlags { Flags: None });
        }
    }
    if LL.getOpcode() == AND && RL.getOpcode() == AND && isNullConstant(LR) && isNullConstant(RR) && CC0 == CC1 && (CC0 == SETNE || CC0 == SETEQ) {
        let mut LL0: SDValue = SDValue {};
        let mut LL1: SDValue = SDValue {};
        let mut RL0: SDValue = SDValue {};
        let mut RL1: SDValue = SDValue {};
        LL0 = LL.getOperand(0);
        RL0 = RL.getOperand(0);
        LL1 = LL.getOperand(1);
        RL1 = RL.getOperand(1);
        if LL0 == RL0 && self.DAG.isKnownToBeAPowerOfTwo(LL1, false, 0) && self.DAG.isKnownToBeAPowerOfTwo(RL1, false, 0) {
            let mut Or: SDValue = self.DAG.getNode(OR, SDLoc { N0 }, OpVT, LL1, RL1);
            let mut And: SDValue = self.DAG.getNode(AND, SDLoc { N0 }, OpVT, LL0, Or);
            return self.DAG.getSetCC(DL, VT, And, Or, if IsAnd { SETEQ } else { SETNE }, SDValue {}, false, SDNodeFlags { Flags: None });
        }
    }
    if LL == RL && CC0 == CC1 && OpVT.getScalarSizeInBits() > 1 && IsInteger && ((IsAnd && CC0 == SETNE) || (!IsAnd && CC0 == SETEQ)) && ((isNullConstant(LR) && isAllOnesConstant(RR)) || (isAllOnesConstant(LR) && isNullConstant(RR))) {
        let mut One: SDValue = self.DAG.getConstant(1, DL, OpVT, false, false);
        let mut Two: SDValue = self.DAG.getConstant(2, DL, OpVT, false, false);
        let mut Add: SDValue = self.DAG.getNode(ADD, SDLoc { N0 }, OpVT, LL, One);
        self.AddToWorklist(Add.getNode(), true, false);
        return self.DAG.getSetCC(DL, VT, Add, Two, if IsAnd { SETUGE } else { SETULT }, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    if IsInteger && self.TLI.convertSetCCLogicToBitwiseLogic(OpVT) && CC0 == CC1 && N0.hasOneUse() && N1.hasOneUse() {
        if (IsAnd && CC1 == SETEQ) || (!IsAnd && CC1 == SETNE) {
            let mut XorL: SDValue = self.DAG.getNode(XOR, SDLoc { N0 }, OpVT, LL, LR);
            let mut XorR: SDValue = self.DAG.getNode(XOR, SDLoc { N1 }, OpVT, RL, RR);
            let mut Or: SDValue = self.DAG.getNode(OR, DL, OpVT, XorL, XorR);
            let mut Zero: SDValue = self.DAG.getConstant(0, DL, OpVT, false, false);
            return self.DAG.getSetCC(DL, VT, Or, Zero, CC1, SDValue {}, false, SDNodeFlags { Flags: None });
        }
        if (IsAnd && CC1 == SETNE) || (!IsAnd && CC1 == SETEQ) {
            let mut MatchDiffPow2: Closure_15 = Closure_15 {};
            if LL == RL && matchBinaryPredicate(LR, RR, function<bool (ConstantSDNode *, ConstantSDNode *)> { MatchDiffPow2 }, false, false) {
                let mut Max: SDValue = self.DAG.getNode(UMAX, DL, OpVT, LR, RR);
                let mut Min: SDValue = self.DAG.getNode(UMIN, DL, OpVT, LR, RR);
                let mut Offset: SDValue = self.DAG.getNode(SUB, DL, OpVT, LL, Min);
                let mut Diff: SDValue = self.DAG.getNode(SUB, DL, OpVT, Max, Min);
                let mut Mask: SDValue = self.DAG.getNOT(DL, Diff, OpVT);
                let mut And: SDValue = self.DAG.getNode(AND, DL, OpVT, Offset, Mask);
                let mut Zero: SDValue = self.DAG.getConstant(0, DL, OpVT, false, false);
                return self.DAG.getSetCC(DL, VT, And, Zero, CC0, SDValue {}, false, SDNodeFlags { Flags: None });
            }
        }
    }
    if LL == RR && LR == RL {
        CC1 = getSetCCSwappedOperands(CC1);
        swap(RL, RR);
    }
    if LL == RL && LR == RR {
        let mut NewCC: CondCode = if IsAnd { getSetCCAndOperation(CC0, CC1, OpVT) } else { getSetCCOrOperation(CC0, CC1, OpVT) };
        if NewCC != SETCC_INVALID && (!self.LegalOperations || (self.TLI.isCondCodeLegal(NewCC, LL.getSimpleValueType()) && self.TLI.isOperationLegal(SETCC, OpVT))) {
            return self.DAG.getSetCC(DL, VT, LL, LR, NewCC, SDValue {}, false, SDNodeFlags { Flags: None });
        }
    }
    return SDValue {};
}

fn arebothOperandsNotSNan(Operand1: SDValue, Operand2: SDValue, DAG: *mut SelectionDAG) -> bool {
    return DAG.isKnownNeverSNaN(Operand2, 0) && DAG.isKnownNeverSNaN(Operand1, 0);
}

fn arebothOperandsNotNan(Operand1: SDValue, Operand2: SDValue, DAG: *mut SelectionDAG) -> bool {
    return DAG.isKnownNeverNaN(Operand2, false, 0) && DAG.isKnownNeverNaN(Operand1, false, 0);
}

fn getMinMaxOpcodeForClamp(IsMin: bool, Operand1: SDValue, Operand2: SDValue, DAG: *mut SelectionDAG, TLI: *TargetLowering) -> u32 {
    let mut VT: EVT = Operand1.getValueType();
    let mut IEEEOp: u32 = if IsMin { FMINNUM_IEEE } else { FMAXNUM_IEEE };
    if TLI.isOperationLegalOrCustom(IEEEOp, VT, false) && arebothOperandsNotNan(Operand1, Operand2, DAG) {
        return IEEEOp;
    }
    let mut PreferredOp: u32 = if IsMin { FMINNUM } else { FMAXNUM };
    if TLI.isOperationLegalOrCustom(PreferredOp, VT, false) {
        return PreferredOp;
    }
    return DELETED_NODE;
}

fn getMinMaxOpcodeForCompareFold(Operand1: SDValue, Operand2: SDValue, SetCCNoNaNs: bool, CC: CondCode, OrAndOpcode: u32, DAG: *mut SelectionDAG, isFMAXNUMFMINNUM_IEEE: bool, isFMAXNUMFMINNUM: bool) -> u32 {
    if ((CC == SETLT || CC == SETLE) && (OrAndOpcode == OR)) || ((CC == SETGT || CC == SETGE) && (OrAndOpcode == AND)) {
        return if (SetCCNoNaNs || arebothOperandsNotNan(Operand1, Operand2, DAG)) && isFMAXNUMFMINNUM_IEEE { FMINNUM_IEEE } else { DELETED_NODE };
    }
    if ((CC == SETGT || CC == SETGE) && (OrAndOpcode == OR)) || ((CC == SETLT || CC == SETLE) && (OrAndOpcode == AND)) {
        return if (SetCCNoNaNs || arebothOperandsNotNan(Operand1, Operand2, DAG)) && isFMAXNUMFMINNUM_IEEE { FMAXNUM_IEEE } else { DELETED_NODE };
    }
    if ((CC == SETOLT || CC == SETOLE) && (OrAndOpcode == OR)) || ((CC == SETUGT || CC == SETUGE) && (OrAndOpcode == AND)) {
        return if isFMAXNUMFMINNUM { FMINNUM } else { if arebothOperandsNotSNan(Operand1, Operand2, DAG) && isFMAXNUMFMINNUM_IEEE { FMINNUM_IEEE } else { DELETED_NODE } };
    }
    if ((CC == SETOGT || CC == SETOGE) && (OrAndOpcode == OR)) || ((CC == SETULT || CC == SETULE) && (OrAndOpcode == AND)) {
        return if isFMAXNUMFMINNUM { FMAXNUM } else { if arebothOperandsNotSNan(Operand1, Operand2, DAG) && isFMAXNUMFMINNUM_IEEE { FMAXNUM_IEEE } else { DELETED_NODE } };
    }
    return DELETED_NODE;
}

fn foldAndOrOfSETCC(LogicOp: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    assert!((LogicOp.getOpcode() == AND || LogicOp.getOpcode() == OR), "Invalid Op to combine SETCC with");
    let mut LHS: SDValue = LogicOp.getOperand(0);
    let mut RHS: SDValue = LogicOp.getOperand(1);
    if operator(LHS).getOpcode() != SETCC || operator(RHS).getOpcode() != SETCC || !operator(LHS).hasOneUse() || !operator(RHS).hasOneUse() {
        return SDValue {};
    }
    let mut LHSSetCCFlags: SDNodeFlags = operator(LHS).getFlags();
    let mut RHSSetCCFlags: SDNodeFlags = operator(RHS).getFlags();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut TargetPreference: AndOrSETCCFoldKind = TLI.isDesirableToCombineLogicOpOfSETCC(LogicOp, LHS.getNode(), RHS.getNode());
    let mut LHS0: SDValue = operator(LHS).getOperand(0);
    let mut RHS0: SDValue = operator(RHS).getOperand(0);
    let mut LHS1: SDValue = operator(LHS).getOperand(1);
    let mut RHS1: SDValue = operator(RHS).getOperand(1);
    let mut LHS1C: *mut ConstantSDNode = isConstOrConstSplat(LHS1, false, false);
    let mut RHS1C: *mut ConstantSDNode = isConstOrConstSplat(RHS1, false, false);
    let mut CCL: CondCode = cast(LHS.getOperand(2)).get();
    let mut CCR: CondCode = cast(RHS.getOperand(2)).get();
    let mut VT: EVT = LogicOp.getValueType(0);
    let mut OpVT: EVT = LHS0.getValueType();
    let mut DL: SDLoc = SDLoc { LogicOp };
    let mut isFMAXNUMFMINNUM_IEEE: bool = TLI.isOperationLegal(FMAXNUM_IEEE, OpVT) && TLI.isOperationLegal(FMINNUM_IEEE, OpVT);
    let mut isFMAXNUMFMINNUM: bool = TLI.isOperationLegalOrCustom(FMAXNUM, OpVT, false) && TLI.isOperationLegalOrCustom(FMINNUM, OpVT, false);
    if ((OpVT.isInteger() && TLI.isOperationLegal(UMAX, OpVT) && TLI.isOperationLegal(SMAX, OpVT) && TLI.isOperationLegal(UMIN, OpVT) && TLI.isOperationLegal(SMIN, OpVT)) || (OpVT.isFloatingPoint() && (isFMAXNUMFMINNUM_IEEE || isFMAXNUMFMINNUM))) && !isIntEqualitySetCC(CCL) && !isFPEqualitySetCC(CCL) && CCL != SETFALSE && CCL != SETO && CCL != SETUO && CCL != SETTRUE && (CCL == CCR || CCL == getSetCCSwappedOperands(CCR)) {
        let mut CommonValue: SDValue = SDValue {};
        let mut Operand1: SDValue = SDValue {};
        let mut Operand2: SDValue = SDValue {};
        let mut CC: CondCode = SETCC_INVALID;
        if CCL == CCR {
            if LHS0 == RHS0 {
                CommonValue = LHS0;
                Operand1 = LHS1;
                Operand2 = RHS1;
                CC = getSetCCSwappedOperands(CCL);
            } else if LHS1 == RHS1 {
                CommonValue = LHS1;
                Operand1 = LHS0;
                Operand2 = RHS0;
                CC = CCL;
            }
        } else {
            assert!(CCL == getSetCCSwappedOperands(CCR), "Unexpected CC");
            if LHS0 == RHS1 {
                CommonValue = LHS0;
                Operand1 = LHS1;
                Operand2 = RHS0;
                CC = CCR;
            } else if RHS0 == LHS1 {
                CommonValue = LHS1;
                Operand1 = LHS0;
                Operand2 = RHS1;
                CC = CCL;
            }
        }
        if CC == SETLT && isNullOrNullSplat(CommonValue, false) {
            CC = SETCC_INVALID;
        } else if CC == SETGT && isAllOnesOrAllOnesSplat(CommonValue, false) {
            CC = SETCC_INVALID;
        }
        if CC != SETCC_INVALID {
            let mut NewOpcode: u32 = DELETED_NODE;
            let mut IsSigned: bool = isSignedIntSetCC(CC);
            if OpVT.isInteger() {
                let mut IsLess: bool = (CC == SETLE || CC == SETULE || CC == SETLT || CC == SETULT);
                let mut IsOr: bool = (LogicOp.getOpcode() == OR);
                if IsLess == IsOr {
                    NewOpcode = if IsSigned { SMIN } else { UMIN };
                } else {
                    NewOpcode = if IsSigned { SMAX } else { UMAX };
                }
            } else if OpVT.isFloatingPoint() {
                NewOpcode = getMinMaxOpcodeForCompareFold(Operand1, Operand2, LHSSetCCFlags.hasNoNaNs() && RHSSetCCFlags.hasNoNaNs(), CC, LogicOp.getOpcode(), DAG, isFMAXNUMFMINNUM_IEEE, isFMAXNUMFMINNUM);
            }
            if NewOpcode != DELETED_NODE {
                let mut Flags: SDNodeFlags = operator(LHS).getFlags() & operator(RHS).getFlags();
                let mut MinMaxValue: SDValue = DAG.getNode(NewOpcode, DL, OpVT, Operand1, Operand2, Flags);
                return DAG.getSetCC(DL, VT, MinMaxValue, CommonValue, CC, SDValue {}, false, Flags);
            }
        }
    }
    if LHS0 == LHS1 && RHS0 == RHS1 && CCL == CCR && LHS0.getValueType() == RHS0.getValueType() && ((LogicOp.getOpcode() == AND && CCL == SETO) || (LogicOp.getOpcode() == OR && CCL == SETUO)) {
        return DAG.getSetCC(DL, VT, LHS0, RHS0, CCL, SDValue {}, false, SDNodeFlags { Flags: None });
    }
    if TargetPreference == None {
        return SDValue {};
    }
    if CCL == CCR && CCL == (if LogicOp.getOpcode() == AND { SETNE } else { SETEQ }) && LHS0 == RHS0 && LHS1C && RHS1C && OpVT.isInteger() {
        let mut APLhs: *APInt = LHS1C.getAPIntValue();
        let mut APRhs: *APInt = RHS1C.getAPIntValue();
        if APLhs == (operator(APRhs)) && ((TargetPreference & ABS) || DAG.doesNodeExist(ABS, DAG.getVTList(OpVT), ArrayRef<SDValue> { [LHS0] })) {
            let mut C: *APInt = if APLhs.isNegative() { APRhs } else { APLhs };
            let mut AbsOp: SDValue = DAG.getNode(ABS, DL, OpVT, LHS0);
            return DAG.getNode(SETCC, DL, VT, AbsOp, DAG.getConstant(C, DL, OpVT, false, false), LHS.getOperand(2));
        } else if TargetPreference & (AddAnd | NotAnd) {
            let mut MaxC: *APInt = smax(APRhs, APLhs);
            let mut MinC: *APInt = smin(APRhs, APLhs);
            let mut Dif: APInt = MaxC - MinC;
            if !Dif.isZero() && Dif.isPowerOf2() {
                if MaxC.isAllOnes() && (TargetPreference & NotAnd) {
                    let mut NotOp: SDValue = DAG.getNOT(DL, LHS0, OpVT);
                    let mut AndOp: SDValue = DAG.getNode(AND, DL, OpVT, NotOp, DAG.getConstant(MinC, DL, OpVT, false, false));
                    return DAG.getNode(SETCC, DL, VT, AndOp, DAG.getConstant(0, DL, OpVT, false, false), LHS.getOperand(2));
                } else if TargetPreference & AddAnd {
                    let mut AddOp: SDValue = DAG.getNode(ADD, DL, OpVT, LHS0, DAG.getConstant(operator(MinC), DL, OpVT, false, false));
                    let mut AndOp: SDValue = DAG.getNode(AND, DL, OpVT, AddOp, DAG.getConstant(operator(Dif), DL, OpVT, false, false));
                    return DAG.getNode(SETCC, DL, VT, AndOp, DAG.getConstant(0, DL, OpVT, false, false), LHS.getOperand(2));
                }
            }
        }
    }
    return SDValue {};
}

fn combineSelectAsExtAnd(Cond: SDValue, T: SDValue, F: SDValue, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if !isNullConstant(F) {
        return SDValue {};
    }
    let mut CondVT: EVT = Cond.getValueType();
    if TLI.getBooleanContents(CondVT) != ZeroOrOneBooleanContent {
        return SDValue {};
    }
    if T.getOpcode() != AND {
        return SDValue {};
    }
    if !isOneConstant(T.getOperand(1)) {
        return SDValue {};
    }
    let mut OpVT: EVT = T.getValueType();
    let mut CondMask: SDValue = if OpVT == CondVT { Cond } else { DAG.getBoolExtOrTrunc(Cond, DL, OpVT, CondVT) };
    return DAG.getNode(AND, DL, OpVT, CondMask, T.getOperand(0));
}

fn DAGCombiner::visitANDLike(self, N0: SDValue, N1: SDValue, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N1.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    if N0.isUndef() || N1.isUndef() {
        return self.DAG.getConstant(0, DL, VT, false, false);
    }
    if self.foldLogicOfSetCCs(true, N0, N1, DL) {
        V;
    } else {
        return V;
    }
    if N1.getOpcode() == ADD {
        swap(N0, N1);
    }
    if N0.getOpcode() == ADD && N1.getOpcode() == SRL && VT.isScalarInteger() && VT.getSizeInBits().operator unsigned long long() <= 64 && operator(N0).hasOneUse() {
        if dyn_cast(N0.getOperand(1)) {
            ADDI;
        } else {
            if dyn_cast(N1.getOperand(1)) {
                SRLI;
            } else {
                let mut ADDC: APInt = ADDI.getAPIntValue();
                let mut SRLC: APInt = SRLI.getAPIntValue();
                if ADDC.getSignificantBits() <= 64 && SRLC.ult(VT.getSizeInBits().operator unsigned long long()) && !self.TLI.isLegalAddImmediate(ADDC.getSExtValue()) {
                    let mut Mask: APInt = getHighBitsSet(VT.getSizeInBits().operator unsigned long long(), SRLC.getZExtValue());
                    if self.DAG.MaskedValueIsZero(N0.getOperand(1), Mask, 0) {
                        operator(ADDC, Mask);
                        if self.TLI.isLegalAddImmediate(ADDC.getSExtValue()) {
                            let mut DL0: SDLoc = SDLoc { N0 };
                            let mut NewAdd: SDValue = self.DAG.getNode(ADD, DL0, VT, N0.getOperand(0), self.DAG.getConstant(ADDC, DL, VT, false, false));
                            self.CombineTo(N0.getNode(), NewAdd, true);
                            return SDValue { Node: N, ResNo: 0 };
                        }
                    }
                }
            }
        }
    }
    return SDValue {};
}

fn DAGCombiner::isAndLoadExtLoad(self, AndC: *mut ConstantSDNode, LoadN: *mut LoadSDNode, LoadResultTy: EVT, ExtVT: *mut EVT) -> bool {
    if !AndC.getAPIntValue().isMask() {
        return false;
    }
    let mut ActiveBits: u32 = AndC.getAPIntValue().countr_one();
    ExtVT = getIntegerVT(*self.DAG.getContext(), ActiveBits);
    let mut LoadedVT: EVT = LoadN.getMemoryVT();
    if ExtVT == LoadedVT && (!self.LegalOperations || self.TLI.isLoadLegal(LoadResultTy, ExtVT, LoadN.getAlign(), LoadN.getAddressSpace(), ZEXTLOAD, false)) {
        return true;
    }
    if !LoadN.isSimple() {
        return false;
    }
    if !LoadedVT.bitsGT(ExtVT) || !ExtVT.isRound() {
        return false;
    }
    if self.LegalOperations && !self.TLI.isLoadLegal(LoadResultTy, ExtVT, LoadN.getAlign(), LoadN.getAddressSpace(), ZEXTLOAD, false) {
        return false;
    }
    if !self.TLI.shouldReduceLoadWidth(LoadN, ZEXTLOAD, ExtVT, optional<unsigned int> { 0 }) {
        return false;
    }
    return true;
}

fn DAGCombiner::isLegalNarrowLdSt(self, LDST: *mut LSBaseSDNode, ExtType: LoadExtType, MemVT: *mut EVT, ShAmt: u32) -> bool {
    if !LDST {
        return false;
    }
    if ShAmt % 8 {
        return false;
    }
    let mut ByteShAmt: u32 = ShAmt / 8;
    if !MemVT.isRound() {
        return false;
    }
    if !LDST.isSimple() {
        return false;
    }
    let mut LdStMemVT: EVT = LDST.getMemoryVT();
    if LdStMemVT.isScalableVector() != MemVT.isScalableVector() {
        return false;
    }
    if LdStMemVT.bitsLT(MemVT) {
        return false;
    }
    if ShAmt {
        let mut LDSTAlign: Align = LDST.getAlign();
        let mut NarrowAlign: Align = commonAlignment(LDSTAlign, ByteShAmt);
        if !self.TLI.allowsMemoryAccess(*self.DAG.getContext(), self.DAG.getDataLayout(), MemVT, LDST.getAddressSpace(), NarrowAlign, LDST.getMemOperand().getFlags(), null) {
            return false;
        }
    }
    let mut PtrType: EVT = LDST.getBasePtr().getValueType();
    if PtrType == EVT { Untyped } || PtrType.isExtended() {
        return false;
    }
    if isa(LDST) {
        let mut Load: *mut LoadSDNode = cast(LDST);
        if !SDValue { Node: Load, ResNo: 0 }.hasOneUse() {
            return false;
        }
        if self.LegalOperations && !self.TLI.isLoadLegal(Load.getValueType(0), MemVT, Load.getAlign(), Load.getAddressSpace(), ExtType, false) {
            return false;
        }
        if Load.getNumValues() > 2 {
            return false;
        }
        if Load.getExtensionType() != NON_EXTLOAD && Load.getMemoryVT().getSizeInBits().operator unsigned long long() < MemVT.getSizeInBits().operator unsigned long long() + ShAmt {
            return false;
        }
        if !self.TLI.shouldReduceLoadWidth(Load, ExtType, MemVT, optional<unsigned int> { ByteShAmt }) {
            return false;
        }
    } else {
        assert!(isa(LDST), "It is not a Load nor a Store SDNode");
        let mut Store: *mut StoreSDNode = cast(LDST);
        if Store.getMemoryVT().getSizeInBits().operator unsigned long long() < MemVT.getSizeInBits().operator unsigned long long() + ShAmt {
            return false;
        }
        if self.LegalOperations && !self.TLI.isTruncStoreLegal(Store.getValue().getValueType(), MemVT, Store.getAlign(), Store.getAddressSpace()) {
            return false;
        }
    }
    return true;
}

fn DAGCombiner::SearchForAndLoads(self, N: *mut SDNode, Loads: *mut SmallVectorImpl<LoadSDNode *>, NodesWithConsts: *mut SmallPtrSetImpl<SDNode *>, Mask: *mut ConstantSDNode, NodeToMask: *mut *mut SDNode) -> bool {
    for Op in N.op_values() {
        if Op.getValueType().isVector() {
            return false;
        }
        if dyn_cast(Op) {
            C;
        } else {
            assert!(isBitwiseLogicOp(N.getOpcode()), "Expected bitwise logic operation");
            if !C.getAPIntValue().isSubsetOf(Mask.getAPIntValue()) {
                NodesWithConsts.insert(N);
            }
            continue;
        }
        if !Op.hasOneUse() {
            return false;
        }
        match Op.getOpcode() {
            LOAD => {
                let mut Load: *mut LoadSDNode = cast(Op);
                let mut ExtVT: EVT = EVT {};
                if self.isAndLoadExtLoad(Mask, Load, Load.getValueType(0), ExtVT) && self.isLegalNarrowLdSt(Load, ZEXTLOAD, ExtVT, 0) {
                    if Load.getExtensionType() == ZEXTLOAD && ExtVT.bitsGE(Load.getMemoryVT()) {
                        continue;
                    }
                    if ExtVT.bitsLE(Load.getMemoryVT()) {
                        Loads.push(Load);
                    }
                    continue;
                }
                return false;
            },
            ZERO_EXTEND => {
                AssertZext;
            },
            OR => {
                XOR;
            },
        }
        if NodeToMask {
            return false;
        }
        NodeToMask = Op.getNode();
        if NodeToMask.getNumValues() > 1 {
            let mut HasValue: bool = false;
            for let mut i: u32 = 0;
let mut e: u32 = NodeToMask.getNumValues(); i < e; i += 1 {
                let mut VT: MVT = SDValue { Node: NodeToMask, ResNo: i }.getSimpleValueType();
                if VT != Glue && VT != Other {
                    if HasValue {
                        NodeToMask = null;
                        return false;
                    }
                    HasValue = true;
                }
            }
            assert!(HasValue, "Node to be masked has no data result?");
        }
    }
    return true;
}

fn DAGCombiner::BackwardsPropagateMask(self, N: *mut SDNode) -> bool {
    let mut Mask: *mut ConstantSDNode = dyn_cast(N.getOperand(1));
    if !Mask {
        return false;
    }
    if !Mask.getAPIntValue().isMask() {
        return false;
    }
    if isa(N.getOperand(0)) {
        return false;
    }
    let mut Loads: SmallVector<LoadSDNode *, 8> = SmallVector<LoadSDNode *, 8> {};
    let mut NodesWithConsts: SmallPtrSet<SDNode *, 2> = SmallPtrSet<SDNode *, 2> {};
    let mut FixupNode: *mut SDNode = null;
    if self.SearchForAndLoads(N, Loads, NodesWithConsts, Mask, FixupNode) {
        if Loads.len == 0 {
            return false;
        }
        while true {
            {
            if DebugFlag && isCurrentDebugType("dagcombine", 1) {
                dbgs() << "Backwards propagate AND: ";
                N.dump();
            }
        }
            if !(false) { break; }
        }
        let mut MaskOp: SDValue = N.getOperand(1);
        if FixupNode {
            while true {
                {
                if DebugFlag && isCurrentDebugType("dagcombine", 1) {
                    dbgs() << "First, need to fix up: ";
                    FixupNode.dump();
                }
            }
                if !(false) { break; }
            }
            let mut And: SDValue = self.DAG.getNode(AND, SDLoc { FixupNode }, FixupNode.getValueType(0), SDValue { Node: FixupNode, ResNo: 0 }, MaskOp);
            self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: FixupNode, ResNo: 0 }, And);
            if And.getOpcode() == AND {
                self.DAG.UpdateNodeOperands(And.getNode(), SDValue { Node: FixupNode, ResNo: 0 }, MaskOp);
            }
        }
        for LogicN in NodesWithConsts {
            let mut Op0: SDValue = LogicN.getOperand(0);
            let mut Op1: SDValue = LogicN.getOperand(1);
            if LogicN.getOpcode() == AND && (!isa(Op0) || !isa(Op1)) {
                continue;
            }
            if isa(Op0) && LogicN.getOpcode() != AND {
                Op0 = self.DAG.getNode(AND, SDLoc { Op0 }, Op0.getValueType(), Op0, MaskOp);
            }
            if isa(Op1) {
                Op1 = self.DAG.getNode(AND, SDLoc { Op1 }, Op1.getValueType(), Op1, MaskOp);
            }
            if isa(Op0) && !isa(Op1) {
                swap(Op0, Op1);
            }
            self.DAG.UpdateNodeOperands(LogicN, Op0, Op1);
        }
        for Load in Loads {
            while true {
                {
                if DebugFlag && isCurrentDebugType("dagcombine", 1) {
                    dbgs() << "Propagate AND back to: ";
                    Load.dump();
                }
            }
                if !(false) { break; }
            }
            let mut And: SDValue = self.DAG.getNode(AND, SDLoc { Load }, Load.getValueType(0), SDValue { Node: Load, ResNo: 0 }, MaskOp);
            self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: Load, ResNo: 0 }, And);
            if And.getOpcode() == AND {
                And = SDValue { Node: self.DAG.UpdateNodeOperands(And.getNode(), SDValue { Node: Load, ResNo: 0 }, MaskOp), ResNo: 0 };
            }
            let mut NewLoad: SDValue = self.reduceLoadWidth(And.getNode());
            assert!(NewLoad, "Shouldn't be masking the load if it can't be narrowed");
            self.CombineTo(Load, NewLoad, NewLoad.getValue(1), true);
        }
        self.DAG.ReplaceAllUsesWith(N, N.getOperand(0).getNode());
        return true;
    }
    return false;
}

fn DAGCombiner::unfoldExtremeBitClearingToShifts(self, N: *mut SDNode) -> SDValue {
    assert!(N.getOpcode() == AND);
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    if !self.TLI.shouldFoldMaskToVariableShiftPair(N0) {
        return SDValue {};
    }
    let mut OuterShift: u32 = 0;
    let mut InnerShift: u32 = 0;
    let mut Y: SDValue = SDValue {};
    let mut matchMask: Closure_16 = Closure_16 { OuterShift: &mut OuterShift, InnerShift: &mut InnerShift, Y: &mut Y };
    let mut X: SDValue = SDValue {};
    if matchMask.call(N1) {
        X = N0;
    } else if matchMask.call(N0) {
        X = N1;
    } else {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    let mut T0: SDValue = self.DAG.getNode(InnerShift, DL, VT, X, Y);
    let mut T1: SDValue = self.DAG.getNode(OuterShift, DL, VT, T0, Y);
    return T1;
}

fn combineShiftAnd1ToBitTest(And: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    assert!(And.getOpcode() == AND, "Expected an 'and' op");
    let mut And0: SDValue = And.getOperand(0);
    let mut And1: SDValue = And.getOperand(1);
    if And0.getOpcode() == ANY_EXTEND && And0.hasOneUse() {
        And0 = And0.getOperand(0);
    }
    if !isOneConstant(And1) || !And0.hasOneUse() {
        return SDValue {};
    }
    let mut Src: SDValue = And0;
    let mut FoundNot: bool = false;
    if isBitwiseNot(Src, false) {
        FoundNot = true;
        Src = Src.getOperand(0);
        if Src.getOpcode() == TRUNCATE && Src.hasOneUse() {
            Src = Src.getOperand(0);
        }
    }
    if Src.getOpcode() != SRL || !Src.hasOneUse() {
        return SDValue {};
    }
    let mut SrcVT: EVT = Src.getValueType();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if !TLI.isTypeLegal(SrcVT) {
        return SDValue {};
    }
    let mut BitWidth: u32 = SrcVT.getScalarSizeInBits();
    let mut ShiftAmt: SDValue = Src.getOperand(1);
    let mut ShiftAmtC: *mut ConstantSDNode = dyn_cast(ShiftAmt);
    if !ShiftAmtC || !ShiftAmtC.getAPIntValue().ult(BitWidth) {
        return SDValue {};
    }
    Src = Src.getOperand(0);
    if !FoundNot {
        if !isBitwiseNot(Src, false) {
            return SDValue {};
        }
        Src = Src.getOperand(0);
    }
    if !TLI.hasBitTest(Src, ShiftAmt) {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { And };
    let mut X: SDValue = DAG.getZExtOrTrunc(Src, DL, SrcVT);
    let mut CCVT: EVT = TLI.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), SrcVT);
    let mut Mask: SDValue = DAG.getConstant(getOneBitSet(BitWidth, ShiftAmtC.getZExtValue()), DL, SrcVT, false, false);
    let mut NewAnd: SDValue = DAG.getNode(AND, DL, SrcVT, X, Mask);
    let mut Zero: SDValue = DAG.getConstant(0, DL, SrcVT, false, false);
    let mut Setcc: SDValue = DAG.getSetCC(DL, CCVT, NewAnd, Zero, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
    return DAG.getZExtOrTrunc(Setcc, DL, And.getValueType(0));
}

fn foldAndToUsubsat(N: *mut SDNode, DAG: *mut SelectionDAG, DL: *SDLoc) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut BitWidth: u32 = VT.getScalarSizeInBits();
    let mut SignMask: APInt = getSignMask(BitWidth);
    let mut X: SDValue = SDValue {};
    if !sd_match(N, m_And(m_OneUse(m_Xor(m_Value(X), m_SpecificInt(SignMask))), m_OneUse(m_Sra(m_Deferred(X), m_SpecificInt(BitWidth - 1))))) && !sd_match(N, m_And(m_OneUse(m_Add(m_Value(X), m_SpecificInt(SignMask))), m_OneUse(m_Sra(m_Deferred(X), m_SpecificInt(BitWidth - 1))))) {
        return SDValue {};
    }
    return DAG.getNode(USUBSAT, DL, VT, X, DAG.getConstant(SignMask, DL, VT, false, false));
}

fn foldLogicOfShifts(N: *mut SDNode, LogicOp: SDValue, ShiftOp: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut LogicOpcode: u32 = N.getOpcode();
    assert!(isBitwiseLogicOp(LogicOpcode), "Expected bitwise logic operation");
    if !LogicOp.hasOneUse() || !ShiftOp.hasOneUse() {
        return SDValue {};
    }
    let mut ShiftOpcode: u32 = ShiftOp.getOpcode();
    if LogicOp.getOpcode() != LogicOpcode || !(ShiftOpcode == SHL || ShiftOpcode == SRL || ShiftOpcode == SRA) {
        return SDValue {};
    }
    let mut X1: SDValue = ShiftOp.getOperand(0);
    let mut Y: SDValue = ShiftOp.getOperand(1);
    let mut X0: SDValue = SDValue {};
    let mut Z: SDValue = SDValue {};
    if LogicOp.getOperand(0).getOpcode() == ShiftOpcode && LogicOp.getOperand(0).getOperand(1) == Y {
        X0 = LogicOp.getOperand(0).getOperand(0);
        Z = LogicOp.getOperand(1);
    } else if LogicOp.getOperand(1).getOpcode() == ShiftOpcode && LogicOp.getOperand(1).getOperand(1) == Y {
        X0 = LogicOp.getOperand(1).getOperand(0);
        Z = LogicOp.getOperand(0);
    } else {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    let mut LogicX: SDValue = DAG.getNode(LogicOpcode, DL, VT, X0, X1);
    let mut NewShift: SDValue = DAG.getNode(ShiftOpcode, DL, VT, LogicX, Y);
    return DAG.getNode(LogicOpcode, DL, VT, NewShift, Z);
}

fn foldLogicTreeOfShifts(N: *mut SDNode, LeftHand: SDValue, RightHand: SDValue, DAG: *mut SelectionDAG) -> SDValue {
    let mut LogicOpcode: u32 = N.getOpcode();
    assert!(isBitwiseLogicOp(LogicOpcode), "Expected bitwise logic operation");
    if LeftHand.getOpcode() != LogicOpcode || RightHand.getOpcode() != LogicOpcode {
        return SDValue {};
    }
    if !LeftHand.hasOneUse() || !RightHand.hasOneUse() {
        return SDValue {};
    }
    let mut CombinedShifts: SDValue = SDValue {};
    let mut W: SDValue = SDValue {};
    let mut R0: SDValue = RightHand.getOperand(0);
    let mut R1: SDValue = RightHand.getOperand(1);
    if (CombinedShifts = foldLogicOfShifts(N, LeftHand, R0, DAG)) {
        W = R1;
    } else if (CombinedShifts = foldLogicOfShifts(N, LeftHand, R1, DAG)) {
        W = R0;
    } else {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    return DAG.getNode(LogicOpcode, DL, VT, CombinedShifts, W);
}

fn foldMaskedMerge(Node: *mut SDNode, DAG: *mut SelectionDAG, TLI: *TargetLowering, DL: *SDLoc) -> SDValue {
    assert!((Node.getOpcode() == OR || Node.getOpcode() == AND), "Must be called with ISD::OR or ISD::AND node");
    if TLI.hasAndNot(SDValue { Node: Node, ResNo: 0 }) {
        return SDValue {};
    }
    let mut M: SDValue = SDValue {};
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    if sd_match(Node, m_Or(m_OneUse(m_And(m_OneUse(m_Not(m_Value(M))), m_Value(Y))), m_OneUse(m_And(m_Deferred(M), m_Value(X))))) || sd_match(Node, m_And(m_OneUse(m_Or(m_OneUse(m_Not(m_Value(M))), m_Value(X))), m_OneUse(m_Or(m_Deferred(M), m_Value(Y))))) {
        let mut VT: EVT = M.getValueType();
        let mut Xor: SDValue = DAG.getNode(XOR, DL, VT, X, Y);
        let mut And: SDValue = DAG.getNode(AND, DL, VT, Xor, M);
        return DAG.getNode(XOR, DL, VT, And, Y);
    }
    return SDValue {};
}

fn DAGCombiner::visitAND(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N1.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    if N0 == N1 {
        return N0;
    }
    if self.DAG.FoldConstantArithmetic(AND, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if self.DAG.isConstantIntBuildVectorOrConstantInt(N0, true) && !self.DAG.isConstantIntBuildVectorOrConstantInt(N1, true) {
        return self.DAG.getNode(AND, DL, VT, N1, N0);
    }
    if areBitwiseNotOfEachother(N0, N1) {
        return self.DAG.getConstant(getZero(VT.getScalarSizeInBits()), DL, VT, false, false);
    }
    if VT.isVector() {
        if self.SimplifyVBinOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
        if isConstantSplatVectorAllZeros(N1.getNode(), false) {
            return self.DAG.getConstant(getZero(N1.getScalarValueSizeInBits()), DL, N1.getValueType(), false, false);
        }
        if isConstantSplatVectorAllOnes(N1.getNode(), false) {
            return N0;
        }
        let mut BV0: *mut BuildVectorSDNode = dyn_cast(N0);
        let mut BV1: *mut BuildVectorSDNode = dyn_cast(N1);
        if BV0 && BV1 && !BV0.getSplatValue(null) && !BV1.getSplatValue(null) && N0.hasOneUse() && N1.hasOneUse() && BV0.getOperand(0).getValueType() == BV1.getOperand(0).getValueType() {
            let mut MergedOps: SmallVector<SDValue> = SmallVector<SDValue> {};
            let mut NumElts: u32 = VT.getVectorNumElements();
            let mut EltVT: EVT = BV0.getOperand(0).getValueType();
            for let mut I: u32 = 0; I != NumElts; I += 1 {
                let mut C0: *mut ConstantSDNode = dyn_cast(BV0.getOperand(I));
                let mut C1: *mut ConstantSDNode = dyn_cast(BV1.getOperand(I));
                if C0 && C1 {
                    MergedOps.push(self.DAG.getConstant(C0.getAPIntValue() & C1.getAPIntValue(), DL, EltVT, false, false));
                } else if C0 && C0.isZero() {
                    MergedOps.push(ValueParamT { BV0.getOperand(I) });
                } else if C1 && C1.isZero() {
                    MergedOps.push(ValueParamT { BV1.getOperand(I) });
                } else if C0 && C0.isAllOnes() {
                    MergedOps.push(ValueParamT { BV1.getOperand(I) });
                } else if C1 && C1.isAllOnes() {
                    MergedOps.push(ValueParamT { BV0.getOperand(I) });
                } else if BV0.getOperand(I) == BV1.getOperand(I) {
                    MergedOps.push(ValueParamT { BV0.getOperand(I) });
                } else {
                    break;
                }
            }
            if MergedOps.len == NumElts {
                return self.DAG.getBuildVector(VT, DL, ArrayRef<SDValue> { MergedOps });
            }
        }
        let mut Frozen: bool = N0.getOpcode() == FREEZE;
        let mut MLoad: *mut MaskedLoadSDNode = dyn_cast(if Frozen { N0.getOperand(0) } else { N0 });
        let mut Splat: *mut ConstantSDNode = isConstOrConstSplat(N1, true, true);
        if MLoad && MLoad.getExtensionType() == EXTLOAD && Splat {
            let mut MemVT: EVT = MLoad.getMemoryVT();
            if self.TLI.isLoadLegal(VT, MemVT, MLoad.getAlign(), MLoad.getAddressSpace(), ZEXTLOAD, false) {
                if Splat.getAPIntValue().isMask(MemVT.getScalarSizeInBits()) {
                    let mut NewLoad: SDValue = self.DAG.getMaskedLoad(VT, DL, MLoad.getChain(), MLoad.getBasePtr(), MLoad.getOffset(), MLoad.getMask(), MLoad.getPassThru(), MemVT, MLoad.getMemOperand(), MLoad.getAddressingMode(), ZEXTLOAD, MLoad.isExpandingLoad());
                    self.CombineTo(N, if Frozen { N0 } else { NewLoad }, true);
                    self.CombineTo(MLoad, NewLoad, NewLoad.getValue(1), true);
                    return SDValue { Node: N, ResNo: 0 };
                }
            }
        }
    }
    if isAllOnesConstant(N1) {
        return N0;
    }
    let mut BitWidth: u32 = VT.getScalarSizeInBits();
    let mut N1C: *mut ConstantSDNode = isConstOrConstSplat(N1, false, false);
    if N1C && self.DAG.MaskedValueIsZero(SDValue { Node: N, ResNo: 0 }, getAllOnes(BitWidth), 0) {
        return self.DAG.getConstant(0, DL, VT, false, false);
    }
    if foldAndOrOfSETCC(N, self.DAG) {
        R;
    } else {
        return R;
    }
    if self.foldBinOpIntoSelect(N) {
        NewSel;
    } else {
        return NewSel;
    }
    if self.reassociateOps(AND, DL, N0, N1, N.getFlags()) {
        RAND;
    } else {
        return RAND;
    }
    if self.reassociateReduction(VECREDUCE_AND, AND, DL, VT, N0, N1, SDNodeFlags { Flags: None }) {
        SD;
    } else {
        return SD;
    }
    let mut MatchSubset: Closure_17 = Closure_17 {};
    if N0.getOpcode() == OR && matchBinaryPredicate(N0.getOperand(1), N1, function<bool (ConstantSDNode *, ConstantSDNode *)> { MatchSubset }, false, false) {
        return N1;
    }
    if N1C && N0.getOpcode() == ANY_EXTEND {
        let mut N0Op0: SDValue = N0.getOperand(0);
        let mut SrcVT: EVT = N0Op0.getValueType();
        let mut SrcBitWidth: u32 = SrcVT.getScalarSizeInBits();
        let mut Mask: APInt = operator(N1C.getAPIntValue());
        Mask = Mask.trunc(SrcBitWidth);
        if self.DAG.MaskedValueIsZero(N0Op0, Mask, 0) {
            return self.DAG.getNode(ZERO_EXTEND, DL, VT, N0Op0);
        }
        if N1C.getAPIntValue().countLeadingZeros() >= (BitWidth - SrcBitWidth) && (self.TLI.isZExtFree(SrcVT, VT) || !self.TLI.isAnyExtFree(SrcVT, VT)) && self.TLI.isTypeDesirableForOp(AND, SrcVT) && self.TLI.isNarrowingProfitable(N, VT, SrcVT) {
            return self.DAG.getNode(ZERO_EXTEND, DL, VT, self.DAG.getNode(AND, DL, SrcVT, N0Op0, self.DAG.getZExtOrTrunc(N1, DL, SrcVT)));
        }
    }
    if isExtOpcode(N0.getOpcode()) {
        let mut ExtOpc: u32 = N0.getOpcode();
        let mut N0Op0: SDValue = N0.getOperand(0);
        if N0Op0.getOpcode() == AND && (ExtOpc != ZERO_EXTEND || !self.TLI.isZExtFree(N0Op0, VT)) && operator(N0).hasOneUse() && operator(N0Op0).hasOneUse() {
            if self.DAG.FoldConstantArithmetic(ExtOpc, DL, VT, ArrayRef<SDValue> { [N0Op0.getOperand(1)] }, SDNodeFlags { Flags: None }) {
                NewExt;
            } else {
                if self.DAG.FoldConstantArithmetic(AND, DL, VT, ArrayRef<SDValue> { [N1, NewExt] }, SDNodeFlags { Flags: None }) {
                    NewMask;
                } else {
                    return self.DAG.getNode(AND, DL, VT, self.DAG.getNode(ExtOpc, DL, VT, N0Op0.getOperand(0)), NewMask);
                }
            }
        }
    }
    if (N0.getOpcode() == EXTRACT_VECTOR_ELT && N0.getValueSizeInBits().operator unsigned long long() == N0.getOperand(0).getScalarValueSizeInBits() && N0.getOperand(0).getOpcode() == LOAD && N0.getOperand(0).getResNo() == 0) || (N0.getOpcode() == LOAD && N0.getResNo() == 0) {
        let mut Load: *mut LoadSDNode = cast(if (N0.getOpcode() == LOAD) { N0 } else { N0.getOperand(0) });
        let mut Constant: APInt = getZero(1);
        if isConstOrConstSplat(N1, false, true) {
            C;
        } else {
            Constant = C.getAPIntValue();
        }
        let mut CanZextLoadProfitably: bool = self.TLI.isLoadLegal(Load.getValueType(0), Load.getMemoryVT(), Load.getAlign(), Load.getAddressSpace(), ZEXTLOAD, false);
        Constant = Constant.zextOrTrunc(Load.getMemoryVT().getScalarSizeInBits());
        let mut B: bool = false;
        match Load.getExtensionType() {
            _ => {
                B = false;
            },
            EXTLOAD => {
                B = CanZextLoadProfitably;
            },
            ZEXTLOAD => {
                NON_EXTLOAD;
            },
        }
        if B && Constant.isAllOnes() {
            let mut NewLoad: SDValue = SDValue { Node: Load, ResNo: 0 };
            self.CombineTo(N, if (N0.getNode() == Load) { NewLoad } else { N0 }, true);
            if Load.getExtensionType() == EXTLOAD {
                NewLoad = self.DAG.getLoad(Load.getAddressingMode(), ZEXTLOAD, Load.getValueType(0), SDLoc { Load }, Load.getChain(), Load.getBasePtr(), Load.getOffset(), Load.getMemoryVT(), Load.getMemOperand());
                if Load.getNumValues() == 3 {
                    let mut To: [3]SDValue = [NewLoad.getValue(0), NewLoad.getValue(1), NewLoad.getValue(2)];
                    self.CombineTo(Load, To, 3, true);
                } else {
                    self.CombineTo(Load, NewLoad.getValue(0), NewLoad.getValue(1), true);
                }
            }
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    if VT.isVector() {
        if self.XformToShuffleWithZero(N) {
            Shuffle;
        } else {
            return Shuffle;
        }
    }
    if combineCarryDiamond(self.DAG, self.TLI, N0, N1, N) {
        Combined;
    } else {
        return Combined;
    }
    if N0.getOpcode() == EXTRACT_SUBVECTOR && N0.hasOneUse() && N1C && isExtOpcode(N0.getOperand(0).getOpcode()) {
        let mut Ext: SDValue = N0.getOperand(0);
        let mut ExtVT: EVT = operator(Ext).getValueType(0);
        let mut Extendee: SDValue = operator(Ext).getOperand(0);
        let mut ScalarWidth: u32 = Extendee.getValueType().getScalarSizeInBits();
        if N1C.getAPIntValue().isMask(ScalarWidth) && (!self.LegalOperations || self.TLI.isOperationLegal(ZERO_EXTEND, ExtVT)) {
            let mut ZeroExtExtendee: SDValue = self.DAG.getNode(ZERO_EXTEND, DL, ExtVT, Extendee);
            return self.DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, ZeroExtExtendee, N0.getOperand(1));
        }
    }
    if dyn_cast(N0) {
        GN0;
    } else {
        let mut MemVT: EVT = GN0.getMemoryVT();
        let mut ScalarVT: EVT = MemVT.getScalarType();
        if SDValue { Node: GN0, ResNo: 0 }.hasOneUse() && isConstantSplatVectorMaskForType(N1.getNode(), ScalarVT) && self.TLI.isVectorLoadExtDesirable(SDValue { Node: N, ResNo: 0 }) {
            let mut Ops: [6]SDValue = [GN0.getChain(), GN0.getPassThru(), GN0.getMask(), GN0.getBasePtr(), GN0.getIndex(), GN0.getScale()];
            let mut ZExtLoad: SDValue = self.DAG.getMaskedGather(self.DAG.getVTList(VT, EVT { Other }), MemVT, DL, ArrayRef<SDValue> { Ops }, GN0.getMemOperand(), GN0.getIndexType(), ZEXTLOAD);
            self.CombineTo(N, ZExtLoad, true);
            self.AddToWorklist(ZExtLoad.getNode(), true, false);
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    if N1C && !VT.isVector() {
        let mut Inner: SDValue = peekThroughFreeze(N0);
        if Inner.getOpcode() == LOAD {
            if self.reduceLoadWidth(N) {
                Res;
            } else {
                return Res;
            }
        }
    }
    if self.LegalTypes {
        if self.BackwardsPropagateMask(N) {
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    if self.visitANDLike(N0, N1, N) {
        Combined;
    } else {
        return Combined;
    }
    if N0.getOpcode() == N1.getOpcode() {
        if self.hoistLogicOpWithSameOpcodeHands(N) {
            V;
        } else {
            return V;
        }
    }
    if foldLogicOfShifts(N, N0, N1, self.DAG) {
        R;
    } else {
        return R;
    }
    if foldLogicOfShifts(N, N1, N0, self.DAG) {
        R;
    } else {
        return R;
    }
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    let mut Z: SDValue = SDValue {};
    let mut NotY: SDValue = SDValue {};
    for Opc in [BSWAP, BITREVERSE] {
        if sd_match(N, m_And(m_Value(X), m_OneUse(m_UnaryOp(Opc, m_Value(NotY))))) && sd_match(NotY, m_Not(m_Value(Y))) && (self.TLI.hasAndNot(SDValue { Node: N, ResNo: 0 }) || operator(NotY).hasOneUse()) {
            return self.DAG.getNode(AND, DL, VT, X, self.DAG.getNOT(DL, self.DAG.getNode(Opc, DL, VT, Y), VT));
        }
    }
    for Opc in [ROTL, ROTR] {
        if sd_match(N, m_And(m_Value(X), m_OneUse(m_BinOp(Opc, m_Value(NotY), m_Value(Z), SDNodeFlags { Flags: None })))) && sd_match(NotY, m_Not(m_Value(Y))) && (self.TLI.hasAndNot(SDValue { Node: N, ResNo: 0 }) || operator(NotY).hasOneUse()) {
            return self.DAG.getNode(AND, DL, VT, X, self.DAG.getNOT(DL, self.DAG.getNode(Opc, DL, VT, Y, Z), VT));
        }
    }
    if self.TLI.hasAndNot(SDValue { Node: N, ResNo: 0 }) {
        if self.foldBitwiseOpWithNeg(N, DL, VT) {
            Folded;
        } else {
            return Folded;
        }
    }
    let mut Amt: APInt = APInt {};
    if sd_match(N, m_And(m_Srl(m_Value(X), m_ConstInt(Amt)), m_One(false))) && Amt.ult(BitWidth - 1) && Amt.uge(BitWidth - self.DAG.ComputeNumSignBits(X, 0)) {
        return self.DAG.getNode(SRL, DL, VT, X, self.DAG.getShiftAmountConstant(BitWidth - 1, VT, DL));
    }
    if sd_match(N, m_And(m_Sub(m_Zero(false), m_Value(X)), m_One(false))) {
        if X.getOpcode() == ZERO_EXTEND && X.getOperand(0).getScalarValueSizeInBits() == 1 {
            return X;
        }
        if X.getOpcode() == SIGN_EXTEND && X.getOperand(0).getScalarValueSizeInBits() == 1 {
            return self.DAG.getNode(ZERO_EXTEND, DL, VT, X.getOperand(0));
        }
    }
    if self.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if isUNINDEXEDLoad(N0.getNode()) && (isEXTLoad(N0.getNode()) || (isSEXTLoad(N0.getNode()) && N0.hasOneUse())) {
        let mut LN0: *mut LoadSDNode = cast(N0);
        let mut MemVT: EVT = LN0.getMemoryVT();
        let mut ExtBitSize: u32 = N1.getScalarValueSizeInBits();
        let mut MemBitSize: u32 = MemVT.getScalarSizeInBits();
        let mut ExtBits: APInt = getHighBitsSet(ExtBitSize, ExtBitSize - MemBitSize);
        if self.DAG.MaskedValueIsZero(N1, ExtBits, 0) && ((!self.LegalOperations && LN0.isSimple()) || self.TLI.isLoadLegal(VT, MemVT, LN0.getAlign(), LN0.getAddressSpace(), ZEXTLOAD, false)) {
            let mut ExtLoad: SDValue = self.DAG.getExtLoad(ZEXTLOAD, SDLoc { N0 }, VT, LN0.getChain(), LN0.getBasePtr(), MemVT, LN0.getMemOperand());
            self.AddToWorklist(N, true, false);
            self.CombineTo(N0.getNode(), ExtLoad, ExtLoad.getValue(1), true);
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    if N1C && N1C.getAPIntValue() == 65535 && N0.getOpcode() == OR {
        if self.MatchBSwapHWordLow(N0.getNode(), N0.getOperand(0), N0.getOperand(1), false) {
            BSwap;
        } else {
            return BSwap;
        }
    }
    if self.unfoldExtremeBitClearingToShifts(N) {
        Shifts;
    } else {
        return Shifts;
    }
    if combineShiftAnd1ToBitTest(N, self.DAG) {
        V;
    } else {
        return V;
    }
    let mut IsAndZeroExtMask: Closure_18 = Closure_18 {};
    if IsAndZeroExtMask.call(N0, N1) && (!self.LegalOperations || self.TLI.isOperationLegal(ZERO_EXTEND, VT)) {
        return self.DAG.getNode(ZERO_EXTEND, DL, VT, N0.getOperand(0));
    }
    if self.hasOperation(USUBSAT, VT) {
        if foldAndToUsubsat(N, self.DAG, DL) {
            V;
        } else {
            return V;
        }
    }
    if self.LegalOperations || VT.isVector() {
        if foldLogicTreeOfShifts(N, N0, N1, self.DAG) {
            R;
        } else {
            return R;
        }
    }
    if VT.isScalarInteger() && VT != EVT { i1 } {
        if foldMaskedMerge(N, self.DAG, self.TLI, DL) {
            R;
        } else {
            return R;
        }
    }
    return SDValue {};
}

fn DAGCombiner::MatchBSwapHWordLow(self, N: *mut SDNode, N0: SDValue, N1: SDValue, DemandHighBits: bool) -> SDValue {
    if !self.LegalOperations {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    if VT != EVT { i64 } && VT != EVT { i32 } && VT != EVT { i16 } {
        return SDValue {};
    }
    if !self.TLI.isOperationLegalOrCustom(BSWAP, VT, false) {
        return SDValue {};
    }
    let mut LookPassAnd0: bool = false;
    let mut LookPassAnd1: bool = false;
    if N0.getOpcode() == AND && N0.getOperand(0).getOpcode() == SRL {
        swap(N0, N1);
    }
    if N1.getOpcode() == AND && N1.getOperand(0).getOpcode() == SHL {
        swap(N0, N1);
    }
    if N0.getOpcode() == AND {
        if !operator(N0).hasOneUse() {
            return SDValue {};
        }
        let mut N01C: *mut ConstantSDNode = dyn_cast(N0.getOperand(1));
        if !N01C || (N01C.getZExtValue() != 65280 && N01C.getZExtValue() != 65535) {
            return SDValue {};
        }
        N0 = N0.getOperand(0);
        LookPassAnd0 = true;
    }
    if N1.getOpcode() == AND {
        if !operator(N1).hasOneUse() {
            return SDValue {};
        }
        let mut N11C: *mut ConstantSDNode = dyn_cast(N1.getOperand(1));
        if !N11C || N11C.getZExtValue() != 255 {
            return SDValue {};
        }
        N1 = N1.getOperand(0);
        LookPassAnd1 = true;
    }
    if N0.getOpcode() == SRL && N1.getOpcode() == SHL {
        swap(N0, N1);
    }
    if N0.getOpcode() != SHL || N1.getOpcode() != SRL {
        return SDValue {};
    }
    if !operator(N0).hasOneUse() || !operator(N1).hasOneUse() {
        return SDValue {};
    }
    let mut N01C: *mut ConstantSDNode = dyn_cast(N0.getOperand(1));
    let mut N11C: *mut ConstantSDNode = dyn_cast(N1.getOperand(1));
    if !N01C || !N11C {
        return SDValue {};
    }
    if N01C.getZExtValue() != 8 || N11C.getZExtValue() != 8 {
        return SDValue {};
    }
    let mut N00: SDValue = operator(N0).getOperand(0);
    if !LookPassAnd0 && N00.getOpcode() == AND {
        if !operator(N00).hasOneUse() {
            return SDValue {};
        }
        let mut N001C: *mut ConstantSDNode = dyn_cast(N00.getOperand(1));
        if !N001C || N001C.getZExtValue() != 255 {
            return SDValue {};
        }
        N00 = N00.getOperand(0);
        LookPassAnd0 = true;
    }
    let mut N10: SDValue = operator(N1).getOperand(0);
    if !LookPassAnd1 && N10.getOpcode() == AND {
        if !operator(N10).hasOneUse() {
            return SDValue {};
        }
        let mut N101C: *mut ConstantSDNode = dyn_cast(N10.getOperand(1));
        if !N101C || (N101C.getZExtValue() != 65280 && N101C.getZExtValue() != 65535) {
            return SDValue {};
        }
        N10 = N10.getOperand(0);
        LookPassAnd1 = true;
    }
    if N00 != N10 {
        return SDValue {};
    }
    let mut OpSizeInBits: u32 = VT.getSizeInBits().operator unsigned long long();
    if OpSizeInBits > 16 {
        if DemandHighBits && !LookPassAnd0 {
            return SDValue {};
        }
        if !LookPassAnd1 {
            let mut HighBit: u32 = if DemandHighBits { OpSizeInBits } else { 24 };
            if !self.DAG.MaskedValueIsZero(N10, getBitsSet(OpSizeInBits, 16, HighBit), 0) {
                return SDValue {};
            }
        }
    }
    let mut Res: SDValue = self.DAG.getNode(BSWAP, SDLoc { N }, VT, N00);
    if OpSizeInBits > 16 {
        let mut DL: SDLoc = SDLoc { N };
        Res = self.DAG.getNode(SRL, DL, VT, Res, self.DAG.getShiftAmountConstant(OpSizeInBits - 16, VT, DL));
    }
    return Res;
}

fn isBSwapHWordElement(N: SDValue, Parts: MutableArrayRef<SDNode *>) -> bool {
    if !operator(N).hasOneUse() {
        return false;
    }
    let mut Opc: u32 = N.getOpcode();
    if Opc != AND && Opc != SHL && Opc != SRL {
        return false;
    }
    let mut N0: SDValue = N.getOperand(0);
    let mut Opc0: u32 = N0.getOpcode();
    if Opc0 != AND && Opc0 != SHL && Opc0 != SRL {
        return false;
    }
    let mut N1C: *mut ConstantSDNode = null;
    if Opc == AND {
        N1C = dyn_cast(N.getOperand(1));
    } else if Opc0 == AND {
        N1C = dyn_cast(N0.getOperand(1));
    }
    if !N1C {
        return false;
    }
    let mut MaskByteOffset: u32 = 0;
    match N1C.getZExtValue() {
        _ => {
            return false;
        },
        255 => {
            MaskByteOffset = 0;
        },
        65280 => {
            MaskByteOffset = 1;
        },
        65535 => {
            if Opc == SRL || (Opc == AND && Opc0 == SHL) {
                MaskByteOffset = 1;
                break;
            }
        },
        16711680 => {
            MaskByteOffset = 2;
        },
        4278190080 => {
            MaskByteOffset = 3;
        },
    }
    if Opc == AND {
        if MaskByteOffset == 0 || MaskByteOffset == 2 {
            if Opc0 != SRL {
                return false;
            }
            let mut C: *mut ConstantSDNode = dyn_cast(N0.getOperand(1));
            if !C || C.getZExtValue() != 8 {
                return false;
            }
        } else {
            if Opc0 != SHL {
                return false;
            }
            let mut C: *mut ConstantSDNode = dyn_cast(N0.getOperand(1));
            if !C || C.getZExtValue() != 8 {
                return false;
            }
        }
    } else if Opc == SHL {
        if MaskByteOffset != 0 && MaskByteOffset != 2 {
            return false;
        }
        let mut C: *mut ConstantSDNode = dyn_cast(N.getOperand(1));
        if !C || C.getZExtValue() != 8 {
            return false;
        }
    } else {
        if MaskByteOffset != 1 && MaskByteOffset != 3 {
            return false;
        }
        let mut C: *mut ConstantSDNode = dyn_cast(N.getOperand(1));
        if !C || C.getZExtValue() != 8 {
            return false;
        }
    }
    if Parts[MaskByteOffset] {
        return false;
    }
    Parts[MaskByteOffset] = N0.getOperand(0).getNode();
    return true;
}

fn isBSwapHWordPair(N: SDValue, Parts: MutableArrayRef<SDNode *>) -> bool {
    if N.getOpcode() == OR {
        return isBSwapHWordElement(N.getOperand(0), Parts) && isBSwapHWordElement(N.getOperand(1), Parts);
    }
    if N.getOpcode() == SRL && N.getOperand(0).getOpcode() == BSWAP {
        let mut C: *mut ConstantSDNode = isConstOrConstSplat(N.getOperand(1), false, false);
        if !C || C.getAPIntValue() != 16 {
            return false;
        }
        Parts[0] = Parts[1] = N.getOperand(0).getOperand(0).getNode();
        return true;
    }
    return false;
}

fn matchBSwapHWordOrAndAnd(TLI: *TargetLowering, DAG: *mut SelectionDAG, N: *mut SDNode, N0: SDValue, N1: SDValue, VT: EVT) -> SDValue {
    assert!(N.getOpcode() == OR && VT == EVT { i32 }, "MatchBSwapHWordOrAndAnd: expecting i32");
    if !TLI.isOperationLegalOrCustom(ROTR, VT, false) {
        return SDValue {};
    }
    if N0.getOpcode() != AND || N1.getOpcode() != AND {
        return SDValue {};
    }
    if !operator(N0).hasOneUse() || !operator(N1).hasOneUse() {
        return SDValue {};
    }
    let mut Mask0: *mut ConstantSDNode = isConstOrConstSplat(N0.getOperand(1), false, false);
    let mut Mask1: *mut ConstantSDNode = isConstOrConstSplat(N1.getOperand(1), false, false);
    if !Mask0 || !Mask1 {
        return SDValue {};
    }
    if Mask0.getAPIntValue() != 4278255360 || Mask1.getAPIntValue() != 16711935 {
        return SDValue {};
    }
    let mut Shift0: SDValue = N0.getOperand(0);
    let mut Shift1: SDValue = N1.getOperand(0);
    if Shift0.getOpcode() != SHL || Shift1.getOpcode() != SRL {
        return SDValue {};
    }
    let mut ShiftAmt0: *mut ConstantSDNode = isConstOrConstSplat(Shift0.getOperand(1), false, false);
    let mut ShiftAmt1: *mut ConstantSDNode = isConstOrConstSplat(Shift1.getOperand(1), false, false);
    if !ShiftAmt0 || !ShiftAmt1 {
        return SDValue {};
    }
    if ShiftAmt0.getAPIntValue() != 8 || ShiftAmt1.getAPIntValue() != 8 {
        return SDValue {};
    }
    if Shift0.getOperand(0) != Shift1.getOperand(0) {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { N };
    let mut BSwap: SDValue = DAG.getNode(BSWAP, DL, VT, Shift0.getOperand(0));
    let mut ShAmt: SDValue = DAG.getShiftAmountConstant(16, VT, DL);
    return DAG.getNode(ROTR, DL, VT, BSwap, ShAmt);
}

fn DAGCombiner::MatchBSwapHWord(self, N: *mut SDNode, N0: SDValue, N1: SDValue) -> SDValue {
    if !self.LegalOperations {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    if VT != EVT { i32 } {
        return SDValue {};
    }
    if !self.TLI.isOperationLegalOrCustom(BSWAP, VT, false) {
        return SDValue {};
    }
    if matchBSwapHWordOrAndAnd(self.TLI, self.DAG, N, N0, N1, VT) {
        BSwap;
    } else {
        return BSwap;
    }
    if matchBSwapHWordOrAndAnd(self.TLI, self.DAG, N, N1, N0, VT) {
        BSwap;
    } else {
        return BSwap;
    }
    let mut Parts: [4]*mut SDNode = [4]*mut SDNode {};
    if isBSwapHWordPair(N0, MutableArrayRef<SDNode *> { Parts }) {
        if !isBSwapHWordPair(N1, MutableArrayRef<SDNode *> { Parts }) {
            return SDValue {};
        }
    } else if N0.getOpcode() == OR {
        if !isBSwapHWordElement(N1, MutableArrayRef<SDNode *> { Parts }) {
            return SDValue {};
        }
        let mut N00: SDValue = N0.getOperand(0);
        let mut N01: SDValue = N0.getOperand(1);
        if !(isBSwapHWordElement(N01, MutableArrayRef<SDNode *> { Parts }) && isBSwapHWordPair(N00, MutableArrayRef<SDNode *> { Parts })) && !(isBSwapHWordElement(N00, MutableArrayRef<SDNode *> { Parts }) && isBSwapHWordPair(N01, MutableArrayRef<SDNode *> { Parts })) {
            return SDValue {};
        }
    } else {
        return SDValue {};
    }
    if Parts[0] != Parts[1] || Parts[0] != Parts[2] || Parts[0] != Parts[3] {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { N };
    let mut BSwap: SDValue = self.DAG.getNode(BSWAP, DL, VT, SDValue { Node: Parts[0], ResNo: 0 });
    let mut ShAmt: SDValue = self.DAG.getShiftAmountConstant(16, VT, DL);
    if self.TLI.isOperationLegalOrCustom(ROTL, VT, false) {
        return self.DAG.getNode(ROTL, DL, VT, BSwap, ShAmt);
    }
    if self.TLI.isOperationLegalOrCustom(ROTR, VT, false) {
        return self.DAG.getNode(ROTR, DL, VT, BSwap, ShAmt);
    }
    return self.DAG.getNode(OR, DL, VT, self.DAG.getNode(SHL, DL, VT, BSwap, ShAmt), self.DAG.getNode(SRL, DL, VT, BSwap, ShAmt));
}

fn DAGCombiner::visitORLike(self, N0: SDValue, N1: SDValue, DL: *SDLoc) -> SDValue {
    let mut VT: EVT = N1.getValueType();
    if !self.LegalOperations && (N0.isUndef() || N1.isUndef()) {
        return self.DAG.getAllOnesConstant(DL, VT, false, false);
    }
    if self.foldLogicOfSetCCs(false, N0, N1, DL) {
        V;
    } else {
        return V;
    }
    if N0.getOpcode() == AND && N1.getOpcode() == AND && (operator(N0).hasOneUse() || operator(N1).hasOneUse()) {
        if getAsNonOpaqueConstant(N0.getOperand(1)) {
            N0O1C;
        } else {
            if getAsNonOpaqueConstant(N1.getOperand(1)) {
                N1O1C;
            } else {
                let mut LHSMask: *APInt = N0O1C.getAPIntValue();
                let mut RHSMask: *APInt = N1O1C.getAPIntValue();
                if self.DAG.MaskedValueIsZero(N0.getOperand(0), RHSMask & operator(LHSMask), 0) && self.DAG.MaskedValueIsZero(N1.getOperand(0), LHSMask & operator(RHSMask), 0) {
                    let mut X: SDValue = self.DAG.getNode(OR, SDLoc { N0 }, VT, N0.getOperand(0), N1.getOperand(0));
                    return self.DAG.getNode(AND, DL, VT, X, self.DAG.getConstant(LHSMask | RHSMask, DL, VT, false, false));
                }
            }
        }
    }
    if N0.getOpcode() == AND && N1.getOpcode() == AND && N0.getOperand(0) == N1.getOperand(0) && (operator(N0).hasOneUse() || operator(N1).hasOneUse()) {
        let mut X: SDValue = self.DAG.getNode(OR, SDLoc { N0 }, VT, N0.getOperand(1), N1.getOperand(1));
        return self.DAG.getNode(AND, DL, VT, N0.getOperand(0), X);
    }
    return SDValue {};
}

fn visitORCommutative(DAG: *mut SelectionDAG, N0: SDValue, N1: SDValue, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N0.getValueType();
    let mut BW: u32 = VT.getScalarSizeInBits();
    let mut DL: SDLoc = SDLoc { N };
    let mut peekThroughResize: Closure_19 = Closure_19 {};
    let mut N0Resized: SDValue = peekThroughResize.call(N0);
    if N0Resized.getOpcode() == AND {
        let mut N1Resized: SDValue = peekThroughResize.call(N1);
        let mut N00: SDValue = N0Resized.getOperand(0);
        let mut N01: SDValue = N0Resized.getOperand(1);
        if N00 == N1Resized || N01 == N1Resized {
            return N1;
        }
        if getBitwiseNotOperand(N01, N00, false) {
            NotOperand;
        } else {
            if peekThroughResize.call(NotOperand) == N1Resized {
                return DAG.getNode(OR, DL, VT, DAG.getZExtOrTrunc(N00, DL, VT), N1);
            }
        }
        if getBitwiseNotOperand(N00, N01, false) {
            NotOperand;
        } else {
            if peekThroughResize.call(NotOperand) == N1Resized {
                return DAG.getNode(OR, DL, VT, DAG.getZExtOrTrunc(N01, DL, VT), N1);
            }
        }
    }
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    if sd_match(N0, m_Xor(m_Value(X), m_Specific(N1))) {
        return DAG.getNode(OR, DL, VT, X, N1);
    }
    if sd_match(N0, m_Xor(m_Value(X), m_Value(Y))) && (sd_match(N1, m_And(m_Specific(X), m_Specific(Y))) || sd_match(N1, m_Or(m_Specific(X), m_Specific(Y)))) {
        return DAG.getNode(OR, DL, VT, X, Y);
    }
    if foldLogicOfShifts(N, N0, N1, DAG) {
        R;
    } else {
        return R;
    }
    let mut peekThroughZext: Closure_20 = Closure_20 {};
    if N0.getOpcode() == FSHL && N1.getOpcode() == SHL && peekThroughZext.call(N0.getOperand(2)) == peekThroughZext.call(N1.getOperand(1)) {
        if N0.getOperand(0) == N1.getOperand(0) {
            return N0;
        }
        if N0.getOperand(1) == N1.getOperand(0) && N0.hasOneUse() && N1.hasOneUse() {
            let mut A: SDValue = N0.getOperand(0);
            let mut X: SDValue = N1.getOperand(0);
            let mut NewLHS: SDValue = DAG.getNode(OR, DL, VT, A, X);
            return DAG.getNode(FSHL, DL, VT, NewLHS, X, N0.getOperand(2));
        }
    }
    if N0.getOpcode() == FSHR && N1.getOpcode() == SRL && peekThroughZext.call(N0.getOperand(2)) == peekThroughZext.call(N1.getOperand(1)) {
        if N0.getOperand(1) == N1.getOperand(0) {
            return N0;
        }
        if N0.getOperand(0) == N1.getOperand(0) && N0.hasOneUse() && N1.hasOneUse() {
            let mut X: SDValue = N1.getOperand(0);
            let mut B: SDValue = N0.getOperand(1);
            let mut NewRHS: SDValue = DAG.getNode(OR, DL, VT, X, B);
            return DAG.getNode(FSHR, DL, VT, X, NewRHS, N0.getOperand(2));
        }
    }
    if N0.getOpcode() == FSHL && N1.getOpcode() == FSHR && N0.hasOneUse() && N1.hasOneUse() {
        let mut S0: *mut ConstantSDNode = dyn_cast(N0.getOperand(2));
        let mut S1: *mut ConstantSDNode = dyn_cast(N1.getOperand(2));
        if S0 && S1 && S0.getZExtValue() < BW && S1.getZExtValue() < BW && S0.getZExtValue() == (BW - S1.getZExtValue()) {
            let mut A: SDValue = N0.getOperand(0);
            let mut B: SDValue = N0.getOperand(1);
            let mut C: SDValue = N1.getOperand(0);
            let mut D: SDValue = N1.getOperand(1);
            let mut NewLHS: SDValue = DAG.getNode(OR, DL, VT, A, C);
            let mut NewRHS: SDValue = DAG.getNode(OR, DL, VT, B, D);
            return DAG.getNode(FSHL, DL, VT, NewLHS, NewRHS, N0.getOperand(2));
        }
    }
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    if sd_match(N0, m_OneUse(m_Shl(m_AnyExt(m_Value(Hi)), m_SpecificInt(BW / 2)))) && sd_match(N1, m_ZExt(m_Value(Lo))) && Lo.getScalarValueSizeInBits() == (BW / 2) && Lo.getValueType() == Hi.getValueType() {
        let mut NotLo: SDValue = SDValue {};
        let mut NotHi: SDValue = SDValue {};
        if sd_match(Lo, m_OneUse(m_Not(m_Value(NotLo)))) && sd_match(Hi, m_OneUse(m_Not(m_Value(NotHi)))) {
            Lo = DAG.getNode(ZERO_EXTEND, DL, VT, NotLo);
            Hi = DAG.getNode(ANY_EXTEND, DL, VT, NotHi);
            Hi = DAG.getNode(SHL, DL, VT, Hi, DAG.getShiftAmountConstant(BW / 2, VT, DL));
            return DAG.getNOT(DL, DAG.getNode(OR, DL, VT, Lo, Hi), VT);
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitOR(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N1.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    if N0 == N1 {
        return N0;
    }
    if self.DAG.FoldConstantArithmetic(OR, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if self.DAG.isConstantIntBuildVectorOrConstantInt(N0, true) && !self.DAG.isConstantIntBuildVectorOrConstantInt(N1, true) {
        return self.DAG.getNode(OR, DL, VT, N1, N0);
    }
    if VT.isVector() {
        if self.SimplifyVBinOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
        if isConstantSplatVectorAllZeros(N1.getNode(), false) {
            return N0;
        }
        if isConstantSplatVectorAllOnes(N1.getNode(), false) {
            return self.DAG.getAllOnesConstant(DL, N1.getValueType(), false, false);
        }
        let mut BV0: *mut BuildVectorSDNode = dyn_cast(N0);
        let mut BV1: *mut BuildVectorSDNode = dyn_cast(N1);
        if BV0 && BV1 && !BV0.getSplatValue(null) && !BV1.getSplatValue(null) && N0.hasOneUse() && N1.hasOneUse() && BV0.getOperand(0).getValueType() == BV1.getOperand(0).getValueType() {
            let mut MergedOps: SmallVector<SDValue> = SmallVector<SDValue> {};
            let mut NumElts: u32 = VT.getVectorNumElements();
            let mut EltVT: EVT = BV0.getOperand(0).getValueType();
            for let mut I: u32 = 0; I != NumElts; I += 1 {
                let mut C0: *mut ConstantSDNode = dyn_cast(BV0.getOperand(I));
                let mut C1: *mut ConstantSDNode = dyn_cast(BV1.getOperand(I));
                if C0 && C1 {
                    MergedOps.push(self.DAG.getConstant(C0.getAPIntValue() | C1.getAPIntValue(), DL, EltVT, false, false));
                } else if C0 && C0.isZero() {
                    MergedOps.push(ValueParamT { BV1.getOperand(I) });
                } else if C1 && C1.isZero() {
                    MergedOps.push(ValueParamT { BV0.getOperand(I) });
                } else if C0 && C0.isAllOnes() {
                    MergedOps.push(ValueParamT { BV0.getOperand(I) });
                } else if C1 && C1.isAllOnes() {
                    MergedOps.push(ValueParamT { BV1.getOperand(I) });
                } else if BV0.getOperand(I) == BV1.getOperand(I) {
                    MergedOps.push(ValueParamT { BV0.getOperand(I) });
                } else {
                    break;
                }
            }
            if MergedOps.len == NumElts {
                return self.DAG.getBuildVector(VT, DL, ArrayRef<SDValue> { MergedOps });
            }
        }
        let mut SV0: *mut ShuffleVectorSDNode = dyn_cast(N0);
        let mut SV1: *mut ShuffleVectorSDNode = dyn_cast(N1);
        if SV0 && SV1 && self.TLI.isTypeLegal(VT) {
            let mut ZeroN00: bool = isBuildVectorAllZeros(N0.getOperand(0).getNode());
            let mut ZeroN01: bool = isBuildVectorAllZeros(N0.getOperand(1).getNode());
            let mut ZeroN10: bool = isBuildVectorAllZeros(N1.getOperand(0).getNode());
            let mut ZeroN11: bool = isBuildVectorAllZeros(N1.getOperand(1).getNode());
            if (ZeroN00 != ZeroN01) && (ZeroN10 != ZeroN11) {
                assert!((!ZeroN00 || !ZeroN01), "Both inputs zero!");
                assert!((!ZeroN10 || !ZeroN11), "Both inputs zero!");
                let mut CanFold: bool = true;
                let mut NumElts: i32 = VT.getVectorNumElements();
                let mut Mask: SmallVector<int, 4> = SmallVector<int, 4> { NumElts, -1 };
                for let mut i: i32 = 0; i != NumElts; i += 1 {
                    let mut M0: i32 = SV0.getMaskElt(i);
                    let mut M1: i32 = SV1.getMaskElt(i);
                    let mut M0Zero: bool = M0 < 0 || (ZeroN00 == (M0 < NumElts));
                    let mut M1Zero: bool = M1 < 0 || (ZeroN10 == (M1 < NumElts));
                    if (M0Zero && M1 < 0) || (M1Zero && M0 < 0) {
                        continue;
                    }
                    if M0Zero == M1Zero {
                        CanFold = false;
                        break;
                    }
                    assert!((M0 >= 0 || M1 >= 0), "Undef index!");
                    Mask[i] = if M1Zero { M0 % NumElts } else { (M1 % NumElts) + NumElts };
                }
                if CanFold {
                    let mut NewLHS: SDValue = if ZeroN00 { N0.getOperand(1) } else { N0.getOperand(0) };
                    let mut NewRHS: SDValue = if ZeroN10 { N1.getOperand(1) } else { N1.getOperand(0) };
                    let mut LegalShuffle: SDValue = self.TLI.buildLegalVectorShuffle(VT, DL, NewLHS, NewRHS, MutableArrayRef<int> { Mask }, self.DAG);
                    if LegalShuffle {
                        return LegalShuffle;
                    }
                }
            }
        }
    }
    if isNullConstant(N1) {
        return N0;
    }
    if isAllOnesConstant(N1) {
        return N1;
    }
    if self.foldBinOpIntoSelect(N) {
        NewSel;
    } else {
        return NewSel;
    }
    let mut N1C: *mut ConstantSDNode = dyn_cast(N1);
    if N1C && self.DAG.MaskedValueIsZero(N0, operator(N1C.getAPIntValue()), 0) {
        return N1;
    }
    if foldAndOrOfSETCC(N, self.DAG) {
        R;
    } else {
        return R;
    }
    if self.visitORLike(N0, N1, DL) {
        Combined;
    } else {
        return Combined;
    }
    if combineCarryDiamond(self.DAG, self.TLI, N0, N1, N) {
        Combined;
    } else {
        return Combined;
    }
    if combineOrOfSetCCToUSUBOCarry(N, self.DAG, self.TLI) {
        Combined;
    } else {
        return Combined;
    }
    if self.MatchBSwapHWord(N, N0, N1) {
        BSwap;
    } else {
        return BSwap;
    }
    if self.MatchBSwapHWordLow(N, N0, N1, true) {
        BSwap;
    } else {
        return BSwap;
    }
    if self.reassociateOps(OR, DL, N0, N1, N.getFlags()) {
        ROR;
    } else {
        return ROR;
    }
    if self.reassociateReduction(VECREDUCE_OR, OR, DL, VT, N0, N1, SDNodeFlags { Flags: None }) {
        SD;
    } else {
        return SD;
    }
    let mut MatchIntersect: Closure_21 = Closure_21 {};
    if N0.getOpcode() == AND && operator(N0).hasOneUse() && matchBinaryPredicate(N0.getOperand(1), N1, function<bool (ConstantSDNode *, ConstantSDNode *)> { MatchIntersect }, true, false) {
        if self.DAG.FoldConstantArithmetic(OR, SDLoc { N1 }, VT, ArrayRef<SDValue> { [N1, N0.getOperand(1)] }, SDNodeFlags { Flags: None }) {
            COR;
        } else {
            let mut IOR: SDValue = self.DAG.getNode(OR, SDLoc { N0 }, VT, N0.getOperand(0), N1);
            self.AddToWorklist(IOR.getNode(), true, false);
            return self.DAG.getNode(AND, DL, VT, COR, IOR);
        }
    }
    if visitORCommutative(self.DAG, N0, N1, N) {
        Combined;
    } else {
        return Combined;
    }
    if visitORCommutative(self.DAG, N1, N0, N) {
        Combined;
    } else {
        return Combined;
    }
    if N0.getOpcode() == N1.getOpcode() {
        if self.hoistLogicOpWithSameOpcodeHands(N) {
            V;
        } else {
            return V;
        }
    }
    if self.MatchRotate(N0, N1, DL, false) {
        Rot;
    } else {
        return Rot;
    }
    if self.MatchLoadCombine(N) {
        Load;
    } else {
        return Load;
    }
    if self.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if (!self.LegalOperations || self.TLI.isOperationLegal(ADD, VT)) && self.DAG.isADDLike(SDValue { Node: N, ResNo: 0 }, false) {
        if self.visitADDLike(N) {
            Combined;
        } else {
            return Combined;
        }
    }
    if self.LegalOperations || VT.isVector() {
        if foldLogicTreeOfShifts(N, N0, N1, self.DAG) {
            R;
        } else {
            return R;
        }
    }
    if VT.isScalarInteger() && VT != EVT { i1 } {
        if foldMaskedMerge(N, self.DAG, self.TLI, DL) {
            R;
        } else {
            return R;
        }
    }
    return SDValue {};
}

fn stripConstantMask(DAG: *SelectionDAG, Op: SDValue, Mask: *mut SDValue) -> SDValue {
    if Op.getOpcode() == AND && DAG.isConstantIntBuildVectorOrConstantInt(Op.getOperand(1), true) {
        Mask = Op.getOperand(1);
        return Op.getOperand(0);
    }
    return Op;
}

fn matchRotateHalf(DAG: *SelectionDAG, Op: SDValue, Shift: *mut SDValue, Mask: *mut SDValue) -> bool {
    Op = stripConstantMask(DAG, Op, Mask);
    if Op.getOpcode() == SRL || Op.getOpcode() == SHL {
        Shift = Op;
        return true;
    }
    return false;
}

fn extractShiftForRotate(DAG: *mut SelectionDAG, OppShift: SDValue, ExtractFrom: SDValue, Mask: *mut SDValue, DL: *SDLoc) -> SDValue {
    assert!(OppShift && ExtractFrom, "Empty SDValue");
    if OppShift.getOpcode() != SHL && OppShift.getOpcode() != SRL {
        return SDValue {};
    }
    ExtractFrom = stripConstantMask(DAG, ExtractFrom, Mask);
    let mut OppShiftLHS: SDValue = OppShift.getOperand(0);
    let mut ShiftedVT: EVT = OppShiftLHS.getValueType();
    let mut OppShiftCst: *mut ConstantSDNode = isConstOrConstSplat(OppShift.getOperand(1), false, false);
    if OppShift.getOpcode() == SRL && OppShiftCst && ExtractFrom.getOpcode() == ADD && ExtractFrom.getOperand(0) == ExtractFrom.getOperand(1) && ExtractFrom.getOperand(0) == OppShiftLHS && OppShiftCst.getAPIntValue() == ShiftedVT.getScalarSizeInBits() - 1 {
        return DAG.getNode(SHL, DL, ShiftedVT, OppShiftLHS, DAG.getShiftAmountConstant(1, ShiftedVT, DL));
    }
    let mut Opcode: u32 = DELETED_NODE;
    let mut IsMulOrDiv: bool = false;
    let mut SelectOpcode: Closure_22 = Closure_22 { IsMulOrDiv: &mut IsMulOrDiv, ExtractFrom: &mut ExtractFrom, Opcode: &mut Opcode };
    if (OppShift.getOpcode() != SRL || !SelectOpcode.call(SHL, MUL)) && (OppShift.getOpcode() != SHL || !SelectOpcode.call(SRL, UDIV)) {
        return SDValue {};
    }
    if OppShiftLHS.getOpcode() != ExtractFrom.getOpcode() || OppShiftLHS.getOperand(0) != ExtractFrom.getOperand(0) || ShiftedVT != ExtractFrom.getValueType() {
        return SDValue {};
    }
    let mut OppLHSCst: *mut ConstantSDNode = isConstOrConstSplat(OppShiftLHS.getOperand(1), false, false);
    let mut ExtractFromCst: *mut ConstantSDNode = isConstOrConstSplat(ExtractFrom.getOperand(1), false, false);
    if !OppShiftCst || operator(OppShiftCst.getAPIntValue()) || !OppLHSCst || operator(OppLHSCst.getAPIntValue()) || !ExtractFromCst || operator(ExtractFromCst.getAPIntValue()) {
        return SDValue {};
    }
    let mut VTWidth: u32 = ShiftedVT.getScalarSizeInBits();
    if OppShiftCst.getAPIntValue().ugt(VTWidth) {
        return SDValue {};
    }
    let mut NeededShiftAmt: APInt = VTWidth - OppShiftCst.getAPIntValue();
    let mut ExtractFromAmt: APInt = ExtractFromCst.getAPIntValue();
    let mut OppLHSAmt: APInt = OppLHSCst.getAPIntValue();
    zeroExtendToMatch(ExtractFromAmt, OppLHSAmt, 0);
    if IsMulOrDiv {
        let mut ExtractDiv: APInt = getOneBitSet(ExtractFromAmt.getBitWidth(), NeededShiftAmt.getZExtValue());
        let mut ResultAmt: APInt = APInt {};
        let mut Rem: APInt = APInt {};
        udivrem(ExtractFromAmt, ExtractDiv, ResultAmt, Rem);
        if Rem != 0 || ResultAmt != OppLHSAmt {
            return SDValue {};
        }
    } else {
        if OppLHSAmt != ExtractFromAmt - NeededShiftAmt.zextOrTrunc(ExtractFromAmt.getBitWidth()) {
            return SDValue {};
        }
    }
    let mut ShiftVT: EVT = OppShift.getOperand(1).getValueType();
    let mut ResVT: EVT = ExtractFrom.getValueType();
    let mut NewShiftNode: SDValue = DAG.getConstant(NeededShiftAmt, DL, ShiftVT, false, false);
    return DAG.getNode(Opcode, DL, ResVT, OppShiftLHS, NewShiftNode);
}

fn matchRotateSub(Pos: SDValue, Neg: SDValue, EltSize: u32, DAG: *mut SelectionDAG, IsRotate: bool, FromAdd: bool) -> bool {
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut MaskLoBits: u32 = 0;
    if IsRotate && !FromAdd && isPowerOf2_64(EltSize) {
        let mut Bits: u32 = Log2_64(EltSize);
        let mut NegBits: u32 = Neg.getScalarValueSizeInBits();
        if NegBits >= Bits {
            let mut DemandedBits: APInt = getLowBitsSet(NegBits, Bits);
            if TLI.SimplifyMultipleUseDemandedBits(Neg, DemandedBits, DAG, 0) {
                Inner;
            } else {
                Neg = Inner;
                MaskLoBits = Bits;
            }
        }
    }
    if Neg.getOpcode() != SUB {
        return false;
    }
    let mut NegC: *mut ConstantSDNode = isConstOrConstSplat(Neg.getOperand(0), false, false);
    if !NegC {
        return false;
    }
    let mut NegOp1: SDValue = Neg.getOperand(1);
    if MaskLoBits {
        let mut PosBits: u32 = Pos.getScalarValueSizeInBits();
        if PosBits >= MaskLoBits {
            let mut DemandedBits: APInt = getLowBitsSet(PosBits, MaskLoBits);
            if TLI.SimplifyMultipleUseDemandedBits(Pos, DemandedBits, DAG, 0) {
                Inner;
            } else {
                Pos = Inner;
            }
        }
    }
    let mut Width: APInt = APInt {};
    if (Pos == NegOp1) || (NegOp1.getOpcode() == TRUNCATE && Pos == NegOp1.getOperand(0)) {
        Width = NegC.getAPIntValue();
    } else if Pos.getOpcode() == ADD && Pos.getOperand(0) == NegOp1 {
        if isConstOrConstSplat(Pos.getOperand(1), false, false) {
            PosC;
        } else {
            Width = PosC.getAPIntValue() + NegC.getAPIntValue();
        }
    } else {
        return false;
    }
    if MaskLoBits {
        return Width.getLoBits(MaskLoBits) == 0;
    }
    return Width == EltSize;
}

fn DAGCombiner::MatchRotatePosNeg(self, Shifted: SDValue, Pos: SDValue, Neg: SDValue, InnerPos: SDValue, InnerNeg: SDValue, FromAdd: bool, HasPos: bool, PosOpcode: u32, NegOpcode: u32, DL: *SDLoc) -> SDValue {
    let mut VT: EVT = Shifted.getValueType();
    if matchRotateSub(InnerPos, InnerNeg, VT.getScalarSizeInBits(), self.DAG, true, FromAdd) {
        return self.DAG.getNode(if HasPos { PosOpcode } else { NegOpcode }, DL, VT, Shifted, if HasPos { Pos } else { Neg });
    }
    return SDValue {};
}

fn DAGCombiner::MatchFunnelPosNeg(self, N0: SDValue, N1: SDValue, Pos: SDValue, Neg: SDValue, InnerPos: SDValue, InnerNeg: SDValue, FromAdd: bool, HasPos: bool, PosOpcode: u32, NegOpcode: u32, DL: *SDLoc) -> SDValue {
    let mut VT: EVT = N0.getValueType();
    let mut EltBits: u32 = VT.getScalarSizeInBits();
    if matchRotateSub(InnerPos, InnerNeg, EltBits, self.DAG, N0 == N1, FromAdd) {
        return self.DAG.getNode(if HasPos { PosOpcode } else { NegOpcode }, DL, VT, N0, N1, if HasPos { Pos } else { Neg });
    }
    if PosOpcode == FSHL && isPowerOf2_32(EltBits) {
        let mut X: SDValue = SDValue {};
        if sd_match(N1, m_Srl(m_Value(X), m_One(false))) && sd_match(InnerNeg, m_Xor(m_Specific(InnerPos), m_SpecificInt(EltBits - 1))) && self.TLI.isOperationLegalOrCustom(FSHL, VT, false) {
            return self.DAG.getNode(FSHL, DL, VT, N0, X, Pos);
        }
        if sd_match(N0, m_Shl(m_Value(X), m_One(false))) && sd_match(InnerPos, m_Xor(m_Specific(InnerNeg), m_SpecificInt(EltBits - 1))) && self.TLI.isOperationLegalOrCustom(FSHR, VT, false) {
            return self.DAG.getNode(FSHR, DL, VT, X, N1, Neg);
        }
        if sd_match(N0, m_Add(m_Value(X), m_Deferred(X))) && sd_match(InnerPos, m_Xor(m_Specific(InnerNeg), m_SpecificInt(EltBits - 1))) && self.TLI.isOperationLegalOrCustom(FSHR, VT, false) {
            return self.DAG.getNode(FSHR, DL, VT, X, N1, Neg);
        }
    }
    return SDValue {};
}

fn DAGCombiner::MatchRotate(self, LHS: SDValue, RHS: SDValue, DL: *SDLoc, FromAdd: bool) -> SDValue {
    let mut VT: EVT = LHS.getValueType();
    let mut HasROTL: bool = self.hasOperation(ROTL, VT);
    let mut HasROTR: bool = self.hasOperation(ROTR, VT);
    let mut HasFSHL: bool = self.hasOperation(FSHL, VT);
    let mut HasFSHR: bool = self.hasOperation(FSHR, VT);
    if VT.isScalarInteger() && self.TLI.getTypeAction(*self.DAG.getContext(), VT) == TypePromoteInteger {
        HasROTL |= self.TLI.getOperationAction(ROTL, VT) == Custom;
        HasROTR |= self.TLI.getOperationAction(ROTR, VT) == Custom;
    }
    if self.LegalOperations && !HasROTL && !HasROTR && !HasFSHL && !HasFSHR {
        return SDValue {};
    }
    if LHS.getOpcode() == TRUNCATE && RHS.getOpcode() == TRUNCATE && LHS.getOperand(0).getValueType() == RHS.getOperand(0).getValueType() {
        assert!(LHS.getValueType() == RHS.getValueType());
        if self.MatchRotate(LHS.getOperand(0), RHS.getOperand(0), DL, FromAdd) {
            Rot;
        } else {
            return self.DAG.getNode(TRUNCATE, SDLoc { LHS }, LHS.getValueType(), Rot);
        }
    }
    let mut LHSShift: SDValue = SDValue {};
    let mut LHSMask: SDValue = SDValue {};
    matchRotateHalf(self.DAG, LHS, LHSShift, LHSMask);
    let mut RHSShift: SDValue = SDValue {};
    let mut RHSMask: SDValue = SDValue {};
    matchRotateHalf(self.DAG, RHS, RHSShift, RHSMask);
    if !LHSShift && !RHSShift {
        return SDValue {};
    }
    if LHSShift {
        if extractShiftForRotate(self.DAG, LHSShift, RHS, RHSMask, DL) {
            NewRHSShift;
        } else {
            RHSShift = NewRHSShift;
        }
    }
    if RHSShift {
        if extractShiftForRotate(self.DAG, RHSShift, LHS, LHSMask, DL) {
            NewLHSShift;
        } else {
            LHSShift = NewLHSShift;
        }
    }
    if !RHSShift || !LHSShift {
        return SDValue {};
    }
    if LHSShift.getOpcode() == RHSShift.getOpcode() {
        return SDValue {};
    }
    if RHSShift.getOpcode() == SHL {
        swap(LHS, RHS);
        swap(LHSShift, RHSShift);
        swap(LHSMask, RHSMask);
    }
    if LHSShift.getOpcode() != SHL || RHSShift.getOpcode() != SRL {
        return SDValue {};
    }
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    let mut LHSShiftArg: SDValue = LHSShift.getOperand(0);
    let mut LHSShiftAmt: SDValue = LHSShift.getOperand(1);
    let mut RHSShiftArg: SDValue = RHSShift.getOperand(0);
    let mut RHSShiftAmt: SDValue = RHSShift.getOperand(1);
    let mut MatchRotateSum: Closure_23 = Closure_23 { EltSizeInBits: EltSizeInBits };
    let mut ApplyMasks: Closure_24 = Closure_24 { LHSMask: &mut LHSMask, RHSMask: &mut RHSMask, cap_2: self, DL: &mut DL, VT: &mut VT, RHSShiftAmt: &mut RHSShiftAmt, LHSShiftAmt: &mut LHSShiftAmt };
    let mut IsRotate: bool = LHSShiftArg == RHSShiftArg;
    if !IsRotate && !(HasFSHL || HasFSHR) {
        if self.TLI.isTypeLegal(VT) && LHS.hasOneUse() && RHS.hasOneUse() && matchBinaryPredicate(LHSShiftAmt, RHSShiftAmt, function<bool (ConstantSDNode *, ConstantSDNode *)> { MatchRotateSum }, false, false) {
            let mut X: SDValue = SDValue {};
            let mut Y: SDValue = SDValue {};
            let mut matchOr: Closure_25 = Closure_25 { X: &mut X, Y: &mut Y };
            let mut Res: SDValue = SDValue {};
            if matchOr.call(LHSShiftArg, RHSShiftArg) {
                let mut RotX: SDValue = self.DAG.getNode(ROTL, DL, VT, X, LHSShiftAmt);
                let mut ShlY: SDValue = self.DAG.getNode(SHL, DL, VT, Y, LHSShiftAmt);
                Res = self.DAG.getNode(OR, DL, VT, RotX, ShlY);
            } else if matchOr.call(RHSShiftArg, LHSShiftArg) {
                let mut RotX: SDValue = self.DAG.getNode(ROTL, DL, VT, X, LHSShiftAmt);
                let mut SrlY: SDValue = self.DAG.getNode(SRL, DL, VT, Y, RHSShiftAmt);
                Res = self.DAG.getNode(OR, DL, VT, RotX, SrlY);
            } else {
                return SDValue {};
            }
            return ApplyMasks.call(Res);
        }
        return SDValue {};
    }
    if matchBinaryPredicate(LHSShiftAmt, RHSShiftAmt, function<bool (ConstantSDNode *, ConstantSDNode *)> { MatchRotateSum }, false, false) {
        let mut Res: SDValue = SDValue {};
        if IsRotate && (HasROTL || HasROTR || !(HasFSHL || HasFSHR)) {
            let mut UseROTL: bool = !self.LegalOperations || HasROTL;
            Res = self.DAG.getNode(if UseROTL { ROTL } else { ROTR }, DL, VT, LHSShiftArg, if UseROTL { LHSShiftAmt } else { RHSShiftAmt });
        } else {
            let mut UseFSHL: bool = !self.LegalOperations || HasFSHL;
            Res = self.DAG.getNode(if UseFSHL { FSHL } else { FSHR }, DL, VT, LHSShiftArg, RHSShiftArg, if UseFSHL { LHSShiftAmt } else { RHSShiftAmt });
        }
        return ApplyMasks.call(Res);
    }
    if !HasROTL && !HasROTR && !HasFSHL && !HasFSHR {
        return SDValue {};
    }
    if LHSMask.getNode() || RHSMask.getNode() {
        return SDValue {};
    }
    let mut LExtOp0: SDValue = LHSShiftAmt;
    let mut RExtOp0: SDValue = RHSShiftAmt;
    if (LHSShiftAmt.getOpcode() == SIGN_EXTEND || LHSShiftAmt.getOpcode() == ZERO_EXTEND || LHSShiftAmt.getOpcode() == ANY_EXTEND || LHSShiftAmt.getOpcode() == TRUNCATE) && (RHSShiftAmt.getOpcode() == SIGN_EXTEND || RHSShiftAmt.getOpcode() == ZERO_EXTEND || RHSShiftAmt.getOpcode() == ANY_EXTEND || RHSShiftAmt.getOpcode() == TRUNCATE) {
        LExtOp0 = LHSShiftAmt.getOperand(0);
        RExtOp0 = RHSShiftAmt.getOperand(0);
    }
    if IsRotate && (HasROTL || HasROTR) {
        if self.MatchRotatePosNeg(LHSShiftArg, LHSShiftAmt, RHSShiftAmt, LExtOp0, RExtOp0, FromAdd, HasROTL, ROTL, ROTR, DL) {
            TryL;
        } else {
            return TryL;
        }
        if self.MatchRotatePosNeg(RHSShiftArg, RHSShiftAmt, LHSShiftAmt, RExtOp0, LExtOp0, FromAdd, HasROTR, ROTR, ROTL, DL) {
            TryR;
        } else {
            return TryR;
        }
    }
    if self.MatchFunnelPosNeg(LHSShiftArg, RHSShiftArg, LHSShiftAmt, RHSShiftAmt, LExtOp0, RExtOp0, FromAdd, HasFSHL, FSHL, FSHR, DL) {
        TryL;
    } else {
        return TryL;
    }
    if self.MatchFunnelPosNeg(LHSShiftArg, RHSShiftArg, RHSShiftAmt, LHSShiftAmt, RExtOp0, LExtOp0, FromAdd, HasFSHR, FSHR, FSHL, DL) {
        TryR;
    } else {
        return TryR;
    }
    return SDValue {};
}

fn calculateByteProvider(Op: SDValue, Index: u32, Depth: u32, VectorIndex: optional<uint64_t>, StartingIndex: u32, ByteMask: MutableArrayRef<uint8_t>) -> optional<SDByteProvider> {
    if Depth == 10 {
        return optional<SDByteProvider> { nullopt };
    }
    if Depth && !Op.hasOneUse() && (Op.getOpcode() != LOAD || !Op.getValueType().isVector()) {
        return optional<SDByteProvider> { nullopt };
    }
    if Op.getOpcode() != LOAD && VectorIndex.has_value() {
        return optional<SDByteProvider> { nullopt };
    }
    let mut BitWidth: u32 = Op.getScalarValueSizeInBits();
    if BitWidth % 8 != 0 {
        return optional<SDByteProvider> { nullopt };
    }
    let mut ByteWidth: u32 = BitWidth / 8;
    assert!(Index < ByteWidth, "invalid index requested");
    ByteWidth as void;
    match Op.getOpcode() {
        OR => {
            let mut LHS: optional<SDByteProvider> = calculateByteProvider(operator(Op).getOperand(0), Index, Depth + 1, optional<uint64_t> { VectorIndex }, StartingIndex, ByteMask);
            if !LHS {
                return optional<SDByteProvider> { nullopt };
            }
            let mut RHS: optional<SDByteProvider> = calculateByteProvider(operator(Op).getOperand(1), Index, Depth + 1, optional<uint64_t> { VectorIndex }, StartingIndex, ByteMask);
            if !RHS {
                return optional<SDByteProvider> { nullopt };
            }
            if operator(LHS).isConstantZero() {
                return RHS;
            }
            if operator(RHS).isConstantZero() {
                return LHS;
            }
            return optional<SDByteProvider> { nullopt };
        },
        SHL => {
            let mut ShiftOp: CastReturnType = dyn_cast(operator(Op).getOperand(1));
            if !ShiftOp {
                return optional<SDByteProvider> { nullopt };
            }
            let mut BitShift: u64 = ShiftOp.getZExtValue();
            if BitShift % 8 != 0 {
                return optional<SDByteProvider> { nullopt };
            }
            let mut ByteShift: u64 = BitShift / 8;
            return if Index < ByteShift { optional<SDByteProvider> { getConstantZero() } } else { calculateByteProvider(operator(Op).getOperand(0), Index - ByteShift, Depth + 1, optional<uint64_t> { VectorIndex }, Index, ByteMask) };
        },
        ANY_EXTEND => {
            SIGN_EXTEND;
        },
        BSWAP => {
            return calculateByteProvider(operator(Op).getOperand(0), ByteWidth - Index - 1, Depth + 1, optional<uint64_t> { VectorIndex }, StartingIndex, ByteMask);
        },
        AND => {
            let mut MaskOp: *mut ConstantSDNode = dyn_cast(operator(Op).getOperand(1));
            if !MaskOp {
                return optional<SDByteProvider> { nullopt };
            }
            let mut MaskByte: u8 = MaskOp.getAPIntValue().extractBitsAsZExtValue(8, Index * 8);
            if MaskByte == 0 {
                return optional<SDByteProvider> { getConstantZero() };
            }
            let mut Result: optional<SDByteProvider> = calculateByteProvider(operator(Op).getOperand(0), Index, Depth + 1, optional<uint64_t> { VectorIndex }, StartingIndex, ByteMask);
            if !Result {
                return optional<SDByteProvider> { nullopt };
            }
            if MaskByte != 255 && !ByteMask.is_empty() && !operator(Result).isConstantZero() {
                ByteMask[StartingIndex] &= MaskByte;
            }
            return Result;
        },
        EXTRACT_VECTOR_ELT => {
            let mut OffsetOp: CastReturnType = dyn_cast(operator(Op).getOperand(1));
            if !OffsetOp {
                return optional<SDByteProvider> { nullopt };
            }
            VectorIndex = optional<unsigned long long> { OffsetOp.getZExtValue() };
            let mut NarrowOp: SDValue = operator(Op).getOperand(0);
            let mut NarrowBitWidth: u32 = NarrowOp.getScalarValueSizeInBits();
            if NarrowBitWidth % 8 != 0 {
                return optional<SDByteProvider> { nullopt };
            }
            let mut NarrowByteWidth: u64 = NarrowBitWidth / 8;
            if Index >= NarrowByteWidth {
                return optional<SDByteProvider> { nullopt };
            }
            if operator(VectorIndex) * NarrowByteWidth > StartingIndex {
                return optional<SDByteProvider> { nullopt };
            }
            if (operator(VectorIndex) + 1) * NarrowByteWidth <= StartingIndex {
                return optional<SDByteProvider> { nullopt };
            }
            return calculateByteProvider(operator(Op).getOperand(0), Index, Depth + 1, optional<uint64_t> { VectorIndex }, StartingIndex, ByteMask);
        },
        LOAD => {
            let mut L: CastReturnType = cast(Op.getNode());
            if !L.isSimple() || L.isIndexed() {
                return optional<SDByteProvider> { nullopt };
            }
            let mut NarrowBitWidth: u32 = L.getMemoryVT().getScalarSizeInBits();
            if NarrowBitWidth % 8 != 0 {
                return optional<SDByteProvider> { nullopt };
            }
            let mut NarrowByteWidth: u64 = NarrowBitWidth / 8;
            if Index >= NarrowByteWidth {
                return if L.getExtensionType() == ZEXTLOAD { optional<SDByteProvider> { getConstantZero() } } else { optional<SDByteProvider> { nullopt } };
            }
            let mut BPVectorIndex: u32 = VectorIndex.value_or(0);
            return optional<SDByteProvider> { getSrc(SDNode *> { L }, Index, BPVectorIndex) };
        },
    }
    return optional<SDByteProvider> { nullopt };
}

fn littleEndianByteAt(BW: u32, i: u32) -> u32 {
    return i;
}

fn bigEndianByteAt(BW: u32, i: u32) -> u32 {
    return BW - i - 1;
}

fn isBigEndian(ByteOffsets: ArrayRef<int64_t>, FirstOffset: i64) -> optional<bool> {
    let mut Width: u32 = ByteOffsets.len;
    if Width < 2 {
        return optional<bool> { nullopt };
    }
    let mut BigEndian: bool = true;
    let mut LittleEndian: bool = true;
    for let mut i: u32 = 0; i < Width; i += 1 {
        let mut CurrentByteOffset: i64 = ByteOffsets[i] - FirstOffset;
        LittleEndian &= CurrentByteOffset == littleEndianByteAt(Width, i);
        BigEndian &= CurrentByteOffset == bigEndianByteAt(Width, i);
        if !BigEndian && !LittleEndian {
            return optional<bool> { nullopt };
        }
    }
    assert!((BigEndian != LittleEndian), "It should be either big endian orlittle endian");
    return optional<bool> { BigEndian };
}

fn stripTruncAndExt(Value: SDValue) -> SDValue {
    match Value.getOpcode() {
        TRUNCATE => {
            ZERO_EXTEND;
        },
    }
    return SDValue {};
}

fn DAGCombiner::mergeTruncStores(self, N: *mut StoreSDNode) -> SDValue {
    if self.LegalOperations || self.OptLevel == None {
        return SDValue {};
    }
    let mut MemVT: EVT = N.getMemoryVT();
    if !(MemVT == EVT { i8 } || MemVT == EVT { i16 } || MemVT == EVT { i32 }) || !N.isSimple() || N.isIndexed() {
        return SDValue {};
    }
    let mut Chain: SDValue = N.getChain();
    let mut Stores: SmallVector<StoreSDNode *, 8> = SmallVector<StoreSDNode *, 8> { [N] };
    let mut NarrowNumBits: u32 = MemVT.getScalarSizeInBits();
    let mut MaxWideNumBits: u32 = 64;
    let mut MaxStores: u32 = MaxWideNumBits / NarrowNumBits;
    while dyn_cast(Chain) {
        Store;
    }
    if Stores.len < 2 {
        return SDValue {};
    }
    let mut Context: *mut LLVMContext = *self.DAG.getContext();
    let mut NumStores: u32 = Stores.len;
    let mut WideNumBits: u32 = NumStores * NarrowNumBits;
    if WideNumBits != 16 && WideNumBits != 32 && WideNumBits != 64 {
        return SDValue {};
    }
    let mut SourceValue: SDValue = SDValue {};
    let mut OffsetMap: SmallVector<int64_t, 8> = SmallVector<int64_t, 8> { NumStores, 9223372036854775807 };
    let mut FirstOffset: i64 = 9223372036854775807;
    let mut FirstStore: *mut StoreSDNode = null;
    let mut Base: optional<BaseIndexOffset> = optional<BaseIndexOffset> {};
    for Store in Stores {
        let mut Trunc: SDValue = Store.getValue();
        if Trunc.getOpcode() != TRUNCATE {
            return SDValue {};
        }
        let mut Offset: i64 = 0;
        let mut WideVal: SDValue = Trunc.getOperand(0);
        if (WideVal.getOpcode() == SRL || WideVal.getOpcode() == SRA) && isa(WideVal.getOperand(1)) {
            let mut ShiftAmtC: u64 = WideVal.getConstantOperandVal(1);
            if ShiftAmtC % NarrowNumBits != 0 {
                return SDValue {};
            }
            if ShiftAmtC > WideVal.getScalarValueSizeInBits() - NarrowNumBits {
                return SDValue {};
            }
            Offset = ShiftAmtC / NarrowNumBits;
            WideVal = WideVal.getOperand(0);
        }
        if !SourceValue {
            SourceValue = WideVal;
        } else if SourceValue != WideVal {
            if stripTruncAndExt(SourceValue) != WideVal && stripTruncAndExt(WideVal) != SourceValue {
                return SDValue {};
            }
            if WideVal.getScalarValueSizeInBits() > SourceValue.getScalarValueSizeInBits() {
                SourceValue = WideVal;
            }
            if SourceValue.getScalarValueSizeInBits() < WideNumBits {
                return SDValue {};
            }
        }
        let mut Ptr: BaseIndexOffset = match(Store, self.DAG);
        let mut ByteOffsetFromBase: i64 = 0;
        if !Base {
            Base = Ptr;
        } else if !operator(Base).equalBaseIndex(Ptr, self.DAG, ByteOffsetFromBase) {
            return SDValue {};
        }
        if ByteOffsetFromBase < FirstOffset {
            FirstStore = Store;
            FirstOffset = ByteOffsetFromBase;
        }
        if Offset < 0 || Offset >= NumStores || OffsetMap[Offset] != 9223372036854775807 {
            return SDValue {};
        }
        OffsetMap[Offset] = ByteOffsetFromBase;
    }
    let mut WideVT: EVT = getIntegerVT(Context, WideNumBits);
    assert!(FirstOffset != 9223372036854775807, "First byte offset must be set");
    assert!(FirstStore, "First store must be set");
    let mut Layout: *DataLayout = self.DAG.getDataLayout();
    let mut Fast: u32 = 0;
    let mut Allowed: bool = self.TLI.allowsMemoryAccess(Context, Layout, WideVT, *FirstStore.getMemOperand(), &mut Fast);
    if !Allowed || !Fast {
        return SDValue {};
    }
    let mut checkOffsets: Closure_26 = Closure_26 { NumStores: &mut NumStores, OffsetMap: &mut OffsetMap, NarrowNumBits: &mut NarrowNumBits, FirstOffset: &mut FirstOffset };
    let mut NeedBswap: bool = false;
    let mut NeedRotate: bool = false;
    if !checkOffsets.call(Layout.isLittleEndian()) {
        if NarrowNumBits == 8 && checkOffsets.call(Layout.isBigEndian()) {
            NeedBswap = true;
        } else if NumStores == 2 && checkOffsets.call(Layout.isBigEndian()) {
            NeedRotate = true;
        } else {
            return SDValue {};
        }
    }
    let mut DL: SDLoc = SDLoc { N };
    if WideVT != SourceValue.getValueType() {
        assert!(SourceValue.getValueType().getScalarSizeInBits() > WideNumBits, "Unexpected store value to merge");
        SourceValue = self.DAG.getNode(TRUNCATE, DL, WideVT, SourceValue);
    }
    if NeedBswap {
        SourceValue = self.DAG.getNode(BSWAP, DL, WideVT, SourceValue);
    } else if NeedRotate {
        assert!(WideNumBits % 2 == 0, "Unexpected type for rotate");
        let mut RotAmt: SDValue = self.DAG.getConstant(WideNumBits / 2, DL, WideVT, false, false);
        SourceValue = self.DAG.getNode(ROTR, DL, WideVT, SourceValue, RotAmt);
    }
    let mut NewStore: SDValue = self.DAG.getStore(Chain, DL, SourceValue, FirstStore.getBasePtr(), FirstStore.getPointerInfo(), FirstStore.getAlign(), MONone, MMOMetadata {});
    self.DAG.ReplaceAllUsesWith(N, NewStore.getNode());
    return NewStore;
}

fn DAGCombiner::MatchLoadCombine(self, N: *mut SDNode) -> SDValue {
    assert!(N.getOpcode() == OR, "Can only match load combining against OR nodes");
    let mut VT: EVT = N.getValueType(0);
    if VT != EVT { i16 } && VT != EVT { i32 } && VT != EVT { i64 } {
        return SDValue {};
    }
    let mut ByteWidth: u32 = VT.getSizeInBits().operator unsigned long long() / 8;
    let mut IsBigEndianTarget: bool = self.DAG.getDataLayout().isBigEndian();
    let mut MemoryByteOffset: Closure_27 = Closure_27 { IsBigEndianTarget: &mut IsBigEndianTarget };
    let mut Base: optional<BaseIndexOffset> = optional<BaseIndexOffset> {};
    let mut Chain: SDValue = SDValue {};
    let mut Loads: SmallPtrSet<LoadSDNode *, 8> = SmallPtrSet<LoadSDNode *, 8> {};
    let mut FirstByteProvider: optional<SDByteProvider> = optional<SDByteProvider> {};
    let mut FirstOffset: i64 = 9223372036854775807;
    let mut ByteOffsets: SmallVector<int64_t, 8> = SmallVector<int64_t, 8> { ByteWidth };
    let mut ByteMasks: SmallVector<uint8_t, 8> = SmallVector<uint8_t, 8> { ByteWidth, 255 };
    let mut ZeroExtendedBytes: u32 = 0;
    for let mut i: i32 = ByteWidth - 1; i >= 0; i -= 1 {
        let mut P: optional<SDByteProvider> = calculateByteProvider(SDValue { Node: N, ResNo: 0 }, i, 0, optional<uint64_t> { nullopt }, i, MutableArrayRef<uint8_t> { ByteMasks });
        if !P {
            return SDValue {};
        }
        if operator(P).isConstantZero() {
            if ZeroExtendedBytes += 1 != (ByteWidth - i as u32) {
                return SDValue {};
            }
            continue;
        }
        assert!(operator(P).hasSrc(), "provenance should either be memory or zero");
        let mut L: *mut LoadSDNode = cast(operator(P).Src.value());
        let mut LChain: SDValue = L.getChain();
        if !Chain {
            Chain = LChain;
        } else if Chain != LChain {
            return SDValue {};
        }
        let mut Ptr: BaseIndexOffset = match(L, self.DAG);
        let mut ByteOffsetFromBase: i64 = 0;
        if L.getMemoryVT().isVector() {
            let mut LoadWidthInBit: u32 = L.getMemoryVT().getScalarSizeInBits();
            if LoadWidthInBit % 8 != 0 {
                return SDValue {};
            }
            let mut ByteOffsetFromVector: u32 = operator(P).SrcOffset * LoadWidthInBit / 8;
            Ptr.addToOffset(ByteOffsetFromVector);
        }
        if !Base {
            Base = Ptr;
        } else if !operator(Base).equalBaseIndex(Ptr, self.DAG, ByteOffsetFromBase) {
            return SDValue {};
        }
        ByteOffsetFromBase += MemoryByteOffset.call(SDByteProvider { operator(P) });
        ByteOffsets[i] = ByteOffsetFromBase;
        if ByteOffsetFromBase < FirstOffset {
            FirstByteProvider = P;
            FirstOffset = ByteOffsetFromBase;
        }
        Loads.insert(L);
    }
    assert!(!Loads.is_empty(), "All the bytes of the value must be loaded from memory, so there must be at least one load which produces the value");
    assert!(Base, "Base address of the accessed memory location must be set");
    assert!(FirstOffset != 9223372036854775807, "First byte offset must be set");
    let mut NeedsZext: bool = ZeroExtendedBytes > 0;
    let mut MemVT: EVT = getIntegerVT(*self.DAG.getContext(), (ByteWidth - ZeroExtendedBytes) * 8);
    if !MemVT.isSimple() {
        return SDValue {};
    }
    let mut IsBigEndian: optional<bool> = isBigEndian(ArrayRef<long long> { ByteOffsets }.drop_back(ZeroExtendedBytes), FirstOffset);
    if !IsBigEndian {
        return SDValue {};
    }
    assert!(FirstByteProvider, "must be set");
    if MemoryByteOffset.call(SDByteProvider { operator(FirstByteProvider) }) != 0 {
        return SDValue {};
    }
    let mut FirstLoad: *mut LoadSDNode = cast(operator(FirstByteProvider).Src.value());
    if self.LegalOperations && !self.TLI.isLoadLegal(VT, MemVT, FirstLoad.getAlign(), FirstLoad.getAddressSpace(), if NeedsZext { ZEXTLOAD } else { NON_EXTLOAD }, false) {
        return SDValue {};
    }
    let mut NeedsBswap: bool = IsBigEndianTarget != operator(IsBigEndian);
    if NeedsBswap && (self.LegalOperations || NeedsZext) && !self.TLI.isOperationLegal(BSWAP, VT) {
        return SDValue {};
    }
    if NeedsBswap && NeedsZext && self.LegalOperations && !self.TLI.isOperationLegal(SHL, VT) {
        return SDValue {};
    }
    let mut Fast: u32 = 0;
    let mut Allowed: bool = self.TLI.allowsMemoryAccess(*self.DAG.getContext(), self.DAG.getDataLayout(), MemVT, *FirstLoad.getMemOperand(), &mut Fast);
    if !Allowed || !Fast {
        return SDValue {};
    }
    let mut NewLoad: SDValue = self.DAG.getExtLoad(if NeedsZext { ZEXTLOAD } else { NON_EXTLOAD }, SDLoc { N }, VT, Chain, FirstLoad.getBasePtr(), FirstLoad.getPointerInfo(), MemVT, MaybeAlign { FirstLoad.getAlign() }, MONone, MMOMetadata {});
    for L in Loads {
        self.DAG.makeEquivalentMemoryOrdering(L, NewLoad);
    }
    let mut HasPartialMask: bool = false;
    let mut CombinedMask: u64 = 0;
    for let mut i: u32 = 0; i < ByteWidth; i += 1 {
        CombinedMask |= ByteMasks[i] as u64 << (i * 8);
        if ByteMasks[i] != 255 {
            HasPartialMask = true;
        }
    }
    if !NeedsBswap {
        if HasPartialMask {
            NewLoad = self.DAG.getNode(AND, SDLoc { N }, VT, NewLoad, self.DAG.getConstant(CombinedMask, SDLoc { N }, VT, false, false));
        }
        return NewLoad;
    }
    let mut ShiftedLoad: SDValue = if NeedsZext { self.DAG.getNode(SHL, SDLoc { N }, VT, NewLoad, self.DAG.getShiftAmountConstant(ZeroExtendedBytes * 8, VT, SDLoc { N })) } else { NewLoad };
    let mut Result: SDValue = self.DAG.getNode(BSWAP, SDLoc { N }, VT, ShiftedLoad);
    if HasPartialMask {
        Result = self.DAG.getNode(AND, SDLoc { N }, VT, Result, self.DAG.getConstant(CombinedMask, SDLoc { N }, VT, false, false));
    }
    return Result;
}

fn DAGCombiner::unfoldMaskedMerge(self, N: *mut SDNode) -> SDValue {
    assert!(N.getOpcode() == XOR);
    if isAllOnesOrAllOnesSplat(N.getOperand(1), false) {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    let mut M: SDValue = SDValue {};
    let mut matchAndXor: Closure_28 = Closure_28 { X: &mut X, Y: &mut Y, M: &mut M };
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    if !matchAndXor.call(N0, 0, N1) && !matchAndXor.call(N0, 1, N1) && !matchAndXor.call(N1, 0, N0) && !matchAndXor.call(N1, 1, N0) {
        return SDValue {};
    }
    if isa(M.getNode()) {
        return SDValue {};
    }
    if !self.TLI.hasAndNot(M) {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { N };
    if !self.TLI.hasAndNot(Y) && !isBitwiseNot(M, false) {
        assert!(self.TLI.hasAndNot(X), "Only mask is a variable? Unreachable.");
        let mut NotX: SDValue = self.DAG.getNOT(DL, X, VT);
        let mut LHS: SDValue = self.DAG.getNode(AND, DL, VT, NotX, M);
        let mut NotLHS: SDValue = self.DAG.getNOT(DL, LHS, VT);
        let mut RHS: SDValue = self.DAG.getNode(OR, DL, VT, M, Y);
        return self.DAG.getNode(AND, DL, VT, NotLHS, RHS);
    }
    if !self.TLI.hasAndNot(X) && isBitwiseNot(M, false) {
        assert!(self.TLI.hasAndNot(Y), "Only mask is a variable? Unreachable.");
        let mut NotM: SDValue = M.getOperand(0);
        let mut LHS: SDValue = self.DAG.getNode(OR, DL, VT, X, NotM);
        let mut NotY: SDValue = self.DAG.getNOT(DL, Y, VT);
        let mut RHS: SDValue = self.DAG.getNode(AND, DL, VT, NotM, NotY);
        let mut NotRHS: SDValue = self.DAG.getNOT(DL, RHS, VT);
        return self.DAG.getNode(AND, DL, VT, LHS, NotRHS);
    }
    let mut LHS: SDValue = self.DAG.getNode(AND, DL, VT, X, M);
    let mut NotM: SDValue = self.DAG.getNOT(DL, M, VT);
    let mut RHS: SDValue = self.DAG.getNode(AND, DL, VT, Y, NotM);
    return self.DAG.getNode(OR, DL, VT, LHS, RHS);
}

fn DAGCombiner::visitXOR(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N0.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    if N0.isUndef() && N1.isUndef() {
        return self.DAG.getConstant(0, DL, VT, false, false);
    }
    if N0.isUndef() {
        return N0;
    }
    if N1.isUndef() {
        return N1;
    }
    if self.DAG.FoldConstantArithmetic(XOR, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if self.DAG.isConstantIntBuildVectorOrConstantInt(N0, true) && !self.DAG.isConstantIntBuildVectorOrConstantInt(N1, true) {
        return self.DAG.getNode(XOR, DL, VT, N1, N0);
    }
    if VT.isVector() {
        if self.SimplifyVBinOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
        if isConstantSplatVectorAllZeros(N1.getNode(), false) {
            return N0;
        }
    }
    if isNullConstant(N1) {
        return N0;
    }
    if self.foldBinOpIntoSelect(N) {
        NewSel;
    } else {
        return NewSel;
    }
    if self.reassociateOps(XOR, DL, N0, N1, N.getFlags()) {
        RXOR;
    } else {
        return RXOR;
    }
    if self.reassociateReduction(VECREDUCE_XOR, XOR, DL, VT, N0, N1, SDNodeFlags { Flags: None }) {
        SD;
    } else {
        return SD;
    }
    if (!self.LegalOperations || self.TLI.isOperationLegal(OR, VT)) && self.DAG.haveNoCommonBitsSet(N0, N1) {
        return self.DAG.getNode(OR, DL, VT, N0, N1, SDNodeFlags { Flags: Disjoint });
    }
    if (!self.LegalOperations || self.TLI.isOperationLegal(ADD, VT)) && isMinSignedConstant(N1) {
        if self.visitADDLike(N) {
            Combined;
        } else {
            return Combined;
        }
    }
    let mut N0Opcode: u32 = N0.getOpcode();
    let mut LHS: SDValue = SDValue {};
    let mut RHS: SDValue = SDValue {};
    let mut CC: SDValue = SDValue {};
    if self.TLI.isConstTrueVal(N1) && self.isSetCCEquivalent(N0, LHS, RHS, CC, true) && !(VT.isVector() && self.TLI.hasAndNot(SDValue { Node: N, ResNo: 0 }) && N.hasOneUse() && operator(N.use_begin()).getUser().getOpcode() == AND) {
        let mut NotCC: CondCode = getSetCCInverse(cast(CC).get(), LHS.getValueType());
        if !self.LegalOperations || self.TLI.isCondCodeLegal(NotCC, LHS.getSimpleValueType()) {
            let mut Flags: SDNodeFlags = operator(N0).getFlags();
            match N0Opcode {
                _ => {
                    llvm_unreachable_internal("Unhandled SetCC Equivalent!", "llvm\\lib\\CodeGen\\SelectionDAG\\DAGCombiner.cpp", 10582);
                },
                SETCC => {
                    return self.DAG.getSetCC(SDLoc { N0 }, VT, LHS, RHS, NotCC, SDValue {}, false, Flags);
                },
                SELECT_CC => {
                    return self.DAG.getSelectCC(SDLoc { N0 }, LHS, RHS, N0.getOperand(2), N0.getOperand(3), NotCC, Flags);
                },
                STRICT_FSETCC => {
                    STRICT_FSETCCS;
                },
            }
        }
    }
    if isOneConstant(N1) && N0Opcode == ZERO_EXTEND && N0.hasOneUse() && self.isSetCCEquivalent(N0.getOperand(0), LHS, RHS, CC, false) {
        let mut V: SDValue = N0.getOperand(0);
        let mut DL0: SDLoc = SDLoc { N0 };
        V = self.DAG.getNode(XOR, DL0, V.getValueType(), V, self.DAG.getConstant(1, DL0, V.getValueType(), false, false));
        self.AddToWorklist(V.getNode(), true, false);
        return self.DAG.getNode(ZERO_EXTEND, DL, VT, V);
    }
    if isOneConstant(N1) && VT == EVT { i1 } && N0.hasOneUse() && (N0Opcode == OR || N0Opcode == AND) {
        let mut N00: SDValue = N0.getOperand(0);
        let mut N01: SDValue = N0.getOperand(1);
        if self.isOneUseSetCC(N01) || self.isOneUseSetCC(N00) {
            let mut NewOpcode: u32 = if N0Opcode == AND { OR } else { AND };
            N00 = self.DAG.getNode(XOR, SDLoc { N00 }, VT, N00, N1);
            N01 = self.DAG.getNode(XOR, SDLoc { N01 }, VT, N01, N1);
            self.AddToWorklist(N00.getNode(), true, false);
            self.AddToWorklist(N01.getNode(), true, false);
            return self.DAG.getNode(NewOpcode, DL, VT, N00, N01);
        }
    }
    if isAllOnesConstant(N1) && N0.hasOneUse() && (N0Opcode == OR || N0Opcode == AND) {
        let mut N00: SDValue = N0.getOperand(0);
        let mut N01: SDValue = N0.getOperand(1);
        if isa(N01) || isa(N00) {
            let mut NewOpcode: u32 = if N0Opcode == AND { OR } else { AND };
            N00 = self.DAG.getNode(XOR, SDLoc { N00 }, VT, N00, N1);
            N01 = self.DAG.getNode(XOR, SDLoc { N01 }, VT, N01, N1);
            self.AddToWorklist(N00.getNode(), true, false);
            self.AddToWorklist(N01.getNode(), true, false);
            return self.DAG.getNode(NewOpcode, DL, VT, N00, N01);
        }
    }
    if N0.getOpcode() == SUB && isAllOnesConstant(N1) {
        let mut Y: SDValue = N0.getOperand(0);
        let mut X: SDValue = N0.getOperand(1);
        if dyn_cast(Y) {
            YConst;
        } else {
            let mut NotYValue: APInt = operator(YConst.getAPIntValue());
            let mut NotY: SDValue = self.DAG.getConstant(NotYValue, DL, VT, false, false);
            return self.DAG.getNode(ADD, DL, VT, X, NotY, N.getFlags());
        }
    }
    if N0.getOpcode() == ADD && N0.hasOneUse() && isAllOnesConstant(N1) && isAllOnesOrAllOnesSplat(N0.getOperand(1), false) {
        return self.DAG.getNegative(N0.getOperand(0), DL, VT);
    }
    if N0Opcode == AND && N0.hasOneUse() && operator(N0).getOperand(1) == N1 {
        let mut X: SDValue = N0.getOperand(0);
        let mut NotX: SDValue = self.DAG.getNOT(SDLoc { X }, X, VT);
        self.AddToWorklist(NotX.getNode(), true, false);
        return self.DAG.getNode(AND, DL, VT, NotX, N1);
    }
    if !self.LegalOperations || self.hasOperation(ABS, VT) {
        let mut A: SDValue = if N0Opcode == ADD { N0 } else { N1 };
        let mut S: SDValue = if N0Opcode == SRA { N0 } else { N1 };
        if A.getOpcode() == ADD && S.getOpcode() == SRA {
            let mut A0: SDValue = A.getOperand(0);
            let mut A1: SDValue = A.getOperand(1);
            let mut S0: SDValue = S.getOperand(0);
            if (A0 == S && A1 == S0) || (A1 == S && A0 == S0) {
                if isConstOrConstSplat(S.getOperand(1), false, false) {
                    C;
                } else if C.getAPIntValue() == (VT.getScalarSizeInBits() - 1) {
                    return self.DAG.getNode(ABS, DL, VT, S0);
                }
            }
        }
    }
    if N0 == N1 {
        return tryFoldToZero(DL, self.TLI, VT, self.DAG, self.LegalOperations);
    }
    if self.TLI.isOperationLegalOrCustom(ROTL, VT, false) && N0Opcode == SHL && isAllOnesConstant(N1) && isOneConstant(N0.getOperand(0)) {
        return self.DAG.getNode(ROTL, DL, VT, self.DAG.getSignedConstant(~1, DL, VT, false, false), N0.getOperand(1));
    }
    if N0Opcode == N1.getOpcode() {
        if self.hoistLogicOpWithSameOpcodeHands(N) {
            V;
        } else {
            return V;
        }
    }
    if foldLogicOfShifts(N, N0, N1, self.DAG) {
        R;
    } else {
        return R;
    }
    if foldLogicOfShifts(N, N1, N0, self.DAG) {
        R;
    } else {
        return R;
    }
    if foldLogicTreeOfShifts(N, N0, N1, self.DAG) {
        R;
    } else {
        return R;
    }
    if self.unfoldMaskedMerge(N) {
        MM;
    } else {
        return MM;
    }
    if self.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if combineCarryDiamond(self.DAG, self.TLI, N0, N1, N) {
        Combined;
    } else {
        return Combined;
    }
    let mut Op0: SDValue = SDValue {};
    if sd_match(N0, m_OneUse(m_AnyOf(m_SMin(m_Value(Op0), m_Specific(N1)), m_SMax(m_Value(Op0), m_Specific(N1)), m_UMin(m_Value(Op0), m_Specific(N1)), m_UMax(m_Value(Op0), m_Specific(N1))))) {
        if isa(N1) || isBuildVectorOfConstantSDNodes(N1.getNode()) {
            if VT.isVector() {
                let mut N1C: *mut ConstantSDNode = isConstOrConstSplat(N1, false, false);
                if !N1C || (!N1C.isZero() && !N1C.isAllOnes()) {
                    return SDValue {};
                }
            }
            if self.TLI.isOperationLegal(N0.getOpcode(), VT) && self.TLI.isPredictableSelectExpensive() {
                return SDValue {};
            }
            let mut CCVT: EVT = self.getSetCCResultType(VT);
            let mut CC: CondCode = zeroed();
            match N0.getOpcode() {
                SMIN => {
                    CC = SETLT;
                },
                SMAX => {
                    CC = SETGT;
                },
                UMIN => {
                    CC = SETULT;
                },
                UMAX => {
                    CC = SETUGT;
                },
            }
            let mut FN1: SDValue = self.DAG.getFreeze(N1);
            let mut Cmp: SDValue = self.DAG.getSetCC(DL, CCVT, Op0, FN1, CC, SDValue {}, false, SDNodeFlags { Flags: None });
            let mut XorXC: SDValue = self.DAG.getNode(XOR, DL, VT, Op0, FN1);
            let mut Zero: SDValue = self.DAG.getConstant(0, DL, VT, false, false);
            return self.DAG.getSelect(DL, VT, Cmp, XorXC, Zero, SDNodeFlags { Flags: None });
        }
    }
    return SDValue {};
}

fn combineShiftOfShiftedLogic(Shift: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut LogicOp: SDValue = Shift.getOperand(0);
    if !LogicOp.hasOneUse() {
        return SDValue {};
    }
    let mut LogicOpcode: u32 = LogicOp.getOpcode();
    if LogicOpcode != AND && LogicOpcode != OR && LogicOpcode != XOR {
        return SDValue {};
    }
    let mut ShiftOpcode: u32 = Shift.getOpcode();
    let mut C1: SDValue = Shift.getOperand(1);
    let mut C1Node: *mut ConstantSDNode = isConstOrConstSplat(C1, false, false);
    assert!(C1Node, "Expected a shift with constant operand");
    let mut C1Val: *APInt = C1Node.getAPIntValue();
    let mut matchFirstShift: Closure_29 = Closure_29 { ShiftOpcode: &mut ShiftOpcode, C1Val: &mut C1Val };
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    let mut C0Val: *APInt = null;
    if matchFirstShift.call(LogicOp.getOperand(0), X, C0Val) {
        Y = LogicOp.getOperand(1);
    } else if matchFirstShift.call(LogicOp.getOperand(1), X, C0Val) {
        Y = LogicOp.getOperand(0);
    } else {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { Shift };
    let mut VT: EVT = Shift.getValueType(0);
    let mut ShiftAmtVT: EVT = Shift.getOperand(1).getValueType();
    let mut ShiftSumC: SDValue = DAG.getConstant(*C0Val + C1Val, DL, ShiftAmtVT, false, false);
    let mut NewShift1: SDValue = DAG.getNode(ShiftOpcode, DL, VT, X, ShiftSumC);
    let mut NewShift2: SDValue = DAG.getNode(ShiftOpcode, DL, VT, Y, C1);
    return DAG.getNode(LogicOpcode, DL, VT, NewShift1, NewShift2, operator(LogicOp).getFlags());
}

fn DAGCombiner::visitShiftByConstant(self, N: *mut SDNode) -> SDValue {
    assert!(isConstOrConstSplat(N.getOperand(1), false, false), "Expected constant operand");
    if isBitwiseNot(N.getOperand(0), false) {
        return SDValue {};
    }
    let mut LHS: SDValue = N.getOperand(0);
    if !LHS.hasOneUse() || !self.TLI.isDesirableToCommuteWithShift(N, self.Level) {
        return SDValue {};
    }
    if combineShiftOfShiftedLogic(N, self.DAG) {
        R;
    } else {
        return R;
    }
    match LHS.getOpcode() {
        _ => {
            return SDValue {};
        },
        OR => {
            XOR;
        },
        ADD => {
            if N.getOpcode() != SHL {
                return SDValue {};
            }
        },
    }
    let mut BinOpLHSVal: SDValue = LHS.getOperand(0);
    let mut IsShiftByConstant: bool = (BinOpLHSVal.getOpcode() == SHL || BinOpLHSVal.getOpcode() == SRA || BinOpLHSVal.getOpcode() == SRL) && isa(BinOpLHSVal.getOperand(1));
    let mut IsCopyOrSelect: bool = BinOpLHSVal.getOpcode() == CopyFromReg || BinOpLHSVal.getOpcode() == SELECT;
    if !IsShiftByConstant && !IsCopyOrSelect {
        return SDValue {};
    }
    if IsCopyOrSelect && N.hasOneUse() {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    if self.DAG.FoldConstantArithmetic(N.getOpcode(), DL, VT, ArrayRef<SDValue> { [LHS.getOperand(1), N.getOperand(1)] }, SDNodeFlags { Flags: None }) {
        NewRHS;
    } else {
        let mut NewShift: SDValue = self.DAG.getNode(N.getOpcode(), DL, VT, LHS.getOperand(0), N.getOperand(1));
        return self.DAG.getNode(LHS.getOpcode(), DL, VT, NewShift, NewRHS);
    }
    return SDValue {};
}

fn DAGCombiner::distributeTruncateThroughAnd(self, N: *mut SDNode) -> SDValue {
    assert!(N.getOpcode() == TRUNCATE);
    assert!(N.getOperand(0).getOpcode() == AND);
    let mut TruncVT: EVT = N.getValueType(0);
    if N.hasOneUse() && N.getOperand(0).hasOneUse() && self.TLI.isTypeDesirableForOp(AND, TruncVT) {
        let mut N01: SDValue = N.getOperand(0).getOperand(1);
        if isConstantOrConstantVector(N01, true, false) {
            let mut DL: SDLoc = SDLoc { N };
            let mut N00: SDValue = N.getOperand(0).getOperand(0);
            let mut Trunc00: SDValue = self.DAG.getNode(TRUNCATE, DL, TruncVT, N00);
            let mut Trunc01: SDValue = self.DAG.getNode(TRUNCATE, DL, TruncVT, N01);
            self.AddToWorklist(Trunc00.getNode(), true, false);
            self.AddToWorklist(Trunc01.getNode(), true, false);
            return self.DAG.getNode(AND, DL, TruncVT, Trunc00, Trunc01);
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitRotate(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut Bitsize: u32 = VT.getScalarSizeInBits();
    if isNullOrNullSplat(N1, false) {
        return N0;
    }
    if isPowerOf2_32(Bitsize) && Bitsize > 1 {
        let mut ModuloMask: APInt = APInt { N1.getScalarValueSizeInBits(), Bitsize - 1, false, false };
        if self.DAG.MaskedValueIsZero(N1, ModuloMask, 0) {
            return N0;
        }
    }
    let mut OutOfRange: bool = false;
    let mut MatchOutOfRange: Closure_30 = Closure_30 { Bitsize: Bitsize, OutOfRange: &mut OutOfRange };
    if matchUnaryPredicate(N1, function<bool (ConstantSDNode *)> { MatchOutOfRange }, false, false) && OutOfRange {
        let mut AmtVT: EVT = N1.getValueType();
        let mut Bits: SDValue = self.DAG.getConstant(Bitsize, dl, AmtVT, false, false);
        if self.DAG.FoldConstantArithmetic(UREM, dl, AmtVT, ArrayRef<SDValue> { [N1, Bits] }, SDNodeFlags { Flags: None }) {
            Amt;
        } else {
            return self.DAG.getNode(N.getOpcode(), dl, VT, N0, Amt);
        }
    }
    let mut RotAmtC: *mut ConstantSDNode = isConstOrConstSplat(N1, false, false);
    if RotAmtC && RotAmtC.getAPIntValue() == 8 && VT.getScalarSizeInBits() == 16 && self.hasOperation(BSWAP, VT) {
        return self.DAG.getNode(BSWAP, dl, VT, N0);
    }
    if self.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if N1.getOpcode() == TRUNCATE && N1.getOperand(0).getOpcode() == AND {
        if self.distributeTruncateThroughAnd(N1.getNode()) {
            NewOp1;
        } else {
            return self.DAG.getNode(N.getOpcode(), dl, VT, N0, NewOp1);
        }
    }
    let mut NextOp: u32 = N0.getOpcode();
    if NextOp == ROTL || NextOp == ROTR {
        let mut C1: bool = self.DAG.isConstantIntBuildVectorOrConstantInt(N1, true);
        let mut C2: bool = self.DAG.isConstantIntBuildVectorOrConstantInt(N0.getOperand(1), true);
        if C1 && C2 && N1.getValueType() == N0.getOperand(1).getValueType() {
            let mut ShiftVT: EVT = N1.getValueType();
            let mut SameSide: bool = (N.getOpcode() == NextOp);
            let mut CombineOp: u32 = if SameSide { ADD } else { SUB };
            let mut BitsizeC: SDValue = self.DAG.getConstant(Bitsize, dl, ShiftVT, false, false);
            let mut Norm1: SDValue = self.DAG.FoldConstantArithmetic(UREM, dl, ShiftVT, ArrayRef<SDValue> { [N1, BitsizeC] }, SDNodeFlags { Flags: None });
            let mut Norm2: SDValue = self.DAG.FoldConstantArithmetic(UREM, dl, ShiftVT, ArrayRef<SDValue> { [N0.getOperand(1), BitsizeC] }, SDNodeFlags { Flags: None });
            if Norm1 && Norm2 {
                if self.DAG.FoldConstantArithmetic(CombineOp, dl, ShiftVT, ArrayRef<SDValue> { [Norm1, Norm2] }, SDNodeFlags { Flags: None }) {
                    CombinedShift;
                } else {
                    CombinedShift = self.DAG.FoldConstantArithmetic(ADD, dl, ShiftVT, ArrayRef<SDValue> { [CombinedShift, BitsizeC] }, SDNodeFlags { Flags: None });
                    let mut CombinedShiftNorm: SDValue = self.DAG.FoldConstantArithmetic(UREM, dl, ShiftVT, ArrayRef<SDValue> { [CombinedShift, BitsizeC] }, SDNodeFlags { Flags: None });
                    return self.DAG.getNode(N.getOpcode(), dl, VT, operator(N0).getOperand(0), CombinedShiftNorm);
                }
            }
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitSHL(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    if self.DAG.simplifyShift(N0, N1) {
        V;
    } else {
        return V;
    }
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: EVT = N0.getValueType();
    let mut ShiftVT: EVT = N1.getValueType();
    let mut OpSizeInBits: u32 = VT.getScalarSizeInBits();
    if self.DAG.FoldConstantArithmetic(SHL, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if VT.isVector() {
        if self.SimplifyVBinOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
        let mut N1CV: *mut BuildVectorSDNode = dyn_cast(N1);
        if N1CV && N1CV.isConstant() {
            if N0.getOpcode() == AND {
                let mut N00: SDValue = operator(N0).getOperand(0);
                let mut N01: SDValue = operator(N0).getOperand(1);
                let mut N01CV: *mut BuildVectorSDNode = dyn_cast(N01);
                if N01CV && N01CV.isConstant() && N00.getOpcode() == SETCC && self.TLI.getBooleanContents(N00.getOperand(0).getValueType()) == ZeroOrNegativeOneBooleanContent {
                    if self.DAG.FoldConstantArithmetic(SHL, DL, VT, ArrayRef<SDValue> { [N01, N1] }, SDNodeFlags { Flags: None }) {
                        C;
                    } else {
                        return self.DAG.getNode(AND, DL, VT, N00, C);
                    }
                }
            }
        }
    }
    if self.foldBinOpIntoSelect(N) {
        NewSel;
    } else {
        return NewSel;
    }
    if self.DAG.MaskedValueIsZero(SDValue { Node: N, ResNo: 0 }, getAllOnes(OpSizeInBits), 0) {
        return self.DAG.getConstant(0, DL, VT, false, false);
    }
    if N1.getOpcode() == TRUNCATE && N1.getOperand(0).getOpcode() == AND {
        if self.distributeTruncateThroughAnd(N1.getNode()) {
            NewOp1;
        } else {
            return self.DAG.getNode(SHL, DL, VT, N0, NewOp1);
        }
    }
    if N0.getOpcode() == SHL {
        let mut MatchOutOfRange: Closure_31 = Closure_31 { OpSizeInBits: OpSizeInBits };
        if matchBinaryPredicate(N1, N0.getOperand(1), function<bool (ConstantSDNode *, ConstantSDNode *)> { MatchOutOfRange }, false, false) {
            return self.DAG.getConstant(0, DL, VT, false, false);
        }
        let mut MatchInRange: Closure_32 = Closure_32 { OpSizeInBits: OpSizeInBits };
        if matchBinaryPredicate(N1, N0.getOperand(1), function<bool (ConstantSDNode *, ConstantSDNode *)> { MatchInRange }, false, false) {
            let mut Sum: SDValue = self.DAG.getNode(ADD, DL, ShiftVT, N1, N0.getOperand(1));
            return self.DAG.getNode(SHL, DL, VT, N0.getOperand(0), Sum);
        }
    }
    if (N0.getOpcode() == ZERO_EXTEND || N0.getOpcode() == ANY_EXTEND || N0.getOpcode() == SIGN_EXTEND) && N0.getOperand(0).getOpcode() == SHL {
        let mut N0Op0: SDValue = N0.getOperand(0);
        let mut InnerShiftAmt: SDValue = N0Op0.getOperand(1);
        let mut InnerVT: EVT = N0Op0.getValueType();
        let mut InnerBitwidth: u64 = InnerVT.getScalarSizeInBits();
        let mut MatchOutOfRange: Closure_33 = Closure_33 { OpSizeInBits: OpSizeInBits, InnerBitwidth: InnerBitwidth };
        if matchBinaryPredicate(InnerShiftAmt, N1, function<bool (ConstantSDNode *, ConstantSDNode *)> { MatchOutOfRange }, false, true) {
            return self.DAG.getConstant(0, DL, VT, false, false);
        }
        let mut MatchInRange: Closure_34 = Closure_34 { OpSizeInBits: OpSizeInBits, InnerBitwidth: InnerBitwidth };
        if matchBinaryPredicate(InnerShiftAmt, N1, function<bool (ConstantSDNode *, ConstantSDNode *)> { MatchInRange }, false, true) {
            let mut Ext: SDValue = self.DAG.getNode(N0.getOpcode(), DL, VT, N0Op0.getOperand(0));
            let mut Sum: SDValue = self.DAG.getZExtOrTrunc(InnerShiftAmt, DL, ShiftVT);
            Sum = self.DAG.getNode(ADD, DL, ShiftVT, Sum, N1);
            return self.DAG.getNode(SHL, DL, VT, Ext, Sum);
        }
    }
    if N0.getOpcode() == ZERO_EXTEND && N0.hasOneUse() && N0.getOperand(0).getOpcode() == SRL {
        let mut N0Op0: SDValue = N0.getOperand(0);
        let mut InnerShiftAmt: SDValue = N0Op0.getOperand(1);
        let mut MatchEqual: Closure_35 = Closure_35 { cap_0: VT };
        if matchBinaryPredicate(InnerShiftAmt, N1, function<bool (ConstantSDNode *, ConstantSDNode *)> { MatchEqual }, false, true) {
            let mut InnerShiftAmtVT: EVT = N0Op0.getOperand(1).getValueType();
            let mut NewSHL: SDValue = self.DAG.getZExtOrTrunc(N1, DL, InnerShiftAmtVT);
            NewSHL = self.DAG.getNode(SHL, DL, N0Op0.getValueType(), N0Op0, NewSHL);
            self.AddToWorklist(NewSHL.getNode(), true, false);
            return self.DAG.getNode(ZERO_EXTEND, SDLoc { N0 }, VT, NewSHL);
        }
    }
    if N0.getOpcode() == SRL || N0.getOpcode() == SRA {
        let mut MatchShiftAmount: Closure_36 = Closure_36 { OpSizeInBits: OpSizeInBits };
        if operator(N0).getFlags().hasExact() {
            if matchBinaryPredicate(N0.getOperand(1), N1, function<bool (ConstantSDNode *, ConstantSDNode *)> { MatchShiftAmount }, false, true) {
                let mut N01: SDValue = self.DAG.getZExtOrTrunc(N0.getOperand(1), DL, ShiftVT);
                let mut Diff: SDValue = self.DAG.getNode(SUB, DL, ShiftVT, N1, N01);
                return self.DAG.getNode(SHL, DL, VT, N0.getOperand(0), Diff);
            }
            if matchBinaryPredicate(N1, N0.getOperand(1), function<bool (ConstantSDNode *, ConstantSDNode *)> { MatchShiftAmount }, false, true) {
                let mut N01: SDValue = self.DAG.getZExtOrTrunc(N0.getOperand(1), DL, ShiftVT);
                let mut Diff: SDValue = self.DAG.getNode(SUB, DL, ShiftVT, N01, N1);
                return self.DAG.getNode(N0.getOpcode(), DL, VT, N0.getOperand(0), Diff);
            }
        }
        if N0.getOpcode() == SRL && (N0.getOperand(1) == N1 || N0.hasOneUse()) && self.TLI.shouldFoldConstantShiftPairToMask(N) {
            if matchBinaryPredicate(N1, N0.getOperand(1), function<bool (ConstantSDNode *, ConstantSDNode *)> { MatchShiftAmount }, false, true) {
                let mut N01: SDValue = self.DAG.getZExtOrTrunc(N0.getOperand(1), DL, ShiftVT);
                let mut Diff: SDValue = self.DAG.getNode(SUB, DL, ShiftVT, N01, N1);
                let mut Mask: SDValue = self.DAG.getAllOnesConstant(DL, VT, false, false);
                Mask = self.DAG.getNode(SHL, DL, VT, Mask, N01);
                Mask = self.DAG.getNode(SRL, DL, VT, Mask, Diff);
                let mut Shift: SDValue = self.DAG.getNode(SRL, DL, VT, N0.getOperand(0), Diff);
                return self.DAG.getNode(AND, DL, VT, Shift, Mask);
            }
            if matchBinaryPredicate(N0.getOperand(1), N1, function<bool (ConstantSDNode *, ConstantSDNode *)> { MatchShiftAmount }, false, true) {
                let mut N01: SDValue = self.DAG.getZExtOrTrunc(N0.getOperand(1), DL, ShiftVT);
                let mut Diff: SDValue = self.DAG.getNode(SUB, DL, ShiftVT, N1, N01);
                let mut Mask: SDValue = self.DAG.getAllOnesConstant(DL, VT, false, false);
                Mask = self.DAG.getNode(SHL, DL, VT, Mask, N1);
                let mut Shift: SDValue = self.DAG.getNode(SHL, DL, VT, N0.getOperand(0), Diff);
                return self.DAG.getNode(AND, DL, VT, Shift, Mask);
            }
        }
    }
    if N0.getOpcode() == SRA && N1 == N0.getOperand(1) && isConstantOrConstantVector(N1, true, false) {
        let mut AllBits: SDValue = self.DAG.getAllOnesConstant(DL, VT, false, false);
        let mut HiBitsMask: SDValue = self.DAG.getNode(SHL, DL, VT, AllBits, N1);
        return self.DAG.getNode(AND, DL, VT, N0.getOperand(0), HiBitsMask);
    }
    if (N0.getOpcode() == ADD || N0.getOpcode() == OR) && self.TLI.isDesirableToCommuteWithShift(N, self.Level) {
        let mut N01: SDValue = N0.getOperand(1);
        if self.DAG.FoldConstantArithmetic(SHL, SDLoc { N1 }, VT, ArrayRef<SDValue> { [N01, N1] }, SDNodeFlags { Flags: None }) {
            Shl1;
        } else {
            let mut Shl0: SDValue = self.DAG.getNode(SHL, SDLoc { N0 }, VT, N0.getOperand(0), N1);
            self.AddToWorklist(Shl0.getNode(), true, false);
            let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
            if N0.getOpcode() == OR && operator(N0).getFlags().hasDisjoint() {
                operator(Flags, SDNodeFlags { Flags: Disjoint });
            }
            return self.DAG.getNode(N0.getOpcode(), DL, VT, Shl0, Shl1, Flags);
        }
    }
    if N0.getOpcode() == SIGN_EXTEND && N0.getOperand(0).getOpcode() == ADD && operator(N0.getOperand(0)).getFlags().hasNoSignedWrap() && self.TLI.isDesirableToCommuteWithShift(N, self.Level) {
        let mut Add: SDValue = N0.getOperand(0);
        let mut DL: SDLoc = SDLoc { N0 };
        if self.DAG.FoldConstantArithmetic(N0.getOpcode(), DL, VT, ArrayRef<SDValue> { [Add.getOperand(1)] }, SDNodeFlags { Flags: None }) {
            ExtC;
        } else {
            if self.DAG.FoldConstantArithmetic(SHL, DL, VT, ArrayRef<SDValue> { [ExtC, N1] }, SDNodeFlags { Flags: None }) {
                ShlC;
            } else {
                let mut ExtX: SDValue = self.DAG.getNode(N0.getOpcode(), DL, VT, Add.getOperand(0));
                let mut ShlX: SDValue = self.DAG.getNode(SHL, DL, VT, ExtX, N1);
                return self.DAG.getNode(ADD, DL, VT, ShlX, ShlC);
            }
        }
    }
    if N0.getOpcode() == MUL && operator(N0).hasOneUse() {
        let mut N01: SDValue = N0.getOperand(1);
        if self.DAG.FoldConstantArithmetic(SHL, SDLoc { N1 }, VT, ArrayRef<SDValue> { [N01, N1] }, SDNodeFlags { Flags: None }) {
            Shl;
        } else {
            return self.DAG.getNode(MUL, DL, VT, N0.getOperand(0), Shl);
        }
    }
    let mut N1C: *mut ConstantSDNode = isConstOrConstSplat(N1, false, false);
    if N1C && !N1C.isOpaque() {
        if self.visitShiftByConstant(N) {
            NewSHL;
        } else {
            return NewSHL;
        }
    }
    if ((N1.getOpcode() == CTTZ && VT.getScalarSizeInBits() <= ShiftVT.getScalarSizeInBits()) || N1.getOpcode() == CTTZ_ZERO_POISON) && N1.hasOneUse() && !self.TLI.isOperationLegalOrCustom(CTTZ, ShiftVT, false) && self.TLI.isOperationLegalOrCustom(MUL, VT, false) {
        let mut Y: SDValue = N1.getOperand(0);
        let mut DL: SDLoc = SDLoc { N };
        let mut NegY: SDValue = self.DAG.getNegative(Y, DL, ShiftVT);
        let mut And: SDValue = self.DAG.getZExtOrTrunc(self.DAG.getNode(AND, DL, ShiftVT, Y, NegY), DL, VT);
        return self.DAG.getNode(MUL, DL, VT, And, N0);
    }
    if self.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if N0.getOpcode() == VSCALE && N1C {
        let mut C0: *APInt = N0.getConstantOperandAPInt(0);
        let mut C1: *APInt = N1C.getAPIntValue();
        return self.DAG.getVScale(DL, VT, C0 << C1);
    }
    let mut X: SDValue = SDValue {};
    let mut VS0: APInt = APInt {};
    if N1C && sd_match(N0, m_Mul(m_Value(X), m_VScale(m_ConstInt(VS0)))) {
        let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
        Flags.setNoUnsignedWrap(N.getFlags().hasNoUnsignedWrap() && operator(N0).getFlags().hasNoUnsignedWrap());
        let mut VScale: SDValue = self.DAG.getVScale(DL, VT, VS0 << N1C.getAPIntValue());
        return self.DAG.getNode(MUL, DL, VT, X, VScale, Flags);
    }
    let mut ShlVal: APInt = APInt {};
    if N0.getOpcode() == STEP_VECTOR && isConstantSplatVector(N1.getNode(), ShlVal) {
        let mut C0: *APInt = N0.getConstantOperandAPInt(0);
        if ShlVal.ult(C0.getBitWidth()) {
            let mut NewStep: APInt = C0 << ShlVal;
            return self.DAG.getStepVector(DL, VT, NewStep);
        }
    }
    return SDValue {};
}

fn combineShiftToMULH(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG, TLI: *TargetLowering) -> SDValue {
    assert!((N.getOpcode() == SRL || N.getOpcode() == SRA), "SRL or SRA node is required here!");
    let mut ShiftAmtSrc: *mut ConstantSDNode = isConstOrConstSplat(N.getOperand(1), false, false);
    if !ShiftAmtSrc {
        return SDValue {};
    }
    let mut ShiftOperand: SDValue = N.getOperand(0);
    if ShiftOperand.getOpcode() != MUL {
        return SDValue {};
    }
    let mut LeftOp: SDValue = ShiftOperand.getOperand(0);
    let mut RightOp: SDValue = ShiftOperand.getOperand(1);
    if LeftOp.getOpcode() != SIGN_EXTEND && LeftOp.getOpcode() != ZERO_EXTEND {
        swap(LeftOp, RightOp);
    }
    let mut IsSignExt: bool = LeftOp.getOpcode() == SIGN_EXTEND;
    let mut IsZeroExt: bool = LeftOp.getOpcode() == ZERO_EXTEND;
    if !IsSignExt && !IsZeroExt {
        return SDValue {};
    }
    let mut NarrowVT: EVT = LeftOp.getOperand(0).getValueType();
    let mut NarrowVTSize: u32 = NarrowVT.getScalarSizeInBits();
    let mut UserOfLowerBits: Closure_37 = Closure_37 { NarrowVTSize: NarrowVTSize };
    let mut MulLoHiOp: u32 = if IsSignExt { SMUL_LOHI } else { UMUL_LOHI };
    if !ShiftOperand.hasOneUse() && TLI.isOperationLegalOrCustom(MulLoHiOp, NarrowVT, false) && any_of(operator(ShiftOperand).users(), UserOfLowerBits) {
        return SDValue {};
    }
    let mut MulhRightOp: SDValue = SDValue {};
    if LeftOp.getOpcode() != RightOp.getOpcode() {
        if IsZeroExt && ShiftOperand.hasOneUse() && DAG.computeKnownBits(RightOp, 0).countMaxActiveBits() <= NarrowVTSize {
            MulhRightOp = DAG.getNode(TRUNCATE, DL, NarrowVT, RightOp);
        } else if IsSignExt && ShiftOperand.hasOneUse() && DAG.ComputeMaxSignificantBits(RightOp, 0) <= NarrowVTSize {
            MulhRightOp = DAG.getNode(TRUNCATE, DL, NarrowVT, RightOp);
        } else {
            return SDValue {};
        }
    } else {
        if NarrowVT != RightOp.getOperand(0).getValueType() {
            return SDValue {};
        }
        MulhRightOp = RightOp.getOperand(0);
    }
    let mut WideVT: EVT = LeftOp.getValueType();
    assert!((WideVT == RightOp.getValueType()), "Cannot have a multiply node with two different operand types.");
    if WideVT.getScalarSizeInBits() != 2 * NarrowVTSize {
        return SDValue {};
    }
    let mut ShiftAmt: u32 = ShiftAmtSrc.getZExtValue();
    if ShiftAmt != NarrowVTSize {
        return SDValue {};
    }
    let mut MulhOpcode: u32 = if IsSignExt { MULHS } else { MULHU };
    let mut TransformVT: EVT = NarrowVT;
    if NarrowVT.isVector() {
        TransformVT = TLI.getLegalTypeToTransformTo(*DAG.getContext(), NarrowVT);
        if TransformVT.getScalarType() != NarrowVT.getScalarType() {
            return SDValue {};
        }
    }
    if !TLI.isOperationLegalOrCustom(MulhOpcode, TransformVT, false) {
        return SDValue {};
    }
    let mut Result: SDValue = DAG.getNode(MulhOpcode, DL, NarrowVT, LeftOp.getOperand(0), MulhRightOp);
    let mut IsSigned: bool = N.getOpcode() == SRA;
    return DAG.getExtOrTrunc(IsSigned, Result, DL, WideVT);
}

fn foldBitOrderCrossLogicOp(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut Opcode: u32 = N.getOpcode();
    if Opcode != BSWAP && Opcode != BITREVERSE {
        return SDValue {};
    }
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    if sd_match(N0, m_OneUse(m_BitwiseLogic(m_UnaryOp(Opcode, m_Value(X)), m_UnaryOp(Opcode, m_Value(Y))))) {
        return DAG.getNode(N0.getOpcode(), DL, VT, X, Y);
    }
    if sd_match(N0, m_OneUse(m_BitwiseLogic(m_OneUse(m_UnaryOp(Opcode, m_Value(X))), m_Value(Y)))) {
        let mut NewBitReorder: SDValue = DAG.getNode(Opcode, DL, VT, Y);
        return DAG.getNode(N0.getOpcode(), DL, VT, X, NewBitReorder);
    }
    return SDValue {};
}

fn DAGCombiner::visitSRA(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    if self.DAG.simplifyShift(N0, N1) {
        V;
    } else {
        return V;
    }
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: EVT = N0.getValueType();
    let mut OpSizeInBits: u32 = VT.getScalarSizeInBits();
    if self.DAG.FoldConstantArithmetic(SRA, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if self.DAG.ComputeNumSignBits(N0, 0) == OpSizeInBits {
        return N0;
    }
    if VT.isVector() {
        if self.SimplifyVBinOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
    }
    if self.foldBinOpIntoSelect(N) {
        NewSel;
    } else {
        return NewSel;
    }
    let mut N1C: *mut ConstantSDNode = isConstOrConstSplat(N1, false, false);
    if N0.getOpcode() == SRA {
        let mut ShiftVT: EVT = N1.getValueType();
        let mut ShiftSVT: EVT = ShiftVT.getScalarType();
        let mut ShiftValues: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
        let mut SumOfShifts: Closure_38 = Closure_38 { OpSizeInBits: &mut OpSizeInBits, ShiftValues: &mut ShiftValues, cap_2: self, DL: &mut DL, ShiftSVT: &mut ShiftSVT };
        if matchBinaryPredicate(N1, N0.getOperand(1), function<bool (ConstantSDNode *, ConstantSDNode *)> { SumOfShifts }, false, false) {
            let mut ShiftValue: SDValue = SDValue {};
            if N1.getOpcode() == BUILD_VECTOR {
                ShiftValue = self.DAG.getBuildVector(ShiftVT, DL, ArrayRef<SDValue> { ShiftValues });
            } else if N1.getOpcode() == SPLAT_VECTOR {
                assert!(ShiftValues.len == 1, "Expected matchBinaryPredicate to return one element for SPLAT_VECTORs");
                ShiftValue = self.DAG.getSplatVector(ShiftVT, DL, ShiftValues[0]);
            } else {
                ShiftValue = ShiftValues[0];
            }
            return self.DAG.getNode(SRA, DL, VT, N0.getOperand(0), ShiftValue);
        }
    }
    let mut X: SDValue = SDValue {};
    let mut C1: APInt = APInt {};
    if N1C && sd_match(N0, m_OneUse(m_Not(m_OneUse(m_Sra(m_Value(X), m_ConstInt(C1)))))) {
        let mut C2: APInt = N1C.getAPIntValue();
        zeroExtendToMatch(C1, C2, 1);
        let mut Sum: APInt = C1 + C2;
        let mut ShiftSum: u32 = Sum.getLimitedValue(OpSizeInBits - 1);
        let mut NewShift: SDValue = self.DAG.getNode(SRA, DL, VT, X, self.DAG.getShiftAmountConstant(ShiftSum, VT, DL));
        return self.DAG.getNOT(DL, NewShift, VT);
    }
    if N0.getOpcode() == SHL && N1C {
        let mut N01C: *ConstantSDNode = isConstOrConstSplat(N0.getOperand(1), false, false);
        if N01C {
            let mut Ctx: *mut LLVMContext = *self.DAG.getContext();
            let mut TruncVT: EVT = VT.changeElementType(Ctx, getIntegerVT(Ctx, OpSizeInBits - N1C.getZExtValue()));
            let mut ShiftAmt: i32 = N1C.getZExtValue() - N01C.getZExtValue();
            if (ShiftAmt > 0) && self.TLI.isOperationLegalOrCustom(SIGN_EXTEND, TruncVT, false) && self.TLI.isOperationLegalOrCustom(TRUNCATE, VT, false) && self.TLI.isTruncateFree(VT, TruncVT) {
                let mut Amt: SDValue = self.DAG.getShiftAmountConstant(ShiftAmt, VT, DL);
                let mut Shift: SDValue = self.DAG.getNode(SRL, DL, VT, N0.getOperand(0), Amt);
                let mut Trunc: SDValue = self.DAG.getNode(TRUNCATE, DL, TruncVT, Shift);
                return self.DAG.getNode(SIGN_EXTEND, DL, N.getValueType(0), Trunc);
            }
        }
    }
    if (N0.getOpcode() == ADD || N0.getOpcode() == SUB) && N1C && N0.hasOneUse() {
        let mut IsAdd: bool = N0.getOpcode() == ADD;
        let mut Shl: SDValue = N0.getOperand(if IsAdd { 0 } else { 1 });
        if Shl.getOpcode() == SHL && Shl.getOperand(1) == N1 && Shl.hasOneUse() {
            if isConstOrConstSplat(N0.getOperand(if IsAdd { 1 } else { 0 }), false, false) {
                AddC;
            } else {
                let mut Ctx: *mut LLVMContext = *self.DAG.getContext();
                let mut ShiftAmt: u32 = N1C.getZExtValue();
                let mut TruncVT: EVT = VT.changeElementType(Ctx, getIntegerVT(Ctx, OpSizeInBits - ShiftAmt));
                if TruncVT.isSimple() && self.isTypeLegal(TruncVT) && self.TLI.isTruncateFree(VT, TruncVT) {
                    let mut Trunc: SDValue = self.DAG.getZExtOrTrunc(Shl.getOperand(0), DL, TruncVT);
                    let mut ShiftC: SDValue = self.DAG.getConstant(AddC.getAPIntValue().lshr(ShiftAmt).trunc(TruncVT.getScalarSizeInBits()), DL, TruncVT, false, false);
                    let mut Add: SDValue = SDValue {};
                    if IsAdd {
                        Add = self.DAG.getNode(ADD, DL, TruncVT, Trunc, ShiftC);
                    } else {
                        Add = self.DAG.getNode(SUB, DL, TruncVT, ShiftC, Trunc);
                    }
                    return self.DAG.getSExtOrTrunc(Add, DL, VT);
                }
            }
        }
    }
    if N1.getOpcode() == TRUNCATE && N1.getOperand(0).getOpcode() == AND {
        if self.distributeTruncateThroughAnd(N1.getNode()) {
            NewOp1;
        } else {
            return self.DAG.getNode(SRA, DL, VT, N0, NewOp1);
        }
    }
    if N0.getOpcode() == TRUNCATE && (N0.getOperand(0).getOpcode() == SRL || N0.getOperand(0).getOpcode() == SRA) && N0.getOperand(0).hasOneUse() && N0.getOperand(0).getOperand(1).hasOneUse() && N1C {
        let mut N0Op0: SDValue = N0.getOperand(0);
        if isConstOrConstSplat(N0Op0.getOperand(1), false, false) {
            LargeShift;
        } else {
            let mut LargeVT: EVT = N0Op0.getValueType();
            let mut TruncBits: u32 = LargeVT.getScalarSizeInBits() - OpSizeInBits;
            if LargeShift.getAPIntValue() == TruncBits {
                let mut LargeShiftVT: EVT = self.getShiftAmountTy(LargeVT);
                let mut Amt: SDValue = self.DAG.getZExtOrTrunc(N1, DL, LargeShiftVT);
                Amt = self.DAG.getNode(ADD, DL, LargeShiftVT, Amt, self.DAG.getConstant(TruncBits, DL, LargeShiftVT, false, false));
                let mut SRA: SDValue = self.DAG.getNode(SRA, DL, LargeVT, N0Op0.getOperand(0), Amt);
                return self.DAG.getNode(TRUNCATE, DL, VT, SRA);
            }
        }
    }
    if N1C && N0.hasOneUse() && N0.getOpcode() == ADD && operator(N0).getFlags().hasNoSignedWrap() {
        if isConstOrConstSplat(N0.getOperand(1), false, false) {
            AddC;
        } else {
            let mut ShAmt: *APInt = N1C.getAPIntValue();
            let mut AddVal: *APInt = AddC.getAPIntValue();
            if ShAmt.ult(AddVal.countr_zero()) {
                let mut ShiftFlags: SDNodeFlags = N.getFlags();
                let mut NewSra: SDValue = self.DAG.getNode(SRA, DL, VT, N0.getOperand(0), N1, ShiftFlags);
                let mut NewC: SDValue = self.DAG.getConstant(AddVal.ashr(ShAmt), DL, VT, false, false);
                let mut AddFlags: SDNodeFlags = operator(N0).getFlags();
                return self.DAG.getNode(ADD, DL, VT, NewSra, NewC, AddFlags);
            }
        }
    }
    if self.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if self.DAG.SignBitIsZero(N0, 0) {
        return self.DAG.getNode(SRL, DL, VT, N0, N1);
    }
    if N1C && !N1C.isOpaque() {
        if self.visitShiftByConstant(N) {
            NewSRA;
        } else {
            return NewSRA;
        }
    }
    if combineShiftToMULH(N, DL, self.DAG, self.TLI) {
        MULH;
    } else {
        return MULH;
    }
    if self.reduceLoadWidth(N) {
        NarrowLoad;
    } else {
        return NarrowLoad;
    }
    if self.foldShiftToAvg(N, DL) {
        AVG;
    } else {
        return AVG;
    }
    return SDValue {};
}

fn DAGCombiner::visitSRL(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    if self.DAG.simplifyShift(N0, N1) {
        V;
    } else {
        return V;
    }
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: EVT = N0.getValueType();
    let mut ShiftVT: EVT = N1.getValueType();
    let mut OpSizeInBits: u32 = VT.getScalarSizeInBits();
    if self.DAG.FoldConstantArithmetic(SRL, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if VT.isVector() {
        if self.SimplifyVBinOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
    }
    if self.foldBinOpIntoSelect(N) {
        NewSel;
    } else {
        return NewSel;
    }
    let mut N1C: *mut ConstantSDNode = isConstOrConstSplat(N1, false, false);
    if N1C && self.DAG.MaskedValueIsZero(SDValue { Node: N, ResNo: 0 }, getAllOnes(OpSizeInBits), 0) {
        return self.DAG.getConstant(0, DL, VT, false, false);
    }
    if N0.getOpcode() == SRL {
        let mut MatchOutOfRange: Closure_39 = Closure_39 { OpSizeInBits: OpSizeInBits };
        if matchBinaryPredicate(N1, N0.getOperand(1), function<bool (ConstantSDNode *, ConstantSDNode *)> { MatchOutOfRange }, false, false) {
            return self.DAG.getConstant(0, DL, VT, false, false);
        }
        let mut MatchInRange: Closure_40 = Closure_40 { OpSizeInBits: OpSizeInBits };
        if matchBinaryPredicate(N1, N0.getOperand(1), function<bool (ConstantSDNode *, ConstantSDNode *)> { MatchInRange }, false, false) {
            let mut Sum: SDValue = self.DAG.getNode(ADD, DL, ShiftVT, N1, N0.getOperand(1));
            return self.DAG.getNode(SRL, DL, VT, N0.getOperand(0), Sum);
        }
    }
    if N1C && N0.getOpcode() == TRUNCATE && N0.getOperand(0).getOpcode() == SRL {
        let mut InnerShift: SDValue = N0.getOperand(0);
        if isConstOrConstSplat(InnerShift.getOperand(1), false, false) {
            N001C;
        } else {
            let mut c1: u64 = N001C.getZExtValue();
            let mut c2: u64 = N1C.getZExtValue();
            let mut InnerShiftVT: EVT = InnerShift.getValueType();
            let mut ShiftAmtVT: EVT = InnerShift.getOperand(1).getValueType();
            let mut InnerShiftSize: u64 = InnerShiftVT.getScalarSizeInBits();
            if c1 + OpSizeInBits == InnerShiftSize {
                if c1 + c2 >= InnerShiftSize {
                    return self.DAG.getConstant(0, DL, VT, false, false);
                }
                let mut NewShiftAmt: SDValue = self.DAG.getConstant(c1 + c2, DL, ShiftAmtVT, false, false);
                let mut NewShift: SDValue = self.DAG.getNode(SRL, DL, InnerShiftVT, InnerShift.getOperand(0), NewShiftAmt);
                return self.DAG.getNode(TRUNCATE, DL, VT, NewShift);
            }
            if N0.hasOneUse() && InnerShift.hasOneUse() && c1 + c2 < InnerShiftSize {
                let mut NewShiftAmt: SDValue = self.DAG.getConstant(c1 + c2, DL, ShiftAmtVT, false, false);
                let mut NewShift: SDValue = self.DAG.getNode(SRL, DL, InnerShiftVT, InnerShift.getOperand(0), NewShiftAmt);
                let mut Mask: SDValue = self.DAG.getConstant(getLowBitsSet(InnerShiftSize, OpSizeInBits - c2), DL, InnerShiftVT, false, false);
                let mut And: SDValue = self.DAG.getNode(AND, DL, InnerShiftVT, NewShift, Mask);
                return self.DAG.getNode(TRUNCATE, DL, VT, And);
            }
        }
    }
    if N0.getOpcode() == SHL {
        if N0.getOperand(1) == N1 && operator(N0).getFlags().hasNoUnsignedWrap() {
            return N0.getOperand(0);
        }
        if (N0.getOperand(1) == N1 || operator(N0).hasOneUse()) && self.TLI.shouldFoldConstantShiftPairToMask(N) {
            let mut MatchShiftAmount: Closure_41 = Closure_41 { OpSizeInBits: OpSizeInBits };
            if matchBinaryPredicate(N1, N0.getOperand(1), function<bool (ConstantSDNode *, ConstantSDNode *)> { MatchShiftAmount }, false, true) {
                let mut N01: SDValue = self.DAG.getZExtOrTrunc(N0.getOperand(1), DL, ShiftVT);
                let mut Diff: SDValue = self.DAG.getNode(SUB, DL, ShiftVT, N01, N1);
                let mut Mask: SDValue = self.DAG.getAllOnesConstant(DL, VT, false, false);
                Mask = self.DAG.getNode(SRL, DL, VT, Mask, N01);
                Mask = self.DAG.getNode(SHL, DL, VT, Mask, Diff);
                let mut Shift: SDValue = self.DAG.getNode(SHL, DL, VT, N0.getOperand(0), Diff);
                return self.DAG.getNode(AND, DL, VT, Shift, Mask);
            }
            if matchBinaryPredicate(N0.getOperand(1), N1, function<bool (ConstantSDNode *, ConstantSDNode *)> { MatchShiftAmount }, false, true) {
                let mut N01: SDValue = self.DAG.getZExtOrTrunc(N0.getOperand(1), DL, ShiftVT);
                let mut Diff: SDValue = self.DAG.getNode(SUB, DL, ShiftVT, N1, N01);
                let mut Mask: SDValue = self.DAG.getAllOnesConstant(DL, VT, false, false);
                Mask = self.DAG.getNode(SRL, DL, VT, Mask, N1);
                let mut Shift: SDValue = self.DAG.getNode(SRL, DL, VT, N0.getOperand(0), Diff);
                return self.DAG.getNode(AND, DL, VT, Shift, Mask);
            }
        }
    }
    if N1C && N0.getOpcode() == ANY_EXTEND {
        let mut SmallVT: EVT = N0.getOperand(0).getValueType();
        let mut BitSize: u32 = SmallVT.getScalarSizeInBits();
        if N1C.getAPIntValue().uge(BitSize) {
            return self.DAG.getUNDEF(VT);
        }
        if !self.LegalTypes || self.TLI.isTypeDesirableForOp(SRL, SmallVT) {
            let mut ShiftAmt: u64 = N1C.getZExtValue();
            let mut DL0: SDLoc = SDLoc { N0 };
            let mut SmallShift: SDValue = self.DAG.getNode(SRL, DL0, SmallVT, N0.getOperand(0), self.DAG.getShiftAmountConstant(ShiftAmt, SmallVT, DL0));
            self.AddToWorklist(SmallShift.getNode(), true, false);
            let mut Mask: APInt = getLowBitsSet(OpSizeInBits, OpSizeInBits - ShiftAmt);
            return self.DAG.getNode(AND, DL, VT, self.DAG.getNode(ANY_EXTEND, DL, VT, SmallShift), self.DAG.getConstant(Mask, DL, VT, false, false));
        }
    }
    if N1C && N1C.getAPIntValue() == (OpSizeInBits - 1) {
        if N0.getOpcode() == SRA {
            return self.DAG.getNode(SRL, DL, VT, N0.getOperand(0), N1);
        }
    }
    if N1C && N0.getOpcode() == CTLZ && isPowerOf2_32(OpSizeInBits) && N1C.getAPIntValue() == Log2_32(OpSizeInBits) {
        let mut Known: KnownBits = self.DAG.computeKnownBits(N0.getOperand(0), 0);
        if Known.One.getBoolValue() {
            return self.DAG.getConstant(0, SDLoc { N0 }, VT, false, false);
        }
        let mut UnknownBits: APInt = operator(Known.Zero);
        if UnknownBits == 0 {
            return self.DAG.getConstant(1, SDLoc { N0 }, VT, false, false);
        }
        if UnknownBits.isPowerOf2() {
            let mut ShAmt: u32 = UnknownBits.countr_zero();
            let mut Op: SDValue = N0.getOperand(0);
            if ShAmt {
                let mut DL: SDLoc = SDLoc { N0 };
                Op = self.DAG.getNode(SRL, DL, VT, Op, self.DAG.getShiftAmountConstant(ShAmt, VT, DL));
                self.AddToWorklist(Op.getNode(), true, false);
            }
            return self.DAG.getNode(XOR, DL, VT, Op, self.DAG.getConstant(1, DL, VT, false, false));
        }
    }
    if N1.getOpcode() == TRUNCATE && N1.getOperand(0).getOpcode() == AND {
        if self.distributeTruncateThroughAnd(N1.getNode()) {
            NewOp1;
        } else {
            return self.DAG.getNode(SRL, DL, VT, N0, NewOp1);
        }
    }
    let mut X: SDValue = SDValue {};
    let mut ZExtY: SDValue = SDValue {};
    if sd_match(N0, m_OneUse(m_BitwiseLogic(m_Value(X), m_OneUse(m_Shl(m_Value(ZExtY, m_SpecificOpc(ZERO_EXTEND)), m_Specific(N1)))))) {
        let mut NumLeadingZeros: u32 = ZExtY.getScalarValueSizeInBits() - ZExtY.getOperand(0).getScalarValueSizeInBits();
        if N1C && N1C.getZExtValue() <= NumLeadingZeros {
            return self.DAG.getNode(N0.getOpcode(), SDLoc { N0 }, VT, self.DAG.getNode(SRL, SDLoc { N0 }, VT, X, N1), ZExtY);
        }
    }
    if N1C && VT.isScalarInteger() && self.DAG.getDataLayout().isLittleEndian() {
        let mut BV: SDValue = peekThroughBitcasts(N0);
        if BV.getOpcode() == BUILD_VECTOR {
            let mut BVVT: EVT = BV.getValueType();
            let mut EltSizeInBits: u32 = BVVT.getScalarSizeInBits();
            let mut NumElts: u32 = BVVT.getVectorNumElements();
            if N1C.getZExtValue() == (NumElts - 1) * EltSizeInBits {
                let mut LastElt: SDValue = BV.getOperand(NumElts - 1);
                assert!(LastElt.getScalarValueSizeInBits() >= EltSizeInBits, "Expected BUILD_VECTOR operand as wide as element type");
                let mut IntEltVT: EVT = LastElt.getValueType().changeTypeToInteger();
                if !self.LegalTypes || self.TLI.isTypeLegal(IntEltVT) {
                    LastElt = self.DAG.getBitcast(IntEltVT, LastElt);
                    let mut Ext: SDValue = self.DAG.getZExtOrTrunc(LastElt, DL, VT);
                    let mut Mask: APInt = getLowBitsSet(VT.getSizeInBits().operator unsigned long long(), EltSizeInBits);
                    return self.DAG.getNode(AND, DL, VT, Ext, self.DAG.getConstant(Mask, DL, VT, false, false));
                }
            }
        }
    }
    if N1C && N0.hasOneUse() && N0.getOpcode() == ADD && operator(N0).getFlags().hasNoUnsignedWrap() {
        if isConstOrConstSplat(N0.getOperand(1), false, false) {
            AddC;
        } else {
            let mut ShAmt: *APInt = N1C.getAPIntValue();
            let mut AddVal: *APInt = AddC.getAPIntValue();
            if ShAmt.ult(AddVal.countr_zero()) {
                let mut ShiftFlags: SDNodeFlags = N.getFlags();
                let mut NewSrl: SDValue = self.DAG.getNode(SRL, DL, VT, N0.getOperand(0), N1, ShiftFlags);
                let mut NewC: SDValue = self.DAG.getConstant(AddVal.lshr(ShAmt), DL, VT, false, false);
                let mut AddFlags: SDNodeFlags = operator(N0).getFlags();
                return self.DAG.getNode(ADD, DL, VT, NewSrl, NewC, AddFlags);
            }
        }
    }
    if self.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if N1C && !N1C.isOpaque() {
        if self.visitShiftByConstant(N) {
            NewSRL;
        } else {
            return NewSRL;
        }
    }
    if self.reduceLoadWidth(N) {
        NarrowLoad;
    } else {
        return NarrowLoad;
    }
    if N.hasOneUse() {
        let mut User: *mut SDNode = operator(N.user_begin());
        if User.getOpcode() == TRUNCATE && User.hasOneUse() {
            User = operator(User.user_begin());
        }
        if User.getOpcode() == BRCOND || User.getOpcode() == AND || User.getOpcode() == OR || User.getOpcode() == XOR {
            self.AddToWorklist(User, true, false);
        }
    }
    if combineShiftToMULH(N, DL, self.DAG, self.TLI) {
        MULH;
    } else {
        return MULH;
    }
    if self.foldShiftToAvg(N, DL) {
        AVG;
    } else {
        return AVG;
    }
    let mut Y: SDValue = SDValue {};
    if VT.getScalarSizeInBits() % 2 == 0 && N1C {
        let mut HalfBW: u32 = VT.getScalarSizeInBits() / 2;
        if sd_match(N0, m_Clmul(m_ZExt(m_Value(X)), m_ZExt(m_Value(Y)))) && X.getScalarValueSizeInBits() == HalfBW && Y.getScalarValueSizeInBits() == HalfBW {
            if N1C.getZExtValue() == HalfBW - 1 && (!self.LegalOperations || self.TLI.isOperationLegalOrCustom(CLMULR, X.getValueType(), false)) {
                return self.DAG.getNode(ZERO_EXTEND, DL, VT, self.DAG.getNode(CLMULR, DL, X.getValueType(), X, Y));
            }
            if N1C.getZExtValue() == HalfBW && (!self.LegalOperations || self.TLI.isOperationLegalOrCustom(CLMULH, X.getValueType(), false)) {
                return self.DAG.getNode(ZERO_EXTEND, DL, VT, self.DAG.getNode(CLMULH, DL, X.getValueType(), X, Y));
            }
        }
    }
    if N1C && N1C.getZExtValue() == 1 && sd_match(N0, m_BitReverse(m_Clmul(m_BitReverse(m_Value(X)), m_BitReverse(m_Value(Y))))) {
        return self.DAG.getNode(CLMULH, DL, VT, X, Y);
    }
    return SDValue {};
}

fn DAGCombiner::visitFunnelShift(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut N2: SDValue = N.getOperand(2);
    let mut IsFSHL: bool = N.getOpcode() == FSHL;
    let mut BitWidth: u32 = VT.getScalarSizeInBits();
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(N.getOpcode(), DL, VT, ArrayRef<SDValue> { [N0, N1, N2] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if isPowerOf2_32(BitWidth) {
        if self.DAG.MaskedValueIsZero(N2, APInt { N2.getScalarValueSizeInBits(), BitWidth - 1, false, false }, 0) {
            return if IsFSHL { N0 } else { N1 };
        }
    }
    let mut IsUndefOrZero: Closure_42 = Closure_42 {};
    if isConstOrConstSplat(N2, false, false) {
        Cst;
    } else {
        let mut ShAmtTy: EVT = N2.getValueType();
        if Cst.getAPIntValue().uge(BitWidth) {
            let mut RotAmt: u64 = Cst.getAPIntValue().urem(BitWidth);
            return self.DAG.getNode(N.getOpcode(), DL, VT, N0, N1, self.DAG.getConstant(RotAmt, DL, ShAmtTy, false, false));
        }
        let mut ShAmt: u32 = Cst.getZExtValue();
        if ShAmt == 0 {
            return if IsFSHL { N0 } else { N1 };
        }
        if IsUndefOrZero.call(N0) {
            return self.DAG.getNode(SRL, DL, VT, N1, self.DAG.getConstant(if IsFSHL { BitWidth - ShAmt } else { ShAmt }, DL, ShAmtTy, false, false));
        }
        if IsUndefOrZero.call(N1) {
            return self.DAG.getNode(SHL, DL, VT, N0, self.DAG.getConstant(if IsFSHL { ShAmt } else { BitWidth - ShAmt }, DL, ShAmtTy, false, false));
        }
        assert!(ShAmt >= 1 && ShAmt < BitWidth, "ShAmt must be in [1, BW-1] for the identity fold to be valid");
        let mut Val: SDValue = SDValue {};
        let mut C0Expected: u32 = if IsFSHL { ShAmt } else { BitWidth - ShAmt };
        let mut C1Expected: u32 = if IsFSHL { BitWidth - ShAmt } else { ShAmt };
        if (sd_match(N0, m_Srl(m_Value(Val), m_SpecificInt(C0Expected))) || sd_match(N0, m_Node(FSHR, m_Value(), m_Value(Val), m_SpecificInt(C0Expected))) || sd_match(N0, m_Node(FSHL, m_Value(), m_Value(Val), m_SpecificInt(C1Expected)))) && (sd_match(N1, m_Shl(m_Specific(Val), m_SpecificInt(C1Expected))) || sd_match(N1, m_Node(FSHL, m_Specific(Val), m_Value(), m_SpecificInt(C1Expected))) || sd_match(N1, m_Node(FSHR, m_Specific(Val), m_Value(), m_SpecificInt(C0Expected)))) {
            return Val;
        }
        if (BitWidth % 8) == 0 && (ShAmt % 8) == 0 && !VT.isVector() && !self.DAG.getDataLayout().isBigEndian() {
            let mut LHS: *mut LoadSDNode = dyn_cast(N0);
            let mut RHS: *mut LoadSDNode = dyn_cast(N1);
            if LHS && RHS && LHS.isSimple() && RHS.isSimple() && LHS.getAddressSpace() == RHS.getAddressSpace() && (LHS.hasNUsesOfValue(1, 0) || RHS.hasNUsesOfValue(1, 0)) && isNON_EXTLoad(RHS) && isNON_EXTLoad(LHS) {
                if self.DAG.areNonVolatileConsecutiveLoads(LHS, RHS, BitWidth / 8, 1) {
                    let mut DL: SDLoc = SDLoc { RHS };
                    let mut PtrOff: u64 = if IsFSHL { (((BitWidth - ShAmt) % BitWidth) / 8) } else { (ShAmt / 8) };
                    let mut NewAlign: Align = commonAlignment(RHS.getAlign(), PtrOff);
                    let mut Fast: u32 = 0;
                    if self.TLI.allowsMemoryAccess(*self.DAG.getContext(), self.DAG.getDataLayout(), VT, RHS.getAddressSpace(), NewAlign, RHS.getMemOperand().getFlags(), &mut Fast) && Fast {
                        let mut NewPtr: SDValue = self.DAG.getMemBasePlusOffset(RHS.getBasePtr(), getFixed(PtrOff), DL, SDNodeFlags { Flags: None });
                        self.AddToWorklist(NewPtr.getNode(), true, false);
                        let mut Load: SDValue = self.DAG.getLoad(VT, DL, RHS.getChain(), NewPtr, RHS.getPointerInfo().getWithOffset(PtrOff), MaybeAlign { NewAlign }, RHS.getMemOperand().getFlags(), MMOMetadata { AAInfo: RHS.getAAInfo(), Ranges: null, MemCacheHint: null });
                        self.DAG.makeEquivalentMemoryOrdering(LHS, Load.getValue(1));
                        self.DAG.makeEquivalentMemoryOrdering(RHS, Load.getValue(1));
                        return Load;
                    }
                }
            }
        }
    }
    if isPowerOf2_32(BitWidth) {
        let mut ModuloBits: APInt = APInt { N2.getScalarValueSizeInBits(), BitWidth - 1, false, false };
        if IsUndefOrZero.call(N0) && !IsFSHL && self.DAG.MaskedValueIsZero(N2, operator(ModuloBits), 0) {
            return self.DAG.getNode(SRL, DL, VT, N1, N2);
        }
        if IsUndefOrZero.call(N1) && IsFSHL && self.DAG.MaskedValueIsZero(N2, operator(ModuloBits), 0) {
            return self.DAG.getNode(SHL, DL, VT, N0, N2);
        }
    }
    let mut RotOpc: u32 = if IsFSHL { ROTL } else { ROTR };
    if N0 == N1 && self.hasOperation(RotOpc, VT) {
        return self.DAG.getNode(RotOpc, DL, VT, N0, N2);
    }
    if self.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn DAGCombiner::visitSHLSAT(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    if self.DAG.simplifyShift(N0, N1) {
        V;
    } else {
        return V;
    }
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: EVT = N0.getValueType();
    if self.DAG.FoldConstantArithmetic(N.getOpcode(), DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    let mut N1C: *mut ConstantSDNode = isConstOrConstSplat(N1, false, false);
    if !self.LegalOperations || self.TLI.isOperationLegalOrCustom(SHL, VT, false) {
        if N.getOpcode() == SSHLSAT && N1C && N1C.getAPIntValue().ult(self.DAG.ComputeNumSignBits(N0, 0)) {
            return self.DAG.getNode(SHL, DL, VT, N0, N1);
        }
        if N.getOpcode() == USHLSAT && N1C && N1C.getAPIntValue().ule(self.DAG.computeKnownBits(N0, 0).countMinLeadingZeros()) {
            return self.DAG.getNode(SHL, DL, VT, N0, N1);
        }
    }
    return SDValue {};
}

fn DAGCombiner::foldABSToABD(self, N: *mut SDNode, DL: *SDLoc) -> SDValue {
    let mut SrcVT: EVT = N.getValueType(0);
    if N.getOpcode() == TRUNCATE {
        N = N.getOperand(0).getNode();
    }
    let mut VT: EVT = N.getValueType(0);
    let mut Op0: SDValue = SDValue {};
    let mut Op1: SDValue = SDValue {};
    if !sd_match(N, m_Abs(m_AnyOf(m_Sub(m_Value(Op0), m_Value(Op1)), m_Add(m_Value(Op0), m_Value(Op1))))) {
        return SDValue {};
    }
    let mut AbsOp0: SDValue = N.getOperand(0);
    let mut IsAdd: bool = AbsOp0.getOpcode() == ADD;
    if IsAdd {
        let mut IsNotMinSignedInt: Closure_43 = Closure_43 { cap_0: VT };
        if !matchUnaryPredicate(Op1, function<bool (ConstantSDNode *)> { IsNotMinSignedInt }, true, true) {
            return SDValue {};
        }
    }
    let mut Opc0: u32 = Op0.getOpcode();
    if Opc0 != Op1.getOpcode() || (Opc0 != ZERO_EXTEND && Opc0 != SIGN_EXTEND && Opc0 != SIGN_EXTEND_INREG) {
        let mut CreateZextedAbd: Closure_44 = Closure_44 { IsAdd: &mut IsAdd, Op1: &mut Op1, cap_2: self, VT: &mut VT, DL: &mut DL, Op0: &mut Op0, SrcVT: &mut SrcVT };
        let mut AbsOpWillNSW: bool = operator(AbsOp0).getFlags().hasNoSignedWrap() || (if IsAdd { self.DAG.willNotOverflowAdd(true, Op0, Op1) } else { self.DAG.willNotOverflowSub(true, Op0, Op1) });
        if self.hasOperation(ABDS, VT) && self.TLI.preferABDSToABSWithNSW(VT) && AbsOpWillNSW {
            return CreateZextedAbd.call(ABDS);
        }
        let mut AbsOpWillNUW: bool = !IsAdd && self.DAG.SignBitIsZero(Op0, 0) && self.DAG.SignBitIsZero(Op1, 0);
        if self.hasOperation(ABDU, VT) && AbsOpWillNUW {
            return CreateZextedAbd.call(ABDU);
        }
        return SDValue {};
    }
    assert!(!IsAdd, "Unexpected abs(add(x,y)) pattern");
    let mut VT0: EVT = EVT {};
    let mut VT1: EVT = EVT {};
    if Opc0 == SIGN_EXTEND_INREG {
        VT0 = cast(Op0.getOperand(1)).getVT();
        VT1 = cast(Op1.getOperand(1)).getVT();
    } else {
        VT0 = Op0.getOperand(0).getValueType();
        VT1 = Op1.getOperand(0).getValueType();
    }
    let mut ABDOpcode: u32 = if (Opc0 == ZERO_EXTEND) { ABDU } else { ABDS };
    let mut MaxVT: EVT = if VT0.bitsGT(VT1) { VT0 } else { VT1 };
    if (VT0 == MaxVT || operator(Op0).hasOneUse()) && (VT1 == MaxVT || operator(Op1).hasOneUse()) && (!self.LegalTypes || self.hasOperation(ABDOpcode, MaxVT)) {
        let mut ABD: SDValue = self.DAG.getNode(ABDOpcode, DL, MaxVT, self.DAG.getNode(TRUNCATE, DL, MaxVT, Op0), self.DAG.getNode(TRUNCATE, DL, MaxVT, Op1));
        ABD = self.DAG.getNode(ZERO_EXTEND, DL, VT, ABD);
        return self.DAG.getZExtOrTrunc(ABD, DL, SrcVT);
    }
    if !self.LegalOperations || self.hasOperation(ABDOpcode, VT) {
        let mut ABD: SDValue = self.DAG.getNode(ABDOpcode, DL, VT, Op0, Op1);
        return self.DAG.getZExtOrTrunc(ABD, DL, SrcVT);
    }
    return SDValue {};
}

fn DAGCombiner::visitABS(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(ABS, DL, VT, ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if isAbsOpcode(N0.getOpcode()) {
        return N0;
    }
    if self.DAG.SignBitIsZero(N0, 0) {
        return N0;
    }
    if self.foldABSToABD(N, DL) {
        ABD;
    } else {
        return ABD;
    }
    if N0.getOpcode() == SIGN_EXTEND_INREG {
        let mut ExtVT: EVT = cast(N0.getOperand(1)).getVT();
        if self.TLI.isTruncateFree(VT, ExtVT) && self.TLI.isZExtFree(ExtVT, VT) && self.TLI.isTypeDesirableForOp(ABS, ExtVT) && self.hasOperation(ABS, ExtVT) {
            return self.DAG.getNode(ZERO_EXTEND, DL, VT, self.DAG.getNode(ABS, DL, ExtVT, self.DAG.getNode(TRUNCATE, DL, ExtVT, N0.getOperand(0))));
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitABS_MIN_POISON(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(ABS_MIN_POISON, DL, VT, ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if isAbsOpcode(peekThroughFreeze(N0).getOpcode()) {
        return N0;
    }
    if self.DAG.SignBitIsZero(N0, 0) {
        return N0;
    }
    if self.foldABSToABD(N, DL) {
        ABD;
    } else {
        return ABD;
    }
    if N0.getOpcode() == SIGN_EXTEND_INREG {
        let mut ExtVT: EVT = cast(N0.getOperand(1)).getVT();
        if self.TLI.isTruncateFree(VT, ExtVT) && self.TLI.isZExtFree(ExtVT, VT) && self.TLI.isTypeDesirableForOp(ABS, ExtVT) && self.hasOperation(ABS, ExtVT) {
            return self.DAG.getNode(ZERO_EXTEND, DL, VT, self.DAG.getNode(ABS, DL, ExtVT, self.DAG.getNode(TRUNCATE, DL, ExtVT, N0.getOperand(0))));
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitCLMUL(self, N: *mut SDNode) -> SDValue {
    let mut Opcode: u32 = N.getOpcode();
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(Opcode, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if self.DAG.isConstantIntBuildVectorOrConstantInt(N0, true) && !self.DAG.isConstantIntBuildVectorOrConstantInt(N1, true) {
        return self.DAG.getNode(Opcode, DL, VT, N1, N0);
    }
    if isNullConstant(N1) || isConstantSplatVectorAllZeros(N1.getNode(), false) {
        return self.DAG.getConstant(0, DL, VT, false, false);
    }
    if Opcode == CLMUL {
        if isConstOrConstSplat(N1, false, false) {
            C;
        } else {
            let mut CV: APInt = C.getAPIntValue().trunc(VT.getScalarSizeInBits());
            if CV.isPowerOf2() && (!self.LegalOperations || self.TLI.isOperationLegal(SHL, VT)) {
                return self.DAG.getNode(SHL, DL, VT, N0, self.DAG.getShiftAmountConstant(CV.logBase2(), VT, DL));
            }
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitPEXT(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut DL: SDLoc = SDLoc { N };
    if isNullOrNullSplat(N1, false) {
        return self.DAG.getConstant(0, DL, VT, false, false);
    }
    if isAllOnesOrAllOnesSplat(N1, false) {
        return N0;
    }
    if self.DAG.FoldConstantArithmetic(PEXT, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    return SDValue {};
}

fn DAGCombiner::visitPDEP(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut DL: SDLoc = SDLoc { N };
    if isNullOrNullSplat(N1, false) {
        return self.DAG.getConstant(0, DL, VT, false, false);
    }
    if isAllOnesOrAllOnesSplat(N1, false) {
        return N0;
    }
    if self.DAG.FoldConstantArithmetic(PDEP, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if self.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn DAGCombiner::visitBSWAP(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(BSWAP, DL, VT, ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if N0.getOpcode() == BSWAP {
        return N0.getOperand(0);
    }
    if N0.getOpcode() == BITREVERSE && N0.hasOneUse() {
        let mut BSwap: SDValue = self.DAG.getNode(BSWAP, DL, VT, N0.getOperand(0));
        return self.DAG.getNode(BITREVERSE, DL, VT, BSwap);
    }
    let mut BW: u32 = VT.getScalarSizeInBits();
    if BW >= 32 && N0.getOpcode() == SHL && N0.hasOneUse() {
        let mut ShAmt: *mut ConstantSDNode = dyn_cast(N0.getOperand(1));
        let mut HalfVT: EVT = getIntegerVT(*self.DAG.getContext(), BW / 2);
        if ShAmt && ShAmt.getAPIntValue().ult(BW) && ShAmt.getZExtValue() >= (BW / 2) && (ShAmt.getZExtValue() % 8) == 0 && self.TLI.isTypeLegal(HalfVT) && self.TLI.isTruncateFree(VT, HalfVT) && (!self.LegalOperations || self.hasOperation(BSWAP, HalfVT)) {
            let mut Res: SDValue = N0.getOperand(0);
            if (ShAmt.getZExtValue() - (BW / 2)) {
                NewShAmt;
            } else {
                Res = self.DAG.getNode(SHL, DL, VT, Res, self.DAG.getShiftAmountConstant(NewShAmt, VT, DL));
            }
            Res = self.DAG.getZExtOrTrunc(Res, DL, HalfVT);
            Res = self.DAG.getNode(BSWAP, DL, HalfVT, Res);
            return self.DAG.getZExtOrTrunc(Res, DL, VT);
        }
    }
    if (N0.getOpcode() == SHL || N0.getOpcode() == SRL) && N0.hasOneUse() {
        let mut ShAmt: *mut ConstantSDNode = dyn_cast(N0.getOperand(1));
        if ShAmt && ShAmt.getAPIntValue().ult(BW) && ShAmt.getZExtValue() % 8 == 0 {
            let mut NewSwap: SDValue = self.DAG.getNode(BSWAP, DL, VT, N0.getOperand(0));
            let mut InverseShift: u32 = if N0.getOpcode() == SHL { SRL } else { SHL };
            return self.DAG.getNode(InverseShift, DL, VT, NewSwap, N0.getOperand(1));
        }
    }
    if foldBitOrderCrossLogicOp(N, self.DAG) {
        V;
    } else {
        return V;
    }
    let mut Known: KnownBits = self.DAG.computeKnownBits(N0, 0);
    if Known.isZero() {
        return self.DAG.getConstant(0, DL, VT, false, false);
    }
    let mut TZ: u32 = alignDown(Known.countMinTrailingZeros(), 8, 0);
    let mut LZ: u32 = alignDown(Known.countMinLeadingZeros(), 8, 0);
    if BW - (LZ + TZ) == 8 {
        let mut Opc: u32 = if LZ > TZ { SHL } else { SRL };
        if !self.LegalOperations || self.hasOperation(Opc, VT) {
            let mut Amt: u32 = AbsoluteDifference(LZ, TZ);
            let mut Flags: SDNodeFlags = SDNodeFlags { Flags: if Opc == SHL { NoUnsignedWrap } else { Exact } };
            return self.DAG.getNode(Opc, DL, VT, N0, self.DAG.getShiftAmountConstant(Amt, VT, DL), Flags);
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitBITREVERSE(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(BITREVERSE, DL, VT, ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if N0.getOpcode() == BITREVERSE {
        return N0.getOperand(0);
    }
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    if (!self.LegalOperations || self.TLI.isOperationLegal(SHL, VT)) && sd_match(N0, m_Srl(m_BitReverse(m_Value(X)), m_Value(Y))) {
        return self.DAG.getNode(SHL, DL, VT, X, Y);
    }
    if (!self.LegalOperations || self.TLI.isOperationLegal(SRL, VT)) && sd_match(N0, m_Shl(m_BitReverse(m_Value(X)), m_Value(Y))) {
        return self.DAG.getNode(SRL, DL, VT, X, Y);
    }
    if (!self.LegalOperations || self.TLI.isOperationLegalOrCustom(CLMULR, VT, false)) && sd_match(N0, m_Clmul(m_BitReverse(m_Value(X)), m_BitReverse(m_Value(Y)))) {
        return self.DAG.getNode(CLMULR, DL, VT, X, Y);
    }
    return SDValue {};
}

fn DAGCombiner::foldCTLZToCTLS(self, Src: SDValue, DL: *SDLoc) -> SDValue {
    let mut VT: EVT = Src.getValueType();
    let mut LK: LegalizeKind = self.TLI.getTypeConversion(*self.DAG.getContext(), VT);
    if (LK.first != TypeLegal && LK.first != TypePromoteInteger) || !self.TLI.isOperationLegalOrCustom(CTLS, LK.second, false) {
        return SDValue {};
    }
    let mut BitWidth: u32 = VT.getScalarSizeInBits();
    let mut NeedAdd: bool = true;
    let mut X: SDValue = SDValue {};
    if sd_match(Src, m_OneUse(m_Or(m_OneUse(m_Shl(m_Value(X), m_One(false))), m_One(false)))) {
        NeedAdd = false;
        Src = X;
    }
    if !sd_match(Src, m_OneUse(m_Xor(m_Value(X), m_OneUse(m_Sra(m_Deferred(X), m_SpecificInt(BitWidth - 1)))))) {
        return SDValue {};
    }
    let mut Res: SDValue = self.DAG.getNode(CTLS, DL, VT, X);
    if !NeedAdd {
        return Res;
    }
    return self.DAG.getNode(ADD, DL, VT, Res, self.DAG.getConstant(1, DL, VT, false, false));
}

fn DAGCombiner::visitCTLZ(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(CTLZ, DL, VT, ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if !self.LegalOperations || self.TLI.isOperationLegal(CTLZ_ZERO_POISON, VT) {
        if self.DAG.isKnownNeverZero(N0, 0) {
            return self.DAG.getNode(CTLZ_ZERO_POISON, DL, VT, N0);
        }
    }
    if self.foldCTLZToCTLS(N0, DL) {
        V;
    } else {
        return V;
    }
    return SDValue {};
}

fn DAGCombiner::visitCTLZ_ZERO_POISON(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(CTLZ_ZERO_POISON, DL, VT, ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if self.foldCTLZToCTLS(N0, DL) {
        V;
    } else {
        return V;
    }
    return SDValue {};
}

fn DAGCombiner::visitCTTZ(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(CTTZ, DL, VT, ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if !self.LegalOperations || self.TLI.isOperationLegal(CTTZ_ZERO_POISON, VT) {
        if self.DAG.isKnownNeverZero(N0, 0) {
            return self.DAG.getNode(CTTZ_ZERO_POISON, DL, VT, N0);
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitCTTZ_ZERO_POISON(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(CTTZ_ZERO_POISON, DL, VT, ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    return SDValue {};
}

fn DAGCombiner::visitPARITY(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    if self.DAG.FoldConstantArithmetic(PARITY, SDLoc { N }, VT, ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    return SDValue {};
}

fn DAGCombiner::visitCTPOP(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut NumBits: u32 = VT.getScalarSizeInBits();
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(CTPOP, DL, VT, ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if N0.getOpcode() == SRL || N0.getOpcode() == SHL {
        if isConstOrConstSplat(N0.getOperand(1), false, false) {
            AmtC;
        } else {
            let mut Amt: *APInt = AmtC.getAPIntValue();
            if Amt.ult(NumBits) {
                let mut KnownSrc: KnownBits = self.DAG.computeKnownBits(N0.getOperand(0), 0);
                if (N0.getOpcode() == SRL && Amt.ule(KnownSrc.countMinTrailingZeros())) || (N0.getOpcode() == SHL && Amt.ule(KnownSrc.countMinLeadingZeros())) {
                    return self.DAG.getNode(CTPOP, DL, VT, N0.getOperand(0));
                }
            }
        }
    }
    if VT.isScalarInteger() && NumBits > 8 && (NumBits & 1) == 0 {
        let mut HalfVT: EVT = getIntegerVT(*self.DAG.getContext(), NumBits / 2);
        if self.hasOperation(CTPOP, HalfVT) && self.TLI.isTypeDesirableForOp(CTPOP, HalfVT) && self.TLI.isTruncateFree(N0, HalfVT) && self.TLI.isZExtFree(HalfVT, VT) {
            let mut UpperBits: APInt = getHighBitsSet(NumBits, NumBits / 2);
            if self.DAG.MaskedValueIsZero(N0, UpperBits, 0) {
                let mut PopCnt: SDValue = self.DAG.getNode(CTPOP, DL, HalfVT, self.DAG.getZExtOrTrunc(N0, DL, HalfVT));
                return self.DAG.getZExtOrTrunc(PopCnt, DL, VT);
            }
        }
    }
    return SDValue {};
}

fn isLegalToCombineMinNumMaxNum(DAG: *mut SelectionDAG, LHS: SDValue, RHS: SDValue, SelectFlags: SDNodeFlags, CmpFlags: SDNodeFlags, TLI: *TargetLowering) -> bool {
    let mut VT: EVT = LHS.getValueType();
    if !VT.isFloatingPoint() {
        return false;
    }
    return SelectFlags.hasNoSignedZeros() && TLI.isProfitableToCombineMinNumMaxNum(VT) && (SelectFlags.hasNoNaNs() || CmpFlags.hasNoNaNs() || (DAG.isKnownNeverNaN(RHS, false, 0) && DAG.isKnownNeverNaN(LHS, false, 0)));
}

fn combineMinNumMaxNumImpl(DL: *SDLoc, VT: EVT, LHS: SDValue, RHS: SDValue, True: SDValue, False: SDValue, CC: CondCode, TLI: *TargetLowering, DAG: *mut SelectionDAG) -> SDValue {
    let mut TransformVT: EVT = TLI.getLegalTypeToTransformTo(*DAG.getContext(), VT);
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: NoNaNs | NoSignedZeros };
    match CC {
        SETOLT => {
            SETOLE;
        },
        SETOGT => {
            SETOGE;
        },
        _ => {
            return SDValue {};
        },
    }
}

fn DAGCombiner::foldShiftToAvg(self, N: *mut SDNode, DL: *SDLoc) -> SDValue {
    let mut Opcode: u32 = N.getOpcode();
    if Opcode != SRA && Opcode != SRL {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    let mut IsUnsigned: bool = Opcode == SRL;
    let mut A: SDValue = SDValue {};
    let mut B: SDValue = SDValue {};
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: if IsUnsigned { NoUnsignedWrap } else { NoSignedWrap } };
    if sd_match(N, m_BinOp(Opcode, m_c_BinOp(ADD, m_Value(A), m_Value(B), Flags), m_One(false), SDNodeFlags { Flags: None })) {
        let mut FloorISD: u32 = if IsUnsigned { AVGFLOORU } else { AVGFLOORS };
        if self.hasOperation(FloorISD, VT) {
            return self.DAG.getNode(FloorISD, DL, VT, ArrayRef<SDValue> { [A, B] });
        }
    }
    return SDValue {};
}

fn DAGCombiner::foldBitwiseOpWithNeg(self, N: *mut SDNode, DL: *SDLoc, VT: EVT) -> SDValue {
    let mut Opc: u32 = N.getOpcode();
    let mut X: SDValue = SDValue {};
    let mut Y: SDValue = SDValue {};
    let mut Z: SDValue = SDValue {};
    if sd_match(N, m_BitwiseLogic(m_Value(X), m_Add(m_Not(m_Value(Y)), m_Value(Z)))) {
        return self.DAG.getNode(Opc, DL, VT, X, self.DAG.getNOT(DL, self.DAG.getNode(SUB, DL, VT, Y, Z), VT));
    }
    if sd_match(N, m_BitwiseLogic(m_Value(X), m_Sub(m_OneUse(m_Not(m_Value(Y))), m_Value(Z)))) {
        return self.DAG.getNode(Opc, DL, VT, X, self.DAG.getNOT(DL, self.DAG.getNode(ADD, DL, VT, Y, Z), VT));
    }
    return SDValue {};
}

fn DAGCombiner::combineMinNumMaxNum(self, DL: *SDLoc, VT: EVT, LHS: SDValue, RHS: SDValue, True: SDValue, False: SDValue, CC: CondCode) -> SDValue {
    if (LHS == True && RHS == False) || (LHS == False && RHS == True) {
        return combineMinNumMaxNumImpl(DL, VT, LHS, RHS, True, False, CC, self.TLI, self.DAG);
    }
    let mut NegTrue: SDValue = self.TLI.getCheaperOrNeutralNegatedExpression(True, self.DAG, self.LegalOperations, self.ForCodeSize, Neutral, 0);
    if !NegTrue {
        return SDValue {};
    }
    let mut NegTrueHandle: HandleSDNode = HandleSDNode { NegTrue };
    if LHS == NegTrue {
        let mut NegRHS: SDValue = self.TLI.getCheaperOrNeutralNegatedExpression(RHS, self.DAG, self.LegalOperations, self.ForCodeSize, Neutral, 0);
        if NegRHS {
            let mut NegRHSHandle: HandleSDNode = HandleSDNode { NegRHS };
            if NegRHS == False {
                let mut Combined: SDValue = combineMinNumMaxNumImpl(DL, VT, LHS, RHS, NegTrue, False, CC, self.TLI, self.DAG);
                if Combined {
                    return self.DAG.getNode(FNEG, DL, VT, Combined);
                }
            }
        }
    }
    return SDValue {};
}

fn foldSelectOfConstantsUsingSra(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut Cond: SDValue = N.getOperand(0);
    let mut C1: SDValue = N.getOperand(1);
    let mut C2: SDValue = N.getOperand(2);
    if !isConstantOrConstantVector(C1, false, false) || !isConstantOrConstantVector(C2, false, false) {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    if Cond.getOpcode() != SETCC || !Cond.hasOneUse() || VT != Cond.getOperand(0).getValueType() {
        return SDValue {};
    }
    let mut X: SDValue = Cond.getOperand(0);
    let mut CondC: SDValue = Cond.getOperand(1);
    let mut CC: CondCode = cast(Cond.getOperand(2)).get();
    if CC == SETGT && isAllOnesOrAllOnesSplat(CondC, false) && isAllOnesOrAllOnesSplat(C2, false) {
        let mut ShAmtC: SDValue = DAG.getConstant(X.getScalarValueSizeInBits() - 1, DL, VT, false, false);
        let mut Sra: SDValue = DAG.getNode(SRA, DL, VT, X, ShAmtC);
        return DAG.getNode(OR, DL, VT, Sra, C1);
    }
    if CC == SETLT && isNullOrNullSplat(CondC, false) && isNullOrNullSplat(C2, false) {
        let mut ShAmtC: SDValue = DAG.getConstant(X.getScalarValueSizeInBits() - 1, DL, VT, false, false);
        let mut Sra: SDValue = DAG.getNode(SRA, DL, VT, X, ShAmtC);
        return DAG.getNode(AND, DL, VT, Sra, C1);
    }
    return SDValue {};
}

fn shouldConvertSelectOfConstantsToMath(Cond: *SDValue, VT: EVT, TLI: *TargetLowering) -> bool {
    if !TLI.convertSelectOfConstantsToMath(VT) {
        return false;
    }
    if Cond.getOpcode() != SETCC || !operator(Cond).hasOneUse() {
        return true;
    }
    if !TLI.isOperationLegalOrCustom(SELECT_CC, VT, false) {
        return true;
    }
    let mut CC: CondCode = cast(Cond.getOperand(2)).get();
    if CC == SETLT && isNullOrNullSplat(Cond.getOperand(1), false) {
        return true;
    }
    if CC == SETGT && isAllOnesOrAllOnesSplat(Cond.getOperand(1), false) {
        return true;
    }
    return false;
}

fn DAGCombiner::foldSelectOfConstants(self, N: *mut SDNode) -> SDValue {
    let mut Cond: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut N2: SDValue = N.getOperand(2);
    let mut VT: EVT = N.getValueType(0);
    let mut CondVT: EVT = Cond.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    if !VT.isInteger() {
        return SDValue {};
    }
    let mut C1: *mut ConstantSDNode = dyn_cast(N1);
    let mut C2: *mut ConstantSDNode = dyn_cast(N2);
    if !C1 || !C2 {
        return SDValue {};
    }
    if CondVT != EVT { i1 } || self.LegalOperations {
        if CondVT.isInteger() && self.TLI.getBooleanContents(false, true) == ZeroOrOneBooleanContent && self.TLI.getBooleanContents(false, false) == ZeroOrOneBooleanContent {
            if C1.isZero() && C2.isOne() {
                let mut NotCond: SDValue = self.DAG.getNode(XOR, DL, CondVT, Cond, self.DAG.getConstant(1, DL, CondVT, false, false));
                if VT.bitsEq(CondVT) {
                    return NotCond;
                }
                return self.DAG.getZExtOrTrunc(NotCond, DL, VT);
            }
            if C1.isOne() && C2.isZero() && CondVT == VT {
                return Cond;
            }
        }
        return SDValue {};
    }
    assert!(CondVT == EVT { i1 } && !self.LegalOperations);
    if C1.isOne() && C2.isZero() {
        return self.DAG.getZExtOrTrunc(Cond, DL, VT);
    }
    if C1.isAllOnes() && C2.isZero() {
        return self.DAG.getSExtOrTrunc(Cond, DL, VT);
    }
    if C1.isZero() && C2.isOne() {
        let mut NotCond: SDValue = self.DAG.getNOT(DL, Cond, EVT { i1 });
        NotCond = self.DAG.getZExtOrTrunc(NotCond, DL, VT);
        return NotCond;
    }
    if C1.isZero() && C2.isAllOnes() {
        let mut NotCond: SDValue = self.DAG.getNOT(DL, Cond, EVT { i1 });
        NotCond = self.DAG.getSExtOrTrunc(NotCond, DL, VT);
        return NotCond;
    }
    if !shouldConvertSelectOfConstantsToMath(Cond, VT, self.TLI) {
        return SDValue {};
    }
    let mut C1Val: *APInt = C1.getAPIntValue();
    let mut C2Val: *APInt = C2.getAPIntValue();
    if C1Val - 1 == C2Val {
        Cond = self.DAG.getZExtOrTrunc(Cond, DL, VT);
        return self.DAG.getNode(ADD, DL, VT, Cond, N2);
    }
    if C1Val + 1 == C2Val {
        Cond = self.DAG.getSExtOrTrunc(Cond, DL, VT);
        return self.DAG.getNode(ADD, DL, VT, Cond, N2);
    }
    if C1Val.isPowerOf2() && C2Val.isZero() {
        Cond = self.DAG.getZExtOrTrunc(Cond, DL, VT);
        let mut ShAmtC: SDValue = self.DAG.getShiftAmountConstant(C1Val.exactLogBase2(), VT, DL);
        return self.DAG.getNode(SHL, DL, VT, Cond, ShAmtC);
    }
    if C1.isAllOnes() {
        Cond = self.DAG.getSExtOrTrunc(Cond, DL, VT);
        return self.DAG.getNode(OR, DL, VT, Cond, N2);
    }
    if C2.isAllOnes() {
        let mut NotCond: SDValue = self.DAG.getNOT(DL, Cond, EVT { i1 });
        NotCond = self.DAG.getSExtOrTrunc(NotCond, DL, VT);
        return self.DAG.getNode(OR, DL, VT, NotCond, N1);
    }
    if foldSelectOfConstantsUsingSra(N, DL, self.DAG) {
        V;
    } else {
        return V;
    }
    return SDValue {};
}

fn foldBoolSelectToLogic(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    assert!((N.getOpcode() == SELECT || N.getOpcode() == VSELECT), "Expected a (v)select");
    let mut Cond: SDValue = N.getOperand(0);
    let mut T: SDValue = N.getOperand(1);
    let mut F: SDValue = N.getOperand(2);
    let mut VT: EVT = N.getValueType(0);
    if VT != Cond.getValueType() || VT.getScalarSizeInBits() != 1 {
        return SDValue {};
    }
    if Cond == T || isOneOrOneSplat(T, true) {
        return DAG.getNode(OR, DL, VT, Cond, DAG.getFreeze(F));
    }
    if Cond == F || isNullOrNullSplat(F, true) {
        return DAG.getNode(AND, DL, VT, Cond, DAG.getFreeze(T));
    }
    if isOneOrOneSplat(F, true) {
        let mut NotCond: SDValue = DAG.getNode(XOR, DL, VT, Cond, DAG.getAllOnesConstant(DL, VT, false, false));
        return DAG.getNode(OR, DL, VT, NotCond, DAG.getFreeze(T));
    }
    if isNullOrNullSplat(T, true) {
        let mut NotCond: SDValue = DAG.getNode(XOR, DL, VT, Cond, DAG.getAllOnesConstant(DL, VT, false, false));
        return DAG.getNode(AND, DL, VT, NotCond, DAG.getFreeze(F));
    }
    return SDValue {};
}

fn foldVSelectToSignBitSplatMask(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut N2: SDValue = N.getOperand(2);
    let mut VT: EVT = N.getValueType(0);
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    let mut Cond0: SDValue = SDValue {};
    let mut Cond1: SDValue = SDValue {};
    let mut CC: CondCode = zeroed();
    if !sd_match(N0, m_OneUse(m_SetCC(CC, m_Value(Cond0), m_Value(Cond1)))) || VT != Cond0.getValueType() {
        return SDValue {};
    }
    if CC == SETLT && isNullOrNullSplat(Cond1, false) {
        
    } else if CC == SETGT && isAllOnesOrAllOnesSplat(Cond1, false) {
        swap(N1, N2);
    } else {
        return SDValue {};
    }
    if isNullOrNullSplat(N2, false) {
        let mut DL: SDLoc = SDLoc { N };
        let mut ShiftAmt: SDValue = DAG.getShiftAmountConstant(EltSizeInBits - 1, VT, DL);
        let mut Sra: SDValue = DAG.getNode(SRA, DL, VT, Cond0, ShiftAmt);
        return DAG.getNode(AND, DL, VT, Sra, DAG.getFreeze(N1));
    }
    if isAllOnesOrAllOnesSplat(N1, false) {
        let mut DL: SDLoc = SDLoc { N };
        let mut ShiftAmt: SDValue = DAG.getShiftAmountConstant(EltSizeInBits - 1, VT, DL);
        let mut Sra: SDValue = DAG.getNode(SRA, DL, VT, Cond0, ShiftAmt);
        return DAG.getNode(OR, DL, VT, Sra, DAG.getFreeze(N2));
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if isNullOrNullSplat(N1, false) && TLI.hasAndNot(N1) {
        let mut DL: SDLoc = SDLoc { N };
        let mut ShiftAmt: SDValue = DAG.getShiftAmountConstant(EltSizeInBits - 1, VT, DL);
        let mut Sra: SDValue = DAG.getNode(SRA, DL, VT, Cond0, ShiftAmt);
        let mut Not: SDValue = DAG.getNOT(DL, Sra, VT);
        return DAG.getNode(AND, DL, VT, Not, DAG.getFreeze(N2));
    }
    return SDValue {};
}

fn DAGCombiner::foldSelectToABD(self, LHS: SDValue, RHS: SDValue, True: SDValue, False: SDValue, CC: CondCode, DL: *SDLoc) -> SDValue {
    let mut IsSigned: bool = isSignedIntSetCC(CC);
    let mut ABDOpc: u32 = if IsSigned { ABDS } else { ABDU };
    let mut VT: EVT = LHS.getValueType();
    if self.LegalOperations && !self.hasOperation(ABDOpc, VT) {
        return SDValue {};
    }
    if isZeroOrZeroSplat(LHS, false) {
        swap(LHS, RHS);
        CC = getSetCCSwappedOperands(CC);
    }
    let mut A: SDValue = SDValue {};
    let mut B: SDValue = SDValue {};
    if isSignedIntSetCC(CC) && operator(LHS).getFlags().hasNoSignedWrap() && isZeroOrZeroSplat(RHS, false) && sd_match(LHS, m_Add(m_Value(A), m_Value(B))) && self.DAG.isConstantIntBuildVectorOrConstantInt(B, true) {
        RHS = self.DAG.getNegative(B, SDLoc { LHS }, B.getValueType());
        LHS = A;
    }
    let mut IsTypeLegalOrPromote: bool = self.TLI.isTypeLegal(VT) || self.TLI.getTypeAction(*self.DAG.getContext(), VT) == TypePromoteInteger;
    match CC {
        SETGT => {
            SETGE;
        },
        SETLT => {
            SETLE;
        },
        _ => {
            break;
        },
    }
    return SDValue {};
}

fn DAGCombiner::foldSelectToUMin(self, LHS: SDValue, RHS: SDValue, True: SDValue, False: SDValue, CC: CondCode, DL: *SDLoc) -> SDValue {
    let mut C: APInt = APInt {};
    let mut VT: EVT = True.getValueType();
    if sd_match(RHS, m_ConstInt(C)) && self.hasUMin(VT) {
        if CC == SETUGT && LHS == False && sd_match(True, m_Add(m_Specific(False), m_SpecificInt(operator(C)))) {
            let mut AddC: SDValue = self.DAG.getConstant(operator(C), DL, VT, false, false);
            let mut Add: SDValue = self.DAG.getNode(ADD, DL, VT, False, AddC);
            return self.DAG.getNode(UMIN, DL, VT, Add, False);
        }
        if CC == SETULT && LHS == True && sd_match(False, m_Add(m_Specific(True), m_SpecificInt(operator(C)))) {
            let mut AddC: SDValue = self.DAG.getConstant(operator(C), DL, VT, false, false);
            let mut Add: SDValue = self.DAG.getNode(ADD, DL, VT, True, AddC);
            return self.DAG.getNode(UMIN, DL, VT, True, Add);
        }
    }
    return SDValue {};
}

fn combineSelectCCToPseudoMinMax(DAG: *mut SelectionDAG, DL: *SDLoc, CC: CondCode, Op0: SDValue, Op1: SDValue, LHS: SDValue, RHS: SDValue, Flags: SDNodeFlags, IsStrict: bool) -> tuple<unsigned int, SDValue, SDValue> {
    let mut Invalid: tuple<unsigned int, SDValue, SDValue> = tuple<unsigned int, SDValue, SDValue> { 0, SDValue {}, SDValue {} };
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut VT: EVT = LHS.getValueType();
    if !VT.isFloatingPoint() {
        return Invalid;
    }
    if !DAG.isEqualTo(LHS, Op0) || !DAG.isEqualTo(RHS, Op1) {
        if !DAG.isEqualTo(LHS, Op1) || !DAG.isEqualTo(RHS, Op0) {
            return Invalid;
        }
        CC = getSetCCInverse(CC, VT);
        swap(LHS, RHS);
    }
    if getUnorderedFlavor(CC) == 1 {
        CC = getSetCCSwappedOperands(getSetCCInverse(CC, VT));
        swap(LHS, RHS);
    }
    let mut Opcode: u32 = 0;
    match CC {
        _ => {
            break;
        },
        SETOLE => {
            if !Flags.hasNoSignedZeros() && !DAG.isKnownNeverLogicalZero(LHS, 0) && !DAG.isKnownNeverLogicalZero(RHS, 0) {
                break;
            }
        },
        SETLE => {
            swap(LHS, RHS);
        },
        SETOLT => {
            SETLT;
        },
        SETOGE => {
            if !Flags.hasNoSignedZeros() && !DAG.isKnownNeverLogicalZero(LHS, 0) && !DAG.isKnownNeverLogicalZero(RHS, 0) {
                break;
            }
        },
        SETGE => {
            swap(LHS, RHS);
        },
        SETOGT => {
            SETGT;
        },
    }
    if !Opcode {
        return Invalid;
    }
    if IsStrict {
        Opcode = if Opcode == PSEUDO_FMIN { STRICT_PSEUDO_FMIN } else { STRICT_PSEUDO_FMAX };
    }
    if !TLI.isOperationLegalOrCustom(Opcode, VT, false) {
        return Invalid;
    }
    return tuple<unsigned int, SDValue, SDValue> { Opcode, LHS, RHS };
}

fn combineSelectToPseudoMinMax(DAG: *mut SelectionDAG, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Cond: SDValue = N.getOperand(0);
    let mut LHS: SDValue = N.getOperand(1);
    let mut RHS: SDValue = N.getOperand(2);
    let mut VT: EVT = LHS.getValueType();
    if (Cond.getOpcode() != SETCC && Cond.getOpcode() != STRICT_FSETCCS) {
        return SDValue {};
    }
    let mut IsStrict: bool = operator(Cond).isStrictFPOpcode();
    let mut CC: CondCode = cast(Cond.getOperand(if IsStrict { 3 } else { 2 })).get();
    let mut Op0: SDValue = Cond.getOperand(if IsStrict { 1 } else { 0 });
    let mut Op1: SDValue = Cond.getOperand(if IsStrict { 2 } else { 1 });
    if !Opcode {
        return SDValue {};
    }
    let mut FlagsInserter: FlagInserter = FlagInserter { DAG, N.getFlags() };
    if IsStrict {
        let mut Ret: SDValue = DAG.getNode(Opcode, DL, ArrayRef<EVT> { [VT, EVT { Other }] }, ArrayRef<SDValue> { [Cond.getOperand(0), NewLHS, NewRHS] });
        DAG.ReplaceAllUsesOfValueWith(Cond.getValue(1), Ret.getValue(1));
        return Ret;
    }
    return DAG.getNode(Opcode, DL, VT, NewLHS, NewRHS);
}

fn foldSelectOfSelectCmp(LHS: SDValue, RHS: SDValue, CC: CondCode, TrueV: SDValue, FalseV: SDValue, DL: *SDLoc, VT: EVT, DAG: *mut SelectionDAG, Flags: SDNodeFlags) -> SDValue {
    if CC != SETEQ && CC != SETNE {
        return SDValue {};
    }
    let mut InnerSel: SDValue = SDValue {};
    let mut CmpC: SDValue = SDValue {};
    if LHS.getOpcode() == SELECT {
        InnerSel = LHS;
        CmpC = RHS;
    } else if RHS.getOpcode() == SELECT {
        InnerSel = RHS;
        CmpC = LHS;
    } else {
        return SDValue {};
    }
    let mut Cond: SDValue = InnerSel.getOperand(0);
    let mut InnerTV: SDValue = InnerSel.getOperand(1);
    let mut InnerFV: SDValue = InnerSel.getOperand(2);
    let mut CTV: *mut ConstantSDNode = dyn_cast(InnerTV);
    let mut CFV: *mut ConstantSDNode = dyn_cast(InnerFV);
    let mut CCnst: *mut ConstantSDNode = dyn_cast(CmpC);
    if !CTV || !CFV || !CCnst {
        return SDValue {};
    }
    if CTV.getAPIntValue() == CFV.getAPIntValue() {
        return SDValue {};
    }
    let mut CmpVal: *APInt = CCnst.getAPIntValue();
    let mut MatchesTV: bool = CmpVal == CTV.getAPIntValue();
    let mut MatchesFV: bool = CmpVal == CFV.getAPIntValue();
    if !MatchesTV && !MatchesFV {
        return SDValue {};
    }
    let mut SelTrueV: SDValue = TrueV;
    let mut SelFalseV: SDValue = FalseV;
    if CC == SETEQ {
        if MatchesFV {
            swap(SelTrueV, SelFalseV);
        }
    } else {
        if MatchesTV {
            swap(SelTrueV, SelFalseV);
        }
    }
    return DAG.getSelect(DL, VT, Cond, SelTrueV, SelFalseV, Flags);
}

fn foldSelectCCOfSelect(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut CC: CondCode = cast(N.getOperand(4)).get();
    return foldSelectOfSelectCmp(N.getOperand(0), N.getOperand(1), CC, N.getOperand(2), N.getOperand(3), SDLoc { N }, N.getValueType(0), DAG, N.getFlags());
}

fn DAGCombiner::visitSELECT(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut N2: SDValue = N.getOperand(2);
    let mut VT: EVT = N.getValueType(0);
    let mut VT0: EVT = N0.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    let mut Flags: SDNodeFlags = N.getFlags();
    if self.DAG.simplifySelect(N0, N1, N2) {
        V;
    } else {
        return V;
    }
    if foldBoolSelectToLogic(N, DL, self.DAG) {
        V;
    } else {
        return V;
    }
    if extractBooleanFlip(N0, self.DAG, self.TLI, false) {
        F;
    } else {
        return self.DAG.getSelect(DL, VT, F, N2, N1, Flags);
    }
    if self.foldSelectOfConstants(N) {
        V;
    } else {
        return V;
    }
    if N0.getOpcode() == SETCC {
        let mut CC: CondCode = cast(N0.getOperand(2)).get();
        if foldSelectOfSelectCmp(N0.getOperand(0), N0.getOperand(1), CC, N1, N2, DL, VT, self.DAG, Flags) {
            R;
        } else {
            return R;
        }
    }
    if self.SimplifySelectOps(N, N1, N2) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if VT0 == EVT { i1 } {
        let mut normalizeToSequence: bool = self.TLI.shouldNormalizeToSelectSequence(*self.DAG.getContext(), VT, VT0);
        if operator(N0).getOpcode() == AND && operator(N0).hasOneUse() {
            let mut Cond0: SDValue = operator(N0).getOperand(0);
            let mut Cond1: SDValue = operator(N0).getOperand(1);
            let mut InnerSelect: SDValue = self.DAG.getNode(SELECT, DL, N1.getValueType(), Cond1, N1, N2, Flags);
            if normalizeToSequence || !InnerSelect.use_empty() {
                return self.DAG.getNode(SELECT, DL, N1.getValueType(), Cond0, InnerSelect, N2, Flags);
            }
            if InnerSelect.use_empty() {
                self.recursivelyDeleteUnusedNodes(InnerSelect.getNode());
            }
        }
        if operator(N0).getOpcode() == OR && operator(N0).hasOneUse() {
            let mut Cond0: SDValue = operator(N0).getOperand(0);
            let mut Cond1: SDValue = operator(N0).getOperand(1);
            let mut InnerSelect: SDValue = self.DAG.getNode(SELECT, DL, N1.getValueType(), Cond1, N1, N2, Flags);
            if normalizeToSequence || !InnerSelect.use_empty() {
                return self.DAG.getNode(SELECT, DL, N1.getValueType(), Cond0, N1, InnerSelect, Flags);
            }
            if InnerSelect.use_empty() {
                self.recursivelyDeleteUnusedNodes(InnerSelect.getNode());
            }
        }
        if operator(N1).getOpcode() == SELECT && operator(N1).hasOneUse() {
            let mut N1_0: SDValue = operator(N1).getOperand(0);
            let mut N1_1: SDValue = operator(N1).getOperand(1);
            let mut N1_2: SDValue = operator(N1).getOperand(2);
            if N1_2 == N2 && N0.getValueType() == N1_0.getValueType() {
                if !normalizeToSequence {
                    let mut And: SDValue = self.DAG.getNode(AND, DL, N0.getValueType(), N0, N1_0);
                    return self.DAG.getNode(SELECT, DL, N1.getValueType(), And, N1_1, N2, Flags);
                }
                if self.visitANDLike(N0, N1_0, N) {
                    Combined;
                } else {
                    return self.DAG.getNode(SELECT, DL, N1.getValueType(), Combined, N1_1, N2, Flags);
                }
            }
        }
        if operator(N2).getOpcode() == SELECT && operator(N2).hasOneUse() {
            let mut N2_0: SDValue = operator(N2).getOperand(0);
            let mut N2_1: SDValue = operator(N2).getOperand(1);
            let mut N2_2: SDValue = operator(N2).getOperand(2);
            if N2_1 == N1 && N0.getValueType() == N2_0.getValueType() {
                if !normalizeToSequence {
                    let mut Or: SDValue = self.DAG.getNode(OR, DL, N0.getValueType(), N0, N2_0);
                    return self.DAG.getNode(SELECT, DL, N1.getValueType(), Or, N1, N2_2, Flags);
                }
                if self.visitORLike(N0, N2_0, DL) {
                    Combined;
                } else {
                    return self.DAG.getNode(SELECT, DL, N1.getValueType(), Combined, N1, N2_2, Flags);
                }
            }
        }
        if N0.getOpcode() == USUBO && N0.getResNo() == 1 && N2.getNode() == N0.getNode() && N2.getResNo() == 0 && N1.getOpcode() == SUB && N2.getOperand(0) == N1.getOperand(1) && N2.getOperand(1) == N1.getOperand(0) && (!self.LegalOperations || self.TLI.isOperationLegal(ABDU, VT)) {
            return self.DAG.getNode(ABDU, DL, VT, N0.getOperand(0), N0.getOperand(1));
        }
        if N0.getOpcode() == USUBO && N0.getResNo() == 1 && N1.getNode() == N0.getNode() && N1.getResNo() == 0 && N2.getOpcode() == SUB && N2.getOperand(0) == N1.getOperand(1) && N2.getOperand(1) == N1.getOperand(0) && (!self.LegalOperations || self.TLI.isOperationLegal(ABDU, VT)) {
            return self.DAG.getNegative(self.DAG.getNode(ABDU, DL, VT, N0.getOperand(0), N0.getOperand(1)), DL, VT);
        }
    }
    if N0.getOpcode() == SETCC {
        let mut Cond0: SDValue = N0.getOperand(0);
        let mut Cond1: SDValue = N0.getOperand(1);
        let mut CC: CondCode = cast(N0.getOperand(2)).get();
        if N0.hasOneUse() && isLegalToCombineMinNumMaxNum(self.DAG, N1, N2, Flags, operator(N0).getFlags(), self.TLI) {
            if self.combineMinNumMaxNum(DL, VT, Cond0, Cond1, N1, N2, CC) {
                FMinMax;
            } else {
                return FMinMax;
            }
        }
        if !self.LegalOperations && self.TLI.isOperationLegalOrCustom(UADDO, VT, false) && CC == SETUGT && N0.hasOneUse() && isAllOnesConstant(N1) && N2.getOpcode() == ADD && Cond0 == N2.getOperand(0) {
            let mut C: *mut ConstantSDNode = dyn_cast(N2.getOperand(1));
            let mut NotC: *mut ConstantSDNode = dyn_cast(Cond1);
            if C && NotC && C.getAPIntValue() == operator(NotC.getAPIntValue()) {
                let mut VTs: SDVTList = self.DAG.getVTList(VT, VT0);
                let mut UAO: SDValue = self.DAG.getNode(UADDO, DL, VTs, Cond0, N2.getOperand(1));
                return self.DAG.getSelect(DL, VT, UAO.getValue(1), N1, UAO.getValue(0), SDNodeFlags { Flags: None });
            }
        }
        if performNanGuardFpToSatCombine(N, self.DAG) {
            S;
        } else {
            return S;
        }
        if self.TLI.isOperationLegal(SELECT_CC, VT) || (!self.LegalOperations && self.TLI.isOperationLegalOrCustom(SELECT_CC, VT, false)) {
            return self.DAG.getNode(SELECT_CC, DL, VT, Cond0, Cond1, N1, N2, N0.getOperand(2), operator(N0).getFlags());
        }
        if self.foldSelectToABD(Cond0, Cond1, N1, N2, CC, DL) {
            ABD;
        } else {
            return ABD;
        }
        if self.SimplifySelect(DL, N0, N1, N2) {
            NewSel;
        } else {
            return NewSel;
        }
        if self.foldSelectToUMin(Cond0, Cond1, N1, N2, CC, DL) {
            UMin;
        } else {
            return UMin;
        }
    }
    if !VT.isVector() {
        if self.foldSelectOfBinops(N) {
            BinOp;
        } else {
            return BinOp;
        }
    }
    if combineSelectAsExtAnd(N0, N1, N2, DL, self.DAG) {
        R;
    } else {
        return R;
    }
    if combineSelectToPseudoMinMax(self.DAG, N) {
        R;
    } else {
        return R;
    }
    return SDValue {};
}

fn ConvertSelectToConcatVector(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Cond: SDValue = N.getOperand(0);
    let mut LHS: SDValue = N.getOperand(1);
    let mut RHS: SDValue = N.getOperand(2);
    let mut VT: EVT = N.getValueType(0);
    let mut NumElems: i32 = VT.getVectorNumElements();
    assert!(LHS.getOpcode() == CONCAT_VECTORS && RHS.getOpcode() == CONCAT_VECTORS && Cond.getOpcode() == BUILD_VECTOR);
    if operator(LHS).getNumOperands() != 2 || operator(RHS).getNumOperands() != 2 {
        return SDValue {};
    }
    let mut BottomHalf: *mut ConstantSDNode = null;
    for let mut i: i32 = 0; i < NumElems / 2; i += 1 {
        if operator(operator(Cond).getOperand(i)).isUndef() {
            continue;
        }
        if BottomHalf == null {
            BottomHalf = cast(Cond.getOperand(i));
        } else if operator(Cond).getOperand(i).getNode() != BottomHalf {
            return SDValue {};
        }
    }
    let mut TopHalf: *mut ConstantSDNode = null;
    for let mut i: i32 = NumElems / 2; i < NumElems; i += 1 {
        if operator(operator(Cond).getOperand(i)).isUndef() {
            continue;
        }
        if TopHalf == null {
            TopHalf = cast(Cond.getOperand(i));
        } else if operator(Cond).getOperand(i).getNode() != TopHalf {
            return SDValue {};
        }
    }
    assert!(TopHalf && BottomHalf, "One half of the selector was all UNDEFs and the other was all the same value. This should have been addressed before this function.");
    return DAG.getNode(CONCAT_VECTORS, DL, VT, if BottomHalf.isZero() { operator(RHS).getOperand(0) } else { operator(LHS).getOperand(0) }, if TopHalf.isZero() { operator(RHS).getOperand(1) } else { operator(LHS).getOperand(1) });
}

fn refineUniformBase(BasePtr: *mut SDValue, Index: *mut SDValue, IndexIsScaled: bool, DAG: *mut SelectionDAG, DL: *SDLoc) -> bool {
    if IndexIsScaled {
        return false;
    }
    if !isNullConstant(BasePtr) && !Index.hasOneUse() {
        return false;
    }
    let mut VT: EVT = BasePtr.getValueType();
    let mut SplatVal: SDValue = DAG.getSplatValue(Index, false);
    if SplatVal && !isNullConstant(SplatVal) && SplatVal.getValueType() == VT {
        BasePtr = DAG.getNode(ADD, DL, VT, BasePtr, SplatVal);
        Index = DAG.getSplat(Index.getValueType(), DL, DAG.getConstant(0, DL, VT, false, false));
        return true;
    }
    if Index.getOpcode() != ADD {
        return false;
    }
    let mut SplatVal: SDValue = DAG.getSplatValue(Index.getOperand(0), false);
    if SplatVal && SplatVal.getValueType() == VT {
        BasePtr = DAG.getNode(ADD, DL, VT, BasePtr, SplatVal);
        Index = Index.getOperand(1);
        return true;
    }
    let mut SplatVal: SDValue = DAG.getSplatValue(Index.getOperand(1), false);
    if SplatVal && SplatVal.getValueType() == VT {
        BasePtr = DAG.getNode(ADD, DL, VT, BasePtr, SplatVal);
        Index = Index.getOperand(0);
        return true;
    }
    return false;
}

fn refineIndexType(Index: *mut SDValue, IndexType: *mut MemIndexType, DataVT: EVT, DAG: *mut SelectionDAG) -> bool {
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if Index.getOpcode() == ZERO_EXTEND {
        if TLI.shouldRemoveExtendFromGSIndex(Index, DataVT) {
            IndexType = UNSIGNED_SCALED;
            Index = Index.getOperand(0);
            return true;
        }
        if isIndexTypeSigned(IndexType) {
            IndexType = UNSIGNED_SCALED;
            return true;
        }
    }
    if Index.getOpcode() == SIGN_EXTEND && isIndexTypeSigned(IndexType) && TLI.shouldRemoveExtendFromGSIndex(Index, DataVT) {
        Index = Index.getOperand(0);
        return true;
    }
    return false;
}

fn DAGCombiner::visitVPSCATTER(self, N: *mut SDNode) -> SDValue {
    let mut MSC: *mut VPScatterSDNode = cast(N);
    let mut Mask: SDValue = MSC.getMask();
    let mut Chain: SDValue = MSC.getChain();
    let mut Index: SDValue = MSC.getIndex();
    let mut Scale: SDValue = MSC.getScale();
    let mut StoreVal: SDValue = MSC.getValue();
    let mut BasePtr: SDValue = MSC.getBasePtr();
    let mut VL: SDValue = MSC.getVectorLength();
    let mut IndexType: MemIndexType = MSC.getIndexType();
    let mut DL: SDLoc = SDLoc { N };
    if isConstantSplatVectorAllZeros(Mask.getNode(), false) {
        return Chain;
    }
    if refineUniformBase(BasePtr, Index, MSC.isIndexScaled(), self.DAG, DL) {
        let mut Ops: [7]SDValue = [Chain, StoreVal, BasePtr, Index, Scale, Mask, VL];
        return self.DAG.getScatterVP(self.DAG.getVTList(EVT { Other }), MSC.getMemoryVT(), DL, ArrayRef<SDValue> { Ops }, MSC.getMemOperand(), IndexType);
    }
    if refineIndexType(Index, IndexType, StoreVal.getValueType(), self.DAG) {
        let mut Ops: [7]SDValue = [Chain, StoreVal, BasePtr, Index, Scale, Mask, VL];
        return self.DAG.getScatterVP(self.DAG.getVTList(EVT { Other }), MSC.getMemoryVT(), DL, ArrayRef<SDValue> { Ops }, MSC.getMemOperand(), IndexType);
    }
    return SDValue {};
}

fn DAGCombiner::visitMSCATTER(self, N: *mut SDNode) -> SDValue {
    let mut MSC: *mut MaskedScatterSDNode = cast(N);
    let mut Mask: SDValue = MSC.getMask();
    let mut Chain: SDValue = MSC.getChain();
    let mut Index: SDValue = MSC.getIndex();
    let mut Scale: SDValue = MSC.getScale();
    let mut StoreVal: SDValue = MSC.getValue();
    let mut BasePtr: SDValue = MSC.getBasePtr();
    let mut IndexType: MemIndexType = MSC.getIndexType();
    let mut DL: SDLoc = SDLoc { N };
    if isConstantSplatVectorAllZeros(Mask.getNode(), false) {
        return Chain;
    }
    if refineUniformBase(BasePtr, Index, MSC.isIndexScaled(), self.DAG, DL) {
        let mut Ops: [6]SDValue = [Chain, StoreVal, Mask, BasePtr, Index, Scale];
        return self.DAG.getMaskedScatter(self.DAG.getVTList(EVT { Other }), MSC.getMemoryVT(), DL, ArrayRef<SDValue> { Ops }, MSC.getMemOperand(), IndexType, MSC.isTruncatingStore());
    }
    if refineIndexType(Index, IndexType, StoreVal.getValueType(), self.DAG) {
        let mut Ops: [6]SDValue = [Chain, StoreVal, Mask, BasePtr, Index, Scale];
        return self.DAG.getMaskedScatter(self.DAG.getVTList(EVT { Other }), MSC.getMemoryVT(), DL, ArrayRef<SDValue> { Ops }, MSC.getMemOperand(), IndexType, MSC.isTruncatingStore());
    }
    return SDValue {};
}

fn calculateConstantLowMaskLanes(Mask: SDValue) -> u64 {
    if Mask.getValueType().getScalarSizeInBits() != 1 {
        return 0;
    }
    if Mask.getOpcode() == BUILD_VECTOR {
        let mut NumOnes: u32 = 0;
        let mut Op: op_iterator = operator(Mask).op_begin();
        for ; Op != operator(Mask).op_end(); Op += 1 {
            if !isOneConstant(*Op.operator const llvm::SDValue &()) {
                break;
            }
            NumOnes += 1;
        }
        if NumOnes == 0 {
            return 0;
        }
        for ; Op != operator(Mask).op_end(); Op += 1 {
            if !isNullConstant(*Op.operator const llvm::SDValue &()) {
                return 0;
            }
        }
        return NumOnes;
    }
    if Mask.getOpcode() == GET_ACTIVE_LANE_MASK && isNullConstant(Mask.getOperand(0)) && isa(Mask.getOperand(1)) && Mask.getOperand(1).getValueType().getSizeInBits().operator unsigned long long() <= 64 {
        return Mask.getConstantOperandVal(1);
    }
    return 0;
}

fn DAGCombiner::visitMSTORE(self, N: *mut SDNode) -> SDValue {
    let mut MST: *mut MaskedStoreSDNode = cast(N);
    let mut Mask: SDValue = MST.getMask();
    let mut Chain: SDValue = MST.getChain();
    let mut Value: SDValue = MST.getValue();
    let mut Ptr: SDValue = MST.getBasePtr();
    let mut VT: EVT = Value.getValueType();
    if isConstantSplatVectorAllZeros(Mask.getNode(), false) {
        return Chain;
    }
    if dyn_cast(Chain) {
        MST1;
    } else {
        if MST.isUnindexed() && MST.isSimple() && MST1.isUnindexed() && MST1.isSimple() && MST1.getBasePtr() == Ptr && !MST.getBasePtr().isUndef() && ((Mask == MST1.getMask() && MST.getMemoryVT().getStoreSize() == MST1.getMemoryVT().getStoreSize()) || isConstantSplatVectorAllOnes(Mask.getNode(), false)) && isKnownLE(MST1.getMemoryVT().getStoreSize(), MST.getMemoryVT().getStoreSize()) {
            self.CombineTo(MST1, MST1.getChain(), true);
            if N.getOpcode() != DELETED_NODE {
                self.AddToWorklist(N, true, false);
            }
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    if MST.isUnindexed() && !MST.isCompressingStore() && !MST.isTruncatingStore() {
        if isConstantSplatVectorAllOnes(Mask.getNode(), false) {
            return self.DAG.getStore(MST.getChain(), SDLoc { N }, MST.getValue(), MST.getBasePtr(), MST.getPointerInfo(), MST.getBaseAlign(), MST.getMemOperand().getFlags(), MMOMetadata { AAInfo: MST.getAAInfo(), Ranges: null, MemCacheHint: null });
        }
        if calculateConstantLowMaskLanes(Mask) {
            Lanes;
        } else {
            if Lanes < VT.getVectorMinNumElements() && isPowerOf2_32(Lanes) {
                let mut SubVT: EVT = getVectorVT(*self.DAG.getContext(), VT.getVectorElementType(), Lanes, false);
                let mut IsFast: u32 = 0;
                if (!self.LegalTypes || self.isTypeLegal(SubVT)) && self.TLI.allowsMemoryAccess(*self.DAG.getContext(), self.DAG.getDataLayout(), SubVT, MST.getAddressSpace(), MST.getBaseAlign(), MST.getMemOperand().getFlags(), &mut IsFast) && IsFast {
                    let mut DL: SDLoc = SDLoc { N };
                    let mut Ext: SDValue = self.DAG.getExtractSubvector(DL, SubVT, MST.getValue(), 0);
                    return self.DAG.getStore(MST.getChain(), DL, Ext, MST.getBasePtr(), MST.getPointerInfo(), MST.getBaseAlign(), MST.getMemOperand().getFlags(), MMOMetadata { AAInfo: MST.getAAInfo(), Ranges: null, MemCacheHint: null });
                }
            }
        }
    }
    if self.CombineToPreIndexedLoadStore(N) || self.CombineToPostIndexedLoadStore(N) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if MST.isTruncatingStore() && MST.isUnindexed() && VT.isInteger() && (!isa(Value) || !cast(Value).isOpaque()) {
        let mut TruncDemandedBits: APInt = getLowBitsSet(Value.getScalarValueSizeInBits(), MST.getMemoryVT().getScalarSizeInBits());
        if self.SimplifyDemandedBits(Value, TruncDemandedBits) {
            if N.getOpcode() != DELETED_NODE {
                self.AddToWorklist(N, true, false);
            }
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    if (Value.getOpcode() == TRUNCATE) && operator(Value).hasOneUse() && MST.isUnindexed() && !MST.isCompressingStore() && self.TLI.canCombineTruncStore(Value.getOperand(0).getValueType(), MST.getMemoryVT(), MST.getAlign(), MST.getAddressSpace(), self.LegalOperations) {
        let mut Mask: SDValue = self.TLI.promoteTargetBoolean(self.DAG, MST.getMask(), Value.getOperand(0).getValueType());
        return self.DAG.getMaskedStore(Chain, SDLoc { N }, Value.getOperand(0), Ptr, MST.getOffset(), Mask, MST.getMemoryVT(), MST.getMemOperand(), MST.getAddressingMode(), true, false);
    }
    return SDValue {};
}

fn DAGCombiner::visitVP_STRIDED_STORE(self, N: *mut SDNode) -> SDValue {
    let mut SST: *mut VPStridedStoreSDNode = cast(N);
    let mut EltVT: EVT = SST.getValue().getValueType().getVectorElementType();
    let mut CStride: *mut ConstantSDNode = dyn_cast(SST.getStride());
    if CStride && CStride.getZExtValue() == EltVT.getStoreSize().operator unsigned long long() {
        return self.DAG.getStoreVP(SST.getChain(), SDLoc { N }, SST.getValue(), SST.getBasePtr(), SST.getOffset(), SST.getMask(), SST.getVectorLength(), SST.getMemoryVT(), SST.getMemOperand(), SST.getAddressingMode(), SST.isTruncatingStore(), SST.isCompressingStore());
    }
    return SDValue {};
}

fn DAGCombiner::visitVECTOR_COMPRESS(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Vec: SDValue = N.getOperand(0);
    let mut Mask: SDValue = N.getOperand(1);
    let mut Passthru: SDValue = N.getOperand(2);
    let mut VecVT: EVT = Vec.getValueType();
    let mut HasPassthru: bool = !Passthru.isUndef();
    let mut SplatVal: APInt = APInt {};
    if isConstantSplatVector(Mask.getNode(), SplatVal) {
        return if self.TLI.isConstTrueVal(Mask) { Vec } else { Passthru };
    }
    if Vec.isUndef() || Mask.isUndef() {
        return Passthru;
    }
    if isBuildVectorOfConstantSDNodes(Mask.getNode()) {
        let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
        let mut ScalarVT: EVT = VecVT.getVectorElementType();
        let mut NumSelected: u32 = 0;
        let mut NumElmts: u32 = VecVT.getVectorNumElements();
        for let mut I: u32 = 0; I < NumElmts; I += 1 {
            let mut MaskI: SDValue = Mask.getOperand(I);
            if MaskI.isUndef() {
                continue;
            }
            if self.TLI.isConstTrueVal(MaskI) {
                let mut VecI: SDValue = self.DAG.getNode(EXTRACT_VECTOR_ELT, DL, ScalarVT, Vec, self.DAG.getVectorIdxConstant(I, DL, false));
                Ops.push(ValueParamT { VecI });
                NumSelected += 1;
            }
        }
        for let mut Rest: u32 = NumSelected; Rest < NumElmts; Rest += 1 {
            let mut Val: SDValue = if HasPassthru { self.DAG.getNode(EXTRACT_VECTOR_ELT, DL, ScalarVT, Passthru, self.DAG.getVectorIdxConstant(Rest, DL, false)) } else { self.DAG.getUNDEF(ScalarVT) };
            Ops.push(ValueParamT { Val });
        }
        return self.DAG.getBuildVector(VecVT, DL, ArrayRef<SDValue> { Ops });
    }
    return SDValue {};
}

fn DAGCombiner::visitVPGATHER(self, N: *mut SDNode) -> SDValue {
    let mut MGT: *mut VPGatherSDNode = cast(N);
    let mut Mask: SDValue = MGT.getMask();
    let mut Chain: SDValue = MGT.getChain();
    let mut Index: SDValue = MGT.getIndex();
    let mut Scale: SDValue = MGT.getScale();
    let mut BasePtr: SDValue = MGT.getBasePtr();
    let mut VL: SDValue = MGT.getVectorLength();
    let mut IndexType: MemIndexType = MGT.getIndexType();
    let mut DL: SDLoc = SDLoc { N };
    if refineUniformBase(BasePtr, Index, MGT.isIndexScaled(), self.DAG, DL) {
        let mut Ops: [6]SDValue = [Chain, BasePtr, Index, Scale, Mask, VL];
        return self.DAG.getGatherVP(self.DAG.getVTList(N.getValueType(0), EVT { Other }), MGT.getMemoryVT(), DL, ArrayRef<SDValue> { Ops }, MGT.getMemOperand(), IndexType);
    }
    if refineIndexType(Index, IndexType, N.getValueType(0), self.DAG) {
        let mut Ops: [6]SDValue = [Chain, BasePtr, Index, Scale, Mask, VL];
        return self.DAG.getGatherVP(self.DAG.getVTList(N.getValueType(0), EVT { Other }), MGT.getMemoryVT(), DL, ArrayRef<SDValue> { Ops }, MGT.getMemOperand(), IndexType);
    }
    return SDValue {};
}

fn DAGCombiner::visitMGATHER(self, N: *mut SDNode) -> SDValue {
    let mut MGT: *mut MaskedGatherSDNode = cast(N);
    let mut Mask: SDValue = MGT.getMask();
    let mut Chain: SDValue = MGT.getChain();
    let mut Index: SDValue = MGT.getIndex();
    let mut Scale: SDValue = MGT.getScale();
    let mut PassThru: SDValue = MGT.getPassThru();
    let mut BasePtr: SDValue = MGT.getBasePtr();
    let mut IndexType: MemIndexType = MGT.getIndexType();
    let mut DL: SDLoc = SDLoc { N };
    if isConstantSplatVectorAllZeros(Mask.getNode(), false) {
        return self.CombineTo(N, PassThru, MGT.getChain(), true);
    }
    if refineUniformBase(BasePtr, Index, MGT.isIndexScaled(), self.DAG, DL) {
        let mut Ops: [6]SDValue = [Chain, PassThru, Mask, BasePtr, Index, Scale];
        return self.DAG.getMaskedGather(self.DAG.getVTList(N.getValueType(0), EVT { Other }), MGT.getMemoryVT(), DL, ArrayRef<SDValue> { Ops }, MGT.getMemOperand(), IndexType, MGT.getExtensionType());
    }
    if refineIndexType(Index, IndexType, N.getValueType(0), self.DAG) {
        let mut Ops: [6]SDValue = [Chain, PassThru, Mask, BasePtr, Index, Scale];
        return self.DAG.getMaskedGather(self.DAG.getVTList(N.getValueType(0), EVT { Other }), MGT.getMemoryVT(), DL, ArrayRef<SDValue> { Ops }, MGT.getMemOperand(), IndexType, MGT.getExtensionType());
    }
    return SDValue {};
}

fn DAGCombiner::visitMLOAD(self, N: *mut SDNode) -> SDValue {
    let mut MLD: *mut MaskedLoadSDNode = cast(N);
    let mut Mask: SDValue = MLD.getMask();
    if isConstantSplatVectorAllZeros(Mask.getNode(), false) {
        return self.CombineTo(N, MLD.getPassThru(), MLD.getChain(), true);
    }
    if isConstantSplatVectorAllOnes(Mask.getNode(), false) && MLD.isUnindexed() && !MLD.isExpandingLoad() && MLD.getExtensionType() == NON_EXTLOAD {
        let mut NewLd: SDValue = self.DAG.getLoad(N.getValueType(0), SDLoc { N }, MLD.getChain(), MLD.getBasePtr(), MLD.getPointerInfo(), MaybeAlign { MLD.getBaseAlign() }, MLD.getMemOperand().getFlags(), MMOMetadata { AAInfo: MLD.getAAInfo(), Ranges: MLD.getRanges(), MemCacheHint: null });
        return self.CombineTo(N, NewLd, NewLd.getValue(1), true);
    }
    if self.CombineToPreIndexedLoadStore(N) || self.CombineToPostIndexedLoadStore(N) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn DAGCombiner::visitMHISTOGRAM(self, N: *mut SDNode) -> SDValue {
    let mut HG: *mut MaskedHistogramSDNode = cast(N);
    let mut Chain: SDValue = HG.getChain();
    let mut Inc: SDValue = HG.getInc();
    let mut Mask: SDValue = HG.getMask();
    let mut BasePtr: SDValue = HG.getBasePtr();
    let mut Index: SDValue = HG.getIndex();
    let mut DL: SDLoc = SDLoc { HG };
    let mut MemVT: EVT = HG.getMemoryVT();
    let mut DataVT: EVT = Index.getValueType();
    let mut MMO: *mut MachineMemOperand = HG.getMemOperand();
    let mut IndexType: MemIndexType = HG.getIndexType();
    if isConstantSplatVectorAllZeros(Mask.getNode(), false) {
        return Chain;
    }
    if refineUniformBase(BasePtr, Index, HG.isIndexScaled(), self.DAG, DL) || refineIndexType(Index, IndexType, DataVT, self.DAG) {
        let mut Ops: [7]SDValue = [Chain, Inc, Mask, BasePtr, Index, HG.getScale(), HG.getIntID()];
        return self.DAG.getMaskedHistogram(self.DAG.getVTList(EVT { Other }), MemVT, DL, ArrayRef<SDValue> { Ops }, MMO, IndexType);
    }
    return SDValue {};
}

fn DAGCombiner::visitPARTIAL_REDUCE_MLA(self, N: *mut SDNode) -> SDValue {
    if self.foldPartialReduceMLAMulOp(N) {
        Res;
    } else {
        return Res;
    }
    if self.foldPartialReduceAdd(N) {
        Res;
    } else {
        return Res;
    }
    return SDValue {};
}

fn DAGCombiner::foldPartialReduceMLAMulOp(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Context: *mut LLVMContext = self.DAG.getContext();
    let mut Tmp: SDValue = SDValue {};
    let mut Acc: SDValue = N.getOperand(0);
    let mut Op1: SDValue = N.getOperand(1);
    let mut OrigOp1: SDValue = Op1;
    let mut Op2: SDValue = N.getOperand(2);
    let mut Opc: u32 = operator(Op1).getOpcode();
    let mut Pred: SDValue = SDValue {};
    if (Opc == VSELECT || Opc == VP_MERGE) && (isZeroOrZeroSplat(operator(Op1).getOperand(2), false) || isZeroOrZeroSplatFP(operator(Op1).getOperand(2), false)) {
        Pred = operator(Op1).getOperand(0);
        Op1 = operator(Op1).getOperand(1);
        Opc = operator(Op1).getOpcode();
    }
    let mut IsMLS: bool = false;
    if sd_match(Op1, m_Neg(m_Value(Tmp))) {
        Op1 = Tmp;
        Opc = operator(Op1).getOpcode();
        IsMLS = true;
    }
    if Opc != MUL && Opc != FMUL && Opc != SHL {
        return SDValue {};
    }
    let mut LHS: SDValue = operator(Op1).getOperand(0);
    let mut RHS: SDValue = operator(Op1).getOperand(1);
    if sd_match(RHS, m_FNeg(m_Value(Tmp))) {
        RHS = Tmp;
        IsMLS = true;
    }
    if Opc == SHL {
        let mut C: APInt = APInt {};
        if !isConstantSplatVector(RHS.getNode(), C) {
            return SDValue {};
        }
        RHS = self.DAG.getSplatVector(RHS.getValueType(), DL, self.DAG.getConstant(APInt { C.getBitWidth(), 1, false, false }.shl(C), DL, RHS.getValueType().getScalarType(), false, false));
        Opc = MUL;
    }
    if !(Opc == MUL && isOneOrOneSplat(Op2, false)) && !(Opc == FMUL && isOneOrOneSplatFP(Op2, false)) {
        return SDValue {};
    }
    let mut IsIntOrFPExtOpcode: Closure_45 = Closure_45 {};
    let mut LHSOpcode: u32 = operator(LHS).getOpcode();
    if !IsIntOrFPExtOpcode.call(LHSOpcode) {
        return SDValue {};
    }
    let mut LHSExtOp: SDValue = operator(LHS).getOperand(0);
    let mut LHSExtOpVT: EVT = LHSExtOp.getValueType();
    let mut ApplyPredicate: Closure_46 = Closure_46 { Pred: &mut Pred, cap_1: self, DL: &mut DL, OrigOp1: &mut OrigOp1 };
    let mut GetMLA: Closure_47 = Closure_47 { IsMLS: &mut IsMLS, cap_1: self, DL: &mut DL };
    let mut C: APInt = APInt {};
    if isConstantSplatVector(RHS.getNode(), C) {
        let mut CTrunc: APInt = C.trunc(LHSExtOpVT.getScalarSizeInBits());
        let mut LHSBits: u32 = LHS.getValueType().getScalarSizeInBits();
        if (LHSOpcode != ZERO_EXTEND || CTrunc.zext(LHSBits) != C) && (LHSOpcode != SIGN_EXTEND || CTrunc.sext(LHSBits) != C) {
            return SDValue {};
        }
        let mut NewOpcode: u32 = if LHSOpcode == SIGN_EXTEND { PARTIAL_REDUCE_SMLA } else { PARTIAL_REDUCE_UMLA };
        if !self.TLI.isPartialReduceMLALegalOrCustom(NewOpcode, self.TLI.getTypeToTransformTo(*Context, N.getValueType(0)), self.TLI.getTypeToTransformTo(*Context, LHSExtOpVT)) {
            return SDValue {};
        }
        let mut C: SDValue = self.DAG.getConstant(CTrunc, DL, LHSExtOpVT, false, false);
        ApplyPredicate.call(C, LHSExtOp);
        return GetMLA.call(NewOpcode, Acc, LHSExtOp, C);
    }
    let mut RHSOpcode: u32 = operator(RHS).getOpcode();
    if !IsIntOrFPExtOpcode.call(RHSOpcode) {
        return SDValue {};
    }
    let mut RHSExtOp: SDValue = operator(RHS).getOperand(0);
    if LHSExtOpVT != RHSExtOp.getValueType() {
        return SDValue {};
    }
    let mut NewOpc: u32 = 0;
    if LHSOpcode == SIGN_EXTEND && RHSOpcode == SIGN_EXTEND {
        NewOpc = PARTIAL_REDUCE_SMLA;
    } else if LHSOpcode == ZERO_EXTEND && RHSOpcode == ZERO_EXTEND {
        NewOpc = PARTIAL_REDUCE_UMLA;
    } else if LHSOpcode == SIGN_EXTEND && RHSOpcode == ZERO_EXTEND {
        NewOpc = PARTIAL_REDUCE_SUMLA;
    } else if LHSOpcode == ZERO_EXTEND && RHSOpcode == SIGN_EXTEND {
        NewOpc = PARTIAL_REDUCE_SUMLA;
        swap(LHSExtOp, RHSExtOp);
    } else if LHSOpcode == FP_EXTEND && RHSOpcode == FP_EXTEND {
        NewOpc = PARTIAL_REDUCE_FMLA;
    } else {
        return SDValue {};
    }
    let mut AccElemVT: EVT = Acc.getValueType().getVectorElementType();
    if Op1.getValueType().getVectorElementType() != AccElemVT && NewOpc != N.getOpcode() {
        return SDValue {};
    }
    if !self.TLI.isPartialReduceMLALegalOrCustom(NewOpc, self.TLI.getTypeToTransformTo(*Context, N.getValueType(0)), self.TLI.getTypeToTransformTo(*Context, LHSExtOpVT)) {
        return SDValue {};
    }
    ApplyPredicate.call(RHSExtOp, LHSExtOp);
    return GetMLA.call(NewOpc, Acc, LHSExtOp, RHSExtOp);
}

fn DAGCombiner::foldPartialReduceAdd(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut Tmp: SDValue = SDValue {};
    let mut Acc: SDValue = N.getOperand(0);
    let mut Op1: SDValue = N.getOperand(1);
    let mut Op2: SDValue = N.getOperand(2);
    if !isOneOrOneSplat(Op2, false) && !isOneOrOneSplatFP(Op2, false) {
        return SDValue {};
    }
    let mut Pred: SDValue = SDValue {};
    let mut Op1Opcode: u32 = Op1.getOpcode();
    if Op1Opcode == VSELECT && (isZeroOrZeroSplat(operator(Op1).getOperand(2), false) || isZeroOrZeroSplatFP(operator(Op1).getOperand(2), false)) {
        Pred = operator(Op1).getOperand(0);
        Op1 = operator(Op1).getOperand(1);
        Op1Opcode = operator(Op1).getOpcode();
    }
    let mut IsMLS: bool = false;
    if sd_match(Op1, m_AnyOf(m_Neg(m_Value(Tmp)), m_FNeg(m_Value(Tmp)))) {
        Op1 = Tmp;
        Op1Opcode = Op1.getOpcode();
        IsMLS = true;
    }
    if !isExtOpcode(Op1Opcode) && Op1Opcode != FP_EXTEND {
        return SDValue {};
    }
    let mut Op1IsSigned: bool = Op1Opcode == SIGN_EXTEND || Op1Opcode == FP_EXTEND;
    let mut NodeIsSigned: bool = N.getOpcode() != PARTIAL_REDUCE_UMLA;
    let mut AccElemVT: EVT = Acc.getValueType().getVectorElementType();
    if Op1IsSigned != NodeIsSigned && Op1.getValueType().getVectorElementType() != AccElemVT {
        return SDValue {};
    }
    let mut NewOpcode: u32 = if N.getOpcode() == PARTIAL_REDUCE_FMLA {} else { if Op1IsSigned { PARTIAL_REDUCE_SMLA } else { PARTIAL_REDUCE_UMLA } };
    let mut UnextOp1: SDValue = Op1.getOperand(0);
    let mut UnextOp1VT: EVT = UnextOp1.getValueType();
    let mut Context: *mut LLVMContext = self.DAG.getContext();
    let mut PromOp1VT: EVT = self.TLI.getTypeToTransformTo(*Context, UnextOp1VT);
    if !self.TLI.isPartialReduceMLALegalOrCustom(NewOpcode, self.TLI.getTypeToTransformTo(*Context, N.getValueType(0)), PromOp1VT) {
        return SDValue {};
    }
    if Op1IsSigned && UnextOp1VT.getVectorElementType() == EVT { i1 } {
        if PromOp1VT == UnextOp1VT {
            return SDValue {};
        }
        UnextOp1VT = PromOp1VT;
        UnextOp1 = self.DAG.getNode(SIGN_EXTEND, DL, UnextOp1VT, UnextOp1);
    }
    let mut Constant: SDValue = if N.getOpcode() == PARTIAL_REDUCE_FMLA { self.DAG.getConstantFP(1, DL, UnextOp1VT, false) } else { self.DAG.getConstant(1, DL, UnextOp1VT, false, false) };
    if Pred {
        let mut Zero: SDValue = if N.getOpcode() == PARTIAL_REDUCE_FMLA { self.DAG.getConstantFP(0, DL, UnextOp1VT, false) } else { self.DAG.getConstant(0, DL, UnextOp1VT, false, false) };
        Constant = self.DAG.getSelect(DL, UnextOp1VT, Pred, Constant, Zero, SDNodeFlags { Flags: None });
    }
    let mut AccVT: EVT = Acc.getValueType();
    return if IsMLS { self.DAG.getPartialReduceMLS(NewOpcode, DL, Acc, UnextOp1, Constant) } else { self.DAG.getNode(NewOpcode, DL, AccVT, Acc, UnextOp1, Constant) };
}

fn DAGCombiner::visitLOOP_DEPENDENCE_MASK(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    let mut LaneOffset: u32 = N.getConstantOperandVal(3);
    if LaneOffset == 0 && VT.getVectorElementCount() == getFixed(1) {
        return self.DAG.getBoolConstant(true, DL, VT, VT);
    }
    return SDValue {};
}

fn DAGCombiner::visitVP_STRIDED_LOAD(self, N: *mut SDNode) -> SDValue {
    let mut SLD: *mut VPStridedLoadSDNode = cast(N);
    let mut EltVT: EVT = SLD.getValueType(0).getVectorElementType();
    let mut CStride: *mut ConstantSDNode = dyn_cast(SLD.getStride());
    if CStride && CStride.getZExtValue() == EltVT.getStoreSize().operator unsigned long long() {
        let mut NewLd: SDValue = self.DAG.getLoadVP(SLD.getAddressingMode(), SLD.getExtensionType(), SLD.getValueType(0), SDLoc { N }, SLD.getChain(), SLD.getBasePtr(), SLD.getOffset(), SLD.getMask(), SLD.getVectorLength(), SLD.getMemoryVT(), SLD.getMemOperand(), SLD.isExpandingLoad());
        return self.CombineTo(N, NewLd, NewLd.getValue(1), true);
    }
    return SDValue {};
}

fn DAGCombiner::foldVSelectOfConstants(self, N: *mut SDNode) -> SDValue {
    let mut Cond: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut N2: SDValue = N.getOperand(2);
    let mut VT: EVT = N.getValueType(0);
    if !Cond.hasOneUse() || Cond.getScalarValueSizeInBits() != 1 || !shouldConvertSelectOfConstantsToMath(Cond, VT, self.TLI) || !isBuildVectorOfConstantSDNodes(N1.getNode()) || !isBuildVectorOfConstantSDNodes(N2.getNode()) {
        return SDValue {};
    }
    let mut AllAddOne: bool = true;
    let mut AllSubOne: bool = true;
    let mut Elts: u32 = VT.getVectorNumElements();
    for let mut i: u32 = 0; i != Elts; i += 1 {
        let mut N1Elt: SDValue = N1.getOperand(i);
        let mut N2Elt: SDValue = N2.getOperand(i);
        if N1Elt.isUndef() {
            continue;
        }
        if N2Elt.isUndef() || N1Elt.getValueType() != N2Elt.getValueType() {
            AllAddOne = false;
            AllSubOne = false;
            break;
        }
        let mut C1: *APInt = operator(N1Elt).getAsAPIntVal();
        let mut C2: *APInt = operator(N2Elt).getAsAPIntVal();
        if C1 != C2 + 1 {
            AllAddOne = false;
        }
        if C1 != C2 - 1 {
            AllSubOne = false;
        }
    }
    let mut DL: SDLoc = SDLoc { N };
    if AllAddOne || AllSubOne {
        let mut ExtendOpcode: NodeType = if AllAddOne { ZERO_EXTEND } else { SIGN_EXTEND };
        let mut ExtendedCond: SDValue = self.DAG.getNode(ExtendOpcode, DL, VT, Cond);
        return self.DAG.getNode(ADD, DL, VT, ExtendedCond, N2);
    }
    let mut Pow2C: APInt = APInt {};
    if isConstantSplatVector(N1.getNode(), Pow2C) && Pow2C.isPowerOf2() && isNullOrNullSplat(N2, false) {
        let mut ZextCond: SDValue = self.DAG.getZExtOrTrunc(Cond, DL, VT);
        let mut ShAmtC: SDValue = self.DAG.getConstant(Pow2C.exactLogBase2(), DL, VT, false, false);
        return self.DAG.getNode(SHL, DL, VT, ZextCond, ShAmtC);
    }
    if foldSelectOfConstantsUsingSra(N, DL, self.DAG) {
        V;
    } else {
        return V;
    }
    return SDValue {};
}

fn combineVSelectWithAllOnesOrZeros(Cond: SDValue, TVal: SDValue, FVal: SDValue, TLI: *TargetLowering, DAG: *mut SelectionDAG, DL: *SDLoc) -> SDValue {
    let mut VT: EVT = TVal.getValueType();
    if !TLI.isTypeLegal(VT) {
        return SDValue {};
    }
    let mut CondVT: EVT = Cond.getValueType();
    assert!(CondVT.isVector(), "Vector select expects a vector selector!");
    let mut IsTAllZero: bool = isConstantSplatVectorAllZeros(TVal.getNode(), false);
    let mut IsTAllOne: bool = isConstantSplatVectorAllOnes(TVal.getNode(), false);
    let mut IsFAllZero: bool = isConstantSplatVectorAllZeros(FVal.getNode(), false);
    let mut IsFAllOne: bool = isConstantSplatVectorAllOnes(FVal.getNode(), false);
    if !IsTAllZero && !IsTAllOne && !IsFAllZero && !IsFAllOne {
        return SDValue {};
    }
    if IsTAllZero && IsFAllZero {
        return if VT.isFloatingPoint() { DAG.getConstantFP(0.0, DL, VT, false) } else { DAG.getConstant(0, DL, VT, false, false) };
    }
    let mut TValAPInt: APInt = APInt {};
    if Cond.getOpcode() == SETCC && Cond.getOperand(2) == DAG.getCondCode(SETGT) && Cond.getOperand(0).getValueType() == VT && VT.isSimple() && isConstantSplatVector(TVal.getNode(), TValAPInt) && TValAPInt.isOne() && isConstantSplatVectorAllOnes(Cond.getOperand(1).getNode(), false) && isConstantSplatVectorAllOnes(FVal.getNode(), false) && !TLI.shouldAvoidTransformToShift(VT, VT.getScalarSizeInBits() - 1) {
        let mut LHS: SDValue = Cond.getOperand(0);
        let mut ShiftC: SDValue = DAG.getShiftAmountConstant(VT.getScalarSizeInBits() - 1, VT, DL);
        let mut Shift: SDValue = DAG.getNode(SRA, DL, VT, LHS, ShiftC);
        return DAG.getNode(OR, DL, VT, Shift, TVal);
    }
    if CondVT.getScalarSizeInBits() != VT.getScalarSizeInBits() {
        return SDValue {};
    }
    if DAG.ComputeNumSignBits(Cond, 0) != CondVT.getScalarSizeInBits() {
        return SDValue {};
    }
    if !IsTAllOne && !IsFAllZero && Cond.hasOneUse() && Cond.getOpcode() == SETCC && TLI.getSetCCResultType(DAG.getDataLayout(), *DAG.getContext(), VT) == CondVT {
        if IsTAllZero || IsFAllOne {
            let mut CC: SDValue = Cond.getOperand(2);
            let mut InverseCC: CondCode = getSetCCInverse(cast(CC).get(), Cond.getOperand(0).getValueType());
            Cond = DAG.getSetCC(DL, CondVT, Cond.getOperand(0), Cond.getOperand(1), InverseCC, SDValue {}, false, SDNodeFlags { Flags: None });
            swap(TVal, FVal);
            swap(IsTAllOne, IsFAllOne);
            swap(IsTAllZero, IsFAllZero);
        }
    }
    assert!(DAG.ComputeNumSignBits(Cond, 0) == CondVT.getScalarSizeInBits(), "Select condition no longer all-sign bits");
    if IsTAllOne && IsFAllZero {
        return DAG.getBitcast(VT, Cond);
    }
    if IsTAllOne {
        let mut X: SDValue = DAG.getBitcast(CondVT, DAG.getFreeze(FVal));
        let mut Or: SDValue = DAG.getNode(OR, DL, CondVT, Cond, X);
        return DAG.getBitcast(VT, Or);
    }
    if IsFAllZero {
        let mut X: SDValue = DAG.getBitcast(CondVT, DAG.getFreeze(TVal));
        let mut And: SDValue = DAG.getNode(AND, DL, CondVT, Cond, X);
        return DAG.getBitcast(VT, And);
    }
    if IsTAllZero && (isBitwiseNot(peekThroughBitcasts(Cond), false) || TLI.hasAndNot(Cond)) {
        let mut X: SDValue = DAG.getBitcast(CondVT, DAG.getFreeze(FVal));
        let mut And: SDValue = DAG.getNode(AND, DL, CondVT, DAG.getNOT(DL, Cond, CondVT), X);
        return DAG.getBitcast(VT, And);
    }
    return SDValue {};
}

fn DAGCombiner::visitVSELECT(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut N2: SDValue = N.getOperand(2);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.simplifySelect(N0, N1, N2) {
        V;
    } else {
        return V;
    }
    if foldBoolSelectToLogic(N, DL, self.DAG) {
        V;
    } else {
        return V;
    }
    if !self.TLI.isTargetCanonicalSelect(N) {
        if extractBooleanFlip(N0, self.DAG, self.TLI, false) {
            F;
        } else {
            return self.DAG.getSelect(DL, VT, F, N2, N1, N.getFlags());
        }
    }
    if N1.getOpcode() == ADD && N1.getOperand(0) == N2 && operator(N1).hasOneUse() && self.DAG.isConstantIntBuildVectorOrConstantInt(N1.getOperand(1), true) && N0.getScalarValueSizeInBits() == N1.getScalarValueSizeInBits() && self.TLI.getBooleanContents(N0.getValueType()) == ZeroOrNegativeOneBooleanContent {
        return self.DAG.getNode(ADD, DL, N1.getValueType(), N2, self.DAG.getNode(AND, DL, N0.getValueType(), N1.getOperand(1), N0));
    }
    if N0.getOpcode() == SETCC {
        let mut LHS: SDValue = N0.getOperand(0);
        let mut RHS: SDValue = N0.getOperand(1);
        let mut CC: CondCode = cast(N0.getOperand(2)).get();
        let mut isAbs: bool = false;
        let mut RHSIsAllZeros: bool = isBuildVectorAllZeros(RHS.getNode());
        if ((RHSIsAllZeros && (CC == SETGT || CC == SETGE)) || (isBuildVectorAllOnes(RHS.getNode()) && CC == SETGT)) && N1 == LHS && N2.getOpcode() == SUB && N1 == N2.getOperand(1) {
            isAbs = isBuildVectorAllZeros(N2.getOperand(0).getNode());
        } else if (RHSIsAllZeros && (CC == SETLT || CC == SETLE)) && N2 == LHS && N1.getOpcode() == SUB && N2 == N1.getOperand(1) {
            isAbs = isBuildVectorAllZeros(N1.getOperand(0).getNode());
        }
        if isAbs {
            if self.TLI.isOperationLegalOrCustom(ABS, VT, false) {
                return self.DAG.getNode(ABS, DL, VT, LHS);
            }
            let mut Shift: SDValue = self.DAG.getNode(SRA, DL, VT, LHS, self.DAG.getShiftAmountConstant(VT.getScalarSizeInBits() - 1, VT, DL));
            let mut Add: SDValue = self.DAG.getNode(ADD, DL, VT, LHS, Shift);
            self.AddToWorklist(Shift.getNode(), true, false);
            self.AddToWorklist(Add.getNode(), true, false);
            return self.DAG.getNode(XOR, DL, VT, Add, Shift);
        }
        if N0.hasOneUse() && isLegalToCombineMinNumMaxNum(self.DAG, LHS, RHS, N.getFlags(), operator(N0).getFlags(), self.TLI) {
            if self.combineMinNumMaxNum(DL, VT, LHS, RHS, N1, N2, CC) {
                FMinMax;
            } else {
                return FMinMax;
            }
        }
        if PerformMinMaxFpToSatCombine(LHS, RHS, N1, N2, CC, self.DAG) {
            S;
        } else {
            return S;
        }
        if PerformUMinFpToSatCombine(LHS, RHS, N1, N2, CC, self.DAG) {
            S;
        } else {
            return S;
        }
        if performNanGuardFpToSatCombine(N, self.DAG) {
            S;
        } else {
            return S;
        }
        if isNullOrNullSplat(RHS, false) {
            let mut NarrowVT: EVT = LHS.getValueType();
            let mut WideVT: EVT = N1.getValueType().changeVectorElementTypeToInteger();
            let mut SetCCVT: EVT = self.getSetCCResultType(LHS.getValueType());
            let mut SetCCWidth: u32 = SetCCVT.getScalarSizeInBits();
            let mut WideWidth: u32 = WideVT.getScalarSizeInBits();
            let mut IsSigned: bool = isSignedIntSetCC(CC);
            let mut LoadExtOpcode: LoadExtType = if IsSigned { SEXTLOAD } else { ZEXTLOAD };
            if LHS.getOpcode() == LOAD && LHS.hasOneUse() && SetCCWidth != 1 && SetCCWidth < WideWidth && self.TLI.isOperationLegalOrCustom(SETCC, WideVT, false) {
                let mut Ld: *mut LoadSDNode = cast(LHS);
                if self.TLI.isLoadLegalOrCustom(WideVT, NarrowVT, Ld.getAlign(), Ld.getAddressSpace(), LoadExtOpcode, false) {
                    let mut ExtOpcode: NodeType = if IsSigned { SIGN_EXTEND } else { ZERO_EXTEND };
                    let mut WideLHS: SDValue = self.DAG.getNode(ExtOpcode, DL, WideVT, LHS);
                    let mut WideRHS: SDValue = self.DAG.getNode(ExtOpcode, DL, WideVT, RHS);
                    let mut WideSetCCVT: EVT = self.getSetCCResultType(WideVT);
                    let mut WideSetCC: SDValue = self.DAG.getSetCC(DL, WideSetCCVT, WideLHS, WideRHS, CC, SDValue {}, false, SDNodeFlags { Flags: None });
                    return self.DAG.getSelect(DL, N1.getValueType(), WideSetCC, N1, N2, SDNodeFlags { Flags: None });
                }
            }
        }
        if self.foldSelectToABD(LHS, RHS, N1, N2, CC, DL) {
            ABD;
        } else {
            return ABD;
        }
        if self.hasOperation(UADDSAT, VT) {
            let mut Other: SDValue = SDValue {};
            let mut SatCC: CondCode = CC;
            if isConstantSplatVectorAllOnes(N1.getNode(), false) {
                Other = N2;
                SatCC = getSetCCInverse(SatCC, VT.getScalarType());
            } else if isConstantSplatVectorAllOnes(N2.getNode(), false) {
                Other = N1;
            }
            if Other && Other.getOpcode() == ADD {
                let mut CondLHS: SDValue = LHS;
                let mut CondRHS: SDValue = RHS;
                let mut OpLHS: SDValue = Other.getOperand(0);
                let mut OpRHS: SDValue = Other.getOperand(1);
                if SatCC == SETUGE {
                    swap(CondLHS, CondRHS);
                    SatCC = SETULE;
                }
                if SatCC == SETULE && Other == CondRHS && (OpLHS == CondLHS || OpRHS == CondLHS) {
                    return self.DAG.getNode(UADDSAT, DL, VT, OpLHS, OpRHS);
                }
                if OpRHS.getOpcode() == CondRHS.getOpcode() && (OpRHS.getOpcode() == BUILD_VECTOR || OpRHS.getOpcode() == SPLAT_VECTOR) && CondLHS == OpLHS {
                    let mut MatchUADDSAT: Closure_48 = Closure_48 {};
                    if SatCC == SETULE && matchBinaryPredicate(OpRHS, CondRHS, function<bool (ConstantSDNode *, ConstantSDNode *)> { MatchUADDSAT }, false, false) {
                        return self.DAG.getNode(UADDSAT, DL, VT, OpLHS, OpRHS);
                    }
                }
            }
        }
        if self.hasOperation(USUBSAT, VT) {
            let mut Other: SDValue = SDValue {};
            let mut SatCC: CondCode = CC;
            if isConstantSplatVectorAllZeros(N1.getNode(), false) {
                Other = N2;
                SatCC = getSetCCInverse(SatCC, VT.getScalarType());
            } else if isConstantSplatVectorAllZeros(N2.getNode(), false) {
                Other = N1;
            }
            if Other && Other.getOpcode() == TRUNCATE && Other.getOperand(0).getOpcode() == SUB && (SatCC == SETUGE || SatCC == SETUGT) {
                let mut OpLHS: SDValue = Other.getOperand(0).getOperand(0);
                let mut OpRHS: SDValue = Other.getOperand(0).getOperand(1);
                if LHS == OpLHS && RHS == OpRHS && LHS.getOpcode() == ZERO_EXTEND {
                    if getTruncatedUSUBSAT(VT, LHS.getValueType(), LHS, RHS, self.DAG, DL) {
                        R;
                    } else {
                        return R;
                    }
                }
            }
            if Other && Other.getNumOperands() == 2 {
                let mut CondRHS: SDValue = RHS;
                let mut OpLHS: SDValue = Other.getOperand(0);
                let mut OpRHS: SDValue = Other.getOperand(1);
                if OpLHS == LHS {
                    if (SatCC == SETUGE || SatCC == SETUGT) && Other.getOpcode() == SUB && OpRHS == CondRHS {
                        return self.DAG.getNode(USUBSAT, DL, VT, OpLHS, OpRHS);
                    }
                    if OpRHS.getOpcode() == BUILD_VECTOR || OpRHS.getOpcode() == SPLAT_VECTOR {
                        if CondRHS.getOpcode() == BUILD_VECTOR || CondRHS.getOpcode() == SPLAT_VECTOR {
                            let mut MatchUSUBSAT: Closure_49 = Closure_49 {};
                            if SatCC == SETUGT && Other.getOpcode() == ADD && matchBinaryPredicate(OpRHS, CondRHS, function<bool (ConstantSDNode *, ConstantSDNode *)> { MatchUSUBSAT }, true, false) {
                                OpRHS = self.DAG.getNegative(OpRHS, DL, VT);
                                return self.DAG.getNode(USUBSAT, DL, VT, OpLHS, OpRHS);
                            }
                            let mut SplatValue: APInt = APInt {};
                            if SatCC == SETLT && Other.getOpcode() == XOR && isConstantSplatVector(OpRHS.getNode(), SplatValue) && isConstantSplatVectorAllZeros(CondRHS.getNode(), false) && SplatValue.isSignMask() {
                                OpRHS = self.DAG.getConstant(SplatValue, DL, VT, false, false);
                                return self.DAG.getNode(USUBSAT, DL, VT, OpLHS, OpRHS);
                            }
                        }
                    }
                }
            }
        }
        if self.foldSelectToUMin(LHS, RHS, N1, N2, CC, DL) {
            UMin;
        } else {
            return UMin;
        }
    }
    if self.SimplifySelectOps(N, N1, N2) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if isConstantSplatVectorAllOnes(N0.getNode(), false) {
        return N1;
    }
    if isConstantSplatVectorAllZeros(N0.getNode(), false) {
        return N2;
    }
    if N1.getOpcode() == CONCAT_VECTORS && N2.getOpcode() == CONCAT_VECTORS && isBuildVectorOfConstantSDNodes(N0.getNode()) {
        if ConvertSelectToConcatVector(N, self.DAG) {
            CV;
        } else {
            return CV;
        }
    }
    if self.foldVSelectOfConstants(N) {
        V;
    } else {
        return V;
    }
    if self.hasOperation(SRA, VT) {
        if foldVSelectToSignBitSplatMask(N, self.DAG) {
            V;
        } else {
            return V;
        }
    }
    if self.SimplifyDemandedVectorElts(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if combineVSelectWithAllOnesOrZeros(N0, N1, N2, self.TLI, self.DAG, DL) {
        V;
    } else {
        return V;
    }
    if combineSelectToPseudoMinMax(self.DAG, N) {
        R;
    } else {
        return R;
    }
    return SDValue {};
}

fn DAGCombiner::visitSELECT_CC(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut N2: SDValue = N.getOperand(2);
    let mut N3: SDValue = N.getOperand(3);
    let mut N4: SDValue = N.getOperand(4);
    let mut CC: CondCode = cast(N4).get();
    let mut DL: SDLoc = SDLoc { N };
    if N2 == N3 {
        return N2;
    }
    if foldSelectCCOfSelect(N, self.DAG) {
        R;
    } else {
        return R;
    }
    if CC == SETEQ && !self.LegalTypes && N0.getValueType() == EVT { i1 } && isNullConstant(N1) {
        return self.DAG.getSelect(DL, N2.getValueType(), N0, N3, N2, SDNodeFlags { Flags: None });
    }
    if self.SimplifySetCC(self.getSetCCResultType(N0.getValueType()), N0, N1, CC, DL, false) {
        SCC;
    } else {
        self.AddToWorklist(SCC.getNode(), true, false);
        if dyn_cast(SCC.getNode()) {
            SCCC;
        } else {
            return if SCCC.isZero() { N3 } else { N2 };
        }
        if operator(SCC).isUndef() {
            return N2;
        }
        if SCC.getOpcode() == SETCC {
            return self.DAG.getNode(SELECT_CC, DL, N2.getValueType(), SCC.getOperand(0), SCC.getOperand(1), N2, N3, SCC.getOperand(2), operator(SCC).getFlags());
        }
    }
    if self.SimplifySelectOps(N, N2, N3) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if Opcode {
        return self.DAG.getNode(Opcode, DL, N.getValueType(0), NewLHS, NewRHS, N.getFlags());
    }
    return self.SimplifySelectCC(DL, N0, N1, N2, N3, CC, false);
}

fn DAGCombiner::visitSETCC(self, N: *mut SDNode) -> SDValue {
    let mut PreferSetCC: bool = N.hasOneUse() && (operator(N.user_begin()).getOpcode() == BRCOND || operator(N.user_begin()).getOpcode() == COND_LOOP);
    let mut Cond: CondCode = cast(N.getOperand(2)).get();
    let mut VT: EVT = N.getValueType(0);
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut DL: SDLoc = SDLoc { N };
    if self.SimplifySetCC(VT, N0, N1, Cond, DL, !PreferSetCC) {
        Combined;
    } else {
        if PreferSetCC && Combined.getOpcode() != SETCC {
            let mut NewSetCC: SDValue = self.rebuildSetCC(Combined);
            if NewSetCC.getNode() == N {
                return SDValue {};
            }
            if NewSetCC {
                return NewSetCC;
            }
        }
        return Combined;
    }
    if Cond == SETNE || Cond == SETEQ {
        let mut IsAndWithShift: Closure_50 = Closure_50 {};
        let mut IsRotateWithOp: Closure_51 = Closure_51 {};
        let mut AndOrOp: SDValue = SDValue {};
        let mut ShiftOrRotate: SDValue = SDValue {};
        let mut IsRotate: bool = false;
        if IsAndWithShift.call(N0, N1) {
            AndOrOp = N0;
            ShiftOrRotate = N1;
        } else if IsAndWithShift.call(N1, N0) {
            AndOrOp = N1;
            ShiftOrRotate = N0;
        } else if IsRotateWithOp.call(N0, N1) {
            IsRotate = true;
            AndOrOp = N0;
            ShiftOrRotate = N1;
        } else if IsRotateWithOp.call(N1, N0) {
            IsRotate = true;
            AndOrOp = N1;
            ShiftOrRotate = N0;
        }
        if AndOrOp && ShiftOrRotate && ShiftOrRotate.hasOneUse() && (IsRotate || AndOrOp.hasOneUse()) {
            let mut OpVT: EVT = N0.getValueType();
            let mut GetAPIntValue: Closure_52 = Closure_52 {};
            let mut AndCMask: optional<APInt> = if IsRotate { optional<APInt> { nullopt } } else { GetAPIntValue.call(AndOrOp.getOperand(1)) };
            let mut ShiftCAmt: optional<APInt> = GetAPIntValue.call(ShiftOrRotate.getOperand(1));
            let mut NumBits: u32 = OpVT.getScalarSizeInBits();
            if ShiftCAmt && (IsRotate || AndCMask) && operator(ShiftCAmt).ult(NumBits) {
                let mut ShiftOpc: u32 = ShiftOrRotate.getOpcode();
                let mut CanTransform: bool = IsRotate;
                if !CanTransform {
                    CanTransform = operator(ShiftCAmt) == (operator(operator(AndCMask))).popcount();
                    CanTransform &= (operator(ShiftCAmt) + operator(AndCMask).popcount()) == NumBits;
                    CanTransform &= if ShiftOpc == SHL { (operator(operator(AndCMask))).isMask() } else { operator(AndCMask).isMask() };
                }
                let mut MayTransformRotate: bool = !operator(ShiftCAmt).isZero() && NumBits % operator(ShiftCAmt).getZExtValue() == 0;
                let mut NewShiftOpc: u32 = self.TLI.preferedOpcodeForCmpEqPiecesOfOperand(OpVT, ShiftOpc, MayTransformRotate, operator(ShiftCAmt), AndCMask);
                if CanTransform && NewShiftOpc != ShiftOpc {
                    let mut NewShiftOrRotate: SDValue = self.DAG.getNode(NewShiftOpc, DL, OpVT, ShiftOrRotate.getOperand(0), ShiftOrRotate.getOperand(1));
                    let mut NewAndOrOp: SDValue = SDValue {};
                    if NewShiftOpc == SHL || NewShiftOpc == SRL {
                        let mut NewMask: APInt = if NewShiftOpc == SHL { getHighBitsSet(NumBits, NumBits - operator(ShiftCAmt).getZExtValue()) } else { getLowBitsSet(NumBits, NumBits - operator(ShiftCAmt).getZExtValue()) };
                        NewAndOrOp = self.DAG.getNode(AND, DL, OpVT, ShiftOrRotate.getOperand(0), self.DAG.getConstant(NewMask, DL, OpVT, false, false));
                    } else {
                        NewAndOrOp = ShiftOrRotate.getOperand(0);
                    }
                    return self.DAG.getSetCC(DL, VT, NewAndOrOp, NewShiftOrRotate, Cond, SDValue {}, false, SDNodeFlags { Flags: None });
                }
            }
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitSETCCCARRY(self, N: *mut SDNode) -> SDValue {
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut Carry: SDValue = N.getOperand(2);
    let mut Cond: SDValue = N.getOperand(3);
    if isNullConstant(Carry) {
        return self.DAG.getNode(SETCC, SDLoc { N }, N.getVTList(), LHS, RHS, Cond);
    }
    return SDValue {};
}

fn isCompatibleLoad(N: SDValue, ExtOpcode: u32) -> bool {
    if !N.hasOneUse() {
        return false;
    }
    if !isa(N) {
        return false;
    }
    let mut Load: *mut LoadSDNode = cast(N);
    let mut LoadExt: LoadExtType = Load.getExtensionType();
    if LoadExt == NON_EXTLOAD || LoadExt == EXTLOAD {
        return true;
    }
    if (LoadExt == SEXTLOAD && ExtOpcode != SIGN_EXTEND) || (LoadExt == ZEXTLOAD && ExtOpcode != ZERO_EXTEND) {
        return false;
    }
    return true;
}

fn tryToFoldExtendSelectLoad(N: *mut SDNode, TLI: *TargetLowering, DAG: *mut SelectionDAG, DL: *SDLoc, Level: CombineLevel) -> SDValue {
    let mut Opcode: u32 = N.getOpcode();
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    assert!((Opcode == SIGN_EXTEND || Opcode == ZERO_EXTEND || Opcode == ANY_EXTEND), "Expected EXTEND dag node in input!");
    let mut Cond: SDValue = SDValue {};
    let mut Op1: SDValue = SDValue {};
    let mut Op2: SDValue = SDValue {};
    if !sd_match(N0, m_OneUse(m_SelectLike(m_Value(Cond), m_Value(Op1), m_Value(Op2)))) {
        return SDValue {};
    }
    if !isCompatibleLoad(Op1, Opcode) || !isCompatibleLoad(Op2, Opcode) {
        return SDValue {};
    }
    let mut ExtLoadOpcode: LoadExtType = EXTLOAD;
    if Opcode == SIGN_EXTEND {
        ExtLoadOpcode = SEXTLOAD;
    } else if Opcode == ZERO_EXTEND {
        ExtLoadOpcode = ZEXTLOAD;
    }
    let mut Load1: *mut LoadSDNode = cast(Op1);
    let mut Load2: *mut LoadSDNode = cast(Op2);
    if !TLI.isLoadLegal(VT, Load1.getMemoryVT(), Load1.getAlign(), Load1.getAddressSpace(), ExtLoadOpcode, false) || !TLI.isLoadLegal(VT, Load2.getMemoryVT(), Load2.getAlign(), Load2.getAddressSpace(), ExtLoadOpcode, false) || (operator(N0).getOpcode() == VSELECT && Level >= AfterLegalizeTypes && TLI.getOperationAction(VSELECT, VT) != Legal) {
        return SDValue {};
    }
    let mut Ext1: SDValue = DAG.getNode(Opcode, DL, VT, Op1);
    let mut Ext2: SDValue = DAG.getNode(Opcode, DL, VT, Op2);
    return DAG.getSelect(DL, VT, Cond, Ext1, Ext2, SDNodeFlags { Flags: None });
}

fn tryToFoldExtendOfConstant(N: *mut SDNode, DL: *SDLoc, TLI: *TargetLowering, DAG: *mut SelectionDAG, LegalTypes: bool) -> SDValue {
    let mut Opcode: u32 = N.getOpcode();
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    assert!((isExtOpcode(Opcode) || isExtVecInRegOpcode(Opcode)), "Expected EXTEND dag node in input!");
    if isa(N0) {
        return DAG.getNode(Opcode, DL, VT, N0);
    }
    if operator(N0).getOpcode() == SELECT {
        let mut Op1: SDValue = operator(N0).getOperand(1);
        let mut Op2: SDValue = operator(N0).getOperand(2);
        if isa(Op1) && isa(Op2) && (Opcode != ZERO_EXTEND || !TLI.isZExtFree(N0.getValueType(), VT)) {
            let mut FoldOpc: u32 = Opcode;
            if FoldOpc == ANY_EXTEND {
                FoldOpc = SIGN_EXTEND;
            }
            return DAG.getSelect(DL, VT, operator(N0).getOperand(0), DAG.getNode(FoldOpc, DL, VT, Op1), DAG.getNode(FoldOpc, DL, VT, Op2), SDNodeFlags { Flags: None });
        }
    }
    let mut SVT: EVT = VT.getScalarType();
    if !(VT.isVector() && (!LegalTypes || TLI.isTypeLegal(SVT)) && isBuildVectorOfConstantSDNodes(N0.getNode())) {
        return SDValue {};
    }
    let mut VTBits: u32 = SVT.getSizeInBits().operator unsigned long long();
    let mut EVTBits: u32 = operator(N0).getValueType(0).getScalarSizeInBits();
    let mut Elts: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut NumElts: u32 = VT.getVectorNumElements();
    for let mut i: u32 = 0; i != NumElts; i += 1 {
        let mut Op: SDValue = N0.getOperand(i);
        if Op.isUndef() {
            if Opcode == ANY_EXTEND || Opcode == ANY_EXTEND_VECTOR_INREG {
                Elts.push(DAG.getUNDEF(SVT));
            } else {
                Elts.push(DAG.getConstant(0, DL, SVT, false, false));
            }
            continue;
        }
        let mut DL: SDLoc = SDLoc { Op };
        let mut C: APInt = operator(Op).getAsAPIntVal().zextOrTrunc(EVTBits);
        if Opcode == SIGN_EXTEND || Opcode == SIGN_EXTEND_VECTOR_INREG {
            Elts.push(DAG.getConstant(C.sext(VTBits), DL, SVT, false, false));
        } else {
            Elts.push(DAG.getConstant(C.zext(VTBits), DL, SVT, false, false));
        }
    }
    return DAG.getBuildVector(VT, DL, ArrayRef<SDValue> { Elts });
}

fn ExtendUsesToFormExtLoad(VT: EVT, N: *mut SDNode, N0: SDValue, ExtOpc: u32, ExtendNodes: *mut SmallVectorImpl<SDNode *>, TLI: *TargetLowering) -> bool {
    let mut HasCopyToRegUses: bool = false;
    let mut isTruncFree: bool = TLI.isTruncateFree(VT, N0.getValueType());
    for Use in operator(N0).uses() {
        let mut User: *mut SDNode = Use.getUser();
        if User == N {
            continue;
        }
        if Use.getResNo() != N0.getResNo() {
            continue;
        }
        if ExtOpc != ANY_EXTEND && User.getOpcode() == SETCC {
            let mut CC: CondCode = cast(User.getOperand(2)).get();
            if ExtOpc == ZERO_EXTEND && isSignedIntSetCC(CC) {
                return false;
            }
            let mut Add: bool = false;
            for let mut i: u32 = 0; i != 2; i += 1 {
                let mut UseOp: SDValue = User.getOperand(i);
                if UseOp == N0 {
                    continue;
                }
                if !isa(UseOp) {
                    return false;
                }
                Add = true;
            }
            if Add {
                ExtendNodes.push(User);
            }
            continue;
        }
        if !isTruncFree {
            return false;
        }
        if User.getOpcode() == CopyToReg {
            HasCopyToRegUses = true;
        }
    }
    if HasCopyToRegUses {
        let mut BothLiveOut: bool = false;
        for Use in N.uses() {
            if Use.getResNo() == 0 && Use.getUser().getOpcode() == CopyToReg {
                BothLiveOut = true;
                break;
            }
        }
        if BothLiveOut {
            return !ExtendNodes.is_empty();
        }
    }
    return true;
}

fn DAGCombiner::ExtendSetCCUses(self, SetCCs: *SmallVectorImpl<SDNode *>, OrigLoad: SDValue, ExtLoad: SDValue, ExtType: NodeType) {
    let mut DL: SDLoc = SDLoc { ExtLoad };
    for SetCC in SetCCs {
        let mut Ops: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
        for let mut j: u32 = 0; j != 2; j += 1 {
            let mut SOp: SDValue = SetCC.getOperand(j);
            if SOp == OrigLoad {
                Ops.push(ValueParamT { ExtLoad });
            } else {
                Ops.push(self.DAG.getNode(ExtType, DL, operator(ExtLoad).getValueType(0), SOp));
            }
        }
        Ops.push(ValueParamT { SetCC.getOperand(2) });
        self.CombineTo(SetCC, self.DAG.getNode(SETCC, DL, SetCC.getValueType(0), ArrayRef<SDValue> { Ops }), true);
    }
}

fn DAGCombiner::CombineExtLoad(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut DstVT: EVT = N.getValueType(0);
    let mut SrcVT: EVT = N0.getValueType();
    assert!((N.getOpcode() == SIGN_EXTEND || N.getOpcode() == ZERO_EXTEND), "Unexpected node type (not an extend)!");
    if operator(N0).getOpcode() != LOAD {
        return SDValue {};
    }
    let mut LN0: *mut LoadSDNode = cast(N0);
    if !isNON_EXTLoad(LN0) || !isUNINDEXEDLoad(LN0) || !N0.hasOneUse() || !LN0.isSimple() || !DstVT.isVector() || !DstVT.isPow2VectorType() || !self.TLI.isVectorLoadExtDesirable(SDValue { Node: N, ResNo: 0 }) {
        return SDValue {};
    }
    let mut SetCCs: SmallVector<SDNode *, 4> = SmallVector<SDNode *, 4> {};
    if !ExtendUsesToFormExtLoad(DstVT, N, N0, N.getOpcode(), SetCCs, self.TLI) {
        return SDValue {};
    }
    let mut ExtType: LoadExtType = if N.getOpcode() == SIGN_EXTEND { SEXTLOAD } else { ZEXTLOAD };
    let mut SplitSrcVT: EVT = SrcVT;
    let mut SplitDstVT: EVT = DstVT;
    while !self.TLI.isLoadLegalOrCustom(SplitDstVT, SplitSrcVT, LN0.getAlign(), LN0.getAddressSpace(), ExtType, false) && SplitSrcVT.getVectorNumElements() > 1 {
        SplitDstVT = self.DAG.GetSplitDestVTs(SplitDstVT).first;
        SplitSrcVT = self.DAG.GetSplitDestVTs(SplitSrcVT).first;
    }
    if !self.TLI.isLoadLegalOrCustom(SplitDstVT, SplitSrcVT, LN0.getAlign(), LN0.getAddressSpace(), ExtType, false) {
        return SDValue {};
    }
    assert!(!DstVT.isScalableVector(), "Unexpected scalable vector type");
    let mut DL: SDLoc = SDLoc { N };
    let mut NumSplits: u32 = DstVT.getVectorNumElements() / SplitDstVT.getVectorNumElements();
    let mut Stride: u32 = SplitSrcVT.getStoreSize().operator unsigned long long();
    let mut Loads: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    let mut Chains: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    let mut BasePtr: SDValue = LN0.getBasePtr();
    for let mut Idx: u32 = 0; Idx < NumSplits; Idx += 1 {
        let mut Offset: u32 = Idx * Stride;
        let mut SplitLoad: SDValue = self.DAG.getExtLoad(ExtType, SDLoc { LN0 }, SplitDstVT, LN0.getChain(), BasePtr, LN0.getPointerInfo().getWithOffset(Offset), SplitSrcVT, MaybeAlign { LN0.getBaseAlign() }, LN0.getMemOperand().getFlags(), MMOMetadata { AAInfo: LN0.getAAInfo(), Ranges: null, MemCacheHint: null });
        BasePtr = self.DAG.getMemBasePlusOffset(BasePtr, getFixed(Stride), DL, SDNodeFlags { Flags: None });
        Loads.push(SplitLoad.getValue(0));
        Chains.push(SplitLoad.getValue(1));
    }
    let mut NewChain: SDValue = self.DAG.getNode(TokenFactor, DL, EVT { Other }, ArrayRef<SDValue> { Chains });
    let mut NewValue: SDValue = self.DAG.getNode(CONCAT_VECTORS, DL, DstVT, ArrayRef<SDValue> { Loads });
    self.AddToWorklist(NewChain.getNode(), true, false);
    self.CombineTo(N, NewValue, true);
    let mut Trunc: SDValue = self.DAG.getNode(TRUNCATE, SDLoc { N0 }, N0.getValueType(), NewValue);
    self.ExtendSetCCUses(SetCCs, N0, NewValue, N.getOpcode() as NodeType);
    self.CombineTo(N0.getNode(), Trunc, NewChain, true);
    return SDValue { Node: N, ResNo: 0 };
}

fn DAGCombiner::CombineZExtLogicopShiftLoad(self, N: *mut SDNode) -> SDValue {
    assert!(N.getOpcode() == ZERO_EXTEND);
    let mut VT: EVT = N.getValueType(0);
    let mut OrigVT: EVT = N.getOperand(0).getValueType();
    if self.TLI.isZExtFree(OrigVT, VT) {
        return SDValue {};
    }
    let mut N0: SDValue = N.getOperand(0);
    if !isBitwiseLogicOp(N0.getOpcode()) || N0.getOperand(1).getOpcode() != Constant || (self.LegalOperations && !self.TLI.isOperationLegal(N0.getOpcode(), VT)) {
        return SDValue {};
    }
    let mut N1: SDValue = operator(N0).getOperand(0);
    if !(N1.getOpcode() == SHL || N1.getOpcode() == SRL) || N1.getOperand(1).getOpcode() != Constant || (self.LegalOperations && !self.TLI.isOperationLegal(N1.getOpcode(), VT)) {
        return SDValue {};
    }
    if !isa(N1.getOperand(0)) {
        return SDValue {};
    }
    let mut Load: *mut LoadSDNode = cast(N1.getOperand(0));
    let mut MemVT: EVT = Load.getMemoryVT();
    if !self.TLI.isLoadLegal(VT, MemVT, Load.getAlign(), Load.getAddressSpace(), ZEXTLOAD, false) || Load.getExtensionType() == SEXTLOAD || Load.isIndexed() {
        return SDValue {};
    }
    if N1.getOpcode() == SHL && N0.getOpcode() != AND {
        return SDValue {};
    }
    if !N0.hasOneUse() || !N1.hasOneUse() {
        return SDValue {};
    }
    let mut SetCCs: SmallVector<SDNode *, 4> = SmallVector<SDNode *, 4> {};
    if !ExtendUsesToFormExtLoad(VT, N1.getNode(), N1.getOperand(0), ZERO_EXTEND, SetCCs, self.TLI) {
        return SDValue {};
    }
    let mut ExtLoad: SDValue = self.DAG.getExtLoad(ZEXTLOAD, SDLoc { Load }, VT, Load.getChain(), Load.getBasePtr(), Load.getMemoryVT(), Load.getMemOperand());
    let mut DL1: SDLoc = SDLoc { N1 };
    let mut Shift: SDValue = self.DAG.getNode(N1.getOpcode(), DL1, VT, ExtLoad, N1.getOperand(1));
    let mut Mask: APInt = N0.getConstantOperandAPInt(1).zext(VT.getSizeInBits().operator unsigned long long());
    let mut DL0: SDLoc = SDLoc { N0 };
    let mut And: SDValue = self.DAG.getNode(N0.getOpcode(), DL0, VT, Shift, self.DAG.getConstant(Mask, DL0, VT, false, false));
    self.ExtendSetCCUses(SetCCs, N1.getOperand(0), ExtLoad, ZERO_EXTEND);
    self.CombineTo(N, And, true);
    if SDValue { Node: Load, ResNo: 0 }.hasOneUse() {
        self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: Load, ResNo: 1 }, ExtLoad.getValue(1));
    } else {
        let mut Trunc: SDValue = self.DAG.getNode(TRUNCATE, SDLoc { Load }, Load.getValueType(0), ExtLoad);
        self.CombineTo(Load, Trunc, ExtLoad.getValue(1), true);
    }
    self.recursivelyDeleteUnusedNodes(N0.getNode());
    return SDValue { Node: N, ResNo: 0 };
}

fn DAGCombiner::matchVSelectOpSizesWithSetCC(self, Cast: *mut SDNode) -> SDValue {
    let mut CastOpcode: u32 = Cast.getOpcode();
    assert!((CastOpcode == SIGN_EXTEND || CastOpcode == ZERO_EXTEND || CastOpcode == TRUNCATE || CastOpcode == FP_EXTEND || CastOpcode == FP_ROUND), "Unexpected opcode for vector select narrowing/widening");
    let mut VT: EVT = Cast.getValueType(0);
    if self.LegalOperations || !self.TLI.isOperationLegalOrCustom(VSELECT, VT, false) {
        return SDValue {};
    }
    let mut VSel: SDValue = Cast.getOperand(0);
    if VSel.getOpcode() != VSELECT || !VSel.hasOneUse() || VSel.getOperand(0).getOpcode() != SETCC {
        return SDValue {};
    }
    let mut SetCC: SDValue = VSel.getOperand(0);
    let mut SetCCVT: EVT = self.getSetCCResultType(SetCC.getOperand(0).getValueType());
    if SetCCVT.getSizeInBits() != VT.getSizeInBits() {
        return SDValue {};
    }
    let mut A: SDValue = VSel.getOperand(1);
    let mut B: SDValue = VSel.getOperand(2);
    let mut CastA: SDValue = SDValue {};
    let mut CastB: SDValue = SDValue {};
    let mut DL: SDLoc = SDLoc { Cast };
    if CastOpcode == FP_ROUND {
        CastA = self.DAG.getNode(CastOpcode, DL, VT, A, Cast.getOperand(1));
        CastB = self.DAG.getNode(CastOpcode, DL, VT, B, Cast.getOperand(1));
    } else {
        CastA = self.DAG.getNode(CastOpcode, DL, VT, A);
        CastB = self.DAG.getNode(CastOpcode, DL, VT, B);
    }
    return self.DAG.getNode(VSELECT, DL, VT, SetCC, CastA, CastB);
}

fn tryToFoldExtOfExtload(DAG: *mut SelectionDAG, Combiner: *mut DAGCombiner, TLI: *TargetLowering, VT: EVT, LegalOperations: bool, N: *mut SDNode, N0: SDValue, ExtLoadType: LoadExtType) -> SDValue {
    let mut Frozen: bool = N0.getOpcode() == FREEZE;
    let mut OldExtLoad: *mut LoadSDNode = dyn_cast(if Frozen { N0.getOperand(0) } else { N0 });
    if !OldExtLoad {
        return SDValue {};
    }
    let mut isAExtLoad: bool = if (ExtLoadType == SEXTLOAD) { isSEXTLoad(OldExtLoad) } else { isZEXTLoad(OldExtLoad) };
    if (!isAExtLoad && !isEXTLoad(OldExtLoad)) || !isUNINDEXEDLoad(OldExtLoad) || !OldExtLoad.hasNUsesOfValue(1, 0) {
        return SDValue {};
    }
    let mut MemVT: EVT = OldExtLoad.getMemoryVT();
    if (LegalOperations || !OldExtLoad.isSimple() || VT.isVector()) && !TLI.isLoadLegal(VT, MemVT, OldExtLoad.getAlign(), OldExtLoad.getAddressSpace(), ExtLoadType, false) {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { OldExtLoad };
    let mut ExtLoad: SDValue = DAG.getExtLoad(ExtLoadType, DL, VT, OldExtLoad.getChain(), OldExtLoad.getBasePtr(), MemVT, OldExtLoad.getMemOperand());
    let mut Res: SDValue = ExtLoad;
    if Frozen {
        Res = DAG.getFreeze(ExtLoad);
        Res = DAG.getNode(if ExtLoadType == SEXTLOAD { AssertSext } else { AssertZext }, DL, Res.getValueType(), Res, DAG.getValueType(OldExtLoad.getValueType(0).getScalarType()));
    }
    Combiner.CombineTo(N, Res, true);
    DAG.ReplaceAllUsesOfValueWith(SDValue { Node: OldExtLoad, ResNo: 1 }, ExtLoad.getValue(1));
    if operator(N0).use_empty() {
        Combiner.recursivelyDeleteUnusedNodes(N0.getNode());
    }
    return SDValue { Node: N, ResNo: 0 };
}

fn tryToFoldExtOfLoad(DAG: *mut SelectionDAG, Combiner: *mut DAGCombiner, TLI: *TargetLowering, VT: EVT, LegalOperations: bool, N: *mut SDNode, N0: SDValue, ExtLoadType: LoadExtType, ExtOpc: NodeType, NonNegZExt: bool) -> SDValue {
    let mut Frozen: bool = N0.getOpcode() == FREEZE;
    let mut Freeze: SDValue = if Frozen { N0 } else { SDValue {} };
    let mut Load: *mut LoadSDNode = dyn_cast(if Frozen { N0.getOperand(0) } else { N0 });
    if !Load || !isNON_EXTLoad(Load) || !isUNINDEXEDLoad(Load) || (Frozen && !Load.hasNUsesOfValue(1, 0)) {
        return SDValue {};
    }
    if NonNegZExt {
        assert!(ExtLoadType == ZEXTLOAD && ExtOpc == ZERO_EXTEND, "Unexpected load type or opcode");
        for User in Load.users() {
            if User.getOpcode() == SETCC {
                let mut CC: CondCode = cast(User.getOperand(2)).get();
                if isSignedIntSetCC(CC) {
                    ExtLoadType = SEXTLOAD;
                    ExtOpc = SIGN_EXTEND;
                    break;
                }
            }
        }
    }
    if (LegalOperations || VT.isFixedLengthVector() || !Load.isSimple()) && !TLI.isLoadLegal(VT, Load.getValueType(0), Load.getAlign(), Load.getAddressSpace(), ExtLoadType, false) {
        return SDValue {};
    }
    let mut DoXform: bool = true;
    let mut SetCCs: SmallVector<SDNode *, 4> = SmallVector<SDNode *, 4> {};
    if !operator(N0).hasOneUse() {
        DoXform = ExtendUsesToFormExtLoad(VT, N, if Frozen { Freeze } else { SDValue { Node: Load, ResNo: 0 } }, ExtOpc, SetCCs, TLI);
    }
    if VT.isVector() {
        DoXform &= TLI.isVectorLoadExtDesirable(SDValue { Node: N, ResNo: 0 });
    }
    if !DoXform {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { Load };
    let mut SalvageDbgValue: Closure_53 = Closure_53 { DAG: &mut DAG };
    let mut SalvageToOldLoadSize: Closure_54 = Closure_54 { DAG: &mut DAG, SalvageDbgValue: &mut SalvageDbgValue };
    let mut ExtLoad: SDValue = DAG.getExtLoad(ExtLoadType, DL, VT, Load.getChain(), Load.getBasePtr(), Load.getValueType(0), Load.getMemOperand());
    let mut Res: SDValue = ExtLoad;
    if Frozen {
        Res = DAG.getFreeze(ExtLoad);
        Res = DAG.getNode(if ExtLoadType == SEXTLOAD { AssertSext } else { AssertZext }, DL, Res.getValueType(), Res, DAG.getValueType(Load.getValueType(0).getScalarType()));
    }
    Combiner.ExtendSetCCUses(SetCCs, N0, Res, ExtOpc);
    let mut NoReplaceTrunc: bool = N0.hasOneUse();
    if N.getHasDebugValue() {
        let mut OldExtValue: SDValue = SDValue { Node: N, ResNo: 0 };
        DAG.transferDbgValues(OldExtValue, ExtLoad, 0, 0, true);
    }
    if NoReplaceTrunc {
        let mut IsSigned: bool = N.getOpcode() == SIGN_EXTEND;
        if Load.getHasDebugValue() {
            let mut OldLoadVal: SDValue = SDValue { Node: Load, ResNo: 0 };
            SalvageToOldLoadSize.call(OldLoadVal, ExtLoad, IsSigned);
        }
        DAG.ReplaceAllUsesOfValueWith(SDValue { Node: Load, ResNo: 1 }, ExtLoad.getValue(1));
        Combiner.CombineTo(N, Res, true);
        Combiner.recursivelyDeleteUnusedNodes(N0.getNode());
    } else {
        Combiner.CombineTo(N, Res, true);
        let mut Trunc: SDValue = DAG.getNode(TRUNCATE, DL, Load.getValueType(0), Res);
        if Frozen {
            Combiner.CombineTo(Freeze.getNode(), Trunc, true);
            DAG.ReplaceAllUsesOfValueWith(SDValue { Node: Load, ResNo: 1 }, ExtLoad.getValue(1));
        } else {
            Combiner.CombineTo(Load, Trunc, ExtLoad.getValue(1), true);
        }
    }
    return SDValue { Node: N, ResNo: 0 };
}

fn tryToFoldExtOfMaskedLoad(DAG: *mut SelectionDAG, TLI: *TargetLowering, VT: EVT, LegalOperations: bool, N: *mut SDNode, N0: SDValue, ExtLoadType: LoadExtType, ExtOpc: NodeType) -> SDValue {
    if !N0.hasOneUse() {
        return SDValue {};
    }
    let mut Ld: *mut MaskedLoadSDNode = dyn_cast(N0);
    if !Ld || Ld.getExtensionType() != NON_EXTLOAD {
        return SDValue {};
    }
    if (LegalOperations || !cast(N0).isSimple()) && !TLI.isLoadLegalOrCustom(VT, Ld.getValueType(0), Ld.getAlign(), Ld.getAddressSpace(), ExtLoadType, false) {
        return SDValue {};
    }
    if !TLI.isVectorLoadExtDesirable(SDValue { Node: N, ResNo: 0 }) {
        return SDValue {};
    }
    let mut dl: SDLoc = SDLoc { Ld };
    let mut PassThru: SDValue = DAG.getNode(ExtOpc, dl, VT, Ld.getPassThru());
    let mut NewLoad: SDValue = DAG.getMaskedLoad(VT, dl, Ld.getChain(), Ld.getBasePtr(), Ld.getOffset(), Ld.getMask(), PassThru, Ld.getMemoryVT(), Ld.getMemOperand(), Ld.getAddressingMode(), ExtLoadType, Ld.isExpandingLoad());
    DAG.ReplaceAllUsesOfValueWith(SDValue { Node: Ld, ResNo: 1 }, SDValue { Node: NewLoad.getNode(), ResNo: 1 });
    return NewLoad;
}

fn tryToFoldExtOfAtomicLoad(DAG: *mut SelectionDAG, TLI: *TargetLowering, VT: EVT, N0: SDValue, ExtLoadType: LoadExtType) -> SDValue {
    let mut ALoad: *mut AtomicSDNode = dyn_cast(N0);
    if !ALoad || ALoad.getOpcode() != ATOMIC_LOAD {
        return SDValue {};
    }
    let mut MemoryVT: EVT = ALoad.getMemoryVT();
    if !TLI.isLoadLegal(VT, MemoryVT, ALoad.getAlign(), ALoad.getAddressSpace(), ExtLoadType, true) {
        return SDValue {};
    }
    let mut ALoadExtTy: LoadExtType = ALoad.getExtensionType();
    if (ALoadExtTy == ZEXTLOAD && ExtLoadType == SEXTLOAD) || (ALoadExtTy == SEXTLOAD && ExtLoadType == ZEXTLOAD) {
        return SDValue {};
    }
    let mut OrigVT: EVT = ALoad.getValueType(0);
    assert!(OrigVT.getSizeInBits().operator unsigned long long() < VT.getSizeInBits().operator unsigned long long(), "VT should be wider.");
    let mut NewALoad: *mut AtomicSDNode = cast(DAG.getAtomicLoad(ExtLoadType, SDLoc { ALoad }, MemoryVT, VT, ALoad.getChain(), ALoad.getBasePtr(), ALoad.getMemOperand()));
    DAG.ReplaceAllUsesOfValueWith(SDValue { Node: ALoad, ResNo: 0 }, DAG.getNode(TRUNCATE, SDLoc { ALoad }, OrigVT, SDValue { Node: NewALoad, ResNo: 0 }));
    DAG.ReplaceAllUsesOfValueWith(SDValue { Node: ALoad, ResNo: 1 }, SDValue { Node: NewALoad, ResNo: 1 });
    return SDValue { Node: NewALoad, ResNo: 0 };
}

fn foldExtendedSignBitTest(N: *mut SDNode, DAG: *mut SelectionDAG, LegalOperations: bool) -> SDValue {
    assert!((N.getOpcode() == SIGN_EXTEND || N.getOpcode() == ZERO_EXTEND), "Expected sext or zext");
    let mut SetCC: SDValue = N.getOperand(0);
    if LegalOperations || SetCC.getOpcode() != SETCC || !SetCC.hasOneUse() || SetCC.getValueType() != EVT { i1 } {
        return SDValue {};
    }
    let mut X: SDValue = SetCC.getOperand(0);
    let mut Ones: SDValue = SetCC.getOperand(1);
    let mut CC: CondCode = cast(SetCC.getOperand(2)).get();
    let mut VT: EVT = N.getValueType(0);
    let mut XVT: EVT = X.getValueType();
    if CC == SETGT && isAllOnesConstant(Ones) && VT == XVT {
        let mut DL: SDLoc = SDLoc { N };
        let mut ShCt: u32 = VT.getSizeInBits().operator unsigned long long() - 1;
        let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
        if !TLI.shouldAvoidTransformToShift(VT, ShCt) {
            let mut NotX: SDValue = DAG.getNOT(DL, X, VT);
            let mut ShiftAmount: SDValue = DAG.getConstant(ShCt, DL, VT, false, false);
            let mut ShiftOpcode: NodeType = if N.getOpcode() == SIGN_EXTEND { SRA } else { SRL };
            return DAG.getNode(ShiftOpcode, DL, VT, NotX, ShiftAmount);
        }
    }
    return SDValue {};
}

fn DAGCombiner::foldSextSetcc(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    if N0.getOpcode() != SETCC {
        return SDValue {};
    }
    let mut N00: SDValue = N0.getOperand(0);
    let mut N01: SDValue = N0.getOperand(1);
    let mut CC: CondCode = cast(N0.getOperand(2)).get();
    let mut VT: EVT = N.getValueType(0);
    let mut N00VT: EVT = N00.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    let mut Flags: SDNodeFlags = operator(N0).getFlags();
    if VT.isVector() && !self.LegalOperations && self.TLI.getBooleanContents(N00VT) == ZeroOrNegativeOneBooleanContent {
        let mut SVT: EVT = self.getSetCCResultType(N00VT);
        if SVT != N0.getValueType() {
            if VT.getSizeInBits() == SVT.getSizeInBits() {
                return self.DAG.getSetCC(DL, VT, N00, N01, CC, SDValue {}, false, Flags);
            }
            let mut MatchingVecType: EVT = N00VT.changeVectorElementTypeToInteger();
            if SVT == MatchingVecType {
                let mut VsetCC: SDValue = self.DAG.getSetCC(DL, MatchingVecType, N00, N01, CC, SDValue {}, false, Flags);
                return self.DAG.getSExtOrTrunc(VsetCC, DL, VT);
            }
        }
        if N0.hasOneUse() && self.TLI.isOperationLegalOrCustom(SETCC, VT, false) && !self.TLI.isOperationLegalOrCustom(SETCC, SVT, false) {
            let mut IsSignedCmp: bool = isSignedIntSetCC(CC);
            let mut LoadOpcode: u32 = if IsSignedCmp { SEXTLOAD } else { ZEXTLOAD };
            let mut ExtOpcode: u32 = if IsSignedCmp { SIGN_EXTEND } else { ZERO_EXTEND };
            let mut IsFreeToExtend: Closure_55 = Closure_55 { cap_0: self, VT: &mut VT, LoadOpcode: &mut LoadOpcode, N0: &mut N0, ExtOpcode: &mut ExtOpcode };
            if IsFreeToExtend.call(N00) && IsFreeToExtend.call(N01) {
                let mut Ext0: SDValue = self.DAG.getNode(ExtOpcode, DL, VT, N00);
                let mut Ext1: SDValue = self.DAG.getNode(ExtOpcode, DL, VT, N01);
                return self.DAG.getSetCC(DL, VT, Ext0, Ext1, CC, SDValue {}, false, Flags);
            }
        }
    }
    let mut SetCCWidth: u32 = N0.getScalarValueSizeInBits();
    let mut ExtTrueVal: SDValue = if (SetCCWidth == 1) { self.DAG.getAllOnesConstant(DL, VT, false, false) } else { self.DAG.getBoolConstant(true, DL, VT, N00VT) };
    let mut Zero: SDValue = self.DAG.getConstant(0, DL, VT, false, false);
    if self.SimplifySelectCC(DL, N00, N01, ExtTrueVal, Zero, CC, true) {
        SCC;
    } else {
        return SCC;
    }
    if !VT.isVector() && !shouldConvertSelectOfConstantsToMath(N0, VT, self.TLI) {
        let mut SetCCVT: EVT = self.getSetCCResultType(N00VT);
        if SetCCVT.getScalarSizeInBits() != 1 && (!self.LegalOperations || self.TLI.isOperationLegal(SETCC, N00VT)) {
            let mut SetCC: SDValue = self.DAG.getSetCC(DL, SetCCVT, N00, N01, CC, SDValue {}, false, Flags);
            return self.DAG.getSelect(DL, VT, SetCC, ExtTrueVal, Zero, Flags);
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitSIGN_EXTEND(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if VT.isVector() {
        if self.SimplifyVCastOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
    }
    if N0.isUndef() {
        return self.DAG.getConstant(0, DL, VT, false, false);
    }
    if tryToFoldExtendOfConstant(N, DL, self.TLI, self.DAG, self.LegalTypes) {
        Res;
    } else {
        return Res;
    }
    if N0.getOpcode() == SIGN_EXTEND || N0.getOpcode() == ANY_EXTEND {
        return self.DAG.getNode(SIGN_EXTEND, DL, VT, N0.getOperand(0));
    }
    if N0.getOpcode() == ANY_EXTEND_VECTOR_INREG || N0.getOpcode() == SIGN_EXTEND_VECTOR_INREG {
        return self.DAG.getNode(SIGN_EXTEND_VECTOR_INREG, SDLoc { N }, VT, N0.getOperand(0));
    }
    if N0.getOpcode() == SIGN_EXTEND_INREG {
        let mut N00: SDValue = N0.getOperand(0);
        let mut ExtVT: EVT = cast(operator(N0).getOperand(1)).getVT();
        if N00.getOpcode() == TRUNCATE || self.TLI.isTruncateFree(N00, ExtVT) {
            if (!self.LegalTypes || self.TLI.isTypeLegal(ExtVT)) {
                let mut T: SDValue = self.DAG.getNode(TRUNCATE, DL, ExtVT, N00);
                return self.DAG.getNode(SIGN_EXTEND, DL, VT, T);
            }
            if !self.LegalTypes || self.TLI.isTypeLegal(VT) {
                let mut ExtSrc: SDValue = self.DAG.getAnyExtOrTrunc(N00, DL, VT);
                return self.DAG.getNode(SIGN_EXTEND_INREG, DL, VT, ExtSrc, operator(N0).getOperand(1));
            }
        }
    }
    if N0.getOpcode() == TRUNCATE {
        if self.reduceLoadWidth(N0.getNode()) {
            NarrowLoad;
        } else {
            let mut oye: *mut SDNode = N0.getOperand(0).getNode();
            if NarrowLoad.getNode() != N0.getNode() {
                self.CombineTo(N0.getNode(), NarrowLoad, true);
                self.AddToWorklist(oye, true, false);
            }
            return SDValue { Node: N, ResNo: 0 };
        }
        let mut Op: SDValue = N0.getOperand(0);
        let mut OpBits: u32 = Op.getScalarValueSizeInBits();
        let mut MidBits: u32 = N0.getScalarValueSizeInBits();
        let mut DestBits: u32 = VT.getScalarSizeInBits();
        if operator(N0).getFlags().hasNoSignedWrap() || self.DAG.ComputeNumSignBits(Op, 0) > OpBits - MidBits {
            if OpBits == DestBits {
                return Op;
            }
            if OpBits < DestBits {
                return self.DAG.getNode(SIGN_EXTEND, DL, VT, Op);
            }
            let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
            Flags.setNoSignedWrap(true);
            Flags.setNoUnsignedWrap(operator(N0).getFlags().hasNoUnsignedWrap());
            return self.DAG.getNode(TRUNCATE, DL, VT, Op, Flags);
        }
        if !self.LegalOperations || self.TLI.isOperationLegal(SIGN_EXTEND_INREG, N0.getValueType()) {
            if OpBits < DestBits {
                Op = self.DAG.getNode(ANY_EXTEND, SDLoc { N0 }, VT, Op);
            } else if OpBits > DestBits {
                Op = self.DAG.getNode(TRUNCATE, SDLoc { N0 }, VT, Op);
            }
            return self.DAG.getNode(SIGN_EXTEND_INREG, DL, VT, Op, self.DAG.getValueType(N0.getValueType()));
        }
    }
    if tryToFoldExtOfLoad(self.DAG, *self, self.TLI, VT, self.LegalOperations, N, N0, SEXTLOAD, SIGN_EXTEND, false) {
        foldedExt;
    } else {
        return foldedExt;
    }
    if tryToFoldExtOfMaskedLoad(self.DAG, self.TLI, VT, self.LegalOperations, N, N0, SEXTLOAD, SIGN_EXTEND) {
        foldedExt;
    } else {
        return foldedExt;
    }
    if self.CombineExtLoad(N) {
        ExtLoad;
    } else {
        return ExtLoad;
    }
    if tryToFoldExtOfExtload(self.DAG, *self, self.TLI, VT, self.LegalOperations, N, N0, SEXTLOAD) {
        foldedExt;
    } else {
        return foldedExt;
    }
    if tryToFoldExtOfAtomicLoad(self.DAG, self.TLI, VT, N0, SEXTLOAD) {
        foldedExt;
    } else {
        return foldedExt;
    }
    if isBitwiseLogicOp(N0.getOpcode()) && isa(N0.getOperand(0)) && N0.getOperand(1).getOpcode() == Constant && (!self.LegalOperations && self.TLI.isOperationLegal(N0.getOpcode(), VT)) {
        let mut LN00: *mut LoadSDNode = cast(N0.getOperand(0));
        let mut MemVT: EVT = LN00.getMemoryVT();
        if self.TLI.isLoadLegal(VT, MemVT, LN00.getAlign(), LN00.getAddressSpace(), SEXTLOAD, false) && LN00.getExtensionType() != ZEXTLOAD && LN00.isUnindexed() {
            let mut SetCCs: SmallVector<SDNode *, 4> = SmallVector<SDNode *, 4> {};
            let mut DoXform: bool = ExtendUsesToFormExtLoad(VT, N0.getNode(), N0.getOperand(0), SIGN_EXTEND, SetCCs, self.TLI);
            if DoXform {
                let mut ExtLoad: SDValue = self.DAG.getExtLoad(SEXTLOAD, SDLoc { LN00 }, VT, LN00.getChain(), LN00.getBasePtr(), LN00.getMemoryVT(), LN00.getMemOperand());
                let mut Mask: APInt = N0.getConstantOperandAPInt(1).sext(VT.getSizeInBits().operator unsigned long long());
                let mut And: SDValue = self.DAG.getNode(N0.getOpcode(), DL, VT, ExtLoad, self.DAG.getConstant(Mask, DL, VT, false, false));
                self.ExtendSetCCUses(SetCCs, N0.getOperand(0), ExtLoad, SIGN_EXTEND);
                let mut NoReplaceTruncAnd: bool = !N0.hasOneUse();
                let mut NoReplaceTrunc: bool = SDValue { Node: LN00, ResNo: 0 }.hasOneUse();
                self.CombineTo(N, And, true);
                if NoReplaceTruncAnd {
                    let mut TruncAnd: SDValue = self.DAG.getNode(TRUNCATE, DL, N0.getValueType(), And);
                    self.CombineTo(N0.getNode(), TruncAnd, true);
                }
                if NoReplaceTrunc {
                    self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: LN00, ResNo: 1 }, ExtLoad.getValue(1));
                } else {
                    let mut Trunc: SDValue = self.DAG.getNode(TRUNCATE, SDLoc { LN00 }, LN00.getValueType(0), ExtLoad);
                    self.CombineTo(LN00, Trunc, ExtLoad.getValue(1), true);
                }
                return SDValue { Node: N, ResNo: 0 };
            }
        }
    }
    if foldExtendedSignBitTest(N, self.DAG, self.LegalOperations) {
        V;
    } else {
        return V;
    }
    if self.foldSextSetcc(N) {
        V;
    } else {
        return V;
    }
    if !self.TLI.isSExtCheaperThanZExt(N0.getValueType(), VT) && (!self.LegalOperations || self.TLI.isOperationLegal(ZERO_EXTEND, VT)) && self.DAG.SignBitIsZero(N0, 0) {
        return self.DAG.getNode(ZERO_EXTEND, DL, VT, N0, SDNodeFlags { Flags: NonNeg });
    }
    if self.matchVSelectOpSizesWithSetCC(N) {
        NewVSel;
    } else {
        return NewVSel;
    }
    if N0.getOpcode() == SUB && N0.hasOneUse() && isNullOrNullSplat(N0.getOperand(0), false) && N0.getOperand(1).getOpcode() == ZERO_EXTEND && self.TLI.isOperationLegalOrCustom(SUB, VT, false) {
        let mut Zext: SDValue = self.DAG.getZExtOrTrunc(N0.getOperand(1).getOperand(0), DL, VT);
        return self.DAG.getNegative(Zext, DL, VT);
    }
    if N0.getOpcode() == ADD && N0.hasOneUse() && isAllOnesOrAllOnesSplat(N0.getOperand(1), false) && N0.getOperand(0).getOpcode() == ZERO_EXTEND && self.TLI.isOperationLegalOrCustom(ADD, VT, false) {
        let mut Zext: SDValue = self.DAG.getZExtOrTrunc(N0.getOperand(0).getOperand(0), DL, VT);
        return self.DAG.getNode(ADD, DL, VT, Zext, self.DAG.getAllOnesConstant(DL, VT, false, false));
    }
    if N0.getValueType() == EVT { i1 } && isBitwiseNot(N0, false) && N0.hasOneUse() && (!self.LegalOperations || (self.TLI.isOperationLegal(ZERO_EXTEND, VT) && self.TLI.isOperationLegal(ADD, VT))) {
        if self.visitXOR(N0.getNode()) {
            NewXor;
        } else {
            if NewXor.getNode() == N0.getNode() {
                return SDValue {};
            }
            return self.DAG.getNode(SIGN_EXTEND, DL, VT, NewXor);
        }
        let mut Zext: SDValue = self.DAG.getNode(ZERO_EXTEND, DL, VT, N0.getOperand(0));
        return self.DAG.getNode(ADD, DL, VT, Zext, self.DAG.getAllOnesConstant(DL, VT, false, false));
    }
    if tryToFoldExtendSelectLoad(N, self.TLI, self.DAG, DL, self.Level) {
        Res;
    } else {
        return Res;
    }
    return SDValue {};
}

fn widenCtPop(Extend: *mut SDNode, DAG: *mut SelectionDAG, DL: *SDLoc) -> SDValue {
    assert!((Extend.getOpcode() == ZERO_EXTEND || Extend.getOpcode() == ANY_EXTEND), "Expected extend op");
    let mut CtPop: SDValue = Extend.getOperand(0);
    if CtPop.getOpcode() != CTPOP || !CtPop.hasOneUse() {
        return SDValue {};
    }
    let mut VT: EVT = Extend.getValueType(0);
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if TLI.isOperationLegalOrCustom(CTPOP, CtPop.getValueType(), false) || !TLI.isOperationLegalOrCustom(CTPOP, VT, false) {
        return SDValue {};
    }
    let mut NewZext: SDValue = DAG.getZExtOrTrunc(CtPop.getOperand(0), DL, VT);
    return DAG.getNode(CTPOP, DL, VT, NewZext);
}

fn widenAbs(Extend: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    assert!(Extend.getOpcode() == ZERO_EXTEND, "Expected zero extend.");
    let mut VT: EVT = Extend.getValueType(0);
    if VT.isVector() {
        return SDValue {};
    }
    let mut Abs: SDValue = Extend.getOperand(0);
    if !isAbsOpcode(Abs.getOpcode()) || !Abs.hasOneUse() {
        return SDValue {};
    }
    let mut AbsVT: EVT = Abs.getValueType();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if TLI.getTypeAction(*DAG.getContext(), AbsVT) != TypePromoteInteger {
        return SDValue {};
    }
    let mut LegalVT: EVT = TLI.getTypeToTransformTo(*DAG.getContext(), AbsVT);
    let mut SExt: SDValue = DAG.getNode(SIGN_EXTEND, SDLoc { Abs }, LegalVT, Abs.getOperand(0));
    let mut NewAbs: SDValue = DAG.getNode(ABS_MIN_POISON, SDLoc { Abs }, LegalVT, SExt);
    return DAG.getZExtOrTrunc(NewAbs, SDLoc { Extend }, VT);
}

fn DAGCombiner::visitZERO_EXTEND(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if VT.isVector() {
        if self.SimplifyVCastOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
    }
    if N0.isUndef() {
        return self.DAG.getConstant(0, DL, VT, false, false);
    }
    if tryToFoldExtendOfConstant(N, DL, self.TLI, self.DAG, self.LegalTypes) {
        Res;
    } else {
        return Res;
    }
    if N0.getOpcode() == ZERO_EXTEND || N0.getOpcode() == ANY_EXTEND {
        let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
        if N0.getOpcode() == ZERO_EXTEND {
            Flags.setNonNeg(operator(N0).getFlags().hasNonNeg());
        }
        return self.DAG.getNode(ZERO_EXTEND, DL, VT, N0.getOperand(0), Flags);
    }
    if N0.getOpcode() == ANY_EXTEND_VECTOR_INREG || N0.getOpcode() == ZERO_EXTEND_VECTOR_INREG {
        return self.DAG.getNode(ZERO_EXTEND_VECTOR_INREG, DL, VT, N0.getOperand(0));
    }
    let mut Op: SDValue = SDValue {};
    let mut Known: KnownBits = KnownBits {};
    if isTruncateOf(self.DAG, N0, Op, Known) {
        let mut TruncatedBits: APInt = if (Op.getScalarValueSizeInBits() == N0.getScalarValueSizeInBits()) { APInt { Op.getScalarValueSizeInBits(), 0, false, false } } else { getBitsSet(Op.getScalarValueSizeInBits(), N0.getScalarValueSizeInBits(), if Op.getScalarValueSizeInBits() < VT.getScalarSizeInBits() { Op.getScalarValueSizeInBits() } else { VT.getScalarSizeInBits() }) };
        if TruncatedBits.isSubsetOf(Known.Zero) {
            let mut ZExtOrTrunc: SDValue = self.DAG.getZExtOrTrunc(Op, DL, VT);
            self.DAG.salvageDebugInfo(*N0.getNode());
            return ZExtOrTrunc;
        }
    }
    if N0.getOpcode() == TRUNCATE {
        if self.reduceLoadWidth(N0.getNode()) {
            NarrowLoad;
        } else {
            let mut oye: *mut SDNode = N0.getOperand(0).getNode();
            if NarrowLoad.getNode() != N0.getNode() {
                self.CombineTo(N0.getNode(), NarrowLoad, true);
                self.AddToWorklist(oye, true, false);
            }
            return SDValue { Node: N, ResNo: 0 };
        }
        let mut SrcVT: EVT = N0.getOperand(0).getValueType();
        let mut MinVT: EVT = N0.getValueType();
        if N.getFlags().hasNonNeg() {
            let mut Op: SDValue = N0.getOperand(0);
            let mut OpBits: u32 = SrcVT.getScalarSizeInBits();
            let mut MidBits: u32 = MinVT.getScalarSizeInBits();
            let mut DestBits: u32 = VT.getScalarSizeInBits();
            if operator(N0).getFlags().hasNoSignedWrap() || self.DAG.ComputeNumSignBits(Op, 0) > OpBits - MidBits {
                if OpBits == DestBits {
                    return Op;
                }
                if OpBits < DestBits {
                    return self.DAG.getNode(SIGN_EXTEND, DL, VT, Op);
                }
                let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
                Flags.setNoSignedWrap(true);
                Flags.setNoUnsignedWrap(true);
                return self.DAG.getNode(TRUNCATE, DL, VT, Op, Flags);
            }
        }
        if SrcVT.bitsLT(VT) && VT.isVector() {
            if !self.LegalOperations || (self.TLI.isOperationLegal(AND, SrcVT) && self.TLI.isOperationLegal(ZERO_EXTEND, VT)) {
                let mut Op: SDValue = N0.getOperand(0);
                Op = self.DAG.getZeroExtendInReg(Op, DL, MinVT);
                self.AddToWorklist(Op.getNode(), true, false);
                let mut ZExtOrTrunc: SDValue = self.DAG.getZExtOrTrunc(Op, DL, VT);
                self.DAG.transferDbgValues(N0, ZExtOrTrunc, 0, 0, true);
                return ZExtOrTrunc;
            }
        }
        if !self.LegalOperations || self.TLI.isOperationLegal(AND, VT) {
            let mut Op: SDValue = self.DAG.getAnyExtOrTrunc(N0.getOperand(0), DL, VT);
            self.AddToWorklist(Op.getNode(), true, false);
            let mut And: SDValue = self.DAG.getZeroExtendInReg(Op, DL, MinVT);
            self.DAG.transferDbgValues(N0, And, 0, 0, true);
            return And;
        }
    }
    if N0.getOpcode() == AND && N0.getOperand(1).getOpcode() == Constant {
        let mut AndSrc: SDValue = N0.getOperand(0);
        let mut X: SDValue = SDValue {};
        if AndSrc.getOpcode() == TRUNCATE {
            X = AndSrc.getOperand(0);
        } else if AndSrc.getOpcode() == BITCAST && AndSrc.getOperand(0).getOpcode() == EXTRACT_SUBVECTOR && AndSrc.getOperand(0).getConstantOperandVal(1) == 0 {
            let mut Src: SDValue = AndSrc.getOperand(0).getOperand(0);
            let mut SrcVT: EVT = Src.getValueType();
            if SrcVT.isFixedLengthVectorOf(EVT { i1 }) {
                let mut WideIntVT: EVT = getIntegerVT(*self.DAG.getContext(), SrcVT.getSizeInBits().operator unsigned long long());
                if self.TLI.isTypeLegal(WideIntVT) {
                    X = self.DAG.getBitcast(WideIntVT, Src);
                }
            }
        }
        if X && (!self.TLI.isTruncateFree(X, N0.getValueType()) || !self.TLI.isZExtFree(N0.getValueType(), VT)) {
            X = self.DAG.getAnyExtOrTrunc(X, SDLoc { X }, VT);
            let mut Mask: APInt = N0.getConstantOperandAPInt(1).zext(VT.getSizeInBits().operator unsigned long long());
            return self.DAG.getNode(AND, DL, VT, X, self.DAG.getConstant(Mask, DL, VT, false, false));
        }
    }
    if tryToFoldExtOfLoad(self.DAG, *self, self.TLI, VT, self.LegalOperations, N, N0, ZEXTLOAD, ZERO_EXTEND, N.getFlags().hasNonNeg()) {
        foldedExt;
    } else {
        return foldedExt;
    }
    if tryToFoldExtOfMaskedLoad(self.DAG, self.TLI, VT, self.LegalOperations, N, N0, ZEXTLOAD, ZERO_EXTEND) {
        foldedExt;
    } else {
        return foldedExt;
    }
    if self.CombineExtLoad(N) {
        ExtLoad;
    } else {
        return ExtLoad;
    }
    if tryToFoldExtOfAtomicLoad(self.DAG, self.TLI, VT, N0, ZEXTLOAD) {
        foldedExt;
    } else {
        return foldedExt;
    }
    if isBitwiseLogicOp(N0.getOpcode()) && !self.TLI.isZExtFree(N0, VT) && isa(N0.getOperand(0)) && N0.getOperand(1).getOpcode() == Constant && (!self.LegalOperations && self.TLI.isOperationLegal(N0.getOpcode(), VT)) {
        let mut LN00: *mut LoadSDNode = cast(N0.getOperand(0));
        let mut MemVT: EVT = LN00.getMemoryVT();
        if self.TLI.isLoadLegal(VT, MemVT, LN00.getAlign(), LN00.getAddressSpace(), ZEXTLOAD, false) && LN00.getExtensionType() != SEXTLOAD && LN00.isUnindexed() {
            let mut DoXform: bool = true;
            let mut SetCCs: SmallVector<SDNode *, 4> = SmallVector<SDNode *, 4> {};
            if !N0.hasOneUse() {
                if N0.getOpcode() == AND {
                    let mut AndC: *mut ConstantSDNode = cast(N0.getOperand(1));
                    let mut LoadResultTy: EVT = AndC.getValueType(0);
                    let mut ExtVT: EVT = EVT {};
                    if self.isAndLoadExtLoad(AndC, LN00, LoadResultTy, ExtVT) {
                        DoXform = false;
                    }
                }
            }
            if DoXform {
                DoXform = ExtendUsesToFormExtLoad(VT, N0.getNode(), N0.getOperand(0), ZERO_EXTEND, SetCCs, self.TLI);
            }
            if DoXform {
                let mut ExtLoad: SDValue = self.DAG.getExtLoad(ZEXTLOAD, SDLoc { LN00 }, VT, LN00.getChain(), LN00.getBasePtr(), LN00.getMemoryVT(), LN00.getMemOperand());
                let mut Mask: APInt = N0.getConstantOperandAPInt(1).zext(VT.getSizeInBits().operator unsigned long long());
                let mut And: SDValue = self.DAG.getNode(N0.getOpcode(), DL, VT, ExtLoad, self.DAG.getConstant(Mask, DL, VT, false, false));
                self.ExtendSetCCUses(SetCCs, N0.getOperand(0), ExtLoad, ZERO_EXTEND);
                let mut NoReplaceTruncAnd: bool = !N0.hasOneUse();
                let mut NoReplaceTrunc: bool = SDValue { Node: LN00, ResNo: 0 }.hasOneUse();
                self.CombineTo(N, And, true);
                if NoReplaceTruncAnd {
                    let mut TruncAnd: SDValue = self.DAG.getNode(TRUNCATE, DL, N0.getValueType(), And);
                    self.CombineTo(N0.getNode(), TruncAnd, true);
                }
                if NoReplaceTrunc {
                    self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: LN00, ResNo: 1 }, ExtLoad.getValue(1));
                } else {
                    let mut Trunc: SDValue = self.DAG.getNode(TRUNCATE, SDLoc { LN00 }, LN00.getValueType(0), ExtLoad);
                    self.CombineTo(LN00, Trunc, ExtLoad.getValue(1), true);
                }
                return SDValue { Node: N, ResNo: 0 };
            }
        }
    }
    if self.CombineZExtLogicopShiftLoad(N) {
        ZExtLoad;
    } else {
        return ZExtLoad;
    }
    if tryToFoldExtOfExtload(self.DAG, *self, self.TLI, VT, self.LegalOperations, N, N0, ZEXTLOAD) {
        foldedExt;
    } else {
        return foldedExt;
    }
    if foldExtendedSignBitTest(N, self.DAG, self.LegalOperations) {
        V;
    } else {
        return V;
    }
    if N0.getOpcode() == SETCC {
        let mut FlagsInserter: FlagInserter = FlagInserter { self.DAG, operator(N0).getFlags() };
        if !self.LegalOperations && VT.isVector() && N0.getValueType().getVectorElementType() == EVT { i1 } {
            let mut N00VT: EVT = N0.getOperand(0).getValueType();
            if self.getSetCCResultType(N00VT) == N0.getValueType() {
                return SDValue {};
            }
            if VT.getSizeInBits() == N00VT.getSizeInBits() {
                let mut VSetCC: SDValue = self.DAG.getNode(SETCC, DL, VT, N0.getOperand(0), N0.getOperand(1), N0.getOperand(2));
                return self.DAG.getZeroExtendInReg(VSetCC, DL, N0.getValueType());
            }
            let mut MatchingVectorType: EVT = N00VT.changeVectorElementTypeToInteger();
            let mut VsetCC: SDValue = self.DAG.getNode(SETCC, DL, MatchingVectorType, N0.getOperand(0), N0.getOperand(1), N0.getOperand(2));
            return self.DAG.getZeroExtendInReg(self.DAG.getAnyExtOrTrunc(VsetCC, DL, VT), DL, N0.getValueType());
        }
        let mut N0VT: EVT = N0.getValueType();
        let mut N00VT: EVT = N0.getOperand(0).getValueType();
        if self.SimplifySelectCC(DL, N0.getOperand(0), N0.getOperand(1), self.DAG.getBoolConstant(true, DL, N0VT, N00VT), self.DAG.getBoolConstant(false, DL, N0VT, N00VT), cast(N0.getOperand(2)).get(), true) {
            SCC;
        } else {
            return self.DAG.getNode(ZERO_EXTEND, DL, VT, SCC);
        }
    }
    if (N0.getOpcode() == SHL || N0.getOpcode() == SRL) && !self.TLI.isZExtFree(N0, VT) {
        let mut ShVal: SDValue = N0.getOperand(0);
        let mut ShAmt: SDValue = N0.getOperand(1);
        if dyn_cast(ShAmt) {
            ShAmtC;
        } else {
            if ShVal.getOpcode() == ZERO_EXTEND && N0.hasOneUse() {
                if N0.getOpcode() == SHL {
                    let mut KnownZeroBits: u32 = ShVal.getValueSizeInBits() - ShVal.getOperand(0).getValueSizeInBits().operator unsigned long long();
                    if ShAmtC.getAPIntValue().ugt(KnownZeroBits) {
                        let mut KnownShVal: KnownBits = self.DAG.computeKnownBits(ShVal, 0);
                        if ShAmtC.getAPIntValue().ugt(KnownShVal.countMinLeadingZeros()) {
                            return SDValue {};
                        }
                    }
                }
                if Log2_32_Ceil(VT.getSizeInBits().operator unsigned long long()) > ShAmt.getValueSizeInBits().operator unsigned long long() {
                    ShAmt = self.DAG.getNode(ZERO_EXTEND, DL, EVT { i32 }, ShAmt);
                }
                return self.DAG.getNode(N0.getOpcode(), DL, VT, self.DAG.getNode(ZERO_EXTEND, DL, VT, ShVal), ShAmt);
            }
        }
    }
    if self.matchVSelectOpSizesWithSetCC(N) {
        NewVSel;
    } else {
        return NewVSel;
    }
    if widenCtPop(N, self.DAG, DL) {
        NewCtPop;
    } else {
        return NewCtPop;
    }
    if widenAbs(N, self.DAG) {
        V;
    } else {
        return V;
    }
    if tryToFoldExtendSelectLoad(N, self.TLI, self.DAG, DL, self.Level) {
        Res;
    } else {
        return Res;
    }
    if N.getFlags().hasNonNeg() && !self.TLI.isZExtFree(N0.getValueType(), VT) {
        let mut CSENode: *mut SDNode = self.DAG.getNodeIfExists(SIGN_EXTEND, N.getVTList(), ArrayRef<SDValue> { N0 }, false);
        if CSENode {
            return SDValue { Node: CSENode, ResNo: 0 };
        }
    }
    return SDValue {};
}

fn propagateUnaryUndef(DAG: *mut SelectionDAG, N0: SDValue, VT: EVT) -> SDValue {
    if N0.getOpcode() == POISON {
        return DAG.getPOISON(VT);
    }
    if N0.getOpcode() == UNDEF {
        return DAG.getUNDEF(VT);
    }
    return SDValue {};
}

fn DAGCombiner::visitANY_EXTEND(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if propagateUnaryUndef(self.DAG, N0, VT) {
        R;
    } else {
        return R;
    }
    if tryToFoldExtendOfConstant(N, DL, self.TLI, self.DAG, self.LegalTypes) {
        Res;
    } else {
        return Res;
    }
    if N0.getOpcode() == ANY_EXTEND || N0.getOpcode() == ZERO_EXTEND || N0.getOpcode() == SIGN_EXTEND {
        let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
        if N0.getOpcode() == ZERO_EXTEND {
            Flags.setNonNeg(operator(N0).getFlags().hasNonNeg());
        }
        return self.DAG.getNode(N0.getOpcode(), DL, VT, N0.getOperand(0), Flags);
    }
    if N0.getOpcode() == ANY_EXTEND_VECTOR_INREG || N0.getOpcode() == ZERO_EXTEND_VECTOR_INREG || N0.getOpcode() == SIGN_EXTEND_VECTOR_INREG {
        return self.DAG.getNode(N0.getOpcode(), DL, VT, N0.getOperand(0));
    }
    if N0.getOpcode() == TRUNCATE {
        if self.reduceLoadWidth(N0.getNode()) {
            NarrowLoad;
        } else {
            let mut oye: *mut SDNode = N0.getOperand(0).getNode();
            if NarrowLoad.getNode() != N0.getNode() {
                self.CombineTo(N0.getNode(), NarrowLoad, true);
                self.AddToWorklist(oye, true, false);
            }
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    if N0.getOpcode() == TRUNCATE {
        return self.DAG.getAnyExtOrTrunc(N0.getOperand(0), DL, VT);
    }
    if N0.getOpcode() == AND && N0.getOperand(1).getOpcode() == Constant {
        let mut AndSrc: SDValue = N0.getOperand(0);
        let mut X: SDValue = SDValue {};
        if AndSrc.getOpcode() == TRUNCATE {
            X = AndSrc.getOperand(0);
        } else if AndSrc.getOpcode() == BITCAST && AndSrc.getOperand(0).getOpcode() == EXTRACT_SUBVECTOR && AndSrc.getOperand(0).getConstantOperandVal(1) == 0 {
            let mut Src: SDValue = AndSrc.getOperand(0).getOperand(0);
            let mut SrcVT: EVT = Src.getValueType();
            if SrcVT.isFixedLengthVectorOf(EVT { i1 }) {
                let mut WideIntVT: EVT = getIntegerVT(*self.DAG.getContext(), SrcVT.getSizeInBits().operator unsigned long long());
                if self.TLI.isTypeLegal(WideIntVT) {
                    X = self.DAG.getBitcast(WideIntVT, Src);
                }
            }
        }
        if X && (!self.TLI.isTruncateFree(X, N0.getValueType()) || (!self.TLI.isZExtFree(N0.getValueType(), VT) && !self.TLI.isSExtCheaperThanZExt(N0.getValueType(), VT))) {
            X = self.DAG.getAnyExtOrTrunc(X, DL, VT);
            let mut Mask: APInt = N0.getConstantOperandAPInt(1).zext(VT.getSizeInBits().operator unsigned long long());
            return self.DAG.getNode(AND, DL, VT, X, self.DAG.getConstant(Mask, DL, VT, false, false));
        }
    }
    if VT.isVector() {
        if tryToFoldExtOfLoad(self.DAG, *self, self.TLI, VT, self.LegalOperations, N, N0, ZEXTLOAD, ZERO_EXTEND, false) {
            foldedExt;
        } else {
            return foldedExt;
        }
    } else if isNON_EXTLoad(N0.getNode()) && isUNINDEXEDLoad(N0.getNode()) {
        let mut LN0: *mut LoadSDNode = cast(N0);
        if self.TLI.isLoadLegalOrCustom(VT, N0.getValueType(), LN0.getAlign(), LN0.getAddressSpace(), EXTLOAD, false) {
            let mut DoXform: bool = true;
            let mut SetCCs: SmallVector<SDNode *, 4> = SmallVector<SDNode *, 4> {};
            if !N0.hasOneUse() {
                DoXform = ExtendUsesToFormExtLoad(VT, N, N0, ANY_EXTEND, SetCCs, self.TLI);
            }
            if DoXform {
                let mut ExtLoad: SDValue = self.DAG.getExtLoad(EXTLOAD, DL, VT, LN0.getChain(), LN0.getBasePtr(), N0.getValueType(), LN0.getMemOperand());
                self.ExtendSetCCUses(SetCCs, N0, ExtLoad, ANY_EXTEND);
                let mut NoReplaceTrunc: bool = N0.hasOneUse();
                self.CombineTo(N, ExtLoad, true);
                if NoReplaceTrunc {
                    self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: LN0, ResNo: 1 }, ExtLoad.getValue(1));
                    self.recursivelyDeleteUnusedNodes(LN0);
                } else {
                    let mut Trunc: SDValue = self.DAG.getNode(TRUNCATE, SDLoc { N0 }, N0.getValueType(), ExtLoad);
                    self.CombineTo(LN0, Trunc, ExtLoad.getValue(1), true);
                }
                return SDValue { Node: N, ResNo: 0 };
            }
        }
    }
    if N0.getOpcode() == LOAD && !isNON_EXTLoad(N0.getNode()) && isUNINDEXEDLoad(N0.getNode()) && N0.hasOneUse() {
        let mut LN0: *mut LoadSDNode = cast(N0);
        let mut ExtType: LoadExtType = LN0.getExtensionType();
        let mut MemVT: EVT = LN0.getMemoryVT();
        if !self.LegalOperations || self.TLI.isLoadLegal(VT, MemVT, LN0.getAlign(), LN0.getAddressSpace(), ExtType, false) {
            let mut ExtLoad: SDValue = self.DAG.getExtLoad(ExtType, DL, VT, LN0.getChain(), LN0.getBasePtr(), MemVT, LN0.getMemOperand());
            self.CombineTo(N, ExtLoad, true);
            self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: LN0, ResNo: 1 }, ExtLoad.getValue(1));
            self.recursivelyDeleteUnusedNodes(LN0);
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    if N0.getOpcode() == SETCC {
        let mut Flags: SDNodeFlags = operator(N0).getFlags();
        let mut FlagsInserter: FlagInserter = FlagInserter { self.DAG, Flags };
        if VT.isVector() && !self.LegalOperations {
            let mut N00VT: EVT = N0.getOperand(0).getValueType();
            if self.getSetCCResultType(N00VT) == N0.getValueType() {
                return SDValue {};
            }
            if VT.getSizeInBits() == N00VT.getSizeInBits() {
                return self.DAG.getSetCC(DL, VT, N0.getOperand(0), N0.getOperand(1), cast(N0.getOperand(2)).get(), SDValue {}, false, Flags);
            }
            let mut MatchingVectorType: EVT = N00VT.changeVectorElementTypeToInteger();
            let mut VsetCC: SDValue = self.DAG.getSetCC(DL, MatchingVectorType, N0.getOperand(0), N0.getOperand(1), cast(N0.getOperand(2)).get(), SDValue {}, false, Flags);
            return self.DAG.getAnyExtOrTrunc(VsetCC, DL, VT);
        }
        if self.SimplifySelectCC(DL, N0.getOperand(0), N0.getOperand(1), self.DAG.getConstant(1, DL, VT, false, false), self.DAG.getConstant(0, DL, VT, false, false), cast(N0.getOperand(2)).get(), true) {
            SCC;
        } else {
            return SCC;
        }
    }
    if widenCtPop(N, self.DAG, DL) {
        NewCtPop;
    } else {
        return NewCtPop;
    }
    if tryToFoldExtendSelectLoad(N, self.TLI, self.DAG, DL, self.Level) {
        Res;
    } else {
        return Res;
    }
    return SDValue {};
}

fn DAGCombiner::visitAssertExt(self, N: *mut SDNode) -> SDValue {
    let mut Opcode: u32 = N.getOpcode();
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut AssertVT: EVT = cast(N1).getVT();
    if N0.getOpcode() == Opcode && AssertVT == cast(N0.getOperand(1)).getVT() {
        return N0;
    }
    if isa(N0) {
        return N0;
    }
    if N0.getOpcode() == TRUNCATE && N0.hasOneUse() && N0.getOperand(0).getOpcode() == Opcode {
        let mut DL: SDLoc = SDLoc { N };
        let mut BigA: SDValue = N0.getOperand(0);
        let mut BigA_AssertVT: EVT = cast(BigA.getOperand(1)).getVT();
        let mut MinAssertVT: EVT = if AssertVT.bitsLT(BigA_AssertVT) { AssertVT } else { BigA_AssertVT };
        let mut MinAssertVTVal: SDValue = self.DAG.getValueType(MinAssertVT);
        let mut NewAssert: SDValue = self.DAG.getNode(Opcode, DL, BigA.getValueType(), BigA.getOperand(0), MinAssertVTVal);
        return self.DAG.getNode(TRUNCATE, DL, N.getValueType(0), NewAssert);
    }
    if N0.getOpcode() == TRUNCATE && N0.hasOneUse() && N0.getOperand(0).getOpcode() == AssertSext && Opcode == AssertZext {
        let mut BigA: SDValue = N0.getOperand(0);
        let mut BigA_AssertVT: EVT = cast(BigA.getOperand(1)).getVT();
        if AssertVT.bitsLT(BigA_AssertVT) {
            let mut DL: SDLoc = SDLoc { N };
            let mut NewAssert: SDValue = self.DAG.getNode(Opcode, DL, BigA.getValueType(), BigA.getOperand(0), N1);
            return self.DAG.getNode(TRUNCATE, DL, N.getValueType(0), NewAssert);
        }
    }
    if Opcode == AssertZext && N0.getOpcode() == AND && isa(N0.getOperand(1)) {
        let mut Mask: *APInt = N0.getConstantOperandAPInt(1);
        if N0.getOperand(0).getOpcode() == AssertSext && N0.hasOneUse() {
            let mut BigA: SDValue = N0.getOperand(0);
            let mut BigA_AssertVT: EVT = cast(BigA.getOperand(1)).getVT();
            if AssertVT.bitsLT(BigA_AssertVT) && Mask.countr_one() >= BigA_AssertVT.getScalarSizeInBits() {
                let mut DL: SDLoc = SDLoc { N };
                let mut NewAssert: SDValue = self.DAG.getNode(Opcode, DL, N.getValueType(0), BigA.getOperand(0), N1);
                return self.DAG.getNode(AND, DL, N.getValueType(0), NewAssert, N0.getOperand(1));
            }
        }
        if Mask.isIntN(AssertVT.getScalarSizeInBits()) {
            return N0;
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitAssertAlign(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut AL: Align = cast(N).getAlign();
    let mut N0: SDValue = N.getOperand(0);
    if dyn_cast(N0) {
        AAN;
    } else {
        return self.DAG.getAssertAlign(DL, N0.getOperand(0), if AL > AAN.getAlign() { AL } else { AAN.getAlign() });
    }
    match N0.getOpcode() {
        _ => {
            break;
        },
        ADD => {
            PTRADD;
        },
    }
    return SDValue {};
}

fn DAGCombiner::visitIS_FPCLASS(self, N: *mut SDNode) -> SDValue {
    let mut Src: SDValue = N.getOperand(0);
    let mut Mask: FPClassTest = N.getConstantOperandVal(1) as FPClassTest;
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if Src.getOpcode() == POISON {
        return self.DAG.getPOISON(VT);
    }
    let mut Known: KnownFPClass = self.DAG.computeKnownFPClass(Src, Mask, 0);
    if (operator(Mask) & Known.getKnownFPClasses()) == fcNone {
        return self.DAG.getBoolConstant(true, DL, VT, Src.getValueType());
    }
    if (Mask & Known.getKnownFPClasses()) != Mask {
        return self.DAG.getNode(IS_FPCLASS, DL, VT, Src, self.DAG.getTargetConstant(Mask & Known.getKnownFPClasses(), DL, EVT { i32 }, false), N.getFlags());
    }
    return SDValue {};
}

fn DAGCombiner::reduceLoadWidth(self, N: *mut SDNode) -> SDValue {
    let mut Opc: u32 = N.getOpcode();
    let mut ExtType: LoadExtType = NON_EXTLOAD;
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut ExtVT: EVT = VT;
    if VT.isVector() {
        return SDValue {};
    }
    let mut ShAmt: u32 = 0;
    let mut ShiftedOffset: u32 = 0;
    if Opc == SIGN_EXTEND_INREG {
        ExtType = SEXTLOAD;
        ExtVT = cast(N.getOperand(1)).getVT();
    } else if Opc == SRL || Opc == SRA {
        let mut LN: *mut LoadSDNode = dyn_cast(N0);
        let mut N1C: *mut ConstantSDNode = dyn_cast(N.getOperand(1));
        if !N1C || !LN {
            return SDValue {};
        }
        ShAmt = N1C.getZExtValue();
        let mut MemoryWidth: u64 = LN.getMemoryVT().getScalarSizeInBits();
        if MemoryWidth <= ShAmt {
            return SDValue {};
        }
        ExtType = if Opc == SRL { ZEXTLOAD } else { SEXTLOAD };
        ExtVT = getIntegerVT(*self.DAG.getContext(), MemoryWidth - ShAmt);
        if (LN.getExtensionType() == SEXTLOAD || LN.getExtensionType() == ZEXTLOAD) && LN.getExtensionType() != ExtType {
            return SDValue {};
        }
    } else if Opc == AND {
        let mut AndC: CastReturnType = dyn_cast(N.getOperand(1));
        if !AndC {
            return SDValue {};
        }
        let mut Mask: *APInt = AndC.getAPIntValue();
        let mut ActiveBits: u32 = 0;
        if Mask.isMask() {
            ActiveBits = Mask.countr_one();
        } else if Mask.isShiftedMask(ShAmt, ActiveBits) {
            ShiftedOffset = ShAmt;
        } else {
            return SDValue {};
        }
        ExtType = ZEXTLOAD;
        ExtVT = getIntegerVT(*self.DAG.getContext(), ActiveBits);
    }
    if Opc == SRL || N0.getOpcode() == SRL {
        let mut SRL: SDValue = if Opc == SRL { SDValue { Node: N, ResNo: 0 } } else { N0 };
        if !SRL.hasOneUse() {
            return SDValue {};
        }
        let mut LN: *mut LoadSDNode = dyn_cast(SRL.getOperand(0));
        let mut SRL1C: *mut ConstantSDNode = dyn_cast(SRL.getOperand(1));
        if !SRL1C || !LN {
            return SDValue {};
        }
        ShAmt = SRL1C.getZExtValue();
        let mut MemoryWidth: u64 = LN.getMemoryVT().getSizeInBits().operator unsigned long long();
        if ShAmt >= MemoryWidth {
            return SDValue {};
        }
        if LN.getExtensionType() == SEXTLOAD {
            return SDValue {};
        }
        if ExtVT.getScalarSizeInBits() > MemoryWidth - ShAmt {
            if ExtType == SEXTLOAD {
                return SDValue {};
            }
            ExtType = ZEXTLOAD;
            ExtVT = getIntegerVT(*self.DAG.getContext(), MemoryWidth - ShAmt);
        }
        let mut Mask: *mut SDNode = operator((operator(SRL).user_begin()));
        if SRL.hasOneUse() && Mask.getOpcode() == AND && isa(Mask.getOperand(1)) {
            let mut Offset: u32 = 0;
            let mut ActiveBits: u32 = 0;
            let mut ShiftMask: *APInt = Mask.getConstantOperandAPInt(1);
            if ShiftMask.isMask() {
                let mut MaskedVT: EVT = getIntegerVT(*self.DAG.getContext(), ShiftMask.countr_one());
                if (ExtVT.getScalarSizeInBits() > MaskedVT.getScalarSizeInBits()) && self.TLI.isLoadLegal(SRL.getValueType(), MaskedVT, LN.getAlign(), LN.getAddressSpace(), ExtType, false) {
                    ExtVT = MaskedVT;
                }
            } else if ExtType == ZEXTLOAD && ShiftMask.isShiftedMask(Offset, ActiveBits) && (Offset + ShAmt) < VT.getScalarSizeInBits() {
                let mut MaskedVT: EVT = getIntegerVT(*self.DAG.getContext(), ActiveBits);
                if ((Offset + ActiveBits) <= ExtVT.getScalarSizeInBits()) && self.TLI.isLoadLegal(SRL.getValueType(), MaskedVT, LN.getAlign(), LN.getAddressSpace(), ExtType, false) {
                    ExtVT = MaskedVT;
                    ShAmt = Offset + ShAmt;
                    ShiftedOffset = Offset;
                }
            }
        }
        N0 = SRL.getOperand(0);
    }
    let mut ShLeftAmt: u32 = 0;
    if ShAmt == 0 && N0.getOpcode() == SHL && N0.hasOneUse() && ExtVT == VT && self.TLI.isNarrowingProfitable(N, N0.getValueType(), VT) {
        if dyn_cast(N0.getOperand(1)) {
            N01;
        } else {
            ShLeftAmt = N01.getZExtValue();
            N0 = N0.getOperand(0);
        }
    }
    let mut FreezeNode: SDValue = SDValue {};
    if N0.getOpcode() == FREEZE {
        FreezeNode = N0;
        N0 = N0.getOperand(0);
    }
    if !isa(N0) {
        return SDValue {};
    }
    let mut LN0: *mut LoadSDNode = cast(N0);
    if !LN0.isSimple() || !self.isLegalNarrowLdSt(LN0, ExtType, ExtVT, ShAmt) {
        return SDValue {};
    }
    if FreezeNode && !FreezeNode.hasOneUse() && (LN0.getMemoryVT().bitsGT(ExtVT) || ExtType != ZEXTLOAD || (LN0.getExtensionType() != EXTLOAD && LN0.getExtensionType() != ZEXTLOAD)) {
        return SDValue {};
    }
    let mut AdjustBigEndianShift: Closure_56 = Closure_56 { LN0: &mut LN0, ExtVT: &mut ExtVT };
    let mut PtrAdjustmentInBits: u32 = if self.DAG.getDataLayout().isBigEndian() { AdjustBigEndianShift.call(ShAmt) } else { ShAmt };
    let mut PtrOff: u64 = PtrAdjustmentInBits / 8;
    let mut DL: SDLoc = SDLoc { LN0 };
    let mut NewPtr: SDValue = self.DAG.getMemBasePlusOffset(LN0.getBasePtr(), getFixed(PtrOff), DL, SDNodeFlags { Flags: NoUnsignedWrap });
    self.AddToWorklist(NewPtr.getNode(), true, false);
    let mut Load: SDValue = SDValue {};
    if ExtType == NON_EXTLOAD {
        let mut OldRanges: *MDNode = LN0.getRanges();
        let mut NewRanges: *MDNode = null;
        if ShAmt == 0 && OldRanges {
            let mut CR: ConstantRange = getConstantRangeFromMetadata(*OldRanges);
            let mut BitSize: u32 = VT.getScalarSizeInBits();
            if CR.getBitWidth() > BitSize {
                let mut TruncatedCR: ConstantRange = CR.truncate(BitSize, 0);
                if !TruncatedCR.isFullSet() {
                    let mut Bounds: [2]*mut Metadata = [get(get(*self.DAG.getContext(), TruncatedCR.getLower())), get(get(*self.DAG.getContext(), TruncatedCR.getUpper()))];
                    NewRanges = get(*self.DAG.getContext(), ArrayRef<Metadata *> { Bounds });
                }
            } else if CR.getBitWidth() == BitSize {
                NewRanges = OldRanges;
            }
        }
        Load = self.DAG.getLoad(VT, DL, LN0.getChain(), NewPtr, LN0.getPointerInfo().getWithOffset(PtrOff), MaybeAlign { LN0.getBaseAlign() }, LN0.getMemOperand().getFlags(), MMOMetadata { AAInfo: LN0.getAAInfo(), Ranges: NewRanges, MemCacheHint: null });
    } else {
        Load = self.DAG.getExtLoad(ExtType, DL, VT, LN0.getChain(), NewPtr, LN0.getPointerInfo().getWithOffset(PtrOff), ExtVT, MaybeAlign { LN0.getBaseAlign() }, LN0.getMemOperand().getFlags(), MMOMetadata { AAInfo: LN0.getAAInfo(), Ranges: null, MemCacheHint: null });
    }
    let mut DeadNodes: WorklistRemover = WorklistRemover { DC: *self };
    self.DAG.ReplaceAllUsesOfValueWith(N0.getValue(1), Load.getValue(1));
    if FreezeNode && !FreezeNode.hasOneUse() {
        self.DAG.ReplaceAllUsesOfValueWith(N0.getValue(0), Load.getValue(0));
    }
    let mut Result: SDValue = Load;
    if FreezeNode {
        Result = self.DAG.getNode(FREEZE, DL, VT, Result);
        if ExtType == ZEXTLOAD {
            Result = self.DAG.getNode(AssertZext, DL, VT, Result, self.DAG.getValueType(ExtVT));
        } else if ExtType == SEXTLOAD {
            Result = self.DAG.getNode(AssertSext, DL, VT, Result, self.DAG.getValueType(ExtVT));
        }
    }
    if ShLeftAmt != 0 {
        if ShLeftAmt >= VT.getScalarSizeInBits() {
            Result = self.DAG.getConstant(0, DL, VT, false, false);
        } else {
            Result = self.DAG.getNode(SHL, DL, VT, Result, self.DAG.getShiftAmountConstant(ShLeftAmt, VT, DL));
        }
    }
    if ShiftedOffset != 0 {
        let mut ShiftC: SDValue = self.DAG.getConstant(ShiftedOffset, DL, VT, false, false);
        Result = self.DAG.getNode(SHL, DL, VT, Result, ShiftC);
        self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: N, ResNo: 0 }, Result);
    }
    return Result;
}

fn DAGCombiner::visitSIGN_EXTEND_INREG(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut ExtVT: EVT = cast(N1).getVT();
    let mut VTBits: u32 = VT.getScalarSizeInBits();
    let mut ExtVTBits: u32 = ExtVT.getScalarSizeInBits();
    let mut DL: SDLoc = SDLoc { N };
    if N0.isUndef() {
        return self.DAG.getConstant(0, DL, VT, false, false);
    }
    if self.DAG.FoldConstantArithmetic(SIGN_EXTEND_INREG, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if ExtVTBits >= self.DAG.ComputeMaxSignificantBits(N0, 0) {
        return N0;
    }
    if N0.getOpcode() == SIGN_EXTEND_INREG && ExtVT.bitsLT(cast(N0.getOperand(1)).getVT()) {
        return self.DAG.getNode(SIGN_EXTEND_INREG, DL, VT, N0.getOperand(0), N1);
    }
    if N0.getOpcode() == SIGN_EXTEND || N0.getOpcode() == ANY_EXTEND {
        let mut N00: SDValue = N0.getOperand(0);
        let mut N00Bits: u32 = N00.getScalarValueSizeInBits();
        if (N00Bits <= ExtVTBits || self.DAG.ComputeMaxSignificantBits(N00, 0) <= ExtVTBits) && (!self.LegalOperations || self.TLI.isOperationLegal(SIGN_EXTEND, VT)) {
            return self.DAG.getNode(SIGN_EXTEND, DL, VT, N00);
        }
    }
    if isExtVecInRegOpcode(N0.getOpcode()) {
        let mut N00: SDValue = N0.getOperand(0);
        let mut N00Bits: u32 = N00.getScalarValueSizeInBits();
        let mut IsZext: bool = N0.getOpcode() == ZERO_EXTEND_VECTOR_INREG;
        if (N00Bits == ExtVTBits || (!IsZext && (N00Bits < ExtVTBits || self.DAG.ComputeMaxSignificantBits(N00, 0) <= ExtVTBits))) && (!self.LegalOperations || self.TLI.isOperationLegal(SIGN_EXTEND_VECTOR_INREG, VT)) {
            return self.DAG.getNode(SIGN_EXTEND_VECTOR_INREG, DL, VT, N00);
        }
    }
    if N0.getOpcode() == ZERO_EXTEND {
        let mut N00: SDValue = N0.getOperand(0);
        if N00.getScalarValueSizeInBits() == ExtVTBits && (!self.LegalOperations || self.TLI.isOperationLegal(SIGN_EXTEND, VT)) {
            return self.DAG.getNode(SIGN_EXTEND, DL, VT, N00);
        }
    }
    if self.DAG.MaskedValueIsZero(N0, getOneBitSet(VTBits, ExtVTBits - 1), 0) {
        return self.DAG.getZeroExtendInReg(N0, DL, ExtVT);
    }
    if self.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if self.reduceLoadWidth(N) {
        NarrowLoad;
    } else {
        return NarrowLoad;
    }
    if N0.getOpcode() == SRL {
        if dyn_cast(N0.getOperand(1)) {
            ShAmt;
        } else if ShAmt.getAPIntValue().ule(VTBits - ExtVTBits) {
            let mut InSignBits: u32 = self.DAG.ComputeNumSignBits(N0.getOperand(0), 0);
            if ((VTBits - ExtVTBits) - ShAmt.getZExtValue()) < InSignBits {
                return self.DAG.getNode(SRA, DL, VT, N0.getOperand(0), N0.getOperand(1));
            }
        }
    }
    if isEXTLoad(N0.getNode()) && isUNINDEXEDLoad(N0.getNode()) {
        let mut LN0: *mut LoadSDNode = cast(N0);
        if ExtVT == LN0.getMemoryVT() && ((!self.LegalOperations && LN0.isSimple() && N0.hasOneUse()) || self.TLI.isLoadLegal(VT, ExtVT, LN0.getAlign(), LN0.getAddressSpace(), SEXTLOAD, false)) {
            let mut ExtLoad: SDValue = self.DAG.getExtLoad(SEXTLOAD, DL, VT, LN0.getChain(), LN0.getBasePtr(), ExtVT, LN0.getMemOperand());
            self.CombineTo(N, ExtLoad, true);
            self.CombineTo(N0.getNode(), ExtLoad, ExtLoad.getValue(1), true);
            self.AddToWorklist(ExtLoad.getNode(), true, false);
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    if isZEXTLoad(N0.getNode()) && isUNINDEXEDLoad(N0.getNode()) {
        let mut LN0: *mut LoadSDNode = cast(N0);
        if N0.hasOneUse() && ExtVT == LN0.getMemoryVT() && ((!self.LegalOperations && LN0.isSimple()) && self.TLI.isLoadLegal(VT, ExtVT, LN0.getAlign(), LN0.getAddressSpace(), SEXTLOAD, false)) {
            let mut ExtLoad: SDValue = self.DAG.getExtLoad(SEXTLOAD, DL, VT, LN0.getChain(), LN0.getBasePtr(), ExtVT, LN0.getMemOperand());
            self.CombineTo(N, ExtLoad, true);
            self.CombineTo(N0.getNode(), ExtLoad, ExtLoad.getValue(1), true);
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    let mut Frozen: bool = N0.getOpcode() == FREEZE && N0.hasOneUse();
    if dyn_cast(if Frozen { N0.getOperand(0) } else { N0 }) {
        Ld;
    } else {
        if ExtVT == Ld.getMemoryVT() && Ld.hasNUsesOfValue(1, 0) && Ld.getExtensionType() != NON_EXTLOAD && self.TLI.isLoadLegal(VT, ExtVT, Ld.getAlign(), Ld.getAddressSpace(), SEXTLOAD, false) {
            let mut ExtMaskedLoad: SDValue = self.DAG.getMaskedLoad(VT, DL, Ld.getChain(), Ld.getBasePtr(), Ld.getOffset(), Ld.getMask(), Ld.getPassThru(), ExtVT, Ld.getMemOperand(), Ld.getAddressingMode(), SEXTLOAD, Ld.isExpandingLoad());
            self.CombineTo(N, if Frozen { N0 } else { ExtMaskedLoad }, true);
            self.CombineTo(Ld, ExtMaskedLoad, ExtMaskedLoad.getValue(1), true);
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    if dyn_cast(N0) {
        GN0;
    } else {
        if SDValue { Node: GN0, ResNo: 0 }.hasOneUse() && ExtVT == GN0.getMemoryVT() && self.TLI.isVectorLoadExtDesirable(SDValue { Node: N, ResNo: 0 }) {
            let mut Ops: [6]SDValue = [GN0.getChain(), GN0.getPassThru(), GN0.getMask(), GN0.getBasePtr(), GN0.getIndex(), GN0.getScale()];
            let mut ExtLoad: SDValue = self.DAG.getMaskedGather(self.DAG.getVTList(VT, EVT { Other }), ExtVT, DL, ArrayRef<SDValue> { Ops }, GN0.getMemOperand(), GN0.getIndexType(), SEXTLOAD);
            self.CombineTo(N, ExtLoad, true);
            self.CombineTo(N0.getNode(), ExtLoad, ExtLoad.getValue(1), true);
            self.AddToWorklist(ExtLoad.getNode(), true, false);
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    if ExtVTBits <= 16 && N0.getOpcode() == OR {
        if self.MatchBSwapHWordLow(N0.getNode(), N0.getOperand(0), N0.getOperand(1), false) {
            BSwap;
        } else {
            return self.DAG.getNode(SIGN_EXTEND_INREG, DL, VT, BSwap, N1);
        }
    }
    if N0.getOpcode() == EXTRACT_SUBVECTOR && N0.hasOneUse() && isExtOpcode(N0.getOperand(0).getOpcode()) {
        let mut InnerExt: SDValue = N0.getOperand(0);
        let mut InnerExtVT: EVT = operator(InnerExt).getValueType(0);
        let mut Extendee: SDValue = operator(InnerExt).getOperand(0);
        if ExtVTBits == Extendee.getValueType().getScalarSizeInBits() && (!self.LegalOperations || self.TLI.isOperationLegal(SIGN_EXTEND, InnerExtVT)) {
            let mut SignExtExtendee: SDValue = self.DAG.getNode(SIGN_EXTEND, DL, InnerExtVT, Extendee);
            return self.DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, SignExtExtendee, N0.getOperand(1));
        }
    }
    return SDValue {};
}

fn foldExtendVectorInregToExtendOfSubvector(N: *mut SDNode, DL: *SDLoc, TLI: *TargetLowering, DAG: *mut SelectionDAG, LegalOperations: bool) -> SDValue {
    let mut InregOpcode: u32 = N.getOpcode();
    let mut Opcode: u32 = DAG.getOpcode_EXTEND(InregOpcode);
    let mut Src: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut SrcVT: EVT = VT.changeVectorElementType(*DAG.getContext(), Src.getValueType().getVectorElementType());
    assert!(isExtVecInRegOpcode(InregOpcode), "Expected EXTEND_VECTOR_INREG dag node in input!");
    if !Src.hasOneUse() || Src.getOpcode() != CONCAT_VECTORS {
        return SDValue {};
    }
    Src = Src.getOperand(0);
    if Src.getValueType() != SrcVT {
        return SDValue {};
    }
    if LegalOperations && !TLI.isOperationLegal(Opcode, VT) {
        return SDValue {};
    }
    return DAG.getNode(Opcode, DL, VT, Src);
}

fn DAGCombiner::visitEXTEND_VECTOR_INREG(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if N0.isUndef() {
        return if N.getOpcode() == ANY_EXTEND_VECTOR_INREG { self.DAG.getUNDEF(VT) } else { self.DAG.getConstant(0, DL, VT, false, false) };
    }
    if tryToFoldExtendOfConstant(N, DL, self.TLI, self.DAG, self.LegalTypes) {
        Res;
    } else {
        return Res;
    }
    if self.SimplifyDemandedVectorElts(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if foldExtendVectorInregToExtendOfSubvector(N, DL, self.TLI, self.DAG, self.LegalOperations) {
        R;
    } else {
        return R;
    }
    return SDValue {};
}

fn DAGCombiner::visitTRUNCATE_USAT_U(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut N0: SDValue = N.getOperand(0);
    let mut FPVal: SDValue = SDValue {};
    if sd_match(N0, m_FPToUI(m_Value(FPVal))) && self.DAG.getTargetLoweringInfo().shouldConvertFpToSat(FP_TO_UINT_SAT, FPVal.getValueType(), VT) {
        return self.DAG.getNode(FP_TO_UINT_SAT, SDLoc { N0 }, VT, FPVal, self.DAG.getValueType(VT.getScalarType()));
    }
    return SDValue {};
}

fn detectUSatUPattern(In: SDValue, VT: EVT) -> SDValue {
    let mut NumDstBits: u32 = VT.getScalarSizeInBits();
    let mut NumSrcBits: u32 = In.getScalarValueSizeInBits();
    assert!(NumSrcBits > NumDstBits, "Unexpected types for truncate operation");
    let mut Min: SDValue = SDValue {};
    let mut UnsignedMax: APInt = getMaxValue(NumDstBits).zext(NumSrcBits);
    if sd_match(In, m_UMin(m_Value(Min), m_SpecificInt(UnsignedMax))) {
        return Min;
    }
    return SDValue {};
}

fn detectSSatSPattern(In: SDValue, VT: EVT) -> SDValue {
    let mut NumDstBits: u32 = VT.getScalarSizeInBits();
    let mut NumSrcBits: u32 = In.getScalarValueSizeInBits();
    assert!(NumSrcBits > NumDstBits, "Unexpected types for truncate operation");
    let mut Val: SDValue = SDValue {};
    let mut SignedMax: APInt = getSignedMaxValue(NumDstBits).sext(NumSrcBits);
    let mut SignedMin: APInt = getSignedMinValue(NumDstBits).sext(NumSrcBits);
    if sd_match(In, m_SMin(m_SMax(m_Value(Val), m_SpecificInt(SignedMin)), m_SpecificInt(SignedMax))) {
        return Val;
    }
    if sd_match(In, m_SMax(m_SMin(m_Value(Val), m_SpecificInt(SignedMax)), m_SpecificInt(SignedMin))) {
        return Val;
    }
    return SDValue {};
}

fn detectSSatUPattern(In: SDValue, VT: EVT, DAG: *mut SelectionDAG, DL: *SDLoc) -> SDValue {
    let mut NumDstBits: u32 = VT.getScalarSizeInBits();
    let mut NumSrcBits: u32 = In.getScalarValueSizeInBits();
    assert!(NumSrcBits > NumDstBits, "Unexpected types for truncate operation");
    let mut Val: SDValue = SDValue {};
    let mut UnsignedMax: APInt = getMaxValue(NumDstBits).zext(NumSrcBits);
    if sd_match(In, m_SMax(m_SMin(m_Value(Val), m_SpecificInt(UnsignedMax)), m_Zero(false))) {
        return Val;
    }
    if sd_match(In, m_SMin(m_SMax(m_Value(Val), m_Zero(false)), m_SpecificInt(UnsignedMax))) {
        return Val;
    }
    if sd_match(In, m_UMin(m_SMax(m_Value(Val), m_Zero(false)), m_SpecificInt(UnsignedMax))) {
        return Val;
    }
    return SDValue {};
}

fn foldToSaturated(N: *mut SDNode, VT: *mut EVT, Src: *mut SDValue, SrcVT: *mut EVT, DL: *mut SDLoc, TLI: *TargetLowering, DAG: *mut SelectionDAG) -> SDValue {
    let mut AllowedTruncateSat: Closure_57 = Closure_57 { TLI: &mut TLI };
    if Src.getOpcode() == SMIN || Src.getOpcode() == SMAX {
        if AllowedTruncateSat.call(TRUNCATE_SSAT_S, SrcVT, VT) {
            if detectSSatSPattern(Src, VT) {
                SSatVal;
            } else {
                return DAG.getNode(TRUNCATE_SSAT_S, DL, VT, SSatVal);
            }
        }
        if AllowedTruncateSat.call(TRUNCATE_SSAT_U, SrcVT, VT) {
            if detectSSatUPattern(Src, VT, DAG, DL) {
                SSatVal;
            } else {
                return DAG.getNode(TRUNCATE_SSAT_U, DL, VT, SSatVal);
            }
        }
    } else if Src.getOpcode() == UMIN {
        if AllowedTruncateSat.call(TRUNCATE_SSAT_U, SrcVT, VT) {
            if detectSSatUPattern(Src, VT, DAG, DL) {
                SSatVal;
            } else {
                return DAG.getNode(TRUNCATE_SSAT_U, DL, VT, SSatVal);
            }
        }
        if AllowedTruncateSat.call(TRUNCATE_USAT_U, SrcVT, VT) {
            if detectUSatUPattern(Src, VT) {
                USatVal;
            } else {
                return DAG.getNode(TRUNCATE_USAT_U, DL, VT, USatVal);
            }
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitTRUNCATE(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut SrcVT: EVT = N0.getValueType();
    let mut isLE: bool = self.DAG.getDataLayout().isLittleEndian();
    let mut DL: SDLoc = SDLoc { N };
    if propagateUnaryUndef(self.DAG, N0, VT) {
        R;
    } else {
        return R;
    }
    if N0.getOpcode() == TRUNCATE {
        return self.DAG.getNode(TRUNCATE, DL, VT, N0.getOperand(0));
    }
    if foldToSaturated(N, VT, N0, SrcVT, DL, self.TLI, self.DAG) {
        SaturatedTR;
    } else {
        return SaturatedTR;
    }
    if self.DAG.FoldConstantArithmetic(TRUNCATE, DL, VT, ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if N0.getOpcode() == ZERO_EXTEND || N0.getOpcode() == SIGN_EXTEND || N0.getOpcode() == ANY_EXTEND {
        if N0.getOperand(0).getValueType().bitsLT(VT) {
            let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
            if N0.getOpcode() == ZERO_EXTEND {
                Flags.setNonNeg(operator(N0).getFlags().hasNonNeg());
            }
            return self.DAG.getNode(N0.getOpcode(), DL, VT, N0.getOperand(0), Flags);
        }
        if N0.getOperand(0).getValueType().bitsGT(VT) {
            return self.DAG.getNode(TRUNCATE, DL, VT, N0.getOperand(0));
        }
        return N0.getOperand(0);
    }
    if !self.LegalTypes && N0.getOpcode() == SIGN_EXTEND_INREG && N0.hasOneUse() {
        let mut X: SDValue = N0.getOperand(0);
        let mut ExtVal: SDValue = N0.getOperand(1);
        let mut ExtVT: EVT = cast(ExtVal).getVT();
        if ExtVT.bitsLT(VT) && self.TLI.preferSextInRegOfTruncate(VT, SrcVT, ExtVT) {
            let mut TrX: SDValue = self.DAG.getNode(TRUNCATE, DL, VT, X);
            return self.DAG.getNode(SIGN_EXTEND_INREG, DL, VT, TrX, ExtVal);
        }
    }
    if N.hasOneUse() && (operator(N.user_begin()).getOpcode() == ANY_EXTEND) {
        return SDValue {};
    }
    if self.LegalTypes && !self.LegalOperations && VT.isScalarInteger() && VT != EVT { i1 } && operator(N0).hasOneUse() {
        let mut TrTy: EVT = N.getValueType(0);
        let mut Src: SDValue = N0;
        let mut EltOffset: i32 = 0;
        if Src.getOpcode() == SRL && operator(Src.getOperand(0)).hasOneUse() {
            if self.DAG.getValidShiftAmount(Src, 0) {
                ShAmt;
            } else {
                if (operator(ShAmt) % TrTy.getSizeInBits().operator unsigned long long()) == 0 {
                    Src = Src.getOperand(0);
                    EltOffset = operator(ShAmt) / TrTy.getSizeInBits().operator unsigned long long();
                }
            }
        }
        if Src.getOpcode() == EXTRACT_VECTOR_ELT {
            let mut VecTy: EVT = Src.getOperand(0).getValueType();
            let mut ExTy: EVT = Src.getValueType();
            let mut EltCnt: ElementCount = VecTy.getVectorElementCount();
            let mut SizeRatio: u32 = ExTy.getSizeInBits().operator unsigned long long() / TrTy.getSizeInBits().operator unsigned long long();
            let mut NewEltCnt: ElementCount = EltCnt * SizeRatio;
            let mut NVT: EVT = getVectorVT(*self.DAG.getContext(), TrTy, NewEltCnt);
            assert!(NVT.getSizeInBits() == VecTy.getSizeInBits(), "Invalid Size");
            let mut EltNo: SDValue = operator(Src).getOperand(1);
            if isa(EltNo) && self.isTypeLegal(NVT) {
                let mut Elt: i32 = operator(EltNo).getAsZExtVal();
                let mut Index: i32 = if isLE { (Elt * SizeRatio + EltOffset) } else { (Elt * SizeRatio + (SizeRatio - 1) - EltOffset) };
                return self.DAG.getNode(EXTRACT_VECTOR_ELT, DL, TrTy, self.DAG.getBitcast(NVT, Src.getOperand(0)), self.DAG.getVectorIdxConstant(Index, DL, false));
            }
        }
    }
    if N0.getOpcode() == SELECT && N0.hasOneUse() && self.TLI.isTruncateFree(SrcVT, VT) {
        if !self.LegalOperations || (self.TLI.isOperationLegal(SELECT, SrcVT) && self.TLI.isNarrowingProfitable(N0.getNode(), SrcVT, VT)) {
            let mut SL: SDLoc = SDLoc { N0 };
            let mut Cond: SDValue = N0.getOperand(0);
            let mut TruncOp0: SDValue = self.DAG.getNode(TRUNCATE, SL, VT, N0.getOperand(1));
            let mut TruncOp1: SDValue = self.DAG.getNode(TRUNCATE, SL, VT, N0.getOperand(2));
            return self.DAG.getNode(SELECT, DL, VT, Cond, TruncOp0, TruncOp1);
        }
    }
    if N0.getOpcode() == SHL && N0.hasOneUse() && (!self.LegalOperations || self.TLI.isOperationLegal(SHL, VT)) && self.TLI.isTypeDesirableForOp(SHL, VT) {
        let mut Amt: SDValue = N0.getOperand(1);
        let mut Known: KnownBits = self.DAG.computeKnownBits(Amt, 0);
        let mut Size: u32 = VT.getScalarSizeInBits();
        if Known.countMaxActiveBits() <= Log2_32(Size) {
            let mut AmtVT: EVT = self.TLI.getShiftAmountTy(VT, self.DAG.getDataLayout());
            let mut Trunc: SDValue = self.DAG.getNode(TRUNCATE, DL, VT, N0.getOperand(0));
            if AmtVT != Amt.getValueType() {
                Amt = self.DAG.getZExtOrTrunc(Amt, DL, AmtVT);
                self.AddToWorklist(Amt.getNode(), true, false);
            }
            return self.DAG.getNode(SHL, DL, VT, Trunc, Amt);
        }
    }
    if self.foldSubToUSubSat(VT, N0.getNode(), DL) {
        V;
    } else {
        return V;
    }
    if self.foldABSToABD(N, DL) {
        ABD;
    } else {
        return ABD;
    }
    if N0.getOpcode() == BUILD_VECTOR && !self.LegalOperations && N0.hasOneUse() && (!self.LegalTypes || self.TLI.isTypeLegal(VT.getScalarType())) {
        if self.TLI.isTruncateFree(SrcVT.getScalarType(), VT.getScalarType()) {
            return self.DAG.UnrollVectorOp(N, 0);
        }
        if self.DAG.getSplatValue(N0, false) {
            SplatVal;
        } else {
            if isExtOpcode(SplatVal.getOpcode()) && SrcVT.getScalarType() == SplatVal.getValueType() {
                return self.DAG.UnrollVectorOp(N, 0);
            }
        }
    }
    if N0.getOpcode() == SPLAT_VECTOR && (!self.LegalTypes || self.TLI.isTypeLegal(VT.getScalarType())) && (!self.LegalOperations || self.TLI.isOperationLegal(SPLAT_VECTOR, VT)) {
        let mut SVT: EVT = VT.getScalarType();
        return self.DAG.getSplatVector(VT, DL, self.DAG.getNode(TRUNCATE, DL, SVT, operator(N0).getOperand(0)));
    }
    if self.Level == AfterLegalizeVectorOps && VT.isVector() && N0.getOpcode() == BITCAST && N0.hasOneUse() && N0.getOperand(0).getOpcode() == BUILD_VECTOR && N0.getOperand(0).hasOneUse() {
        let mut BuildVect: SDValue = N0.getOperand(0);
        let mut BuildVectEltTy: EVT = BuildVect.getValueType().getVectorElementType();
        let mut TruncVecEltTy: EVT = VT.getVectorElementType();
        if BuildVectEltTy == TruncVecEltTy {
            let mut BuildVecNumElts: u32 = BuildVect.getNumOperands();
            let mut TruncVecNumElts: u32 = VT.getVectorNumElements();
            let mut TruncEltOffset: u32 = BuildVecNumElts / TruncVecNumElts;
            let mut FirstElt: u32 = if isLE { 0 } else { (TruncEltOffset - 1) };
            assert!((BuildVecNumElts % TruncVecNumElts) == 0, "Invalid number of elements");
            let mut Opnds: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
            for let mut i: u32 = FirstElt;
let mut e: u32 = BuildVecNumElts; i < e; i += TruncEltOffset {
                Opnds.push(ValueParamT { BuildVect.getOperand(i) });
            }
            return self.DAG.getBuildVector(VT, DL, ArrayRef<SDValue> { Opnds });
        }
    }
    if !self.LegalTypes || self.TLI.isTypeDesirableForOp(N0.getNode(), VT) {
        if self.reduceLoadWidth(N) {
            Reduced;
        } else {
            return Reduced;
        }
        if N0.hasOneUse() && isUNINDEXEDLoad(N0.getNode()) {
            let mut LN0: *mut LoadSDNode = cast(N0);
            if LN0.isSimple() && LN0.getMemoryVT().bitsLE(VT) {
                let mut NewLoad: SDValue = self.DAG.getExtLoad(LN0.getExtensionType(), SDLoc { LN0 }, VT, LN0.getChain(), LN0.getBasePtr(), LN0.getMemoryVT(), LN0.getMemOperand());
                self.DAG.ReplaceAllUsesOfValueWith(N0.getValue(1), NewLoad.getValue(1));
                return NewLoad;
            }
        }
    }
    if N0.getOpcode() == CONCAT_VECTORS && !self.LegalTypes {
        let mut VTs: SmallVector<EVT, 8> = SmallVector<EVT, 8> {};
        let mut V: SDValue = SDValue {};
        let mut Idx: u32 = 0;
        let mut NumDefs: u32 = 0;
        for let mut i: u32 = 0;
let mut e: u32 = N0.getNumOperands(); i != e; i += 1 {
            let mut X: SDValue = N0.getOperand(i);
            if !X.isUndef() {
                V = X;
                Idx = i;
                NumDefs += 1;
            }
            if NumDefs > 1 {
                break;
            }
            VTs.push(getVectorVT(*self.DAG.getContext(), VT.getVectorElementType(), X.getValueType().getVectorElementCount()));
        }
        if NumDefs == 0 {
            return self.DAG.getUNDEF(VT);
        }
        if NumDefs == 1 {
            assert!(V.getNode(), "The single defined operand is empty!");
            let mut Opnds: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
            for let mut i: u32 = 0;
let mut e: u32 = VTs.len; i != e; i += 1 {
                if i != Idx {
                    Opnds.push(self.DAG.getUNDEF(VTs[i]));
                    continue;
                }
                let mut NV: SDValue = self.DAG.getNode(TRUNCATE, SDLoc { V }, VTs[i], V);
                self.AddToWorklist(NV.getNode(), true, false);
                Opnds.push(ValueParamT { NV });
            }
            return self.DAG.getNode(CONCAT_VECTORS, DL, VT, ArrayRef<SDValue> { Opnds });
        }
    }
    if N0.getOpcode() == BITCAST && !VT.isVector() {
        let mut VecSrc: SDValue = N0.getOperand(0);
        let mut VecSrcVT: EVT = VecSrc.getValueType();
        if VecSrcVT.isVectorOf(VT) && (!self.LegalOperations || self.TLI.isOperationLegal(EXTRACT_VECTOR_ELT, VecSrcVT)) {
            let mut Idx: u32 = if isLE { 0 } else { VecSrcVT.getVectorNumElements() - 1 };
            return self.DAG.getNode(EXTRACT_VECTOR_ELT, DL, VT, VecSrc, self.DAG.getVectorIdxConstant(Idx, DL, false));
        }
    }
    if self.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if !self.LegalTypes && N0.getOpcode() == EXTRACT_SUBVECTOR {
        let mut N00: SDValue = N0.getOperand(0);
        if N00.getOpcode() == SIGN_EXTEND || N00.getOpcode() == ZERO_EXTEND || N00.getOpcode() == ANY_EXTEND {
            if operator(N00.getOperand(0)).getValueType(0).getVectorElementType() == VT.getVectorElementType() {
                return self.DAG.getNode(EXTRACT_SUBVECTOR, SDLoc { operator(N0).getOperand(0) }, VT, N00.getOperand(0), N0.getOperand(1));
            }
        }
    }
    if self.matchVSelectOpSizesWithSetCC(N) {
        NewVSel;
    } else {
        return NewVSel;
    }
    match N0.getOpcode() {
        ADD => {
            SUB;
        },
        ADDE => {
            UADDO_CARRY;
        },
        USUBSAT => {
            if !self.LegalOperations && N0.hasOneUse() && N0.getOperand(0).getOpcode() == ZERO_EXTEND && N0.getOperand(0).getOperand(0).getScalarValueSizeInBits() <= VT.getScalarSizeInBits() && self.hasOperation(N0.getOpcode(), VT) {
                return getTruncatedUSUBSAT(VT, SrcVT, N0.getOperand(0), N0.getOperand(1), self.DAG, DL);
            }
        },
        AVGCEILS => {
            AVGCEILU;
        },
        AVGFLOORS => {
            AVGFLOORU;
        },
    }
    return SDValue {};
}

fn getBuildPairElt(N: *mut SDNode, i: u32) -> *mut SDNode {
    let mut Elt: SDValue = N.getOperand(i);
    if Elt.getOpcode() != MERGE_VALUES {
        return Elt.getNode();
    }
    return Elt.getOperand(Elt.getResNo()).getNode();
}

fn DAGCombiner::CombineConsecutiveLoads(self, N: *mut SDNode, VT: EVT) -> SDValue {
    assert!(N.getOpcode() == BUILD_PAIR);
    let mut LD1: *mut LoadSDNode = dyn_cast(getBuildPairElt(N, 0));
    let mut LD2: *mut LoadSDNode = dyn_cast(getBuildPairElt(N, 1));
    if self.DAG.getDataLayout().isBigEndian() {
        swap(LD1, LD2);
    }
    if !LD1 || !LD2 || !isNON_EXTLoad(LD1) || !isNON_EXTLoad(LD2) || !LD1.hasOneUse() || !LD2.hasOneUse() || LD1.getAddressSpace() != LD2.getAddressSpace() {
        return SDValue {};
    }
    let mut LD1Fast: u32 = 0;
    let mut LD1VT: EVT = LD1.getValueType(0);
    let mut LD1Bytes: u32 = LD1VT.getStoreSize().operator unsigned long long();
    if (!self.LegalOperations || self.TLI.isOperationLegal(LOAD, VT)) && self.DAG.areNonVolatileConsecutiveLoads(LD2, LD1, LD1Bytes, 1) && self.TLI.allowsMemoryAccess(*self.DAG.getContext(), self.DAG.getDataLayout(), VT, *LD1.getMemOperand(), &mut LD1Fast) && LD1Fast {
        return self.DAG.getLoad(VT, SDLoc { N }, LD1.getChain(), LD1.getBasePtr(), LD1.getPointerInfo(), MaybeAlign { LD1.getAlign() }, MONone, MMOMetadata {});
    }
    return SDValue {};
}

fn getPPCf128HiElementSelector(DAG: *SelectionDAG) -> u32 {
    return if DAG.getDataLayout().isBigEndian() { 1 } else { 0 };
}

fn DAGCombiner::foldBitcastedFPLogic(self, N: *mut SDNode, DAG: *mut SelectionDAG, TLI: *TargetLowering) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut N0: SDValue = N.getOperand(0);
    let mut SourceVT: EVT = N0.getValueType();
    if !VT.isFloatingPoint() {
        return SDValue {};
    }
    if VT.getScalarSizeInBits() != SourceVT.getScalarSizeInBits() {
        return SDValue {};
    }
    let mut FPOpcode: u32 = 0;
    let mut SignMask: APInt = APInt {};
    match N0.getOpcode() {
        AND => {
            FPOpcode = FABS;
        },
        XOR => {
            FPOpcode = FNEG;
        },
        OR => {
            FPOpcode = FABS;
        },
        _ => {
            return SDValue {};
        },
    }
    if self.LegalOperations && !TLI.isOperationLegal(FPOpcode, VT) {
        return SDValue {};
    }
    let mut IsBitCastOrFree: Closure_58 = Closure_58 { TLI: &mut TLI, FPOpcode: FPOpcode };
    let mut LogicOp0: SDValue = N0.getOperand(0);
    let mut LogicOp1: *mut ConstantSDNode = isConstOrConstSplat(N0.getOperand(1), true, false);
    if LogicOp1 && LogicOp1.getAPIntValue() == SignMask && IsBitCastOrFree.call(LogicOp0, VT) {
        let mut CastOp0: SDValue = DAG.getNode(BITCAST, SDLoc { N }, VT, LogicOp0);
        let mut FPOp: SDValue = DAG.getNode(FPOpcode, SDLoc { N }, VT, CastOp0);
        operator(NumFPLogicOpsConv, 0);
        if N0.getOpcode() == OR {
            return DAG.getNode(FNEG, SDLoc { N }, VT, FPOp);
        }
        return FPOp;
    }
    return SDValue {};
}

fn DAGCombiner::visitBITCAST(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    if propagateUnaryUndef(self.DAG, N0, VT) {
        R;
    } else {
        return R;
    }
    if VT.isVector() && (!self.LegalTypes || (!self.LegalOperations && VT.isInteger() && N0.getValueType().isInteger() && self.TLI.isTypeLegal(VT.getVectorElementType()))) && N0.getOpcode() == BUILD_VECTOR && operator(N0).hasOneUse() && cast(N0).isConstant() {
        return self.DAG.FoldConstantBuildVector(cast(N0), SDLoc { N }, VT.getVectorElementType());
    }
    if isIntOrFPConstant(N0) {
        if !self.LegalOperations || (isa(N0) && VT.isFloatingPoint() && !VT.isVector() && self.TLI.isOperationLegal(ConstantFP, VT)) || (isa(N0) && VT.isInteger() && !VT.isVector() && self.TLI.isOperationLegal(Constant, VT)) {
            let mut C: SDValue = self.DAG.getBitcast(VT, N0);
            if C.getNode() != N {
                return C;
            }
        }
    }
    if N0.getOpcode() == BITCAST {
        return self.DAG.getBitcast(VT, N0.getOperand(0));
    }
    if isBitwiseLogicOp(N0.getOpcode()) && VT.isInteger() && !self.TLI.isTypeLegal(N0.getOperand(0).getValueType()) {
        let mut IsFreeBitcast: Closure_59 = Closure_59 { cap_0: VT };
        if IsFreeBitcast.call(N0.getOperand(0)) && IsFreeBitcast.call(N0.getOperand(1)) {
            return self.DAG.getNode(N0.getOpcode(), SDLoc { N }, VT, self.DAG.getBitcast(VT, N0.getOperand(0)), self.DAG.getBitcast(VT, N0.getOperand(1)));
        }
    }
    let mut CastLoad: Closure_60 = Closure_60 { cap_0: self, VT: &mut VT };
    if CastLoad.call(N0, SDLoc { N }) {
        NewLd;
    } else {
        return NewLd;
    }
    if N0.getOpcode() == FREEZE && N0.hasOneUse() {
        if CastLoad.call(N0.getOperand(0), SDLoc { N }) {
            NewLd;
        } else {
            return self.DAG.getFreeze(NewLd);
        }
    }
    if self.foldBitcastedFPLogic(N, self.DAG, self.TLI) {
        V;
    } else {
        return V;
    }
    if ((N0.getOpcode() == FNEG && !self.TLI.isFNegFree(N0.getValueType())) || (N0.getOpcode() == FABS && !self.TLI.isFAbsFree(N0.getValueType()))) && operator(N0).hasOneUse() && VT.isInteger() && !VT.isVector() && !N0.getValueType().isVector() {
        let mut NewConv: SDValue = self.DAG.getBitcast(VT, N0.getOperand(0));
        self.AddToWorklist(NewConv.getNode(), true, false);
        let mut DL: SDLoc = SDLoc { N };
        if N0.getValueType() == EVT { ppcf128 } && !self.LegalTypes {
            assert!(VT.getSizeInBits().operator unsigned long long() == 128);
            let mut SignBit: SDValue = self.DAG.getConstant(getSignMask(VT.getSizeInBits().operator unsigned long long() / 2), SDLoc { N0 }, EVT { i64 }, false, false);
            let mut FlipBit: SDValue = SDValue {};
            if N0.getOpcode() == FNEG {
                FlipBit = SignBit;
                self.AddToWorklist(FlipBit.getNode(), true, false);
            } else {
                assert!(N0.getOpcode() == FABS);
                let mut Hi: SDValue = self.DAG.getNode(EXTRACT_ELEMENT, SDLoc { NewConv }, EVT { i64 }, NewConv, self.DAG.getIntPtrConstant(getPPCf128HiElementSelector(self.DAG), SDLoc { NewConv }, false));
                self.AddToWorklist(Hi.getNode(), true, false);
                FlipBit = self.DAG.getNode(AND, SDLoc { N0 }, EVT { i64 }, Hi, SignBit);
                self.AddToWorklist(FlipBit.getNode(), true, false);
            }
            let mut FlipBits: SDValue = self.DAG.getNode(BUILD_PAIR, SDLoc { N0 }, VT, FlipBit, FlipBit);
            self.AddToWorklist(FlipBits.getNode(), true, false);
            return self.DAG.getNode(XOR, DL, VT, NewConv, FlipBits);
        }
        let mut SignBit: APInt = getSignMask(VT.getSizeInBits().operator unsigned long long());
        if N0.getOpcode() == FNEG {
            return self.DAG.getNode(XOR, DL, VT, NewConv, self.DAG.getConstant(SignBit, DL, VT, false, false));
        }
        assert!(N0.getOpcode() == FABS);
        return self.DAG.getNode(AND, DL, VT, NewConv, self.DAG.getConstant(operator(SignBit), DL, VT, false, false));
    }
    if N0.getOpcode() == FCOPYSIGN && operator(N0).hasOneUse() && isa(N0.getOperand(0)) && VT.isInteger() && !VT.isVector() {
        let mut OrigXWidth: u32 = N0.getOperand(1).getValueSizeInBits().operator unsigned long long();
        let mut IntXVT: EVT = getIntegerVT(*self.DAG.getContext(), OrigXWidth);
        if self.isTypeLegal(IntXVT) {
            let mut X: SDValue = self.DAG.getBitcast(IntXVT, N0.getOperand(1));
            self.AddToWorklist(X.getNode(), true, false);
            let mut VTWidth: u32 = VT.getSizeInBits().operator unsigned long long();
            if OrigXWidth < VTWidth {
                X = self.DAG.getNode(SIGN_EXTEND, SDLoc { N }, VT, X);
                self.AddToWorklist(X.getNode(), true, false);
            } else if OrigXWidth > VTWidth {
                let mut DL: SDLoc = SDLoc { X };
                X = self.DAG.getNode(SRL, DL, X.getValueType(), X, self.DAG.getConstant(OrigXWidth - VTWidth, DL, X.getValueType(), false, false));
                self.AddToWorklist(X.getNode(), true, false);
                X = self.DAG.getNode(TRUNCATE, SDLoc { X }, VT, X);
                self.AddToWorklist(X.getNode(), true, false);
            }
            if N0.getValueType() == EVT { ppcf128 } && !self.LegalTypes {
                let mut SignBit: APInt = getSignMask(VT.getSizeInBits().operator unsigned long long() / 2);
                let mut Cst: SDValue = self.DAG.getBitcast(VT, N0.getOperand(0));
                self.AddToWorklist(Cst.getNode(), true, false);
                let mut X: SDValue = self.DAG.getBitcast(VT, N0.getOperand(1));
                self.AddToWorklist(X.getNode(), true, false);
                let mut XorResult: SDValue = self.DAG.getNode(XOR, SDLoc { N0 }, VT, Cst, X);
                self.AddToWorklist(XorResult.getNode(), true, false);
                let mut XorResult64: SDValue = self.DAG.getNode(EXTRACT_ELEMENT, SDLoc { XorResult }, EVT { i64 }, XorResult, self.DAG.getIntPtrConstant(getPPCf128HiElementSelector(self.DAG), SDLoc { XorResult }, false));
                self.AddToWorklist(XorResult64.getNode(), true, false);
                let mut FlipBit: SDValue = self.DAG.getNode(AND, SDLoc { XorResult64 }, EVT { i64 }, XorResult64, self.DAG.getConstant(SignBit, SDLoc { XorResult64 }, EVT { i64 }, false, false));
                self.AddToWorklist(FlipBit.getNode(), true, false);
                let mut FlipBits: SDValue = self.DAG.getNode(BUILD_PAIR, SDLoc { N0 }, VT, FlipBit, FlipBit);
                self.AddToWorklist(FlipBits.getNode(), true, false);
                return self.DAG.getNode(XOR, SDLoc { N }, VT, Cst, FlipBits);
            }
            let mut SignBit: APInt = getSignMask(VT.getSizeInBits().operator unsigned long long());
            X = self.DAG.getNode(AND, SDLoc { X }, VT, X, self.DAG.getConstant(SignBit, SDLoc { X }, VT, false, false));
            self.AddToWorklist(X.getNode(), true, false);
            let mut Cst: SDValue = self.DAG.getBitcast(VT, N0.getOperand(0));
            Cst = self.DAG.getNode(AND, SDLoc { Cst }, VT, Cst, self.DAG.getConstant(operator(SignBit), SDLoc { Cst }, VT, false, false));
            self.AddToWorklist(Cst.getNode(), true, false);
            return self.DAG.getNode(OR, SDLoc { N }, VT, X, Cst);
        }
    }
    if N0.getOpcode() == BUILD_PAIR {
        if self.CombineConsecutiveLoads(N0.getNode(), VT) {
            CombineLD;
        } else {
            return CombineLD;
        }
    }
    if self.DAG.getDataLayout().isLittleEndian() && N0.getOpcode() == SCALAR_TO_VECTOR && VT.isScalarInteger() {
        let mut SrcScalar: SDValue = N0.getOperand(0);
        let mut SrcVT: EVT = SrcScalar.getValueType();
        if SrcVT.isScalarInteger() && VT.bitsGT(SrcVT) {
            return self.DAG.getNode(ANY_EXTEND, SDLoc { N }, VT, SrcScalar);
        }
    }
    if self.Level < AfterLegalizeDAG && self.TLI.isTypeLegal(VT) && VT.isVector() && operator(N0).getOpcode() == VECTOR_SHUFFLE && N0.hasOneUse() && VT.getVectorNumElements() >= N0.getValueType().getVectorNumElements() && !(VT.getVectorNumElements() % N0.getValueType().getVectorNumElements()) {
        let mut SVN: *mut ShuffleVectorSDNode = cast(N0);
        let mut PeekThroughBitcast: Closure_61 = Closure_61 { VT: &mut VT, cap_1: self };
        let mut SV0: SDValue = PeekThroughBitcast.call(operator(N0).getOperand(0));
        let mut SV1: SDValue = PeekThroughBitcast.call(operator(N0).getOperand(1));
        if !(SV0 && SV1) {
            return SDValue {};
        }
        let mut MaskScale: i32 = VT.getVectorNumElements() / N0.getValueType().getVectorNumElements();
        let mut NewMask: SmallVector<int, 8> = SmallVector<int, 8> {};
        for M in SVN.getMask() {
            for let mut i: i32 = 0; i != MaskScale; i += 1 {
                NewMask.push(if M < 0 { -1 } else { M * MaskScale + i });
            }
        }
        let mut LegalShuffle: SDValue = self.TLI.buildLegalVectorShuffle(VT, SDLoc { N }, SV0, SV1, MutableArrayRef<int> { NewMask }, self.DAG);
        if LegalShuffle {
            return LegalShuffle;
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitBUILD_PAIR(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    return self.CombineConsecutiveLoads(N, VT);
}

fn DAGCombiner::visitFREEZE(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    if self.DAG.isGuaranteedNotToBeUndefOrPoison(N0, UndefOrPoison, 0) {
        return N0;
    }
    if !N0.isUndef() && !N0.hasOneUse() {
        let mut FrozenN0: SDValue = SDValue { Node: N, ResNo: 0 };
        while !N.use_empty() {
            self.DAG.ReplaceAllUsesOfValueWith(FrozenN0, N0);
        }
        self.DAG.ReplaceAllUsesOfValueWith(N0, FrozenN0);
        assert!(N.getOperand(0) == FrozenN0, "Expected cycle in DAG");
        self.DAG.UpdateNodeOperands(N, N0);
        self.AddToWorklist(N, true, false);
        return FrozenN0;
    }
    if N0.getOpcode() == SRL {
        return SDValue {};
    }
    if self.DAG.canCreateUndefOrPoison(N0, UndefOrPoison, false, 0) || operator(N0).getNumValues() != 1 || !operator(N0).hasOneUse() {
        return SDValue {};
    }
    let mut AllowMultipleMaybePoisonOperands: bool = N0.getOpcode() == SELECT_CC || N0.getOpcode() == SETCC || N0.getOpcode() == BUILD_VECTOR || N0.getOpcode() == INSERT_SUBVECTOR || N0.getOpcode() == BUILD_PAIR || N0.getOpcode() == VECTOR_SHUFFLE || N0.getOpcode() == CONCAT_VECTORS || N0.getOpcode() == FMUL;
    if N0.getOpcode() == BUILD_VECTOR {
        let mut DL: SDLoc = SDLoc { N0 };
        let mut VT: EVT = N0.getValueType();
        if isBuildVectorAllOnes(N0.getNode()) && VT.isInteger() {
            return self.DAG.getAllOnesConstant(DL, VT, false, false);
        }
        if isBuildVectorOfConstantSDNodes(N0.getNode()) {
            let mut NewVecC: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
            for Op in operator(N0).op_values() {
                NewVecC.push(if Op.isUndef() { self.DAG.getConstant(0, DL, Op.getValueType(), false, false) } else { Op });
            }
            return self.DAG.getBuildVector(VT, DL, ArrayRef<SDValue> { NewVecC });
        }
    }
    let mut MaybePoisonOperands: SmallSet<SDValue, 8> = SmallSet<SDValue, 8> {};
    let mut MaybePoisonOperandNumbers: SmallVector<unsigned int, 8> = SmallVector<unsigned int, 8> {};
    for x in enumerate(operator(N0).ops()) {
        if self.DAG.isGuaranteedNotToBeUndefOrPoison(Op.operator const llvm::SDValue &(), UndefOrPoison, 0) {
            continue;
        }
        let mut HadMaybePoisonOperands: bool = !MaybePoisonOperands.is_empty();
        let mut IsNewMaybePoisonOperand: bool = MaybePoisonOperands.insert(Op.operator const llvm::SDValue &()).second;
        if IsNewMaybePoisonOperand {
            MaybePoisonOperandNumbers.push(OpNo);
        }
        if !HadMaybePoisonOperands {
            continue;
        }
        if IsNewMaybePoisonOperand && !AllowMultipleMaybePoisonOperands {
            return SDValue {};
        }
    }
    for OpNo in MaybePoisonOperandNumbers {
        let mut MaybePoisonOperand: SDValue = N.getOperand(0).getOperand(OpNo);
        if MaybePoisonOperand.isUndef() {
            continue;
        }
        let mut FrozenMaybePoisonOperand: SDValue = self.DAG.getFreeze(MaybePoisonOperand);
        self.DAG.ReplaceAllUsesOfValueWith(MaybePoisonOperand, FrozenMaybePoisonOperand);
        if FrozenMaybePoisonOperand.getOpcode() == FREEZE && FrozenMaybePoisonOperand.getOperand(0) == FrozenMaybePoisonOperand {
            self.DAG.UpdateNodeOperands(FrozenMaybePoisonOperand.getNode(), MaybePoisonOperand);
        }
        if N.getOpcode() == DELETED_NODE {
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    assert!(N.getOpcode() != DELETED_NODE, "Node was deleted!");
    N0 = N.getOperand(0);
    let mut Ops: SmallVector<SDValue> = SmallVector<SDValue> { operator(N0).ops() };
    for Op in Ops {
        if Op.isUndef() {
            Op = self.DAG.getFreeze(Op);
        }
    }
    let mut DL: SDLoc = SDLoc { N0 };
    if dyn_cast(N0) {
        SVN;
    } else {
        return self.DAG.getVectorShuffle(N0.getValueType(), DL, Ops[0], Ops[1], SVN.getMask());
    }
    let mut SrcFlags: SDNodeFlags = operator(N0).getFlags();
    let mut SafeFlags: SDNodeFlags = SDNodeFlags { Flags: None };
    SafeFlags.setAllowContract(SrcFlags.hasAllowContract());
    SafeFlags.setAllowReassociation(SrcFlags.hasAllowReassociation());
    SafeFlags.setApproximateFuncs(SrcFlags.hasApproximateFuncs());
    SafeFlags.setAllowReciprocal(SrcFlags.hasAllowReciprocal());
    return self.DAG.getNode(N0.getOpcode(), DL, operator(N0).getVTList(), ArrayRef<SDValue> { Ops }, SafeFlags);
}

fn isContractableFMUL(N: SDValue) -> bool {
    assert!(N.getOpcode() == FMUL);
    return operator(N).getFlags().hasAllowContract();
}

fn DAGCombiner::visitFADDForFMACombine(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut SL: SDLoc = SDLoc { N };
    let mut HasFMAD: bool = (self.LegalOperations && self.TLI.isFMADLegal(self.DAG, N));
    let mut HasFMA: bool = (!self.LegalOperations || self.TLI.isOperationLegalOrCustom(FMA, VT, false)) && self.TLI.isFMAFasterThanFMulAndFAdd(self.DAG.getMachineFunction(), VT);
    if !HasFMAD && !HasFMA {
        return SDValue {};
    }
    let mut AllowFusionGlobally: bool = HasFMAD;
    if !AllowFusionGlobally && !N.getFlags().hasAllowContract() {
        return SDValue {};
    }
    if N0 == N1 {
        return SDValue {};
    }
    if self.TLI.generateFMAsInMachineCombiner(VT, self.OptLevel) {
        return SDValue {};
    }
    let mut PreferredFusedOpcode: u32 = if HasFMAD { FMAD } else { FMA };
    let mut Aggressive: bool = self.TLI.enableAggressiveFMAFusion(VT);
    let mut isFusedOp: Closure_62 = Closure_62 {};
    let mut isContractableFMUL: Closure_63 = Closure_63 { AllowFusionGlobally: AllowFusionGlobally };
    if Aggressive && isContractableFMUL.call(N0) && isContractableFMUL.call(N1) {
        if operator(N0).use_size() > operator(N1).use_size() {
            swap(N0, N1);
        }
    }
    if isContractableFMUL.call(N0) && (Aggressive || operator(N0).hasOneUse()) {
        return self.DAG.getNode(PreferredFusedOpcode, SL, VT, N0.getOperand(0), N0.getOperand(1), N1);
    }
    if isContractableFMUL.call(N1) && (Aggressive || operator(N1).hasOneUse()) {
        return self.DAG.getNode(PreferredFusedOpcode, SL, VT, N1.getOperand(0), N1.getOperand(1), N0);
    }
    let mut CanReassociate: bool = N.getFlags().hasAllowReassociation();
    if CanReassociate {
        let mut FMA: SDValue = SDValue {};
        let mut E: SDValue = SDValue {};
        if isFusedOp.call(N0) && N0.hasOneUse() {
            FMA = N0;
            E = N1;
        } else if isFusedOp.call(N1) && N1.hasOneUse() {
            FMA = N1;
            E = N0;
        }
        let mut TmpFMA: SDValue = FMA;
        while E && isFusedOp.call(TmpFMA) && TmpFMA.hasOneUse() {
            let mut FMul: SDValue = operator(TmpFMA).getOperand(2);
            if FMul.getOpcode() == FMUL && FMul.hasOneUse() {
                let mut C: SDValue = FMul.getOperand(0);
                let mut D: SDValue = FMul.getOperand(1);
                let mut CDE: SDValue = self.DAG.getNode(PreferredFusedOpcode, SL, VT, C, D, E);
                self.DAG.ReplaceAllUsesOfValueWith(FMul, CDE);
                return if FMA.getOpcode() == DELETED_NODE { SDValue { Node: N, ResNo: 0 } } else { FMA };
            }
            TmpFMA = operator(TmpFMA).getOperand(2);
        }
    }
    if N0.getOpcode() == FP_EXTEND {
        let mut N00: SDValue = N0.getOperand(0);
        if isContractableFMUL.call(N00) && self.TLI.isFPExtFoldable(self.DAG, PreferredFusedOpcode, VT, N00.getValueType()) {
            return self.DAG.getNode(PreferredFusedOpcode, SL, VT, self.DAG.getNode(FP_EXTEND, SL, VT, N00.getOperand(0)), self.DAG.getNode(FP_EXTEND, SL, VT, N00.getOperand(1)), N1);
        }
    }
    if N1.getOpcode() == FP_EXTEND {
        let mut N10: SDValue = N1.getOperand(0);
        if isContractableFMUL.call(N10) && self.TLI.isFPExtFoldable(self.DAG, PreferredFusedOpcode, VT, N10.getValueType()) {
            return self.DAG.getNode(PreferredFusedOpcode, SL, VT, self.DAG.getNode(FP_EXTEND, SL, VT, N10.getOperand(0)), self.DAG.getNode(FP_EXTEND, SL, VT, N10.getOperand(1)), N0);
        }
    }
    if Aggressive {
        let mut FoldFAddFMAFPExtFMul: Closure_64 = Closure_64 { cap_0: self, PreferredFusedOpcode: &mut PreferredFusedOpcode, SL: &mut SL, VT: &mut VT };
        if isFusedOp.call(N0) {
            let mut N02: SDValue = N0.getOperand(2);
            if N02.getOpcode() == FP_EXTEND {
                let mut N020: SDValue = N02.getOperand(0);
                if isContractableFMUL.call(N020) && self.TLI.isFPExtFoldable(self.DAG, PreferredFusedOpcode, VT, N020.getValueType()) {
                    return FoldFAddFMAFPExtFMul.call(N0.getOperand(0), N0.getOperand(1), N020.getOperand(0), N020.getOperand(1), N1);
                }
            }
        }
        let mut FoldFAddFPExtFMAFMul: Closure_65 = Closure_65 { cap_0: self, PreferredFusedOpcode: &mut PreferredFusedOpcode, SL: &mut SL, VT: &mut VT };
        if N0.getOpcode() == FP_EXTEND {
            let mut N00: SDValue = N0.getOperand(0);
            if isFusedOp.call(N00) {
                let mut N002: SDValue = N00.getOperand(2);
                if isContractableFMUL.call(N002) && self.TLI.isFPExtFoldable(self.DAG, PreferredFusedOpcode, VT, N00.getValueType()) {
                    return FoldFAddFPExtFMAFMul.call(N00.getOperand(0), N00.getOperand(1), N002.getOperand(0), N002.getOperand(1), N1);
                }
            }
        }
        if isFusedOp.call(N1) {
            let mut N12: SDValue = N1.getOperand(2);
            if N12.getOpcode() == FP_EXTEND {
                let mut N120: SDValue = N12.getOperand(0);
                if isContractableFMUL.call(N120) && self.TLI.isFPExtFoldable(self.DAG, PreferredFusedOpcode, VT, N120.getValueType()) {
                    return FoldFAddFMAFPExtFMul.call(N1.getOperand(0), N1.getOperand(1), N120.getOperand(0), N120.getOperand(1), N0);
                }
            }
        }
        if N1.getOpcode() == FP_EXTEND {
            let mut N10: SDValue = N1.getOperand(0);
            if isFusedOp.call(N10) {
                let mut N102: SDValue = N10.getOperand(2);
                if isContractableFMUL.call(N102) && self.TLI.isFPExtFoldable(self.DAG, PreferredFusedOpcode, VT, N10.getValueType()) {
                    return FoldFAddFPExtFMAFMul.call(N10.getOperand(0), N10.getOperand(1), N102.getOperand(0), N102.getOperand(1), N0);
                }
            }
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitFSUBForFMACombine(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut SL: SDLoc = SDLoc { N };
    let mut HasFMAD: bool = (self.LegalOperations && self.TLI.isFMADLegal(self.DAG, N));
    let mut HasFMA: bool = (!self.LegalOperations || self.TLI.isOperationLegalOrCustom(FMA, VT, false)) && self.TLI.isFMAFasterThanFMulAndFAdd(self.DAG.getMachineFunction(), VT);
    if !HasFMAD && !HasFMA {
        return SDValue {};
    }
    let mut Flags: SDNodeFlags = N.getFlags();
    let mut AllowFusionGlobally: bool = HasFMAD;
    if !AllowFusionGlobally && !N.getFlags().hasAllowContract() {
        return SDValue {};
    }
    if self.TLI.generateFMAsInMachineCombiner(VT, self.OptLevel) {
        return SDValue {};
    }
    let mut PreferredFusedOpcode: u32 = if HasFMAD { FMAD } else { FMA };
    let mut Aggressive: bool = self.TLI.enableAggressiveFMAFusion(VT);
    let mut NoSignedZero: bool = Flags.hasNoSignedZeros();
    let mut isContractableFMUL: Closure_66 = Closure_66 { AllowFusionGlobally: AllowFusionGlobally };
    let mut tryToFoldXYSubZ: Closure_67 = Closure_67 { isContractableFMUL: &mut isContractableFMUL, Aggressive: &mut Aggressive, cap_2: self, PreferredFusedOpcode: &mut PreferredFusedOpcode, SL: &mut SL, VT: &mut VT };
    let mut tryToFoldXSubYZ: Closure_68 = Closure_68 { isContractableFMUL: &mut isContractableFMUL, Aggressive: &mut Aggressive, cap_2: self, PreferredFusedOpcode: &mut PreferredFusedOpcode, SL: &mut SL, VT: &mut VT };
    if isContractableFMUL.call(N0) && isContractableFMUL.call(N1) && (operator(N0).use_size() > operator(N1).use_size()) {
        if tryToFoldXSubYZ.call(N0, N1) {
            V;
        } else {
            return V;
        }
        if tryToFoldXYSubZ.call(N0, N1) {
            V;
        } else {
            return V;
        }
    } else {
        if tryToFoldXYSubZ.call(N0, N1) {
            V;
        } else {
            return V;
        }
        if tryToFoldXSubYZ.call(N0, N1) {
            V;
        } else {
            return V;
        }
    }
    if N0.getOpcode() == FNEG && isContractableFMUL.call(N0.getOperand(0)) && (Aggressive || (operator(N0).hasOneUse() && N0.getOperand(0).hasOneUse())) {
        let mut N00: SDValue = N0.getOperand(0).getOperand(0);
        let mut N01: SDValue = N0.getOperand(0).getOperand(1);
        return self.DAG.getNode(PreferredFusedOpcode, SL, VT, self.DAG.getNode(FNEG, SL, VT, N00), N01, self.DAG.getNode(FNEG, SL, VT, N1));
    }
    if N0.getOpcode() == FP_EXTEND {
        let mut N00: SDValue = N0.getOperand(0);
        if isContractableFMUL.call(N00) && self.TLI.isFPExtFoldable(self.DAG, PreferredFusedOpcode, VT, N00.getValueType()) {
            return self.DAG.getNode(PreferredFusedOpcode, SL, VT, self.DAG.getNode(FP_EXTEND, SL, VT, N00.getOperand(0)), self.DAG.getNode(FP_EXTEND, SL, VT, N00.getOperand(1)), self.DAG.getNode(FNEG, SL, VT, N1));
        }
    }
    if N1.getOpcode() == FP_EXTEND {
        let mut N10: SDValue = N1.getOperand(0);
        if isContractableFMUL.call(N10) && self.TLI.isFPExtFoldable(self.DAG, PreferredFusedOpcode, VT, N10.getValueType()) {
            return self.DAG.getNode(PreferredFusedOpcode, SL, VT, self.DAG.getNode(FNEG, SL, VT, self.DAG.getNode(FP_EXTEND, SL, VT, N10.getOperand(0))), self.DAG.getNode(FP_EXTEND, SL, VT, N10.getOperand(1)), N0);
        }
    }
    if N0.getOpcode() == FP_EXTEND {
        let mut N00: SDValue = N0.getOperand(0);
        if N00.getOpcode() == FNEG {
            let mut N000: SDValue = N00.getOperand(0);
            if isContractableFMUL.call(N000) && self.TLI.isFPExtFoldable(self.DAG, PreferredFusedOpcode, VT, N00.getValueType()) {
                return self.DAG.getNode(FNEG, SL, VT, self.DAG.getNode(PreferredFusedOpcode, SL, VT, self.DAG.getNode(FP_EXTEND, SL, VT, N000.getOperand(0)), self.DAG.getNode(FP_EXTEND, SL, VT, N000.getOperand(1)), N1));
            }
        }
    }
    if N0.getOpcode() == FNEG {
        let mut N00: SDValue = N0.getOperand(0);
        if N00.getOpcode() == FP_EXTEND {
            let mut N000: SDValue = N00.getOperand(0);
            if isContractableFMUL.call(N000) && self.TLI.isFPExtFoldable(self.DAG, PreferredFusedOpcode, VT, N000.getValueType()) {
                return self.DAG.getNode(FNEG, SL, VT, self.DAG.getNode(PreferredFusedOpcode, SL, VT, self.DAG.getNode(FP_EXTEND, SL, VT, N000.getOperand(0)), self.DAG.getNode(FP_EXTEND, SL, VT, N000.getOperand(1)), N1));
            }
        }
    }
    let mut isContractableAndReassociableFMUL: Closure_69 = Closure_69 { isContractableFMUL: &mut isContractableFMUL };
    let mut isFusedOp: Closure_70 = Closure_70 {};
    if Aggressive && N.getFlags().hasAllowReassociation() {
        let mut CanFuse: bool = N.getFlags().hasAllowContract();
        if CanFuse && isFusedOp.call(N0) && isContractableAndReassociableFMUL.call(N0.getOperand(2)) && operator(N0).hasOneUse() && operator(N0.getOperand(2)).hasOneUse() {
            return self.DAG.getNode(PreferredFusedOpcode, SL, VT, N0.getOperand(0), N0.getOperand(1), self.DAG.getNode(PreferredFusedOpcode, SL, VT, N0.getOperand(2).getOperand(0), N0.getOperand(2).getOperand(1), self.DAG.getNode(FNEG, SL, VT, N1)));
        }
        if CanFuse && isFusedOp.call(N1) && isContractableAndReassociableFMUL.call(N1.getOperand(2)) && operator(N1).hasOneUse() && NoSignedZero {
            let mut N20: SDValue = N1.getOperand(2).getOperand(0);
            let mut N21: SDValue = N1.getOperand(2).getOperand(1);
            return self.DAG.getNode(PreferredFusedOpcode, SL, VT, self.DAG.getNode(FNEG, SL, VT, N1.getOperand(0)), N1.getOperand(1), self.DAG.getNode(PreferredFusedOpcode, SL, VT, self.DAG.getNode(FNEG, SL, VT, N20), N21, N0));
        }
        if isFusedOp.call(N0) && operator(N0).hasOneUse() {
            let mut N02: SDValue = N0.getOperand(2);
            if N02.getOpcode() == FP_EXTEND {
                let mut N020: SDValue = N02.getOperand(0);
                if isContractableAndReassociableFMUL.call(N020) && self.TLI.isFPExtFoldable(self.DAG, PreferredFusedOpcode, VT, N020.getValueType()) {
                    return self.DAG.getNode(PreferredFusedOpcode, SL, VT, N0.getOperand(0), N0.getOperand(1), self.DAG.getNode(PreferredFusedOpcode, SL, VT, self.DAG.getNode(FP_EXTEND, SL, VT, N020.getOperand(0)), self.DAG.getNode(FP_EXTEND, SL, VT, N020.getOperand(1)), self.DAG.getNode(FNEG, SL, VT, N1)));
                }
            }
        }
        if N0.getOpcode() == FP_EXTEND {
            let mut N00: SDValue = N0.getOperand(0);
            if isFusedOp.call(N00) {
                let mut N002: SDValue = N00.getOperand(2);
                if isContractableAndReassociableFMUL.call(N002) && self.TLI.isFPExtFoldable(self.DAG, PreferredFusedOpcode, VT, N00.getValueType()) {
                    return self.DAG.getNode(PreferredFusedOpcode, SL, VT, self.DAG.getNode(FP_EXTEND, SL, VT, N00.getOperand(0)), self.DAG.getNode(FP_EXTEND, SL, VT, N00.getOperand(1)), self.DAG.getNode(PreferredFusedOpcode, SL, VT, self.DAG.getNode(FP_EXTEND, SL, VT, N002.getOperand(0)), self.DAG.getNode(FP_EXTEND, SL, VT, N002.getOperand(1)), self.DAG.getNode(FNEG, SL, VT, N1)));
                }
            }
        }
        if isFusedOp.call(N1) && N1.getOperand(2).getOpcode() == FP_EXTEND && operator(N1).hasOneUse() {
            let mut N120: SDValue = N1.getOperand(2).getOperand(0);
            if isContractableAndReassociableFMUL.call(N120) && self.TLI.isFPExtFoldable(self.DAG, PreferredFusedOpcode, VT, N120.getValueType()) {
                let mut N1200: SDValue = N120.getOperand(0);
                let mut N1201: SDValue = N120.getOperand(1);
                return self.DAG.getNode(PreferredFusedOpcode, SL, VT, self.DAG.getNode(FNEG, SL, VT, N1.getOperand(0)), N1.getOperand(1), self.DAG.getNode(PreferredFusedOpcode, SL, VT, self.DAG.getNode(FNEG, SL, VT, self.DAG.getNode(FP_EXTEND, SL, VT, N1200)), self.DAG.getNode(FP_EXTEND, SL, VT, N1201), N0));
            }
        }
        if N1.getOpcode() == FP_EXTEND && isFusedOp.call(N1.getOperand(0)) {
            let mut CvtSrc: SDValue = N1.getOperand(0);
            let mut N100: SDValue = CvtSrc.getOperand(0);
            let mut N101: SDValue = CvtSrc.getOperand(1);
            let mut N102: SDValue = CvtSrc.getOperand(2);
            if isContractableAndReassociableFMUL.call(N102) && self.TLI.isFPExtFoldable(self.DAG, PreferredFusedOpcode, VT, CvtSrc.getValueType()) {
                let mut N1020: SDValue = N102.getOperand(0);
                let mut N1021: SDValue = N102.getOperand(1);
                return self.DAG.getNode(PreferredFusedOpcode, SL, VT, self.DAG.getNode(FNEG, SL, VT, self.DAG.getNode(FP_EXTEND, SL, VT, N100)), self.DAG.getNode(FP_EXTEND, SL, VT, N101), self.DAG.getNode(PreferredFusedOpcode, SL, VT, self.DAG.getNode(FNEG, SL, VT, self.DAG.getNode(FP_EXTEND, SL, VT, N1020)), self.DAG.getNode(FP_EXTEND, SL, VT, N1021), N0));
            }
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitFMULForFMADistributiveCombine(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut SL: SDLoc = SDLoc { N };
    assert!(N.getOpcode() == FMUL, "Expected FMUL Operation");
    let mut FAdd: SDValue = if N0.getOpcode() == FADD { N0 } else { N1 };
    if !operator(FAdd).getFlags().hasNoInfs() {
        return SDValue {};
    }
    let mut HasFMA: bool = isContractableFMUL(SDValue { Node: N, ResNo: 0 }) && (!self.LegalOperations || self.TLI.isOperationLegalOrCustom(FMA, VT, false)) && self.TLI.isFMAFasterThanFMulAndFAdd(self.DAG.getMachineFunction(), VT);
    let mut HasFMAD: bool = self.LegalOperations && self.TLI.isFMADLegal(self.DAG, N);
    if !HasFMAD && !HasFMA {
        return SDValue {};
    }
    let mut PreferredFusedOpcode: u32 = if HasFMAD { FMAD } else { FMA };
    let mut Aggressive: bool = self.TLI.enableAggressiveFMAFusion(VT);
    let mut FuseFADD: Closure_71 = Closure_71 { Aggressive: &mut Aggressive, cap_1: self, PreferredFusedOpcode: &mut PreferredFusedOpcode, SL: &mut SL, VT: &mut VT };
    if FuseFADD.call(N0, N1) {
        FMA;
    } else {
        return FMA;
    }
    if FuseFADD.call(N1, N0) {
        FMA;
    } else {
        return FMA;
    }
    let mut FuseFSUB: Closure_72 = Closure_72 { Aggressive: &mut Aggressive, cap_1: self, PreferredFusedOpcode: &mut PreferredFusedOpcode, SL: &mut SL, VT: &mut VT };
    if FuseFSUB.call(N0, N1) {
        FMA;
    } else {
        return FMA;
    }
    if FuseFSUB.call(N1, N0) {
        FMA;
    } else {
        return FMA;
    }
    return SDValue {};
}

fn DAGCombiner::visitFADD(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut N0CFP: bool = self.DAG.isConstantFPBuildVectorOrConstantFP(N0);
    let mut N1CFP: bool = self.DAG.isConstantFPBuildVectorOrConstantFP(N1);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    let mut Flags: SDNodeFlags = N.getFlags();
    let mut FlagsInserter: FlagInserter = FlagInserter { self.DAG, N };
    if self.DAG.simplifyFPBinop(N.getOpcode(), N0, N1, Flags) {
        R;
    } else {
        return R;
    }
    if self.DAG.FoldConstantArithmetic(FADD, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if N0CFP && !N1CFP {
        return self.DAG.getNode(FADD, DL, VT, N1, N0);
    }
    if VT.isVector() {
        if self.SimplifyVBinOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
    }
    let mut N1C: *mut ConstantFPSDNode = isConstOrConstSplatFP(N1, true);
    if N1C && N1C.isZero() {
        if N1C.isNegative() || self.DAG.canIgnoreSignBitOfZero(SDValue { Node: N, ResNo: 0 }) {
            return N0;
        }
    }
    if self.foldBinOpIntoSelect(N) {
        NewSel;
    } else {
        return NewSel;
    }
    if !self.LegalOperations || self.TLI.isOperationLegalOrCustom(FSUB, VT, false) {
        if self.TLI.getCheaperNegatedExpression(N1, self.DAG, self.LegalOperations, self.ForCodeSize, 0) {
            NegN1;
        } else {
            return self.DAG.getNode(FSUB, DL, VT, N0, NegN1);
        }
    }
    if !self.LegalOperations || self.TLI.isOperationLegalOrCustom(FSUB, VT, false) {
        if self.TLI.getCheaperNegatedExpression(N0, self.DAG, self.LegalOperations, self.ForCodeSize, 0) {
            NegN0;
        } else {
            return self.DAG.getNode(FSUB, DL, VT, N1, NegN0);
        }
    }
    let mut isFMulNegTwo: Closure_73 = Closure_73 {};
    if isFMulNegTwo.call(N0) {
        let mut B: SDValue = N0.getOperand(0);
        let mut Add: SDValue = self.DAG.getNode(FADD, DL, VT, B, B);
        return self.DAG.getNode(FSUB, DL, VT, N1, Add);
    }
    if isFMulNegTwo.call(N1) {
        let mut B: SDValue = N1.getOperand(0);
        let mut Add: SDValue = self.DAG.getNode(FADD, DL, VT, B, B);
        return self.DAG.getNode(FSUB, DL, VT, N0, Add);
    }
    let mut AllowNewConst: bool = (self.Level < AfterLegalizeDAG);
    if Flags.hasNoNaNs() && AllowNewConst {
        if N0.getOpcode() == FNEG && N0.getOperand(0) == N1 {
            return self.DAG.getConstantFP(0.0, DL, VT, false);
        }
        if N1.getOpcode() == FNEG && N1.getOperand(0) == N0 {
            return self.DAG.getConstantFP(0.0, DL, VT, false);
        }
    }
    if Flags.hasAllowReassociation() && Flags.hasNoSignedZeros() && AllowNewConst {
        if N1CFP && N0.getOpcode() == FADD && self.DAG.isConstantFPBuildVectorOrConstantFP(N0.getOperand(1)) {
            let mut NewC: SDValue = self.DAG.getNode(FADD, DL, VT, N0.getOperand(1), N1);
            return self.DAG.getNode(FADD, DL, VT, N0.getOperand(0), NewC);
        }
        if (!self.LegalOperations || self.TLI.isOperationLegalOrCustom(FMUL, VT, false)) && !N0CFP && !N1CFP {
            if N0.getOpcode() == FMUL {
                let mut CFP00: bool = self.DAG.isConstantFPBuildVectorOrConstantFP(N0.getOperand(0));
                let mut CFP01: bool = self.DAG.isConstantFPBuildVectorOrConstantFP(N0.getOperand(1));
                if CFP01 && !CFP00 && N0.getOperand(0) == N1 {
                    let mut NewCFP: SDValue = self.DAG.getNode(FADD, DL, VT, N0.getOperand(1), self.DAG.getConstantFP(1.0, DL, VT, false));
                    return self.DAG.getNode(FMUL, DL, VT, N1, NewCFP);
                }
                if CFP01 && !CFP00 && N1.getOpcode() == FADD && N1.getOperand(0) == N1.getOperand(1) && N0.getOperand(0) == N1.getOperand(0) {
                    let mut NewCFP: SDValue = self.DAG.getNode(FADD, DL, VT, N0.getOperand(1), self.DAG.getConstantFP(2.0, DL, VT, false));
                    return self.DAG.getNode(FMUL, DL, VT, N0.getOperand(0), NewCFP);
                }
            }
            if N1.getOpcode() == FMUL {
                let mut CFP10: bool = self.DAG.isConstantFPBuildVectorOrConstantFP(N1.getOperand(0));
                let mut CFP11: bool = self.DAG.isConstantFPBuildVectorOrConstantFP(N1.getOperand(1));
                if CFP11 && !CFP10 && N1.getOperand(0) == N0 {
                    let mut NewCFP: SDValue = self.DAG.getNode(FADD, DL, VT, N1.getOperand(1), self.DAG.getConstantFP(1.0, DL, VT, false));
                    return self.DAG.getNode(FMUL, DL, VT, N0, NewCFP);
                }
                if CFP11 && !CFP10 && N0.getOpcode() == FADD && N0.getOperand(0) == N0.getOperand(1) && N1.getOperand(0) == N0.getOperand(0) {
                    let mut NewCFP: SDValue = self.DAG.getNode(FADD, DL, VT, N1.getOperand(1), self.DAG.getConstantFP(2.0, DL, VT, false));
                    return self.DAG.getNode(FMUL, DL, VT, N1.getOperand(0), NewCFP);
                }
            }
            if N0.getOpcode() == FADD {
                let mut CFP00: bool = self.DAG.isConstantFPBuildVectorOrConstantFP(N0.getOperand(0));
                if !CFP00 && N0.getOperand(0) == N0.getOperand(1) && (N0.getOperand(0) == N1) {
                    return self.DAG.getNode(FMUL, DL, VT, N1, self.DAG.getConstantFP(3.0, DL, VT, false));
                }
            }
            if N1.getOpcode() == FADD {
                let mut CFP10: bool = self.DAG.isConstantFPBuildVectorOrConstantFP(N1.getOperand(0));
                if !CFP10 && N1.getOperand(0) == N1.getOperand(1) && N1.getOperand(0) == N0 {
                    return self.DAG.getNode(FMUL, DL, VT, N0, self.DAG.getConstantFP(3.0, DL, VT, false));
                }
            }
            if N0.getOpcode() == FADD && N1.getOpcode() == FADD && N0.getOperand(0) == N0.getOperand(1) && N1.getOperand(0) == N1.getOperand(1) && N0.getOperand(0) == N1.getOperand(0) {
                return self.DAG.getNode(FMUL, DL, VT, N0.getOperand(0), self.DAG.getConstantFP(4.0, DL, VT, false));
            }
        }
    }
    if Flags.hasAllowReassociation() && Flags.hasNoSignedZeros() {
        if self.reassociateReduction(VECREDUCE_FADD, FADD, DL, VT, N0, N1, Flags) {
            SD;
        } else {
            return SD;
        }
    }
    if self.visitFADDForFMACombine(N) {
        Fused;
    } else {
        if Fused.getOpcode() != DELETED_NODE {
            self.AddToWorklist(Fused.getNode(), true, false);
        }
        return Fused;
    }
    return SDValue {};
}

fn DAGCombiner::visitSTRICT_FADD(self, N: *mut SDNode) -> SDValue {
    let mut Chain: SDValue = N.getOperand(0);
    let mut N0: SDValue = N.getOperand(1);
    let mut N1: SDValue = N.getOperand(2);
    let mut VT: EVT = N.getValueType(0);
    let mut ChainVT: EVT = N.getValueType(1);
    let mut DL: SDLoc = SDLoc { N };
    let mut FlagsInserter: FlagInserter = FlagInserter { self.DAG, N };
    if !self.LegalOperations || self.TLI.isOperationLegalOrCustom(STRICT_FSUB, VT, false) {
        if self.TLI.getCheaperNegatedExpression(N1, self.DAG, self.LegalOperations, self.ForCodeSize, 0) {
            NegN1;
        } else {
            return self.DAG.getNode(STRICT_FSUB, DL, self.DAG.getVTList(VT, ChainVT), ArrayRef<SDValue> { [Chain, N0, NegN1] });
        }
    }
    if !self.LegalOperations || self.TLI.isOperationLegalOrCustom(STRICT_FSUB, VT, false) {
        if self.TLI.getCheaperNegatedExpression(N0, self.DAG, self.LegalOperations, self.ForCodeSize, 0) {
            NegN0;
        } else {
            return self.DAG.getNode(STRICT_FSUB, DL, self.DAG.getVTList(VT, ChainVT), ArrayRef<SDValue> { [Chain, N1, NegN0] });
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitFSUB(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut N0CFP: *mut ConstantFPSDNode = isConstOrConstSplatFP(N0, true);
    let mut N1CFP: *mut ConstantFPSDNode = isConstOrConstSplatFP(N1, true);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    let mut Flags: SDNodeFlags = N.getFlags();
    let mut FlagsInserter: FlagInserter = FlagInserter { self.DAG, N };
    if self.DAG.simplifyFPBinop(N.getOpcode(), N0, N1, Flags) {
        R;
    } else {
        return R;
    }
    if self.DAG.FoldConstantArithmetic(FSUB, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if VT.isVector() {
        if self.SimplifyVBinOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
    }
    if self.foldBinOpIntoSelect(N) {
        NewSel;
    } else {
        return NewSel;
    }
    if N1CFP && N1CFP.isZero() {
        if !N1CFP.isNegative() || self.DAG.canIgnoreSignBitOfZero(SDValue { Node: N, ResNo: 0 }) {
            return N0;
        }
    }
    if N0 == N1 {
        if Flags.hasNoNaNs() {
            return self.DAG.getConstantFP(0.0, DL, VT, false);
        }
    }
    if N0CFP && N0CFP.isZero() {
        if N0CFP.isNegative() || self.DAG.canIgnoreSignBitOfZero(SDValue { Node: N, ResNo: 0 }) {
            let mut DenormMode: DenormalMode = self.DAG.getDenormalMode(VT);
            if DenormMode == getIEEE() {
                if self.TLI.getNegatedExpression(N1, self.DAG, self.LegalOperations, self.ForCodeSize, 0) {
                    NegN1;
                } else {
                    return NegN1;
                }
                if !self.LegalOperations || self.TLI.isOperationLegal(FNEG, VT) {
                    return self.DAG.getNode(FNEG, DL, VT, N1);
                }
            }
        }
    }
    if Flags.hasAllowReassociation() && Flags.hasNoSignedZeros() && N1.getOpcode() == FADD {
        if N0 == operator(N1).getOperand(0) {
            return self.DAG.getNode(FNEG, DL, VT, operator(N1).getOperand(1));
        }
        if N0 == operator(N1).getOperand(1) {
            return self.DAG.getNode(FNEG, DL, VT, operator(N1).getOperand(0));
        }
    }
    if self.TLI.getNegatedExpression(N1, self.DAG, self.LegalOperations, self.ForCodeSize, 0) {
        NegN1;
    } else {
        return self.DAG.getNode(FADD, DL, VT, N0, NegN1);
    }
    if self.visitFSUBForFMACombine(N) {
        Fused;
    } else {
        self.AddToWorklist(Fused.getNode(), true, false);
        return Fused;
    }
    return SDValue {};
}

fn DAGCombiner::combineFMulOrFDivWithIntPow2(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if !isIEEELikeFP(VT.getFltSemantics()) {
        return SDValue {};
    }
    let mut ConstOp: SDValue = SDValue {};
    let mut Pow2Op: SDValue = SDValue {};
    let mut Mantissa: optional<int> = optional<int> {};
    let mut GetConstAndPow2Ops: Closure_74 = Closure_74 { N: &mut N, ConstOp: &mut ConstOp, Pow2Op: &mut Pow2Op, cap_3: self, Mantissa: &mut Mantissa };
    if !GetConstAndPow2Ops.call(0) && !GetConstAndPow2Ops.call(1) {
        return SDValue {};
    }
    if !self.TLI.optimizeFMulOrFDivAsShiftAddBitcast(N, ConstOp, Pow2Op) {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { N };
    let mut NewIntVT: EVT = VT.changeElementType(*self.DAG.getContext(), getIntegerVT(*self.DAG.getContext(), VT.getScalarSizeInBits()));
    let mut Log2: SDValue = self.BuildLogBase2(Pow2Op, DL, self.DAG.isKnownNeverZero(Pow2Op, 0), true, optional<EVT> { NewIntVT });
    if !Log2 {
        return SDValue {};
    }
    let mut MantissaShiftCnt: SDValue = self.DAG.getShiftAmountConstant(operator(Mantissa), NewIntVT, DL);
    let mut Shift: SDValue = self.DAG.getNode(SHL, DL, NewIntVT, Log2, MantissaShiftCnt);
    let mut ResAsInt: SDValue = self.DAG.getNode(if N.getOpcode() == FMUL { ADD } else { SUB }, DL, NewIntVT, self.DAG.getBitcast(NewIntVT, ConstOp), Shift);
    let mut ResAsFP: SDValue = self.DAG.getBitcast(VT, ResAsInt);
    return ResAsFP;
}

fn DAGCombiner::visitFMUL(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut N1CFP: *mut ConstantFPSDNode = isConstOrConstSplatFP(N1, true);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    let mut Flags: SDNodeFlags = N.getFlags();
    let mut FlagsInserter: FlagInserter = FlagInserter { self.DAG, N };
    if self.DAG.simplifyFPBinop(N.getOpcode(), N0, N1, Flags) {
        R;
    } else {
        return R;
    }
    if self.DAG.FoldConstantArithmetic(FMUL, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if self.DAG.isConstantFPBuildVectorOrConstantFP(N0) && !self.DAG.isConstantFPBuildVectorOrConstantFP(N1) {
        return self.DAG.getNode(FMUL, DL, VT, N1, N0);
    }
    if VT.isVector() {
        if self.SimplifyVBinOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
    }
    if self.foldBinOpIntoSelect(N) {
        NewSel;
    } else {
        return NewSel;
    }
    if Flags.hasAllowReassociation() {
        if self.DAG.isConstantFPBuildVectorOrConstantFP(N1) && N0.getOpcode() == FMUL {
            let mut N00: SDValue = N0.getOperand(0);
            let mut N01: SDValue = N0.getOperand(1);
            if self.DAG.isConstantFPBuildVectorOrConstantFP(N01) && !self.DAG.isConstantFPBuildVectorOrConstantFP(N00) {
                let mut MulConsts: SDValue = self.DAG.getNode(FMUL, DL, VT, N01, N1);
                return self.DAG.getNode(FMUL, DL, VT, N00, MulConsts);
            }
        }
        if N0.getOpcode() == FADD && N0.hasOneUse() && N0.getOperand(0) == N0.getOperand(1) {
            let mut Two: SDValue = self.DAG.getConstantFP(2.0, DL, VT, false);
            let mut MulConsts: SDValue = self.DAG.getNode(FMUL, DL, VT, Two, N1);
            return self.DAG.getNode(FMUL, DL, VT, N0.getOperand(0), MulConsts);
        }
        if self.reassociateReduction(VECREDUCE_FMUL, FMUL, DL, VT, N0, N1, Flags) {
            SD;
        } else {
            return SD;
        }
    }
    if N1CFP && N1CFP.isExactlyValue(2.0) {
        return self.DAG.getNode(FADD, DL, VT, N0, N0);
    }
    if N1CFP && N1CFP.isMinusOne() {
        if !self.LegalOperations || self.TLI.isOperationLegal(FSUB, VT) {
            return self.DAG.getNode(FSUB, DL, VT, self.DAG.getConstantFP(-0.0, DL, VT, false), N0, Flags);
        }
    }
    let mut CostN0: NegatibleCost = Expensive;
    let mut CostN1: NegatibleCost = Expensive;
    let mut NegN0: SDValue = self.TLI.getNegatedExpression(N0, self.DAG, self.LegalOperations, self.ForCodeSize, CostN0, 0);
    if NegN0 {
        let mut NegN0Handle: HandleSDNode = HandleSDNode { NegN0 };
        let mut NegN1: SDValue = self.TLI.getNegatedExpression(N1, self.DAG, self.LegalOperations, self.ForCodeSize, CostN1, 0);
        if NegN1 && (CostN0 == Cheaper || CostN1 == Cheaper) {
            return self.DAG.getNode(FMUL, DL, VT, NegN0, NegN1);
        }
    }
    if Flags.hasNoNaNs() && Flags.hasNoSignedZeros() && (N0.getOpcode() == SELECT || N1.getOpcode() == SELECT) && self.TLI.isOperationLegal(FABS, VT) {
        let mut Select: SDValue = N0;
        let mut X: SDValue = N1;
        if Select.getOpcode() != SELECT {
            swap(Select, X);
        }
        let mut Cond: SDValue = Select.getOperand(0);
        let mut TrueOpnd: CastReturnType = dyn_cast(Select.getOperand(1));
        let mut FalseOpnd: CastReturnType = dyn_cast(Select.getOperand(2));
        if TrueOpnd && FalseOpnd && Cond.getOpcode() == SETCC && Cond.getOperand(0) == X && isa(Cond.getOperand(1)) && cast(Cond.getOperand(1)).isPosZero() {
            let mut CC: CondCode = cast(Cond.getOperand(2)).get();
            match CC {
                _ => {
                    break;
                },
                SETOLT => {
                    SETULT;
                },
                SETOGT => {
                    SETUGT;
                },
            }
        }
    }
    if self.visitFMULForFMADistributiveCombine(N) {
        Fused;
    } else {
        self.AddToWorklist(Fused.getNode(), true, false);
        return Fused;
    }
    if self.combineFMulOrFDivWithIntPow2(N) {
        R;
    } else {
        return R;
    }
    return SDValue {};
}

fn DAGCombiner::visitFMA(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut N2: SDValue = N.getOperand(2);
    let mut N0CFP: *mut ConstantFPSDNode = dyn_cast(N0);
    let mut N1CFP: *mut ConstantFPSDNode = dyn_cast(N1);
    let mut N2CFP: *mut ConstantFPSDNode = dyn_cast(N2);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    let mut FlagsInserter: FlagInserter = FlagInserter { self.DAG, N };
    if self.DAG.FoldConstantArithmetic(N.getOpcode(), DL, VT, ArrayRef<SDValue> { [N0, N1, N2] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    let mut CostN0: NegatibleCost = Expensive;
    let mut CostN1: NegatibleCost = Expensive;
    let mut NegN0: SDValue = self.TLI.getNegatedExpression(N0, self.DAG, self.LegalOperations, self.ForCodeSize, CostN0, 0);
    if NegN0 {
        let mut NegN0Handle: HandleSDNode = HandleSDNode { NegN0 };
        let mut NegN1: SDValue = self.TLI.getNegatedExpression(N1, self.DAG, self.LegalOperations, self.ForCodeSize, CostN1, 0);
        if NegN1 && (CostN0 == Cheaper || CostN1 == Cheaper) {
            return self.DAG.getNode(FMA, DL, VT, NegN0, NegN1, N2);
        }
    }
    if N.getFlags().hasNoNaNs() && N.getFlags().hasNoInfs() {
        if N.getFlags().hasNoSignedZeros() || (N2CFP && !N2CFP.isNegZero()) {
            if N0CFP && N0CFP.isZero() {
                return N2;
            }
            if N1CFP && N1CFP.isZero() {
                return N2;
            }
        }
    }
    if N0CFP && N0CFP.isOne() {
        return self.DAG.getNode(FADD, DL, VT, N1, N2);
    }
    if N1CFP && N1CFP.isOne() {
        return self.DAG.getNode(FADD, DL, VT, N0, N2);
    }
    if self.DAG.isConstantFPBuildVectorOrConstantFP(N0) && !self.DAG.isConstantFPBuildVectorOrConstantFP(N1) {
        return self.DAG.getNode(FMA, DL, VT, N1, N0, N2);
    }
    let mut CanReassociate: bool = N.getFlags().hasAllowReassociation();
    if CanReassociate {
        if N2.getOpcode() == FMUL && N0 == N2.getOperand(0) && self.DAG.isConstantFPBuildVectorOrConstantFP(N1) && self.DAG.isConstantFPBuildVectorOrConstantFP(N2.getOperand(1)) {
            return self.DAG.getNode(FMUL, DL, VT, N0, self.DAG.getNode(FADD, DL, VT, N1, N2.getOperand(1)));
        }
        if N0.getOpcode() == FMUL && self.DAG.isConstantFPBuildVectorOrConstantFP(N1) && self.DAG.isConstantFPBuildVectorOrConstantFP(N0.getOperand(1)) {
            return self.DAG.getNode(FMA, DL, VT, N0.getOperand(0), self.DAG.getNode(FMUL, DL, VT, N1, N0.getOperand(1)), N2);
        }
    }
    if N1CFP {
        if N1CFP.isOne() {
            return self.DAG.getNode(FADD, DL, VT, N0, N2);
        }
        if N1CFP.isMinusOne() && (!self.LegalOperations || self.TLI.isOperationLegal(FNEG, VT)) {
            let mut RHSNeg: SDValue = self.DAG.getNode(FNEG, DL, VT, N0);
            self.AddToWorklist(RHSNeg.getNode(), true, false);
            return self.DAG.getNode(FADD, DL, VT, N2, RHSNeg);
        }
        if N0.getOpcode() == FNEG && (self.TLI.isOperationLegal(ConstantFP, VT) || (N1.hasOneUse() && !self.TLI.isFPImmLegal(N1CFP.getValueAPF(), VT, self.ForCodeSize))) {
            return self.DAG.getNode(FMA, DL, VT, N0.getOperand(0), self.DAG.getNode(FNEG, DL, VT, N1), N2);
        }
    }
    if CanReassociate {
        if N1CFP && N0 == N2 {
            return self.DAG.getNode(FMUL, DL, VT, N0, self.DAG.getNode(FADD, DL, VT, N1, self.DAG.getConstantFP(1.0, DL, VT, false)));
        }
        if N1CFP && N2.getOpcode() == FNEG && N2.getOperand(0) == N0 {
            return self.DAG.getNode(FMUL, DL, VT, N0, self.DAG.getNode(FADD, DL, VT, N1, self.DAG.getConstantFP(-1.0, DL, VT, false)));
        }
    }
    if !self.TLI.isFNegFree(VT) {
        if self.TLI.getCheaperNegatedExpression(SDValue { Node: N, ResNo: 0 }, self.DAG, self.LegalOperations, self.ForCodeSize, 0) {
            Neg;
        } else {
            return self.DAG.getNode(FNEG, DL, VT, Neg);
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitFMAD(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut N2: SDValue = N.getOperand(2);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(FMAD, DL, VT, ArrayRef<SDValue> { [N0, N1, N2] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    return SDValue {};
}

fn DAGCombiner::visitFMULADD(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut N2: SDValue = N.getOperand(2);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(FMULADD, DL, VT, ArrayRef<SDValue> { [N0, N1, N2] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    return SDValue {};
}

fn DAGCombiner::combineRepeatedFPDivisors(self, N: *mut SDNode) -> SDValue {
    let mut Flags: SDNodeFlags = N.getFlags();
    if self.LegalDAG || !Flags.hasAllowReciprocal() {
        return SDValue {};
    }
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut N0CFP: *mut ConstantFPSDNode = isConstOrConstSplatFP(N0, true);
    if N0CFP && (N0CFP.isOne() || N0CFP.isMinusOne()) {
        return SDValue {};
    }
    let mut MinUses: u32 = self.TLI.combineRepeatedFPDivisors();
    let mut NumElts: u32 = 1;
    let mut VT: EVT = N.getValueType(0);
    if VT.isVector() && self.DAG.isSplatValue(N1, false) {
        NumElts = VT.getVectorMinNumElements();
    }
    if !MinUses || (operator(N1).use_size() * NumElts) < MinUses {
        return SDValue {};
    }
    let mut Users: SetVector<SDNode *> = SetVector<SDNode *> {};
    for U in operator(N1).users() {
        if U.getOpcode() == FDIV && U.getOperand(1) == N1 {
            if U.getOperand(1).getOpcode() == FSQRT && U.getOperand(0) == U.getOperand(1).getOperand(0) && U.getFlags().hasAllowReassociation() && U.getFlags().hasNoSignedZeros() {
                continue;
            }
            if U.getFlags().hasAllowReciprocal() {
                Users.insert(U);
            }
        }
    }
    if (Users.len * NumElts) < MinUses {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { N };
    let mut FPOne: SDValue = self.DAG.getConstantFP(1.0, DL, VT, false);
    let mut Reciprocal: SDValue = self.DAG.getNode(FDIV, DL, VT, FPOne, N1, Flags);
    for U in Users {
        let mut Dividend: SDValue = U.getOperand(0);
        if Dividend != FPOne {
            let mut NewNode: SDValue = self.DAG.getNode(FMUL, SDLoc { U }, VT, Dividend, Reciprocal, Flags);
            self.CombineTo(U, NewNode, true);
        } else if U != Reciprocal.getNode() {
            self.CombineTo(U, Reciprocal, true);
        }
    }
    return SDValue { Node: N, ResNo: 0 };
}

fn DAGCombiner::visitFDIV(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    let mut Flags: SDNodeFlags = N.getFlags();
    let mut FlagsInserter: FlagInserter = FlagInserter { self.DAG, N };
    if self.DAG.simplifyFPBinop(N.getOpcode(), N0, N1, Flags) {
        R;
    } else {
        return R;
    }
    if self.DAG.FoldConstantArithmetic(FDIV, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if VT.isVector() {
        if self.SimplifyVBinOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
    }
    if self.foldBinOpIntoSelect(N) {
        NewSel;
    } else {
        return NewSel;
    }
    if self.combineRepeatedFPDivisors(N) {
        V;
    } else {
        return V;
    }
    if isConstOrConstSplatFP(N1, true) {
        N1CFP;
    } else {
        let mut N1APF: *APFloat = N1CFP.getValueAPF();
        let mut Recip: APFloat = getOne(N1APF.getSemantics(), false);
        let mut st: opStatus = Recip.divide(N1APF, rmNearestTiesToEven);
        if ((st == opOK && !Recip.isDenormal()) || (st == opInexact && Flags.hasAllowReciprocal())) && (!self.LegalOperations || self.TLI.isOperationLegal(ConstantFP, VT) || self.TLI.isFPImmLegal(Recip, VT, self.ForCodeSize)) {
            return self.DAG.getNode(FMUL, DL, VT, N0, self.DAG.getConstantFP(Recip, DL, VT, false));
        }
    }
    if Flags.hasAllowReciprocal() {
        let mut N1AllowReciprocal: bool = operator(N1).getFlags().hasAllowReciprocal();
        if N1.getOpcode() == FSQRT {
            if self.buildRsqrtEstimate(N1.getOperand(0), operator(N1).getFlags()) {
                RV;
            } else {
                return self.DAG.getNode(FMUL, DL, VT, N0, RV);
            }
        } else if N1.getOpcode() == FP_EXTEND && N1.getOperand(0).getOpcode() == FSQRT && N1AllowReciprocal {
            if self.buildRsqrtEstimate(N1.getOperand(0).getOperand(0), operator(N1.getOperand(0)).getFlags()) {
                RV;
            } else {
                RV = self.DAG.getNode(FP_EXTEND, SDLoc { N1 }, VT, RV);
                self.AddToWorklist(RV.getNode(), true, false);
                return self.DAG.getNode(FMUL, DL, VT, N0, RV);
            }
        } else if N1.getOpcode() == FP_ROUND && N1.getOperand(0).getOpcode() == FSQRT {
            if self.buildRsqrtEstimate(N1.getOperand(0).getOperand(0), operator(N1.getOperand(0)).getFlags()) {
                RV;
            } else {
                RV = self.DAG.getNode(FP_ROUND, SDLoc { N1 }, VT, RV, N1.getOperand(1));
                self.AddToWorklist(RV.getNode(), true, false);
                return self.DAG.getNode(FMUL, DL, VT, N0, RV);
            }
        } else if N1.getOpcode() == FMUL {
            let mut Sqrt: SDValue = SDValue {};
            let mut Y: SDValue = SDValue {};
            if N1.getOperand(0).getOpcode() == FSQRT {
                Sqrt = N1.getOperand(0);
                Y = N1.getOperand(1);
            } else if N1.getOperand(1).getOpcode() == FSQRT {
                Sqrt = N1.getOperand(1);
                Y = N1.getOperand(0);
            }
            if Sqrt.getNode() {
                if Flags.hasAllowReassociation() && N1.hasOneUse() && operator(N1).getFlags().hasAllowReassociation() && Sqrt.hasOneUse() {
                    let mut A: SDValue = SDValue {};
                    if Y.getOpcode() == FABS && Y.hasOneUse() {
                        A = Y.getOperand(0);
                    } else if Y == Sqrt.getOperand(0) {
                        A = Y;
                    }
                    if A {
                        let mut AA: SDValue = self.DAG.getNode(FMUL, DL, VT, A, A);
                        let mut AAZ: SDValue = self.DAG.getNode(FMUL, DL, VT, AA, Sqrt.getOperand(0));
                        if self.buildRsqrtEstimate(AAZ, operator(Sqrt).getFlags()) {
                            Rsqrt;
                        } else {
                            return self.DAG.getNode(FMUL, DL, VT, N0, Rsqrt);
                        }
                        self.recursivelyDeleteUnusedNodes(AAZ.getNode());
                    }
                }
                if self.buildRsqrtEstimate(Sqrt.getOperand(0), operator(Sqrt).getFlags()) {
                    Rsqrt;
                } else {
                    let mut Div: SDValue = self.DAG.getNode(FDIV, SDLoc { N1 }, VT, Rsqrt, Y);
                    self.AddToWorklist(Div.getNode(), true, false);
                    return self.DAG.getNode(FMUL, DL, VT, N0, Div);
                }
            }
        }
        if Flags.hasNoInfs() {
            if self.BuildDivEstimate(N0, N1, Flags) {
                RV;
            } else {
                return RV;
            }
        }
    }
    if self.DAG.canIgnoreSignBitOfZero(SDValue { Node: N, ResNo: 0 }) && Flags.hasAllowReassociation() {
        if N1.getOpcode() == FSQRT && N0 == N1.getOperand(0) {
            return N1;
        }
    }
    let mut CostN0: NegatibleCost = Expensive;
    let mut CostN1: NegatibleCost = Expensive;
    let mut NegN0: SDValue = self.TLI.getNegatedExpression(N0, self.DAG, self.LegalOperations, self.ForCodeSize, CostN0, 0);
    if NegN0 {
        let mut NegN0Handle: HandleSDNode = HandleSDNode { NegN0 };
        let mut NegN1: SDValue = self.TLI.getNegatedExpression(N1, self.DAG, self.LegalOperations, self.ForCodeSize, CostN1, 0);
        if NegN1 && (CostN0 == Cheaper || CostN1 == Cheaper) {
            return self.DAG.getNode(FDIV, DL, VT, NegN0, NegN1);
        }
    }
    if self.combineFMulOrFDivWithIntPow2(N) {
        R;
    } else {
        return R;
    }
    return SDValue {};
}

fn DAGCombiner::visitFREM(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut Flags: SDNodeFlags = N.getFlags();
    let mut FlagsInserter: FlagInserter = FlagInserter { self.DAG, N };
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.simplifyFPBinop(N.getOpcode(), N0, N1, Flags) {
        R;
    } else {
        return R;
    }
    if self.DAG.FoldConstantArithmetic(FREM, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if self.foldBinOpIntoSelect(N) {
        NewSel;
    } else {
        return NewSel;
    }
    if !self.TLI.isOperationLegal(FREM, VT) && self.TLI.isOperationLegalOrCustom(FMUL, VT, false) && self.TLI.isOperationLegalOrCustom(FDIV, VT, false) && self.TLI.isOperationLegalOrCustom(FTRUNC, VT, false) && self.DAG.isKnownToBeAPowerOfTwoFP(N1, 0) {
        let mut NeedsCopySign: bool = !self.DAG.canIgnoreSignBitOfZero(SDValue { Node: N, ResNo: 0 }) && !self.DAG.cannotBeOrderedNegativeFP(N0);
        let mut Div: SDValue = self.DAG.getNode(FDIV, DL, VT, N0, N1);
        let mut Rnd: SDValue = self.DAG.getNode(FTRUNC, DL, VT, Div);
        let mut MLA: SDValue = SDValue {};
        if self.TLI.isFMAFasterThanFMulAndFAdd(self.DAG.getMachineFunction(), VT) {
            MLA = self.DAG.getNode(FMA, DL, VT, self.DAG.getNode(FNEG, DL, VT, Rnd), N1, N0);
        } else {
            let mut Mul: SDValue = self.DAG.getNode(FMUL, DL, VT, Rnd, N1);
            MLA = self.DAG.getNode(FSUB, DL, VT, N0, Mul);
        }
        return if NeedsCopySign { self.DAG.getNode(FCOPYSIGN, DL, VT, MLA, N0) } else { MLA };
    }
    return SDValue {};
}

fn DAGCombiner::visitFSQRT(self, N: *mut SDNode) -> SDValue {
    let mut Flags: SDNodeFlags = N.getFlags();
    if !Flags.hasApproximateFuncs() || !Flags.hasNoInfs() {
        return SDValue {};
    }
    let mut N0: SDValue = N.getOperand(0);
    if self.TLI.isFsqrtCheap(N0, self.DAG) {
        return SDValue {};
    }
    let mut FlagInserter: FlagInserter = FlagInserter { self.DAG, Flags };
    return self.buildSqrtEstimate(N0, Flags);
}

fn CanCombineFCOPYSIGN_EXTEND_ROUND(XTy: EVT, YTy: EVT) -> bool {
    if XTy == YTy {
        return true;
    }
    if YTy == EVT { f128 } {
        return false;
    }
    return !YTy.isVector();
}

fn CanCombineFCOPYSIGN_EXTEND_ROUND(N: *mut SDNode) -> bool {
    let mut N1: SDValue = N.getOperand(1);
    if N1.getOpcode() != FP_EXTEND && N1.getOpcode() != FP_ROUND {
        return false;
    }
    let mut N1VT: EVT = operator(N1).getValueType(0);
    let mut N1Op0VT: EVT = operator(N1).getOperand(0).getValueType();
    return CanCombineFCOPYSIGN_EXTEND_ROUND(N1VT, N1Op0VT);
}

fn DAGCombiner::visitFCOPYSIGN(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(FCOPYSIGN, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if CanCombineFCOPYSIGN_EXTEND_ROUND(N) {
        return self.DAG.getNode(FCOPYSIGN, DL, VT, N0, N1.getOperand(0));
    }
    if self.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if VT != N1.getValueType() {
        return SDValue {};
    }
    if self.DAG.SignBitIsZeroFP(N0, 0) && self.DAG.computeKnownBits(N1, 0).Zero.isMaxSignedValue() {
        let mut IntVT: EVT = VT.changeTypeToInteger();
        let mut CastSrc0: SDValue = self.DAG.getNode(BITCAST, DL, IntVT, N0);
        let mut CastSrc1: SDValue = self.DAG.getNode(BITCAST, DL, IntVT, N1);
        let mut SignOr: SDValue = self.DAG.getNode(OR, DL, IntVT, CastSrc0, CastSrc1, SDNodeFlags { Flags: Disjoint });
        return self.DAG.getNode(BITCAST, DL, VT, SignOr);
    }
    return SDValue {};
}

fn DAGCombiner::visitFPOW(self, N: *mut SDNode) -> SDValue {
    let mut ExponentC: *mut ConstantFPSDNode = isConstOrConstSplatFP(N.getOperand(1), false);
    if !ExponentC {
        return SDValue {};
    }
    let mut FlagsInserter: FlagInserter = FlagInserter { self.DAG, N };
    let mut VT: EVT = N.getValueType(0);
    let mut ScalarVT: EVT = VT.getScalarType();
    if (ScalarVT == EVT { f32 } && ExponentC.getValueAPF().isExactlyValue(1.0 / 3.0)) || (ScalarVT == EVT { f64 } && ExponentC.getValueAPF().isExactlyValue(1.0 / 3.0)) {
        let mut Flags: SDNodeFlags = N.getFlags();
        if !Flags.hasNoSignedZeros() || !Flags.hasNoInfs() || !Flags.hasNoNaNs() || !Flags.hasApproximateFuncs() {
            return SDValue {};
        }
        let mut LC: Libcall = getCBRT(VT);
        let mut HasLibCall: bool = self.DAG.getLibcalls().getLibcallImpl(LC) != Unsupported;
        if !HasLibCall || (!self.DAG.getTargetLoweringInfo().isOperationExpand(FPOW, VT) && self.DAG.getTargetLoweringInfo().isOperationExpand(FCBRT, VT)) {
            return SDValue {};
        }
        return self.DAG.getNode(FCBRT, SDLoc { N }, VT, N.getOperand(0));
    }
    let mut ExponentIs025: bool = ExponentC.getValueAPF().isExactlyValue(0.25);
    let mut ExponentIs075: bool = ExponentC.getValueAPF().isExactlyValue(0.75);
    if ExponentIs025 || ExponentIs075 {
        let mut Flags: SDNodeFlags = N.getFlags();
        if (!Flags.hasNoSignedZeros() && ExponentIs025) || !Flags.hasNoInfs() || !Flags.hasApproximateFuncs() {
            return SDValue {};
        }
        if !self.DAG.getTargetLoweringInfo().isOperationLegalOrCustom(FSQRT, VT, false) {
            return SDValue {};
        }
        if self.ForCodeSize {
            return SDValue {};
        }
        let mut DL: SDLoc = SDLoc { N };
        let mut Sqrt: SDValue = self.DAG.getNode(FSQRT, DL, VT, N.getOperand(0));
        let mut SqrtSqrt: SDValue = self.DAG.getNode(FSQRT, DL, VT, Sqrt);
        if ExponentIs025 {
            return SqrtSqrt;
        }
        return self.DAG.getNode(FMUL, DL, VT, Sqrt, SqrtSqrt);
    }
    return SDValue {};
}

fn foldFPToIntToFP(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG, TLI: *TargetLowering) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if !TLI.isOperationLegalOrCustom(FTRUNC, VT, false) {
        return SDValue {};
    }
    let mut IsUnsigned: bool = N.getOpcode() == UINT_TO_FP;
    let mut IsSigned: bool = N.getOpcode() == SINT_TO_FP;
    assert!(IsSigned || IsUnsigned);
    let mut IntVT: EVT = N.getOperand(0).getValueType();
    let mut LegalIntVT: EVT = TLI.getTypeToTransformTo(*DAG.getContext(), IntVT);
    let mut FPToIntOp: u32 = if IsUnsigned { FP_TO_UINT } else { FP_TO_SINT };
    let mut IntToFPOp: u32 = N.getOpcode();
    if !TLI.isOperationLegal(FTRUNC, VT) && TLI.isOperationLegal(FPToIntOp, LegalIntVT) && TLI.isOperationLegal(IntToFPOp, VT) {
        return SDValue {};
    }
    let mut IsSignedZeroSafe: bool = DAG.canIgnoreSignBitOfZero(SDValue { Node: N, ResNo: 0 });
    if IsSigned && !IsSignedZeroSafe {
        return SDValue {};
    }
    if IsUnsigned && !IsSignedZeroSafe && !TLI.isFAbsFree(VT) {
        return SDValue {};
    }
    let mut MaxClamps: u32 = 2;
    let mut Clamps: SmallVector<ClampInfo, MaxClamps> = SmallVector<ClampInfo, MaxClamps> {};
    let mut MinOp: u32 = if IsUnsigned { UMIN } else { SMIN };
    let mut MaxOp: u32 = if IsUnsigned { UMAX } else { SMAX };
    let mut IntVal: SDValue = N.getOperand(0);
    for let mut Level: u32 = 0; Level < MaxClamps; Level += 1 {
        if !IntVal.hasOneUse() || (IntVal.getOpcode() != MinOp && IntVal.getOpcode() != MaxOp) {
            break;
        }
        let mut RHS: SDValue = IntVal.getOperand(1);
        let mut IntConst: APInt = APInt {};
        if dyn_cast(RHS) {
            IntConstNode;
        } else {
            IntConst = IntConstNode.getAPIntValue();
        }
        let mut FPConst: APFloat = APFloat { U: VT.getFltSemantics() };
        FPConst.convertFromAPInt(IntConst, IsSigned, rmNearestTiesToEven);
        let mut RoundTrip: APSInt = APSInt { IntConst.getBitWidth(), IsUnsigned };
        let mut IsExact: bool = false;
        if FPConst.convertToInteger(RoundTrip, rmTowardZero, &mut IsExact) != opOK || !IsExact || RoundTrip as APInt != IntConst {
            return SDValue {};
        }
        let mut IsMin: bool = IntVal.getOpcode() == MinOp;
        Clamps.push(ClampInfo { IsMin, DAG.getConstantFP(FPConst, DL, VT, false) });
        IntVal = IntVal.getOperand(0);
    }
    if IntVal.getOpcode() != FPToIntOp || IntVal.getOperand(0).getValueType() != VT {
        return SDValue {};
    }
    let mut Result: SDValue = IntVal.getOperand(0);
    if IsUnsigned && !IsSignedZeroSafe && TLI.isFAbsFree(VT) {
        Result = DAG.getNode(FABS, DL, VT, Result);
    }
    Result = DAG.getNode(FTRUNC, DL, VT, Result);
    for Clamp in reverse(Clamps) {
        let mut FPClampOp: u32 = getMinMaxOpcodeForClamp(Clamp.IsMin, Result, Clamp.Constant, DAG, TLI);
        if FPClampOp == DELETED_NODE {
            return SDValue {};
        }
        Result = DAG.getNode(FPClampOp, DL, VT, Result, Clamp.Constant);
    }
    return Result;
}

fn DAGCombiner::visitSINT_TO_FP(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut OpVT: EVT = N0.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    if N0.isUndef() {
        return self.DAG.getConstantFP(0.0, DL, VT, false);
    }
    if (!self.LegalOperations || self.TLI.isOperationLegalOrCustom(ConstantFP, VT, false)) {
        if self.DAG.FoldConstantArithmetic(SINT_TO_FP, DL, VT, ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None }) {
            C;
        } else {
            return C;
        }
    }
    if !self.hasOperation(SINT_TO_FP, OpVT) && self.hasOperation(UINT_TO_FP, OpVT) {
        if self.DAG.SignBitIsZero(N0, 0) {
            return self.DAG.getNode(UINT_TO_FP, DL, VT, N0);
        }
    }
    if N0.getOpcode() == SETCC && N0.getValueType() == EVT { i1 } && !VT.isVector() && (!self.LegalOperations || self.TLI.isOperationLegalOrCustom(ConstantFP, VT, false)) {
        return self.DAG.getSelect(DL, VT, N0, self.DAG.getConstantFP(-1.0, DL, VT, false), self.DAG.getConstantFP(0.0, DL, VT, false), SDNodeFlags { Flags: None });
    }
    if N0.getOpcode() == ZERO_EXTEND && N0.getOperand(0).getOpcode() == SETCC && !VT.isVector() && (!self.LegalOperations || self.TLI.isOperationLegalOrCustom(ConstantFP, VT, false)) {
        return self.DAG.getSelect(DL, VT, N0.getOperand(0), self.DAG.getConstantFP(1.0, DL, VT, false), self.DAG.getConstantFP(0.0, DL, VT, false), SDNodeFlags { Flags: None });
    }
    if foldFPToIntToFP(N, DL, self.DAG, self.TLI) {
        FTrunc;
    } else {
        return FTrunc;
    }
    if N0.getOpcode() == TRUNCATE && operator(N0).getFlags().hasNoSignedWrap() && self.TLI.isTypeDesirableForOp(SINT_TO_FP, N0.getOperand(0).getValueType()) {
        return self.DAG.getNode(SINT_TO_FP, DL, VT, N0.getOperand(0));
    }
    return SDValue {};
}

fn DAGCombiner::visitUINT_TO_FP(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut OpVT: EVT = N0.getValueType();
    let mut DL: SDLoc = SDLoc { N };
    if N0.isUndef() {
        return self.DAG.getConstantFP(0.0, DL, VT, false);
    }
    if (!self.LegalOperations || self.TLI.isOperationLegalOrCustom(ConstantFP, VT, false)) {
        if self.DAG.FoldConstantArithmetic(UINT_TO_FP, DL, VT, ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None }) {
            C;
        } else {
            return C;
        }
    }
    if !self.hasOperation(UINT_TO_FP, OpVT) && self.hasOperation(SINT_TO_FP, OpVT) {
        if self.DAG.SignBitIsZero(N0, 0) {
            return self.DAG.getNode(SINT_TO_FP, DL, VT, N0);
        }
    }
    if N0.getOpcode() == SETCC && !VT.isVector() && (!self.LegalOperations || self.TLI.isOperationLegalOrCustom(ConstantFP, VT, false)) {
        return self.DAG.getSelect(DL, VT, N0, self.DAG.getConstantFP(1.0, DL, VT, false), self.DAG.getConstantFP(0.0, DL, VT, false), SDNodeFlags { Flags: None });
    }
    if foldFPToIntToFP(N, DL, self.DAG, self.TLI) {
        FTrunc;
    } else {
        return FTrunc;
    }
    if N0.getOpcode() == TRUNCATE && operator(N0).getFlags().hasNoUnsignedWrap() && self.TLI.isTypeDesirableForOp(UINT_TO_FP, N0.getOperand(0).getValueType()) {
        return self.DAG.getNode(UINT_TO_FP, DL, VT, N0.getOperand(0));
    }
    return SDValue {};
}

fn FoldIntToFPToInt(N: *mut SDNode, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    if N0.getOpcode() != UINT_TO_FP && N0.getOpcode() != SINT_TO_FP {
        return SDValue {};
    }
    let mut Src: SDValue = N0.getOperand(0);
    let mut SrcVT: EVT = Src.getValueType();
    let mut IsInputSigned: bool = N0.getOpcode() == SINT_TO_FP;
    let mut IsOutputSigned: bool = N.getOpcode() == FP_TO_SINT;
    let mut InputSize: u32 = SrcVT.getScalarSizeInBits() as i32 - IsInputSigned;
    let mut OutputSize: u32 = VT.getScalarSizeInBits() as i32;
    let mut ActualSize: u32 = if InputSize < OutputSize { InputSize } else { OutputSize };
    let mut Sem: *fltSemantics = N0.getValueType().getFltSemantics();
    if semanticsPrecision(Sem) >= ActualSize {
        if VT.getScalarSizeInBits() > SrcVT.getScalarSizeInBits() {
            let mut ExtOp: u32 = if IsInputSigned && IsOutputSigned { SIGN_EXTEND } else { ZERO_EXTEND };
            return DAG.getNode(ExtOp, DL, VT, Src);
        }
        if VT.getScalarSizeInBits() < SrcVT.getScalarSizeInBits() {
            return DAG.getNode(TRUNCATE, DL, VT, Src);
        }
        return DAG.getBitcast(VT, Src);
    }
    return SDValue {};
}

fn DAGCombiner::visitFP_TO_SINT(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if propagateUnaryUndef(self.DAG, N0, VT) {
        R;
    } else {
        return R;
    }
    if self.DAG.FoldConstantArithmetic(FP_TO_SINT, DL, VT, ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    return FoldIntToFPToInt(N, DL, self.DAG);
}

fn DAGCombiner::visitFP_TO_UINT(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if propagateUnaryUndef(self.DAG, N0, VT) {
        R;
    } else {
        return R;
    }
    if self.DAG.FoldConstantArithmetic(FP_TO_UINT, DL, VT, ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    return FoldIntToFPToInt(N, DL, self.DAG);
}

fn DAGCombiner::visitXROUND(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    if propagateUnaryUndef(self.DAG, N0, VT) {
        R;
    } else {
        return R;
    }
    if self.DAG.FoldConstantArithmetic(N.getOpcode(), SDLoc { N }, VT, ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    return SDValue {};
}

fn DAGCombiner::visitFP_ROUND(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(FP_ROUND, DL, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if N0.getOpcode() == FP_EXTEND && VT == N0.getOperand(0).getValueType() {
        return N0.getOperand(0);
    }
    if N0.getOpcode() == FP_ROUND {
        let mut NIsTrunc: bool = N.getConstantOperandVal(1) == 1;
        let mut N0IsTrunc: bool = N0.getConstantOperandVal(1) == 1;
        if !self.hasOperation(FP_ROUND, VT) {
            return SDValue {};
        }
        if N0.getOperand(0).getValueType() == EVT { f80 } && VT == EVT { f16 } {
            return SDValue {};
        }
        if (N.getFlags().hasAllowContract() && operator(N0).getFlags().hasAllowContract()) || N0IsTrunc {
            return self.DAG.getNode(FP_ROUND, DL, VT, N0.getOperand(0), self.DAG.getIntPtrConstant(NIsTrunc && N0IsTrunc, DL, true));
        }
    }
    if N0.getOpcode() == FCOPYSIGN && operator(N0).hasOneUse() && CanCombineFCOPYSIGN_EXTEND_ROUND(VT, N0.getValueType()) {
        let mut Tmp: SDValue = self.DAG.getNode(FP_ROUND, SDLoc { N0 }, VT, N0.getOperand(0), N1);
        self.AddToWorklist(Tmp.getNode(), true, false);
        return self.DAG.getNode(FCOPYSIGN, DL, VT, Tmp, N0.getOperand(1));
    }
    if self.matchVSelectOpSizesWithSetCC(N) {
        NewVSel;
    } else {
        return NewVSel;
    }
    return SDValue {};
}

fn eliminateFPCastPair(N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut NarrowingOp: u32 = 0;
    match N.getOpcode() {
        FP16_TO_FP => {
            NarrowingOp = FP_TO_FP16;
        },
        BF16_TO_FP => {
            NarrowingOp = FP_TO_BF16;
        },
        FP_EXTEND => {
            NarrowingOp = FP_ROUND;
        },
        _ => {
            llvm_unreachable_internal("Expected widening FP cast", "llvm\\lib\\CodeGen\\SelectionDAG\\DAGCombiner.cpp", 20932);
        },
    }
    if N0.getOpcode() == NarrowingOp && N0.getOperand(0).getValueType() == VT {
        let mut NarrowFlags: SDNodeFlags = operator(N0).getFlags();
        let mut WidenFlags: SDNodeFlags = N.getFlags();
        if WidenFlags.hasNoNaNs() && WidenFlags.hasNoInfs() && NarrowFlags.hasAllowContract() && WidenFlags.hasAllowContract() {
            return N0.getOperand(0);
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitFP_EXTEND(self, N: *mut SDNode) -> SDValue {
    let mut FlagsInserter: FlagInserter = FlagInserter { self.DAG, N };
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if VT.isVector() {
        if self.SimplifyVCastOp(N, DL) {
            FoldedVOp;
        } else {
            return FoldedVOp;
        }
    }
    if N.hasOneUse() && operator(N.user_begin()).getOpcode() == FP_ROUND {
        return SDValue {};
    }
    if self.DAG.FoldConstantArithmetic(FP_EXTEND, DL, VT, ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if N0.getOpcode() == FP16_TO_FP && self.TLI.getOperationAction(FP16_TO_FP, VT) == Legal {
        return self.DAG.getNode(FP16_TO_FP, DL, VT, N0.getOperand(0));
    }
    if N0.getOpcode() == FP_ROUND && N0.getConstantOperandVal(1) == 1 {
        let mut In: SDValue = N0.getOperand(0);
        if In.getValueType() == VT {
            return In;
        }
        if VT.bitsLT(In.getValueType()) {
            return self.DAG.getNode(FP_ROUND, DL, VT, In, N0.getOperand(1));
        }
        return self.DAG.getNode(FP_EXTEND, DL, VT, In);
    }
    if isNormalLoad(N0.getNode()) && N0.hasOneUse() {
        let mut LN0: *mut LoadSDNode = cast(N0);
        if self.TLI.isLoadLegalOrCustom(VT, N0.getValueType(), LN0.getAlign(), LN0.getAddressSpace(), EXTLOAD, false) {
            let mut ExtLoad: SDValue = self.DAG.getExtLoad(EXTLOAD, DL, VT, LN0.getChain(), LN0.getBasePtr(), N0.getValueType(), LN0.getMemOperand());
            self.CombineTo(N, ExtLoad, true);
            self.CombineTo(N0.getNode(), self.DAG.getNode(FP_ROUND, SDLoc { N0 }, N0.getValueType(), ExtLoad, self.DAG.getIntPtrConstant(1, SDLoc { N0 }, true)), ExtLoad.getValue(1), true);
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    if self.matchVSelectOpSizesWithSetCC(N) {
        NewVSel;
    } else {
        return NewVSel;
    }
    if eliminateFPCastPair(N) {
        CastEliminated;
    } else {
        return CastEliminated;
    }
    return SDValue {};
}

fn DAGCombiner::visitFCEIL(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    if self.DAG.FoldConstantArithmetic(FCEIL, SDLoc { N }, VT, ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    return SDValue {};
}

fn DAGCombiner::visitFTRUNC(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    if self.DAG.FoldConstantArithmetic(FTRUNC, SDLoc { N }, VT, ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    match N0.getOpcode() {
        _ => {
            break;
        },
        FRINT => {
            FTRUNC;
        },
    }
    return SDValue {};
}

fn DAGCombiner::visitFFREXP(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    if self.DAG.isConstantFPBuildVectorOrConstantFP(N0) {
        return self.DAG.getNode(FFREXP, SDLoc { N }, N.getVTList(), N0);
    }
    return SDValue {};
}

fn DAGCombiner::visitFFLOOR(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    if self.DAG.FoldConstantArithmetic(FFLOOR, SDLoc { N }, VT, ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
