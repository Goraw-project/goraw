        if !IsVariadic {
            NewExpr = appendExt(OldExpr, NewBits, OldBits, IsSigned);
        } else {
            let mut ExtOps: ExtOps = getExtOps(NewBits, OldBits, IsSigned);
            NewExpr = convertToVariadicExpression(OldExpr);
            for ArgNo in AffectedArgs {
