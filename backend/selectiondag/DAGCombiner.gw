                return SDValue {};
            }
        }
        let mut ClearSVT: EVT = getIntegerVT(*self.DAG.getContext(), NumSubBits);
        let mut ClearVT: EVT = getVectorVT(*self.DAG.getContext(), ClearSVT, NumSubElts, false);
        if !self.TLI.isVectorClearMaskLegal(ArrayRef<int> { Indices }, ClearVT) {
