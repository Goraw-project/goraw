            LSN;
        } else {
            let mut Offset: i64 = 0;
            if dyn_cast(LSN.getOffset()) {
                C;
            } else {
                Offset = if (LSN.getAddressingMode() == PRE_INC) { C.getSExtValue() } else { if (LSN.getAddressingMode() == PRE_DEC) { -1 * C.getSExtValue() } else { 0 } };
            }
            let mut Size: TypeSize = LSN.getMemoryVT().getStoreSize();
            return MemUseCharacteristics { LSN.isVolatile(), LSN.isAtomic(), LSN.getBasePtr(), Offset, precise(Size), LSN.getMemOperand() };
        }
        if cast(N) {
            LN;
        } else {
            let mut MFI: *mut MachineFrameInfo = self.DAG.getMachineFunction().getFrameInfo();
            return MemUseCharacteristics { false, false, LN.getOperand(1), 0, precise(MFI.getObjectSize(LN.getFrameIndex())), null as *mut MachineMemOperand };
        }
        return MemUseCharacteristics { false, false, SDValue {}, 0 as i64, beforeOrAfterPointer(), null as *mut MachineMemOperand };
    }

struct Closure_131 {
    IsLoad: *mut bool,
    cap_1: *mut DAGCombiner,
    N: *mut *mut SDNode,
}

unsafe fn Closure_131::call(self: *mut Closure_131, C: *mut SDValue) -> auto {
        match C.getOpcode() {
            EntryToken => {
                C = SDValue {};
            },
            LOAD => {
                STORE;
            },
            CopyFromReg => {
                C = C.getOperand(0);
            },
            LIFETIME_START => {
                LIFETIME_END;
            },
            _ => {
                return false;
            },
        }
    }

struct Closure_132 {
    NewChain: *mut SDValue,
}

unsafe fn Closure_132::call(self: *mut Closure_132, ST: SDValue) -> auto {
        return operator(ST).getOperand(0) != (*self.NewChain);
    }
