    }
    return SDValue {};
}

fn DAGCombiner::visitFNEG(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut FlagsInserter: FlagInserter = FlagInserter { self.DAG, N };
    if self.DAG.FoldConstantArithmetic(FNEG, SDLoc { N }, VT, ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if self.TLI.getNegatedExpression(N0, self.DAG, self.LegalOperations, self.ForCodeSize, 0) {
        NegN0;
    } else {
        return NegN0;
    }
    if N0.getOpcode() == FSUB && N.getFlags().hasNoSignedZeros() && N0.hasOneUse() {
        return self.DAG.getNode(FSUB, SDLoc { N }, VT, N0.getOperand(1), N0.getOperand(0));
    }
    if self.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if self.foldSignChangeInBitcast(N) {
        Cast;
    } else {
        return Cast;
    }
    return SDValue {};
}

fn DAGCombiner::visitFMinMax(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut Flags: SDNodeFlags = N.getFlags();
    let mut Opc: u32 = N.getOpcode();
    let mut PropAllNaNsToQNaNs: bool = Opc == FMINIMUM || Opc == FMAXIMUM;
    let mut PropOnlySNaNsToQNaNs: bool = Opc == FMINNUM || Opc == FMAXNUM;
    let mut IsMin: bool = Opc == FMINNUM || Opc == FMINIMUM || Opc == FMINIMUMNUM;
    let mut FlagsInserter: FlagInserter = FlagInserter { self.DAG, N };
    if self.DAG.FoldConstantArithmetic(Opc, SDLoc { N }, VT, ArrayRef<SDValue> { [N0, N1] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if self.DAG.isConstantFPBuildVectorOrConstantFP(N0) && !self.DAG.isConstantFPBuildVectorOrConstantFP(N1) {
        return self.DAG.getNode(N.getOpcode(), SDLoc { N }, VT, N1, N0);
    }
    if isConstOrConstSplatFP(N1, false) {
        N1CFP;
    } else {
        let mut AF: *APFloat = N1CFP.getValueAPF();
        if AF.isNaN() {
            if PropAllNaNsToQNaNs || (AF.isSignaling() && PropOnlySNaNsToQNaNs) {
                if AF.isSignaling() {
                    return self.DAG.getConstantFP(AF.makeQuiet(), SDLoc { N }, VT, false);
                }
                return N.getOperand(1);
            }
            return N.getOperand(0);
        }
        if AF.isInfinity() || (Flags.hasNoInfs() && AF.isLargest()) {
            if IsMin == AF.isNegative() && (!PropAllNaNsToQNaNs || Flags.hasNoNaNs()) {
                return N.getOperand(1);
            }
            if IsMin != AF.isNegative() && (PropAllNaNsToQNaNs || Flags.hasNoNaNs()) {
                return N.getOperand(0);
            }
        }
    }
    let mut ReduceOpc: u32 = 0;
    if PropAllNaNsToQNaNs {
        ReduceOpc = if IsMin { VECREDUCE_FMINIMUM } else { VECREDUCE_FMAXIMUM };
    } else if PropOnlySNaNsToQNaNs {
        ReduceOpc = if IsMin { VECREDUCE_FMIN } else { VECREDUCE_FMAX };
    } else {
        ReduceOpc = if IsMin { VECREDUCE_FMINIMUMNUM } else { VECREDUCE_FMAXIMUMNUM };
    }
    if self.reassociateReduction(ReduceOpc, Opc, SDLoc { N }, VT, N0, N1, Flags) {
        SD;
    } else {
        return SD;
    }
    return SDValue {};
}

fn DAGCombiner::visitFABS(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut DL: SDLoc = SDLoc { N };
    if self.DAG.FoldConstantArithmetic(FABS, DL, VT, ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None }) {
        C;
    } else {
        return C;
    }
    if self.SimplifyDemandedBits(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if self.foldSignChangeInBitcast(N) {
        Cast;
    } else {
        return Cast;
    }
    return SDValue {};
}

fn DAGCombiner::visitBRCOND(self, N: *mut SDNode) -> SDValue {
    let mut Chain: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut N2: SDValue = N.getOperand(2);
    if operator(N1).getOpcode() == FREEZE && N1.hasOneUse() {
        return self.DAG.getNode(BRCOND, SDLoc { N }, EVT { Other }, Chain, operator(N1).getOperand(0), N2, N.getFlags());
    }
    if operator(N1).getOpcode() == SETCC && N1.hasOneUse() {
        let mut S0: SDValue = operator(N1).getOperand(0);
        let mut S1: SDValue = operator(N1).getOperand(1);
        let mut Cond: CondCode = cast(operator(N1).getOperand(2)).get();
        let mut S0C: *mut ConstantSDNode = dyn_cast(S0);
        let mut S1C: *mut ConstantSDNode = dyn_cast(S1);
        let mut Updated: bool = false;
        let mut IsAlwaysTrueOrFalse: Closure_76 = Closure_76 {};
        if operator(S0).getOpcode() == FREEZE && S0.hasOneUse() && S1C {
            if !IsAlwaysTrueOrFalse.call(Cond, S1C) {
                S0 = operator(S0).getOperand(0);
                Updated = true;
            }
        }
        if operator(S1).getOpcode() == FREEZE && S1.hasOneUse() && S0C {
            if !IsAlwaysTrueOrFalse.call(getSetCCSwappedOperands(Cond), S0C) {
                S1 = operator(S1).getOperand(0);
                Updated = true;
            }
        }
        if Updated {
            return self.DAG.getNode(BRCOND, SDLoc { N }, EVT { Other }, Chain, self.DAG.getSetCC(SDLoc { N1 }, operator(N1).getValueType(0), S0, S1, Cond, SDValue {}, false, SDNodeFlags { Flags: None }), N2, N.getFlags());
        }
    }
    if N1.getOpcode() == SETCC && self.TLI.isOperationLegalOrCustom(BR_CC, N1.getOperand(0).getValueType(), false) {
        return self.DAG.getNode(BR_CC, SDLoc { N }, EVT { Other }, Chain, N1.getOperand(2), N1.getOperand(0), N1.getOperand(1), N2, operator(N1).getFlags());
    }
    if N1.hasOneUse() {
        let mut ChainHandle: HandleSDNode = HandleSDNode { Chain };
        if self.rebuildSetCC(N1) {
            NewN1;
        } else {
            return self.DAG.getNode(BRCOND, SDLoc { N }, EVT { Other }, ChainHandle.getValue(), NewN1, N2, N.getFlags());
        }
    }
    return SDValue {};
}

fn DAGCombiner::rebuildSetCC(self, N: SDValue) -> SDValue {
    if N.getOpcode() == SRL || (N.getOpcode() == TRUNCATE && (N.getOperand(0).hasOneUse() && N.getOperand(0).getOpcode() == SRL)) {
        if N.getOpcode() == TRUNCATE {
            N = N.getOperand(0);
        }
        let mut Op0: SDValue = N.getOperand(0);
        let mut Op1: SDValue = N.getOperand(1);
        if Op0.getOpcode() == AND && Op1.getOpcode() == Constant {
            let mut AndOp1: SDValue = Op0.getOperand(1);
            if AndOp1.getOpcode() == Constant {
                let mut AndConst: *APInt = operator(AndOp1).getAsAPIntVal();
                if AndConst.isPowerOf2() && operator(Op1).getAsAPIntVal() == AndConst.logBase2() {
                    let mut DL: SDLoc = SDLoc { N };
                    return self.DAG.getSetCC(DL, self.getSetCCResultType(Op0.getValueType()), Op0, self.DAG.getConstant(0, DL, Op0.getValueType(), false, false), SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
                }
            }
        }
    }
    if N.getOpcode() == XOR {
        while N.getOpcode() == XOR {
            let mut XORHandle: HandleSDNode = HandleSDNode { N };
            let mut Tmp: SDValue = self.visitXOR(N.getNode());
            if !Tmp.getNode() {
                break;
            }
            if Tmp.getNode() == N.getNode() {
                N = XORHandle.getValue();
            } else {
                N = Tmp;
            }
        }
        if N.getOpcode() != XOR {
            return N;
        }
        let mut Op0: SDValue = operator(N).getOperand(0);
        let mut Op1: SDValue = operator(N).getOperand(1);
        if Op0.getOpcode() != SETCC && Op1.getOpcode() != SETCC {
            let mut Equal: bool = false;
            if isBitwiseNot(N, false) && Op0.hasOneUse() && Op0.getOpcode() == XOR && Op0.getValueType() == EVT { i1 } {
                N = Op0;
                Op0 = operator(N).getOperand(0);
                Op1 = operator(N).getOperand(1);
                Equal = true;
            }
            let mut SetCCVT: EVT = N.getValueType();
            if self.LegalTypes {
                SetCCVT = self.getSetCCResultType(SetCCVT);
            }
            let mut CC: CondCode = if Equal { SETEQ } else { SETNE };
            if !self.LegalOperations || self.TLI.isCondCodeLegal(CC, Op0.getSimpleValueType()) {
                return self.DAG.getSetCC(SDLoc { N }, SetCCVT, Op0, Op1, CC, SDValue {}, false, SDNodeFlags { Flags: None });
            }
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitBR_CC(self, N: *mut SDNode) -> SDValue {
    let mut CC: *mut CondCodeSDNode = cast(N.getOperand(1));
    let mut CondLHS: SDValue = N.getOperand(2);
    let mut CondRHS: SDValue = N.getOperand(3);
    let mut Simp: SDValue = self.SimplifySetCC(self.getSetCCResultType(CondLHS.getValueType()), CondLHS, CondRHS, CC.get(), SDLoc { N }, false);
    if Simp.getNode() {
        self.AddToWorklist(Simp.getNode(), true, false);
    }
    if Simp.getNode() && Simp.getOpcode() == SETCC {
        return self.DAG.getNode(BR_CC, SDLoc { N }, EVT { Other }, N.getOperand(0), Simp.getOperand(2), Simp.getOperand(0), Simp.getOperand(1), N.getOperand(4));
    }
    return SDValue {};
}

fn getCombineLoadStoreParts(N: *mut SDNode, Inc: u32, Dec: u32, IsLoad: *mut bool, IsMasked: *mut bool, Ptr: *mut SDValue, TLI: *TargetLowering) -> bool {
    if dyn_cast(N) {
        LD;
    } else {
        if LD.isIndexed() {
            return false;
        }
        let mut VT: EVT = LD.getMemoryVT();
        if !TLI.isIndexedLoadLegal(Inc, VT) && !TLI.isIndexedLoadLegal(Dec, VT) {
            return false;
        }
        Ptr = LD.getBasePtr();
    }
    return true;
}

fn DAGCombiner::CombineToPreIndexedLoadStore(self, N: *mut SDNode) -> bool {
    if self.Level < AfterLegalizeDAG {
        return false;
    }
    let mut IsLoad: bool = true;
    let mut IsMasked: bool = false;
    let mut Ptr: SDValue = SDValue {};
    if !getCombineLoadStoreParts(N, PRE_INC, PRE_DEC, IsLoad, IsMasked, Ptr, self.TLI) {
        return false;
    }
    if (Ptr.getOpcode() != ADD && Ptr.getOpcode() != SUB) || operator(Ptr).hasOneUse() {
        return false;
    }
    let mut BasePtr: SDValue = SDValue {};
    let mut Offset: SDValue = SDValue {};
    let mut AM: MemIndexedMode = UNINDEXED;
    if !self.TLI.getPreIndexedAddressParts(N, BasePtr, Offset, AM, self.DAG) {
        return false;
    }
    let mut Swapped: bool = false;
    if isa(BasePtr) {
        swap(BasePtr, Offset);
        Swapped = true;
    }
    if isNullConstant(Offset) {
        return false;
    }
    if isa(BasePtr) || isa(BasePtr) {
        return false;
    }
    if !IsLoad {
        let mut Val: SDValue = if IsMasked { cast(N).getValue() } else { cast(N).getValue() };
        if Val == BasePtr {
            return false;
        }
        if Val == Ptr || operator(Ptr).isPredecessorOf(Val.getNode()) {
            return false;
        }
    }
    let mut Visited: SmallPtrSet<const SDNode *, 32> = SmallPtrSet<const SDNode *, 32> {};
    let mut Worklist: SmallVector<const SDNode *, 16> = SmallVector<const SDNode *, 16> {};
    Worklist.push(N);
    let mut OtherUses: SmallVector<SDNode *, 16> = SmallVector<SDNode *, 16> {};
    let mut MaxSteps: u32 = getHasPredecessorMaxSteps();
    if isa(Offset) {
        for Use in operator(BasePtr).uses() {
            if Use.getUser() == Ptr.getNode() || Use != BasePtr {
                continue;
            }
            if hasPredecessorHelper(Use.getUser(), Visited, Worklist, MaxSteps, false) {
                continue;
            }
            if Use.getUser().getOpcode() != ADD && Use.getUser().getOpcode() != SUB {
                OtherUses.clear();
                break;
            }
            let mut Op1: SDValue = Use.getUser().getOperand((Use.getOperandNo() + 1) & 1);
            if !isa(Op1) {
                OtherUses.clear();
                break;
            }
            if Op1.getValueType() != Offset.getValueType() {
                OtherUses.clear();
                break;
            }
            OtherUses.push(Use.getUser());
        }
    }
    if Swapped {
        swap(BasePtr, Offset);
    }
    let mut RealUse: bool = false;
    for User in operator(Ptr).users() {
        if User == N {
            continue;
        }
        if hasPredecessorHelper(User, Visited, Worklist, MaxSteps, false) {
            return false;
        }
        if !canFoldInAddressingMode(Ptr.getNode(), User, self.DAG, self.TLI) {
            RealUse = true;
        }
    }
    if !RealUse {
        return false;
    }
    let mut Result: SDValue = SDValue {};
    if !IsMasked {
        if IsLoad {
            Result = self.DAG.getIndexedLoad(SDValue { Node: N, ResNo: 0 }, SDLoc { N }, BasePtr, Offset, AM);
        } else {
            Result = self.DAG.getIndexedStore(SDValue { Node: N, ResNo: 0 }, SDLoc { N }, BasePtr, Offset, AM);
        }
    } else {
        if IsLoad {
            Result = self.DAG.getIndexedMaskedLoad(SDValue { Node: N, ResNo: 0 }, SDLoc { N }, BasePtr, Offset, AM);
        } else {
            Result = self.DAG.getIndexedMaskedStore(SDValue { Node: N, ResNo: 0 }, SDLoc { N }, BasePtr, Offset, AM);
        }
    }
    operator(PreIndexedNodes);
    operator(NodesCombined);
    while true {
        {
        if DebugFlag && isCurrentDebugType("dagcombine", 1) {
            dbgs() << "\nReplacing.4 ";
            N.dump(&mut self.DAG);
            dbgs() << "\nWith: ";
            Result.dump(&mut self.DAG);
            dbgs() << 10;
        }
    }
        if !(false) { break; }
    }
    let mut DeadNodes: WorklistRemover = WorklistRemover { DC: *self };
    if IsLoad {
        self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: N, ResNo: 0 }, Result.getValue(0));
        self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: N, ResNo: 1 }, Result.getValue(2));
    } else {
        self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: N, ResNo: 0 }, Result.getValue(1));
    }
    self.deleteAndRecombine(N);
    if Swapped {
        swap(BasePtr, Offset);
    }
    for OtherUse in OtherUses {
        let mut OffsetIdx: u32 = 1;
        if OtherUse.getOperand(OffsetIdx).getNode() == BasePtr.getNode() {
            OffsetIdx = 0;
        }
        assert!(OtherUse.getOperand(!OffsetIdx).getNode() == BasePtr.getNode(), "Expected BasePtr operand");
        let mut CN: *mut ConstantSDNode = cast(OtherUse.getOperand(OffsetIdx));
        let mut Offset0: *APInt = CN.getAPIntValue();
        let mut Offset1: *APInt = operator(Offset).getAsAPIntVal();
        let mut X0: i32 = if (OtherUse.getOpcode() == SUB && OffsetIdx == 1) { -1 } else { 1 };
        let mut Y0: i32 = if (OtherUse.getOpcode() == SUB && OffsetIdx == 0) { -1 } else { 1 };
        let mut X1: i32 = if (AM == PRE_DEC && !Swapped) { -1 } else { 1 };
        let mut Y1: i32 = if (AM == PRE_DEC && Swapped) { -1 } else { 1 };
        let mut Opcode: u32 = if (Y0 * Y1 < 0) { SUB } else { ADD };
        let mut CNV: APInt = Offset0;
        if X0 < 0 {
            CNV = operator(CNV);
        }
        if X1 * Y0 * Y1 < 0 {
            CNV = CNV + Offset1;
        } else {
            CNV = CNV - Offset1;
        }
        let mut DL: SDLoc = SDLoc { OtherUse };
        let mut NewOp1: SDValue = self.DAG.getConstant(CNV, DL, CN.getValueType(0), false, false);
        let mut NewOp2: SDValue = Result.getValue(if IsLoad { 1 } else { 0 });
        let mut NewUse: SDValue = self.DAG.getNode(Opcode, DL, OtherUse.getValueType(0), NewOp1, NewOp2);
        self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: OtherUse, ResNo: 0 }, NewUse);
        self.deleteAndRecombine(OtherUse);
    }
    self.DAG.ReplaceAllUsesOfValueWith(Ptr, Result.getValue(if IsLoad { 1 } else { 0 }));
    self.deleteAndRecombine(Ptr.getNode());
    self.AddToWorklist(Result.getNode(), true, false);
    return true;
}

fn shouldCombineToPostInc(N: *mut SDNode, Ptr: SDValue, PtrUse: *mut SDNode, BasePtr: *mut SDValue, Offset: *mut SDValue, AM: *mut MemIndexedMode, DAG: *mut SelectionDAG, TLI: *TargetLowering) -> bool {
    if PtrUse == N || (PtrUse.getOpcode() != ADD && PtrUse.getOpcode() != SUB) {
        return false;
    }
    if !TLI.getPostIndexedAddressParts(N, PtrUse, BasePtr, Offset, AM, DAG) {
        return false;
    }
    if isNullConstant(Offset) {
        return false;
    }
    if isa(BasePtr) || isa(BasePtr) {
        return false;
    }
    let mut Visited: SmallPtrSet<const SDNode *, 32> = SmallPtrSet<const SDNode *, 32> {};
    let mut MaxSteps: u32 = getHasPredecessorMaxSteps();
    for User in operator(BasePtr).users() {
        if User == Ptr.getNode() {
            continue;
        }
        if isa(User) {
            let mut IsLoad: bool = true;
            let mut IsMasked: bool = false;
            let mut OtherPtr: SDValue = SDValue {};
            if getCombineLoadStoreParts(User, POST_INC, POST_DEC, IsLoad, IsMasked, OtherPtr, TLI) {
                let mut Worklist: SmallVector<const SDNode *, 2> = SmallVector<const SDNode *, 2> {};
                Worklist.push(User);
                if hasPredecessorHelper(N, Visited, Worklist, MaxSteps, false) {
                    return false;
                }
            }
        }
        if User.getOpcode() == ADD || User.getOpcode() == SUB {
            for UserUser in User.users() {
                if canFoldInAddressingMode(User, UserUser, DAG, TLI) {
                    return false;
                }
            }
        }
    }
    return true;
}

fn getPostIndexedLoadStoreOp(N: *mut SDNode, IsLoad: *mut bool, IsMasked: *mut bool, Ptr: *mut SDValue, BasePtr: *mut SDValue, Offset: *mut SDValue, AM: *mut MemIndexedMode, DAG: *mut SelectionDAG, TLI: *TargetLowering) -> *mut SDNode {
    if !getCombineLoadStoreParts(N, POST_INC, POST_DEC, IsLoad, IsMasked, Ptr, TLI) || operator(Ptr).hasOneUse() {
        return null;
    }
    let mut MaxSteps: u32 = getHasPredecessorMaxSteps();
    for U in operator(Ptr).uses() {
        if U.getResNo() != Ptr.getResNo() {
            continue;
        }
        let mut Op: *mut SDNode = U.getUser();
        if !shouldCombineToPostInc(N, Ptr, Op, BasePtr, Offset, AM, DAG, TLI) {
            continue;
        }
        let mut Visited: SmallPtrSet<const SDNode *, 32> = SmallPtrSet<const SDNode *, 32> {};
        let mut Worklist: SmallVector<const SDNode *, 8> = SmallVector<const SDNode *, 8> {};
        Visited.insert(Ptr.getNode());
        Worklist.push(N);
        Worklist.push(Op);
        if !hasPredecessorHelper(N, Visited, Worklist, MaxSteps, false) && !hasPredecessorHelper(Op, Visited, Worklist, MaxSteps, false) {
            return Op;
        }
    }
    return null;
}

fn DAGCombiner::CombineToPostIndexedLoadStore(self, N: *mut SDNode) -> bool {
    if self.Level < AfterLegalizeDAG {
        return false;
    }
    let mut IsLoad: bool = true;
    let mut IsMasked: bool = false;
    let mut Ptr: SDValue = SDValue {};
    let mut BasePtr: SDValue = SDValue {};
    let mut Offset: SDValue = SDValue {};
    let mut AM: MemIndexedMode = UNINDEXED;
    let mut Op: *mut SDNode = getPostIndexedLoadStoreOp(N, IsLoad, IsMasked, Ptr, BasePtr, Offset, AM, self.DAG, self.TLI);
    if !Op {
        return false;
    }
    let mut Result: SDValue = SDValue {};
    if !IsMasked {
        Result = if IsLoad { self.DAG.getIndexedLoad(SDValue { Node: N, ResNo: 0 }, SDLoc { N }, BasePtr, Offset, AM) } else { self.DAG.getIndexedStore(SDValue { Node: N, ResNo: 0 }, SDLoc { N }, BasePtr, Offset, AM) };
    } else {
        Result = if IsLoad { self.DAG.getIndexedMaskedLoad(SDValue { Node: N, ResNo: 0 }, SDLoc { N }, BasePtr, Offset, AM) } else { self.DAG.getIndexedMaskedStore(SDValue { Node: N, ResNo: 0 }, SDLoc { N }, BasePtr, Offset, AM) };
    }
    operator(PostIndexedNodes);
    operator(NodesCombined);
    while true {
        {
        if DebugFlag && isCurrentDebugType("dagcombine", 1) {
            dbgs() << "\nReplacing.5 ";
            N.dump(&mut self.DAG);
            dbgs() << "\nWith: ";
            Result.dump(&mut self.DAG);
            dbgs() << 10;
        }
    }
        if !(false) { break; }
    }
    let mut DeadNodes: WorklistRemover = WorklistRemover { DC: *self };
    if IsLoad {
        self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: N, ResNo: 0 }, Result.getValue(0));
        self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: N, ResNo: 1 }, Result.getValue(2));
    } else {
        self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: N, ResNo: 0 }, Result.getValue(1));
    }
    self.deleteAndRecombine(N);
    self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: Op, ResNo: 0 }, Result.getValue(if IsLoad { 1 } else { 0 }));
    self.deleteAndRecombine(Op);
    return true;
}

fn DAGCombiner::SplitIndexingFromLoad(self, LD: *mut LoadSDNode) -> SDValue {
    let mut AM: MemIndexedMode = LD.getAddressingMode();
    assert!(AM != UNINDEXED);
    let mut BP: SDValue = LD.getOperand(1);
    let mut Inc: SDValue = LD.getOperand(2);
    assert!((Inc.getOpcode() != TargetConstant || !cast(Inc).isOpaque()), "Cannot split out indexing using opaque target constants");
    if Inc.getOpcode() == TargetConstant {
        let mut ConstInc: *mut ConstantSDNode = cast(Inc);
        Inc = self.DAG.getConstant(*ConstInc.getConstantIntValue(), SDLoc { Inc }, ConstInc.getValueType(0), false, false);
    }
    let mut Opc: u32 = (if AM == PRE_INC || AM == POST_INC { ADD } else { SUB });
    return self.DAG.getNode(Opc, SDLoc { LD }, EVT { BP.getSimpleValueType() }, BP, Inc);
}

fn numVectorEltsOrZero(T: EVT) -> ElementCount {
    return if T.isVector() { T.getVectorElementCount() } else { getFixed(0) };
}

fn DAGCombiner::getTruncatedStoreValue(self, ST: *mut StoreSDNode, Val: *mut SDValue) -> bool {
    let mut STType: EVT = Val.getValueType();
    let mut STMemType: EVT = ST.getMemoryVT();
    if STType == STMemType {
        return true;
    }
    if self.isTypeLegal(STMemType) {
        return false;
    }
    if STType.isFloatingPoint() && STMemType.isFloatingPoint() && self.TLI.isOperationLegal(FTRUNC, STMemType) {
        Val = self.DAG.getNode(FTRUNC, SDLoc { ST }, STMemType, Val);
        return true;
    }
    if numVectorEltsOrZero(STType) == numVectorEltsOrZero(STMemType) && STType.isInteger() && STMemType.isInteger() {
        Val = self.DAG.getNode(TRUNCATE, SDLoc { ST }, STMemType, Val);
        return true;
    }
    if STType.getSizeInBits() == STMemType.getSizeInBits() {
        Val = self.DAG.getBitcast(STMemType, Val);
        return true;
    }
    return false;
}

fn DAGCombiner::extendLoadedValueToExtension(self, LD: *mut LoadSDNode, Val: *mut SDValue) -> bool {
    let mut LDMemType: EVT = LD.getMemoryVT();
    let mut LDType: EVT = LD.getValueType(0);
    assert!(Val.getValueType() == LDMemType, "Attempting to extend value of non-matching type");
    if LDType == LDMemType {
        return true;
    }
    if LDMemType.isInteger() && LDType.isInteger() {
        match LD.getExtensionType() {
            NON_EXTLOAD => {
                Val = self.DAG.getBitcast(LDType, Val);
            },
            EXTLOAD => {
                Val = self.DAG.getNode(ANY_EXTEND, SDLoc { LD }, LDType, Val);
            },
            SEXTLOAD => {
                Val = self.DAG.getNode(SIGN_EXTEND, SDLoc { LD }, LDType, Val);
            },
            ZEXTLOAD => {
                Val = self.DAG.getNode(ZERO_EXTEND, SDLoc { LD }, LDType, Val);
            },
        }
    }
    return false;
}

fn DAGCombiner::getUniqueStoreFeeding(self, LD: *mut LoadSDNode, Offset: *mut i64) -> *mut StoreSDNode {
    let mut Chain: SDValue = LD.getOperand(0);
    if Chain.getOpcode() == CALLSEQ_START {
        Chain = operator(Chain).getOperand(0);
    }
    let mut ST: *mut StoreSDNode = null;
    let mut Aliases: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    if Chain.getOpcode() == TokenFactor {
        for Op in operator(Chain).ops() {
            let mut Store: *mut StoreSDNode = dyn_cast(Op.getNode());
            if !Store {
                continue;
            }
            let mut BasePtrLD: BaseIndexOffset = match(LD, self.DAG);
            let mut BasePtrST: BaseIndexOffset = match(Store, self.DAG);
            if !BasePtrST.equalBaseIndex(BasePtrLD, self.DAG, Offset) {
                continue;
            }
            self.GatherAllAliases(Store, Chain, Aliases);
            if Aliases.len == 0 || (Aliases.len == 1 && Aliases.front().getNode() == Store) {
                ST = Store;
            }
            break;
        }
    } else {
        let mut Store: *mut StoreSDNode = dyn_cast(Chain.getNode());
        if Store {
            let mut BasePtrLD: BaseIndexOffset = match(LD, self.DAG);
            let mut BasePtrST: BaseIndexOffset = match(Store, self.DAG);
            if BasePtrST.equalBaseIndex(BasePtrLD, self.DAG, Offset) {
                ST = Store;
            }
        }
    }
    return ST;
}

fn DAGCombiner::ForwardStoreValueToDirectLoad(self, LD: *mut LoadSDNode) -> SDValue {
    if self.OptLevel == None || !LD.isSimple() {
        return SDValue {};
    }
    let mut Chain: SDValue = LD.getOperand(0);
    let mut Offset: i64 = 0;
    let mut ST: *mut StoreSDNode = self.getUniqueStoreFeeding(LD, Offset);
    if !ST || !ST.isSimple() || ST.getAddressSpace() != LD.getAddressSpace() {
        return SDValue {};
    }
    let mut LDType: EVT = LD.getValueType(0);
    let mut LDMemType: EVT = LD.getMemoryVT();
    let mut STMemType: EVT = ST.getMemoryVT();
    let mut STType: EVT = ST.getValue().getValueType();
    let mut LdStScalable: bool = LDMemType.isScalableVT();
    if LdStScalable != STMemType.isScalableVT() {
        return SDValue {};
    }
    if LdStScalable && self.DAG.getDataLayout().isBigEndian() {
        return SDValue {};
    }
    let mut OrigOffset: i64 = Offset;
    if self.DAG.getDataLayout().isBigEndian() {
        Offset = (STMemType.getStoreSizeInBits().getFixedValue() as i64 - LDMemType.getStoreSizeInBits().getFixedValue() as i64) / 8 - Offset;
    }
    let mut STCoversLD: bool = false;
    let mut LdMemSize: TypeSize = LDMemType.getSizeInBits();
    let mut StMemSize: TypeSize = STMemType.getSizeInBits();
    if LdStScalable {
        STCoversLD = (Offset == 0) && LdMemSize == StMemSize;
    } else {
        STCoversLD = (Offset >= 0) && (Offset * 8 + LdMemSize.getFixedValue() <= StMemSize.getFixedValue());
    }
    let mut ReplaceLd: Closure_77 = Closure_77 { cap_0: self };
    if !STCoversLD {
        return SDValue {};
    }
    if Offset == 0 && LDType == STType && STMemType == LDMemType {
        if LDType.getSizeInBits() == LdMemSize {
            return ReplaceLd.call(LD, ST.getValue(), Chain);
        }
        if STType.isInteger() && LDMemType.isInteger() && !STType.isVector() && !LDMemType.isVector() && LD.getExtensionType() != SEXTLOAD {
            let mut Mask: SDValue = self.DAG.getConstant(getLowBitsSet(STType.getFixedSizeInBits(), StMemSize.getFixedValue()), SDLoc { ST }, STType, false, false);
            let mut Val: SDValue = self.DAG.getNode(AND, SDLoc { LD }, LDType, ST.getValue(), Mask);
            return ReplaceLd.call(LD, Val, Chain);
        }
    }
    let mut Val: SDValue = ST.getValue();
    if self.DAG.getDataLayout().isBigEndian() && Offset > 0 && OrigOffset == 0 {
        if STType.isInteger() && !STType.isVector() && LDType.isInteger() && !LDType.isVector() && self.isTypeLegal(STType) && self.TLI.isOperationLegal(SRL, STType) {
            Val = self.DAG.getNode(SRL, SDLoc { LD }, STType, Val, self.DAG.getShiftAmountConstant(Offset * 8, STType, SDLoc { LD }));
            Offset = 0;
        }
    }
    if LD.getBasePtr().isUndef() || Offset != 0 {
        return SDValue {};
    }
    while true {
        {
        if !self.getTruncatedStoreValue(ST, Val) {
            break;
        }
        if !self.isTypeLegal(LDMemType) {
            break;
        }
        if STMemType != LDMemType {
            if LdMemSize == StMemSize {
                if self.TLI.isOperationLegal(BITCAST, LDMemType) && self.isTypeLegal(LDMemType) && self.TLI.isOperationLegal(BITCAST, STMemType) && self.isTypeLegal(STMemType) && self.TLI.isLoadBitCastBeneficial(LDMemType, STMemType, self.DAG, *LD.getMemOperand()) {
                    Val = self.DAG.getBitcast(LDMemType, Val);
                } else {
                    break;
                }
            } else if LDMemType.isVector() && self.isTypeLegal(STMemType) {
                let mut EltVT: EVT = LDMemType.getVectorElementType();
                let mut EltSize: TypeSize = EltVT.getSizeInBits();
                if !StMemSize.isKnownMultipleOf(EltSize) {
                    break;
                }
                let mut InterVT: EVT = getVectorVT(*self.DAG.getContext(), EltVT, StMemSize.divideCoefficientBy(EltSize.operator unsigned long long()).operator unsigned long long(), false);
                if !self.TLI.isOperationLegalOrCustom(EXTRACT_SUBVECTOR, LDMemType, false) || !self.TLI.isTypeLegal(InterVT) {
                    break;
                }
                let mut ExtIdx: u32 = 0;
                if self.DAG.getDataLayout().isBigEndian() {
                    ExtIdx = InterVT.getVectorNumElements() - LDMemType.getVectorNumElements();
                }
                if self.TLI.getExtractSubvectorCost(LDMemType, InterVT, ExtIdx) > Cheap {
                    break;
                }
                Val = self.DAG.getExtractSubvector(SDLoc { LD }, LDMemType, self.DAG.getBitcast(InterVT, Val), ExtIdx);
            } else if !STMemType.isVector() && !LDMemType.isVector() && STMemType.isInteger() && LDMemType.isInteger() {
                Val = self.DAG.getNode(TRUNCATE, SDLoc { LD }, LDMemType, Val);
            } else {
                break;
            }
        }
        if !self.extendLoadedValueToExtension(LD, Val) {
            break;
        }
        return ReplaceLd.call(LD, Val, Chain);
    }
        if !(false) { break; }
    }
    if operator(Val).use_empty() {
        self.deleteAndRecombine(Val.getNode());
    }
    return SDValue {};
}

fn DAGCombiner::visitLOAD(self, N: *mut SDNode) -> SDValue {
    let mut LD: *mut LoadSDNode = cast(N);
    let mut Chain: SDValue = LD.getChain();
    let mut Ptr: SDValue = LD.getBasePtr();
    if LD.isSimple() {
        if N.getValueType(1) == EVT { Other } {
            if !N.hasAnyUseOfValue(0) {
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("dagcombine", 1) {
                        dbgs() << "\nReplacing.6 ";
                        N.dump(&mut self.DAG);
                        dbgs() << "\nWith chain: ";
                        Chain.dump(&mut self.DAG);
                        dbgs() << "\n";
                    }
                }
                    if !(false) { break; }
                }
                let mut DeadNodes: WorklistRemover = WorklistRemover { DC: *self };
                self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: N, ResNo: 1 }, Chain);
                self.AddUsersToWorklist(Chain.getNode());
                if N.use_empty() {
                    self.deleteAndRecombine(N);
                }
                return SDValue { Node: N, ResNo: 0 };
            }
        } else {
            assert!(N.getValueType(2) == EVT { Other }, "Malformed indexed loads?");
            let mut CanSplitIdx: bool = canSplitIdx(LD);
            if !N.hasAnyUseOfValue(0) && (CanSplitIdx || !N.hasAnyUseOfValue(1)) {
                let mut Poison: SDValue = self.DAG.getPOISON(N.getValueType(0));
                let mut Index: SDValue = SDValue {};
                if N.hasAnyUseOfValue(1) && CanSplitIdx {
                    Index = self.SplitIndexingFromLoad(LD);
                    self.AddUsersToWorklist(N);
                } else {
                    Index = self.DAG.getPOISON(N.getValueType(1));
                }
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("dagcombine", 1) {
                        dbgs() << "\nReplacing.7 ";
                        N.dump(&mut self.DAG);
                        dbgs() << "\nWith: ";
                        Poison.dump(&mut self.DAG);
                        dbgs() << " and 2 other values\n";
                    }
                }
                    if !(false) { break; }
                }
                let mut DeadNodes: WorklistRemover = WorklistRemover { DC: *self };
                self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: N, ResNo: 0 }, Poison);
                self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: N, ResNo: 1 }, Index);
                self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: N, ResNo: 2 }, Chain);
                self.deleteAndRecombine(N);
                return SDValue { Node: N, ResNo: 0 };
            }
        }
    }
    if self.ForwardStoreValueToDirectLoad(LD) {
        V;
    } else {
        return V;
    }
    if self.OptLevel != None && LD.isUnindexed() && !LD.isAtomic() {
        if self.DAG.InferPtrAlign(Ptr) {
            Alignment;
        } else {
            if operator(Alignment) > LD.getAlign() && isAligned(operator(Alignment), LD.getSrcValueOffset()) {
                let mut NewLoad: SDValue = self.DAG.getLoad(LD.getAddressingMode(), LD.getExtensionType(), LD.getValueType(0), SDLoc { N }, Chain, Ptr, LD.getOffset(), LD.getPointerInfo(), LD.getMemoryVT(), operator(Alignment), LD.getMemOperand().getFlags(), MMOMetadata { AAInfo: LD.getAAInfo(), Ranges: null, MemCacheHint: null });
                assert!(NewLoad.getNode() == N);
                NewLoad as void;
            }
        }
    }
    if LD.isUnindexed() {
        let mut BetterChain: SDValue = self.FindBetterChain(LD, Chain);
        if Chain != BetterChain {
            let mut ReplLoad: SDValue = SDValue {};
            if LD.getExtensionType() == NON_EXTLOAD {
                ReplLoad = self.DAG.getLoad(N.getValueType(0), SDLoc { LD }, BetterChain, Ptr, LD.getMemOperand());
            } else {
                ReplLoad = self.DAG.getExtLoad(LD.getExtensionType(), SDLoc { LD }, LD.getValueType(0), BetterChain, Ptr, LD.getMemoryVT(), LD.getMemOperand());
            }
            let mut Token: SDValue = self.DAG.getNode(TokenFactor, SDLoc { N }, EVT { Other }, Chain, ReplLoad.getValue(1));
            return self.CombineTo(N, ReplLoad.getValue(0), Token, true);
        }
    }
    if self.CombineToPreIndexedLoadStore(N) || self.CombineToPostIndexedLoadStore(N) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if self.SliceUpLoad(N) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

struct LoadedSlice {
    Inst: *mut SDNode,
    Origin: *mut LoadSDNode,
    Shift: u32,
    DAG: *mut SelectionDAG,
}

fn LoadedSlice::getUsedBits(self: *LoadedSlice) -> APInt {
    assert!(self.Origin, "No original load to compare against.");
    let mut BitWidth: u32 = self.Origin.getValueSizeInBits(0).operator unsigned long long();
    assert!(self.Inst, "This slice is not bound to an instruction");
    assert!(self.Inst.getValueSizeInBits(0).operator unsigned long long() <= BitWidth, "Extracted slice is bigger than the whole type!");
    let mut UsedBits: APInt = APInt { self.Inst.getValueSizeInBits(0).operator unsigned long long(), 0, false, false };
    UsedBits.setAllBits();
    UsedBits = UsedBits.zext(BitWidth);
    operator(UsedBits, self.Shift);
    return UsedBits;
}

fn LoadedSlice::getLoadedSize(self: *LoadedSlice) -> u32 {
    let mut SliceSize: u32 = self.getUsedBits().popcount();
    assert!(!(SliceSize & 7), "Size is not a multiple of a byte.");
    return SliceSize / 8;
}

fn LoadedSlice::getLoadedType(self: *LoadedSlice) -> EVT {
    assert!(self.DAG, "Missing context");
    let mut Ctxt: *mut LLVMContext = *self.DAG.getContext();
    return getIntegerVT(Ctxt, self.getLoadedSize() * 8);
}

fn LoadedSlice::getAlign(self: *LoadedSlice) -> Align {
    let mut Alignment: Align = self.Origin.getAlign();
    let mut Offset: u64 = self.getOffsetFromBase();
    if Offset != 0 {
        Alignment = commonAlignment(Alignment, Alignment.value() + Offset);
    }
    return Alignment;
}

fn LoadedSlice::isLegal(self: *LoadedSlice) -> bool {
    if !self.Origin || !self.Inst || !self.DAG {
        return false;
    }
    if !self.Origin.getOffset().isUndef() {
        return false;
    }
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut SliceType: EVT = self.getLoadedType();
    if !TLI.isTypeLegal(SliceType) {
        return false;
    }
    if !TLI.isOperationLegal(LOAD, SliceType) {
        return false;
    }
    let mut PtrType: EVT = self.Origin.getBasePtr().getValueType();
    if PtrType == EVT { Untyped } || PtrType.isExtended() {
        return false;
    }
    if !TLI.isLegalAddImmediate(self.getOffsetFromBase()) {
        return false;
    }
    if !TLI.isOperationLegal(ADD, PtrType) {
        return false;
    }
    let mut TruncateType: EVT = self.Inst.getValueType(0);
    if TruncateType != SliceType && !TLI.isOperationLegal(ZERO_EXTEND, TruncateType) {
        return false;
    }
    return true;
}

fn LoadedSlice::getOffsetFromBase(self: *LoadedSlice) -> u64 {
    assert!(self.DAG, "Missing context.");
    let mut IsBigEndian: bool = self.DAG.getDataLayout().isBigEndian();
    assert!(!(self.Shift & 7), "Shifts not aligned on Bytes are not supported.");
    let mut Offset: u64 = self.Shift / 8;
    let mut TySizeInBytes: u32 = self.Origin.getValueSizeInBits(0).operator unsigned long long() / 8;
    assert!(!(self.Origin.getValueSizeInBits(0).operator unsigned long long() & 7), "The size of the original loaded type is not a multiple of a byte.");
    assert!(TySizeInBytes > Offset, "Invalid shift amount for given loaded size");
    if IsBigEndian {
        Offset = TySizeInBytes - Offset - self.getLoadedSize();
    }
    return Offset;
}

fn LoadedSlice::loadSlice(self: *LoadedSlice) -> SDValue {
    assert!(self.Inst && self.Origin, "Unable to replace a non-existing slice.");
    let mut OldBaseAddr: *SDValue = self.Origin.getBasePtr();
    let mut BaseAddr: SDValue = OldBaseAddr;
    let mut Offset: i64 = self.getOffsetFromBase() as i64;
    assert!(Offset >= 0, "Offset too big to fit in int64_t!");
    if Offset {
        let mut ArithType: EVT = BaseAddr.getValueType();
        let mut DL: SDLoc = SDLoc { self.Origin };
        BaseAddr = self.DAG.getNode(ADD, DL, ArithType, BaseAddr, self.DAG.getConstant(Offset, DL, ArithType, false, false));
    }
    let mut SliceType: EVT = self.getLoadedType();
    let mut LastInst: SDValue = self.DAG.getLoad(SliceType, SDLoc { self.Origin }, self.Origin.getChain(), BaseAddr, self.Origin.getPointerInfo().getWithOffset(Offset), MaybeAlign { self.getAlign() }, self.Origin.getMemOperand().getFlags(), MMOMetadata {});
    let mut FinalType: EVT = self.Inst.getValueType(0);
    if SliceType != FinalType {
        LastInst = self.DAG.getNode(ZERO_EXTEND, SDLoc { LastInst }, FinalType, LastInst);
    }
    return LastInst;
}

fn LoadedSlice::canMergeExpensiveCrossRegisterBankCopy(self: *LoadedSlice) -> bool {
    if !self.Inst || !self.Inst.hasOneUse() {
        return false;
    }
    let mut User: *mut SDNode = operator(self.Inst.user_begin());
    if User.getOpcode() != BITCAST {
        return false;
    }
    assert!(self.DAG, "Missing context");
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut ResVT: EVT = User.getValueType(0);
    let mut ResRC: *TargetRegisterClass = TLI.getRegClassFor(ResVT.getSimpleVT(), User.isDivergent());
    let mut ArgRC: *TargetRegisterClass = TLI.getRegClassFor(User.getOperand(0).getValueType().getSimpleVT(), operator(User.getOperand(0)).isDivergent());
    if ArgRC == ResRC || !TLI.isOperationLegal(LOAD, ResVT) {
        return false;
    }
    let mut TRI: *TargetRegisterInfo = self.DAG.getSubtarget().getRegisterInfo();
    if !TRI || TRI.getCommonSubClass(ArgRC, ResRC) {
        return false;
    }
    let mut IsFast: u32 = 0;
    if !TLI.allowsMemoryAccess(*self.DAG.getContext(), self.DAG.getDataLayout(), ResVT, self.Origin.getAddressSpace(), self.getAlign(), self.Origin.getMemOperand().getFlags(), &mut IsFast) || !IsFast {
        return false;
    }
    if !TLI.isOperationLegal(LOAD, ResVT) {
        return false;
    }
    if self.Inst.getValueType(0) != self.getLoadedType() {
        return false;
    }
    return true;
}

fn LoadedSlice::operator=(self, arg: *mut *mut LoadedSlice) -> *mut LoadedSlice {
    self.Inst =  as LoadedSlice.Inst;
    self.Origin =  as LoadedSlice.Origin;
    self.Shift =  as LoadedSlice.Shift;
    self.DAG =  as LoadedSlice.DAG;
    return *self;
}

fn areUsedBitsDense(UsedBits: *APInt) -> bool {
    if UsedBits.isAllOnes() {
        return true;
    }
    let mut NarrowedUsedBits: APInt = UsedBits.lshr(UsedBits.countr_zero());
    if NarrowedUsedBits.countl_zero() {
        NarrowedUsedBits = NarrowedUsedBits.trunc(NarrowedUsedBits.getActiveBits());
    }
    return NarrowedUsedBits.isAllOnes();
}

fn areSlicesNextToEachOther(First: *LoadedSlice, Second: *LoadedSlice) -> bool {
    assert!(First.Origin == Second.Origin && First.Origin, "Unable to match different memory origins.");
    let mut UsedBits: APInt = First.getUsedBits();
    assert!((UsedBits & Second.getUsedBits()) == 0, "Slices are not supposed to overlap.");
    operator(UsedBits, Second.getUsedBits());
    return areUsedBitsDense(UsedBits);
}

fn adjustCostForPairing(LoadedSlices: *mut SmallVectorImpl<LoadedSlice>, GlobalLSCost: *mut Cost) {
    let mut NumberOfSlices: u32 = LoadedSlices.len;
    if NumberOfSlices < 2 {
        return;
    }
    sort(LoadedSlices, Closure_78 {});
    let mut TLI: *TargetLowering = LoadedSlices[0].DAG.getTargetLoweringInfo();
    let mut First: *LoadedSlice = null;
    let mut Second: *LoadedSlice = null;
    for let mut CurrSlice: u32 = 0; CurrSlice < NumberOfSlices; CurrSlice += 1 , First = Second {
        Second = &mut LoadedSlices[CurrSlice];
        if !First {
            continue;
        }
        let mut LoadedType: EVT = First.getLoadedType();
        if LoadedType != Second.getLoadedType() {
            continue;
        }
        let mut RequiredAlignment: Align = Align {};
        if !TLI.hasPairedLoad(LoadedType, RequiredAlignment) {
            Second = null;
            continue;
        }
        if First.getAlign() < RequiredAlignment {
            continue;
        }
        if !areSlicesNextToEachOther(*First, *Second) {
            continue;
        }
        assert!(GlobalLSCost.Loads > 0, "We save more loads than we created!");
        GlobalLSCost.Loads -= 1;
        Second = null;
    }
}

fn isSlicingProfitable(LoadedSlices: *mut SmallVectorImpl<LoadedSlice>, UsedBits: *APInt, ForCodeSize: bool) -> bool {
    let mut NumberOfSlices: u32 = LoadedSlices.len;
    if StressLoadSlicing {
        return NumberOfSlices > 1;
    }
    if NumberOfSlices != 2 {
        return false;
    }
    if !areUsedBitsDense(UsedBits) {
        return false;
    }
    let mut OrigCost: Cost = Cost { ForCodeSize };
    let mut GlobalSlicingCost: Cost = Cost { ForCodeSize };
    OrigCost.Loads = 1;
    for let mut CurrSlice: u32 = 0; CurrSlice < NumberOfSlices; CurrSlice += 1 {
        let mut LS: *LoadedSlice = LoadedSlices[CurrSlice];
        let mut SliceCost: Cost = Cost { LS, ForCodeSize };
        operator(GlobalSlicingCost, SliceCost);
        OrigCost.addSliceGain(LS);
    }
    adjustCostForPairing(LoadedSlices, GlobalSlicingCost);
    return OrigCost > GlobalSlicingCost;
}

fn DAGCombiner::SliceUpLoad(self, N: *mut SDNode) -> bool {
    if self.Level < AfterLegalizeDAG {
        return false;
    }
    let mut LD: *mut LoadSDNode = cast(N);
    if !LD.isSimple() || !isNormalLoad(LD) || !LD.getValueType(0).isInteger() {
        return false;
    }
    if LD.getValueType(0).isScalableVector() {
        return false;
    }
    let mut UsedBits: APInt = APInt { LD.getValueSizeInBits(0).operator unsigned long long(), 0, false, false };
    let mut LoadedSlices: SmallVector<LoadedSlice, 4> = SmallVector<LoadedSlice, 4> {};
    for U in LD.uses() {
        if U.getResNo() != 0 {
            continue;
        }
        let mut User: *mut SDNode = U.getUser();
        let mut Shift: u32 = 0;
        if User.getOpcode() == SRL && User.hasOneUse() && isa(User.getOperand(1)) {
            Shift = User.getConstantOperandVal(1);
            User = operator(User.user_begin());
        }
        if User.getOpcode() != TRUNCATE {
            return false;
        }
        let mut Width: u32 = User.getValueSizeInBits(0).operator unsigned long long();
        if Width < 8 || !isPowerOf2_32(Width) || (Shift & 7) {
            return false;
        }
        let mut LS: LoadedSlice = LoadedSlice { Inst: User, Origin: LD, Shift: Shift, DAG: &mut self.DAG };
        let mut CurrentUsedBits: APInt = LS.getUsedBits();
        if (CurrentUsedBits & UsedBits) != 0 {
            return false;
        }
        operator(UsedBits, CurrentUsedBits);
        if !LS.isLegal() {
            return false;
        }
        LoadedSlices.push(LS);
    }
    if !isSlicingProfitable(LoadedSlices, UsedBits, self.ForCodeSize) {
        return false;
    }
    operator(SlicedLoads);
    let mut ArgChains: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    for LS in LoadedSlices {
        let mut SliceInst: SDValue = LS.loadSlice();
        self.CombineTo(LS.Inst, SliceInst, true);
        if SliceInst.getOpcode() != LOAD {
            SliceInst = SliceInst.getOperand(0);
        }
        assert!(operator(SliceInst).getOpcode() == LOAD, "It takes more than a zext to get to the loaded slice!!");
        ArgChains.push(SliceInst.getValue(1));
    }
    let mut Chain: SDValue = self.DAG.getNode(TokenFactor, SDLoc { LD }, EVT { Other }, ArrayRef<SDValue> { ArgChains });
    self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: N, ResNo: 1 }, Chain);
    self.AddToWorklist(Chain.getNode(), true, false);
    return true;
}

fn CheckForMaskedLoad(V: SDValue, Ptr: SDValue, Chain: SDValue) -> pair<unsigned int, unsigned int> {
    let mut Result: pair<unsigned int, unsigned int> = pair<unsigned int, unsigned int> { 0, 0 };
    if operator(V).getOpcode() != AND || !isa(operator(V).getOperand(1)) || !isNormalLoad(operator(V).getOperand(0).getNode()) {
        return Result;
    }
    let mut LD: *mut LoadSDNode = cast(operator(V).getOperand(0));
    if LD.getBasePtr() != Ptr {
        return Result;
    }
    if V.getValueType() != EVT { i16 } && V.getValueType() != EVT { i32 } && V.getValueType() != EVT { i64 } {
        return Result;
    }
    let mut NotMask: u64 = ~cast(operator(V).getOperand(1)).getSExtValue();
    let mut NotMaskLZ: u32 = countl_zero(NotMask);
    if NotMaskLZ & 7 {
        return Result;
    }
    let mut NotMaskTZ: u32 = countr_zero(NotMask);
    if NotMaskTZ & 7 {
        return Result;
    }
    if NotMaskLZ == 64 {
        return Result;
    }
    if countr_one(NotMask >> NotMaskTZ) + NotMaskTZ + NotMaskLZ != 64 {
        return Result;
    }
    if V.getValueType() != EVT { i64 } && NotMaskLZ {
        NotMaskLZ -= 64 - V.getValueSizeInBits().operator unsigned long long();
    }
    let mut MaskedBytes: u32 = (V.getValueSizeInBits().operator unsigned long long() - NotMaskLZ - NotMaskTZ) / 8;
    match MaskedBytes {
        1 => {
            2;
        },
        _ => {
            return Result;
        },
    }
    if NotMaskTZ && NotMaskTZ / 8 % MaskedBytes {
        return Result;
    }
    if LD == Chain.getNode() {
        
    } else if operator(Chain).getOpcode() == TokenFactor && SDValue { Node: LD, ResNo: 1 }.hasOneUse() {
        if !LD.isOperandOf(Chain.getNode()) {
            return Result;
        }
    } else {
        return Result;
    }
    Result.first = MaskedBytes;
    Result.second = NotMaskTZ / 8;
    return Result;
}

fn ShrinkLoadReplaceStoreWithStore(MaskInfo: *pair<unsigned int, unsigned int>, IVal: SDValue, St: *mut StoreSDNode, DC: *mut DAGCombiner) -> SDValue {
    let mut NumBytes: u32 = MaskInfo.first;
    let mut ByteShift: u32 = MaskInfo.second;
    let mut DAG: *mut SelectionDAG = DC.getDAG();
    let mut Mask: APInt = operator(getBitsSet(IVal.getValueSizeInBits().operator unsigned long long(), ByteShift * 8, (ByteShift + NumBytes) * 8));
    if !DAG.MaskedValueIsZero(IVal, Mask, 0) {
        return SDValue {};
    }
    let mut VT: MVT = getIntegerVT(NumBytes * 8);
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut UseTruncStore: bool = false;
    if DC.isTypeLegal(EVT { VT }) {
        UseTruncStore = false;
    } else if TLI.isTypeLegal(IVal.getValueType()) && TLI.isTruncStoreLegal(IVal.getValueType(), EVT { VT }, St.getAlign(), St.getAddressSpace()) {
        UseTruncStore = true;
    } else {
        return SDValue {};
    }
    if St.isIndexed() {
        return SDValue {};
    }
    if St.getMemOperand() && !TLI.allowsMemoryAccess(*DAG.getContext(), DAG.getDataLayout(), EVT { VT }, *St.getMemOperand(), null) {
        return SDValue {};
    }
    if ByteShift {
        let mut DL: SDLoc = SDLoc { IVal };
        IVal = DAG.getNode(SRL, DL, IVal.getValueType(), IVal, DAG.getShiftAmountConstant(ByteShift * 8, IVal.getValueType(), DL));
    }
    let mut StOffset: u32 = 0;
    if DAG.getDataLayout().isLittleEndian() {
        StOffset = ByteShift;
    } else {
        StOffset = IVal.getValueType().getStoreSize().operator unsigned long long() - ByteShift - NumBytes;
    }
    let mut Ptr: SDValue = St.getBasePtr();
    if StOffset {
        let mut DL: SDLoc = SDLoc { IVal };
        Ptr = DAG.getMemBasePlusOffset(Ptr, getFixed(StOffset), DL, SDNodeFlags { Flags: None });
    }
    operator(OpsNarrowed);
    if UseTruncStore {
        return DAG.getTruncStore(St.getChain(), SDLoc { St }, IVal, Ptr, St.getPointerInfo().getWithOffset(StOffset), EVT { VT }, St.getBaseAlign(), MONone, MMOMetadata {});
    }
    IVal = DAG.getNode(TRUNCATE, SDLoc { IVal }, EVT { VT }, IVal);
    return DAG.getStore(St.getChain(), SDLoc { St }, IVal, Ptr, St.getPointerInfo().getWithOffset(StOffset), St.getBaseAlign(), MONone, MMOMetadata {});
}

fn DAGCombiner::ReduceLoadOpStoreWidth(self, N: *mut SDNode) -> SDValue {
    let mut ST: *mut StoreSDNode = cast(N);
    if !ST.isSimple() {
        return SDValue {};
    }
    let mut Chain: SDValue = ST.getChain();
    let mut Value: SDValue = ST.getValue();
    let mut Ptr: SDValue = ST.getBasePtr();
    let mut VT: EVT = Value.getValueType();
    if ST.isTruncatingStore() || VT.isVector() {
        return SDValue {};
    }
    let mut Opc: u32 = Value.getOpcode();
    if (Opc != OR && Opc != XOR && Opc != AND) || !Value.hasOneUse() {
        return SDValue {};
    }
    if Opc == OR && EnableShrinkLoadReplaceStoreWithStore {
        let mut MaskedLoad: pair<unsigned int, unsigned int> = pair<unsigned int, unsigned int> {};
        MaskedLoad = CheckForMaskedLoad(Value.getOperand(0), Ptr, Chain);
        if MaskedLoad.first {
            if ShrinkLoadReplaceStoreWithStore(MaskedLoad, Value.getOperand(1), ST, self) {
                NewST;
            } else {
                return NewST;
            }
        }
        MaskedLoad = CheckForMaskedLoad(Value.getOperand(1), Ptr, Chain);
        if MaskedLoad.first {
            if ShrinkLoadReplaceStoreWithStore(MaskedLoad, Value.getOperand(0), ST, self) {
                NewST;
            } else {
                return NewST;
            }
        }
    }
    if !EnableReduceLoadOpStoreWidth {
        return SDValue {};
    }
    if Value.getOperand(1).getOpcode() != Constant {
        return SDValue {};
    }
    let mut N0: SDValue = Value.getOperand(0);
    if isNormalLoad(N0.getNode()) && N0.hasOneUse() && Chain == SDValue { Node: N0.getNode(), ResNo: 1 } {
        let mut LD: *mut LoadSDNode = cast(N0);
        if LD.getBasePtr() != Ptr || LD.getPointerInfo().getAddrSpace() != ST.getPointerInfo().getAddrSpace() {
            return SDValue {};
        }
        let mut N1: SDValue = Value.getOperand(1);
        let mut BitWidth: u32 = N1.getValueSizeInBits().operator unsigned long long();
        let mut Imm: APInt = operator(N1).getAsAPIntVal();
        if Opc == AND {
            Imm.flipAllBits();
        }
        if Imm == 0 || Imm.isAllOnes() {
            return SDValue {};
        }
        let mut BitsPerByteMask: u32 = 7;
        let mut LSB: u32 = Imm.countr_zero() & ~BitsPerByteMask;
        let mut MSB: u32 = (Imm.getActiveBits() - 1) | BitsPerByteMask;
        let mut NewBW: u32 = NextPowerOf2(MSB - LSB);
        let mut NewVT: EVT = getIntegerVT(*self.DAG.getContext(), NewBW);
        while NewBW < BitWidth && (NewVT.getStoreSizeInBits().operator unsigned long long() != NewBW || !self.TLI.isOperationLegalOrCustom(Opc, NewVT, false) || (!ReduceLoadOpStoreWidthForceNarrowingProfitable && !self.TLI.isNarrowingProfitable(N, VT, NewVT))) {
            NewBW = NextPowerOf2(NewBW);
            NewVT = getIntegerVT(*self.DAG.getContext(), NewBW);
        }
        if NewBW >= BitWidth {
            return SDValue {};
        }
        let mut VTStoreSize: u32 = VT.getStoreSizeInBits().getFixedValue();
        let mut ShAmt: u32 = 0;
        let mut PtrOff: u64 = 0;
        for ; ShAmt + NewBW <= VTStoreSize; ShAmt += 8 {
            if ShAmt > LSB {
                return SDValue {};
            }
            if ShAmt + NewBW < MSB {
                continue;
            }
            let mut PtrAdjustmentInBits: u32 = if self.DAG.getDataLayout().isBigEndian() { VTStoreSize - NewBW - ShAmt } else { ShAmt };
            PtrOff = PtrAdjustmentInBits / 8;
            let mut IsFast: u32 = 0;
            let mut NewAlign: Align = commonAlignment(LD.getAlign(), PtrOff);
            if self.TLI.allowsMemoryAccess(*self.DAG.getContext(), self.DAG.getDataLayout(), NewVT, LD.getAddressSpace(), NewAlign, LD.getMemOperand().getFlags(), &mut IsFast) && IsFast {
                break;
            }
        }
        if ShAmt + NewBW > VTStoreSize {
            return SDValue {};
        }
        let mut NewImm: APInt = Imm.lshr(ShAmt).trunc(NewBW);
        if Opc == AND {
            NewImm.flipAllBits();
        }
        let mut NewAlign: Align = commonAlignment(LD.getAlign(), PtrOff);
        let mut NewPtr: SDValue = self.DAG.getMemBasePlusOffset(Ptr, getFixed(PtrOff), SDLoc { LD }, SDNodeFlags { Flags: None });
        let mut NewLD: SDValue = self.DAG.getLoad(NewVT, SDLoc { N0 }, LD.getChain(), NewPtr, LD.getPointerInfo().getWithOffset(PtrOff), MaybeAlign { NewAlign }, LD.getMemOperand().getFlags(), MMOMetadata { AAInfo: LD.getAAInfo(), Ranges: null, MemCacheHint: null });
        let mut NewVal: SDValue = self.DAG.getNode(Opc, SDLoc { Value }, NewVT, NewLD, self.DAG.getConstant(NewImm, SDLoc { Value }, NewVT, false, false));
        let mut NewST: SDValue = self.DAG.getStore(Chain, SDLoc { N }, NewVal, NewPtr, ST.getPointerInfo().getWithOffset(PtrOff), NewAlign, MONone, MMOMetadata {});
        self.AddToWorklist(NewPtr.getNode(), true, false);
        self.AddToWorklist(NewLD.getNode(), true, false);
        self.AddToWorklist(NewVal.getNode(), true, false);
        let mut DeadNodes: WorklistRemover = WorklistRemover { DC: *self };
        self.DAG.ReplaceAllUsesOfValueWith(N0.getValue(1), NewLD.getValue(1));
        operator(OpsNarrowed);
        return NewST;
    }
    return SDValue {};
}

fn DAGCombiner::TransformFPLoadStorePair(self, N: *mut SDNode) -> SDValue {
    let mut ST: *mut StoreSDNode = cast(N);
    let mut Value: SDValue = ST.getValue();
    if isNormalStore(ST) && isNormalLoad(Value.getNode()) && Value.hasOneUse() {
        let mut LD: *mut LoadSDNode = cast(Value);
        let mut VT: EVT = LD.getMemoryVT();
        if !VT.isSimple() || !VT.isFloatingPoint() || VT != ST.getMemoryVT() || LD.isNonTemporal() || ST.isNonTemporal() || LD.getPointerInfo().getAddrSpace() != 0 || ST.getPointerInfo().getAddrSpace() != 0 {
            return SDValue {};
        }
        let mut VTSize: TypeSize = VT.getSizeInBits();
        if VTSize.isScalable() {
            return SDValue {};
        }
        let mut FastLD: u32 = 0;
        let mut FastST: u32 = 0;
        let mut IntVT: EVT = getIntegerVT(*self.DAG.getContext(), VTSize.getFixedValue());
        if !self.TLI.isOperationLegal(LOAD, IntVT) || !self.TLI.isOperationLegal(STORE, IntVT) || !self.TLI.isDesirableToTransformToIntegerOp(LOAD, VT) || !self.TLI.isDesirableToTransformToIntegerOp(STORE, VT) || !self.TLI.allowsMemoryAccess(*self.DAG.getContext(), self.DAG.getDataLayout(), IntVT, *LD.getMemOperand(), &mut FastLD) || !self.TLI.allowsMemoryAccess(*self.DAG.getContext(), self.DAG.getDataLayout(), IntVT, *ST.getMemOperand(), &mut FastST) || !FastLD || !FastST {
            return SDValue {};
        }
        let mut NewLD: SDValue = self.DAG.getLoad(IntVT, SDLoc { Value }, LD.getChain(), LD.getBasePtr(), LD.getMemOperand());
        let mut NewST: SDValue = self.DAG.getStore(ST.getChain(), SDLoc { N }, NewLD, ST.getBasePtr(), ST.getMemOperand());
        self.AddToWorklist(NewLD.getNode(), true, false);
        self.AddToWorklist(NewST.getNode(), true, false);
        let mut DeadNodes: WorklistRemover = WorklistRemover { DC: *self };
        self.DAG.ReplaceAllUsesOfValueWith(Value.getValue(1), NewLD.getValue(1));
        operator(LdStFP2Int);
        return NewST;
    }
    return SDValue {};
}

fn DAGCombiner::isMulAddWithConstProfitable(self, MulNode: *mut SDNode, AddNode: SDValue, ConstNode: SDValue) -> bool {
    if operator(AddNode).hasOneUse() && self.TLI.isMulAddWithConstProfitable(AddNode, ConstNode) {
        return true;
    }
    for User in operator(ConstNode).users() {
        if User == MulNode {
            continue;
        }
        if User.getOpcode() == MUL {
            let mut OtherOp: *mut SDNode = null;
            let mut MulVar: *mut SDNode = AddNode.getOperand(0).getNode();
            if User.getOperand(0) == ConstNode {
                OtherOp = User.getOperand(1).getNode();
            } else {
                OtherOp = User.getOperand(0).getNode();
            }
            if OtherOp == MulVar {
                return true;
            }
            if OtherOp.getOpcode() == ADD && self.DAG.isConstantIntBuildVectorOrConstantInt(OtherOp.getOperand(1), true) && OtherOp.getOperand(0).getNode() == MulVar {
                return true;
            }
        }
    }
    return false;
}

fn DAGCombiner::getMergeStoreChains(self, StoreNodes: *mut SmallVectorImpl<MemOpLink>, NumStores: u32) -> SDValue {
    let mut Chains: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut Visited: SmallPtrSet<const SDNode *, 8> = SmallPtrSet<const SDNode *, 8> {};
    let mut StoreDL: SDLoc = SDLoc { StoreNodes[0].MemNode };
    for let mut i: u32 = 0; i < NumStores; i += 1 {
        Visited.insert(StoreNodes[i].MemNode);
    }
    for let mut i: u32 = 0; i < NumStores; i += 1 {
        if Visited.insert(StoreNodes[i].MemNode.getChain().getNode()).second {
            Chains.push(ValueParamT { StoreNodes[i].MemNode.getChain() });
        }
    }
    assert!(!Chains.is_empty(), "Chain should have generated a chain");
    return self.DAG.getTokenFactor(StoreDL, Chains);
}

fn DAGCombiner::hasSameUnderlyingObj(self, StoreNodes: ArrayRef<MemOpLink>) -> bool {
    let mut UnderlyingObj: *Value = null;
    for MemOp in StoreNodes {
        let mut MMO: *MachineMemOperand = MemOp.MemNode.getMemOperand();
        if MMO.getPseudoValue() {
            return false;
        }
        if !MMO.getValue() {
            return false;
        }
        let mut Obj: *Value = getUnderlyingObject(MMO.getValue(), MaxLookupSearchDepth, false);
        if UnderlyingObj && UnderlyingObj != Obj {
            return false;
        }
        if !UnderlyingObj {
            UnderlyingObj = Obj;
        }
    }
    return true;
}

fn DAGCombiner::mergeStoresOfConstantsOrVecElts(self, StoreNodes: *mut SmallVectorImpl<MemOpLink>, MemVT: EVT, NumStores: u32, IsConstantSrc: bool, UseVector: bool, UseTrunc: bool) -> bool {
    if NumStores < 2 {
        return false;
    }
    assert!((!UseTrunc || !UseVector), "This optimization cannot emit a vector truncating store");
    let mut DL: SDLoc = SDLoc { StoreNodes[0].MemNode };
    let mut ElementSizeBits: TypeSize = MemVT.getStoreSizeInBits();
    let mut SizeInBits: u32 = NumStores * ElementSizeBits.operator unsigned long long();
    let mut NumMemElts: u32 = if MemVT.isVector() { MemVT.getVectorNumElements() } else { 1 };
    let mut Flags: Flags> = Flags> {};
    let mut AAInfo: AAMDNodes = AAMDNodes {};
    for let mut I: u32 = 0; I != NumStores; I += 1 {
        let mut St: *mut StoreSDNode = cast(StoreNodes[I].MemNode);
        if !Flags {
            Flags = Flags> { St.getMemOperand().getFlags() };
            AAInfo = St.getAAInfo();
            continue;
        }
        if Flags != St.getMemOperand().getFlags() {
            return false;
        }
        AAInfo = AAInfo.concat(St.getAAInfo());
    }
    let mut StoreTy: EVT = EVT {};
    if UseVector {
        let mut Elts: u32 = NumStores * NumMemElts;
        StoreTy = getVectorVT(*self.DAG.getContext(), MemVT.getScalarType(), Elts, false);
    } else {
        StoreTy = getIntegerVT(*self.DAG.getContext(), SizeInBits);
    }
    let mut StoredVal: SDValue = SDValue {};
    if UseVector {
        if IsConstantSrc {
            let mut BuildVector: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
            for let mut I: u32 = 0; I != NumStores; I += 1 {
                let mut St: *mut StoreSDNode = cast(StoreNodes[I].MemNode);
                let mut Val: SDValue = St.getValue();
                if MemVT != Val.getValueType() {
                    Val = peekThroughBitcasts(Val);
                    if ElementSizeBits != Val.getValueSizeInBits() {
                        let mut C: *mut ConstantSDNode = dyn_cast(Val);
                        if !C {
                            return false;
                        }
                        let mut IntMemVT: EVT = getIntegerVT(*self.DAG.getContext(), MemVT.getSizeInBits().operator unsigned long long());
                        Val = self.DAG.getConstant(C.getAPIntValue().zextOrTrunc(Val.getValueSizeInBits().operator unsigned long long()).zextOrTrunc(ElementSizeBits.operator unsigned long long()), SDLoc { C }, IntMemVT, false, false);
                    }
                    Val = self.DAG.getBitcast(MemVT, Val);
                }
                BuildVector.push(ValueParamT { Val });
            }
            StoredVal = self.DAG.getNode(if MemVT.isVector() { CONCAT_VECTORS } else { BUILD_VECTOR }, DL, StoreTy, ArrayRef<SDValue> { BuildVector });
        } else {
            let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
            for let mut i: u32 = 0; i < NumStores; i += 1 {
                let mut St: *mut StoreSDNode = cast(StoreNodes[i].MemNode);
                let mut Val: SDValue = peekThroughBitcasts(St.getValue());
                if (MemVT != Val.getValueType()) && (Val.getOpcode() == EXTRACT_VECTOR_ELT || Val.getOpcode() == EXTRACT_SUBVECTOR) {
                    let mut MemVTScalarTy: EVT = MemVT.getScalarType();
                    if MemVTScalarTy != Val.getValueType().getScalarType() {
                        Val = self.DAG.getBitcast(MemVT, Val);
                    } else if MemVT.isVector() && Val.getOpcode() == EXTRACT_VECTOR_ELT {
                        Val = self.DAG.getNode(BUILD_VECTOR, DL, MemVT, Val);
                    } else {
                        let mut OpC: u32 = if MemVT.isVector() { EXTRACT_SUBVECTOR } else { EXTRACT_VECTOR_ELT };
                        let mut Vec: SDValue = Val.getOperand(0);
                        let mut Idx: SDValue = Val.getOperand(1);
                        Val = self.DAG.getNode(OpC, SDLoc { Val }, MemVT, Vec, Idx);
                    }
                }
                Ops.push(ValueParamT { Val });
            }
            StoredVal = self.DAG.getNode(if MemVT.isVector() { CONCAT_VECTORS } else { BUILD_VECTOR }, DL, StoreTy, ArrayRef<SDValue> { Ops });
        }
    } else {
        assert!(IsConstantSrc, "Merged vector elements should use vector store");
        let mut StoreInt: APInt = APInt { SizeInBits, 0, false, false };
        let mut IsLE: bool = self.DAG.getDataLayout().isLittleEndian();
        for let mut i: u32 = 0; i < NumStores; i += 1 {
            let mut Idx: u32 = if IsLE { (NumStores - 1 - i) } else { i };
            let mut St: *mut StoreSDNode = cast(StoreNodes[Idx].MemNode);
            let mut Val: SDValue = St.getValue();
            Val = peekThroughBitcasts(Val);
            operator(StoreInt, ElementSizeBits.operator unsigned long long());
            if dyn_cast(Val) {
                C;
            } else {
                operator(StoreInt, C.getAPIntValue().zextOrTrunc(ElementSizeBits.operator unsigned long long()).zextOrTrunc(SizeInBits));
            }
        }
        StoredVal = self.DAG.getConstant(StoreInt, DL, StoreTy, false, false);
    }
    let mut FirstInChain: *mut LSBaseSDNode = StoreNodes[0].MemNode;
    let mut NewChain: SDValue = self.getMergeStoreChains(StoreNodes, NumStores);
    let mut CanReusePtrInfo: bool = self.hasSameUnderlyingObj(ArrayRef<MemOpLink> { StoreNodes });
    let mut NewStore: SDValue = SDValue {};
    if !UseTrunc {
        NewStore = self.DAG.getStore(NewChain, DL, StoredVal, FirstInChain.getBasePtr(), if CanReusePtrInfo { FirstInChain.getPointerInfo() } else { MachinePointerInfo { FirstInChain.getPointerInfo().getAddrSpace(), 0 } }, FirstInChain.getAlign(), operator(Flags), MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
    } else {
        let mut LegalizedStoredValTy: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), StoredVal.getValueType());
        let mut LegalizedStoreSize: u32 = LegalizedStoredValTy.getSizeInBits().operator unsigned long long();
        let mut C: *mut ConstantSDNode = cast(StoredVal);
        let mut ExtendedStoreVal: SDValue = self.DAG.getConstant(C.getAPIntValue().zextOrTrunc(LegalizedStoreSize), DL, LegalizedStoredValTy, false, false);
        NewStore = self.DAG.getTruncStore(NewChain, DL, ExtendedStoreVal, FirstInChain.getBasePtr(), if CanReusePtrInfo { FirstInChain.getPointerInfo() } else { MachinePointerInfo { FirstInChain.getPointerInfo().getAddrSpace(), 0 } }, StoredVal.getValueType(), FirstInChain.getAlign(), operator(Flags), MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
    }
    for let mut i: u32 = 0; i < NumStores; i += 1 {
        self.CombineTo(StoreNodes[i].MemNode, NewStore, true);
    }
    self.AddToWorklist(NewChain.getNode(), true, false);
    return true;
}

fn DAGCombiner::getStoreMergeCandidates(self, St: *mut StoreSDNode, StoreNodes: *mut SmallVectorImpl<MemOpLink>) -> *mut SDNode {
    let mut BasePtr: BaseIndexOffset = match(St, self.DAG);
    if !BasePtr.getBase().getNode() || BasePtr.getBase().isUndef() {
        return null;
    }
    let mut Val: SDValue = peekThroughBitcasts(St.getValue());
    let mut StoreSrc: StoreSource = self.getStoreSource(Val);
    assert!(StoreSrc != Unknown, "Expected known source for store");
    let mut MemVT: EVT = St.getMemoryVT();
    let mut LBasePtr: BaseIndexOffset = BaseIndexOffset {};
    let mut LoadVT: EVT = EVT {};
    if StoreSrc == Load {
        let mut Ld: *mut LoadSDNode = cast(Val);
        LBasePtr = match(Ld, self.DAG);
        LoadVT = Ld.getMemoryVT();
        if MemVT != LoadVT {
            return null;
        }
        if !Ld.hasNUsesOfValue(1, 0) {
            return null;
        }
        if !Ld.isSimple() || Ld.isIndexed() {
            return null;
        }
    }
    let mut CandidateMatch: Closure_79 = Closure_79 { St: &mut St, cap_1: self, MemVT: &mut MemVT, StoreSrc: &mut StoreSrc, LoadVT: &mut LoadVT, Val: &mut Val, LBasePtr: &mut LBasePtr, BasePtr: &mut BasePtr };
    let mut RootNode: *mut SDNode = St.getChain().getNode();
    if self.ChainsWithoutMergeableStores.contains(RootNode) {
        return null;
    }
    let mut OverLimitInDependenceCheck: Closure_80 = Closure_80 { cap_0: self };
    let mut TryToAddCandidate: Closure_81 = Closure_81 { CandidateMatch: &mut CandidateMatch, OverLimitInDependenceCheck: &mut OverLimitInDependenceCheck, RootNode: &mut RootNode, StoreNodes: &mut StoreNodes };
    let mut NumNodesExplored: u32 = 0;
    let mut MaxSearchNodes: u32 = 1024;
    if dyn_cast(RootNode) {
        Ldn;
    } else {
        RootNode = Ldn.getChain().getNode();
        if self.ChainsWithoutMergeableStores.contains(RootNode) {
            return null;
        }
        for let mut I: use_iterator = RootNode.use_begin();
let mut E: use_iterator = RootNode.use_end(); I != E && NumNodesExplored < MaxSearchNodes; operator(I) , NumNodesExplored += 1 {
            let mut User: *mut SDNode = operator(I).getUser();
            if operator(I).getOperandNo() == 0 && isa(User) {
                for U2 in User.uses() {
                    TryToAddCandidate.call(U2);
                }
            }
            if operator(I).getOperandNo() == 0 && isa(User) {
                TryToAddCandidate.call(operator(I));
            }
        }
    }
    return RootNode;
}

fn DAGCombiner::checkMergeStoreCandidatesForDependencies(self, StoreNodes: *mut SmallVectorImpl<MemOpLink>, NumStores: u32, RootNode: *mut SDNode) -> bool {
    let mut Visited: SmallPtrSet<const SDNode *, 32> = SmallPtrSet<const SDNode *, 32> {};
    let mut Worklist: SmallVector<const SDNode *, 8> = SmallVector<const SDNode *, 8> {};
    Worklist.push(RootNode);
    while !Worklist.is_empty() {
        let mut N: *SDNode = Worklist.pop_back_val();
        if !Visited.insert(N).second {
            continue;
        }
        if N.getOpcode() == TokenFactor {
            for Op in N.ops() {
                Worklist.push(Op.getNode());
            }
        }
    }
    let mut Max: u32 = 1024 + Visited.len;
    for let mut i: u32 = 0; i < NumStores; i += 1 {
        let mut N: *mut SDNode = StoreNodes[i].MemNode;
        for Op in N.op_values() {
            Worklist.push(Op.getNode());
        }
    }
    for let mut i: u32 = 0; i < NumStores; i += 1 {
        if hasPredecessorHelper(StoreNodes[i].MemNode, Visited, Worklist, Max, false) {
            if Visited.len >= Max {
                let mut RootCount: *mut SDNode *, unsigned int> = self.StoreRootCountMap[StoreNodes[i].MemNode];
                if RootCount.first == RootNode {
                    RootCount.second += 1;
                } else {
                    RootCount = SDNode *, unsigned int> { RootNode, 1 };
                }
            }
            return false;
        }
    }
    return true;
}

fn DAGCombiner::hasCallInLdStChain(self, St: *mut StoreSDNode, Ld: *mut LoadSDNode) -> bool {
    let mut Visited: SmallPtrSet<const SDNode *, 32> = SmallPtrSet<const SDNode *, 32> {};
    let mut Worklist: pair<const SDNode *, bool>, 8> = pair<const SDNode *, bool>, 8> {};
    Worklist.emplace_back(St.getChain().getNode(), false);
    while !Worklist.is_empty() {
        if !Visited.insert(Node).second || Node.getNumOperands() == 0 {
            continue;
        }
        match Node.getOpcode() {
            CALLSEQ_END => {
                Worklist.emplace_back(Node.getOperand(0).getNode(), true);
            },
            TokenFactor => {
                for Op in Node.ops() {
                    Worklist.emplace_back(Op.getNode(), FoundCall);
                }
            },
            LOAD => {
                if Node == Ld {
                    return FoundCall;
                }
            },
            _ => {
                assert!(Node.getOperand(0).getValueType() == EVT { Other }, "Invalid chain type");
            },
        }
    }
    return false;
}

fn DAGCombiner::getConsecutiveStores(self: *DAGCombiner, StoreNodes: *mut SmallVectorImpl<MemOpLink>, ElementSizeBytes: i64) -> u32 {
    while true {
        let mut StartIdx: u64 = 0;
        while (StartIdx + 1 < StoreNodes.len) && StoreNodes[StartIdx].OffsetFromBase + ElementSizeBytes != StoreNodes[StartIdx + 1].OffsetFromBase {
            StartIdx += 1;
        }
        if StartIdx + 1 >= StoreNodes.len {
            return 0;
        }
        if StartIdx {
            StoreNodes.erase(StoreNodes.begin(), StoreNodes.begin() + StartIdx);
        }
        let mut NumConsecutiveStores: u32 = 1;
        let mut StartAddress: i64 = StoreNodes[0].OffsetFromBase;
        for let mut i: u32 = 1;
let mut e: u32 = StoreNodes.len; i < e; i += 1 {
            let mut CurrAddress: i64 = StoreNodes[i].OffsetFromBase;
            if CurrAddress - StartAddress != (ElementSizeBytes * i) {
                break;
            }
            NumConsecutiveStores = i + 1;
        }
        if NumConsecutiveStores > 1 {
            return NumConsecutiveStores;
        }
        StoreNodes.erase(StoreNodes.begin(), StoreNodes.begin() + 1);
    }
}

fn DAGCombiner::tryStoreMergeOfConstants(self, StoreNodes: *mut SmallVectorImpl<MemOpLink>, NumConsecutiveStores: u32, MemVT: EVT, RootNode: *mut SDNode, AllowVectors: bool) -> bool {
    let mut Context: *mut LLVMContext = *self.DAG.getContext();
    let mut DL: *DataLayout = self.DAG.getDataLayout();
    let mut ElementSizeBytes: i64 = MemVT.getStoreSize().operator unsigned long long();
    let mut NumMemElts: u32 = if MemVT.isVector() { MemVT.getVectorNumElements() } else { 1 };
    let mut MadeChange: bool = false;
    while NumConsecutiveStores >= 2 {
        let mut FirstInChain: *mut LSBaseSDNode = StoreNodes[0].MemNode;
        let mut FirstStoreAS: u32 = FirstInChain.getAddressSpace();
        let mut FirstStoreAlign: Align = FirstInChain.getAlign();
        let mut LastLegalType: u32 = 1;
        let mut LastLegalVectorType: u32 = 1;
        let mut LastIntegerTrunc: bool = false;
        let mut NonZero: bool = false;
        let mut FirstZeroAfterNonZero: u32 = NumConsecutiveStores;
        for let mut i: u32 = 0; i < NumConsecutiveStores; i += 1 {
            let mut ST: *mut StoreSDNode = cast(StoreNodes[i].MemNode);
            let mut StoredVal: SDValue = ST.getValue();
            let mut IsElementZero: bool = false;
            if dyn_cast(StoredVal) {
                C;
            } else {
                IsElementZero = C.isZero();
            }
            if IsElementZero {
                if NonZero && FirstZeroAfterNonZero == NumConsecutiveStores {
                    FirstZeroAfterNonZero = i;
                }
            }
            NonZero |= !IsElementZero;
            let mut SizeInBits: u32 = (i + 1) * ElementSizeBytes * 8;
            let mut StoreTy: EVT = getIntegerVT(Context, SizeInBits);
            let mut IsFast: u32 = 0;
            if StoreTy.getSizeInBits().operator unsigned long long() > self.TLI.getMaximumLegalStoreInBits() {
                break;
            }
            if self.TLI.isTypeLegal(StoreTy) && self.TLI.canMergeStoresTo(FirstStoreAS, StoreTy, self.DAG.getMachineFunction()) && self.TLI.allowsMemoryAccess(Context, DL, StoreTy, *FirstInChain.getMemOperand(), &mut IsFast) && IsFast {
                LastIntegerTrunc = false;
                LastLegalType = i + 1;
            } else if self.TLI.getTypeAction(Context, StoreTy) == TypePromoteInteger {
                let mut LegalizedStoredValTy: EVT = self.TLI.getTypeToTransformTo(Context, StoredVal.getValueType());
                if self.TLI.isTruncStoreLegal(LegalizedStoredValTy, StoreTy, FirstStoreAlign, FirstStoreAS) && self.TLI.canMergeStoresTo(FirstStoreAS, LegalizedStoredValTy, self.DAG.getMachineFunction()) && self.TLI.allowsMemoryAccess(Context, DL, StoreTy, *FirstInChain.getMemOperand(), &mut IsFast) && IsFast {
                    LastIntegerTrunc = true;
                    LastLegalType = i + 1;
                }
            }
            if self.TLI.storeOfVectorConstantIsCheap(!NonZero, MemVT, i + 1, FirstStoreAS) && AllowVectors {
                let mut Elts: u32 = (i + 1) * NumMemElts;
                let mut Ty: EVT = getVectorVT(Context, MemVT.getScalarType(), Elts, false);
                if self.TLI.isTypeLegal(Ty) && self.TLI.isTypeLegal(MemVT) && self.TLI.canMergeStoresTo(FirstStoreAS, Ty, self.DAG.getMachineFunction()) && self.TLI.allowsMemoryAccess(Context, DL, Ty, *FirstInChain.getMemOperand(), &mut IsFast) && IsFast {
                    LastLegalVectorType = i + 1;
                }
            }
        }
        let mut UseVector: bool = (LastLegalVectorType > LastLegalType) && AllowVectors;
        let mut NumElem: u32 = if (UseVector) { LastLegalVectorType } else { LastLegalType };
        let mut UseTrunc: bool = LastIntegerTrunc && !UseVector;
        if NumElem < 2 {
            let mut NumSkip: u32 = 1;
            while (NumSkip < NumConsecutiveStores) && (NumSkip < FirstZeroAfterNonZero) && (StoreNodes[NumSkip].MemNode.getAlign() <= FirstStoreAlign) {
                NumSkip += 1;
            }
            StoreNodes.erase(StoreNodes.begin(), StoreNodes.begin() + NumSkip);
            NumConsecutiveStores -= NumSkip;
            continue;
        }
        if !self.checkMergeStoreCandidatesForDependencies(StoreNodes, NumElem, RootNode) {
            StoreNodes.erase(StoreNodes.begin(), StoreNodes.begin() + NumElem);
            NumConsecutiveStores -= NumElem;
            continue;
        }
        MadeChange |= self.mergeStoresOfConstantsOrVecElts(StoreNodes, MemVT, NumElem, true, UseVector, UseTrunc);
        StoreNodes.erase(StoreNodes.begin(), StoreNodes.begin() + NumElem);
        NumConsecutiveStores -= NumElem;
    }
    return MadeChange;
}

fn DAGCombiner::tryStoreMergeOfExtracts(self, StoreNodes: *mut SmallVectorImpl<MemOpLink>, NumConsecutiveStores: u32, MemVT: EVT, RootNode: *mut SDNode) -> bool {
    let mut Context: *mut LLVMContext = *self.DAG.getContext();
    let mut DL: *DataLayout = self.DAG.getDataLayout();
    let mut NumMemElts: u32 = if MemVT.isVector() { MemVT.getVectorNumElements() } else { 1 };
    let mut MadeChange: bool = false;
    while NumConsecutiveStores >= 2 {
        let mut FirstInChain: *mut LSBaseSDNode = StoreNodes[0].MemNode;
        let mut FirstStoreAS: u32 = FirstInChain.getAddressSpace();
        let mut FirstStoreAlign: Align = FirstInChain.getAlign();
        let mut NumStoresToMerge: u32 = 1;
        for let mut i: u32 = 0; i < NumConsecutiveStores; i += 1 {
            let mut Elts: u32 = (i + 1) * NumMemElts;
            let mut Ty: EVT = getVectorVT(*self.DAG.getContext(), MemVT.getScalarType(), Elts, false);
            let mut IsFast: u32 = 0;
            if Ty.getSizeInBits().operator unsigned long long() > self.TLI.getMaximumLegalStoreInBits() {
                break;
            }
            if self.TLI.isTypeLegal(Ty) && self.TLI.canMergeStoresTo(FirstStoreAS, Ty, self.DAG.getMachineFunction()) && self.TLI.allowsMemoryAccess(Context, DL, Ty, *FirstInChain.getMemOperand(), &mut IsFast) && IsFast {
                NumStoresToMerge = i + 1;
            }
        }
        if NumStoresToMerge < 2 {
            let mut NumSkip: u32 = 1;
            while (NumSkip < NumConsecutiveStores) && (StoreNodes[NumSkip].MemNode.getAlign() <= FirstStoreAlign) {
                NumSkip += 1;
            }
            StoreNodes.erase(StoreNodes.begin(), StoreNodes.begin() + NumSkip);
            NumConsecutiveStores -= NumSkip;
            continue;
        }
        if !self.checkMergeStoreCandidatesForDependencies(StoreNodes, NumStoresToMerge, RootNode) {
            StoreNodes.erase(StoreNodes.begin(), StoreNodes.begin() + NumStoresToMerge);
            NumConsecutiveStores -= NumStoresToMerge;
            continue;
        }
        MadeChange |= self.mergeStoresOfConstantsOrVecElts(StoreNodes, MemVT, NumStoresToMerge, false, true, false);
        StoreNodes.erase(StoreNodes.begin(), StoreNodes.begin() + NumStoresToMerge);
        NumConsecutiveStores -= NumStoresToMerge;
    }
    return MadeChange;
}

fn DAGCombiner::tryStoreMergeOfLoads(self, StoreNodes: *mut SmallVectorImpl<MemOpLink>, NumConsecutiveStores: u32, MemVT: EVT, RootNode: *mut SDNode, AllowVectors: bool, IsNonTemporalStore: bool, IsNonTemporalLoad: bool) -> bool {
    let mut Context: *mut LLVMContext = *self.DAG.getContext();
    let mut DL: *DataLayout = self.DAG.getDataLayout();
    let mut ElementSizeBytes: i64 = MemVT.getStoreSize().operator unsigned long long();
    let mut NumMemElts: u32 = if MemVT.isVector() { MemVT.getVectorNumElements() } else { 1 };
    let mut MadeChange: bool = false;
    let mut LoadNodes: SmallVector<MemOpLink, 8> = SmallVector<MemOpLink, 8> {};
    let mut LdBasePtr: BaseIndexOffset = BaseIndexOffset {};
    for let mut i: u32 = 0; i < NumConsecutiveStores; i += 1 {
        let mut St: *mut StoreSDNode = cast(StoreNodes[i].MemNode);
        let mut Val: SDValue = peekThroughBitcasts(St.getValue());
        let mut Ld: *mut LoadSDNode = cast(Val);
        let mut LdPtr: BaseIndexOffset = match(Ld, self.DAG);
        let mut LdOffset: i64 = 0;
        if LdBasePtr.getBase().getNode() {
            if !LdBasePtr.equalBaseIndex(LdPtr, self.DAG, LdOffset) {
                break;
            }
        } else {
            LdBasePtr = LdPtr;
        }
        LoadNodes.push(MemOpLink { Ld, LdOffset });
    }
    while NumConsecutiveStores >= 2 && LoadNodes.len >= 2 {
        let mut RequiredAlignment: Align = Align {};
        let mut NeedRotate: bool = false;
        if LoadNodes.len == 2 {
            if self.TLI.hasPairedLoad(MemVT, RequiredAlignment) && StoreNodes[0].MemNode.getAlign() >= RequiredAlignment {
                StoreNodes.erase(StoreNodes.begin(), StoreNodes.begin() + 2);
                LoadNodes.erase(LoadNodes.begin(), LoadNodes.begin() + 2);
                break;
            }
            let mut Offset0: i64 = LoadNodes[0].OffsetFromBase;
            let mut Offset1: i64 = LoadNodes[1].OffsetFromBase;
            let mut PairVT: EVT = getIntegerVT(Context, ElementSizeBytes * 8 * 2);
            if Offset0 - Offset1 == ElementSizeBytes && (self.hasOperation(ROTL, PairVT) || self.hasOperation(ROTR, PairVT)) {
                swap(LoadNodes[0], LoadNodes[1]);
                NeedRotate = true;
            }
        }
        let mut FirstInChain: *mut LSBaseSDNode = StoreNodes[0].MemNode;
        let mut FirstStoreAS: u32 = FirstInChain.getAddressSpace();
        let mut FirstStoreAlign: Align = FirstInChain.getAlign();
        let mut FirstLoad: *mut LoadSDNode = cast(LoadNodes[0].MemNode);
        let mut LastConsecutiveLoad: u32 = 1;
        let mut LastLegalVectorType: u32 = 1;
        let mut LastLegalIntegerType: u32 = 1;
        let mut isDereferenceable: bool = true;
        let mut DoIntegerTruncate: bool = false;
        let mut StartAddress: i64 = LoadNodes[0].OffsetFromBase;
        let mut LoadChain: SDValue = FirstLoad.getChain();
        for let mut i: u32 = 1; i < LoadNodes.len; i += 1 {
            if LoadNodes[i].MemNode.getChain() != LoadChain {
                break;
            }
            let mut CurrAddress: i64 = LoadNodes[i].OffsetFromBase;
            if CurrAddress - StartAddress != (ElementSizeBytes * i) {
                break;
            }
            LastConsecutiveLoad = i;
            if isDereferenceable && !LoadNodes[i].MemNode.isDereferenceable() {
                isDereferenceable = false;
            }
            let mut Elts: u32 = (i + 1) * NumMemElts;
            let mut StoreTy: EVT = getVectorVT(Context, MemVT.getScalarType(), Elts, false);
            if StoreTy.getSizeInBits().operator unsigned long long() > self.TLI.getMaximumLegalStoreInBits() {
                break;
            }
            let mut IsFastSt: u32 = 0;
            let mut IsFastLd: u32 = 0;
            if !NeedRotate && self.TLI.isTypeLegal(StoreTy) && self.TLI.canMergeStoresTo(FirstStoreAS, StoreTy, self.DAG.getMachineFunction()) && self.TLI.allowsMemoryAccess(Context, DL, StoreTy, *FirstInChain.getMemOperand(), &mut IsFastSt) && IsFastSt && self.TLI.allowsMemoryAccess(Context, DL, StoreTy, *FirstLoad.getMemOperand(), &mut IsFastLd) && IsFastLd {
                LastLegalVectorType = i + 1;
            }
            let mut SizeInBits: u32 = (i + 1) * ElementSizeBytes * 8;
            StoreTy = getIntegerVT(Context, SizeInBits);
            if self.TLI.isTypeLegal(StoreTy) && self.TLI.canMergeStoresTo(FirstStoreAS, StoreTy, self.DAG.getMachineFunction()) && self.TLI.allowsMemoryAccess(Context, DL, StoreTy, *FirstInChain.getMemOperand(), &mut IsFastSt) && IsFastSt && self.TLI.allowsMemoryAccess(Context, DL, StoreTy, *FirstLoad.getMemOperand(), &mut IsFastLd) && IsFastLd {
                LastLegalIntegerType = i + 1;
                DoIntegerTruncate = false;
            } else if self.TLI.getTypeAction(Context, StoreTy) == TypePromoteInteger {
                let mut LegalizedStoredValTy: EVT = self.TLI.getTypeToTransformTo(Context, StoreTy);
                if self.TLI.isTruncStoreLegal(LegalizedStoredValTy, StoreTy, FirstStoreAlign, FirstStoreAS) && self.TLI.canMergeStoresTo(FirstStoreAS, LegalizedStoredValTy, self.DAG.getMachineFunction()) && self.TLI.isLoadLegal(LegalizedStoredValTy, StoreTy, FirstLoad.getAlign(), FirstLoad.getAddressSpace(), ZEXTLOAD, false) && self.TLI.isLoadLegal(LegalizedStoredValTy, StoreTy, FirstLoad.getAlign(), FirstLoad.getAddressSpace(), SEXTLOAD, false) && self.TLI.isLoadLegal(LegalizedStoredValTy, StoreTy, FirstLoad.getAlign(), FirstLoad.getAddressSpace(), EXTLOAD, false) && self.TLI.allowsMemoryAccess(Context, DL, StoreTy, *FirstInChain.getMemOperand(), &mut IsFastSt) && IsFastSt && self.TLI.allowsMemoryAccess(Context, DL, StoreTy, *FirstLoad.getMemOperand(), &mut IsFastLd) && IsFastLd {
                    LastLegalIntegerType = i + 1;
                    DoIntegerTruncate = true;
                }
            }
        }
        let mut UseVectorTy: bool = LastLegalVectorType > LastLegalIntegerType && AllowVectors;
        let mut LastLegalType: u32 = if LastLegalVectorType > LastLegalIntegerType { LastLegalVectorType } else { LastLegalIntegerType };
        let mut NumElem: u32 = if NumConsecutiveStores < LastConsecutiveLoad + 1 { NumConsecutiveStores } else { LastConsecutiveLoad + 1 };
        NumElem = if LastLegalType < NumElem { LastLegalType } else { NumElem };
        let mut FirstLoadAlign: Align = FirstLoad.getAlign();
        if NumElem < 2 {
            let mut NumSkip: u32 = 1;
            while (NumSkip < LoadNodes.len) && (LoadNodes[NumSkip].MemNode.getAlign() <= FirstLoadAlign) && (StoreNodes[NumSkip].MemNode.getAlign() <= FirstStoreAlign) {
                NumSkip += 1;
            }
            StoreNodes.erase(StoreNodes.begin(), StoreNodes.begin() + NumSkip);
            LoadNodes.erase(LoadNodes.begin(), LoadNodes.begin() + NumSkip);
            NumConsecutiveStores -= NumSkip;
            continue;
        }
        if !self.checkMergeStoreCandidatesForDependencies(StoreNodes, NumElem, RootNode) {
            StoreNodes.erase(StoreNodes.begin(), StoreNodes.begin() + NumElem);
            LoadNodes.erase(LoadNodes.begin(), LoadNodes.begin() + NumElem);
            NumConsecutiveStores -= NumElem;
            continue;
        }
        let mut JointMemOpVT: EVT = EVT {};
        if UseVectorTy {
            let mut Elts: u32 = NumElem * NumMemElts;
            JointMemOpVT = getVectorVT(Context, MemVT.getScalarType(), Elts, false);
        } else {
            let mut SizeInBits: u32 = NumElem * ElementSizeBytes * 8;
            JointMemOpVT = getIntegerVT(Context, SizeInBits);
        }
        if !self.TLI.shouldMergeStoreOfLoadsOverCall(MemVT, JointMemOpVT) && self.hasCallInLdStChain(cast(StoreNodes[0].MemNode), cast(LoadNodes[0].MemNode)) {
            StoreNodes.erase(StoreNodes.begin(), StoreNodes.begin() + NumElem);
            LoadNodes.erase(LoadNodes.begin(), LoadNodes.begin() + NumElem);
            NumConsecutiveStores -= NumElem;
            continue;
        }
        let mut LoadDL: SDLoc = SDLoc { LoadNodes[0].MemNode };
        let mut StoreDL: SDLoc = SDLoc { StoreNodes[0].MemNode };
        let mut NewStoreChain: SDValue = self.getMergeStoreChains(StoreNodes, NumElem);
        let mut CanReusePtrInfo: bool = self.hasSameUnderlyingObj(ArrayRef<MemOpLink> { StoreNodes });
        self.AddToWorklist(NewStoreChain.getNode(), true, false);
        let mut LdMMOFlags: Flags = if isDereferenceable { MODereferenceable } else { MONone };
        if IsNonTemporalLoad {
            operator(LdMMOFlags, MONonTemporal);
        }
        operator(LdMMOFlags, self.TLI.getTargetMMOFlags(*FirstLoad));
        let mut StMMOFlags: Flags = if IsNonTemporalStore { MONonTemporal } else { MONone };
        operator(StMMOFlags, self.TLI.getTargetMMOFlags(*StoreNodes[0].MemNode));
        let mut NewLoad: SDValue = SDValue {};
        let mut NewStore: SDValue = SDValue {};
        if UseVectorTy || !DoIntegerTruncate {
            NewLoad = self.DAG.getLoad(JointMemOpVT, LoadDL, FirstLoad.getChain(), FirstLoad.getBasePtr(), FirstLoad.getPointerInfo(), MaybeAlign { FirstLoadAlign }, LdMMOFlags, MMOMetadata {});
            let mut StoreOp: SDValue = NewLoad;
            if NeedRotate {
                let mut LoadWidth: u32 = ElementSizeBytes * 8 * 2;
                assert!(JointMemOpVT == getIntegerVT(Context, LoadWidth), "Unexpected type for rotate-able load pair");
                let mut RotAmt: SDValue = self.DAG.getShiftAmountConstant(LoadWidth / 2, JointMemOpVT, LoadDL);
                StoreOp = self.DAG.getNode(ROTL, LoadDL, JointMemOpVT, NewLoad, RotAmt);
            }
            NewStore = self.DAG.getStore(NewStoreChain, StoreDL, StoreOp, FirstInChain.getBasePtr(), if CanReusePtrInfo { FirstInChain.getPointerInfo() } else { MachinePointerInfo { FirstStoreAS, 0 } }, FirstStoreAlign, StMMOFlags, MMOMetadata {});
        } else {
            let mut ExtendedTy: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), JointMemOpVT);
            NewLoad = self.DAG.getExtLoad(EXTLOAD, LoadDL, ExtendedTy, FirstLoad.getChain(), FirstLoad.getBasePtr(), FirstLoad.getPointerInfo(), JointMemOpVT, MaybeAlign { FirstLoadAlign }, LdMMOFlags, MMOMetadata {});
            NewStore = self.DAG.getTruncStore(NewStoreChain, StoreDL, NewLoad, FirstInChain.getBasePtr(), if CanReusePtrInfo { FirstInChain.getPointerInfo() } else { MachinePointerInfo { FirstStoreAS, 0 } }, JointMemOpVT, FirstInChain.getAlign(), FirstInChain.getMemOperand().getFlags(), MMOMetadata {});
        }
        for let mut i: u32 = 0; i < NumElem; i += 1 {
            let mut Ld: *mut LoadSDNode = cast(LoadNodes[i].MemNode);
            self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: Ld, ResNo: 1 }, SDValue { Node: NewLoad.getNode(), ResNo: 1 });
        }
        for let mut i: u32 = 0; i < NumElem; i += 1 {
            let mut Val: SDValue = StoreNodes[i].MemNode.getOperand(1);
            self.CombineTo(StoreNodes[i].MemNode, NewStore, true);
            if operator(Val).use_empty() {
                self.recursivelyDeleteUnusedNodes(Val.getNode());
            }
        }
        MadeChange = true;
        StoreNodes.erase(StoreNodes.begin(), StoreNodes.begin() + NumElem);
        LoadNodes.erase(LoadNodes.begin(), LoadNodes.begin() + NumElem);
        NumConsecutiveStores -= NumElem;
    }
    return MadeChange;
}

fn DAGCombiner::mergeConsecutiveStores(self, St: *mut StoreSDNode) -> bool {
    if self.OptLevel == None || !EnableStoreMerging {
        return false;
    }
    let mut MemVT: EVT = St.getMemoryVT();
    if MemVT.isScalableVT() {
        return false;
    }
    if !MemVT.isSimple() || MemVT.getSizeInBits() * 2.operator unsigned long long() > self.TLI.getMaximumLegalStoreInBits() {
        return false;
    }
    let mut ElementSizeBytes: i64 = MemVT.getStoreSize().operator unsigned long long();
    if ElementSizeBytes * 8 != MemVT.getSizeInBits().operator unsigned long long() as i64 {
        return false;
    }
    let mut StoredVal: SDValue = peekThroughBitcasts(St.getValue());
    let mut StoreSrc: StoreSource = self.getStoreSource(StoredVal);
    if StoreSrc == Unknown {
        return false;
    }
    let mut StoreNodes: SmallVector<MemOpLink, 8> = SmallVector<MemOpLink, 8> {};
    let mut RootNode: *mut SDNode = self.getStoreMergeCandidates(St, StoreNodes);
    if StoreNodes.len < 2 {
        return false;
    }
    sort(StoreNodes, Closure_82 {});
    let mut AllowVectors: bool = !self.DAG.getMachineFunction().getFunction().hasFnAttribute(NoImplicitFloat);
    let mut IsNonTemporalStore: bool = St.isNonTemporal();
    let mut IsNonTemporalLoad: bool = StoreSrc == Load && cast(StoredVal).isNonTemporal();
    let mut MadeChange: bool = false;
    while StoreNodes.len > 1 {
        let mut NumConsecutiveStores: u32 = self.getConsecutiveStores(StoreNodes, ElementSizeBytes);
        if NumConsecutiveStores == 0 {
            return MadeChange;
        }
        assert!(NumConsecutiveStores >= 2, "Expected at least 2 stores");
        match StoreSrc {
            Constant => {
                MadeChange |= self.tryStoreMergeOfConstants(StoreNodes, NumConsecutiveStores, MemVT, RootNode, AllowVectors);
            },
            Extract => {
                MadeChange |= self.tryStoreMergeOfExtracts(StoreNodes, NumConsecutiveStores, MemVT, RootNode);
            },
            Load => {
                MadeChange |= self.tryStoreMergeOfLoads(StoreNodes, NumConsecutiveStores, MemVT, RootNode, AllowVectors, IsNonTemporalStore, IsNonTemporalLoad);
            },
            _ => {
                llvm_unreachable_internal("Unhandled store source type", "llvm\\lib\\CodeGen\\SelectionDAG\\DAGCombiner.cpp", 24358);
            },
        }
    }
    if !MadeChange {
        self.ChainsWithoutMergeableStores.insert(RootNode);
    }
    return MadeChange;
}

fn DAGCombiner::replaceStoreChain(self, ST: *mut StoreSDNode, BetterChain: SDValue) -> SDValue {
    let mut SL: SDLoc = SDLoc { ST };
    let mut ReplStore: SDValue = SDValue {};
    if ST.isTruncatingStore() {
        ReplStore = self.DAG.getTruncStore(BetterChain, SL, ST.getValue(), ST.getBasePtr(), ST.getMemoryVT(), ST.getMemOperand());
    } else {
        ReplStore = self.DAG.getStore(BetterChain, SL, ST.getValue(), ST.getBasePtr(), ST.getMemOperand());
    }
    let mut Token: SDValue = self.DAG.getNode(TokenFactor, SL, EVT { Other }, ST.getChain(), ReplStore);
    self.AddToWorklist(Token.getNode(), true, false);
    return self.CombineTo(ST, Token, false);
}

fn DAGCombiner::replaceStoreOfFPConstant(self, ST: *mut StoreSDNode) -> SDValue {
    let mut Value: SDValue = ST.getValue();
    if Value.getOpcode() == TargetConstantFP {
        return SDValue {};
    }
    if !isNormalStore(ST) {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { ST };
    let mut Chain: SDValue = ST.getChain();
    let mut Ptr: SDValue = ST.getBasePtr();
    let mut CFP: *ConstantFPSDNode = cast(Value);
    let mut Tmp: SDValue = SDValue {};
    match CFP.getSimpleValueType(0).SimpleTy {
        _ => {
            llvm_unreachable_internal("Unknown FP type", "llvm\\lib\\CodeGen\\SelectionDAG\\DAGCombiner.cpp", 24417);
        },
        f16 => {
            bf16;
        },
        f32 => {
            if (self.isTypeLegal(EVT { i32 }) && !self.LegalOperations && ST.isSimple()) || self.TLI.isOperationLegalOrCustom(STORE, EVT { i32 }, false) {
                Tmp = self.DAG.getConstant(CFP.getValueAPF().bitcastToAPInt().getZExtValue() as u32, SDLoc { CFP }, EVT { i32 }, false, false);
                return self.DAG.getStore(Chain, DL, Tmp, Ptr, ST.getMemOperand());
            }
        },
        f64 => {
            if (self.TLI.isTypeLegal(EVT { i64 }) && !self.LegalOperations && ST.isSimple()) || self.TLI.isOperationLegalOrCustom(STORE, EVT { i64 }, false) {
                Tmp = self.DAG.getConstant(CFP.getValueAPF().bitcastToAPInt().getZExtValue(), SDLoc { CFP }, EVT { i64 }, false, false);
                return self.DAG.getStore(Chain, DL, Tmp, Ptr, ST.getMemOperand());
            }
        },
    }
}

fn DAGCombiner::replaceStoreOfInsertLoad(self, ST: *mut StoreSDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { ST };
    let mut Value: SDValue = ST.getValue();
    let mut Ptr: SDValue = ST.getBasePtr();
    let mut Chain: SDValue = ST.getChain();
    if Value.getOpcode() != INSERT_VECTOR_ELT || !Value.hasOneUse() {
        return SDValue {};
    }
    let mut Elt: SDValue = Value.getOperand(1);
    let mut Idx: SDValue = Value.getOperand(2);
    let mut EltVT: EVT = Elt.getValueType();
    if !EltVT.isByteSized() || EltVT != Value.getOperand(0).getValueType().getVectorElementType() {
        return SDValue {};
    }
    let mut Ld: *mut LoadSDNode = dyn_cast(Value.getOperand(0));
    if !Ld || Ld.getBasePtr() != Ptr || ST.getMemoryVT() != Ld.getMemoryVT() || !ST.isSimple() || !isNormalStore(ST) || Ld.getAddressSpace() != ST.getAddressSpace() || !Chain.reachesChainWithoutSideEffects(SDValue { Node: Ld, ResNo: 1 }, 2) {
        return SDValue {};
    }
    let mut IsFast: u32 = 0;
    if !self.TLI.allowsMemoryAccess(*self.DAG.getContext(), self.DAG.getDataLayout(), Elt.getValueType(), ST.getAddressSpace(), ST.getAlign(), ST.getMemOperand().getFlags(), &mut IsFast) || !IsFast {
        return SDValue {};
    }
    let mut PointerInfo: MachinePointerInfo = MachinePointerInfo { ST.getAddressSpace(), 0 };
    let mut NewAlign: Align = Align {};
    let mut NewPtr: SDValue = SDValue {};
    if dyn_cast(Idx) {
        CIdx;
    } else {
        let mut COffset: u32 = CIdx.getSExtValue() * EltVT.getFixedSizeInBits() / 8;
        NewPtr = self.DAG.getMemBasePlusOffset(Ptr, getFixed(COffset), DL, SDNodeFlags { Flags: None });
        PointerInfo = ST.getPointerInfo().getWithOffset(COffset);
        NewAlign = ST.getAlign();
    }
    return self.DAG.getStore(Chain, DL, Elt, NewPtr, PointerInfo, NewAlign, ST.getMemOperand().getFlags(), MMOMetadata {});
}

fn DAGCombiner::visitATOMIC_STORE(self, N: *mut SDNode) -> SDValue {
    let mut ST: *mut AtomicSDNode = cast(N);
    let mut Val: SDValue = ST.getVal();
    let mut VT: EVT = Val.getValueType();
    let mut MemVT: EVT = ST.getMemoryVT();
    if MemVT.bitsLT(VT) {
        let mut TruncDemandedBits: APInt = getLowBitsSet(VT.getScalarSizeInBits(), MemVT.getScalarSizeInBits());
        if self.SimplifyDemandedBits(Val, TruncDemandedBits) {
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    return SDValue {};
}

fn foldToMaskedStore(Store: *mut StoreSDNode, DAG: *mut SelectionDAG, Dl: *SDLoc) -> SDValue {
    if !Store.isSimple() || !isNormalStore(Store) {
        return SDValue {};
    }
    let mut StoredVal: SDValue = Store.getValue();
    let mut StorePtr: SDValue = Store.getBasePtr();
    let mut StoreOffset: SDValue = Store.getOffset();
    let mut VT: EVT = Store.getMemoryVT();
    if !VT.isVector() || VT.isScalableVector() || VT.getVectorNumElements() == 1 {
        return SDValue {};
    }
    let mut AddrSpace: u32 = Store.getAddressSpace();
    let mut Alignment: Align = Store.getAlign();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if !TLI.isOperationLegalOrCustom(MSTORE, VT, false) || !TLI.isTypeDesirableForOp(MSTORE, VT) || !TLI.allowsMisalignedMemoryAccesses(VT, AddrSpace, Alignment, MONone, null) {
        return SDValue {};
    }
    let mut Mask: SDValue = SDValue {};
    let mut OtherVec: SDValue = SDValue {};
    let mut LoadCh: SDValue = SDValue {};
    let mut LoadPos: u32 = 0;
    if sd_match(StoredVal, m_VSelect(m_Value(Mask), m_Value(OtherVec), m_Load(m_Value(LoadCh), m_Specific(StorePtr), m_Specific(StoreOffset)))) {
        LoadPos = 2;
    } else if sd_match(StoredVal, m_VSelect(m_Value(Mask), m_Load(m_Value(LoadCh), m_Specific(StorePtr), m_Specific(StoreOffset)), m_Value(OtherVec))) {
        LoadPos = 1;
    } else {
        return SDValue {};
    }
    let mut Load: *mut LoadSDNode = cast(StoredVal.getOperand(LoadPos));
    if !Load.isSimple() || !isNormalLoad(Load) || Load.getAddressSpace() != AddrSpace {
        return SDValue {};
    }
    if !Store.getChain().reachesChainWithoutSideEffects(LoadCh, 2) {
        return SDValue {};
    }
    if LoadPos == 1 {
        Mask = DAG.getNOT(Dl, Mask, Mask.getValueType());
    }
    let mut MaskVT: EVT = Mask.getValueType();
    if MaskVT.getVectorElementType() != EVT { i1 } {
        let mut BoolVT: EVT = MaskVT.changeVectorElementType(*DAG.getContext(), EVT { i1 });
        if TLI.isTypeLegal(BoolVT) {
            Mask = DAG.getNode(TRUNCATE, Dl, BoolVT, Mask);
        }
    }
    return DAG.getMaskedStore(Store.getChain(), Dl, OtherVec, StorePtr, StoreOffset, Mask, VT, Store.getMemOperand(), Store.getAddressingMode(), false, false);
}

fn DAGCombiner::combineStoreConcatTruncVector(self, ST: *mut StoreSDNode) -> SDValue {
    if !self.LegalTypes {
        return SDValue {};
    }
    if !ST.isSimple() || ST.isTruncatingStore() || ST.isIndexed() {
        return SDValue {};
    }
    let mut Chain: SDValue = ST.getChain();
    let mut ConcatVec: SDValue = ST.getValue();
    if ConcatVec.getOpcode() != CONCAT_VECTORS || ConcatVec.getNumOperands() != 2 || !operator(ConcatVec).hasOneUse() {
        return SDValue {};
    }
    let mut T1: SDValue = ConcatVec.getOperand(0);
    let mut T2: SDValue = ConcatVec.getOperand(1);
    if T1.getOpcode() != TRUNCATE || T2.getOpcode() != TRUNCATE {
        return SDValue {};
    }
    let mut LoMemVT: EVT = T1.getValueType();
    let mut HiMemVT: EVT = T2.getValueType();
    if !LoMemVT.isFixedLengthVector() {
        return SDValue {};
    }
    if !T1.hasOneUse() || !T2.hasOneUse() {
        return SDValue {};
    }
    let mut LoBytes: u32 = LoMemVT.getStoreSize().operator unsigned long long();
    let mut HiBytes: u32 = HiMemVT.getStoreSize().operator unsigned long long();
    let mut LoAlign: Align = ST.getAlign();
    let mut HiAlign: Align = commonAlignment(LoAlign, LoBytes);
    if !self.TLI.canCombineTruncStore(T1.getOperand(0).getValueType(), LoMemVT, LoAlign, ST.getAddressSpace(), self.LegalOperations) || !self.TLI.canCombineTruncStore(T2.getOperand(0).getValueType(), HiMemVT, HiAlign, ST.getAddressSpace(), self.LegalOperations) {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { ST };
    let mut LoPtr: SDValue = ST.getBasePtr();
    let mut HiPtr: SDValue = self.DAG.getObjectPtrOffset(DL, LoPtr, getFixed(LoBytes));
    let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
    let mut LoMMO: *mut MachineMemOperand = MF.getMachineMemOperand(ST.getMemOperand(), 0, LoBytes);
    let mut HiMMO: *mut MachineMemOperand = MF.getMachineMemOperand(ST.getMemOperand(), LoBytes, HiBytes);
    let mut LoSt: SDValue = self.DAG.getTruncStore(Chain, DL, T1.getOperand(0), LoPtr, LoMemVT, LoMMO);
    let mut HiSt: SDValue = self.DAG.getTruncStore(Chain, DL, T2.getOperand(0), HiPtr, HiMemVT, HiMMO);
    return self.DAG.getNode(TokenFactor, DL, EVT { Other }, LoSt, HiSt);
}

fn DAGCombiner::visitSTORE(self, N: *mut SDNode) -> SDValue {
    let mut ST: *mut StoreSDNode = cast(N);
    let mut Chain: SDValue = ST.getChain();
    let mut Value: SDValue = ST.getValue();
    let mut Ptr: SDValue = ST.getBasePtr();
    if Value.getOpcode() == BITCAST && !ST.isTruncatingStore() && ST.isUnindexed() {
        let mut SVT: EVT = Value.getOperand(0).getValueType();
        if ((!self.LegalOperations && ST.isSimple()) || self.TLI.isOperationLegal(STORE, SVT)) && self.TLI.isStoreBitCastBeneficial(Value.getValueType(), SVT, self.DAG, *ST.getMemOperand()) {
            return self.DAG.getStore(Chain, SDLoc { N }, Value.getOperand(0), Ptr, ST.getMemOperand());
        }
    }
    if Value.isUndef() && ST.isUnindexed() && !ST.isVolatile() {
        return Chain;
    }
    if self.OptLevel != None && ST.isUnindexed() && !ST.isAtomic() {
        if self.DAG.InferPtrAlign(Ptr) {
            Alignment;
        } else {
            if operator(Alignment) > ST.getAlign() && isAligned(operator(Alignment), ST.getSrcValueOffset()) {
                let mut NewStore: SDValue = self.DAG.getTruncStore(Chain, SDLoc { N }, Value, Ptr, ST.getOffset(), ST.getPointerInfo(), ST.getMemoryVT(), operator(Alignment), ST.getMemOperand().getFlags(), MMOMetadata { AAInfo: ST.getAAInfo(), Ranges: null, MemCacheHint: null });
                assert!(NewStore.getNode() == N);
                NewStore as void;
            }
        }
    }
    if self.TransformFPLoadStorePair(N) {
        NewST;
    } else {
        return NewST;
    }
    if self.mergeTruncStores(ST) {
        Store;
    } else {
        return Store;
    }
    if ST.isUnindexed() {
        if self.findBetterNeighborChains(ST) {
            return SDValue { Node: ST, ResNo: 0 };
        }
        Chain = ST.getChain();
    }
    if self.combineStoreConcatTruncVector(ST) {
        R;
    } else {
        return R;
    }
    if ST.isTruncatingStore() && ST.isUnindexed() && Value.getValueType().isInteger() && (!isa(Value) || !cast(Value).isOpaque()) {
        if (Value.getOpcode() == ZERO_EXTEND || Value.getOpcode() == SIGN_EXTEND || Value.getOpcode() == ANY_EXTEND) && Value.getOperand(0).getValueType() == ST.getMemoryVT() && self.TLI.isOperationLegalOrCustom(STORE, ST.getMemoryVT(), false) {
            return self.DAG.getStore(Chain, SDLoc { N }, Value.getOperand(0), Ptr, ST.getMemOperand());
        }
        let mut TruncDemandedBits: APInt = getLowBitsSet(Value.getScalarValueSizeInBits(), ST.getMemoryVT().getScalarSizeInBits());
        self.AddToWorklist(Value.getNode(), true, false);
        if self.SimplifyDemandedBits(Value, TruncDemandedBits) {
            if N.getOpcode() != DELETED_NODE {
                self.AddToWorklist(N, true, false);
            }
            return SDValue { Node: N, ResNo: 0 };
        }
        if self.TLI.SimplifyMultipleUseDemandedBits(Value, TruncDemandedBits, self.DAG, 0) {
            Shorter;
        } else {
            return self.DAG.getTruncStore(Chain, SDLoc { N }, Shorter, Ptr, ST.getMemoryVT(), ST.getMemOperand());
        }
        if dyn_cast(Value) {
            Cst;
        } else if !Cst.isOpaque() {
            let mut CValue: *APInt = Cst.getAPIntValue();
            let mut NewVal: APInt = CValue & TruncDemandedBits;
            if NewVal != CValue {
                let mut Shorter: SDValue = self.DAG.getConstant(NewVal, SDLoc { N }, Value.getValueType(), false, false);
                return self.DAG.getTruncStore(Chain, SDLoc { N }, Shorter, Ptr, ST.getMemoryVT(), ST.getMemOperand());
            }
        }
    }
    let mut TruncVal: SDValue = if self.DAG.getDataLayout().isLittleEndian() { peekThroughTruncates(Value) } else { Value };
    if dyn_cast(TruncVal) {
        Ld;
    } else {
        if Ld.getBasePtr() == Ptr && ST.getMemoryVT() == Ld.getMemoryVT() && ST.isUnindexed() && ST.isSimple() && Ld.getAddressSpace() == ST.getAddressSpace() && Chain.reachesChainWithoutSideEffects(SDValue { Node: Ld, ResNo: 1 }, 2) {
            return Chain;
        }
    }
    if self.replaceStoreOfInsertLoad(ST) {
        NewST;
    } else {
        return NewST;
    }
    if dyn_cast(Chain) {
        ST1;
    } else {
        if ST.isUnindexed() && ST.isSimple() && ST1.isUnindexed() && ST1.isSimple() {
            if self.OptLevel != None && ST1.getBasePtr() == Ptr && ST1.getValue() == Value && ST.getMemoryVT() == ST1.getMemoryVT() && ST.getAddressSpace() == ST1.getAddressSpace() {
                return Chain;
            }
            if self.OptLevel != None && ST1.hasOneUse() && !ST1.getBasePtr().isUndef() && ST.getAddressSpace() == ST1.getAddressSpace() {
                if ST.getMemoryVT().isScalableVector() || ST1.getMemoryVT().isScalableVector() {
                    if ST1.getBasePtr() == Ptr && isKnownLE(ST1.getMemoryVT().getStoreSize(), ST.getMemoryVT().getStoreSize()) {
                        self.CombineTo(ST1, ST1.getChain(), true);
                        return SDValue { Node: N, ResNo: 0 };
                    }
                } else {
                    let mut STBase: BaseIndexOffset = match(ST, self.DAG);
                    let mut ChainBase: BaseIndexOffset = match(ST1, self.DAG);
                    if STBase.contains(self.DAG, ST.getMemoryVT().getFixedSizeInBits(), ChainBase, ST1.getMemoryVT().getFixedSizeInBits()) {
                        self.CombineTo(ST1, ST1.getChain(), true);
                        return SDValue { Node: N, ResNo: 0 };
                    }
                }
            }
        }
    }
    if (Value.getOpcode() == FP_ROUND || Value.getOpcode() == TRUNCATE) && operator(Value).hasOneUse() && ST.isUnindexed() && self.TLI.canCombineTruncStore(Value.getOperand(0).getValueType(), ST.getMemoryVT(), ST.getAlign(), ST.getAddressSpace(), self.LegalOperations) {
        return self.DAG.getTruncStore(Chain, SDLoc { N }, Value.getOperand(0), Ptr, ST.getMemoryVT(), ST.getMemOperand());
    }
    if !self.LegalTypes || (self.TLI.mergeStoresAfterLegalization(ST.getMemoryVT())) {
        while true {
            let mut Changed: bool = self.mergeConsecutiveStores(ST);
            if !Changed {
                break;
            }
            if N.getOpcode() == DELETED_NODE || !isa(N) {
                return SDValue { Node: N, ResNo: 0 };
            }
        }
    }
    if self.CombineToPreIndexedLoadStore(N) || self.CombineToPostIndexedLoadStore(N) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if isa(ST.getValue()) {
        if self.replaceStoreOfFPConstant(ST) {
            NewSt;
        } else {
            return NewSt;
        }
    }
    if self.splitMergedValStore(ST) {
        NewSt;
    } else {
        return NewSt;
    }
    if foldToMaskedStore(ST, self.DAG, SDLoc { N }) {
        MaskedStore;
    } else {
        return MaskedStore;
    }
    return self.ReduceLoadOpStoreWidth(N);
}

fn DAGCombiner::visitLIFETIME_END(self, N: *mut SDNode) -> SDValue {
    let mut LifetimeEnd: *LifetimeSDNode const = cast(N);
    let mut LifetimeEndBase: BaseIndexOffset = BaseIndexOffset { Base: N.getOperand(1), Index: SDValue {}, Offset: 0, IsIndexSignExt: false };
    let mut Chains: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { [N.getOperand(0)] };
    while !Chains.is_empty() {
        let mut Chain: SDValue = Chains.pop_back_val();
        if !Chain.hasOneUse() {
            continue;
        }
        match Chain.getOpcode() {
            TokenFactor => {
                for let mut Nops: u32 = Chain.getNumOperands(); Nops;  {
                    Chains.push(ValueParamT { Chain.getOperand(Nops -= 1) });
                }
            },
            LIFETIME_START => {
                LIFETIME_END;
            },
            STORE => {
                let mut ST: *mut StoreSDNode = dyn_cast(Chain);
                if !ST.isSimple() || ST.isIndexed() {
                    continue;
                }
                let mut StoreSize: TypeSize = ST.getMemoryVT().getStoreSize();
                if StoreSize.isScalable() {
                    continue;
                }
                let mut StoreBase: BaseIndexOffset = match(ST, self.DAG);
                let mut MFI: *mut MachineFrameInfo = self.DAG.getMachineFunction().getFrameInfo();
                if LifetimeEndBase.contains(self.DAG, MFI.getObjectSize(LifetimeEnd.getFrameIndex()) * 8, StoreBase, StoreSize.getFixedValue() * 8) {
                    while true {
                        {
                        if DebugFlag && isCurrentDebugType("dagcombine", 1) {
                            dbgs() << "\nRemoving store:";
                            StoreBase.dump();
                            dbgs() << "\nwithin LIFETIME_END of : ";
                            LifetimeEndBase.dump();
                            dbgs() << "\n";
                        }
                    }
                        if !(false) { break; }
                    }
                    self.CombineTo(ST, ST.getChain(), true);
                    return SDValue { Node: N, ResNo: 0 };
                }
            },
        }
    }
    return SDValue {};
}

fn DAGCombiner::splitMergedValStore(self, ST: *mut StoreSDNode) -> SDValue {
    if self.OptLevel == None {
        return SDValue {};
    }
    if !ST.isSimple() {
        return SDValue {};
    }
    let mut Val: SDValue = ST.getValue();
    let mut DL: SDLoc = SDLoc { ST };
    if !Val.getValueType().isScalarInteger() || Val.getOpcode() != OR {
        return SDValue {};
    }
    let mut Op1: SDValue = Val.getOperand(0);
    let mut Op2: SDValue = Val.getOperand(1);
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    if Op1.getOpcode() != SHL {
        swap(Op1, Op2);
        if Op1.getOpcode() != SHL {
            return SDValue {};
        }
    }
    Lo = Op2;
    Hi = Op1.getOperand(0);
    if !Op1.hasOneUse() {
        return SDValue {};
    }
    let mut HalfValBitSize: u32 = Val.getValueSizeInBits().operator unsigned long long() / 2;
    let mut ShAmt: *mut ConstantSDNode = dyn_cast(Op1.getOperand(1));
    if !ShAmt || ShAmt.getAPIntValue() != HalfValBitSize {
        return SDValue {};
    }
    if Lo.getOpcode() != ZERO_EXTEND || !Lo.hasOneUse() || !Lo.getOperand(0).getValueType().isScalarInteger() || Lo.getOperand(0).getValueSizeInBits().operator unsigned long long() > HalfValBitSize || Hi.getOpcode() != ZERO_EXTEND || !Hi.hasOneUse() || !Hi.getOperand(0).getValueType().isScalarInteger() || Hi.getOperand(0).getValueSizeInBits().operator unsigned long long() > HalfValBitSize {
        return SDValue {};
    }
    let mut LowTy: EVT = if (Lo.getOperand(0).getOpcode() == BITCAST) { Lo.getOperand(0).getValueType() } else { Lo.getValueType() };
    let mut HighTy: EVT = if (Hi.getOperand(0).getOpcode() == BITCAST) { Hi.getOperand(0).getValueType() } else { Hi.getValueType() };
    if !self.TLI.isMultiStoresCheaperThanBitsMerge(LowTy, HighTy) {
        return SDValue {};
    }
    let mut MMOFlags: Flags = ST.getMemOperand().getFlags();
    let mut AAInfo: AAMDNodes = ST.getAAInfo();
    let mut VT: EVT = getIntegerVT(*self.DAG.getContext(), HalfValBitSize);
    Lo = self.DAG.getNode(ZERO_EXTEND, DL, VT, Lo.getOperand(0));
    Hi = self.DAG.getNode(ZERO_EXTEND, DL, VT, Hi.getOperand(0));
    let mut Chain: SDValue = ST.getChain();
    let mut Ptr: SDValue = ST.getBasePtr();
    let mut St0: SDValue = self.DAG.getStore(Chain, DL, Lo, Ptr, ST.getPointerInfo(), ST.getBaseAlign(), MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
    Ptr = self.DAG.getMemBasePlusOffset(Ptr, getFixed(HalfValBitSize / 8), DL, SDNodeFlags { Flags: None });
    let mut St1: SDValue = self.DAG.getStore(St0, DL, Hi, Ptr, ST.getPointerInfo().getWithOffset(HalfValBitSize / 8), ST.getBaseAlign(), MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
    return St1;
}

fn mergeEltWithShuffle(X: *mut SDValue, Y: *mut SDValue, Mask: ArrayRef<int>, NewMask: *mut SmallVectorImpl<int>, Elt: SDValue, InsIndex: u32) -> bool {
    if Elt.getOpcode() != EXTRACT_VECTOR_ELT || !isa(Elt.getOperand(1)) {
        return false;
    }
    let mut InsertVal0: SDValue = Elt.getOperand(0);
    let mut ElementOffset: i32 = -1;
    let mut ArgWorkList: pair<int, SDValue>, 8> = pair<int, SDValue>, 8> {};
    ArgWorkList.emplace_back(Mask.len, Y);
    ArgWorkList.emplace_back(0, X);
    while !ArgWorkList.is_empty() {
        let mut ArgOffset: i32 = 0;
        let mut ArgVal: SDValue = SDValue {};
        tie(ArgOffset, ArgVal) = ArgWorkList.pop_back_val();
        if ArgVal == InsertVal0 {
            ElementOffset = ArgOffset;
            break;
        }
        if ArgVal.getOpcode() == CONCAT_VECTORS {
            let mut CurrentArgOffset: i32 = ArgOffset + ArgVal.getValueType().getVectorNumElements();
            let mut Step: i32 = ArgVal.getOperand(0).getValueType().getVectorNumElements();
            for Op in reverse(operator(ArgVal).ops()) {
                CurrentArgOffset -= Step;
                ArgWorkList.emplace_back(CurrentArgOffset, Op);
            }
            assert!(CurrentArgOffset == ArgOffset);
        }
    }
    if ElementOffset == -1 {
        if !Y.isUndef() || InsertVal0.getValueType() != Y.getValueType() {
            return false;
        }
        ElementOffset = Mask.len;
        Y = InsertVal0;
    }
    NewMask.assign(Mask.begin(), Mask.end());
    NewMask[InsIndex] = ElementOffset + Elt.getConstantOperandVal(1);
    assert!(NewMask[InsIndex] < (2 * Mask.len) as i32 && NewMask[InsIndex] >= 0, "NewMask[InsIndex] is out of bound");
    return true;
}

fn DAGCombiner::mergeInsertEltWithShuffle(self, N: *mut SDNode, InsIndex: u32) -> SDValue {
    assert!(N.getOpcode() == INSERT_VECTOR_ELT, "Expected extract_vector_elt");
    let mut InsertVal: SDValue = N.getOperand(1);
    let mut Vec: SDValue = N.getOperand(0);
    let mut SVN: *mut ShuffleVectorSDNode = dyn_cast(Vec);
    if !SVN || !Vec.hasOneUse() {
        return SDValue {};
    }
    let mut Mask: ArrayRef<int> = SVN.getMask();
    let mut X: SDValue = Vec.getOperand(0);
    let mut Y: SDValue = Vec.getOperand(1);
    let mut NewMask: SmallVector<int, 16> = SmallVector<int, 16> { Mask };
    if mergeEltWithShuffle(X, Y, Mask, NewMask, InsertVal, InsIndex) {
        let mut LegalShuffle: SDValue = self.TLI.buildLegalVectorShuffle(Vec.getValueType(), SDLoc { N }, X, Y, MutableArrayRef<int> { NewMask }, self.DAG);
        if LegalShuffle {
            return LegalShuffle;
        }
    }
    return SDValue {};
}

fn DAGCombiner::combineInsertEltToShuffle(self, N: *mut SDNode, InsIndex: u32) -> SDValue {
    assert!(N.getOpcode() == INSERT_VECTOR_ELT, "Expected extract_vector_elt");
    let mut InsertVal: SDValue = N.getOperand(1);
    if InsertVal.getOpcode() != BITCAST || !InsertVal.hasOneUse() || !InsertVal.getOperand(0).getValueType().isVector() {
        return SDValue {};
    }
    let mut SubVec: SDValue = InsertVal.getOperand(0);
    let mut DestVec: SDValue = N.getOperand(0);
    let mut SubVecVT: EVT = SubVec.getValueType();
    let mut VT: EVT = DestVec.getValueType();
    let mut NumSrcElts: u32 = SubVecVT.getVectorNumElements();
    if InsertVal.getValueType() != VT.getVectorElementType() {
        return SDValue {};
    }
    if NumSrcElts == 1 {
        return SDValue {};
    }
    let mut ExtendRatio: u32 = VT.getSizeInBits().operator unsigned long long() / SubVecVT.getSizeInBits().operator unsigned long long();
    let mut NumMaskVals: u32 = ExtendRatio * NumSrcElts;
    let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> { NumMaskVals };
    for let mut i: u32 = 0; i != NumMaskVals; i += 1 {
        if i / NumSrcElts == InsIndex {
            Mask[i] = (i % NumSrcElts) + NumMaskVals;
        } else {
            Mask[i] = i;
        }
    }
    let mut SubVecEltVT: EVT = SubVecVT.getVectorElementType();
    let mut ShufVT: EVT = getVectorVT(*self.DAG.getContext(), SubVecEltVT, NumMaskVals, false);
    if (self.LegalTypes && !self.TLI.isTypeLegal(ShufVT)) || !self.TLI.isShuffleMaskLegal(ArrayRef<int> { Mask }, ShufVT) {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { N };
    let mut ConcatOps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { ExtendRatio, self.DAG.getPOISON(SubVecVT) };
    ConcatOps[0] = SubVec;
    let mut PaddedSubV: SDValue = self.DAG.getNode(CONCAT_VECTORS, DL, ShufVT, ArrayRef<SDValue> { ConcatOps });
    let mut DestVecBC: SDValue = self.DAG.getBitcast(ShufVT, DestVec);
    let mut Shuf: SDValue = self.DAG.getVectorShuffle(ShufVT, DL, DestVecBC, PaddedSubV, ArrayRef<int> { Mask });
    self.AddToWorklist(PaddedSubV.getNode(), true, false);
    self.AddToWorklist(DestVecBC.getNode(), true, false);
    self.AddToWorklist(Shuf.getNode(), true, false);
    return self.DAG.getBitcast(VT, Shuf);
}

fn DAGCombiner::combineInsertEltToLoad(self, N: *mut SDNode, InsIndex: u32) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if !VT.isFixedLengthVector() || (InsIndex != 0 && InsIndex != VT.getVectorNumElements() - 1) {
        return SDValue {};
    }
    let mut Shuffle: *mut ShuffleVectorSDNode = dyn_cast(N.getOperand(0));
    let mut Scalar: SDValue = N.getOperand(1);
    if !Shuffle || !all_of(enumerate(Shuffle.getMask()), Closure_83 { InsIndex: &mut InsIndex, VT: &mut VT }) {
        return SDValue {};
    }
    let mut Extend: u32 = 0;
    if Scalar.getOpcode() == ZERO_EXTEND || Scalar.getOpcode() == SIGN_EXTEND || Scalar.getOpcode() == ANY_EXTEND {
        Extend = Scalar.getOpcode();
        Scalar = Scalar.getOperand(0);
    }
    let mut ScalarLoad: *mut LoadSDNode = dyn_cast(Scalar);
    if !ScalarLoad {
        return SDValue {};
    }
    let mut Vec: SDValue = Shuffle.getOperand(0);
    if Extend {
        if Vec.getOpcode() != Extend {
            return SDValue {};
        }
        Vec = Vec.getOperand(0);
    }
    let mut VecLoad: *mut LoadSDNode = dyn_cast(Vec);
    if !VecLoad || Vec.getValueType().getScalarType() != Scalar.getValueType() {
        return SDValue {};
    }
    let mut EltSize: i32 = ScalarLoad.getValueType(0).getScalarSizeInBits();
    if EltSize == 0 || EltSize % 8 != 0 || !ScalarLoad.isSimple() || !VecLoad.isSimple() || VecLoad.getExtensionType() != NON_EXTLOAD || ScalarLoad.getExtensionType() != NON_EXTLOAD || ScalarLoad.getAddressSpace() != VecLoad.getAddressSpace() {
        return SDValue {};
    }
    if InsIndex == 0 {
        if !self.DAG.areNonVolatileConsecutiveLoads(ScalarLoad, VecLoad, EltSize / 8, -1) {
            return SDValue {};
        }
    } else {
        if !self.DAG.areNonVolatileConsecutiveLoads(VecLoad, ScalarLoad, VT.getVectorNumElements() * EltSize / 8, -1) {
            return SDValue {};
        }
    }
    let mut IsFast: u32 = 0;
    let mut NewAlign: Align = commonAlignment(VecLoad.getAlign(), EltSize / 8);
    if !self.TLI.allowsMemoryAccess(*self.DAG.getContext(), self.DAG.getDataLayout(), Vec.getValueType(), VecLoad.getAddressSpace(), NewAlign, VecLoad.getMemOperand().getFlags(), &mut IsFast) || !IsFast {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { N };
    let mut Ptr: SDValue = ScalarLoad.getBasePtr();
    if InsIndex != 0 {
        Ptr = self.DAG.getNode(ADD, DL, Ptr.getValueType(), VecLoad.getBasePtr(), self.DAG.getConstant(EltSize / 8, DL, Ptr.getValueType(), false, false));
    }
    let mut PtrInfo: MachinePointerInfo = if InsIndex == 0 { ScalarLoad.getPointerInfo() } else { VecLoad.getPointerInfo().getWithOffset(EltSize / 8) };
    let mut Load: SDValue = self.DAG.getLoad(VecLoad.getValueType(0), DL, ScalarLoad.getChain(), Ptr, PtrInfo, MaybeAlign { NewAlign }, MONone, MMOMetadata {});
    self.DAG.makeEquivalentMemoryOrdering(ScalarLoad, Load.getValue(1));
    self.DAG.makeEquivalentMemoryOrdering(VecLoad, Load.getValue(1));
    return if Extend { self.DAG.getNode(Extend, DL, VT, Load) } else { Load };
}

fn DAGCombiner::visitINSERT_VECTOR_ELT(self, N: *mut SDNode) -> SDValue {
    let mut InVec: SDValue = N.getOperand(0);
    let mut InVal: SDValue = N.getOperand(1);
    let mut EltNo: SDValue = N.getOperand(2);
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: EVT = InVec.getValueType();
    let mut IndexC: *mut ConstantSDNode = dyn_cast(EltNo);
    if IndexC && VT.isFixedLengthVector() && IndexC.getZExtValue() >= VT.getVectorNumElements() {
        return self.DAG.getPOISON(VT);
    }
    if InVal.getOpcode() == EXTRACT_VECTOR_ELT && InVec == InVal.getOperand(0) && EltNo == InVal.getOperand(1) {
        return InVec;
    }
    if InVal.isUndef() {
        if InVal.getOpcode() == POISON || InVec.getOpcode() == UNDEF {
            return InVec;
        }
        return self.DAG.getFreeze(InVec);
    }
    if !IndexC {
        if InVec.isUndef() && self.TLI.shouldSplatInsEltVarIndex(VT) {
            return self.DAG.getSplat(VT, DL, InVal);
        }
        let mut OldVT: EVT = VT;
        let mut EltVT: EVT = VT.getVectorElementType();
        let mut IsByteSized: bool = EltVT.isByteSized();
        if !IsByteSized {
            EltVT = EltVT.changeTypeToInteger().getRoundIntegerType(*self.DAG.getContext());
            VT = VT.changeElementType(*self.DAG.getContext(), EltVT);
        }
        let mut IsTypeDefaultHandled: Closure_84 = Closure_84 { cap_0: self };
        if IsTypeDefaultHandled.call(OldVT) && IsTypeDefaultHandled.call(VT) {
            let mut Seq: SmallVector<SDNode *> = SmallVector<SDNode *> { [N] };
            let mut NumDynamic: u32 = 1;
            while true {
                let mut InVec: SDValue = Seq.back().getOperand(0);
                if InVec.getOpcode() != INSERT_VECTOR_ELT {
                    break;
                }
                Seq.push(InVec.getNode());
                NumDynamic += !isa(InVec.getOperand(2));
            }
            if NumDynamic > 1 {
                let mut SmallestAlign: Align = self.DAG.getReducedAlign(VT, false);
                let mut StackPtr: SDValue = self.DAG.CreateStackTemporary(VT.getStoreSize(), SmallestAlign);
                let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
                let mut FrameIndex: i32 = cast(StackPtr.getNode()).getIndex();
                let mut PtrInfo: MachinePointerInfo = getFixedStack(MF, FrameIndex, 0);
                let mut InVec: SDValue = Seq.back().getOperand(0);
                if !IsByteSized {
                    InVec = self.DAG.getNode(ANY_EXTEND, DL, VT, InVec);
                }
                let mut Store: SDValue = self.DAG.getStore(self.DAG.getEntryNode(), DL, InVec, StackPtr, PtrInfo, SmallestAlign, MONone, MMOMetadata {});
                for N in reverse(Seq) {
                    let mut Elmnt: SDValue = N.getOperand(1);
                    let mut Index: SDValue = N.getOperand(2);
                    if !IsByteSized && Elmnt.getValueType().bitsLT(EltVT) {
                        Elmnt = self.DAG.getNode(ANY_EXTEND, DL, EltVT, Elmnt);
                    }
                    let mut EltPtr: SDValue = self.TLI.getVectorElementPointer(self.DAG, StackPtr, VT, Index, SDNodeFlags { Flags: None });
                    let mut EltVT: EVT = Elmnt.getValueType();
                    Store = self.DAG.getTruncStore(Store, DL, Elmnt, EltPtr, getUnknownStack(MF), EltVT, commonAlignment(SmallestAlign, EltVT.getFixedSizeInBits() / 8), MONone, MMOMetadata {});
                }
                let mut Load: SDValue = self.DAG.getLoad(VT, DL, Store, StackPtr, PtrInfo, MaybeAlign { SmallestAlign }, MONone, MMOMetadata {});
                let mut LoadV: SDValue = Load.getValue(0);
                return if IsByteSized { LoadV } else { self.DAG.getAnyExtOrTrunc(LoadV, DL, OldVT) };
            }
        }
        return SDValue {};
    }
    if VT.isScalableVector() {
        return SDValue {};
    }
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut Elt: u32 = IndexC.getZExtValue();
    if NumElts == 1 {
        if InVal.getOpcode() == EXTRACT_VECTOR_ELT && InVal.getOperand(0).getValueType() == VT && isNullConstant(InVal.getOperand(1)) {
            return InVal.getOperand(0);
        }
    }
    if InVec.getOpcode() == INSERT_VECTOR_ELT && InVec.hasOneUse() && isa(InVec.getOperand(2)) {
        let mut OtherElt: u32 = InVec.getConstantOperandVal(2);
        if Elt < OtherElt {
            let mut NewOp: SDValue = self.DAG.getNode(INSERT_VECTOR_ELT, DL, VT, InVec.getOperand(0), InVal, EltNo);
            self.AddToWorklist(NewOp.getNode(), true, false);
            return self.DAG.getNode(INSERT_VECTOR_ELT, SDLoc { InVec.getNode() }, VT, NewOp, InVec.getOperand(1), InVec.getOperand(2));
        }
    }
    if self.mergeInsertEltWithShuffle(N, Elt) {
        Shuf;
    } else {
        return Shuf;
    }
    if self.combineInsertEltToShuffle(N, Elt) {
        Shuf;
    } else {
        return Shuf;
    }
    if self.combineInsertEltToLoad(N, Elt) {
        Shuf;
    } else {
        return Shuf;
    }
    if !self.LegalOperations || self.TLI.isOperationLegal(BUILD_VECTOR, VT) {
        if NumElts == 1 {
            return self.DAG.getBuildVector(VT, DL, ArrayRef<SDValue> { [InVal] });
        }
        let mut MaxEltVT: EVT = InVal.getValueType();
        let mut AddBuildVectorOp: Closure_85 = Closure_85 { VT: &mut VT, MaxEltVT: &mut MaxEltVT };
        let mut CanonicalizeBuildVector: Closure_86 = Closure_86 { NumElts: &mut NumElts, cap_1: self, MaxEltVT: &mut MaxEltVT, VT: &mut VT, DL: &mut DL };
        let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { NumElts, SDValue {} };
        Ops[Elt] = InVal;
        for let mut CurVec: SDValue = InVec; CurVec;  {
            if CurVec.isUndef() {
                return CanonicalizeBuildVector.call(Ops, false);
            }
            if isFreezeUndef(CurVec.getNode()) && CurVec.hasOneUse() {
                return CanonicalizeBuildVector.call(Ops, true);
            }
            if CurVec.getOpcode() == BUILD_VECTOR && (CurVec.hasOneUse() || self.TLI.aggressivelyPreferBuildVectorSources(VT)) {
                for let mut I: u32 = 0; I != NumElts; I += 1 {
                    AddBuildVectorOp.call(Ops, CurVec.getOperand(I), I);
                }
                return CanonicalizeBuildVector.call(Ops, false);
            }
            if CurVec.getOpcode() == SCALAR_TO_VECTOR && CurVec.hasOneUse() {
                AddBuildVectorOp.call(Ops, CurVec.getOperand(0), 0);
                return CanonicalizeBuildVector.call(Ops, false);
            }
            if CurVec.getOpcode() == INSERT_VECTOR_ELT && CurVec.hasOneUse() {
                if dyn_cast(CurVec.getOperand(2)) {
                    CurIdx;
                } else if CurIdx.getAPIntValue().ult(NumElts) {
                    let mut Idx: u32 = CurIdx.getZExtValue();
                    AddBuildVectorOp.call(Ops, CurVec.getOperand(1), Idx);
                    if all_of(Ops, Closure_87 {}) {
                        return CanonicalizeBuildVector.call(Ops, false);
                    }
                    CurVec = operator(CurVec).getOperand(0);
                    continue;
                }
            }
            if CurVec.getOpcode() == VECTOR_SHUFFLE && CurVec.hasOneUse() {
                let mut SVN: *mut ShuffleVectorSDNode = cast(CurVec);
                let mut LHS: SDValue = SVN.getOperand(0);
                let mut RHS: SDValue = SVN.getOperand(1);
                let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> { SVN.getMask() };
                let mut Merged: bool = true;
                for I in enumerate(Ops) {
                    let mut Op: *mut SDValue = I.value();
                    if Op {
                        let mut NewMask: SmallVector<int, 16> = SmallVector<int, 16> {};
                        if !mergeEltWithShuffle(LHS, RHS, ArrayRef<int> { Mask }, NewMask, Op, I.index()) {
                            Merged = false;
                            break;
                        }
                        Mask = move(NewMask);
                    }
                }
                if Merged {
                    if self.TLI.buildLegalVectorShuffle(VT, DL, LHS, RHS, MutableArrayRef<int> { Mask }, self.DAG) {
                        NewShuffle;
                    } else {
                        return NewShuffle;
                    }
                }
            }
            if !self.LegalOperations {
                let mut IsNull: bool = isNullConstant(InVal);
                if (IsNull || isAllOnesConstant(InVal)) && all_of(Ops, Closure_88 { cap_0: InVal }) && count_if(Ops, Closure_89 { cap_0: InVal }) >= 2 {
                    let mut Zero: SDValue = self.DAG.getConstant(0, DL, MaxEltVT, false, false);
                    let mut AllOnes: SDValue = self.DAG.getAllOnesConstant(DL, MaxEltVT, false, false);
                    let mut Mask: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { NumElts };
                    let mut BuildMaskAndNode: Closure_90 = Closure_90 { NumElts: &mut NumElts, Mask: &mut Mask, Ops: &mut Ops, CurVec: &mut CurVec, cap_4: self, DL: &mut DL, VT: &mut VT };
                    if IsNull {
                        return BuildMaskAndNode.call(Zero, AllOnes, AND);
                    }
                    return BuildMaskAndNode.call(AllOnes, Zero, OR);
                }
            }
            break;
        }
        let mut DemandedZeroElts: APInt = getZero(NumElts);
        for let mut I: u32 = 0; I != NumElts; I += 1 {
            if !Ops[I] {
                DemandedZeroElts.setBit(I);
            }
        }
        if self.DAG.MaskedVectorIsZero(InVec, DemandedZeroElts, 0) {
            let mut Zero: SDValue = if VT.isInteger() { self.DAG.getConstant(0, DL, MaxEltVT, false, false) } else { self.DAG.getConstantFP(0, DL, MaxEltVT, false) };
            for let mut I: u32 = 0; I != NumElts; I += 1 {
                if !Ops[I] {
                    Ops[I] = Zero;
                }
            }
            return CanonicalizeBuildVector.call(Ops, false);
        }
    }
    return SDValue {};
}

fn scalarizeExtractedBinOp(ExtElt: *mut SDNode, DAG: *mut SelectionDAG, DL: *SDLoc, LegalTypes: bool) -> SDValue {
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut Vec: SDValue = ExtElt.getOperand(0);
    let mut Index: SDValue = ExtElt.getOperand(1);
    let mut IndexC: *mut ConstantSDNode = dyn_cast(Index);
    let mut Opc: u32 = Vec.getOpcode();
    if !IndexC || !Vec.hasOneUse() || (!TLI.isBinOp(Opc) && Opc != SETCC) || operator(Vec).getNumValues() != 1 {
        return SDValue {};
    }
    if !TLI.shouldScalarizeBinop(Vec) {
        return SDValue {};
    }
    let mut ResVT: EVT = ExtElt.getValueType(0);
    if Opc == SETCC && (ResVT != Vec.getValueType().getVectorElementType() || LegalTypes) {
        return SDValue {};
    }
    let mut IsExtractFree: Closure_91 = Closure_91 {};
    let mut Op0: SDValue = Vec.getOperand(0);
    let mut Op1: SDValue = Vec.getOperand(1);
    if !IsExtractFree.call(Op0) && !IsExtractFree.call(Op1) {
        return SDValue {};
    }
    if Opc == SETCC {
        let mut OpVT: EVT = Op0.getValueType().getVectorElementType();
        Op0 = DAG.getNode(EXTRACT_VECTOR_ELT, DL, OpVT, Op0, Index);
        Op1 = DAG.getNode(EXTRACT_VECTOR_ELT, DL, OpVT, Op1, Index);
        let mut NewVal: SDValue = DAG.getSetCC(DL, ResVT, Op0, Op1, cast(operator(Vec).getOperand(2)).get(), SDValue {}, false, SDNodeFlags { Flags: None });
        let mut VecBoolContents: u32 = TLI.getBooleanContents(Vec.getValueType());
        if ResVT != EVT { i1 } && VecBoolContents != UndefinedBooleanContent && VecBoolContents != TLI.getBooleanContents(ResVT) {
            if VecBoolContents == ZeroOrNegativeOneBooleanContent {
                NewVal = DAG.getNode(SIGN_EXTEND_INREG, DL, ResVT, NewVal, DAG.getValueType(EVT { i1 }));
            } else {
                NewVal = DAG.getZeroExtendInReg(NewVal, DL, EVT { i1 });
            }
        }
        return NewVal;
    }
    Op0 = DAG.getNode(EXTRACT_VECTOR_ELT, DL, ResVT, Op0, Index);
    Op1 = DAG.getNode(EXTRACT_VECTOR_ELT, DL, ResVT, Op1, Index);
    return DAG.getNode(Opc, DL, ResVT, Op0, Op1);
}

fn DAGCombiner::refineExtractVectorEltIntoMultipleNarrowExtractVectorElts(self, N: *mut SDNode) -> bool {
    if self.Level != AfterLegalizeVectorOps && self.Level != AfterLegalizeTypes {
        return false;
    }
    if self.DAG.getDataLayout().isBigEndian() {
        return false;
    }
    let mut VecOp: SDValue = N.getOperand(0);
    let mut VecVT: EVT = VecOp.getValueType();
    assert!(!VecVT.isScalableVector(), "Only for fixed vectors.");
    let mut IndexC: *mut ConstantSDNode = dyn_cast(N.getOperand(1));
    if !IndexC {
        return false;
    }
    assert!(IndexC.getZExtValue() < VecVT.getVectorNumElements(), "Original ISD::EXTRACT_VECTOR_ELT is undefinend?");
    let mut VecEltBitWidth: u32 = VecVT.getScalarSizeInBits();
    let mut ScalarVT: EVT = N.getValueType(0);
    if VecVT.getScalarType() != ScalarVT {
        return false;
    }
    if !ScalarVT.isScalarInteger() {
        return false;
    }
    let mut Worklist: SmallVector<Entry, 32> = SmallVector<Entry, 32> {};
    let mut Leafs: SmallVector<Entry, 32> = SmallVector<Entry, 32> {};
    Worklist.emplace_back(N, VecEltBitWidth * IndexC.getZExtValue(), VecEltBitWidth);
    while !Worklist.is_empty() {
        let mut E: Entry = Worklist.pop_back_val();
        if !(E.NumBits > 0 && E.BitPos < VecVT.getSizeInBits().operator unsigned long long() && E.BitPos + E.NumBits <= VecVT.getSizeInBits().operator unsigned long long()) {
            return false;
        }
        let mut ProducerIsLeaf: bool = false;
        for User in E.Producer.users() {
            match User.getOpcode() {
                TRUNCATE => {
                    Worklist.emplace_back(User, E.BitPos, User.getValueSizeInBits(0));
                },
                SRL => {
                    let mut ShAmtC: *mut ConstantSDNode = dyn_cast(User.getOperand(1));
                    if User.getOperand(0).getNode() == E.Producer && ShAmtC {
                        let mut ShAmt: u32 = ShAmtC.getZExtValue();
                        Worklist.emplace_back(User, E.BitPos + ShAmt, E.NumBits - ShAmt);
                        break;
                    }
                },
                _ => {
                    ProducerIsLeaf = true;
                },
            }
        }
        if ProducerIsLeaf {
            Leafs.emplace_back(move(E));
        }
    }
    let mut NewVecEltBitWidth: u32 = Leafs.front().NumBits;
    if NewVecEltBitWidth == VecEltBitWidth {
        return false;
    }
    if VecVT.getSizeInBits().operator unsigned long long() % NewVecEltBitWidth != 0 {
        return false;
    }
    if !all_of(Leafs, Closure_92 { NewVecEltBitWidth: NewVecEltBitWidth }) {
        return false;
    }
    let mut NewScalarVT: EVT = getIntegerVT(*self.DAG.getContext(), NewVecEltBitWidth);
    let mut NewVecVT: EVT = getVectorVT(*self.DAG.getContext(), NewScalarVT, VecVT.getSizeInBits().operator unsigned long long() / NewVecEltBitWidth, false);
    if self.LegalTypes && !(self.TLI.isTypeLegal(NewScalarVT) && self.TLI.isTypeLegal(NewVecVT)) {
        return false;
    }
    if self.LegalOperations && !(self.TLI.isOperationLegalOrCustom(BITCAST, NewVecVT, false) && self.TLI.isOperationLegalOrCustom(EXTRACT_VECTOR_ELT, NewVecVT, false)) {
        return false;
    }
    let mut NewVecOp: SDValue = self.DAG.getBitcast(NewVecVT, VecOp);
    for E in Leafs {
        let mut DL: SDLoc = SDLoc { E.Producer };
        let mut NewIndex: u32 = E.BitPos / NewVecEltBitWidth;
        assert!(NewIndex < NewVecVT.getVectorNumElements(), "Creating out-of-bounds ISD::EXTRACT_VECTOR_ELT?");
        let mut V: SDValue = self.DAG.getNode(EXTRACT_VECTOR_ELT, DL, NewScalarVT, NewVecOp, self.DAG.getVectorIdxConstant(NewIndex, DL, false));
        self.CombineTo(E.Producer, V, true);
    }
    return true;
}

fn DAGCombiner::visitEXTRACT_VECTOR_ELT(self, N: *mut SDNode) -> SDValue {
    let mut VecOp: SDValue = N.getOperand(0);
    let mut Index: SDValue = N.getOperand(1);
    let mut ScalarVT: EVT = N.getValueType(0);
    let mut VecVT: EVT = VecOp.getValueType();
    if VecOp.getOpcode() == POISON {
        return self.DAG.getPOISON(ScalarVT);
    }
    if VecOp.getOpcode() == UNDEF {
        return self.DAG.getUNDEF(ScalarVT);
    }
    let mut DL: SDLoc = SDLoc { N };
    if VecOp.getOpcode() == INSERT_VECTOR_ELT && Index == VecOp.getOperand(2) {
        let mut Elt: SDValue = VecOp.getOperand(1);
        self.AddUsersToWorklist(VecOp.getNode());
        return if VecVT.isInteger() { self.DAG.getAnyExtOrTrunc(Elt, DL, ScalarVT) } else { Elt };
    }
    if VecOp.getOpcode() == SCALAR_TO_VECTOR {
        if self.DAG.isKnownNeverZero(Index, 0) {
            return self.DAG.getPOISON(ScalarVT);
        }
        let mut InOp: SDValue = VecOp.getOperand(0);
        if InOp.getValueType() != ScalarVT {
            assert!(InOp.getValueType().isInteger() && ScalarVT.isInteger());
            if InOp.getValueType().bitsGT(ScalarVT) {
                return self.DAG.getNode(TRUNCATE, DL, ScalarVT, InOp);
            }
            return self.DAG.getNode(ANY_EXTEND, DL, ScalarVT, InOp);
        }
        return InOp;
    }
    let mut IndexC: *mut ConstantSDNode = dyn_cast(Index);
    if IndexC && VecVT.isFixedLengthVector() && IndexC.getAPIntValue().uge(VecVT.getVectorNumElements()) {
        return self.DAG.getPOISON(ScalarVT);
    }
    if ((IndexC && VecOp.getOpcode() == BUILD_VECTOR) || VecOp.getOpcode() == SPLAT_VECTOR) && self.TLI.isTypeLegal(VecVT) {
        assert!((VecOp.getOpcode() != BUILD_VECTOR || VecVT.isFixedLengthVector()), "BUILD_VECTOR used for scalable vectors");
        let mut IndexVal: u32 = if VecOp.getOpcode() == BUILD_VECTOR { IndexC.getZExtValue() } else { 0 };
        let mut Elt: SDValue = VecOp.getOperand(IndexVal);
        let mut InEltVT: EVT = Elt.getValueType();
        if VecOp.hasOneUse() || self.TLI.aggressivelyPreferBuildVectorSources(VecVT) || isNullConstant(Elt) {
            if ScalarVT == InEltVT {
                return Elt;
            }
        }
    }
    if scalarizeExtractedBinOp(N, self.DAG, DL, self.LegalTypes) {
        BO;
    } else {
        return BO;
    }
    if VecVT.isScalableVector() {
        return SDValue {};
    }
    let mut NumElts: u32 = VecVT.getVectorNumElements();
    let mut VecEltBitWidth: u32 = VecVT.getScalarSizeInBits();
    if IndexC && ScalarVT.isFloatingPoint() {
        let mut EltMask: APInt = getOneBitSet(NumElts, IndexC.getZExtValue());
        let mut KnownElt: KnownBits = self.DAG.computeKnownBits(VecOp, EltMask, 0);
        if KnownElt.isConstant() {
            let mut CstFP: APFloat = APFloat { ScalarVT.getFltSemantics(), KnownElt.getConstant() };
            if self.TLI.isFPImmLegal(CstFP, ScalarVT, false) {
                return self.DAG.getConstantFP(CstFP, DL, ScalarVT, false);
            }
        }
    }
    if IndexC && VecOp.getOpcode() == BITCAST && VecVT.isInteger() && VecOp.hasOneUse() {
        let mut IsLE: bool = self.DAG.getDataLayout().isLittleEndian();
        let mut ExtractIndex: u32 = IndexC.getZExtValue();
        let mut BCTruncElt: u32 = if IsLE { 0 } else { NumElts - 1 };
        let mut BCSrc: SDValue = VecOp.getOperand(0);
        if ExtractIndex == BCTruncElt && BCSrc.getValueType().isScalarInteger() {
            return self.DAG.getAnyExtOrTrunc(BCSrc, DL, ScalarVT);
        }
        if self.LegalTypes && BCSrc.getValueType().isInteger() && BCSrc.getOpcode() == SCALAR_TO_VECTOR && BCSrc.getScalarValueSizeInBits() == BCSrc.getOperand(0).getScalarValueSizeInBits() {
            let mut X: SDValue = BCSrc.getOperand(0);
            let mut XVT: EVT = X.getValueType();
            assert!(XVT.isScalarInteger() && ScalarVT.isScalarInteger(), "Extract element and scalar to vector can't change element type from FP to integer.");
            let mut XBitWidth: u32 = X.getValueSizeInBits().operator unsigned long long();
            let mut Scale: u32 = XBitWidth / VecEltBitWidth;
            BCTruncElt = if IsLE { 0 } else { Scale - 1 };
            if ExtractIndex < Scale && XBitWidth > VecEltBitWidth {
                assert!(XBitWidth % VecEltBitWidth == 0, "Scalar bitwidth must be a multiple of vector element bitwidth");
                if ExtractIndex != BCTruncElt {
                    let mut ShiftIndex: u32 = if IsLE { ExtractIndex } else { (Scale - 1) - ExtractIndex };
                    X = self.DAG.getNode(SRL, DL, XVT, X, self.DAG.getShiftAmountConstant(ShiftIndex * VecEltBitWidth, XVT, DL));
                }
                return self.DAG.getAnyExtOrTrunc(X, DL, ScalarVT);
            }
        }
    }
    if IndexC && VecOp.getOpcode() == VECTOR_SHUFFLE {
        let mut Shuf: *mut ShuffleVectorSDNode = cast(VecOp);
        let mut OrigElt: i32 = Shuf.getMaskElt(IndexC.getZExtValue());
        if OrigElt == -1 {
            return self.DAG.getPOISON(ScalarVT);
        }
        let mut SVInVec: SDValue = SDValue {};
        if OrigElt < NumElts as i32 {
            SVInVec = VecOp.getOperand(0);
        } else {
            SVInVec = VecOp.getOperand(1);
            OrigElt -= NumElts;
        }
        if SVInVec.getOpcode() == BUILD_VECTOR {
            if self.LegalOperations && self.TLI.isOperationLegal(VECTOR_SHUFFLE, VecVT) && !VecOp.hasOneUse() {
                return SDValue {};
            }
            let mut InOp: SDValue = SVInVec.getOperand(OrigElt);
            if InOp.getValueType() != ScalarVT {
                assert!(InOp.getValueType().isInteger() && ScalarVT.isInteger());
                InOp = self.DAG.getSExtOrTrunc(InOp, DL, ScalarVT);
            }
            return InOp;
        }
        if !self.LegalOperations || self.TLI.isOperationLegal(EXTRACT_VECTOR_ELT, VecVT) || self.TLI.isOperationExpand(VECTOR_SHUFFLE, VecVT) {
            return self.DAG.getNode(EXTRACT_VECTOR_ELT, DL, ScalarVT, SVInVec, self.DAG.getVectorIdxConstant(OrigElt, DL, false));
        }
    }
    if all_of(operator(VecOp).users(), Closure_93 { VecOp: &mut VecOp }) {
        let mut DemandedElts: APInt = getZero(NumElts);
        for User in operator(VecOp).users() {
            let mut CstElt: *mut ConstantSDNode = cast(User.getOperand(1));
            if CstElt.getAPIntValue().ult(NumElts) {
                DemandedElts.setBit(CstElt.getZExtValue());
            }
        }
        if self.SimplifyDemandedVectorElts(VecOp, DemandedElts, true) {
            if N.getOpcode() != DELETED_NODE {
                self.AddToWorklist(N, true, false);
            }
            return SDValue { Node: N, ResNo: 0 };
        }
        let mut DemandedBits: APInt = getAllOnes(VecEltBitWidth);
        if self.SimplifyDemandedBits(VecOp, DemandedBits, DemandedElts, true) {
            if N.getOpcode() != DELETED_NODE {
                self.AddToWorklist(N, true, false);
            }
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    if self.refineExtractVectorEltIntoMultipleNarrowExtractVectorElts(N) {
        return SDValue { Node: N, ResNo: 0 };
    }
    let mut BCNumEltsChanged: bool = false;
    let mut ExtVT: EVT = VecVT.getVectorElementType();
    let mut LVT: EVT = ExtVT;
    if ScalarVT.bitsLT(LVT) && !self.TLI.isTruncateFree(LVT, ScalarVT) {
        return SDValue {};
    }
    if VecOp.getOpcode() == BITCAST {
        if !VecOp.hasOneUse() {
            return SDValue {};
        }
        let mut BCVT: EVT = VecOp.getOperand(0).getValueType();
        if !BCVT.isVector() || ExtVT.bitsGT(BCVT.getVectorElementType()) {
            return SDValue {};
        }
        if NumElts != BCVT.getVectorNumElements() {
            BCNumEltsChanged = true;
        }
        VecOp = VecOp.getOperand(0);
        ExtVT = BCVT.getVectorElementType();
    }
    if !self.LegalOperations && !IndexC && VecOp.hasOneUse() && isNormalLoad(VecOp.getNode()) && !operator(Index).hasPredecessor(VecOp.getNode()) {
        let mut VecLoad: *mut LoadSDNode = dyn_cast(VecOp);
        if VecLoad && VecLoad.isSimple() {
            if self.TLI.scalarizeExtractedVectorLoad(ScalarVT, SDLoc { N }, VecVT, Index, VecLoad, self.DAG) {
                Scalarized;
            } else {
                operator(OpsNarrowed);
                return Scalarized;
            }
        }
    }
    if !self.LegalOperations || !IndexC {
        return SDValue {};
    }
    let mut IsFrozen: bool = false;
    if VecOp.getOpcode() == FREEZE && VecOp.hasOneUse() {
        VecOp = VecOp.getOperand(0);
        IsFrozen = true;
    }
    let mut Elt: i32 = IndexC.getZExtValue();
    let mut LN0: *mut LoadSDNode = null;
    if isNormalLoad(VecOp.getNode()) {
        LN0 = cast(VecOp);
    } else if VecOp.getOpcode() == SCALAR_TO_VECTOR && VecOp.getOperand(0).getValueType() == ExtVT && isNormalLoad(VecOp.getOperand(0).getNode()) {
        if !VecOp.hasOneUse() {
            return SDValue {};
        }
        LN0 = cast(VecOp.getOperand(0));
    }
    if dyn_cast(VecOp) {
        Shuf;
    } else {
        if !VecOp.hasOneUse() {
            return SDValue {};
        }
        if BCNumEltsChanged {
            return SDValue {};
        }
        let mut Idx: i32 = if (Elt > NumElts as i32) { -1 } else { Shuf.getMaskElt(Elt) };
        VecOp = if (Idx < NumElts as i32) { VecOp.getOperand(0) } else { VecOp.getOperand(1) };
        if VecOp.getOpcode() == BITCAST {
            if !VecOp.hasOneUse() {
                return SDValue {};
            }
            VecOp = VecOp.getOperand(0);
        }
        if isNormalLoad(VecOp.getNode()) {
            LN0 = cast(VecOp);
            Elt = if (Idx < NumElts as i32) { Idx } else { Idx - NumElts as i32 };
            Index = self.DAG.getConstant(Elt, DL, Index.getValueType(), false, false);
        }
    }
    if !LN0 || !LN0.hasNUsesOfValue(1, 0) || !LN0.isSimple() {
        return SDValue {};
    }
    if Elt == -1 {
        return self.DAG.getPOISON(LVT);
    }
    if self.TLI.scalarizeExtractedVectorLoad(LVT, DL, VecVT, Index, LN0, self.DAG) {
        Scalarized;
    } else {
        operator(OpsNarrowed);
        if IsFrozen {
            return self.DAG.getFreeze(Scalarized);
        }
        return Scalarized;
    }
    return SDValue {};
}

fn DAGCombiner::reduceBuildVecExtToExtBuildVec(self, N: *mut SDNode) -> SDValue {
    if self.Level != AfterLegalizeVectorOps && self.Level != AfterLegalizeTypes {
        return SDValue {};
    }
    let mut NumInScalars: u32 = N.getNumOperands();
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    let mut SourceType: EVT = EVT { Other };
    let mut AllAnyExt: bool = true;
    for let mut i: u32 = 0; i != NumInScalars; i += 1 {
        let mut In: SDValue = N.getOperand(i);
        if In.isUndef() {
            continue;
        }
        let mut AnyExt: bool = In.getOpcode() == ANY_EXTEND;
        let mut ZeroExt: bool = In.getOpcode() == ZERO_EXTEND;
        if !ZeroExt && !AnyExt {
            SourceType = EVT { Other };
            break;
        }
        let mut InTy: EVT = In.getOperand(0).getValueType();
        if SourceType == EVT { Other } {
            SourceType = InTy;
        } else if InTy != SourceType {
            SourceType = EVT { Other };
            break;
        }
        AllAnyExt &= AnyExt;
    }
    let mut OutScalarTy: EVT = VT.getScalarType();
    let mut ValidTypes: bool = SourceType != EVT { Other } && has_single_bit(OutScalarTy.getSizeInBits().operator unsigned long long()) && has_single_bit(SourceType.getSizeInBits().operator unsigned long long());
    if !ValidTypes {
        return SDValue {};
    }
    if !AllAnyExt && self.DAG.isSplatValue(SDValue { Node: N, ResNo: 0 }, true) {
        return SDValue {};
    }
    let mut isLE: bool = self.DAG.getDataLayout().isLittleEndian();
    let mut ElemRatio: u32 = OutScalarTy.getSizeInBits().operator unsigned long long() / SourceType.getSizeInBits().operator unsigned long long();
    assert!(ElemRatio > 1, "Invalid element size ratio");
    let mut Filler: SDValue = if AllAnyExt { self.DAG.getPOISON(SourceType) } else { self.DAG.getConstant(0, DL, SourceType, false, false) };
    let mut NewBVElems: u32 = ElemRatio * VT.getVectorNumElements();
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { NewBVElems, Filler };
    for let mut i: u32 = 0;
let mut e: u32 = N.getNumOperands(); i != e; i += 1 {
        let mut Cast: SDValue = N.getOperand(i);
        assert!((Cast.getOpcode() == ANY_EXTEND || Cast.getOpcode() == ZERO_EXTEND || Cast.isUndef()), "Invalid cast opcode");
        let mut In: SDValue = SDValue {};
        if Cast.isUndef() {
            In = self.DAG.getUNDEF(SourceType);
        } else {
            In = operator(Cast).getOperand(0);
        }
        let mut Index: u32 = if isLE { (i * ElemRatio) } else { (i * ElemRatio + (ElemRatio - 1)) };
        assert!(Index < Ops.len, "Invalid index");
        Ops[Index] = In;
    }
    let mut VecVT: EVT = getVectorVT(*self.DAG.getContext(), SourceType, NewBVElems, false);
    assert!(VecVT.getSizeInBits() == VT.getSizeInBits(), "Invalid vector size");
    if !self.isTypeLegal(VecVT) || (!self.TLI.isOperationLegal(BUILD_VECTOR, VecVT) && self.TLI.isOperationLegal(BUILD_VECTOR, VT)) {
        return SDValue {};
    }
    let mut BV: SDValue = self.DAG.getBuildVector(VecVT, DL, ArrayRef<SDValue> { Ops });
    self.AddToWorklist(BV.getNode(), true, false);
    return self.DAG.getBitcast(VT, BV);
}

fn DAGCombiner::reduceBuildVecTruncToBitCast(self, N: *mut SDNode) -> SDValue {
    assert!(N.getOpcode() == BUILD_VECTOR, "Expected build vector");
    let mut VT: EVT = N.getValueType(0);
    if self.Level < AfterLegalizeTypes && self.TLI.isTypeLegal(VT) {
        return SDValue {};
    }
    if !self.DAG.getDataLayout().isLittleEndian() {
        return SDValue {};
    }
    let mut OutScalarTy: EVT = VT.getScalarType();
    let mut ScalarTypeBitsize: u64 = OutScalarTy.getSizeInBits().operator unsigned long long();
    if !isPowerOf2_64(ScalarTypeBitsize) {
        return SDValue {};
    }
    let mut NumInScalars: u32 = N.getNumOperands();
    let mut PeekThroughBitcast: Closure_94 = Closure_94 {};
    let mut Src: SDValue = SDValue {};
    for let mut i: u32 = 0; i != NumInScalars; i += 1 {
        let mut In: SDValue = PeekThroughBitcast.call(N.getOperand(i));
        if In.isUndef() {
            continue;
        }
        if In.getOpcode() != TRUNCATE {
            return SDValue {};
        }
        In = PeekThroughBitcast.call(In.getOperand(0));
        if In.getOpcode() != SRL {
            if i != 0 {
                return SDValue {};
            }
            Src = In;
        } else {
            let mut part: SDValue = PeekThroughBitcast.call(In.getOperand(0));
            if !Src {
                Src = part;
            } else if Src != part {
                return SDValue {};
            }
            let mut ShiftAmtVal: SDValue = In.getOperand(1);
            if !isa(ShiftAmtVal) {
                return SDValue {};
            }
            let mut ShiftAmt: u64 = In.getConstantOperandVal(1);
            if ShiftAmt != i * ScalarTypeBitsize {
                return SDValue {};
            }
        }
    }
    if !Src || Src.getValueType().getSizeInBits() != VT.getSizeInBits() {
        return SDValue {};
    }
    return self.DAG.getBitcast(VT, Src);
}

fn DAGCombiner::createBuildVecShuffle(self, DL: *SDLoc, N: *mut SDNode, VectorMask: ArrayRef<int>, VecIn1: SDValue, VecIn2: SDValue, LeftIdx: u32, DidSplitVec: bool) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut InVT1: EVT = VecIn1.getValueType();
    let mut InVT2: EVT = if VecIn2.getNode() { VecIn2.getValueType() } else { InVT1 };
    let mut NumElems: u32 = VT.getVectorNumElements();
    let mut ShuffleNumElems: u32 = NumElems;
    let mut Vec2Offset: u32 = if DidSplitVec { 0 } else { InVT1.getVectorNumElements() };
    let mut VTSize: u64 = VT.getFixedSizeInBits();
    let mut InVT1Size: u64 = InVT1.getFixedSizeInBits();
    let mut InVT2Size: u64 = InVT2.getFixedSizeInBits();
    assert!(InVT2Size <= InVT1Size, "Inputs must be sorted to be in non-increasing vector size order.");
    if InVT1 != VT || InVT2 != VT {
        if (VTSize % InVT1Size == 0) && InVT1 == InVT2 {
            let mut NumConcats: u32 = VTSize / InVT1Size;
            assert!(NumConcats >= 2, "Concat needs at least two inputs!");
            let mut ConcatOps: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> { NumConcats, self.DAG.getPOISON(InVT1) };
            ConcatOps[0] = VecIn1;
            ConcatOps[1] = if VecIn2 {} else { self.DAG.getPOISON(InVT1) };
            VecIn1 = self.DAG.getNode(CONCAT_VECTORS, DL, VT, ArrayRef<SDValue> { ConcatOps });
            VecIn2 = SDValue {};
        } else if InVT1Size == VTSize * 2 {
            if self.TLI.getExtractSubvectorCost(VT, InVT1, NumElems) > Cheap {
                return SDValue {};
            }
            if !VecIn2.getNode() {
                VecIn2 = self.DAG.getNode(EXTRACT_SUBVECTOR, DL, VT, VecIn1, self.DAG.getVectorIdxConstant(NumElems, DL, false));
                VecIn1 = self.DAG.getExtractSubvector(DL, VT, VecIn1, 0);
                Vec2Offset = NumElems;
            } else {
                assert!(InVT2Size <= InVT1Size, "Second input is not going to be larger than the first one.");
                if self.LegalOperations && !self.TLI.isOperationLegal(VECTOR_SHUFFLE, InVT1) {
                    return SDValue {};
                }
                if InVT1 != InVT2 {
                    if !self.TLI.isTypeLegal(InVT2) {
                        return SDValue {};
                    }
                    VecIn2 = self.DAG.getInsertSubvector(DL, self.DAG.getPOISON(InVT1), VecIn2, 0);
                }
                ShuffleNumElems = NumElems * 2;
            }
        } else if InVT2Size * 2 == VTSize && InVT1Size == VTSize {
            let mut ConcatOps: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> { 2, self.DAG.getPOISON(InVT2) };
            ConcatOps[0] = VecIn2;
            VecIn2 = self.DAG.getNode(CONCAT_VECTORS, DL, VT, ArrayRef<SDValue> { ConcatOps });
        } else if InVT1Size / VTSize > 1 && InVT1Size % VTSize == 0 {
            if self.TLI.getExtractSubvectorCost(VT, InVT1, NumElems) > Cheap || !self.TLI.isTypeLegal(InVT1) || !self.TLI.isTypeLegal(InVT2) {
                return SDValue {};
            }
            if VT.getVectorNumElements() <= 2 || !VecIn2.getNode() {
                return SDValue {};
            }
            assert!(InVT2Size <= InVT1Size, "Second input is not going to be larger than the first one.");
            if self.LegalOperations && !self.TLI.isOperationLegal(VECTOR_SHUFFLE, InVT1) {
                return SDValue {};
            }
            if InVT1 != InVT2 {
                VecIn2 = self.DAG.getInsertSubvector(DL, self.DAG.getPOISON(InVT1), VecIn2, 0);
            }
            ShuffleNumElems = InVT1Size / VTSize * NumElems;
        } else {
            return SDValue {};
        }
    }
    let mut Mask: SmallVector<int, 8> = SmallVector<int, 8> { ShuffleNumElems, -1 };
    for let mut i: u32 = 0; i != NumElems; i += 1 {
        if VectorMask[i] <= 0 {
            continue;
        }
        let mut ExtIndex: u32 = N.getOperand(i).getConstantOperandVal(1);
        if VectorMask[i] == LeftIdx as i32 {
            Mask[i] = ExtIndex;
        } else if VectorMask[i] == LeftIdx as i32 + 1 {
            Mask[i] = Vec2Offset + ExtIndex;
        }
    }
    InVT1 = VecIn1.getValueType();
    VecIn2 = if VecIn2.getNode() { VecIn2 } else { self.DAG.getPOISON(InVT1) };
    assert!(InVT1 == VecIn2.getValueType(), "Unexpected second input type.");
    let mut Shuffle: SDValue = self.DAG.getVectorShuffle(InVT1, DL, VecIn1, VecIn2, ArrayRef<int> { Mask });
    if ShuffleNumElems > NumElems {
        Shuffle = self.DAG.getExtractSubvector(DL, VT, Shuffle, 0);
    }
    return Shuffle;
}

fn reduceBuildVecToShuffleWithZero(BV: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    assert!(BV.getOpcode() == BUILD_VECTOR, "Expected build vector");
    let mut NumBVOps: i32 = BV.getNumOperands();
    let mut ZextElt: i32 = -1;
    for let mut i: i32 = 0; i != NumBVOps; i += 1 {
        let mut Op: SDValue = BV.getOperand(i);
        if Op.isUndef() {
            continue;
        }
        if ZextElt == -1 {
            ZextElt = i;
        } else {
            return SDValue {};
        }
    }
    if ZextElt == -1 {
        return SDValue {};
    }
    let mut VT: EVT = BV.getValueType(0);
    let mut Zext: SDValue = BV.getOperand(ZextElt);
    if Zext.getOpcode() != ZERO_EXTEND || !Zext.hasOneUse() || Zext.getOperand(0).getOpcode() != EXTRACT_VECTOR_ELT || !isa(Zext.getOperand(0).getOperand(1)) || Zext.getValueSizeInBits().operator unsigned long long() != VT.getScalarSizeInBits() {
        return SDValue {};
    }
    let mut Extract: SDValue = Zext.getOperand(0);
    let mut DestSize: u32 = Zext.getValueSizeInBits().operator unsigned long long();
    let mut SrcSize: u32 = Extract.getValueSizeInBits().operator unsigned long long();
    if DestSize % SrcSize != 0 || Extract.getOperand(0).getValueSizeInBits() != VT.getSizeInBits() {
        return SDValue {};
    }
    let mut ZextRatio: i32 = DestSize / SrcSize;
    let mut NumMaskElts: i32 = NumBVOps * ZextRatio;
    let mut ShufMask: SmallVector<int, 32> = SmallVector<int, 32> { NumMaskElts, -1 };
    for let mut i: i32 = 0; i != NumMaskElts; i += 1 {
        if i / ZextRatio == ZextElt {
            let mut Low: i32 = if DAG.getDataLayout().isBigEndian() { (ZextRatio - 1) } else { 0 };
            ShufMask[i] = if (i % ZextRatio == Low) { Extract.getConstantOperandVal(1) } else { NumMaskElts };
        }
    }
    let mut DL: SDLoc = SDLoc { BV };
    let mut VecVT: EVT = Extract.getOperand(0).getValueType();
    let mut ZeroVec: SDValue = DAG.getConstant(0, DL, VecVT, false, false);
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut Shuf: SDValue = TLI.buildLegalVectorShuffle(VecVT, DL, Extract.getOperand(0), ZeroVec, MutableArrayRef<int> { ShufMask }, DAG);
    if !Shuf {
        return SDValue {};
    }
    return DAG.getBitcast(VT, Shuf);
}

// ========================================================
// [C++ Template - Неинстанциированный шаблон функции: getFirstIndexOf]
// template <typename R, typename T>
// fn getFirstIndexOf(Range: *mut *mut SDValue, int>>, Val: *SDValue, int>) -> SDValue, int> *> {
//     let mut I: *SDValue, int> = find(Range, Val);
//     if I == Range.end() {
//         return -1 as distance(Range.begin(), I));
//     }
//     return distance(Range.begin(), I);
// }
// ========================================================

fn DAGCombiner::reduceBuildVecToShuffle(self, N: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    if !self.isTypeLegal(VT) {
        return SDValue {};
    }
    if reduceBuildVecToShuffleWithZero(N, self.DAG) {
        V;
    } else {
        return V;
    }
    if self.LegalOperations && !self.TLI.isOperationLegal(VECTOR_SHUFFLE, VT) {
        return SDValue {};
    }
    let mut UsesZeroVector: bool = false;
    let mut NumElems: u32 = N.getNumOperands();
    let mut VectorMask: SmallVector<int, 8> = SmallVector<int, 8> { NumElems, -1 };
    let mut VecIn: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    VecIn.push(SDValue {});
    let mut OneConstExtractIndex: u32 = ~0;
    let mut NumExtracts: u32 = 0;
    for let mut i: u32 = 0; i != NumElems; i += 1 {
        let mut Op: SDValue = N.getOperand(i);
        if Op.isUndef() {
            continue;
        }
        if isNullConstant(Op) || isNullFPConstant(Op) {
            UsesZeroVector = true;
            VectorMask[i] = 0;
            continue;
        }
        if Op.getOpcode() != EXTRACT_VECTOR_ELT {
            return SDValue {};
        }
        let mut ExtractedFromVec: SDValue = Op.getOperand(0);
        if ExtractedFromVec.getValueType().isScalableVector() {
            return SDValue {};
        }
        let mut ExtractIdx: *mut ConstantSDNode = dyn_cast(Op.getOperand(1));
        if !ExtractIdx {
            return SDValue {};
        }
        if ExtractIdx.getAsAPIntVal().uge(ExtractedFromVec.getValueType().getVectorNumElements()) {
            return SDValue {};
        }
        if VT.getVectorElementType() != ExtractedFromVec.getValueType().getVectorElementType() {
            return SDValue {};
        }
        OneConstExtractIndex = ExtractIdx.getZExtValue();
        NumExtracts += 1;
        let mut Idx: i32 = getFirstIndexOf(VecIn, ExtractedFromVec);
        if Idx == -1 {
            Idx = VecIn.len;
            VecIn.push(ValueParamT { ExtractedFromVec });
        }
        VectorMask[i] = Idx;
    }
    if VecIn.len < 2 {
        return SDValue {};
    }
    let mut DidSplitVec: bool = false;
    if VecIn.len == 2 {
        if NumExtracts == 1 && self.TLI.isOperationLegalOrCustom(EXTRACT_VECTOR_ELT, VT, false) && self.TLI.isTypeLegal(VT.getVectorElementType()) && self.TLI.isExtractVecEltCheap(VT, OneConstExtractIndex) {
            return SDValue {};
        }
        let mut MaxIndex: u32 = 0;
        let mut NearestPow2: u32 = 0;
        let mut Vec: SDValue = VecIn.back();
        let mut InVT: EVT = Vec.getValueType();
        let mut IndexVec: SmallVector<unsigned int, 8> = SmallVector<unsigned int, 8> { NumElems, 0 };
        for let mut i: u32 = 0; i < NumElems; i += 1 {
            if VectorMask[i] <= 0 {
                continue;
            }
            let mut Index: u32 = N.getOperand(i).getConstantOperandVal(1);
            IndexVec[i] = Index;
            MaxIndex = if MaxIndex > Index { MaxIndex } else { Index };
        }
        NearestPow2 = PowerOf2Ceil(MaxIndex);
        if InVT.isSimple() && NearestPow2 > 2 && MaxIndex < NearestPow2 && NumElems * 2 < NearestPow2 {
            let mut SplitSize: u32 = NearestPow2 / 2;
            let mut SplitVT: EVT = getVectorVT(*self.DAG.getContext(), InVT.getVectorElementType(), SplitSize, false);
            if self.TLI.isTypeLegal(SplitVT) && SplitSize + SplitVT.getVectorNumElements() <= InVT.getVectorNumElements() {
                let mut VecIn2: SDValue = self.DAG.getNode(EXTRACT_SUBVECTOR, DL, SplitVT, Vec, self.DAG.getVectorIdxConstant(SplitSize, DL, false));
                let mut VecIn1: SDValue = self.DAG.getNode(EXTRACT_SUBVECTOR, DL, SplitVT, Vec, self.DAG.getVectorIdxConstant(0, DL, false));
                VecIn.pop();
                VecIn.push(ValueParamT { VecIn1 });
                VecIn.push(ValueParamT { VecIn2 });
                DidSplitVec = true;
                for let mut i: u32 = 0; i < NumElems; i += 1 {
                    if VectorMask[i] <= 0 {
                        continue;
                    }
                    VectorMask[i] = if (IndexVec[i] < SplitSize) { 1 } else { 2 };
                }
            }
        }
    }
    let mut SortedVecIn: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { VecIn };
    stable_sort(MutableArrayRef<SDValue> { SortedVecIn }.drop_front(1), Closure_95 {});
    for SourceVectorIndex in VectorMask {
        if SourceVectorIndex <= 0 {
            continue;
        }
        let mut Idx: u32 = getFirstIndexOf(SortedVecIn, VecIn[SourceVectorIndex]);
        assert!(Idx > 0 && Idx < SortedVecIn.len && VecIn[SourceVectorIndex] == SortedVecIn[Idx], "Remapping failure");
        SourceVectorIndex = Idx;
    }
    VecIn = move(SortedVecIn);
    let mut Shuffles: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    for let mut In: u32 = 0;
let mut Len: u32 = (VecIn.len / 2); In < Len; In += 1 {
        let mut LeftIdx: u32 = 2 * In + 1;
        let mut VecLeft: SDValue = VecIn[LeftIdx];
        let mut VecRight: SDValue = if (LeftIdx + 1) < VecIn.len { VecIn[LeftIdx + 1] } else { SDValue {} };
        if self.createBuildVecShuffle(DL, N, ArrayRef<int> { VectorMask }, VecLeft, VecRight, LeftIdx, DidSplitVec) {
            Shuffle;
        } else {
            Shuffles.push(ValueParamT { Shuffle });
        }
    }
    if UsesZeroVector {
        Shuffles.push(if VT.isInteger() { self.DAG.getConstant(0, DL, VT, false, false) } else { self.DAG.getConstantFP(0.0, DL, VT, false) });
    }
    if Shuffles.len == 1 {
        return Shuffles[0];
    }
    for Vec in VectorMask {
        if Vec == 0 {
            Vec = Shuffles.len - 1;
        } else {
            Vec = (Vec - 1) / 2;
        }
    }
    if Shuffles.len % 2 {
        Shuffles.push(self.DAG.getPOISON(VT));
    }
    for let mut CurSize: u32 = Shuffles.len; CurSize > 1; CurSize /= 2 {
        if CurSize % 2 {
            Shuffles[CurSize] = self.DAG.getPOISON(VT);
            CurSize += 1;
        }
        for let mut In: u32 = 0;
let mut Len: u32 = CurSize / 2; In < Len; In += 1 {
            let mut Left: i32 = 2 * In;
            let mut Right: i32 = 2 * In + 1;
            let mut Mask: SmallVector<int, 8> = SmallVector<int, 8> { NumElems, -1 };
            let mut L: SDValue = Shuffles[Left];
            let mut LMask: ArrayRef<int> = ArrayRef<int> {};
            let mut IsLeftShuffle: bool = L.getOpcode() == VECTOR_SHUFFLE && L.use_empty() && L.getOperand(1).isUndef() && L.getOperand(0).getValueType() == L.getValueType();
            if IsLeftShuffle {
                LMask = cast(L.getNode()).getMask();
                L = L.getOperand(0);
            }
            let mut R: SDValue = Shuffles[Right];
            let mut RMask: ArrayRef<int> = ArrayRef<int> {};
            let mut IsRightShuffle: bool = R.getOpcode() == VECTOR_SHUFFLE && R.use_empty() && R.getOperand(1).isUndef() && R.getOperand(0).getValueType() == R.getValueType();
            if IsRightShuffle {
                RMask = cast(R.getNode()).getMask();
                R = R.getOperand(0);
            }
            for let mut I: u32 = 0; I != NumElems; I += 1 {
                if VectorMask[I] == Left {
                    Mask[I] = I;
                    if IsLeftShuffle {
                        Mask[I] = LMask[I];
                    }
                    VectorMask[I] = In;
                } else if VectorMask[I] == Right {
                    Mask[I] = I + NumElems;
                    if IsRightShuffle {
                        Mask[I] = RMask[I] + NumElems;
                    }
                    VectorMask[I] = In;
                }
            }
            Shuffles[In] = self.DAG.getVectorShuffle(VT, DL, L, R, ArrayRef<int> { Mask });
        }
    }
    return Shuffles[0];
}

fn DAGCombiner::convertBuildVecExtToExt(self, N: *mut SDNode) -> SDValue {
    if self.LegalOperations {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    let mut FoundZeroExtend: bool = false;
    let mut FoundSignExtend: bool = false;
    let mut Op0: SDValue = N.getOperand(0);
    let mut checkElem: Closure_96 = Closure_96 { FoundZeroExtend: &mut FoundZeroExtend, FoundSignExtend: &mut FoundSignExtend, Op0: &mut Op0 };
    let mut Offset: i64 = checkElem.call(Op0);
    if Offset < 0 || (Offset % VT.getVectorNumElements()) != 0 {
        return SDValue {};
    }
    let mut NumElems: u32 = N.getNumOperands();
    let mut In: SDValue = Op0.getOperand(0).getOperand(0);
    let mut InSVT: EVT = In.getValueType().getScalarType();
    let mut InVT: EVT = getVectorVT(*self.DAG.getContext(), InSVT, NumElems, false);
    if self.LegalTypes && !self.TLI.isTypeLegal(InVT) {
        return SDValue {};
    }
    for let mut i: u32 = 1; i != NumElems; i += 1 {
        if (Offset + i) != checkElem.call(N.getOperand(i)) {
            return SDValue {};
        }
    }
    if FoundZeroExtend && FoundSignExtend {
        return SDValue {};
    }
    let mut ExtOpc: u32 = ANY_EXTEND;
    if FoundSignExtend {
        ExtOpc = SIGN_EXTEND;
    } else if FoundZeroExtend {
        ExtOpc = ZERO_EXTEND;
    }
    let mut DL: SDLoc = SDLoc { N };
    In = self.DAG.getNode(EXTRACT_SUBVECTOR, DL, InVT, In, Op0.getOperand(0).getOperand(1));
    return self.DAG.getNode(ExtOpc, DL, VT, In);
}

fn DAGCombiner::convertBuildVecZextToBuildVecWithZeros(self, N: *mut SDNode) -> SDValue {
    if self.Level >= AfterLegalizeDAG {
        return SDValue {};
    }
    if self.DAG.getDataLayout().isBigEndian() {
        return SDValue {};
    }
    let mut VT: EVT = N.getValueType(0);
    let mut OpVT: EVT = N.getOperand(0).getValueType();
    assert!(!VT.isScalableVector(), "Encountered scalable BUILD_VECTOR?");
    let mut OpIntVT: EVT = getIntegerVT(*self.DAG.getContext(), OpVT.getSizeInBits().operator unsigned long long());
    if !self.TLI.isTypeLegal(OpIntVT) || (self.LegalOperations && !self.TLI.isOperationLegalOrCustom(BITCAST, OpIntVT, false)) {
        return SDValue {};
    }
    let mut EltBitwidth: u32 = VT.getScalarSizeInBits();
    let mut ActiveBits: u32 = 0;
    let mut KnownZeroOps: APInt = APInt { VT.getVectorNumElements(), 0, false, false };
    for I in enumerate(N.ops()) {
        let mut Op: SDValue = I.value().operator const llvm::SDValue &();
        if dyn_cast(Op) {
            Cst;
        } else {
            let mut OpActiveBits: u32 = Cst.getAPIntValue().trunc(EltBitwidth).getActiveBits();
            if OpActiveBits == 0 {
                KnownZeroOps.setBit(I.index());
                continue;
            }
            return SDValue {};
        }
        if I.index() != 0 {
            return SDValue {};
        }
        if Op.getOpcode() != ZERO_EXTEND {
            return SDValue {};
        }
        let mut CurrActiveBits: u32 = Op.getOperand(0).getValueSizeInBits().getFixedValue();
        assert!(!ActiveBits, "Already encountered non-constant-zero operand?");
        ActiveBits = CurrActiveBits;
        if 2 * ActiveBits > EltBitwidth {
            return SDValue {};
        }
    }
    if ActiveBits == 0 {
        return SDValue {};
    }
    let mut NewScalarIntVT: EVT = EVT {};
    let mut NewIntVT: EVT = EVT {};
    let mut Factor: optional<unsigned int> = optional<unsigned int> {};
    assert!(2 * ActiveBits <= EltBitwidth, "We know that half or less bits of the element are active.");
    for let mut Scale: u32 = EltBitwidth / ActiveBits; Scale >= 2; Scale -= 1 {
        if EltBitwidth % Scale != 0 {
            continue;
        }
        let mut ChunkBitwidth: u32 = EltBitwidth / Scale;
        assert!(ChunkBitwidth >= ActiveBits, "As per starting point.");
        NewScalarIntVT = getIntegerVT(*self.DAG.getContext(), ChunkBitwidth);
        NewIntVT = getVectorVT(*self.DAG.getContext(), NewScalarIntVT, Scale * N.getNumOperands(), false);
        if !self.TLI.isTypeLegal(NewScalarIntVT) || !self.TLI.isTypeLegal(NewIntVT) || (self.LegalOperations && !(self.TLI.isOperationLegalOrCustom(TRUNCATE, NewScalarIntVT, false) && self.TLI.isOperationLegalOrCustom(BUILD_VECTOR, NewIntVT, false))) {
            continue;
        }
        Factor = optional<unsigned int> { Scale };
        break;
    }
    if !Factor {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { N };
    let mut ZeroOp: SDValue = self.DAG.getConstant(0, DL, NewScalarIntVT, false, false);
    let mut NewOps: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    NewOps.reserve(NewIntVT.getVectorNumElements());
    for I in enumerate(N.ops()) {
        let mut Op: SDValue = I.value().operator const llvm::SDValue &();
        assert!(!Op.isUndef(), "FIXME: after allowing UNDEF's, handle them here.");
        let mut SrcOpIdx: u32 = I.index();
        if KnownZeroOps[SrcOpIdx] {
            NewOps.append(operator(Factor), ValueParamT { ZeroOp });
            continue;
        }
        Op = self.DAG.getBitcast(OpIntVT, Op);
        Op = self.DAG.getNode(TRUNCATE, DL, NewScalarIntVT, Op);
        NewOps.emplace_back(Op);
        NewOps.append(operator(Factor) - 1, ValueParamT { ZeroOp });
    }
    assert!(NewOps.len == NewIntVT.getVectorNumElements());
    let mut NewBV: SDValue = self.DAG.getBuildVector(NewIntVT, DL, ArrayRef<SDValue> { NewOps });
    NewBV = self.DAG.getBitcast(VT, NewBV);
    return NewBV;
}

fn DAGCombiner::visitBUILD_VECTOR(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if allOperandsUndef(N) {
        return self.DAG.getUNDEF(VT);
    }
    if !self.LegalOperations {
        let mut Splat: SDValue = cast(N).getSplatValue(null);
        if Splat && Splat.getValueType() == VT.getVectorElementType() {
            Splat = peekThroughBitcasts(Splat);
            let mut SrcVT: EVT = Splat.getValueType();
            if SrcVT.isVector() {
                let mut NumElts: u32 = N.getNumOperands() * SrcVT.getVectorNumElements();
                let mut NewVT: EVT = getVectorVT(*self.DAG.getContext(), SrcVT.getVectorElementType(), NumElts, false);
                if !self.LegalTypes || self.TLI.isTypeLegal(NewVT) {
                    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { N.getNumOperands(), Splat };
                    let mut Concat: SDValue = self.DAG.getNode(CONCAT_VECTORS, SDLoc { N }, NewVT, ArrayRef<SDValue> { Ops });
                    return self.DAG.getBitcast(VT, Concat);
                }
            }
        }
    }
    if !self.LegalTypes && (N.getNumOperands() > 1) {
        let mut Op0: SDValue = N.getOperand(0);
        let mut checkElem: Closure_97 = Closure_97 { Op0: &mut Op0 };
        let mut Offset: i32 = checkElem.call(Op0);
        for let mut i: u32 = 0; i < N.getNumOperands(); i += 1 {
            if Offset + i != checkElem.call(N.getOperand(i)) {
                Offset = -1;
                break;
            }
        }
        if (Offset == 0) && (Op0.getOperand(0).getValueType() == N.getValueType(0)) {
            return Op0.getOperand(0);
        }
        if (Offset != -1) && ((Offset % N.getValueType(0).getVectorNumElements()) == 0) {
            return self.DAG.getNode(EXTRACT_SUBVECTOR, SDLoc { N }, N.getValueType(0), Op0.getOperand(0), Op0.getOperand(1));
        }
    }
    if self.convertBuildVecExtToExt(N) {
        V;
    } else {
        return V;
    }
    if self.convertBuildVecZextToBuildVecWithZeros(N) {
        V;
    } else {
        return V;
    }
    if self.reduceBuildVecExtToExtBuildVec(N) {
        V;
    } else {
        return V;
    }
    if self.reduceBuildVecTruncToBitCast(N) {
        V;
    } else {
        return V;
    }
    if self.reduceBuildVecToShuffle(N) {
        V;
    } else {
        return V;
    }
    if self.TLI.getOperationAction(SPLAT_VECTOR, VT) != Expand {
        if cast(N).getSplatValue(null) {
            V;
        } else {
            assert!(!V.isUndef(), "Splat of undef should have been handled earlier");
            return self.DAG.getNode(SPLAT_VECTOR, SDLoc { N }, VT, V);
        }
    }
    return SDValue {};
}

fn combineConcatVectorOfScalars(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut OpVT: EVT = N.getOperand(0).getValueType();
    if TLI.isTypeLegal(OpVT) || OpVT.isScalableVector() {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut SVT: EVT = getIntegerVT(*DAG.getContext(), OpVT.getSizeInBits().operator unsigned long long());
    let mut AnyFPVT: EVT = EVT {};
    for Op in N.ops() {
        if BITCAST == Op.getOpcode() && !Op.getOperand(0).getValueType().isVector() {
            Ops.push(ValueParamT { Op.getOperand(0) });
        } else if Op.isUndef() {
            Ops.push(DAG.getNode(Op.getOpcode(), DL, SVT));
        } else {
            return SDValue {};
        }
        let mut LastOpVT: EVT = Ops.back().getValueType();
        if LastOpVT.isFloatingPoint() {
            AnyFPVT = LastOpVT;
        } else if !LastOpVT.isInteger() {
            return SDValue {};
        }
    }
    if AnyFPVT != EVT {} {
        SVT = AnyFPVT;
        for Op in Ops {
            if Op.getValueType() == SVT {
                continue;
            }
            if Op.isUndef() {
                Op = DAG.getNode(Op.getOpcode(), DL, SVT);
            } else {
                Op = DAG.getBitcast(SVT, Op);
            }
        }
    }
    let mut VecVT: EVT = getVectorVT(*DAG.getContext(), SVT, VT.getSizeInBits().operator unsigned long long() / SVT.getSizeInBits().operator unsigned long long(), false);
    return DAG.getBitcast(VT, DAG.getBuildVector(VecVT, DL, ArrayRef<SDValue> { Ops }));
}

fn combineConcatVectorOfConcatVectors(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut SubVT: EVT = EVT {};
    let mut FirstConcat: SDValue = SDValue {};
    for Op in N.ops() {
        if Op.isUndef() {
            continue;
        }
        if Op.getOpcode() != CONCAT_VECTORS {
            return SDValue {};
        }
        if !FirstConcat {
            SubVT = Op.getOperand(0).getValueType();
            if !DAG.getTargetLoweringInfo().isTypeLegal(SubVT) {
                return SDValue {};
            }
            FirstConcat = Op;
            continue;
        }
        if SubVT != Op.getOperand(0).getValueType() {
            return SDValue {};
        }
    }
    assert!(FirstConcat, "Concat of all-undefs found");
    let mut ConcatOps: SmallVector<SDValue> = SmallVector<SDValue> {};
    for Op in N.ops() {
        if Op.isUndef() {
            ConcatOps.append(operator(FirstConcat).getNumOperands(), DAG.getNode(Op.getOpcode(), SDLoc {}, SubVT));
            continue;
        }
        ConcatOps.append(operator(Op).op_begin(), operator(Op).op_end());
    }
    return DAG.getNode(CONCAT_VECTORS, SDLoc { N }, VT, ArrayRef<SDValue> { ConcatOps });
}

fn combineConcatVectorOfExtracts(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut OpVT: EVT = N.getOperand(0).getValueType();
    if VT.isScalableVector() {
        return SDValue {};
    }
    let mut NumElts: i32 = VT.getVectorNumElements();
    let mut NumOpElts: i32 = OpVT.getVectorNumElements();
    let mut SV0: SDValue = DAG.getPOISON(VT);
    let mut SV1: SDValue = DAG.getPOISON(VT);
    let mut Mask: SmallVector<int, 8> = SmallVector<int, 8> {};
    for Op in N.ops() {
        Op = peekThroughBitcasts(Op);
        if Op.isUndef() {
            Mask.append(NumOpElts as u32, -1);
            continue;
        }
        if Op.getOpcode() != EXTRACT_SUBVECTOR {
            return SDValue {};
        }
        let mut ExtVec: SDValue = Op.getOperand(0);
        let mut ExtIdx: i32 = Op.getConstantOperandVal(1);
        let mut ExtVT: EVT = ExtVec.getValueType();
        ExtVec = peekThroughBitcasts(ExtVec);
        if ExtVec.isUndef() {
            Mask.append(NumOpElts as u32, -1);
            continue;
        }
        if ExtVT.getSizeInBits() != VT.getSizeInBits() {
            return SDValue {};
        }
        let mut NumExtElts: i32 = ExtVT.getVectorNumElements();
        if 0 == (NumExtElts % NumElts) {
            ExtIdx /= (NumExtElts / NumElts);
        } else if 0 == (NumElts % NumExtElts) {
            ExtIdx *= (NumElts / NumExtElts);
        } else {
            return SDValue {};
        }
        if SV0.isUndef() || SV0 == ExtVec {
            SV0 = ExtVec;
            for let mut i: i32 = 0; i != NumOpElts; i += 1 {
                Mask.push(i + ExtIdx);
            }
        } else if SV1.isUndef() || SV1 == ExtVec {
            SV1 = ExtVec;
            for let mut i: i32 = 0; i != NumOpElts; i += 1 {
                Mask.push(i + ExtIdx + NumElts);
            }
        } else {
            return SDValue {};
        }
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    return TLI.buildLegalVectorShuffle(VT, SDLoc { N }, DAG.getBitcast(VT, SV0), DAG.getBitcast(VT, SV1), MutableArrayRef<int> { Mask }, DAG);
}

fn combineConcatVectorOfCasts(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut CastOpcode: u32 = N.getOperand(0).getOpcode();
    match CastOpcode {
        SINT_TO_FP => {
            UINT_TO_FP;
        },
        _ => {
            return SDValue {};
        },
    }
    let mut SrcVT: EVT = N.getOperand(0).getOperand(0).getValueType();
    if !SrcVT.isVector() {
        return SDValue {};
    }
    let mut SrcOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    for Op in N.ops() {
        if Op.getOpcode() != CastOpcode || !Op.hasOneUse() || Op.getOperand(0).getValueType() != SrcVT {
            return SDValue {};
        }
        SrcOps.push(ValueParamT { Op.getOperand(0) });
    }
    let mut VT: EVT = N.getValueType(0);
    let mut NumElts: ElementCount = SrcVT.getVectorElementCount() * N.getNumOperands();
    let mut ConcatSrcVT: EVT = SrcVT.changeVectorElementCount(*DAG.getContext(), NumElts);
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    match CastOpcode {
        SINT_TO_FP => {
            UINT_TO_FP;
        },
        FP_TO_SINT => {
            FP_TO_UINT;
        },
        _ => {
            llvm_unreachable_internal("Unexpected cast opcode", "llvm\\lib\\CodeGen\\SelectionDAG\\DAGCombiner.cpp", 27492);
        },
    }
    let mut DL: SDLoc = SDLoc { N };
    let mut NewConcat: SDValue = DAG.getNode(CONCAT_VECTORS, DL, ConcatSrcVT, ArrayRef<SDValue> { SrcOps });
    return DAG.getNode(CastOpcode, DL, VT, NewConcat);
}

fn combineConcatVectorOfShuffleAndItsOperands(N: *mut SDNode, DAG: *mut SelectionDAG, TLI: *TargetLowering, LegalTypes: bool, LegalOperations: bool) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut OpVT: EVT = N.getOperand(0).getValueType();
    if VT.isScalableVector() {
        return SDValue {};
    }
    if N.getNumOperands() != 2 {
        return SDValue {};
    }
    if (LegalTypes && !TLI.isTypeLegal(VT)) || (LegalOperations && !TLI.isOperationLegalOrCustom(VECTOR_SHUFFLE, VT, false)) {
        return SDValue {};
    }
    let mut SVN: *mut ShuffleVectorSDNode = null;
    for Op in N.ops() {
        let mut CurSVN: *mut ShuffleVectorSDNode = dyn_cast(Op);
        if CurSVN && CurSVN.getOperand(1).isUndef() && N.isOnlyUserOf(CurSVN) && all_of(N.ops(), Closure_98 { CurSVN: CurSVN }) {
            SVN = CurSVN;
            break;
        }
    }
    if !SVN {
        return SDValue {};
    }
    let mut AdjustedMask: SmallVector<int, 16> = SmallVector<int, 16> { SVN.getMask() };
    assert!(SVN.getOperand(1).isUndef(), "Expected unary shuffle!");
    let mut IdentityMask: SmallVector<int, 32> = SmallVector<int, 32> { 2 * OpVT.getVectorNumElements() };
    let mut FirstShufOpIdentityMask: MutableArrayRef<int> = MutableArrayRef<int> { IdentityMask }.take_front(OpVT.getVectorNumElements());
    let mut SecondShufOpIdentityMask: MutableArrayRef<int> = MutableArrayRef<int> { IdentityMask }.take_back(OpVT.getVectorNumElements());
    iota(FirstShufOpIdentityMask.begin(), FirstShufOpIdentityMask.end(), 0);
    iota(SecondShufOpIdentityMask.begin(), SecondShufOpIdentityMask.end(), VT.getVectorNumElements());
    let mut Mask: SmallVector<int, 32> = SmallVector<int, 32> {};
    Mask.reserve(VT.getVectorNumElements());
    for Op in N.ops() {
        assert!(!Op.isUndef(), "Not expecting to concatenate UNDEF.");
        if Op.getNode() == SVN {
            append_range(Mask, AdjustedMask);
            continue;
        }
        if Op == SVN.getOperand(0) {
            append_range(Mask, FirstShufOpIdentityMask);
            continue;
        }
        if Op == SVN.getOperand(1) {
            append_range(Mask, SecondShufOpIdentityMask);
            continue;
        }
        llvm_unreachable_internal("Unexpected operand!", "llvm\\lib\\CodeGen\\SelectionDAG\\DAGCombiner.cpp", 27576);
    }
    if !TLI.isShuffleMaskLegal(ArrayRef<int> { Mask }, VT) {
        return SDValue {};
    }
    let mut dl: SDLoc = SDLoc { N };
    let mut ShufOps: array<SDValue, 2> = array<SDValue, 2> {};
    for I in zip(SVN.ops(), ShufOps) {
        let mut ShufOp: SDValue = get(I).operator const llvm::SDValue &();
        let mut NewShufOp: *mut SDValue = get(I);
        if ShufOp.isUndef() {
            NewShufOp = DAG.getNode(ShufOp.getOpcode(), SDLoc {}, VT);
        } else {
            let mut ShufOpParts: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> { N.getNumOperands(), DAG.getPOISON(OpVT) };
            ShufOpParts[0] = ShufOp;
            NewShufOp = DAG.getNode(CONCAT_VECTORS, dl, VT, ArrayRef<SDValue> { ShufOpParts });
        }
    }
    return DAG.getVectorShuffle(VT, dl, ShufOps[0], ShufOps[1], ArrayRef<int> { Mask });
}

fn combineConcatVectorOfShuffles(N: *mut SDNode, DAG: *mut SelectionDAG, TLI: *TargetLowering, LegalOperations: bool) -> SDValue {
    let mut A: SDValue = SDValue {};
    let mut B: SDValue = SDValue {};
    let mut M0: ArrayRef<int> = ArrayRef<int> {};
    let mut M1: ArrayRef<int> = ArrayRef<int> {};
    if !sd_match(N, m_Node(CONCAT_VECTORS, m_OneUse(m_Shuffle(m_NUses(m_Value(A)), m_NUses(m_Value(B)), m_Mask { MaskRef: M0 })), m_OneUse(m_Shuffle(m_Deferred(A), m_Deferred(B), m_Mask { MaskRef: M1 })))) {
        return SDValue {};
    }
    let mut LoadA: *mut LoadSDNode = dyn_cast(A.getNode());
    let mut LoadB: *mut LoadSDNode = dyn_cast(B.getNode());
    if !LoadA || !LoadB || !isNON_EXTLoad(LoadA) || !isNON_EXTLoad(LoadB) {
        return SDValue {};
    }
    if LoadA.getAddressSpace() != LoadB.getAddressSpace() {
        return SDValue {};
    }
    let mut Base: *mut LoadSDNode = null;
    if DAG.areNonVolatileConsecutiveLoads(LoadB, LoadA, LoadB.getMemoryVT().getStoreSize().operator unsigned long long(), 1) {
        Base = LoadA;
    } else if DAG.areNonVolatileConsecutiveLoads(LoadA, LoadB, LoadA.getMemoryVT().getStoreSize().operator unsigned long long(), 1) {
        Base = LoadB;
    } else {
        return SDValue {};
    }
    let mut Fast: u32 = 0;
    let mut NewAlign: Align = Base.getAlign();
    let mut WideVT: EVT = LoadA.getMemoryVT().getDoubleNumVectorElementsVT(*DAG.getContext());
    if !TLI.allowsMemoryAccess(*DAG.getContext(), DAG.getDataLayout(), WideVT, Base.getAddressSpace(), NewAlign, Base.getMemOperand().getFlags(), &mut Fast) || !Fast {
        return SDValue {};
    }
    let mut Mask: SmallVector<int, 32> = SmallVector<int, 32> {};
    if Base == LoadA {
        append_range(Mask, M0);
        append_range(Mask, M1);
    } else {
        let mut C0: SmallVector<int, 16> = SmallVector<int, 16> { M0 };
        let mut C1: SmallVector<int, 16> = SmallVector<int, 16> { M1 };
        commuteMask(MutableArrayRef<int> { C0 });
        commuteMask(MutableArrayRef<int> { C1 });
        append_range(Mask, C0);
        append_range(Mask, C1);
    }
    if LegalOperations && (!TLI.isOperationLegal(LOAD, WideVT) || !TLI.isOperationLegalOrCustom(VECTOR_SHUFFLE, WideVT, false) || !TLI.isShuffleMaskLegal(ArrayRef<int> { Mask }, WideVT)) {
        return SDValue {};
    }
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut WideMMO: *mut MachineMemOperand = MF.getMachineMemOperand(Base.getMemOperand(), 0, WideVT.getStoreSize());
    let mut WideLoad: SDValue = DAG.getLoad(WideVT, SDLoc { N }, Base.getChain(), Base.getBasePtr(), WideMMO);
    DAG.makeEquivalentMemoryOrdering(LoadA, WideLoad);
    DAG.makeEquivalentMemoryOrdering(LoadB, WideLoad);
    return DAG.getVectorShuffle(WideVT, SDLoc { N }, WideLoad, DAG.getPOISON(WideVT), ArrayRef<int> { Mask });
}

fn combineConcatVectorOfSplats(N: *mut SDNode, DAG: *mut SelectionDAG, TLI: *TargetLowering, LegalTypes: bool, LegalOperations: bool) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if (LegalTypes && !TLI.isTypeLegal(VT)) || (LegalOperations && !TLI.isOperationLegal(SPLAT_VECTOR, VT)) {
        return SDValue {};
    }
    let mut Op0: SDValue = N.getOperand(0);
    if !all_equal(N.op_values()) || Op0.getOpcode() != SPLAT_VECTOR {
        return SDValue {};
    }
    return DAG.getNode(SPLAT_VECTOR, SDLoc { N }, VT, Op0.getOperand(0));
}

fn DAGCombiner::visitCONCAT_VECTORS(self, N: *mut SDNode) -> SDValue {
    if N.getNumOperands() == 1 {
        return N.getOperand(0);
    }
    let mut VT: EVT = N.getValueType(0);
    if allOperandsUndef(N) {
        return self.DAG.getUNDEF(VT);
    }
    if all_of(drop_begin(N.ops(), 1), Closure_99 {}) {
        let mut In: SDValue = N.getOperand(0);
        assert!(In.getValueType().isVector(), "Must concat vectors");
        if In.getOpcode() == CONCAT_VECTORS && In.hasOneUse() && !(self.LegalDAG && In.getValueType().isScalableVector()) {
            let mut NumOps: u32 = N.getNumOperands() * In.getNumOperands();
            let mut Ops: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { operator(In).ops() };
            Ops.resize(NumOps, self.DAG.getPOISON(Ops[0].getValueType()));
            return self.DAG.getNode(CONCAT_VECTORS, SDLoc { N }, VT, ArrayRef<SDValue> { Ops });
        }
        let mut Scalar: SDValue = peekThroughOneUseBitcasts(In);
        if !self.LegalOperations && Scalar.getOpcode() == SCALAR_TO_VECTOR && Scalar.hasOneUse() {
            let mut SVT: EVT = Scalar.getValueType().getVectorElementType();
            if SVT == Scalar.getOperand(0).getValueType() {
                Scalar = Scalar.getOperand(0);
            }
        }
        if !Scalar.getValueType().isVector() && In.hasOneUse() {
            if operator(Scalar).getOpcode() == TRUNCATE && !self.TLI.isTypeLegal(Scalar.getValueType()) && self.TLI.isTypeLegal(operator(Scalar).getOperand(0).getValueType()) && self.DAG.getDataLayout().isLittleEndian() {
                Scalar = operator(Scalar).getOperand(0);
            }
            let mut SclTy: EVT = Scalar.getValueType();
            if !SclTy.isFloatingPoint() && !SclTy.isInteger() {
                return SDValue {};
            }
            if VT.getSizeInBits().operator unsigned long long() % SclTy.getSizeInBits().operator unsigned long long() {
                return SDValue {};
            }
            let mut VNTNumElms: u32 = VT.getSizeInBits().operator unsigned long long() / SclTy.getSizeInBits().operator unsigned long long();
            if VNTNumElms < 2 {
                return SDValue {};
            }
            let mut NVT: EVT = getVectorVT(*self.DAG.getContext(), SclTy, VNTNumElms, false);
            if !self.TLI.isTypeLegal(NVT) || !self.TLI.isTypeLegal(Scalar.getValueType()) {
                return SDValue {};
            }
            let mut Res: SDValue = self.DAG.getNode(SCALAR_TO_VECTOR, SDLoc { N }, NVT, Scalar);
            return self.DAG.getBitcast(VT, Res);
        }
    }
    let mut IsBuildVectorOrUndef: Closure_100 = Closure_100 {};
    if all_of(N.ops(), IsBuildVectorOrUndef) {
        let mut Opnds: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
        let mut SVT: EVT = VT.getScalarType();
        let mut MinVT: EVT = SVT;
        if !SVT.isFloatingPoint() {
            let mut FoundMinVT: bool = false;
            for Op in N.ops() {
                if BUILD_VECTOR == Op.getOpcode() {
                    let mut OpSVT: EVT = Op.getOperand(0).getValueType();
                    MinVT = if (!FoundMinVT || OpSVT.bitsLE(MinVT)) { OpSVT } else { MinVT };
                    FoundMinVT = true;
                }
            }
            assert!(FoundMinVT, "Concat vector type mismatch");
        }
        for Op in N.ops() {
            let mut OpVT: EVT = Op.getValueType();
            let mut NumElts: u32 = OpVT.getVectorNumElements();
            if Op.isUndef() {
                Opnds.append(NumElts, self.DAG.getNode(Op.getOpcode(), SDLoc {}, MinVT));
            }
            if BUILD_VECTOR == Op.getOpcode() {
                if SVT.isFloatingPoint() {
                    assert!(SVT == OpVT.getScalarType(), "Concat vector type mismatch");
                    Opnds.append(operator(Op).op_begin(), operator(Op).op_begin() + NumElts);
                } else {
                    for let mut i: u32 = 0; i != NumElts; i += 1 {
                        Opnds.push(self.DAG.getNode(TRUNCATE, SDLoc { N }, MinVT, Op.getOperand(i)));
                    }
                }
            }
        }
        assert!(VT.getVectorNumElements() == Opnds.len, "Concat vector type mismatch");
        return self.DAG.getBuildVector(VT, SDLoc { N }, ArrayRef<SDValue> { Opnds });
    }
    if combineConcatVectorOfSplats(N, self.DAG, self.TLI, self.LegalTypes, self.LegalOperations) {
        V;
    } else {
        return V;
    }
    if combineConcatVectorOfScalars(N, self.DAG) {
        V;
    } else {
        return V;
    }
    if self.Level <= AfterLegalizeVectorOps && self.TLI.isTypeLegal(VT) {
        if combineConcatVectorOfConcatVectors(N, self.DAG) {
            V;
        } else {
            return V;
        }
        if combineConcatVectorOfExtracts(N, self.DAG) {
            V;
        } else {
            return V;
        }
    }
    if combineConcatVectorOfCasts(N, self.DAG) {
        V;
    } else {
        return V;
    }
    if combineConcatVectorOfShuffleAndItsOperands(N, self.DAG, self.TLI, self.LegalTypes, self.LegalOperations) {
        V;
    } else {
        return V;
    }
    if combineConcatVectorOfShuffles(N, self.DAG, self.TLI, self.LegalOperations) {
        V;
    } else {
        return V;
    }
    let mut SingleSource: SDValue = SDValue {};
    let mut PartNumElem: u32 = N.getOperand(0).getValueType().getVectorMinNumElements();
    for let mut i: u32 = 0;
let mut e: u32 = N.getNumOperands(); i != e; i += 1 {
        let mut Op: SDValue = N.getOperand(i);
        if Op.isUndef() {
            continue;
        }
        if Op.getOpcode() != EXTRACT_SUBVECTOR {
            return SDValue {};
        }
        if SingleSource.getNode() {
            if Op.getOperand(0) != SingleSource {
                return SDValue {};
            }
        } else {
            SingleSource = Op.getOperand(0);
            if SingleSource.getValueType() != N.getValueType(0) {
                return SDValue {};
            }
        }
        let mut IdentityIndex: u32 = i * PartNumElem;
        if Op.getConstantOperandAPInt(1) != IdentityIndex {
            return SDValue {};
        }
    }
    if SingleSource.getNode() {
        return SingleSource;
    }
    return SDValue {};
}

fn DAGCombiner::visitVECTOR_INTERLEAVE(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut Op0: SDValue = N.getOperand(0);
    let mut Factor: u32 = N.getNumOperands();
    if Op0.getOpcode() == BUILD_VECTOR {
        let mut EltVT: EVT = Op0.getOperand(0).getValueType();
        if all_of(N.op_values(), Closure_101 { EltVT: &mut EltVT }) {
            let mut NumElts: u32 = VT.getVectorNumElements();
            let mut DL: SDLoc = SDLoc { N };
            let mut Results: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
            let mut InterleavedElts: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
            for let mut I: u32 = 0; I != NumElts; I += 1 {
                for op in N.op_values() {
                    InterleavedElts.push(ValueParamT { op.getOperand(I) });
                }
            }
            for let mut I: u32 = 0; I < Factor; I += 1 {
                Results.push(self.DAG.getBuildVector(VT, DL, SDValue> { InterleavedElts }.slice(I * NumElts, NumElts)));
            }
            return self.CombineTo(N, &mut Results, true);
        }
    }
    if Op0.getOpcode() == VECTOR_SHUFFLE && VT.getVectorElementCount().isKnownMultipleOf(Factor) {
        let mut FirstIndex: i32 = 0;
        let mut NumElts: u32 = VT.getVectorNumElements();
        let mut Source: SDValue = self.DAG.getSplatSourceVector(Op0, FirstIndex);
        if Source && all_of(enumerate(N.op_values()), Closure_102 { cap_0: self, Source: &mut Source, FirstIndex: &mut FirstIndex }) {
            let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> {};
            for let mut I: u32 = 0; I != NumElts; I += 1 {
                Mask.push(FirstIndex + I % Factor);
            }
            let mut Shuffle: SDValue = self.DAG.getVectorShuffle(VT, SDLoc { N }, Source, self.DAG.getPOISON(VT), ArrayRef<int> { Mask });
            let mut Results: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { Factor, Shuffle };
            return self.CombineTo(N, &mut Results, true);
        }
    }
    if !all_equal(N.op_values()) {
        return SDValue {};
    }
    if !self.DAG.isSplatValue(N.getOperand(0), false) {
        return SDValue {};
    }
    let mut Ops: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    Ops.append(N.op_values().begin(), N.op_values().end());
    return self.CombineTo(N, &mut Ops, true);
}

fn getSubVectorSrc(V: SDValue, Index: u32, SubVT: EVT) -> SDValue {
    if V.getOpcode() == INSERT_SUBVECTOR && V.getOperand(1).getValueType() == SubVT && V.getConstantOperandAPInt(2) == Index {
        return V.getOperand(1);
    }
    if V.getOpcode() == CONCAT_VECTORS && V.getOperand(0).getValueType() == SubVT && (Index % SubVT.getVectorMinNumElements()) == 0 {
        let mut SubIdx: u64 = Index / SubVT.getVectorMinNumElements();
        return V.getOperand(SubIdx);
    }
    return SDValue {};
}

fn narrowInsertExtractVectorBinOp(SubVT: EVT, BinOp: SDValue, Index: u32, DL: *SDLoc, DAG: *mut SelectionDAG, LegalOperations: bool) -> SDValue {
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut BinOpcode: u32 = BinOp.getOpcode();
    if !TLI.isBinOp(BinOpcode) || operator(BinOp).getNumValues() != 1 {
        return SDValue {};
    }
    let mut VecVT: EVT = BinOp.getValueType();
    let mut Bop0: SDValue = BinOp.getOperand(0);
    let mut Bop1: SDValue = BinOp.getOperand(1);
    if VecVT != Bop0.getValueType() || VecVT != Bop1.getValueType() {
        return SDValue {};
    }
    if !TLI.isOperationLegalOrCustom(BinOpcode, SubVT, LegalOperations) {
        return SDValue {};
    }
    let mut Sub0: SDValue = getSubVectorSrc(Bop0, Index, SubVT);
    let mut Sub1: SDValue = getSubVectorSrc(Bop1, Index, SubVT);
    if !Sub0 || !Sub1 {
        return SDValue {};
    }
    return DAG.getNode(BinOpcode, DL, SubVT, Sub0, Sub1, operator(BinOp).getFlags());
}

fn narrowExtractedVectorBinOp(VT: EVT, Src: SDValue, Index: u32, DL: *SDLoc, DAG: *mut SelectionDAG, LegalOperations: bool) -> SDValue {
    if narrowInsertExtractVectorBinOp(VT, Src, Index, DL, DAG, LegalOperations) {
        V;
    } else {
        return V;
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut BinOp: SDValue = peekThroughBitcasts(Src);
    let mut BOpcode: u32 = BinOp.getOpcode();
    if !TLI.isBinOp(BOpcode) || operator(BinOp).getNumValues() != 1 {
        return SDValue {};
    }
    if BOpcode == FSUB {
        let mut C: *mut ConstantFPSDNode = isConstOrConstSplatFP(BinOp.getOperand(0), true);
        if C && C.getValueAPF().isNegZero() {
            return SDValue {};
        }
    }
    let mut WideBVT: EVT = BinOp.getValueType();
    if !WideBVT.isFixedLengthVector() {
        return SDValue {};
    }
    assert!((Index % VT.getVectorNumElements()) == 0, "Extract index is not a multiple of the vector length.");
    let mut WideWidth: u32 = WideBVT.getSizeInBits().operator unsigned long long();
    let mut NarrowWidth: u32 = VT.getSizeInBits().operator unsigned long long();
    if WideWidth % NarrowWidth != 0 {
        return SDValue {};
    }
    let mut NarrowingRatio: u32 = WideWidth / NarrowWidth;
    let mut WideNumElts: u32 = WideBVT.getVectorNumElements();
    if WideNumElts % NarrowingRatio != 0 {
        return SDValue {};
    }
    let mut NarrowBVT: EVT = getVectorVT(*DAG.getContext(), WideBVT.getScalarType(), WideNumElts / NarrowingRatio, false);
    if !TLI.isOperationLegalOrCustomOrPromote(BOpcode, NarrowBVT, LegalOperations) {
        return SDValue {};
    }
    let mut ConcatOpNum: u32 = Index / VT.getVectorNumElements();
    let mut ExtBOIdx: u32 = ConcatOpNum * NarrowBVT.getVectorNumElements();
    if TLI.getExtractSubvectorCost(NarrowBVT, WideBVT, ExtBOIdx) <= Cheap && BinOp.hasOneUse() && operator(Src).hasOneUse() {
        let mut NewExtIndex: SDValue = DAG.getVectorIdxConstant(ExtBOIdx, DL, false);
        let mut X: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, NarrowBVT, BinOp.getOperand(0), NewExtIndex);
        let mut Y: SDValue = DAG.getNode(EXTRACT_SUBVECTOR, DL, NarrowBVT, BinOp.getOperand(1), NewExtIndex);
        let mut NarrowBinOp: SDValue = DAG.getNode(BOpcode, DL, NarrowBVT, X, Y, operator(BinOp).getFlags());
        return DAG.getBitcast(VT, NarrowBinOp);
    }
    if NarrowingRatio != 2 {
        return SDValue {};
    }
    if BOpcode != AND && BOpcode != OR && BOpcode != XOR {
        return SDValue {};
    }
    let mut GetSubVector: Closure_103 = Closure_103 { ConcatOpNum: ConcatOpNum };
    let mut SubVecL: SDValue = GetSubVector.call(peekThroughBitcasts(BinOp.getOperand(0)));
    let mut SubVecR: SDValue = GetSubVector.call(peekThroughBitcasts(BinOp.getOperand(1)));
    if SubVecL || SubVecR {
        let mut IndexC: SDValue = DAG.getVectorIdxConstant(ExtBOIdx, DL, false);
        let mut X: SDValue = if SubVecL { DAG.getBitcast(NarrowBVT, SubVecL) } else { DAG.getNode(EXTRACT_SUBVECTOR, DL, NarrowBVT, BinOp.getOperand(0), IndexC) };
        let mut Y: SDValue = if SubVecR { DAG.getBitcast(NarrowBVT, SubVecR) } else { DAG.getNode(EXTRACT_SUBVECTOR, DL, NarrowBVT, BinOp.getOperand(1), IndexC) };
        let mut NarrowBinOp: SDValue = DAG.getNode(BOpcode, DL, NarrowBVT, X, Y, operator(BinOp).getFlags());
        return DAG.getBitcast(VT, NarrowBinOp);
    }
    return SDValue {};
}

fn narrowExtractedVectorLoad(VT: EVT, Src: SDValue, Index: u32, DL: *SDLoc, DAG: *mut SelectionDAG) -> SDValue {
    if DAG.getDataLayout().isBigEndian() {
        return SDValue {};
    }
    let mut Ld: *mut LoadSDNode = dyn_cast(Src);
    if !Ld || !isNormalLoad(Ld) || !Ld.isSimple() {
        return SDValue {};
    }
    if !VT.isByteSized() {
        return SDValue {};
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if !TLI.isOperationLegalOrCustomOrPromote(LOAD, VT, false) {
        return SDValue {};
    }
    let mut NumElts: u32 = VT.getVectorMinNumElements();
    if Index == 0 && NumElts >= Ld.getValueType(0).getVectorMinNumElements() {
        return SDValue {};
    }
    assert!(Index % NumElts == 0, "The extract subvector index is not a multiple of the result's element count");
    let mut Offset: TypeSize = VT.getStoreSize() * (Index / NumElts);
    let mut ByteOffset: optional<unsigned int> = optional<unsigned int> {};
    if Offset.isFixed() {
        ByteOffset = Offset.getFixedValue();
    }
    if !TLI.shouldReduceLoadWidth(Ld, Ld.getExtensionType(), VT, ByteOffset) {
        return SDValue {};
    }
    let mut NewAddr: SDValue = DAG.getMemBasePlusOffset(Ld.getBasePtr(), Offset, DL, SDNodeFlags { Flags: None });
    let mut MF: *mut MachineFunction = DAG.getMachineFunction();
    let mut MMO: *mut MachineMemOperand = null;
    if Offset.isScalable() {
        let mut MPI: MachinePointerInfo = MachinePointerInfo { Ld.getPointerInfo().getAddrSpace(), 0 };
        MMO = MF.getMachineMemOperand(Ld.getMemOperand(), MPI, VT.getStoreSize());
    } else {
        MMO = MF.getMachineMemOperand(Ld.getMemOperand(), Offset.getFixedValue(), VT.getStoreSize());
    }
    let mut NewLd: SDValue = DAG.getLoad(VT, DL, Ld.getChain(), NewAddr, MMO);
    DAG.makeEquivalentMemoryOrdering(Ld, NewLd);
    return NewLd;
}

fn foldExtractSubvectorFromShuffleVector(NarrowVT: EVT, Src: SDValue, Index: u32, DL: *SDLoc, DAG: *mut SelectionDAG, LegalOperations: bool) -> SDValue {
    let mut WideVT: EVT = Src.getValueType();
    if !NarrowVT.isFixedLengthVector() || !WideVT.isFixedLengthVector() {
        return SDValue {};
    }
    let mut WideShuffleVector: *mut ShuffleVectorSDNode = dyn_cast(Src);
    if !WideShuffleVector {
        return SDValue {};
    }
    if !WideShuffleVector.hasOneUse() {
        return SDValue {};
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    if LegalOperations && !TLI.isOperationLegalOrCustom(VECTOR_SHUFFLE, NarrowVT, false) {
        return SDValue {};
    }
    let mut NumEltsExtracted: i32 = NarrowVT.getVectorNumElements();
    assert!((Index % NumEltsExtracted) == 0, "Extract index is not a multiple of the output vector length.");
    let mut WideNumElts: i32 = WideVT.getVectorNumElements();
    let mut NewMask: SmallVector<int, 16> = SmallVector<int, 16> {};
    NewMask.reserve(NumEltsExtracted);
    let mut DemandedSubvectors: pair<SDValue, int>, 2> = pair<SDValue, int>, 2> {};
    for M in WideShuffleVector.getMask().slice(Index, NumEltsExtracted) {
        assert!((M >= -1) && (M < (2 * WideNumElts)), "Out-of-bounds shuffle mask?");
        if M < 0 {
            NewMask.emplace_back(M);
            continue;
        }
        let mut WideShufOpIdx: i32 = M / WideNumElts;
        let mut OpEltIdx: i32 = M % WideNumElts;
        assert!((OpEltIdx + WideShufOpIdx * WideNumElts) == M, "Shuffle mask vector decomposition failure.");
        let mut OpSubvecIdx: i32 = OpEltIdx / NumEltsExtracted;
        let mut OpEltIdxInSubvec: i32 = OpEltIdx % NumEltsExtracted;
        assert!((OpEltIdxInSubvec + OpSubvecIdx * NumEltsExtracted) == OpEltIdx, "Shuffle mask subvector decomposition failure.");
        assert!((OpEltIdxInSubvec + OpSubvecIdx * NumEltsExtracted + WideShufOpIdx * WideNumElts) == M, "Shuffle mask full decomposition failure.");
        let mut Op: SDValue = WideShuffleVector.getOperand(WideShufOpIdx);
        if Op.isUndef() {
            NewMask.emplace_back(-1);
            continue;
        }
        let mut DemandedSubvector: pair<SDValue, int> = make_pair(Op, OpSubvecIdx);
        if DemandedSubvectors.insert(DemandedSubvector) {
            if DemandedSubvectors.len > 2 {
                return SDValue {};
            }
            let mut Index: i32 = NumEltsExtracted * OpSubvecIdx;
            if TLI.getExtractSubvectorCost(NarrowVT, WideVT, Index) > Cheap {
                return SDValue {};
            }
        }
        let mut NewOpIdx: i32 = getFirstIndexOf(DemandedSubvectors.getArrayRef(), DemandedSubvector);
        assert!((NewOpIdx == 0 || NewOpIdx == 1), "Unexpected operand index.");
        let mut AdjM: i32 = OpEltIdxInSubvec + NewOpIdx * NumEltsExtracted;
        NewMask.emplace_back(AdjM);
    }
    assert!(NewMask.len == NumEltsExtracted as u32, "Produced bad mask.");
    assert!(DemandedSubvectors.len <= 2, "Should have ended up demanding at most two subvectors.");
    if DemandedSubvectors.len == 0 {
        return DAG.getPOISON(NarrowVT);
    }
    if !isIdentityMask(ArrayRef<int> { NewMask }, NewMask.len) || any_of(NewMask, Closure_104 {}) {
        for DemandedSubvector in DemandedSubvectors {
            if DemandedSubvector.second != 0 {
                return SDValue {};
            }
        }
    }
    if TLI.isShuffleMaskLegal(WideShuffleVector.getMask(), WideVT) && !TLI.isShuffleMaskLegal(ArrayRef<int> { NewMask }, NarrowVT) {
        return SDValue {};
    }
    let mut NewOps: SmallVector<SDValue, 2> = SmallVector<SDValue, 2> {};
    for DemandedSubvector in DemandedSubvectors {
        let mut Index: i32 = NumEltsExtracted * DemandedSubvector.second;
        let mut IndexC: SDValue = DAG.getVectorIdxConstant(Index, DL, false);
        NewOps.emplace_back(DAG.getNode(EXTRACT_SUBVECTOR, DL, NarrowVT, DemandedSubvector.first, IndexC));
    }
    assert!((NewOps.len == 1 || NewOps.len == 2), "Should end up with either one or two ops");
    if NewOps.len == 1 {
        NewOps.emplace_back(DAG.getPOISON(NarrowVT));
    }
    return DAG.getVectorShuffle(NarrowVT, DL, NewOps[0], NewOps[1], ArrayRef<int> { NewMask });
}

fn DAGCombiner::foldExtractSubvectorFromConcatVectors(self, VT: EVT, V: SDValue, ExtIdx: u64, DL: *SDLoc) -> SDValue {
    assert!(V.getOpcode() == CONCAT_VECTORS, "Expected a CONCAT_VECTORS operand");
    let mut ExtNumElts: ElementCount = VT.getVectorElementCount();
    assert!(ExtIdx % ExtNumElts.getKnownMinValue() == 0, "subvector extract is alligned");
    let mut ConcatSrcVT: EVT = V.getOperand(0).getValueType();
    let mut ConcatSrcNumElts: ElementCount = ConcatSrcVT.getVectorElementCount();
    let mut ConcatOpIdx: u32 = ExtIdx / ConcatSrcNumElts.getKnownMinValue();
    if ConcatOpIdx >= V.getNumOperands() {
        return SDValue {};
    }
    if VT.getVectorElementCount() == ConcatSrcVT.getVectorElementCount() {
        return V.getOperand(ConcatOpIdx);
    }
    if ConcatSrcNumElts.hasKnownScalarFactor(ExtNumElts) {
        let mut NewExtIdx: u64 = ExtIdx - ConcatOpIdx * ConcatSrcNumElts.getKnownMinValue();
        return self.DAG.getExtractSubvector(DL, VT, V.getOperand(ConcatOpIdx), NewExtIdx);
    }
    if ExtNumElts.hasKnownScalarFactor(ConcatSrcNumElts) && ExtIdx % ConcatSrcNumElts.getKnownMinValue() == 0 && (!self.LegalOperations || self.hasOperation(CONCAT_VECTORS, VT)) {
        let mut NumConcatOps: u32 = ExtNumElts.getKnownScalarFactor(ConcatSrcNumElts);
        return self.DAG.getNode(CONCAT_VECTORS, DL, VT, operator(V).ops().slice(ConcatOpIdx, NumConcatOps));
    }
    return SDValue {};
}

fn DAGCombiner::visitEXTRACT_SUBVECTOR(self, N: *mut SDNode) -> SDValue {
    let mut NVT: EVT = N.getValueType(0);
    let mut V: SDValue = N.getOperand(0);
    let mut ExtIdx: u64 = N.getConstantOperandVal(1);
    let mut DL: SDLoc = SDLoc { N };
    if V.isUndef() {
        return self.DAG.getUNDEF(NVT);
    }
    if narrowExtractedVectorLoad(NVT, V, ExtIdx, DL, self.DAG) {
        NarrowLoad;
    } else {
        return NarrowLoad;
    }
    if V.getOpcode() == FREEZE && V.hasOneUse() && V.getOperand(0).hasOneUse() {
        if narrowExtractedVectorLoad(NVT, V.getOperand(0), ExtIdx, DL, self.DAG) {
            NarrowLoad;
        } else {
            return self.DAG.getFreeze(NarrowLoad);
        }
    }
    if V.getOpcode() == EXTRACT_SUBVECTOR && V.hasOneUse() {
        let mut InnerExtIdx: u64 = V.getConstantOperandVal(1);
        let mut NewExtIdx: u64 = InnerExtIdx + ExtIdx;
        if V.getValueType().isScalableVector() == NVT.isScalableVector() && NewExtIdx % NVT.getVectorMinNumElements() == 0 && self.TLI.getExtractSubvectorCost(NVT, V.getOperand(0).getValueType(), NewExtIdx) <= Cheap && self.TLI.isOperationLegalOrCustom(EXTRACT_SUBVECTOR, NVT, false) {
            return self.DAG.getExtractSubvector(DL, NVT, V.getOperand(0), NewExtIdx);
        }
    }
    if V.getOpcode() == SPLAT_VECTOR {
        if (self.DAG.isConstantValueOfAnyType(V.getOperand(0)) && !(NVT.isScalableVector() && self.TLI.getExtractSubvectorCost(NVT, V.getValueType(), ExtIdx) <= Cheap)) || V.hasOneUse() {
            if !self.LegalOperations || self.TLI.isOperationLegal(SPLAT_VECTOR, NVT) {
                return self.DAG.getSplatVector(NVT, DL, V.getOperand(0));
            }
        }
    }
    if ExtIdx == 0 && V.getOpcode() == GET_ACTIVE_LANE_MASK && V.hasOneUse() && (!self.LegalOperations || self.TLI.isOperationLegal(GET_ACTIVE_LANE_MASK, NVT)) {
        return self.DAG.getNode(GET_ACTIVE_LANE_MASK, DL, NVT, V.getOperand(0), V.getOperand(1));
    }
    if V.getOpcode() == INSERT_SUBVECTOR {
        let mut InsSub: SDValue = V.getOperand(1);
        let mut InsSubVT: EVT = InsSub.getValueType();
        let mut NumInsElts: u32 = InsSubVT.getVectorMinNumElements();
        let mut InsIdx: u32 = V.getConstantOperandVal(2);
        let mut NumSubElts: u32 = NVT.getVectorMinNumElements();
        if InsIdx <= ExtIdx && (ExtIdx + NumSubElts) <= (InsIdx + NumInsElts) && self.TLI.getExtractSubvectorCost(NVT, InsSubVT, ExtIdx - InsIdx) <= Cheap && InsSubVT.isFixedLengthVector() && NVT.isFixedLengthVector() && V.getValueType().isFixedLengthVector() {
            return self.DAG.getNode(EXTRACT_SUBVECTOR, DL, NVT, InsSub, self.DAG.getVectorIdxConstant(ExtIdx - InsIdx, DL, false));
        }
    }
    if V.getOpcode() == BITCAST && V.getOperand(0).getValueType().isVector() && (!self.LegalOperations || self.TLI.isOperationLegal(BITCAST, NVT)) {
        let mut SrcOp: SDValue = V.getOperand(0);
        let mut SrcVT: EVT = SrcOp.getValueType();
        let mut SrcNumElts: u32 = SrcVT.getVectorMinNumElements();
        let mut DestNumElts: u32 = V.getValueType().getVectorMinNumElements();
        if (SrcNumElts % DestNumElts) == 0 {
            let mut SrcDestRatio: u32 = SrcNumElts / DestNumElts;
            let mut NewExtEC: ElementCount = NVT.getVectorElementCount() * SrcDestRatio;
            let mut NewExtVT: EVT = getVectorVT(*self.DAG.getContext(), SrcVT.getScalarType(), NewExtEC);
            if self.TLI.isOperationLegalOrCustom(EXTRACT_SUBVECTOR, NewExtVT, false) {
                let mut NewIndex: SDValue = self.DAG.getVectorIdxConstant(ExtIdx * SrcDestRatio, DL, false);
                let mut NewExtract: SDValue = self.DAG.getNode(EXTRACT_SUBVECTOR, DL, NewExtVT, V.getOperand(0), NewIndex);
                return self.DAG.getBitcast(NVT, NewExtract);
            }
        }
        if (DestNumElts % SrcNumElts) == 0 {
            let mut DestSrcRatio: u32 = DestNumElts / SrcNumElts;
            if NVT.getVectorElementCount().isKnownMultipleOf(DestSrcRatio) {
                let mut NewExtEC: ElementCount = NVT.getVectorElementCount().divideCoefficientBy(DestSrcRatio);
                let mut ScalarVT: EVT = SrcVT.getScalarType();
                if (ExtIdx % DestSrcRatio) == 0 {
                    let mut IndexValScaled: u32 = ExtIdx / DestSrcRatio;
                    let mut NewExtVT: EVT = getVectorVT(*self.DAG.getContext(), ScalarVT, NewExtEC);
                    if self.TLI.isOperationLegalOrCustom(EXTRACT_SUBVECTOR, NewExtVT, false) {
                        let mut NewIndex: SDValue = self.DAG.getVectorIdxConstant(IndexValScaled, DL, false);
                        let mut NewExtract: SDValue = self.DAG.getNode(EXTRACT_SUBVECTOR, DL, NewExtVT, V.getOperand(0), NewIndex);
                        return self.DAG.getBitcast(NVT, NewExtract);
                    }
                    if NewExtEC.isScalar() && self.TLI.isOperationLegalOrCustom(EXTRACT_VECTOR_ELT, ScalarVT, false) {
                        let mut NewIndex: SDValue = self.DAG.getVectorIdxConstant(IndexValScaled, DL, false);
                        let mut NewExtract: SDValue = self.DAG.getNode(EXTRACT_VECTOR_ELT, DL, ScalarVT, V.getOperand(0), NewIndex);
                        return self.DAG.getBitcast(NVT, NewExtract);
                    }
                }
            }
        }
    }
    if V.getOpcode() == CONCAT_VECTORS {
        if self.foldExtractSubvectorFromConcatVectors(NVT, V, ExtIdx, DL) {
            Folded;
        } else {
            return Folded;
        }
    }
    if foldExtractSubvectorFromShuffleVector(NVT, V, ExtIdx, DL, self.DAG, self.LegalOperations) {
        Shuffle;
    } else {
        return Shuffle;
    }
    if narrowExtractedVectorBinOp(NVT, V, ExtIdx, DL, self.DAG, self.LegalOperations) {
        NarrowBOp;
    } else {
        return NarrowBOp;
    }
    V = peekThroughBitcasts(V);
    if V.getOpcode() == BUILD_VECTOR {
        let mut InVT: EVT = V.getValueType();
        let mut ExtractSize: u32 = NVT.getSizeInBits().operator unsigned long long();
        let mut EltSize: u32 = InVT.getScalarSizeInBits();
        if ExtractSize % EltSize == 0 {
            let mut NumElems: u32 = ExtractSize / EltSize;
            let mut EltVT: EVT = InVT.getVectorElementType();
            let mut ExtractVT: EVT = if NumElems == 1 { EltVT } else { getVectorVT(*self.DAG.getContext(), EltVT, NumElems, false) };
            if (self.Level < AfterLegalizeDAG || (NumElems == 1 || self.TLI.isOperationLegal(BUILD_VECTOR, ExtractVT))) && (!self.LegalTypes || self.TLI.isTypeLegal(ExtractVT)) {
                let mut IdxVal: u32 = (ExtIdx * NVT.getScalarSizeInBits()) / EltSize;
                if NumElems == 1 {
                    let mut Src: SDValue = operator(V).getOperand(IdxVal);
                    if EltVT != Src.getValueType() {
                        Src = self.DAG.getNode(TRUNCATE, DL, EltVT, Src);
                    }
                    return self.DAG.getBitcast(NVT, Src);
                }
                let mut BuildVec: SDValue = self.DAG.getBuildVector(ExtractVT, DL, operator(V).ops().slice(IdxVal, NumElems));
                return self.DAG.getBitcast(NVT, BuildVec);
            }
        }
    }
    if V.getOpcode() == INSERT_SUBVECTOR {
        let mut SmallVT: EVT = V.getOperand(1).getValueType();
        if NVT.bitsEq(SmallVT) {
            let mut InsIdx: u64 = V.getConstantOperandVal(2);
            if InsIdx * SmallVT.getScalarSizeInBits() == ExtIdx * NVT.getScalarSizeInBits() {
                if !self.LegalOperations || self.TLI.isOperationLegal(BITCAST, NVT) {
                    return self.DAG.getBitcast(NVT, V.getOperand(1));
                }
            } else {
                return self.DAG.getNode(EXTRACT_SUBVECTOR, DL, NVT, self.DAG.getBitcast(N.getOperand(0).getValueType(), V.getOperand(0)), N.getOperand(1));
            }
        }
    }
    if !V.getValueType().isScalableVector() && all_of(operator(V).users(), Closure_105 { V: &mut V }) {
        let mut NumElts: u32 = V.getValueType().getVectorNumElements();
        let mut DemandedElts: APInt = getZero(NumElts);
        for User in operator(V).users() {
            let mut ExtIdx: u32 = User.getConstantOperandVal(1);
            let mut NumSubElts: u32 = User.getValueType(0).getVectorNumElements();
            DemandedElts.setBits(ExtIdx, ExtIdx + NumSubElts);
        }
        if self.SimplifyDemandedVectorElts(V, DemandedElts, true) {
            if N.getOpcode() != DELETED_NODE {
                self.AddToWorklist(N, true, false);
            }
            return SDValue { Node: N, ResNo: 0 };
        }
    } else {
        if self.SimplifyDemandedVectorElts(SDValue { Node: N, ResNo: 0 }) {
            return SDValue { Node: N, ResNo: 0 };
        }
    }
    return SDValue {};
}

fn foldShuffleOfConcatUndefs(Shuf: *mut ShuffleVectorSDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut N0: SDValue = Shuf.getOperand(0);
    let mut N1: SDValue = Shuf.getOperand(1);
    if N0.getOpcode() != CONCAT_VECTORS || N0.getNumOperands() != 2 || N1.getOpcode() != CONCAT_VECTORS || N1.getNumOperands() != 2 || !N0.getOperand(1).isUndef() || !N1.getOperand(1).isUndef() {
        return SDValue {};
    }
    let mut Mask: ArrayRef<int> = Shuf.getMask();
    let mut VT: EVT = Shuf.getValueType(0);
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut HalfNumElts: u32 = NumElts / 2;
    let mut Mask0: SmallVector<int, 16> = SmallVector<int, 16> { HalfNumElts, -1 };
    let mut Mask1: SmallVector<int, 16> = SmallVector<int, 16> { HalfNumElts, -1 };
    for let mut i: u32 = 0; i != NumElts; i += 1 {
        if Mask[i] == -1 {
            continue;
        }
        if (Mask[i] % NumElts) >= HalfNumElts {
            continue;
        }
        let mut M: i32 = if Mask[i] < NumElts as i32 { Mask[i] } else { Mask[i] - HalfNumElts as i32 };
        if i < HalfNumElts {
            Mask0[i] = M;
        } else {
            Mask1[i - HalfNumElts] = M;
        }
    }
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut HalfVT: EVT = getVectorVT(*DAG.getContext(), VT.getScalarType(), HalfNumElts, false);
    if !TLI.isShuffleMaskLegal(ArrayRef<int> { Mask0 }, HalfVT) || !TLI.isShuffleMaskLegal(ArrayRef<int> { Mask1 }, HalfVT) {
        return SDValue {};
    }
    let mut X: SDValue = N0.getOperand(0);
    let mut Y: SDValue = N1.getOperand(0);
    let mut DL: SDLoc = SDLoc { Shuf };
    let mut Shuf0: SDValue = DAG.getVectorShuffle(HalfVT, DL, X, Y, ArrayRef<int> { Mask0 });
    let mut Shuf1: SDValue = DAG.getVectorShuffle(HalfVT, DL, X, Y, ArrayRef<int> { Mask1 });
    return DAG.getNode(CONCAT_VECTORS, DL, VT, Shuf0, Shuf1);
}

fn partitionShuffleOfConcats(N: *mut SDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut SVN: *mut ShuffleVectorSDNode = cast(N);
    let mut Mask: ArrayRef<int> = SVN.getMask();
    let mut Ops: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
    let mut ConcatVT: EVT = N0.getOperand(0).getValueType();
    let mut NumElemsPerConcat: u32 = ConcatVT.getVectorNumElements();
    let mut NumConcats: u32 = NumElts / NumElemsPerConcat;
    let mut IsUndefMaskElt: Closure_106 = Closure_106 {};
    if NumElemsPerConcat * 2 == NumElts && N1.isUndef() && all_of(Mask.slice(NumElemsPerConcat, NumElemsPerConcat), IsUndefMaskElt) {
        N0 = DAG.getVectorShuffle(ConcatVT, SDLoc { N }, N0.getOperand(0), N0.getOperand(1), Mask.slice(0, NumElemsPerConcat));
        N1 = DAG.getPOISON(ConcatVT);
        return DAG.getNode(CONCAT_VECTORS, SDLoc { N }, VT, N0, N1);
    }
    for let mut I: u32 = 0; I != NumConcats; I += 1 {
        let mut Begin: u32 = I * NumElemsPerConcat;
        let mut SubMask: ArrayRef<int> = Mask.slice(Begin, NumElemsPerConcat);
        if all_of(SubMask, IsUndefMaskElt) {
            Ops.push(DAG.getUNDEF(ConcatVT));
            continue;
        }
        let mut OpIdx: i32 = -1;
        for let mut i: i32 = 0; i != NumElemsPerConcat as i32; i += 1 {
            if IsUndefMaskElt.call(SubMask[i]) {
                continue;
            }
            if (SubMask[i] % NumElemsPerConcat as i32) != i {
                return SDValue {};
            }
            let mut EltOpIdx: i32 = SubMask[i] / NumElemsPerConcat;
            if 0 <= OpIdx && EltOpIdx != OpIdx {
                return SDValue {};
            }
            OpIdx = EltOpIdx;
        }
        assert!(0 <= OpIdx, "Unknown concat_vectors op");
        if OpIdx < N0.getNumOperands() as i32 {
            Ops.push(ValueParamT { N0.getOperand(OpIdx) });
        } else {
            Ops.push(ValueParamT { N1.getOperand(OpIdx - N0.getNumOperands()) });
        }
    }
    return DAG.getNode(CONCAT_VECTORS, SDLoc { N }, VT, ArrayRef<SDValue> { Ops });
}

fn combineShuffleOfScalars(SVN: *mut ShuffleVectorSDNode, DAG: *mut SelectionDAG, TLI: *TargetLowering) -> SDValue {
    let mut VT: EVT = SVN.getValueType(0);
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut N0: SDValue = SVN.getOperand(0);
    let mut N1: SDValue = SVN.getOperand(1);
    if !operator(N0).hasOneUse() {
        return SDValue {};
    }
    if !N1.isUndef() {
        if !operator(N1).hasOneUse() {
            return SDValue {};
        }
        let mut N0AnyConst: bool = isAnyConstantBuildVector(N0, false);
        let mut N1AnyConst: bool = isAnyConstantBuildVector(N1, false);
        if N0AnyConst && !N1AnyConst && !isBuildVectorAllZeros(N0.getNode()) {
            return SDValue {};
        }
        if !N0AnyConst && N1AnyConst && !isBuildVectorAllZeros(N1.getNode()) {
            return SDValue {};
        }
    }
    let mut IsSplat: bool = false;
    let mut BV0: *mut BuildVectorSDNode = dyn_cast(N0);
    let mut BV1: *mut BuildVectorSDNode = dyn_cast(N1);
    if BV0 && BV1 {
        if BV0.getSplatValue(null) {
            Splat0;
        } else {
            IsSplat = (Splat0 == BV1.getSplatValue(null));
        }
    }
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut DuplicateOps: SmallSet<SDValue, 16> = SmallSet<SDValue, 16> {};
    for M in SVN.getMask() {
        let mut Op: SDValue = DAG.getPOISON(VT.getScalarType());
        if M >= 0 {
            let mut Idx: i32 = if M < NumElts as i32 { M } else { M - NumElts };
            let mut S: *mut SDValue = (if M < NumElts as i32 { N0 } else { N1 });
            if S.getOpcode() == BUILD_VECTOR {
                Op = S.getOperand(Idx);
            } else if S.getOpcode() == SCALAR_TO_VECTOR {
                let mut Op0: SDValue = S.getOperand(0);
                Op = if Idx == 0 { Op0 } else { DAG.getPOISON(Op0.getValueType()) };
            } else {
                return SDValue {};
            }
        }
        if !Op.isUndef() && !isIntOrFPConstant(Op) {
            if !IsSplat && !DuplicateOps.insert(Op).second {
                return SDValue {};
            }
        }
        Ops.push(ValueParamT { Op });
    }
    let mut SVT: EVT = VT.getScalarType();
    if SVT.isInteger() {
        for Op in Ops {
            SVT = (if SVT.bitsLT(Op.getValueType()) { Op.getValueType() } else { SVT });
        }
    }
    if SVT != VT.getScalarType() {
        for Op in Ops {
            Op = if Op.isUndef() { DAG.getUNDEF(SVT) } else { (if TLI.isZExtFree(Op.getValueType(), SVT) { DAG.getZExtOrTrunc(Op, SDLoc { SVN }, SVT) } else { DAG.getSExtOrTrunc(Op, SDLoc { SVN }, SVT) }) };
        }
    }
    return DAG.getBuildVector(VT, SDLoc { SVN }, ArrayRef<SDValue> { Ops });
}

fn canCombineShuffleToExtendVectorInreg(Opcode: u32, VT: EVT, Match: function<bool (unsigned int)>, DAG: *mut SelectionDAG, TLI: *TargetLowering, LegalTypes: bool, LegalOperations: bool) -> optional<EVT> {
    let mut IsBigEndian: bool = DAG.getDataLayout().isBigEndian();
    if !VT.isInteger() || IsBigEndian {
        return optional<EVT> { nullopt };
    }
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    for let mut Scale: u32 = 2; Scale < NumElts; Scale *= 2 {
        if NumElts % Scale != 0 {
            continue;
        }
        let mut OutSVT: EVT = getIntegerVT(*DAG.getContext(), EltSizeInBits * Scale);
        let mut OutVT: EVT = getVectorVT(*DAG.getContext(), OutSVT, NumElts / Scale, false);
        if (LegalTypes && !TLI.isTypeLegal(OutVT)) || (LegalOperations && !TLI.isOperationLegalOrCustom(Opcode, OutVT, false)) {
            continue;
        }
        if Match.call(Scale) {
            return optional<EVT> { OutVT };
        }
    }
    return optional<EVT> { nullopt };
}

fn combineShuffleToAnyExtendVectorInreg(SVN: *mut ShuffleVectorSDNode, DAG: *mut SelectionDAG, TLI: *TargetLowering, LegalOperations: bool) -> SDValue {
    let mut VT: EVT = SVN.getValueType(0);
    let mut IsBigEndian: bool = DAG.getDataLayout().isBigEndian();
    if !VT.isInteger() || IsBigEndian {
        return SDValue {};
    }
    let mut isAnyExtend: Closure_107 = Closure_107 { cap_0: VT.getVectorNumElements(), cap_1: SVN.getMask() };
    let mut Opcode: u32 = ANY_EXTEND_VECTOR_INREG;
    let mut N0: SDValue = SVN.getOperand(0);
    let mut OutVT: optional<EVT> = canCombineShuffleToExtendVectorInreg(Opcode, VT, function<bool (unsigned int)> { isAnyExtend }, DAG, TLI, true, LegalOperations);
    if !OutVT {
        return SDValue {};
    }
    return DAG.getBitcast(VT, DAG.getNode(Opcode, SDLoc { SVN }, operator(OutVT), N0));
}

fn combineShuffleToZeroExtendVectorInReg(SVN: *mut ShuffleVectorSDNode, DAG: *mut SelectionDAG, TLI: *TargetLowering, LegalOperations: bool) -> SDValue {
    let mut LegalTypes: bool = true;
    let mut VT: EVT = SVN.getValueType(0);
    assert!(!VT.isScalableVector(), "Encountered scalable shuffle?");
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    let mut IsBigEndian: bool = DAG.getDataLayout().isBigEndian();
    if !VT.isInteger() || IsBigEndian {
        return SDValue {};
    }
    let mut Mask: SmallVector<int, 16> = SmallVector<int, 16> { SVN.getMask() };
    let mut ForEachDecomposedIndice: Closure_108 = Closure_108 { NumElts: NumElts, Mask: &mut Mask };
    let mut OpsDemandedElts: array<APInt, 2> = array<APInt, 2> {};
    for OpDemandedElts in OpsDemandedElts {
        OpDemandedElts = getZero(NumElts);
    }
    ForEachDecomposedIndice.call(Closure_109 { OpsDemandedElts: &mut OpsDemandedElts });
    let mut OpsKnownZeroElts: array<APInt, 2> = array<APInt, 2> {};
    for I in zip(SVN.ops(), OpsDemandedElts, OpsKnownZeroElts) {
        get(I) = DAG.computeVectorKnownZeroElements(get(I).operator const llvm::SDValue &(), get(I), 0);
    }
    let mut HadZeroableElts: bool = false;
    ForEachDecomposedIndice.call(Closure_110 { OpsKnownZeroElts: &mut OpsKnownZeroElts, HadZeroableElts: &mut HadZeroableElts });
    if !HadZeroableElts {
        return SDValue {};
    }
    let mut ScaledMask: SmallVector<int, 16> = SmallVector<int, 16> {};
    getShuffleMaskWithWidestElts(ArrayRef<int> { Mask }, ScaledMask);
    assert!(Mask.len >= ScaledMask.len && Mask.len % ScaledMask.len == 0, "Unexpected mask widening.");
    let mut Prescale: i32 = Mask.len / ScaledMask.len;
    NumElts = ScaledMask.len;
    EltSizeInBits *= Prescale;
    let mut PrescaledVT: EVT = getVectorVT(*DAG.getContext(), getIntegerVT(*DAG.getContext(), EltSizeInBits), NumElts, false);
    if LegalTypes && !TLI.isTypeLegal(PrescaledVT) && TLI.isTypeLegal(VT) {
        return SDValue {};
    }
    let mut isZeroExtend: Closure_111 = Closure_111 { NumElts: NumElts, ScaledMask: &mut ScaledMask };
    let mut Opcode: u32 = ZERO_EXTEND_VECTOR_INREG;
    for Commuted in [false, true] {
        let mut Op: SDValue = SVN.getOperand(if !Commuted { 0 } else { 1 });
        if Commuted {
            commuteMask(MutableArrayRef<int> { ScaledMask });
        }
        let mut OutVT: optional<EVT> = canCombineShuffleToExtendVectorInreg(Opcode, PrescaledVT, function<bool (unsigned int)> { isZeroExtend }, DAG, TLI, LegalTypes, LegalOperations);
        if OutVT {
            return DAG.getBitcast(VT, DAG.getNode(Opcode, SDLoc { SVN }, operator(OutVT), DAG.getBitcast(PrescaledVT, Op)));
        }
    }
    return SDValue {};
}

fn combineTruncationShuffle(SVN: *mut ShuffleVectorSDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = SVN.getValueType(0);
    let mut IsBigEndian: bool = DAG.getDataLayout().isBigEndian();
    if !VT.isInteger() || IsBigEndian {
        return SDValue {};
    }
    let mut N0: SDValue = peekThroughBitcasts(SVN.getOperand(0));
    let mut Opcode: u32 = N0.getOpcode();
    if !isExtVecInRegOpcode(Opcode) {
        return SDValue {};
    }
    let mut N00: SDValue = N0.getOperand(0);
    let mut Mask: ArrayRef<int> = SVN.getMask();
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
    let mut ExtSrcSizeInBits: u32 = N00.getScalarValueSizeInBits();
    let mut ExtDstSizeInBits: u32 = N0.getScalarValueSizeInBits();
    if ExtDstSizeInBits % ExtSrcSizeInBits != 0 {
        return SDValue {};
    }
    let mut ExtScale: u32 = ExtDstSizeInBits / ExtSrcSizeInBits;
    let mut isTruncate: Closure_113 = Closure_113 { Mask: &mut Mask, NumElts: &mut NumElts };
    if EltSizeInBits != ExtSrcSizeInBits {
        return SDValue {};
    }
    if VT.getSizeInBits() != N00.getValueSizeInBits() {
        return SDValue {};
    }
    if isTruncate.call(ExtScale) {
        return DAG.getBitcast(VT, N00);
    }
    return SDValue {};
}

fn combineShuffleOfSplatVal(Shuf: *mut ShuffleVectorSDNode, DAG: *mut SelectionDAG) -> SDValue {
    let mut VT: EVT = Shuf.getValueType(0);
    let mut NumElts: u32 = VT.getVectorNumElements();
    if !Shuf.getOperand(1).isUndef() {
        return SDValue {};
    }
    if !Shuf.isSplat() {
        let mut DemandedElts: APInt = APInt { NumElts, 0, false, false };
        for Idx in Shuf.getMask() {
            if Idx < 0 {
                continue;
            }
            assert!(Idx as u32 < NumElts, "Out-of-bounds shuffle indice?");
            DemandedElts.setBit(Idx);
        }
        assert!(DemandedElts.popcount() > 1, "Is a splat shuffle already?");
        let mut UndefElts: APInt = APInt {};
        if DAG.isSplatValue(Shuf.getOperand(0), DemandedElts, UndefElts, 0) {
            let mut MinNonUndefIdx: optional<unsigned int> = optional<unsigned int> {};
            for Idx in Shuf.getMask() {
                if Idx < 0 || UndefElts[Idx] {
                    continue;
                }
                MinNonUndefIdx = optional<unsigned int> { if Idx < MinNonUndefIdx.value_or(~0) { Idx } else { MinNonUndefIdx.value_or(~0) } };
            }
            if !MinNonUndefIdx {
                return DAG.getUNDEF(VT);
            }
            assert!(operator(MinNonUndefIdx) < NumElts, "Expected valid element index.");
            let mut SplatMask: SmallVector<int, 8> = SmallVector<int, 8> { Shuf.getMask() };
            for Idx in SplatMask {
                if Idx < 0 {
                    continue;
                }
                Idx = if UndefElts[Idx] { -1 } else { operator(MinNonUndefIdx) };
            }
            assert!(SplatMask != Shuf.getMask(), "Expected mask to change!");
            return DAG.getVectorShuffle(VT, SDLoc { Shuf }, Shuf.getOperand(0), Shuf.getOperand(1), ArrayRef<int> { SplatMask });
        }
    }
    if DAG.isSplatValue(Shuf.getOperand(0), false) {
        return Shuf.getOperand(0);
    }
    let mut Splat: *mut ShuffleVectorSDNode = dyn_cast(Shuf.getOperand(0));
    if !Splat || !Splat.isSplat() {
        return SDValue {};
    }
    let mut ShufMask: ArrayRef<int> = Shuf.getMask();
    let mut SplatMask: ArrayRef<int> = Splat.getMask();
    assert!(ShufMask.len == SplatMask.len, "Mask length mismatch");
    let mut CanSimplifyToExistingSplat: Closure_114 = Closure_114 {};
    if CanSimplifyToExistingSplat.call(ShufMask, SplatMask) {
        return Shuf.getOperand(0);
    }
    let mut NewMask: SmallVector<int, 32> = SmallVector<int, 32> {};
    for Idx in ShufMask {
        NewMask.push(if Idx == -1 { -1 } else { SplatMask[Idx] });
    }
    return DAG.getVectorShuffle(Splat.getValueType(0), SDLoc { Splat }, Splat.getOperand(0), Splat.getOperand(1), ArrayRef<int> { NewMask });
}

fn combineShuffleOfBitcast(SVN: *mut ShuffleVectorSDNode, DAG: *mut SelectionDAG, TLI: *TargetLowering, LegalOperations: bool) -> SDValue {
    let mut Op0: SDValue = SVN.getOperand(0);
    let mut Op1: SDValue = SVN.getOperand(1);
    let mut VT: EVT = SVN.getValueType(0);
    if Op0.getOpcode() != BITCAST {
        return SDValue {};
    }
    let mut InVT: EVT = Op0.getOperand(0).getValueType();
    if !InVT.isVector() || (!Op1.isUndef() && (Op1.getOpcode() != BITCAST || Op1.getOperand(0).getValueType() != InVT)) {
        return SDValue {};
    }
    if isAnyConstantBuildVector(Op0.getOperand(0), false) && (Op1.isUndef() || isAnyConstantBuildVector(Op1.getOperand(0), false)) {
        return SDValue {};
    }
    let mut VTLanes: i32 = VT.getVectorNumElements();
    let mut InLanes: i32 = InVT.getVectorNumElements();
    if VTLanes <= InLanes || VTLanes % InLanes != 0 || (LegalOperations && !TLI.isOperationLegalOrCustom(VECTOR_SHUFFLE, InVT, false)) {
        return SDValue {};
    }
    let mut Factor: i32 = VTLanes / InLanes;
    let mut Mask: ArrayRef<int> = SVN.getMask();
    let mut NewMask: SmallVector<int> = SmallVector<int> {};
    if !widenShuffleMaskElts(Factor, Mask, NewMask) {
        return SDValue {};
    }
    if !TLI.isShuffleMaskLegal(ArrayRef<int> { NewMask }, InVT) {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { SVN };
    Op0 = Op0.getOperand(0);
    Op1 = if Op1.isUndef() { DAG.getUNDEF(InVT) } else { Op1.getOperand(0) };
    let mut NewShuf: SDValue = DAG.getVectorShuffle(InVT, DL, Op0, Op1, ArrayRef<int> { NewMask });
    return DAG.getBitcast(VT, NewShuf);
}

fn formSplatFromShuffles(OuterShuf: *mut ShuffleVectorSDNode, DAG: *mut SelectionDAG) -> SDValue {
    if !OuterShuf.getOperand(1).isUndef() {
        return SDValue {};
    }
    let mut InnerShuf: *mut ShuffleVectorSDNode = dyn_cast(OuterShuf.getOperand(0));
    if !InnerShuf || !InnerShuf.getOperand(1).isUndef() {
        return SDValue {};
    }
    let mut OuterMask: ArrayRef<int> = OuterShuf.getMask();
    let mut InnerMask: ArrayRef<int> = InnerShuf.getMask();
    let mut NumElts: u32 = OuterMask.len;
    assert!(NumElts == InnerMask.len, "Mask length mismatch");
    let mut CombinedMask: SmallVector<int, 32> = SmallVector<int, 32> { NumElts, -1 };
    let mut SplatIndex: i32 = -1;
    for let mut i: u32 = 0; i != NumElts; i += 1 {
        let mut OuterMaskElt: i32 = OuterMask[i];
        if OuterMaskElt == -1 {
            continue;
        }
        let mut InnerMaskElt: i32 = InnerMask[OuterMaskElt];
        if InnerMaskElt == -1 {
            continue;
        }
        if SplatIndex == -1 {
            SplatIndex = InnerMaskElt;
        }
        if SplatIndex != InnerMaskElt {
            return SDValue {};
        }
        CombinedMask[i] = InnerMaskElt;
    }
    assert!((all_of(CombinedMask, equal_to(-1)) || getSplatIndex(ArrayRef<int> { CombinedMask }) != -1), "Expected a splat mask");
    let mut VT: EVT = OuterShuf.getValueType(0);
    assert!(VT == InnerShuf.getValueType(0), "Expected matching shuffle types");
    if !DAG.getTargetLoweringInfo().isShuffleMaskLegal(ArrayRef<int> { CombinedMask }, VT) {
        return SDValue {};
    }
    return DAG.getVectorShuffle(VT, SDLoc { OuterShuf }, InnerShuf.getOperand(0), InnerShuf.getOperand(1), ArrayRef<int> { CombinedMask });
}

fn getShuffleMaskIndexOfOneElementFromOp0IntoOp1(Mask: ArrayRef<int>) -> i32 {
    let mut MaskSize: i32 = Mask.len;
    let mut EltFromOp0: i32 = -1;
    for let mut i: i32 = 0; i != MaskSize; i += 1 {
        if Mask[i] >= 0 && Mask[i] < MaskSize {
            if EltFromOp0 != -1 {
                return -1;
            }
            EltFromOp0 = i;
        } else if Mask[i] != i + MaskSize {
            return -1;
        }
    }
    return EltFromOp0;
}

fn DAGCombiner::replaceShuffleOfInsert(self, Shuf: *mut ShuffleVectorSDNode) -> SDValue {
    let mut Mask: ArrayRef<int> = Shuf.getMask();
    let mut CommutedMask: SmallVector<int, 16> = SmallVector<int, 16> { Mask };
    let mut Op0: SDValue = Shuf.getOperand(0);
    let mut Op1: SDValue = Shuf.getOperand(1);
    let mut ShufOp0Index: i32 = getShuffleMaskIndexOfOneElementFromOp0IntoOp1(Mask);
    if ShufOp0Index == -1 {
        commuteMask(MutableArrayRef<int> { CommutedMask });
        ShufOp0Index = getShuffleMaskIndexOfOneElementFromOp0IntoOp1(ArrayRef<int> { CommutedMask });
        if ShufOp0Index == -1 {
            return SDValue {};
        }
        swap(Op0, Op1);
        Mask = ArrayRef<int> { CommutedMask };
    }
    assert!(Mask[ShufOp0Index] >= 0 && Mask[ShufOp0Index] < Mask.len as i32, "Shuffle mask value must be from operand 0");
    let mut Elt: SDValue = SDValue {};
    if sd_match(Op0, m_InsertElt(m_Value(), m_Value(Elt), m_SpecificInt(Mask[ShufOp0Index]))) {
        let mut NewInsIndex: SDValue = self.DAG.getVectorIdxConstant(ShufOp0Index, SDLoc { Shuf }, false);
        return self.DAG.getNode(INSERT_VECTOR_ELT, SDLoc { Shuf }, Op0.getValueType(), Op1, Elt, NewInsIndex);
    }
    if !self.hasOperation(INSERT_VECTOR_ELT, Op0.getValueType()) {
        return SDValue {};
    }
    if sd_match(Op0, m_UnaryOp(SCALAR_TO_VECTOR, m_Value(Elt))) && Mask[ShufOp0Index] == 0 {
        let mut NewInsIndex: SDValue = self.DAG.getVectorIdxConstant(ShufOp0Index, SDLoc { Shuf }, false);
        return self.DAG.getNode(INSERT_VECTOR_ELT, SDLoc { Shuf }, Op0.getValueType(), Op1, Elt, NewInsIndex);
    }
    return SDValue {};
}

fn simplifyShuffleOfShuffle(Shuf: *mut ShuffleVectorSDNode) -> SDValue {
    let mut Shuf0: *mut ShuffleVectorSDNode = dyn_cast(Shuf.getOperand(0));
    if !Shuf0 || !Shuf.getOperand(1).isUndef() {
        return SDValue {};
    }
    let mut Mask: ArrayRef<int> = Shuf.getMask();
    let mut Mask0: ArrayRef<int> = Shuf0.getMask();
    for let mut i: i32 = 0;
let mut e: i32 = Mask.len as i32; i != e; i += 1 {
        if Mask[i] == -1 {
            continue;
        }
        assert!(Mask[i] >= 0 && Mask[i] < e, "Unexpected shuffle mask value");
        if Mask0[Mask[i]] != Mask0[i] {
            return SDValue {};
        }
    }
    return Shuf.getOperand(0);
}

fn DAGCombiner::visitVECTOR_SHUFFLE(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut NumElts: u32 = VT.getVectorNumElements();
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    assert!(N0.getValueType() == VT, "Vector shuffle must be normalized in DAG");
    if N0.isUndef() && N1.isUndef() {
        return self.DAG.getUNDEF(VT);
    }
    let mut SVN: *mut ShuffleVectorSDNode = cast(N);
    if N0 == N1 {
        return self.DAG.getVectorShuffle(VT, SDLoc { N }, N0, self.DAG.getPOISON(VT), ArrayRef<int> { createUnaryMask(SVN.getMask(), NumElts) });
    }
    if N0.isUndef() {
        return self.DAG.getCommutedVectorShuffle(*SVN);
    }
    if N1.isUndef() {
        let mut Changed: bool = false;
        let mut NewMask: SmallVector<int, 8> = SmallVector<int, 8> {};
        for let mut i: u32 = 0; i != NumElts; i += 1 {
            let mut Idx: i32 = SVN.getMaskElt(i);
            if Idx >= NumElts as i32 {
                Idx = -1;
                Changed = true;
            }
            NewMask.push(Idx);
        }
        if Changed {
            return self.DAG.getVectorShuffle(VT, SDLoc { N }, N0, N1, ArrayRef<int> { NewMask });
        }
    }
    if self.replaceShuffleOfInsert(SVN) {
        InsElt;
    } else {
        return InsElt;
    }
    if combineShuffleOfSplatVal(SVN, self.DAG) {
        V;
    } else {
        return V;
    }
    if formSplatFromShuffles(SVN, self.DAG) {
        V;
    } else {
        return V;
    }
    if SVN.isSplat() && SVN.getSplatIndex() < NumElts as i32 {
        let mut SplatIndex: i32 = SVN.getSplatIndex();
        if N0.hasOneUse() && self.TLI.isExtractVecEltCheap(VT, SplatIndex) && self.TLI.isBinOp(N0.getOpcode()) && operator(N0).getNumValues() == 1 {
            let mut L: SDValue = N0.getOperand(0);
            let mut R: SDValue = N0.getOperand(1);
            let mut DL: SDLoc = SDLoc { N };
            let mut EltVT: EVT = VT.getScalarType();
            let mut Index: SDValue = self.DAG.getVectorIdxConstant(SplatIndex, DL, false);
            let mut ExtL: SDValue = self.DAG.getNode(EXTRACT_VECTOR_ELT, DL, EltVT, L, Index);
            let mut ExtR: SDValue = self.DAG.getNode(EXTRACT_VECTOR_ELT, DL, EltVT, R, Index);
            let mut NewBO: SDValue = self.DAG.getNode(N0.getOpcode(), DL, EltVT, ExtL, ExtR, operator(N0).getFlags());
            let mut Insert: SDValue = self.DAG.getNode(SCALAR_TO_VECTOR, DL, VT, NewBO);
            let mut ZeroMask: SmallVector<int, 16> = SmallVector<int, 16> { VT.getVectorNumElements(), 0 };
            return self.DAG.getVectorShuffle(VT, DL, Insert, self.DAG.getPOISON(VT), ArrayRef<int> { ZeroMask });
        }
        if (!self.LegalOperations || self.TLI.isOperationLegal(BUILD_VECTOR, VT)) && N0.hasOneUse() {
            if N0.getOpcode() == SCALAR_TO_VECTOR && SplatIndex == 0 {
                return self.DAG.getSplatBuildVector(VT, SDLoc { N }, N0.getOperand(0));
            }
            if N0.getOpcode() == INSERT_VECTOR_ELT {
                if dyn_cast(N0.getOperand(2)) {
                    Idx;
                } else if Idx.getAPIntValue() == SplatIndex {
                    return self.DAG.getSplatBuildVector(VT, SDLoc { N }, N0.getOperand(1));
                }
            }
            if N0.getOpcode() == BITCAST && N0.getOperand(0).hasOneUse() && SplatIndex == 0 && self.DAG.getDataLayout().isLittleEndian() && (N0.getOperand(0).getOpcode() == SCALAR_TO_VECTOR || N0.getOperand(0).getOpcode() == BUILD_VECTOR) {
                let mut N00VT: EVT = N0.getOperand(0).getValueType();
                if VT.getScalarSizeInBits() <= N00VT.getScalarSizeInBits() && VT.isInteger() && N00VT.isInteger() {
                    let mut InVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT.getScalarType());
                    let mut Op: SDValue = self.DAG.getZExtOrTrunc(N0.getOperand(0).getOperand(0), SDLoc { N }, InVT);
                    return self.DAG.getSplatBuildVector(VT, SDLoc { N }, Op);
                }
            }
        }
        let mut V: *mut SDNode = N0.getNode();
        if V.getOpcode() == BITCAST {
            let mut ConvInput: SDValue = V.getOperand(0);
            if ConvInput.getValueType().isVector() && ConvInput.getValueType().getVectorNumElements() == NumElts {
                V = ConvInput.getNode();
            }
        }
        if V.getOpcode() == BUILD_VECTOR {
            assert!(V.getNumOperands() == NumElts, "BUILD_VECTOR has wrong number of operands");
            let mut Base: SDValue = SDValue {};
            let mut AllSame: bool = true;
            for let mut i: u32 = 0; i != NumElts; i += 1 {
                if !V.getOperand(i).isUndef() {
                    Base = V.getOperand(i);
                    break;
                }
            }
            if !Base.getNode() {
                return N0;
            }
            for let mut i: u32 = 0; i != NumElts; i += 1 {
                if V.getOperand(i) != Base {
                    AllSame = false;
                    break;
                }
            }
            if AllSame {
                return N0;
            }
            let mut Splatted: SDValue = V.getOperand(SplatIndex);
            let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { NumElts, Splatted };
            let mut EltVT: EVT = Splatted.getValueType();
            for let mut i: u32 = 0; i != NumElts; i += 1 {
                if SVN.getMaskElt(i) < 0 {
                    Ops[i] = self.DAG.getPOISON(EltVT);
                }
            }
            let mut NewBV: SDValue = self.DAG.getBuildVector(V.getValueType(0), SDLoc { N }, ArrayRef<SDValue> { Ops });
            if V.getValueType(0) != VT {
                NewBV = self.DAG.getBitcast(VT, NewBV);
            }
            return NewBV;
        }
    }
    if self.SimplifyDemandedVectorElts(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    if simplifyShuffleOfShuffle(SVN) {
        ShufOp;
    } else {
        return ShufOp;
    }
    if combineShuffleToAnyExtendVectorInreg(SVN, self.DAG, self.TLI, self.LegalOperations) {
        V;
    } else {
        return V;
    }
    if combineTruncationShuffle(SVN, self.DAG) {
        V;
    } else {
        return V;
    }
    if N0.getOpcode() == CONCAT_VECTORS && self.Level < AfterLegalizeVectorOps && (N1.isUndef() || (N1.getOpcode() == CONCAT_VECTORS && N0.getOperand(0).getValueType() == N1.getOperand(0).getValueType())) {
        if partitionShuffleOfConcats(N, self.DAG) {
            V;
        } else {
            return V;
        }
    }
    if N0.getOpcode() == CONCAT_VECTORS && N1.isUndef() && N0.getNumOperands() == 2 && N0.getOperand(0) == N0.getOperand(1) {
        let mut HalfNumElts: i32 = NumElts as i32 / 2;
        let mut NewMask: SmallVector<int, 8> = SmallVector<int, 8> {};
        for let mut i: u32 = 0; i != NumElts; i += 1 {
            let mut Idx: i32 = SVN.getMaskElt(i);
            if Idx >= HalfNumElts {
                assert!(Idx < NumElts as i32, "Shuffle mask chooses undef op");
                Idx -= HalfNumElts;
            }
            NewMask.push(Idx);
        }
        if self.TLI.isShuffleMaskLegal(ArrayRef<int> { NewMask }, VT) {
            let mut UndefVec: SDValue = self.DAG.getPOISON(N0.getOperand(0).getValueType());
            let mut NewCat: SDValue = self.DAG.getNode(CONCAT_VECTORS, SDLoc { N }, VT, N0.getOperand(0), UndefVec);
            return self.DAG.getVectorShuffle(VT, SDLoc { N }, NewCat, N1, ArrayRef<int> { NewMask });
        }
    }
    if self.Level < AfterLegalizeVectorOps && self.TLI.isTypeLegal(VT) && self.TLI.isOperationLegalOrCustom(INSERT_SUBVECTOR, VT, false) {
        let mut ShuffleToInsert: Closure_115 = Closure_115 { NumElts: &mut NumElts, cap_1: self, N: &mut N };
        let mut Mask: ArrayRef<int> = SVN.getMask();
        if N1.getOpcode() == CONCAT_VECTORS {
            if ShuffleToInsert.call(N0, N1, Mask) {
                InsertN1;
            } else {
                return InsertN1;
            }
        }
        if N0.getOpcode() == CONCAT_VECTORS {
            let mut CommuteMask: SmallVector<int> = SmallVector<int> { Mask };
            commuteMask(MutableArrayRef<int> { CommuteMask });
            if ShuffleToInsert.call(N1, N0, ArrayRef<int> { CommuteMask }) {
                InsertN0;
            } else {
                return InsertN0;
            }
        }
    }
    if self.Level < AfterLegalizeDAG && self.TLI.isTypeLegal(VT) {
        let mut IsInLaneMask: bool = true;
        let mut Mask: ArrayRef<int> = SVN.getMask();
        let mut ClearMask: SmallVector<int, 16> = SmallVector<int, 16> { NumElts, -1 };
        let mut DemandedLHS: APInt = getZero(NumElts);
        let mut DemandedRHS: APInt = getZero(NumElts);
        for let mut I: i32 = 0; I != NumElts as i32; I += 1 {
            let mut M: i32 = Mask[I];
            if M < 0 {
                continue;
            }
            ClearMask[I] = if M == I {} else { (I + NumElts) };
            IsInLaneMask &= (M == I) || (M == (I + NumElts) as i32);
            if M != I {
                let mut Demanded: *mut APInt = if M < NumElts as i32 { DemandedLHS } else { DemandedRHS };
                Demanded.setBit(M % NumElts);
            }
        }
        if !IsInLaneMask && (!DemandedLHS.isZero() || !DemandedRHS.isZero()) && (DemandedLHS.isZero() || self.DAG.MaskedVectorIsZero(N0, DemandedLHS, 0)) && (DemandedRHS.isZero() || self.DAG.MaskedVectorIsZero(N1, DemandedRHS, 0)) {
            let mut DL: SDLoc = SDLoc { N };
            let mut IntVT: EVT = VT.changeVectorElementTypeToInteger();
            let mut IntSVT: EVT = VT.getVectorElementType().changeTypeToInteger();
            if !self.TLI.isTypeLegal(IntSVT) && self.LegalTypes {
                IntSVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), IntSVT);
            }
            if IntSVT.getSizeInBits().operator unsigned long long() >= IntVT.getScalarSizeInBits() {
                let mut ZeroElt: SDValue = self.DAG.getConstant(0, DL, IntSVT, false, false);
                let mut AllOnesElt: SDValue = self.DAG.getAllOnesConstant(DL, IntSVT, false, false);
                let mut AndMask: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> { NumElts, self.DAG.getPOISON(IntSVT) };
                for let mut I: i32 = 0; I != NumElts as i32; I += 1 {
                    if 0 <= Mask[I] {
                        AndMask[I] = if Mask[I] == I { AllOnesElt } else { ZeroElt };
                    }
                }
                if self.TLI.isVectorClearMaskLegal(ArrayRef<int> { ClearMask }, IntVT) {
                    return self.DAG.getBitcast(VT, self.DAG.getVectorShuffle(IntVT, DL, self.DAG.getBitcast(IntVT, N0), self.DAG.getConstant(0, DL, IntVT, false, false), ArrayRef<int> { ClearMask }));
                }
                if self.TLI.isOperationLegalOrCustom(AND, IntVT, false) {
                    return self.DAG.getBitcast(VT, self.DAG.getNode(AND, DL, IntVT, self.DAG.getBitcast(IntVT, N0), self.DAG.getBuildVector(IntVT, DL, ArrayRef<SDValue> { AndMask })));
                }
            }
        }
    }
    if self.Level < AfterLegalizeDAG && self.TLI.isTypeLegal(VT) {
        if combineShuffleOfScalars(SVN, self.DAG, self.TLI) {
            Res;
        } else {
            return Res;
        }
    }
    if N0.getOpcode() == BITCAST && N0.hasOneUse() && N1.isUndef() && self.Level < AfterLegalizeVectorOps && self.TLI.isTypeLegal(VT) {
        let mut BC0: SDValue = peekThroughOneUseBitcasts(N0);
        if BC0.getOpcode() == VECTOR_SHUFFLE && BC0.hasOneUse() {
            let mut SVT: EVT = VT.getScalarType();
            let mut InnerVT: EVT = operator(BC0).getValueType(0);
            let mut InnerSVT: EVT = InnerVT.getScalarType();
            let mut ScaleVT: EVT = if SVT.bitsLT(InnerSVT) { VT } else { InnerVT };
            let mut ScaleSVT: EVT = ScaleVT.getScalarType();
            if self.TLI.isTypeLegal(ScaleVT) && 0 == (InnerSVT.getSizeInBits().operator unsigned long long() % ScaleSVT.getSizeInBits().operator unsigned long long()) && 0 == (SVT.getSizeInBits().operator unsigned long long() % ScaleSVT.getSizeInBits().operator unsigned long long()) {
                let mut InnerScale: i32 = InnerSVT.getSizeInBits().operator unsigned long long() / ScaleSVT.getSizeInBits().operator unsigned long long();
                let mut OuterScale: i32 = SVT.getSizeInBits().operator unsigned long long() / ScaleSVT.getSizeInBits().operator unsigned long long();
                let mut InnerSVN: *mut ShuffleVectorSDNode = cast(BC0);
                let mut InnerMask: SmallVector<int, 8> = SmallVector<int, 8> {};
                let mut OuterMask: SmallVector<int, 8> = SmallVector<int, 8> {};
                narrowShuffleMaskElts(InnerScale, InnerSVN.getMask(), InnerMask);
                narrowShuffleMaskElts(OuterScale, SVN.getMask(), OuterMask);
                let mut NewMask: SmallVector<int, 8> = SmallVector<int, 8> {};
                for M in OuterMask {
                    NewMask.push(if M < 0 { -1 } else { InnerMask[M] });
                }
                let mut SV0: SDValue = operator(BC0).getOperand(0);
                let mut SV1: SDValue = operator(BC0).getOperand(1);
                let mut LegalMask: bool = self.TLI.isShuffleMaskLegal(ArrayRef<int> { NewMask }, ScaleVT);
                if !LegalMask {
                    swap(SV0, SV1);
                    commuteMask(MutableArrayRef<int> { NewMask });
                    LegalMask = self.TLI.isShuffleMaskLegal(ArrayRef<int> { NewMask }, ScaleVT);
                }
                if LegalMask {
                    SV0 = self.DAG.getBitcast(ScaleVT, SV0);
                    SV1 = self.DAG.getBitcast(ScaleVT, SV1);
                    return self.DAG.getBitcast(VT, self.DAG.getVectorShuffle(ScaleVT, SDLoc { N }, SV0, SV1, ArrayRef<int> { NewMask }));
                }
            }
        }
    }
    if combineShuffleOfBitcast(SVN, self.DAG, self.TLI, self.LegalOperations) {
        V;
    } else {
        return V;
    }
    let mut MergeInnerShuffle: Closure_117 = Closure_117 { NumElts: NumElts, VT: &mut VT };
    if self.Level < AfterLegalizeDAG && self.TLI.isTypeLegal(VT) {
        if N1.getOpcode() == VECTOR_SHUFFLE && N0.getOpcode() != VECTOR_SHUFFLE {
            assert!(operator(N1).getOperand(0).getValueType() == VT, "Shuffle types don't match");
            let mut SV0: SDValue = operator(N1).getOperand(0);
            let mut SV1: SDValue = operator(N1).getOperand(1);
            let mut HasSameOp0: bool = N0 == SV0;
            let mut IsSV1Undef: bool = SV1.isUndef();
            if HasSameOp0 || IsSV1Undef || N0 == SV1 {
                return self.DAG.getCommutedVectorShuffle(*SVN);
            }
        }
        if N0.getOpcode() == VECTOR_SHUFFLE && N1.getOpcode() == VECTOR_SHUFFLE && cast(N0).isSplat() && !cast(N1).isSplat() {
            return self.DAG.getCommutedVectorShuffle(*SVN);
        }
        for let mut i: i32 = 0; i != 2; i += 1 {
            if N.getOperand(i).getOpcode() == VECTOR_SHUFFLE && N.isOnlyUserOf(N.getOperand(i).getNode()) {
                let mut OtherSV: *mut ShuffleVectorSDNode = cast(N.getOperand(i));
                assert!(OtherSV.getOperand(0).getValueType() == VT, "Shuffle types don't match");
                let mut SV0: SDValue = SDValue {};
                let mut SV1: SDValue = SDValue {};
                let mut Mask: SmallVector<int, 4> = SmallVector<int, 4> {};
                if MergeInnerShuffle.call(i != 0, SVN, OtherSV, N.getOperand(1 - i), self.TLI, SV0, SV1, Mask) {
                    if all_of(Mask, Closure_119 {}) {
                        return self.DAG.getPOISON(VT);
                    }
                    return self.DAG.getVectorShuffle(VT, SDLoc { N }, if SV0 {} else { self.DAG.getPOISON(VT) }, if SV1 {} else { self.DAG.getPOISON(VT) }, ArrayRef<int> { Mask });
                }
            }
        }
        let mut SrcOpcode: u32 = N0.getOpcode();
        if self.TLI.isBinOp(SrcOpcode) && N.isOnlyUserOf(N0.getNode()) && (N1.isUndef() || (SrcOpcode == N1.getOpcode() && N.isOnlyUserOf(N1.getNode()) && N0.getResNo() == N1.getResNo())) {
            let mut Op00: SDValue = N0.getOperand(0);
            let mut Op01: SDValue = N0.getOperand(1);
            let mut Op10: SDValue = if N1.isUndef() { N1 } else { N1.getOperand(0) };
            let mut Op11: SDValue = if N1.isUndef() { N1 } else { N1.getOperand(1) };
            if Op00.getValueType() == VT && Op10.getValueType() == VT && Op01.getValueType() == VT && Op11.getValueType() == VT && (Op00.getOpcode() == VECTOR_SHUFFLE || Op10.getOpcode() == VECTOR_SHUFFLE || Op01.getOpcode() == VECTOR_SHUFFLE || Op11.getOpcode() == VECTOR_SHUFFLE) {
                let mut CanMergeInnerShuffle: Closure_120 = Closure_120 { N1: &mut N1, N0: &mut N0, Op00: &mut Op00, Op01: &mut Op01, Op10: &mut Op10, Op11: &mut Op11, MergeInnerShuffle: &mut MergeInnerShuffle, SVN: &mut SVN, cap_8: self };
                let mut MergedLeft: bool = false;
                let mut LeftSV0: SDValue = SDValue {};
                let mut LeftSV1: SDValue = SDValue {};
                let mut LeftMask: SmallVector<int, 4> = SmallVector<int, 4> {};
                if CanMergeInnerShuffle.call(LeftSV0, LeftSV1, LeftMask, true, false) || CanMergeInnerShuffle.call(LeftSV0, LeftSV1, LeftMask, true, true) {
                    MergedLeft = true;
                } else {
                    LeftMask.assign(SVN.getMask().begin(), SVN.getMask().end());
                    LeftSV0 = Op00 , LeftSV1 = Op10;
                }
                let mut MergedRight: bool = false;
                let mut RightSV0: SDValue = SDValue {};
                let mut RightSV1: SDValue = SDValue {};
                let mut RightMask: SmallVector<int, 4> = SmallVector<int, 4> {};
                if CanMergeInnerShuffle.call(RightSV0, RightSV1, RightMask, false, false) || CanMergeInnerShuffle.call(RightSV0, RightSV1, RightMask, false, true) {
                    MergedRight = true;
                } else {
                    RightMask.assign(SVN.getMask().begin(), SVN.getMask().end());
                    RightSV0 = Op01 , RightSV1 = Op11;
                }
                if MergedLeft || MergedRight {
                    let mut DL: SDLoc = SDLoc { N };
                    let mut LHS: SDValue = self.DAG.getVectorShuffle(VT, DL, if LeftSV0 {} else { self.DAG.getPOISON(VT) }, if LeftSV1 {} else { self.DAG.getPOISON(VT) }, ArrayRef<int> { LeftMask });
                    let mut RHS: SDValue = self.DAG.getVectorShuffle(VT, DL, if RightSV0 {} else { self.DAG.getPOISON(VT) }, if RightSV1 {} else { self.DAG.getPOISON(VT) }, ArrayRef<int> { RightMask });
                    return self.DAG.getNode(SrcOpcode, DL, operator(N0).getVTList(), LHS, RHS).getValue(N0.getResNo());
                }
            }
        }
    }
    if foldShuffleOfConcatUndefs(SVN, self.DAG) {
        V;
    } else {
        return V;
    }
    if self.Level < AfterLegalizeTypes {
        if combineShuffleToZeroExtendVectorInReg(SVN, self.DAG, self.TLI, self.LegalOperations) {
            V;
        } else {
            return V;
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitSCALAR_TO_VECTOR(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if !VT.isFixedLengthVector() {
        return SDValue {};
    }
    let mut Scalar: SDValue = N.getOperand(0);
    let mut Opcode: u32 = Scalar.getOpcode();
    let mut VecEltVT: EVT = VT.getScalarType();
    if Scalar.hasOneUse() && operator(Scalar).getNumValues() == 1 && self.TLI.isBinOp(Opcode) && Scalar.getValueType() == VecEltVT && Scalar.getOperand(0).getValueType() == VecEltVT && Scalar.getOperand(1).getValueType() == VecEltVT && operator(Scalar).isOnlyUserOf(Scalar.getOperand(0).getNode()) && operator(Scalar).isOnlyUserOf(Scalar.getOperand(1).getNode()) && self.DAG.isSafeToSpeculativelyExecute(Opcode) && self.hasOperation(Opcode, VT) {
        let mut ShufMask: SmallVector<int, 8> = SmallVector<int, 8> { VT.getVectorNumElements(), -1 };
        for i in [0, 1] {
            let mut EE: SDValue = Scalar.getOperand(i);
            let mut C: *mut ConstantSDNode = dyn_cast(Scalar.getOperand(if i { 0 } else { 1 }));
            if C && EE.getOpcode() == EXTRACT_VECTOR_ELT && EE.getOperand(0).getValueType() == VT && isa(EE.getOperand(1)) {
                ShufMask[0] = EE.getConstantOperandVal(1);
                if self.TLI.isShuffleMaskLegal(ArrayRef<int> { ShufMask }, VT) {
                    let mut DL: SDLoc = SDLoc { N };
                    let mut V: [2]SDValue = [EE.getOperand(0), self.DAG.getConstant(C.getAPIntValue(), DL, VT, false, false)];
                    let mut VecBO: SDValue = self.DAG.getNode(Opcode, DL, VT, V[i], V[1 - i]);
                    return self.DAG.getVectorShuffle(VT, DL, VecBO, self.DAG.getPOISON(VT), ArrayRef<int> { ShufMask });
                }
            }
        }
    }
    if Opcode != EXTRACT_VECTOR_ELT || !Scalar.getOperand(0).getValueType().isFixedLengthVector() {
        return SDValue {};
    }
    if VecEltVT != Scalar.getValueType() && Scalar.getValueType().isScalarInteger() && self.isTypeLegal(VecEltVT) {
        let mut Val: SDValue = self.DAG.getNode(TRUNCATE, SDLoc { Scalar }, VecEltVT, Scalar);
        return self.DAG.getNode(SCALAR_TO_VECTOR, SDLoc { N }, VT, Val);
    }
    let mut ExtIndexC: *mut ConstantSDNode = dyn_cast(Scalar.getOperand(1));
    if !ExtIndexC {
        return SDValue {};
    }
    let mut SrcVec: SDValue = Scalar.getOperand(0);
    let mut SrcVT: EVT = SrcVec.getValueType();
    let mut SrcNumElts: u32 = SrcVT.getVectorNumElements();
    let mut VTNumElts: u32 = VT.getVectorNumElements();
    if VecEltVT == SrcVT.getScalarType() && VTNumElts <= SrcNumElts {
        let mut Mask: SmallVector<int, 8> = SmallVector<int, 8> { SrcNumElts, -1 };
        Mask[0] = ExtIndexC.getZExtValue();
        let mut LegalShuffle: SDValue = self.TLI.buildLegalVectorShuffle(SrcVT, SDLoc { N }, SrcVec, self.DAG.getPOISON(SrcVT), MutableArrayRef<int> { Mask }, self.DAG);
        if !LegalShuffle {
            return SDValue {};
        }
        if VT == SrcVT {
            return LegalShuffle;
        }
        if VTNumElts != SrcNumElts {
            let mut ZeroIdx: SDValue = self.DAG.getVectorIdxConstant(0, SDLoc { N }, false);
            let mut SubVT: EVT = getVectorVT(*self.DAG.getContext(), SrcVT.getVectorElementType(), VTNumElts, false);
            return self.DAG.getNode(EXTRACT_SUBVECTOR, SDLoc { N }, SubVT, LegalShuffle, ZeroIdx);
        }
    }
    return SDValue {};
}

fn DAGCombiner::visitINSERT_SUBVECTOR(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut N2: SDValue = N.getOperand(2);
    let mut InsIdx: u64 = N.getConstantOperandVal(2);
    if N1.isUndef() {
        if N1.getOpcode() == POISON || N0.getOpcode() == UNDEF {
            return N0;
        }
        return self.DAG.getFreeze(N0);
    }
    if N0.isUndef() && N1.getOpcode() == EXTRACT_SUBVECTOR && N1.getOperand(1) == N2 {
        let mut N1VT: EVT = N1.getValueType();
        let mut SrcVT: EVT = N1.getOperand(0).getValueType();
        if SrcVT == VT {
            if N0.getOpcode() == POISON {
                return N1.getOperand(0);
            }
            if VT.isFixedLengthVector() && N1VT.isFixedLengthVector() {
                let mut SubVecNumElts: u32 = N1VT.getVectorNumElements();
                let mut EltMask: APInt = getBitsSet(VT.getVectorNumElements(), InsIdx, InsIdx + SubVecNumElts);
                if self.DAG.isGuaranteedNotToBePoison(N1.getOperand(0), operator(EltMask), 0) {
                    return N1.getOperand(0);
                }
            } else if self.DAG.isGuaranteedNotToBePoison(N1.getOperand(0), 0) {
                return N1.getOperand(0);
            }
        }
        if isNullConstant(N2) {
            if VT.knownBitsGE(SrcVT) && !(VT.isFixedLengthVector() && SrcVT.isScalableVector()) {
                return self.DAG.getNode(INSERT_SUBVECTOR, SDLoc { N }, VT, N0, N1.getOperand(0), N2);
            } else if VT.knownBitsLE(SrcVT) && !(VT.isScalableVector() && SrcVT.isFixedLengthVector()) {
                return self.DAG.getNode(EXTRACT_SUBVECTOR, SDLoc { N }, VT, N1.getOperand(0), N2);
            }
        }
    }
    if N1.getOpcode() == EXTRACT_SUBVECTOR && N1.getOperand(0) == N0 && N1.getOperand(1) == N2 {
        return N0;
    }
    if N0.isUndef() && N1.getOpcode() == SPLAT_VECTOR {
        if self.DAG.isConstantValueOfAnyType(N1.getOperand(0)) || N1.hasOneUse() {
            return self.DAG.getNode(SPLAT_VECTOR, SDLoc { N }, VT, N1.getOperand(0));
        }
    }
    if N0.getOpcode() == SPLAT_VECTOR && N0.getOpcode() == N1.getOpcode() && N0.getOperand(0) == N1.getOperand(0) {
        return N0;
    }
    if N0.isUndef() && N1.getOpcode() == BITCAST && N1.getOperand(0).getOpcode() == EXTRACT_SUBVECTOR && N1.getOperand(0).getOperand(1) == N2 && N1.getOperand(0).getOperand(0).getValueType().getVectorElementCount() == VT.getVectorElementCount() && N1.getOperand(0).getOperand(0).getValueType().getSizeInBits() == VT.getSizeInBits() {
        return self.DAG.getBitcast(VT, N1.getOperand(0).getOperand(0));
    }
    if N0.getOpcode() == BITCAST && N1.getOpcode() == BITCAST {
        let mut CN0: SDValue = N0.getOperand(0);
        let mut CN1: SDValue = N1.getOperand(0);
        let mut CN0VT: EVT = CN0.getValueType();
        let mut CN1VT: EVT = CN1.getValueType();
        if CN0VT.isVector() && CN1VT.isVector() && CN0VT.getVectorElementType() == CN1VT.getVectorElementType() && CN0VT.getVectorElementCount() == VT.getVectorElementCount() {
            let mut NewINSERT: SDValue = self.DAG.getNode(INSERT_SUBVECTOR, SDLoc { N }, CN0.getValueType(), CN0, CN1, N2);
            return self.DAG.getBitcast(VT, NewINSERT);
        }
    }
    if N0.getOpcode() == INSERT_SUBVECTOR && N0.getOperand(1).getValueType() == N1.getValueType() && N0.getOperand(2) == N2 {
        return self.DAG.getNode(INSERT_SUBVECTOR, SDLoc { N }, VT, N0.getOperand(0), N1, N2);
    }
    if N0.isUndef() && N1.getOpcode() == INSERT_SUBVECTOR && N1.getOperand(0).isUndef() && isNullConstant(N1.getOperand(2)) && isNullConstant(N2) {
        return self.DAG.getNode(INSERT_SUBVECTOR, SDLoc { N }, VT, N0, N1.getOperand(1), N2);
    }
    if (N0.isUndef() || N0.getOpcode() == BITCAST) && N1.getOpcode() == BITCAST {
        let mut N0Src: SDValue = peekThroughBitcasts(N0);
        let mut N1Src: SDValue = peekThroughBitcasts(N1);
        let mut N0SrcSVT: EVT = N0Src.getValueType().getScalarType();
        let mut N1SrcSVT: EVT = N1Src.getValueType().getScalarType();
        if (N0.isUndef() || N0SrcSVT == N1SrcSVT) && N0Src.getValueType().isVector() && N1Src.getValueType().isVector() {
            let mut NewVT: EVT = EVT {};
            let mut DL: SDLoc = SDLoc { N };
            let mut NewIdx: SDValue = SDValue {};
            let mut Ctx: *mut LLVMContext = *self.DAG.getContext();
            let mut NumElts: ElementCount = VT.getVectorElementCount();
            let mut EltSizeInBits: u32 = VT.getScalarSizeInBits();
            if (EltSizeInBits % N1SrcSVT.getSizeInBits().operator unsigned long long()) == 0 {
                let mut Scale: u32 = EltSizeInBits / N1SrcSVT.getSizeInBits().operator unsigned long long();
                NewVT = getVectorVT(Ctx, N1SrcSVT, NumElts * Scale);
                NewIdx = self.DAG.getVectorIdxConstant(InsIdx * Scale, DL, false);
            } else if (N1SrcSVT.getSizeInBits().operator unsigned long long() % EltSizeInBits) == 0 {
                let mut Scale: u32 = N1SrcSVT.getSizeInBits().operator unsigned long long() / EltSizeInBits;
                if NumElts.isKnownMultipleOf(Scale) && (InsIdx % Scale) == 0 {
                    NewVT = getVectorVT(Ctx, N1SrcSVT, NumElts.divideCoefficientBy(Scale));
                    NewIdx = self.DAG.getVectorIdxConstant(InsIdx / Scale, DL, false);
                }
            }
            if NewIdx && self.hasOperation(INSERT_SUBVECTOR, NewVT) {
                let mut Res: SDValue = self.DAG.getBitcast(NewVT, N0Src);
                Res = self.DAG.getNode(INSERT_SUBVECTOR, DL, NewVT, Res, N1Src, NewIdx);
                return self.DAG.getBitcast(VT, Res);
            }
        }
    }
    if N0.getOpcode() == INSERT_SUBVECTOR && N0.hasOneUse() && N1.getValueType() == N0.getOperand(1).getValueType() {
        let mut OtherIdx: u32 = N0.getConstantOperandVal(2);
        if InsIdx < OtherIdx {
            let mut NewOp: SDValue = self.DAG.getNode(INSERT_SUBVECTOR, SDLoc { N }, VT, N0.getOperand(0), N1, N2);
            self.AddToWorklist(NewOp.getNode(), true, false);
            return self.DAG.getNode(INSERT_SUBVECTOR, SDLoc { N0.getNode() }, VT, NewOp, N0.getOperand(1), N0.getOperand(2));
        }
    }
    if N0.getOpcode() == CONCAT_VECTORS && N0.hasOneUse() {
        let mut ConcatOpVT: EVT = N0.getOperand(0).getValueType();
        let mut InsVT: EVT = N1.getValueType();
        let mut Factor: u32 = ConcatOpVT.getVectorMinNumElements();
        let mut ConcatOpIdx: u32 = InsIdx / Factor;
        let mut RelativeIdx: u32 = InsIdx - ConcatOpIdx * Factor;
        assert!(ConcatOpIdx < N0.getNumOperands(), "subvector index mismatch");
        if RelativeIdx == 0 && ConcatOpVT == InsVT {
            let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { operator(N0).ops() };
            Ops[ConcatOpIdx] = N1;
            return self.DAG.getNode(CONCAT_VECTORS, SDLoc { N }, VT, ArrayRef<SDValue> { Ops });
        }
        if VT.isFixedLengthVector() && ConcatOpVT.isFixedLengthVector() && InsVT.isFixedLengthVector() && self.hasOperation(INSERT_SUBVECTOR, ConcatOpVT) {
            let mut NumConcatOpElts: u32 = ConcatOpVT.getVectorNumElements();
            let mut NumInsElts: u32 = InsVT.getVectorNumElements();
            if RelativeIdx % NumInsElts == 0 && RelativeIdx + NumInsElts <= NumConcatOpElts {
                let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { operator(N0).ops() };
                Ops[ConcatOpIdx] = self.DAG.getInsertSubvector(SDLoc { N }, Ops[ConcatOpIdx], N1, RelativeIdx);
                return self.DAG.getNode(CONCAT_VECTORS, SDLoc { N }, VT, ArrayRef<SDValue> { Ops });
            }
        }
    }
    if self.SimplifyDemandedVectorElts(SDValue { Node: N, ResNo: 0 }) {
        return SDValue { Node: N, ResNo: 0 };
    }
    return SDValue {};
}

fn DAGCombiner::visitFP_TO_FP16(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    if operator(N0).getOpcode() == FP16_TO_FP {
        return operator(N0).getOperand(0);
    }
    return SDValue {};
}

fn DAGCombiner::visitFP16_TO_FP(self, N: *mut SDNode) -> SDValue {
    let mut FlagsInserter: FlagInserter = FlagInserter { self.DAG, N };
    let mut Op: u32 = N.getOpcode();
    assert!((Op == FP16_TO_FP || Op == BF16_TO_FP), "opcode should be FP16_TO_FP or BF16_TO_FP.");
    let mut N0: SDValue = N.getOperand(0);
    if !self.TLI.shouldKeepZExtForFP16Conv() && operator(N0).getOpcode() == AND {
        let mut AndConst: *mut ConstantSDNode = getAsNonOpaqueConstant(N0.getOperand(1));
        if AndConst && AndConst.getAPIntValue() == 65535 {
            return self.DAG.getNode(Op, SDLoc { N }, N.getValueType(0), N0.getOperand(0));
        }
    }
    if eliminateFPCastPair(N) {
        CastEliminated;
    } else {
        return CastEliminated;
    }
    let mut Folded: SDValue = self.DAG.FoldConstantArithmetic(N.getOpcode(), SDLoc { N }, N.getValueType(0), ArrayRef<SDValue> { [N0] }, SDNodeFlags { Flags: None });
    return Folded;
}

fn DAGCombiner::visitFP_TO_BF16(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    if operator(N0).getOpcode() == BF16_TO_FP {
        return operator(N0).getOperand(0);
    }
    return SDValue {};
}

fn DAGCombiner::visitBF16_TO_FP(self, N: *mut SDNode) -> SDValue {
    return self.visitFP16_TO_FP(N);
}

fn DAGCombiner::visitVECREDUCE(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N0.getValueType();
    let mut Opcode: u32 = N.getOpcode();
    if VT.getVectorElementCount().isScalar() {
        let mut dl: SDLoc = SDLoc { N };
        let mut Res: SDValue = self.DAG.getNode(EXTRACT_VECTOR_ELT, dl, VT.getVectorElementType(), N0, self.DAG.getVectorIdxConstant(0, dl, false));
        if Res.getValueType() != N.getValueType(0) {
            Res = self.DAG.getNode(ANY_EXTEND, dl, N.getValueType(0), Res);
        }
        return Res;
    }
    if Opcode == VECREDUCE_AND || Opcode == VECREDUCE_OR {
        let mut NewOpcode: u32 = if Opcode == VECREDUCE_AND { VECREDUCE_UMIN } else { VECREDUCE_UMAX };
        if !self.TLI.isOperationLegalOrCustom(Opcode, VT, false) && self.TLI.isOperationLegalOrCustom(NewOpcode, VT, false) && self.DAG.ComputeNumSignBits(N0, 0) == VT.getScalarSizeInBits() {
            return self.DAG.getNode(NewOpcode, SDLoc { N }, N.getValueType(0), N0);
        }
    }
    if N0.getOpcode() == INSERT_SUBVECTOR && self.TLI.isTypeLegal(N0.getOperand(1).getValueType()) {
        let mut Vec: SDValue = N0.getOperand(0);
        let mut Subvec: SDValue = N0.getOperand(1);
        if (Opcode == VECREDUCE_OR && (N0.getOperand(0).isUndef() || isNullOrNullSplat(Vec, false))) || (Opcode == VECREDUCE_AND && (N0.getOperand(0).isUndef() || isAllOnesOrAllOnesSplat(Vec, false))) {
            return self.DAG.getNode(Opcode, SDLoc { N }, N.getValueType(0), Subvec);
        }
    }
    if (Opcode == VECREDUCE_OR || Opcode == VECREDUCE_AND || Opcode == VECREDUCE_XOR) && (N0.getOpcode() == SIGN_EXTEND || N0.getOpcode() == ZERO_EXTEND || N0.getOpcode() == ANY_EXTEND) && self.TLI.isOperationLegalOrCustom(Opcode, N0.getOperand(0).getValueType(), false) {
        let mut Red: SDValue = self.DAG.getNode(Opcode, SDLoc { N }, N0.getOperand(0).getValueType().getScalarType(), N0.getOperand(0));
        return self.DAG.getNode(N0.getOpcode(), SDLoc { N }, N.getValueType(0), Red);
    }
    return SDValue {};
}

fn DAGCombiner::visitVPOp(self, N: *mut SDNode) -> SDValue {
    if N.getOpcode() == VP_GATHER {
        if self.visitVPGATHER(N) {
            SD;
        } else {
            return SD;
        }
    }
    if N.getOpcode() == VP_SCATTER {
        if self.visitVPSCATTER(N) {
            SD;
        } else {
            return SD;
        }
    }
    if N.getOpcode() == EXPERIMENTAL_VP_STRIDED_LOAD {
        if self.visitVP_STRIDED_LOAD(N) {
            SD;
        } else {
            return SD;
        }
    }
    if N.getOpcode() == EXPERIMENTAL_VP_STRIDED_STORE {
        if self.visitVP_STRIDED_STORE(N) {
            SD;
        } else {
            return SD;
        }
    }
    let mut AreAllEltsDisabled: bool = false;
    if getVPExplicitVectorLengthIdx(N.getOpcode()) {
        EVLIdx;
    } else {
        AreAllEltsDisabled |= isNullConstant(N.getOperand(operator(EVLIdx)));
    }
    if getVPMaskIdx(N.getOpcode()) {
        MaskIdx;
    } else {
        AreAllEltsDisabled |= isConstantSplatVectorAllZeros(N.getOperand(operator(MaskIdx)).getNode(), false);
    }
    if !AreAllEltsDisabled {
        return SDValue {};
    }
    if isVPBinaryOp(N.getOpcode()) {
        return self.DAG.getUNDEF(N.getValueType(0));
    }
    if dyn_cast(N) {
        MemSD;
    } else {
        if MemSD.writeMem() {
            return MemSD.getChain();
        }
        return self.CombineTo(N, self.DAG.getUNDEF(N.getValueType(0)), MemSD.getChain(), true);
    }
    if isVPReduction(N.getOpcode()) {
        return N.getOperand(0);
    }
    return SDValue {};
}

fn DAGCombiner::visitGET_FPENV_MEM(self, N: *mut SDNode) -> SDValue {
    let mut Chain: SDValue = N.getOperand(0);
    let mut Ptr: SDValue = N.getOperand(1);
    let mut MemVT: EVT = cast(N).getMemoryVT();
    let mut LdNode: *mut LoadSDNode = null;
    for U in operator(Ptr).users() {
        if U == N {
            continue;
        }
        if dyn_cast(U) {
            Ld;
        } else {
            if LdNode && LdNode != Ld {
                return SDValue {};
            }
            LdNode = Ld;
            continue;
        }
        return SDValue {};
    }
    if !LdNode || !LdNode.isSimple() || LdNode.isIndexed() || !LdNode.getOffset().isUndef() || LdNode.getMemoryVT() != MemVT || !LdNode.getChain().reachesChainWithoutSideEffects(SDValue { Node: N, ResNo: 0 }, 2) {
        return SDValue {};
    }
    let mut StNode: *mut StoreSDNode = null;
    for U in LdNode.uses() {
        if U.getResNo() == 0 {
            if dyn_cast(U.getUser()) {
                St;
            } else {
                if StNode {
                    return SDValue {};
                }
                StNode = St;
            }
        }
    }
    if !StNode || !StNode.isSimple() || StNode.isIndexed() || !StNode.getOffset().isUndef() || StNode.getMemoryVT() != MemVT || !StNode.getChain().reachesChainWithoutSideEffects(SDValue { Node: LdNode, ResNo: 1 }, 2) {
        return SDValue {};
    }
    let mut Res: SDValue = self.DAG.getGetFPEnv(Chain, SDLoc { N }, StNode.getBasePtr(), MemVT, StNode.getMemOperand());
    self.CombineTo(StNode, Res, false);
    return Res;
}

fn DAGCombiner::visitSET_FPENV_MEM(self, N: *mut SDNode) -> SDValue {
    let mut Chain: SDValue = N.getOperand(0);
    let mut Ptr: SDValue = N.getOperand(1);
    let mut MemVT: EVT = cast(N).getMemoryVT();
    let mut StNode: *mut StoreSDNode = null;
    for U in operator(Ptr).users() {
        if U == N {
            continue;
        }
        if dyn_cast(U) {
            St;
        } else {
            if StNode && StNode != St {
                return SDValue {};
            }
            StNode = St;
            continue;
        }
        return SDValue {};
    }
    if !StNode || !StNode.isSimple() || StNode.isIndexed() || !StNode.getOffset().isUndef() || StNode.getMemoryVT() != MemVT || !Chain.reachesChainWithoutSideEffects(SDValue { Node: StNode, ResNo: 0 }, 2) {
        return SDValue {};
    }
    let mut StValue: SDValue = StNode.getValue();
    let mut LdNode: *mut LoadSDNode = dyn_cast(StValue);
    if !LdNode || !LdNode.isSimple() || LdNode.isIndexed() || !LdNode.getOffset().isUndef() || LdNode.getMemoryVT() != MemVT || !StNode.getChain().reachesChainWithoutSideEffects(SDValue { Node: LdNode, ResNo: 1 }, 2) {
        return SDValue {};
    }
    let mut Res: SDValue = self.DAG.getSetFPEnv(LdNode.getChain(), SDLoc { N }, LdNode.getBasePtr(), MemVT, LdNode.getMemOperand());
    return Res;
}

fn DAGCombiner::XformToShuffleWithZero(self, N: *mut SDNode) -> SDValue {
    assert!(N.getOpcode() == AND, "Unexpected opcode!");
    let mut VT: EVT = N.getValueType(0);
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = peekThroughBitcasts(N.getOperand(1));
    let mut DL: SDLoc = SDLoc { N };
    if self.LegalOperations {
        return SDValue {};
    }
    if RHS.getOpcode() != BUILD_VECTOR {
        return SDValue {};
    }
    let mut RVT: EVT = RHS.getValueType();
    let mut NumElts: u32 = RHS.getNumOperands();
    let mut BuildClearMask: Closure_123 = Closure_123 { NumElts: &mut NumElts, RVT: &mut RVT, RHS: &mut RHS, cap_3: self, DL: &mut DL, VT: &mut VT, LHS: &mut LHS };
    let mut MaxSplit: i32 = 1;
    if RVT.getScalarSizeInBits() % 8 == 0 {
        MaxSplit = RVT.getScalarSizeInBits() / 8;
    }
    for let mut Split: i32 = 1; Split <= MaxSplit; Split += 1 {
        if RVT.getScalarSizeInBits() % Split == 0 {
            if BuildClearMask.call(Split) {
                S;
            } else {
                return S;
            }
        }
    }
    return SDValue {};
}

fn scalarizeBinOpOfSplats(N: *mut SDNode, DAG: *mut SelectionDAG, DL: *SDLoc, LegalTypes: bool) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut Opcode: u32 = N.getOpcode();
    let mut VT: EVT = N.getValueType(0);
    let mut EltVT: EVT = VT.getVectorElementType();
    let mut TLI: *TargetLowering = DAG.getTargetLoweringInfo();
    let mut Index0: i32 = 0;
    let mut Index1: i32 = 0;
    let mut Src0: SDValue = DAG.getSplatSourceVector(N0, Index0);
    let mut Src1: SDValue = DAG.getSplatSourceVector(N1, Index1);
    let mut IsBothSplatVector: bool = N0.getOpcode() == SPLAT_VECTOR && N1.getOpcode() == SPLAT_VECTOR;
    if !Src0 || !Src1 || Index0 != Index1 || Src0.getValueType().getVectorElementType() != EltVT || Src1.getValueType().getVectorElementType() != EltVT || !(IsBothSplatVector || TLI.isExtractVecEltCheap(VT, Index0)) || !TLI.isOperationLegalOrCustom(Opcode, if LegalTypes { EltVT } else { TLI.getTypeToTransformTo(*DAG.getContext(), EltVT) }, false) {
        return SDValue {};
    }
    if (Opcode == MULHS || Opcode == MULHU) && !TLI.isTypeLegal(EltVT) {
        return SDValue {};
    }
    if N0.getOpcode() == BUILD_VECTOR && N0.getOpcode() == N1.getOpcode() {
        let mut EltsX: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
        let mut EltsY: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
        let mut EltsResult: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
        DAG.ExtractVectorElements(Src0, EltsX, 0, 0, EVT {});
        DAG.ExtractVectorElements(Src1, EltsY, 0, 0, EVT {});
        for x in zip(EltsX, EltsY) {
            EltsResult.push(DAG.getNode(Opcode, DL, EltVT, X, Y, N.getFlags()));
        }
        return DAG.getBuildVector(VT, DL, ArrayRef<SDValue> { EltsResult });
    }
    let mut IndexC: SDValue = DAG.getVectorIdxConstant(Index0, DL, false);
    let mut X: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, DL, EltVT, Src0, IndexC);
    let mut Y: SDValue = DAG.getNode(EXTRACT_VECTOR_ELT, DL, EltVT, Src1, IndexC);
    let mut ScalarBO: SDValue = DAG.getNode(Opcode, DL, EltVT, X, Y, N.getFlags());
    return DAG.getSplat(VT, DL, ScalarBO);
}

fn DAGCombiner::SimplifyVCastOp(self, N: *mut SDNode, DL: *SDLoc) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    assert!(VT.isVector(), "SimplifyVCastOp only works on vectors!");
    let mut EltVT: EVT = VT.getVectorElementType();
    let mut Opcode: u32 = N.getOpcode();
    let mut N0: SDValue = N.getOperand(0);
    let mut TLI: *TargetLowering = self.DAG.getTargetLoweringInfo();
    let mut Index0: i32 = 0;
    let mut Src0: SDValue = self.DAG.getSplatSourceVector(N0, Index0);
    if Src0 && (N0.getOpcode() == SPLAT_VECTOR || TLI.isExtractVecEltCheap(VT, Index0)) && TLI.isOperationLegalOrCustom(Opcode, EltVT, false) && TLI.preferScalarizeSplat(N) {
        let mut SrcVT: EVT = N0.getValueType();
        let mut SrcEltVT: EVT = SrcVT.getVectorElementType();
        if !self.LegalTypes || TLI.isTypeLegal(SrcEltVT) {
            let mut IndexC: SDValue = self.DAG.getVectorIdxConstant(Index0, DL, false);
            let mut Elt: SDValue = self.DAG.getNode(EXTRACT_VECTOR_ELT, DL, SrcEltVT, Src0, IndexC);
            let mut ScalarBO: SDValue = self.DAG.getNode(Opcode, DL, EltVT, Elt, N.getFlags());
            if VT.isScalableVector() {
                return self.DAG.getSplatVector(VT, DL, ScalarBO);
            }
            let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { VT.getVectorNumElements(), ScalarBO };
            return self.DAG.getBuildVector(VT, DL, ArrayRef<SDValue> { Ops });
        }
    }
    return SDValue {};
}

fn DAGCombiner::SimplifyVBinOp(self, N: *mut SDNode, DL: *SDLoc) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    assert!(VT.isVector(), "SimplifyVBinOp only works on vectors!");
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = N.getOperand(1);
    let mut Opcode: u32 = N.getOpcode();
    let mut Flags: SDNodeFlags = N.getFlags();
    if self.DAG.isSafeToSpeculativelyExecute(Opcode) {
        let mut Shuf0: *mut ShuffleVectorSDNode = dyn_cast(LHS);
        let mut Shuf1: *mut ShuffleVectorSDNode = dyn_cast(RHS);
        if Shuf0 && Shuf1 && Shuf0.getMask().equals(Shuf1.getMask()) && LHS.getOperand(1).isUndef() && RHS.getOperand(1).isUndef() && (LHS.hasOneUse() || RHS.hasOneUse() || LHS == RHS) {
            let mut NewBinOp: SDValue = self.DAG.getNode(Opcode, DL, VT, LHS.getOperand(0), RHS.getOperand(0), Flags);
            let mut UndefV: SDValue = LHS.getOperand(1);
            return self.DAG.getVectorShuffle(VT, DL, NewBinOp, UndefV, Shuf0.getMask());
        }
        if isConstOrConstSplat(RHS, false, false) && Shuf0 && all_equal(Shuf0.getMask()) && Shuf0.hasOneUse() && Shuf0.getOperand(1).isUndef() && Shuf0.getOperand(0).getOpcode() != INSERT_VECTOR_ELT {
            let mut X: SDValue = Shuf0.getOperand(0);
            let mut NewBinOp: SDValue = self.DAG.getNode(Opcode, DL, VT, X, RHS, Flags);
            return self.DAG.getVectorShuffle(VT, DL, NewBinOp, self.DAG.getPOISON(VT), Shuf0.getMask());
        }
        if isConstOrConstSplat(LHS, false, false) && Shuf1 && all_equal(Shuf1.getMask()) && Shuf1.hasOneUse() && Shuf1.getOperand(1).isUndef() && Shuf1.getOperand(0).getOpcode() != INSERT_VECTOR_ELT {
            let mut X: SDValue = Shuf1.getOperand(0);
            let mut NewBinOp: SDValue = self.DAG.getNode(Opcode, DL, VT, LHS, X, Flags);
            return self.DAG.getVectorShuffle(VT, DL, NewBinOp, self.DAG.getPOISON(VT), Shuf1.getMask());
        }
    }
    if LHS.getOpcode() == INSERT_SUBVECTOR && LHS.getOperand(0).isUndef() && RHS.getOpcode() == INSERT_SUBVECTOR && RHS.getOperand(0).isUndef() && LHS.getOperand(2) == RHS.getOperand(2) && (LHS.hasOneUse() || RHS.hasOneUse()) {
        let mut X: SDValue = LHS.getOperand(1);
        let mut Y: SDValue = RHS.getOperand(1);
        let mut Z: SDValue = LHS.getOperand(2);
        let mut NarrowVT: EVT = X.getValueType();
        if NarrowVT == Y.getValueType() && self.TLI.isOperationLegalOrCustomOrPromote(Opcode, NarrowVT, self.LegalOperations) {
            let mut VecC: SDValue = self.DAG.getNode(Opcode, DL, VT, self.DAG.getUNDEF(VT), self.DAG.getUNDEF(VT));
            let mut NarrowBO: SDValue = self.DAG.getNode(Opcode, DL, NarrowVT, X, Y);
            return self.DAG.getNode(INSERT_SUBVECTOR, DL, VT, VecC, NarrowBO, Z);
        }
    }
    let mut ConcatWithConstantOrUndef: Closure_124 = Closure_124 {};
    if ConcatWithConstantOrUndef.call(LHS) && ConcatWithConstantOrUndef.call(RHS) && (LHS.hasOneUse() || RHS.hasOneUse()) {
        let mut NarrowVT: EVT = LHS.getOperand(0).getValueType();
        if NarrowVT == RHS.getOperand(0).getValueType() && self.TLI.isOperationLegalOrCustomOrPromote(Opcode, NarrowVT, false) {
            let mut NumOperands: u32 = LHS.getNumOperands();
            let mut ConcatOps: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> {};
            for let mut i: u32 = 0; i != NumOperands; i += 1 {
                ConcatOps.push(self.DAG.getNode(Opcode, DL, NarrowVT, LHS.getOperand(i), RHS.getOperand(i)));
            }
            return self.DAG.getNode(CONCAT_VECTORS, DL, VT, ArrayRef<SDValue> { ConcatOps });
        }
    }
    if scalarizeBinOpOfSplats(N, self.DAG, DL, self.LegalTypes) {
        V;
    } else {
        return V;
    }
    return SDValue {};
}

fn DAGCombiner::SimplifySelect(self, DL: *SDLoc, N0: SDValue, N1: SDValue, N2: SDValue) -> SDValue {
    assert!(N0.getOpcode() == SETCC, "First argument must be a SetCC node!");
    let mut SCC: SDValue = self.SimplifySelectCC(DL, N0.getOperand(0), N0.getOperand(1), N1, N2, cast(N0.getOperand(2)).get(), false);
    if SCC.getNode() {
        if SCC.getOpcode() == SELECT_CC {
            let mut Flags: SDNodeFlags = operator(N0).getFlags();
            let mut SETCC: SDValue = self.DAG.getNode(SETCC, SDLoc { N0 }, N0.getValueType(), SCC.getOperand(0), SCC.getOperand(1), SCC.getOperand(4), Flags);
            self.AddToWorklist(SETCC.getNode(), true, false);
            return self.DAG.getSelect(SDLoc { SCC }, SCC.getValueType(), SETCC, SCC.getOperand(2), SCC.getOperand(3), Flags);
        }
        return SCC;
    }
    return SDValue {};
}

fn DAGCombiner::SimplifySelectOps(self, TheSelect: *mut SDNode, LHS: SDValue, RHS: SDValue) -> bool {
    if isConstOrConstSplatFP(LHS, false) {
        NaN;
    } else {
        if NaN.isNaN() && RHS.getOpcode() == FSQRT {
            let mut Sqrt: SDValue = RHS;
            let mut CC: CondCode = zeroed();
            let mut CmpLHS: SDValue = SDValue {};
            let mut Zero: *ConstantFPSDNode = null;
            if TheSelect.getOpcode() == SELECT_CC {
                CC = cast(TheSelect.getOperand(4)).get();
                CmpLHS = TheSelect.getOperand(0);
                Zero = isConstOrConstSplatFP(TheSelect.getOperand(1), false);
            } else {
                let mut Cmp: SDValue = TheSelect.getOperand(0);
                if Cmp.getOpcode() == SETCC {
                    CC = cast(Cmp.getOperand(2)).get();
                    CmpLHS = Cmp.getOperand(0);
                    Zero = isConstOrConstSplatFP(Cmp.getOperand(1), false);
                }
            }
            if Zero && Zero.isZero() && Sqrt.getOperand(0) == CmpLHS && (CC == SETOLT || CC == SETULT || CC == SETLT) {
                self.CombineTo(TheSelect, Sqrt, true);
                return true;
            }
        }
    }
    if TheSelect.getOperand(0).getValueType().isVector() {
        return false;
    }
    if LHS.getOpcode() != RHS.getOpcode() || !LHS.hasOneUse() || !RHS.hasOneUse() {
        return false;
    }
    if LHS.getOpcode() == LOAD {
        let mut LLD: *mut LoadSDNode = cast(LHS);
        let mut RLD: *mut LoadSDNode = cast(RHS);
        if LHS.getOperand(0) != RHS.getOperand(0) || !LLD.isSimple() || !RLD.isSimple() || LLD.isIndexed() || RLD.isIndexed() || LLD.getMemoryVT() != RLD.getMemoryVT() || (LLD.getExtensionType() != RLD.getExtensionType() && LLD.getExtensionType() != EXTLOAD && RLD.getExtensionType() != EXTLOAD) || LLD.getPointerInfo().getAddrSpace() != RLD.getPointerInfo().getAddrSpace() || LLD.getBasePtr().getOpcode() == TargetFrameIndex || RLD.getBasePtr().getOpcode() == TargetFrameIndex || !self.TLI.isOperationLegalOrCustom(TheSelect.getOpcode(), LLD.getBasePtr().getValueType(), false) {
            return false;
        }
        if LLD.isPredecessorOf(RLD) || RLD.isPredecessorOf(LLD) {
            return false;
        }
        let mut Visited: SmallPtrSet<const SDNode *, 32> = SmallPtrSet<const SDNode *, 32> {};
        let mut Worklist: SmallVector<const SDNode *, 16> = SmallVector<const SDNode *, 16> {};
        Visited.insert(TheSelect);
        Worklist.push(LLD);
        Worklist.push(RLD);
        if hasPredecessorHelper(LLD, Visited, Worklist, 0, false) || hasPredecessorHelper(RLD, Visited, Worklist, 0, false) {
            return false;
        }
        let mut Addr: SDValue = SDValue {};
        if TheSelect.getOpcode() == SELECT {
            let mut CondNode: *mut SDNode = TheSelect.getOperand(0).getNode();
            Worklist.push(CondNode);
            if (LLD.hasAnyUseOfValue(1) && hasPredecessorHelper(LLD, Visited, Worklist, 0, false)) || (RLD.hasAnyUseOfValue(1) && hasPredecessorHelper(RLD, Visited, Worklist, 0, false)) {
                return false;
            }
            Addr = self.DAG.getSelect(SDLoc { TheSelect }, LLD.getBasePtr().getValueType(), self.DAG.getFreeze(TheSelect.getOperand(0)), LLD.getBasePtr(), RLD.getBasePtr(), SDNodeFlags { Flags: None });
        } else {
            let mut CondLHS: *mut SDNode = TheSelect.getOperand(0).getNode();
            let mut CondRHS: *mut SDNode = TheSelect.getOperand(1).getNode();
            Worklist.push(CondLHS);
            Worklist.push(CondRHS);
            if (LLD.hasAnyUseOfValue(1) && hasPredecessorHelper(LLD, Visited, Worklist, 0, false)) || (RLD.hasAnyUseOfValue(1) && hasPredecessorHelper(RLD, Visited, Worklist, 0, false)) {
                return false;
            }
            let mut FrozenOp0: SDValue = self.DAG.getFreeze(TheSelect.getOperand(0));
            let mut FrozenOp1: SDValue = self.DAG.getFreeze(TheSelect.getOperand(1));
            Addr = self.DAG.getNode(SELECT_CC, SDLoc { TheSelect }, LLD.getBasePtr().getValueType(), FrozenOp0, FrozenOp1, LLD.getBasePtr(), RLD.getBasePtr(), TheSelect.getOperand(4));
        }
        let mut Load: SDValue = SDValue {};
        let mut Alignment: Align = if LLD.getAlign() < RLD.getAlign() { LLD.getAlign() } else { RLD.getAlign() };
        let mut AddrSpace: u32 = LLD.getAddressSpace();
        assert!(AddrSpace == RLD.getAddressSpace());
        let mut MMOFlags: Flags = LLD.getMemOperand().getFlags();
        if !RLD.isInvariant() {
            operator(MMOFlags, operator(MOInvariant));
        }
        if !RLD.isDereferenceable() {
            operator(MMOFlags, operator(MODereferenceable));
        }
        if LLD.getExtensionType() == NON_EXTLOAD {
            Load = self.DAG.getLoad(TheSelect.getValueType(0), SDLoc { TheSelect }, LLD.getChain(), Addr, MachinePointerInfo { AddrSpace, 0 }, MaybeAlign { Alignment }, MMOFlags, MMOMetadata {});
        } else {
            Load = self.DAG.getExtLoad(if LLD.getExtensionType() == EXTLOAD { RLD.getExtensionType() } else { LLD.getExtensionType() }, SDLoc { TheSelect }, TheSelect.getValueType(0), LLD.getChain(), Addr, MachinePointerInfo { AddrSpace, 0 }, LLD.getMemoryVT(), MaybeAlign { Alignment }, MMOFlags, MMOMetadata {});
        }
        self.CombineTo(TheSelect, Load, true);
        self.CombineTo(LHS.getNode(), Load.getValue(0), Load.getValue(1), true);
        self.CombineTo(RHS.getNode(), Load.getValue(0), Load.getValue(1), true);
        return true;
    }
    return false;
}

fn DAGCombiner::foldSelectCCToShiftAnd(self, DL: *SDLoc, N0: SDValue, N1: SDValue, N2: SDValue, N3: SDValue, CC: CondCode) -> SDValue {
    let mut XType: EVT = N0.getValueType();
    let mut AType: EVT = N2.getValueType();
    if !isNullConstant(N3) || !XType.bitsGE(AType) {
        return SDValue {};
    }
    if CC == SETGT && self.TLI.hasAndNot(N2) {
        if !(isAllOnesConstant(N1) || (isNullConstant(N1) && N0 == N2)) {
            return SDValue {};
        }
    } else if CC == SETLT {
        if !(isNullConstant(N1) || (isOneConstant(N1) && N0 == N2)) {
            return SDValue {};
        }
    } else {
        return SDValue {};
    }
    let mut N2C: *mut ConstantSDNode = dyn_cast(N2.getNode());
    if N2C && ((N2C.getAPIntValue() & (N2C.getAPIntValue() - 1)) == 0) {
        let mut ShCt: u32 = XType.getSizeInBits().operator unsigned long long() - N2C.getAPIntValue().logBase2() - 1;
        if !self.TLI.shouldAvoidTransformToShift(XType, ShCt) {
            let mut ShiftAmt: SDValue = self.DAG.getShiftAmountConstant(ShCt, XType, DL);
            let mut Shift: SDValue = self.DAG.getNode(SRL, DL, XType, N0, ShiftAmt);
            self.AddToWorklist(Shift.getNode(), true, false);
            if XType.bitsGT(AType) {
                Shift = self.DAG.getNode(TRUNCATE, DL, AType, Shift);
                self.AddToWorklist(Shift.getNode(), true, false);
            }
            if CC == SETGT {
                Shift = self.DAG.getNOT(DL, Shift, AType);
            }
            return self.DAG.getNode(AND, DL, AType, Shift, N2);
        }
    }
    let mut ShCt: u32 = XType.getSizeInBits().operator unsigned long long() - 1;
    if self.TLI.shouldAvoidTransformToShift(XType, ShCt) {
        return SDValue {};
    }
    let mut ShiftAmt: SDValue = self.DAG.getShiftAmountConstant(ShCt, XType, DL);
    let mut Shift: SDValue = self.DAG.getNode(SRA, DL, XType, N0, ShiftAmt);
    self.AddToWorklist(Shift.getNode(), true, false);
    if XType.bitsGT(AType) {
        Shift = self.DAG.getNode(TRUNCATE, DL, AType, Shift);
        self.AddToWorklist(Shift.getNode(), true, false);
    }
    if CC == SETGT {
        Shift = self.DAG.getNOT(DL, Shift, AType);
    }
    return self.DAG.getNode(AND, DL, AType, Shift, N2);
}

fn DAGCombiner::foldSelectOfBinops(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut N1: SDValue = N.getOperand(1);
    let mut N2: SDValue = N.getOperand(2);
    let mut DL: SDLoc = SDLoc { N };
    let mut BinOpc: u32 = N1.getOpcode();
    if !self.TLI.isBinOp(BinOpc) || (N2.getOpcode() != BinOpc) || (N1.getResNo() != N2.getResNo()) {
        return SDValue {};
    }
    if !operator(N1).hasOneUse() || !operator(N2).hasOneUse() {
        return SDValue {};
    }
    let mut OpVTs: SDVTList = operator(N1).getVTList();
    if N1.getOperand(1) == N2.getOperand(1) {
        let mut N10: SDValue = N1.getOperand(0);
        let mut N20: SDValue = N2.getOperand(0);
        let mut NewSel: SDValue = self.DAG.getSelect(DL, N10.getValueType(), N0, N10, N20, SDNodeFlags { Flags: None });
        let mut Flags: SDNodeFlags = operator(N1).getFlags() & operator(N2).getFlags();
        let mut NewBinOp: SDValue = self.DAG.getNode(BinOpc, DL, OpVTs, ArrayRef<SDValue> { [NewSel, N1.getOperand(1)] }, Flags);
        return SDValue { Node: NewBinOp.getNode(), ResNo: N1.getResNo() };
    }
    if N1.getOperand(0) == N2.getOperand(0) {
        let mut N11: SDValue = N1.getOperand(1);
        let mut N21: SDValue = N2.getOperand(1);
        if N11.getValueType() == N21.getValueType() {
            let mut NewSel: SDValue = self.DAG.getSelect(DL, N11.getValueType(), N0, N11, N21, SDNodeFlags { Flags: None });
            let mut Flags: SDNodeFlags = operator(N1).getFlags() & operator(N2).getFlags();
            let mut NewBinOp: SDValue = self.DAG.getNode(BinOpc, DL, OpVTs, ArrayRef<SDValue> { [N1.getOperand(0), NewSel] }, Flags);
            return SDValue { Node: NewBinOp.getNode(), ResNo: N1.getResNo() };
        }
    }
    return SDValue {};
}

fn DAGCombiner::foldSignChangeInBitcast(self, N: *mut SDNode) -> SDValue {
    let mut N0: SDValue = N.getOperand(0);
    let mut VT: EVT = N.getValueType(0);
    let mut IsFabs: bool = N.getOpcode() == FABS;
    let mut IsFree: bool = if IsFabs { self.TLI.isFAbsFree(VT) } else { self.TLI.isFNegFree(VT) };
    if IsFree || N0.getOpcode() != BITCAST || !N0.hasOneUse() {
        return SDValue {};
    }
    let mut Int: SDValue = N0.getOperand(0);
    let mut IntVT: EVT = Int.getValueType();
    if !IntVT.isInteger() || IntVT.isVector() {
        return SDValue {};
    }
    let mut SignMask: APInt = APInt {};
    if N0.getValueType().isVector() {
        SignMask = getSignMask(N0.getScalarValueSizeInBits());
        if IsFabs {
            SignMask = operator(SignMask);
        }
        SignMask = getSplat(IntVT.getSizeInBits().operator unsigned long long(), SignMask);
    } else {
        SignMask = getSignMask(IntVT.getSizeInBits().operator unsigned long long());
        if IsFabs {
            SignMask = operator(SignMask);
        }
    }
    let mut DL: SDLoc = SDLoc { N0 };
    Int = self.DAG.getNode(if IsFabs { AND } else { XOR }, DL, IntVT, Int, self.DAG.getConstant(SignMask, DL, IntVT, false, false));
    self.AddToWorklist(Int.getNode(), true, false);
    return self.DAG.getBitcast(VT, Int);
}

fn DAGCombiner::convertSelectOfFPConstantsToLoadOffset(self, DL: *SDLoc, N0: SDValue, N1: SDValue, N2: SDValue, N3: SDValue, CC: CondCode) -> SDValue {
    if !self.TLI.reduceSelectOfFPConstantLoads(N0.getValueType()) {
        return SDValue {};
    }
    let mut TV: *mut ConstantFPSDNode = dyn_cast(N2);
    let mut FV: *mut ConstantFPSDNode = dyn_cast(N3);
    let mut VT: EVT = N2.getValueType();
    if !TV || !FV || !self.TLI.isTypeLegal(VT) {
        return SDValue {};
    }
    if self.TLI.getOperationAction(ConstantFP, VT) == Legal || self.TLI.isFPImmLegal(TV.getValueAPF(), TV.getValueType(0), self.ForCodeSize) || self.TLI.isFPImmLegal(FV.getValueAPF(), FV.getValueType(0), self.ForCodeSize) {
        return SDValue {};
    }
    if !TV.hasOneUse() && !FV.hasOneUse() {
        return SDValue {};
    }
    let mut Elts: [2]*mut Constant = [FV.getConstantFPValue(), TV.getConstantFPValue()];
    let mut FPTy: *mut Type = Elts[0].getType();
    let mut TD: *DataLayout = self.DAG.getDataLayout();
    let mut CA: *mut Constant = get(get(FPTy, 2), ArrayRef<Constant *> { Elts });
    let mut CPIdx: SDValue = self.DAG.getConstantPool(CA, EVT { self.TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, MaybeAlign { TD.getPrefTypeAlign(FPTy) }, 0, false, 0);
    let mut Alignment: Align = cast(CPIdx).getAlign();
    let mut Zero: SDValue = self.DAG.getIntPtrConstant(0, DL, false);
    let mut EltSize: u32 = TD.getTypeAllocSize(Elts[0].getType()).operator unsigned long long() as u32;
    let mut One: SDValue = self.DAG.getIntPtrConstant(EltSize, SDLoc { FV }, false);
    let mut Cond: SDValue = self.DAG.getSetCC(DL, self.getSetCCResultType(N0.getValueType()), N0, N1, CC, SDValue {}, false, SDNodeFlags { Flags: None });
    self.AddToWorklist(Cond.getNode(), true, false);
    let mut CstOffset: SDValue = self.DAG.getSelect(DL, Zero.getValueType(), Cond, One, Zero, SDNodeFlags { Flags: None });
    self.AddToWorklist(CstOffset.getNode(), true, false);
    CPIdx = self.DAG.getNode(ADD, DL, CPIdx.getValueType(), CPIdx, CstOffset);
    self.AddToWorklist(CPIdx.getNode(), true, false);
    return self.DAG.getLoad(TV.getValueType(0), DL, self.DAG.getEntryNode(), CPIdx, getConstantPool(self.DAG.getMachineFunction()), MaybeAlign { Alignment }, MONone, MMOMetadata {});
}

fn DAGCombiner::SimplifySelectCC(self, DL: *SDLoc, N0: SDValue, N1: SDValue, N2: SDValue, N3: SDValue, CC: CondCode, NotExtCompare: bool) -> SDValue {
    if N2 == N3 {
        return N2;
    }
    let mut CmpOpVT: EVT = N0.getValueType();
    let mut CmpResVT: EVT = self.getSetCCResultType(CmpOpVT);
    let mut VT: EVT = N2.getValueType();
    let mut N1C: *mut ConstantSDNode = dyn_cast(N1.getNode());
    let mut N2C: *mut ConstantSDNode = dyn_cast(N2.getNode());
    let mut N3C: *mut ConstantSDNode = dyn_cast(N3.getNode());
    if self.DAG.FoldSetCC(CmpResVT, N0, N1, CC, DL, SDNodeFlags { Flags: None }) {
        SCC;
    } else {
        self.AddToWorklist(SCC.getNode(), true, false);
        if dyn_cast(SCC) {
            SCCC;
        } else {
            return if !(SCCC.isZero()) { N2 } else { N3 };
        }
    }
    if self.convertSelectOfFPConstantsToLoadOffset(DL, N0, N1, N2, N3, CC) {
        V;
    } else {
        return V;
    }
    if self.foldSelectCCToShiftAnd(DL, N0, N1, N2, N3, CC) {
        V;
    } else {
        return V;
    }
    if CC == SETEQ && operator(N0).getOpcode() == AND && operator(N0).getValueType(0) == VT && isNullConstant(N1) && isNullConstant(N2) {
        let mut AndLHS: SDValue = operator(N0).getOperand(0);
        let mut ConstAndRHS: *mut ConstantSDNode = dyn_cast(operator(N0).getOperand(1));
        if ConstAndRHS && ConstAndRHS.getAPIntValue().isPowerOf2() {
            let mut AndMask: *APInt = ConstAndRHS.getAPIntValue();
            if self.TLI.shouldFoldSelectWithSingleBitTest(VT, AndMask) {
                let mut ShCt: u32 = AndMask.getBitWidth() - 1;
                let mut ShlAmt: SDValue = self.DAG.getShiftAmountConstant(AndMask.countl_zero(), VT, SDLoc { AndLHS });
                let mut Shl: SDValue = self.DAG.getNode(SHL, SDLoc { N0 }, VT, AndLHS, ShlAmt);
                let mut ShrAmt: SDValue = self.DAG.getShiftAmountConstant(ShCt, VT, SDLoc { Shl });
                let mut Shr: SDValue = self.DAG.getNode(SRA, SDLoc { N0 }, VT, Shl, ShrAmt);
                return self.DAG.getNode(AND, DL, VT, Shr, N3);
            }
        }
    }
    let mut Fold: bool = N2C && isNullConstant(N3) && N2C.getAPIntValue().isPowerOf2();
    let mut Swap: bool = N3C && isNullConstant(N2) && N3C.getAPIntValue().isPowerOf2();
    if (Fold || Swap) && self.TLI.getBooleanContents(CmpOpVT) == ZeroOrOneBooleanContent && (!self.LegalOperations || self.TLI.isOperationLegal(SETCC, CmpOpVT)) && self.TLI.convertSelectOfConstantsToMath(VT) {
        if Swap {
            CC = getSetCCInverse(CC, CmpOpVT);
            swap(N2C, N3C);
        }
        if NotExtCompare && N2C.isOne() {
            return SDValue {};
        }
        let mut Temp: SDValue = SDValue {};
        let mut SCC: SDValue = SDValue {};
        if self.LegalTypes {
            SCC = self.DAG.getSetCC(DL, CmpResVT, N0, N1, CC, SDValue {}, false, SDNodeFlags { Flags: None });
            Temp = self.DAG.getZExtOrTrunc(SCC, SDLoc { N2 }, VT);
        } else {
            SCC = self.DAG.getSetCC(SDLoc { N0 }, EVT { i1 }, N0, N1, CC, SDValue {}, false, SDNodeFlags { Flags: None });
            Temp = self.DAG.getNode(ZERO_EXTEND, SDLoc { N2 }, VT, SCC);
        }
        self.AddToWorklist(SCC.getNode(), true, false);
        self.AddToWorklist(Temp.getNode(), true, false);
        if N2C.isOne() {
            return Temp;
        }
        let mut ShCt: u32 = N2C.getAPIntValue().logBase2();
        if self.TLI.shouldAvoidTransformToShift(VT, ShCt) {
            return SDValue {};
        }
        return self.DAG.getNode(SHL, DL, N2.getValueType(), Temp, self.DAG.getShiftAmountConstant(ShCt, N2.getValueType(), SDLoc { Temp }));
    }
    if N1C && N1C.isZero() && (CC == SETEQ || CC == SETNE) {
        let mut ValueOnZero: SDValue = N2;
        let mut Count: SDValue = N3;
        if CC == SETNE {
            swap(ValueOnZero, Count);
        }
        if dyn_cast(ValueOnZero) {
            ValueOnZeroC;
        } else {
            if ValueOnZeroC.getAPIntValue() == VT.getSizeInBits().operator unsigned long long() {
                if (Count.getOpcode() == CTTZ || Count.getOpcode() == CTTZ_ZERO_POISON) && N0 == Count.getOperand(0) && (!self.LegalOperations || self.TLI.isOperationLegal(CTTZ, VT)) {
                    return self.DAG.getNode(CTTZ, DL, VT, N0);
                }
                if (Count.getOpcode() == CTLZ || Count.getOpcode() == CTLZ_ZERO_POISON) && N0 == Count.getOperand(0) && (!self.LegalOperations || self.TLI.isOperationLegal(CTLZ, VT)) {
                    return self.DAG.getNode(CTLZ, DL, VT, N0);
                }
            }
        }
    }
    if !NotExtCompare && N1C && N2C && N3C && N2C.getAPIntValue() == operator(N3C.getAPIntValue()) && ((N1C.isAllOnes() && CC == SETGT) || (N1C.isZero() && CC == SETLT)) && !self.TLI.shouldAvoidTransformToShift(VT, CmpOpVT.getScalarSizeInBits() - 1) {
        let mut ASHR: SDValue = self.DAG.getNode(SRA, DL, CmpOpVT, N0, self.DAG.getShiftAmountConstant(CmpOpVT.getScalarSizeInBits() - 1, CmpOpVT, DL));
        return self.DAG.getNode(XOR, DL, VT, self.DAG.getSExtOrTrunc(ASHR, DL, VT), self.DAG.getSExtOrTrunc(if CC == SETLT { N3 } else { N2 }, DL, VT));
    }
    if CC == SETGT && N1C && N2C && N3C && N1C.isAllOnes() && N2C.isOne() && N3C.isAllOnes() && !self.TLI.shouldAvoidTransformToShift(CmpOpVT, CmpOpVT.getScalarSizeInBits() - 1) {
        let mut ASHR: SDValue = self.DAG.getNode(SRA, DL, CmpOpVT, N0, self.DAG.getShiftAmountConstant(CmpOpVT.getScalarSizeInBits() - 1, CmpOpVT, DL));
        return self.DAG.getNode(OR, DL, VT, self.DAG.getSExtOrTrunc(ASHR, DL, VT), self.DAG.getConstant(1, DL, VT, false, false));
    }
    if PerformMinMaxFpToSatCombine(N0, N1, N2, N3, CC, self.DAG) {
        S;
    } else {
        return S;
    }
    if PerformUMinFpToSatCombine(N0, N1, N2, N3, CC, self.DAG) {
        S;
    } else {
        return S;
    }
    if self.foldSelectToABD(N0, N1, N2, N3, CC, DL) {
        ABD;
    } else {
        return ABD;
    }
    return SDValue {};
}

fn matchMergedBFX(Root: SDValue, DAG: *mut SelectionDAG, TLI: *TargetLowering) -> SDValue {
    let mut VT: EVT = Root.getValueType();
    if !VT.isScalarInteger() || Root.getOpcode() != AND {
        return SDValue {};
    }
    let mut N0: SDValue = Root.getOperand(0);
    let mut N1: SDValue = Root.getOperand(1);
    if N0.getOpcode() != OR || !isa(N1) {
        return SDValue {};
    }
    let mut RootMask: APInt = cast(N1).getAsAPIntVal();
    let mut Src: SDValue = SDValue {};
    let mut IsSrc: Closure_126 = Closure_126 { Src: &mut Src };
    let mut Worklist: SmallVector<SDValue> = SmallVector<SDValue> { [N0] };
    let mut PartsMask: APInt = APInt { VT.getSizeInBits().operator unsigned long long(), 0, false, false };
    while !Worklist.is_empty() {
        let mut V: SDValue = Worklist.pop_back_val();
        if !V.hasOneUse() && (Src && Src != V) {
            return SDValue {};
        }
        if V.getOpcode() == OR {
            Worklist.push(ValueParamT { V.getOperand(0) });
            Worklist.push(ValueParamT { V.getOperand(1) });
            continue;
        }
        if V.getOpcode() == SRL {
            let mut ShiftSrc: SDValue = V.getOperand(0);
            let mut ShiftAmt: SDValue = V.getOperand(1);
            if !IsSrc.call(ShiftSrc) || !isa(ShiftAmt) {
                return SDValue {};
            }
            let mut ShiftAmtVal: u64 = cast(ShiftAmt).getAsZExtVal();
            if ShiftAmtVal > RootMask.getBitWidth() {
                return SDValue {};
            }
            operator(PartsMask, (RootMask << ShiftAmtVal));
            continue;
        }
        if IsSrc.call(V) {
            operator(PartsMask, RootMask);
            continue;
        }
        return SDValue {};
    }
    if !Src {
        return SDValue {};
    }
    let mut DL: SDLoc = SDLoc { Root };
    return DAG.getNode(AND, DL, VT, ArrayRef<SDValue> { [Src, DAG.getConstant(PartsMask, DL, VT, false, false)] });
}

fn DAGCombiner::SimplifySetCC(self, VT: EVT, N0: SDValue, N1: SDValue, Cond: CondCode, DL: *SDLoc, foldBooleans: bool) -> SDValue {
    let mut DagCombineInfo: DAGCombinerInfo = DAGCombinerInfo { self.DAG, self.Level, false, self };
    if self.TLI.SimplifySetCC(VT, N0, N1, Cond, foldBooleans, DagCombineInfo, DL) {
        C;
    } else {
        return C;
    }
    if isIntEqualitySetCC(Cond) && N0.getOpcode() == AND && isNullConstant(N1) {
        if matchMergedBFX(N0, self.DAG, self.TLI) {
            Res;
        } else {
            return self.DAG.getSetCC(DL, VT, Res, N1, Cond, SDValue {}, false, SDNodeFlags { Flags: None });
        }
    }
    return SDValue {};
}

fn DAGCombiner::BuildSDIV(self, N: *mut SDNode) -> SDValue {
    if self.DAG.getMachineFunction().getFunction().hasMinSize() {
        return SDValue {};
    }
    let mut Built: SmallVector<SDNode *, 8> = SmallVector<SDNode *, 8> {};
    if self.TLI.BuildSDIV(N, self.DAG, self.LegalOperations, self.LegalTypes, Built) {
        S;
    } else {
        for N in Built {
            self.AddToWorklist(N, true, false);
        }
        return S;
    }
    return SDValue {};
}

fn DAGCombiner::BuildSDIVPow2(self, N: *mut SDNode) -> SDValue {
    let mut C: *mut ConstantSDNode = isConstOrConstSplat(N.getOperand(1), false, false);
    if !C {
        return SDValue {};
    }
    if C.isZero() {
        return SDValue {};
    }
    let mut Built: SmallVector<SDNode *, 8> = SmallVector<SDNode *, 8> {};
    if self.TLI.BuildSDIVPow2(N, C.getAPIntValue(), self.DAG, Built) {
        S;
    } else {
        for N in Built {
            self.AddToWorklist(N, true, false);
        }
        return S;
    }
    return SDValue {};
}

fn DAGCombiner::BuildUDIV(self, N: *mut SDNode) -> SDValue {
    if self.DAG.getMachineFunction().getFunction().hasMinSize() {
        return SDValue {};
    }
    let mut Built: SmallVector<SDNode *, 8> = SmallVector<SDNode *, 8> {};
    if self.TLI.BuildUDIV(N, self.DAG, self.LegalOperations, self.LegalTypes, Built) {
        S;
    } else {
        for N in Built {
            self.AddToWorklist(N, true, false);
        }
        return S;
    }
    return SDValue {};
}

fn DAGCombiner::BuildSREMPow2(self, N: *mut SDNode) -> SDValue {
    let mut C: *mut ConstantSDNode = isConstOrConstSplat(N.getOperand(1), false, false);
    if !C {
        return SDValue {};
    }
    if C.isZero() {
        return SDValue {};
    }
    let mut Built: SmallVector<SDNode *, 8> = SmallVector<SDNode *, 8> {};
    if self.TLI.BuildSREMPow2(N, C.getAPIntValue(), self.DAG, Built) {
        S;
    } else {
        for N in Built {
            self.AddToWorklist(N, true, false);
        }
        return S;
    }
    return SDValue {};
}

fn takeInexpensiveLog2(DAG: *mut SelectionDAG, DL: *SDLoc, VT: EVT, Op: SDValue, Depth: u32, AssumeNonZero: bool) -> SDValue {
    assert!(VT.isInteger(), "Only integer types are supported!");
    let mut PeekThroughCastsAndTrunc: Closure_127 = Closure_127 {};
    if VT.isScalableVector() {
        return SDValue {};
    }
    Op = PeekThroughCastsAndTrunc.call(Op);
    let mut Pow2Constants: SmallVector<APInt> = SmallVector<APInt> {};
    let mut IsPowerOfTwo: Closure_128 = Closure_128 { Pow2Constants: &mut Pow2Constants };
    if matchUnaryPredicate(Op, function<bool (ConstantSDNode *)> { IsPowerOfTwo }, false, true) {
        if !VT.isVector() {
            return DAG.getConstant(Pow2Constants.back().logBase2(), DL, VT, false, false);
        }
        if Op.getOpcode() == SPLAT_VECTOR {
            return DAG.getSplat(VT, DL, DAG.getConstant(Pow2Constants.back().logBase2(), DL, VT.getScalarType(), false, false));
        }
        let mut Log2Ops: SmallVector<SDValue> = SmallVector<SDValue> {};
        for Pow2 in Pow2Constants {
            Log2Ops.emplace_back(DAG.getConstant(Pow2.logBase2(), DL, VT.getScalarType(), false, false));
        }
        return DAG.getBuildVector(VT, DL, ArrayRef<SDValue> { Log2Ops });
    }
    if Depth >= DAG.MaxRecursionDepth {
        return SDValue {};
    }
    let mut CastToVT: Closure_129 = Closure_129 { DAG: &mut DAG, DL: &mut DL };
    if Op.getOpcode() == SHL {
        if AssumeNonZero || operator(Op).getFlags().hasNoUnsignedWrap() || operator(Op).getFlags().hasNoSignedWrap() || isOneConstant(Op.getOperand(0)) {
            if takeInexpensiveLog2(DAG, DL, VT, Op.getOperand(0), Depth + 1, AssumeNonZero) {
                LogX;
            } else {
                return DAG.getNode(ADD, DL, VT, LogX, CastToVT.call(VT, Op.getOperand(1)));
            }
        }
    }
    let mut Cond: SDValue = SDValue {};
    let mut TVal: SDValue = SDValue {};
    let mut FVal: SDValue = SDValue {};
    if sd_match(Op, m_OneUse(m_SelectLike(m_Value(Cond), m_Value(TVal), m_Value(FVal)))) {
        if takeInexpensiveLog2(DAG, DL, VT, TVal, Depth + 1, AssumeNonZero) {
            LogX;
        } else if takeInexpensiveLog2(DAG, DL, VT, FVal, Depth + 1, AssumeNonZero) {
            LogY;
        } else {
            return DAG.getSelect(DL, VT, Cond, LogX, LogY, SDNodeFlags { Flags: None });
        }
    }
    if (Op.getOpcode() == UMIN || Op.getOpcode() == UMAX) && Op.hasOneUse() {
        if takeInexpensiveLog2(DAG, DL, VT, Op.getOperand(0), Depth + 1, false) {
            LogX;
        } else if takeInexpensiveLog2(DAG, DL, VT, Op.getOperand(1), Depth + 1, false) {
            LogY;
        } else {
            return DAG.getNode(Op.getOpcode(), DL, VT, LogX, LogY);
        }
    }
    return SDValue {};
}

fn DAGCombiner::BuildLogBase2(self, V: SDValue, DL: *SDLoc, KnownNonZero: bool, InexpensiveOnly: bool, OutVT: optional<EVT>) -> SDValue {
    let mut VT: EVT = if OutVT { operator(OutVT) } else { V.getValueType() };
    let mut InexpensiveLogBase2: SDValue = takeInexpensiveLog2(self.DAG, DL, VT, V, 0, KnownNonZero);
    if InexpensiveLogBase2 || InexpensiveOnly || !self.DAG.isKnownToBeAPowerOfTwo(V, false, 0) {
        return InexpensiveLogBase2;
    }
    let mut Ctlz: SDValue = self.DAG.getNode(CTLZ, DL, VT, V);
    let mut Base: SDValue = self.DAG.getConstant(VT.getScalarSizeInBits() - 1, DL, VT, false, false);
    let mut LogBase2: SDValue = self.DAG.getNode(SUB, DL, VT, Base, Ctlz);
    return LogBase2;
}

fn DAGCombiner::BuildDivEstimate(self, N: SDValue, Op: SDValue, Flags: SDNodeFlags) -> SDValue {
    if self.LegalDAG {
        return SDValue {};
    }
    let mut VT: EVT = Op.getValueType();
    if VT.getScalarType() != EVT { f16 } && VT.getScalarType() != EVT { f32 } && VT.getScalarType() != EVT { f64 } {
        return SDValue {};
    }
    let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
    let mut Enabled: i32 = self.TLI.getRecipEstimateDivEnabled(VT, MF);
    if Enabled == self.TLI.Disabled {
        return SDValue {};
    }
    let mut Iterations: i32 = self.TLI.getDivRefinementSteps(VT, MF);
    if self.TLI.getRecipEstimate(Op, self.DAG, Enabled, Iterations) {
        Est;
    } else {
        self.AddToWorklist(Est.getNode(), true, false);
        let mut DL: SDLoc = SDLoc { Op };
        if Iterations {
            let mut FPOne: SDValue = self.DAG.getConstantFP(1.0, DL, VT, false);
            for let mut i: i32 = 0; i < Iterations; i += 1 {
                let mut MulEst: SDValue = Est;
                if i == Iterations - 1 {
                    MulEst = self.DAG.getNode(FMUL, DL, VT, N, Est, Flags);
                    self.AddToWorklist(MulEst.getNode(), true, false);
                }
                let mut NewEst: SDValue = self.DAG.getNode(FMUL, DL, VT, Op, MulEst, Flags);
                self.AddToWorklist(NewEst.getNode(), true, false);
                NewEst = self.DAG.getNode(FSUB, DL, VT, (if i == Iterations - 1 { N } else { FPOne }), NewEst, Flags);
                self.AddToWorklist(NewEst.getNode(), true, false);
                NewEst = self.DAG.getNode(FMUL, DL, VT, Est, NewEst, Flags);
                self.AddToWorklist(NewEst.getNode(), true, false);
                Est = self.DAG.getNode(FADD, DL, VT, MulEst, NewEst, Flags);
                self.AddToWorklist(Est.getNode(), true, false);
            }
        } else {
            Est = self.DAG.getNode(FMUL, DL, VT, Est, N, Flags);
            self.AddToWorklist(Est.getNode(), true, false);
        }
        return Est;
    }
    return SDValue {};
}

fn DAGCombiner::buildSqrtNROneConst(self, Arg: SDValue, Est: SDValue, Iterations: u32, Reciprocal: bool) -> SDValue {
    let mut VT: EVT = Arg.getValueType();
    let mut DL: SDLoc = SDLoc { Arg };
    let mut ThreeHalves: SDValue = self.DAG.getConstantFP(1.5, DL, VT, false);
    let mut HalfArg: SDValue = self.DAG.getNode(FMUL, DL, VT, ThreeHalves, Arg);
    HalfArg = self.DAG.getNode(FSUB, DL, VT, HalfArg, Arg);
    for let mut i: u32 = 0; i < Iterations; i += 1 {
        let mut NewEst: SDValue = self.DAG.getNode(FMUL, DL, VT, Est, Est);
        NewEst = self.DAG.getNode(FMUL, DL, VT, HalfArg, NewEst);
        NewEst = self.DAG.getNode(FSUB, DL, VT, ThreeHalves, NewEst);
        Est = self.DAG.getNode(FMUL, DL, VT, Est, NewEst);
    }
    if !Reciprocal {
        Est = self.DAG.getNode(FMUL, DL, VT, Est, Arg);
    }
    return Est;
}

fn DAGCombiner::buildSqrtNRTwoConst(self, Arg: SDValue, Est: SDValue, Iterations: u32, Reciprocal: bool) -> SDValue {
    let mut VT: EVT = Arg.getValueType();
    let mut DL: SDLoc = SDLoc { Arg };
    let mut MinusThree: SDValue = self.DAG.getConstantFP(-3.0, DL, VT, false);
    let mut MinusHalf: SDValue = self.DAG.getConstantFP(-0.5, DL, VT, false);
    assert!(Iterations > 0);
    for let mut i: u32 = 0; i < Iterations; i += 1 {
        let mut AE: SDValue = self.DAG.getNode(FMUL, DL, VT, Arg, Est);
        let mut AEE: SDValue = self.DAG.getNode(FMUL, DL, VT, AE, Est);
        let mut RHS: SDValue = self.DAG.getNode(FADD, DL, VT, AEE, MinusThree);
        let mut LHS: SDValue = SDValue {};
        if Reciprocal || (i + 1) < Iterations {
            LHS = self.DAG.getNode(FMUL, DL, VT, Est, MinusHalf);
        } else {
            LHS = self.DAG.getNode(FMUL, DL, VT, AE, MinusHalf);
        }
        Est = self.DAG.getNode(FMUL, DL, VT, LHS, RHS);
    }
    return Est;
}

fn DAGCombiner::buildSqrtEstimateImpl(self, Op: SDValue, Reciprocal: bool, Flags: SDNodeFlags) -> SDValue {
    if self.LegalDAG {
        return SDValue {};
    }
    let mut VT: EVT = Op.getValueType();
    if VT.getScalarType() != EVT { f16 } && VT.getScalarType() != EVT { f32 } && VT.getScalarType() != EVT { f64 } {
        return SDValue {};
    }
    let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
    let mut Enabled: i32 = self.TLI.getRecipEstimateSqrtEnabled(VT, MF);
    if Enabled == self.TLI.Disabled {
        return SDValue {};
    }
    let mut Iterations: i32 = self.TLI.getSqrtRefinementSteps(VT, MF);
    let mut UseOneConstNR: bool = false;
    if self.TLI.getSqrtEstimate(Op, self.DAG, Enabled, Iterations, UseOneConstNR, Reciprocal) {
        Est;
    } else {
        self.AddToWorklist(Est.getNode(), true, false);
        if Iterations > 0 {
            Est = if UseOneConstNR { self.buildSqrtNROneConst(Op, Est, Iterations, Reciprocal) } else { self.buildSqrtNRTwoConst(Op, Est, Iterations, Reciprocal) };
        }
        if !Reciprocal {
            let mut DL: SDLoc = SDLoc { Op };
            let mut Test: SDValue = self.TLI.getSqrtInputTest(Op, self.DAG, self.DAG.getDenormalMode(VT), Flags);
            Est = self.DAG.getSelect(DL, VT, Test, self.TLI.getSqrtResultForDenormInput(Op, self.DAG), Est, SDNodeFlags { Flags: None });
        }
        return Est;
    }
    return SDValue {};
}

fn DAGCombiner::buildRsqrtEstimate(self, Op: SDValue, Flags: SDNodeFlags) -> SDValue {
    return self.buildSqrtEstimateImpl(Op, true, Flags);
}

fn DAGCombiner::buildSqrtEstimate(self, Op: SDValue, Flags: SDNodeFlags) -> SDValue {
    return self.buildSqrtEstimateImpl(Op, false, Flags);
}

fn DAGCombiner::mayAlias(self: *DAGCombiner, Op0: *mut SDNode, Op1: *mut SDNode) -> bool {
    let mut getCharacteristics: Closure_130 = Closure_130 { cap_0: self };
    let mut MUC0: MemUseCharacteristics = getCharacteristics.call(Op0);
    let mut MUC1: MemUseCharacteristics = getCharacteristics.call(Op1);
    if MUC0.BasePtr.getNode() && MUC0.BasePtr == MUC1.BasePtr && MUC0.Offset == MUC1.Offset {
        return true;
    }
    if MUC0.IsVolatile && MUC1.IsVolatile {
        return true;
    }
    if MUC0.IsAtomic && MUC1.IsAtomic {
        return true;
    }
    if MUC0.MMO && MUC1.MMO {
        if (MUC0.MMO.isInvariant() && MUC1.MMO.isStore()) || (MUC1.MMO.isInvariant() && MUC0.MMO.isStore()) {
            return false;
        }
    }
    if (MUC0.NumBytes.hasValue() && MUC0.NumBytes.isScalable() && MUC0.Offset != 0) || (MUC1.NumBytes.hasValue() && MUC1.NumBytes.isScalable() && MUC1.Offset != 0) {
        return true;
    }
    let mut IsAlias: bool = false;
    if computeAliasing(Op0, MUC0.NumBytes, Op1, MUC1.NumBytes, self.DAG, IsAlias) {
        return IsAlias;
    }
    if !MUC0.MMO || !MUC1.MMO {
        return true;
    }
    if (MUC0.MMO.isInvariant() && MUC1.MMO.isStore()) || (MUC1.MMO.isInvariant() && MUC0.MMO.isStore()) {
        return false;
    }
    let mut SrcValOffset0: i64 = MUC0.MMO.getOffset();
    let mut SrcValOffset1: i64 = MUC1.MMO.getOffset();
    let mut OrigAlignment0: Align = MUC0.MMO.getBaseAlign();
    let mut OrigAlignment1: Align = MUC1.MMO.getBaseAlign();
    let mut Size0: LocationSize = MUC0.NumBytes;
    let mut Size1: LocationSize = MUC1.NumBytes;
    if OrigAlignment0 == OrigAlignment1 && SrcValOffset0 != SrcValOffset1 && Size0.hasValue() && Size1.hasValue() && !Size0.isScalable() && !Size1.isScalable() && Size0 == Size1 && OrigAlignment0 > Size0.getValue().getKnownMinValue() && SrcValOffset0 % Size0.getValue().getKnownMinValue() == 0 && SrcValOffset1 % Size1.getValue().getKnownMinValue() == 0 {
        let mut OffAlign0: i64 = SrcValOffset0 % OrigAlignment0.value();
        let mut OffAlign1: i64 = SrcValOffset1 % OrigAlignment1.value();
        if (OffAlign0 + Size0.getValue().getKnownMinValue() as i64) <= OffAlign1 || (OffAlign1 + Size1.getValue().getKnownMinValue() as i64) <= OffAlign0 {
            return false;
        }
    }
    let mut UseAA: bool = if CombinerGlobalAA.getNumOccurrences() > 0 { CombinerGlobalAA } else { self.DAG.getSubtarget().useAA() };
    if CombinerAAOnlyFunc.getNumOccurrences() && CombinerAAOnlyFunc != self.DAG.getMachineFunction().getName() {
        UseAA = false;
    }
    if UseAA && self.BatchAA && MUC0.MMO.getValue() && MUC1.MMO.getValue() && Size0.hasValue() && Size1.hasValue() && (!Size0.isScalable() || SrcValOffset0 == 0) && (!Size1.isScalable() || SrcValOffset1 == 0) {
        let mut MinOffset: i64 = if SrcValOffset0 < SrcValOffset1 { SrcValOffset0 } else { SrcValOffset1 };
        let mut Overlap0: i64 = Size0.getValue().getKnownMinValue() + SrcValOffset0 - MinOffset;
        let mut Overlap1: i64 = Size1.getValue().getKnownMinValue() + SrcValOffset1 - MinOffset;
        let mut Loc0: LocationSize = if Size0.isScalable() { Size0 } else { precise(Overlap0) };
        let mut Loc1: LocationSize = if Size1.isScalable() { Size1 } else { precise(Overlap1) };
        if self.BatchAA.isNoAlias(MemoryLocation { Ptr: MUC0.MMO.getValue(), Size: Loc0, AATags: if UseTBAA { MUC0.MMO.getAAInfo() } else { AAMDNodes {} } }, MemoryLocation { Ptr: MUC1.MMO.getValue(), Size: Loc1, AATags: if UseTBAA { MUC1.MMO.getAAInfo() } else { AAMDNodes {} } }) {
            return false;
        }
    }
    return true;
}

fn DAGCombiner::GatherAllAliases(self, N: *mut SDNode, OriginalChain: SDValue, Aliases: *mut SmallVectorImpl<SDValue>) {
    let mut Chains: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut Visited: SmallPtrSet<SDNode *, 16> = SmallPtrSet<SDNode *, 16> {};
    let mut IsLoad: bool = isa(N) && cast(N).isSimple();
    Chains.push(ValueParamT { OriginalChain });
    let mut Depth: u32 = 0;
    let mut ImproveChain: Closure_131 = Closure_131 { IsLoad: &mut IsLoad, cap_1: self, N: &mut N };
    while !Chains.is_empty() {
        let mut Chain: SDValue = Chains.pop_back_val();
        if !Visited.insert(Chain.getNode()).second {
            continue;
        }
        if Depth > self.TLI.getGatherAllAliasesMaxDepth() {
            Aliases.clear();
            Aliases.push(ValueParamT { OriginalChain });
            return;
        }
        if Chain.getOpcode() == TokenFactor {
            if Chain.getNumOperands() > 16 {
                Aliases.push(ValueParamT { Chain });
                continue;
            }
            for let mut n: u32 = Chain.getNumOperands(); n;  {
                Chains.push(ValueParamT { Chain.getOperand(n -= 1) });
            }
            Depth += 1;
            continue;
        }
        if ImproveChain.call(Chain) {
            if Chain.getNode() {
                Chains.push(ValueParamT { Chain });
            }
            Depth += 1;
            continue;
        }
        Aliases.push(ValueParamT { Chain });
    }
}

fn DAGCombiner::FindBetterChain(self, N: *mut SDNode, OldChain: SDValue) -> SDValue {
    if self.OptLevel == None {
        return OldChain;
    }
    let mut Aliases: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    self.GatherAllAliases(N, OldChain, Aliases);
    if Aliases.len == 0 {
        return self.DAG.getEntryNode();
    }
    if Aliases.len == 1 {
        return Aliases[0];
    }
    return self.DAG.getTokenFactor(SDLoc { N }, Aliases);
}

fn DAGCombiner::parallelizeChainedStores(self, St: *mut StoreSDNode) -> bool {
    let mut ChainedStores: SmallVector<StoreSDNode *, 8> = SmallVector<StoreSDNode *, 8> {};
    let mut STChain: *mut StoreSDNode = St;
    let mut A: Allocator = Allocator {};
    let mut Intervals: IMap = IMap { A };
    let mut BasePtr: BaseIndexOffset = match(St, self.DAG);
    if !BasePtr.getBase().getNode() {
        return false;
    }
    if BasePtr.getBase().isUndef() {
        return false;
    }
    if St.getMemoryVT().isZeroSized() {
        return false;
    }
    if St.getMemoryVT().isScalableVT() {
        return false;
    }
    Intervals.insert(0, (St.getMemoryVT().getSizeInBits().operator unsigned long long() + 7) / 8, monostate {});
    while dyn_cast(STChain.getChain()) {
        Chain;
    }
    if ChainedStores.len == 0 {
        return false;
    }
    let mut NewChain: SDValue = STChain.getChain();
    let mut TFOps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    for let mut I: u32 = ChainedStores.len; I;  {
        let mut S: *mut StoreSDNode = ChainedStores[I -= 1];
        let mut BetterChain: SDValue = self.FindBetterChain(S, NewChain);
        S = cast(self.DAG.UpdateNodeOperands(S, BetterChain, S.getOperand(1), S.getOperand(2), S.getOperand(3)));
        TFOps.push(SDValue { Node: S, ResNo: 0 });
        ChainedStores[I] = S;
    }
    let mut BetterChain: SDValue = self.FindBetterChain(St, NewChain);
    let mut NewST: SDValue = SDValue {};
    if St.isTruncatingStore() {
        NewST = self.DAG.getTruncStore(BetterChain, SDLoc { St }, St.getValue(), St.getBasePtr(), St.getMemoryVT(), St.getMemOperand());
    } else {
        NewST = self.DAG.getStore(BetterChain, SDLoc { St }, St.getValue(), St.getBasePtr(), St.getMemOperand());
    }
    TFOps.push(ValueParamT { NewST });
    let mut hasImprovedChain: Closure_132 = Closure_132 { NewChain: &mut NewChain };
    let mut AddNewChain: bool = all_of(TFOps, hasImprovedChain);
    if AddNewChain {
        TFOps.insert(TFOps.begin(), NewChain);
    }
    let mut TF: SDValue = self.DAG.getTokenFactor(SDLoc { STChain }, TFOps);
    self.CombineTo(St, TF, true);
    self.AddToWorklist(TF.getNode(), true, false);
    for Op in operator(TF).ops() {
        self.AddToWorklist(Op.getNode(), true, false);
    }
    self.AddToWorklist(STChain, true, false);
    return true;
}

fn DAGCombiner::findBetterNeighborChains(self, St: *mut StoreSDNode) -> bool {
    if self.OptLevel == None {
        return false;
    }
    let mut BasePtr: BaseIndexOffset = match(St, self.DAG);
    if !BasePtr.getBase().getNode() {
        return false;
    }
    if BasePtr.getBase().isUndef() {
        return false;
    }
    if self.parallelizeChainedStores(St) {
        return true;
    }
    let mut BetterChain: SDValue = self.FindBetterChain(St, St.getChain());
    if St.getChain() != BetterChain {
        self.replaceStoreChain(St, BetterChain);
        return true;
    }
    return false;
}

fn SelectionDAG::Combine(self, Level: CombineLevel, BatchAA: *mut BatchAAResults, OptLevel: CodeGenOptLevel) {
    DAGCombiner { *self, BatchAA, OptLevel }.Run(Level);
}

struct Closure_1 {
    N: *mut *mut SDNode,
    ScalableOffset: *mut i64,
    cap_2: *mut DAGCombiner,
}

unsafe fn Closure_1::call(self: *mut Closure_1, Node: *mut SDNode) -> bool {
            let mut LoadStore: *mut MemSDNode = dyn_cast(Node);
            if LoadStore && LoadStore.hasUniqueMemOperand() && LoadStore.getBasePtr().getNode() == (*self.N) {
                let mut AM: AddrMode = AddrMode {};
                AM.HasBaseReg = true;
                (*self.ScalableOffset) = (*self.ScalableOffset);
                let mut VT: EVT = LoadStore.getMemoryVT();
                let mut AS: u32 = LoadStore.getAddressSpace();
                let mut AccessTy: *mut Type = VT.getTypeForEVT(*self.DAG.getContext());
                return self.TLI.isLegalAddressingMode(self.DAG.getDataLayout(), AM, AccessTy, AS, null);
            }
            return false;
        }

struct Closure_2 {
    RedOpc: *mut u32,
    Opc: *mut u32,
    cap_2: *mut DAGCombiner,
    VT: *mut EVT,
    Flags: *mut SDNodeFlags,
    DL: *mut SDLoc,
}

unsafe fn Closure_2::call(self: *mut Closure_2, Red0: SDValue, Chain: SDValue) -> auto {
        let mut X: SDValue = SDValue {};
        let mut Y: SDValue = SDValue {};
        let mut Z: SDValue = SDValue {};
        let mut RedY: SDValue = SDValue {};
        if !sd_match(Red0, m_OneUse(m_UnaryOp((*self.RedOpc), m_Value(X)))) || !sd_match(Chain, m_OneUse(m_c_BinOp((*self.Opc), m_Value(RedY, m_OneUse(m_UnaryOp((*self.RedOpc), m_Value(Y)))), m_Value(Z, m_Unless(m_UnaryOp((*self.RedOpc), m_Value()))), SDNodeFlags { Flags: None }))) || X.getValueType() != Y.getValueType() || !self.hasOperation((*self.Opc), X.getValueType()) || !self.TLI.shouldReassociateReduction((*self.RedOpc), (*self.VT)) {
            return SDValue {};
        }
        if ((*self.Opc) == FADD || (*self.Opc) == FMUL) && (!operator(Chain).getFlags().hasAllowReassociation() || !operator(Red0).getFlags().hasAllowReassociation() || !operator(RedY).getFlags().hasAllowReassociation()) {
            return SDValue {};
        }
        let mut FlagsInserter: FlagInserter = FlagInserter { self.DAG, (*self.Flags) & operator(Chain).getFlags() & operator(Red0).getFlags() & operator(RedY).getFlags() };
        let mut Op: SDValue = self.DAG.getNode((*self.Opc), (*self.DL), X.getValueType(), X, Y);
        let mut Red: SDValue = self.DAG.getNode((*self.RedOpc), (*self.DL), (*self.VT), Op);
        return self.DAG.getNode((*self.Opc), (*self.DL), (*self.VT), Red, Z);
    }

struct Closure_3 {
    SeenOps: *mut SmallPtrSet<SDNode *, 16>,
    Changed: *mut bool,
    DidPruneOps: *mut bool,
    Ops: *mut SmallVector<SDValue, 8>,
    Worklist: *mut pair<SDNode *, unsigned int>, 8>,
    OpWorkCount: *mut SmallVector<unsigned int, 8>,
    NumLeftToConsider: *mut u32,
    SeenChains: *mut SmallPtrSet<SDNode *, 16>,
}

unsafe fn Closure_3::call(self: *mut Closure_3, CurIdx: u32, Op: *mut SDNode, OpNumber: u32) {
        if (*self.SeenOps).contains(Op) {
            (*self.Changed) = true;
            (*self.DidPruneOps) = true;
            let mut OrigOpNumber: u32 = 0;
            while OrigOpNumber < (*self.Ops).len && (*self.Ops)[OrigOpNumber].getNode() != Op {
                OrigOpNumber += 1;
            }
            assert!((OrigOpNumber != (*self.Ops).len), "expected to find TokenFactor Operand");
            for let mut i: u32 = CurIdx + 1; i < (*self.Worklist).len; i += 1 {
                if (*self.Worklist)[i].second == OrigOpNumber {
                    (*self.Worklist)[i].second = OpNumber;
                }
            }
            (*self.OpWorkCount)[OpNumber] += (*self.OpWorkCount)[OrigOpNumber];
            (*self.OpWorkCount)[OrigOpNumber] = 0;
            (*self.NumLeftToConsider) -= 1;
        }
        if (*self.SeenChains).insert(Op).second {
            (*self.OpWorkCount)[OpNumber] += 1;
            (*self.Worklist).push(make_pair(Op, OpNumber));
        }
    }

struct Closure_4 {
    N: *mut *mut SDNode,
    cap_1: *mut DAGCombiner,
}

unsafe fn Closure_4::call(self: *mut Closure_4, User: *mut SDNode) -> bool {
            return canFoldInAddressingMode((*self.N), User, self.DAG, self.TLI);
        }

struct Closure_5 {
    cap_0: *mut DAGCombiner,
    DL: *mut SDLoc,
    VT: *mut EVT,
}

unsafe fn Closure_5::call(self: *mut Closure_5, N0: SDValue, N1: SDValue) -> SDValue {
            if self.DAG.isADDLike(N0, false) && N0.hasOneUse() && isConstantOrConstantVector(N0.getOperand(1), true, false) {
                let mut TyActn: LegalizeTypeAction = self.TLI.getTypeAction(*self.DAG.getContext(), N0.getValueType());
                let mut NoAddCarry: bool = TyActn == TypeLegal || TyActn == TypePromoteInteger || isMinSignedConstant(N0.getOperand(1));
                if NoAddCarry {
                    return self.DAG.getNode(ADD, (*self.DL), (*self.VT), self.DAG.getNode(ADD, (*self.DL), (*self.VT), N1, N0.getOperand(0)), N0.getOperand(1));
                }
            }
            return SDValue {};
        }

struct Closure_6 {}

fn Closure_6::call(self: *Closure_6, Max: *mut ConstantSDNode, Op: *mut ConstantSDNode) -> bool {
            return (!Max && !Op) || (Max && Op && Max.getAPIntValue() == (operator(Op.getAPIntValue())));
        }

struct Closure_7 {
    N: *mut *mut SDNode,
    DAG: *mut SelectionDAG,
    Carry0: *mut SDValue,
    Z: *mut SDValue,
    Combiner: *mut DAGCombiner,
    X: *mut SDValue,
}

unsafe fn Closure_7::call(self: *mut Closure_7, A: SDValue, B: SDValue) -> SDValue {
        let mut DL: SDLoc = SDLoc { (*self.N) };
        let mut NewY: SDValue = (*self.DAG).getNode(UADDO_CARRY, DL, operator((*self.Carry0)).getVTList(), A, B, (*self.Z));
        (*self.Combiner).AddToWorklist(NewY.getNode(), true, false);
        return (*self.DAG).getNode(UADDO_CARRY, DL, (*self.N).getVTList(), (*self.X), (*self.DAG).getConstant(0, DL, (*self.X).getValueType(), false, false), NewY.getValue(1));
    }

struct Closure_8 {
    Sub0: *mut SDValue,
}

unsafe fn Closure_8::call(self: *mut Closure_8, DivRem: SDValue, MaybeY: SDValue) -> auto {
        if (DivRem.getOpcode() == SDIVREM || DivRem.getOpcode() == UDIVREM) && DivRem.getResNo() == 0 && DivRem.getOperand(0) == (*self.Sub0) && DivRem.getOperand(1) == MaybeY {
            return SDValue { Node: DivRem.getNode(), ResNo: 1 };
        }
        return SDValue {};
    }

struct Closure_9 {
    ClearMask: *mut SmallBitVector,
}

unsafe fn Closure_9::call(self: *mut Closure_9, V: *mut ConstantSDNode) -> bool {
            if !V || V.isZero() {
                (*self.ClearMask).push(true);
                return true;
            }
            (*self.ClearMask).push(false);
            return V.isOne();
        }

struct Closure_10 {}

fn Closure_10::call(self: *Closure_10, C: *mut ConstantSDNode) -> bool {
        if C.isZero() || C.isOpaque() {
            return false;
        }
        if C.getAPIntValue().isPowerOf2() {
            return true;
        }
        if C.getAPIntValue().isNegatedPowerOf2() {
            return true;
        }
        return false;
    }

struct Closure_11 {
    Opcode: *mut u32,
    Bits: *mut u64,
}

unsafe fn Closure_11::call(self: *mut Closure_11) {
                if !C {
                    return true;
                }
                let mut YConst: *APInt = C();
                return if ((*self.Opcode) == ABDS) { YConst.isSignedIntN((*self.Bits)) } else { YConst.isIntN((*self.Bits)) };
            }

struct Closure_12 {}

fn Closure_12::call(self: *Closure_12, N0: SDValue, N1: SDValue, N2: SDValue, N3: SDValue, CC: CondCode) -> i32 {
        if N0 != N2 && (N2.getOpcode() != TRUNCATE || N0 != N2.getOperand(0)) {
            return 0;
        }
        let mut N1C: *mut ConstantSDNode = isConstOrConstSplat(peekThroughTruncates(N1), false, false);
        let mut N3C: *mut ConstantSDNode = isConstOrConstSplat(peekThroughTruncates(N3), false, false);
        if !N1C || !N3C {
            return 0;
        }
        let mut C1: *APInt = N1C.getAPIntValue().trunc(N1.getScalarValueSizeInBits());
        let mut C2: *APInt = N3C.getAPIntValue().trunc(N3.getScalarValueSizeInBits());
        if C1.getBitWidth() < C2.getBitWidth() || C1 != C2.sext(C1.getBitWidth()) {
            return 0;
        }
        return if CC == SETLT { SMIN } else { (if CC == SETGT { SMAX } else { 0 }) };
    }

struct Closure_13 {
    cap_0: *mut DAGCombiner,
}

fn Closure_13::call(self: *Closure_13, A: SDValue, B: SDValue) -> bool {
            if A.isUndef() || B.isUndef() {
                return true;
            }
            let mut KA: KnownBits = self.DAG.computeKnownBits(A, 0);
            if !KA.isNonNegative() && !KA.isNegative() {
                return false;
            }
            let mut KB: KnownBits = self.DAG.computeKnownBits(B, 0);
            if KA.isNonNegative() {
                return KB.isNonNegative();
            }
            return KB.isNegative();
        }

struct Closure_14 {}

fn Closure_14::call(self: *Closure_14, Opcode: u32) -> NodeType {
        match Opcode {
            SMIN => {
                return VECREDUCE_SMIN;
            },
            SMAX => {
                return VECREDUCE_SMAX;
            },
            UMIN => {
                return VECREDUCE_UMIN;
            },
            UMAX => {
                return VECREDUCE_UMAX;
            },
            _ => {
                llvm_unreachable_internal("Unexpected opcode", "llvm\\lib\\CodeGen\\SelectionDAG\\DAGCombiner.cpp", 6545);
            },
        }
    }

struct Closure_15 {}

fn Closure_15::call(self: *Closure_15, C0: *mut ConstantSDNode, C1: *mut ConstantSDNode) -> bool {
                let mut CMax: *APInt = umax(C0.getAPIntValue(), C1.getAPIntValue());
                let mut CMin: *APInt = umin(C0.getAPIntValue(), C1.getAPIntValue());
                return !C0.isOpaque() && !C1.isOpaque() && (CMax - CMin).isPowerOf2();
            }

struct Closure_16 {
    OuterShift: *mut u32,
    InnerShift: *mut u32,
    Y: *mut SDValue,
}

unsafe fn Closure_16::call(self: *mut Closure_16, M: SDValue) -> auto {
        if !M.hasOneUse() {
            return false;
        }
        (*self.OuterShift) = operator(M).getOpcode();
        if (*self.OuterShift) == SHL {
            (*self.InnerShift) = SRL;
        } else if (*self.OuterShift) == SRL {
            (*self.InnerShift) = SHL;
        } else {
            return false;
        }
        if !isAllOnesConstant(operator(M).getOperand(0)) {
            return false;
        }
        (*self.Y) = operator(M).getOperand(1);
        return true;
    }

struct Closure_17 {}

fn Closure_17::call(self: *Closure_17, LHS: *mut ConstantSDNode, RHS: *mut ConstantSDNode) -> bool {
        return RHS.getAPIntValue().isSubsetOf(LHS.getAPIntValue());
    }

struct Closure_18 {}

fn Closure_18::call(self: *Closure_18, LHS: SDValue, RHS: SDValue) -> bool {
        if operator(LHS).getOpcode() != SIGN_EXTEND {
            return false;
        }
        let mut C: *mut ConstantSDNode = isConstOrConstSplat(RHS, false, true);
        if !C {
            return false;
        }
        if !C.getAPIntValue().isMask(LHS.getOperand(0).getValueType().getScalarSizeInBits()) {
            return false;
        }
        return true;
    }

struct Closure_19 {}

fn Closure_19::call(self: *Closure_19, V: SDValue) -> SDValue {
        if operator(V).getOpcode() == ZERO_EXTEND || operator(V).getOpcode() == TRUNCATE {
            return operator(V).getOperand(0);
        }
        return V;
    }

struct Closure_20 {}

fn Closure_20::call(self: *Closure_20, V: SDValue) -> SDValue {
        if operator(V).getOpcode() == ZERO_EXTEND {
            return operator(V).getOperand(0);
        }
        return V;
    }

struct Closure_21 {}

fn Closure_21::call(self: *Closure_21, C1: *mut ConstantSDNode, C2: *mut ConstantSDNode) -> bool {
        return !C1 || !C2 || C1.getAPIntValue().intersects(C2.getAPIntValue());
    }

struct Closure_22 {
    IsMulOrDiv: *mut bool,
    ExtractFrom: *mut SDValue,
    Opcode: *mut u32,
}

unsafe fn Closure_22::call(self: *mut Closure_22, NeededShift: u32, MulOrDivVariant: u32) -> bool {
        (*self.IsMulOrDiv) = (*self.ExtractFrom).getOpcode() == MulOrDivVariant;
        if !(*self.IsMulOrDiv) && (*self.ExtractFrom).getOpcode() != NeededShift {
            return false;
        }
        (*self.Opcode) = NeededShift;
        return true;
    }

struct Closure_23 {
    EltSizeInBits: u32,
}

fn Closure_23::call(self: *Closure_23, LHS: *mut ConstantSDNode, RHS: *mut ConstantSDNode) -> bool {
        return (LHS.getAPIntValue() + RHS.getAPIntValue()) == self.EltSizeInBits;
    }

struct Closure_24 {
    LHSMask: *mut SDValue,
    RHSMask: *mut SDValue,
    cap_2: *mut DAGCombiner,
    DL: *mut SDLoc,
    VT: *mut EVT,
    RHSShiftAmt: *mut SDValue,
    LHSShiftAmt: *mut SDValue,
}

unsafe fn Closure_24::call(self: *mut Closure_24, Res: SDValue) -> SDValue {
        if (*self.LHSMask).getNode() || (*self.RHSMask).getNode() {
            let mut AllOnes: SDValue = self.DAG.getAllOnesConstant((*self.DL), (*self.VT), false, false);
            let mut Mask: SDValue = AllOnes;
            if (*self.LHSMask).getNode() {
                let mut RHSBits: SDValue = self.DAG.getNode(SRL, (*self.DL), (*self.VT), AllOnes, (*self.RHSShiftAmt));
                Mask = self.DAG.getNode(AND, (*self.DL), (*self.VT), Mask, self.DAG.getNode(OR, (*self.DL), (*self.VT), (*self.LHSMask), RHSBits));
            }
            if (*self.RHSMask).getNode() {
                let mut LHSBits: SDValue = self.DAG.getNode(SHL, (*self.DL), (*self.VT), AllOnes, (*self.LHSShiftAmt));
                Mask = self.DAG.getNode(AND, (*self.DL), (*self.VT), Mask, self.DAG.getNode(OR, (*self.DL), (*self.VT), (*self.RHSMask), LHSBits));
            }
            Res = self.DAG.getNode(AND, (*self.DL), (*self.VT), Res, Mask);
        }
        return Res;
    }

struct Closure_25 {
    X: *mut SDValue,
    Y: *mut SDValue,
}

unsafe fn Closure_25::call(self: *mut Closure_25, Or: SDValue, CommonOp: SDValue) -> bool {
                if !Or.hasOneUse() || Or.getOpcode() != OR {
                    return false;
                }
                if CommonOp == Or.getOperand(0) {
                    (*self.X) = CommonOp;
                    (*self.Y) = Or.getOperand(1);
                    return true;
                }
                if CommonOp == Or.getOperand(1) {
                    (*self.X) = CommonOp;
                    (*self.Y) = Or.getOperand(0);
                    return true;
                }
                return false;
            }

struct Closure_26 {
    NumStores: *mut u32,
    OffsetMap: *mut SmallVector<int64_t, 8>,
    NarrowNumBits: *mut u32,
    FirstOffset: *mut i64,
}

unsafe fn Closure_26::call(self: *mut Closure_26, MatchLittleEndian: bool) -> bool {
        if MatchLittleEndian {
            for let mut i: u32 = 0; i != (*self.NumStores); i += 1 {
                if (*self.OffsetMap)[i] != i * ((*self.NarrowNumBits) / 8) + (*self.FirstOffset) {
                    return false;
                }
            }
        } else {
            for let mut i: u32 = 0;
let mut j: u32 = (*self.NumStores) - 1; i != (*self.NumStores); i += 1 , j -= 1 {
                if (*self.OffsetMap)[j] != i * ((*self.NarrowNumBits) / 8) + (*self.FirstOffset) {
                    return false;
                }
            }
        }
        return true;
    }

struct Closure_27 {
    IsBigEndianTarget: *mut bool,
}

unsafe fn Closure_27::call(self: *mut Closure_27, P: SDByteProvider) -> u32 {
        assert!(P.hasSrc(), "Must be a memory byte provider");
        let mut Load: *mut LoadSDNode = cast(P.Src.value());
        let mut LoadBitWidth: u32 = Load.getMemoryVT().getScalarSizeInBits();
        assert!(LoadBitWidth % 8 == 0, "can only analyze providers for individual bytes not bit");
        let mut LoadByteWidth: u32 = LoadBitWidth / 8;
        return if (*self.IsBigEndianTarget) { bigEndianByteAt(LoadByteWidth, P.DestOffset) } else { littleEndianByteAt(LoadByteWidth, P.DestOffset) };
    }

struct Closure_28 {
    X: *mut SDValue,
    Y: *mut SDValue,
    M: *mut SDValue,
}

unsafe fn Closure_28::call(self: *mut Closure_28, And: SDValue, XorIdx: u32, Other: SDValue) -> bool {
        if And.getOpcode() != AND || !And.hasOneUse() {
            return false;
        }
        let mut Xor: SDValue = And.getOperand(XorIdx);
        if Xor.getOpcode() != XOR || !Xor.hasOneUse() {
            return false;
        }
        let mut Xor0: SDValue = Xor.getOperand(0);
        let mut Xor1: SDValue = Xor.getOperand(1);
        if isAllOnesOrAllOnesSplat(Xor1, false) {
            return false;
        }
        if Other == Xor0 {
            swap(Xor0, Xor1);
        }
        if Other != Xor1 {
            return false;
        }
        (*self.X) = Xor0;
        (*self.Y) = Xor1;
        (*self.M) = And.getOperand(if XorIdx { 0 } else { 1 });
        return true;
    }

struct Closure_29 {
    ShiftOpcode: *mut u32,
    C1Val: *mut APInt,
}

unsafe fn Closure_29::call(self: *mut Closure_29, V: SDValue, ShiftOp: *mut SDValue, ShiftAmtVal: **mut APInt) -> bool {
        if V.getOpcode() != (*self.ShiftOpcode) || !V.hasOneUse() {
            return false;
        }
        let mut ShiftCNode: *mut ConstantSDNode = isConstOrConstSplat(V.getOperand(1), false, false);
        if !ShiftCNode {
            return false;
        }
        ShiftOp = V.getOperand(0);
        ShiftAmtVal = &mut ShiftCNode.getAPIntValue();
        if ShiftAmtVal.getBitWidth() != (*self.C1Val).getBitWidth() {
            return false;
        }
        let mut Overflow: bool = false;
        let mut NewShiftAmt: APInt = (*self.C1Val).uadd_ov(*ShiftAmtVal, Overflow);
        if Overflow {
            return false;
        }
        if NewShiftAmt.uge(V.getScalarValueSizeInBits()) {
            return false;
        }
        return true;
    }

struct Closure_30 {
    Bitsize: u32,
    OutOfRange: *mut bool,
}

unsafe fn Closure_30::call(self: *mut Closure_30, C: *mut ConstantSDNode) -> bool {
        (*self.OutOfRange) |= C.getAPIntValue().uge(self.Bitsize);
        return true;
    }

struct Closure_31 {
    OpSizeInBits: u32,
}

fn Closure_31::call(self: *Closure_31, LHS: *mut ConstantSDNode, RHS: *mut ConstantSDNode) -> bool {
            let mut c1: APInt = LHS.getAPIntValue();
            let mut c2: APInt = RHS.getAPIntValue();
            zeroExtendToMatch(c1, c2, 1);
            return (c1 + c2).uge(self.OpSizeInBits);
        }

struct Closure_32 {
    OpSizeInBits: u32,
}

fn Closure_32::call(self: *Closure_32, LHS: *mut ConstantSDNode, RHS: *mut ConstantSDNode) -> bool {
            let mut c1: APInt = LHS.getAPIntValue();
            let mut c2: APInt = RHS.getAPIntValue();
            zeroExtendToMatch(c1, c2, 1);
            return (c1 + c2).ult(self.OpSizeInBits);
        }

struct Closure_33 {
    OpSizeInBits: u32,
    InnerBitwidth: u64,
}

fn Closure_33::call(self: *Closure_33, LHS: *mut ConstantSDNode, RHS: *mut ConstantSDNode) -> bool {
            let mut c1: APInt = LHS.getAPIntValue();
            let mut c2: APInt = RHS.getAPIntValue();
            zeroExtendToMatch(c1, c2, 1);
            return c2.uge(self.OpSizeInBits - self.InnerBitwidth) && (c1 + c2).uge(self.OpSizeInBits);
        }

struct Closure_34 {
    OpSizeInBits: u32,
    InnerBitwidth: u64,
}

fn Closure_34::call(self: *Closure_34, LHS: *mut ConstantSDNode, RHS: *mut ConstantSDNode) -> bool {
            let mut c1: APInt = LHS.getAPIntValue();
            let mut c2: APInt = RHS.getAPIntValue();
            zeroExtendToMatch(c1, c2, 1);
            return c2.uge(self.OpSizeInBits - self.InnerBitwidth) && (c1 + c2).ult(self.OpSizeInBits);
        }

struct Closure_35 {
    cap_0: EVT,
}

fn Closure_35::call(self: *Closure_35, LHS: *mut ConstantSDNode, RHS: *mut ConstantSDNode) -> bool {
            let mut c1: APInt = LHS.getAPIntValue();
            let mut c2: APInt = RHS.getAPIntValue();
            zeroExtendToMatch(c1, c2, 0);
            return c1.ult(VT.getScalarSizeInBits()) && (c1 == c2);
        }

struct Closure_36 {
    OpSizeInBits: u32,
}

fn Closure_36::call(self: *Closure_36, LHS: *mut ConstantSDNode, RHS: *mut ConstantSDNode) -> bool {
            let mut LHSC: *APInt = LHS.getAPIntValue();
            let mut RHSC: *APInt = RHS.getAPIntValue();
            return LHSC.ult(self.OpSizeInBits) && RHSC.ult(self.OpSizeInBits) && LHSC.getZExtValue() <= RHSC.getZExtValue();
        }

struct Closure_37 {
    NarrowVTSize: u32,
}

fn Closure_37::call(self: *Closure_37, U: *mut SDNode) -> bool {
        if U.getOpcode() != SRL && U.getOpcode() != SRA {
            return true;
        }
        let mut UShiftAmtSrc: *mut ConstantSDNode = isConstOrConstSplat(U.getOperand(1), false, false);
        if !UShiftAmtSrc {
            return true;
        }
        let mut UShiftAmt: u32 = UShiftAmtSrc.getZExtValue();
        return UShiftAmt < self.NarrowVTSize;
    }

struct Closure_38 {
    OpSizeInBits: *mut u32,
    ShiftValues: *mut SmallVector<SDValue, 16>,
    cap_2: *mut DAGCombiner,
    DL: *mut SDLoc,
    ShiftSVT: *mut EVT,
}

unsafe fn Closure_38::call(self: *mut Closure_38, LHS: *mut ConstantSDNode, RHS: *mut ConstantSDNode) -> bool {
            let mut c1: APInt = LHS.getAPIntValue();
            let mut c2: APInt = RHS.getAPIntValue();
            zeroExtendToMatch(c1, c2, 1);
            let mut Sum: APInt = c1 + c2;
            let mut ShiftSum: u32 = if Sum.uge((*self.OpSizeInBits)) { ((*self.OpSizeInBits) - 1) } else { Sum.getZExtValue() };
            (*self.ShiftValues).push(self.DAG.getConstant(ShiftSum, (*self.DL), (*self.ShiftSVT), false, false));
            return true;
        }

