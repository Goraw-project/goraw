        let mut AffectedArgs: SmallVector<unsigned int, 2> = SmallVector<unsigned int, 2> {};
        for let mut I: u32 = 0;
let mut E: u32 = Locs.len; I != E; I += 1 {
            let mut Op: *mut SDDbgOperand = Locs[I];
