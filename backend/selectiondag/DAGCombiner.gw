        let mut NewDV: *mut SDDbgValue = (*self.DAG).getDbgValueList(Dbg.getVariable(), NewExpr, ArrayRef<SDDbgOperand> { Locs }, Dbg.getAdditionalDependencies(), Dbg.isIndirect(), Dbg.getDebugLoc(), Dbg.getOrder(), Dbg.isVariadic());
        Dbg.setIsInvalidated();
        Dbg.setIsEmitted();
        (*self.DAG).AddDbgValue(NewDV, false);
    }

