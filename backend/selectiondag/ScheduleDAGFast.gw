fn ScheduleDAGLinearize::ScheduleNode(self, N: *mut SDNode) {
    if N.getNodeId() != 0 {
        llvm_unreachable_internal(null, "llvm\\lib\\CodeGen\\SelectionDAG\\ScheduleDAGFast.cpp", 640);
    }
    if !N.isMachineOpcode() && (N.getOpcode() == EntryToken || isPassiveNode(N)) {
        return;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
            dbgs() << "\n*** Scheduling: ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
            N.dump(self.DAG);
        }
    }
        if !(false) { break; }
    }
    self.Sequence.push(N);
    let mut NumOps: u32 = N.getNumOperands();
    if NumOps {
        NumLeft;
    } else {
        let mut GluedOpN: *mut SDNode = null;
        while true {
            {
            let mut Op: *SDValue = N.getOperand(NumLeft - 1);
            let mut OpN: *mut SDNode = Op.getNode();
            if NumLeft == NumOps && Op.getValueType() == EVT { Glue } {
                GluedOpN = OpN;
                assert!(OpN.getNodeId() != 0, "Glue operand not ready?");
                OpN.setNodeId(0);
                self.ScheduleNode(OpN);
                continue;
            }
            if OpN == GluedOpN {
                continue;
            }
            let mut DI: iterator = self.GluedMap.find(OpN);
            if DI != self.GluedMap.end() && operator(DI).second != N {
                OpN = operator(DI).second;
            }
            let mut Degree: u32 = OpN.getNodeId();
            assert!(Degree > 0, "Predecessor over-released!");
            OpN.setNodeId(Degree -= 1);
            if Degree == 0 {
                self.ScheduleNode(OpN);
            }
        }
            if !(NumLeft -= 1) { break; }
        }
    }
}

fn findGluedUser(N: *mut SDNode) -> *mut SDNode {
    while N.getGluedUser() {
        Glued;
    }
    return N;
}

fn ScheduleDAGLinearize::Schedule(self) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
            dbgs() << "********** DAG Linearization **********\n";
        }
    }
        if !(false) { break; }
    }
    let mut Glues: SmallVector<SDNode *, 8> = SmallVector<SDNode *, 8> {};
    let mut DAGSize: u32 = 0;
    for Node in self.DAG.allnodes() {
        let mut N: *mut SDNode = &mut Node;
        let mut Degree: u32 = N.use_size();
        N.setNodeId(Degree);
        let mut NumVals: u32 = N.getNumValues();
        if NumVals && N.getValueType(NumVals - 1) == EVT { Glue } && N.hasAnyUseOfValue(NumVals - 1) {
            let mut User: *mut SDNode = findGluedUser(N);
            if User {
                Glues.push(N);
                self.GluedMap.insert(make_pair(N, User));
            }
        }
        if N.isMachineOpcode() || (N.getOpcode() != EntryToken && !isPassiveNode(N)) {
            DAGSize += 1;
        }
    }
    for Glue in Glues {
        let mut GUser: *mut SDNode = self.GluedMap[Glue];
        let mut Degree: u32 = Glue.getNodeId();
        let mut UDegree: u32 = GUser.getNodeId();
        let mut ImmGUser: *mut SDNode = Glue.getGluedUser();
        for U in Glue.users() {
            if U == ImmGUser {
                Degree -= 1;
            }
        }
        GUser.setNodeId(UDegree + Degree);
        Glue.setNodeId(1);
    }
    self.Sequence.reserve(DAGSize);
    self.ScheduleNode(self.DAG.getRoot().getNode());
}

fn ScheduleDAGLinearize::EmitSchedule(self, InsertPos: *mut iterator) -> *mut MachineBasicBlock {
    let mut Emitter: InstrEmitter = InstrEmitter { self.DAG.getTarget(), self.BB, iterator { InsertPos } };
    let mut VRBaseMap: VRBaseMapType = VRBaseMapType {};
    while true {
        {
        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
            {
                dbgs() << "\n*** Final schedule ***\n";
            }
        }
    }
        if !(false) { break; }
    }
    let mut NumNodes: u32 = self.Sequence.len;
    let mut BB: *mut MachineBasicBlock = Emitter.getBlock();
    for let mut i: u32 = 0; i != NumNodes; i += 1 {
        let mut N: *mut SDNode = self.Sequence[NumNodes - i - 1];
        while true {
            {
            if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                N.dump(self.DAG);
            }
        }
            if !(false) { break; }
        }
        Emitter.EmitNode(N, false, false, VRBaseMap);
        if N.getHasDebugValue() {
            let mut InsertPos: iterator = Emitter.getInsertPos();
            for DV in self.DAG.GetDbgValues(N) {
                if !DV.isEmitted() {
                    if Emitter.EmitDbgValue(DV, VRBaseMap) {
                        DbgMI;
                    } else {
                        BB.insert(iterator { InsertPos }, DbgMI);
                    }
                }
            }
        }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
            dbgs() << 10;
        }
    }
        if !(false) { break; }
    }
    InsertPos = Emitter.getInsertPos();
    return Emitter.getBlock();
}

fn createFastDAGScheduler(IS: *mut SelectionDAGISel, arg: CodeGenOptLevel) -> *mut ScheduleDAGSDNodes {
    return ScheduleDAGFast { *IS.MF };
}

fn createDAGLinearizer(IS: *mut SelectionDAGISel, arg: CodeGenOptLevel) -> *mut ScheduleDAGSDNodes {
    return ScheduleDAGLinearize { *IS.MF };
}
