struct FloatSignAsInt {
    FloatVT: EVT,
    Chain: SDValue,
    FloatPtr: SDValue,
    IntPtr: SDValue,
    IntPointerInfo: MachinePointerInfo,
    FloatPointerInfo: MachinePointerInfo,
    IntValue: SDValue,
    SignMask: APInt,
    SignBit: u8,
}

struct SelectionDAGLegalize {
    TM: *TargetMachine,
    TLI: *TargetLowering,
    DAG: *mut SelectionDAG,
    LegalizedNodes: *mut SmallPtrSetImpl<SDNode *>,
    UpdatedNodes: *mut SmallSetVector<SDNode *, 16>,
}

fn SelectionDAGLegalize::getSetCCResultType(self: *SelectionDAGLegalize, VT: EVT) -> EVT {
    return self.TLI.getSetCCResultType(self.DAG.getDataLayout(), *self.DAG.getContext(), VT);
}

fn SelectionDAGLegalize::ReplacedNode(self, N: *mut SDNode) {
    self.LegalizedNodes.erase(N);
    if self.UpdatedNodes {
        self.UpdatedNodes.insert(N);
    }
}

fn SelectionDAGLegalize::ReplaceNode(self, Old: *mut SDNode, New: *mut SDNode) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalizedag", 1) {
            dbgs() << " ... replacing: ";
            Old.dump(&mut self.DAG);
            dbgs() << "     with:      ";
            New.dump(&mut self.DAG);
        }
    }
        if !(false) { break; }
    }
    assert!(Old.getNumValues() == New.getNumValues(), "Replacing one node with another that produces a different number of values!");
    self.DAG.ReplaceAllUsesWith(Old, New);
    if self.UpdatedNodes {
        self.UpdatedNodes.insert(New);
    }
    self.ReplacedNode(Old);
}

fn SelectionDAGLegalize::ReplaceNode(self, Old: SDValue, New: SDValue) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalizedag", 1) {
            dbgs() << " ... replacing: ";
            operator(Old).dump(&mut self.DAG);
            dbgs() << "     with:      ";
            operator(New).dump(&mut self.DAG);
        }
    }
        if !(false) { break; }
    }
    self.DAG.ReplaceAllUsesWith(Old, New);
    if self.UpdatedNodes {
        self.UpdatedNodes.insert(New.getNode());
    }
    self.ReplacedNode(Old.getNode());
}

fn SelectionDAGLegalize::ReplaceNode(self, Old: *mut SDNode, New: *SDValue) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalizedag", 1) {
            dbgs() << " ... replacing: ";
            Old.dump(&mut self.DAG);
        }
    }
        if !(false) { break; }
    }
    self.DAG.ReplaceAllUsesWith(Old, New);
    for let mut i: u32 = 0;
let mut e: u32 = Old.getNumValues(); i != e; i += 1 {
        while true {
            {
            if DebugFlag && isCurrentDebugType("legalizedag", 1) {
                dbgs() << (if i == 0 { "     with:      " } else { "      and:      " });
                operator(New[i]).dump(&mut self.DAG);
            }
        }
            if !(false) { break; }
        }
        if self.UpdatedNodes {
            self.UpdatedNodes.insert(New[i].getNode());
        }
    }
    self.ReplacedNode(Old);
}

fn SelectionDAGLegalize::ReplaceNodeWithValue(self, Old: SDValue, New: SDValue) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalizedag", 1) {
            dbgs() << " ... replacing: ";
            operator(Old).dump(&mut self.DAG);
            dbgs() << "     with:      ";
            operator(New).dump(&mut self.DAG);
        }
    }
        if !(false) { break; }
    }
    self.DAG.ReplaceAllUsesOfValueWith(Old, New);
    if self.UpdatedNodes {
        self.UpdatedNodes.insert(New.getNode());
    }
    self.ReplacedNode(Old.getNode());
}

fn getStackAlignedMMO(StackPtr: SDValue, MF: *mut MachineFunction, isObjectScalable: bool) -> *mut MachineMemOperand {
    let mut MFI: *mut MachineFrameInfo = MF.getFrameInfo();
    let mut FI: i32 = cast(StackPtr).getIndex();
    let mut PtrInfo: MachinePointerInfo = getFixedStack(MF, FI, 0);
    let mut ObjectSize: LocationSize = if isObjectScalable { beforeOrAfterPointer() } else { precise(MFI.getObjectSize(FI)) };
    return MF.getMachineMemOperand(PtrInfo, MOStore, ObjectSize, MFI.getObjectAlign(FI), MMOMetadata {}, System, NotAtomic, NotAtomic);
}

fn SelectionDAGLegalize::ShuffleWithNarrowerEltType(self: *SelectionDAGLegalize, NVT: EVT, VT: EVT, dl: *SDLoc, N1: SDValue, N2: SDValue, Mask: ArrayRef<int>) -> SDValue {
    let mut NumMaskElts: u32 = VT.getVectorNumElements();
    let mut NumDestElts: u32 = NVT.getVectorNumElements();
    let mut NumEltsGrowth: u32 = NumDestElts / NumMaskElts;
    assert!(NumEltsGrowth, "Cannot promote to vector type with fewer elts!");
    if NumEltsGrowth == 1 {
        return self.DAG.getVectorShuffle(NVT, dl, N1, N2, Mask);
    }
    let mut NewMask: SmallVector<int, 8> = SmallVector<int, 8> {};
    for let mut i: u32 = 0; i != NumMaskElts; i += 1 {
        let mut Idx: i32 = Mask[i];
        for let mut j: u32 = 0; j != NumEltsGrowth; j += 1 {
            if Idx < 0 {
                NewMask.push(-1);
            } else {
                NewMask.push(Idx * NumEltsGrowth + j);
            }
        }
    }
    assert!(NewMask.len == NumDestElts, "Non-integer NumEltsGrowth?");
    assert!(self.TLI.isShuffleMaskLegal(ArrayRef<int> { NewMask }, NVT), "Shuffle not legal?");
    return self.DAG.getVectorShuffle(NVT, dl, N1, N2, ArrayRef<int> { NewMask });
}

fn SelectionDAGLegalize::ExpandConstantFP(self, CFP: *mut ConstantFPSDNode, UseCP: bool) -> SDValue {
    let mut Extend: bool = false;
    let mut dl: SDLoc = SDLoc { CFP };
    let mut VT: EVT = CFP.getValueType(0);
    let mut LLVMC: *mut ConstantFP = CFP.getConstantFPValue();
    if !UseCP {
        assert!((VT == EVT { f64 } || VT == EVT { f32 }), "Invalid type expansion");
        return self.DAG.getConstant(LLVMC.getValueAPF().bitcastToAPInt(), dl, EVT { if (VT == EVT { f64 }) { i64 } else { i32 } }, false, false);
    }
    let mut APF: APFloat = CFP.getValueAPF();
    let mut OrigVT: EVT = VT;
    let mut SVT: EVT = VT;
    if !APF.isSignaling() {
        while SVT != EVT { f32 } && SVT != EVT { f16 } && SVT != EVT { bf16 } {
            SVT = EVT { (SVT.getSimpleVT().SimpleTy - 1) as SimpleValueType };
            if isValueValidForType(SVT, APF) && self.TLI.isLoadLegal(OrigVT, SVT, self.DAG.getDataLayout().getPrefTypeAlign(SVT.getTypeForEVT(*self.DAG.getContext())), getConstantPool(self.DAG.getMachineFunction()).getAddrSpace(), EXTLOAD, false) && self.TLI.ShouldShrinkFPConstant(OrigVT) {
                let mut SType: *mut Type = SVT.getTypeForEVT(*self.DAG.getContext());
                LLVMC = cast(ConstantFoldCastOperand(FPTrunc, LLVMC, SType, self.DAG.getDataLayout()));
                VT = SVT;
                Extend = true;
            }
        }
    }
    let mut CPIdx: SDValue = self.DAG.getConstantPool(LLVMC, EVT { self.TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, MaybeAlign { nullopt }, 0, false, 0);
    let mut Alignment: Align = cast(CPIdx).getAlign();
    if Extend {
        let mut Result: SDValue = self.DAG.getExtLoad(EXTLOAD, dl, OrigVT, self.DAG.getEntryNode(), CPIdx, getConstantPool(self.DAG.getMachineFunction()), VT, MaybeAlign { Alignment }, MONone, MMOMetadata {});
        return Result;
    }
    let mut Result: SDValue = self.DAG.getLoad(OrigVT, dl, self.DAG.getEntryNode(), CPIdx, getConstantPool(self.DAG.getMachineFunction()), MaybeAlign { Alignment }, MONone, MMOMetadata {});
    return Result;
}

fn SelectionDAGLegalize::ExpandConstant(self, CP: *mut ConstantSDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { CP };
    let mut VT: EVT = CP.getValueType(0);
    let mut CPIdx: SDValue = self.DAG.getConstantPool(CP.getConstantIntValue(), EVT { self.TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, MaybeAlign { nullopt }, 0, false, 0);
    let mut Alignment: Align = cast(CPIdx).getAlign();
    let mut Result: SDValue = self.DAG.getLoad(VT, dl, self.DAG.getEntryNode(), CPIdx, getConstantPool(self.DAG.getMachineFunction()), MaybeAlign { Alignment }, MONone, MMOMetadata {});
    return Result;
}

fn SelectionDAGLegalize::ExpandINSERT_VECTOR_ELT(self, Op: SDValue) -> SDValue {
    let mut Vec: SDValue = Op.getOperand(0);
    let mut Val: SDValue = Op.getOperand(1);
    let mut Idx: SDValue = Op.getOperand(2);
    let mut dl: SDLoc = SDLoc { Op };
    if dyn_cast(Idx) {
        InsertPos;
    } else {
        let mut EltVT: EVT = Vec.getValueType().getVectorElementType();
        if Val.getValueType() == EltVT || (EltVT.isInteger() && Val.getValueType().bitsGE(EltVT)) {
            let mut ScVec: SDValue = self.DAG.getNode(SCALAR_TO_VECTOR, dl, Vec.getValueType(), Val);
            let mut NumElts: u32 = Vec.getValueType().getVectorNumElements();
            let mut ShufOps: SmallVector<int, 8> = SmallVector<int, 8> {};
            for let mut i: u32 = 0; i != NumElts; i += 1 {
                ShufOps.push(if i != InsertPos.getZExtValue() { i } else { NumElts });
            }
            return self.DAG.getVectorShuffle(Vec.getValueType(), dl, Vec, ScVec, ArrayRef<int> { ShufOps });
        }
    }
    return self.ExpandInsertToVectorThroughStack(Op);
}

fn SelectionDAGLegalize::OptimizeFloatStore(self, ST: *mut StoreSDNode) -> SDValue {
    if !isNormalStore(ST) {
        return SDValue {};
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalizedag", 1) {
            dbgs() << "Optimizing float store operations\n";
        }
    }
        if !(false) { break; }
    }
    let mut Chain: SDValue = ST.getChain();
    let mut Ptr: SDValue = ST.getBasePtr();
    let mut Value: SDValue = ST.getValue();
    let mut MMOFlags: Flags = ST.getMemOperand().getFlags();
    let mut AAInfo: AAMDNodes = ST.getAAInfo();
    let mut dl: SDLoc = SDLoc { ST };
    if Value.getOpcode() == TargetConstantFP {
        return SDValue {};
    }
    if dyn_cast(Value) {
        CFP;
    } else {
        if CFP.getValueType(0) == EVT { f32 } && self.TLI.isTypeLegal(EVT { i32 }) {
            let mut Con: SDValue = self.DAG.getConstant(CFP.getValueAPF().bitcastToAPInt().zextOrTrunc(32), SDLoc { CFP }, EVT { i32 }, false, false);
            return self.DAG.getStore(Chain, dl, Con, Ptr, ST.getPointerInfo(), ST.getBaseAlign(), MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
        }
        if CFP.getValueType(0) == EVT { f64 } && !self.TLI.isFPImmLegal(CFP.getValueAPF(), EVT { f64 }, false) {
            if self.TLI.isTypeLegal(EVT { i64 }) {
                let mut Con: SDValue = self.DAG.getConstant(CFP.getValueAPF().bitcastToAPInt().zextOrTrunc(64), SDLoc { CFP }, EVT { i64 }, false, false);
                return self.DAG.getStore(Chain, dl, Con, Ptr, ST.getPointerInfo(), ST.getBaseAlign(), MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
            }
            if self.TLI.isTypeLegal(EVT { i32 }) && !ST.isVolatile() {
                let mut IntVal: *APInt = CFP.getValueAPF().bitcastToAPInt();
                let mut Lo: SDValue = self.DAG.getConstant(IntVal.trunc(32), dl, EVT { i32 }, false, false);
                let mut Hi: SDValue = self.DAG.getConstant(IntVal.lshr(32).trunc(32), dl, EVT { i32 }, false, false);
                if self.DAG.getDataLayout().isBigEndian() {
                    swap(Lo, Hi);
                }
                Lo = self.DAG.getStore(Chain, dl, Lo, Ptr, ST.getPointerInfo(), ST.getBaseAlign(), MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
                Ptr = self.DAG.getMemBasePlusOffset(Ptr, getFixed(4), dl, SDNodeFlags { Flags: None });
                Hi = self.DAG.getStore(Chain, dl, Hi, Ptr, ST.getPointerInfo().getWithOffset(4), ST.getBaseAlign(), MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
                return self.DAG.getNode(TokenFactor, dl, EVT { Other }, Lo, Hi);
            }
        }
    }
    return SDValue {};
}

fn SelectionDAGLegalize::LegalizeStoreOps(self, Node: *mut SDNode) {
    let mut ST: *mut StoreSDNode = cast(Node);
    let mut Chain: SDValue = ST.getChain();
    let mut Ptr: SDValue = ST.getBasePtr();
    let mut dl: SDLoc = SDLoc { Node };
    let mut MMOFlags: Flags = ST.getMemOperand().getFlags();
    let mut AAInfo: AAMDNodes = ST.getAAInfo();
    if !ST.isTruncatingStore() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("legalizedag", 1) {
                dbgs() << "Legalizing store operation\n";
            }
        }
            if !(false) { break; }
        }
        if self.OptimizeFloatStore(ST).getNode() {
            OptStore;
        } else {
            self.ReplaceNode(ST, OptStore);
            return;
        }
        let mut Value: SDValue = ST.getValue();
        let mut VT: MVT = Value.getSimpleValueType();
        match self.TLI.getOperationAction(STORE, EVT { VT }) {
            _ => {
                llvm_unreachable_internal("This action is not supported yet!", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeDAG.cpp", 511);
            },
            Legal => {
                let mut MemVT: EVT = ST.getMemoryVT();
                let mut DL: *DataLayout = self.DAG.getDataLayout();
                if !self.TLI.allowsMemoryAccessForAlignment(*self.DAG.getContext(), DL, MemVT, *ST.getMemOperand(), null) {
                    while true {
                        {
                        if DebugFlag && isCurrentDebugType("legalizedag", 1) {
                            dbgs() << "Expanding unsupported unaligned store\n";
                        }
                    }
                        if !(false) { break; }
                    }
                    let mut Result: SDValue = self.TLI.expandUnalignedStore(ST, self.DAG);
                    self.ReplaceNode(SDValue { Node: ST, ResNo: 0 }, Result);
                } else {
                    while true {
                        {
                        if DebugFlag && isCurrentDebugType("legalizedag", 1) {
                            dbgs() << "Legal store\n";
                        }
                    }
                        if !(false) { break; }
                    }
                }
                break;
            },
            Custom => {
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("legalizedag", 1) {
                        dbgs() << "Trying custom lowering\n";
                    }
                }
                    if !(false) { break; }
                }
                let mut Res: SDValue = self.TLI.LowerOperation(SDValue { Node: Node, ResNo: 0 }, self.DAG);
                if Res && Res != SDValue { Node: Node, ResNo: 0 } {
                    self.ReplaceNode(SDValue { Node: Node, ResNo: 0 }, Res);
                }
                return;
            },
            Promote => {
                let mut NVT: MVT = self.TLI.getTypeToPromoteTo(STORE, VT);
                assert!(NVT.getSizeInBits() == VT.getSizeInBits(), "Can only promote stores to same size type");
                Value = self.DAG.getNode(BITCAST, dl, EVT { NVT }, Value);
                let mut Result: SDValue = self.DAG.getStore(Chain, dl, Value, Ptr, ST.getPointerInfo(), ST.getBaseAlign(), MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
                self.ReplaceNode(SDValue { Node: Node, ResNo: 0 }, Result);
                break;
            },
        }
        return;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalizedag", 1) {
            dbgs() << "Legalizing truncating store operations\n";
        }
    }
        if !(false) { break; }
    }
    let mut Value: SDValue = ST.getValue();
    let mut StVT: EVT = ST.getMemoryVT();
    let mut StWidth: TypeSize = StVT.getSizeInBits();
    let mut StSize: TypeSize = StVT.getStoreSizeInBits();
    let mut DL: *DataLayout = self.DAG.getDataLayout();
    if StWidth != StSize {
        let mut NVT: EVT = getIntegerVT(*self.DAG.getContext(), StSize.getFixedValue());
        Value = self.DAG.getZeroExtendInReg(Value, dl, StVT);
        let mut Result: SDValue = self.DAG.getTruncStore(Chain, dl, Value, Ptr, ST.getPointerInfo(), NVT, ST.getBaseAlign(), MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
        self.ReplaceNode(SDValue { Node: Node, ResNo: 0 }, Result);
    } else if !StVT.isVector() && !isPowerOf2_64(StWidth.getFixedValue()) {
        assert!(!StVT.isVector(), "Unsupported truncstore!");
        let mut StWidthBits: u32 = StWidth.getFixedValue();
        let mut LogStWidth: u32 = Log2_32(StWidthBits);
        assert!(LogStWidth < 32);
        let mut RoundWidth: u32 = 1 << LogStWidth;
        assert!(RoundWidth < StWidthBits);
        let mut ExtraWidth: u32 = StWidthBits - RoundWidth;
        assert!(ExtraWidth < RoundWidth);
        assert!(!(RoundWidth % 8) && !(ExtraWidth % 8), "Store size not an integral number of bytes!");
        let mut RoundVT: EVT = getIntegerVT(*self.DAG.getContext(), RoundWidth);
        let mut ExtraVT: EVT = getIntegerVT(*self.DAG.getContext(), ExtraWidth);
        let mut Lo: SDValue = SDValue {};
        let mut Hi: SDValue = SDValue {};
        let mut IncrementSize: u32 = 0;
        if DL.isLittleEndian() {
            Lo = self.DAG.getTruncStore(Chain, dl, Value, Ptr, ST.getPointerInfo(), RoundVT, ST.getBaseAlign(), MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
            IncrementSize = RoundWidth / 8;
            Ptr = self.DAG.getMemBasePlusOffset(Ptr, getFixed(IncrementSize), dl, SDNodeFlags { Flags: None });
            Hi = self.DAG.getNode(SRL, dl, Value.getValueType(), Value, self.DAG.getShiftAmountConstant(RoundWidth, Value.getValueType(), dl));
            Hi = self.DAG.getTruncStore(Chain, dl, Hi, Ptr, ST.getPointerInfo().getWithOffset(IncrementSize), ExtraVT, ST.getBaseAlign(), MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
        } else {
            Hi = self.DAG.getNode(SRL, dl, Value.getValueType(), Value, self.DAG.getShiftAmountConstant(ExtraWidth, Value.getValueType(), dl));
            Hi = self.DAG.getTruncStore(Chain, dl, Hi, Ptr, ST.getPointerInfo(), RoundVT, ST.getBaseAlign(), MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
            IncrementSize = RoundWidth / 8;
            Ptr = self.DAG.getNode(ADD, dl, Ptr.getValueType(), Ptr, self.DAG.getConstant(IncrementSize, dl, Ptr.getValueType(), false, false));
            Lo = self.DAG.getTruncStore(Chain, dl, Value, Ptr, ST.getPointerInfo().getWithOffset(IncrementSize), ExtraVT, ST.getBaseAlign(), MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
        }
        let mut Result: SDValue = self.DAG.getNode(TokenFactor, dl, EVT { Other }, Lo, Hi);
        self.ReplaceNode(SDValue { Node: Node, ResNo: 0 }, Result);
    } else {
        match self.TLI.getTruncStoreAction(ST.getValue().getValueType(), StVT, ST.getAlign(), ST.getAddressSpace()) {
            _ => {
                llvm_unreachable_internal("This action is not supported yet!", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeDAG.cpp", 624);
            },
            Legal => {
                let mut MemVT: EVT = ST.getMemoryVT();
                if !self.TLI.allowsMemoryAccessForAlignment(*self.DAG.getContext(), DL, MemVT, *ST.getMemOperand(), null) {
                    let mut Result: SDValue = self.TLI.expandUnalignedStore(ST, self.DAG);
                    self.ReplaceNode(SDValue { Node: ST, ResNo: 0 }, Result);
                }
                break;
            },
            Custom => {
                let mut Res: SDValue = self.TLI.LowerOperation(SDValue { Node: Node, ResNo: 0 }, self.DAG);
                if Res && Res != SDValue { Node: Node, ResNo: 0 } {
                    self.ReplaceNode(SDValue { Node: Node, ResNo: 0 }, Res);
                }
                return;
            },
            Expand => {
                assert!(!StVT.isVector(), "Vector Stores are handled in LegalizeVectorOps");
            },
        }
    }
}

fn SelectionDAGLegalize::LegalizeLoadOps(self, Node: *mut SDNode) {
    let mut LD: *mut LoadSDNode = cast(Node);
    let mut Chain: SDValue = LD.getChain();
    let mut Ptr: SDValue = LD.getBasePtr();
    let mut Value: SDValue = SDValue {};
    let mut dl: SDLoc = SDLoc { Node };
    let mut ExtType: LoadExtType = LD.getExtensionType();
    if ExtType == NON_EXTLOAD {
        while true {
            {
            if DebugFlag && isCurrentDebugType("legalizedag", 1) {
                dbgs() << "Legalizing non-extending load operation\n";
            }
        }
            if !(false) { break; }
        }
        let mut VT: MVT = Node.getSimpleValueType(0);
        let mut RVal: SDValue = SDValue { Node: Node, ResNo: 0 };
        let mut RChain: SDValue = SDValue { Node: Node, ResNo: 1 };
        match self.TLI.getOperationAction(Node.getOpcode(), EVT { VT }) {
            _ => {
                llvm_unreachable_internal("This action is not supported yet!", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeDAG.cpp", 684);
            },
            Legal => {
                let mut MemVT: EVT = LD.getMemoryVT();
                let mut DL: *DataLayout = self.DAG.getDataLayout();
                if !self.TLI.allowsMemoryAccessForAlignment(*self.DAG.getContext(), DL, MemVT, *LD.getMemOperand(), null) {
                    tie(RVal, RChain) = self.TLI.expandUnalignedLoad(LD, self.DAG);
                }
                break;
            },
            Custom => {
                if self.TLI.LowerOperation(RVal, self.DAG) {
                    Res;
                } else {
                    RVal = Res;
                    RChain = Res.getValue(1);
                }
            },
            Promote => {
                let mut NVT: MVT = self.TLI.getTypeToPromoteTo(Node.getOpcode(), VT);
                assert!(NVT.getSizeInBits() == VT.getSizeInBits(), "Can only promote loads to same size type");
                if LD.getRanges() {
                    MD;
                } else {
                    let mut Lower: *mut ConstantInt = extract(MD.getOperand(0));
                    if Lower.getBitWidth() != NVT.getScalarSizeInBits() || !NVT.isInteger() {
                        LD.getMemOperand().clearRanges();
                    }
                }
                let mut Res: SDValue = self.DAG.getLoad(EVT { NVT }, dl, Chain, Ptr, LD.getMemOperand());
                RVal = self.DAG.getNode(BITCAST, dl, EVT { VT }, Res);
                RChain = Res.getValue(1);
                break;
            },
        }
        if RChain.getNode() != Node {
            assert!(RVal.getNode() != Node, "Load must be completely replaced");
            self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: Node, ResNo: 0 }, RVal);
            self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: Node, ResNo: 1 }, RChain);
            if self.UpdatedNodes {
                self.UpdatedNodes.insert(RVal.getNode());
                self.UpdatedNodes.insert(RChain.getNode());
            }
            self.ReplacedNode(Node);
        }
        return;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalizedag", 1) {
            dbgs() << "Legalizing extending load operation\n";
        }
    }
        if !(false) { break; }
    }
    let mut SrcVT: EVT = LD.getMemoryVT();
    let mut SrcWidth: TypeSize = SrcVT.getSizeInBits();
    let mut MMOFlags: Flags = LD.getMemOperand().getFlags();
    let mut AAInfo: AAMDNodes = LD.getAAInfo();
    if SrcWidth != SrcVT.getStoreSizeInBits() && (SrcVT != EVT { i1 } || self.TLI.getLoadAction(Node.getValueType(0), EVT { i1 }, LD.getAlign(), LD.getAddressSpace(), ExtType, false) == Promote) {
        let mut NewWidth: u32 = SrcVT.getStoreSizeInBits().operator unsigned long long();
        let mut NVT: EVT = getIntegerVT(*self.DAG.getContext(), NewWidth);
        let mut Ch: SDValue = SDValue {};
        let mut NewExtType: LoadExtType = if ExtType == ZEXTLOAD {} else { EXTLOAD };
        let mut Result: SDValue = self.DAG.getExtLoad(NewExtType, dl, Node.getValueType(0), Chain, Ptr, LD.getPointerInfo(), NVT, MaybeAlign { LD.getBaseAlign() }, MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
        Ch = Result.getValue(1);
        if ExtType == SEXTLOAD {
            Result = self.DAG.getNode(SIGN_EXTEND_INREG, dl, Result.getValueType(), Result, self.DAG.getValueType(SrcVT));
        } else if ExtType == ZEXTLOAD || NVT == Result.getValueType() {
            Result = self.DAG.getNode(AssertZext, dl, Result.getValueType(), Result, self.DAG.getValueType(SrcVT));
        }
        Value = Result;
        Chain = Ch;
    } else if !isPowerOf2_64(SrcWidth.getKnownMinValue()) {
        assert!(!SrcVT.isVector(), "Unsupported extload!");
        let mut SrcWidthBits: u32 = SrcWidth.getFixedValue();
        let mut LogSrcWidth: u32 = Log2_32(SrcWidthBits);
        assert!(LogSrcWidth < 32);
        let mut RoundWidth: u32 = 1 << LogSrcWidth;
        assert!(RoundWidth < SrcWidthBits);
        let mut ExtraWidth: u32 = SrcWidthBits - RoundWidth;
        assert!(ExtraWidth < RoundWidth);
        assert!(!(RoundWidth % 8) && !(ExtraWidth % 8), "Load size not an integral number of bytes!");
        let mut RoundVT: EVT = getIntegerVT(*self.DAG.getContext(), RoundWidth);
        let mut ExtraVT: EVT = getIntegerVT(*self.DAG.getContext(), ExtraWidth);
        let mut Lo: SDValue = SDValue {};
        let mut Hi: SDValue = SDValue {};
        let mut Ch: SDValue = SDValue {};
        let mut IncrementSize: u32 = 0;
        let mut DL: *DataLayout = self.DAG.getDataLayout();
        if DL.isLittleEndian() {
            Lo = self.DAG.getExtLoad(ZEXTLOAD, dl, Node.getValueType(0), Chain, Ptr, LD.getPointerInfo(), RoundVT, MaybeAlign { LD.getBaseAlign() }, MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
            IncrementSize = RoundWidth / 8;
            Ptr = self.DAG.getMemBasePlusOffset(Ptr, getFixed(IncrementSize), dl, SDNodeFlags { Flags: None });
            Hi = self.DAG.getExtLoad(ExtType, dl, Node.getValueType(0), Chain, Ptr, LD.getPointerInfo().getWithOffset(IncrementSize), ExtraVT, MaybeAlign { LD.getBaseAlign() }, MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
            Ch = self.DAG.getNode(TokenFactor, dl, EVT { Other }, Lo.getValue(1), Hi.getValue(1));
            Hi = self.DAG.getNode(SHL, dl, Hi.getValueType(), Hi, self.DAG.getShiftAmountConstant(RoundWidth, Hi.getValueType(), dl));
            Value = self.DAG.getNode(OR, dl, Node.getValueType(0), Lo, Hi);
        } else {
            Hi = self.DAG.getExtLoad(ExtType, dl, Node.getValueType(0), Chain, Ptr, LD.getPointerInfo(), RoundVT, MaybeAlign { LD.getBaseAlign() }, MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
            IncrementSize = RoundWidth / 8;
            Ptr = self.DAG.getMemBasePlusOffset(Ptr, getFixed(IncrementSize), dl, SDNodeFlags { Flags: None });
            Lo = self.DAG.getExtLoad(ZEXTLOAD, dl, Node.getValueType(0), Chain, Ptr, LD.getPointerInfo().getWithOffset(IncrementSize), ExtraVT, MaybeAlign { LD.getBaseAlign() }, MMOFlags, MMOMetadata { AAInfo: AAInfo, Ranges: null, MemCacheHint: null });
            Ch = self.DAG.getNode(TokenFactor, dl, EVT { Other }, Lo.getValue(1), Hi.getValue(1));
            Hi = self.DAG.getNode(SHL, dl, Hi.getValueType(), Hi, self.DAG.getShiftAmountConstant(ExtraWidth, Hi.getValueType(), dl));
            Value = self.DAG.getNode(OR, dl, Node.getValueType(0), Lo, Hi);
        }
        Chain = Ch;
    } else {
        let mut isCustom: bool = false;
        match self.TLI.getLoadAction(Node.getValueType(0), EVT { SrcVT.getSimpleVT() }, LD.getAlign(), LD.getAddressSpace(), ExtType, false) {
            _ => {
                llvm_unreachable_internal("This action is not supported yet!", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeDAG.cpp", 866);
            },
            Custom => {
                isCustom = true;
            },
            Legal => {
                Value = SDValue { Node: Node, ResNo: 0 };
            },
            Expand => {
                let mut DestVT: EVT = Node.getValueType(0);
                if !self.TLI.isLoadLegal(DestVT, SrcVT, LD.getAlign(), LD.getAddressSpace(), EXTLOAD, false) {
                    let mut LoadVT: EVT = EVT { self.TLI.getRegisterType(*self.DAG.getContext(), EVT { SrcVT.getSimpleVT() }) };
                    if (LoadVT.isFloatingPoint() == SrcVT.isFloatingPoint()) && (self.TLI.isTypeLegal(SrcVT) || self.TLI.isLoadLegal(LoadVT, SrcVT, LD.getAlign(), LD.getAddressSpace(), ExtType, false)) {
                        let mut MidExtType: LoadExtType = if (LoadVT == SrcVT) { NON_EXTLOAD } else { ExtType };
                        let mut Load: SDValue = self.DAG.getExtLoad(MidExtType, dl, LoadVT, Chain, Ptr, SrcVT, LD.getMemOperand());
                        let mut ExtendOp: u32 = getExtForLoadExtType(SrcVT.isFloatingPoint(), ExtType);
                        Value = self.DAG.getNode(ExtendOp, dl, Node.getValueType(0), Load);
                        Chain = Load.getValue(1);
                        break;
                    }
                    let mut SVT: EVT = SrcVT.getScalarType();
                    if SVT == EVT { f16 } || SVT == EVT { bf16 } {
                        let mut ISrcVT: EVT = SrcVT.changeTypeToInteger();
                        let mut IDestVT: EVT = DestVT.changeTypeToInteger();
                        let mut ILoadVT: EVT = EVT { self.TLI.getRegisterType(*self.DAG.getContext(), EVT { IDestVT.getSimpleVT() }) };
                        let mut Result: SDValue = self.DAG.getExtLoad(ZEXTLOAD, dl, ILoadVT, Chain, Ptr, ISrcVT, LD.getMemOperand());
                        Value = self.DAG.getNode(if SVT == EVT { f16 } { FP16_TO_FP } else { BF16_TO_FP }, dl, DestVT, Result);
                        Chain = Result.getValue(1);
                        break;
                    }
                }
                assert!(!SrcVT.isVector(), "Vector Loads are handled in LegalizeVectorOps");
                assert!(ExtType != EXTLOAD, "EXTLOAD should always be supported!");
                let mut Result: SDValue = self.DAG.getExtLoad(EXTLOAD, dl, Node.getValueType(0), Chain, Ptr, SrcVT, LD.getMemOperand());
                let mut ValRes: SDValue = SDValue {};
                if ExtType == SEXTLOAD {
                    ValRes = self.DAG.getNode(SIGN_EXTEND_INREG, dl, Result.getValueType(), Result, self.DAG.getValueType(SrcVT));
                } else {
                    ValRes = self.DAG.getZeroExtendInReg(Result, dl, SrcVT);
                }
                Value = ValRes;
                Chain = Result.getValue(1);
                break;
            },
        }
    }
    if Chain.getNode() != Node {
        assert!(Value.getNode() != Node, "Load must be completely replaced");
        self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: Node, ResNo: 0 }, Value);
        self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: Node, ResNo: 1 }, Chain);
        if self.UpdatedNodes {
            self.UpdatedNodes.insert(Value.getNode());
            self.UpdatedNodes.insert(Chain.getNode());
        }
        self.ReplacedNode(Node);
    }
}

fn SelectionDAGLegalize::LegalizeOp(self, Node: *mut SDNode) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalizedag", 1) {
            dbgs() << "\nLegalizing: ";
            Node.dump(&mut self.DAG);
        }
    }
        if !(false) { break; }
    }
    if Node.getOpcode() == TargetConstant || Node.getOpcode() == Register {
        return;
    }
    for let mut i: u32 = 0;
let mut e: u32 = Node.getNumValues(); i != e; i += 1 {
        assert!(self.TLI.getTypeAction(*self.DAG.getContext(), Node.getValueType(i)) == TypeLegal, "Unexpected illegal type!");
    }
    for Op in Node.op_values() {
        assert!((self.TLI.getTypeAction(*self.DAG.getContext(), Op.getValueType()) == TypeLegal || Op.getOpcode() == TargetConstant || Op.getOpcode() == Register), "Unexpected illegal type!");
    }
    let mut Action: LegalizeAction = Legal;
    let mut SimpleFinishLegalizing: bool = true;
    match Node.getOpcode() {
        INTRINSIC_W_CHAIN => {
            INTRINSIC_WO_CHAIN;
        },
        GET_DYNAMIC_AREA_OFFSET => {
            Action = self.TLI.getOperationAction(Node.getOpcode(), Node.getValueType(0));
        },
        VAARG => {
            Action = self.TLI.getOperationAction(Node.getOpcode(), Node.getValueType(0));
        },
        SET_FPENV => {
            SET_FPMODE;
        },
        FP_TO_FP16 => {
            FP_TO_BF16;
        },
        STRICT_FP_TO_FP16 => {
            STRICT_FP_TO_BF16;
        },
        SIGN_EXTEND_INREG => {
            let mut InnerType: EVT = cast(Node.getOperand(1)).getVT();
            Action = self.TLI.getOperationAction(Node.getOpcode(), InnerType);
            break;
        },
        ATOMIC_STORE => {
            Action = self.TLI.getOperationAction(Node.getOpcode(), Node.getOperand(1).getValueType());
        },
        SELECT_CC => {
            STRICT_FSETCC;
        },
        LOAD => {
            STORE;
        },
        CALLSEQ_START => {
            CALLSEQ_END;
        },
        EXTRACT_ELEMENT => {
            GET_ROUNDING;
        },
        INIT_TRAMPOLINE => {
            ADJUST_TRAMPOLINE;
        },
        CLEAR_CACHE => {
            Action = self.TLI.getOperationAction(Node.getOpcode(), Node.getValueType(0));
        },
        READCYCLECOUNTER => {
            READSTEADYCOUNTER;
        },
        READ_REGISTER => {
            WRITE_REGISTER;
        },
        UBSANTRAP => {
            Action = self.TLI.getOperationAction(Node.getOpcode(), Node.getValueType(0));
        },
        DEBUGTRAP => {
            Action = self.TLI.getOperationAction(Node.getOpcode(), Node.getValueType(0));
        },
        SADDSAT => {
            UADDSAT;
        },
        SMULFIX => {
            SMULFIXSAT;
        },
        MSCATTER => {
            Action = self.TLI.getOperationAction(Node.getOpcode(), cast(Node).getValue().getValueType());
        },
        MSTORE => {
            Action = self.TLI.getOperationAction(Node.getOpcode(), cast(Node).getValue().getValueType());
        },
        VP_SCATTER => {
            Action = self.TLI.getOperationAction(Node.getOpcode(), cast(Node).getValue().getValueType());
        },
        VP_STORE => {
            Action = self.TLI.getOperationAction(Node.getOpcode(), cast(Node).getValue().getValueType());
        },
        EXPERIMENTAL_VP_STRIDED_STORE => {
            Action = self.TLI.getOperationAction(Node.getOpcode(), cast(Node).getValue().getValueType());
        },
        VECREDUCE_FADD => {
            VECREDUCE_FMUL;
        },
        VECREDUCE_SEQ_FADD => {
            VECREDUCE_SEQ_FMUL;
        },
        CTTZ_ELTS => {
            CTTZ_ELTS_ZERO_POISON;
        },
        VECTOR_INTERLEAVE => {
            VECTOR_DEINTERLEAVE;
        },
        EXPERIMENTAL_VECTOR_HISTOGRAM => {
            Action = self.TLI.getOperationAction(Node.getOpcode(), cast(Node).getIndex().getValueType());
        },
        _ => {
            if Node.getOpcode() >= BUILTIN_OP_END {
                Action = self.TLI.getCustomOperationAction(*Node);
            } else {
                Action = self.TLI.getOperationAction(Node.getOpcode(), Node.getValueType(0));
            }
        },
    }
    if SimpleFinishLegalizing {
        let mut NewNode: *mut SDNode = Node;
        match Node.getOpcode() {
            _ => {
                break;
            },
            SHL => {
                SRL;
            },
            FSHL => {
                FSHR;
            },
        }
        if NewNode != Node {
            self.ReplaceNode(Node, NewNode);
            Node = NewNode;
        }
        match Action {
            Legal => {
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("legalizedag", 1) {
                        dbgs() << "Legal node: nothing to do\n";
                    }
                }
                    if !(false) { break; }
                }
            },
            Custom => {
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("legalizedag", 1) {
                        dbgs() << "Trying custom legalization\n";
                    }
                }
                    if !(false) { break; }
                }
            },
            Expand => {
                if self.ExpandNode(Node) {
                    return;
                }
            },
            LibCall => {
                self.ConvertNodeToLibcall(Node);
            },
            Promote => {
                self.PromoteNode(Node);
            },
        }
    }
    match Node.getOpcode() {
        _ => {
            dbgs() << "NODE: ";
        },
        CALLSEQ_START => {
            CALLSEQ_END;
        },
        LOAD => {
            return self.LegalizeLoadOps(Node);
        },
        STORE => {
            return self.LegalizeStoreOps(Node);
        },
    }
}

fn SelectionDAGLegalize::ExpandExtractFromVectorThroughStack(self, Op: SDValue) -> SDValue {
    let mut Vec: SDValue = Op.getOperand(0);
    let mut Idx: SDValue = Op.getOperand(1);
    let mut dl: SDLoc = SDLoc { Op };
    let mut Visited: SmallPtrSet<const SDNode *, 32> = SmallPtrSet<const SDNode *, 32> {};
    let mut Worklist: SmallVector<const SDNode *, 16> = SmallVector<const SDNode *, 16> {};
    Visited.insert(Op.getNode());
    Worklist.push(Idx.getNode());
    let mut StackPtr: SDValue = SDValue {};
    let mut Ch: SDValue = SDValue {};
    for User in Vec.getNode().users() {
        if dyn_cast(User) {
            ST;
        } else {
            if ST.isIndexed() || ST.isTruncatingStore() || ST.getValue() != Vec {
                continue;
            }
            if !ST.getChain().reachesChainWithoutSideEffects(self.DAG.getEntryNode(), 2) {
                continue;
            }
            if hasPredecessorHelper(ST, Visited, Worklist, 0, false) || ST.hasPredecessor(Op.getNode()) {
                continue;
            }
            StackPtr = ST.getBasePtr();
            Ch = SDValue { Node: ST, ResNo: 0 };
            break;
        }
    }
    let mut VecVT: EVT = Vec.getValueType();
    if !Ch.getNode() {
        StackPtr = self.DAG.CreateStackTemporary(VecVT, 1);
        let mut StoreMMO: *mut MachineMemOperand = getStackAlignedMMO(StackPtr, self.DAG.getMachineFunction(), VecVT.isScalableVector());
        Ch = self.DAG.getStore(self.DAG.getEntryNode(), dl, Vec, StackPtr, StoreMMO);
    }
    let mut NewLoad: SDValue = SDValue {};
    let mut ElementAlignment: Align = if cast(Ch).getAlign() < self.DAG.getDataLayout().getPrefTypeAlign(Op.getValueType().getTypeForEVT(*self.DAG.getContext())) { cast(Ch).getAlign() } else { self.DAG.getDataLayout().getPrefTypeAlign(Op.getValueType().getTypeForEVT(*self.DAG.getContext())) };
    if Op.getValueType().isVector() {
        StackPtr = self.TLI.getVectorSubVecPointer(self.DAG, StackPtr, VecVT, Op.getValueType(), Idx, SDNodeFlags { Flags: None });
        NewLoad = self.DAG.getLoad(Op.getValueType(), dl, Ch, StackPtr, MachinePointerInfo { 0, 0 }, MaybeAlign { ElementAlignment }, MONone, MMOMetadata {});
    } else {
        StackPtr = self.TLI.getVectorElementPointer(self.DAG, StackPtr, VecVT, Idx, SDNodeFlags { Flags: None });
        NewLoad = self.DAG.getExtLoad(EXTLOAD, dl, Op.getValueType(), Ch, StackPtr, MachinePointerInfo { 0, 0 }, VecVT.getVectorElementType(), MaybeAlign { ElementAlignment }, MONone, MMOMetadata {});
    }
    self.DAG.ReplaceAllUsesOfValueWith(Ch, SDValue { Node: NewLoad.getNode(), ResNo: 1 });
    let mut NewLoadOperands: SmallVector<SDValue, 6> = SmallVector<SDValue, 6> { operator(NewLoad).ops() };
    NewLoadOperands[0] = Ch;
    NewLoad = SDValue { Node: self.DAG.UpdateNodeOperands(NewLoad.getNode(), ArrayRef<SDValue> { NewLoadOperands }), ResNo: 0 };
    return NewLoad;
}

fn SelectionDAGLegalize::ExpandInsertToVectorThroughStack(self, Op: SDValue) -> SDValue {
    assert!(Op.getValueType().isVector(), "Non-vector insert subvector!");
    let mut Vec: SDValue = Op.getOperand(0);
    let mut Part: SDValue = Op.getOperand(1);
    let mut Idx: SDValue = Op.getOperand(2);
    let mut dl: SDLoc = SDLoc { Op };
    let mut VecVT: EVT = Vec.getValueType();
    let mut PartVT: EVT = Part.getValueType();
    let mut StackPtr: SDValue = self.DAG.CreateStackTemporary(VecVT, 1);
    let mut FI: i32 = cast(StackPtr.getNode()).getIndex();
    let mut PtrInfo: MachinePointerInfo = getFixedStack(self.DAG.getMachineFunction(), FI, 0);
    let mut BaseVecAlignment: Align = self.DAG.getMachineFunction().getFrameInfo().getObjectAlign(FI);
    let mut Ch: SDValue = self.DAG.getStore(self.DAG.getEntryNode(), dl, Vec, StackPtr, PtrInfo, BaseVecAlignment, MONone, MMOMetadata {});
    Idx = self.DAG.getFreeze(Idx);
    let mut PartTy: *mut Type = PartVT.getTypeForEVT(*self.DAG.getContext());
    let mut PartAlignment: Align = self.DAG.getDataLayout().getPrefTypeAlign(PartTy);
    if PartVT.isVector() {
        let mut SubStackPtr: SDValue = self.TLI.getVectorSubVecPointer(self.DAG, StackPtr, VecVT, PartVT, Idx, SDNodeFlags { Flags: None });
        Ch = self.DAG.getStore(Ch, dl, Part, SubStackPtr, getUnknownStack(self.DAG.getMachineFunction()), PartAlignment, MONone, MMOMetadata {});
    } else {
        let mut SubStackPtr: SDValue = self.TLI.getVectorElementPointer(self.DAG, StackPtr, VecVT, Idx, SDNodeFlags { Flags: None });
        Ch = self.DAG.getTruncStore(Ch, dl, Part, SubStackPtr, getUnknownStack(self.DAG.getMachineFunction()), VecVT.getVectorElementType(), PartAlignment, MONone, MMOMetadata {});
    }
    assert!(cast(Ch).getAlign() == PartAlignment, "ElementAlignment does not match!");
    return self.DAG.getLoad(Op.getValueType(), dl, Ch, StackPtr, PtrInfo, MaybeAlign { BaseVecAlignment }, MONone, MMOMetadata {});
}

fn SelectionDAGLegalize::ExpandConcatVectors(self, Node: *mut SDNode) -> SDValue {
    assert!(Node.getOpcode() == CONCAT_VECTORS, "Unexpected opcode!");
    let mut DL: SDLoc = SDLoc { Node };
    let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
    let mut NumOperands: u32 = Node.getNumOperands();
    let mut VectorIdxType: MVT = self.TLI.getVectorIdxTy(self.DAG.getDataLayout());
    let mut VectorValueType: EVT = Node.getOperand(0).getValueType();
    let mut NumSubElem: u32 = VectorValueType.getVectorNumElements();
    let mut ElementValueType: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VectorValueType.getVectorElementType());
    for let mut I: u32 = 0; I < NumOperands; I += 1 {
        let mut SubOp: SDValue = Node.getOperand(I);
        for let mut Idx: u32 = 0; Idx < NumSubElem; Idx += 1 {
            Ops.push(self.DAG.getNode(EXTRACT_VECTOR_ELT, DL, ElementValueType, SubOp, self.DAG.getConstant(Idx, DL, EVT { VectorIdxType }, false, false)));
        }
    }
    return self.DAG.getBuildVector(Node.getValueType(0), DL, ArrayRef<SDValue> { Ops });
}

fn SelectionDAGLegalize::ExpandVectorBuildThroughStack(self, Node: *mut SDNode) -> SDValue {
    assert!((Node.getOpcode() == BUILD_VECTOR || Node.getOpcode() == CONCAT_VECTORS), "Unexpected opcode!");
    let mut VT: EVT = Node.getValueType(0);
    let mut MemVT: EVT = if isa(Node) { VT.getVectorElementType() } else { Node.getOperand(0).getValueType() };
    let mut dl: SDLoc = SDLoc { Node };
    let mut FIPtr: SDValue = self.DAG.CreateStackTemporary(VT, 1);
    let mut FI: i32 = cast(FIPtr.getNode()).getIndex();
    let mut PtrInfo: MachinePointerInfo = getFixedStack(self.DAG.getMachineFunction(), FI, 0);
    let mut Stores: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut TypeByteSize: u32 = MemVT.getSizeInBits().operator unsigned long long() / 8;
    assert!(TypeByteSize > 0, "Vector element type too small for stack store!");
    let mut Truncate: bool = isa(Node) && MemVT.bitsLT(Node.getOperand(0).getValueType());
    for let mut i: u32 = 0;
let mut e: u32 = Node.getNumOperands(); i != e; i += 1 {
        if Node.getOperand(i).isUndef() {
            continue;
        }
        let mut Offset: u32 = TypeByteSize * i;
        let mut Idx: SDValue = self.DAG.getMemBasePlusOffset(FIPtr, getFixed(Offset), dl, SDNodeFlags { Flags: None });
        if Truncate {
            Stores.push(self.DAG.getTruncStore(self.DAG.getEntryNode(), dl, Node.getOperand(i), Idx, PtrInfo.getWithOffset(Offset), MemVT, MaybeAlign {}, MONone, MMOMetadata {}));
        } else {
            Stores.push(self.DAG.getStore(self.DAG.getEntryNode(), dl, Node.getOperand(i), Idx, PtrInfo.getWithOffset(Offset), MaybeAlign {}, MONone, MMOMetadata {}));
        }
    }
    let mut StoreChain: SDValue = SDValue {};
    if !Stores.is_empty() {
        StoreChain = self.DAG.getNode(TokenFactor, dl, EVT { Other }, ArrayRef<SDValue> { Stores });
    } else {
        StoreChain = self.DAG.getEntryNode();
    }
    return self.DAG.getLoad(VT, dl, StoreChain, FIPtr, PtrInfo, MaybeAlign {}, MONone, MMOMetadata {});
}

fn SelectionDAGLegalize::getSignAsIntValue(self: *SelectionDAGLegalize, State: *mut FloatSignAsInt, DL: *SDLoc, Value: SDValue) {
    let mut FloatVT: EVT = Value.getValueType();
    let mut NumBits: u32 = FloatVT.getScalarSizeInBits();
    State.FloatVT = FloatVT;
    let mut IVT: EVT = getIntegerVT(*self.DAG.getContext(), NumBits);
    if self.TLI.isTypeLegal(IVT) {
        State.IntValue = self.DAG.getNode(BITCAST, DL, IVT, Value);
        State.SignMask = getSignMask(NumBits);
        State.SignBit = NumBits - 1;
        return;
    }
    let mut DataLayout: *DataLayout = self.DAG.getDataLayout();
    let mut LoadTy: MVT = self.TLI.getRegisterType(*self.DAG.getContext(), EVT { i8 });
    let mut StackPtr: SDValue = self.DAG.CreateStackTemporary(FloatVT, EVT { LoadTy });
    let mut FI: i32 = cast(StackPtr.getNode()).getIndex();
    State.FloatPtr = StackPtr;
    let mut MF: *mut MachineFunction = self.DAG.getMachineFunction();
    State.FloatPointerInfo = getFixedStack(MF, FI, 0);
    State.Chain = self.DAG.getStore(self.DAG.getEntryNode(), DL, Value, State.FloatPtr, State.FloatPointerInfo, MaybeAlign {}, MONone, MMOMetadata {});
    let mut IntPtr: SDValue = SDValue {};
    if DataLayout.isBigEndian() {
        assert!(FloatVT.isByteSized(), "Unsupported floating point type!");
        IntPtr = StackPtr;
        State.IntPointerInfo = State.FloatPointerInfo;
    } else {
        let mut ByteOffset: u32 = (NumBits / 8) - 1;
        IntPtr = self.DAG.getMemBasePlusOffset(StackPtr, getFixed(ByteOffset), DL, SDNodeFlags { Flags: None });
        State.IntPointerInfo = getFixedStack(MF, FI, ByteOffset);
    }
    State.IntPtr = IntPtr;
    State.IntValue = self.DAG.getExtLoad(EXTLOAD, DL, EVT { LoadTy }, State.Chain, IntPtr, State.IntPointerInfo, EVT { i8 }, MaybeAlign {}, MONone, MMOMetadata {});
    State.SignMask = getOneBitSet(LoadTy.getScalarSizeInBits(), 7);
    State.SignBit = 7;
}

fn SelectionDAGLegalize::modifySignAsInt(self: *SelectionDAGLegalize, State: *FloatSignAsInt, DL: *SDLoc, NewIntValue: SDValue) -> SDValue {
    if !State.Chain {
        return self.DAG.getNode(BITCAST, DL, State.FloatVT, NewIntValue);
    }
    let mut Chain: SDValue = self.DAG.getTruncStore(State.Chain, DL, NewIntValue, State.IntPtr, State.IntPointerInfo, EVT { i8 }, MaybeAlign {}, MONone, MMOMetadata {});
    return self.DAG.getLoad(State.FloatVT, DL, Chain, State.FloatPtr, State.FloatPointerInfo, MaybeAlign {}, MONone, MMOMetadata {});
}

fn SelectionDAGLegalize::ExpandFCOPYSIGN(self: *SelectionDAGLegalize, Node: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { Node };
    let mut Mag: SDValue = Node.getOperand(0);
    let mut Sign: SDValue = Node.getOperand(1);
    if Sign.getValueType().isVector() {
        return self.DAG.UnrollVectorOp(Node, 0);
    }
    let mut SignAsInt: FloatSignAsInt = FloatSignAsInt {};
    self.getSignAsIntValue(SignAsInt, DL, Sign);
    let mut IntVT: EVT = SignAsInt.IntValue.getValueType();
    let mut SignMask: SDValue = self.DAG.getConstant(SignAsInt.SignMask, DL, IntVT, false, false);
    let mut SignBit: SDValue = self.DAG.getNode(AND, DL, IntVT, SignAsInt.IntValue, SignMask);
    let mut FloatVT: EVT = Mag.getValueType();
    if self.TLI.isOperationLegalOrCustom(FABS, FloatVT, false) && self.TLI.isOperationLegalOrCustom(FNEG, FloatVT, false) {
        let mut AbsValue: SDValue = self.DAG.getNode(FABS, DL, FloatVT, Mag);
        let mut NegValue: SDValue = self.DAG.getNode(FNEG, DL, FloatVT, AbsValue);
        let mut Cond: SDValue = self.DAG.getSetCC(DL, self.getSetCCResultType(IntVT), SignBit, self.DAG.getConstant(0, DL, IntVT, false, false), SETNE, SDValue {}, false, SDNodeFlags { Flags: None });
        return self.DAG.getSelect(DL, FloatVT, Cond, NegValue, AbsValue, SDNodeFlags { Flags: None });
    }
    let mut MagAsInt: FloatSignAsInt = FloatSignAsInt {};
    self.getSignAsIntValue(MagAsInt, DL, Mag);
    let mut MagVT: EVT = MagAsInt.IntValue.getValueType();
    let mut ClearSignMask: SDValue = self.DAG.getConstant(operator(MagAsInt.SignMask), DL, MagVT, false, false);
    let mut ClearedSign: SDValue = self.DAG.getNode(AND, DL, MagVT, MagAsInt.IntValue, ClearSignMask);
    let mut ShiftAmount: i32 = SignAsInt.SignBit - MagAsInt.SignBit;
    let mut ShiftVT: EVT = IntVT;
    if SignBit.getScalarValueSizeInBits() < ClearedSign.getScalarValueSizeInBits() {
        SignBit = self.DAG.getNode(ZERO_EXTEND, DL, MagVT, SignBit);
        ShiftVT = MagVT;
    }
    if ShiftAmount > 0 {
        let mut ShiftCnst: SDValue = self.DAG.getConstant(ShiftAmount, DL, ShiftVT, false, false);
        SignBit = self.DAG.getNode(SRL, DL, ShiftVT, SignBit, ShiftCnst);
    } else if ShiftAmount < 0 {
        let mut ShiftCnst: SDValue = self.DAG.getConstant(-ShiftAmount, DL, ShiftVT, false, false);
        SignBit = self.DAG.getNode(SHL, DL, ShiftVT, SignBit, ShiftCnst);
    }
    if SignBit.getScalarValueSizeInBits() > ClearedSign.getScalarValueSizeInBits() {
        SignBit = self.DAG.getNode(TRUNCATE, DL, MagVT, SignBit);
    }
    let mut CopiedSign: SDValue = self.DAG.getNode(OR, DL, MagVT, ClearedSign, SignBit, SDNodeFlags { Flags: Disjoint });
    return self.modifySignAsInt(MagAsInt, DL, CopiedSign);
}

fn SelectionDAGLegalize::ExpandFNEG(self: *SelectionDAGLegalize, Node: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { Node };
    if Node.getValueType(0).isVector() {
        return self.DAG.UnrollVectorOp(Node, 0);
    }
    let mut SignAsInt: FloatSignAsInt = FloatSignAsInt {};
    self.getSignAsIntValue(SignAsInt, DL, Node.getOperand(0));
    let mut IntVT: EVT = SignAsInt.IntValue.getValueType();
    let mut SignMask: SDValue = self.DAG.getConstant(SignAsInt.SignMask, DL, IntVT, false, false);
    let mut SignFlip: SDValue = self.DAG.getNode(XOR, DL, IntVT, SignAsInt.IntValue, SignMask);
    return self.modifySignAsInt(SignAsInt, DL, SignFlip);
}

fn SelectionDAGLegalize::ExpandFABS(self: *SelectionDAGLegalize, Node: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { Node };
    let mut Value: SDValue = Node.getOperand(0);
    let mut FloatVT: EVT = Value.getValueType();
    if self.TLI.isOperationLegalOrCustom(FCOPYSIGN, FloatVT, false) {
        let mut Zero: SDValue = self.DAG.getConstantFP(0.0, DL, FloatVT, false);
        return self.DAG.getNode(FCOPYSIGN, DL, FloatVT, Value, Zero);
    }
    if FloatVT.isVector() {
        return self.DAG.UnrollVectorOp(Node, 0);
    }
    let mut ValueAsInt: FloatSignAsInt = FloatSignAsInt {};
    self.getSignAsIntValue(ValueAsInt, DL, Value);
    let mut IntVT: EVT = ValueAsInt.IntValue.getValueType();
    let mut ClearSignMask: SDValue = self.DAG.getConstant(operator(ValueAsInt.SignMask), DL, IntVT, false, false);
    let mut ClearedSign: SDValue = self.DAG.getNode(AND, DL, IntVT, ValueAsInt.IntValue, ClearSignMask);
    return self.modifySignAsInt(ValueAsInt, DL, ClearedSign);
}

fn SelectionDAGLegalize::ExpandDYNAMIC_STACKALLOC(self, Node: *mut SDNode, Results: *mut SmallVectorImpl<SDValue>) {
    let mut SPReg: Register = self.TLI.getStackPointerRegisterToSaveRestore();
    assert!(SPReg.operator unsigned int(), "Target cannot require DYNAMIC_STACKALLOC expansion and not tell us which reg is the stack pointer!");
    let mut dl: SDLoc = SDLoc { Node };
    let mut VT: EVT = Node.getValueType(0);
    let mut Tmp1: SDValue = SDValue { Node: Node, ResNo: 0 };
    let mut Tmp2: SDValue = SDValue { Node: Node, ResNo: 1 };
    let mut Tmp3: SDValue = Node.getOperand(2);
    let mut Chain: SDValue = Tmp1.getOperand(0);
    Chain = self.DAG.getCALLSEQ_START(Chain, 0, 0, dl);
    let mut Size: SDValue = Tmp2.getOperand(1);
    let mut SP: SDValue = self.DAG.getCopyFromReg(Chain, dl, SPReg, VT);
    Chain = SP.getValue(1);
    let mut Alignment: Align = cast(Tmp3).getAlignValue();
    let mut TFL: *TargetFrameLowering = self.DAG.getSubtarget().getFrameLowering();
    let mut Opc: u32 = if TFL.getStackGrowthDirection() == StackGrowsUp { ADD } else { SUB };
    let mut StackAlign: Align = TFL.getStackAlign();
    Tmp1 = self.DAG.getNode(Opc, dl, VT, SP, Size);
    if Alignment > StackAlign {
        Tmp1 = self.DAG.getNode(AND, dl, VT, Tmp1, self.DAG.getSignedConstant(-Alignment.value(), dl, VT, false, false));
    }
    Chain = self.DAG.getCopyToReg(Chain, dl, SPReg, Tmp1);
    Tmp2 = self.DAG.getCALLSEQ_END(Chain, 0, 0, SDValue {}, dl);
    Results.push(ValueParamT { Tmp1 });
    Results.push(ValueParamT { Tmp2 });
}

fn SelectionDAGLegalize::EmitStackConvert(self, SrcOp: SDValue, SlotVT: EVT, DestVT: EVT, dl: *SDLoc) -> SDValue {
    return self.EmitStackConvert(SrcOp, SlotVT, DestVT, dl, self.DAG.getEntryNode());
}

fn SelectionDAGLegalize::EmitStackConvert(self, SrcOp: SDValue, SlotVT: EVT, DestVT: EVT, dl: *SDLoc, Chain: SDValue) -> SDValue {
    let mut SrcVT: EVT = SrcOp.getValueType();
    let mut DestType: *mut Type = DestVT.getTypeForEVT(*self.DAG.getContext());
    let mut DestAlign: Align = self.DAG.getDataLayout().getPrefTypeAlign(DestType);
    if (SrcVT.bitsGT(SlotVT) && !self.TLI.isTruncStoreLegalOrCustom(SrcVT, SlotVT, DestAlign, self.DAG.getDataLayout().getAllocaAddrSpace())) || (SlotVT.bitsLT(DestVT) && !self.TLI.isLoadLegalOrCustom(DestVT, SlotVT, DestAlign, self.DAG.getDataLayout().getAllocaAddrSpace(), EXTLOAD, false)) {
        return SDValue {};
    }
    return self.DAG.emitStackConvert(SrcOp, SlotVT, DestVT, dl, Chain);
}

fn SelectionDAGLegalize::ExpandSCALAR_TO_VECTOR(self, Node: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { Node };
    let mut StackPtr: SDValue = self.DAG.CreateStackTemporary(Node.getValueType(0), 1);
    let mut StackPtrFI: *mut FrameIndexSDNode = cast(StackPtr);
    let mut SPFI: i32 = StackPtrFI.getIndex();
    let mut Ch: SDValue = self.DAG.getTruncStore(self.DAG.getEntryNode(), dl, Node.getOperand(0), StackPtr, getFixedStack(self.DAG.getMachineFunction(), SPFI, 0), Node.getValueType(0).getVectorElementType(), MaybeAlign {}, MONone, MMOMetadata {});
    return self.DAG.getLoad(Node.getValueType(0), dl, Ch, StackPtr, getFixedStack(self.DAG.getMachineFunction(), SPFI, 0), MaybeAlign {}, MONone, MMOMetadata {});
}

fn ExpandBVWithShuffles(Node: *mut SDNode, DAG: *mut SelectionDAG, TLI: *TargetLowering, Res: *mut SDValue) -> bool {
    let mut NumElems: u32 = Node.getNumOperands();
    let mut dl: SDLoc = SDLoc { Node };
    let mut VT: EVT = Node.getValueType(0);
    for let mut Phase: i32 = 0; Phase < 2; Phase += 1 {
        let mut IntermedVals: pair<SDValue, SmallVector<int, 16>>, 16> = pair<SDValue, SmallVector<int, 16>>, 16> {};
        let mut NewIntermedVals: pair<SDValue, SmallVector<int, 16>>, 16> = pair<SDValue, SmallVector<int, 16>>, 16> {};
        for let mut i: u32 = 0; i < NumElems; i += 1 {
            let mut V: SDValue = Node.getOperand(i);
            if V.isUndef() {
                continue;
            }
            let mut Vec: SDValue = SDValue {};
            if Phase {
                Vec = DAG.getNode(SCALAR_TO_VECTOR, dl, VT, V);
            }
            IntermedVals.push(make_pair(Vec, SmallVector<int, 16> { 1, i }));
        }
        while IntermedVals.len > 2 {
            NewIntermedVals.clear();
            for let mut i: u32 = 0;
let mut e: u32 = (IntermedVals.len & ~1); i < e; i += 2 {
                let mut ShuffleVec: SmallVector<int, 16> = SmallVector<int, 16> { NumElems, -1 };
                let mut FinalIndices: SmallVector<int, 16> = SmallVector<int, 16> {};
                FinalIndices.reserve(IntermedVals[i].second.len + IntermedVals[i + 1].second.len);
                let mut k: i32 = 0;
                for let mut j: u32 = 0;
let mut f: u32 = IntermedVals[i].second.len; j != f; j += 1 , k += 1 {
                    ShuffleVec[k] = j;
                    FinalIndices.push(IntermedVals[i].second[j]);
                }
                for let mut j: u32 = 0;
let mut f: u32 = IntermedVals[i + 1].second.len; j != f; j += 1 , k += 1 {
                    ShuffleVec[k] = NumElems + j;
                    FinalIndices.push(IntermedVals[i + 1].second[j]);
                }
                let mut Shuffle: SDValue = SDValue {};
                if Phase {
                    Shuffle = DAG.getVectorShuffle(VT, dl, IntermedVals[i].first, IntermedVals[i + 1].first, ArrayRef<int> { ShuffleVec });
                } else if !TLI.isShuffleMaskLegal(ArrayRef<int> { ShuffleVec }, VT) {
                    return false;
                }
                NewIntermedVals.push(make_pair(Shuffle, move(FinalIndices)));
            }
            if (IntermedVals.len & 1) != 0 {
                NewIntermedVals.push(IntermedVals.back());
            }
            IntermedVals.swap(NewIntermedVals);
        }
        assert!(IntermedVals.len <= 2 && IntermedVals.len > 0, "Invalid number of intermediate vectors");
        let mut Vec1: SDValue = IntermedVals[0].first;
        let mut Vec2: SDValue = SDValue {};
        if IntermedVals.len > 1 {
            Vec2 = IntermedVals[1].first;
        } else if Phase {
            Vec2 = DAG.getPOISON(VT);
        }
        let mut ShuffleVec: SmallVector<int, 16> = SmallVector<int, 16> { NumElems, -1 };
        for let mut i: u32 = 0;
let mut e: u32 = IntermedVals[0].second.len; i != e; i += 1 {
            ShuffleVec[IntermedVals[0].second[i]] = i;
        }
        for let mut i: u32 = 0;
let mut e: u32 = IntermedVals[1].second.len; i != e; i += 1 {
            ShuffleVec[IntermedVals[1].second[i]] = NumElems + i;
        }
        if Phase {
            Res = DAG.getVectorShuffle(VT, dl, Vec1, Vec2, ArrayRef<int> { ShuffleVec });
        } else if !TLI.isShuffleMaskLegal(ArrayRef<int> { ShuffleVec }, VT) {
            return false;
        }
    }
    return true;
}

fn SelectionDAGLegalize::ExpandBUILD_VECTOR(self, Node: *mut SDNode) -> SDValue {
    let mut NumElems: u32 = Node.getNumOperands();
    let mut Value1: SDValue = SDValue {};
    let mut Value2: SDValue = SDValue {};
    let mut dl: SDLoc = SDLoc { Node };
    let mut VT: EVT = Node.getValueType(0);
    let mut OpVT: EVT = Node.getOperand(0).getValueType();
    let mut EltVT: EVT = VT.getVectorElementType();
    let mut isOnlyLowElement: bool = true;
    let mut MoreThanTwoValues: bool = false;
    let mut isConstant: bool = true;
    for let mut i: u32 = 0; i < NumElems; i += 1 {
        let mut V: SDValue = Node.getOperand(i);
        if V.isUndef() {
            continue;
        }
        if i > 0 {
            isOnlyLowElement = false;
        }
        if !isa(V) && !isa(V) {
            isConstant = false;
        }
        if !Value1.getNode() {
            Value1 = V;
        } else if !Value2.getNode() {
            if V != Value1 {
                Value2 = V;
            }
        } else if V != Value1 && V != Value2 {
            MoreThanTwoValues = true;
        }
    }
    if !Value1.getNode() {
        return self.DAG.getUNDEF(VT);
    }
    if isOnlyLowElement {
        return self.DAG.getNode(SCALAR_TO_VECTOR, dl, VT, Node.getOperand(0));
    }
    if isConstant {
        let mut CV: SmallVector<Constant *, 16> = SmallVector<Constant *, 16> {};
        for let mut i: u32 = 0;
let mut e: u32 = NumElems; i != e; i += 1 {
            if dyn_cast(Node.getOperand(i)) {
                V;
            } else {
                CV.push(V.getConstantFPValue());
            }
        }
        let mut CP: *mut Constant = get(ArrayRef<Constant *> { CV });
        let mut CPIdx: SDValue = self.DAG.getConstantPool(CP, EVT { self.TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, MaybeAlign { nullopt }, 0, false, 0);
        let mut Alignment: Align = cast(CPIdx).getAlign();
        return self.DAG.getLoad(VT, dl, self.DAG.getEntryNode(), CPIdx, getConstantPool(self.DAG.getMachineFunction()), MaybeAlign { Alignment }, MONone, MMOMetadata {});
    }
    let mut DefinedValues: SmallSet<SDValue, 16> = SmallSet<SDValue, 16> {};
    for let mut i: u32 = 0; i < NumElems; i += 1 {
        if Node.getOperand(i).isUndef() {
            continue;
        }
        DefinedValues.insert(Node.getOperand(i));
    }
    if self.TLI.shouldExpandBuildVectorWithShuffles(VT, DefinedValues.len) {
        if !MoreThanTwoValues {
            let mut ShuffleVec: SmallVector<int, 8> = SmallVector<int, 8> { NumElems, -1 };
            for let mut i: u32 = 0; i < NumElems; i += 1 {
                let mut V: SDValue = Node.getOperand(i);
                if V.isUndef() {
                    continue;
                }
                ShuffleVec[i] = if V == Value1 { 0 } else { NumElems };
            }
            if self.TLI.isShuffleMaskLegal(ArrayRef<int> { ShuffleVec }, Node.getValueType(0)) {
                let mut Vec1: SDValue = self.DAG.getNode(SCALAR_TO_VECTOR, dl, VT, Value1);
                let mut Vec2: SDValue = SDValue {};
                if Value2.getNode() {
                    Vec2 = self.DAG.getNode(SCALAR_TO_VECTOR, dl, VT, Value2);
                } else {
                    Vec2 = self.DAG.getPOISON(VT);
                }
                return self.DAG.getVectorShuffle(VT, dl, Vec1, Vec2, ArrayRef<int> { ShuffleVec });
            }
        } else {
            let mut Res: SDValue = SDValue {};
            if ExpandBVWithShuffles(Node, self.DAG, self.TLI, Res) {
                return Res;
            }
        }
    }
    return self.ExpandVectorBuildThroughStack(Node);
}

fn SelectionDAGLegalize::ExpandSPLAT_VECTOR(self, Node: *mut SDNode) -> SDValue {
    let mut DL: SDLoc = SDLoc { Node };
    let mut VT: EVT = Node.getValueType(0);
    let mut SplatVal: SDValue = Node.getOperand(0);
    return self.DAG.getSplatBuildVector(VT, DL, SplatVal);
}

fn SelectionDAGLegalize::ExpandLibCall(self, LC: Libcall, Node: *mut SDNode, Args: *mut *mut ArgListTy, IsSigned: bool, RetVT: EVT) -> pair<SDValue, SDValue> {
    let mut CodePtrTy: EVT = EVT { self.TLI.getPointerTy(self.DAG.getDataLayout(), 0) };
    let mut Callee: SDValue = SDValue {};
    let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if LCImpl != Unsupported {
        Callee = self.DAG.getExternalSymbol(LCImpl, CodePtrTy);
    } else {
        Callee = self.DAG.getPOISON(CodePtrTy);
        self.DAG.getContext().emitError("no libcall available for " + Node.getOperationName(&mut self.DAG));
    }
    let mut RetTy: *mut Type = RetVT.getTypeForEVT(*self.DAG.getContext());
    let mut InChain: SDValue = self.DAG.getEntryNode();
    let mut TCChain: SDValue = InChain;
    let mut F: *Function = self.DAG.getMachineFunction().getFunction();
    let mut isTailCall: bool = self.TLI.isInTailCallPosition(self.DAG, Node, TCChain) && (RetTy == F.getReturnType() || F.getReturnType().isVoidTy()) && !self.DAG.hasSwiftErrorArg();
    if isTailCall {
        InChain = TCChain;
    }
    let mut CLI: CallLoweringInfo = CallLoweringInfo { self.DAG };
    let mut signExtend: bool = self.TLI.shouldSignExtendTypeInLibCall(RetTy, IsSigned);
    CLI.setDebugLoc(SDLoc { Node }).setChain(InChain).setLibCallee(self.DAG.getLibcalls().getLibcallImplCallingConv(LCImpl), RetTy, Callee, move(Args)).setTailCall(isTailCall).setSExtResult(signExtend).setZExtResult(!signExtend).setIsPostTypeLegalization(true);
    let mut CallInfo: pair<SDValue, SDValue> = self.TLI.LowerCallTo(CLI);
    if !CallInfo.second.getNode() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("legalizedag", 1) {
                dbgs() << "Created tailcall: ";
                self.DAG.getRoot().dump(&mut self.DAG);
            }
        }
            if !(false) { break; }
        }
        return pair<SDValue, SDValue> { self.DAG.getRoot(), self.DAG.getRoot() };
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalizedag", 1) {
            dbgs() << "Created libcall: ";
            CallInfo.first.dump(&mut self.DAG);
        }
    }
        if !(false) { break; }
    }
    return CallInfo;
}

fn SelectionDAGLegalize::ExpandLibCall(self, LC: Libcall, Node: *mut SDNode, isSigned: bool) -> pair<SDValue, SDValue> {
    let mut Args: ArgListTy = ArgListTy {};
    for Op in Node.op_values() {
        let mut ArgVT: EVT = Op.getValueType();
        let mut ArgTy: *mut Type = ArgVT.getTypeForEVT(*self.DAG.getContext());
        let mut Entry: ArgListEntry = ArgListEntry { Op, ArgTy };
        Entry.IsSExt = self.TLI.shouldSignExtendTypeInLibCall(ArgTy, isSigned);
        Entry.IsZExt = !Entry.IsSExt;
        Args.push(Entry);
    }
    return self.ExpandLibCall(LC, Node, move(Args), isSigned, Node.getValueType(0));
}

fn SelectionDAGLegalize::ExpandFPLibCall(self, Node: *mut SDNode, LC: Libcall, Results: *mut SmallVectorImpl<SDValue>) {
    if LC == UNKNOWN_LIBCALL {
        llvm_unreachable_internal("Can't create an unknown libcall!", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeDAG.cpp", 2193);
    }
    if Node.isStrictFPOpcode() {
        let mut RetVT: EVT = Node.getValueType(0);
        let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
        if LCImpl == Unsupported {
            self.DAG.getContext().emitError("no libcall available for " + Node.getOperationName(&mut self.DAG));
            Results.push(self.DAG.getPOISON(RetVT));
            Results.push(ValueParamT { Node.getOperand(0) });
            return;
        }
        let mut Ops: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { drop_begin(Node.ops(), 1) };
        let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
        CallOptions.IsPostTypeLegalization = true;
        let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, LCImpl, RetVT, ArrayRef<SDValue> { Ops }, CallOptions, SDLoc { Node }, Node.getOperand(0));
        Results.push(ValueParamT { Tmp.first });
        Results.push(ValueParamT { Tmp.second });
    } else {
        let mut IsSignedArgument: bool = Node.getOpcode() == FLDEXP;
        let mut Tmp: SDValue = self.ExpandLibCall(LC, Node, IsSignedArgument).first;
        Results.push(ValueParamT { Tmp });
    }
}

fn SelectionDAGLegalize::ExpandFastFPLibCall(self, Node: *mut SDNode, IsFast: bool, Call_F32: Libcall>, Call_F64: Libcall>, Call_F80: Libcall>, Call_F128: Libcall>, Call_PPCF128: Libcall>, Results: *mut SmallVectorImpl<SDValue>) {
    let mut VT: EVT = EVT { Node.getSimpleValueType(0) };
    let mut LC: Libcall = zeroed();
    if IsFast {
        LC = getFPLibCall(VT, Call_F32.first, Call_F64.first, Call_F80.first, Call_F128.first, Call_PPCF128.first);
    }
    if !IsFast || self.DAG.getLibcalls().getLibcallImpl(LC) == Unsupported {
        LC = getFPLibCall(VT, Call_F32.second, Call_F64.second, Call_F80.second, Call_F128.second, Call_PPCF128.second);
    }
    self.ExpandFPLibCall(Node, LC, Results);
}

fn SelectionDAGLegalize::ExpandIntLibCall(self, Node: *mut SDNode, isSigned: bool, Call_I8: Libcall, Call_I16: Libcall, Call_I32: Libcall, Call_I64: Libcall, Call_I128: Libcall) -> SDValue {
    let mut LC: Libcall = zeroed();
    match Node.getSimpleValueType(0).SimpleTy {
        _ => {
            llvm_unreachable_internal("Unexpected request for libcall!", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeDAG.cpp", 2260);
        },
        i8 => {
            LC = Call_I8;
        },
        i16 => {
            LC = Call_I16;
        },
        i32 => {
            LC = Call_I32;
        },
        i64 => {
            LC = Call_I64;
        },
        i128 => {
            LC = Call_I128;
        },
    }
    return self.ExpandLibCall(LC, Node, isSigned).first;
}

fn SelectionDAGLegalize::ExpandArgFPLibCall(self, Node: *mut SDNode, Call_F32: Libcall, Call_F64: Libcall, Call_F80: Libcall, Call_F128: Libcall, Call_PPCF128: Libcall, Results: *mut SmallVectorImpl<SDValue>) {
    let mut InVT: EVT = Node.getOperand(if Node.isStrictFPOpcode() { 1 } else { 0 }).getValueType();
    let mut LC: Libcall = getFPLibCall(EVT { InVT.getSimpleVT() }, Call_F32, Call_F64, Call_F80, Call_F128, Call_PPCF128);
    self.ExpandFPLibCall(Node, LC, Results);
}

fn SelectionDAGLegalize::ExpandBitCountingLibCall(self, Node: *mut SDNode, CallI32: Libcall, CallI64: Libcall, CallI128: Libcall) -> SDValue {
    let mut LC: Libcall = zeroed();
    match Node.getSimpleValueType(0).SimpleTy {
        _ => {
            llvm_unreachable_internal("Unexpected request for libcall!", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeDAG.cpp", 2292);
        },
        i32 => {
            LC = CallI32;
        },
        i64 => {
            LC = CallI64;
        },
        i128 => {
            LC = CallI128;
        },
    }
    let mut Op: SDValue = Node.getOperand(0);
    let mut IntVT: EVT = getIntegerVT(*self.DAG.getContext(), self.DAG.getLibInfo().getIntSize());
    let mut ArgVT: EVT = Op.getValueType();
    let mut ArgTy: *mut Type = ArgVT.getTypeForEVT(*self.DAG.getContext());
    let mut Arg: ArgListEntry = ArgListEntry { Op, ArgTy };
    Arg.IsSExt = self.TLI.shouldSignExtendTypeInLibCall(ArgTy, false);
    Arg.IsZExt = !Arg.IsSExt;
    let mut Res: SDValue = self.ExpandLibCall(LC, Node, ArgListTy { [Arg], ArgListEntry> {} }, true, IntVT).first;
    if Res.getValueType() != EVT { Other } {
        Res = self.DAG.getSExtOrTrunc(Res, SDLoc { Node }, Node.getValueType(0));
    }
    return Res;
}

fn SelectionDAGLegalize::ExpandDivRemLibCall(self, Node: *mut SDNode, Results: *mut SmallVectorImpl<SDValue>) {
    let mut Opcode: u32 = Node.getOpcode();
    let mut isSigned: bool = Opcode == SDIVREM;
    let mut LC: Libcall = zeroed();
    match Node.getSimpleValueType(0).SimpleTy {
        _ => {
            llvm_unreachable_internal("Unexpected request for libcall!", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeDAG.cpp", 2337);
        },
        i8 => {
            LC = if isSigned { SDIVREM_I8 } else { UDIVREM_I8 };
        },
        i16 => {
            LC = if isSigned { SDIVREM_I16 } else { UDIVREM_I16 };
        },
        i32 => {
            LC = if isSigned { SDIVREM_I32 } else { UDIVREM_I32 };
        },
        i64 => {
            LC = if isSigned { SDIVREM_I64 } else { UDIVREM_I64 };
        },
        i128 => {
            LC = if isSigned { SDIVREM_I128 } else { UDIVREM_I128 };
        },
    }
    let mut InChain: SDValue = self.DAG.getEntryNode();
    let mut RetVT: EVT = Node.getValueType(0);
    let mut RetTy: *mut Type = RetVT.getTypeForEVT(*self.DAG.getContext());
    let mut Args: ArgListTy = ArgListTy {};
    for Op in Node.op_values() {
        let mut ArgVT: EVT = Op.getValueType();
        let mut ArgTy: *mut Type = ArgVT.getTypeForEVT(*self.DAG.getContext());
        let mut Entry: ArgListEntry = ArgListEntry { Op, ArgTy };
        Entry.IsSExt = isSigned;
        Entry.IsZExt = !isSigned;
        Args.push(Entry);
    }
    let mut FIPtr: SDValue = self.DAG.CreateStackTemporary(RetVT, 1);
    let mut Entry: ArgListEntry = ArgListEntry { FIPtr, getUnqual(RetTy.getContext()) };
    Entry.IsSExt = isSigned;
    Entry.IsZExt = !isSigned;
    Args.push(Entry);
    let mut LibcallImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if LibcallImpl == Unsupported {
        self.DAG.getContext().emitError("no libcall available for " + Node.getOperationName(&mut self.DAG));
        let mut Poison: SDValue = self.DAG.getPOISON(RetVT);
        Results.push(ValueParamT { Poison });
        Results.push(ValueParamT { Poison });
        return;
    }
    let mut Callee: SDValue = self.DAG.getExternalSymbol(LibcallImpl, EVT { self.TLI.getPointerTy(self.DAG.getDataLayout(), 0) });
    let mut dl: SDLoc = SDLoc { Node };
    let mut CLI: CallLoweringInfo = CallLoweringInfo { self.DAG };
    CLI.setDebugLoc(dl).setChain(InChain).setLibCallee(self.DAG.getLibcalls().getLibcallImplCallingConv(LibcallImpl), RetTy, Callee, move(Args)).setSExtResult(isSigned).setZExtResult(!isSigned);
    let mut CallInfo: pair<SDValue, SDValue> = self.TLI.LowerCallTo(CLI);
    let mut FI: i32 = cast(FIPtr).getIndex();
    let mut PtrInfo: MachinePointerInfo = getFixedStack(self.DAG.getMachineFunction(), FI, 0);
    let mut Rem: SDValue = self.DAG.getLoad(RetVT, dl, CallInfo.second, FIPtr, PtrInfo, MaybeAlign {}, MONone, MMOMetadata {});
    Results.push(ValueParamT { CallInfo.first });
    Results.push(ValueParamT { Rem });
}

fn isSinCosLibcallAvailable(Node: *mut SDNode, Libcalls: *LibcallLoweringInfo) -> bool {
    let mut VT: SimpleValueType = Node.getSimpleValueType(0).SimpleTy;
    return Libcalls.getLibcallImpl(getSINCOS(EVT { VT })) != Unsupported || Libcalls.getLibcallImpl(getSINCOS_STRET(EVT { VT })) != Unsupported;
}

fn useSinCos(Node: *mut SDNode) -> bool {
    let mut OtherOpcode: u32 = if Node.getOpcode() == FSIN { FCOS } else { FSIN };
    let mut Op0: SDValue = Node.getOperand(0);
    for User in Op0.getNode().users() {
        if User == Node {
            continue;
        }
        if User.getOpcode() == OtherOpcode || User.getOpcode() == FSINCOS {
            return true;
        }
    }
    return false;
}

fn SelectionDAGLegalize::ExpandSincosStretLibCall(self: *SelectionDAGLegalize, Node: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { Node };
    let mut Arg: SDValue = Node.getOperand(0);
    let mut ArgVT: EVT = Arg.getValueType();
    let mut LC: Libcall = getSINCOS_STRET(ArgVT);
    let mut SincosStret: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if SincosStret == Unsupported {
        return SDValue {};
    }
    let mut CallsInfo: *RuntimeLibcallsInfo = self.TLI.getRuntimeLibcallsInfo();
    let mut DL: *DataLayout = self.DAG.getDataLayout();
    let mut SincosStretRetTy: *mut Type = FuncTy.getReturnType();
    let mut CallConv: ID = CallsInfo.getLibcallImplCallingConv(SincosStret);
    let mut Callee: SDValue = self.DAG.getExternalSymbol(SincosStret, EVT { self.TLI.getProgramPointerTy(DL) });
    let mut Args: ArgListTy = ArgListTy {};
    let mut SRet: SDValue = SDValue {};
    let mut FrameIdx: i32 = 0;
    if FuncTy.getParamType(0).isPointerTy() {
        let mut MFI: *mut MachineFrameInfo = self.DAG.getMachineFunction().getFrameInfo();
        let mut PtrAttrs: AttributeSet = FuncAttrs.getParamAttrs(0);
        let mut StructTy: *mut Type = PtrAttrs.getStructRetType();
        let mut ByteSize: u64 = DL.getTypeAllocSize(StructTy).operator unsigned long long();
        let mut StackAlign: Align = DL.getPrefTypeAlign(StructTy);
        FrameIdx = MFI.CreateStackObject(ByteSize, StackAlign, false, null, 0);
        SRet = self.DAG.getFrameIndex(FrameIdx, EVT { self.TLI.getFrameIndexTy(DL) }, false);
        let mut Entry: ArgListEntry = ArgListEntry { SRet, FuncTy.getParamType(0) };
        Entry.IsSRet = true;
        Entry.IndirectType = StructTy;
        Entry.Alignment = MaybeAlign { StackAlign };
        Args.push(Entry);
        Args.emplace_back(Arg, FuncTy.getParamType(1));
    } else {
        Args.emplace_back(Arg, FuncTy.getParamType(0));
    }
    let mut CLI: CallLoweringInfo = CallLoweringInfo { self.DAG };
    CLI.setDebugLoc(dl).setChain(self.DAG.getEntryNode()).setLibCallee(CallConv, SincosStretRetTy, Callee, move(Args)).setIsPostTypeLegalization(true);
    let mut CallResult: pair<SDValue, SDValue> = self.TLI.LowerCallTo(CLI);
    if SRet {
        let mut PtrInfo: MachinePointerInfo = getFixedStack(self.DAG.getMachineFunction(), FrameIdx, 0);
        let mut LoadSin: SDValue = self.DAG.getLoad(ArgVT, dl, CallResult.second, SRet, PtrInfo, MaybeAlign {}, MONone, MMOMetadata {});
        let mut StoreSize: TypeSize = ArgVT.getStoreSize();
        let mut Add: SDValue = self.DAG.getObjectPtrOffset(dl, SRet, StoreSize);
        let mut LoadCos: SDValue = self.DAG.getLoad(ArgVT, dl, LoadSin.getValue(1), Add, PtrInfo.getWithOffset(StoreSize.operator unsigned long long()), MaybeAlign {}, MONone, MMOMetadata {});
        let mut Tys: SDVTList = self.DAG.getVTList(ArgVT, ArgVT);
        return self.DAG.getNode(MERGE_VALUES, dl, Tys, LoadSin.getValue(0), LoadCos.getValue(0));
    }
    if !CallResult.first.getValueType().isVector() {
        return CallResult.first;
    }
    let mut SinVal: SDValue = self.DAG.getNode(EXTRACT_VECTOR_ELT, dl, ArgVT, CallResult.first, self.DAG.getVectorIdxConstant(0, dl, false));
    let mut CosVal: SDValue = self.DAG.getNode(EXTRACT_VECTOR_ELT, dl, ArgVT, CallResult.first, self.DAG.getVectorIdxConstant(1, dl, false));
    let mut Tys: SDVTList = self.DAG.getVTList(ArgVT, ArgVT);
    return self.DAG.getNode(MERGE_VALUES, dl, Tys, SinVal, CosVal);
}

fn SelectionDAGLegalize::expandLdexp(self: *SelectionDAGLegalize, Node: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { Node };
    let mut VT: EVT = Node.getValueType(0);
    let mut X: SDValue = Node.getOperand(0);
    let mut N: SDValue = Node.getOperand(1);
    let mut ExpVT: EVT = N.getValueType();
    let mut AsIntVT: EVT = VT.changeTypeToInteger();
    if AsIntVT == EVT {} {
        return SDValue {};
    }
    if !self.TLI.isTypeLegal(AsIntVT) {
        return SDValue {};
    }
    if Node.getOpcode() == STRICT_FLDEXP {
        return SDValue {};
    }
    let mut NSW: SDNodeFlags = SDNodeFlags { Flags: None };
    NSW.setNoSignedWrap(true);
    let mut NUW_NSW: SDNodeFlags = SDNodeFlags { Flags: None };
    NUW_NSW.setNoUnsignedWrap(true);
    NUW_NSW.setNoSignedWrap(true);
    let mut SetCCVT: EVT = self.TLI.getSetCCResultType(self.DAG.getDataLayout(), *self.DAG.getContext(), ExpVT);
    let mut FltSem: *fltSemantics = VT.getFltSemantics();
    let mut MaxExpVal: ExponentType = semanticsMaxExponent(FltSem);
    let mut MinExpVal: ExponentType = semanticsMinExponent(FltSem);
    let mut Precision: i32 = semanticsPrecision(FltSem);
    let mut MaxExp: SDValue = self.DAG.getSignedConstant(MaxExpVal, dl, ExpVT, false, false);
    let mut MinExp: SDValue = self.DAG.getSignedConstant(MinExpVal, dl, ExpVT, false, false);
    let mut DoubleMaxExp: SDValue = self.DAG.getSignedConstant(2 * MaxExpVal, dl, ExpVT, false, false);
    let mut One: APFloat = APFloat { FltSem, "1.0" };
    let mut ScaleUpK: APFloat = scalbn(One, MaxExpVal, rmNearestTiesToEven);
    let mut ScaleDownK: APFloat = scalbn(One, MinExpVal + Precision, rmNearestTiesToEven);
    let mut NGtMaxExp: SDValue = self.DAG.getSetCC(dl, SetCCVT, N, MaxExp, SETGT, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut DecN0: SDValue = self.DAG.getNode(SUB, dl, ExpVT, N, MaxExp, NSW);
    let mut ClampMaxVal: SDValue = self.DAG.getConstant(3 * MaxExpVal, dl, ExpVT, false, false);
    let mut ClampN_Big: SDValue = self.DAG.getNode(SMIN, dl, ExpVT, N, ClampMaxVal);
    let mut DecN1: SDValue = self.DAG.getNode(SUB, dl, ExpVT, ClampN_Big, DoubleMaxExp, NSW);
    let mut ScaleUpTwice: SDValue = self.DAG.getSetCC(dl, SetCCVT, N, DoubleMaxExp, SETUGT, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut ScaleUpVal: SDValue = self.DAG.getConstantFP(ScaleUpK, dl, VT, false);
    let mut ScaleUp0: SDValue = self.DAG.getNode(FMUL, dl, VT, X, ScaleUpVal);
    let mut ScaleUp1: SDValue = self.DAG.getNode(FMUL, dl, VT, ScaleUp0, ScaleUpVal);
    let mut SelectN_Big: SDValue = self.DAG.getNode(SELECT, dl, ExpVT, ScaleUpTwice, DecN1, DecN0);
    let mut SelectX_Big: SDValue = self.DAG.getNode(SELECT, dl, VT, ScaleUpTwice, ScaleUp1, ScaleUp0);
    let mut NLtMinExp: SDValue = self.DAG.getSetCC(dl, SetCCVT, N, MinExp, SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut Increment0: SDValue = self.DAG.getConstant(-(MinExpVal + Precision), dl, ExpVT, false, false);
    let mut Increment1: SDValue = self.DAG.getConstant(-2 * (MinExpVal + Precision), dl, ExpVT, false, false);
    let mut IncN0: SDValue = self.DAG.getNode(ADD, dl, ExpVT, N, Increment0, NUW_NSW);
    let mut ClampMinVal: SDValue = self.DAG.getSignedConstant(3 * MinExpVal + 2 * Precision, dl, ExpVT, false, false);
    let mut ClampN_Small: SDValue = self.DAG.getNode(SMAX, dl, ExpVT, N, ClampMinVal);
    let mut IncN1: SDValue = self.DAG.getNode(ADD, dl, ExpVT, ClampN_Small, Increment1, NSW);
    let mut ScaleDownVal: SDValue = self.DAG.getConstantFP(ScaleDownK, dl, VT, false);
    let mut ScaleDown0: SDValue = self.DAG.getNode(FMUL, dl, VT, X, ScaleDownVal);
    let mut ScaleDown1: SDValue = self.DAG.getNode(FMUL, dl, VT, ScaleDown0, ScaleDownVal);
    let mut ScaleDownTwice: SDValue = self.DAG.getSetCC(dl, SetCCVT, N, self.DAG.getSignedConstant(2 * MinExpVal + Precision, dl, ExpVT, false, false), SETULT, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut SelectN_Small: SDValue = self.DAG.getNode(SELECT, dl, ExpVT, ScaleDownTwice, IncN1, IncN0);
    let mut SelectX_Small: SDValue = self.DAG.getNode(SELECT, dl, VT, ScaleDownTwice, ScaleDown1, ScaleDown0);
    let mut NewX: SDValue = self.DAG.getNode(SELECT, dl, VT, NGtMaxExp, SelectX_Big, self.DAG.getNode(SELECT, dl, VT, NLtMinExp, SelectX_Small, X));
    let mut NewN: SDValue = self.DAG.getNode(SELECT, dl, ExpVT, NGtMaxExp, SelectN_Big, self.DAG.getNode(SELECT, dl, ExpVT, NLtMinExp, SelectN_Small, N));
    let mut BiasedN: SDValue = self.DAG.getNode(ADD, dl, ExpVT, NewN, MaxExp, NSW);
    let mut ExponentShiftAmt: SDValue = self.DAG.getShiftAmountConstant(Precision - 1, ExpVT, dl);
    let mut CastExpToValTy: SDValue = self.DAG.getZExtOrTrunc(BiasedN, dl, AsIntVT);
    let mut AsInt: SDValue = self.DAG.getNode(SHL, dl, AsIntVT, CastExpToValTy, ExponentShiftAmt, NUW_NSW);
    let mut AsFP: SDValue = self.DAG.getNode(BITCAST, dl, VT, AsInt);
    return self.DAG.getNode(FMUL, dl, VT, NewX, AsFP);
}

fn SelectionDAGLegalize::expandFrexp(self: *SelectionDAGLegalize, Node: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { Node };
    let mut Val: SDValue = Node.getOperand(0);
    let mut VT: EVT = Val.getValueType();
    let mut ExpVT: EVT = Node.getValueType(1);
    let mut AsIntVT: EVT = VT.changeTypeToInteger();
    if AsIntVT == EVT {} {
        return SDValue {};
    }
    if !self.TLI.isTypeLegal(AsIntVT) {
        return SDValue {};
    }
    let mut FltSem: *fltSemantics = VT.getFltSemantics();
    let mut MinExpVal: ExponentType = semanticsMinExponent(FltSem);
    let mut Precision: u32 = semanticsPrecision(FltSem);
    let mut BitSize: u32 = VT.getScalarSizeInBits();
    let mut NegSmallestNormalizedInt: SDValue = self.DAG.getConstant(getSmallestNormalized(FltSem, true).bitcastToAPInt(), dl, AsIntVT, false, false);
    let mut SmallestNormalizedInt: SDValue = self.DAG.getConstant(getSmallestNormalized(FltSem, false).bitcastToAPInt(), dl, AsIntVT, false, false);
    let mut ExpMask: SDValue = self.DAG.getConstant(getInf(FltSem, false).bitcastToAPInt(), dl, AsIntVT, false, false);
    let mut FractSignMaskVal: APInt = getBitsSet(BitSize, 0, Precision - 1);
    FractSignMaskVal.setBit(BitSize - 1);
    let mut SignMaskVal: APInt = getSignedMaxValue(BitSize);
    let mut SignMask: SDValue = self.DAG.getConstant(SignMaskVal, dl, AsIntVT, false, false);
    let mut FractSignMask: SDValue = self.DAG.getConstant(FractSignMaskVal, dl, AsIntVT, false, false);
    let mut One: APFloat = APFloat { FltSem, "1.0" };
    let mut ScaleUpKVal: APFloat = scalbn(One, Precision + 1, rmNearestTiesToEven);
    let mut ScaleUpK: SDValue = self.DAG.getConstantFP(ScaleUpKVal, dl, VT, false);
    let mut ScaleUp: SDValue = self.DAG.getNode(FMUL, dl, VT, Val, ScaleUpK);
    let mut SetCCVT: EVT = self.TLI.getSetCCResultType(self.DAG.getDataLayout(), *self.DAG.getContext(), VT);
    let mut AsInt: SDValue = self.DAG.getNode(BITCAST, dl, AsIntVT, Val);
    let mut Abs: SDValue = self.DAG.getNode(AND, dl, AsIntVT, AsInt, SignMask);
    let mut AddNegSmallestNormal: SDValue = self.DAG.getNode(ADD, dl, AsIntVT, Abs, NegSmallestNormalizedInt);
    let mut DenormOrZero: SDValue = self.DAG.getSetCC(dl, SetCCVT, AddNegSmallestNormal, NegSmallestNormalizedInt, SETULE, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut IsDenormal: SDValue = self.DAG.getSetCC(dl, SetCCVT, Abs, SmallestNormalizedInt, SETULT, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut MinExp: SDValue = self.DAG.getSignedConstant(MinExpVal, dl, ExpVT, false, false);
    let mut Zero: SDValue = self.DAG.getConstant(0, dl, ExpVT, false, false);
    let mut ScaledAsInt: SDValue = self.DAG.getNode(BITCAST, dl, AsIntVT, ScaleUp);
    let mut ScaledSelect: SDValue = self.DAG.getNode(SELECT, dl, AsIntVT, IsDenormal, ScaledAsInt, AsInt);
    let mut ExpMaskScaled: SDValue = self.DAG.getNode(AND, dl, AsIntVT, ScaledAsInt, ExpMask);
    let mut ScaledValue: SDValue = self.DAG.getNode(SELECT, dl, AsIntVT, IsDenormal, ExpMaskScaled, Abs);
    let mut ExponentShiftAmt: SDValue = self.DAG.getShiftAmountConstant(Precision - 1, AsIntVT, dl);
    let mut ShiftedExp: SDValue = self.DAG.getNode(SRL, dl, AsIntVT, ScaledValue, ExponentShiftAmt);
    let mut Exp: SDValue = self.DAG.getSExtOrTrunc(ShiftedExp, dl, ExpVT);
    let mut NormalBiasedExp: SDValue = self.DAG.getNode(ADD, dl, ExpVT, Exp, MinExp);
    let mut DenormalOffset: SDValue = self.DAG.getConstant(-Precision - 1, dl, ExpVT, false, false);
    let mut DenormalExpBias: SDValue = self.DAG.getNode(SELECT, dl, ExpVT, IsDenormal, DenormalOffset, Zero);
    let mut MaskedFractAsInt: SDValue = self.DAG.getNode(AND, dl, AsIntVT, ScaledSelect, FractSignMask);
    let mut Half: APFloat = APFloat { FltSem, "0.5" };
    let mut FPHalf: SDValue = self.DAG.getConstant(Half.bitcastToAPInt(), dl, AsIntVT, false, false);
    let mut Or: SDValue = self.DAG.getNode(OR, dl, AsIntVT, MaskedFractAsInt, FPHalf);
    let mut MaskedFract: SDValue = self.DAG.getNode(BITCAST, dl, VT, Or);
    let mut ComputedExp: SDValue = self.DAG.getNode(ADD, dl, ExpVT, NormalBiasedExp, DenormalExpBias);
    let mut Result0: SDValue = self.DAG.getNode(SELECT, dl, VT, DenormOrZero, Val, MaskedFract);
    let mut Result1: SDValue = self.DAG.getNode(SELECT, dl, ExpVT, DenormOrZero, Zero, ComputedExp);
    return self.DAG.getMergeValues(ArrayRef<SDValue> { [Result0, Result1] }, dl);
}

fn SelectionDAGLegalize::expandModf(self: *SelectionDAGLegalize, Node: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { Node };
    let mut Val: SDValue = Node.getOperand(0);
    let mut VT: EVT = Val.getValueType();
    let mut Flags: SDNodeFlags = Node.getFlags();
    let mut IntPart: SDValue = self.DAG.getNode(FTRUNC, dl, VT, Val, Flags);
    let mut FracPart: SDValue = self.DAG.getNode(FSUB, dl, VT, Val, IntPart, Flags);
    let mut FracToUse: SDValue = SDValue {};
    if Flags.hasNoInfs() {
        FracToUse = FracPart;
    } else {
        let mut Abs: SDValue = self.DAG.getNode(FABS, dl, VT, Val, Flags);
        let mut Inf: SDValue = self.DAG.getConstantFP(getInf(VT.getFltSemantics(), false), dl, VT, false);
        let mut SetCCVT: EVT = self.TLI.getSetCCResultType(self.DAG.getDataLayout(), *self.DAG.getContext(), VT);
        let mut IsInf: SDValue = self.DAG.getSetCC(dl, SetCCVT, Abs, Inf, SETOEQ, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut Zero: SDValue = self.DAG.getConstantFP(0.0, dl, VT, false);
        FracToUse = self.DAG.getSelect(dl, VT, IsInf, Zero, FracPart, SDNodeFlags { Flags: None });
    }
    let mut ResultFrac: SDValue = self.DAG.getNode(FCOPYSIGN, dl, VT, FracToUse, Val, Flags);
    return self.DAG.getMergeValues(ArrayRef<SDValue> { [ResultFrac, IntPart] }, dl);
}

fn SelectionDAGLegalize::ExpandLegalINT_TO_FP(self, Node: *mut SDNode, Chain: *mut SDValue) -> SDValue {
    let mut isSigned: bool = (Node.getOpcode() == STRICT_SINT_TO_FP || Node.getOpcode() == SINT_TO_FP);
    let mut DestVT: EVT = Node.getValueType(0);
    let mut dl: SDLoc = SDLoc { Node };
    let mut OpNo: u32 = if Node.isStrictFPOpcode() { 1 } else { 0 };
    let mut Op0: SDValue = Node.getOperand(OpNo);
    let mut SrcVT: EVT = Op0.getValueType();
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalizedag", 1) {
            dbgs() << "Legalizing INT_TO_FP\n";
        }
    }
        if !(false) { break; }
    }
    if SrcVT == EVT { i32 } && self.TLI.isTypeLegal(EVT { f64 }) && (DestVT.bitsLE(EVT { f64 }) || self.TLI.isOperationLegal(if Node.isStrictFPOpcode() { STRICT_FP_EXTEND } else { FP_EXTEND }, DestVT)) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("legalizedag", 1) {
                dbgs() << "32-bit [signed|unsigned] integer to float/double expansion\n";
            }
        }
            if !(false) { break; }
        }
        let mut StackSlot: SDValue = self.DAG.CreateStackTemporary(EVT { f64 }, 1);
        let mut Lo: SDValue = Op0;
        if isSigned {
            Lo = self.DAG.getNode(XOR, dl, EVT { i32 }, Lo, self.DAG.getConstant(2147483648, dl, EVT { i32 }, false, false));
        }
        let mut Hi: SDValue = self.DAG.getConstant(1127219200, dl, EVT { i32 }, false, false);
        if self.DAG.getDataLayout().isBigEndian() {
            swap(Lo, Hi);
        }
        let mut MemChain: SDValue = self.DAG.getEntryNode();
        let mut Store1: SDValue = self.DAG.getStore(MemChain, dl, Lo, StackSlot, MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
        let mut HiPtr: SDValue = self.DAG.getMemBasePlusOffset(StackSlot, getFixed(4), dl, SDNodeFlags { Flags: None });
        let mut Store2: SDValue = self.DAG.getStore(MemChain, dl, Hi, HiPtr, MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
        MemChain = self.DAG.getNode(TokenFactor, dl, EVT { Other }, Store1, Store2);
        let mut Load: SDValue = self.DAG.getLoad(EVT { f64 }, dl, MemChain, StackSlot, MachinePointerInfo { 0, 0 }, MaybeAlign {}, MONone, MMOMetadata {});
        let mut Bias: SDValue = self.DAG.getConstantFP(if isSigned { bit_cast(4841369601570766848) } else { bit_cast(4841369599423283200) }, dl, EVT { f64 }, false);
        let mut Sub: SDValue = SDValue {};
        let mut Result: SDValue = SDValue {};
        if Node.isStrictFPOpcode() {
            Sub = self.DAG.getNode(STRICT_FSUB, dl, ArrayRef<EVT> { [EVT { f64 }, EVT { Other }] }, ArrayRef<SDValue> { [Node.getOperand(0), Load, Bias] });
            Chain = Sub.getValue(1);
            if DestVT != Sub.getValueType() {
                let mut ResultPair: pair<SDValue, SDValue> = pair<SDValue, SDValue> {};
                ResultPair = self.DAG.getStrictFPExtendOrRound(Sub, Chain, dl, DestVT);
                Result = ResultPair.first;
                Chain = ResultPair.second;
            } else {
                Result = Sub;
            }
        } else {
            Sub = self.DAG.getNode(FSUB, dl, EVT { f64 }, Load, Bias);
            Result = self.DAG.getFPExtendOrRound(Sub, dl, DestVT);
        }
        return Result;
    }
    if isSigned {
        return SDValue {};
    }
    if ((SrcVT == EVT { i32 } || SrcVT == EVT { i64 }) && DestVT == EVT { f32 }) || (SrcVT == EVT { i64 } && DestVT == EVT { f64 }) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("legalizedag", 1) {
                dbgs() << "Converting unsigned i32/i64 to f32/f64\n";
            }
        }
            if !(false) { break; }
        }
        let mut SetCCVT: EVT = self.getSetCCResultType(SrcVT);
        let mut SignBitTest: SDValue = self.DAG.getSetCC(dl, SetCCVT, Op0, self.DAG.getConstant(0, dl, SrcVT, false, false), SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
        let mut ShiftConst: SDValue = self.DAG.getShiftAmountConstant(1, SrcVT, dl);
        let mut Shr: SDValue = self.DAG.getNode(SRL, dl, SrcVT, Op0, ShiftConst);
        let mut AndConst: SDValue = self.DAG.getConstant(1, dl, SrcVT, false, false);
        let mut And: SDValue = self.DAG.getNode(AND, dl, SrcVT, Op0, AndConst);
        let mut Or: SDValue = self.DAG.getNode(OR, dl, SrcVT, And, Shr);
        let mut Slow: SDValue = SDValue {};
        let mut Fast: SDValue = SDValue {};
        if Node.isStrictFPOpcode() {
            let mut InCvt: SDValue = self.DAG.getSelect(dl, SrcVT, SignBitTest, Or, Op0, SDNodeFlags { Flags: None });
            let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
            Flags.setNoFPExcept(Node.getFlags().hasNoFPExcept());
            Fast = self.DAG.getNode(STRICT_SINT_TO_FP, dl, ArrayRef<EVT> { [DestVT, EVT { Other }] }, ArrayRef<SDValue> { [Node.getOperand(0), InCvt] }, Flags);
            Flags.setNoFPExcept(true);
            Slow = self.DAG.getNode(STRICT_FADD, dl, ArrayRef<EVT> { [DestVT, EVT { Other }] }, ArrayRef<SDValue> { [Fast.getValue(1), Fast, Fast] }, Flags);
            Chain = Slow.getValue(1);
        } else {
            let mut SignCvt: SDValue = self.DAG.getNode(SINT_TO_FP, dl, DestVT, Or);
            Slow = self.DAG.getNode(FADD, dl, DestVT, SignCvt, SignCvt);
            Fast = self.DAG.getNode(SINT_TO_FP, dl, DestVT, Op0);
        }
        return self.DAG.getSelect(dl, DestVT, SignBitTest, Slow, Fast, SDNodeFlags { Flags: None });
    }
    if !self.TLI.isOperationLegalOrCustom(if Node.isStrictFPOpcode() { STRICT_FADD } else { FADD }, DestVT, false) {
        return SDValue {};
    }
    assert!(semanticsPrecision(DestVT.getFltSemantics()) >= SrcVT.getSizeInBits().operator unsigned long long() - 1, "Cannot perform lossless SINT_TO_FP!");
    let mut Tmp1: SDValue = SDValue {};
    if Node.isStrictFPOpcode() {
        Tmp1 = self.DAG.getNode(STRICT_SINT_TO_FP, dl, ArrayRef<EVT> { [DestVT, EVT { Other }] }, ArrayRef<SDValue> { [Node.getOperand(0), Op0] });
    } else {
        Tmp1 = self.DAG.getNode(SINT_TO_FP, dl, DestVT, Op0);
    }
    let mut SignSet: SDValue = self.DAG.getSetCC(dl, self.getSetCCResultType(SrcVT), Op0, self.DAG.getConstant(0, dl, SrcVT, false, false), SETLT, SDValue {}, false, SDNodeFlags { Flags: None });
    let mut Zero: SDValue = self.DAG.getIntPtrConstant(0, dl, false);
    let mut Four: SDValue = self.DAG.getIntPtrConstant(4, dl, false);
    let mut CstOffset: SDValue = self.DAG.getSelect(dl, Zero.getValueType(), SignSet, Four, Zero, SDNodeFlags { Flags: None });
    let mut FF: u64 = 0;
    match SrcVT.getSimpleVT().SimpleTy {
        _ => {
            return SDValue {};
        },
        i8 => {
            FF = 1132462080;
        },
        i16 => {
            FF = 1199570944;
        },
        i32 => {
            FF = 1333788672;
        },
        i64 => {
            FF = 1602224128;
        },
    }
    if self.DAG.getDataLayout().isLittleEndian() {
        FF <<= 32;
    }
    let mut FudgeFactor: *mut Constant = get(getInt64Ty(*self.DAG.getContext()), FF, false, false);
    let mut CPIdx: SDValue = self.DAG.getConstantPool(FudgeFactor, EVT { self.TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, MaybeAlign { nullopt }, 0, false, 0);
    let mut Alignment: Align = cast(CPIdx).getAlign();
    CPIdx = self.DAG.getNode(ADD, dl, CPIdx.getValueType(), CPIdx, CstOffset);
    Alignment = commonAlignment(Alignment, 4);
    let mut FudgeInReg: SDValue = SDValue {};
    if DestVT == EVT { f32 } {
        FudgeInReg = self.DAG.getLoad(EVT { f32 }, dl, self.DAG.getEntryNode(), CPIdx, getConstantPool(self.DAG.getMachineFunction()), MaybeAlign { Alignment }, MONone, MMOMetadata {});
    } else {
        let mut Load: SDValue = self.DAG.getExtLoad(EXTLOAD, dl, DestVT, self.DAG.getEntryNode(), CPIdx, getConstantPool(self.DAG.getMachineFunction()), EVT { f32 }, MaybeAlign { Alignment }, MONone, MMOMetadata {});
        let mut Handle: HandleSDNode = HandleSDNode { Load };
        self.LegalizeOp(Load.getNode());
        FudgeInReg = Handle.getValue();
    }
    if Node.isStrictFPOpcode() {
        let mut Result: SDValue = self.DAG.getNode(STRICT_FADD, dl, ArrayRef<EVT> { [DestVT, EVT { Other }] }, ArrayRef<SDValue> { [Tmp1.getValue(1), Tmp1, FudgeInReg] });
        Chain = Result.getValue(1);
        return Result;
    }
    return self.DAG.getNode(FADD, dl, DestVT, Tmp1, FudgeInReg);
}

fn SelectionDAGLegalize::PromoteLegalINT_TO_FP(self, N: *mut SDNode, dl: *SDLoc, Results: *mut SmallVectorImpl<SDValue>) {
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut IsSigned: bool = N.getOpcode() == SINT_TO_FP || N.getOpcode() == STRICT_SINT_TO_FP;
    let mut DestVT: EVT = N.getValueType(0);
    let mut LegalOp: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    let mut UIntOp: u32 = if IsStrict { STRICT_UINT_TO_FP } else { UINT_TO_FP };
    let mut SIntOp: u32 = if IsStrict { STRICT_SINT_TO_FP } else { SINT_TO_FP };
    let mut NewInTy: EVT = LegalOp.getValueType();
    let mut OpToUse: u32 = 0;
    while true {
        NewInTy = EVT { (NewInTy.getSimpleVT().SimpleTy + 1) as SimpleValueType };
        assert!(NewInTy.isInteger(), "Ran out of possibilities!");
        if self.TLI.isOperationLegalOrCustom(SIntOp, NewInTy, false) {
            OpToUse = SIntOp;
            break;
        }
        if IsSigned {
            continue;
        }
        if self.TLI.isOperationLegalOrCustom(UIntOp, NewInTy, false) {
            OpToUse = UIntOp;
            break;
        }
    }
    if IsStrict {
        let mut Res: SDValue = self.DAG.getNode(OpToUse, dl, ArrayRef<EVT> { [DestVT, EVT { Other }] }, ArrayRef<SDValue> { [N.getOperand(0), self.DAG.getNode(if IsSigned { SIGN_EXTEND } else { ZERO_EXTEND }, dl, NewInTy, LegalOp)] });
        Results.push(ValueParamT { Res });
        Results.push(Res.getValue(1));
        return;
    }
    Results.push(self.DAG.getNode(OpToUse, dl, DestVT, self.DAG.getNode(if IsSigned { SIGN_EXTEND } else { ZERO_EXTEND }, dl, NewInTy, LegalOp)));
}

fn SelectionDAGLegalize::PromoteLegalFP_TO_INT(self, N: *mut SDNode, dl: *SDLoc, Results: *mut SmallVectorImpl<SDValue>) {
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut IsSigned: bool = N.getOpcode() == FP_TO_SINT || N.getOpcode() == STRICT_FP_TO_SINT;
    let mut DestVT: EVT = N.getValueType(0);
    let mut LegalOp: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    let mut NewOutTy: EVT = DestVT;
    let mut OpToUse: u32 = 0;
    while true {
        NewOutTy = EVT { (NewOutTy.getSimpleVT().SimpleTy + 1) as SimpleValueType };
        assert!(NewOutTy.isInteger(), "Ran out of possibilities!");
        OpToUse = if IsStrict { STRICT_FP_TO_SINT } else { FP_TO_SINT };
        if self.TLI.isOperationLegalOrCustom(OpToUse, NewOutTy, false) {
            break;
        }
        OpToUse = if IsStrict { STRICT_FP_TO_UINT } else { FP_TO_UINT };
        if !IsSigned && self.TLI.isOperationLegalOrCustom(OpToUse, NewOutTy, false) {
            break;
        }
    }
    let mut Operation: SDValue = SDValue {};
    if IsStrict {
        let mut VTs: SDVTList = self.DAG.getVTList(NewOutTy, EVT { Other });
        Operation = self.DAG.getNode(OpToUse, dl, VTs, N.getOperand(0), LegalOp);
    } else {
        Operation = self.DAG.getNode(OpToUse, dl, NewOutTy, LegalOp);
    }
    let mut Trunc: SDValue = self.DAG.getNode(TRUNCATE, dl, DestVT, Operation);
    Results.push(ValueParamT { Trunc });
    if IsStrict {
        Results.push(Operation.getValue(1));
    }
}

fn SelectionDAGLegalize::PromoteLegalFP_TO_INT_SAT(self, Node: *mut SDNode, dl: *SDLoc) -> SDValue {
    let mut Opcode: u32 = Node.getOpcode();
    let mut NewOutTy: EVT = Node.getValueType(0);
    while true {
        NewOutTy = EVT { (NewOutTy.getSimpleVT().SimpleTy + 1) as SimpleValueType };
        assert!(NewOutTy.isInteger(), "Ran out of possibilities!");
        if self.TLI.isOperationLegalOrCustom(Opcode, NewOutTy, false) {
            break;
        }
    }
    let mut Result: SDValue = self.DAG.getNode(Opcode, dl, NewOutTy, Node.getOperand(0), Node.getOperand(1));
    return self.DAG.getNode(TRUNCATE, dl, Node.getValueType(0), Result);
}

fn SelectionDAGLegalize::ExpandPARITY(self, Op: SDValue, dl: *SDLoc) -> SDValue {
    let mut VT: EVT = Op.getValueType();
    let mut ShVT: EVT = self.TLI.getShiftAmountTy(VT, self.DAG.getDataLayout());
    let mut Sz: u32 = VT.getScalarSizeInBits();
    let mut Result: SDValue = SDValue {};
    if self.TLI.isOperationLegalOrPromote(CTPOP, VT, false) {
        Result = self.DAG.getNode(CTPOP, dl, VT, Op);
    } else {
        Result = Op;
        for let mut i: u32 = Log2_32_Ceil(Sz); i != 0;  {
            let mut Shift: SDValue = self.DAG.getNode(SRL, dl, VT, Result, self.DAG.getConstant(1 << (i -= 1), dl, ShVT, false, false));
            Result = self.DAG.getNode(XOR, dl, VT, Result, Shift);
        }
    }
    return self.DAG.getNode(AND, dl, VT, Result, self.DAG.getConstant(1, dl, VT, false, false));
}

fn SelectionDAGLegalize::PromoteReduction(self, Node: *mut SDNode) -> SDValue {
    let mut IsVPOpcode: bool = isVPOpcode(Node.getOpcode());
    let mut VecVT: MVT = if IsVPOpcode { Node.getOperand(1).getSimpleValueType() } else { Node.getOperand(0).getSimpleValueType() };
    let mut NewVecVT: MVT = self.TLI.getTypeToPromoteTo(Node.getOpcode(), VecVT);
    let mut ScalarVT: MVT = Node.getSimpleValueType(0);
    let mut NewScalarVT: MVT = NewVecVT.getVectorElementType();
    let mut DL: SDLoc = SDLoc { Node };
    let mut Operands: SmallVector<SDValue, 4> = SmallVector<SDValue, 4> { Node.getNumOperands() };
    assert!(Node.getOperand(0).getValueType().isFloatingPoint(), "Only FP promotion is supported");
    for let mut j: u32 = 0; j != Node.getNumOperands(); j += 1 {
        if Node.getOperand(j).getValueType().isVector() && !(IsVPOpcode && getVPMaskIdx(Node.getOpcode()) == j) {
            assert!(Node.getOperand(j).getValueType().isFloatingPoint(), "Only FP promotion is supported");
            Operands[j] = self.DAG.getNode(FP_EXTEND, DL, EVT { NewVecVT }, Node.getOperand(j));
        } else if Node.getOperand(j).getValueType().isFloatingPoint() {
            Operands[j] = self.DAG.getNode(FP_EXTEND, DL, EVT { NewScalarVT }, Node.getOperand(j));
        } else {
            Operands[j] = Node.getOperand(j);
        }
    }
    let mut Res: SDValue = self.DAG.getNode(Node.getOpcode(), DL, EVT { NewScalarVT }, ArrayRef<SDValue> { Operands }, Node.getFlags());
    assert!(ScalarVT.isFloatingPoint(), "Only FP promotion is supported");
    return self.DAG.getNode(FP_ROUND, DL, EVT { ScalarVT }, Res, self.DAG.getIntPtrConstant(0, DL, true));
}

fn SelectionDAGLegalize::ExpandNode(self, Node: *mut SDNode) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalizedag", 1) {
            dbgs() << "Trying to expand node\n";
        }
    }
        if !(false) { break; }
    }
    let mut Results: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut dl: SDLoc = SDLoc { Node };
    let mut Tmp1: SDValue = SDValue {};
    let mut Tmp2: SDValue = SDValue {};
    let mut Tmp3: SDValue = SDValue {};
    let mut Tmp4: SDValue = SDValue {};
    let mut NeedInvert: bool = false;
    match Node.getOpcode() {
        ABS => {
            ABS_MIN_POISON;
        },
        ABDS => {
            ABDU;
        },
        AVGCEILS => {
            AVGCEILU;
        },
        CTPOP => {
            if (Tmp1 = self.TLI.expandCTPOP(Node, self.DAG)) {
                Results.push(ValueParamT { Tmp1 });
            }
        },
        CTLZ => {
            CTLZ_ZERO_POISON;
        },
        CTLS => {
            if (Tmp1 = self.TLI.expandCTLS(Node, self.DAG)) {
                Results.push(ValueParamT { Tmp1 });
            }
        },
        CTTZ => {
            CTTZ_ZERO_POISON;
        },
        BITREVERSE => {
            if (Tmp1 = self.TLI.expandBITREVERSE(Node, self.DAG)) {
                Results.push(ValueParamT { Tmp1 });
            }
        },
        BSWAP => {
            if (Tmp1 = self.TLI.expandBSWAP(Node, self.DAG)) {
                Results.push(ValueParamT { Tmp1 });
            }
        },
        PARITY => {
            Results.push(self.ExpandPARITY(Node.getOperand(0), dl));
        },
        FRAMEADDR => {
            RETURNADDR;
        },
        EH_DWARF_CFA => {
            let mut CfaArg: SDValue = self.DAG.getSExtOrTrunc(Node.getOperand(0), dl, EVT { self.TLI.getPointerTy(self.DAG.getDataLayout(), 0) });
            let mut Offset: SDValue = self.DAG.getNode(ADD, dl, CfaArg.getValueType(), self.DAG.getNode(FRAME_TO_ARGS_OFFSET, dl, CfaArg.getValueType()), CfaArg);
            let mut FA: SDValue = self.DAG.getNode(FRAMEADDR, dl, EVT { self.TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, self.DAG.getConstant(0, dl, EVT { self.TLI.getPointerTy(self.DAG.getDataLayout(), 0) }, false, false));
            Results.push(self.DAG.getNode(ADD, dl, FA.getValueType(), FA, Offset));
            break;
        },
        GET_ROUNDING => {
            Results.push(self.DAG.getConstant(1, dl, Node.getValueType(0), false, false));
        },
        EH_RETURN => {
            PREFETCH;
        },
        READCYCLECOUNTER => {
            READSTEADYCOUNTER;
        },
        EH_SJLJ_SETJMP => {
            Results.push(self.DAG.getConstant(0, dl, EVT { i32 }, false, false));
        },
        ATOMIC_LOAD => {
            let mut Zero: SDValue = self.DAG.getConstant(0, dl, Node.getValueType(0), false, false);
            let mut VTs: SDVTList = self.DAG.getVTList(Node.getValueType(0), EVT { Other });
            let mut Swap: SDValue = self.DAG.getAtomicCmpSwap(ATOMIC_CMP_SWAP, dl, cast(Node).getMemoryVT(), VTs, Node.getOperand(0), Node.getOperand(1), Zero, Zero, cast(Node).getMemOperand());
            Results.push(Swap.getValue(0));
            Results.push(Swap.getValue(1));
            break;
        },
        ATOMIC_STORE => {
            let mut Swap: SDValue = self.DAG.getAtomic(ATOMIC_SWAP, dl, cast(Node).getMemoryVT(), Node.getOperand(0), Node.getOperand(2), Node.getOperand(1), cast(Node).getMemOperand());
            Results.push(Swap.getValue(1));
            break;
        },
        ATOMIC_CMP_SWAP_WITH_SUCCESS => {
            let mut VTs: SDVTList = self.DAG.getVTList(Node.getValueType(0), EVT { Other });
            let mut Res: SDValue = self.DAG.getAtomicCmpSwap(ATOMIC_CMP_SWAP, dl, cast(Node).getMemoryVT(), VTs, Node.getOperand(0), Node.getOperand(1), Node.getOperand(2), Node.getOperand(3), cast(Node).getMemOperand());
            let mut ExtRes: SDValue = Res;
            let mut LHS: SDValue = Res;
            let mut RHS: SDValue = Node.getOperand(1);
            let mut AtomicType: EVT = cast(Node).getMemoryVT();
            let mut OuterType: EVT = Node.getValueType(0);
            match self.TLI.getExtendForAtomicOps() {
                SIGN_EXTEND => {
                    LHS = self.DAG.getNode(AssertSext, dl, OuterType, Res, self.DAG.getValueType(AtomicType));
                },
                ZERO_EXTEND => {
                    LHS = self.DAG.getNode(AssertZext, dl, OuterType, Res, self.DAG.getValueType(AtomicType));
                },
                ANY_EXTEND => {
                    LHS = self.DAG.getZeroExtendInReg(Res, dl, AtomicType);
                },
                _ => {
                    llvm_unreachable_internal("Invalid atomic op extension", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeDAG.cpp", 3365);
                },
            }
            let mut Success: SDValue = self.DAG.getSetCC(dl, Node.getValueType(1), LHS, RHS, SETEQ, SDValue {}, false, SDNodeFlags { Flags: None });
            Results.push(ExtRes.getValue(0));
            Results.push(ValueParamT { Success });
            Results.push(Res.getValue(1));
            break;
        },
        ATOMIC_LOAD_SUB => {
            let mut DL: SDLoc = SDLoc { Node };
            let mut VT: EVT = Node.getValueType(0);
            let mut RHS: SDValue = Node.getOperand(2);
            let mut AN: *mut AtomicSDNode = cast(Node);
            if operator(RHS).getOpcode() == SIGN_EXTEND_INREG && cast(operator(RHS).getOperand(1)).getVT() == AN.getMemoryVT() {
                RHS = operator(RHS).getOperand(0);
            }
            let mut NewRHS: SDValue = self.DAG.getNode(SUB, DL, VT, self.DAG.getConstant(0, DL, VT, false, false), RHS);
            let mut Res: SDValue = self.DAG.getAtomic(ATOMIC_LOAD_ADD, DL, AN.getMemoryVT(), Node.getOperand(0), Node.getOperand(1), NewRHS, AN.getMemOperand());
            Results.push(ValueParamT { Res });
            Results.push(Res.getValue(1));
            break;
        },
        ATOMIC_LOAD_FSUB => {
            let mut DL: SDLoc = SDLoc { Node };
            let mut VT: EVT = Node.getValueType(0);
            let mut AN: *mut AtomicSDNode = cast(Node);
            let mut NewRHS: SDValue = self.DAG.getNode(FNEG, DL, VT, Node.getOperand(2));
            let mut Res: SDValue = self.DAG.getAtomic(ATOMIC_LOAD_FADD, DL, AN.getMemoryVT(), Node.getOperand(0), Node.getOperand(1), NewRHS, AN.getMemOperand());
            Results.push(ValueParamT { Res });
            Results.push(Res.getValue(1));
            break;
        },
        DYNAMIC_STACKALLOC => {
            self.ExpandDYNAMIC_STACKALLOC(Node, Results);
        },
        MERGE_VALUES => {
            for let mut i: u32 = 0; i < Node.getNumValues(); i += 1 {
                Results.push(ValueParamT { Node.getOperand(i) });
            }
        },
        POISON => {
            UNDEF;
        },
        STRICT_FP_ROUND => {
            if self.TLI.isStrictFPEnabled() {
                break;
            }
        },
        FP_ROUND => {
            if (Tmp1 = self.TLI.expandFP_ROUND(Node, self.DAG)) {
                Results.push(ValueParamT { Tmp1 });
                break;
            }
        },
        BITCAST => {
            if (Tmp1 = self.EmitStackConvert(Node.getOperand(0), Node.getValueType(0), Node.getValueType(0), dl)) {
                Results.push(ValueParamT { Tmp1 });
            }
        },
        STRICT_FP_EXTEND => {
            if self.TLI.isStrictFPEnabled() {
                break;
            }
        },
        FP_EXTEND => {
            let mut Op: SDValue = Node.getOperand(0);
            let mut SrcVT: EVT = Op.getValueType();
            let mut DstVT: EVT = Node.getValueType(0);
            if SrcVT.getScalarType() == EVT { bf16 } {
                Results.push(self.DAG.getNode(BF16_TO_FP, SDLoc { Node }, DstVT, Op));
                break;
            }
            if (Tmp1 = self.EmitStackConvert(Op, SrcVT, DstVT, dl)) {
                Results.push(ValueParamT { Tmp1 });
            }
            break;
        },
        BF16_TO_FP => {
            let mut Op: SDValue = Node.getOperand(0);
            if Op.getValueType() == EVT { bf16 } {
                Op = self.DAG.getNode(ANY_EXTEND, dl, EVT { i32 }, self.DAG.getNode(BITCAST, dl, EVT { i16 }, Op));
            } else {
                Op = self.DAG.getAnyExtOrTrunc(Op, dl, EVT { i32 });
            }
            Op = self.DAG.getNode(SHL, dl, EVT { i32 }, Op, self.DAG.getShiftAmountConstant(16, EVT { i32 }, dl));
            Op = self.DAG.getNode(BITCAST, dl, EVT { f32 }, Op);
            if Node.getValueType(0) != EVT { f32 } {
                Op = self.DAG.getNode(FP_EXTEND, dl, Node.getValueType(0), Op);
            }
            Results.push(ValueParamT { Op });
            break;
        },
        FP_TO_BF16 => {
            let mut Op: SDValue = Node.getOperand(0);
            if Op.getValueType() != EVT { f32 } {
                Op = self.DAG.getNode(FP_ROUND, dl, EVT { f32 }, Op, self.DAG.getIntPtrConstant(0, dl, true));
            }
            if !self.DAG.isKnownNeverSNaN(Op, 0) {
                Op = self.DAG.getNode(FCANONICALIZE, dl, EVT { f32 }, Op, Node.getFlags());
            }
            Op = self.DAG.getNode(SRL, dl, EVT { i32 }, self.DAG.getNode(BITCAST, dl, EVT { i32 }, Op), self.DAG.getShiftAmountConstant(16, EVT { i32 }, dl));
            if Node.getValueType(0) == EVT { bf16 } {
                Op = self.DAG.getNode(BITCAST, dl, EVT { bf16 }, self.DAG.getNode(TRUNCATE, dl, EVT { i16 }, Op));
            } else {
                Op = self.DAG.getAnyExtOrTrunc(Op, dl, Node.getValueType(0));
            }
            Results.push(ValueParamT { Op });
            break;
        },
        CONVERT_FROM_ARBITRARY_FP => {
            let mut DstVT: EVT = Node.getValueType(0);
            if self.TLI.expandCONVERT_FROM_ARBITRARY_FP(Node, self.DAG) {
                Expanded;
            } else {
                Results.push(ValueParamT { Expanded });
            }
            break;
        },
        CONVERT_TO_ARBITRARY_FP => {
            let mut ResVT: EVT = Node.getValueType(0);
            if self.TLI.expandCONVERT_TO_ARBITRARY_FP(Node, self.DAG) {
                Expanded;
            } else {
                Results.push(ValueParamT { Expanded });
            }
            break;
        },
        FCANONICALIZE => {
            let mut Mul: SDValue = self.TLI.expandFCANONICALIZE(Node, self.DAG);
            Results.push(ValueParamT { Mul });
            break;
        },
        SIGN_EXTEND_INREG => {
            let mut ExtraVT: EVT = cast(Node.getOperand(1)).getVT();
            let mut VT: EVT = Node.getValueType(0);
            if ExtraVT.isScalarInteger() && ExtraVT.getSizeInBits().operator unsigned long long() == 1 {
                let mut One: SDValue = self.DAG.getConstant(1, dl, VT, false, false);
                let mut And: SDValue = self.DAG.getNode(AND, dl, VT, Node.getOperand(0), One);
                let mut Zero: SDValue = self.DAG.getConstant(0, dl, VT, false, false);
                let mut Neg: SDValue = self.DAG.getNode(SUB, dl, VT, Zero, And);
                Results.push(ValueParamT { Neg });
                break;
            }
            let mut BitsDiff: u32 = VT.getScalarSizeInBits() - ExtraVT.getScalarSizeInBits();
            let mut ShiftCst: SDValue = self.DAG.getShiftAmountConstant(BitsDiff, VT, dl);
            Tmp1 = self.DAG.getNode(SHL, dl, VT, Node.getOperand(0), ShiftCst);
            Tmp1 = self.DAG.getNode(SRA, dl, VT, Tmp1, ShiftCst);
            Results.push(ValueParamT { Tmp1 });
            break;
        },
        UINT_TO_FP => {
            STRICT_UINT_TO_FP;
        },
        SINT_TO_FP => {
            STRICT_SINT_TO_FP;
        },
        FP_TO_SINT => {
            if self.TLI.expandFP_TO_SINT(Node, Tmp1, self.DAG) {
                Results.push(ValueParamT { Tmp1 });
            }
        },
        STRICT_FP_TO_SINT => {
            if self.TLI.expandFP_TO_SINT(Node, Tmp1, self.DAG) {
                self.ReplaceNode(Node, Tmp1.getNode());
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("legalizedag", 1) {
                        dbgs() << "Successfully expanded STRICT_FP_TO_SINT node\n";
                    }
                }
                    if !(false) { break; }
                }
                return true;
            }
        },
        FP_TO_UINT => {
            if self.TLI.expandFP_TO_UINT(Node, Tmp1, Tmp2, self.DAG) {
                Results.push(ValueParamT { Tmp1 });
            }
        },
        STRICT_FP_TO_UINT => {
            if self.TLI.expandFP_TO_UINT(Node, Tmp1, Tmp2, self.DAG) {
                self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: Node, ResNo: 1 }, Tmp2);
                self.ReplaceNodeWithValue(SDValue { Node: Node, ResNo: 0 }, Tmp1);
                while true {
                    {
                    if DebugFlag && isCurrentDebugType("legalizedag", 1) {
                        dbgs() << "Successfully expanded STRICT_FP_TO_UINT node\n";
                    }
                }
                    if !(false) { break; }
                }
                return true;
            }
        },
        FP_TO_SINT_SAT => {
            FP_TO_UINT_SAT;
        },
        LROUND => {
            LLROUND;
        },
        VAARG => {
            Results.push(self.DAG.expandVAArg(Node));
        },
        VACOPY => {
            Results.push(self.DAG.expandVACopy(Node));
        },
        EXTRACT_VECTOR_ELT => {
            if Node.getOperand(0).getValueType().getVectorElementCount().isScalar() {
                Tmp1 = self.DAG.getNode(BITCAST, dl, Node.getValueType(0), Node.getOperand(0));
            } else {
                Tmp1 = self.ExpandExtractFromVectorThroughStack(SDValue { Node: Node, ResNo: 0 });
            }
        },
        EXTRACT_SUBVECTOR => {
            Results.push(self.ExpandExtractFromVectorThroughStack(SDValue { Node: Node, ResNo: 0 }));
        },
        INSERT_SUBVECTOR => {
            Results.push(self.ExpandInsertToVectorThroughStack(SDValue { Node: Node, ResNo: 0 }));
        },
        CONCAT_VECTORS => {
            let mut VectorValueType: EVT = Node.getOperand(0).getValueType();
            if VectorValueType.isScalableVector() || self.TLI.isOperationExpand(EXTRACT_VECTOR_ELT, VectorValueType) {
                Results.push(self.ExpandVectorBuildThroughStack(Node));
            } else {
                Results.push(self.ExpandConcatVectors(Node));
            }
        },
        SCALAR_TO_VECTOR => {
            Results.push(self.ExpandSCALAR_TO_VECTOR(Node));
        },
        INSERT_VECTOR_ELT => {
            Results.push(self.ExpandINSERT_VECTOR_ELT(SDValue { Node: Node, ResNo: 0 }));
        },
        VECTOR_SHUFFLE => {
            let mut NewMask: SmallVector<int, 32> = SmallVector<int, 32> {};
            let mut Mask: ArrayRef<int> = cast(Node).getMask();
            let mut VT: EVT = Node.getValueType(0);
            let mut EltVT: EVT = VT.getVectorElementType();
            let mut Op0: SDValue = Node.getOperand(0);
            let mut Op1: SDValue = Node.getOperand(1);
            if !self.TLI.isTypeLegal(EltVT) {
                let mut NewEltVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), EltVT);
                if NewEltVT.bitsLT(EltVT) {
                    let mut NewVT: EVT = getVectorVT(*self.DAG.getContext(), NewEltVT, VT.getSizeInBits().operator unsigned long long() / NewEltVT.getSizeInBits().operator unsigned long long(), false);
                    assert!(NewVT.bitsEq(VT));
                    Op0 = self.DAG.getNode(BITCAST, dl, NewVT, Op0);
                    Op1 = self.DAG.getNode(BITCAST, dl, NewVT, Op1);
                    let mut factor: u32 = NewVT.getVectorNumElements() / VT.getVectorNumElements();
                    assert!(factor > 0);
                    for let mut i: u32 = 0; i < VT.getVectorNumElements(); i += 1 {
                        if Mask[i] < 0 {
                            for let mut fi: u32 = 0; fi < factor; fi += 1 {
                                NewMask.push(Mask[i]);
                            }
                        } else {
                            for let mut fi: u32 = 0; fi < factor; fi += 1 {
                                NewMask.push(Mask[i] * factor + fi);
                            }
                        }
                    }
                    Mask = ArrayRef<int> { NewMask };
                    VT = NewVT;
                }
                EltVT = NewEltVT;
            }
            let mut NumElems: u32 = VT.getVectorNumElements();
            let mut Ops: SmallVector<SDValue, 16> = SmallVector<SDValue, 16> {};
            for let mut i: u32 = 0; i != NumElems; i += 1 {
                if Mask[i] < 0 {
                    Ops.push(self.DAG.getUNDEF(EltVT));
                    continue;
                }
                let mut Idx: u32 = Mask[i];
                if Idx < NumElems {
                    Ops.push(self.DAG.getNode(EXTRACT_VECTOR_ELT, dl, EltVT, Op0, self.DAG.getVectorIdxConstant(Idx, dl, false)));
                } else {
                    Ops.push(self.DAG.getNode(EXTRACT_VECTOR_ELT, dl, EltVT, Op1, self.DAG.getVectorIdxConstant(Idx - NumElems, dl, false)));
                }
            }
            Tmp1 = self.DAG.getBuildVector(VT, dl, ArrayRef<SDValue> { Ops });
            Tmp1 = self.DAG.getNode(BITCAST, dl, Node.getValueType(0), Tmp1);
            Results.push(ValueParamT { Tmp1 });
            break;
        },
        VECTOR_SPLICE_LEFT => {
            VECTOR_SPLICE_RIGHT;
        },
        VECTOR_DEINTERLEAVE => {
            let mut Factor: u32 = Node.getNumOperands();
            if Factor <= 2 || Factor % 2 != 0 {
                break;
            }
            let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { Node.ops() };
            let mut VecVT: EVT = Node.getValueType(0);
            let mut HalfVTs: SmallVector<EVT> = SmallVector<EVT> { Factor / 2, VecVT };
            let mut L: SDValue = self.DAG.getNode(VECTOR_DEINTERLEAVE, dl, ArrayRef<EVT> { HalfVTs }, SDValue> { Ops }.take_front(Factor / 2));
            let mut R: SDValue = self.DAG.getNode(VECTOR_DEINTERLEAVE, dl, ArrayRef<EVT> { HalfVTs }, SDValue> { Ops }.take_back(Factor / 2));
            Results.resize(Factor);
            for let mut I: u32 = 0; I < Factor / 2; I += 1 {
                let mut Deinterleave: SDValue = self.DAG.getNode(VECTOR_DEINTERLEAVE, dl, ArrayRef<EVT> { [VecVT, VecVT] }, ArrayRef<SDValue> { [L.getValue(I), R.getValue(I)] });
                Results[I] = Deinterleave.getValue(0);
                Results[I + Factor / 2] = Deinterleave.getValue(1);
            }
            break;
        },
        VECTOR_INTERLEAVE => {
            let mut Factor: u32 = Node.getNumOperands();
            if Factor <= 2 || Factor % 2 != 0 {
                break;
            }
            let mut VecVT: EVT = Node.getValueType(0);
            let mut HalfVTs: SmallVector<EVT> = SmallVector<EVT> { Factor / 2, VecVT };
            let mut LOps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
            let mut ROps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
            for let mut I: u32 = 0; I < Factor / 2; I += 1 {
                let mut Interleave: SDValue = self.DAG.getNode(VECTOR_INTERLEAVE, dl, ArrayRef<EVT> { [VecVT, VecVT] }, ArrayRef<SDValue> { [Node.getOperand(I), Node.getOperand(I + Factor / 2)] });
                LOps.push(Interleave.getValue(0));
                ROps.push(Interleave.getValue(1));
            }
            let mut L: SDValue = self.DAG.getNode(VECTOR_INTERLEAVE, dl, ArrayRef<EVT> { HalfVTs }, ArrayRef<SDValue> { LOps });
            let mut R: SDValue = self.DAG.getNode(VECTOR_INTERLEAVE, dl, ArrayRef<EVT> { HalfVTs }, ArrayRef<SDValue> { ROps });
            for let mut I: u32 = 0; I < Factor / 2; I += 1 {
                Results.push(L.getValue(I));
            }
            for let mut I: u32 = 0; I < Factor / 2; I += 1 {
                Results.push(R.getValue(I));
            }
            break;
        },
        EXTRACT_ELEMENT => {
            let mut OpTy: EVT = Node.getOperand(0).getValueType();
            if Node.getConstantOperandVal(1) {
                Tmp1 = self.DAG.getNode(SRL, dl, OpTy, Node.getOperand(0), self.DAG.getShiftAmountConstant(OpTy.getSizeInBits().operator unsigned long long() / 2, OpTy, dl));
                Tmp1 = self.DAG.getNode(TRUNCATE, dl, Node.getValueType(0), Tmp1);
            } else {
                Tmp1 = self.DAG.getNode(TRUNCATE, dl, Node.getValueType(0), Node.getOperand(0));
            }
            Results.push(ValueParamT { Tmp1 });
            break;
        },
        STACKADDRESS => {
            STACKSAVE;
        },
        STACKRESTORE => {
            if self.TLI.getStackPointerRegisterToSaveRestore() {
                SP.operator unsigned int();
            } else {
                Results.push(self.DAG.getCopyToReg(Node.getOperand(0), dl, SP, Node.getOperand(1)));
            }
        },
        GET_DYNAMIC_AREA_OFFSET => {
            Results.push(self.DAG.getConstant(0, dl, Node.getValueType(0), false, false));
        },
        FCOPYSIGN => {
            Results.push(self.ExpandFCOPYSIGN(Node));
        },
        FNEG => {
            Results.push(self.ExpandFNEG(Node));
        },
        FABS => {
            Results.push(self.ExpandFABS(Node));
        },
        IS_FPCLASS => {
            let mut Test: FPClassTest = Node.getConstantOperandVal(1) as FPClassTest;
            if self.TLI.expandIS_FPCLASS(Node.getValueType(0), Node.getOperand(0), Test, Node.getFlags(), SDLoc { Node }, self.DAG) {
                Expanded;
            } else {
                Results.push(ValueParamT { Expanded });
            }
            break;
        },
        SMIN => {
            SMAX;
        },
        FMINNUM => {
            FMAXNUM;
        },
        FMINIMUM => {
            FMAXIMUM;
        },
        FMINIMUMNUM => {
            FMAXIMUMNUM;
        },
        FSIN => {
            FCOS;
        },
        FLDEXP => {
            STRICT_FLDEXP;
        },
        FFREXP => {
            let mut LC: Libcall = getFREXP(Node.getValueType(0));
            if self.DAG.getLibcalls().getLibcallImpl(LC) != Unsupported {
                break;
            }
            if self.expandFrexp(Node) {
                Expanded;
            } else {
                Results.push(ValueParamT { Expanded });
                Results.push(Expanded.getValue(1));
            }
            break;
        },
        FMODF => {
            let mut LC: Libcall = getMODF(Node.getValueType(0));
            if self.DAG.getLibcalls().getLibcallImpl(LC) != Unsupported {
                break;
            }
            if self.expandModf(Node) {
                Expanded;
            } else {
                Results.push(ValueParamT { Expanded });
                Results.push(Expanded.getValue(1));
            }
            break;
        },
        FSINCOS => {
            if isSinCosLibcallAvailable(Node, self.DAG.getLibcalls()) {
                break;
            }
            let mut VT: EVT = Node.getValueType(0);
            let mut Op: SDValue = Node.getOperand(0);
            let mut Flags: SDNodeFlags = Node.getFlags();
            Tmp1 = self.DAG.getNode(FSIN, dl, VT, Op, Flags);
            Tmp2 = self.DAG.getNode(FCOS, dl, VT, Op, Flags);
            Results.append([Tmp1, Tmp2]);
            break;
        },
        FMAD => {
            llvm_unreachable_internal("Illegal fmad should never be formed", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeDAG.cpp", 3996);
        },
        FP16_TO_FP => {
            if Node.getValueType(0) != EVT { f32 } {
                let mut Res: SDValue = self.DAG.getNode(FP16_TO_FP, dl, EVT { f32 }, Node.getOperand(0));
                Results.push(self.DAG.getNode(FP_EXTEND, dl, Node.getValueType(0), Res));
            }
        },
        STRICT_BF16_TO_FP => {
            STRICT_FP16_TO_FP;
        },
        FP_TO_FP16 => {
            while true {
                {
                if DebugFlag && isCurrentDebugType("legalizedag", 1) {
                    dbgs() << "Legalizing FP_TO_FP16\n";
                }
            }
                if !(false) { break; }
            }
        },
        ConstantFP => {
            let mut CFP: *mut ConstantFPSDNode = cast(Node);
            if !self.TLI.isFPImmLegal(CFP.getValueAPF(), Node.getValueType(0), self.DAG.shouldOptForSize()) {
                Results.push(self.ExpandConstantFP(CFP, true));
            }
            break;
        },
        Constant => {
            let mut CP: *mut ConstantSDNode = cast(Node);
            Results.push(self.ExpandConstant(CP));
            break;
        },
        FSUB => {
            let mut VT: EVT = Node.getValueType(0);
            if self.TLI.isOperationLegalOrCustom(FADD, VT, false) && self.TLI.isOperationLegalOrCustom(FNEG, VT, false) {
                let mut Flags: SDNodeFlags = Node.getFlags();
                Tmp1 = self.DAG.getNode(FNEG, dl, VT, Node.getOperand(1));
                Tmp1 = self.DAG.getNode(FADD, dl, VT, Node.getOperand(0), Tmp1, Flags);
                Results.push(ValueParamT { Tmp1 });
            }
            break;
        },
        SUB => {
            let mut VT: EVT = Node.getValueType(0);
            assert!(self.TLI.isOperationLegalOrCustom(ADD, VT, false) && self.TLI.isOperationLegalOrCustom(XOR, VT, false), "Don't know how to expand this subtraction!");
            Tmp1 = self.DAG.getNOT(dl, Node.getOperand(1), VT);
            Tmp1 = self.DAG.getNode(ADD, dl, VT, Tmp1, self.DAG.getConstant(1, dl, VT, false, false));
            Results.push(self.DAG.getNode(ADD, dl, VT, Node.getOperand(0), Tmp1));
            break;
        },
        UREM => {
            SREM;
        },
        UDIV => {
            SDIV;
        },
        MULHU => {
            MULHS;
        },
        UMUL_LOHI => {
            SMUL_LOHI;
        },
        MUL => {
            let mut VT: EVT = Node.getValueType(0);
            let mut VTs: SDVTList = self.DAG.getVTList(VT, VT);
            let mut HasSMUL_LOHI: bool = self.TLI.isOperationLegalOrCustom(SMUL_LOHI, VT, false);
            let mut HasUMUL_LOHI: bool = self.TLI.isOperationLegalOrCustom(UMUL_LOHI, VT, false);
            let mut HasMULHS: bool = self.TLI.isOperationLegalOrCustom(MULHS, VT, false);
            let mut HasMULHU: bool = self.TLI.isOperationLegalOrCustom(MULHU, VT, false);
            let mut OpToUse: u32 = 0;
            if HasSMUL_LOHI && !HasMULHS {
                OpToUse = SMUL_LOHI;
            } else if HasUMUL_LOHI && !HasMULHU {
                OpToUse = UMUL_LOHI;
            } else if HasSMUL_LOHI {
                OpToUse = SMUL_LOHI;
            } else if HasUMUL_LOHI {
                OpToUse = UMUL_LOHI;
            }
            if OpToUse {
                Results.push(self.DAG.getNode(OpToUse, dl, VTs, Node.getOperand(0), Node.getOperand(1)));
                break;
            }
            let mut Lo: SDValue = SDValue {};
            let mut Hi: SDValue = SDValue {};
            let mut HalfType: EVT = VT.getHalfSizedIntegerVT(*self.DAG.getContext());
            if self.TLI.isOperationLegalOrCustom(ZERO_EXTEND, VT, false) && self.TLI.isOperationLegalOrCustom(ANY_EXTEND, VT, false) && self.TLI.isOperationLegalOrCustom(SHL, VT, false) && self.TLI.isOperationLegalOrCustom(OR, VT, false) && self.TLI.expandMUL(Node, Lo, Hi, HalfType, self.DAG, OnlyLegalOrCustom, SDValue {}, SDValue {}, SDValue {}, SDValue {}) {
                Lo = self.DAG.getNode(ZERO_EXTEND, dl, VT, Lo);
                Hi = self.DAG.getNode(ANY_EXTEND, dl, VT, Hi);
                let mut Shift: SDValue = self.DAG.getShiftAmountConstant(HalfType.getSizeInBits().operator unsigned long long(), VT, dl);
                Hi = self.DAG.getNode(SHL, dl, VT, Hi, Shift);
                Results.push(self.DAG.getNode(OR, dl, VT, Lo, Hi));
            }
            break;
        },
        FSHL => {
            FSHR;
        },
        ROTL => {
            ROTR;
        },
        CLMUL => {
            CLMULR;
        },
        PEXT => {
            Results.push(self.TLI.expandPEXT(Node, self.DAG));
        },
        PDEP => {
            Results.push(self.TLI.expandPDEP(Node, self.DAG));
        },
        SADDSAT => {
            UADDSAT;
        },
        SCMP => {
            UCMP;
        },
        SSHLSAT => {
            USHLSAT;
        },
        SMULFIX => {
            SMULFIXSAT;
        },
        SDIVFIX => {
            SDIVFIXSAT;
        },
        UADDO_CARRY => {
            USUBO_CARRY;
        },
        SADDO => {
            SSUBO;
        },
        UADDO => {
            USUBO;
        },
        UMULO => {
            SMULO;
        },
        BUILD_PAIR => {
            let mut PairTy: EVT = Node.getValueType(0);
            Tmp1 = self.DAG.getNode(ZERO_EXTEND, dl, PairTy, Node.getOperand(0));
            Tmp2 = self.DAG.getNode(ANY_EXTEND, dl, PairTy, Node.getOperand(1));
            Tmp2 = self.DAG.getNode(SHL, dl, PairTy, Tmp2, self.DAG.getShiftAmountConstant(PairTy.getSizeInBits().operator unsigned long long() / 2, PairTy, dl));
            Results.push(self.DAG.getNode(OR, dl, PairTy, Tmp1, Tmp2));
            break;
        },
        SELECT => {
            Tmp1 = Node.getOperand(0);
        },
        BR_JT => {
            let mut Chain: SDValue = Node.getOperand(0);
            let mut Table: SDValue = Node.getOperand(1);
            let mut Index: SDValue = Node.getOperand(2);
            let mut JTI: i32 = cast(Table.getNode()).getIndex();
            let mut TD: *DataLayout = self.DAG.getDataLayout();
            let mut PTy: EVT = EVT { self.TLI.getPointerTy(TD, 0) };
            let mut EntrySize: u32 = self.DAG.getMachineFunction().getJumpTableInfo().getEntrySize(TD);
            if isPowerOf2_32(EntrySize) {
                Index = self.DAG.getNode(SHL, dl, Index.getValueType(), Index, self.DAG.getConstant(Log2_32(EntrySize), dl, Index.getValueType(), false, false));
            } else {
                Index = self.DAG.getNode(MUL, dl, Index.getValueType(), Index, self.DAG.getConstant(EntrySize, dl, Index.getValueType(), false, false));
            }
            let mut Addr: SDValue = self.DAG.getMemBasePlusOffset(Table, Index, dl, SDNodeFlags { Flags: None });
            let mut MemVT: EVT = getIntegerVT(*self.DAG.getContext(), EntrySize * 8);
            let mut LD: SDValue = self.DAG.getExtLoad(SEXTLOAD, dl, PTy, Chain, Addr, getJumpTable(self.DAG.getMachineFunction()), MemVT, MaybeAlign {}, MONone, MMOMetadata {});
            Addr = LD;
            if self.TLI.isJumpTableRelative() {
                Addr = self.DAG.getMemBasePlusOffset(self.TLI.getPICJumpTableRelocBase(Table, self.DAG), Addr, dl, SDNodeFlags { Flags: None });
            }
            Tmp1 = self.TLI.expandIndirectJTBranch(dl, LD.getValue(1), Addr, JTI, self.DAG);
            Results.push(ValueParamT { Tmp1 });
            break;
        },
        BRCOND => {
            Tmp1 = Node.getOperand(0);
        },
        SETCC => {
            STRICT_FSETCC;
        },
        SELECT_CC => {
            Tmp1 = Node.getOperand(0);
            Tmp2 = Node.getOperand(1);
            Tmp3 = Node.getOperand(2);
            Tmp4 = Node.getOperand(3);
            let mut VT: EVT = Node.getValueType(0);
            let mut Chain: SDValue = SDValue {};
            let mut CC: SDValue = Node.getOperand(4);
            let mut CCOp: CondCode = cast(CC).get();
            if self.TLI.isCondCodeLegalOrCustom(CCOp, Tmp1.getSimpleValueType()) {
                let mut CmpVT: EVT = Tmp1.getValueType();
                assert!(!self.TLI.isOperationExpand(SELECT, VT), "Cannot expand ISD::SELECT_CC when ISD::SELECT also needs to be expanded.");
                let mut CCVT: EVT = self.getSetCCResultType(CmpVT);
                let mut Cond: SDValue = self.DAG.getNode(SETCC, dl, CCVT, Tmp1, Tmp2, CC, Node.getFlags());
                Results.push(self.DAG.getSelect(dl, VT, Cond, Tmp3, Tmp4, Node.getFlags()));
                break;
            }
            let mut Legalized: bool = false;
            let mut InvCC: CondCode = getSetCCInverse(CCOp, Tmp1.getValueType());
            if self.TLI.isCondCodeLegalOrCustom(InvCC, Tmp1.getSimpleValueType()) {
                Legalized = true;
                Tmp1 = self.DAG.getSelectCC(dl, Tmp1, Tmp2, Tmp4, Tmp3, InvCC, Node.getFlags());
            } else {
                let mut SwapInvCC: CondCode = getSetCCSwappedOperands(InvCC);
                if self.TLI.isCondCodeLegalOrCustom(SwapInvCC, Tmp1.getSimpleValueType()) {
                    Legalized = true;
                    Tmp1 = self.DAG.getSelectCC(dl, Tmp2, Tmp1, Tmp4, Tmp3, SwapInvCC, Node.getFlags());
                }
            }
            if !Legalized {
                Legalized = self.TLI.LegalizeSetCCCondCode(self.DAG, self.getSetCCResultType(Tmp1.getValueType()), Tmp1, Tmp2, CC, NeedInvert, dl, Chain, false);
                assert!(Legalized, "Can't legalize SELECT_CC with legal condition!");
                if NeedInvert {
                    swap(Tmp3, Tmp4);
                }
                if CC.getNode() {
                    Tmp1 = self.DAG.getNode(SELECT_CC, dl, Node.getValueType(0), Tmp1, Tmp2, Tmp3, Tmp4, CC, Node.getFlags());
                } else {
                    Tmp2 = self.DAG.getConstant(0, dl, Tmp1.getValueType(), false, false);
                    CC = self.DAG.getCondCode(SETNE);
                    Tmp1 = self.DAG.getNode(SELECT_CC, dl, Node.getValueType(0), Tmp1, Tmp2, Tmp3, Tmp4, CC, Node.getFlags());
                }
            }
            Results.push(ValueParamT { Tmp1 });
            break;
        },
        BR_CC => {
            let mut Chain: SDValue = SDValue {};
            Tmp1 = Node.getOperand(0);
            Tmp2 = Node.getOperand(2);
            Tmp3 = Node.getOperand(3);
            Tmp4 = Node.getOperand(1);
            let mut Legalized: bool = self.TLI.LegalizeSetCCCondCode(self.DAG, self.getSetCCResultType(Tmp2.getValueType()), Tmp2, Tmp3, Tmp4, NeedInvert, dl, Chain, false);
            Legalized as void;
            assert!(Legalized, "Can't legalize BR_CC with legal condition!");
            if Tmp4.getNode() {
                assert!(!NeedInvert, "Don't know how to invert BR_CC!");
                Tmp1 = self.DAG.getNode(BR_CC, dl, Node.getValueType(0), Tmp1, Tmp4, Tmp2, Tmp3, Node.getOperand(4));
            } else {
                Tmp3 = self.DAG.getConstant(0, dl, Tmp2.getValueType(), false, false);
                Tmp4 = self.DAG.getCondCode(if NeedInvert { SETEQ } else { SETNE });
                Tmp1 = self.DAG.getNode(BR_CC, dl, Node.getValueType(0), Tmp1, Tmp4, Tmp2, Tmp3, Node.getOperand(4));
            }
            Results.push(ValueParamT { Tmp1 });
            break;
        },
        BUILD_VECTOR => {
            Results.push(self.ExpandBUILD_VECTOR(Node));
        },
        SPLAT_VECTOR => {
            Results.push(self.ExpandSPLAT_VECTOR(Node));
        },
        SRA => {
            SRL;
        },
        VECREDUCE_FADD => {
            VECREDUCE_FMUL;
        },
        VP_CTTZ_ELTS => {
            VP_CTTZ_ELTS_ZERO_POISON;
        },
        CLEAR_CACHE => {
            Results.push(ValueParamT { Node.getOperand(0) });
        },
        LRINT => {
            LLRINT;
        },
        ADDRSPACECAST => {
            Results.push(self.DAG.UnrollVectorOp(Node, 0));
        },
        GLOBAL_OFFSET_TABLE => {
            GlobalAddress;
        },
    }
    if !self.TLI.isStrictFPEnabled() && Results.is_empty() && Node.isStrictFPOpcode() {
        match Node.getOpcode() {
            _ => {
                if self.TLI.getStrictFPOperationAction(Node.getOpcode(), Node.getValueType(0)) == Legal {
                    return true;
                }
            },
            STRICT_FSUB => {
                if self.TLI.getStrictFPOperationAction(STRICT_FSUB, Node.getValueType(0)) == Legal {
                    return true;
                }
                if self.TLI.getStrictFPOperationAction(STRICT_FADD, Node.getValueType(0)) != Legal {
                    break;
                }
                let mut VT: EVT = Node.getValueType(0);
                let mut Flags: SDNodeFlags = Node.getFlags();
                let mut Neg: SDValue = self.DAG.getNode(FNEG, dl, VT, Node.getOperand(2), Flags);
                let mut Fadd: SDValue = self.DAG.getNode(STRICT_FADD, dl, Node.getVTList(), ArrayRef<SDValue> { [Node.getOperand(0), Node.getOperand(1), Neg] }, Flags);
                Results.push(ValueParamT { Fadd });
                Results.push(Fadd.getValue(1));
                break;
            },
            STRICT_SINT_TO_FP => {
                STRICT_UINT_TO_FP;
            },
        }
    }
    if Results.len == 0 {
        while true {
            {
            if DebugFlag && isCurrentDebugType("legalizedag", 1) {
                dbgs() << "Cannot expand node\n";
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalizedag", 1) {
            dbgs() << "Successfully expanded node\n";
        }
    }
        if !(false) { break; }
    }
    self.ReplaceNode(Node, Results.ptr);
    return true;
}

fn canUseFastMathLibcall(Node: *SDNode) -> bool {
    let mut Flags: SDNodeFlags = Node.getFlags();
    return Flags.hasApproximateFuncs() && Flags.hasNoNaNs() && Flags.hasNoInfs() && Flags.hasNoSignedZeros();
}

fn SelectionDAGLegalize::ConvertNodeToLibcall(self, Node: *mut SDNode) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalizedag", 1) {
            dbgs() << "Trying to convert node to libcall\n";
        }
    }
        if !(false) { break; }
    }
    let mut Results: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut dl: SDLoc = SDLoc { Node };
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    CallOptions.IsPostTypeLegalization = true;
    let mut Opc: u32 = Node.getOpcode();
    match Opc {
        ATOMIC_FENCE => {
            let mut Args: ArgListTy = ArgListTy {};
            let mut CLI: CallLoweringInfo = CallLoweringInfo { self.DAG };
            CLI.setDebugLoc(dl).setChain(Node.getOperand(0)).setLibCallee(C, getVoidTy(*self.DAG.getContext()), self.DAG.getExternalSymbol("__sync_synchronize", EVT { self.TLI.getPointerTy(self.DAG.getDataLayout(), 0) }), move(Args));
            let mut CallResult: pair<SDValue, SDValue> = self.TLI.LowerCallTo(CLI);
            Results.push(ValueParamT { CallResult.second });
            break;
        },
        ATOMIC_SWAP => {
            ATOMIC_LOAD_ADD;
        },
        TRAP => {
            let mut Args: ArgListTy = ArgListTy {};
            let mut CLI: CallLoweringInfo = CallLoweringInfo { self.DAG };
            CLI.setDebugLoc(dl).setChain(Node.getOperand(0)).setLibCallee(C, getVoidTy(*self.DAG.getContext()), self.DAG.getExternalSymbol("abort", EVT { self.TLI.getPointerTy(self.DAG.getDataLayout(), 0) }), move(Args));
            let mut CallResult: pair<SDValue, SDValue> = self.TLI.LowerCallTo(CLI);
            Results.push(ValueParamT { CallResult.second });
            break;
        },
        CLEAR_CACHE => {
            let mut InputChain: SDValue = Node.getOperand(0);
            let mut StartVal: SDValue = Node.getOperand(1);
            let mut EndVal: SDValue = Node.getOperand(2);
            let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, CLEAR_CACHE, EVT { isVoid }, ArrayRef<SDValue> { [StartVal, EndVal] }, CallOptions, SDLoc { Node }, InputChain);
            Results.push(ValueParamT { Tmp.second });
            break;
        },
        FMINNUM => {
            STRICT_FMINNUM;
        },
        FMAXNUM => {
            STRICT_FMAXNUM;
        },
        FMINIMUMNUM => {
            self.ExpandFPLibCall(Node, getFMINIMUM_NUM(EVT { Node.getSimpleValueType(0) }), Results);
        },
        FMAXIMUMNUM => {
            self.ExpandFPLibCall(Node, getFMAXIMUM_NUM(EVT { Node.getSimpleValueType(0) }), Results);
        },
        FSQRT => {
            STRICT_FSQRT;
        },
        FCBRT => {
            self.ExpandFPLibCall(Node, getCBRT(EVT { Node.getSimpleValueType(0) }), Results);
        },
        FSIN => {
            STRICT_FSIN;
        },
        FCOS => {
            STRICT_FCOS;
        },
        FTAN => {
            STRICT_FTAN;
        },
        FASIN => {
            STRICT_FASIN;
        },
        FACOS => {
            STRICT_FACOS;
        },
        FATAN => {
            STRICT_FATAN;
        },
        FATAN2 => {
            STRICT_FATAN2;
        },
        FSINH => {
            STRICT_FSINH;
        },
        FCOSH => {
            STRICT_FCOSH;
        },
        FTANH => {
            STRICT_FTANH;
        },
        FSINCOS => {
            FSINCOSPI;
        },
        FLOG => {
            STRICT_FLOG;
        },
        FLOG2 => {
            STRICT_FLOG2;
        },
        FLOG10 => {
            STRICT_FLOG10;
        },
        FEXP => {
            STRICT_FEXP;
        },
        FEXP2 => {
            STRICT_FEXP2;
        },
        FEXP10 => {
            self.ExpandFPLibCall(Node, getEXP10(EVT { Node.getSimpleValueType(0) }), Results);
        },
        FTRUNC => {
            STRICT_FTRUNC;
        },
        FFLOOR => {
            STRICT_FFLOOR;
        },
        FCEIL => {
            STRICT_FCEIL;
        },
        FRINT => {
            STRICT_FRINT;
        },
        FNEARBYINT => {
            STRICT_FNEARBYINT;
        },
        FROUND => {
            STRICT_FROUND;
        },
        FROUNDEVEN => {
            STRICT_FROUNDEVEN;
        },
        FLDEXP => {
            STRICT_FLDEXP;
        },
        FMODF => {
            FFREXP;
        },
        FPOWI => {
            STRICT_FPOWI;
        },
        FPOW => {
            STRICT_FPOW;
        },
        LROUND => {
            STRICT_LROUND;
        },
        LLROUND => {
            STRICT_LLROUND;
        },
        LRINT => {
            STRICT_LRINT;
        },
        LLRINT => {
            STRICT_LLRINT;
        },
        FDIV => {
            STRICT_FDIV;
        },
        FREM => {
            STRICT_FREM;
        },
        FMA => {
            STRICT_FMA;
        },
        FADD => {
            STRICT_FADD;
        },
        FMUL => {
            STRICT_FMUL;
        },
        FP16_TO_FP => {
            if Node.getValueType(0) == EVT { f32 } {
                Results.push(ValueParamT { self.ExpandLibCall(FPEXT_F16_F32, Node, false).first });
            }
        },
        STRICT_BF16_TO_FP => {
            if Node.getValueType(0) == EVT { f32 } {
                let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, FPEXT_BF16_F32, EVT { f32 }, ArrayRef<SDValue> { Node.getOperand(1) }, CallOptions, SDLoc { Node }, Node.getOperand(0));
                Results.push(ValueParamT { Tmp.first });
                Results.push(ValueParamT { Tmp.second });
            }
        },
        STRICT_FP16_TO_FP => {
            if Node.getValueType(0) == EVT { f32 } {
                let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, FPEXT_F16_F32, EVT { f32 }, ArrayRef<SDValue> { Node.getOperand(1) }, CallOptions, SDLoc { Node }, Node.getOperand(0));
                Results.push(ValueParamT { Tmp.first });
                Results.push(ValueParamT { Tmp.second });
            }
            break;
        },
        FP_TO_FP16 => {
            let mut LC: Libcall = getFPROUND(Node.getOperand(0).getValueType(), EVT { f16 });
            assert!(LC != UNKNOWN_LIBCALL, "Unable to expand fp_to_fp16");
            Results.push(ValueParamT { self.ExpandLibCall(LC, Node, false).first });
            break;
        },
        FP_TO_BF16 => {
            let mut LC: Libcall = getFPROUND(Node.getOperand(0).getValueType(), EVT { bf16 });
            assert!(LC != UNKNOWN_LIBCALL, "Unable to expand fp_to_bf16");
            Results.push(ValueParamT { self.ExpandLibCall(LC, Node, false).first });
            break;
        },
        STRICT_SINT_TO_FP => {
            STRICT_UINT_TO_FP;
        },
        FP_TO_SINT => {
            FP_TO_UINT;
        },
        FP_ROUND => {
            STRICT_FP_ROUND;
        },
        FP_EXTEND => {
            Results.push(ValueParamT { self.ExpandLibCall(getFPEXT(Node.getOperand(0).getValueType(), Node.getValueType(0)), Node, false).first });
            break;
        },
        STRICT_FP_EXTEND => {
            STRICT_FP_TO_FP16;
        },
        FSUB => {
            STRICT_FSUB;
        },
        SREM => {
            Results.push(self.ExpandIntLibCall(Node, true, SREM_I8, SREM_I16, SREM_I32, SREM_I64, SREM_I128));
        },
        UREM => {
            Results.push(self.ExpandIntLibCall(Node, false, UREM_I8, UREM_I16, UREM_I32, UREM_I64, UREM_I128));
        },
        SDIV => {
            Results.push(self.ExpandIntLibCall(Node, true, SDIV_I8, SDIV_I16, SDIV_I32, SDIV_I64, SDIV_I128));
        },
        UDIV => {
            Results.push(self.ExpandIntLibCall(Node, false, UDIV_I8, UDIV_I16, UDIV_I32, UDIV_I64, UDIV_I128));
        },
        SDIVREM => {
            UDIVREM;
        },
        MUL => {
            Results.push(self.ExpandIntLibCall(Node, false, MUL_I8, MUL_I16, MUL_I32, MUL_I64, MUL_I128));
        },
        CTLZ_ZERO_POISON => {
            Results.push(self.ExpandBitCountingLibCall(Node, CTLZ_I32, CTLZ_I64, CTLZ_I128));
        },
        CTPOP => {
            Results.push(self.ExpandBitCountingLibCall(Node, CTPOP_I32, CTPOP_I64, CTPOP_I128));
        },
        RESET_FPENV => {
            let mut PtrTy: EVT = EVT { self.TLI.getPointerTy(self.DAG.getDataLayout(), 0) };
            let mut Ptr: SDValue = self.DAG.getAllOnesConstant(dl, PtrTy, false, false);
            let mut Chain: SDValue = Node.getOperand(0);
            Results.push(self.DAG.makeStateFunctionCall(FESETENV, Ptr, Chain, Node));
            break;
        },
        GET_FPENV_MEM => {
            let mut Chain: SDValue = Node.getOperand(0);
            let mut EnvPtr: SDValue = Node.getOperand(1);
            Results.push(self.DAG.makeStateFunctionCall(FEGETENV, EnvPtr, Chain, Node));
            break;
        },
        SET_FPENV_MEM => {
            let mut Chain: SDValue = Node.getOperand(0);
            let mut EnvPtr: SDValue = Node.getOperand(1);
            Results.push(self.DAG.makeStateFunctionCall(FESETENV, EnvPtr, Chain, Node));
            break;
        },
        GET_FPMODE => {
            let mut ModeVT: EVT = Node.getValueType(0);
            let mut StackPtr: SDValue = self.DAG.CreateStackTemporary(ModeVT, 1);
            let mut SPFI: i32 = cast(StackPtr.getNode()).getIndex();
            let mut Chain: SDValue = self.DAG.makeStateFunctionCall(FEGETMODE, StackPtr, Node.getOperand(0), Node);
            let mut LdInst: SDValue = self.DAG.getLoad(ModeVT, dl, Chain, StackPtr, getFixedStack(self.DAG.getMachineFunction(), SPFI, 0), MaybeAlign {}, MONone, MMOMetadata {});
            Results.push(ValueParamT { LdInst });
            Results.push(LdInst.getValue(1));
            break;
        },
        SET_FPMODE => {
            let mut Mode: SDValue = Node.getOperand(1);
            let mut ModeVT: EVT = Mode.getValueType();
            let mut StackPtr: SDValue = self.DAG.CreateStackTemporary(ModeVT, 1);
            let mut SPFI: i32 = cast(StackPtr.getNode()).getIndex();
            let mut StInst: SDValue = self.DAG.getStore(Node.getOperand(0), dl, Mode, StackPtr, getFixedStack(self.DAG.getMachineFunction(), SPFI, 0), MaybeAlign {}, MONone, MMOMetadata {});
            Results.push(self.DAG.makeStateFunctionCall(FESETMODE, StackPtr, StInst, Node));
            break;
        },
        RESET_FPMODE => {
            let mut DL: *DataLayout = self.DAG.getDataLayout();
            let mut PtrTy: EVT = EVT { self.TLI.getPointerTy(DL, 0) };
            let mut Mode: SDValue = self.DAG.getAllOnesConstant(dl, PtrTy, false, false);
            Results.push(self.DAG.makeStateFunctionCall(FESETMODE, Mode, Node.getOperand(0), Node));
            break;
        },
    }
    if !Results.is_empty() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("legalizedag", 1) {
                dbgs() << "Successfully converted node to libcall\n";
            }
        }
            if !(false) { break; }
        }
        self.ReplaceNode(Node, Results.ptr);
    } else {
        while true {
            {
            if DebugFlag && isCurrentDebugType("legalizedag", 1) {
                dbgs() << "Could not convert node to libcall\n";
            }
        }
            if !(false) { break; }
        }
    }
}

fn getPromotedVectorElementType(TLI: *TargetLowering, EltVT: MVT, NewEltVT: MVT) -> MVT {
    let mut OldEltsPerNewElt: u32 = EltVT.getSizeInBits().operator unsigned long long() / NewEltVT.getSizeInBits().operator unsigned long long();
    let mut MidVT: MVT = if OldEltsPerNewElt == 1 { NewEltVT } else { getVectorVT(NewEltVT, OldEltsPerNewElt) };
    assert!(TLI.isTypeLegal(EVT { MidVT }), "unexpected");
    return MidVT;
}

fn SelectionDAGLegalize::PromoteNode(self, Node: *mut SDNode) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalizedag", 1) {
            dbgs() << "Trying to promote node\n";
        }
    }
        if !(false) { break; }
    }
    let mut Results: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
    let mut OVT: MVT = Node.getSimpleValueType(0);
    if Node.getOpcode() == UINT_TO_FP || Node.getOpcode() == SINT_TO_FP || Node.getOpcode() == SETCC || Node.getOpcode() == EXTRACT_VECTOR_ELT || Node.getOpcode() == INSERT_VECTOR_ELT || Node.getOpcode() == VECREDUCE_FMAX || Node.getOpcode() == VECREDUCE_FMIN || Node.getOpcode() == VECREDUCE_FMAXIMUM || Node.getOpcode() == VECREDUCE_FMINIMUM || Node.getOpcode() == VECREDUCE_FMAXIMUMNUM || Node.getOpcode() == VECREDUCE_FMINIMUMNUM {
        OVT = Node.getOperand(0).getSimpleValueType();
    }
    if Node.getOpcode() == ATOMIC_STORE || Node.getOpcode() == STRICT_UINT_TO_FP || Node.getOpcode() == STRICT_SINT_TO_FP || Node.getOpcode() == STRICT_FSETCC || Node.getOpcode() == STRICT_FSETCCS || Node.getOpcode() == STRICT_LRINT || Node.getOpcode() == STRICT_LLRINT || Node.getOpcode() == STRICT_LROUND || Node.getOpcode() == STRICT_LLROUND || Node.getOpcode() == VP_REDUCE_FADD || Node.getOpcode() == VP_REDUCE_FMUL || Node.getOpcode() == VP_REDUCE_FMAX || Node.getOpcode() == VP_REDUCE_FMIN || Node.getOpcode() == VP_REDUCE_FMAXIMUM || Node.getOpcode() == VP_REDUCE_FMINIMUM || Node.getOpcode() == VP_REDUCE_SEQ_FADD {
        OVT = Node.getOperand(1).getSimpleValueType();
    }
    if Node.getOpcode() == BR_CC || Node.getOpcode() == SELECT_CC {
        OVT = Node.getOperand(2).getSimpleValueType();
    }
    let mut FastMathFlags: SDNodeFlags = Node.getFlags() & SDNodeFlags { Flags: FastMathFlags };
    let mut FlagsInserter: FlagInserter = FlagInserter { self.DAG, FastMathFlags };
    let mut NVT: MVT = self.TLI.getTypeToPromoteTo(Node.getOpcode(), OVT);
    let mut dl: SDLoc = SDLoc { Node };
    let mut Tmp1: SDValue = SDValue {};
    let mut Tmp2: SDValue = SDValue {};
    let mut Tmp3: SDValue = SDValue {};
    let mut Tmp4: SDValue = SDValue {};
    match Node.getOpcode() {
        CTTZ => {
            CTTZ_ZERO_POISON;
        },
        CTLZ_ZERO_POISON => {
            let mut AnyExtendedNode: SDValue = self.DAG.getNode(ANY_EXTEND, dl, EVT { NVT }, Node.getOperand(0));
            let mut ShiftConstant: SDValue = self.DAG.getShiftAmountConstant(NVT.getSizeInBits() - OVT.getSizeInBits().operator unsigned long long(), EVT { NVT }, dl);
            let mut LeftShiftResult: SDValue = self.DAG.getNode(SHL, dl, EVT { NVT }, AnyExtendedNode, ShiftConstant);
            let mut CTLZResult: SDValue = self.DAG.getNode(Node.getOpcode(), dl, EVT { NVT }, LeftShiftResult);
            Results.push(self.DAG.getNode(TRUNCATE, dl, EVT { OVT }, CTLZResult));
            break;
        },
        PEXT => {
            Tmp1 = self.DAG.getNode(ANY_EXTEND, dl, EVT { NVT }, Node.getOperand(0));
            Tmp2 = self.DAG.getNode(ZERO_EXTEND, dl, EVT { NVT }, Node.getOperand(1));
            Tmp1 = self.DAG.getNode(PEXT, dl, EVT { NVT }, Tmp1, Tmp2);
            Results.push(self.DAG.getNode(TRUNCATE, dl, EVT { OVT }, Tmp1));
            break;
        },
        PDEP => {
            Tmp1 = self.DAG.getNode(ANY_EXTEND, dl, EVT { NVT }, Node.getOperand(0));
            Tmp2 = self.DAG.getNode(ANY_EXTEND, dl, EVT { NVT }, Node.getOperand(1));
            Tmp1 = self.DAG.getNode(PDEP, dl, EVT { NVT }, Tmp1, Tmp2);
            Results.push(self.DAG.getNode(TRUNCATE, dl, EVT { OVT }, Tmp1));
            break;
        },
        BITREVERSE => {
            BSWAP;
        },
        FP_TO_UINT => {
            STRICT_FP_TO_UINT;
        },
        FP_TO_UINT_SAT => {
            FP_TO_SINT_SAT;
        },
        UINT_TO_FP => {
            STRICT_UINT_TO_FP;
        },
        VAARG => {
            let mut Chain: SDValue = Node.getOperand(0);
            let mut Ptr: SDValue = Node.getOperand(1);
            let mut TruncOp: u32 = 0;
            if OVT.isVector() {
                TruncOp = BITCAST;
            } else {
                assert!(OVT.isInteger(), "VAARG promotion is supported only for vectors or integer types");
                TruncOp = TRUNCATE;
            }
            Tmp1 = self.DAG.getVAArg(EVT { NVT }, dl, Chain, Ptr, Node.getOperand(2), Node.getConstantOperandVal(3));
            Chain = Tmp1.getValue(1);
            Tmp2 = self.DAG.getNode(TruncOp, dl, EVT { OVT }, Tmp1);
            self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: Node, ResNo: 0 }, Tmp2);
            self.DAG.ReplaceAllUsesOfValueWith(SDValue { Node: Node, ResNo: 1 }, Chain);
            if self.UpdatedNodes {
                self.UpdatedNodes.insert(Tmp2.getNode());
                self.UpdatedNodes.insert(Chain.getNode());
            }
            self.ReplacedNode(Node);
            break;
        },
        MUL => {
            SDIV;
        },
        UMUL_LOHI => {
            SMUL_LOHI;
        },
        SELECT => {
            let mut ExtOp: u32 = 0;
            let mut TruncOp: u32 = 0;
            if Node.getValueType(0).isVector() || Node.getValueType(0).getSizeInBits() == NVT.getSizeInBits() {
                ExtOp = BITCAST;
                TruncOp = BITCAST;
            } else if Node.getValueType(0).isInteger() {
                ExtOp = ANY_EXTEND;
                TruncOp = TRUNCATE;
            } else {
                ExtOp = FP_EXTEND;
                TruncOp = FP_ROUND;
            }
            Tmp1 = Node.getOperand(0);
            Tmp2 = self.DAG.getNode(ExtOp, dl, EVT { NVT }, Node.getOperand(1));
            Tmp3 = self.DAG.getNode(ExtOp, dl, EVT { NVT }, Node.getOperand(2));
            Tmp1 = self.DAG.getSelect(dl, EVT { NVT }, Tmp1, Tmp2, Tmp3, SDNodeFlags { Flags: None });
            if TruncOp != FP_ROUND {
                Tmp1 = self.DAG.getNode(TruncOp, dl, Node.getValueType(0), Tmp1);
            } else {
                Tmp1 = self.DAG.getNode(TruncOp, dl, Node.getValueType(0), Tmp1, self.DAG.getIntPtrConstant(0, dl, true));
            }
            Results.push(ValueParamT { Tmp1 });
            break;
        },
        VECTOR_SHUFFLE => {
            let mut Mask: ArrayRef<int> = cast(Node).getMask();
            Tmp1 = self.DAG.getNode(BITCAST, dl, EVT { NVT }, Node.getOperand(0));
            Tmp2 = self.DAG.getNode(BITCAST, dl, EVT { NVT }, Node.getOperand(1));
            Tmp1 = self.ShuffleWithNarrowerEltType(EVT { NVT }, EVT { OVT }, dl, Tmp1, Tmp2, Mask);
            Tmp1 = self.DAG.getNode(BITCAST, dl, EVT { OVT }, Tmp1);
            Results.push(ValueParamT { Tmp1 });
            break;
        },
        VECTOR_SPLICE_LEFT => {
            VECTOR_SPLICE_RIGHT;
        },
        SELECT_CC => {
            let mut Cond: SDValue = Node.getOperand(4);
            let mut CCCode: CondCode = cast(Cond).get();
            let mut CVT: MVT = Node.getSimpleValueType(0);
            assert!(CVT == OVT, "not handled");
            let mut ExtOp: u32 = FP_EXTEND;
            if NVT.isInteger() {
                ExtOp = if isSignedIntSetCC(CCCode) { SIGN_EXTEND } else { ZERO_EXTEND };
            }
            if self.TLI.isCondCodeLegal(CCCode, CVT) {
                Tmp1 = Node.getOperand(0);
                Tmp2 = Node.getOperand(1);
            } else {
                Tmp1 = self.DAG.getNode(ExtOp, dl, EVT { NVT }, Node.getOperand(0));
                Tmp2 = self.DAG.getNode(ExtOp, dl, EVT { NVT }, Node.getOperand(1));
            }
            Tmp3 = self.DAG.getNode(ExtOp, dl, EVT { NVT }, Node.getOperand(2));
            Tmp4 = self.DAG.getNode(ExtOp, dl, EVT { NVT }, Node.getOperand(3));
            Tmp1 = self.DAG.getNode(SELECT_CC, dl, EVT { NVT }, ArrayRef<SDValue> { [Tmp1, Tmp2, Tmp3, Tmp4, Cond] }, Node.getFlags());
            if ExtOp != FP_EXTEND {
                Tmp1 = self.DAG.getNode(TRUNCATE, dl, EVT { OVT }, Tmp1);
            } else {
                Tmp1 = self.DAG.getNode(FP_ROUND, dl, EVT { OVT }, Tmp1, self.DAG.getIntPtrConstant(0, dl, true));
            }
            Results.push(ValueParamT { Tmp1 });
            break;
        },
        SETCC => {
            STRICT_FSETCC;
        },
        BR_CC => {
            let mut ExtOp: u32 = FP_EXTEND;
            if NVT.isInteger() {
                let mut CCCode: CondCode = cast(Node.getOperand(1)).get();
                ExtOp = if isSignedIntSetCC(CCCode) { SIGN_EXTEND } else { ZERO_EXTEND };
            }
            Tmp1 = self.DAG.getNode(ExtOp, dl, EVT { NVT }, Node.getOperand(2));
            Tmp2 = self.DAG.getNode(ExtOp, dl, EVT { NVT }, Node.getOperand(3));
            Results.push(self.DAG.getNode(BR_CC, dl, Node.getValueType(0), Node.getOperand(0), Node.getOperand(1), Tmp1, Tmp2, Node.getOperand(4)));
            break;
        },
        FADD => {
            FSUB;
        },
        STRICT_FMINIMUM => {
            STRICT_FMAXIMUM;
        },
        STRICT_FADD => {
            STRICT_FSUB;
        },
        FMA => {
            if !OVT.isVector() && NVT.isVector() && NVT.getVectorElementType() == OVT {
                Tmp1 = self.DAG.getNode(SCALAR_TO_VECTOR, dl, EVT { NVT }, Node.getOperand(0));
                Tmp2 = self.DAG.getNode(SCALAR_TO_VECTOR, dl, EVT { NVT }, Node.getOperand(1));
                Tmp3 = self.DAG.getNode(SCALAR_TO_VECTOR, dl, EVT { NVT }, Node.getOperand(2));
                let mut Result: SDValue = self.DAG.getNode(Node.getOpcode(), dl, EVT { NVT }, Tmp1, Tmp2, Tmp3, Node.getFlags());
                Results.push(self.DAG.getNode(EXTRACT_VECTOR_ELT, dl, EVT { OVT }, Result, self.DAG.getConstant(0, dl, EVT { i32 }, false, false)));
                break;
            }
        },
        STRICT_FMA => {
            Tmp1 = self.DAG.getNode(STRICT_FP_EXTEND, dl, ArrayRef<EVT> { [EVT { NVT }, EVT { Other }] }, ArrayRef<SDValue> { [Node.getOperand(0), Node.getOperand(1)] });
        },
        FCOPYSIGN => {
            FLDEXP;
        },
        STRICT_FLDEXP => {
            Tmp1 = self.DAG.getNode(STRICT_FP_EXTEND, dl, ArrayRef<EVT> { [EVT { NVT }, EVT { Other }] }, ArrayRef<SDValue> { [Node.getOperand(0), Node.getOperand(1)] });
            Tmp2 = Node.getOperand(2);
            Tmp3 = self.DAG.getNode(STRICT_FLDEXP, dl, ArrayRef<EVT> { [EVT { NVT }, EVT { Other }] }, ArrayRef<SDValue> { [Tmp1.getValue(1), Tmp1, Tmp2] });
            Tmp4 = self.DAG.getNode(STRICT_FP_ROUND, dl, ArrayRef<EVT> { [EVT { OVT }, EVT { Other }] }, ArrayRef<SDValue> { [Tmp3.getValue(1), Tmp3, self.DAG.getIntPtrConstant(0, dl, true)] });
            Results.push(ValueParamT { Tmp4 });
            Results.push(Tmp4.getValue(1));
            break;
        },
        STRICT_FPOWI => {
            Tmp1 = self.DAG.getNode(STRICT_FP_EXTEND, dl, ArrayRef<EVT> { [EVT { NVT }, EVT { Other }] }, ArrayRef<SDValue> { [Node.getOperand(0), Node.getOperand(1)] });
        },
        FFREXP => {
            Tmp1 = self.DAG.getNode(FP_EXTEND, dl, EVT { NVT }, Node.getOperand(0));
            Tmp2 = self.DAG.getNode(FFREXP, dl, ArrayRef<EVT> { [EVT { NVT }, Node.getValueType(1)] }, ArrayRef<SDValue> { Tmp1 });
            Results.push(self.DAG.getNode(FP_ROUND, dl, EVT { OVT }, Tmp2, self.DAG.getIntPtrConstant(0, dl, true)));
            Results.push(Tmp2.getValue(1));
            break;
        },
        FMODF => {
            FSINCOS;
        },
        FFLOOR => {
            FCEIL;
        },
        STRICT_FFLOOR => {
            STRICT_FCEIL;
        },
        LLROUND => {
            LROUND;
        },
        STRICT_LLROUND => {
            STRICT_LROUND;
        },
        BUILD_VECTOR => {
            let mut EltVT: MVT = OVT.getVectorElementType();
            let mut NewEltVT: MVT = NVT.getVectorElementType();
            assert!(NVT.isVector() && OVT.getSizeInBits() == NVT.getSizeInBits(), "Invalid promote type for build_vector");
            assert!(NewEltVT.bitsLE(EltVT), "not handled");
            let mut MidVT: MVT = getPromotedVectorElementType(self.TLI, EltVT, NewEltVT);
            let mut NewOps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
            for Op in Node.op_values() {
                NewOps.push(self.DAG.getNode(BITCAST, SDLoc { Op }, EVT { MidVT }, Op));
            }
            let mut SL: SDLoc = SDLoc { Node };
            let mut Concat: SDValue = self.DAG.getNode(if MidVT == NewEltVT { BUILD_VECTOR } else { CONCAT_VECTORS }, SL, EVT { NVT }, ArrayRef<SDValue> { NewOps });
            let mut CvtVec: SDValue = self.DAG.getNode(BITCAST, SL, EVT { OVT }, Concat);
            Results.push(ValueParamT { CvtVec });
            break;
        },
        EXTRACT_VECTOR_ELT => {
            let mut EltVT: MVT = OVT.getVectorElementType();
            let mut NewEltVT: MVT = NVT.getVectorElementType();
            assert!(NVT.isVector() && OVT.getSizeInBits() == NVT.getSizeInBits(), "Invalid promote type for extract_vector_elt");
            assert!(NewEltVT.bitsLT(EltVT), "not handled");
            let mut MidVT: MVT = getPromotedVectorElementType(self.TLI, EltVT, NewEltVT);
            let mut NewEltsPerOldElt: u32 = MidVT.getVectorNumElements();
            let mut Idx: SDValue = Node.getOperand(1);
            let mut IdxVT: EVT = Idx.getValueType();
            let mut SL: SDLoc = SDLoc { Node };
            let mut Factor: SDValue = self.DAG.getConstant(NewEltsPerOldElt, SL, IdxVT, false, false);
            let mut NewBaseIdx: SDValue = self.DAG.getNode(MUL, SL, IdxVT, Idx, Factor);
            let mut CastVec: SDValue = self.DAG.getNode(BITCAST, SL, EVT { NVT }, Node.getOperand(0));
            let mut NewOps: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
            for let mut I: u32 = 0; I < NewEltsPerOldElt; I += 1 {
                let mut IdxOffset: SDValue = self.DAG.getConstant(I, SL, IdxVT, false, false);
                let mut TmpIdx: SDValue = self.DAG.getNode(ADD, SL, IdxVT, NewBaseIdx, IdxOffset);
                let mut Elt: SDValue = self.DAG.getNode(EXTRACT_VECTOR_ELT, SL, EVT { NewEltVT }, CastVec, TmpIdx);
                NewOps.push(ValueParamT { Elt });
            }
            let mut NewVec: SDValue = self.DAG.getBuildVector(EVT { MidVT }, SL, ArrayRef<SDValue> { NewOps });
            Results.push(self.DAG.getNode(BITCAST, SL, EVT { EltVT }, NewVec));
            break;
        },
        INSERT_VECTOR_ELT => {
            let mut EltVT: MVT = OVT.getVectorElementType();
            let mut NewEltVT: MVT = NVT.getVectorElementType();
            assert!(NVT.isVector() && OVT.getSizeInBits() == NVT.getSizeInBits(), "Invalid promote type for insert_vector_elt");
            assert!(NewEltVT.bitsLT(EltVT), "not handled");
            let mut MidVT: MVT = getPromotedVectorElementType(self.TLI, EltVT, NewEltVT);
            let mut NewEltsPerOldElt: u32 = MidVT.getVectorNumElements();
            let mut Val: SDValue = Node.getOperand(1);
            let mut Idx: SDValue = Node.getOperand(2);
            let mut IdxVT: EVT = Idx.getValueType();
            let mut SL: SDLoc = SDLoc { Node };
            let mut Factor: SDValue = self.DAG.getConstant(NewEltsPerOldElt, SDLoc {}, IdxVT, false, false);
            let mut NewBaseIdx: SDValue = self.DAG.getNode(MUL, SL, IdxVT, Idx, Factor);
            let mut CastVec: SDValue = self.DAG.getNode(BITCAST, SL, EVT { NVT }, Node.getOperand(0));
            let mut CastVal: SDValue = self.DAG.getNode(BITCAST, SL, EVT { MidVT }, Val);
            let mut NewVec: SDValue = CastVec;
            for let mut I: u32 = 0; I < NewEltsPerOldElt; I += 1 {
                let mut IdxOffset: SDValue = self.DAG.getConstant(I, SL, IdxVT, false, false);
                let mut InEltIdx: SDValue = self.DAG.getNode(ADD, SL, IdxVT, NewBaseIdx, IdxOffset);
                let mut Elt: SDValue = self.DAG.getNode(EXTRACT_VECTOR_ELT, SL, EVT { NewEltVT }, CastVal, IdxOffset);
                NewVec = self.DAG.getNode(INSERT_VECTOR_ELT, SL, EVT { NVT }, NewVec, Elt, InEltIdx);
            }
            Results.push(self.DAG.getNode(BITCAST, SL, EVT { OVT }, NewVec));
            break;
        },
        SCALAR_TO_VECTOR => {
            let mut EltVT: MVT = OVT.getVectorElementType();
            let mut NewEltVT: MVT = NVT.getVectorElementType();
            let mut MidVT: MVT = getPromotedVectorElementType(self.TLI, EltVT, NewEltVT);
            let mut Val: SDValue = Node.getOperand(0);
            let mut SL: SDLoc = SDLoc { Node };
            let mut CastVal: SDValue = self.DAG.getNode(BITCAST, SL, EVT { MidVT }, Val);
            let mut Undef: SDValue = self.DAG.getUNDEF(EVT { MidVT });
            let mut NewElts: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> {};
            NewElts.push(ValueParamT { CastVal });
            for let mut I: u32 = 1;
let mut NElts: u32 = OVT.getVectorNumElements(); I != NElts; I += 1 {
                NewElts.push(ValueParamT { Undef });
            }
            let mut Concat: SDValue = self.DAG.getNode(CONCAT_VECTORS, SL, EVT { NVT }, ArrayRef<SDValue> { NewElts });
            let mut CvtVec: SDValue = self.DAG.getNode(BITCAST, SL, EVT { OVT }, Concat);
            Results.push(ValueParamT { CvtVec });
            break;
        },
        ATOMIC_SWAP => {
            ATOMIC_STORE;
        },
        ATOMIC_LOAD => {
            let mut AM: *mut AtomicSDNode = cast(Node);
            let mut SL: SDLoc = SDLoc { Node };
            assert!(NVT.getSizeInBits() == OVT.getSizeInBits(), "unexpected promotion type");
            assert!(AM.getMemoryVT().getSizeInBits() == NVT.getSizeInBits(), "unexpected atomic_load with illegal type");
            let mut NewAtomic: SDValue = self.DAG.getAtomic(ATOMIC_LOAD, SL, EVT { NVT }, self.DAG.getVTList(EVT { NVT }, EVT { Other }), ArrayRef<SDValue> { [AM.getChain(), AM.getBasePtr()] }, AM.getMemOperand(), NON_EXTLOAD);
            Results.push(self.DAG.getNode(BITCAST, SL, EVT { OVT }, NewAtomic));
            Results.push(NewAtomic.getValue(1));
            break;
        },
        SPLAT_VECTOR => {
            let mut Scalar: SDValue = Node.getOperand(0);
            let mut ScalarType: MVT = Scalar.getSimpleValueType();
            let mut NewScalarType: MVT = NVT.getVectorElementType();
            if ScalarType.isInteger() {
                Tmp1 = self.DAG.getNode(ANY_EXTEND, dl, EVT { NewScalarType }, Scalar);
                Tmp2 = self.DAG.getNode(Node.getOpcode(), dl, EVT { NVT }, Tmp1);
                Results.push(self.DAG.getNode(TRUNCATE, dl, EVT { OVT }, Tmp2));
                break;
            }
            Tmp1 = self.DAG.getNode(FP_EXTEND, dl, EVT { NewScalarType }, Scalar);
            Tmp2 = self.DAG.getNode(Node.getOpcode(), dl, EVT { NVT }, Tmp1);
            Results.push(self.DAG.getNode(FP_ROUND, dl, EVT { OVT }, Tmp2, self.DAG.getIntPtrConstant(0, dl, true)));
            break;
        },
        VECREDUCE_FMAX => {
            VECREDUCE_FMIN;
        },
    }
    if !Results.is_empty() {
        while true {
            {
            if DebugFlag && isCurrentDebugType("legalizedag", 1) {
                dbgs() << "Successfully promoted node\n";
            }
        }
            if !(false) { break; }
        }
        self.ReplaceNode(Node, Results.ptr);
    } else {
        while true {
            {
            if DebugFlag && isCurrentDebugType("legalizedag", 1) {
                dbgs() << "Could not promote node\n";
            }
        }
            if !(false) { break; }
        }
    }
}

fn SelectionDAG::Legalize(self) {
    self.AssignTopologicalOrder();
    let mut LegalizedNodes: SmallPtrSet<SDNode *, 16> = SmallPtrSet<SDNode *, 16> {};
    let mut DeleteListener: DAGNodeDeletedListener = DAGNodeDeletedListener { *self, function<void (SDNode *, SDNode *)> { Closure_1 { LegalizedNodes: &mut LegalizedNodes } } };
    let mut Legalizer: SelectionDAGLegalize = SelectionDAGLegalize { *self, LegalizedNodes, null };
    while true {
        let mut AnyLegalized: bool = false;
        for let mut NI: allnodes_iterator = self.allnodes_end(); NI != self.allnodes_begin();  {
            operator(NI);
            let mut N: *mut SDNode = &mut operator(NI);
            if N.use_empty() && N != self.getRoot().getNode() {
                operator(NI);
                self.DeleteNode(N);
                continue;
            }
            if LegalizedNodes.insert(N).second {
                AnyLegalized = true;
                Legalizer.LegalizeOp(N);
                if N.use_empty() && N != self.getRoot().getNode() {
                    operator(NI);
                    self.DeleteNode(N);
                }
            }
        }
        if !AnyLegalized {
            break;
        }
    }
    self.RemoveDeadNodes();
}

fn SelectionDAG::LegalizeOp(self, N: *mut SDNode, UpdatedNodes: *mut SmallSetVector<SDNode *, 16>) -> bool {
    let mut LegalizedNodes: SmallPtrSet<SDNode *, 16> = SmallPtrSet<SDNode *, 16> {};
    let mut Legalizer: SelectionDAGLegalize = SelectionDAGLegalize { *self, LegalizedNodes, &mut UpdatedNodes };
    LegalizedNodes.insert(N);
    Legalizer.LegalizeOp(N);
    return LegalizedNodes.count(N);
}

struct Closure_1 {
    LegalizedNodes: *mut SmallPtrSet<SDNode *, 16>,
}

unsafe fn Closure_1::call(self: *mut Closure_1, N: *mut SDNode, E: *mut SDNode) {
        (*self.LegalizedNodes).erase(N);
    }
