static mut VerboseDAGDumping: opt<bool> = opt<bool> { "dag-dump-verbose", Hidden, desc { Desc: "Display more information when dumping selection DAG nodes." } };

static mut PrintSDNodeAddrs: opt<bool> = opt<bool> { "print-sdnode-addrs", Hidden, desc { Desc: "Print addresses of SDNodes when dumping" } };

fn getCondCodeName(Operation: CondCode) -> str {
    match Operation {
        _ => {
            llvm_unreachable_internal("Unknown setcc condition!", "llvm\\lib\\CodeGen\\SelectionDAG\\SelectionDAGDumper.cpp", 65);
        },
        SETOEQ => {
            return "setoeq";
        },
        SETOGT => {
            return "setogt";
        },
        SETOGE => {
            return "setoge";
        },
        SETOLT => {
            return "setolt";
        },
        SETOLE => {
            return "setole";
        },
        SETONE => {
            return "setone";
        },
        SETO => {
            return "seto";
        },
        SETUO => {
            return "setuo";
        },
        SETUEQ => {
            return "setueq";
        },
        SETUGT => {
            return "setugt";
        },
        SETUGE => {
            return "setuge";
        },
        SETULT => {
            return "setult";
        },
        SETULE => {
            return "setule";
        },
        SETUNE => {
            return "setune";
        },
        SETEQ => {
            return "seteq";
        },
        SETGT => {
            return "setgt";
        },
        SETGE => {
            return "setge";
        },
        SETLT => {
            return "setlt";
        },
        SETLE => {
            return "setle";
        },
        SETNE => {
            return "setne";
        },
        SETTRUE => {
            return "settrue";
        },
        SETTRUE2 => {
            return "settrue2";
        },
        SETFALSE => {
            return "setfalse";
        },
        SETFALSE2 => {
            return "setfalse2";
        },
    }
}

fn SDNode::getOperationName(self: *SDNode, G: *SelectionDAG) -> str {
    match self.getOpcode() {
        _ => {
            if self.getOpcode() < BUILTIN_OP_END {
                return "<<Unknown DAG Node>>";
            }
        },
        DELETED_NODE => {
            return "<<Deleted Node!>>";
        },
