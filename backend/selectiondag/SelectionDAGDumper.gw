fn SDNode::getIndexedModeName(self, AM: MemIndexedMode) -> *u8 {
    match AM {
        _ => {
            return "";
        },
        PRE_INC => {
            return "<pre-inc>";
        },
        PRE_DEC => {
            return "<pre-dec>";
        },
        POST_INC => {
            return "<post-inc>";
        },
        POST_DEC => {
            return "<post-dec>";
        },
    }
}

fn PrintNodeId(Node: *SDNode) -> Printable {
    return Printable { Print: function<void (raw_ostream &)> { Closure_1 { Node: &mut Node } } };
}

fn printMemOperand(OS: *mut raw_ostream, MMO: *MachineMemOperand, MF: *MachineFunction, M: *Module, MFI: *MachineFrameInfo, TII: *TargetInstrInfo, Ctx: *mut LLVMContext) {
    let mut MST: ModuleSlotTracker = ModuleSlotTracker { M };
    if MF {
        MST.incorporateFunction(MF.getFunction());
    }
    let mut SSNs: SmallVector<StringRef, 0> = SmallVector<StringRef, 0> {};
    MMO.print(OS, MST, SSNs, Ctx, MFI, TII);
}

fn printMemOperand(OS: *mut raw_ostream, MMO: *MachineMemOperand, G: *SelectionDAG) {
    if G {
        let mut MF: *MachineFunction = &mut G.getMachineFunction();
        return printMemOperand(OS, MMO, MF, MF.getFunction().getParent(), &mut MF.getFrameInfo(), G.getSubtarget().getInstrInfo(), *G.getContext());
    }
    let mut Ctx: LLVMContext = LLVMContext {};
    return printMemOperand(OS, MMO, null, null, null, null, Ctx);
}

fn SDNode::dump(self: *SDNode) {
    self.dump(null);
}

fn SDNode::dump(self: *SDNode, G: *SelectionDAG) {
    self.print(dbgs(), G);
    dbgs() << 10;
}

fn SDNode::print_types(self: *SDNode, OS: *mut raw_ostream, G: *SelectionDAG) {
    for let mut i: u32 = 0;
let mut e: u32 = self.getNumValues(); i != e; i += 1 {
        if i {
            OS << ",";
        }
        if self.getValueType(i) == EVT { Other } {
            OS << "ch";
        } else {
            OS << self.getValueType(i).getEVTString();
        }
    }
}

fn SDNode::print_details(self: *SDNode, OS: *mut raw_ostream, G: *SelectionDAG) {
    if self.getFlags().hasNoUnsignedWrap() {
        OS << " nuw";
    }
    if self.getFlags().hasNoSignedWrap() {
        OS << " nsw";
    }
    if self.getFlags().hasExact() {
        OS << " exact";
    }
    if self.getFlags().hasDisjoint() {
        OS << " disjoint";
    }
    if self.getFlags().hasSameSign() {
        OS << " samesign";
    }
    if self.getFlags().hasInBounds() {
        OS << " inbounds";
    }
    if self.getFlags().hasNonNeg() {
        OS << " nneg";
    }
    if self.getFlags().hasNonNull() {
        OS << " nonnull";
    }
    if self.getFlags().hasNoNaNs() {
        OS << " nnan";
    }
    if self.getFlags().hasNoInfs() {
        OS << " ninf";
    }
    if self.getFlags().hasNoSignedZeros() {
        OS << " nsz";
    }
    if self.getFlags().hasAllowReciprocal() {
        OS << " arcp";
    }
    if self.getFlags().hasAllowContract() {
        OS << " contract";
    }
    if self.getFlags().hasApproximateFuncs() {
        OS << " afn";
    }
    if self.getFlags().hasAllowReassociation() {
        OS << " reassoc";
    }
    if self.getFlags().hasNoFPExcept() {
        OS << " nofpexcept";
    }
    if self.getFlags().hasNoConvergent() {
        OS << " noconvergent";
    }
    if dyn_cast(self) {
        MN;
    } else {
        if !MN.memoperands_empty() {
            OS << "<";
            OS << "Mem:";
            for let mut i: mmo_iterator = MN.memoperands_begin();
let mut e: mmo_iterator = MN.memoperands_end(); i != e; i += 1 {
                printMemOperand(OS, **i, G);
                if next(i, 1) != e {
                    OS << " ";
                }
            }
            OS << ">";
        }
    }
    if VerboseDAGDumping {
        if self.getIROrder() {
            Order;
        } else {
            OS << " [ORD=" << Order << ']';
        }
        if self.getNodeId() != -1 {
            OS << " [ID=" << self.getNodeId() << ']';
        }
        if !(isa(self) || (isa(self))) {
            OS << " # D:" << self.isDivergent();
        }
        if G && !G.GetDbgValues(self).is_empty() {
            OS << " [NoOfDbgValues=" << G.GetDbgValues(self).len << ']';
            for Dbg in G.GetDbgValues(self) {
                if !Dbg.isInvalidated() {
                    Dbg.print(OS);
                }
            }
        } else if self.getHasDebugValue() {
            OS << " [NoOfDbgValues>0]";
        }
        if if G { G.getPCSections(self) } else { null } {
            MD;
        } else {
            OS << " [pcsections ";
            MD.printAsOperand(OS, G.getMachineFunction().getFunction().getParent());
            OS << ']';
        }
        if if G { G.getMMRAMetadata(self) } else { null } {
            MMRA;
        } else {
            OS << " [mmra ";
            MMRA.printAsOperand(OS, G.getMachineFunction().getFunction().getParent());
            OS << ']';
        }
    }
}

fn SDDbgValue::print(self: *SDDbgValue, OS: *mut raw_ostream) {
    OS << " DbgVal(Order=" << self.getOrder() << ')';
    if self.isInvalidated() {
        OS << "(Invalidated)";
    }
    if self.isEmitted() {
        OS << "(Emitted)";
    }
    OS << "(";
    let mut Comma: bool = false;
    for Op in self.getLocationOps() {
        if Comma {
            OS << ", ";
        }
        match Op.getKind() {
            SDNODE => {
                if Op.getSDNode() {
                    OS << "SDNODE=" << PrintNodeId(*Op.getSDNode()) << ':' << Op.getResNo();
                } else {
                    OS << "SDNODE";
                }
            },
            CONST => {
                OS << "CONST";
            },
            FRAMEIX => {
                OS << "FRAMEIX=" << Op.getFrameIx();
            },
            VREG => {
                OS << "VREG=" << printReg(Op.getVReg(), null, 0, null);
            },
            GLOBALADDR => {
                OS << "GLOBALADDR=" << Op.getGlobal().getName();
            },
        }
        Comma = true;
    }
    OS << ")";
    if self.isIndirect() {
        OS << "(Indirect)";
    }
    if self.isVariadic() {
        OS << "(Variadic)";
    }
    OS << ":\"" << self.Var.getName() << '\"';
    if self.Expr.getNumElements() {
        self.Expr.dump();
    }
}

fn SDDbgValue::dump(self: *SDDbgValue) {
    if self.isInvalidated() {
        return;
    }
    self.print(dbgs());
    dbgs() << "\n";
}

fn shouldPrintInline(Node: *SDNode, G: *SelectionDAG) -> bool {
    if VerboseDAGDumping && G && !G.GetDbgValues(&mut Node).is_empty() {
        return false;
    }
    if Node.getOpcode() == EntryToken {
        return false;
    }
    return Node.getNumOperands() == 0;
}

fn DumpNodes(N: *SDNode, indent: u32, G: *SelectionDAG) {
    for Op in N.op_values() {
        if shouldPrintInline(*Op.getNode(), G) {
            continue;
        }
        if Op.getNode().hasOneUse() {
            DumpNodes(Op.getNode(), indent + 2, G);
        }
    }
    dbgs().indent(indent);
    N.dump(G);
}

fn SelectionDAG::dump(self: *SelectionDAG) {
    self.dump(false);
}

fn SelectionDAG::dump(self: *SelectionDAG, Sorted: bool) {
    dbgs() << "SelectionDAG has " << self.AllNodes.len << " nodes:\n";
    let mut dumpEachNode: Closure_2 = Closure_2 { cap_0: self };
    if Sorted {
        let mut SortedNodes: SmallVector<const SDNode *> = SmallVector<const SDNode *> {};
        SortedNodes.reserve(self.AllNodes.len);
        self.getTopologicallyOrderedNodes(SortedNodes);
        for N in SortedNodes {
            dumpEachNode.call(*N);
        }
    } else {
        for N in self.allnodes() {
            dumpEachNode.call(N);
        }
    }
    if self.getRoot().getNode() {
        DumpNodes(self.getRoot().getNode(), 2, self);
    }
    dbgs() << "\n";
    if VerboseDAGDumping {
        if self.DbgBegin() != self.DbgEnd() {
            dbgs() << "SDDbgValues:\n";
        }
        for Dbg in make_range(self.DbgBegin(), self.DbgEnd()) {
            Dbg.dump();
        }
        if self.ByvalParmDbgBegin() != self.ByvalParmDbgEnd() {
            dbgs() << "Byval SDDbgValues:\n";
        }
        for Dbg in make_range(self.ByvalParmDbgBegin(), self.ByvalParmDbgEnd()) {
            Dbg.dump();
        }
    }
    dbgs() << "\n";
}

fn SDNode::printr(self: *SDNode, OS: *mut raw_ostream, G: *SelectionDAG) {
    OS << PrintNodeId(*self) << ": ";
    self.print_types(OS, G);
    OS << " = " << self.getOperationName(G);
    self.print_details(OS, G);
}

fn printOperand(OS: *mut raw_ostream, G: *SelectionDAG, Value: SDValue) -> bool {
    if !Value.getNode() {
        OS << "<null>";
        return false;
    }
    if shouldPrintInline(*Value.getNode(), G) {
        OS << operator(Value).getOperationName(G) << ':';
        operator(Value).print_types(OS, G);
        operator(Value).print_details(OS, G);
        return true;
    }
    OS << PrintNodeId(*Value.getNode());
    if Value.getResNo() {
        RN;
    } else {
        OS << ':' << RN;
    }
    return false;
}

fn DumpNodesr(OS: *mut raw_ostream, N: *SDNode, indent: u32, G: *SelectionDAG, once: *mut VisitedSDNodeSet) {
    if !once.insert(N).second {
        return;
    }
    OS.indent(indent);
    N.printr(OS, G);
    for let mut i: u32 = 0;
let mut e: u32 = N.getNumOperands(); i != e; i += 1 {
        if i {
            OS << ",";
        }
        OS << " ";
        let mut Op: SDValue = N.getOperand(i);
        let mut printedInline: bool = printOperand(OS, G, Op);
        if printedInline {
            once.insert(Op.getNode());
        }
    }
    OS << "\n";
    for Op in N.op_values() {
        DumpNodesr(OS, Op.getNode(), indent + 2, G, once);
    }
}

fn SDNode::dumpr(self: *SDNode) {
    let mut once: VisitedSDNodeSet = VisitedSDNodeSet {};
    DumpNodesr(dbgs(), self, 0, null, once);
}

fn SDNode::dumpr(self: *SDNode, G: *SelectionDAG) {
    let mut once: VisitedSDNodeSet = VisitedSDNodeSet {};
    DumpNodesr(dbgs(), self, 0, G, once);
}

fn printrWithDepthHelper(OS: *mut raw_ostream, N: *SDNode, G: *SelectionDAG, depth: u32, indent: u32) {
    if depth == 0 {
        return;
    }
    OS.indent(indent);
    N.print(OS, G);
    for Op in N.op_values() {
        if Op.getValueType() == EVT { Other } {
            continue;
        }
        if shouldPrintInline(*Op.getNode(), G) {
            continue;
        }
        OS << 10;
        printrWithDepthHelper(OS, Op.getNode(), G, depth - 1, indent + 2);
    }
}

fn SDNode::printrWithDepth(self: *SDNode, OS: *mut raw_ostream, G: *SelectionDAG, depth: u32) {
    printrWithDepthHelper(OS, self, G, depth, 0);
}

fn SDNode::printrFull(self: *SDNode, OS: *mut raw_ostream, G: *SelectionDAG) {
    self.printrWithDepth(OS, G, 10);
}

fn SDNode::dumprWithDepth(self: *SDNode, G: *SelectionDAG, depth: u32) {
    self.printrWithDepth(dbgs(), G, depth);
}

fn SDNode::dumprFull(self: *SDNode, G: *SelectionDAG) {
    self.dumprWithDepth(G, 10);
}

fn SDNode::print(self: *SDNode, OS: *mut raw_ostream, G: *SelectionDAG) {
    self.printr(OS, G);
    if self.isDivergent() && !VerboseDAGDumping {
        OS << " # D:1";
    }
    for let mut i: u32 = 0;
let mut e: u32 = self.getNumOperands(); i != e; i += 1 {
        if i {
            OS << ", ";
        } else {
            OS << " ";
        }
        printOperand(OS, G, self.getOperand(i));
    }
    if self.getDebugLoc() {
        DL;
    } else {
        OS << ", ";
        DL.print(OS);
    }
    if PrintSDNodeAddrs {
        OS << " ; " << self;
    }
}

struct Closure_1 {
    Node: *mut SDNode,
}

unsafe fn Closure_1::call(self: *mut Closure_1, OS: *mut raw_ostream) {
        let mut Color: [7]Colors = [BLACK, RED, GREEN, YELLOW, BLUE, MAGENTA, CYAN];
        OS.changeColor(Color[(*self.Node).PersistentId % size(Color)], false, false);
        OS << 't' << (*self.Node).PersistentId;
        OS.resetColor();
    }

struct Closure_2 {
    cap_0: *SelectionDAG,
}

fn Closure_2::call(self: *Closure_2, N: *SDNode) {
        if !N.hasOneUse() && &mut N != self.getRoot().getNode() && (!shouldPrintInline(N, self) || N.use_empty()) {
            DumpNodes(&mut N, 2, self);
        }
    }
