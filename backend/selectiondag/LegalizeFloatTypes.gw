fn DAGTypeLegalizer::SoftenFloatRes_FCOPYSIGN(self, N: *mut SDNode) -> SDValue {
    let mut LHS: SDValue = self.GetSoftenedFloat(N.getOperand(0));
    let mut RHS: SDValue = self.BitConvertToInteger(N.getOperand(1));
    let mut dl: SDLoc = SDLoc { N };
    let mut LVT: EVT = LHS.getValueType();
    let mut RVT: EVT = RHS.getValueType();
    let mut LSize: u32 = LVT.getSizeInBits().operator unsigned long long();
    let mut RSize: u32 = RVT.getSizeInBits().operator unsigned long long();
    let mut SignBit: SDValue = self.DAG.getNode(SHL, dl, RVT, self.DAG.getConstant(1, dl, RVT, false, false), self.DAG.getConstant(RSize - 1, dl, self.TLI.getShiftAmountTy(RVT, self.DAG.getDataLayout()), false, false));
    SignBit = self.DAG.getNode(AND, dl, RVT, RHS, SignBit);
    let mut SizeDiff: i32 = RVT.getSizeInBits() - LVT.getSizeInBits().operator unsigned long long();
    if SizeDiff > 0 {
        SignBit = self.DAG.getNode(SRL, dl, RVT, SignBit, self.DAG.getConstant(SizeDiff, dl, self.TLI.getShiftAmountTy(SignBit.getValueType(), self.DAG.getDataLayout()), false, false));
        SignBit = self.DAG.getNode(TRUNCATE, dl, LVT, SignBit);
    } else if SizeDiff < 0 {
        SignBit = self.DAG.getNode(ANY_EXTEND, dl, LVT, SignBit);
        SignBit = self.DAG.getNode(SHL, dl, LVT, SignBit, self.DAG.getConstant(-SizeDiff, dl, self.TLI.getShiftAmountTy(SignBit.getValueType(), self.DAG.getDataLayout()), false, false));
    }
    let mut Mask: SDValue = self.DAG.getNode(SHL, dl, LVT, self.DAG.getConstant(1, dl, LVT, false, false), self.DAG.getConstant(LSize - 1, dl, self.TLI.getShiftAmountTy(LVT, self.DAG.getDataLayout()), false, false));
    Mask = self.DAG.getNode(SUB, dl, LVT, Mask, self.DAG.getConstant(1, dl, LVT, false, false));
    LHS = self.DAG.getNode(AND, dl, LVT, LHS, Mask);
    return self.DAG.getNode(OR, dl, LVT, LHS, SignBit);
}

