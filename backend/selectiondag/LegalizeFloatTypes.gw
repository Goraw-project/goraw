fn reportNoLibcall(DAG: *mut SelectionDAG, N: *mut SDNode, VT: EVT) {
    DAG.getContext().emitError("no libcall available for " + N.getOperationName(&mut DAG) + " with type " + VT.getEVTString());
}

fn GetFPLibCall(VT: EVT, Call_F32: Libcall, Call_F64: Libcall, Call_F80: Libcall, Call_F128: Libcall, Call_PPCF128: Libcall) -> Libcall {
    return if VT == EVT { f32 } { Call_F32 } else { if VT == EVT { f64 } { Call_F64 } else { if VT == EVT { f80 } { Call_F80 } else { if VT == EVT { f128 } { Call_F128 } else { if VT == EVT { ppcf128 } { Call_PPCF128 } else { UNKNOWN_LIBCALL } } } } };
}

fn DAGTypeLegalizer::SoftenFloatResult(self, N: *mut SDNode, ResNo: u32) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalize-types", 1) {
            dbgs() << "Soften float result " << ResNo << ": ";
            N.dump(&mut self.DAG);
        }
    }
        if !(false) { break; }
    }
    let mut R: SDValue = SDValue {};
    match N.getOpcode() {
        _ => {
            dbgs() << "SoftenFloatResult #" << ResNo << ": ";
        },
        EXTRACT_ELEMENT => {
            R = self.SoftenFloatRes_EXTRACT_ELEMENT(N);
        },
        ARITH_FENCE => {
            R = self.SoftenFloatRes_ARITH_FENCE(N);
        },
        MERGE_VALUES => {
            R = self.SoftenFloatRes_MERGE_VALUES(N, ResNo);
        },
        BITCAST => {
            R = self.SoftenFloatRes_BITCAST(N);
        },
        BUILD_PAIR => {
            R = self.SoftenFloatRes_BUILD_PAIR(N);
        },
        ConstantFP => {
            R = self.SoftenFloatRes_ConstantFP(N);
        },
        EXTRACT_VECTOR_ELT => {
            R = self.SoftenFloatRes_EXTRACT_VECTOR_ELT(N, ResNo);
        },
        FABS => {
            R = self.SoftenFloatRes_FABS(N);
        },
        FCANONICALIZE => {
            R = self.SoftenFloatRes_FCANONICALIZE(N);
        },
        STRICT_FMINNUM => {
            FMINNUM;
        },
        STRICT_FMAXNUM => {
            FMAXNUM;
        },
        FMINIMUMNUM => {
            R = self.SoftenFloatRes_FMINIMUMNUM(N);
        },
        FMAXIMUMNUM => {
            R = self.SoftenFloatRes_FMAXIMUMNUM(N);
        },
        FMINIMUM => {
            R = self.SoftenFloatRes_FMINIMUM(N);
        },
        FMAXIMUM => {
            R = self.SoftenFloatRes_FMAXIMUM(N);
        },
        STRICT_FADD => {
            FADD;
        },
        STRICT_FACOS => {
            FACOS;
        },
        STRICT_FASIN => {
            FASIN;
        },
        STRICT_FATAN => {
            FATAN;
        },
        STRICT_FATAN2 => {
            FATAN2;
        },
        FCBRT => {
            R = self.SoftenFloatRes_FCBRT(N);
        },
        STRICT_FCEIL => {
            FCEIL;
        },
        FCOPYSIGN => {
            R = self.SoftenFloatRes_FCOPYSIGN(N);
        },
        STRICT_FCOS => {
            FCOS;
        },
        STRICT_FCOSH => {
            FCOSH;
        },
        STRICT_FDIV => {
            FDIV;
        },
        STRICT_FEXP => {
            FEXP;
        },
        STRICT_FEXP2 => {
            FEXP2;
        },
        FEXP10 => {
            R = self.SoftenFloatRes_FEXP10(N);
        },
        STRICT_FFLOOR => {
            FFLOOR;
        },
        STRICT_FLOG => {
            FLOG;
        },
        STRICT_FLOG2 => {
            FLOG2;
        },
        STRICT_FLOG10 => {
            FLOG10;
        },
        STRICT_FMA => {
            FMA;
        },
        STRICT_FMUL => {
            FMUL;
        },
        STRICT_FNEARBYINT => {
            FNEARBYINT;
        },
        FNEG => {
            R = self.SoftenFloatRes_FNEG(N);
        },
        STRICT_FP_EXTEND => {
            FP_EXTEND;
        },
        STRICT_FP_ROUND => {
            FP_ROUND;
        },
        FP16_TO_FP => {
            R = self.SoftenFloatRes_FP16_TO_FP(N);
        },
        BF16_TO_FP => {
            R = self.SoftenFloatRes_BF16_TO_FP(N);
        },
        STRICT_FPOW => {
            FPOW;
        },
        STRICT_FPOWI => {
            FPOWI;
        },
        FFREXP => {
            R = self.SoftenFloatRes_FFREXP(N);
        },
        FSINCOS => {
            R = self.SoftenFloatRes_FSINCOS(N);
        },
        FMODF => {
            R = self.SoftenFloatRes_FMODF(N);
        },
        STRICT_FREM => {
            FREM;
        },
        STRICT_FRINT => {
            FRINT;
        },
        STRICT_FROUND => {
            FROUND;
        },
        STRICT_FROUNDEVEN => {
            FROUNDEVEN;
        },
        STRICT_FSIN => {
            FSIN;
        },
        STRICT_FSINH => {
            FSINH;
        },
        STRICT_FSQRT => {
            FSQRT;
        },
        STRICT_FSUB => {
            FSUB;
        },
        STRICT_FTAN => {
            FTAN;
        },
        STRICT_FTANH => {
            FTANH;
        },
        STRICT_FTRUNC => {
            FTRUNC;
        },
        LOAD => {
            R = self.SoftenFloatRes_LOAD(N);
        },
        ATOMIC_LOAD => {
            R = self.SoftenFloatRes_ATOMIC_LOAD(N);
        },
        ATOMIC_SWAP => {
            R = self.BitcastToInt_ATOMIC_SWAP(N);
        },
        SELECT => {
            R = self.SoftenFloatRes_SELECT(N);
        },
        SELECT_CC => {
            R = self.SoftenFloatRes_SELECT_CC(N);
        },
        FREEZE => {
            R = self.SoftenFloatRes_FREEZE(N);
        },
        STRICT_SINT_TO_FP => {
            STRICT_UINT_TO_FP;
        },
        POISON => {
            UNDEF;
        },
        VAARG => {
            R = self.SoftenFloatRes_VAARG(N);
        },
        AssertNoFPClass => {
            R = self.GetSoftenedFloat(N.getOperand(0));
        },
        VECREDUCE_FADD => {
            VECREDUCE_FMUL;
        },
        VECREDUCE_SEQ_FADD => {
            VECREDUCE_SEQ_FMUL;
        },
    }
    if R.getNode() {
        assert!(R.getNode() != N);
        self.SetSoftenedFloat(SDValue { Node: N, ResNo: ResNo }, R);
    }
}

fn DAGTypeLegalizer::SoftenFloatRes_NoLibcall(self, N: *mut SDNode, NVT: EVT) -> SDValue {
    reportNoLibcall(self.DAG, N, N.getValueType(0));
    if N.isStrictFPOpcode() {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, N.getOperand(0));
    }
    return self.DAG.getPOISON(NVT);
}

fn DAGTypeLegalizer::SoftenFloatRes_Unary(self, N: *mut SDNode, LC: Libcall) -> SDValue {
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut Offset: u32 = if IsStrict { 1 } else { 0 };
    assert!(N.getNumOperands() == (1 + Offset), "Unexpected number of operands!");
    let mut Op: SDValue = self.GetSoftenedFloat(N.getOperand(0 + Offset));
    let mut Chain: SDValue = if IsStrict { N.getOperand(0) } else { SDValue {} };
    let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if LCImpl == Unsupported {
        return self.SoftenFloatRes_NoLibcall(N, NVT);
    }
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    let mut OpVT: EVT = N.getOperand(0 + Offset).getValueType();
    CallOptions.setTypeListBeforeSoften(ArrayRef<EVT> { OpVT }, N.getValueType(0));
    let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, LCImpl, NVT, ArrayRef<SDValue> { Op }, CallOptions, SDLoc { N }, Chain);
    if IsStrict {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Tmp.second);
    }
    return Tmp.first;
}

fn DAGTypeLegalizer::SoftenFloatRes_Binary(self, N: *mut SDNode, LC: Libcall) -> SDValue {
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut Offset: u32 = if IsStrict { 1 } else { 0 };
    assert!(N.getNumOperands() == (2 + Offset), "Unexpected number of operands!");
    let mut Ops: [2]SDValue = [self.GetSoftenedFloat(N.getOperand(0 + Offset)), self.GetSoftenedFloat(N.getOperand(1 + Offset))];
    let mut Chain: SDValue = if IsStrict { N.getOperand(0) } else { SDValue {} };
    let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if LCImpl == Unsupported {
        return self.SoftenFloatRes_NoLibcall(N, NVT);
    }
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    let mut OpsVT: [2]EVT = [N.getOperand(0 + Offset).getValueType(), N.getOperand(1 + Offset).getValueType()];
    CallOptions.setTypeListBeforeSoften(ArrayRef<EVT> { OpsVT }, N.getValueType(0));
    let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, LCImpl, NVT, ArrayRef<SDValue> { Ops }, CallOptions, SDLoc { N }, Chain);
    if IsStrict {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Tmp.second);
    }
    return Tmp.first;
}

fn DAGTypeLegalizer::SoftenFloatRes_BITCAST(self, N: *mut SDNode) -> SDValue {
    return self.BitConvertToInteger(N.getOperand(0));
}

fn DAGTypeLegalizer::SoftenFloatRes_FREEZE(self, N: *mut SDNode) -> SDValue {
    let mut Ty: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    return self.DAG.getNode(FREEZE, SDLoc { N }, Ty, self.GetSoftenedFloat(N.getOperand(0)));
}

fn DAGTypeLegalizer::SoftenFloatRes_ARITH_FENCE(self, N: *mut SDNode) -> SDValue {
    let mut Ty: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut NewFence: SDValue = self.DAG.getNode(ARITH_FENCE, SDLoc { N }, Ty, self.GetSoftenedFloat(N.getOperand(0)));
    return NewFence;
}

fn DAGTypeLegalizer::SoftenFloatRes_MERGE_VALUES(self, N: *mut SDNode, ResNo: u32) -> SDValue {
    let mut Op: SDValue = self.DisintegrateMERGE_VALUES(N, ResNo);
    return self.BitConvertToInteger(Op);
}

fn DAGTypeLegalizer::SoftenFloatRes_BUILD_PAIR(self, N: *mut SDNode) -> SDValue {
    return self.DAG.getNode(BUILD_PAIR, SDLoc { N }, self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0)), self.BitConvertToInteger(N.getOperand(0)), self.BitConvertToInteger(N.getOperand(1)));
}

fn DAGTypeLegalizer::SoftenFloatRes_ConstantFP(self, N: *mut SDNode) -> SDValue {
    let mut CN: *mut ConstantFPSDNode = cast(N);
    if self.DAG.getDataLayout().isBigEndian() && CN.getValueType(0).getSimpleVT() == ppcf128 {
        let mut words: [2]u64 = [CN.getValueAPF().bitcastToAPInt().getRawData()[1], CN.getValueAPF().bitcastToAPInt().getRawData()[0]];
        let mut Val: APInt = APInt { U: 128, BitWidth: ArrayRef<uint64_t> { words } };
        return self.DAG.getConstant(Val, SDLoc { CN }, self.TLI.getTypeToTransformTo(*self.DAG.getContext(), CN.getValueType(0)), false, false);
    } else {
        return self.DAG.getConstant(CN.getValueAPF().bitcastToAPInt(), SDLoc { CN }, self.TLI.getTypeToTransformTo(*self.DAG.getContext(), CN.getValueType(0)), false, false);
    }
}

fn DAGTypeLegalizer::SoftenFloatRes_EXTRACT_ELEMENT(self, N: *mut SDNode) -> SDValue {
    let mut Src: SDValue = N.getOperand(0);
    assert!(Src.getValueType() == EVT { ppcf128 }, "In floats only ppcf128 can be extracted by element!");
    return self.DAG.getNode(EXTRACT_ELEMENT, SDLoc { N }, N.getValueType(0).changeTypeToInteger(), self.DAG.getBitcast(EVT { i128 }, Src), N.getOperand(1));
}

fn DAGTypeLegalizer::SoftenFloatRes_EXTRACT_VECTOR_ELT(self, N: *mut SDNode, ResNo: u32) -> SDValue {
    let mut NewOp: SDValue = self.BitConvertVectorToIntegerVector(N.getOperand(0));
    return self.DAG.getNode(EXTRACT_VECTOR_ELT, SDLoc { N }, NewOp.getValueType().getVectorElementType(), NewOp, N.getOperand(1));
}

fn DAGTypeLegalizer::SoftenFloatRes_FABS(self, N: *mut SDNode) -> SDValue {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut Size: u32 = NVT.getSizeInBits().operator unsigned long long();
    let mut API: APInt = getAllOnes(Size);
    API.clearBit(Size - 1);
    let mut Mask: SDValue = self.DAG.getConstant(API, SDLoc { N }, NVT, false, false);
    let mut Op: SDValue = self.GetSoftenedFloat(N.getOperand(0));
    return self.DAG.getNode(AND, SDLoc { N }, NVT, Op, Mask);
}

fn DAGTypeLegalizer::SoftenFloatRes_FCANONICALIZE(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut Operand: SDValue = N.getOperand(0);
    let mut VT: EVT = Operand.getValueType();
    let mut One: SDValue = self.DAG.getConstantFP(1.0, dl, VT, false);
    let mut Chain: SDValue = self.DAG.getEntryNode();
    let mut CanonicalizeFlags: SDNodeFlags = N.getFlags();
    CanonicalizeFlags.setNoFPExcept(true);
    let mut Mul: SDValue = self.DAG.getNode(STRICT_FMUL, dl, ArrayRef<EVT> { [VT, EVT { Other }] }, ArrayRef<SDValue> { [Chain, Operand, One] }, CanonicalizeFlags);
    return self.BitConvertToInteger(Mul);
}

fn DAGTypeLegalizer::SoftenFloatRes_FMINNUM(self, N: *mut SDNode) -> SDValue {
    if self.TLI.createSelectForFMINNUM_FMAXNUM(N, self.DAG) {
        SelCC;
    } else {
        return self.SoftenFloatRes_SELECT_CC(SelCC.getNode());
    }
    return self.SoftenFloatRes_Binary(N, getFMIN(N.getValueType(0)));
}

fn DAGTypeLegalizer::SoftenFloatRes_FMAXNUM(self, N: *mut SDNode) -> SDValue {
    if self.TLI.createSelectForFMINNUM_FMAXNUM(N, self.DAG) {
        SelCC;
    } else {
        return self.SoftenFloatRes_SELECT_CC(SelCC.getNode());
    }
    return self.SoftenFloatRes_Binary(N, getFMAX(N.getValueType(0)));
}

fn DAGTypeLegalizer::SoftenFloatRes_FMINIMUMNUM(self, N: *mut SDNode) -> SDValue {
    return self.SoftenFloatRes_Binary(N, getFMINIMUM_NUM(N.getValueType(0)));
}

