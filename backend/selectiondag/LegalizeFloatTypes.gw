fn DAGTypeLegalizer::SoftenFloatRes_LOAD(self, N: *mut SDNode) -> SDValue {
    let mut L: *mut LoadSDNode = cast(N);
    let mut VT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut dl: SDLoc = SDLoc { N };
    let mut MMOFlags: Flags = L.getMemOperand().getFlags() & operator((MOInvariant | MODereferenceable));
    let mut NewL: SDValue = SDValue {};
    if L.getExtensionType() == NON_EXTLOAD {
        let mut MemVT: EVT = getIntegerVT(*self.DAG.getContext(), VT.getSizeInBits().operator unsigned long long());
        NewL = self.DAG.getLoad(L.getAddressingMode(), EXTLOAD, NVT, dl, L.getChain(), L.getBasePtr(), L.getOffset(), L.getPointerInfo(), MemVT, L.getBaseAlign(), MMOFlags, MMOMetadata { AAInfo: L.getAAInfo(), Ranges: null, MemCacheHint: null });
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, NewL.getValue(1));
        return NewL;
    }
    NewL = self.DAG.getLoad(L.getAddressingMode(), NON_EXTLOAD, L.getMemoryVT(), dl, L.getChain(), L.getBasePtr(), L.getOffset(), L.getPointerInfo(), L.getMemoryVT(), L.getBaseAlign(), MMOFlags, MMOMetadata { AAInfo: L.getAAInfo(), Ranges: null, MemCacheHint: null });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, NewL.getValue(1));
    let mut ExtendNode: SDValue = self.DAG.getNode(FP_EXTEND, dl, VT, NewL);
    return self.BitConvertToInteger(ExtendNode);
}

fn DAGTypeLegalizer::SoftenFloatRes_ATOMIC_LOAD(self, N: *mut SDNode) -> SDValue {
    let mut L: *mut AtomicSDNode = cast(N);
    let mut VT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut dl: SDLoc = SDLoc { N };
    if L.getExtensionType() == NON_EXTLOAD {
        let mut NewL: SDValue = self.DAG.getAtomic(ATOMIC_LOAD, dl, NVT, self.DAG.getVTList(NVT, EVT { Other }), ArrayRef<SDValue> { [L.getChain(), L.getBasePtr()] }, L.getMemOperand(), NON_EXTLOAD);
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, NewL.getValue(1));
        return NewL;
    }
    report_fatal_error("softening fp extending atomic load not handled", true);
}

fn DAGTypeLegalizer::SoftenFloatRes_SELECT(self, N: *mut SDNode) -> SDValue {
    let mut LHS: SDValue = self.GetSoftenedFloat(N.getOperand(1));
    let mut RHS: SDValue = self.GetSoftenedFloat(N.getOperand(2));
    return self.DAG.getSelect(SDLoc { N }, LHS.getValueType(), N.getOperand(0), LHS, RHS, SDNodeFlags { Flags: None });
}

fn DAGTypeLegalizer::SoftenFloatRes_SELECT_CC(self, N: *mut SDNode) -> SDValue {
    let mut LHS: SDValue = self.GetSoftenedFloat(N.getOperand(2));
    let mut RHS: SDValue = self.GetSoftenedFloat(N.getOperand(3));
    return self.DAG.getNode(SELECT_CC, SDLoc { N }, LHS.getValueType(), N.getOperand(0), N.getOperand(1), LHS, RHS, N.getOperand(4));
}

fn DAGTypeLegalizer::SoftenFloatRes_UNDEF(self, N: *mut SDNode) -> SDValue {
    return self.DAG.getUNDEF(self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0)));
}

fn DAGTypeLegalizer::SoftenFloatRes_VAARG(self, N: *mut SDNode) -> SDValue {
    let mut Chain: SDValue = N.getOperand(0);
    let mut Ptr: SDValue = N.getOperand(1);
    let mut VT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut dl: SDLoc = SDLoc { N };
    let mut NewVAARG: SDValue = SDValue {};
    NewVAARG = self.DAG.getVAArg(NVT, dl, Chain, Ptr, N.getOperand(2), N.getConstantOperandVal(3));
    if N != NewVAARG.getValue(1).getNode() {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, NewVAARG.getValue(1));
    }
    return NewVAARG;
}

fn DAGTypeLegalizer::SoftenFloatRes_XINT_TO_FP(self, N: *mut SDNode) -> SDValue {
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut Signed: bool = N.getOpcode() == SINT_TO_FP || N.getOpcode() == STRICT_SINT_TO_FP;
    let mut SVT: EVT = N.getOperand(if IsStrict { 1 } else { 0 }).getValueType();
    let mut RVT: EVT = N.getValueType(0);
    let mut NVT: EVT = EVT {};
    let mut dl: SDLoc = SDLoc { N };
    let mut LC: Libcall = UNKNOWN_LIBCALL;
    for let mut t: u32 = FIRST_INTEGER_VALUETYPE; t <= LAST_INTEGER_VALUETYPE && LC == UNKNOWN_LIBCALL; t += 1 {
        NVT = EVT { t as SimpleValueType };
        if NVT.bitsGE(SVT) {
            LC = if Signed { getSINTTOFP(NVT, RVT) } else { getUINTTOFP(NVT, RVT) };
        }
    }
    assert!(LC != UNKNOWN_LIBCALL, "Unsupported XINT_TO_FP!");
    let mut NRVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), RVT);
    let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if LCImpl == Unsupported {
        return self.SoftenFloatRes_NoLibcall(N, NRVT);
    }
    let mut Chain: SDValue = if IsStrict { N.getOperand(0) } else { SDValue {} };
    let mut Op: SDValue = self.DAG.getNode(if Signed { SIGN_EXTEND } else { ZERO_EXTEND }, dl, NVT, N.getOperand(if IsStrict { 1 } else { 0 }));
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    CallOptions.setIsSigned(Signed);
    CallOptions.setTypeListBeforeSoften(ArrayRef<EVT> { SVT }, RVT);
    let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, LCImpl, NRVT, ArrayRef<SDValue> { Op }, CallOptions, dl, Chain);
    if IsStrict {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Tmp.second);
    }
    return Tmp.first;
}

fn DAGTypeLegalizer::SoftenFloatRes_VECREDUCE(self, N: *mut SDNode) -> SDValue {
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, self.TLI.expandVecReduce(N, self.DAG));
    return SDValue {};
}

fn DAGTypeLegalizer::SoftenFloatRes_VECREDUCE_SEQ(self, N: *mut SDNode) -> SDValue {
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, self.TLI.expandVecReduceSeq(N, self.DAG));
    return SDValue {};
}

fn DAGTypeLegalizer::SoftenFloatOperand(self, N: *mut SDNode, OpNo: u32) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalize-types", 1) {
            dbgs() << "Soften float operand " << OpNo << ": ";
            N.dump(&mut self.DAG);
        }
    }
        if !(false) { break; }
    }
    let mut Res: SDValue = SDValue {};
    match N.getOpcode() {
        _ => {
            dbgs() << "SoftenFloatOperand Op #" << OpNo << ": ";
        },
        BITCAST => {
            Res = self.SoftenFloatOp_BITCAST(N);
        },
        BR_CC => {
            Res = self.SoftenFloatOp_BR_CC(N);
        },
        STRICT_FP_TO_FP16 => {
            FP_TO_FP16;
        },
        STRICT_FP_TO_SINT => {
            STRICT_FP_TO_UINT;
        },
        FP_TO_SINT_SAT => {
            FP_TO_UINT_SAT;
        },
        STRICT_LROUND => {
            LROUND;
        },
        STRICT_LLROUND => {
            LLROUND;
        },
        STRICT_LRINT => {
            LRINT;
        },
        STRICT_LLRINT => {
            LLRINT;
        },
        SELECT_CC => {
            Res = self.SoftenFloatOp_SELECT_CC(N);
        },
        STRICT_FSETCC => {
            STRICT_FSETCCS;
        },
        STORE => {
            Res = self.SoftenFloatOp_STORE(N, OpNo);
        },
        ATOMIC_STORE => {
            Res = self.SoftenFloatOp_ATOMIC_STORE(N, OpNo);
        },
        FCOPYSIGN => {
            Res = self.SoftenFloatOp_FCOPYSIGN(N);
        },
        FAKE_USE => {
            Res = self.SoftenFloatOp_FAKE_USE(N);
        },
        STACKMAP => {
            Res = self.SoftenFloatOp_STACKMAP(N, OpNo);
        },
        PATCHPOINT => {
            Res = self.SoftenFloatOp_PATCHPOINT(N, OpNo);
        },
    }
    if !Res.getNode() {
        return false;
    }
    if Res.getNode() == N {
        return true;
    }
    assert!(Res.getValueType() == N.getValueType(0) && N.getNumValues() == 1, "Invalid operand softening");
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Res);
    return false;
}

fn DAGTypeLegalizer::SoftenFloatOp_BITCAST(self, N: *mut SDNode) -> SDValue {
    let mut Op0: SDValue = self.GetSoftenedFloat(N.getOperand(0));
    return self.DAG.getNode(BITCAST, SDLoc { N }, N.getValueType(0), Op0);
}

fn DAGTypeLegalizer::SoftenFloatOp_FP_ROUND(self, N: *mut SDNode) -> SDValue {
    assert!(N.getOpcode() == FP_ROUND || N.getOpcode() == FP_TO_FP16 || N.getOpcode() == STRICT_FP_TO_FP16 || N.getOpcode() == FP_TO_BF16 || N.getOpcode() == STRICT_FP_TO_BF16 || N.getOpcode() == STRICT_FP_ROUND);
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut Op: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    let mut SVT: EVT = Op.getValueType();
    let mut RVT: EVT = N.getValueType(0);
    let mut FloatRVT: EVT = RVT;
    if N.getOpcode() == FP_TO_FP16 || N.getOpcode() == STRICT_FP_TO_FP16 {
        FloatRVT = EVT { f16 };
    } else if N.getOpcode() == FP_TO_BF16 || N.getOpcode() == STRICT_FP_TO_BF16 {
        FloatRVT = EVT { bf16 };
    }
    let mut LC: Libcall = getFPROUND(SVT, FloatRVT);
    assert!(LC != UNKNOWN_LIBCALL, "Unsupported FP_ROUND libcall");
    let mut Chain: SDValue = if IsStrict { N.getOperand(0) } else { SDValue {} };
    let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if LCImpl == Unsupported {
        reportNoLibcall(self.DAG, N, SVT);
        let mut Poison: SDValue = self.DAG.getPOISON(RVT);
        if IsStrict {
            self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Chain);
            self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Poison);
            return SDValue {};
        }
        return Poison;
    }
    Op = self.GetSoftenedFloat(Op);
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    CallOptions.setTypeListBeforeSoften(ArrayRef<EVT> { SVT }, RVT);
    let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, LCImpl, RVT, ArrayRef<SDValue> { Op }, CallOptions, SDLoc { N }, Chain);
    if IsStrict {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Tmp.second);
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Tmp.first);
        return SDValue {};
    }
    return Tmp.first;
}

fn DAGTypeLegalizer::SoftenFloatOp_BR_CC(self, N: *mut SDNode) -> SDValue {
    let mut NewLHS: SDValue = N.getOperand(2);
    let mut NewRHS: SDValue = N.getOperand(3);
    let mut CCCode: CondCode = cast(N.getOperand(1)).get();
    let mut VT: EVT = NewLHS.getValueType();
    NewLHS = self.GetSoftenedFloat(NewLHS);
    NewRHS = self.GetSoftenedFloat(NewRHS);
    self.TLI.softenSetCCOperands(self.DAG, VT, NewLHS, NewRHS, CCCode, SDLoc { N }, N.getOperand(2), N.getOperand(3));
    if !NewRHS.getNode() {
        NewRHS = self.DAG.getConstant(0, SDLoc { N }, NewLHS.getValueType(), false, false);
        CCCode = SETNE;
    }
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, N.getOperand(0), self.DAG.getCondCode(CCCode), NewLHS, NewRHS, N.getOperand(4)), ResNo: 0 };
}

fn findFPToIntLibcall(SrcVT: EVT, RetVT: EVT, Promoted: *mut EVT, Signed: bool) -> Libcall {
    let mut LC: Libcall = UNKNOWN_LIBCALL;
    for let mut IntVT: u32 = FIRST_INTEGER_VALUETYPE; IntVT <= LAST_INTEGER_VALUETYPE && LC == UNKNOWN_LIBCALL; IntVT += 1 {
        Promoted = EVT { IntVT as SimpleValueType };
        if Promoted.bitsGE(RetVT) {
            LC = if Signed { getFPTOSINT(SrcVT, Promoted) } else { getFPTOUINT(SrcVT, Promoted) };
        }
    }
    return LC;
}

fn DAGTypeLegalizer::SoftenFloatOp_FP_TO_XINT(self, N: *mut SDNode) -> SDValue {
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut Signed: bool = N.getOpcode() == FP_TO_SINT || N.getOpcode() == STRICT_FP_TO_SINT;
    let mut Op: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    let mut SVT: EVT = Op.getValueType();
    let mut RVT: EVT = N.getValueType(0);
    let mut NVT: EVT = EVT {};
    let mut dl: SDLoc = SDLoc { N };
    let mut LC: Libcall = findFPToIntLibcall(SVT, RVT, NVT, Signed);
    assert!(LC != UNKNOWN_LIBCALL && NVT.isSimple(), "Unsupported FP_TO_XINT!");
    let mut Chain: SDValue = if IsStrict { N.getOperand(0) } else { SDValue {} };
    let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if LCImpl == Unsupported {
        reportNoLibcall(self.DAG, N, SVT);
        let mut Poison: SDValue = self.DAG.getPOISON(RVT);
        if IsStrict {
            self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Chain);
            self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Poison);
            return SDValue {};
        }
        return Poison;
    }
    Op = self.GetSoftenedFloat(Op);
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    CallOptions.setTypeListBeforeSoften(ArrayRef<EVT> { SVT }, RVT);
    let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, LCImpl, NVT, ArrayRef<SDValue> { Op }, CallOptions, dl, Chain);
    let mut Res: SDValue = self.DAG.getNode(TRUNCATE, dl, RVT, Tmp.first);
    if !IsStrict {
        return Res;
    }
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Tmp.second);
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Res);
    return SDValue {};
}

fn DAGTypeLegalizer::SoftenFloatOp_FP_TO_XINT_SAT(self, N: *mut SDNode) -> SDValue {
    let mut Res: SDValue = self.TLI.expandFP_TO_INT_SAT(N, self.DAG);
    return Res;
}

fn DAGTypeLegalizer::SoftenFloatOp_SELECT_CC(self, N: *mut SDNode) -> SDValue {
    let mut NewLHS: SDValue = N.getOperand(0);
    let mut NewRHS: SDValue = N.getOperand(1);
    let mut CCCode: CondCode = cast(N.getOperand(4)).get();
    let mut VT: EVT = NewLHS.getValueType();
    NewLHS = self.GetSoftenedFloat(NewLHS);
    NewRHS = self.GetSoftenedFloat(NewRHS);
    self.TLI.softenSetCCOperands(self.DAG, VT, NewLHS, NewRHS, CCCode, SDLoc { N }, N.getOperand(0), N.getOperand(1));
    if !NewRHS.getNode() {
        NewRHS = self.DAG.getConstant(0, SDLoc { N }, NewLHS.getValueType(), false, false);
        CCCode = SETNE;
    }
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, NewLHS, NewRHS, N.getOperand(2), N.getOperand(3), self.DAG.getCondCode(CCCode)), ResNo: 0 };
}

fn DAGTypeLegalizer::SoftenFloatOp_SETCC(self, N: *mut SDNode) -> SDValue {
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut Op0: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    let mut Op1: SDValue = N.getOperand(if IsStrict { 2 } else { 1 });
    let mut Chain: SDValue = if IsStrict { N.getOperand(0) } else { SDValue {} };
    let mut CCCode: CondCode = cast(N.getOperand(if IsStrict { 3 } else { 2 })).get();
    let mut VT: EVT = Op0.getValueType();
    let mut NewLHS: SDValue = self.GetSoftenedFloat(Op0);
    let mut NewRHS: SDValue = self.GetSoftenedFloat(Op1);
    self.TLI.softenSetCCOperands(self.DAG, VT, NewLHS, NewRHS, CCCode, SDLoc { N }, Op0, Op1, Chain, N.getOpcode() == STRICT_FSETCCS);
    if NewRHS.getNode() {
        if IsStrict {
            NewLHS = self.DAG.getNode(SETCC, SDLoc { N }, N.getValueType(0), NewLHS, NewRHS, self.DAG.getCondCode(CCCode));
        } else {
            return SDValue { Node: self.DAG.UpdateNodeOperands(N, NewLHS, NewRHS, self.DAG.getCondCode(CCCode)), ResNo: 0 };
        }
    }
    assert!((NewRHS.getNode() || NewLHS.getValueType() == N.getValueType(0)), "Unexpected setcc expansion!");
    if IsStrict {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, NewLHS);
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Chain);
        return SDValue {};
    }
    return NewLHS;
}

fn DAGTypeLegalizer::SoftenFloatOp_STORE(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(isUNINDEXEDStore(N), "Indexed store during type legalization!");
    assert!(OpNo == 1, "Can only soften the stored value!");
    let mut ST: *mut StoreSDNode = cast(N);
    let mut Val: SDValue = ST.getValue();
    let mut dl: SDLoc = SDLoc { N };
    if ST.isTruncatingStore() {
        Val = self.BitConvertToInteger(self.DAG.getNode(FP_ROUND, dl, ST.getMemoryVT(), Val, self.DAG.getIntPtrConstant(0, dl, true)));
    } else {
        Val = self.GetSoftenedFloat(Val);
    }
    let mut MemVT: EVT = getIntegerVT(*self.DAG.getContext(), ST.getMemoryVT().getSizeInBits().operator unsigned long long());
    return self.DAG.getTruncStore(ST.getChain(), dl, Val, ST.getBasePtr(), MemVT, ST.getMemOperand());
}

fn DAGTypeLegalizer::SoftenFloatOp_ATOMIC_STORE(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 1, "Can only soften the stored value!");
    let mut ST: *mut AtomicSDNode = cast(N);
    let mut Val: SDValue = ST.getVal();
    let mut VT: EVT = Val.getValueType();
    let mut dl: SDLoc = SDLoc { N };
    assert!(ST.getMemoryVT() == VT, "truncating atomic store not handled");
    let mut NewVal: SDValue = self.GetSoftenedFloat(Val);
    return self.DAG.getAtomic(ATOMIC_STORE, dl, VT, ST.getChain(), NewVal, ST.getBasePtr(), ST.getMemOperand());
}

fn DAGTypeLegalizer::SoftenFloatOp_FCOPYSIGN(self, N: *mut SDNode) -> SDValue {
    let mut LHS: SDValue = N.getOperand(0);
    let mut RHS: SDValue = self.BitConvertToInteger(N.getOperand(1));
    let mut dl: SDLoc = SDLoc { N };
    let mut LVT: EVT = LHS.getValueType();
    let mut ILVT: EVT = getIntegerVT(*self.DAG.getContext(), LVT.getSizeInBits().operator unsigned long long());
    let mut RVT: EVT = RHS.getValueType();
    let mut LSize: u32 = LVT.getSizeInBits().operator unsigned long long();
    let mut RSize: u32 = RVT.getSizeInBits().operator unsigned long long();
    let mut SizeDiff: i32 = RSize - LSize;
    if SizeDiff > 0 {
        RHS = self.DAG.getNode(SRL, dl, RVT, RHS, self.DAG.getConstant(SizeDiff, dl, self.TLI.getShiftAmountTy(RHS.getValueType(), self.DAG.getDataLayout()), false, false));
        RHS = self.DAG.getNode(TRUNCATE, dl, ILVT, RHS);
    } else if SizeDiff < 0 {
        RHS = self.DAG.getNode(ANY_EXTEND, dl, LVT, RHS);
        RHS = self.DAG.getNode(SHL, dl, ILVT, RHS, self.DAG.getConstant(-SizeDiff, dl, self.TLI.getShiftAmountTy(RHS.getValueType(), self.DAG.getDataLayout()), false, false));
    }
    RHS = self.DAG.getBitcast(LVT, RHS);
    return self.DAG.getNode(FCOPYSIGN, dl, LVT, LHS, RHS);
}

fn DAGTypeLegalizer::SoftenFloatOp_Unary(self, N: *mut SDNode, LC: Libcall) -> SDValue {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut Offset: u32 = if IsStrict { 1 } else { 0 };
    let mut Op: SDValue = self.GetSoftenedFloat(N.getOperand(0 + Offset));
    let mut Chain: SDValue = if IsStrict { N.getOperand(0) } else { SDValue {} };
    let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if LCImpl == Unsupported {
        reportNoLibcall(self.DAG, N, N.getOperand(0 + Offset).getValueType());
        let mut Poison: SDValue = self.DAG.getPOISON(N.getValueType(0));
        if IsStrict {
            self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Chain);
            self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Poison);
            return SDValue {};
        }
        return Poison;
    }
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    let mut OpVT: EVT = N.getOperand(0 + Offset).getValueType();
    CallOptions.setTypeListBeforeSoften(ArrayRef<EVT> { OpVT }, N.getValueType(0));
    let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, LCImpl, NVT, ArrayRef<SDValue> { Op }, CallOptions, SDLoc { N }, Chain);
    if IsStrict {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Tmp.second);
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Tmp.first);
        return SDValue {};
    }
    return Tmp.first;
}

fn DAGTypeLegalizer::SoftenFloatOp_LROUND(self, N: *mut SDNode) -> SDValue {
    let mut OpVT: EVT = N.getOperand(if N.isStrictFPOpcode() { 1 } else { 0 }).getValueType();
    return self.SoftenFloatOp_Unary(N, GetFPLibCall(OpVT, LROUND_F32, LROUND_F64, LROUND_F80, LROUND_F128, LROUND_PPCF128));
}

fn DAGTypeLegalizer::SoftenFloatOp_LLROUND(self, N: *mut SDNode) -> SDValue {
    let mut OpVT: EVT = N.getOperand(if N.isStrictFPOpcode() { 1 } else { 0 }).getValueType();
    return self.SoftenFloatOp_Unary(N, GetFPLibCall(OpVT, LLROUND_F32, LLROUND_F64, LLROUND_F80, LLROUND_F128, LLROUND_PPCF128));
}

fn DAGTypeLegalizer::SoftenFloatOp_LRINT(self, N: *mut SDNode) -> SDValue {
    let mut OpVT: EVT = N.getOperand(if N.isStrictFPOpcode() { 1 } else { 0 }).getValueType();
    return self.SoftenFloatOp_Unary(N, GetFPLibCall(OpVT, LRINT_F32, LRINT_F64, LRINT_F80, LRINT_F128, LRINT_PPCF128));
}

fn DAGTypeLegalizer::SoftenFloatOp_LLRINT(self, N: *mut SDNode) -> SDValue {
    let mut OpVT: EVT = N.getOperand(if N.isStrictFPOpcode() { 1 } else { 0 }).getValueType();
    return self.SoftenFloatOp_Unary(N, GetFPLibCall(OpVT, LLRINT_F32, LLRINT_F64, LLRINT_F80, LLRINT_F128, LLRINT_PPCF128));
}

fn DAGTypeLegalizer::SoftenFloatOp_FAKE_USE(self, N: *mut SDNode) -> SDValue {
    let mut Op1: SDValue = self.BitConvertToInteger(N.getOperand(1));
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, N.getValueType(0), N.getOperand(0), Op1);
}

fn DAGTypeLegalizer::SoftenFloatOp_STACKMAP(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo > 1);
    let mut NewOps: SmallVector<SDValue> = SmallVector<SDValue> { N.ops() };
    NewOps[OpNo] = self.GetSoftenedFloat(NewOps[OpNo]);
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, ArrayRef<SDValue> { NewOps }), ResNo: 0 };
}

fn DAGTypeLegalizer::SoftenFloatOp_PATCHPOINT(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo >= 7);
    let mut NewOps: SmallVector<SDValue> = SmallVector<SDValue> { N.ops() };
    NewOps[OpNo] = self.GetSoftenedFloat(NewOps[OpNo]);
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, ArrayRef<SDValue> { NewOps }), ResNo: 0 };
}

fn DAGTypeLegalizer::ExpandFloatResult(self, N: *mut SDNode, ResNo: u32) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalize-types", 1) {
            dbgs() << "Expand float result: ";
            N.dump(&mut self.DAG);
        }
    }
        if !(false) { break; }
    }
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    Lo = Hi = SDValue {};
    if self.CustomLowerNode(N, N.getValueType(ResNo), true) {
        return;
    }
    match N.getOpcode() {
        _ => {
            dbgs() << "ExpandFloatResult #" << ResNo << ": ";
        },
        POISON => {
            UNDEF;
        },
        SELECT => {
            self.SplitRes_Select(N, Lo, Hi);
        },
        SELECT_CC => {
            self.SplitRes_SELECT_CC(N, Lo, Hi);
        },
        MERGE_VALUES => {
            self.ExpandRes_MERGE_VALUES(N, ResNo, Lo, Hi);
        },
        BITCAST => {
            self.ExpandRes_BITCAST(N, Lo, Hi);
        },
        BUILD_PAIR => {
            self.ExpandRes_BUILD_PAIR(N, Lo, Hi);
        },
        EXTRACT_ELEMENT => {
            self.ExpandRes_EXTRACT_ELEMENT(N, Lo, Hi);
        },
        EXTRACT_VECTOR_ELT => {
            self.ExpandRes_EXTRACT_VECTOR_ELT(N, Lo, Hi);
        },
        VAARG => {
            self.ExpandRes_VAARG(N, Lo, Hi);
        },
        ConstantFP => {
            self.ExpandFloatRes_ConstantFP(N, Lo, Hi);
        },
        AssertNoFPClass => {
            self.ExpandFloatRes_AssertNoFPClass(N, Lo, Hi);
        },
        FABS => {
            self.ExpandFloatRes_FABS(N, Lo, Hi);
        },
        STRICT_FMINNUM => {
            FMINNUM;
        },
        STRICT_FMAXNUM => {
            FMAXNUM;
        },
        FMINIMUMNUM => {
            self.ExpandFloatRes_FMINIMUMNUM(N, Lo, Hi);
        },
        FMAXIMUMNUM => {
            self.ExpandFloatRes_FMAXIMUMNUM(N, Lo, Hi);
        },
        STRICT_FADD => {
            FADD;
        },
        STRICT_FACOS => {
            FACOS;
        },
        STRICT_FASIN => {
            FASIN;
        },
        STRICT_FATAN => {
            FATAN;
        },
        STRICT_FATAN2 => {
            FATAN2;
        },
        FCBRT => {
            self.ExpandFloatRes_FCBRT(N, Lo, Hi);
        },
        STRICT_FCEIL => {
            FCEIL;
        },
        FCOPYSIGN => {
            self.ExpandFloatRes_FCOPYSIGN(N, Lo, Hi);
        },
        STRICT_FCOS => {
            FCOS;
        },
        STRICT_FCOSH => {
            FCOSH;
        },
        STRICT_FDIV => {
            FDIV;
        },
        STRICT_FEXP => {
            FEXP;
        },
        STRICT_FEXP2 => {
            FEXP2;
        },
        FEXP10 => {
            self.ExpandFloatRes_FEXP10(N, Lo, Hi);
        },
        STRICT_FFLOOR => {
            FFLOOR;
        },
        STRICT_FLOG => {
            FLOG;
        },
        STRICT_FLOG2 => {
            FLOG2;
        },
        STRICT_FLOG10 => {
            FLOG10;
        },
        STRICT_FMA => {
            FMA;
        },
        STRICT_FMUL => {
            FMUL;
        },
        STRICT_FNEARBYINT => {
            FNEARBYINT;
        },
        FNEG => {
            self.ExpandFloatRes_FNEG(N, Lo, Hi);
        },
        STRICT_FP_EXTEND => {
            FP_EXTEND;
        },
        STRICT_FPOW => {
            FPOW;
        },
        STRICT_FPOWI => {
            FPOWI;
        },
        FLDEXP => {
            STRICT_FLDEXP;
        },
        FREEZE => {
            self.ExpandFloatRes_FREEZE(N, Lo, Hi);
        },
        STRICT_FRINT => {
            FRINT;
        },
        STRICT_FROUND => {
            FROUND;
        },
        STRICT_FROUNDEVEN => {
            FROUNDEVEN;
        },
        STRICT_FSIN => {
            FSIN;
        },
        STRICT_FSINH => {
            FSINH;
        },
        STRICT_FSQRT => {
            FSQRT;
        },
        STRICT_FSUB => {
            FSUB;
        },
        STRICT_FTAN => {
            FTAN;
        },
        STRICT_FTANH => {
            FTANH;
        },
        STRICT_FTRUNC => {
            FTRUNC;
        },
        LOAD => {
            self.ExpandFloatRes_LOAD(N, Lo, Hi);
        },
        STRICT_SINT_TO_FP => {
            STRICT_UINT_TO_FP;
        },
        STRICT_FREM => {
            FREM;
        },
        FMODF => {
            self.ExpandFloatRes_FMODF(N);
        },
        FSINCOS => {
            self.ExpandFloatRes_FSINCOS(N);
        },
        FSINCOSPI => {
            self.ExpandFloatRes_FSINCOSPI(N);
        },
    }
    if Lo.getNode() {
        self.SetExpandedFloat(SDValue { Node: N, ResNo: ResNo }, Lo, Hi);
    }
}

fn DAGTypeLegalizer::ExpandFloatRes_ConstantFP(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    assert!(NVT.getSizeInBits().operator unsigned long long() == 64, "Do not know how to expand this float constant!");
    let mut C: APInt = cast(N).getValueAPF().bitcastToAPInt();
    let mut dl: SDLoc = SDLoc { N };
    let mut Sem: *fltSemantics = NVT.getFltSemantics();
    Lo = self.DAG.getConstantFP(APFloat { Sem, C.extractBits(64, 64) }, dl, NVT, false);
    Hi = self.DAG.getConstantFP(APFloat { Sem, C.extractBits(64, 0) }, dl, NVT, false);
}

fn DAGTypeLegalizer::ExpandFloatRes_NoLibcall(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    reportNoLibcall(self.DAG, N, N.getValueType(0));
    if N.isStrictFPOpcode() {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, N.getOperand(0));
    }
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    Lo = Hi = self.DAG.getPOISON(NVT);
}

fn DAGTypeLegalizer::ExpandFloatRes_Unary(self, N: *mut SDNode, LC: Libcall, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut Offset: u32 = if IsStrict { 1 } else { 0 };
    let mut Op: SDValue = N.getOperand(0 + Offset);
    let mut Chain: SDValue = if IsStrict { N.getOperand(0) } else { SDValue {} };
    let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if LCImpl == Unsupported {
        return self.ExpandFloatRes_NoLibcall(N, Lo, Hi);
    }
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, LCImpl, N.getValueType(0), ArrayRef<SDValue> { Op }, CallOptions, SDLoc { N }, Chain);
    if IsStrict {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Tmp.second);
    }
    self.GetPairElements(Tmp.first, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandFloatRes_Binary(self, N: *mut SDNode, LC: Libcall, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut Offset: u32 = if IsStrict { 1 } else { 0 };
    let mut Ops: [2]SDValue = [N.getOperand(0 + Offset), N.getOperand(1 + Offset)];
    let mut Chain: SDValue = if IsStrict { N.getOperand(0) } else { SDValue {} };
    let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if LCImpl == Unsupported {
        return self.ExpandFloatRes_NoLibcall(N, Lo, Hi);
    }
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, LCImpl, N.getValueType(0), ArrayRef<SDValue> { Ops }, CallOptions, SDLoc { N }, Chain);
    if IsStrict {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Tmp.second);
    }
    self.GetPairElements(Tmp.first, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandFloatRes_FMODF(self, N: *mut SDNode) {
    self.ExpandFloatRes_UnaryWithTwoFPResults(N, getMODF(N.getValueType(0)), optional<unsigned int> { 0 });
}

fn DAGTypeLegalizer::ExpandFloatRes_FSINCOS(self, N: *mut SDNode) {
    self.ExpandFloatRes_UnaryWithTwoFPResults(N, getSINCOS(N.getValueType(0)), optional<unsigned int> {});
}

fn DAGTypeLegalizer::ExpandFloatRes_FSINCOSPI(self, N: *mut SDNode) {
    self.ExpandFloatRes_UnaryWithTwoFPResults(N, getSINCOSPI(N.getValueType(0)), optional<unsigned int> {});
}

fn DAGTypeLegalizer::ExpandFloatRes_UnaryWithTwoFPResults(self, N: *mut SDNode, LC: Libcall, CallRetResNo: optional<unsigned int>) {
    assert!(!N.isStrictFPOpcode(), "strictfp not implemented");
    let mut Results: SmallVector<SDValue> = SmallVector<SDValue> {};
    if !self.TLI.expandMultipleResultFPLibCall(self.DAG, LC, N, Results, CallRetResNo) {
        reportNoLibcall(self.DAG, N, N.getValueType(0));
        let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
        let mut Poison: SDValue = self.DAG.getPOISON(NVT);
        for let mut ResNo: u32 = 0;
let mut E: u32 = N.getNumValues(); ResNo != E; ResNo += 1 {
            self.SetExpandedFloat(SDValue { Node: N, ResNo: ResNo }, Poison, Poison);
        }
        return;
    }
    for x in enumerate(Results) {
        let mut Lo: SDValue = SDValue {};
        let mut Hi: SDValue = SDValue {};
        self.GetPairElements(Res, Lo, Hi);
        self.SetExpandedFloat(SDValue { Node: N, ResNo: ResNo }, Lo, Hi);
    }
}

fn DAGTypeLegalizer::ExpandFloatRes_FABS(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    assert!(N.getValueType(0) == EVT { ppcf128 }, "Logic only correct for ppcf128!");
    let mut dl: SDLoc = SDLoc { N };
    let mut Tmp: SDValue = SDValue {};
    self.GetExpandedFloat(N.getOperand(0), Lo, Tmp);
    Hi = self.DAG.getNode(FABS, dl, Tmp.getValueType(), Tmp);
    Lo = self.DAG.getSelectCC(dl, Tmp, Hi, Lo, self.DAG.getNode(FNEG, dl, Lo.getValueType(), Lo), SETEQ, SDNodeFlags { Flags: None });
}

