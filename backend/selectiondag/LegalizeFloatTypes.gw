fn DAGTypeLegalizer::SoftenFloatRes_FMA(self, N: *mut SDNode) -> SDValue {
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut Offset: u32 = if IsStrict { 1 } else { 0 };
    let mut Ops: [3]SDValue = [self.GetSoftenedFloat(N.getOperand(0 + Offset)), self.GetSoftenedFloat(N.getOperand(1 + Offset)), self.GetSoftenedFloat(N.getOperand(2 + Offset))];
    let mut Chain: SDValue = if IsStrict { N.getOperand(0) } else { SDValue {} };
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    let mut OpsVT: [3]EVT = [N.getOperand(0 + Offset).getValueType(), N.getOperand(1 + Offset).getValueType(), N.getOperand(2 + Offset).getValueType()];
    CallOptions.setTypeListBeforeSoften(ArrayRef<EVT> { OpsVT }, N.getValueType(0));
    let mut LC: Libcall = getFMA(N.getValueType(0));
    let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if LCImpl == Unsupported {
        return self.SoftenFloatRes_NoLibcall(N, NVT);
    }
    let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, LCImpl, NVT, ArrayRef<SDValue> { Ops }, CallOptions, SDLoc { N }, Chain);
    if IsStrict {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Tmp.second);
    }
    return Tmp.first;
}

fn DAGTypeLegalizer::SoftenFloatRes_FMUL(self, N: *mut SDNode) -> SDValue {
    return self.SoftenFloatRes_Binary(N, GetFPLibCall(N.getValueType(0), MUL_F32, MUL_F64, MUL_F80, MUL_F128, MUL_PPCF128));
}

fn DAGTypeLegalizer::SoftenFloatRes_FNEARBYINT(self, N: *mut SDNode) -> SDValue {
    return self.SoftenFloatRes_Unary(N, getNEARBYINT(N.getValueType(0)));
}

fn DAGTypeLegalizer::SoftenFloatRes_FNEG(self, N: *mut SDNode) -> SDValue {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut dl: SDLoc = SDLoc { N };
    let mut SignMask: APInt = getSignMask(NVT.getSizeInBits().operator unsigned long long());
    return self.DAG.getNode(XOR, dl, NVT, self.GetSoftenedFloat(N.getOperand(0)), self.DAG.getConstant(SignMask, dl, NVT, false, false));
}

fn DAGTypeLegalizer::SoftenFloatRes_FP_EXTEND(self, N: *mut SDNode) -> SDValue {
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut Op: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    let mut Chain: SDValue = if IsStrict { N.getOperand(0) } else { SDValue {} };
    if (Op.getValueType() == EVT { f16 } || Op.getValueType() == EVT { bf16 }) && N.getValueType(0) != EVT { f32 } {
        if IsStrict {
            Op = self.DAG.getNode(STRICT_FP_EXTEND, SDLoc { N }, ArrayRef<EVT> { [EVT { f32 }, EVT { Other }] }, ArrayRef<SDValue> { [Chain, Op] });
            Chain = Op.getValue(1);
        } else {
            Op = self.DAG.getNode(FP_EXTEND, SDLoc { N }, EVT { f32 }, Op);
        }
    }
    if Op.getValueType() == EVT { bf16 } {
        return self.SoftenFloatRes_BF16_TO_FP(N);
    }
    let mut LC: Libcall = getFPEXT(Op.getValueType(), N.getValueType(0));
    if LC == UNKNOWN_LIBCALL {
        self.DAG.getContext().emitError("do not know how to soften fp_extend");
        if IsStrict {
            self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Chain);
        }
        return self.DAG.getPOISON(NVT);
    }
    let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if LCImpl == Unsupported {
        return self.SoftenFloatRes_NoLibcall(N, NVT);
    }
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    let mut OpVT: EVT = N.getOperand(if IsStrict { 1 } else { 0 }).getValueType();
    CallOptions.setTypeListBeforeSoften(ArrayRef<EVT> { OpVT }, N.getValueType(0));
    let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, LCImpl, NVT, ArrayRef<SDValue> { Op }, CallOptions, SDLoc { N }, Chain);
    if IsStrict {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Tmp.second);
    }
    return Tmp.first;
}

fn DAGTypeLegalizer::SoftenFloatRes_FP16_TO_FP(self, N: *mut SDNode) -> SDValue {
    let mut MidVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), EVT { f32 });
    let mut Op: SDValue = N.getOperand(0);
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    let mut OpsVT: [1]EVT = [N.getOperand(0).getValueType()];
    CallOptions.setTypeListBeforeSoften(ArrayRef<EVT> { OpsVT }, N.getValueType(0));
    let mut Res32: SDValue = self.TLI.makeLibCall(self.DAG, FPEXT_F16_F32, MidVT, ArrayRef<SDValue> { Op }, CallOptions, SDLoc { N }, SDValue {}).first;
    if N.getValueType(0) == EVT { f32 } {
        return Res32;
    }
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut LC: Libcall = getFPEXT(EVT { f32 }, N.getValueType(0));
    assert!(LC != UNKNOWN_LIBCALL, "Unsupported FP_EXTEND!");
    return self.TLI.makeLibCall(self.DAG, LC, NVT, ArrayRef<SDValue> { Res32 }, CallOptions, SDLoc { N }, SDValue {}).first;
}

fn DAGTypeLegalizer::SoftenFloatRes_BF16_TO_FP(self, N: *mut SDNode) -> SDValue {
    assert!(N.getValueType(0) == EVT { f32 }, "Can only soften BF16_TO_FP with f32 result");
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), EVT { f32 });
    let mut Op: SDValue = N.getOperand(0);
    let mut DL: SDLoc = SDLoc { N };
    Op = self.DAG.getNode(ANY_EXTEND, DL, NVT, self.DAG.getNode(BITCAST, DL, EVT { i16 }, Op));
    let mut Res: SDValue = self.DAG.getNode(SHL, DL, NVT, Op, self.DAG.getShiftAmountConstant(16, NVT, DL));
    return Res;
}

fn DAGTypeLegalizer::SoftenFloatRes_FP_ROUND(self, N: *mut SDNode) -> SDValue {
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut Op: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    let mut Chain: SDValue = if IsStrict { N.getOperand(0) } else { SDValue {} };
    let mut LC: Libcall = getFPROUND(Op.getValueType(), N.getValueType(0));
    assert!(LC != UNKNOWN_LIBCALL, "Unsupported FP_ROUND!");
    let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if LCImpl == Unsupported {
        return self.SoftenFloatRes_NoLibcall(N, NVT);
    }
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    let mut OpVT: EVT = N.getOperand(if IsStrict { 1 } else { 0 }).getValueType();
    CallOptions.setTypeListBeforeSoften(ArrayRef<EVT> { OpVT }, N.getValueType(0));
    let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, LCImpl, NVT, ArrayRef<SDValue> { Op }, CallOptions, SDLoc { N }, Chain);
    if IsStrict {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Tmp.second);
    }
    return Tmp.first;
}

fn DAGTypeLegalizer::SoftenFloatRes_FPOW(self, N: *mut SDNode) -> SDValue {
    return self.SoftenFloatRes_Binary(N, getPOW(N.getValueType(0)));
}

fn DAGTypeLegalizer::SoftenFloatRes_ExpOp(self, N: *mut SDNode) -> SDValue {
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut Offset: u32 = if IsStrict { 1 } else { 0 };
    let mut IsPowI: bool = N.getOpcode() == FPOWI || N.getOpcode() == STRICT_FPOWI;
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut LC: Libcall = if IsPowI { getPOWI(N.getValueType(0)) } else { getLDEXP(N.getValueType(0)) };
    assert!(LC != UNKNOWN_LIBCALL, "Unexpected fpowi.");
    let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if LCImpl == Unsupported {
        self.DAG.getContext().emitError("do not know how to soften fpowi to fpow");
        if IsStrict {
            self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, N.getOperand(0));
        }
        return self.DAG.getPOISON(NVT);
    }
    if self.DAG.getLibInfo().getIntSize() != N.getOperand(1 + Offset).getValueType().getSizeInBits().operator unsigned long long() {
        self.DAG.getContext().emitError("powi exponent does not match sizeof(int)");
        if IsStrict {
            self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, N.getOperand(0));
        }
        return self.DAG.getPOISON(NVT);
    }
    let mut Ops: [2]SDValue = [self.GetSoftenedFloat(N.getOperand(0 + Offset)), N.getOperand(1 + Offset)];
    let mut Chain: SDValue = if IsStrict { N.getOperand(0) } else { SDValue {} };
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    let mut OpsVT: [2]EVT = [N.getOperand(0 + Offset).getValueType(), N.getOperand(1 + Offset).getValueType()];
    CallOptions.setTypeListBeforeSoften(ArrayRef<EVT> { OpsVT }, N.getValueType(0));
    CallOptions.setIsSigned(true);
    let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, LCImpl, NVT, ArrayRef<SDValue> { Ops }, CallOptions, SDLoc { N }, Chain);
    if IsStrict {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Tmp.second);
    }
    return Tmp.first;
}

fn DAGTypeLegalizer::SoftenFloatRes_FFREXP(self, N: *mut SDNode) -> SDValue {
    assert!(!N.isStrictFPOpcode(), "strictfp not implemented for frexp");
    let mut VT0: EVT = N.getValueType(0);
    let mut VT1: EVT = N.getValueType(1);
    let mut LC: Libcall = getFREXP(VT0);
    let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    let mut NVT0: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT0);
    let mut DL: SDLoc = SDLoc { N };
    if LCImpl == Unsupported {
        reportNoLibcall(self.DAG, N, VT0);
        let mut PoisonExp: SDValue = self.DAG.getPOISON(VT1);
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, PoisonExp);
        return self.DAG.getMergeValues(ArrayRef<SDValue> { [self.DAG.getPOISON(NVT0), PoisonExp] }, DL);
    }
    if self.DAG.getLibInfo().getIntSize() != VT1.getSizeInBits().operator unsigned long long() {
        self.DAG.getContext().emitError("ffrexp exponent does not match sizeof(int)");
        let mut PoisonExp: SDValue = self.DAG.getPOISON(VT1);
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, PoisonExp);
        return self.DAG.getMergeValues(ArrayRef<SDValue> { [self.DAG.getPOISON(NVT0), PoisonExp] }, DL);
    }
    let mut StackSlot: SDValue = self.DAG.CreateStackTemporary(VT1, 1);
    let mut PointerTy: *mut PointerType = getUnqual(*self.DAG.getContext());
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    let mut Ops: [2]SDValue = [self.GetSoftenedFloat(N.getOperand(0)), StackSlot];
    let mut OpsVT: [2]EVT = [VT0, StackSlot.getValueType()];
    let mut CallOpsTypeOverrides: [2]*mut Type = [null, PointerTy];
    CallOptions.setTypeListBeforeSoften(ArrayRef<EVT> { OpsVT }, VT0).setOpsTypeOverrides(ArrayRef<Type *> { CallOpsTypeOverrides });
    let mut FrameIdx: i32 = cast(StackSlot).getIndex();
    let mut PtrInfo: MachinePointerInfo = getFixedStack(self.DAG.getMachineFunction(), FrameIdx, 0);
    let mut LoadExp: SDValue = self.DAG.getLoad(VT1, DL, Chain, StackSlot, PtrInfo, MaybeAlign {}, MONone, MMOMetadata {});
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, LoadExp);
    return ReturnVal;
}

fn DAGTypeLegalizer::SoftenFloatRes_UnaryWithTwoFPResults(self, N: *mut SDNode, LC: Libcall, CallRetResNo: optional<unsigned int>) -> bool {
    assert!(!N.isStrictFPOpcode(), "strictfp not implemented");
    let mut VT: EVT = N.getValueType(0);
    assert!(VT == N.getValueType(1), "expected both return values to have the same type");
    let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if LCImpl == Unsupported {
        return false;
    }
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut DL: SDLoc = SDLoc { N };
    let mut Ops: SmallVector<SDValue, 3> = SmallVector<SDValue, 3> { [self.GetSoftenedFloat(N.getOperand(0))] };
    let mut OpsVT: SmallVector<EVT, 3> = SmallVector<EVT, 3> { [VT] };
    let mut StackSlots: array<SDValue, 2> = array<SDValue, 2> {};
    let mut CallOpsTypeOverrides: SmallVector<Type *, 3> = SmallVector<Type *, 3> { [null] };
    let mut PointerTy: *mut PointerType = getUnqual(*self.DAG.getContext());
    for let mut ResNum: u32 = 0; ResNum < N.getNumValues(); ResNum += 1 {
        if ResNum == CallRetResNo {
            continue;
        }
        let mut StackSlot: SDValue = self.DAG.CreateStackTemporary(NVT, 1);
        Ops.push(ValueParamT { StackSlot });
        OpsVT.push(StackSlot.getValueType());
        StackSlots[ResNum] = StackSlot;
        CallOpsTypeOverrides.push(PointerTy);
    }
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    CallOptions.setTypeListBeforeSoften(ArrayRef<EVT> { OpsVT }, VT).setOpsTypeOverrides(ArrayRef<Type *> { CallOpsTypeOverrides });
    let mut CreateStackLoad: Closure_1 = Closure_1 { cap_0: type { Chain }, cap_1: self, NVT: &mut NVT, DL: &mut DL };
    for x in enumerate(StackSlots) {
        if CallRetResNo == ResNum {
            self.SetSoftenedFloat(SDValue { Node: N, ResNo: ResNum }, ReturnVal);
            continue;
        }
        self.SetSoftenedFloat(SDValue { Node: N, ResNo: ResNum }, CreateStackLoad.call(SlackSlot));
    }
    return true;
}

fn DAGTypeLegalizer::SoftenFloatRes_FSINCOS(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if self.SoftenFloatRes_UnaryWithTwoFPResults(N, getSINCOS(VT), optional<unsigned int> {}) {
        return SDValue {};
    }
    let mut SinLC: Libcall = getSIN(VT);
    let mut CosLC: Libcall = getCOS(VT);
    let mut SoftSin: SDValue = SDValue {};
    let mut SoftCos: SDValue = SDValue {};
    if self.DAG.getLibcalls().getLibcallImpl(SinLC) == Unsupported || self.DAG.getLibcalls().getLibcallImpl(CosLC) == Unsupported {
        self.DAG.getContext().emitError("do not know how to soften fsincos");
        let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
        SoftSin = SoftCos = self.DAG.getPOISON(NVT);
    } else {
        SoftSin = self.SoftenFloatRes_Unary(N, SinLC);
        SoftCos = self.SoftenFloatRes_Unary(N, CosLC);
    }
    self.SetSoftenedFloat(SDValue { Node: N, ResNo: 0 }, SoftSin);
    self.SetSoftenedFloat(SDValue { Node: N, ResNo: 1 }, SoftCos);
    return SDValue {};
}

fn DAGTypeLegalizer::SoftenFloatRes_FMODF(self, N: *mut SDNode) -> SDValue {
    let mut VT: EVT = N.getValueType(0);
    if self.SoftenFloatRes_UnaryWithTwoFPResults(N, getMODF(VT), optional<unsigned int> { 0 }) {
        return SDValue {};
    }
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    self.DAG.getContext().emitError("do not know how to soften fmodf");
    let mut Poison: SDValue = self.DAG.getPOISON(NVT);
    self.SetSoftenedFloat(SDValue { Node: N, ResNo: 0 }, Poison);
    self.SetSoftenedFloat(SDValue { Node: N, ResNo: 1 }, Poison);
    return SDValue {};
}

fn DAGTypeLegalizer::SoftenFloatRes_FREM(self, N: *mut SDNode) -> SDValue {
    return self.SoftenFloatRes_Binary(N, getREM(N.getValueType(0)));
}

fn DAGTypeLegalizer::SoftenFloatRes_FRINT(self, N: *mut SDNode) -> SDValue {
    return self.SoftenFloatRes_Unary(N, getRINT(N.getValueType(0)));
