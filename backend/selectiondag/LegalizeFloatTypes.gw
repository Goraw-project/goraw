fn DAGTypeLegalizer::ExpandFloatRes_LOAD(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    if isNormalLoad(N) {
        self.ExpandRes_NormalLoad(N, Lo, Hi);
        return;
    }
    assert!(isUNINDEXEDLoad(N), "Indexed load during type legalization!");
    let mut LD: *mut LoadSDNode = cast(N);
    let mut Chain: SDValue = LD.getChain();
    let mut Ptr: SDValue = LD.getBasePtr();
    let mut dl: SDLoc = SDLoc { N };
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), LD.getValueType(0));
    assert!(NVT.isByteSized(), "Expanded type not byte sized!");
    assert!(LD.getMemoryVT().bitsLE(NVT), "Float type not round?");
    Hi = self.DAG.getExtLoad(LD.getExtensionType(), dl, NVT, Chain, Ptr, LD.getMemoryVT(), LD.getMemOperand());
    Chain = Hi.getValue(1);
    Lo = self.DAG.getConstantFP(getZero(NVT.getFltSemantics(), false), dl, NVT, false);
    self.ReplaceValueWith(SDValue { Node: LD, ResNo: 1 }, Chain);
}

fn DAGTypeLegalizer::ExpandFloatRes_XINT_TO_FP(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    assert!(N.getValueType(0) == EVT { ppcf128 }, "Unsupported XINT_TO_FP!");
    let mut VT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), VT);
    let mut Strict: bool = N.isStrictFPOpcode();
    let mut Src: SDValue = N.getOperand(if Strict { 1 } else { 0 });
    let mut SrcVT: EVT = Src.getValueType();
    let mut isSigned: bool = N.getOpcode() == SINT_TO_FP || N.getOpcode() == STRICT_SINT_TO_FP;
    let mut dl: SDLoc = SDLoc { N };
    let mut Chain: SDValue = if Strict { N.getOperand(0) } else { self.DAG.getEntryNode() };
    let mut Flags: SDNodeFlags = SDNodeFlags { Flags: None };
    Flags.setNoFPExcept(N.getFlags().hasNoFPExcept());
    if SrcVT.bitsLE(EVT { i32 }) {
        Lo = self.DAG.getConstantFP(getZero(NVT.getFltSemantics(), false), dl, NVT, false);
        if Strict {
            Hi = self.DAG.getNode(N.getOpcode(), dl, self.DAG.getVTList(NVT, EVT { Other }), ArrayRef<SDValue> { [Chain, Src] }, Flags);
            Chain = Hi.getValue(1);
        } else {
            Hi = self.DAG.getNode(N.getOpcode(), dl, NVT, Src);
        }
    } else {
        let mut LC: Libcall = UNKNOWN_LIBCALL;
        if SrcVT.bitsLE(EVT { i64 }) {
            Src = self.DAG.getNode(if isSigned { SIGN_EXTEND } else { ZERO_EXTEND }, dl, EVT { i64 }, Src);
            LC = SINTTOFP_I64_PPCF128;
        } else if SrcVT.bitsLE(EVT { i128 }) {
            Src = self.DAG.getNode(SIGN_EXTEND, dl, EVT { i128 }, Src);
            LC = SINTTOFP_I128_PPCF128;
        }
        assert!(LC != UNKNOWN_LIBCALL, "Unsupported XINT_TO_FP!");
        let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
        if LCImpl == Unsupported {
            return self.ExpandFloatRes_NoLibcall(N, Lo, Hi);
        }
        let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
        CallOptions.setIsSigned(true);
        let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, LCImpl, VT, ArrayRef<SDValue> { Src }, CallOptions, dl, Chain);
        if Strict {
            Chain = Tmp.second;
        }
        self.GetPairElements(Tmp.first, Lo, Hi);
    }
    if isSigned || SrcVT.bitsLE(EVT { i32 }) {
        if Strict {
            self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Chain);
        }
        return;
    }
    Hi = self.DAG.getNode(BUILD_PAIR, dl, VT, Lo, Hi);
    SrcVT = Src.getValueType();
    let mut TwoE32: [2]u64 = [4751297606875873280, 0];
    let mut TwoE64: [2]u64 = [4895412794951729152, 0];
    let mut TwoE128: [2]u64 = [5183643171103440896, 0];
    let mut Parts: ArrayRef<uint64_t> = ArrayRef<uint64_t> {};
    match SrcVT.getSimpleVT().SimpleTy {
        _ => {
            llvm_unreachable_internal("Unsupported UINT_TO_FP!", "llvm\\lib\\CodeGen\\SelectionDAG\\LegalizeFloatTypes.cpp", 2133);
        },
        i32 => {
            Parts = ArrayRef<unsigned long long> { TwoE32 };
        },
        i64 => {
            Parts = ArrayRef<unsigned long long> { TwoE64 };
        },
        i128 => {
            Parts = ArrayRef<unsigned long long> { TwoE128 };
        },
    }
    let mut NewLo: SDValue = self.DAG.getConstantFP(APFloat { PPCDoubleDouble(), APInt { U: 128, BitWidth: ArrayRef<uint64_t> { Parts } } }, dl, EVT { ppcf128 }, false);
    if Strict {
        Lo = self.DAG.getNode(STRICT_FADD, dl, self.DAG.getVTList(VT, EVT { Other }), ArrayRef<SDValue> { [Chain, Hi, NewLo] }, Flags);
        Chain = Lo.getValue(1);
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Chain);
    } else {
        Lo = self.DAG.getNode(FADD, dl, VT, Hi, NewLo);
    }
    Lo = self.DAG.getSelectCC(dl, Src, self.DAG.getConstant(0, dl, SrcVT, false, false), Lo, Hi, SETLT, SDNodeFlags { Flags: None });
    self.GetPairElements(Lo, Lo, Hi);
}

fn DAGTypeLegalizer::ExpandFloatOperand(self, N: *mut SDNode, OpNo: u32) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalize-types", 1) {
            dbgs() << "Expand float operand: ";
            N.dump(&mut self.DAG);
        }
    }
        if !(false) { break; }
    }
    let mut Res: SDValue = SDValue {};
    if self.CustomLowerNode(N, N.getOperand(OpNo).getValueType(), false) {
        return false;
    }
    match N.getOpcode() {
        _ => {
            dbgs() << "ExpandFloatOperand Op #" << OpNo << ": ";
        },
        BITCAST => {
            Res = self.ExpandOp_BITCAST(N);
        },
        BUILD_VECTOR => {
            Res = self.ExpandOp_BUILD_VECTOR(N);
        },
        EXTRACT_ELEMENT => {
            Res = self.ExpandOp_EXTRACT_ELEMENT(N);
        },
        BR_CC => {
            Res = self.ExpandFloatOp_BR_CC(N);
        },
        FCOPYSIGN => {
            Res = self.ExpandFloatOp_FCOPYSIGN(N);
        },
        STRICT_FP_ROUND => {
            FP_ROUND;
        },
        STRICT_FP_TO_SINT => {
            STRICT_FP_TO_UINT;
        },
        LROUND => {
            Res = self.ExpandFloatOp_LROUND(N);
        },
        LLROUND => {
            Res = self.ExpandFloatOp_LLROUND(N);
        },
        LRINT => {
            Res = self.ExpandFloatOp_LRINT(N);
        },
        LLRINT => {
            Res = self.ExpandFloatOp_LLRINT(N);
        },
        SELECT_CC => {
            Res = self.ExpandFloatOp_SELECT_CC(N);
        },
        STRICT_FSETCC => {
            STRICT_FSETCCS;
        },
        STORE => {
            Res = self.ExpandFloatOp_STORE(cast(N), OpNo);
        },
    }
    if !Res.getNode() {
        return false;
    }
    if Res.getNode() == N {
        return true;
    }
    assert!(Res.getValueType() == N.getValueType(0) && N.getNumValues() == 1, "Invalid operand expansion");
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Res);
    return false;
}

fn DAGTypeLegalizer::FloatExpandSetCCOperands(self, NewLHS: *mut SDValue, NewRHS: *mut SDValue, CCCode: *mut CondCode, dl: *SDLoc, Chain: *mut SDValue, IsSignaling: bool) {
    let mut LHSLo: SDValue = SDValue {};
    let mut LHSHi: SDValue = SDValue {};
    let mut RHSLo: SDValue = SDValue {};
    let mut RHSHi: SDValue = SDValue {};
    self.GetExpandedFloat(NewLHS, LHSLo, LHSHi);
    self.GetExpandedFloat(NewRHS, RHSLo, RHSHi);
    assert!(NewLHS.getValueType() == EVT { ppcf128 }, "Unsupported setcc type!");
    let mut Tmp1: SDValue = SDValue {};
    let mut Tmp2: SDValue = SDValue {};
    let mut Tmp3: SDValue = SDValue {};
    let mut OutputChain: SDValue = SDValue {};
    Tmp1 = self.DAG.getSetCC(dl, self.getSetCCResultType(LHSHi.getValueType()), LHSHi, RHSHi, SETOEQ, Chain, IsSignaling, SDNodeFlags { Flags: None });
    OutputChain = if operator(Tmp1).getNumValues() > 1 { Tmp1.getValue(1) } else { SDValue {} };
    Tmp2 = self.DAG.getSetCC(dl, self.getSetCCResultType(LHSLo.getValueType()), LHSLo, RHSLo, CCCode, OutputChain, IsSignaling, SDNodeFlags { Flags: None });
    OutputChain = if operator(Tmp2).getNumValues() > 1 { Tmp2.getValue(1) } else { SDValue {} };
    Tmp3 = self.DAG.getNode(AND, dl, Tmp1.getValueType(), Tmp1, Tmp2);
    Tmp1 = self.DAG.getSetCC(dl, self.getSetCCResultType(LHSHi.getValueType()), LHSHi, RHSHi, SETUNE, OutputChain, IsSignaling, SDNodeFlags { Flags: None });
    OutputChain = if operator(Tmp1).getNumValues() > 1 { Tmp1.getValue(1) } else { SDValue {} };
    Tmp2 = self.DAG.getSetCC(dl, self.getSetCCResultType(LHSHi.getValueType()), LHSHi, RHSHi, CCCode, OutputChain, IsSignaling, SDNodeFlags { Flags: None });
    OutputChain = if operator(Tmp2).getNumValues() > 1 { Tmp2.getValue(1) } else { SDValue {} };
    Tmp1 = self.DAG.getNode(AND, dl, Tmp1.getValueType(), Tmp1, Tmp2);
    NewLHS = self.DAG.getNode(OR, dl, Tmp1.getValueType(), Tmp1, Tmp3);
    NewRHS = SDValue {};
    Chain = OutputChain;
}

fn DAGTypeLegalizer::ExpandFloatOp_BR_CC(self, N: *mut SDNode) -> SDValue {
    let mut NewLHS: SDValue = N.getOperand(2);
    let mut NewRHS: SDValue = N.getOperand(3);
    let mut CCCode: CondCode = cast(N.getOperand(1)).get();
    let mut Chain: SDValue = SDValue {};
    self.FloatExpandSetCCOperands(NewLHS, NewRHS, CCCode, SDLoc { N }, Chain, false);
    if !NewRHS.getNode() {
        NewRHS = self.DAG.getConstant(0, SDLoc { N }, NewLHS.getValueType(), false, false);
        CCCode = SETNE;
    }
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, N.getOperand(0), self.DAG.getCondCode(CCCode), NewLHS, NewRHS, N.getOperand(4)), ResNo: 0 };
}

fn DAGTypeLegalizer::ExpandFloatOp_FCOPYSIGN(self, N: *mut SDNode) -> SDValue {
    assert!(N.getOperand(1).getValueType() == EVT { ppcf128 }, "Logic only correct for ppcf128!");
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    self.GetExpandedFloat(N.getOperand(1), Lo, Hi);
    return self.DAG.getNode(FCOPYSIGN, SDLoc { N }, N.getValueType(0), N.getOperand(0), Hi);
}

fn DAGTypeLegalizer::ExpandFloatOp_FP_ROUND(self, N: *mut SDNode) -> SDValue {
    let mut IsStrict: bool = N.isStrictFPOpcode();
    assert!(N.getOperand(if IsStrict { 1 } else { 0 }).getValueType() == EVT { ppcf128 }, "Logic only correct for ppcf128!");
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    self.GetExpandedFloat(N.getOperand(if IsStrict { 1 } else { 0 }), Lo, Hi);
    if !IsStrict {
        return self.DAG.getNode(FP_ROUND, SDLoc { N }, N.getValueType(0), Hi, N.getOperand(1));
    }
    if Hi.getValueType() == N.getValueType(0) {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, N.getOperand(0));
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Hi);
        return SDValue {};
    }
    let mut Expansion: SDValue = self.DAG.getNode(STRICT_FP_ROUND, SDLoc { N }, ArrayRef<EVT> { [N.getValueType(0), EVT { Other }] }, ArrayRef<SDValue> { [N.getOperand(0), Hi, N.getOperand(2)] });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Expansion.getValue(1));
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Expansion);
    return SDValue {};
}

fn DAGTypeLegalizer::ExpandFloatOp_FP_TO_XINT(self, N: *mut SDNode) -> SDValue {
    let mut RVT: EVT = N.getValueType(0);
    let mut dl: SDLoc = SDLoc { N };
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut Signed: bool = N.getOpcode() == FP_TO_SINT || N.getOpcode() == STRICT_FP_TO_SINT;
    let mut Op: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    let mut Chain: SDValue = if IsStrict { N.getOperand(0) } else { SDValue {} };
    let mut NVT: EVT = EVT {};
    let mut LC: Libcall = findFPToIntLibcall(Op.getValueType(), RVT, NVT, Signed);
    assert!(LC != UNKNOWN_LIBCALL && NVT.isSimple(), "Unsupported FP_TO_XINT!");
    let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if LCImpl == Unsupported {
        reportNoLibcall(self.DAG, N, Op.getValueType());
        let mut Poison: SDValue = self.DAG.getPOISON(RVT);
        if IsStrict {
            self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Chain);
            self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Poison);
            return SDValue {};
        }
        return Poison;
    }
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, LCImpl, NVT, ArrayRef<SDValue> { Op }, CallOptions, dl, Chain);
    if !IsStrict {
        return Tmp.first;
    }
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Tmp.second);
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Tmp.first);
    return SDValue {};
}

fn DAGTypeLegalizer::ExpandFloatOp_SELECT_CC(self, N: *mut SDNode) -> SDValue {
    let mut NewLHS: SDValue = N.getOperand(0);
    let mut NewRHS: SDValue = N.getOperand(1);
    let mut CCCode: CondCode = cast(N.getOperand(4)).get();
    let mut Chain: SDValue = SDValue {};
    self.FloatExpandSetCCOperands(NewLHS, NewRHS, CCCode, SDLoc { N }, Chain, false);
    if !NewRHS.getNode() {
        NewRHS = self.DAG.getConstant(0, SDLoc { N }, NewLHS.getValueType(), false, false);
        CCCode = SETNE;
    }
    return SDValue { Node: self.DAG.UpdateNodeOperands(N, NewLHS, NewRHS, N.getOperand(2), N.getOperand(3), self.DAG.getCondCode(CCCode)), ResNo: 0 };
}

fn DAGTypeLegalizer::ExpandFloatOp_SETCC(self, N: *mut SDNode) -> SDValue {
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut NewLHS: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    let mut NewRHS: SDValue = N.getOperand(if IsStrict { 2 } else { 1 });
    let mut Chain: SDValue = if IsStrict { N.getOperand(0) } else { SDValue {} };
    let mut CCCode: CondCode = cast(N.getOperand(if IsStrict { 3 } else { 2 })).get();
    self.FloatExpandSetCCOperands(NewLHS, NewRHS, CCCode, SDLoc { N }, Chain, N.getOpcode() == STRICT_FSETCCS);
    assert!(!NewRHS.getNode(), "Expect to return scalar");
    assert!(NewLHS.getValueType() == N.getValueType(0), "Unexpected setcc expansion!");
    if Chain {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, NewLHS);
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Chain);
        return SDValue {};
    }
    return NewLHS;
}

fn DAGTypeLegalizer::ExpandFloatOp_STORE(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    if isNormalStore(N) {
        return self.ExpandOp_NormalStore(N, OpNo);
    }
    assert!(isUNINDEXEDStore(N), "Indexed store during type legalization!");
    assert!(OpNo == 1, "Can only expand the stored value so far");
    let mut ST: *mut StoreSDNode = cast(N);
    let mut Chain: SDValue = ST.getChain();
    let mut Ptr: SDValue = ST.getBasePtr();
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), ST.getValue().getValueType());
    assert!(NVT.isByteSized(), "Expanded type not byte sized!");
    assert!(ST.getMemoryVT().bitsLE(NVT), "Float type not round?");
    NVT as void;
    let mut Lo: SDValue = SDValue {};
    let mut Hi: SDValue = SDValue {};
    self.GetExpandedOp(ST.getValue(), Lo, Hi);
    return self.DAG.getTruncStore(Chain, SDLoc { N }, Hi, Ptr, ST.getMemoryVT(), ST.getMemOperand());
}

fn DAGTypeLegalizer::ExpandFloatOp_XRINT_XROUND(self, N: *mut SDNode, LC: Libcall) -> SDValue {
    let mut RVT: EVT = N.getValueType(0);
    let mut LCImpl: LibcallImpl = self.DAG.getLibcalls().getLibcallImpl(LC);
    if LCImpl == Unsupported {
        reportNoLibcall(self.DAG, N, N.getOperand(0).getValueType());
        return self.DAG.getPOISON(RVT);
    }
    let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
    return self.TLI.makeLibCall(self.DAG, LCImpl, RVT, ArrayRef<SDValue> { N.getOperand(0) }, CallOptions, SDLoc { N }, SDValue {}).first;
}

fn DAGTypeLegalizer::ExpandFloatOp_LROUND(self, N: *mut SDNode) -> SDValue {
    let mut RetVT: EVT = N.getOperand(0).getValueType();
    return self.ExpandFloatOp_XRINT_XROUND(N, GetFPLibCall(RetVT, LROUND_F32, LROUND_F64, LROUND_F80, LROUND_F128, LROUND_PPCF128));
}

fn DAGTypeLegalizer::ExpandFloatOp_LLROUND(self, N: *mut SDNode) -> SDValue {
    let mut RetVT: EVT = N.getOperand(0).getValueType();
    return self.ExpandFloatOp_XRINT_XROUND(N, GetFPLibCall(RetVT, LLROUND_F32, LLROUND_F64, LLROUND_F80, LLROUND_F128, LLROUND_PPCF128));
}

fn DAGTypeLegalizer::ExpandFloatOp_LRINT(self, N: *mut SDNode) -> SDValue {
    let mut RetVT: EVT = N.getOperand(0).getValueType();
    return self.ExpandFloatOp_XRINT_XROUND(N, GetFPLibCall(RetVT, LRINT_F32, LRINT_F64, LRINT_F80, LRINT_F128, LRINT_PPCF128));
}

fn DAGTypeLegalizer::ExpandFloatOp_LLRINT(self, N: *mut SDNode) -> SDValue {
    let mut RetVT: EVT = N.getOperand(0).getValueType();
    return self.ExpandFloatOp_XRINT_XROUND(N, GetFPLibCall(RetVT, LLRINT_F32, LLRINT_F64, LLRINT_F80, LLRINT_F128, LLRINT_PPCF128));
}

fn GetPromotionOpcode(OpVT: EVT, RetVT: EVT) -> NodeType {
    if OpVT == EVT { f16 } {
        return FP16_TO_FP;
    }
    if RetVT == EVT { f16 } {
        return FP_TO_FP16;
    }
    if OpVT == EVT { bf16 } {
        return BF16_TO_FP;
    }
    if RetVT == EVT { bf16 } {
        return FP_TO_BF16;
    }
    report_fatal_error("Attempt at an invalid promotion-related conversion", true);
}

fn GetPromotionOpcodeStrict(OpVT: EVT, RetVT: EVT) -> NodeType {
    if OpVT == EVT { f16 } {
        return STRICT_FP16_TO_FP;
    }
    if RetVT == EVT { f16 } {
        return STRICT_FP_TO_FP16;
    }
    if OpVT == EVT { bf16 } {
        return STRICT_BF16_TO_FP;
    }
    if RetVT == EVT { bf16 } {
        return STRICT_FP_TO_BF16;
    }
    report_fatal_error("Attempt at an invalid promotion-related conversion", true);
}

fn DAGTypeLegalizer::BitcastToInt_ATOMIC_SWAP(self, N: *mut SDNode) -> SDValue {
    let mut AM: *mut AtomicSDNode = cast(N);
    let mut SL: SDLoc = SDLoc { N };
    let mut CastVal: SDValue = self.BitConvertToInteger(AM.getVal());
    let mut CastVT: EVT = CastVal.getValueType();
    let mut NewAtomic: SDValue = self.DAG.getAtomic(ATOMIC_SWAP, SL, CastVT, self.DAG.getVTList(CastVT, EVT { Other }), ArrayRef<SDValue> { [AM.getChain(), AM.getBasePtr(), CastVal] }, AM.getMemOperand(), NON_EXTLOAD);
    let mut Result: SDValue = NewAtomic;
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, NewAtomic.getValue(1));
    return Result;
}

fn DAGTypeLegalizer::SoftPromoteHalfResult(self, N: *mut SDNode, ResNo: u32) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalize-types", 1) {
            dbgs() << "Soft promote half result " << ResNo << ": ";
            N.dump(&mut self.DAG);
        }
    }
        if !(false) { break; }
    }
    let mut R: SDValue = SDValue {};
    if self.CustomLowerNode(N, N.getValueType(ResNo), true) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("legalize-types", 1) {
                dbgs() << "Node has been custom expanded, done\n";
            }
        }
            if !(false) { break; }
        }
        return;
    }
    match N.getOpcode() {
        _ => {
            dbgs() << "SoftPromoteHalfResult #" << ResNo << ": ";
        },
        ARITH_FENCE => {
            R = self.SoftPromoteHalfRes_ARITH_FENCE(N);
        },
        BITCAST => {
            R = self.SoftPromoteHalfRes_BITCAST(N);
        },
        ConstantFP => {
            R = self.SoftPromoteHalfRes_ConstantFP(N);
        },
        EXTRACT_VECTOR_ELT => {
            R = self.SoftPromoteHalfRes_EXTRACT_VECTOR_ELT(N);
        },
        FCOPYSIGN => {
            R = self.SoftPromoteHalfRes_FCOPYSIGN(N);
        },
        STRICT_FP_ROUND => {
            FP_ROUND;
        },
        FACOS => {
            FASIN;
        },
        FABS => {
            R = self.SoftPromoteHalfRes_FABS(N);
        },
        FNEG => {
            R = self.SoftPromoteHalfRes_FNEG(N);
        },
        AssertNoFPClass => {
            R = self.SoftPromoteHalfRes_AssertNoFPClass(N);
        },
        FADD => {
            FDIV;
        },
        FMA => {
            FMAD;
        },
        FPOWI => {
            FLDEXP;
        },
        FFREXP => {
            R = self.SoftPromoteHalfRes_FFREXP(N);
        },
        FMODF => {
            FSINCOS;
        },
        LOAD => {
            R = self.SoftPromoteHalfRes_LOAD(N);
        },
        ATOMIC_LOAD => {
            R = self.SoftPromoteHalfRes_ATOMIC_LOAD(N);
        },
        SELECT => {
            R = self.SoftPromoteHalfRes_SELECT(N);
        },
        SELECT_CC => {
            R = self.SoftPromoteHalfRes_SELECT_CC(N);
        },
        STRICT_SINT_TO_FP => {
            STRICT_UINT_TO_FP;
        },
        CONVERT_FROM_ARBITRARY_FP => {
            R = self.SoftPromoteHalfRes_CONVERT_FROM_ARBITRARY_FP(N);
        },
        POISON => {
            UNDEF;
        },
        ATOMIC_SWAP => {
            R = self.BitcastToInt_ATOMIC_SWAP(N);
        },
        VECREDUCE_FADD => {
            VECREDUCE_FMUL;
        },
        VECREDUCE_SEQ_FADD => {
            VECREDUCE_SEQ_FMUL;
        },
    }
    if R.getNode() {
        self.SetSoftPromotedHalf(SDValue { Node: N, ResNo: ResNo }, R);
    }
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_ARITH_FENCE(self, N: *mut SDNode) -> SDValue {
    return self.DAG.getNode(ARITH_FENCE, SDLoc { N }, EVT { i16 }, self.BitConvertToInteger(N.getOperand(0)));
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_BITCAST(self, N: *mut SDNode) -> SDValue {
    return self.BitConvertToInteger(N.getOperand(0));
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_ConstantFP(self, N: *mut SDNode) -> SDValue {
    let mut CN: *mut ConstantFPSDNode = cast(N);
    return self.DAG.getConstant(CN.getValueAPF().bitcastToAPInt(), SDLoc { CN }, EVT { i16 }, false, false);
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_EXTRACT_VECTOR_ELT(self, N: *mut SDNode) -> SDValue {
    let mut NewOp: SDValue = self.BitConvertVectorToIntegerVector(N.getOperand(0));
    return self.DAG.getNode(EXTRACT_VECTOR_ELT, SDLoc { N }, NewOp.getValueType().getVectorElementType(), NewOp, N.getOperand(1));
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_FCOPYSIGN(self, N: *mut SDNode) -> SDValue {
    let mut LHS: SDValue = self.GetSoftPromotedHalf(N.getOperand(0));
    let mut RHS: SDValue = self.BitConvertToInteger(N.getOperand(1));
    let mut dl: SDLoc = SDLoc { N };
    let mut LVT: EVT = LHS.getValueType();
    let mut RVT: EVT = RHS.getValueType();
    let mut LSize: u32 = LVT.getSizeInBits().operator unsigned long long();
    let mut RSize: u32 = RVT.getSizeInBits().operator unsigned long long();
    let mut SignBit: SDValue = self.DAG.getNode(SHL, dl, RVT, self.DAG.getConstant(1, dl, RVT, false, false), self.DAG.getConstant(RSize - 1, dl, self.TLI.getShiftAmountTy(RVT, self.DAG.getDataLayout()), false, false));
    SignBit = self.DAG.getNode(AND, dl, RVT, RHS, SignBit);
    let mut SizeDiff: i32 = RVT.getSizeInBits() - LVT.getSizeInBits().operator unsigned long long();
    if SizeDiff > 0 {
        SignBit = self.DAG.getNode(SRL, dl, RVT, SignBit, self.DAG.getConstant(SizeDiff, dl, self.TLI.getShiftAmountTy(SignBit.getValueType(), self.DAG.getDataLayout()), false, false));
        SignBit = self.DAG.getNode(TRUNCATE, dl, LVT, SignBit);
    } else if SizeDiff < 0 {
        SignBit = self.DAG.getNode(ANY_EXTEND, dl, LVT, SignBit);
        SignBit = self.DAG.getNode(SHL, dl, LVT, SignBit, self.DAG.getConstant(-SizeDiff, dl, self.TLI.getShiftAmountTy(SignBit.getValueType(), self.DAG.getDataLayout()), false, false));
    }
    let mut Mask: SDValue = self.DAG.getNode(SHL, dl, LVT, self.DAG.getConstant(1, dl, LVT, false, false), self.DAG.getConstant(LSize - 1, dl, self.TLI.getShiftAmountTy(LVT, self.DAG.getDataLayout()), false, false));
    Mask = self.DAG.getNode(SUB, dl, LVT, Mask, self.DAG.getConstant(1, dl, LVT, false, false));
    LHS = self.DAG.getNode(AND, dl, LVT, LHS, Mask);
    return self.DAG.getNode(OR, dl, LVT, LHS, SignBit);
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_FMAD(self, N: *mut SDNode) -> SDValue {
    let mut OVT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OVT);
    let mut Op0: SDValue = self.GetSoftPromotedHalf(N.getOperand(0));
    let mut Op1: SDValue = self.GetSoftPromotedHalf(N.getOperand(1));
    let mut Op2: SDValue = self.GetSoftPromotedHalf(N.getOperand(2));
    let mut Flags: SDNodeFlags = N.getFlags();
    let mut dl: SDLoc = SDLoc { N };
    let mut PromotionOpcode: NodeType = GetPromotionOpcode(OVT, NVT);
    Op0 = self.DAG.getNode(PromotionOpcode, dl, NVT, Op0);
    Op1 = self.DAG.getNode(PromotionOpcode, dl, NVT, Op1);
    Op2 = self.DAG.getNode(PromotionOpcode, dl, NVT, Op2);
    let mut Res: SDValue = SDValue {};
    if OVT == EVT { f16 } {
        let mut A64: SDValue = self.DAG.getNode(FP_EXTEND, dl, EVT { f64 }, Op0, Flags);
        let mut B64: SDValue = self.DAG.getNode(FP_EXTEND, dl, EVT { f64 }, Op1, Flags);
        let mut C64: SDValue = self.DAG.getNode(FP_EXTEND, dl, EVT { f64 }, Op2, Flags);
        let mut WideRes: SDValue = SDValue {};
        if self.TLI.isFMAFasterThanFMulAndFAdd(self.DAG.getMachineFunction(), EVT { f64 }) {
            WideRes = self.DAG.getNode(FMA, dl, EVT { f64 }, A64, B64, C64, Flags);
        } else {
            let mut Mul: SDValue = self.DAG.getNode(FMUL, dl, EVT { f64 }, A64, B64, Flags);
            WideRes = self.DAG.getNode(FADD, dl, EVT { f64 }, Mul, C64, Flags);
        }
        return self.DAG.getNode(GetPromotionOpcode(EVT { f64 }, OVT), dl, EVT { i16 }, WideRes);
    }
    Res = self.DAG.getNode(N.getOpcode(), dl, NVT, Op0, Op1, Op2, Flags);
    return self.DAG.getNode(GetPromotionOpcode(NVT, OVT), dl, EVT { i16 }, Res);
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_ExpOp(self, N: *mut SDNode) -> SDValue {
    let mut OVT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OVT);
    let mut Op0: SDValue = self.GetSoftPromotedHalf(N.getOperand(0));
    let mut Op1: SDValue = N.getOperand(1);
    let mut dl: SDLoc = SDLoc { N };
    Op0 = self.DAG.getNode(GetPromotionOpcode(OVT, NVT), dl, NVT, Op0);
    let mut Res: SDValue = self.DAG.getNode(N.getOpcode(), dl, NVT, Op0, Op1);
    return self.DAG.getNode(GetPromotionOpcode(NVT, OVT), dl, EVT { i16 }, Res);
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_FFREXP(self, N: *mut SDNode) -> SDValue {
    let mut OVT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OVT);
    let mut Op: SDValue = self.GetSoftPromotedHalf(N.getOperand(0));
    let mut dl: SDLoc = SDLoc { N };
    Op = self.DAG.getNode(GetPromotionOpcode(OVT, NVT), dl, NVT, Op);
    let mut Res: SDValue = self.DAG.getNode(N.getOpcode(), dl, self.DAG.getVTList(NVT, N.getValueType(1)), Op);
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
    return self.DAG.getNode(GetPromotionOpcode(NVT, OVT), dl, EVT { i16 }, Res);
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_UnaryWithTwoFPResults(self, N: *mut SDNode) -> SDValue {
    let mut OVT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OVT);
    let mut Op: SDValue = self.GetSoftPromotedHalf(N.getOperand(0));
    let mut dl: SDLoc = SDLoc { N };
    Op = self.DAG.getNode(GetPromotionOpcode(OVT, NVT), dl, NVT, Op);
    let mut Res: SDValue = self.DAG.getNode(N.getOpcode(), dl, self.DAG.getVTList(NVT, NVT), Op);
    let mut Truncate: NodeType = GetPromotionOpcode(NVT, OVT);
    for let mut ResNum: u32 = 0;
let mut NumValues: u32 = N.getNumValues(); ResNum < NumValues; ResNum += 1 {
        let mut Trunc: SDValue = self.DAG.getNode(Truncate, dl, EVT { i16 }, Res.getValue(ResNum));
        self.SetSoftPromotedHalf(SDValue { Node: N, ResNo: ResNum }, Trunc);
    }
    return SDValue {};
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_FP_ROUND(self, N: *mut SDNode) -> SDValue {
    let mut RVT: EVT = N.getValueType(0);
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut Op: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    let mut SVT: EVT = Op.getValueType();
    if self.getTypeAction(SVT) == TypeSoftenFloat {
        let mut LC: Libcall = getFPROUND(SVT, RVT);
        assert!(LC != UNKNOWN_LIBCALL, "Unsupported FP_ROUND libcall");
        let mut Chain: SDValue = if IsStrict { N.getOperand(0) } else { SDValue {} };
        Op = self.GetSoftenedFloat(Op);
        let mut CallOptions: MakeLibCallOptions = MakeLibCallOptions {};
        CallOptions.setTypeListBeforeSoften(ArrayRef<EVT> { SVT }, RVT);
        let mut Tmp: pair<SDValue, SDValue> = self.TLI.makeLibCall(self.DAG, LC, RVT, ArrayRef<SDValue> { Op }, CallOptions, SDLoc { N }, Chain);
        if IsStrict {
            self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Tmp.second);
        }
        return self.DAG.getNode(BITCAST, SDLoc { N }, EVT { i16 }, Tmp.first);
    }
    if IsStrict {
        let mut Res: SDValue = self.DAG.getNode(GetPromotionOpcodeStrict(SVT, RVT), SDLoc { N }, ArrayRef<EVT> { [EVT { i16 }, EVT { Other }] }, ArrayRef<SDValue> { [N.getOperand(0), Op] });
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
        return Res;
    }
    return self.DAG.getNode(GetPromotionOpcode(SVT, RVT), SDLoc { N }, EVT { i16 }, N.getOperand(0));
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_LOAD(self, N: *mut SDNode) -> SDValue {
    let mut L: *mut LoadSDNode = cast(N);
    assert!(L.getExtensionType() == NON_EXTLOAD, "Unexpected extension!");
    let mut NewL: SDValue = self.DAG.getLoad(L.getAddressingMode(), L.getExtensionType(), EVT { i16 }, SDLoc { N }, L.getChain(), L.getBasePtr(), L.getOffset(), L.getPointerInfo(), EVT { i16 }, L.getBaseAlign(), L.getMemOperand().getFlags(), MMOMetadata { AAInfo: L.getAAInfo(), Ranges: null, MemCacheHint: null });
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, NewL.getValue(1));
    return NewL;
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_ATOMIC_LOAD(self, N: *mut SDNode) -> SDValue {
    let mut AM: *mut AtomicSDNode = cast(N);
    let mut NewL: SDValue = self.DAG.getAtomic(ATOMIC_LOAD, SDLoc { N }, EVT { i16 }, self.DAG.getVTList(EVT { i16 }, EVT { Other }), ArrayRef<SDValue> { [AM.getChain(), AM.getBasePtr()] }, AM.getMemOperand(), NON_EXTLOAD);
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, NewL.getValue(1));
    return NewL;
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_SELECT(self, N: *mut SDNode) -> SDValue {
    let mut Op1: SDValue = self.GetSoftPromotedHalf(N.getOperand(1));
    let mut Op2: SDValue = self.GetSoftPromotedHalf(N.getOperand(2));
    return self.DAG.getSelect(SDLoc { N }, Op1.getValueType(), N.getOperand(0), Op1, Op2, N.getFlags());
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_SELECT_CC(self, N: *mut SDNode) -> SDValue {
    let mut Op2: SDValue = self.GetSoftPromotedHalf(N.getOperand(2));
    let mut Op3: SDValue = self.GetSoftPromotedHalf(N.getOperand(3));
    return self.DAG.getNode(SELECT_CC, SDLoc { N }, Op2.getValueType(), N.getOperand(0), N.getOperand(1), Op2, Op3, N.getOperand(4));
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_XINT_TO_FP(self, N: *mut SDNode) -> SDValue {
    let mut OVT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OVT);
    let mut dl: SDLoc = SDLoc { N };
    if N.isStrictFPOpcode() {
        let mut Op: SDValue = self.DAG.getNode(N.getOpcode(), dl, ArrayRef<EVT> { [NVT, EVT { Other }] }, ArrayRef<SDValue> { [N.getOperand(0), N.getOperand(1)] });
        Op = self.DAG.getNode(GetPromotionOpcodeStrict(NVT, OVT), dl, ArrayRef<EVT> { [EVT { i16 }, EVT { Other }] }, ArrayRef<SDValue> { [Op.getValue(1), Op] });
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Op.getValue(1));
        return Op;
    }
    let mut Res: SDValue = self.DAG.getNode(N.getOpcode(), dl, NVT, N.getOperand(0));
    return self.DAG.getNode(GetPromotionOpcode(NVT, OVT), dl, EVT { i16 }, Res);
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_CONVERT_FROM_ARBITRARY_FP(self, N: *mut SDNode) -> SDValue {
    let mut OVT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OVT);
    let mut dl: SDLoc = SDLoc { N };
    let mut Res: SDValue = self.DAG.getNode(CONVERT_FROM_ARBITRARY_FP, dl, NVT, N.getOperand(0), N.getOperand(1));
    return self.DAG.getNode(GetPromotionOpcode(NVT, OVT), dl, EVT { i16 }, Res);
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_UNDEF(self, N: *mut SDNode) -> SDValue {
    return self.DAG.getUNDEF(EVT { i16 });
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_UnaryOp(self, N: *mut SDNode) -> SDValue {
    let mut OVT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OVT);
    let mut Op: SDValue = self.GetSoftPromotedHalf(N.getOperand(0));
    let mut dl: SDLoc = SDLoc { N };
    Op = self.DAG.getNode(GetPromotionOpcode(OVT, NVT), dl, NVT, Op);
    let mut Res: SDValue = self.DAG.getNode(N.getOpcode(), dl, NVT, Op);
    return self.DAG.getNode(GetPromotionOpcode(NVT, OVT), dl, EVT { i16 }, Res);
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_FABS(self, N: *mut SDNode) -> SDValue {
    let mut Op: SDValue = self.GetSoftPromotedHalf(N.getOperand(0));
    let mut dl: SDLoc = SDLoc { N };
    return self.DAG.getNode(AND, dl, EVT { i16 }, Op, self.DAG.getConstant(32767, dl, EVT { i16 }, false, false));
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_FNEG(self, N: *mut SDNode) -> SDValue {
    let mut Op: SDValue = self.GetSoftPromotedHalf(N.getOperand(0));
    let mut dl: SDLoc = SDLoc { N };
    return self.DAG.getNode(XOR, dl, EVT { i16 }, Op, self.DAG.getConstant(32768, dl, EVT { i16 }, false, false));
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_AssertNoFPClass(self, N: *mut SDNode) -> SDValue {
    return self.GetSoftPromotedHalf(N.getOperand(0));
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_BinOp(self, N: *mut SDNode) -> SDValue {
    let mut OVT: EVT = N.getValueType(0);
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), OVT);
    let mut Op0: SDValue = self.GetSoftPromotedHalf(N.getOperand(0));
    let mut Op1: SDValue = self.GetSoftPromotedHalf(N.getOperand(1));
    let mut dl: SDLoc = SDLoc { N };
    let mut PromotionOpcode: NodeType = GetPromotionOpcode(OVT, NVT);
    Op0 = self.DAG.getNode(PromotionOpcode, dl, NVT, Op0);
    Op1 = self.DAG.getNode(PromotionOpcode, dl, NVT, Op1);
    let mut Res: SDValue = self.DAG.getNode(N.getOpcode(), dl, NVT, Op0, Op1);
    return self.DAG.getNode(GetPromotionOpcode(NVT, OVT), dl, EVT { i16 }, Res);
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_VECREDUCE(self, N: *mut SDNode) -> SDValue {
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, self.TLI.expandVecReduce(N, self.DAG));
    return SDValue {};
}

fn DAGTypeLegalizer::SoftPromoteHalfRes_VECREDUCE_SEQ(self, N: *mut SDNode) -> SDValue {
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, self.TLI.expandVecReduceSeq(N, self.DAG));
    return SDValue {};
}

fn DAGTypeLegalizer::SoftPromoteHalfOperand(self, N: *mut SDNode, OpNo: u32) -> bool {
    while true {
        {
        if DebugFlag && isCurrentDebugType("legalize-types", 1) {
            dbgs() << "Soft promote half operand " << OpNo << ": ";
            N.dump(&mut self.DAG);
        }
    }
        if !(false) { break; }
    }
    let mut Res: SDValue = SDValue {};
    if self.CustomLowerNode(N, N.getOperand(OpNo).getValueType(), false) {
        while true {
            {
            if DebugFlag && isCurrentDebugType("legalize-types", 1) {
                dbgs() << "Node has been custom lowered, done\n";
            }
        }
            if !(false) { break; }
        }
        return false;
    }
    match N.getOpcode() {
        _ => {
            dbgs() << "SoftPromoteHalfOperand Op #" << OpNo << ": ";
        },
        BITCAST => {
            Res = self.SoftPromoteHalfOp_BITCAST(N);
        },
        BUILD_VECTOR => {
            Res = self.SoftPromoteHalfOp_BUILD_VECTOR(N);
        },
        INSERT_VECTOR_ELT => {
            Res = self.SoftPromoteHalfOp_INSERT_VECTOR_ELT(N, OpNo);
        },
        FAKE_USE => {
            Res = self.SoftPromoteHalfOp_FAKE_USE(N, OpNo);
        },
        FCOPYSIGN => {
            Res = self.SoftPromoteHalfOp_FCOPYSIGN(N, OpNo);
        },
        FP_TO_SINT => {
            FP_TO_UINT;
        },
        FP_TO_SINT_SAT => {
            FP_TO_UINT_SAT;
        },
        CONVERT_TO_ARBITRARY_FP => {
            Res = self.SoftPromoteHalfOp_CONVERT_TO_ARBITRARY_FP(N);
        },
        STRICT_FP_EXTEND => {
            FP_EXTEND;
        },
        SELECT_CC => {
            Res = self.SoftPromoteHalfOp_SELECT_CC(N, OpNo);
        },
        BR_CC => {
            Res = self.SoftPromoteHalfOp_BR_CC(N);
        },
        SETCC => {
            Res = self.SoftPromoteHalfOp_SETCC(N);
        },
        STORE => {
            Res = self.SoftPromoteHalfOp_STORE(N, OpNo);
        },
        ATOMIC_STORE => {
            Res = self.SoftPromoteHalfOp_ATOMIC_STORE(N, OpNo);
        },
        STACKMAP => {
            Res = self.SoftPromoteHalfOp_STACKMAP(N, OpNo);
        },
        PATCHPOINT => {
            Res = self.SoftPromoteHalfOp_PATCHPOINT(N, OpNo);
        },
    }
    if !Res.getNode() {
        return false;
    }
    assert!(Res.getNode() != N, "Expected a new node!");
    assert!(Res.getValueType() == N.getValueType(0) && N.getNumValues() == 1, "Invalid operand expansion");
    self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Res);
    return false;
}

fn DAGTypeLegalizer::SoftPromoteHalfOp_BITCAST(self, N: *mut SDNode) -> SDValue {
    let mut Op0: SDValue = self.GetSoftPromotedHalf(N.getOperand(0));
    return self.DAG.getNode(BITCAST, SDLoc { N }, N.getValueType(0), Op0);
}

fn DAGTypeLegalizer::SoftPromoteHalfOp_BUILD_VECTOR(self, N: *mut SDNode) -> SDValue {
    let mut dl: SDLoc = SDLoc { N };
    let mut VT: EVT = N.getValueType(0);
    let mut Ops: SmallVector<SDValue, 8> = SmallVector<SDValue, 8> { N.getNumOperands() };
    for let mut I: u32 = 0;
let mut E: u32 = N.getNumOperands(); I != E; I += 1 {
        Ops[I] = self.GetSoftPromotedHalf(N.getOperand(I));
    }
    let mut IVT: EVT = VT.changeVectorElementTypeToInteger();
    let mut Res: SDValue = self.DAG.getBuildVector(IVT, dl, ArrayRef<SDValue> { Ops });
    return self.DAG.getBitcast(VT, Res);
}

fn DAGTypeLegalizer::SoftPromoteHalfOp_INSERT_VECTOR_ELT(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 1, "Only Operand 1 must need promotion here");
    let mut Vec: SDValue = self.BitConvertVectorToIntegerVector(N.getOperand(0));
    let mut Elt: SDValue = self.GetSoftPromotedHalf(N.getOperand(OpNo));
    let mut Res: SDValue = self.DAG.getNode(INSERT_VECTOR_ELT, SDLoc { N }, Vec.getValueType(), Vec, Elt, N.getOperand(2));
    return self.DAG.getBitcast(N.getValueType(0), Res);
}

fn DAGTypeLegalizer::SoftPromoteHalfOp_FAKE_USE(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 1, "Only Operand 1 must need promotion here");
    let mut Op: SDValue = self.GetSoftPromotedHalf(N.getOperand(OpNo));
    return self.DAG.getNode(N.getOpcode(), SDLoc { N }, EVT { Other }, N.getOperand(0), Op);
}

fn DAGTypeLegalizer::SoftPromoteHalfOp_FCOPYSIGN(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 1, "Only Operand 1 must need promotion here");
    let mut Op1: SDValue = N.getOperand(1);
    let mut RVT: EVT = Op1.getValueType();
    let mut dl: SDLoc = SDLoc { N };
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), Op1.getValueType());
    Op1 = self.GetSoftPromotedHalf(Op1);
    Op1 = self.DAG.getNode(GetPromotionOpcode(RVT, NVT), dl, NVT, Op1);
    return self.DAG.getNode(N.getOpcode(), dl, N.getValueType(0), N.getOperand(0), Op1);
}

fn DAGTypeLegalizer::SoftPromoteHalfOp_FP_EXTEND(self, N: *mut SDNode) -> SDValue {
    let mut RVT: EVT = N.getValueType(0);
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut Op: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    let mut SVT: EVT = Op.getValueType();
    Op = self.GetSoftPromotedHalf(N.getOperand(if IsStrict { 1 } else { 0 }));
    if IsStrict {
        let mut Res: SDValue = self.DAG.getNode(GetPromotionOpcodeStrict(SVT, RVT), SDLoc { N }, ArrayRef<EVT> { [RVT, EVT { Other }] }, ArrayRef<SDValue> { [N.getOperand(0), Op] });
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Res.getValue(1));
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Res);
        return SDValue {};
    }
    return self.DAG.getNode(GetPromotionOpcode(SVT, RVT), SDLoc { N }, RVT, Op);
}

fn DAGTypeLegalizer::SoftPromoteHalfOp_Op0WithStrict(self, N: *mut SDNode) -> SDValue {
    let mut RVT: EVT = N.getValueType(0);
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut Op: SDValue = N.getOperand(if IsStrict { 1 } else { 0 });
    let mut SVT: EVT = Op.getValueType();
    let mut dl: SDLoc = SDLoc { N };
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), SVT);
    Op = self.GetSoftPromotedHalf(Op);
    if IsStrict {
        Op = self.DAG.getNode(GetPromotionOpcodeStrict(SVT, RVT), dl, ArrayRef<EVT> { [NVT, EVT { Other }] }, ArrayRef<SDValue> { [N.getOperand(0), Op] });
        Op = self.DAG.getNode(N.getOpcode(), dl, ArrayRef<EVT> { [RVT, EVT { Other }] }, ArrayRef<SDValue> { [Op.getValue(1), Op] });
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Op.getValue(1));
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 0 }, Op);
        return SDValue {};
    }
    let mut Res: SDValue = self.DAG.getNode(GetPromotionOpcode(SVT, RVT), dl, NVT, Op);
    return self.DAG.getNode(N.getOpcode(), dl, RVT, Res);
}

fn DAGTypeLegalizer::SoftPromoteHalfOp_FP_TO_XINT_SAT(self, N: *mut SDNode) -> SDValue {
    let mut RVT: EVT = N.getValueType(0);
    let mut Op: SDValue = N.getOperand(0);
    let mut SVT: EVT = Op.getValueType();
    let mut dl: SDLoc = SDLoc { N };
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), Op.getValueType());
    Op = self.GetSoftPromotedHalf(Op);
    let mut Res: SDValue = self.DAG.getNode(GetPromotionOpcode(SVT, RVT), dl, NVT, Op);
    return self.DAG.getNode(N.getOpcode(), dl, N.getValueType(0), Res, N.getOperand(1));
}

fn DAGTypeLegalizer::SoftPromoteHalfOp_CONVERT_TO_ARBITRARY_FP(self, N: *mut SDNode) -> SDValue {
    let mut RVT: EVT = N.getValueType(0);
    let mut Op: SDValue = N.getOperand(0);
    let mut SVT: EVT = Op.getValueType();
    let mut dl: SDLoc = SDLoc { N };
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), Op.getValueType());
    Op = self.GetSoftPromotedHalf(Op);
    let mut Res: SDValue = self.DAG.getNode(GetPromotionOpcode(SVT, RVT), dl, NVT, Op);
    return self.DAG.getNode(CONVERT_TO_ARBITRARY_FP, dl, N.getValueType(0), Res, N.getOperand(1), N.getOperand(2), N.getOperand(3));
}

fn DAGTypeLegalizer::SoftPromoteHalfOp_BR_CC(self, N: *mut SDNode) -> SDValue {
    let mut Op0: SDValue = N.getOperand(2);
    let mut Op1: SDValue = N.getOperand(3);
    let mut dl: SDLoc = SDLoc { N };
    let mut SVT: EVT = Op0.getValueType();
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), SVT);
    Op0 = self.GetSoftPromotedHalf(Op0);
    Op1 = self.GetSoftPromotedHalf(Op1);
    let mut PromotionOpcode: u32 = GetPromotionOpcode(SVT, NVT);
    Op0 = self.DAG.getNode(PromotionOpcode, dl, NVT, Op0);
    Op1 = self.DAG.getNode(PromotionOpcode, dl, NVT, Op1);
    return self.DAG.getNode(BR_CC, dl, EVT { Other }, N.getOperand(0), N.getOperand(1), Op0, Op1, N.getOperand(4));
}

fn DAGTypeLegalizer::SoftPromoteHalfOp_SELECT_CC(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 0, "Can only soften the comparison values");
    let mut Op0: SDValue = N.getOperand(0);
    let mut Op1: SDValue = N.getOperand(1);
    let mut dl: SDLoc = SDLoc { N };
    let mut SVT: EVT = Op0.getValueType();
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), SVT);
    Op0 = self.GetSoftPromotedHalf(Op0);
    Op1 = self.GetSoftPromotedHalf(Op1);
    let mut PromotionOpcode: NodeType = GetPromotionOpcode(SVT, NVT);
    Op0 = self.DAG.getNode(PromotionOpcode, dl, NVT, Op0);
    Op1 = self.DAG.getNode(PromotionOpcode, dl, NVT, Op1);
    return self.DAG.getNode(SELECT_CC, SDLoc { N }, N.getValueType(0), Op0, Op1, N.getOperand(2), N.getOperand(3), N.getOperand(4));
}

fn DAGTypeLegalizer::SoftPromoteHalfOp_SETCC(self, N: *mut SDNode) -> SDValue {
    let mut Op0: SDValue = N.getOperand(0);
    let mut Op1: SDValue = N.getOperand(1);
    let mut CCCode: CondCode = cast(N.getOperand(2)).get();
    let mut dl: SDLoc = SDLoc { N };
    let mut SVT: EVT = Op0.getValueType();
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), Op0.getValueType());
    Op0 = self.GetSoftPromotedHalf(Op0);
    Op1 = self.GetSoftPromotedHalf(Op1);
    let mut PromotionOpcode: NodeType = GetPromotionOpcode(SVT, NVT);
    Op0 = self.DAG.getNode(PromotionOpcode, dl, NVT, Op0);
    Op1 = self.DAG.getNode(PromotionOpcode, dl, NVT, Op1);
    return self.DAG.getSetCC(SDLoc { N }, N.getValueType(0), Op0, Op1, CCCode, SDValue {}, false, SDNodeFlags { Flags: None });
}

fn DAGTypeLegalizer::SoftPromoteHalfOp_STORE(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 1, "Can only soften the stored value!");
    let mut ST: *mut StoreSDNode = cast(N);
    let mut Val: SDValue = ST.getValue();
    let mut dl: SDLoc = SDLoc { N };
    assert!(!ST.isTruncatingStore(), "Unexpected truncating store.");
    let mut Promoted: SDValue = self.GetSoftPromotedHalf(Val);
    return self.DAG.getStore(ST.getChain(), dl, Promoted, ST.getBasePtr(), ST.getMemOperand());
}

fn DAGTypeLegalizer::SoftPromoteHalfOp_ATOMIC_STORE(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo == 1, "Can only soften the stored value!");
    let mut ST: *mut AtomicSDNode = cast(N);
    let mut Val: SDValue = ST.getVal();
    let mut dl: SDLoc = SDLoc { N };
    let mut Promoted: SDValue = self.GetSoftPromotedHalf(Val);
    return self.DAG.getAtomic(ATOMIC_STORE, dl, Promoted.getValueType(), ST.getChain(), Promoted, ST.getBasePtr(), ST.getMemOperand());
}

fn DAGTypeLegalizer::SoftPromoteHalfOp_STACKMAP(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo > 1);
    let mut NewOps: SmallVector<SDValue> = SmallVector<SDValue> { N.ops() };
    let mut Op: SDValue = N.getOperand(OpNo);
    NewOps[OpNo] = self.GetSoftPromotedHalf(Op);
    let mut NewNode: SDValue = self.DAG.getNode(N.getOpcode(), SDLoc { N }, N.getVTList(), ArrayRef<SDValue> { NewOps });
    for let mut ResNum: u32 = 0; ResNum < N.getNumValues(); ResNum += 1 {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: ResNum }, NewNode.getValue(ResNum));
    }
    return SDValue {};
}

fn DAGTypeLegalizer::SoftPromoteHalfOp_PATCHPOINT(self, N: *mut SDNode, OpNo: u32) -> SDValue {
    assert!(OpNo >= 7);
    let mut NewOps: SmallVector<SDValue> = SmallVector<SDValue> { N.ops() };
    let mut Op: SDValue = N.getOperand(OpNo);
    NewOps[OpNo] = self.GetSoftPromotedHalf(Op);
    let mut NewNode: SDValue = self.DAG.getNode(N.getOpcode(), SDLoc { N }, N.getVTList(), ArrayRef<SDValue> { NewOps });
    for let mut ResNum: u32 = 0; ResNum < N.getNumValues(); ResNum += 1 {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: ResNum }, NewNode.getValue(ResNum));
    }
    return SDValue {};
}

struct Closure_1 {
    cap_0: type,
    cap_1: *mut DAGTypeLegalizer,
    NVT: *mut EVT,
    DL: *mut SDLoc,
}

unsafe fn Closure_1::call(self: *mut Closure_1, StackSlot: SDValue) -> SDValue {
        let mut FrameIdx: i32 = cast(StackSlot).getIndex();
        let mut PtrInfo: MachinePointerInfo = getFixedStack(self.DAG.getMachineFunction(), FrameIdx, 0);
        return self.DAG.getLoad((*self.NVT), (*self.DL), SDValue { Chain }, StackSlot, PtrInfo, MaybeAlign {}, MONone, MMOMetadata {});
    }
