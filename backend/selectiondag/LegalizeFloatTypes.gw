fn DAGTypeLegalizer::ExpandFloatRes_FP_EXTEND(self, N: *mut SDNode, Lo: *mut SDValue, Hi: *mut SDValue) {
    let mut NVT: EVT = self.TLI.getTypeToTransformTo(*self.DAG.getContext(), N.getValueType(0));
    let mut dl: SDLoc = SDLoc { N };
    let mut IsStrict: bool = N.isStrictFPOpcode();
    let mut Chain: SDValue = SDValue {};
    if IsStrict {
        if NVT == N.getOperand(1).getValueType() {
            Hi = N.getOperand(1);
            Chain = N.getOperand(0);
        } else {
            Hi = self.DAG.getNode(STRICT_FP_EXTEND, dl, ArrayRef<EVT> { [NVT, EVT { Other }] }, ArrayRef<SDValue> { [N.getOperand(0), N.getOperand(1)] });
            Chain = Hi.getValue(1);
        }
    } else {
        Hi = self.DAG.getNode(FP_EXTEND, dl, NVT, N.getOperand(0));
    }
    Lo = self.DAG.getConstantFP(getZero(NVT.getFltSemantics(), false), dl, NVT, false);
    if IsStrict {
        self.ReplaceValueWith(SDValue { Node: N, ResNo: 1 }, Chain);
    }
}

