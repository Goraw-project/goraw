static mut NumNoops: Statistic = Statistic { "pre-RA-sched", "NumNoops", "Number of noops inserted" };

static mut NumStalls: Statistic = Statistic { "pre-RA-sched", "NumStalls", "Number of pipeline stalls" };

static mut VLIWScheduler: RegisterScheduler = RegisterScheduler { "vliw-td", "VLIW scheduler", createVLIWDAGScheduler };

struct ScheduleDAGVLIW {
    TM: *TargetMachine,
    TII: *TargetInstrInfo,
    TRI: *TargetRegisterInfo,
    MF: *mut MachineFunction,
    MRI: *mut MachineRegisterInfo,
    SUnits: []SUnit,
    EntrySU: SUnit,
    ExitSU: SUnit,
    StressSched: bool,
    BB: *mut MachineBasicBlock,
    DAG: *mut SelectionDAG,
    InstrItins: *InstrItineraryData,
    Sequence: []*mut SUnit,
    AvailableQueue: *mut SchedulingPriorityQueue,
    PendingQueue: []*mut SUnit,
    HazardRec: *mut ScheduleHazardRecognizer,
}

fn ScheduleDAGVLIW::ScheduleDAGVLIW(self, MF: *mut MachineFunction, AvailableQueue: *mut SchedulingPriorityQueue) {
    let mut STI: *TargetSubtargetInfo = MF.getSubtarget();
    self.HazardRec = STI.getInstrInfo().CreateTargetHazardRecognizer(&mut STI, self);
}

fn ScheduleDAGVLIW::~ScheduleDAGVLIW(self) {
    self.HazardRec;
    self.AvailableQueue;
}

fn ScheduleDAGVLIW::getInstrDesc(self: *ScheduleDAGVLIW, SU: *SUnit) -> *MCInstrDesc {
    if SU.isInstr() {
        return &mut SU.getInstr().getDesc();
    }
    return self.getNodeDesc(SU.getNode());
}

fn ScheduleDAGVLIW::addCustomGraphFeatures(self: *ScheduleDAGVLIW, arg: *mut GraphWriter<ScheduleDAG *>) {}

fn ScheduleDAGVLIW::isPassiveNode(self, Node: *mut SDNode) -> bool {
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if isa(Node) {
        return true;
    }
    if Node.getOpcode() == EntryToken || isa(Node) {
        return true;
    }
    return false;
}

fn ScheduleDAGVLIW::forceUnitLatencies(self: *ScheduleDAGVLIW) -> bool {
    return false;
}

fn ScheduleDAGVLIW::Schedule(self) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
            dbgs() << "********** List Scheduling " << printMBBReference(*self.BB) << " '" << self.BB.getName() << "' **********\n";
        }
    }
        if !(false) { break; }
    }
    self.BuildSchedGraph();
    self.AvailableQueue.initNodes(self.SUnits);
    self.listScheduleTopDown();
    self.AvailableQueue.releaseState();
}

fn ScheduleDAGVLIW::releaseSucc(self, SU: *mut SUnit, D: *SDep) {
    let mut SuccSU: *mut SUnit = D.getSUnit();
    if SuccSU.NumPredsLeft == 0 {
        dbgs() << "*** Scheduling failed! ***\n";
        self.dumpNode(*SuccSU);
        dbgs() << " has been released too many times!\n";
        llvm_unreachable_internal(null, "llvm\\lib\\CodeGen\\SelectionDAG\\ScheduleDAGVLIW.cpp", 113);
    }
    assert!(!D.isWeak(), "unexpected artificial DAG edge");
    SuccSU.NumPredsLeft -= 1;
    SuccSU.setDepthToAtLeast(SU.getDepth() + D.getLatency());
    if SuccSU.NumPredsLeft == 0 && SuccSU != &mut self.ExitSU {
        self.PendingQueue.push(SuccSU);
    }
}

fn ScheduleDAGVLIW::releaseSuccessors(self, SU: *mut SUnit) {
    for Succ in SU.Succs {
        assert!(!Succ.isAssignedRegDep(), "The list-td scheduler doesn't yet support physreg dependencies!");
        self.releaseSucc(SU, Succ);
    }
}

fn ScheduleDAGVLIW::scheduleNodeTopDown(self, SU: *mut SUnit, CurCycle: u32) {
    while true {
        {
        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
            dbgs() << "*** Scheduling [" << CurCycle << "]: ";
        }
    }
        if !(false) { break; }
    }
    while true {
        {
        if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
            self.dumpNode(*SU);
        }
    }
        if !(false) { break; }
    }
    self.Sequence.push(SU);
    assert!(CurCycle >= SU.getDepth(), "Node scheduled above its depth!");
    SU.setDepthToAtLeast(CurCycle);
    self.releaseSuccessors(SU);
    SU.isScheduled = true;
    self.AvailableQueue.scheduledNode(SU);
}

fn ScheduleDAGVLIW::listScheduleTopDown(self) {
    let mut CurCycle: u32 = 0;
    self.releaseSuccessors(&mut self.EntrySU);
    for SU in self.SUnits {
        if SU.Preds.len == 0 {
            self.AvailableQueue.push(&mut SU);
            SU.isAvailable = true;
        }
    }
    let mut NotReady: []*mut SUnit = []*mut SUnit {};
    self.Sequence.reserve(self.SUnits.len);
    while !self.AvailableQueue.is_empty() || !self.PendingQueue.is_empty() {
        for let mut i: u32 = 0;
let mut e: u32 = self.PendingQueue.len; i != e; i += 1 {
            if self.PendingQueue[i].getDepth() == CurCycle {
                self.AvailableQueue.push(self.PendingQueue[i]);
                self.PendingQueue[i].isAvailable = true;
                self.PendingQueue[i] = self.PendingQueue.back();
                self.PendingQueue.pop();
                i -= 1;
                e -= 1;
            } else {
                assert!(self.PendingQueue[i].getDepth() > CurCycle, "Negative latency?");
            }
        }
        if self.AvailableQueue.len == 0 {
            self.AvailableQueue.scheduledNode(null);
            CurCycle += 1;
            continue;
        }
        let mut FoundSUnit: *mut SUnit = null;
        let mut HasNoopHazards: bool = false;
        while !self.AvailableQueue.is_empty() {
            let mut CurSUnit: *mut SUnit = self.AvailableQueue.pop();
            let mut HT: HazardType = self.HazardRec.getHazardType(CurSUnit, 0);
            if HT == NoHazard {
                FoundSUnit = CurSUnit;
                break;
            }
            HasNoopHazards |= HT == NoopHazard;
            NotReady.push(CurSUnit);
        }
        if !NotReady.is_empty() {
            self.AvailableQueue.push_all(NotReady);
            NotReady.clear();
        }
        if FoundSUnit {
            self.scheduleNodeTopDown(FoundSUnit, CurCycle);
            self.HazardRec.EmitInstruction(FoundSUnit);
            if FoundSUnit.Latency {
                CurCycle += 1;
            }
        } else if !HasNoopHazards {
            while true {
                {
                if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                    dbgs() << "*** Advancing cycle, no work to do\n";
                }
            }
                if !(false) { break; }
            }
            self.HazardRec.AdvanceCycle();
            operator(NumStalls);
            CurCycle += 1;
        } else {
            while true {
                {
                if DebugFlag && isCurrentDebugType("pre-RA-sched", 1) {
                    dbgs() << "*** Emitting noop\n";
                }
            }
                if !(false) { break; }
            }
            self.HazardRec.EmitNoop();
            self.Sequence.push(null);
            operator(NumNoops);
            CurCycle += 1;
        }
    }
    self.VerifyScheduledSequence(false);
}

fn createVLIWDAGScheduler(IS: *mut SelectionDAGISel, arg: CodeGenOptLevel) -> *mut ScheduleDAGSDNodes {
    return ScheduleDAGVLIW { *IS.MF, ResourcePriorityQueue { IS } };
}
