// Goraw Standard Library: std/libc/string.gw
// Pure Goraw implementation of C Standard Library string functions.
// Sourced & adapted from LLVM-libc (Apache 2.0 with LLVM Exceptions).

import "mem.gw";

// Computes the length of the string s, up to, but not including the terminating null byte.
fn strlen(s: *const u8) -> i64 {
    if s == null {
        return 0;
    }
    let mut len: i64 = 0;
    while unsafe { s[len] != 0 } {
        len = len + 1;
    }
    return len;
}

// Determines the number of bytes in string s, up to maxlen.
fn strnlen(s: *const u8, maxlen: i64) -> i64 {
    if s == null || maxlen <= 0 {
        return 0;
    }
    let mut len: i64 = 0;
    while len < maxlen && unsafe { s[len] != 0 } {
        len = len + 1;
    }
    return len;
}

// Copies string src to dst including terminating null byte.
fn strcpy(dst: *mut u8, src: *const u8) -> *mut u8 {
    if dst == null || src == null {
        return dst;
    }
    let mut i: i64 = 0;
    while unsafe { src[i] != 0 } {
        unsafe {
            dst[i] = src[i];
        }
        i = i + 1;
    }
    unsafe {
        dst[i] = 0;
    }
    return dst;
}

// Copies at most n bytes of src to dst.
fn strncpy(dst: *mut u8, src: *const u8, n: i64) -> *mut u8 {
    if dst == null || src == null || n <= 0 {
        return dst;
    }
    let mut i: i64 = 0;
    while i < n && unsafe { src[i] != 0 } {
        unsafe {
            dst[i] = src[i];
        }
        i = i + 1;
    }
    while i < n {
        unsafe {
            dst[i] = 0;
        }
        i = i + 1;
    }
    return dst;
}

// Appends string src to dst.
fn strcat(dst: *mut u8, src: *const u8) -> *mut u8 {
    if dst == null || src == null {
        return dst;
    }
    let mut d: i64 = strlen(dst as *const u8);
    let mut s: i64 = 0;
    while unsafe { src[s] != 0 } {
        unsafe {
            dst[d] = src[s];
        }
        d = d + 1;
        s = s + 1;
    }
    unsafe {
        dst[d] = 0;
    }
    return dst;
}

// Appends at most n bytes of src to dst.
fn strncat(dst: *mut u8, src: *const u8, n: i64) -> *mut u8 {
    if dst == null || src == null || n <= 0 {
        return dst;
    }
    let mut d: i64 = strlen(dst as *const u8);
    let mut s: i64 = 0;
    while s < n && unsafe { src[s] != 0 } {
        unsafe {
            dst[d] = src[s];
        }
        d = d + 1;
        s = s + 1;
    }
    unsafe {
        dst[d] = 0;
    }
    return dst;
}

// Compares two strings s1 and s2.
fn strcmp(s1: *const u8, s2: *const u8) -> i32 {
    if s1 == s2 {
        return 0;
    }
    if s1 == null {
        return -1;
    }
    if s2 == null {
        return 1;
    }
    let mut i: i64 = 0;
    while true {
        let b1: u8 = unsafe { s1[i] };
        let b2: u8 = unsafe { s2[i] };
        if b1 != b2 {
            return (b1 as i32) - (b2 as i32);
        }
        if b1 == 0 {
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

// Compares at most n bytes of s1 and s2.
fn strncmp(s1: *const u8, s2: *const u8, n: i64) -> i32 {
    if n <= 0 || s1 == s2 {
        return 0;
    }
    if s1 == null {
        return -1;
    }
    if s2 == null {
        return 1;
    }
    let mut i: i64 = 0;
    while i < n {
        let b1: u8 = unsafe { s1[i] };
        let b2: u8 = unsafe { s2[i] };
        if b1 != b2 {
            return (b1 as i32) - (b2 as i32);
        }
        if b1 == 0 {
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

// Locates the first occurrence of c in s.
fn strchr(s: *const u8, c: i32) -> *const u8 {
    if s == null {
        return null;
    }
    let target: u8 = (c & 0xFF) as u8;
    let mut i: i64 = 0;
    while true {
        let b: u8 = unsafe { s[i] };
        if b == target {
            return unsafe { (s as i64 + i) as *const u8 };
        }
        if b == 0 {
            return null;
        }
        i = i + 1;
    }
    return null;
}

// Locates the last occurrence of c in s.
fn strrchr(s: *const u8, c: i32) -> *const u8 {
    if s == null {
        return null;
    }
    let target: u8 = (c & 0xFF) as u8;
    let mut last: *const u8 = null;
    let mut i: i64 = 0;
    while true {
        let b: u8 = unsafe { s[i] };
        if b == target {
            last = unsafe { (s as i64 + i) as *const u8 };
        }
        if b == 0 {
            break;
        }
        i = i + 1;
    }
    return last;
}

// Finds the first occurrence of the substring needle in haystack.
fn strstr(haystack: *const u8, needle: *const u8) -> *const u8 {
    if haystack == null || needle == null {
        return null;
    }
    if unsafe { needle[0] == 0 } {
        return haystack;
    }

    let n_len: i64 = strlen(needle);
    let mut h: i64 = 0;

    while unsafe { haystack[h] != 0 } {
        if unsafe { haystack[h] == needle[0] } {
            let mut match_ok: bool = true;
            let mut k: i64 = 1;
            while k < n_len {
                let hb: u8 = unsafe { haystack[h + k] };
                let nb: u8 = unsafe { needle[k] };
                if hb != nb {
                    match_ok = false;
                    break;
                }
                k = k + 1;
            }
            if match_ok {
                return unsafe { (haystack as i64 + h) as *const u8 };
            }
        }
        h = h + 1;
    }

    return null;
}

// Calculates length of initial segment of s consisting only of characters from accept.
fn strspn(s: *const u8, accept: *const u8) -> i64 {
    if s == null || accept == null {
        return 0;
    }
    let mut count: i64 = 0;
    while unsafe { s[count] != 0 } {
        let ch: i32 = unsafe { s[count] } as i32;
        if strchr(accept, ch) == null {
            break;
        }
        count = count + 1;
    }
    return count;
}

// Calculates length of initial segment of s consisting of characters NOT in reject.
fn strcspn(s: *const u8, reject: *const u8) -> i64 {
    if s == null || reject == null {
        return 0;
    }
    let mut count: i64 = 0;
    while unsafe { s[count] != 0 } {
        let ch: i32 = unsafe { s[count] } as i32;
        if strchr(reject, ch) != null {
            break;
        }
        count = count + 1;
    }
    return count;
}

// Locates the first occurrence in s of any character from accept.
fn strpbrk(s: *const u8, accept: *const u8) -> *const u8 {
    if s == null || accept == null {
        return null;
    }
    let mut i: i64 = 0;
    while unsafe { s[i] != 0 } {
        let ch: i32 = unsafe { s[i] } as i32;
        if strchr(accept, ch) != null {
            return unsafe { (s as i64 + i) as *const u8 };
        }
        i = i + 1;
    }
    return null;
}
