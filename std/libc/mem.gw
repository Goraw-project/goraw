// Goraw Standard Library: std/libc/mem.gw
// Pure Goraw implementation of C Standard Library memory primitives.
// Sourced & adapted from LLVM-libc (Apache 2.0 with LLVM Exceptions).

// Copies n bytes from memory area src to memory area dst.
// Uses fast 64-bit word chunking when possible.
fn memcpy(dst: *mut u8, src: *const u8, n: i64) -> *mut u8 {
    if dst == null || src == null || n <= 0 {
        return dst;
    }

    let mut i: i64 = 0;

    // 8-byte word copies for bulk data
    let words: i64 = n / 8;
    let mut d64: *mut u64 = dst as *mut u64;
    let mut s64: *const u64 = src as *const u64;
    let mut w: i64 = 0;
    while w < words {
        unsafe {
            d64[w] = s64[w];
        }
        w = w + 1;
    }
    i = words * 8;

    // Remaining trailing bytes
    while i < n {
        unsafe {
            dst[i] = src[i];
        }
        i = i + 1;
    }

    return dst;
}

// Copies n bytes from src to dst, correctly handling overlapping regions.
fn memmove(dst: *mut u8, src: *const u8, n: i64) -> *mut u8 {
    if dst == null || src == null || n <= 0 || (dst as i64) == (src as i64) {
        return dst;
    }

    let d_addr: i64 = dst as i64;
    let s_addr: i64 = src as i64;

    if d_addr < s_addr {
        // Forward copy
        return memcpy(dst, src, n);
    } else {
        // Backward copy to avoid overwriting source
        let mut i: i64 = n;
        while i > 0 {
            i = i - 1;
            unsafe {
                dst[i] = src[i];
            }
        }
    }

    return dst;
}

// Fills the first n bytes of the memory area pointed to by dst with constant byte c.
fn memset(dst: *mut u8, c: i32, n: i64) -> *mut u8 {
    if dst == null || n <= 0 {
        return dst;
    }

    let byte_val: u8 = (c & 0xFF) as u8;
    let mut i: i64 = 0;

    // Replicate byte across 64-bit word
    let b: u64 = byte_val as u64;
    let word_val: u64 = b | (b << 8) | (b << 16) | (b << 24) | (b << 32) | (b << 40) | (b << 48) | (b << 56);

    let words: i64 = n / 8;
    let mut d64: *mut u64 = dst as *mut u64;
    let mut w: i64 = 0;
    while w < words {
        unsafe {
            d64[w] = word_val;
        }
        w = w + 1;
    }
    i = words * 8;

    while i < n {
        unsafe {
            dst[i] = byte_val;
        }
        i = i + 1;
    }

    return dst;
}

// Compares the first n bytes of the memory areas s1 and s2.
fn memcmp(s1: *const u8, s2: *const u8, n: i64) -> i32 {
    if s1 == null || s2 == null || n <= 0 {
        return 0;
    }

    let mut i: i64 = 0;
    while i < n {
        let b1: u8 = unsafe { s1[i] };
        let b2: u8 = unsafe { s2[i] };
        if b1 != b2 {
            return (b1 as i32) - (b2 as i32);
        }
        i = i + 1;
    }

    return 0;
}

// Locates the first occurrence of c in the initial n bytes of s.
fn memchr(s: *const u8, c: i32, n: i64) -> *const u8 {
    if s == null || n <= 0 {
        return null;
    }

    let target: u8 = (c & 0xFF) as u8;
    let mut i: i64 = 0;
    while i < n {
        let b: u8 = unsafe { s[i] };
        if b == target {
            return unsafe { (s as i64 + i) as *const u8 };
        }
        i = i + 1;
    }

    return null;
}

// Erases n bytes from dst with zeros.
fn bzero(dst: *mut u8, n: i64) {
    memset(dst, 0, n);
}

// Byte comparison alias.
fn bcmp(s1: *const u8, s2: *const u8, n: i64) -> i32 {
    return memcmp(s1, s2, n);
}
