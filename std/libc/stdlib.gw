// Goraw Standard Library: std/libc/stdlib.gw
// Pure Goraw implementation of C Standard Library utility functions.
// Sourced & adapted from LLVM-libc (Apache 2.0 with LLVM Exceptions).

import "mem.gw";
import "string.gw";

// Global PRNG state for rand/srand (Linear Congruential Generator as in LLVM-libc)
let mut __libc_rand_seed: u64 = 1;

// Absolute value of a 32-bit integer.
fn abs(x: i32) -> i32 {
    if x < 0 {
        return -x;
    }
    return x;
}

// Absolute value of a 64-bit integer.
fn labs(x: i64) -> i64 {
    if x < 0 {
        return -x;
    }
    return x;
}

// Converts the initial portion of string s to an integer.
fn atoi(s: *const u8) -> i32 {
    return atol(s) as i32;
}

// Converts the initial portion of string s to a 64-bit integer.
fn atol(s: *const u8) -> i64 {
    if s == null {
        return 0;
    }
    let mut i: i64 = 0;
    // Skip whitespace
    while unsafe { s[i] == 32 || (s[i] >= 9 && s[i] <= 13) } {
        i = i + 1;
    }

    let mut sign: i64 = 1;
    if unsafe { s[i] == 45 } { // '-'
        sign = -1;
        i = i + 1;
    } else if unsafe { s[i] == 43 } { // '+'
        i = i + 1;
    }

    let mut result: i64 = 0;
    while unsafe { s[i] >= 48 && s[i] <= 57 } { // '0' .. '9'
        let digit: i64 = (unsafe { s[i] } - 48) as i64;
        result = result * 10 + digit;
        i = i + 1;
    }

    return result * sign;
}

// Seeds the pseudo-random number generator.
fn srand(seed: u32) {
    __libc_rand_seed = seed as u64;
}

// Returns a pseudo-random integer in the range [0, 32767].
fn rand() -> i32 {
    // POSIX / LLVM-libc standard LCG: next = next * 1103515245 + 12345
    __libc_rand_seed = (__libc_rand_seed * 1103515245 + 12345) & 0x7FFFFFFF;
    return ((__libc_rand_seed >> 16) & 0x7FFF) as i32;
}

// Binary search implementation conforming to C standard bsearch.
fn bsearch(
    key: *const u8,
    base: *const u8,
    num: i64,
    size: i64,
    compar: fn(*const u8, *const u8) -> i32
) -> *const u8 {
    if key == null || base == null || num <= 0 || size <= 0 {
        return null;
    }

    let mut low: i64 = 0;
    let mut high: i64 = num - 1;

    while low <= high {
        let mid: i64 = low + (high - low) / 2;
        let mid_elem: *const u8 = unsafe { (base as i64 + mid * size) as *const u8 };
        let cmp: i32 = compar(key, mid_elem);

        if cmp == 0 {
            return mid_elem;
        } else if cmp < 0 {
            high = mid - 1;
        } else {
            low = mid + 1;
        }
    }

    return null;
}

// In-place QuickSort adapted from LLVM-libc quick_sort.h.
fn qsort(
    base: *mut u8,
    num: i64,
    size: i64,
    compar: fn(*const u8, *const u8) -> i32
) {
    if base == null || num <= 1 || size <= 0 {
        return;
    }

    let mut temp: [u8; 256] = [0; 256];
    let t_ptr: *mut u8 = temp.as_mut_ptr();

    __qsort_recursive(base, 0, num - 1, size, compar, t_ptr);
}

fn __qsort_swap(a: *mut u8, b: *mut u8, size: i64, temp: *mut u8) {
    if a == b {
        return;
    }
    memcpy(temp, a as *const u8, size);
    memcpy(a, b as *const u8, size);
    memcpy(b, temp as *const u8, size);
}

fn __qsort_recursive(
    base: *mut u8,
    left: i64,
    right: i64,
    size: i64,
    compar: fn(*const u8, *const u8) -> i32,
    temp: *mut u8
) {
    if left >= right {
        return;
    }

    let pivot_idx: i64 = left + (right - left) / 2;
    let pivot_ptr: *mut u8 = unsafe { (base as i64 + pivot_idx * size) as *mut u8 };
    let right_ptr: *mut u8 = unsafe { (base as i64 + right * size) as *mut u8 };

    __qsort_swap(pivot_ptr, right_ptr, size, temp);

    let mut store_idx: i64 = left;
    let mut i: i64 = left;
    while i < right {
        let cur_elem: *const u8 = unsafe { (base as i64 + i * size) as *const u8 };
        if compar(cur_elem, right_ptr as *const u8) < 0 {
            let store_ptr: *mut u8 = unsafe { (base as i64 + store_idx * size) as *mut u8 };
            __qsort_swap(cur_elem as *mut u8, store_ptr, size, temp);
            store_idx = store_idx + 1;
        }
        i = i + 1;
    }

    let store_final: *mut u8 = unsafe { (base as i64 + store_idx * size) as *mut u8 };
    __qsort_swap(right_ptr, store_final, size, temp);

    if store_idx > left + 1 {
        __qsort_recursive(base, left, store_idx - 1, size, compar, temp);
    }
    if store_idx + 1 < right {
        __qsort_recursive(base, store_idx + 1, right, size, compar, temp);
    }
}
