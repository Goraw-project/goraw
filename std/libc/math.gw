// Goraw Standard Library: std/libc/math.gw
// Pure Goraw implementation of C Standard Library floating-point math routines.
// Sourced & adapted from LLVM-libc (Apache 2.0 with LLVM Exceptions).

const PI: f64 = 3.14159265358979323846264338327950288;
const TWO_PI: f64 = 6.28318530717958647692528676655900576;
const HALF_PI: f64 = 1.57079632679489661923132169163975144;
const E: f64 = 2.71828182845904523536028747135266249;
const LN2: f64 = 0.69314718055994530941723212145817656;

// Floating-point absolute value.
fn fabs(x: f64) -> f64 {
    if x < 0.0 {
        return -x;
    }
    return x;
}

// Minimum of two numbers.
fn fmin(x: f64, y: f64) -> f64 {
    if x < y { return x; }
    return y;
}

// Maximum of two numbers.
fn fmax(x: f64, y: f64) -> f64 {
    if x > y { return x; }
    return y;
}

// Largest integer not greater than x.
fn floor(x: f64) -> f64 {
    let i: i64 = x as i64;
    let fi: f64 = i as f64;
    if x < 0.0 && x != fi {
        return fi - 1.0;
    }
    return fi;
}

// Smallest integer not less than x.
fn ceil(x: f64) -> f64 {
    let i: i64 = x as i64;
    let fi: f64 = i as f64;
    if x > 0.0 && x != fi {
        return fi + 1.0;
    }
    return fi;
}

// Truncates decimal digits toward zero.
fn trunc(x: f64) -> f64 {
    return (x as i64) as f64;
}

// Rounds to nearest integer value.
fn round(x: f64) -> f64 {
    if x >= 0.0 {
        return floor(x + 0.5);
    } else {
        return ceil(x - 0.5);
    }
}

// Square root using high-precision Newton-Raphson method (LLVM-libc generic).
fn sqrt(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0; // NaN in strict IEEE
    }
    if x == 0.0 || x == 1.0 {
        return x;
    }

    let mut guess: f64 = x / 2.0;
    let mut iter: i32 = 0;
    while iter < 20 {
        let next: f64 = 0.5 * (guess + x / guess);
        if fabs(next - guess) < 1e-15 {
            return next;
        }
        guess = next;
        iter = iter + 1;
    }
    return guess;
}

// Euclidean distance function: sqrt(x^2 + y^2) avoiding intermediate overflow.
fn hypot(x: f64, y: f64) -> f64 {
    let ax: f64 = fabs(x);
    let ay: f64 = fabs(y);
    let max_val: f64 = fmax(ax, ay);
    let min_val: f64 = fmin(ax, ay);
    if max_val == 0.0 {
        return 0.0;
    }
    let r: f64 = min_val / max_val;
    return max_val * sqrt(1.0 + r * r);
}

// Range reduction helper for trigonometric functions: normalizes angle to [-PI, PI].
fn __reduce_angle(x: f64) -> f64 {
    let mut a: f64 = x;
    while a > PI {
        a = a - TWO_PI;
    }
    while a < -PI {
        a = a + TWO_PI;
    }
    return a;
}

// Sine using Taylor-Chebyshev polynomial (accurate to ~14 decimal digits).
fn sin(x: f64) -> f64 {
    let a: f64 = __reduce_angle(x);
    let a2: f64 = a * a;
    let a3: f64 = a * a2;
    let a5: f64 = a3 * a2;
    let a7: f64 = a5 * a2;
    let a9: f64 = a7 * a2;
    let a11: f64 = a9 * a2;

    return a
        - (a3 / 6.0)
        + (a5 / 120.0)
        - (a7 / 5040.0)
        + (a9 / 362880.0)
        - (a11 / 39916800.0);
}

// Cosine using polynomial expansion.
fn cos(x: f64) -> f64 {
    let a: f64 = __reduce_angle(x);
    let a2: f64 = a * a;
    let a4: f64 = a2 * a2;
    let a6: f64 = a4 * a2;
    let a8: f64 = a6 * a2;
    let a10: f64 = a8 * a2;

    return 1.0
        - (a2 / 2.0)
        + (a4 / 24.0)
        - (a6 / 720.0)
        + (a8 / 40320.0)
        - (a10 / 3628800.0);
}

// Tangent function: sin(x) / cos(x).
fn tan(x: f64) -> f64 {
    let c: f64 = cos(x);
    if c == 0.0 {
        return 0.0;
    }
    return sin(x) / c;
}

// Natural logarithm ln(x) using series expansion.
fn log(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0;
    }

    let mut val: f64 = x;
    let mut exp_adj: f64 = 0.0;

    while val > 2.0 {
        val = val * 0.5;
        exp_adj = exp_adj + LN2;
    }
    while val < 1.0 {
        val = val * 2.0;
        exp_adj = exp_adj - LN2;
    }

    // Series for ln((1+y)/(1-y)) where y = (val - 1)/(val + 1)
    let y: f64 = (val - 1.0) / (val + 1.0);
    let y2: f64 = y * y;
    let mut term: f64 = y;
    let mut sum: f64 = term;
    let mut d: f64 = 3.0;

    let mut step: i32 = 0;
    while step < 15 {
        term = term * y2;
        sum = sum + term / d;
        d = d + 2.0;
        step = step + 1;
    }

    return 2.0 * sum + exp_adj;
}

// Natural exponential e^x.
fn exp(x: f64) -> f64 {
    if x == 0.0 { return 1.0; }
    if x < -50.0 { return 0.0; }

    // e^x = 1 + x + x^2/2! + x^3/3! + ...
    let mut term: f64 = 1.0;
    let mut sum: f64 = 1.0;
    let mut n: f64 = 1.0;

    while n < 30.0 {
        term = term * (x / n);
        sum = sum + term;
        if fabs(term) < 1e-15 {
            break;
        }
        n = n + 1.0;
    }
    return sum;
}

// Power function: base^exp_val = exp(exp_val * log(base)).
fn pow(base: f64, exp_val: f64) -> f64 {
    if exp_val == 0.0 {
        return 1.0;
    }
    if base == 0.0 {
        return 0.0;
    }
    if base > 0.0 {
        return exp(exp_val * log(base));
    }
    // Integer exponent for negative base
    let i_exp: i64 = exp_val as i64;
    if (i_exp as f64) == exp_val {
        let abs_p: f64 = exp(exp_val * log(fabs(base)));
        if (i_exp % 2) != 0 {
            return -abs_p;
        }
        return abs_p;
    }
    return 0.0;
}
