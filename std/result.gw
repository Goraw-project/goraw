// Goraw Standard Library: std/result.gw
// Result<T, E> and Option<T> error and optional handling abstractions.

struct Result<T, E> {
    is_ok: bool,
    value: T,
    error: E,
}

fn Result<T, E>::ok(val: T) -> Result<T, E> {
    let mut err_dummy: E = zeroed();
    return Result {
        is_ok: true,
        value: val,
        error: err_dummy,
    };
}

fn Result<T, E>::err(err: E) -> Result<T, E> {
    let mut val_dummy: T = zeroed();
    return Result {
        is_ok: false,
        value: val_dummy,
        error: err,
    };
}

fn Result<T, E>::is_ok(self) -> bool {
    return self.is_ok;
}

fn Result<T, E>::is_err(self) -> bool {
    return !self.is_ok;
}

fn Result<T, E>::unwrap(self) -> T {
    if !self.is_ok {
        panic("called Result::unwrap on an Err value");
    }
    return self.value;
}

fn Result<T, E>::unwrap_err(self) -> E {
    if self.is_ok {
        panic("called Result::unwrap_err on an Ok value");
    }
    return self.error;
}

struct Option<T> {
    is_some: bool,
    value: T,
}

fn Option<T>::some(val: T) -> Option<T> {
    return Option {
        is_some: true,
        value: val,
    };
}

fn Option<T>::none() -> Option<T> {
    let mut val_dummy: T = zeroed();
    return Option {
        is_some: false,
        value: val_dummy,
    };
}

fn Option<T>::is_some(self) -> bool {
    return self.is_some;
}

fn Option<T>::is_none(self) -> bool {
    return !self.is_some;
}

fn Option<T>::unwrap(self) -> T {
    if !self.is_some {
        panic("called Option::unwrap on a None value");
    }
    return self.value;
}
