// Goraw Standard Library: std/box.gw
// Generic smart pointer on the heap with automatic RAII deterministic destruction.

extern fn malloc(size: i64) -> *mut u8;
extern fn free(ptr: *mut u8);

struct Box<T> {
    ptr: *mut T,
}

fn Box<T>::new(val: T) -> Box<T> {
    let elem_sz: i64 = 8;
    let p = malloc(elem_sz) as *mut T;
    unsafe {
        *p = val;
    }
    return Box { ptr: p };
}

fn Box<T>::get(self) -> T {
    let mut val: T = zeroed();
    unsafe {
        val = *self.ptr;
    }
    return val;
}

fn Box<T>::set(self, val: T) {
    unsafe {
        *self.ptr = val;
    }
}

fn Box<T>::drop(self) {
    if self.ptr != null {
        free(self.ptr as *mut u8);
        self.ptr = null;
    }
}
