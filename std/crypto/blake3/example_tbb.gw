// Внешние системные функции libc
extern fn printf(fmt: *u8, ...) -> i32;

fn main() -> i32 {
    for let mut i: i32 = 1; i < argc; i += 1 {
        let mut fd: i32 = open(argv[i], 0);
        if fd == -1 {
            fprintf((__acrt_iob_func(2)), "open failed: %s\n", strerror((*_errno())));
            return 1;
        }
        let mut statbuf: stat = stat {};
        if fstat(fd, &mut statbuf) == -1 {
            fprintf((__acrt_iob_func(2)), "stat failed: %s\n", strerror((*_errno())));
            return 1;
        }
        let mut mapped: *mut void = mmap(0, statbuf.st_size, fd, 0);
        if  {
            fprintf((__acrt_iob_func(2)), "mmap failed: %s\n", strerror((*_errno())));
            return 1;
        }
        let mut hasher: blake3_hasher = blake3_hasher {};
        blake3_hasher_init(&mut hasher);
        blake3_hasher_update_tbb(&mut hasher, mapped, statbuf.st_size);
        if munmap(mapped, statbuf.st_size) == -1 {
            fprintf((__acrt_iob_func(2)), "munmap failed: %s\n", strerror((*_errno())));
            return 1;
        }
        if close(fd) == -1 {
            fprintf((__acrt_iob_func(2)), "close failed: %s\n", strerror((*_errno())));
            return 1;
        }
        let mut output: [32]u8 = zeroed();
        blake3_hasher_finalize(&mut hasher, output, 32);
        for let mut i: u64 = 0; i < 32; i += 1 {
            printf("%02x", output[i]);
        }
        printf("\n");
    }
}
