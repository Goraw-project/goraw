// Внешние системные функции libc
extern fn memcpy(dest: *mut u8, src: *u8, n: u64) -> *mut u8;

fn loadu_128(src: *u8) -> __m128i {
    return _mm_loadu_si128(src as *mut void);
}

fn loadu_256(src: *u8) -> __m256i {
    return _mm256_loadu_si256(src as *mut void);
}

fn loadu_512(src: *u8) -> __m512i {
    return _mm512_loadu_epi32(src as *mut void);
}

fn storeu_128(src: __m128i, dest: *mut u8) {
    _mm_storeu_si128(dest as *mut void, src);
}

fn storeu_256(src: __m256i, dest: *mut u8) {
    _mm256_storeu_si256(dest as *mut void, src);
}

fn storeu_512(src: __m512i, dest: *mut u8) {
    _mm512_storeu_epi32(dest as *mut void, src);
}

fn add_128(a: __m128i, b: __m128i) -> __m128i {
    return _mm_add_epi32(a, b);
}

fn add_256(a: __m256i, b: __m256i) -> __m256i {
    return _mm256_add_epi32(a, b);
}

fn add_512(a: __m512i, b: __m512i) -> __m512i {
    return _mm512_add_epi32(a, b);
}

fn xor_128(a: __m128i, b: __m128i) -> __m128i {
    return _mm_xor_si128(a, b);
}

fn xor_256(a: __m256i, b: __m256i) -> __m256i {
    return _mm256_xor_si256(a, b);
}

fn xor_512(a: __m512i, b: __m512i) -> __m512i {
    return _mm512_xor_epi32(a, b);
}

fn set1_128(x: u32) -> __m128i {
    return _mm_set1_epi32(x as i32);
}

fn set1_256(x: u32) -> __m256i {
    return _mm256_set1_epi32(x as i32);
}

fn set1_512(x: u32) -> __m512i {
    return _mm512_set1_epi32(x as i32);
}

fn set4(a: u32, b: u32, c: u32, d: u32) -> __m128i {
    return _mm_setr_epi32(a as i32, b as i32, c as i32, d as i32);
}

fn rot16_128(x: __m128i) -> __m128i {
    return _mm_ror_epi32(x, 16);
}

fn rot16_256(x: __m256i) -> __m256i {
    return _mm256_ror_epi32(x, 16);
}

fn rot16_512(x: __m512i) -> __m512i {
    return _mm512_ror_epi32(x, 16);
}

fn rot12_128(x: __m128i) -> __m128i {
    return _mm_ror_epi32(x, 12);
}

fn rot12_256(x: __m256i) -> __m256i {
    return _mm256_ror_epi32(x, 12);
}

fn rot12_512(x: __m512i) -> __m512i {
    return _mm512_ror_epi32(x, 12);
}

fn rot8_128(x: __m128i) -> __m128i {
    return _mm_ror_epi32(x, 8);
}

fn rot8_256(x: __m256i) -> __m256i {
    return _mm256_ror_epi32(x, 8);
}

fn rot8_512(x: __m512i) -> __m512i {
    return _mm512_ror_epi32(x, 8);
}

fn rot7_128(x: __m128i) -> __m128i {
    return _mm_ror_epi32(x, 7);
}

fn rot7_256(x: __m256i) -> __m256i {
    return _mm256_ror_epi32(x, 7);
}

fn rot7_512(x: __m512i) -> __m512i {
    return _mm512_ror_epi32(x, 7);
}

fn g1(row0: *mut __m128i, row1: *mut __m128i, row2: *mut __m128i, row3: *mut __m128i, m: __m128i) {
    *row0 = add_128(add_128(*row0, m), *row1);
    *row3 = xor_128(*row3, *row0);
    *row3 = rot16_128(*row3);
    *row2 = add_128(*row2, *row3);
    *row1 = xor_128(*row1, *row2);
    *row1 = rot12_128(*row1);
}

fn g2(row0: *mut __m128i, row1: *mut __m128i, row2: *mut __m128i, row3: *mut __m128i, m: __m128i) {
    *row0 = add_128(add_128(*row0, m), *row1);
    *row3 = xor_128(*row3, *row0);
    *row3 = rot8_128(*row3);
    *row2 = add_128(*row2, *row3);
    *row1 = xor_128(*row1, *row2);
    *row1 = rot7_128(*row1);
}

fn diagonalize(row0: *mut __m128i, row2: *mut __m128i, row3: *mut __m128i) {
    *row0 = _mm_shuffle_epi32(*row0, (((2) << 6) | ((1) << 4) | ((0) << 2) | ((3))));
    *row3 = _mm_shuffle_epi32(*row3, (((1) << 6) | ((0) << 4) | ((3) << 2) | ((2))));
    *row2 = _mm_shuffle_epi32(*row2, (((0) << 6) | ((3) << 4) | ((2) << 2) | ((1))));
}

fn undiagonalize(row0: *mut __m128i, row2: *mut __m128i, row3: *mut __m128i) {
    *row0 = _mm_shuffle_epi32(*row0, (((0) << 6) | ((3) << 4) | ((2) << 2) | ((1))));
    *row3 = _mm_shuffle_epi32(*row3, (((1) << 6) | ((0) << 4) | ((3) << 2) | ((2))));
    *row2 = _mm_shuffle_epi32(*row2, (((2) << 6) | ((1) << 4) | ((0) << 2) | ((3))));
}

fn compress_pre(rows: *mut __m128i, cv: *u32, block: *u8, block_len: u8, counter: u64, flags: u8) {
    rows[0] = loadu_128(&mut cv[0] as *mut u8);
    rows[1] = loadu_128(&mut cv[4] as *mut u8);
    rows[2] = set4(IV[0], IV[1], IV[2], IV[3]);
    rows[3] = set4(counter_low(counter), counter_high(counter), block_len as u32, flags as u32);
    let mut m0: __m128i = loadu_128(&mut block[ * 0]);
    let mut m1: __m128i = loadu_128(&mut block[ * 1]);
    let mut m2: __m128i = loadu_128(&mut block[ * 2]);
    let mut m3: __m128i = loadu_128(&mut block[ * 3]);
    let mut t0: __m128i = __m128i {};
    let mut t1: __m128i = __m128i {};
    let mut t2: __m128i = __m128i {};
    let mut t3: __m128i = __m128i {};
    let mut tt: __m128i = __m128i {};
    t0 = (_mm_castps_si128(_mm_shuffle_ps(_mm_castsi128_ps(m0), _mm_castsi128_ps(m1), ((((2) << 6) | ((0) << 4) | ((2) << 2) | ((0)))))));
    g1(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t0);
    t1 = (_mm_castps_si128(_mm_shuffle_ps(_mm_castsi128_ps(m0), _mm_castsi128_ps(m1), ((((3) << 6) | ((1) << 4) | ((3) << 2) | ((1)))))));
    g2(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t1);
    diagonalize(&mut rows[0], &mut rows[2], &mut rows[3]);
    t2 = (_mm_castps_si128(_mm_shuffle_ps(_mm_castsi128_ps(m2), _mm_castsi128_ps(m3), ((((2) << 6) | ((0) << 4) | ((2) << 2) | ((0)))))));
    t2 = _mm_shuffle_epi32(t2, (((2) << 6) | ((1) << 4) | ((0) << 2) | ((3))));
    g1(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t2);
    t3 = (_mm_castps_si128(_mm_shuffle_ps(_mm_castsi128_ps(m2), _mm_castsi128_ps(m3), ((((3) << 6) | ((1) << 4) | ((3) << 2) | ((1)))))));
    t3 = _mm_shuffle_epi32(t3, (((2) << 6) | ((1) << 4) | ((0) << 2) | ((3))));
    g2(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t3);
    undiagonalize(&mut rows[0], &mut rows[2], &mut rows[3]);
    m0 = t0;
    m1 = t1;
    m2 = t2;
    m3 = t3;
    t0 = (_mm_castps_si128(_mm_shuffle_ps(_mm_castsi128_ps(m0), _mm_castsi128_ps(m1), ((((3) << 6) | ((1) << 4) | ((1) << 2) | ((2)))))));
    t0 = _mm_shuffle_epi32(t0, (((0) << 6) | ((3) << 4) | ((2) << 2) | ((1))));
    g1(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t0);
    t1 = (_mm_castps_si128(_mm_shuffle_ps(_mm_castsi128_ps(m2), _mm_castsi128_ps(m3), ((((3) << 6) | ((3) << 4) | ((2) << 2) | ((2)))))));
    tt = _mm_shuffle_epi32(m0, (((0) << 6) | ((0) << 4) | ((3) << 2) | ((3))));
    t1 = _mm_blend_epi16(tt, t1, 204);
    g2(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t1);
    diagonalize(&mut rows[0], &mut rows[2], &mut rows[3]);
    t2 = _mm_unpacklo_epi64(m3, m1);
    tt = _mm_blend_epi16(t2, m2, 192);
    t2 = _mm_shuffle_epi32(tt, (((1) << 6) | ((3) << 4) | ((2) << 2) | ((0))));
    g1(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t2);
    t3 = _mm_unpackhi_epi32(m1, m3);
    tt = _mm_unpacklo_epi32(m2, t3);
    t3 = _mm_shuffle_epi32(tt, (((0) << 6) | ((1) << 4) | ((3) << 2) | ((2))));
    g2(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t3);
    undiagonalize(&mut rows[0], &mut rows[2], &mut rows[3]);
    m0 = t0;
    m1 = t1;
    m2 = t2;
    m3 = t3;
    t0 = (_mm_castps_si128(_mm_shuffle_ps(_mm_castsi128_ps(m0), _mm_castsi128_ps(m1), ((((3) << 6) | ((1) << 4) | ((1) << 2) | ((2)))))));
    t0 = _mm_shuffle_epi32(t0, (((0) << 6) | ((3) << 4) | ((2) << 2) | ((1))));
    g1(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t0);
    t1 = (_mm_castps_si128(_mm_shuffle_ps(_mm_castsi128_ps(m2), _mm_castsi128_ps(m3), ((((3) << 6) | ((3) << 4) | ((2) << 2) | ((2)))))));
    tt = _mm_shuffle_epi32(m0, (((0) << 6) | ((0) << 4) | ((3) << 2) | ((3))));
    t1 = _mm_blend_epi16(tt, t1, 204);
    g2(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t1);
    diagonalize(&mut rows[0], &mut rows[2], &mut rows[3]);
    t2 = _mm_unpacklo_epi64(m3, m1);
    tt = _mm_blend_epi16(t2, m2, 192);
    t2 = _mm_shuffle_epi32(tt, (((1) << 6) | ((3) << 4) | ((2) << 2) | ((0))));
    g1(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t2);
    t3 = _mm_unpackhi_epi32(m1, m3);
    tt = _mm_unpacklo_epi32(m2, t3);
    t3 = _mm_shuffle_epi32(tt, (((0) << 6) | ((1) << 4) | ((3) << 2) | ((2))));
    g2(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t3);
    undiagonalize(&mut rows[0], &mut rows[2], &mut rows[3]);
    m0 = t0;
    m1 = t1;
    m2 = t2;
    m3 = t3;
    t0 = (_mm_castps_si128(_mm_shuffle_ps(_mm_castsi128_ps(m0), _mm_castsi128_ps(m1), ((((3) << 6) | ((1) << 4) | ((1) << 2) | ((2)))))));
    t0 = _mm_shuffle_epi32(t0, (((0) << 6) | ((3) << 4) | ((2) << 2) | ((1))));
    g1(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t0);
    t1 = (_mm_castps_si128(_mm_shuffle_ps(_mm_castsi128_ps(m2), _mm_castsi128_ps(m3), ((((3) << 6) | ((3) << 4) | ((2) << 2) | ((2)))))));
    tt = _mm_shuffle_epi32(m0, (((0) << 6) | ((0) << 4) | ((3) << 2) | ((3))));
    t1 = _mm_blend_epi16(tt, t1, 204);
    g2(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t1);
    diagonalize(&mut rows[0], &mut rows[2], &mut rows[3]);
    t2 = _mm_unpacklo_epi64(m3, m1);
    tt = _mm_blend_epi16(t2, m2, 192);
    t2 = _mm_shuffle_epi32(tt, (((1) << 6) | ((3) << 4) | ((2) << 2) | ((0))));
    g1(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t2);
    t3 = _mm_unpackhi_epi32(m1, m3);
    tt = _mm_unpacklo_epi32(m2, t3);
    t3 = _mm_shuffle_epi32(tt, (((0) << 6) | ((1) << 4) | ((3) << 2) | ((2))));
    g2(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t3);
    undiagonalize(&mut rows[0], &mut rows[2], &mut rows[3]);
    m0 = t0;
    m1 = t1;
    m2 = t2;
    m3 = t3;
    t0 = (_mm_castps_si128(_mm_shuffle_ps(_mm_castsi128_ps(m0), _mm_castsi128_ps(m1), ((((3) << 6) | ((1) << 4) | ((1) << 2) | ((2)))))));
    t0 = _mm_shuffle_epi32(t0, (((0) << 6) | ((3) << 4) | ((2) << 2) | ((1))));
    g1(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t0);
    t1 = (_mm_castps_si128(_mm_shuffle_ps(_mm_castsi128_ps(m2), _mm_castsi128_ps(m3), ((((3) << 6) | ((3) << 4) | ((2) << 2) | ((2)))))));
    tt = _mm_shuffle_epi32(m0, (((0) << 6) | ((0) << 4) | ((3) << 2) | ((3))));
    t1 = _mm_blend_epi16(tt, t1, 204);
    g2(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t1);
    diagonalize(&mut rows[0], &mut rows[2], &mut rows[3]);
    t2 = _mm_unpacklo_epi64(m3, m1);
    tt = _mm_blend_epi16(t2, m2, 192);
    t2 = _mm_shuffle_epi32(tt, (((1) << 6) | ((3) << 4) | ((2) << 2) | ((0))));
    g1(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t2);
    t3 = _mm_unpackhi_epi32(m1, m3);
    tt = _mm_unpacklo_epi32(m2, t3);
    t3 = _mm_shuffle_epi32(tt, (((0) << 6) | ((1) << 4) | ((3) << 2) | ((2))));
    g2(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t3);
    undiagonalize(&mut rows[0], &mut rows[2], &mut rows[3]);
    m0 = t0;
    m1 = t1;
    m2 = t2;
    m3 = t3;
    t0 = (_mm_castps_si128(_mm_shuffle_ps(_mm_castsi128_ps(m0), _mm_castsi128_ps(m1), ((((3) << 6) | ((1) << 4) | ((1) << 2) | ((2)))))));
    t0 = _mm_shuffle_epi32(t0, (((0) << 6) | ((3) << 4) | ((2) << 2) | ((1))));
    g1(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t0);
    t1 = (_mm_castps_si128(_mm_shuffle_ps(_mm_castsi128_ps(m2), _mm_castsi128_ps(m3), ((((3) << 6) | ((3) << 4) | ((2) << 2) | ((2)))))));
    tt = _mm_shuffle_epi32(m0, (((0) << 6) | ((0) << 4) | ((3) << 2) | ((3))));
    t1 = _mm_blend_epi16(tt, t1, 204);
    g2(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t1);
    diagonalize(&mut rows[0], &mut rows[2], &mut rows[3]);
    t2 = _mm_unpacklo_epi64(m3, m1);
    tt = _mm_blend_epi16(t2, m2, 192);
    t2 = _mm_shuffle_epi32(tt, (((1) << 6) | ((3) << 4) | ((2) << 2) | ((0))));
    g1(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t2);
    t3 = _mm_unpackhi_epi32(m1, m3);
    tt = _mm_unpacklo_epi32(m2, t3);
    t3 = _mm_shuffle_epi32(tt, (((0) << 6) | ((1) << 4) | ((3) << 2) | ((2))));
    g2(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t3);
    undiagonalize(&mut rows[0], &mut rows[2], &mut rows[3]);
    m0 = t0;
    m1 = t1;
    m2 = t2;
    m3 = t3;
    t0 = (_mm_castps_si128(_mm_shuffle_ps(_mm_castsi128_ps(m0), _mm_castsi128_ps(m1), ((((3) << 6) | ((1) << 4) | ((1) << 2) | ((2)))))));
    t0 = _mm_shuffle_epi32(t0, (((0) << 6) | ((3) << 4) | ((2) << 2) | ((1))));
    g1(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t0);
    t1 = (_mm_castps_si128(_mm_shuffle_ps(_mm_castsi128_ps(m2), _mm_castsi128_ps(m3), ((((3) << 6) | ((3) << 4) | ((2) << 2) | ((2)))))));
    tt = _mm_shuffle_epi32(m0, (((0) << 6) | ((0) << 4) | ((3) << 2) | ((3))));
    t1 = _mm_blend_epi16(tt, t1, 204);
    g2(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t1);
    diagonalize(&mut rows[0], &mut rows[2], &mut rows[3]);
    t2 = _mm_unpacklo_epi64(m3, m1);
    tt = _mm_blend_epi16(t2, m2, 192);
    t2 = _mm_shuffle_epi32(tt, (((1) << 6) | ((3) << 4) | ((2) << 2) | ((0))));
    g1(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t2);
    t3 = _mm_unpackhi_epi32(m1, m3);
    tt = _mm_unpacklo_epi32(m2, t3);
    t3 = _mm_shuffle_epi32(tt, (((0) << 6) | ((1) << 4) | ((3) << 2) | ((2))));
    g2(&mut rows[0], &mut rows[1], &mut rows[2], &mut rows[3], t3);
    undiagonalize(&mut rows[0], &mut rows[2], &mut rows[3]);
}

fn blake3_compress_xof_avx512(cv: *u32, block: *u8, block_len: u8, counter: u64, flags: u8, out: *mut u8) {
    let mut rows: [4]__m128i = [4]__m128i {};
    compress_pre(rows, cv, block, block_len, counter, flags);
    storeu_128(xor_128(rows[0], rows[2]), &mut out[0]);
    storeu_128(xor_128(rows[1], rows[3]), &mut out[16]);
    storeu_128(xor_128(rows[2], loadu_128(&mut cv[0] as *mut u8)), &mut out[32]);
    storeu_128(xor_128(rows[3], loadu_128(&mut cv[4] as *mut u8)), &mut out[48]);
}

fn blake3_compress_in_place_avx512(cv: *mut u32, block: *u8, block_len: u8, counter: u64, flags: u8) {
    let mut rows: [4]__m128i = [4]__m128i {};
    compress_pre(rows, cv, block, block_len, counter, flags);
    storeu_128(xor_128(rows[0], rows[2]), &mut cv[0] as *mut u8);
    storeu_128(xor_128(rows[1], rows[3]), &mut cv[4] as *mut u8);
}

fn round_fn4(v: *mut __m128i, m: *mut __m128i, r: u64) {
    v[0] = add_128(v[0], m[MSG_SCHEDULE[r][0] as u64]);
    v[1] = add_128(v[1], m[MSG_SCHEDULE[r][2] as u64]);
    v[2] = add_128(v[2], m[MSG_SCHEDULE[r][4] as u64]);
    v[3] = add_128(v[3], m[MSG_SCHEDULE[r][6] as u64]);
    v[0] = add_128(v[0], v[4]);
    v[1] = add_128(v[1], v[5]);
    v[2] = add_128(v[2], v[6]);
    v[3] = add_128(v[3], v[7]);
    v[12] = xor_128(v[12], v[0]);
    v[13] = xor_128(v[13], v[1]);
    v[14] = xor_128(v[14], v[2]);
    v[15] = xor_128(v[15], v[3]);
    v[12] = rot16_128(v[12]);
    v[13] = rot16_128(v[13]);
    v[14] = rot16_128(v[14]);
    v[15] = rot16_128(v[15]);
    v[8] = add_128(v[8], v[12]);
    v[9] = add_128(v[9], v[13]);
    v[10] = add_128(v[10], v[14]);
    v[11] = add_128(v[11], v[15]);
    v[4] = xor_128(v[4], v[8]);
    v[5] = xor_128(v[5], v[9]);
    v[6] = xor_128(v[6], v[10]);
    v[7] = xor_128(v[7], v[11]);
    v[4] = rot12_128(v[4]);
    v[5] = rot12_128(v[5]);
    v[6] = rot12_128(v[6]);
    v[7] = rot12_128(v[7]);
    v[0] = add_128(v[0], m[MSG_SCHEDULE[r][1] as u64]);
    v[1] = add_128(v[1], m[MSG_SCHEDULE[r][3] as u64]);
    v[2] = add_128(v[2], m[MSG_SCHEDULE[r][5] as u64]);
    v[3] = add_128(v[3], m[MSG_SCHEDULE[r][7] as u64]);
    v[0] = add_128(v[0], v[4]);
    v[1] = add_128(v[1], v[5]);
    v[2] = add_128(v[2], v[6]);
    v[3] = add_128(v[3], v[7]);
    v[12] = xor_128(v[12], v[0]);
    v[13] = xor_128(v[13], v[1]);
    v[14] = xor_128(v[14], v[2]);
    v[15] = xor_128(v[15], v[3]);
    v[12] = rot8_128(v[12]);
    v[13] = rot8_128(v[13]);
    v[14] = rot8_128(v[14]);
    v[15] = rot8_128(v[15]);
    v[8] = add_128(v[8], v[12]);
    v[9] = add_128(v[9], v[13]);
    v[10] = add_128(v[10], v[14]);
    v[11] = add_128(v[11], v[15]);
    v[4] = xor_128(v[4], v[8]);
    v[5] = xor_128(v[5], v[9]);
    v[6] = xor_128(v[6], v[10]);
    v[7] = xor_128(v[7], v[11]);
    v[4] = rot7_128(v[4]);
    v[5] = rot7_128(v[5]);
    v[6] = rot7_128(v[6]);
    v[7] = rot7_128(v[7]);
    v[0] = add_128(v[0], m[MSG_SCHEDULE[r][8] as u64]);
    v[1] = add_128(v[1], m[MSG_SCHEDULE[r][10] as u64]);
    v[2] = add_128(v[2], m[MSG_SCHEDULE[r][12] as u64]);
    v[3] = add_128(v[3], m[MSG_SCHEDULE[r][14] as u64]);
    v[0] = add_128(v[0], v[5]);
    v[1] = add_128(v[1], v[6]);
    v[2] = add_128(v[2], v[7]);
    v[3] = add_128(v[3], v[4]);
    v[15] = xor_128(v[15], v[0]);
    v[12] = xor_128(v[12], v[1]);
    v[13] = xor_128(v[13], v[2]);
    v[14] = xor_128(v[14], v[3]);
    v[15] = rot16_128(v[15]);
    v[12] = rot16_128(v[12]);
    v[13] = rot16_128(v[13]);
    v[14] = rot16_128(v[14]);
    v[10] = add_128(v[10], v[15]);
    v[11] = add_128(v[11], v[12]);
    v[8] = add_128(v[8], v[13]);
    v[9] = add_128(v[9], v[14]);
    v[5] = xor_128(v[5], v[10]);
    v[6] = xor_128(v[6], v[11]);
    v[7] = xor_128(v[7], v[8]);
    v[4] = xor_128(v[4], v[9]);
    v[5] = rot12_128(v[5]);
    v[6] = rot12_128(v[6]);
    v[7] = rot12_128(v[7]);
    v[4] = rot12_128(v[4]);
    v[0] = add_128(v[0], m[MSG_SCHEDULE[r][9] as u64]);
    v[1] = add_128(v[1], m[MSG_SCHEDULE[r][11] as u64]);
    v[2] = add_128(v[2], m[MSG_SCHEDULE[r][13] as u64]);
    v[3] = add_128(v[3], m[MSG_SCHEDULE[r][15] as u64]);
    v[0] = add_128(v[0], v[5]);
    v[1] = add_128(v[1], v[6]);
    v[2] = add_128(v[2], v[7]);
    v[3] = add_128(v[3], v[4]);
    v[15] = xor_128(v[15], v[0]);
    v[12] = xor_128(v[12], v[1]);
    v[13] = xor_128(v[13], v[2]);
    v[14] = xor_128(v[14], v[3]);
    v[15] = rot8_128(v[15]);
    v[12] = rot8_128(v[12]);
    v[13] = rot8_128(v[13]);
    v[14] = rot8_128(v[14]);
    v[10] = add_128(v[10], v[15]);
    v[11] = add_128(v[11], v[12]);
    v[8] = add_128(v[8], v[13]);
    v[9] = add_128(v[9], v[14]);
    v[5] = xor_128(v[5], v[10]);
    v[6] = xor_128(v[6], v[11]);
    v[7] = xor_128(v[7], v[8]);
    v[4] = xor_128(v[4], v[9]);
    v[5] = rot7_128(v[5]);
    v[6] = rot7_128(v[6]);
    v[7] = rot7_128(v[7]);
    v[4] = rot7_128(v[4]);
}

fn transpose_vecs_128(vecs: *mut __m128i) {
    let mut ab_01: __m128i = _mm_unpacklo_epi32(vecs[0], vecs[1]);
    let mut ab_23: __m128i = _mm_unpackhi_epi32(vecs[0], vecs[1]);
    let mut cd_01: __m128i = _mm_unpacklo_epi32(vecs[2], vecs[3]);
    let mut cd_23: __m128i = _mm_unpackhi_epi32(vecs[2], vecs[3]);
    let mut abcd_0: __m128i = _mm_unpacklo_epi64(ab_01, cd_01);
    let mut abcd_1: __m128i = _mm_unpackhi_epi64(ab_01, cd_01);
    let mut abcd_2: __m128i = _mm_unpacklo_epi64(ab_23, cd_23);
    let mut abcd_3: __m128i = _mm_unpackhi_epi64(ab_23, cd_23);
    vecs[0] = abcd_0;
    vecs[1] = abcd_1;
    vecs[2] = abcd_2;
    vecs[3] = abcd_3;
}

fn transpose_msg_vecs4(inputs: *uint8_t *const, block_offset: u64, out: *mut __m128i) {
    out[0] = loadu_128(&mut inputs[0][block_offset + 0 * ]);
    out[1] = loadu_128(&mut inputs[1][block_offset + 0 * ]);
    out[2] = loadu_128(&mut inputs[2][block_offset + 0 * ]);
    out[3] = loadu_128(&mut inputs[3][block_offset + 0 * ]);
    out[4] = loadu_128(&mut inputs[0][block_offset + 1 * ]);
    out[5] = loadu_128(&mut inputs[1][block_offset + 1 * ]);
    out[6] = loadu_128(&mut inputs[2][block_offset + 1 * ]);
    out[7] = loadu_128(&mut inputs[3][block_offset + 1 * ]);
    out[8] = loadu_128(&mut inputs[0][block_offset + 2 * ]);
    out[9] = loadu_128(&mut inputs[1][block_offset + 2 * ]);
    out[10] = loadu_128(&mut inputs[2][block_offset + 2 * ]);
    out[11] = loadu_128(&mut inputs[3][block_offset + 2 * ]);
    out[12] = loadu_128(&mut inputs[0][block_offset + 3 * ]);
    out[13] = loadu_128(&mut inputs[1][block_offset + 3 * ]);
    out[14] = loadu_128(&mut inputs[2][block_offset + 3 * ]);
    out[15] = loadu_128(&mut inputs[3][block_offset + 3 * ]);
    for let mut i: u64 = 0; i < 4; i += 1 {
        _mm_prefetch(&mut inputs[i][block_offset + 256] as *void, 1);
    }
    transpose_vecs_128(&mut out[0]);
    transpose_vecs_128(&mut out[4]);
    transpose_vecs_128(&mut out[8]);
    transpose_vecs_128(&mut out[12]);
}

fn load_counters4(counter: u64, increment_counter: bool, out_lo: *mut __m128i, out_hi: *mut __m128i) {
    let mut mask: u64 = (if increment_counter { ~0 } else { 0 });
    let mut mask_vec: __m256i = _mm256_set1_epi64x(mask);
    let mut deltas: __m256i = _mm256_setr_epi64x(0, 1, 2, 3);
    deltas = _mm256_and_si256(mask_vec, deltas);
    let mut counters: __m256i = _mm256_add_epi64(_mm256_set1_epi64x(counter as i64), deltas);
    *out_lo = _mm256_cvtepi64_epi32(counters);
    *out_hi = _mm256_cvtepi64_epi32(_mm256_srli_epi64(counters, 32));
}

fn blake3_hash4_avx512(inputs: *uint8_t *const, blocks: u64, key: *u32, counter: u64, increment_counter: bool, flags: u8, flags_start: u8, flags_end: u8, out: *mut u8) {
    let mut h_vecs: [8]__m128i = [set1_128(key[0]), set1_128(key[1]), set1_128(key[2]), set1_128(key[3]), set1_128(key[4]), set1_128(key[5]), set1_128(key[6]), set1_128(key[7])];
    let mut counter_low_vec: __m128i = __m128i {};
    let mut counter_high_vec: __m128i = __m128i {};
    load_counters4(counter, increment_counter, &mut counter_low_vec, &mut counter_high_vec);
    let mut block_flags: u8 = flags | flags_start;
    for let mut block: u64 = 0; block < blocks; block += 1 {
        if block + 1 == blocks {
            block_flags |= flags_end;
        }
        let mut block_len_vec: __m128i = set1_128(64);
        let mut block_flags_vec: __m128i = set1_128(block_flags);
        let mut msg_vecs: [16]__m128i = [16]__m128i {};
        transpose_msg_vecs4(inputs, block * 64, msg_vecs);
        let mut v: [16]__m128i = [h_vecs[0], h_vecs[1], h_vecs[2], h_vecs[3], h_vecs[4], h_vecs[5], h_vecs[6], h_vecs[7], set1_128(IV[0]), set1_128(IV[1]), set1_128(IV[2]), set1_128(IV[3]), counter_low_vec, counter_high_vec, block_len_vec, block_flags_vec];
        round_fn4(v, msg_vecs, 0);
        round_fn4(v, msg_vecs, 1);
        round_fn4(v, msg_vecs, 2);
        round_fn4(v, msg_vecs, 3);
        round_fn4(v, msg_vecs, 4);
        round_fn4(v, msg_vecs, 5);
        round_fn4(v, msg_vecs, 6);
        h_vecs[0] = xor_128(v[0], v[8]);
        h_vecs[1] = xor_128(v[1], v[9]);
        h_vecs[2] = xor_128(v[2], v[10]);
        h_vecs[3] = xor_128(v[3], v[11]);
        h_vecs[4] = xor_128(v[4], v[12]);
        h_vecs[5] = xor_128(v[5], v[13]);
        h_vecs[6] = xor_128(v[6], v[14]);
        h_vecs[7] = xor_128(v[7], v[15]);
        block_flags = flags;
    }
    transpose_vecs_128(&mut h_vecs[0]);
    transpose_vecs_128(&mut h_vecs[4]);
    storeu_128(h_vecs[0], &mut out[0 * ]);
    storeu_128(h_vecs[4], &mut out[1 * ]);
    storeu_128(h_vecs[1], &mut out[2 * ]);
    storeu_128(h_vecs[5], &mut out[3 * ]);
    storeu_128(h_vecs[2], &mut out[4 * ]);
    storeu_128(h_vecs[6], &mut out[5 * ]);
    storeu_128(h_vecs[3], &mut out[6 * ]);
    storeu_128(h_vecs[7], &mut out[7 * ]);
}

fn blake3_xof4_avx512(cv: *u32, block: *u8, block_len: u8, counter: u64, flags: u8, out: *mut u8) {
    let mut h_vecs: [8]__m128i = [set1_128(cv[0]), set1_128(cv[1]), set1_128(cv[2]), set1_128(cv[3]), set1_128(cv[4]), set1_128(cv[5]), set1_128(cv[6]), set1_128(cv[7])];
    let mut block_words: [16]u32 = zeroed();
    load_block_words(block, block_words);
    let mut msg_vecs: [16]__m128i = [16]__m128i {};
    for let mut i: u64 = 0; i < 16; i += 1 {
        msg_vecs[i] = set1_128(block_words[i]);
    }
    let mut counter_low_vec: __m128i = __m128i {};
    let mut counter_high_vec: __m128i = __m128i {};
    load_counters4(counter, true, &mut counter_low_vec, &mut counter_high_vec);
    let mut block_len_vec: __m128i = set1_128(block_len);
    let mut block_flags_vec: __m128i = set1_128(flags);
    let mut v: [16]__m128i = [h_vecs[0], h_vecs[1], h_vecs[2], h_vecs[3], h_vecs[4], h_vecs[5], h_vecs[6], h_vecs[7], set1_128(IV[0]), set1_128(IV[1]), set1_128(IV[2]), set1_128(IV[3]), counter_low_vec, counter_high_vec, block_len_vec, block_flags_vec];
    round_fn4(v, msg_vecs, 0);
    round_fn4(v, msg_vecs, 1);
    round_fn4(v, msg_vecs, 2);
    round_fn4(v, msg_vecs, 3);
    round_fn4(v, msg_vecs, 4);
    round_fn4(v, msg_vecs, 5);
    round_fn4(v, msg_vecs, 6);
    for let mut i: u64 = 0; i < 8; i += 1 {
        v[i] = xor_128(v[i], v[i + 8]);
        v[i + 8] = xor_128(v[i + 8], h_vecs[i]);
    }
    transpose_vecs_128(&mut v[0]);
    transpose_vecs_128(&mut v[4]);
    transpose_vecs_128(&mut v[8]);
    transpose_vecs_128(&mut v[12]);
    for let mut i: u64 = 0; i < 4; i += 1 {
        storeu_128(v[i + 0], &mut out[(4 * i + 0) * ]);
        storeu_128(v[i + 4], &mut out[(4 * i + 1) * ]);
        storeu_128(v[i + 8], &mut out[(4 * i + 2) * ]);
        storeu_128(v[i + 12], &mut out[(4 * i + 3) * ]);
    }
}

fn round_fn8(v: *mut __m256i, m: *mut __m256i, r: u64) {
    v[0] = add_256(v[0], m[MSG_SCHEDULE[r][0] as u64]);
