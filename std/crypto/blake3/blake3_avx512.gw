    v[7] = rot12_256(v[7]);
    v[0] = add_256(v[0], m[MSG_SCHEDULE[r][1] as u64]);
    v[1] = add_256(v[1], m[MSG_SCHEDULE[r][3] as u64]);
    v[2] = add_256(v[2], m[MSG_SCHEDULE[r][5] as u64]);
    v[3] = add_256(v[3], m[MSG_SCHEDULE[r][7] as u64]);
    v[0] = add_256(v[0], v[4]);
    v[1] = add_256(v[1], v[5]);
    v[2] = add_256(v[2], v[6]);
    v[3] = add_256(v[3], v[7]);
