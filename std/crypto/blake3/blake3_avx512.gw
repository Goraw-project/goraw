    v[13] = xor_256(v[13], v[1]);
    v[14] = xor_256(v[14], v[2]);
    v[15] = xor_256(v[15], v[3]);
    v[12] = rot8_256(v[12]);
    v[13] = rot8_256(v[13]);
    v[14] = rot8_256(v[14]);
    v[15] = rot8_256(v[15]);
    v[8] = add_256(v[8], v[12]);
    v[9] = add_256(v[9], v[13]);
    v[10] = add_256(v[10], v[14]);
    v[11] = add_256(v[11], v[15]);
    v[4] = xor_256(v[4], v[8]);
    v[5] = xor_256(v[5], v[9]);
    v[6] = xor_256(v[6], v[10]);
    v[7] = xor_256(v[7], v[11]);
    v[4] = rot7_256(v[4]);
    v[5] = rot7_256(v[5]);
    v[6] = rot7_256(v[6]);
    v[7] = rot7_256(v[7]);
    v[0] = add_256(v[0], m[MSG_SCHEDULE[r][8] as u64]);
    v[1] = add_256(v[1], m[MSG_SCHEDULE[r][10] as u64]);
    v[2] = add_256(v[2], m[MSG_SCHEDULE[r][12] as u64]);
    v[3] = add_256(v[3], m[MSG_SCHEDULE[r][14] as u64]);
    v[0] = add_256(v[0], v[5]);
    v[1] = add_256(v[1], v[6]);
    v[2] = add_256(v[2], v[7]);
    v[3] = add_256(v[3], v[4]);
    v[15] = xor_256(v[15], v[0]);
    v[12] = xor_256(v[12], v[1]);
    v[13] = xor_256(v[13], v[2]);
    v[14] = xor_256(v[14], v[3]);
    v[15] = rot16_256(v[15]);
    v[12] = rot16_256(v[12]);
    v[13] = rot16_256(v[13]);
    v[14] = rot16_256(v[14]);
    v[10] = add_256(v[10], v[15]);
    v[11] = add_256(v[11], v[12]);
    v[8] = add_256(v[8], v[13]);
    v[9] = add_256(v[9], v[14]);
    v[5] = xor_256(v[5], v[10]);
    v[6] = xor_256(v[6], v[11]);
    v[7] = xor_256(v[7], v[8]);
    v[4] = xor_256(v[4], v[9]);
    v[5] = rot12_256(v[5]);
    v[6] = rot12_256(v[6]);
    v[7] = rot12_256(v[7]);
    v[4] = rot12_256(v[4]);
    v[0] = add_256(v[0], m[MSG_SCHEDULE[r][9] as u64]);
    v[1] = add_256(v[1], m[MSG_SCHEDULE[r][11] as u64]);
    v[2] = add_256(v[2], m[MSG_SCHEDULE[r][13] as u64]);
