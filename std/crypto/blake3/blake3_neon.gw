// Внешние системные функции libc
extern fn memcpy(dest: *mut u8, src: *u8, n: u64) -> *mut u8;

fn loadu_128(src: *u8) -> uint32x4_t {
    return ((__neon_Q1Adr(4095740431, __uint8ToN64_c(src))));
}

fn storeu_128(src: uint32x4_t, dest: *mut u8) {
    (__neon_AdrQ1(4093643279, __uint8ToN64(dest), ((src))));
}

fn add_128(a: uint32x4_t, b: uint32x4_t) -> uint32x4_t {
    return (__neon_QdQnQm(4062185536, (a), (b)));
}

fn xor_128(a: uint32x4_t, b: uint32x4_t) -> uint32x4_t {
    return (__neon_QdQnQm(4076863824, (a), (b)));
}

fn set1_128(x: u32) -> uint32x4_t {
    return (__neon_Q1Adr(4104129711, __uint32ToN64_c(&mut x)));
}

fn set4(a: u32, b: u32, c: u32, d: u32) -> uint32x4_t {
    let mut array: [4]u32 = [a, b, c, d];
    return (__neon_Q1Adr(4095740559, __uint32ToN64_c(array)));
}

fn rot16_128(x: uint32x4_t) -> uint32x4_t {
    return ((__neon_QdQm(4088660160, ((x)))));
}

fn rot12_128(x: uint32x4_t) -> uint32x4_t {
    return (__static_assert((12) >= 1 && (12) <= 32, "invalid shift amount") , __neon_QdQm_acc(4087350352 | (((32 - (12)) << 16) & 2031616), ((__static_assert((32 - 12) >= 0 && (32 - 12) < 32, "invalid shift amount") , __neon_QdQm(4070573392 | (((32 - 12) << 16) & 2031616), (x)))), (x)));
}

fn rot8_128(x: uint32x4_t) -> uint32x4_t {
    return (__builtin_shufflevector((x), (x), 1, 2, 3, 0, 5, 6, 7, 4, 9, 10, 11, 8, 13, 14, 15, 12));
}

fn rot7_128(x: uint32x4_t) -> uint32x4_t {
    return (__static_assert((7) >= 1 && (7) <= 32, "invalid shift amount") , __neon_QdQm_acc(4087350352 | (((32 - (7)) << 16) & 2031616), ((__static_assert((32 - 7) >= 0 && (32 - 7) < 32, "invalid shift amount") , __neon_QdQm(4070573392 | (((32 - 7) << 16) & 2031616), (x)))), (x)));
}

fn round_fn4(v: *mut uint32x4_t, m: *mut uint32x4_t, r: u64) {
    v[0] = add_128(v[0], m[MSG_SCHEDULE[r][0] as u64]);
    v[1] = add_128(v[1], m[MSG_SCHEDULE[r][2] as u64]);
    v[2] = add_128(v[2], m[MSG_SCHEDULE[r][4] as u64]);
    v[3] = add_128(v[3], m[MSG_SCHEDULE[r][6] as u64]);
    v[0] = add_128(v[0], v[4]);
    v[1] = add_128(v[1], v[5]);
    v[2] = add_128(v[2], v[6]);
    v[3] = add_128(v[3], v[7]);
    v[12] = xor_128(v[12], v[0]);
    v[13] = xor_128(v[13], v[1]);
    v[14] = xor_128(v[14], v[2]);
    v[15] = xor_128(v[15], v[3]);
    v[12] = rot16_128(v[12]);
    v[13] = rot16_128(v[13]);
    v[14] = rot16_128(v[14]);
    v[15] = rot16_128(v[15]);
    v[8] = add_128(v[8], v[12]);
    v[9] = add_128(v[9], v[13]);
    v[10] = add_128(v[10], v[14]);
    v[11] = add_128(v[11], v[15]);
    v[4] = xor_128(v[4], v[8]);
    v[5] = xor_128(v[5], v[9]);
    v[6] = xor_128(v[6], v[10]);
    v[7] = xor_128(v[7], v[11]);
    v[4] = rot12_128(v[4]);
    v[5] = rot12_128(v[5]);
    v[6] = rot12_128(v[6]);
    v[7] = rot12_128(v[7]);
    v[0] = add_128(v[0], m[MSG_SCHEDULE[r][1] as u64]);
    v[1] = add_128(v[1], m[MSG_SCHEDULE[r][3] as u64]);
    v[2] = add_128(v[2], m[MSG_SCHEDULE[r][5] as u64]);
    v[3] = add_128(v[3], m[MSG_SCHEDULE[r][7] as u64]);
    v[0] = add_128(v[0], v[4]);
    v[1] = add_128(v[1], v[5]);
    v[2] = add_128(v[2], v[6]);
    v[3] = add_128(v[3], v[7]);
    v[12] = xor_128(v[12], v[0]);
    v[13] = xor_128(v[13], v[1]);
    v[14] = xor_128(v[14], v[2]);
    v[15] = xor_128(v[15], v[3]);
    v[12] = rot8_128(v[12]);
    v[13] = rot8_128(v[13]);
    v[14] = rot8_128(v[14]);
    v[15] = rot8_128(v[15]);
    v[8] = add_128(v[8], v[12]);
    v[9] = add_128(v[9], v[13]);
    v[10] = add_128(v[10], v[14]);
    v[11] = add_128(v[11], v[15]);
    v[4] = xor_128(v[4], v[8]);
    v[5] = xor_128(v[5], v[9]);
    v[6] = xor_128(v[6], v[10]);
    v[7] = xor_128(v[7], v[11]);
    v[4] = rot7_128(v[4]);
    v[5] = rot7_128(v[5]);
    v[6] = rot7_128(v[6]);
    v[7] = rot7_128(v[7]);
    v[0] = add_128(v[0], m[MSG_SCHEDULE[r][8] as u64]);
    v[1] = add_128(v[1], m[MSG_SCHEDULE[r][10] as u64]);
    v[2] = add_128(v[2], m[MSG_SCHEDULE[r][12] as u64]);
    v[3] = add_128(v[3], m[MSG_SCHEDULE[r][14] as u64]);
    v[0] = add_128(v[0], v[5]);
    v[1] = add_128(v[1], v[6]);
    v[2] = add_128(v[2], v[7]);
    v[3] = add_128(v[3], v[4]);
    v[15] = xor_128(v[15], v[0]);
    v[12] = xor_128(v[12], v[1]);
    v[13] = xor_128(v[13], v[2]);
    v[14] = xor_128(v[14], v[3]);
    v[15] = rot16_128(v[15]);
    v[12] = rot16_128(v[12]);
    v[13] = rot16_128(v[13]);
    v[14] = rot16_128(v[14]);
    v[10] = add_128(v[10], v[15]);
    v[11] = add_128(v[11], v[12]);
    v[8] = add_128(v[8], v[13]);
    v[9] = add_128(v[9], v[14]);
    v[5] = xor_128(v[5], v[10]);
    v[6] = xor_128(v[6], v[11]);
    v[7] = xor_128(v[7], v[8]);
    v[4] = xor_128(v[4], v[9]);
    v[5] = rot12_128(v[5]);
    v[6] = rot12_128(v[6]);
    v[7] = rot12_128(v[7]);
    v[4] = rot12_128(v[4]);
    v[0] = add_128(v[0], m[MSG_SCHEDULE[r][9] as u64]);
    v[1] = add_128(v[1], m[MSG_SCHEDULE[r][11] as u64]);
    v[2] = add_128(v[2], m[MSG_SCHEDULE[r][13] as u64]);
    v[3] = add_128(v[3], m[MSG_SCHEDULE[r][15] as u64]);
    v[0] = add_128(v[0], v[5]);
    v[1] = add_128(v[1], v[6]);
    v[2] = add_128(v[2], v[7]);
    v[3] = add_128(v[3], v[4]);
    v[15] = xor_128(v[15], v[0]);
    v[12] = xor_128(v[12], v[1]);
    v[13] = xor_128(v[13], v[2]);
    v[14] = xor_128(v[14], v[3]);
    v[15] = rot8_128(v[15]);
    v[12] = rot8_128(v[12]);
    v[13] = rot8_128(v[13]);
    v[14] = rot8_128(v[14]);
    v[10] = add_128(v[10], v[15]);
    v[11] = add_128(v[11], v[12]);
    v[8] = add_128(v[8], v[13]);
    v[9] = add_128(v[9], v[14]);
    v[5] = xor_128(v[5], v[10]);
    v[6] = xor_128(v[6], v[11]);
    v[7] = xor_128(v[7], v[8]);
    v[4] = xor_128(v[4], v[9]);
    v[5] = rot7_128(v[5]);
    v[6] = rot7_128(v[6]);
    v[7] = rot7_128(v[7]);
    v[4] = rot7_128(v[4]);
}

fn transpose_vecs_128(vecs: *mut uint32x4_t) {
    let mut rows01: uint32x4x2_t = (__neon_QdQm_acc2(4089053376, (vecs[0]), (vecs[1])));
    let mut rows23: uint32x4x2_t = (__neon_QdQm_acc2(4089053376, (vecs[2]), (vecs[3])));
    vecs[0] = (__neon_QdDnDm_merge(0, ((__neon_DdQm_low(0, (rows01.val[0])))), ((__neon_DdQm_low(0, (rows23.val[0]))))));
    vecs[1] = (__neon_QdDnDm_merge(0, ((__neon_DdQm_low(0, (rows01.val[1])))), ((__neon_DdQm_low(0, (rows23.val[1]))))));
    vecs[2] = (__neon_QdDnDm_merge(0, ((__neon_DdQm_high(0, (rows01.val[0])))), ((__neon_DdQm_high(0, (rows23.val[0]))))));
    vecs[3] = (__neon_QdDnDm_merge(0, ((__neon_DdQm_high(0, (rows01.val[1])))), ((__neon_DdQm_high(0, (rows23.val[1]))))));
}

fn transpose_msg_vecs4(inputs: *uint8_t *const, block_offset: u64, out: *mut uint32x4_t) {
    out[0] = loadu_128(&mut inputs[0][block_offset + 0 * ]);
    out[1] = loadu_128(&mut inputs[1][block_offset + 0 * ]);
    out[2] = loadu_128(&mut inputs[2][block_offset + 0 * ]);
    out[3] = loadu_128(&mut inputs[3][block_offset + 0 * ]);
    out[4] = loadu_128(&mut inputs[0][block_offset + 1 * ]);
    out[5] = loadu_128(&mut inputs[1][block_offset + 1 * ]);
    out[6] = loadu_128(&mut inputs[2][block_offset + 1 * ]);
    out[7] = loadu_128(&mut inputs[3][block_offset + 1 * ]);
    out[8] = loadu_128(&mut inputs[0][block_offset + 2 * ]);
    out[9] = loadu_128(&mut inputs[1][block_offset + 2 * ]);
    out[10] = loadu_128(&mut inputs[2][block_offset + 2 * ]);
    out[11] = loadu_128(&mut inputs[3][block_offset + 2 * ]);
    out[12] = loadu_128(&mut inputs[0][block_offset + 3 * ]);
    out[13] = loadu_128(&mut inputs[1][block_offset + 3 * ]);
    out[14] = loadu_128(&mut inputs[2][block_offset + 3 * ]);
    out[15] = loadu_128(&mut inputs[3][block_offset + 3 * ]);
    transpose_vecs_128(&mut out[0]);
    transpose_vecs_128(&mut out[4]);
    transpose_vecs_128(&mut out[8]);
    transpose_vecs_128(&mut out[12]);
}

fn load_counters4(counter: u64, increment_counter: bool, out_low: *mut uint32x4_t, out_high: *mut uint32x4_t) {
    let mut mask: u64 = (if increment_counter { ~0 } else { 0 });
    *out_low = set4(counter_low(counter + (mask & 0)), counter_low(counter + (mask & 1)), counter_low(counter + (mask & 2)), counter_low(counter + (mask & 3)));
    *out_high = set4(counter_high(counter + (mask & 0)), counter_high(counter + (mask & 1)), counter_high(counter + (mask & 2)), counter_high(counter + (mask & 3)));
}

fn blake3_hash4_neon(inputs: *uint8_t *const, blocks: u64, key: *u32, counter: u64, increment_counter: bool, flags: u8, flags_start: u8, flags_end: u8, out: *mut u8) {
    let mut h_vecs: [8]uint32x4_t = [set1_128(key[0]), set1_128(key[1]), set1_128(key[2]), set1_128(key[3]), set1_128(key[4]), set1_128(key[5]), set1_128(key[6]), set1_128(key[7])];
    let mut counter_low_vec: uint32x4_t = uint32x4_t {};
    let mut counter_high_vec: uint32x4_t = uint32x4_t {};
    load_counters4(counter, increment_counter, &mut counter_low_vec, &mut counter_high_vec);
    let mut block_flags: u8 = flags | flags_start;
    for let mut block: u64 = 0; block < blocks; block += 1 {
        if block + 1 == blocks {
            block_flags |= flags_end;
        }
        let mut block_len_vec: uint32x4_t = set1_128(64);
        let mut block_flags_vec: uint32x4_t = set1_128(block_flags);
        let mut msg_vecs: [16]uint32x4_t = [16]uint32x4_t {};
        transpose_msg_vecs4(inputs, block * 64, msg_vecs);
        let mut v: [16]uint32x4_t = [h_vecs[0], h_vecs[1], h_vecs[2], h_vecs[3], h_vecs[4], h_vecs[5], h_vecs[6], h_vecs[7], set1_128(IV[0]), set1_128(IV[1]), set1_128(IV[2]), set1_128(IV[3]), counter_low_vec, counter_high_vec, block_len_vec, block_flags_vec];
        round_fn4(v, msg_vecs, 0);
        round_fn4(v, msg_vecs, 1);
        round_fn4(v, msg_vecs, 2);
        round_fn4(v, msg_vecs, 3);
        round_fn4(v, msg_vecs, 4);
        round_fn4(v, msg_vecs, 5);
        round_fn4(v, msg_vecs, 6);
        h_vecs[0] = xor_128(v[0], v[8]);
        h_vecs[1] = xor_128(v[1], v[9]);
        h_vecs[2] = xor_128(v[2], v[10]);
        h_vecs[3] = xor_128(v[3], v[11]);
        h_vecs[4] = xor_128(v[4], v[12]);
        h_vecs[5] = xor_128(v[5], v[13]);
        h_vecs[6] = xor_128(v[6], v[14]);
        h_vecs[7] = xor_128(v[7], v[15]);
        block_flags = flags;
    }
    transpose_vecs_128(&mut h_vecs[0]);
    transpose_vecs_128(&mut h_vecs[4]);
    storeu_128(h_vecs[0], &mut out[0 * ]);
    storeu_128(h_vecs[4], &mut out[1 * ]);
    storeu_128(h_vecs[1], &mut out[2 * ]);
    storeu_128(h_vecs[5], &mut out[3 * ]);
    storeu_128(h_vecs[2], &mut out[4 * ]);
    storeu_128(h_vecs[6], &mut out[5 * ]);
    storeu_128(h_vecs[3], &mut out[6 * ]);
    storeu_128(h_vecs[7], &mut out[7 * ]);
}

extern fn blake3_compress_in_place_portable(cv: *mut u32, block: *u8, block_len: u8, counter: u64, flags: u8);

fn hash_one_neon(input: *u8, blocks: u64, key: *u32, counter: u64, flags: u8, flags_start: u8, flags_end: u8, out: *mut u8) {
    let mut cv: [8]u32 = zeroed();
    memcpy(cv, key, 32);
    let mut block_flags: u8 = flags | flags_start;
    while blocks > 0 {
        if blocks == 1 {
            block_flags |= flags_end;
        }
        blake3_compress_in_place_portable(cv, input, 64, counter, block_flags);
        input = &mut input[64];
        blocks -= 1;
        block_flags = flags;
    }
    memcpy(out, cv, 32);
}

fn blake3_hash_many_neon(inputs: *uint8_t *const, num_inputs: u64, blocks: u64, key: *u32, counter: u64, increment_counter: bool, flags: u8, flags_start: u8, flags_end: u8, out: *mut u8) {
    while num_inputs >= 4 {
        blake3_hash4_neon(inputs, blocks, key, counter, increment_counter, flags, flags_start, flags_end, out);
        if increment_counter {
            counter += 4;
        }
        inputs += 4;
        num_inputs -= 4;
        out = &mut out[4 * 32];
    }
    while num_inputs > 0 {
        hash_one_neon(inputs[0], blocks, key, counter, flags, flags_start, flags_end, out);
        if increment_counter {
            counter += 1;
        }
        inputs += 1;
        num_inputs -= 1;
        out = &mut out[32];
    }
}
