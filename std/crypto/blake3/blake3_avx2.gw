fn loadu(src: *u8) -> __m256i {
    return _mm256_loadu_si256(src as *__m256i);
}

fn storeu(src: __m256i, dest: *mut u8) {
    _mm256_storeu_si256(dest as *mut __m256i, src);
}

fn addv(a: __m256i, b: __m256i) -> __m256i {
    return _mm256_add_epi32(a, b);
}

fn xorv(a: __m256i, b: __m256i) -> __m256i {
    return _mm256_xor_si256(a, b);
}

fn set1(x: u32) -> __m256i {
    return _mm256_set1_epi32(x as i32);
}

fn rot16(x: __m256i) -> __m256i {
    return _mm256_shuffle_epi8(x, _mm256_set_epi8(13, 12, 15, 14, 9, 8, 11, 10, 5, 4, 7, 6, 1, 0, 3, 2, 13, 12, 15, 14, 9, 8, 11, 10, 5, 4, 7, 6, 1, 0, 3, 2));
}

fn rot12(x: __m256i) -> __m256i {
    return _mm256_or_si256(_mm256_srli_epi32(x, 12), _mm256_slli_epi32(x, 32 - 12));
}

fn rot8(x: __m256i) -> __m256i {
    return _mm256_shuffle_epi8(x, _mm256_set_epi8(12, 15, 14, 13, 8, 11, 10, 9, 4, 7, 6, 5, 0, 3, 2, 1, 12, 15, 14, 13, 8, 11, 10, 9, 4, 7, 6, 5, 0, 3, 2, 1));
}

fn rot7(x: __m256i) -> __m256i {
    return _mm256_or_si256(_mm256_srli_epi32(x, 7), _mm256_slli_epi32(x, 32 - 7));
}

fn round_fn(v: *mut __m256i, m: *mut __m256i, r: u64) {
    v[0] = addv(v[0], m[MSG_SCHEDULE[r][0] as u64]);
    v[1] = addv(v[1], m[MSG_SCHEDULE[r][2] as u64]);
    v[2] = addv(v[2], m[MSG_SCHEDULE[r][4] as u64]);
    v[3] = addv(v[3], m[MSG_SCHEDULE[r][6] as u64]);
    v[0] = addv(v[0], v[4]);
    v[1] = addv(v[1], v[5]);
    v[2] = addv(v[2], v[6]);
    v[3] = addv(v[3], v[7]);
    v[12] = xorv(v[12], v[0]);
    v[13] = xorv(v[13], v[1]);
    v[14] = xorv(v[14], v[2]);
    v[15] = xorv(v[15], v[3]);
    v[12] = rot16(v[12]);
    v[13] = rot16(v[13]);
    v[14] = rot16(v[14]);
    v[15] = rot16(v[15]);
    v[8] = addv(v[8], v[12]);
    v[9] = addv(v[9], v[13]);
    v[10] = addv(v[10], v[14]);
    v[11] = addv(v[11], v[15]);
    v[4] = xorv(v[4], v[8]);
    v[5] = xorv(v[5], v[9]);
    v[6] = xorv(v[6], v[10]);
    v[7] = xorv(v[7], v[11]);
    v[4] = rot12(v[4]);
    v[5] = rot12(v[5]);
    v[6] = rot12(v[6]);
    v[7] = rot12(v[7]);
    v[0] = addv(v[0], m[MSG_SCHEDULE[r][1] as u64]);
    v[1] = addv(v[1], m[MSG_SCHEDULE[r][3] as u64]);
    v[2] = addv(v[2], m[MSG_SCHEDULE[r][5] as u64]);
    v[3] = addv(v[3], m[MSG_SCHEDULE[r][7] as u64]);
    v[0] = addv(v[0], v[4]);
    v[1] = addv(v[1], v[5]);
    v[2] = addv(v[2], v[6]);
    v[3] = addv(v[3], v[7]);
    v[12] = xorv(v[12], v[0]);
    v[13] = xorv(v[13], v[1]);
    v[14] = xorv(v[14], v[2]);
    v[15] = xorv(v[15], v[3]);
    v[12] = rot8(v[12]);
    v[13] = rot8(v[13]);
    v[14] = rot8(v[14]);
    v[15] = rot8(v[15]);
    v[8] = addv(v[8], v[12]);
    v[9] = addv(v[9], v[13]);
    v[10] = addv(v[10], v[14]);
    v[11] = addv(v[11], v[15]);
    v[4] = xorv(v[4], v[8]);
    v[5] = xorv(v[5], v[9]);
    v[6] = xorv(v[6], v[10]);
    v[7] = xorv(v[7], v[11]);
    v[4] = rot7(v[4]);
    v[5] = rot7(v[5]);
    v[6] = rot7(v[6]);
    v[7] = rot7(v[7]);
    v[0] = addv(v[0], m[MSG_SCHEDULE[r][8] as u64]);
    v[1] = addv(v[1], m[MSG_SCHEDULE[r][10] as u64]);
    v[2] = addv(v[2], m[MSG_SCHEDULE[r][12] as u64]);
    v[3] = addv(v[3], m[MSG_SCHEDULE[r][14] as u64]);
    v[0] = addv(v[0], v[5]);
    v[1] = addv(v[1], v[6]);
    v[2] = addv(v[2], v[7]);
    v[3] = addv(v[3], v[4]);
    v[15] = xorv(v[15], v[0]);
    v[12] = xorv(v[12], v[1]);
    v[13] = xorv(v[13], v[2]);
    v[14] = xorv(v[14], v[3]);
    v[15] = rot16(v[15]);
    v[12] = rot16(v[12]);
    v[13] = rot16(v[13]);
    v[14] = rot16(v[14]);
    v[10] = addv(v[10], v[15]);
    v[11] = addv(v[11], v[12]);
    v[8] = addv(v[8], v[13]);
    v[9] = addv(v[9], v[14]);
    v[5] = xorv(v[5], v[10]);
    v[6] = xorv(v[6], v[11]);
    v[7] = xorv(v[7], v[8]);
    v[4] = xorv(v[4], v[9]);
    v[5] = rot12(v[5]);
    v[6] = rot12(v[6]);
    v[7] = rot12(v[7]);
    v[4] = rot12(v[4]);
    v[0] = addv(v[0], m[MSG_SCHEDULE[r][9] as u64]);
    v[1] = addv(v[1], m[MSG_SCHEDULE[r][11] as u64]);
    v[2] = addv(v[2], m[MSG_SCHEDULE[r][13] as u64]);
    v[3] = addv(v[3], m[MSG_SCHEDULE[r][15] as u64]);
    v[0] = addv(v[0], v[5]);
    v[1] = addv(v[1], v[6]);
    v[2] = addv(v[2], v[7]);
    v[3] = addv(v[3], v[4]);
    v[15] = xorv(v[15], v[0]);
    v[12] = xorv(v[12], v[1]);
    v[13] = xorv(v[13], v[2]);
    v[14] = xorv(v[14], v[3]);
    v[15] = rot8(v[15]);
    v[12] = rot8(v[12]);
    v[13] = rot8(v[13]);
    v[14] = rot8(v[14]);
    v[10] = addv(v[10], v[15]);
    v[11] = addv(v[11], v[12]);
    v[8] = addv(v[8], v[13]);
    v[9] = addv(v[9], v[14]);
    v[5] = xorv(v[5], v[10]);
    v[6] = xorv(v[6], v[11]);
    v[7] = xorv(v[7], v[8]);
    v[4] = xorv(v[4], v[9]);
    v[5] = rot7(v[5]);
    v[6] = rot7(v[6]);
    v[7] = rot7(v[7]);
    v[4] = rot7(v[4]);
}

fn transpose_vecs(vecs: *mut __m256i) {
    let mut ab_0145: __m256i = _mm256_unpacklo_epi32(vecs[0], vecs[1]);
    let mut ab_2367: __m256i = _mm256_unpackhi_epi32(vecs[0], vecs[1]);
    let mut cd_0145: __m256i = _mm256_unpacklo_epi32(vecs[2], vecs[3]);
    let mut cd_2367: __m256i = _mm256_unpackhi_epi32(vecs[2], vecs[3]);
    let mut ef_0145: __m256i = _mm256_unpacklo_epi32(vecs[4], vecs[5]);
    let mut ef_2367: __m256i = _mm256_unpackhi_epi32(vecs[4], vecs[5]);
    let mut gh_0145: __m256i = _mm256_unpacklo_epi32(vecs[6], vecs[7]);
    let mut gh_2367: __m256i = _mm256_unpackhi_epi32(vecs[6], vecs[7]);
    let mut abcd_04: __m256i = _mm256_unpacklo_epi64(ab_0145, cd_0145);
    let mut abcd_15: __m256i = _mm256_unpackhi_epi64(ab_0145, cd_0145);
    let mut abcd_26: __m256i = _mm256_unpacklo_epi64(ab_2367, cd_2367);
    let mut abcd_37: __m256i = _mm256_unpackhi_epi64(ab_2367, cd_2367);
    let mut efgh_04: __m256i = _mm256_unpacklo_epi64(ef_0145, gh_0145);
    let mut efgh_15: __m256i = _mm256_unpackhi_epi64(ef_0145, gh_0145);
    let mut efgh_26: __m256i = _mm256_unpacklo_epi64(ef_2367, gh_2367);
    let mut efgh_37: __m256i = _mm256_unpackhi_epi64(ef_2367, gh_2367);
    vecs[0] = _mm256_permute2x128_si256(abcd_04, efgh_04, 32);
    vecs[1] = _mm256_permute2x128_si256(abcd_15, efgh_15, 32);
    vecs[2] = _mm256_permute2x128_si256(abcd_26, efgh_26, 32);
    vecs[3] = _mm256_permute2x128_si256(abcd_37, efgh_37, 32);
    vecs[4] = _mm256_permute2x128_si256(abcd_04, efgh_04, 49);
    vecs[5] = _mm256_permute2x128_si256(abcd_15, efgh_15, 49);
    vecs[6] = _mm256_permute2x128_si256(abcd_26, efgh_26, 49);
    vecs[7] = _mm256_permute2x128_si256(abcd_37, efgh_37, 49);
}

fn transpose_msg_vecs(inputs: *uint8_t *const, block_offset: u64, out: *mut __m256i) {
    out[0] = loadu(&mut inputs[0][block_offset + 0 * ]);
    out[1] = loadu(&mut inputs[1][block_offset + 0 * ]);
    out[2] = loadu(&mut inputs[2][block_offset + 0 * ]);
    out[3] = loadu(&mut inputs[3][block_offset + 0 * ]);
    out[4] = loadu(&mut inputs[4][block_offset + 0 * ]);
    out[5] = loadu(&mut inputs[5][block_offset + 0 * ]);
    out[6] = loadu(&mut inputs[6][block_offset + 0 * ]);
    out[7] = loadu(&mut inputs[7][block_offset + 0 * ]);
    out[8] = loadu(&mut inputs[0][block_offset + 1 * ]);
    out[9] = loadu(&mut inputs[1][block_offset + 1 * ]);
    out[10] = loadu(&mut inputs[2][block_offset + 1 * ]);
    out[11] = loadu(&mut inputs[3][block_offset + 1 * ]);
    out[12] = loadu(&mut inputs[4][block_offset + 1 * ]);
    out[13] = loadu(&mut inputs[5][block_offset + 1 * ]);
    out[14] = loadu(&mut inputs[6][block_offset + 1 * ]);
    out[15] = loadu(&mut inputs[7][block_offset + 1 * ]);
    for let mut i: u64 = 0; i < 8; i += 1 {
        _mm_prefetch(&mut inputs[i][block_offset + 256] as *void, 1);
    }
    transpose_vecs(&mut out[0]);
    transpose_vecs(&mut out[8]);
}

fn load_counters(counter: u64, increment_counter: bool, out_lo: *mut __m256i, out_hi: *mut __m256i) {
    let mut mask: __m256i = _mm256_set1_epi32(-increment_counter as i32);
    let mut add0: __m256i = _mm256_set_epi32(7, 6, 5, 4, 3, 2, 1, 0);
    let mut add1: __m256i = _mm256_and_si256(mask, add0);
    let mut l: __m256i = _mm256_add_epi32(_mm256_set1_epi32(counter as i32), add1);
    let mut carry: __m256i = _mm256_cmpgt_epi32(_mm256_xor_si256(add1, _mm256_set1_epi32(2147483648)), _mm256_xor_si256(l, _mm256_set1_epi32(2147483648)));
    let mut h: __m256i = _mm256_sub_epi32(_mm256_set1_epi32((counter >> 32) as i32), carry);
    *out_lo = l;
    *out_hi = h;
}

fn blake3_hash8_avx2(inputs: *uint8_t *const, blocks: u64, key: *u32, counter: u64, increment_counter: bool, flags: u8, flags_start: u8, flags_end: u8, out: *mut u8) {
    let mut h_vecs: [8]__m256i = [set1(key[0]), set1(key[1]), set1(key[2]), set1(key[3]), set1(key[4]), set1(key[5]), set1(key[6]), set1(key[7])];
    let mut counter_low_vec: __m256i = __m256i {};
    let mut counter_high_vec: __m256i = __m256i {};
    load_counters(counter, increment_counter, &mut counter_low_vec, &mut counter_high_vec);
    let mut block_flags: u8 = flags | flags_start;
    for let mut block: u64 = 0; block < blocks; block += 1 {
        if block + 1 == blocks {
            block_flags |= flags_end;
        }
        let mut block_len_vec: __m256i = set1(64);
        let mut block_flags_vec: __m256i = set1(block_flags);
        let mut msg_vecs: [16]__m256i = [16]__m256i {};
        transpose_msg_vecs(inputs, block * 64, msg_vecs);
        let mut v: [16]__m256i = [h_vecs[0], h_vecs[1], h_vecs[2], h_vecs[3], h_vecs[4], h_vecs[5], h_vecs[6], h_vecs[7], set1(IV[0]), set1(IV[1]), set1(IV[2]), set1(IV[3]), counter_low_vec, counter_high_vec, block_len_vec, block_flags_vec];
        round_fn(v, msg_vecs, 0);
        round_fn(v, msg_vecs, 1);
        round_fn(v, msg_vecs, 2);
        round_fn(v, msg_vecs, 3);
        round_fn(v, msg_vecs, 4);
        round_fn(v, msg_vecs, 5);
        round_fn(v, msg_vecs, 6);
        h_vecs[0] = xorv(v[0], v[8]);
        h_vecs[1] = xorv(v[1], v[9]);
        h_vecs[2] = xorv(v[2], v[10]);
        h_vecs[3] = xorv(v[3], v[11]);
        h_vecs[4] = xorv(v[4], v[12]);
        h_vecs[5] = xorv(v[5], v[13]);
        h_vecs[6] = xorv(v[6], v[14]);
        h_vecs[7] = xorv(v[7], v[15]);
        block_flags = flags;
    }
    transpose_vecs(h_vecs);
    storeu(h_vecs[0], &mut out[0 * ]);
    storeu(h_vecs[1], &mut out[1 * ]);
    storeu(h_vecs[2], &mut out[2 * ]);
    storeu(h_vecs[3], &mut out[3 * ]);
    storeu(h_vecs[4], &mut out[4 * ]);
    storeu(h_vecs[5], &mut out[5 * ]);
    storeu(h_vecs[6], &mut out[6 * ]);
    storeu(h_vecs[7], &mut out[7 * ]);
}

extern fn blake3_hash_many_sse41(inputs: *uint8_t *const, num_inputs: u64, blocks: u64, key: *u32, counter: u64, increment_counter: bool, flags: u8, flags_start: u8, flags_end: u8, out: *mut u8);

fn blake3_hash_many_avx2(inputs: *uint8_t *const, num_inputs: u64, blocks: u64, key: *u32, counter: u64, increment_counter: bool, flags: u8, flags_start: u8, flags_end: u8, out: *mut u8) {
    while num_inputs >= 8 {
        blake3_hash8_avx2(inputs, blocks, key, counter, increment_counter, flags, flags_start, flags_end, out);
        if increment_counter {
            counter += 8;
        }
        inputs += 8;
        num_inputs -= 8;
        out = &mut out[8 * 32];
    }
    blake3_hash_many_sse41(inputs, num_inputs, blocks, key, counter, increment_counter, flags, flags_start, flags_end, out);
}
