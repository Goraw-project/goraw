fn mi_theap_alloc_new_nothrow(theap: *mut mi_theap_t, size: u64) -> *mut void {
    let mut p: *mut void = mi_theap_malloc(theap, size);
    if __builtin_expect(!!(p == 0), false) {
        return mi_theap_try_new(theap, size, true);
    }
    return p;
}

fn mi_new_nothrow(size: u64) -> *mut void {
    return mi_theap_alloc_new_nothrow(_mi_theap_default(), size);
}

fn mi_try_new_aligned(size: u64, alignment: u64, nothrow: bool) -> *mut void {
    let mut p: *mut void = 0;
    for let mut i: i32 = 0; i < (4) && p == 0 && mi_try_new_handler(nothrow); i += 1 {
        if !mi_alignment_is_valid(alignment) {
            return 0;
        }
        p = mi_malloc_aligned(size, alignment);
    }
    return p;
}

fn mi_new_aligned(size: u64, alignment: u64) -> *mut void {
    let mut p: *mut void = mi_malloc_aligned(size, alignment);
    if __builtin_expect(!!(p == 0), false) {
        return mi_try_new_aligned(size, alignment, false);
