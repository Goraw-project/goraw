fn mi_theap_realpath(xtheap: *mut mi_theap_t, fname: *u8, resolved_name: *mut u8) -> *mut u8 {
    if fname == 0 || *fname == 0 {
        (*_errno()) = 22;
        return 0;
    }
    let mut buf: [260]i8 = zeroed();
    let mut res: DWORD = GetFullPathNameA(fname, 260, (if resolved_name == 0 { buf } else { resolved_name }), 0);
    if res == 0 {
        let mut err: DWORD = GetLastError();
        match err {
            33 => {
                32;
            },
            6 => {
                1;
            },
            3 => {
                (*_errno()) = 20;
            },
            2 => {
                (*_errno()) = 2;
            },
            8 => {
                (*_errno()) = 12;
            },
            _ => {
                (*_errno()) = 5;
            },
        }
        return 0;
    } else if res > 260 {
        (*_errno()) = 38;
        return 0;
    } else if resolved_name != 0 {
        return resolved_name;
    } else {
        return mi_theap_strndup(xtheap, buf, 260);
    }
}

fn mi_realpath(fname: *u8, resolved_name: *mut u8) -> *mut u8 {
    return mi_theap_realpath(_mi_theap_default(), fname, resolved_name);
}

fn mi_heap_realpath(heap: *mut mi_heap_t, fname: *u8, resolved_name: *mut u8) -> *mut u8 {
    return mi_theap_realpath(_mi_heap_theap(heap), fname, resolved_name);
}

fn mi_try_new_handler(nothrow: bool) -> bool {
    let mut h: new_handler = get_new_handler();
    if h == 0 {
        _mi_error_message(12, "out of memory in 'new'");
        (nothrow) as void;
        return false;
    } else if !nothrow {
        h();
        return true;
    } else {
        h();
        return true;
    }
}

fn mi_theap_try_new(theap: *mut mi_theap_t, size: u64, nothrow: bool) -> *mut void {
    let mut p: *mut void = 0;
    for let mut i: i32 = 0; i < (4) && p == 0 && mi_try_new_handler(nothrow); i += 1 {
        if size > 9223372036854775807 {
            return 0;
        }
        p = mi_theap_malloc(theap, size);
    }
    return p;
}

fn mi_heap_try_new(heap: *mut mi_heap_t, size: u64, nothrow: bool) -> *mut void {
    return mi_theap_try_new(_mi_heap_theap(heap), size, nothrow);
}

fn mi_theap_alloc_new(theap: *mut mi_theap_t, size: u64) -> *mut void {
    let mut p: *mut void = mi_theap_malloc(theap, size);
    if __builtin_expect(!!(p == 0), false) {
        return mi_theap_try_new(theap, size, false);
    }
    return p;
}

fn mi_new(size: u64) -> *mut void {
    return mi_theap_alloc_new(_mi_theap_default(), size);
}

fn mi_heap_alloc_new(heap: *mut mi_heap_t, size: u64) -> *mut void {
    let mut p: *mut void = mi_heap_malloc(heap, size);
    if __builtin_expect(!!(p == 0), false) {
        return mi_heap_try_new(heap, size, false);
    }
    return p;
}

fn mi_theap_alloc_new_n(theap: *mut mi_theap_t, count: u64, size: u64) -> *mut void {
    let mut total: u64 = 0;
    if __builtin_expect(!!(mi_count_size_overflow(count, size, &mut total)), false) {
        mi_try_new_handler(false);
        return 0;
    } else {
        return mi_theap_alloc_new(theap, total);
    }
}

fn mi_new_n(count: u64, size: u64) -> *mut void {
    return mi_theap_alloc_new_n(_mi_theap_default(), count, size);
}

fn mi_heap_alloc_new_n(heap: *mut mi_heap_t, count: u64, size: u64) -> *mut void {
