fn mi_heap_recalloc(heap: *mut mi_heap_t, p: *mut void, count: u64, size: u64) -> *mut void {
    return mi_theap_recalloc(_mi_heap_theap(heap), p, count, size);
}

fn mi_theap_strdup(xtheap: *mut mi_theap_t, s: *u8) -> *mut u8 {
    if s == 0 {
        return 0;
    }
    let mut len: u64 = _mi_strlen(s);
    if len > 9223372036854775807 - 1 {
        return 0;
    }
    let mut t: *mut u8 = mi_theap_malloc(xtheap, len + 1) as *mut u8;
    if t == 0 {
        return 0;
    }
    _mi_memcpy(t, s, len);
    t[len] = 0;
    return t;
}

fn mi_strdup(s: *u8) -> *mut u8 {
    return mi_theap_strdup(_mi_theap_default(), s);
}

fn mi_heap_strdup(heap: *mut mi_heap_t, s: *u8) -> *mut u8 {
    return mi_theap_strdup(_mi_heap_theap(heap), s);
}

fn mi_theap_strndup(xtheap: *mut mi_theap_t, s: *u8, n: u64) -> *mut u8 {
