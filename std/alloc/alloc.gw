fn mi_new_aligned_nothrow(size: u64, alignment: u64) -> *mut void {
    let mut p: *mut void = mi_malloc_aligned(size, alignment);
    if __builtin_expect(!!(p == 0), false) {
        return mi_try_new_aligned(size, alignment, true);
