fn mi_try_new_realloc(p: *mut void, newsize: u64) -> *mut void {
    let mut q: *mut void = 0;
    for let mut i: i32 = 0; i < (4) && q == 0 && mi_try_new_handler(false); i += 1 {
        if newsize > 9223372036854775807 {
            return 0;
        }
        q = mi_realloc(p, newsize);
    }
    return q;
}

fn mi_new_realloc(p: *mut void, newsize: u64) -> *mut void {
    let mut q: *mut void = mi_realloc(p, newsize);
    if q == 0 {
        return mi_try_new_realloc(p, newsize);
    }
    return q;
}

fn mi_new_reallocn(p: *mut void, newcount: u64, size: u64) -> *mut void {
    let mut total: u64 = 0;
    if __builtin_expect(!!(mi_count_size_overflow(newcount, size, &mut total)), false) {
        mi_try_new_handler(false);
        return 0;
    } else {
        return mi_new_realloc(p, total);
    }
}
