    *size = *wrong = bsize;
    if !ok {
        return false;
    }
    (if (bsize >= delta) { 0 as void } else { _mi_assert_fail("bsize >= delta", "mimalloc\\src\\free.c", 735, "mi_verify_padding") });
    *size = bsize - delta;
    if !mi_page_is_huge(page) {
        let mut fill: *mut u8 = block as *mut u8 + bsize - delta;
        let mut maxpad: u64 = (if delta > 16 { 16 } else { delta });
        for let mut i: u64 = 0; i < maxpad; i += 1 {
            if fill[i] != (222) {
                *wrong = bsize - delta + i;
                ok = false;
                break;
            }
        }
    }
    return ok;
}

fn mi_check_padding_on_free(page: *mi_page_t, block: *mi_block_t, is_guarded: bool, usable_size: *mut u64) -> bool {
    if __builtin_expect(!!(is_guarded), false) {
        let mut bsize: u64 = mi_page_block_size(page);
        *usable_size = (bsize - _mi_os_page_size());
        return true;
    } else {
        let mut wrong: u64 = 0;
        let mut is_double_free: bool = false;
        if __builtin_expect(!!(!mi_verify_padding(page, block, usable_size, &mut wrong, &mut is_double_free)), false) {
            if is_double_free {
                _mi_error_message(11, "double free detected of heap block %p with size %zu\n", block, *usable_size);
            } else {
                _mi_error_message(14, "buffer overflow in heap block %p of size %zu: write after %zu bytes\n", block, *usable_size, wrong);
            }
            return false;
        }
        return true;
    }
}

fn mi_stat_free(page: *mi_page_t, block: *mi_block_t) {
    (page) as void;
    (block) as void;
}
