    return bit_set_count;
}

enum mi_ansi_color_e {
    MI_BLACK = 0,
    MI_MAROON = 1,
    MI_DARKGREEN = 2,
    MI_ORANGE = 3,
    MI_NAVY = 4,
    MI_PURPLE = 5,
    MI_TEAL = 6,
    MI_GRAY = 7,
    MI_DARKGRAY = 8,
    MI_RED = 9,
    MI_GREEN = 10,
    MI_YELLOW = 11,
    MI_BLUE = 12,
    MI_MAGENTA = 13,
    MI_CYAN = 14,
    MI_WHITE = 15,
}

fn mi_debug_color(buf: *mut u8, k: *mut u64, color: mi_ansi_color_t) {
    *k += _mi_snprintf(buf + *k, 32, "\033[%dm", color as i32);
}

fn mi_page_commit_usage(page: *mut mi_page_t) -> i32 {
    let mut committed_size: u64 = mi_page_committed(page);
    let mut used_size: u64 = mi_page_used(page) * mi_page_block_size(page);
    return (used_size * 100 / committed_size) as i32;
}

fn mi_debug_show_page_bfield(buf: *mut u8, k: *mut u64, arena: *mut mi_arena_t, slice_index: u64, pbit_of_page: *mut i64, pcolor_of_page: *mut mi_ansi_color_t) -> u64 {
    let mut bit_set_count: u64 = 0;
    let mut bit_of_page: i64 = *pbit_of_page;
    let mut color: mi_ansi_color_t = *pcolor_of_page;
    let mut prev_color: mi_ansi_color_t = MI_GRAY;
    for let mut bit: i32 = 0; bit < (1 << ((3) + 3)); bit += 1 , bit_of_page -= 1 {
        let mut start: *mut void = mi_arena_slice_start(arena, slice_index + bit);
        let mut page: *mut mi_page_t = _mi_safe_ptr_page(start);
        let mut c: i8 = ' ';
        if page != 0 && start == mi_page_slice_start(page) {
            (if (bit_of_page <= 0) { 0 as void } else { _mi_assert_fail("bit_of_page <= 0", "mimalloc\\src\\arena.c", 2015, "mi_debug_show_page_bfield") });
            bit_set_count += 1;
            c = 'p';
            color = MI_GRAY;
            if _mi_meta_is_meta_page(arena.subproc, page) {
                c = 'm';
            } else if mi_page_is_singleton(page) {
                c = 's';
            } else if mi_page_is_full(page) {
                c = 'f';
            }
            if !mi_page_is_abandoned(page) {
                c = _mi_toupper(c);
            }
            let mut commit_usage: i32 = mi_page_commit_usage(page);
            if commit_usage < 25 {
                color = MI_MAROON;
            } else if commit_usage < 50 {
                color = MI_ORANGE;
            } else if commit_usage < 75 {
                color = MI_TEAL;
            } else {
                color = MI_DARKGREEN;
            }
            bit_of_page = page.memid.mem.arena.slice_count as i64;
        } else {
            c = '?';
            if bit_of_page > 0 {
                c = '-';
            } else if slice_index + bit < arena.info_slices {
                c = 'i';
                color = MI_GRAY;
            } else if (slice_index % ((1 << (3)) * (1 << (6 + (3))))) == 0 && bit as u64 <= mi_arena_page_meta_aligned_slice_count() {
                {
                    c = 'i';
                    color = MI_GRAY;
                }
            } else if mi_bbitmap_is_setN(arena.slices_free, slice_index + bit, 1) {
                if mi_bitmap_is_set(arena.slices_purge, slice_index + bit) {
                    c = '~';
                    color = MI_ORANGE;
                } else if mi_bitmap_is_set(arena.slices_committed, slice_index + bit) {
                    c = '_';
                    color = MI_GRAY;
                } else {
                    c = '.';
                    color = MI_GRAY;
                }
            }
            if bit == (1 << ((3) + 3)) - 1 && bit_of_page > 1 {
                c = '>';
            }
        }
        if color != prev_color {
            mi_debug_color(buf, k, color);
            prev_color = color;
        }
        buf[*k] = c;
        *k += 1;
    }
    mi_debug_color(buf, k, MI_GRAY);
    *pbit_of_page = bit_of_page;
    *pcolor_of_page = color;
    return bit_set_count;
}

fn mi_debug_show_chunks(header1: *u8, header2: *u8, header3: *u8, slice_count: u64, chunk_count: u64, chunks: *mut mi_bchunk_t, chunk_bins: *mut mi_bchunkmap_t, invert: bool, arena: *mut mi_arena_t, narrow: bool) -> u64 {
    _mi_raw_message("\033[37m%s%s%s (use/commit: \033[31m0 - 25%%\033[33m - 50%%\033[36m - 75%%\033[32m - 100%%\033[0m)\n", header1, header2, header3);
    let mut fields_per_line: u64 = (if narrow { 2 } else { 4 });
    let mut used_slice_count: u64 = mi_arena_used_slices(arena);
    let mut bit_count: u64 = 0;
    let mut bit_set_count: u64 = 0;
    let mut bit_of_page: i64 = 0;
    let mut color_of_page: mi_ansi_color_t = MI_GRAY;
    for let mut i: u64 = 0; i < chunk_count && bit_count < slice_count; i += 1 {
        let mut buf: [2624]i8 = zeroed();
        _mi_memzero(buf, (buf));
        if bit_count > used_slice_count && i + 2 < chunk_count {
            let mut diff: u64 = chunk_count - 1 - i;
            bit_count += diff * (1 << (6 + (3)));
            _mi_raw_message("  |\n");
            i = chunk_count - 1;
        }
        let mut k: u64 = 0;
        if i < 10 {
            buf[k += 1] = ('0' + i as i8);
            buf[k += 1] = ' ';
            buf[k += 1] = ' ';
        } else if i < 100 {
            buf[k += 1] = ('0' + (i / 10) as i8);
            buf[k += 1] = ('0' + (i % 10) as i8);
            buf[k += 1] = ' ';
        } else if i < 1000 {
            buf[k += 1] = ('0' + (i / 100) as i8);
            buf[k += 1] = ('0' + ((i % 100) / 10) as i8);
            buf[k += 1] = ('0' + (i % 10) as i8);
        }
        let mut chunk_kind: i8 = ' ';
        if chunk_bins != 0 {
            match mi_bbitmap_debug_get_bin(chunk_bins, i) {
                MI_CBIN_SMALL => {
                    chunk_kind = 'S';
                },
                MI_CBIN_MEDIUM => {
                    chunk_kind = 'M';
                },
                MI_CBIN_LARGE => {
                    chunk_kind = 'L';
                },
                MI_CBIN_HUGE => {
                    chunk_kind = 'H';
                },
                MI_CBIN_OTHER => {
                    chunk_kind = 'X';
                },
                _ => {
                    chunk_kind = ' ';
                },
            }
        }
        buf[k += 1] = chunk_kind;
        buf[k += 1] = ' ';
        for let mut j: u64 = 0; j < ((1 << (6 + (3))) / (1 << ((3) + 3))); j += 1 {
            if j > 0 && (j % fields_per_line) == 0 {
                _mi_raw_message("  %s\n\033[37m", buf);
                _mi_memzero(buf, (buf));
                _mi_memset(buf, ' ', 5);
                k = 5;
            }
            if bit_count < slice_count {
                let mut bfield: mi_bfield_t = 0;
                if chunks != 0 {
                    bfield = chunks[i].bfields[j].operator unsigned long long();
                }
                if invert {
                    bfield = ~bfield;
                }
                let mut xcount: u64 = (if chunks == 0 { mi_debug_show_page_bfield(buf, &mut k, arena, bit_count, &mut bit_of_page, &mut color_of_page) } else { mi_debug_show_bfield(bfield, buf, &mut k) });
                if invert {
                    xcount = (1 << ((3) + 3)) - xcount;
                }
                bit_set_count += xcount;
                buf[k += 1] = ' ';
            } else {
                _mi_memset(buf + k, 'o', (1 << ((3) + 3)));
                k += (1 << ((3) + 3));
            }
            bit_count += (1 << ((3) + 3));
        }
        _mi_raw_message("  %s\n\033[37m", buf);
    }
    _mi_raw_message("\033[0m  total pages: %zu\n", bit_set_count);
    return bit_set_count;
}

