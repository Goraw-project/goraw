fn mi_reserve_huge_os_pages_at_ex(pages: u64, numa_node: i32, timeout_msecs: u64, exclusive: bool, arena_id: *mut mi_arena_id_t) -> i32 {
    if arena_id != 0 {
        *arena_id = 0;
    }
    if pages == 0 {
        return 0;
    }
    if numa_node < -1 {
        numa_node = -1;
    }
    if numa_node >= 0 {
        numa_node = numa_node % _mi_os_numa_node_count();
    }
    let mut subproc: *mut mi_subproc_t = _mi_subproc();
    let mut hsize: u64 = 0;
    let mut pages_reserved: u64 = 0;
    let mut memid: mi_memid_t = mi_memid_t {};
    let mut p: *mut void = _mi_os_alloc_huge_os_pages(subproc, pages, numa_node, timeout_msecs, &mut pages_reserved, &mut hsize, &mut memid);
    if p == 0 || pages_reserved == 0 {
        _mi_warning_message("failed to reserve %zu GiB huge pages\n", pages);
        return 12;
    }
    _mi_verbose_message("numa node %i: reserved %zu GiB huge pages (of the %zu GiB requested)\n", numa_node, pages_reserved, pages);
    if !mi_manage_os_memory_ex2(subproc, p, hsize, numa_node, exclusive, memid, 0, 0, arena_id) {
        _mi_os_free(subproc, p, hsize, memid);
        return 12;
    }
    return 0;
}

fn mi_reserve_huge_os_pages_at(pages: u64, numa_node: i32, timeout_msecs: u64) -> i32 {
    return mi_reserve_huge_os_pages_at_ex(pages, numa_node, timeout_msecs, false, 0);
}

fn mi_reserve_huge_os_pages_interleave(pages: u64, numa_nodes: u64, timeout_msecs: u64) -> i32 {
    if pages == 0 {
        return 0;
    }
    let mut numa_count: i32 = (if numa_nodes > 0 && numa_nodes <= 2147483647 { numa_nodes as i32 } else { _mi_os_numa_node_count() });
    if numa_count <= 0 {
        numa_count = 1;
    }
    let mut pages_per: u64 = pages / numa_count;
    let mut pages_mod: u64 = pages % numa_count;
    let mut timeout_per: u64 = (if timeout_msecs == 0 { 0 } else { (timeout_msecs / numa_count) + 50 });
    for let mut numa_node: i32 = 0; numa_node < numa_count && pages > 0; numa_node += 1 {
        let mut node_pages: u64 = pages_per;
        if numa_node as u64 < pages_mod {
            node_pages += 1;
        }
        let mut err: i32 = mi_reserve_huge_os_pages_at(node_pages, numa_node, timeout_per);
        if err {
            return err;
        }
        if pages < node_pages {
            pages = 0;
        } else {
            pages -= node_pages;
        }
    }
    return 0;
}

fn mi_reserve_huge_os_pages(pages: u64, max_secs: f64, pages_reserved: *mut u64) -> i32 {
    (max_secs) as void;
    _mi_warning_message("mi_reserve_huge_os_pages is deprecated: use mi_reserve_huge_os_pages_interleave/at instead\n");
    if pages_reserved != 0 {
        *pages_reserved = 0;
    }
    let mut err: i32 = mi_reserve_huge_os_pages_interleave(pages, 0, (max_secs * 1000.0) as u64);
    if err == 0 && pages_reserved != 0 {
        *pages_reserved = pages;
    }
    return err;
}

fn mi_arena_purge_delay() -> i64 {
    let mut delay: i64 = mi_option_get(mi_option_purge_delay);
    let mut mult: i64 = mi_option_get(mi_option_arena_purge_mult);
    if delay < 0 || mult < 0 {
        return -1;
    }
    if delay == 0 || mult == 0 {
        return 0;
    }
    let mut total: u64 = 0;
    if mi_mul_overflow(delay as u64, mult as u64, &mut total) {
        return delay;
    }
    if total > 2147483647 {
        return delay;
    }
    return total as i64;
}

