fn mi_option_is_enabled(option: mi_option_t) -> bool {
    return (mi_option_get(option) != 0);
}

fn mi_option_set_enabled(option: mi_option_t, enable: bool) {
    mi_option_set(option, (if enable { 1 } else { 0 }));
}

fn mi_option_set_enabled_default(option: mi_option_t, enable: bool) {
    mi_option_set_default(option, (if enable { 1 } else { 0 }));
}

fn mi_option_enable(option: mi_option_t) {
    mi_option_set_enabled(option, true);
}

fn mi_option_disable(option: mi_option_t) {
    mi_option_set_enabled(option, false);
}

