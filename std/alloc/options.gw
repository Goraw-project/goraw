        if mi_max_error_count >= 0 && atomic_fetch_add_explicit(&mut error_count, 1 as u64, memory_order_acq_rel) as i64 > mi_max_error_count {
            return;
        }
    }
    mi_vfprintf_thread(0, 0, "mimalloc: error: ", fmt, args);
}

