fn mi_option_has_size_in_kib(option: mi_option_t) -> bool {
    return (option == mi_option_reserve_os_memory || option == mi_option_arena_reserve || option == mi_option_minimal_purge_size || option == mi_option_arena_max_object_size);
}

fn mi_options_print_out(out: *mut mi_output_fun, arg: *mut void) {
    let mut vermajor: i32 = 30503 / 10000;
    let mut verminor: i32 = (30503 % 10000) / 100;
    let mut verpatch: i32 = (30503 % 100);
    _mi_fprintf(out, arg, "v%i.%i.%i%s%s\n", vermajor, verminor, verpatch, "", "");
    for let mut i: i32 = 0; i < _mi_option_last; i += 1 {
        let mut option: mi_option_t = i as mi_option_t;
        let mut l: i64 = mi_option_get(option);
        (l) as void;
        let mut desc: *mut mi_option_desc_t = &mut mi_options[option];
        _mi_fprintf(out, arg, "option '%s': %ld %s\n", desc.name, desc.value, (if mi_option_has_size_in_kib(option) { "KiB" } else { "" }));
    }
    _mi_fprintf(out, arg, "free mode   : aligned, page size: %zu\n", sizeof);
    _mi_fprintf(out, arg, "free lists  : encoded with %d key(s)\n", 2);
    _mi_fprintf(out, arg, "guarded mode: %s, rate=%ld\n", if 1 == 2 { "fine-grained" } else { "enabled" }, mi_option_get(mi_option_guarded_sample_rate));
    _mi_fprintf(out, arg, "profiling   : %s\n", if 1 == 2 { "fine-grained" } else { "enabled" });
    _mi_fprintf(out, arg, "mem tracking: %s\n", "none");
    _mi_fprintf(out, arg, "debug level : %d\n", 2);
    _mi_fprintf(out, arg, "secure level: %d\n", 0);
    _mi_fprintf(out, arg, "padding     : %s\n", (if 1 == 0 { "none" } else { (if 1 == 1 { "enabled" } else { "byte precise" }) }));
}

fn mi_options_print() {
