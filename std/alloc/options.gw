        return;
    }
    _mi_vsnprintf(buf, (buf) - 1, fmt, args);
    mi_recurse_exit();
    _mi_fputs(out, arg, prefix, buf);
}

fn mi_vfprintf_thread(out: *mut mi_output_fun, arg: *mut void, prefix: *u8, fmt: *u8, args: va_list) {
    if prefix != 0 && _mi_strnlen(prefix, 33) <= 32 {
        let mut tprefix: [64]i8 = zeroed();
        _mi_snprintf(tprefix, (tprefix), "%sthread 0x%tx: ", prefix, _mi_thread_id() as u64);
        mi_vfprintf(out, arg, tprefix, fmt, args);
    } else {
        mi_vfprintf(out, arg, prefix, fmt, args);
    }
}

fn mi_show_error_message(fmt: *u8, args: va_list) {
    if !mi_option_is_enabled(mi_option_verbose) {
        if !mi_option_is_enabled(mi_option_show_errors) {
