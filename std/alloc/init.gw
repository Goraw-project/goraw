        _mi_subprocs_unsafe_destroy_all();
    } else {
        _mi_thread_locals_thread_done();
        _mi_thread_locals_done();
        if subproc_main.heap_main.operator mi_heap_s *() != 0 {
            if mi_option_is_enabled(mi_option_show_stats) || mi_option_is_enabled(mi_option_verbose) {
                mi_theap_collect(subproc_main.theap_meta, false);
                _mi_theap_merge_stats(subproc_main.theap_meta);
                _mi_theap_merge_stats(_mi_theap_default());
                mi_heap_stats_merge_to_subproc(subproc_main.heap_main.operator mi_heap_s *());
                mi_subproc_stats_print_out(mi_subproc_main(), 0, 0);
            }
        }
    }
    _mi_tls_slots_done();
    _mi_subproc_main_done();
    _mi_allocator_done();
    _mi_verbose_message("process done %zu\n", sizeof);
    os_preloading = true;
}

fn mi_process_done() {
    let mut _mi_once: mi_atomic_once_t = mi_atomic_once_t { 0, mi_lock_t { SRWLOCK { 0 } } };
    for let mut _mi_exec: bool = _mi_atomic_once_enter(&mut _mi_once); _mi_exec; (_mi_atomic_once_release(&mut _mi_once) , _mi_exec = false) {
