        tld.thread_id = _mi_prim_thread_id();
        tld.is_in_threadpool = _mi_prim_thread_is_in_threadpool();
        tld.thread_seq = tseq;
        atomic_fetch_add_explicit(&mut tld.subproc.thread_count, 1 as u64, memory_order_relaxed);
    }
    return tld;
}

