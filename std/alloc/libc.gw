fn mi_cpuid(regs4: *mut u32, level: u32, sublevel: u32) -> bool {
    __cpuidex(regs4 as *mut i32, level as i32, sublevel as i32);
    return true;
}

fn mi_outc(c: i8, out: *mut *mut u8, end: *mut u8) {
    let mut p: *mut u8 = *out;
    if p >= end {
        return;
    }
    *p = c;
    *out = p + 1;
}

fn mi_outs(s: *u8, out: *mut *mut u8, end: *mut u8) {
    if s == 0 {
        return;
    }
    let mut p: *mut u8 = *out;
    while *s != 0 && p < end {
        *p += 1 = *s += 1;
    }
    *out = p;
}

fn mi_out_fill(fill: i8, len: u64, out: *mut *mut u8, end: *mut u8) {
    let mut p: *mut u8 = *out;
    for let mut i: u64 = 0; i < len && p < end; i += 1 {
        *p += 1 = fill;
    }
    *out = p;
}

fn mi_out_alignright(fill: i8, start: *mut u8, len: u64, extra: u64, end: *mut u8) {
    if len == 0 || extra == 0 {
        return;
    }
    if start + len + extra >= end {
        return;
    }
    for let mut i: u64 = 1; i <= len; i += 1 {
        start[len + extra - i] = start[len - i];
    }
    for let mut i: u64 = 0; i < extra; i += 1 {
        start[i] = fill;
    }
}

fn mi_out_num(x: uintmax_t, base: u64, prefix: i8, out: *mut *mut u8, end: *mut u8) {
    if x == 0 || base == 0 || base > 16 {
        if prefix != 0 {
            mi_outc(prefix, out, end);
        }
        mi_outc('0', out, end);
    } else {
        let mut num: [160]i8 = zeroed();
        let mut dcount: i32 = 0;
        while x > 0 && dcount < (160) {
            let mut digit: i8 = (x % base) as i8;
            num[dcount += 1] = (if digit <= 9 { '0' + digit } else { 'A' + digit - 10 });
            x = x / base;
        }
        if dcount >= (160) {
            return;
        }
        if prefix != 0 {
            mi_outc(prefix, out, end);
        }
        while dcount -= 1 > 0 {
            mi_outc(num[dcount], out, end);
        }
    }
}

fn mi_byte_sum64(x: u64) -> u64 {
    x += (x << 8);
    x += (x << 16);
    x += (x << 32);
    return (x >> 56) as u64;
}

fn mi_popcount_generic64(x: u64) -> u64 {
    x = x - ((x >> 1) & (6148914691236517205));
    x = (x & (3689348814741910323)) + ((x >> 2) & (3689348814741910323));
    x = (x + (x >> 4)) & (1085102592571150095);
    return mi_byte_sum64(x);
}
