// Goraw Standard Library: std/vec.gw
// Generic dynamic vector with automatic RAII deterministic destruction.

extern fn malloc(size: i64) -> *mut u8;
extern fn free(ptr: *mut u8);
extern fn realloc(ptr: *mut u8, new_size: i64) -> *mut u8;

struct Vec<T> {
    data: *mut T,
    len: i64,
    cap: i64,
}

fn Vec<T>::new() -> Vec<T> {
    return Vec {
        data: null,
        len: 0,
        cap: 0,
    };
}

fn Vec<T>::push(self, val: T) {
    if self.len >= self.cap {
        let new_cap: i64 = if self.cap == 0 { 4 } else { self.cap * 2 };
        let elem_sz: i64 = 8;
        let new_data = if self.data == null {
            malloc(new_cap * elem_sz) as *mut T
        } else {
            realloc(self.data as *mut u8, new_cap * elem_sz) as *mut T
        };
        self.data = new_data;
        self.cap = new_cap;
    }
    unsafe {
        self.data[self.len] = val;
    }
    self.len = self.len + 1;
}

fn Vec<T>::pop(self) -> T {
    self.len = self.len - 1;
    let mut res: T = zeroed();
    unsafe {
        res = self.data[self.len];
    }
    return res;
}

fn Vec<T>::get(self, idx: i64) -> T {
    let mut res: T = zeroed();
    unsafe {
        res = self.data[idx];
    }
    return res;
}

fn Vec<T>::len(self) -> i64 {
    return self.len;
}

fn Vec<T>::cap(self) -> i64 {
    return self.cap;
}

fn Vec<T>::drop(self) {
    if self.data != null {
        free(self.data as *mut u8);
        self.data = null;
        self.len = 0;
        self.cap = 0;
    }
}
