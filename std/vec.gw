// Goraw Standard Library: std/vec.gw
// Generic dynamic vector with deterministic memory management and safety.

struct Vec<T> {
    data: *mut T,
    len: i64,
    cap: i64,
}

fn Vec<T>::new() -> Vec<T> {
    return Vec {
        data: null,
        len: 0,
        cap: 0,
    };
}

fn Vec<T>::with_capacity(initial_cap: i64) -> Vec<T> {
    if initial_cap <= 0 {
        return Vec<T>::new();
    }
    let sz: i64 = sizeof(T);
    let p = alloc(initial_cap * sz) as *mut T;
    return Vec {
        data: p,
        len: 0,
        cap: initial_cap,
    };
}

fn Vec<T>::push(self, val: T) {
    if self.len >= self.cap {
        let new_cap: i64 = if self.cap == 0 { 4 } else { self.cap * 2 };
        let sz: i64 = sizeof(T);
        let new_data = if self.data == null {
            alloc(new_cap * sz) as *mut T
        } else {
            realloc(self.data as *mut u8, new_cap * sz) as *mut T
        };
        self.data = new_data;
        self.cap = new_cap;
    }
    unsafe {
        self.data[self.len] = val;
    }
    self.len = self.len + 1;
}

fn Vec<T>::pop(self) -> T {
    if self.len == 0 {
        panic("called Vec::pop on an empty Vec");
    }
    self.len = self.len - 1;
    let mut res: T = zeroed();
    unsafe {
        res = self.data[self.len];
    }
    return res;
}

fn Vec<T>::get(self, idx: i64) -> T {
    if idx < 0 || idx >= self.len {
        panic("Vec index out of bounds in get()");
    }
    let mut res: T = zeroed();
    unsafe {
        res = self.data[idx];
    }
    return res;
}

fn Vec<T>::set(self, idx: i64, val: T) {
    if idx < 0 || idx >= self.len {
        panic("Vec index out of bounds in set()");
    }
    unsafe {
        self.data[idx] = val;
    }
}

fn Vec<T>::len(self) -> i64 {
    return self.len;
}

fn Vec<T>::cap(self) -> i64 {
    return self.cap;
}

fn Vec<T>::is_empty(self) -> bool {
    return self.len == 0;
}

fn Vec<T>::clear(self) {
    self.len = 0;
}

fn Vec<T>::drop(self) {
    if self.data != null {
        free(self.data as *mut u8);
        self.data = null;
        self.len = 0;
        self.cap = 0;
    }
}
